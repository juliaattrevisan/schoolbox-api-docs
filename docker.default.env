# default settings for Docker environment.
# To modify, copy to docker.env and modify settings as needed.
EXTERNAL_DB="synergetic"
EXTERNAL_DB_HOST="172.31.25.26"
EXTERNAL_DB_DB="Synergetic_AUVIC_ALARESS_PRD"

# Which PHP version is Schoolbox run on?
# Usually not changed, but may be when testing a new version.
# (Not called PHP_VERSION as that conflicts with an env var in PHP containers.)
PHP_MAJOR_VERSION="8.4"

# Which MariaDB version is Schoolbox run on?
MARIADB_MAJOR_VERSION="11.4"

# Which port (if any) does the MariaDB container publish to the host?
# This allows a client running on the host to connect to the database.
MARIADB_PUBLISHED_PORT="3306"

# Which Redis version is Schoolbox run on?
REDIS_MAJOR_VERSION="6.0"

# Which ports (if any) do the Redis containers publish to the host?
# This allows a client running on the host to connect to the instance.
REDIS_STORAGE_PUBLISHED_PORT="6379"
REDIS_CACHE_PUBLISHED_PORT="6380"

# Which RabbitMQ version is Schoolbox run on?
RABBITMQ_MAJOR_VERSION="3.13"

# Which Etherpad version does Schoolbox run?
ETHERPAD_MAJOR_VERSION="2.1"

# From Sam.Bailey ~2017
# This is a caching proxy that can be used when in the Melbourne Office for faster downloads.
# It's a caching proxy, so if you're the first to download a new version it will be same speed as downloading from AWS, but the next person will be faster.
# DATA_SOURCE="https://gw-mel.alaress.com.au/sandbox-data"
DATA_SOURCE="https://s3-ap-southeast-2.amazonaws.com/schoolbox-data"
DATA_FILENAME="initial.tar.gz"

# Where are the SSL certificates downloaded from?
CERTIFICATE_SOURCE="https://s3-ap-southeast-2.amazonaws.com/schoolbox-cloud-tls"

# IR URL and API key
INSTANCE_REGISTRY_URL="https://manage.schoolbox.cloud"
INSTANCE_REGISTRY_API_KEY=""

# Default INSTANCE_ID for scripts run in the schoolbox-cli container
DEFAULT_INSTANCE_ID="docker"

# Should the base PHP image be built locally, or pulled from elsewhere?
# This should be off unless testing the build of the base image.
BASE_PHP_IMAGE_BUILD_FROM_LOCAL=0

# Should the task daemon image be built locally, or pulled from elsewhere?
# If building locally, the task daemon code base must be in the `../taskd`
# folder: it's no longer possible to configure the folder as it was in Vagrant.
TASKD_BUILD_FROM_LOCAL=0

# Enabling this will let your API cests evaluate responses against api schema yaml files
API_DIR=""

# The AWS region to log in to, for SSO
AWS_REGION="ap-southeast-2"

# The AWS account ID of the Schoolbox company AWS account for sso
AWS_ACCOUNT_ID="476058706527"

# The AWS IAM role name to assume when using the Schoolbox company AWS account for sso
AWS_ROLE_NAME="Vagrant"

# The sso start url
AWS_START_URL="https://d-976758be37.awsapps.com/start#/"

# Source from which previously built CI artifacts are downloaded
ARTIFACT_SOURCE="https://s3-ap-southeast-2.amazonaws.com/schoolbox-ci"

# The host and bucket name to which CDN files are uploaded:
# used for testing CDN functionality.
CDN_HOST="https://s3-ap-southeast-2.amazonaws.com"
CDN_BUCKET="sbx-dev-cdn"

# The prefix within `cdn_bucket` to which CDN files are uploaded:
# should be "$firstname.$lastname" (e.g. "eli.lowinger").
# Must be defined in `docker.env` in order to use `upload-static-assets.sh`.
#CDN_BUCKET_PREFIX="$firstname.$lastname"

# The registry from which private container images are pulled.
# (Public images are always pulled from Dockerhub for now.)
PRIVATE_CONTAINER_REGISTRY_TYPE="dockerhub"
#PRIVATE_CONTAINER_REGISTRY_TYPE="ecr"

# Dockerhub only: login with this username
PRIVATE_CONTAINER_REGISTRY_DOCKERHUB_USERNAME="alaress"

# ECR only: use region and account ID to derive repository URL
PRIVATE_CONTAINER_REGISTRY_ECR_ACCOUNT_ID="476058706527"
PRIVATE_CONTAINER_REGISTRY_ECR_REGION="ap-southeast-2"

# Server name for debugging:
# if set, must match the name of a setup server in PHPStorm settings > PHP > Servers.
PHPSTORM_SERVER_NAME=""

# Sentry settings
# This should only be set for testing the Sentry integration, and then removed:
# otherwise, too many errors could be reported to Sentry.
SENTRY_DSN=''
SENTRY_ERROR_SAMPLE_RATE=1.0
SENTRY_TRACE_SAMPLE_RATE=0.0005
SENTRY_PROFILE_SAMPLE_RATE=0.1
