#!/usr/bin/env bash

# Always run within root folder
cd "$(dirname "$0")/.." || exit 1

# Parse args for --install-instance-only
provision_args=''
errors='0'
while [[ $# -gt 0 ]]; do
    case $1 in
        --install-instance-only )
            provision_args="--install-instance-only"
            shift
            ;;
        *)
            error "Unrecognised option: '$1'"
            shift # past argument
            errors="1"
            ;;
    esac
done
if [[ $errors == "1" ]]; then
    exit 1
fi

# Add tests that containers are actually up, or just run docker-up

# Run the provision script in the schoolbox-cli container
docker exec -it -u root schoolbox-cli tools/docker-provision.sh $provision_args

# Restart containers which may depend on the rabbitmq vhost
"$(dirname "$0")/compose" restart schoolbox-scheduled schoolbox-mobiled

# Is the second env in action?
# If so copy from the second to the first, or just re-run the provision script
# for INSTANCE_ID=docker2
# For now I think it's fine to share storage folders
# Load config to find out
declare SECOND_INSTANCE_ENABLE
source ./docker.default.env
if [ -f ./docker.env ]; then
    source ./docker.env
fi
case "${SECOND_INSTANCE_ENABLE}" in
    1 | true | yes | on)
        docker exec -it -e INSTANCE_ID=docker2 -u root schoolbox-cli tools/docker-provision.sh --install-instance-only
        "$(dirname "$0")/compose" restart schoolbox2-scheduled schoolbox2-mobiled
        ;;
esac

# restart the caddy container to pick up any changes
"$(dirname "$0")/compose" restart caddy

# Output the URLs/IPs which this instance may be accessed from:
echo "Access the Schoolbox development instance via the following local URLs:"
echo "This machine only:"
echo "- https://docker.dev.schoolbox.cloud/"
case "${SECOND_INSTANCE_ENABLE}" in
    1 | true | yes | on)
        echo "- https://docker2.dev.schoolbox.cloud/ (separate instance)"
        echo "Other machines on this network (docker.dev.schoolbox.cloud only):"
        ;;
    * )
        echo "Other machines on this network:"
        ;;
esac
for device in $(ip -4 -o a | cut -d ' ' -f 2); do
    # Skip loopback device
    if [ "$device" = 'lo' ]; then
        continue
    fi

    # Output all IPv4 addresses for this device:
    # most likely, someone will want to access from a wireless IP:
    # just assume that's one whose device name starts with 'w'
    for ip in $(ip -4 -o a show dev "$device" | cut -d ' ' -f 7| cut -d '/' -f 1); do
        note=''
        if [[ "$device" == wl* ]]; then
            note="(wireless: try this first)"
        fi
        echo -n '- '
        printf "https://%-16s %s\n" "$ip/" "$note"
    done
done
