#!/usr/bin/env bash

declare LTI_DEVKIT_ENABLE
declare LTI_DEVKIT_PUBLISHED_PORT
declare PRIMARY_INSTANCE_HOSTNAME
declare SECONDARY_INSTANCE_ENABLE
declare SECONDARY_INSTANCE_HOSTNAME
declare PROVISION_DEBUG_ENABLE

source "$(dirname "$0")/functions"

load_config

# Always run within root folder
cd "$(dirname "$0")/.." || exit 1

# Parse args for --install-instance-only
provision_args=''
errors='0'
while [[ $# -gt 0 ]]; do
    case $1 in
        --install-instance-only )
            provision_args="--install-instance-only"
            shift
            ;;
        *)
            log "Unrecognised option: '$1'"
            shift # past argument
            errors="1"
            ;;
    esac
done
if [[ $errors == "1" ]]; then
    exit 1
fi

# Need to pass timezone as an env arg to provision
env_args="-e CONFIG_DATE_TIMEZONE=${TIMEZONE}"

# If _not_ debugging provisioning:
# run all of these commands with an empty Xdebug config (no IDE key), so that
# they do not trigger breakpoints.
case "${PROVISION_DEBUG_ENABLE}" in
    1 | true | yes | on)
        ;;
    *)
        env_args+=' -e XDEBUG_CONFIG='
        ;;
esac

# Run the provision script in the schoolbox-cli container
"$(dirname "$0")/compose" exec -it $env_args -u root schoolbox-cli tools/docker-provision.sh $provision_args

# Is the second env in action?
# If so, re-run the provision script for INSTANCE_ID=docker2
case "${SECONDARY_INSTANCE_ENABLE}" in
    1 | true | yes | on)
        "$(dirname "$0")/compose" exec -it -e INSTANCE_ID=docker2 $env_args -u root schoolbox-cli tools/docker-provision.sh --install-instance-only
        ;;
esac

# restart the web server and reverse proxy containers,
# so that any changes in configuration are respected
"$(dirname "$0")/compose" restart caddy schoolbox-frankenphp

# If using devkit:
# install its SQL, reading:
# * public key from lti dir config/keys/public.key
# * port from LTI_DEVKIT_PUBLISHED_PORT
# extract the newly created LTI tool's deployment ID
case "${LTI_DEVKIT_ENABLE}" in
    1 | true | yes | on)
        export LTI_DEVKIT_PUBLISHED_PORT=${LTI_DEVKIT_PUBLISHED_PORT}
        export PRIMARY_INSTANCE_HOSTNAME=${PRIMARY_INSTANCE_HOSTNAME}
        export SCHOOLBOX_PLATFORM_PUBLIC_KEY=$("$(dirname "$0")/compose" exec -it $env_args schoolbox-cli tools/instance-mariadb.sh \
            --skip-column-names --batch --raw \
            -e "SELECT value FROM config WHERE name='jwt_public_key'" \
            | sed -e 's/[[:space:]]*$//' )
        export SCHOOLBOX_PLATFORM_DEPLOYMENT_ID=$("$(dirname "$0")/compose" exec -it $env_args schoolbox-cli "tools/provision/create-devkit-lti-tool.php" \
            --key "$(cat ../devkit-lti1p3/config/keys/public.key)" \
            --host "http://devkit-lti1p3.localhost:${LTI_DEVKIT_PUBLISHED_PORT}" \
            | sed -e 's/[[:space:]]*$//' )

        envsubst < ./docker/devkit-lti1p3-phpfpm/env.template > ./docker/devkit-lti1p3-phpfpm/.env
        printf '%s\n%s\n' "# Do not edit this file: autogenerated by docker/provision" "$(cat ./docker/devkit-lti1p3-phpfpm/.env)" > ./docker/devkit-lti1p3-phpfpm/.env

        # restart now, with the new .env file
        "$(dirname "$0")/compose" up -d devkit-lti1p3-phpfpm
        ;;

esac

# Output the URLs/IPs which this instance may be accessed from:
echo "Access the Schoolbox development instance via the following local URLs:"
echo "This machine only:"
echo "- https://${PRIMARY_INSTANCE_HOSTNAME}/"
case "${SECONDARY_INSTANCE_ENABLE}" in
    1 | true | yes | on)
        echo "- https://${SECONDARY_INSTANCE_HOSTNAME}/ (separate instance)"
        echo "Other machines on this network (${PRIMARY_INSTANCE_HOSTNAME} only):"
        ;;
    * )
        echo "Other machines on this network:"
        ;;
esac
for device in $(ip -4 -o a | cut -d ' ' -f 2); do
    # Skip loopback device
    if [ "$device" = 'lo' ]; then
        continue
    fi

    # Output all IPv4 addresses for this device:
    # most likely, someone will want to access from a wireless IP:
    # just assume that's one whose device name starts with 'w'
    for ip in $(ip -4 -o a show dev "$device" | cut -d ' ' -f 7| cut -d '/' -f 1); do
        note=''
        if [[ "$device" == wl* ]]; then
            note="(wireless: try this first)"
        fi
        echo -n '- '
        printf "https://%-16s %s\n" "$ip/" "$note"
    done
done
