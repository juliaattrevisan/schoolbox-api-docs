#!/usr/bin/env sh

# Always run within root folder
cd "$(dirname "$0")/.." || exit 1

# Stop containers for all docker-compose configurations:
# don't need to stop all possible permutations, just need to ensure each
# taskd and frankenphp variant is stopped at least once.
docker compose --progress plain \
    -f "docker/base.docker-compose.yaml" \
    -f "docker/schoolbox-taskd-local.docker-compose.yaml" \
    -f "docker/schoolbox-frankenphp-local.docker-compose.yaml" \
    down

docker compose --progress plain \
    -f "docker/base.docker-compose.yaml" \
    -f "docker/schoolbox-taskd-prebuilt.docker-compose.yaml" \
    -f "docker/schoolbox-frankenphp-deploy.docker-compose.yaml" \
    down
