# Configure the site env and the log and cache dirs to one readable by www-data
APP_ENV=dev
APP_CACHE_DIR=/tmp/devkit/dev/cache
APP_LOG_DIR=/tmp/devkit/dev/log

# These env vars override whatever is in the devkit's .env
APP_HOST=http://${LTI_DEVKIT_HOSTNAME}:${LTI_DEVKIT_PUBLISHED_PORT}
REDIS_CACHE_DSN=redis://redis-cache:6379

# Schoolbox integration configuration
SCHOOLBOX_PLATFORM_HOST="https://${PRIMARY_INSTANCE_HOSTNAME}"
SCHOOLBOX_PLATFORM_PUBLIC_KEY="
${SCHOOLBOX_PLATFORM_PUBLIC_KEY}"
SCHOOLBOX_REGISTRATION_DEPLOYMENT_ID="${SCHOOLBOX_PLATFORM_DEPLOYMENT_ID}"
