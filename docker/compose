#!/usr/bin/env bash

declare PROJECT_NAME
declare SCHOOLBOX_CLI_IMAGE_BUILD_FROM_LOCAL
declare TASKD_BUILD_FROM_LOCAL
declare TOOLSD_BUILD_FROM_LOCAL
declare LTI_DEVKIT_ENABLE
declare SECONDARY_INSTANCE_ENABLE

source "$(dirname "$0")/functions"

load_config

# For now the FrankenPHP compose file is hardcoded:
# eventually, this may allow loading the deployable variant of the
# FrankenPHP container.
frankenphp_compose_file="docker/schoolbox-frankenphp/dev.docker-compose.yaml"

# Which schoolbox-cli compose file is used?
# A different one is used when using a locally built image, vs. using one pulled
# from the private container registry.
schoolbox_cli_compose_file=''
case "${SCHOOLBOX_CLI_IMAGE_BUILD_FROM_LOCAL}" in
    1 | true | yes | on)
        schoolbox_cli_compose_file="docker/schoolbox-cli/local.docker-compose.yaml"
        ;;
    *)
        schoolbox_cli_compose_file="docker/schoolbox-cli/prebuilt.docker-compose.yaml"
        ;;
esac

# Which task daemon compose file is used?
# Like schoolbox-cli: a different one is used when using a locally built vs.
# prebuilt image.
taskd_compose_file=''
case "${TASKD_BUILD_FROM_LOCAL}" in
    1 | true | yes | on)
        taskd_compose_file="docker/schoolbox-taskd/dev.docker-compose.yaml"
        ;;
    *)
        taskd_compose_file="docker/schoolbox-taskd/deploy.docker-compose.yaml"
        ;;
esac

# Which tools daemon compose file is used?
# Like schoolbox-cli: a different one is used when using a locally built vs.
# prebuilt image.
toolsd_compose_file=''
case "${TOOLSD_BUILD_FROM_LOCAL}" in
    1 | true | yes | on)
        toolsd_compose_file="docker/schoolbox-toolsd/dev.docker-compose.yaml"
        ;;
    *)
        toolsd_compose_file="docker/schoolbox-toolsd/deploy.docker-compose.yaml"
        ;;
esac

# Build args
args=(
    --progress plain
    -p "${PROJECT_NAME}" \
    -f "docker/base.docker-compose.yaml" \
    -f "${frankenphp_compose_file}" \
    -f "${schoolbox_cli_compose_file}" \
    -f "${taskd_compose_file}" \
    -f "${toolsd_compose_file}" \
)

# Build profiles
case "${LTI_DEVKIT_ENABLE}" in
    1 | true | yes | on)
        args+=(--profile lti)
        ;;
esac
case "${SECONDARY_INSTANCE_ENABLE}" in
    1 | true | yes | on)
        args+=(--profile second-instance)
        ;;
esac
args+=(--env-file .docker-compose.env)

# Run docker compose with whatever the appropriate profiles are.
docker compose "${args[@]}" "$@"
