docker.dev.schoolbox.cloud:1081 {
    #tls /etc/nginx/certs/schoolbox-vagrantx-fullchain.crt /etc/nginx/certs/schoolbox-vagrantx-private.key
    tls internal
    root * /usr/share/schoolbox/www
    php_fastcgi localhost:9000 {
        try_files private/auth.php

        @good status 200
        handle_response @good {
            rewrite {http.request.orig_uri}
            reverse_proxy localhost:1080
        }
        handle_response {
            respond {rp.status_text} {rp.status_code}
        }
    }
}

docker-dav.dev.schoolbox.cloud {
    #tls /etc/nginx/certs/schoolbox-vagrantx-fullchain.crt /etc/nginx/certs/schoolbox-vagrantx-private.key
    tls internal
    root * /usr/share/schoolbox/dav
    #import headers
    php_fastcgi localhost:9000
    handle_errors 404 {
        rewrite * /index.php?page=common/404
    }
    handle_errors {
        respond "{err.status_code} {err.status_text}"
    }
}

