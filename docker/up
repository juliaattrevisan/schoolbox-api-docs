#!/usr/bin/env bash

source "$(dirname "$0")/functions"

# Always run within root folder
cd "$(dirname "$0")/.." || exit 1

declare PHP_MAJOR_VERSION
declare MARIADB_MAJOR_VERSION
declare REDIS_MAJOR_VERSION
declare RABBITMQ_MAJOR_VERSION
declare ETHERPAD_MAJOR_VERSION
declare HTTP_PUBLISHED_PORT
declare HTTPS_PUBLISHED_PORT
declare REDIS_STORAGE_PUBLISHED_PORT
declare REDIS_CACHE_PUBLISHED_PORT
declare RABBITMQ_MANAGEMENT_PUBLISHED_PORT
declare BASE_PHP_IMAGE_BUILD_FROM_LOCAL
declare SCHOOLBOX_CLI_IMAGE_BUILD_FROM_LOCAL
declare TASKD_BUILD_FROM_LOCAL
declare PRIVATE_CONTAINER_REGISTRY_TYPE
declare PRIVATE_CONTAINER_REGISTRY_DOCKERHUB_USERNAME
declare PRIVATE_CONTAINER_REGISTRY_ECR_ACCOUNT_ID
declare PRIVATE_CONTAINER_REGISTRY_ECR_REGION
declare AWS_REGION
declare AWS_START_URL
declare AWS_SSO_AUTO_OPEN_BROWSER
declare AWS_SSO_PASSTHROUGH_CREDENTIALS
declare PHPSTORM_SERVER_NAME
declare SENTRY_DSN
declare SENTRY_ERROR_SAMPLE_RATE
declare SENTRY_TRACE_SAMPLE_RATE
declare SENTRY_PROFILE_SAMPLE_RATE
declare LTI_DEVKIT_PUBLISHED_PORT
declare MAILCATCHER_UI_PUBLISHED_PORT
declare SECOND_INSTANCE_ENABLE
declare SYNERGETIC_PASSWORD_ENCRYPTION_KEY
declare SYNERGETIC_PASSWORD_ENCRYPTION_IV
declare INSTANCE_REGISTRY_URL
declare INSTANCE_REGISTRY_API_KEY
declare TIMEZONE

declare private_container_registry
declare base_php_image
declare base_branch
declare schoolbox_cli_image
declare docker_compose_args

function verify_executables() {
    log "Verifying Docker installed..."
    if ! which docker > /dev/null; then
        log "Docker not installed. Visit either:"
        log "* https://docs.docker.com/engine/install/ for instructions on installing the Docker CLI tools only"
        log "* https://www.docker.com/products/docker-desktop/ for instructions on installing the Docker Desktop application"
        exit 1
    fi

    log "Verifying current user has permission to run Docker..."
    if ! docker info > /dev/null 2>&1; then
        log "Current user does not have permission to run Docker. Either:"
        log "* run as \`sudo\`"
        log "* add the current user to the \`docker\` group: https://docs.docker.com/engine/install/linux-postinstall/#manage-docker-as-a-non-root-user"
        exit 1
    fi

    log "Verifying AWS CLI installed..."
    if ! which aws > /dev/null; then
        log "AWS CLI not installed."
        log "Visit https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html for instructions on installation."
        exit 1
    fi
}

function output_help() {
    if [[ "$*" =~ '--help' ]] || [[ "$*" =~ '-h' ]] ; then
        docker compose up --help;
        exit;
    fi
}

function create_dirs() {
    # ensure that the AWS folder exists
    mkdir -p .aws

    # ensure that the storage folders exist
    mkdir -p ./data/docker/storage
    mkdir -p ./data/docker2/storage

    # ensure the ssl cert folder exists (schoolbox-cli / caddy share):
    # schoolbox-cli must download them so that the Caddy container can use them.
    mkdir -p ./data/docker/ssl
    mkdir -p ./data/docker2/ssl
}

function login_to_aws() {
    # Preconfigure an AWS profile and SSO session, just for this script.
    # it's not possible to pass `aws configure sso` a region or start URL, so
    # that needs to be in the pre-configured AWS config.
    aws_profile='schoolbox-docker'
    echo "
    [default]
    sso_session = ${aws_profile}
    sso_account_id = ${AWS_ACCOUNT_ID}
    sso_role_name = ${AWS_ROLE_NAME}
    region = ${AWS_REGION}

    [sso-session ${aws_profile}]
    sso_region = ${AWS_REGION}
    sso_start_url = ${AWS_START_URL}"  | sed -e 's/^[ \t]*//' > .aws/config

    # Then log in to AWS, if not already logged in
    log "Testing if logged in to AWS (region: ${AWS_REGION})..."
    if ! AWS_CONFIG_FILE=.aws/config aws configure list > /dev/null; then
        log "Not logged in to AWS: logging in"
        # Check whether to open a browser or not
        if [ "${AWS_SSO_AUTO_OPEN_BROWSER}" -eq 0 ]; then
            AWS_CONFIG_FILE=.aws/config aws sso login --no-browser --use-device-code
        elif [ "$(id -u)" -eq 0 ]; then
            log "Running as root, but AWS_SSO_AUTO_OPEN_BROWSER is on: ignoring"
            AWS_CONFIG_FILE=.aws/config aws sso login --no-browser --use-device-code
        else
            AWS_CONFIG_FILE=.aws/config aws sso login --use-device-code
        fi
    else
        log "Logged in to AWS: continuing"
    fi
}

function login_to_container_registry() {
    # Log into whatever repository, as long as not already logged into it
    test_image='taskd'
    case "${PRIVATE_CONTAINER_REGISTRY_TYPE}" in
        dockerhub )
            private_container_registry="docker.io/${PRIVATE_CONTAINER_REGISTRY_DOCKERHUB_USERNAME}"
            # Test if logged into repo by fetching the test image manifest:
            # if not, then login
            log "Testing if logged in to private container registry ${private_container_registry}..."
            docker manifest inspect "${private_container_registry}/${test_image}" > /dev/null
            if [ ! $? -eq 0 ]; then
                log "Not logged in to private container registry: logging in"
                docker login -u "${PRIVATE_CONTAINER_REGISTRY_DOCKERHUB_USERNAME}"
            else
                log "Logged in to private container registry: continuing"
            fi
            ;;
        ecr )
            private_container_registry="${PRIVATE_CONTAINER_REGISTRY_ECR_ACCOUNT_ID}.dkr.ecr.${PRIVATE_CONTAINER_REGISTRY_ECR_REGION}.amazonaws.com"
            # As with the Dockerhub variant:
            # test if logged in by fetching an image manifest, if not then login
            log "Testing if logged in to private container registry ${private_container_registry}..."
            docker manifest inspect "${private_container_registry}/${test_image}" > /dev/null
            if [ ! $? -eq 0 ]; then
                log "Not logged in to private container registry: logging in"
                AWS_CONFIG_FILE=.aws/config aws ecr get-login-password --region "${PRIVATE_CONTAINER_REGISTRY_ECR_REGION}" \
                    | docker login -u AWS --password-stdin "${private_container_registry}"
            else
                log "Logged in to private container registry: continuing"
            fi
            ;;
        * )
            log "Invalid PRIVATE_CONTAINER_REGISTRY_TYPE value ${PRIVATE_CONTAINER_REGISTRY_TYPE}: must be dockerhub or ecr" >&2
            exit 1
            ;;
    esac
}

function build_docker_compose_env() {
    # Put private repository and AWS credentials into an env file for docker compose
    declare aws_credentials
    case "${AWS_SSO_PASSTHROUGH_CREDENTIALS}" in
        1 | true | yes | on)
            aws_credentials=$(AWS_CONFIG_FILE=.aws/config aws configure export-credentials --format=env-no-export)
            ;;
        *)
            aws_credentials=""
            ;;
    esac
    echo "# Do not edit this file: autogenerated by docker/up
    ENV=\"dev\"
    PHP_MAJOR_VERSION=\"${PHP_MAJOR_VERSION}\"
    MARIADB_MAJOR_VERSION=\"${MARIADB_MAJOR_VERSION}\"
    REDIS_MAJOR_VERSION=\"${REDIS_MAJOR_VERSION}\"
    HTTP_PUBLISHED_PORT=\"${HTTP_PUBLISHED_PORT}\"
    HTTPS_PUBLISHED_PORT=\"${HTTPS_PUBLISHED_PORT}\"
    MARIADB_PUBLISHED_PORT=\"${MARIADB_PUBLISHED_PORT}\"
    REDIS_STORAGE_PUBLISHED_PORT=\"${REDIS_STORAGE_PUBLISHED_PORT}\"
    REDIS_CACHE_PUBLISHED_PORT=\"${REDIS_CACHE_PUBLISHED_PORT}\"
    RABBITMQ_MAJOR_VERSION=\"${RABBITMQ_MAJOR_VERSION}\"
    ETHERPAD_MAJOR_VERSION=\"${ETHERPAD_MAJOR_VERSION}\"
    PRIVATE_CONTAINER_REGISTRY=\"${private_container_registry}\"
    INSTANCE_ID=\"docker\"
    PHPSTORM_SERVER_NAME=\"${PHPSTORM_SERVER_NAME}\"
    BASE_PHP_IMAGE=\"${base_php_image}\"
    SCHOOLBOX_CLI_IMAGE=\"${schoolbox_cli_image}\"
    BASE_BRANCH=\"${base_branch}\"
    LTI_DEVKIT_PUBLISHED_PORT=\"${LTI_DEVKIT_PUBLISHED_PORT}\"
    MAILCATCHER_UI_PUBLISHED_PORT=\"${MAILCATCHER_UI_PUBLISHED_PORT}\"
    RABBITMQ_MANAGEMENT_PUBLISHED_PORT=\"${RABBITMQ_MANAGEMENT_PUBLISHED_PORT}\"
    SYNERGETIC_PASSWORD_ENCRYPTION_KEY=\"${SYNERGETIC_PASSWORD_ENCRYPTION_KEY}\"
    SYNERGETIC_PASSWORD_ENCRYPTION_IV=\"${SYNERGETIC_PASSWORD_ENCRYPTION_IV}\"
    ${aws_credentials}" | sed -e 's/^[ \t]*//' > .docker-compose.env
}

function build_schoolbox_config_ini() {
    echo "# Do not edit this file: autogenerated by docker/up
    $(cat ./docker/schoolbox/config/config.default.ini)
    SENTRY_DSN                     = '${SENTRY_DSN}'
    SENTRY_ERROR_SAMPLE_RATE       = ${SENTRY_ERROR_SAMPLE_RATE}
    SENTRY_TRACE_SAMPLE_RATE       = ${SENTRY_TRACE_SAMPLE_RATE}
    SENTRY_PROFILE_SAMPLE_RATE     = ${SENTRY_PROFILE_SAMPLE_RATE}" | sed -e 's/^[ \t]*//' > ./docker/schoolbox/config/config.ini
}

function build_instance_registry_json() {
  echo -e \
    "{\n" \
    "  \"instance_registry_url_override\": \"${INSTANCE_REGISTRY_URL}\",\n" \
    "  \"instance_registry_api_token\": \"${INSTANCE_REGISTRY_API_KEY}\"\n" \
    "}" > ./docker/schoolbox/config/instance-registry.json
}

function build_schoolbox_cron_config_ini() {
    local timezone;
    if [[ -z "${TIMEZONE}" ]]; then
        timezone="$(readlink /etc/localtime | sed 's/\/usr\/share\/zoneinfo\///')"
    else
        timezone="${TIMEZONE}"
    fi
    # Hardcode UPS run time to 22:00 for now, I suppose?
    echo "# Do not edit this file: autogenerated by docker/up
    docker;${timezone};22:00;/var/log/schoolbox/docker
    docker2;${timezone};22:00;/var/log/schoolbox/docker2
    " | sed -e 's/^[ \t]*//' > ./docker/schoolbox/config/cron_config.ini
}

function build_image_names() {
    # Determine base image tag from current branch:
    # assume master if nothing better known.
    # Possibly, if the current branch is very old then the current master-tagged
    # image won't work:
    # in that case, must use BASE_PHP_IMAGE_BUILD_FROM_LOCAL=1.
    # Anyway, what's the branch name?
    branch_name=$(git rev-parse --abbrev-ref HEAD 2> /dev/null) || exit
    base_branch="master"
    if [[ $branch_name =~ develop ]]; then
        base_branch="develop"
    fi

    # determine base images for PHP and schoolbox-cli:
    # note that if the base image is built locally, then the schoolbox-cli image
    # is as well.
    case "${BASE_PHP_IMAGE_BUILD_FROM_LOCAL}" in
        1 | true | yes | on)
            SCHOOLBOX_CLI_IMAGE_BUILD_FROM_LOCAL=1
            base_branch="master"
            base_php_image="php-frankenphp"
            ;;
        *)
            base_php_image="${private_container_registry}/frankenphp-base:latest-php${PHP_MAJOR_VERSION}-dev-${base_branch}"
            ;;
    esac

    case "${SCHOOLBOX_CLI_IMAGE_BUILD_FROM_LOCAL}" in
        1 | true | yes | on)
            base_branch="master"
            schoolbox_cli_image="schoolbox-cli"
            ;;
        *)
            schoolbox_cli_image="${private_container_registry}/schoolbox-cli:latest-php${PHP_MAJOR_VERSION}-dev-${base_branch}"
            ;;
    esac
}

function build_docker_compose_args() {
    # Currently, this is simply the list of parameters from the CLI:
    # future versions may be more sophisticated in what they allow.
    docker_compose_args="$*"
}

function start_containers() {
    # Build base PHP image locally if required before starting the default env,
    # as containers rely upon it.
    case "${BASE_PHP_IMAGE_BUILD_FROM_LOCAL}" in
        1 | true | yes | on)
            docker build --progress=plain \
                -t "${base_php_image}" \
                --build-arg "ENV=dev" \
                --build-arg "PHP_MAJOR_VERSION=${PHP_MAJOR_VERSION}" \
                "docker/base-images/php-frankenphp/"
            ;;
        *)
            ;;
    esac

    # If TASKD_BUILD_FROM_LOCAL:
    # run `composer install` locally
    case "${TASKD_BUILD_FROM_LOCAL}" in
        1 | true | yes | on)
            (cd ../taskd && docker run -it \
                --volume $PWD:/app \
                --user "${SUDO_UID:-$(id -u)}:${SUDO_GID:-$(id -g)}" \
                composer:2.8 \
                install --ignore-platform-reqs
            )
            ;;
        *)
            ;;
    esac

    # start default environment:
    # this has Schoolbox's code folder mounted as a local mount, thus changes
    # made locally are available immediately within the container.
    "$(dirname "$0")/compose" up -d $docker_compose_args

    # if using a remote schoolbox-cli image is built:
    # tag the remote image with the "docker-schoolbox-cli" tag, so that there is
    # a local image with a consistent name for running scripts.
    case "${SCHOOLBOX_CLI_IMAGE_BUILD_FROM_LOCAL}" in
        1 | true | yes | on)
            ;;
        *)
            docker tag "${schoolbox_cli_image}" "docker-schoolbox-cli"
            ;;
    esac

    # start cron in schoolbox-cli container, so that cron tasks actually run:
    # even though this is in a post_start in docker/base.docker-compose.yaml,
    # it is not guaranteed to run on docker/up
    docker exec -it schoolbox-cli sudo /etc/init.d/cron start

    # Also rebuild cronjobs
    docker exec -it schoolbox-cli sudo cloud-rebuild-cronjobs --is-primary-host 1 --instance docker
    case "${SECOND_INSTANCE_ENABLE}" in
        1 | true | yes | on)
            docker exec -it schoolbox-cli sudo cloud-rebuild-cronjobs --is-primary-host 1 --instance docker2
            ;;
    esac

    # Create vhosts in rabbitmq container:
    # this can't be done in post_start, because the container's not healthy at
    # that time
    docker exec -it rabbitmq rabbitmqctl add_vhost docker
    docker exec -it rabbitmq rabbitmqctl set_permissions -p docker guest ".*" ".*" ".*"
    "$(dirname "$0")/compose" restart schoolbox-scheduled schoolbox-mobiled
    case "${SECOND_INSTANCE_ENABLE}" in
        1 | true | yes | on)
            docker exec -it rabbitmq rabbitmqctl add_vhost docker2
            docker exec -it rabbitmq rabbitmqctl set_permissions -p docker2 guest ".*" ".*" ".*"
            "$(dirname "$0")/compose" restart schoolbox2-scheduled schoolbox2-mobiled
            ;;
    esac
}

function main() {
    verify_executables
    output_help "$@"
    create_dirs
    load_config
    login_to_aws
    login_to_container_registry
    build_image_names
    build_docker_compose_args "$@"
    build_docker_compose_env
    build_schoolbox_config_ini
    build_instance_registry_json
    build_schoolbox_cron_config_ini
    start_containers "$@"
}

main "$@"
