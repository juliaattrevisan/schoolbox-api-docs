#!/usr/bin/env bash

# Always run within root folder
cd "$(dirname "$0")/.." || exit 1

declare taskd_compose_file

# For now this is hardcoded
declare frankenphp_compose_file="docker/schoolbox-frankenphp-local.docker-compose.yaml"

# Load config to figure out which taskd compose file to use
declare taskd_build_from_local
source ./docker.default.ini
source ./docker.ini
case "${taskd_build_from_local}" in
    1 | true | on)
        taskd_compose_file="docker/schoolbox-taskd-local.docker-compose.yaml"
        ;;
    *)
        taskd_compose_file="docker/schoolbox-taskd-prebuilt.docker-compose.yaml"
        ;;
esac

# ensure that the storage folder exists
mkdir -p ./data/docker/storage

# currently, the `php82-bookworm` image must be built locally before everything
# else
docker compose --progress plain \
    -f "docker/base.docker-compose.yaml" \
    -f "${frankenphp_compose_file}" \
    -f "${taskd_compose_file}" \
    build php82-bookworm

# start default environment:
# this has Schoolbox's code folder mounted as a local mount, thus changes made
# locally are available immediately within the container.
docker compose --progress plain \
    -f "docker/base.docker-compose.yaml" \
    -f "${frankenphp_compose_file}" \
    -f "${taskd_compose_file}" \
    up -d
