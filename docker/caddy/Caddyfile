vagrant.dev.schoolbox.cloud:80 {
    handle_path /.well-known/acme-challenge/ping {
        respond "port 80 accessible from your location\n" 200
    }
    redir https://{host}{uri} 308
}

vagrant.dev.schoolbox.cloud:443 {
    #tls /etc/nginx/certs/schoolbox-vagrantx-fullchain.crt /etc/nginx/certs/schoolbox-vagrantx-private.key
    tls internal
    log {
        output stdout
    }
    root * /usr/share/schoolbox/www
    # What's this?
    #import headers
    @allowed-methods method GET HEAD POST PUT DELETE PATCH OPTIONS
    @disallowed-methods not {
        method GET HEAD POST PUT DELETE PATCH OPTIONS
    }
    error @disallowed-methods "Method {method} Not Allowed" 405
    handle_path /static/images/core/fail-whale.png {
        rewrite * /images/core/fail-whale.png
        reverse_proxy https://schoolbox-static.cloud {
            header_up host {http.reverse_proxy.upstream.hostport}
        }
    }
    handle_path /static/images/core/icons/fail-whale-16x16.png {
        rewrite * /images/core/icons/fail-whale-16x16.png
        reverse_proxy https://schoolbox-static.cloud {
            header_up host {http.reverse_proxy.upstream.hostport}
        }
    }
    handle_path /favicon.ico {
        rewrite * /images/logo.php?logo=skin_logo_square&size=favicon
    }
    handle_errors 404 {
        rewrite * /index.php?page=common/404
    }
    handle_errors 502 {
        root * /usr/share/schoolbox/templates/core/error
        rewrite * 502-bad-gateway.html
        file_server
    }
    handle_errors 503 {
        root * /usr/share/schoolbox/templates/core/error
        rewrite * 503-maintenance.html
        file_server
    }
    handle_errors 504 {
        root * /usr/share/schoolbox/templates/core/error
        rewrite * 504-gateway-timeout.html
        file_server
    }
    handle_errors 500 {
        respond "an error occurred. please try again later." 500
    }
    handle_errors 429 {
        root * /usr/share/schoolbox/templates/core/error
        rewrite * 429-rate-limit.html
        file_server
    }

    handle_errors {
        respond "{err.status_code} {err.status_text}"
    }

    handle_path /websocket {
        reverse_proxy php-fpm:9081
    }
    handle_path /pad* {
        reverse_proxy php-fpm:9001
    }
    @images path_regexp (portrait|videothumb|cms/(image|myimage)|images/(fail|icon|logo)|(socialstream|storage)/image)\.php$
    handle @images {
        log_skip *
        php_fastcgi php-fpm:9002 {
            try_files index.php
        }
    }

    handle_path /awstats-icon* {
        root * /usr/share/awstats/icon
        file_server
    }
    handle_path /awstats* {
        php_fastcgi php-fpm:9000 {
            try_files private/auth.php
            env X-Original-URI {http.request.orig_uri}

            @good status 200
            handle_response @good {
                root * /var/awstats
                @root expression {http.request.orig_uri.path} == "/awstats/"
                rewrite @root awstats.awstats.conf.html
                rewrite {http.request.orig_uri.path}
                uri strip_prefix /awstats
                file_server
            }
            handle_response {
                respond {rp.status_text} {rp.status_code}
            }
        }
    }
    handle_path /debugbar* {
        root * /usr/share/schoolbox/vendor/maximebf/debugbar/src/DebugBar/Resources
    }
    handle /static* {
        file_server
    }

    log_skip /static*
    log_skip /favicon.ico
    log_skip /css*
    log_skip /websocket
    log_skip /pad*
    log_skip /service-worker.js
    log_skip /manifest
    encode  zstd  gzip
    php_fastcgi php-fpm:9000 {
            try_files index.php
    }
    file_server
}

vagrant.dev.schoolbox.cloud:1081 {
    #tls /etc/nginx/certs/schoolbox-vagrantx-fullchain.crt /etc/nginx/certs/schoolbox-vagrantx-private.key
    tls internal
    root * /usr/share/schoolbox/www
    php_fastcgi php-fpm:9000 {
        try_files private/auth.php

        @good status 200
        handle_response @good {
            rewrite {http.request.orig_uri}
            reverse_proxy php-fpm:1080
        }
        handle_response {
            respond {rp.status_text} {rp.status_code}
        }
    }
}



vagrant-dav.dev.schoolbox.cloud {
    #tls /etc/nginx/certs/schoolbox-vagrantx-fullchain.crt /etc/nginx/certs/schoolbox-vagrantx-private.key
    tls internal
    root * /usr/share/schoolbox/dav
    #import headers
    php_fastcgi php-fpm:9000
    handle_errors 404 {
        rewrite * /index.php?page=common/404
    }
    handle_errors {
        respond "{err.status_code} {err.status_text}"
    }
}

