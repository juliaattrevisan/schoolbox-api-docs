#!/usr/bin/env php
<?php
/**
 * @copyright   Copyright 2019, Schoolbox Pty Ltd
 * @link        https://schoolbox.com.au/
 */

// Reads Schoolbox config and returns in JSON format
$options = getopt('', ['conf::', 'option::']);

$confFile = $options['conf'] ?? '/usr/share/schoolbox/www/conf/conf.php';

require $confFile;

$conf = [
    'conffile'         => $confFile,
    'SITE_root'        => SITE_root,
    'WEB_root'         => WEB_root,
    'TEMPLATE_body'    => TEMPLATE_body,
    'TEMPLATE_content' => TEMPLATE_content,
    'SQL_host'         => SQL_host,
    'SQL_user'         => SQL_user,
    'SQL_passwd'       => SQL_passwd,
    'SQL_db'           => SQL_db,
    'SQL_dsn'          => SQL_dsn,
    'INSTANCE_ID'      => INSTANCE_ID,
    'SENTRY_TOKEN'     => SENTRY_TOKEN,
    'SENTRY_PROJECT'   => SENTRY_PROJECT,
    'ETHERPAD_HOST'    => 'http://localhost:9001',
];

$optionKey = $options['option'] ?? '';

if($optionKey && array_key_exists($optionKey, $conf)){
    echo $conf[$optionKey];
} elseif(in_array($optionKey, ['instancelist', 'instance_list'], true)){
    echo json_encode(defined('INSTANCE_ID_LIST') ? INSTANCE_ID_LIST : [INSTANCE_ID]);
} else {
    echo json_encode($conf);
}
