{
    frankenphp {
        php_ini expose_php off
    }
    metrics
}

:80 {
    log {
        output stdout
    }
    root * /usr/share/schoolbox/www
    # What's this?
    #import headers
    @allowed-methods method GET HEAD POST PUT DELETE PATCH OPTIONS
    @disallowed-methods not {
        method GET HEAD POST PUT DELETE PATCH OPTIONS
    }
    error @disallowed-methods "Method {method} Not Allowed" 405
    handle_path /favicon.ico {
        rewrite * /images/logo.php?logo=skin_logo_square&size=favicon
    }
    handle_errors 404 {
        rewrite * /index.php?page=common/404
    }
    handle_errors 502 {
        root * /usr/share/schoolbox/templates/core/error
        rewrite * 502-bad-gateway.html
        file_server
    }
    handle_errors 503 {
        root * /usr/share/schoolbox/templates/core/error
        rewrite * 503-maintenance.html
        file_server
    }
    handle_errors 504 {
        root * /usr/share/schoolbox/templates/core/error
        rewrite * 504-gateway-timeout.html
        file_server
    }
    handle_errors 500 {
        respond "an error occurred. please try again later." 500
    }
    handle_errors 429 {
        root * /usr/share/schoolbox/templates/core/error
        rewrite * 429-rate-limit.html
        file_server
    }

    handle_errors {
        respond "{err.status_code} {err.status_text}"
    }

    handle_path /health {
        php_server {
            root /usr/share/schoolbox/www
            try_files health.php
        }
    }

    handle_path /websocket {
        reverse_proxy schoolbox-socketd:9081
    }
    handle_path /pad* {
        reverse_proxy schoolbox-etherpad:9001
    }

    handle_path /php-debugbar* {
        file_server
        root * /usr/share/schoolbox/vendor/php-debugbar/php-debugbar/src/DebugBar/Resources
    }
    handle /static* {
        file_server
    }

    log_skip /static*
    log_skip /favicon.ico
    log_skip /css*
    log_skip /websocket
    log_skip /pad*
    log_skip /service-worker.js
    log_skip /manifest
    encode  zstd  gzip
    php_server {
        file_server off
        try_files index.php
        root /usr/share/schoolbox/www
    }
}
