# Fetch current SU password if one exists
function fetch_old_su_password() {
  # If a new install, this table won't exist.
  local table_count;
  table_count=$(mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" -ss -e "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = '$sql_schema' AND TABLE_NAME = 'user'")

  # If table exists, fetch password hash
  if [[ $table_count == 1 ]]; then
    su_password_hash=$(mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -ss -e 'SELECT password FROM user WHERE username = "alaress" LIMIT 1')
  fi
}

# Attempt to fetch existing config if doing a refresh, but don't clobber CLI flags which have precendence
function fetch_existing_config() {
  # If a new install, this table won't exist.
  local table_count;
  table_count=$(mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" -ss -e "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = '$sql_schema' AND TABLE_NAME = 'config'")

  # If table exists, fetch existing config
  if [[ $table_count == 1 ]]; then
    local config_value;
    for config_name in "${config_to_preserve[@]}"; do
      # Only fetch from DB if not already provided as CLI arg
      if [[ ! -v "config[$config_name]" ]]; then
        # Need to distinguish NULL and 'NULL' (string)
        config_value_and_isnull=$(mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -ss -e "SELECT value, value IS NULL FROM config WHERE name = '$config_name' LIMIT 1")
        IFS=$'\t' read -r -a array <<< "$config_value_and_isnull"
        config_value=${array[0]}
        is_null=${array[1]}
        if [[ $is_null == "1" ]]; then
          config[$config_name]="$config_value"
        else
          config[$config_name]="'$config_value'"
        fi
      fi
    done
  fi
}

function validate_config() {
  local errors='0'
  for key in "${required_config[@]}"; do
    if [[ ! -v "config[$key]" ]]; then
      error "You must declare a config value using the --$key flag or have it available from current instance on refresh"
      errors="1"
    fi
  done

  if [[ $skip_bucket_copy == 0 ]]; then
    for key in "${required_config_if_bucket_copy[@]}"; do
      if [[ ! -v "config[$key]" ]]; then
        error "You must declare a config value using the --$key flag or have it available from current instance on refresh when copying the S3 bucket"
        errors="1"
      fi
    done
  fi

  if [[ $errors == "1" ]]; then
    error "Validation errors occurred"
    exit 1
  fi
}


# Download dataset from provided location and extract SQL file
function fetch_dataset_and_extract_database(){
  local instance_data_dir=$1
  log "Fetching dataset '$dataset'..."
  rm -fR "$instance_data_dir";
  mkdir -p "$instance_data_dir";

  # Need to support local-only datasets that are already in the cache dir.
  # In this case, try to fetch from S3, but if not found, only an error if not in cache dir
  local download_s3_file_output;
  local download_s3_file_command;

  if [[ "$dataset_is_url" == true ]]; then
    download_s3_file_command="wget -O $cache_dir/$file_name_short $dataset";
  else
    local script=/usr/share/schoolbox/tools/download-s3-file.sh

    # TODO, remove once all schoolbox packages upgrade past 22.0.2 (at which point these args became required)
    local extra_args=()
    if $script --help 2>/dev/null | grep -q iam-access-key; then
      extra_args+=( --iam-access-key "$iam_access_key" )
      extra_args+=( --iam-secret-key "$iam_secret_key" )
    fi
    if [[ -n $s3_referer  ]]; then
      extra_args+=( --s3-referer "$s3_referer" )
    fi
    download_s3_file_command="$script --data-source $data_source --file-name $dataset ${extra_args[*]} --cache-dir $cache_dir";
  fi
  if ! download_s3_file_output=$($download_s3_file_command 2>&1); then
    if [[ -f "$cache_dir"/"$file_name_short" ]]; then
      log "dataset file found in cache but not S3, using cached version"
    else
      echo "$download_s3_file_output";
      error "Unable to fetch dataset"
      exit 1
    fi
  fi

  if ! tar -C "$instance_data_dir" -xzf "$cache_dir"/"$file_name_short" data/schoolbox.sql --strip-components=1; then
    error "Unable to extract database"
    exit 1
  fi
}

# Extracts the dataset's file, optionally excluding the 'storage_dir' directory
function extract_all_dataset_files(){
  local instance_data_dir=$1
  log "Extracting data dirs from tarball to '$instance_data_dir'"

  # No need to re-extract SQL file. Did caller request to also exclude the storage dir?
  local exclude_options=(--exclude schoolbox.sql)
  if [[ "$no_local_storage" == 1 ]]; then
    local storage_dir_value
    IFS=';' read -r -a array <<< "$data_dirs_config"
    for element in "${array[@]}"; do
      IFS=':' read -r -a sub_array <<< "$element"
      if [[ ${sub_array[0]} == "storage_dir" ]]; then
        storage_dir_value=${sub_array[1]}
        break
      fi
    done
    log "Excluding storage dir '${storage_dir_value}'"
    exclude_options+=(--exclude "${storage_dir_value}")
  fi

  if ! tar -C "$instance_data_dir" -xzf "$cache_dir"/"$file_name_short" data --strip-components=1 "${exclude_options[@]}"; then
    error "Unable to extract data dirs from dataset"
    exit 1
  fi
}

# Returns whether the site version we are deploying to still requires a 'logs_dir' data dir
# Returns:
#   0 if still required (ie < 21.1.4)
#   1 if not required (ie 21.1.4+)
requires_logs_data_dir(){
  local target_site_version;
  target_site_version=$(find /usr/share/schoolbox/updates/ -mindepth 1 -maxdepth 1 -type d -printf "%f\n" | sort -V | tail -n 1)
  log "Deploying to site_version: '$target_site_version'"
  if [[ $(echo -e "$SITE_VERSION_LOGS_DIR_REMOVED\n$target_site_version" | sort -V | head -n 1) == "$SITE_VERSION_LOGS_DIR_REMOVED" ]]; then
    return 1
  fi
  return 0
}

set_ownership_and_permissions(){
  if ! /usr/share/schoolbox/tools/set-config-data-dirs-perms.sh --owner www-data --group www-data --verbose; then
    error "Unable to set data dir ownership and perms"
    exit 1;
  fi
}

# Drop all database views and tables
function empty_schema(){
  log "Dropping all database views..."
  for db_view in $(mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -ss -e 'SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_TYPE LIKE "VIEW"'); do
    if ! mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -e "SET MAX_STATEMENT_TIME=0; DROP view $db_view"; then
      error "Unable to drop database view: $db_view"
      error 1;
    fi
  done

  log "Dropping all database tables..."
  if ! mysqldump --single-transaction --no-tablespaces --add-drop-table --no-data -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" | grep -e '^DROP \| FOREIGN_KEY_CHECKS' | mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema"; then
    error "Unable to drop database tables"
    exit 1;
  fi
}


# Import the SQL dump file into the schema
function import_dataset(){
  local instance_data_dir=$1
  log "Loading dataset into database schema '$sql_schema'..."
  if ! (echo "SET MAX_STATEMENT_TIME=0; "; pv "$instance_data_dir"/schoolbox.sql) | sed -E "s/^\/\*\!50013 DEFINER=.+\*\//\/\* Fallback to default DEFINER \*\//g" | mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema"; then
    error "Unable to import database"
    exit 1;
  fi
  rm "$instance_data_dir"/schoolbox.sql
}


