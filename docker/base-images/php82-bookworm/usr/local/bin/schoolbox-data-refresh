#!/bin/bash
# Refresh a instance using an S3 dataset
#
# This should only be invoked on the primary node in a cluster.
#
# This script has two main use cases:
# 1. Installing a new instance, and
# 2. Refreshing an existing instance
#
# 1. Install:
#   In this case, the instances.ini file won't yet contain an entry for this instance.
#   * SQL credentials must be provided as CLI args. We will pass them to PHP scripts.
#
# 2. Refresh
#   * instances.ini will have an entry for the instance, we can read SQL credentials from that.
#   * will preserves the SU user's password hash.
#
# To support both cases, we cannot rely on instances.ini, and thus must required SQL credentials
# and pass these to any PHP scripts as ENV vars.
#
# Usage:
#        INSTANCE_ID=[INSTANCE_ID] tools/cloud/data-refresh.sh \
#         --dataset [sales.tar.gz] \
#         --plan [PLAN_NAME] \
#         --config [CONFIG_NAME] [CONFIG_VALUE] \
#         --config [CONFIG_NAME] '[CONFIG_VALUE]'
#         ...
# Example - new install (need to provide SQL credentials + rabbitmq config)
#       INSTANCE_ID=vagrantx /usr/share/schoolbox/tools/cloud/data-refresh.sh \
#         --dataset initial.tar.gz \
#         --plan elite \
#         --sql-host localhost --sql-schema schoolbox --sql-user schoolboxvagrant --sql-pass abc123
#         --config  site_hostname "'demo'" \
#         --config  amqp_host     "NULL"
#
# Example - refresh (no need for SQL credentials or rabbitmq config, do need to purge redis)
#       INSTANCE_ID=vagrantx /usr/share/schoolbox/tools/cloud/data-refresh.sh \
#         --dataset initial.tar.gz \
#         --plan elite \
#         --purge-redis
#         --config  site_hostname "'demo'" \

# Global const
readonly LOG=/usr/bin/alaress-logger
readonly READ_IR_CONF=/usr/local/bin/schoolbox-instance-registry
readonly L_INFO=200;
readonly L_WARN=300;
readonly L_ERROR=400;
readonly ARG_DATASET='dataset'
readonly ARG_CONFIG='config'
readonly ARG_SITE_ROOT='site-root'
readonly ARG_SQL_HOST='sql-host'
readonly ARG_SQL_SCHEMA='sql-schema'
readonly ARG_SQL_USER='sql-user'
readonly ARG_SQL_PASS='sql-pass'
readonly ARG_PURGE_REDIS='purge-redis'
readonly ARG_SKIP_BUCKET_COPY='skip-bucket-copy'
readonly ARG_INCREMENT_DATES='increment-dates'
readonly ARG_CACHE_DIR='cache-dir'
readonly ARG_DATA_SOURCE='data-source'
readonly DATA_SOURCE_DEFAULT='https://s3-ap-southeast-2.amazonaws.com/schoolbox-data';
readonly ARG_S3_REFERER='s3-referer'
readonly ARG_IAM_ACCESS_KEY='iam-access-key'
readonly ARG_IAM_SECRET_KEY='iam-secret-key'
readonly ARG_NO_LOCAL_STORAGE='no-local-storage'
readonly ARG_PLAN='plan'
# This is a list of data dir config names over a range of SB versions.
readonly FALLBACK_DATA_DIR_CONFIG='backup_dir:files;dropbox_dir:dropbox;file_dir:files;logs_dir:cache/logs;minify_dir:cache/minify;myfile_dir:myFiles;myfiles_cache_dir:cache/myfiles;portrait_dir:cache/portrait;purifier_cache_dir:purifier;returns_dir:returns;storage_dir:storage;stream_dir:cache/stream;submission_dir:submissions;submission_upload_tmp_dir:cache/submission_upload;thumbnail_dir:thumbnails;twig_cache_dir:twig;video_dir:video;weather_dir:cache/weather;xml_dir:cache/xml;zip_dir:cache/zip';
readonly SITE_VERSION_LOGS_DIR_REMOVED="21.1.4" # In this version, the 'logs_dir' data dir config was removed
readonly PLAN_CUSTOM='custom';
readonly SITE_PLANS_VALID=("$PLAN_CUSTOM" portal portalplus wellbeing basic pro elite canvasplus canvas)

# Global vars and defaults
declare dataset;            # eg 'sales.tar.gz?versionId=abc'
declare file_name_short;    # The name we use on local disk, eg 'sales.tar.gz'
declare sql_user;           # Puppet may not yet have provisioned instances.ini for this instance (eg install via IR)
declare sql_passwd;
declare sql_host;
declare sql_schema;
declare su_password_hash;   # Needs to be preserved during refresh, ignored on new install
declare purge_redis=0;      # Should we purge redis data ? (install=>no, refresh=>yes)
declare skip_bucket_copy=0; # Should we skip the AWS S3 bucket copy ? (vagrant-provision=>yes, otherwise=>no)
declare increment_dates=0;  # Should we increment dates on refresh?
declare -A config;          # All the config we will set
declare cache_dir='/tmp'    # Default cache directory to work in
declare data_source="$DATA_SOURCE_DEFAULT"
declare s3_referer;
declare iam_access_key
declare iam_secret_key
declare puppet_certname;    # This host's puppet cert name
declare ir_api_key;         # This host's api key for calling the Instance Registry
declare ir_api_url;         # This host's IR endpoint
declare data_dirs_config;   # Configured data dir defaults. eg 'backup_dir:files;dropbox_dir:dropbox,storage_dir:storage...'
declare dataset_is_url;     # Is the dataset a URL?
declare plan

# Assume these are always required. (if we wish to override this assumption, add a new flag to support that)
declare required_config=(amqp_host amqp_user amqp_pass amqp_vhost redis_url site_hostname site_domain title site_school_code)

# These are required if copying the bucket
declare required_config_if_bucket_copy=(otfs_s3_bucket otfs_s3_cred_key otfs_s3_cred_secret)

# Attempt to preserve these if they already exist (eg on refresh), but respect CLI if provided
declare config_to_preserve=(amqp_host amqp_user amqp_pass amqp_vhost redis_ephemeral_url taskd_redis_url otfs_s3_alt_host otfs_s3_alt_bucket otfs_s3_alt_region otfs_s3_alt_bucket otfs_s3_alt_access_key otfs_s3_alt_secret_key)

function log(){
  $LOG $L_INFO "$1"
}

function warn(){
  $LOG $L_WARN "$1"
}

function error(){
  $LOG $L_ERROR "$1"
}

# Check scrips is running as root.
function check_run_as_root(){
  if [[ $EUID -ne 0 ]]; then
    error "This script must be run as root"
    exit 1
  fi
}

# Ensure an INSTANCE_ID env var is available
function check_instance_id(){
  if [[ -z "$INSTANCE_ID" ]]; then
    error "You must set an INSTANCE_ID as environment var"
    exit 1
  fi
}

# checks if argument is a URL
function is_url(){
  if [[ "$1" =~ ^https?:// ]]; then
    dataset_is_url=true
  else
    dataset_is_url=false
  fi
}


# Parse ENV + CLI flags
function parse_args(){
  local errors='0'

  while [[ $# -gt 0 ]]; do
    case $1 in
      --"$ARG_PURGE_REDIS")
        purge_redis="1"; shift;
        ;;
      --"$ARG_SKIP_BUCKET_COPY")
        skip_bucket_copy="1"; shift;
        ;;
      --"$ARG_INCREMENT_DATES")
        increment_dates="1"; shift;
        ;;
      --"$ARG_DATA_SOURCE")
        data_source="$2"; shift; shift;
        ;;
      --"$ARG_S3_REFERER")
        s3_referer="$2"; shift; shift;
        ;;
      --"$ARG_IAM_ACCESS_KEY")
        iam_access_key="$2"; shift; shift;
        ;;
      --"$ARG_IAM_SECRET_KEY")
        iam_secret_key="$2"; shift; shift;
        ;;
      --"$ARG_DATASET")
        dataset="$2"; shift; shift;
        is_url "$dataset";
        if [[ "$dataset_is_url" == false ]]; then
          file_name_short=$(echo "$dataset" | cut -d'?' -f1); # Strip off any '?versionId=abc' trailing part
        else
          file_name_short=$(basename "$dataset" | cut -d'?' -f1); # Strip off any '?versionId=abc' trailing part
        fi
        ;;
      --"$ARG_CACHE_DIR")
        cache_dir=${2%/}; shift; shift; # trim trailing slashes
        ;;
      --"$ARG_SITE_ROOT")
        warn "'--$ARG_SITE_ROOT' is no longer required and has no effect"
        shift; shift;
        ;;
      --"$ARG_SQL_HOST")
        sql_host="$2"; shift; shift;
        ;;
      --"$ARG_SQL_SCHEMA")
        sql_schema="$2"; shift; shift;
        ;;
      --"$ARG_SQL_USER")
        sql_user="$2"; shift; shift;
        ;;
      --"$ARG_SQL_PASS")
        sql_passwd="$2"; shift; shift;
        ;;
      --"$ARG_NO_LOCAL_STORAGE")
        no_local_storage="1"; shift;
        ;;
      --"$ARG_PLAN")
        plan="$2"; shift; shift;
        ;;
      --"$ARG_CONFIG")
        config["$2"]="$3"; shift; shift; shift;
        ;;
      *)
        error "Unrecognised option: '$1'"
        shift # past argument
        errors="1"
        ;;
    esac
  done
  if [[ $errors == "1" ]]; then
    exit 1
  fi
}

# Attempt to read SQL from conf file using INSTANCE_ID
# This will not work during new install because SQL credentials will not yet have been deployed to instances.ini
# For new installs, SQL credentials must be passed as CLI args
function parse_sql_from_conf(){
  if [[ -z $sql_user ]]; then
    sql_user=$(schoolbox-read-instances --option SQL_user);
  fi
  if [[ -z $sql_passwd ]]; then
    sql_passwd=$(schoolbox-read-instances --option SQL_passwd);
  fi
  if [[ -z $sql_host ]]; then
    sql_host=$(schoolbox-read-instances --option SQL_host);
  fi
  if [[ -z $sql_schema ]]; then
    sql_schema=$(schoolbox-read-instances --option SQL_db);
  fi
}

# Checks the CLI flags we passed are valid
function validate_args(){
  local errors='0'

  if [[ -z $dataset ]]; then
    error "You must specify a dataset using the '--$ARG_DATASET' flag"
    errors="1"
  fi
  if [[ -z $sql_host ]]; then
    error "Unable to derive SQL host. You must provide one using the '--$ARG_SQL_HOST' flag"
    errors="1"
  fi
  if [[ -z $sql_schema ]]; then
    error "Unable to derive SQL schema. You must provide one using the '--$ARG_SQL_SCHEMA' flag"
    errors="1"
  fi
  if [[ -z $sql_user ]]; then
    error "Unable to derive SQL user. You must provide one using the '--$ARG_SQL_USER' flag"
    errors="1"
  fi
  if [[ -z $sql_passwd ]]; then
    error "Unable to derive SQL password. You must provide one using the '--$ARG_SQL_PASS' flag"
    errors="1"
  fi
  if [[ -n "$plan" ]] && [[ ! " ${SITE_PLANS_VALID[*]} " =~ $plan ]]; then
    error "Invalid plan. Expected one of (${SITE_PLANS_VALID[*]}), found: '$plan'"
    errors="1"
  fi

  if [[ $errors == "1" ]]; then
    exit 1
  fi
}


# Export SQL credentials to be used by subsequent scripts prior to instances.ini update.
export_sql_credentials(){
  export SQL_USER="$sql_user"
  export SQL_PASS="$sql_passwd"
  export SQL_HOST="$sql_host"
  export SQL_SCHEMA="$sql_schema"
}


