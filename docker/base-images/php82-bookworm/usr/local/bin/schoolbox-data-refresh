# Localise the database config table.
# This needs to run:
# 1. After initial data import to ensure update scripts can function in this environment
# 2. After update scripts have finished to populate any new config that did not exist in an old dataset
function localise_database_config(){
  for key in "${!config[@]}"; do
    if ! mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -e "UPDATE config SET value=${config[$key]} WHERE name='$key'"; then
      error "Unable to set config '$key' to ${config[$key]}"
      exit 1;
    fi
  done
}


# Restore the SU password hash we captured earlier
function restore_su_password() {
  if [[ -n $su_password_hash ]]; then
    if mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -e "UPDATE user SET password = '$su_password_hash' WHERE username = 'alaress'"; then
      log "Password hash for 'alaress' user restored to '$su_password_hash'"
    else
      error "Error. Unable to restore alaress user password hash to '$su_password_hash'"
    fi
  fi
}


# We need to place data dirs from inside the dataset into their canonical instance-specific locations
# This will create data dirs for the imported SQL which may be at an older version that the code on this host.
# If the update scripts change data dirs, it is their responsibility to manage the primary host's file-system.
# Puppet will periodically run on non-primary hosts and ensure the data dirs in the schema are created on the host.
function create_data_dirs(){
  local instance_data_dir=$1
  # We don't care if this is schoolbox/dev, because we put the instance_id in the path.

  local -A data_dir_map=(); # Maps config name to default relative dir, eg 'twig_cache_dir:twig;backup_dir:files;zip_dir:cache/zip'

  IFS=';' read -r -a array <<< "$data_dirs_config"
  for element in "${array[@]}"; do
    IFS=':' read -r -a sub_array <<< "$element"
    data_dir_map[${sub_array[0]}]="${sub_array[1]}"
  done

  # We will just blindly assume the dataset had all data dirs in their default relative locations.
  # TODO enforce this https://schoolbox.atlassian.net/browse/IST-404
  # We need to update the database's pointers to their new location on disk.

  local sql_cmd
  for data_dir_name in "${!data_dir_map[@]}"; do

    # If we are deploying to a 21.1.4+ product, we can ignore log dir, as all logs are being moved to /var/log/schoolbox/$INSTANCE_ID
    # TODO remove once all clients upgrade past 21.1.4
    if [[ $data_dir_name == "logs_dir" ]]; then
      local target_site_version;
      target_site_version=$(find /usr/share/schoolbox/updates/ -mindepth 1 -maxdepth 1 -type d -printf "%f\n" | sort -V | tail -n 1)
      if ! requires_logs_data_dir; then
        log "Skipping 'logs_dir', no longer required in $SITE_VERSION_LOGS_DIR_REMOVED+"
        continue
      else
        log "Retaining 'logs_dir', still used by versions <$SITE_VERSION_LOGS_DIR_REMOVED"
      fi
    fi

    local data_dir_value="${instance_data_dir}/${data_dir_map[$data_dir_name]}"
    log "Setting data_dir '$data_dir_name' => '$data_dir_value'"
    sql_cmd="UPDATE config SET value = '$data_dir_value' WHERE name = '$data_dir_name'"
    if ! mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -ss -e "$sql_cmd"; then
      error "Unable to set '$data_dir_value' to '$data_dir_name'"
      exit 1
    fi
    mkdir -vp "$data_dir_value"
  done
}

# TODO remove this once all sites using this have upgraded past 21.1.5 (where it was moved prior to SQL short-circuit)
set_site_package(){
  local package_version
  if dpkg -l | grep -qE "\sschoolbox\s"; then
    package_version=$(dpkg -s schoolbox | grep Version | awk '{print $2}')
  fi
  log "Setting 'site_package' to '$package_version'"
  mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -e "UPDATE config SET value = '$package_version' WHERE name = 'site_package';"
}


# Upgrade SQL
function upgrade_sql(){
  if INSTANCE_ID="$INSTANCE_ID" /usr/share/schoolbox/tools/maintenance/site_down.sh -eq 0 ; then
    log "Maintenance mode enabled on instance '$INSTANCE_ID'."
  else
    log "Could not enable maintenance mode on instance '$INSTANCE_ID'.  Exiting."
    exit 1;
  fi

  # We need to set the SQL credentials as env vars as we are invoking PHP and instances.ini may not yet have this instance
  if ! SQL_HOST="$sql_host" SQL_SCHEMA="$sql_schema" SQL_USER="$sql_user" SQL_PASS="$sql_passwd" /usr/share/schoolbox/tools/update-sql.sh; then
    error "Unable to update SQL"
    exit 1;
  fi

  if INSTANCE_ID="$INSTANCE_ID" /usr/share/schoolbox/tools/maintenance/site_up.sh -eq 0 ; then
    log "Maintenance mode disabled on instance '$INSTANCE_ID'."
  else
    log "Could not disable maintenance mode on instance '$INSTANCE_ID'.  Continuing."
  fi
}


function set_plan(){
  if [[ -z $plan ]]; then
    log "Plan arg not provided, resetting to current plan"
    /usr/share/schoolbox/tools/set-plan.php --reset
  elif [[ $plan == "$PLAN_CUSTOM" ]]; then
    log "Plan is '$PLAN_CUSTOM', skipping set-plan.php"
  else
    log "setting plan to '$plan'"
    /usr/share/schoolbox/tools/set-plan.php --plan "$plan"
  fi
}


# Wipe messages from redis
function empty_redis(){
  local redis_url;
  redis_url=$(echo "${config[redis_url]}" | sed "s/'//g" | sed -E "s/^[a-z]+:\/\///")
  local redis_host;
  local redis_port;
  redis_host=$(echo "$redis_url" | cut -d ":" -f 1)
  redis_port=$(echo "$redis_url" | cut -d ":" -f 2)
  if [[ -z $redis_port ]]; then
    redis_port=6379
  fi
  log "Resetting redis. (Host: $redis_host, Port: $redis_port)"
  redis-cli -h "$redis_host" -p $redis_port KEYS "*:$INSTANCE_ID:*" | xargs redis-cli -h "$redis_host" -p $redis_port DEL;
}

function refresh_module_route_cache(){
  local script=/usr/share/schoolbox/tools/module/refresh-cache.php
  # Check we are installing a version that actually has this feature.
  if [[ -f $script ]]; then
    log "Loading route+module cache...";
    SQL_HOST="$sql_host" SQL_SCHEMA="$sql_schema" SQL_USER="$sql_user" SQL_PASS="$sql_passwd" $script;
  fi
}

# Refresh binding cache, write it to redis, and signal daemons to reload.
# TODO confirm this works for new installs. The daemons that use this cache wont yet exist. Do they pick it up correctly when created by puppet?
function refresh_binding_cache(){
  # Always refresh binding cache (provide SQL credentials to support new installs)
  SQL_HOST="$sql_host" SQL_SCHEMA="$sql_schema" SQL_USER="$sql_user" SQL_PASS="$sql_passwd" php /usr/share/schoolbox/tools/notif/route/refresh-binding-cache.php -vv
}


# Fetch 'data_dirs_defaults' from config table, falling back to sane values if not found
function get_data_dirs_defaults_config(){
  data_dirs_config=$(mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -ss -e "SELECT value from config WHERE name = 'data_dirs_defaults'")
  if [[ -z $data_dirs_config ]]; then
    local sql_version;
    sql_version=$(mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -ss -e "SELECT value from config WHERE name = 'site_version'")
    local message="Data dir default config not found or empty. SQL version: $sql_version"
    if [[ "$(echo -e "20.1.7\n${sql_version}" | sort -V | head -n 1)" == "20.1.7" ]]; then
      error "$message"
      exit 1;
    else
      warn "$message. Falling back to fuzzy list"
      data_dirs_config="$FALLBACK_DATA_DIR_CONFIG"
    fi
  fi
}

set_log_dir(){
  if requires_logs_data_dir; then
    log "Skipping log dir modification. Product update script will do this..."
    return
  fi

  local log_dir_value="/var/log/schoolbox/${INSTANCE_ID}"
  mkdir -pv "$log_dir_value"
  chown -c www-data:www-data "$log_dir_value"
  log "Setting logging directory => '$log_dir_value'"
  sql_cmd="UPDATE config SET value = '$log_dir_value' WHERE name = 'logs_dir'"
  if ! mysql -h "$sql_host" -u "$sql_user" -p"$sql_passwd" "$sql_schema" -ss -e "$sql_cmd"; then
    error "Unable to set 'logs_dir' to '$log_dir_value'"
    exit 1
  fi
}

increment_dates(){
  log "Launching product date-increment script..."
  /usr/share/schoolbox/tools/increment-instance-dates.php
}

# Main logic flow
function main(){
  PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games';
  check_run_as_root
  check_instance_id
  parse_args "$@"
  parse_sql_from_conf
  validate_args
  export_sql_credentials
#  derive_puppet_certname
#  if [[ $skip_bucket_copy == 0 ]]; then
#    derive_ir_api_key
#    derive_ir_api_url
#  fi
  fetch_old_su_password
  fetch_existing_config
  validate_config


  # We don't care if this is schoolbox/dev, because we put the instance_id in the path.
  local instance_data_dir="/var/lib/schoolbox/$INSTANCE_ID"

  # fetch dataset from S3 into cache directory and only extract the database for now
  fetch_dataset_and_extract_database "$instance_data_dir"

  # Clear transient data (prior to blowing away the config that points to it)
  if [[ $purge_redis == '1' ]]; then
    empty_redis
  fi

  # Import dataset SQL and upgrade to current version
  empty_schema
  import_dataset "$instance_data_dir"
  get_data_dirs_defaults_config
  create_data_dirs "$instance_data_dir"
  set_log_dir
#  if [[ $skip_bucket_copy == 0 ]]; then
#    copy_bucket_contents
#  fi

  extract_all_dataset_files "$instance_data_dir"
  set_ownership_and_permissions
  localise_database_config
  restore_su_password
  set_site_package
  upgrade_sql
  set_plan
  # Intentionally apply config after plan so that 'cloud refresh' configs take precedence over plan defaults.
  localise_database_config
  refresh_module_route_cache
  refresh_binding_cache

  if [[ $increment_dates == 1 ]]; then
      increment_dates
  fi

  log "Data refresh complete."
}

main "$@"
