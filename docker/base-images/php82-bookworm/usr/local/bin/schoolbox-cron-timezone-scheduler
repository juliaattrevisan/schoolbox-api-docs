#!/bin/bash
# Convert cron schedule between timezones
# Usage ./cron-timezones --schedule [SCHEDULE] --from [TZ_INSTANCE] [--to [TZ_HOST]]
#
# Eg. Host is UTC (00:00), Instance is +10:00.
#     If   Cron needs to run at 14:00 on Instance,
#     Then Cron needs to run at 04:00 on Host

# Global constants
readonly TYPE_MIN=1             # eg '*', '*/2', '1', '1-2', '1,2'
readonly TYPE_HOUR=2            # eg '*', '*/2', '1', '1-2', '1,2'
readonly TYPE_DAY_OF_MONTH=3    # eg '*', '*/2', '1', '1-2', '1,2'
readonly TYPE_MONTH=4           # eg '*', '*/2', '1', '1-2', '1,2', 'jan'
readonly TYPE_DAY_OF_WEEK=5     # eg '*', '*/2', '1', '1-2', '1,2', 'sun'
readonly MAP_MONTH=(jan feb mar apr may jun jul aug sep oct nov dec)
readonly MAP_DAY_OF_WEEK=(sun mon tue wed thu fri sat sun)
readonly DAYS_IN_MONTHS=(31 28 31 30 31 30 31 31 30 31 30 31)
declare -A MOD_VALUES
MOD_VALUES[$TYPE_MIN]=60
MOD_VALUES[$TYPE_HOUR]=60
MOD_VALUES[$TYPE_DAY_OF_MONTH]=31
MOD_VALUES[$TYPE_MONTH]=12
MOD_VALUES[$TYPE_DAY_OF_WEEK]=7
readonly MOD_VALUES

# Global vars parsed from CLI args
declare schedule;
declare tz_from;
declare tz_to;         # optional. Defaults to host's timezone

# Parse CLI args
parse_args(){
  local errors=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --schedule) schedule="$2"; shift; shift; ;;
      --from)     tz_from="$2"; shift; shift; ;;
      --to)       tz_to="$2"; shift; shift; ;;
      *)    # unknown option
      echo "Unrecognised option: '$1'" >&2
      errors='1'
      shift # past argument
      ;;
    esac
  done
  if [[ $errors == '1' ]]; then
    return 1
  fi
  if [[ -z $tz_to ]]; then
    tz_to=$(cat /etc/timezone)
  fi
}


# Ensure CLI args are valid
validate_args(){
  local errors=0
  if [[ -z $schedule ]]; then
    echo "You must provide a --schedule option" >&2
    errors=1
  fi
  if [[ -z $tz_from ]]; then
    echo "You must provide a --from timezone option" >&2
    errors=1
  fi
  if [[ -z $tz_to ]]; then
    echo "You must provide a --to timezone option" >&2
    errors=1
  fi
  if [[ $errors == '1' ]]; then
    return 1
  fi
}


# Convert a month name (jan-dec) to index (1-12)
month_index(){
  local month;
  month=$(echo "$1" | tr '[:upper:]' '[:lower:]'); # Ensure lowercase. Eg 'JAN' => 'jan'
  local i=0
  while [[ $i -lt ${#MAP_MONTH[@]} ]]; do
    if [[ "${MAP_MONTH[$i]}" == "$month" ]]; then
      echo $((++i))
      return
    fi
    ((i++))
  done
  echo "Unable to convert month name to index. Month name: '$month'" >&2
  return 1
}


# Convert a day-of-week name (sun-sat) to index (0-6)
day_of_week_index(){
  local day_of_week;
  day_of_week=$(echo "$1" | tr '[:upper:]' '[:lower:]'); # Ensure lowercase. Eg 'SUN' => 'sun'
  local i=0
  while [[ $i -lt ${#MAP_DAY_OF_WEEK[@]} ]]; do
    if [[ "${MAP_DAY_OF_WEEK[$i]}" == "$day_of_week" ]]; then
      echo $i
      return
    fi
    ((i++))
  done
  echo "Unable to convert day-of-week name to index. Day name: '$day_of_week'" >&2
  return 1
}


# Convert a month/day name to index. eg
#  *    => *
#  0    => 0
# 'Sun' => 0
# 'JAN' => 1
convert_name_to_index(){
  local value=$1
  local type=$2
  if [[ $value =~ ^[*0-9]+ ]]; then
    echo "$value"
    return
  fi
  if [[ $type == "$TYPE_MONTH" ]]; then
    month_index "$value" || return 1
  elif [[ $type == "$TYPE_DAY_OF_WEEK" ]]; then
    day_of_week_index "$value" || return 1
  else
    echo "Unable to convert string to index. Value: '$value'. Type: '$type' " >&2
    return 1
  fi
}


# Explode range to individual elements. Eg
# '58-02' 'minutes' => '58 59 0 1 2'
explode_range(){
  local min
  local max
  local type=$2
  local mod=${MOD_VALUES[$type]}    # eg 60

  # Split on '-' char
  min=$(echo "$1" | cut -d '-' -f1) # eg 40
  max=$(echo "$1" | cut -d '-' -f2) # eg 20

  # Convert names to indexes so we can perform maths
  min=$(convert_name_to_index "$min" "$type") || return 1
  max=$(convert_name_to_index "$max" "$type") || return 1

  # Handle wrap-around
  if [[ $max -lt $min ]]; then
    max=$((max + mod))
  fi
  while [[ $min -lt $max ]]; do
    echo "$((min % mod))"
    ((min++))
  done
  echo "$((max % mod))"
}


# Convert non-numeric and/or ranged-field to tokens, eg 'sun,1-3,6,*/2' => '0,1,2,3,6,*/2'
normalise(){
  local field="$1"
  local type="$2"

  # Split on comma char
  IFS="," read -r -a tokens <<< "$field"

  for token in "${tokens[@]}"; do
    # Is this a range?
    if [[ $token =~ - ]]; then
      explode_range "$token" "$type" || return 1
    else
      convert_name_to_index "$token" "$type" || return 1
    fi
  done
}


explode_schedules(){
  # Split on space char
  IFS=" " read -r -a tokens <<< "$schedule"
  if [[ ${#tokens[@]} != 5 ]]; then
    echo "Schedule must have 5 tokens. Found: ${#tokens[@]}" >&2
    return 1
  fi

  # We cannot guarantee that we can convert a range-based schedule into a single range-based schedule in a different timezone.
  # eg '00-40 05 * * *' +01:30 => '30-59 06 * * *'
  #                               '00-20 07 * * *'
  # Instead, easier to explode into individual schedules and map each one
  # eg '00-02 05,23 * * *' => '00 05 * * *' +01:30 => '30 06 * * *'
  #                           '00 23 * * *'           '30 00 * * *'
  #                           '01 05 * * *'           '31 06 * * *'
  #                           '01 23 * * *'           '31 00 * * *'
  #                           '02 05 * * *'           '32 06 * * *'
  #                           '02 23 * * *'           '32 00 * * *'
  minutes=$(normalise "${tokens[0]}" "$TYPE_MIN") || return 1;                     # eg '*', '*/2', '1', '1-2', '1,2'
  minutes=$(echo "$minutes" | sort | uniq)
  hours=$(normalise "${tokens[1]}" "$TYPE_HOUR") || return 1;                      # eg '*', '*/2', '1', '1-2', '1,2'
  hours=$(echo "$hours" | sort | uniq)
  days_of_month=$(normalise "${tokens[2]}" "$TYPE_DAY_OF_MONTH") || return 1;      # eg '*', '*/2', '1', '1-2', '1,2'
  days_of_month=$(echo "$days_of_month" | sort | uniq)
  months=$(normalise "${tokens[3]}" "$TYPE_MONTH") || return 1;                    # eg '*', '*/2', '1', '1-2', '1,2', 'jan'
  months=$(echo "$months" | sort | uniq)
  days_of_week=$(normalise "${tokens[4]}" "$TYPE_DAY_OF_WEEK") || return 1;        # eg '*', '*/2', '1', '1-2', '1,2', 'sun'
  days_of_week=$(echo "$days_of_week" | sort | uniq)

  set -o noglob
  for minute in $minutes; do
    for hour in $hours; do
      for day_of_month in $days_of_month; do
        for month in $months; do
          for day_of_week in $days_of_week; do
            echo "$minute $hour $day_of_month $month $day_of_week"
          done
        done
      done
    done
  done
  set +o noglob
}


# Convert a single schedule b/w timezones, eg:
# '1 1 1 jan sun' +01:30 => '31 2 1 jan sun'
convert_schedule(){
  local schedule=$1
  local diff_minute=$2
  local diff_hour=$3
  local diff_days=0
  local diff_months=0

  # Split on space char
  IFS=" " read -r -a tokens <<< "$schedule"
  minute="${tokens[0]}";                     # eg '*', '*/2', '1'
  hour="${tokens[1]}";                       # eg '*', '*/2', '1'
  day_of_month="${tokens[2]}";               # eg '*', '*/2', '1'
  month="${tokens[3]}";                      # eg '*', '*/2', '1'
  day_of_week="${tokens[4]}";                # eg '*', '*/2', '1'

  # Remove leading zeros to prevent the numbers from being interpreted as octal when used inside double square brackets [[]].
  # See https://stackoverflow.com/questions/24777597/value-too-great-for-base-error-token-is-08
  # See https://stackoverflow.com/questions/12821715/convert-string-into-integer-in-bash-script-leading-zero-number-error/12821845#12821845
  # For values 01 to 07, octal interpretation will be the same as decimal.
  # For values 08 and 09, there is no octal representation, so interpreting as octal will error "value too great for base'.
   if [[ "$hour" != "0" ]]; then
     hour=${hour#0}
   fi
   if [[ "$minute" != "0" ]]; then
     minute=${minute#0}
   fi
   if [[ "$day_of_month" != "0" ]]; then
     day_of_month=${day_of_month#0}
   fi
   if [[ "$month" != "0" ]]; then
     month=${month#0}
   fi
   if [[ "$day_of_week" != "0" ]]; then
     day_of_week=${day_of_week#0}
   fi

  # Adjust minute
  if [[ $minute =~ ^[0-9]+$ ]] && [[ $diff_minute -ne 0 ]]; then
    ((minute+=diff_minute))
    if [[ $minute -lt 0 ]]; then
      ((minute+=60))
      ((diff_hour--))
    elif [[ $minute -gt 59 ]]; then
      ((minute-=60))
      ((diff_hour++))
    fi
  fi

  # Adjust hour
  if [[ "$hour" =~ ^[0-9]+$ ]] && [[ $diff_hour -ne 0 ]]; then
    ((hour+=diff_hour))
    if [[ $hour -lt 0 ]]; then
      ((hour+=24))
      ((diff_days--))
    elif [[ $hour -gt 23 ]]; then
      ((hour-=24))
      ((diff_days++))
    fi
  fi

  # Adjust day-of-month. eg:
  # '31 Jan' +1 day => '2 Feb'
  # '01 Jan' -1 day => '31 Dec'
  if [[ "$day_of_month" =~ ^[0-9]+$ ]] && [[ $diff_days -ne 0 ]]; then
    ((day_of_month+=diff_days))
    # Wrap around?
    if [[ $month =~ ^[0-9]+$ ]]; then
      count_month_days=${DAYS_IN_MONTHS[$((month - 1))]}
    else
      count_month_days=31
    fi

    if [[ $day_of_month -lt 1 ]]; then
      if [[ $month =~ ^[0-9]+$ ]]; then
        count_month_days=${DAYS_IN_MONTHS[$(( ((month - 2)) % 12))]}
      fi
      ((day_of_month+=count_month_days))
      ((diff_months--))
    elif [[ $day_of_month -gt $count_month_days ]]; then
      if [[ $month =~ ^[0-9]+$ ]]; then
        count_month_days=${DAYS_IN_MONTHS[$(( ((month - 1)) % 12))]}
      fi
      ((day_of_month %= count_month_days))
      ((diff_months++))
    fi
  fi

  # Adjust month
  if [[ "$month" =~ ^[0-9]+$ ]] && [[ $diff_months -ne 0 ]]; then
    month=$(( (( ((month + diff_months - 1)) % 12)) + 1))
  fi

  # Adjust day-of-week
  if [[ "$day_of_week" =~ ^[0-9]+$ ]] && [[ $diff_days -ne 0 ]]; then
    day_of_week="$((((day_of_week + diff_days + 7)) % 7))"
  fi

  echo "$minute $hour $day_of_month $month $day_of_week"
}


# Main logic
main(){
  parse_args "$@" || exit 1
  validate_args || exit 1

  # derive difference b/w timezones by converting an arbitrary time
  converted_day="$(TZ="$tz_to" date -d "TZ=\"$tz_from\" wed 00:00" +"%a")"
  converted_day_index=$(day_of_week_index "$converted_day") || exit 1
  reference_day_index=$(day_of_week_index "wed") || exit 1

  diff_days=$((converted_day_index - reference_day_index))
  diff_hour=$(("$(TZ="$tz_to" date -d "TZ=\"$tz_from\" wed 00:00" +"%-H")" + 24 * diff_days))
  diff_min="$(TZ="$tz_to" date -d "TZ=\"$tz_from\" wed 00:00" +"%-M")"

  if [[ $diff_days -eq 0 ]] && [[ $diff_hour -eq 0 ]] && [[ $diff_min -eq 0 ]]; then
    # If no timezone differences, just output original schedule
    echo "$schedule"
    exit 0
  fi

  exploded="$(explode_schedules)" || exit 1
  while IFS= read -r schedule; do
    convert_schedule "$schedule" "$diff_min" "$diff_hour"
  done <<< "$exploded"
}

main "$@"
