#!/bin/bash
# Rewrites cron jobs to be suitable for cloud
# * Sets INSTANCE_ID as env var
# * Rewrites www-data jobs to log to /var/lib/schoolbox/cache/logs (which is owned by www-data)
# * Ensures all log files have an INSTANCE_ID in their file name
# * If this server is non-primary, will only remove cron
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games
readonly LOG=/usr/bin/alaress-logger
readonly L_DEBUG=100
readonly L_WARNING=300
readonly L_ERROR=400
readonly MAILTO="ist+cron@schoolbox.com.au"
readonly MAILFROM="cron"

function debug() {
  if [[ $verbose == '1' ]]; then
    $LOG $L_DEBUG "$1"
  fi
}
function warning() {
  $LOG $L_WARNING "$1"
}
function error() {
  $LOG $L_ERROR "$1"
}

if [[ $EUID -ne 0 ]]; then
  error "This script must be run as root"
  exit 1
fi

declare errors=0    # Any errors detected in CLI args?
declare instance_id # If a specific instance provided, just rebuild for that instance. Otherwise all instances.
declare verbose=0
declare is_primary_host # Is this a primary (1) or secondary (0) host. If secondary, just delete the cron jobs.

# Parse CLI args
while [[ $# -gt 0 ]]; do
  case $1 in
  -v | --verbose)
    verbose="1"
    shift
    ;;
  --instance)
    instance_id="$2"
    shift
    shift
    ;;
  --is-primary-host)
    if [[ $2 =~ ^[01]{1}$ ]]; then
      is_primary_host=$2
      shift
      shift
    else
      error "Unrecognised value for --is-primary-host '$2'"
      errors=1
      shift
    fi
    ;;
  *)
    error "Unrecognised option: '$1'"
    errors='1'
    shift
    ;;
  esac
done

if [[ -z $is_primary_host ]]; then
  error "You must declare whether this is a primary host using the --is-primary-host flag"
  errors=1
fi

if [[ $errors == '1' ]]; then
  exit 1
fi

cron_file="/usr/share/schoolbox/tools/cron/schoolbox"

if [ -n "$instance_id" ]; then
  instanceList=$(schoolbox-read-instances --option instance-list | sort | grep -E "^$instance_id$")
  if [[ ${#instanceList[@]} == 0 ]] || [[ ${instanceList[0]} == '' ]]; then
    error "Warning: No instance found on host with instance_id: '$instance_id'."
    exit 1
  fi
else
  instanceList=$(schoolbox-read-instances --option instance-list | sort)
fi

# Simulate a 2D array so we can later align output
readonly COL_SCHEDULE='s'
readonly COL_USER='u'
readonly COL_COMMAND='c'

for i in ${instanceList[*]}; do
  declare -A output=()
  job_idx=0
  instance_cron_file=/etc/cron.d/sbc_schoolbox_"${i}"

  # Remove and don't create cron file if this is a non-primary host
  if [[ $is_primary_host == '0' ]]; then
    if [[ -f $instance_cron_file ]]; then
      debug "Removing cron file from secondary host: '$instance_cron_file'"
      rm "$instance_cron_file"
    else
      debug "Not building cron file for instance '${i}' on secondary host"
    fi
    continue
  fi

  cron_config_line=$(grep "^${i};" /etc/schoolbox/cron_config.ini)
  IFS=";" read -r -a cron_config_array <<<"$cron_config_line"
  timezone=${cron_config_array[1]}
  ups_time=${cron_config_array[2]}
  logs_dir=${cron_config_array[3]%%*(/)} # Trim trailing '/' char if present

  debug "instance: $i, timezone: $timezone, ups_time: $ups_time, logs_dir: $logs_dir"

  {
    echo -e "# Auto generated by $0 from $cron_file at $(date +%Y-%m-%d\ %X)
# Times have been adjusted for the $timezone timezone
# Any manual changes to this file will be overwritten
MAILTO=\"$MAILTO\"
MAILFROM=\"$MAILFROM\""
  } >"$instance_cron_file"

  while IFS= read -r line; do
    # If not a comment or MAILTO or empty line
    if [[ ! $line =~ ^\s*# ]] && [[ ! $line =~ ^MAILTO ]] && [[ -n $line ]]; then
      # Convert all whitespace to single space char
      line=$(echo -e "$line" | sed -E 's/\s+/ /g')
      # Split on space char
      IFS=" " read -r -a tokens <<<"$line"
      # Fail if less than 7 tokens otherwise process line
      if [[ ${#tokens[@]} -lt 7 ]]; then
        error "Unable to parse line: '$line'"
      else
        schedules="$(schoolbox-cron-timezone-scheduler --schedule "${tokens[0]} ${tokens[1]} ${tokens[2]} ${tokens[3]} ${tokens[4]}" --from "$timezone")"
        user=${tokens[5]} # root | www-data
        command="${tokens[6]}"
        j=7
        while [ $j -lt ${#tokens[@]} ]; do
          command="$command ${tokens[j]}"
          j=$((j + 1))
        done
        is_using_configured_logs_dir=0
        has_log_file=0

        # TODO Remove once upgraded to version where product hard-codes instance log-dir to /var/log/schoolbox/$INSTANCE_ID
        # Ensure log file always instance-specific. Order of preference.
        #  1. '/var/log/schoolbox/xxx/yyy.log'        => '/var/log/schoolbox/INSTANCE_ID/xxx/yyy.log'         (new canonical location)
        #  2. '/var/lib/schoolbox/cache/logs/xxx.log' => '/var/lib/schoolbox/INSTANCE_ID/cache/logs/xxx.log'  (configured log dir)
        #  3. '/var/lib/schoolbox/YYY/xxx.log'        => '/var/lib/schoolbox/YYY/xxx-INSTANCE_ID.log'         (modify file name)
        if echo "$command" | grep -q "/var/log/schoolbox/"; then
          # eg "/var/log/schoolbox/path/file.log" => "/var/log/schoolbox/${INSTANCE_ID}/path/file.log"
          command=$(echo "$command" | sed -E "s#/var/log/schoolbox/#/var/log/schoolbox/$i/#")
          has_log_file=1
        elif echo "$command" | grep -q "/var/lib/schoolbox/cache/logs/"; then
          # eg "/var/lib/schoolbox/cache/logs/path/file.log" => "${logs_dir}/path/file.log"
          command=$(echo "$command" | sed -E "s#/var/lib/schoolbox/cache/logs#$logs_dir#")
          is_using_configured_logs_dir=1
          has_log_file=1
        elif echo "$command" | grep -Eq "/var/(lib|log)/schoolbox"; then
          # eg (/var/log/schoolbox/)(path/file)(.log) => (/var/log/schoolbox/)(path/file)-INSTANCE_ID(.log)
          command=$(echo "$command" | sed -E "s#(/var/(lib|log)/schoolbox/)([^.]+)(\.[^\s]+)#\1\3-$i\4#")
          has_log_file=1
        fi

        # Does cron use a log file?
        if [[ $has_log_file == 1 ]]; then
          if [[ $is_using_configured_logs_dir == '1' ]]; then
            log_file=$(echo "$command" | grep -oE "$logs_dir.+" | awk '{print $1;}')
          else
            log_file=$(echo "$command" | grep -oE "/var/(log|lib)/schoolbox/.+" | awk '{print $1;}')
          fi
          log_file_dir="$(dirname "$log_file")"

          # Ensure log file's parent dir exists. If we create it, ensure owned by www-data
          if [[ ! -d "$log_file_dir" ]]; then
            mkdir -p "$log_file_dir"
            chown www-data:www-data "$log_file_dir"
          fi

          if [[ ! -f "$log_file" ]]; then
            touch "$log_file"
          fi

          # if run as www-data, rewrite log to dir owned by www-data
          if [[ $user == "www-data" ]]; then
            chown -c www-data:www-data "$log_file_dir"
            if [[ -f "$log_file" ]]; then
              # Ensure log file is owned by www-data
              chown -c www-data:www-data "$log_file"
            fi
          fi
        fi

        # Apply jitter if not already applied
        if echo "$command" | grep -q "/usr/local/bin/jitter"; then
          command=$(echo "$command" | sed -E "s/(\/usr\/local\/bin\/jitter [0-9]+) /\1\t\&\& INSTANCE_ID=$i\t/g")
        else
          command="/usr/local/bin/jitter 60\t&& INSTANCE_ID=$i\t$command"
        fi

        # Build new cronjob elements
        while IFS= read -r schedule; do
          output["$job_idx.$COL_SCHEDULE"]="$schedule"
          output["$job_idx.$COL_USER"]="$user"
          output["$job_idx.$COL_COMMAND"]="$command"
          job_idx=$((job_idx + 1))
        done <<<"$schedules"
      fi
    fi
  done <"$cron_file"

  # add UPS cronjob at the time specified in puppet for this host.
  ups_hour=$(echo "$ups_time" | cut -d : -f 1)
  ups_min=$(echo "$ups_time" | cut -d : -f 2)
  schedules="$(schoolbox-cron-timezone-scheduler --schedule "${ups_min} ${ups_hour} * * *" --from "$timezone")"
  # Build new cronjob elements
  while IFS= read -r schedule; do
    output["$job_idx.$COL_SCHEDULE"]="$schedule"
    output["$job_idx.$COL_USER"]="www-data"
    output["$job_idx.$COL_COMMAND"]="/usr/local/bin/jitter 60\t&& INSTANCE_ID=$i\tphp /usr/share/schoolbox/tools/synchronise/userProvision.php -v --perform-update >> /var/log/schoolbox/$i/ups.log 2>&1"
    job_idx=$((job_idx + 1))
  done <<<"$schedules"

  # Derive length of largest value in each column
  max_length_schedule=0
  max_length_user=0
  max_length_command=0
  idx=0
  while [[ idx -lt job_idx ]]; do
    schedule=${output["$idx.$COL_SCHEDULE"]}
    user=${output["$idx.$COL_USER"]}
    command=${output["$idx.$COL_COMMAND"]}
    length_schedule=${#schedule}
    length_user=${#user}
    length_command=${#command}
    if [[ $length_schedule -gt $max_length_schedule ]]; then
      max_length_schedule=$length_schedule
    fi
    if [[ $length_user -gt $max_length_user ]]; then
      max_length_user=$length_user
    fi
    if [[ $length_command -gt $max_length_command ]]; then
      max_length_command=$length_command
    fi
    idx=$((idx + 1))
  done

  # Right-pad column values with space character
  idx=0
  while [[ idx -lt job_idx ]]; do
    schedule=$(printf "%-${max_length_schedule}s" "${output["$idx.$COL_SCHEDULE"]}")
    user=$(printf "%-${max_length_schedule}s" "${output["$idx.$COL_USER"]}")
    command=$(printf "%-${max_length_schedule}s" "${output["$idx.$COL_COMMAND"]}")
    echo -e "$schedule\t$user\t$command" >>"$instance_cron_file"
    idx=$((idx + 1))
  done
done

# If updating all instances, then delete any old instance files
if [ -z "$instance_id" ]; then
  debug "Removing new-style files..."
  while IFS= read -r -d '' instance_cron_file; do
    found='0'
    debug "instance_cron_file: '$instance_cron_file'"
    for i in ${instanceList[*]}; do
      if [[ $instance_cron_file == "sbc_schoolbox_${i}" ]]; then
        found='1'
        break
      fi
    done
    if [[ $found == '0' ]]; then
      debug "Removing '/etc/cron.d/$instance_cron_file' (not a current instance)"
      rm "/etc/cron.d/$instance_cron_file"
    else
      debug "Retaining '/etc/cron.d/$instance_cron_file' (is a current instance)"
    fi
  done < <(find /etc/cron.d -maxdepth 1 -name "sbc_schoolbox_*" -printf "%f\\0")

  # TODO. Remove once run on all servers. Remove old style files that lacked the package in the filename
  debug "Removing old-style files..."
  while IFS= read -r -d '' instance_cron_file; do
    debug "instance_cron_file: '$instance_cron_file'"
    if ! echo "$instance_cron_file" | grep -q 'schoolbox'; then
      debug "Removing '/etc/cron.d/$instance_cron_file' (is old style)"
      rm "/etc/cron.d/$instance_cron_file"
    else
      debug "Retaining '/etc/cron.d/$instance_cron_file' (not an old style)"
    fi
  done < <(find /etc/cron.d -maxdepth 1 -name "sbc_*" -printf "%f\\0")
fi

# Deploy per-package cron jobs
package_cron_file="/usr/share/schoolbox/tools/cron/schoolbox_package"
if [[ ! -f $package_cron_file ]]; then
  debug "Package cron file not present. Assuming this is a <21.1.11 package"
else
  debug "Package cron file present."
  if [[ $is_primary_host == "1" ]]; then
    debug "Host is primary. Deploying to /etc/cron.d/schoolbox..."
    cp -v $package_cron_file /etc/cron.d/schoolbox
  else
    debug "Host is non-primary. Deleting from /etc/cron.d/schoolbox..."
    rm -fv /etc/cron.d/schoolbox
  fi
fi

# Ensure log file exists
if [ -d /var/log/schoolbox ]; then
  touch /var/log/schoolbox/purge-old-sessions.log
  chown www-data:www-data /var/log/schoolbox/purge-old-sessions.log
fi
