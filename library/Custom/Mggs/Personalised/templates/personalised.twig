<style type="text/css">
    .fc-time-area .fc-event-container {
        padding-bottom: 2px;
        top: 1px;
    }
    .fc-timeline-event .fc-content {
        padding: 5px 1px;
        white-space: nowrap;
        overflow: hidden;
    }

    {# Base colors #}
    .fc-event.contentArea,
    .fc-event.activity {
        border-color: #EEEEEE;
        background-color: #EEEEEE;
    }

    {# Assessment status colors #}
    .fc-event.fail {
        border-color: rgb(247, 206, 204);
        background-color: rgb(247, 206, 204);
    }
    .fc-event.fail .fc-title:before {
        /* cross */
        content: "\e60d ";
        font-family: "schoolbox";
        padding-right: .75em;
    }

    .fc-event.mastered {
        border-color: rgb(213, 231, 212);
        background-color: rgb(213, 231, 212);
    }
    .fc-event.mastered .fc-title:before {
        /* tick */
        content: "\e604 ";
        font-family: "schoolbox";
        padding-right: .75em;
    }

    .fc-event.notmarked {
        border-color: rgb(255, 242, 205);
        background-color: rgb(255, 242, 205);
    }
    .fc-event.notmarked .fc-title:before {
        /* pause */
        content: "\e650 ";
        font-family: "schoolbox";
        padding-right: .75em;
    }

    {# Read-only colors - override other colors #}
    .fc-event.unit,
    .fc-event.project {
        border-color: #111111;
        background-color: #111111;
        color: #EEEEEE;
    }
    .fc-event.unit:hover,
    .fc-event.project:hover {
        color: #EEEEEE;
    }
</style>

{# Header #}
<div class="row">
    <div class="small-12 columns">
        <h1>Personalised learning for {{ student.formatName }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <section>
            <div id="calendar"></div>
        </section>
    </div>
</div>

<div id="unitModal" class="reveal-modal" data-reveal aria-labelledby="unitModalTitle" aria-hidden="true" role="dialog">
    <h3 class="note" id="unitModalTitle" data-value="text"></h3>

    {# Metadata #}
    <ul class="meta">
        <li class="icon-calendar date">
            <time data-value="eventSpan"></time>
        </li>
    </ul>

    {# Buttons #}
    <dl>
        <dd>
            <a class="button icon-homepage" data-value="href" href="#">View {{ locale.unit.proper }} Homepage</a>
        </dd>
    </dl>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div id="assessmentModal" class="reveal-modal" data-reveal aria-labelledby="assessmentModalTitle" aria-hidden="true" role="dialog">
    <h3 class="note" id="assessmentModalTitle" data-value="text"></h3>

    {# Metadata #}
    <ul class="meta">
        <li class="icon-calendar date">
            {# Assessment's open/close date #}
            Open between: <time data-value="assessmentSpan"></time>
        </li>
        <li class="icon-staff-students date" data-personalised-date>
            {# My open/close date #}
            My timeframe: <time data-value="eventSpan"></time>
        </li>
    </ul>

    {# Description? #}
    <article class="detail" data-value="description"></article>

    {# Buttons #}
    <dl>
        <dd>
            <a class="button icon-due-work" data-value="href" href="#">View More Details</a>
        </dd>
    </dl>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

{# FullCalendar setup #}

{% autoescape 'js' %}
<script type="text/javascript">
    // Do stuff here
    $(function() {
        var calendar = $('#calendar');

        /**
         * Convert duration unit to FullCalendar view type name
         *
         * @param durationUnit
         * @param defaultView
         * @returns {String}
         */
        var convertDurationUnitToViewType = function(durationUnit, defaultView) {
            switch (durationUnit) {
                case 'term':
                    return 'timelineTerm';

                case 'week':
                    return 'timelineTwoWeek';

                case 'month':
                    return 'timelineTwoMonth';

                default:
                    return defaultView;
            }
        };

        /**
         * Extract calendar params out of hash
         *
         * @param hash
         * @returns {object} with "date" and "view" keys
         */
        var getCalendarParams = function(hash) {
            // Valid hash: #view/DD/MM/YYYY (URL date format)
            var hashParts = hash.match(/^#(\w+)\/?(.*)/),
                viewAlias,
                calendarDate;
            if (hashParts) {
                viewAlias      = hashParts[1];
                var momentDate = moment(hashParts[2], dateDisplayFormats.momentJs);
                if (momentDate.isValid()) {
                    calendarDate = momentDate.toDate();
                } else {
                    calendarDate = new Date();
                }
            } else {
                viewAlias    = 'month';
                calendarDate = new Date();
            }

            return {
                date: calendarDate,
                view: convertDurationUnitToViewType(viewAlias, 'timelineTwoMonth')
            }
        };

        /**
         * Retrieves the duration unit from the type of the custom view.
         *
         * @param view
         * @returns {Object}
         * @throws Error if view type not recognized
         */
        var getDurationFromView = function(view) {
            switch (view.type) {
                case 'timelineTerm':
                    return {
                        unit:    'months',
                        quantity: 6
                    };

                case 'timelineTwoMonth':
                    return {
                        unit:    'months',
                        quantity: 1
                    };

                case 'timelineTwoWeek':
                    return {
                        unit:    'weeks',
                        quantity: 1
                    };
            }
            throw new Error('Unrecognised view type "'+String(view.type)+'"');
        };

        /**
         * Retrieves the duration unit from the type of the custom view.
         *
         * @param view
         * @returns {String}
         * @throws Error if view type not recognized
         */
        var getViewAlias = function(view) {
            switch (view.type) {
                case 'timelineTerm':
                    return 'term';

                case 'timelineTwoMonth':
                    return 'month';

                case 'timelineTwoWeek':
                    return 'week';
            }
            throw new Error('Unrecognised view type "'+String(view.type)+'"');
        };

        /**
         * Update assessment method.
         *
         * * Gives event a "loading" style
         * * Removes that style when update finishes (regardless of result)
         *
         * @param calEvent   The event to update
         * @param delta      The amount of change
         * @param revertFunc called if update failed for whatever reason.
         *                   Sets event back to original state.
         */
        var updateAssessment = function(calEvent, delta, revertFunc) {
            var format = 'Y-MM-DD HH:mm:ss';
            // Account for Fullcalendar exclusive vs inclusive end dates
            var data = {
                assessmentId: calEvent.meta.assessmentId,
                openDate: calEvent.start.format(format),
                dueDate: calEvent.allDay
                    ? calEvent.end.clone().subtract({days: 1}).format(format)
                    : calEvent.end.format(format)
            };

            calEvent.className.push('loading');
            var post = $.post(
                '{{ routeLookup('learningPersonalised.postUpdateParticipation', {studentId: student.id}) }}',
                data,
                null,
                'json'
            );
            post.fail(revertFunc)
                .always(function() {
                    // Remove the loading class
                    calEvent.className = calEvent.className.filter(function (value) {
                        return value != 'loading';
                    });
                    calendar.fullCalendar('rerenderEvents');
                });
        };

        /**
         * Push calendar's current state (view + date) to history
         */
        var pushCurrentCalendarState = function() {
            try {
                var unit = getViewAlias(calendar.fullCalendar('getView'));
                var date = calendar.fullCalendar('getDate');
                window.history.pushState({}, '', ('#'+unit+'/'+date.format(dateDisplayFormats.momentJs)));
            } catch (e) {
                // Can't recognize view - ignore
            }
        };

        /**
         * Builds a date span text and datetime tag value.
         *
         * @param start  A moment object
         * @param end    A moment object
         * @param allDay Is this an all day event?
         * @returns {Object} text: a text representation, datetime: an ISO8601 time interval
         */
        var buildDateSpan = function(start, end, allDay) {
            var format = 'Do MMMM YYYY',
                datetime = '';
            if (allDay) {
                // All day offset -_- FC is exclusive end, we want inclusive
                end = end.clone().subtract({days: 1});
                datetime = start.format('YYYY-MM-DD') + '/' + end.format('YYYY-MM-DD');
            } else {
                format = format + ', h:mm a';
                datetime = start.toISOString() + '/' + end.toISOString();
            }

            return {
                text: $.fullCalendar.formatRange(start, end, format),
                datetime: datetime
            }
        };

        // On hash change - update calendar based on hash contents
        $(window).on('hashchange', function() {
            var calendarParams = getCalendarParams(window.location.hash);
            calendar.fullCalendar('changeView', convertDurationUnitToViewType(calendarParams.view, 'timelineTwoMonth'));
            calendar.fullCalendar('gotoDate', calendarParams.date);
        });

        // Keep expanded resources expanded until page is reloaded
        var expandedResources = {};
        calendar.on('click', '.fc-expander', function() {
            var resourceId = $(this).closest('[data-resource-id]').data('resourceId');
            expandedResources[resourceId] = !expandedResources[resourceId];
        });

        var previousView   = {};
        var calendarParams = getCalendarParams(window.location.hash);

        // This WAS in eventOrder but that config callback only allows sorting of events with the same datespan
        $.fullCalendar.Grid.mixin({
            compareEventSegs: function(a, b) {
                // Sort order:
                // 1. student start date
                // 2. student end date
                // 3. preset start date
                // 4. preset end date
                // 5. ordering within course outline
                var stringCompare = function(a,b) { return a.localeCompare(b); };
                var numCompare    = function(a,b) { return a - b; };
                var sorts         = [
                    {
                        column: function (item) { return item.meta.assessmentStart; },
                        comparator: stringCompare
                    },
                    {
                        column: function (item) { return item.meta.assessmentEnd; },
                        comparator: stringCompare
                    },
                    {
                        column: function (item) { return item.start.toISOString(); },
                        comparator: stringCompare
                    },
                    {
                        column: function (item) { return item.end.toISOString(); },
                        comparator: stringCompare
                    },
                    {
                        column: function (item) { return Number(item.meta.assessmentOrder); },
                        comparator: numCompare
                    }
                ];

                // Check each sort
                for (var i = 0; i < sorts.length; i++) {
                    try {
                        var aComp = sorts[i].column(a);
                        var bComp = sorts[i].column(b);
                        var comp  = sorts[i].comparator(aComp, bComp);
                        if (comp != 0) {
                            return comp;
                        }
                    } catch (e) {
                        // Something went wrong in fetching column or comparing values:
                        // consider these items not comparable. (Continue is implicit)
                    }
                }
            }
        });

        var c = new Calendar('calendar', 'calendar-bubble', {
            filter: {
                enabled: false,
                listViewButton: false
            },
            fullCalendar: {
                firstHour: 9,
                allDaySlot: false,
                defaultDate: calendarParams.date,
                views: {
                    timelineTerm: {
                        type: 'timeline',
                        duration: { months: 6 },
                        slotDuration: { days: 1 },
                        slotLabelFormat: { weeks: 1 },
                        slotLabelInterval: { weeks: 1 },
                        buttonText: 'Semester'
                    },
                    timelineTwoMonth: {
                        type: 'timeline',
                        duration: { months: 2 },
                        buttonText: 'Month'
                    },
                    timelineTwoWeek: {
                        type: 'timeline',
                        duration: { weeks: 2 },
                        slotLabelInterval: { days: 1 },
                        buttonText: 'Week'
                    }
                },
                height: 'auto',
                eventLimit: {{ config.calendar_collapse_events ? 'true' : 'false' }},
                firstDay: Number('{{ config.calendar_start_day }}'),
                schedulerLicenseKey: '{{ config.fullcalendar_scheduler_license_key }}',
                defaultView: calendarParams.view,
                header: {
                    left: 'prevWindow,today,nextWindow',
                    center: 'title',
                    right: 'timelineTerm,timelineTwoMonth,timelineTwoWeek'
                },
                events: function(start, end, timezone, callback) {
                    $.ajax({
                        dataType: 'json',
                        url:      '{{ routeLookup('learningPersonalised.getCalendarForStudent', {studentId: student.id}) }}',
                        data: {
                            start: Calendar.reOffsetTimestamp(start.unix()),
                            end:   Calendar.reOffsetTimestamp(end.unix())
                        },
                        cache: false
                    })
                    .done(
                        function(data) {
                            callback(data.filter(function(v) {
                                return 'start' in v && 'end' in v;
                            }));
                        }
                    );
                },

                eventClick: function(calEvent, jsEvent, view) {

                    if (calEvent.meta && calEvent.meta.type) {

                        var klass = '',
                            modal;
                        switch (calEvent.meta.type) {
                            case 'unit':
                                klass = 'icon-home';
                                break;

                            case 'dueWork':
                                klass = 'icon-due-work';
                                break;

                            case 'quiz':
                                klass = 'icon-quiz';
                                break;

                            case 'task':
                                klass = 'icon-task';
                                break;

                            case 'project':
                                klass = 'icon-project';
                                break;

                            default:
                                break;
                        }

                        if (calEvent.meta.type == 'unit') {
                            modal = $('#unitModal');
                        } else {
                            modal = $('#assessmentModal');
                        }

                        // Build date spans
                        var eventEnd = calEvent.end,
                            assessmentEnd = moment(calEvent.meta.assessmentEnd);
                        if (calEvent.allDay) {
                            eventEnd      = eventEnd.clone().subtract({days: 1});
                            assessmentEnd = assessmentEnd.clone().subtract({days: 1});
                        }
                        var eventSpan = $.fullCalendar.formatRange(calEvent.start, eventEnd, 'Do MMMM YYYY'),
                            assessmentSpan = $.fullCalendar.formatRange(calEvent.meta.assessmentStart, assessmentEnd, 'Do MMMM YYYY');

                        // Update contents
                        modal.find('[data-value]').each(function() {
                            var $this = $(this),
                                valueTag = $this.data('value');

                            switch (valueTag) {
                                case 'text':
                                    $this.text(calEvent.title);
                                    break;

                                case 'description':
                                    $this.html(calEvent.meta.description);
                                    break;

                                case 'eventSpan':
                                    var eventSpan = buildDateSpan(
                                        calEvent.start,
                                        calEvent.end,
                                        calEvent.allDay
                                    );
                                    $this
                                        .text(eventSpan.text)
                                        .attr('datetime', eventSpan.datetime);
                                    break;

                                case 'assessmentSpan':
                                    var assessmentSpan = buildDateSpan(
                                        moment(calEvent.meta.assessmentStart),
                                        moment(calEvent.meta.assessmentEnd),
                                        calEvent.allDay
                                    );
                                    $this
                                        .text(assessmentSpan.text)
                                        .attr('datetime', assessmentSpan.datetime);
                                    break;

                                case 'href':
                                    $this
                                        .attr('href', calEvent.meta.link)
                                        .removeClass('icon-home icon-due-work icon-quiz icon-task icon-project')
                                        .addClass(klass);
                                    break;

                                default:
                                    break;
                            }
                        });

                        modal.foundation('reveal', 'open');
                    }
                },

                customButtons: {
                    prevWindow: {
                        icon: 'left-single-arrow',
                        click: function() {
                            try {
                                // Step back one window from now
                                var duration = getDurationFromView(calendar.fullCalendar('getView'));
                                var date     = calendar.fullCalendar('getDate').clone();
                                calendar.fullCalendar('gotoDate', date.subtract(duration.quantity, duration.unit));
                                pushCurrentCalendarState();
                            } catch (e) {
                                // Just go to previous step
                                calendar.fullCalendar('prev');
                            }
                        }
                    },
                    today: {
                        text: 'Today',
                        click: function() {
                            calendar.fullCalendar('today');
                            pushCurrentCalendarState();
                        }
                    },
                    nextWindow: {
                        icon: 'right-single-arrow',
                        click: function() {
                            try {
                                // Step forward two windows from now, then back one window from that.
                                // This ensures that events that are in the next window but not this one get loaded.
                                var duration = getDurationFromView(calendar.fullCalendar('getView'));
                                var date     = calendar.fullCalendar('getDate').clone();
                                // Handle pushstate here because this triggers a second viewRender event.
                                // I don't want to pushstate twice.
                                calendar.fullCalendar('gotoDate', date.add(duration.quantity*2, duration.unit));
                                calendar.fullCalendar('gotoDate', date.subtract(duration.quantity, duration.unit));
                                pushCurrentCalendarState();
                            } catch (e) {
                                // Just go to next step
                                calendar.fullCalendar('next');
                            }
                        }
                    }
                },

                viewRender: function() {
                    var currentView = calendar.fullCalendar('getView');
                    var isTermView  = (currentView.type == 'timelineTerm');

                    // Only if the calendar view has changed
                    if (previousView.type != currentView.type) {
                        // Timeline term view: skip back to the first day of the 6-month cycle
                        if (isTermView) {
                            var date = calendar.fullCalendar('getDate').clone().date(1);
                            if (date.month() <= 6) {
                                // Moment months start at 0 :/
                                date = date.month(0);
                            } else {
                                date = date.month(6);
                            }
                            calendar.fullCalendar('gotoDate', date);
                        }

                        pushCurrentCalendarState();
                    }
                    previousView = currentView;

                    // Re-render the weeks bar
                    // First: starts on start of span, until Sunday
                    // Each one after: renders Monday
                    if (isTermView) {
                        var now         = moment();
                        var anotherDate = currentView.start.clone();
                        var datePiles   = {};
                        while (anotherDate.isBefore(currentView.end)) {
                            // Rewind to Monday
                            var key = anotherDate.clone().startOf('isoWeek').format('YYYY-MM-DD');
                            if (!(key in datePiles)) {
                                datePiles[key] = [];
                            }
                            datePiles[key].push(anotherDate);
                            anotherDate = anotherDate.clone().add({days: 1});
                        }

                        var columns = $();
                        $.each(datePiles, function(i, v) {
                            var firstDate = v[0];
                            var head = $('<th class="fc-widget-header" />')
                                .attr('data-date', firstDate.format('YYYY-MM-DD'))
                                .attr('colspan', v.length)
                                .addClass('fc-'+firstDate.format('ddd').toLowerCase());

                            if (firstDate.isBefore(now)) {
                                head.addClass('fc-past');

                            } else if (firstDate.isAfter(now)) {
                                head.addClass('fc-future');

                            } else {
                                head.addClass('fc-today');
                            }

                            // Contents
                            var content = $('<span class="fc-cell-text" />')
                                .text(firstDate.format('dd D'));
                            head.append($('<div class="fc-cell-content">').append(content));
                            columns = columns.add(head);
                        });
                        calendar.find('.fc-chrono').empty().append(columns);
                    }
                },

                eventResize: updateAssessment,

                eventDrop: updateAssessment,

                // Resources:
                // * all of this student's classes
                // ** Units (any unit imported onto this class)
                // ** Content Areas (any duework/quiz in one of these units)
                // ** Projects (any project in one of these units)
                // ** Activities (any assessment in one of those projects)
                // * each folder is a resource group
                // Does FC support nested groups?
                resources: {
                    dataType: 'json',
                    url:      '{{ routeLookup('learningPersonalised.getResourcesForStudent', {studentId: student.id}) }}'
                },
                resourceOrder: 'folderTitle',
                resourceColumns: [{
                    labelText: 'Assessment',
                    render: function(resource, el) {
                        el.find('.fc-cell-text').empty().text(resource.title);
                    }
                }],

                eventRender: function(event, element, view) {
                    // Set a title
                    if ('title' in event) {
                        // All day offset -_- FC is exclusive end, we want inclusive
                        var eventSpan = buildDateSpan(event.start, event.end, event.allDay);
                        element.attr('title', event.title + ' ('+eventSpan.text+')');
                    }
                },

                eventAfterAllRender: function(view) {
                    // Any resource whose children contain no events should be collapsed
                    $.each(view.resourceRowHash, function(key, resourceRow) {
                        if (expandedResources[key]) {
                            resourceRow.expand();
                        } else {
                            resourceRow.collapse();
                        }
                    });

                    // If on semester view: find this week and give it the today class
                    if (view.type == 'timelineTerm') {
                        var today = calendar.find('.fc-chrono .fc-widget-header.fc-today');
                        if (today.length === 0) {
                            // Find the last item in the past
                            var mostRecent = calendar.find('.fc-chrono .fc-widget-header.fc-past').last();
                            if (mostRecent.length > 0) {
                                // If I add one week to its date: is it still less than today?
                                var mostRecentDate = moment(mostRecent.data('date'), 'YYYY-MM-DD');
                                if (moment().isBefore(mostRecentDate.add({weeks: 1}))) {
                                    mostRecent.removeClass('fc-past').addClass('fc-today');
                                }
                            }
                        }
                    }

                    // Scroll to today if it's there
                    var scrollTo = calendar.find('.fc-widget-header .fc-today');
                    if (scrollTo.length) {
                        scrollTo.closest('.fc-scroller').scrollTo(scrollTo);
                    }
                },

                loading: function(isLoading) {
                    /* Show loading div right in the middle
                     */
                    if (isLoading === true) {
                        $.magnificPopup.open({
                            showCloseBtn: false,
                            items: {
                                src: "<div class='preview loader'></div>",
                                type: 'inline'
                            }
                        });
                    }
                    /* Has finished loading
                     */
                    else {
                        /* Hide loading div
                         */
                        $.magnificPopup.close();
                    }
                }
            },
            x: false
        }).init();
    });
</script>
{% endautoescape %}
