{#
Renders an Academic Achievement Summary component.

Data:
    error:               string           - Optional. If present, the reason why we can't render the component
    grid:                Rubric\Grid      - The rubric grid
    markedGrid:          MarkedGrid       - Optional. The student's marks for the rubric
    useMarkRange:        bool
    showDescriptorValue: bool
    showGroupTotal:      bool
    showRubricTotal:     bool
    showErrors           bool             - Should we render errors?
    dataAttributeError   string           - A string to apply as a data attribute to error alerts
#}

<div class="aas-wrap">
    <h3 class="subheader">Academic Achievement Summary</h3>
    {% if error|default(null) %}
        {% if showErrors %}<div data-alert {{ dataAttributeError }} class="alert-box alert">{{ error|raw }}</div>{% endif %}
    {% else %}
        <div class="aas">
            {% include '@rubric/grid.twig' with {
                rubricGrid: grid,
                rubricMarkedGrid: markedGrid,
                markVisibility: true,
                useMarkRange: useMarkRange,
                showDescriptorValue: showDescriptorValue,
                showGroupTotal: showGroupTotal,
                showRubricTotal: showRubricTotal
            } only %}
        </div>
    {% endif %}
</div>
