{#
Renders the 'HSC Assessment Rank' component.

Data:
    error:             string           - Optional. If present, the reason why we can't render the component
    studentMark:       string|null      - Optional. eg '65 %'
    cohortAverage:     string|null      - Optional. eg '76.33 %'    The average mark given to students across the cohort
    cohortRank:        string|null      -           eg '7 / 9'      Where the student ranked compared to the cohort
    showErrors         bool             - Should we render errors?
    dataAttributeError string           - A string to apply as a data attribute to error alerts
#}
<div class="hsc-rank-wrap">
    <h2 class="subheader">HSC Assessment Rank</h2>
    {% if error|default(null) %}
        {% if showErrors %}<div data-alert {{ dataAttributeError }} class="alert-box alert">{{ error|raw }}</div>{% endif %}
    {% else %}
        <div class="scrollable">
            <table class="hsc-rank">
                <tbody>
                {% if studentMark is defined %}
                    <tr>
                        <th>Assessment Mark</th>
                        <td>{{ studentMark|default('-') }}</td>
                    </tr>
                {% endif %}
                {% if cohortAverage is defined %}
                    <tr>
                        <th>Assessment Average</th>
                        <td>{{ cohortAverage|default('-') }}</td>
                    </tr>
                {% endif %}
                <tr>
                    <th>Assessment Rank</th>
                    <td>{{ cohortRank|default('-') }}</td>
                </tr>
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
