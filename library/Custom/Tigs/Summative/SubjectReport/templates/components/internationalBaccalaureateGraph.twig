{#
Renders a MYP/DP graph.

Data:
    error:               string        - Optional. If present, the reason why we can't render the component
    studentMark:         int|null      - Optional. The student's mark for the IB graph assessment
    studentComment:      string|null   - Optional. The student's comment for the IB graph assessment
    data:                array         - The results to render. key: column, value: height
    useComment:          bool          - Whether to render the student's comment, instead of the graph
    showComponent:       bool          - Whether the component should be shown at all (used by including template)
    showErrors:          bool          - Should we render errors?
    dataAttributeError   string        - A string to apply as a data attribute to error alerts
#}
{% import '@learning/macro/urgency.twig' as urgency %}
{% set gradientClass = studentMark is null ? '' : urgency.marks(studentMark / 7 * 100) ~ '-bg' %}

<h2 class="subheader">{{ header }}</h2>

{% if error|default(null) %}
    {% if showErrors %}<div data-alert {{ dataAttributeError }} class="alert-box alert">{{ error|raw }}</div>{% endif %}
{% else %}

    <div {% if gradientClass %}class="{{ gradientClass }}"{% endif %}>
        <h3 class="grade-heading {% if gradientClass %}has-gradient{% endif %}">{{ studentMark|default('-') }}</h3>
    </div>

    {% if useComment %}
        <blockquote>{{ studentComment|nl2br }}</blockquote>
    {% else %}

        {% autoescape 'js' %}
        <script type="text/javascript">


            $(function(){

                var rawData = {{ data|json_encode|raw }},
                    studentMark = Number("{{ studentMark }}");

                {#
                    Convert into object format so we can add css classes for colour gradients.
                    @see https://api.highcharts.com/highcharts/series.column.data
                #}
                var data = [];
                for(var key in rawData){
                    if(!rawData.hasOwnProperty(key)){
                        continue;
                    }
                    var column = {
                        x: Object.keys(rawData).length + 1 - Number(key), // Reverse order, highest value first
                        y: rawData[key],
                        name: rawData[key]
                    };
                    if(studentMark === Number(key)){
                        column.className = '{{ gradientClass }}';
                    } else {
                        column.color = '#454549';
                    }
                    data.push(column);
                }

                $("#ib-graph").highcharts({
                    legend: {
                        enabled: false
                    },
                    credits: {
                        enabled: false
                    },
                    title: {
                        text: null
                    },
                    tooltip: {
                        enabled: false
                    },
                    xAxis: {
                        title: {
                            text: null
                        },
                        min: 0.5,
                        tickInterval: 1,
                        max: 7.5,
                        labels: {
                            formatter: function() {
                                return Object.keys(rawData).length + 1 - this.pos;
                            }
                        }
                    },
                    yAxis: {
                        title: {
                            text: '# Students (Cohort)'
                        },
                        allowDecimals: false
                    },
                    series: [
                        {
                            type: 'column',
                            data: data,
                            label: {
                                enabled: false
                            }
                        }
                    ]
                });
            });
        </script>
        {% endautoescape %}
        <div id="ib-graph" class="grade-graph"></div>
    {% endif %}
{% endif %}
