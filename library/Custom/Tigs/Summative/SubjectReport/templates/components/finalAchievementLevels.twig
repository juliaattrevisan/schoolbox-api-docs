{#
Renders a `MYP Final Achievement Levels` component.

This is a table derived from a rubric.

Data:
    error:               string           - Optional. If present, the reason why we can't render the component
    data:                int[]:           - Optional. The student's marks for the rubric
    showErrors           bool             - Should we render errors?
    dataAttributeError   string           - A string to apply as a data attribute to error alerts
#}
<div class="fal-wrap">
<h2 class="subheader fal-heading">MYP Final Achievement Levels</h2>
{% if error|default(null) %}
    {% if showErrors %}<div data-alert {{ dataAttributeError }} class="alert-box alert">{{ error|raw }}</div>{% endif %}
{% else %}
    <div class="scrollable">
        <table class="fal">
            <thead>
            <tr>
                <td>Criterion</td>
                <td>Mark</td>
            </tr>
            </thead>
            <tbody>
            {% for criterion, mark in data.marks %}
                <tr>
                    <td>{{ criterion | nl2br }}</td>
                    <td>{{ mark|default('-') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
</div>
<br>
