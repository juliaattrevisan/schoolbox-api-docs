{#
Renders a `MYP Final Achievement Levels` component.

This is a table derived from a rubric.

Data:
    error:               string           - Optional. If present, the reason why we can't render the component
    data:                int[]:           - Optional. The student's marks for the rubric
#}

<h2 class="subheader">MYP Final Achievement Levels</h2>
{% if error|default(null) %}
    <div data-alert class="alert-box alert">{{ error|raw }}</div>
{% else %}
    <table>
        <thead>
        <tr>
            <td>Criterion</td>
            <td>Mark</td>
        </tr>
        </thead>
        <tbody>
        {% for criterion, mark in data %}
            <tr>
                <td>{{ criterion }}</td>
                <td>{{ mark }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
<br>
