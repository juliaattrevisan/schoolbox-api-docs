{#
Renders a NESA Grade graph.

Data:
    error:               string   - Optional. If present, the reason why we can't render the component
    studentMark:         int|null - Optional. The student's mark for the NESA graph assessment
    cohortMarks:         array    - The results to render. key: column, value: height
    semester:            int      - Which semester this is for
    showErrors           bool     - Should we render errors?
    dataAttributeError   string   - A string to apply as a data attribute to error alerts
#}
{% import '@learning/macro/urgency.twig' as urgency %}

{# Convert A-E to a normalised value for gradient colours #}
{% set studentMarks = {'A': 5, 'B': 4, 'C': 3, 'D': 2, 'E': 1} %}
{% set normalisedMark = studentMarks[studentMark] / (studentMarks | length) * 100 %}
{% set gradientClass = studentMark is null ? '' : urgency.marks(normalisedMark) ~ '-bg' %}
{% set graphId = 'nesa-graph' ~ semester %}

<div class="nesa-wrap">
{% if error|default(null) %}
    {% if showErrors %}<div data-alert {{ dataAttributeError }} class="alert-box alert">{{ error|raw }}</div>{% endif %}
{% else %}
    <div{% if gradientClass %} class="{{ gradientClass }}"{% endif %}>
        <h3 class="grade-heading {% if gradientClass %}has-gradient{% endif %}">{{ studentMark|default('-') }}</h3>
    </div>
    {% if comment %}
    <blockquote>{{ comment.comment|nl2br }}</blockquote>
    {% endif %}

    {% autoescape 'js' %}
        <script type="text/javascript">

            $(function () {

                var rawData = {{ cohortMarks|json_encode|raw }},
                    studentMark = "{{ studentMark }}",
                    studentMarks = {{ studentMarks|json_encode|raw }},
                    studentMarksInverted = {};

                for (var key in studentMarks) {
                    if (!studentMarks.hasOwnProperty(key)) {
                        continue;
                    }
                    studentMarksInverted[Object.keys(studentMarks).length + 1 - studentMarks[key]] = key;
                }

                {#
                    Convert into object format so we can add css classes for colour gradients.
                    @see https://api.highcharts.com/highcharts/series.column.data
                #}
                var data = [];
                for (var key in rawData) {
                    if (!rawData.hasOwnProperty(key)) {
                        continue;
                    }
                    var column = {
                        x: Object.keys(studentMarks).length + 1 - studentMarks[key],
                        y: rawData[key],
                        name: key
                    };
                    if (studentMark === key) {
                        column.className = '{{ gradientClass }}';
                    } else {
                        column.color = '#454549';
                    }
                    data.push(column);
                }

                $("#{{ graphId }}").highcharts({
                    legend: {
                        enabled: false
                    },
                    credits: {
                        enabled: false
                    },
                    title: {
                        text: null
                    },
                    tooltip: {
                        enabled: false
                    },
                    xAxis: {
                        title: {
                            text: null
                        },
                        categories: studentMarksInverted
                    },
                    yAxis: {
                        title: {
                            text: '# Students (Cohort)'
                        },
                        allowDecimals: false
                    },
                    series: [
                        {
                            type: 'column',
                            data: data,
                            label: {
                                enabled: false
                            }
                        }
                    ]
                });
            });
        </script>
    {% endautoescape %}
    <div id="{{ graphId }}" class="grade-graph"></div>
{% endif %}
</div>
