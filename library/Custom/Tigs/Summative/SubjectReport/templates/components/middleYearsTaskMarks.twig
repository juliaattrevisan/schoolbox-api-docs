{#
 # Renders a Middle Years Task Marks component.
 #
 # @param string $error               Optional. If present, the reason why we can't render the component
 # @param string|null $studentMark    eg '15 %'
 # @param string|null $cohortAverage  eg '25 %'
 # @param bool $showErrors            Should we render errors?
 # @param string $dataAttributeError  A string to apply as a data attribute to error alerts
#}

<style>
    table.middle-years-task-marks th {
        width: 150px;
    }
</style>

<div class="middle-years-task-marks-wrap">
<p class="meta middle-years-task-marks-heading">Task Marks (%)</p>
{% if error|default(null) %}
    {% if showErrors %}<div data-alert {{ dataAttributeError }} class="alert-box alert">{{ error|raw }}</div>{% endif %}
{% else %}
    <div class="scrollable">
        <table class="middle-years-task-marks">
            <tbody>
                <tr>
                    <th>Student Mark %</th>
                    <td>{{ studentMark|default('-') }}</td>
                </tr>
                <tr>
                    <th>Cohort Average %</th>
                    <td>{{ cohortAverage }}</td>
                </tr>
            </tbody>
        </table>
    </div>
{% endif %}
</div>
