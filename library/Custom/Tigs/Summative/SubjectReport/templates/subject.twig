{#
Displays a report for the selected user and folder for the current term.

Data:
    user:                     User                  - a student in years 7-12
    folder:                   Folder\Model          - a class folder
    teachers:                 User[]                - teachers of this class folder
    courseSpec:               CourseSpec\Model|null - if present, the single courseSpec imported to this class
    isEnabled:                bool                  - is this report enabled for the student and their parents?
    showNoLongerEnrolledAlert bool                  - should we show an alert indicating the student has left this class?
    attributes:               StudentAttributes
    errors                    string[]              - Any errors that affect the whole page
    unitSpecs                 unitSpec\Model        - Unit specs which contains visible data imported to this folder.
    courseDescription         null|string           - If present, the text from a specific textbox on the imported CourseSpec's homepage
    aasData                   array                 - Data to render the Academic Achievement Summary components
    aamData                   array                 - Data to render the Approaches to Learning components
    hscTaskMarks              array                 - Data to render the HSC Task Marks components
    hscTaskMarks['error']     string                - Optional. If present, the reason we can't render these components
    hscTaskMarks['data']      array                 - Optional. If present, the per-unit data. Indexed by unitSpec.id
    hscRankData               array                 - Data to render the 'HSC Assessment Rank' component
    nesaGraphData             array                 - Data to render the NESA Grade Graph component
    showErrors                bool                  - Should we render errors?
    dataAttributeError      string                - A string to apply as a data attribute to error alerts
#}
{% import '@tigsSubjectReport/student-attributes-macro.twig' as macro %}

{# Extra data to pass to each component #}
{% set extraComponentData = {
    showErrors: showErrors,
    dataAttributeError: dataAttributeError
} %}
<style>
    .tigs-crp .linked-unit-heading {
        color: inherit;
    }

    /* These manifest in the NESA graph twig fragments
     */
    .tigs-crp .grade-graph {
        margin-bottom: 2rem;
    }

    .tigs-crp .grade-heading {
        text-align: center;
        margin-bottom: 0;
    }

    .tigs-crp .grade-heading.has-gradient {
        color: white;
    }

    /* The Task Marks tables all have a similar and consistent appearance
     * They appear at the bottom of the Subject Report for a specific folder
     * and contain Student Mark, Cohort Average, etc.
     */
    .tigs-crp .task-marks-wrap {
        margin-bottom: 1rem;
    }

    .tigs-crp .task-marks-wrap th {
        width: 150px;
    }
</style>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/highcharts.js?v={{ config.site_version }}"></script>
<div class="tigs-crp subject-report {{ macro.cssClasses(attributes) }}">
    <div class="row header">
        <div class="island small-12">
            <h1>{{ courseSpec ? courseSpec.title : folder.title }}</h1>
            <p class="meta">Curriculum Year {{ attributes.curriculumYearLevel }}, Semester {{ attributes.curriculumSemester }}</p>
            {% if not isEnabled %}
                <div data-alert class="alert-box highlight">
                    This report is currently not visible to the student or their parents.
                </div>
            {% endif %}
            {% if showNoLongerEnrolledAlert %}
                <div data-alert class="alert-box highlight">
                    Student is not currently enrolled in this class, but has submitted work and/or received marks.
                </div>
            {% endif %}
            {% for error in errors %}
                {% if showErrors %}
                <div data-alert {{ dataAttributeError }} class="alert-box alert">
                    {{ error|raw }}
                </div>
                {% endif %}
            {% endfor %}
            {% if aasData.error is defined and showErrors %}
                <div data-alert {{ dataAttributeError }} class="alert-box alert">
                    {{ aasData.error|raw }}
                </div>
            {% endif %}
            {% if aamData.error is defined and showErrors %}
                <div data-alert {{ dataAttributeError }} class="alert-box alert">
                    {{ aamData.error|raw }}
                </div>
            {% endif %}
            {% if hscTaskMarks.error is defined and showErrors %}
                <div data-alert {{ dataAttributeError }} class="alert-box alert">
                    {{ hscTaskMarks.error|raw }}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="row student-teacher">
        <div class="column small-12 medium-6 student">
            <h2 class="subheader">Student</h2>
            <div class="card small-12">
                {% include 'include/portrait.twig' with {user: user} only %}
                <h3><a href="/search/user/{{ user.id }}">{{ user.fullName }}</a></h3>
                <p class="meta">{{ user.role.name }}</p>
            </div>
        </div>
        <div class="column small-12 medium-6 teacher">
            <h2 class="subheader">Class Teacher{% if teachers | length > 1 %}s{% endif %}</h2>
            {% for teacher in teachers %}
                <div class="card small-12">
                    {% include 'include/portrait.twig' with {user: teacher} only %}
                    <h3><a href="/search/user/{{ teacher.id }}">{{ teacher.fullName }}</a></h3>
                    <p class="meta">{{ teacher.role.name }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
    <hr/>

    {% if courseDescription %}
    <div class="row course-description">
        <div class="island small-12">
            <h2 class="subheader">Description</h2>
            <section class="content">
                <p>{{ courseDescription | raw }}</p>
            </section>
        </div>
    </div>
    {% endif %}

    <div class="row">
        {% if hscRankData %}
        <div class="column small-12">
            {% include '@tigsSubjectReport/components/hscAssessmentRank.twig' with hscRankData|merge(extraComponentData) only %}
        </div>
        {% endif %}

        {# Show a meaningful error message for the user, if needed #}
        {% if nesaGraphData.error|default(null) %}
        <div class="column small-12 nesa">
            <div data-alert {{ dataAttributeError }} class="alert-box alert">{{ nesaGraphData.error|raw }}</div>
        </div>
        {% elseif nesaGraphData.data is defined %}

            {# Display NESA graphs side by side, where possible #}
            {% for semester, nesaGraphDatum in nesaGraphData.data %}
            <div class="column small-12 medium-6 nesa">
                <div class="semester-{{ semester }}">
                <h2 class="subheader">NESA Grade (Semester {{ semester }})</h2>
                    {% include '@tigsSubjectReport/components/nesaScoreGraph.twig' with nesaGraphDatum|merge(extraComponentData) only %}
                </div>
            </div>
            {% endfor %}
        {% endif %}

        {% for unitSpec in unitSpecs %}
            {% set unitSpecId = unitSpec.id %}

            <div class="unit">
                <div class="column small-12">

                    {# Do we have a link to an AAS assessment for this unit? #}
                    {% set unitRoute = (aasData.data is defined and aasData.data[unitSpecId] is defined) ? aasData.data[unitSpecId].link : '' %}
                    {% if unitRoute %}
                        <h2 class="subheader"><a href="{{ unitRoute }}"><span class="icon-link linked-unit-heading"></span>{{ unitSpec.title }}</a></h2>
                    {% else %}
                        <h2 class="subheader">{{ unitSpec.title }}</h2>
                    {% endif %}
                </div>

                {# All the Task Marks table sit in the left column
                 # any existing commentary in the right column
                 #}
                <div class="small-12 column">
                    <div class="row">
                        <div class="small-12 medium-4 columns">
                            {# Middle Years Task Marks #}
                            {% if middleYearsTaskMarks.data is defined and middleYearsTaskMarks.data[unitSpecId] is defined %}
                                {% include '@tigsSubjectReport/components/middleYearsTaskMarks.twig' with middleYearsTaskMarks.data[unitSpecId]|merge(extraComponentData) only %}
                            {% endif %}

                            {# Were we given HSC Task Marks data for this unit? #}
                            {% if hscTaskMarks.data is defined and hscTaskMarks.data[unitSpecId] is defined %}
                                {% include '@tigsSubjectReport/components/hscTaskMarks.twig' with hscTaskMarks.data[unitSpecId]|merge(extraComponentData) only %}
                            {% endif %}
                        </div>
                        <div class="small-12 medium-8 columns">
                            {# Comments come from different assessments, depending on student type #}

                            {% if attributes.isHsc %}
                                {% set commentData = hscTaskMarks.data[unitSpecId] %}
                            {% else %}
                                {% set commentData = aamData.data[unitSpecId] %}
                            {% endif %}

                            {% if commentData.comment is defined and commentData.comment %}
                                <div class="small-12 island comments">
                                    <h4 class="subheader">Comments by {{ commentData.commentBy.fullname }}</h4>
                                    <section class="content">
                                        <p>{{ commentData.comment | nl2br }}</p>
                                    </section>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="small-12 columns">
                    {# Were we given AAS data for this unit? #}
{#                    {% if aasData.data is defined and aasData.data[unitSpecId] is defined %}#}
{#                        {% include '@tigsSubjectReport/components/academicAchievementSummary.twig' with aasData.data[unitSpecId]|merge(extraComponentData) only %}#}
{#                    {% endif %}#}

                    {# Were we given AAM data for this unit? #}
                    {% if aamData.data is defined and aamData.data[unitSpecId] is defined %}
                        {% include '@tigsSubjectReport/components/academicAchievementMatrix.twig' with aamData.data[unitSpecId]|merge(extraComponentData) only %}
                    {% endif %}

                    {# Were we given HSC Task Marks data for this unit? This mark shares the same twig as AAM #}
                    {% if hscTaskMatrix.data is defined and hscTaskMatrix.data[unitSpecId] is defined %}
                        {% include '@tigsSubjectReport/components/academicAchievementMatrix.twig' with hscTaskMatrix.data[unitSpecId]|merge(extraComponentData) only %}
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
