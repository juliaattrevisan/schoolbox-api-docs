{#
Displays a report for the selected user and current term.

Data:
    user:                   User                - a student in years 7-12
    isEnabled               bool                - is the report enabled for the student and their parents to visit?
    attributes:             StudentAttributes
    dean:                   User|null
    mentor:                 User|null
    awards:                 Award[]
    awards[idx].name:       string
    awards[idx].detail:     string
    houseEvents:            HouseEvent[]
    houseEvents[idx].name
    houseEvents[idx].status
    subjects                array
    subjects[idx].name      string
    subjects[idx].codes     string[]
    subjects[idx].folderId  int
    subjects[idx].teachers  User[]
    explanation             null|string         - Explanation of the student's grades
    reportDate              null|string
#}
{% import '@tigsSubjectReport/student-attributes-macro.twig' as macro %}
<div class="tigs-crp continuous-report {{ macro.cssClasses(attributes) }}">
    <div class="row header">
        <div class="island small-12">
            <h1>Continuous Report: {{ user.fullName }}</h1>
            <p class="meta">Curriculum Year {{ attributes.curriculumYearLevel }}, Semester {{ attributes.curriculumSemester }}</p>
            {% if not isEnabled %}
                <div data-alert class="alert-box highlight">
                    This report is currently not visible to the student or their parents.
                </div>
            {% endif %}
        </div>
    </div>

    <div class="row student">
        <div class="column small-12">
            <h2 class="subheader">Student</h2>
            <div class="card small-12">
                <img src="/portrait.php?userId={{ user.externalId }}&amp;size=square64" alt="View Profile">
                <h3><a href="/search/user/{{ user.id }}">{{ user.fullName }}</a></h3>
                <p class="meta">{{ user.role.name }}</p>
                <p class="meta">Unapproved absences: Semester 1 <span class="label neutral">{{ absences[1] }}</span> Semester 2 <span class="label neutral">{{ absences[2] }}</span></p>
            </div>
        </div>
    </div>

    <div class="row dean-mentor">
        <div class="column small-12 medium-6 dean">
            <h2 class="subheader">Dean</h2>
            <div class="card small-12">
                <img src="/portrait.php?userId={{ dean.externalId }}&amp;size=square64" alt="View Profile">
                <h3>
                    {%- if dean.id -%}
                        <a href="/search/user/{{ dean.id }}">{{ dean.fullName }}</a>
                    {%- else -%}
                        {{ dean.fullName }}
                    {%- endif -%}
                </h3>
                {% if dean.role.name %}<p class="meta">{{ dean.role.name }}</p>{% endif %}
            </div>
        </div>
        <div class="column small-12 medium-6 mentor">
            <h2 class="subheader">Student Mentor</h2>
            <div class="card small-12">
                <img src="/portrait.php?userId={{ mentor.externalId }}&amp;size=square64" alt="View Profile">
                <h3>
                    {%- if mentor.id -%}
                        <a href="/search/user/{{ mentor.id }}">{{ mentor.fullName }}</a>
                    {%- else -%}
                        {{ mentor.fullName }}
                    {%- endif -%}
                </h3>
                {% if mentor.role.name %}<p class="meta">{{ mentor.role.name }}</p>{% endif %}
            </div>
        </div>
    </div>

    {# Do we have any deans' comments to display? #}
    {% set hasDeansComments = false %}
    {% for deansComment in deansComments %}
        {% if deansComment %}
            {% set hasDeansComments = true %}
        {% endif %}
    {% endfor %}

    {% if hasDeansComments %}
        <div class="row dean-comments">
            {% for i in 1..2 %}
                {% if deansComments[i] %}
                <div class="dean-comment semester-{{ i }} small-12 medium-6 island">
                    <h2 class="subheader">Dean's Comment - Semester {{ i }}</h2>
                    <section class="content">
                        {{ deansComments[i] | purify }}
                    </section>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}

    <div class="row awards">
        <div class="column small-12">
            <h2 class="subheader">{{ attributes.calendarYear }} Awards</h2>
            <table>
                <thead>
                    <tr>
                        <td>Award</td>
                        <td>Description</td>
                    </tr>
                </thead>
                <tbody>
                {% for award in awards %}
                    <tr>
                        <td>{{ award.name }}</td>
                        <td>{{ award.detail | nl2br }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="row attendance">
        <div class="column small-12">
            <h2 class="subheader">{{ attributes.calendarYear }} House Attendance</h2>
            <table>
                <thead>
                <tr>
                    <td>Event</td>
                    <td>Participation</td>
                </tr>
                </thead>
                <tbody>
                {% for houseEvent in houseEvents %}
                    <tr>
                        <td>{{ houseEvent.name }}</td>
                        <td>{{ houseEvent.status }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="row subject-list-group">
        <div class="small-12 island">
            {% include '@tigsParticipationReport/fragments/academicTranscript.twig' with {
                attributes: attributes,
                student:    user,
                subjects:   subjects,
                data:       academicTranscript,
                reportDate: reportDate
            } only %}
        </div>
    </div>

    {% if explanation is not null %}
    <div class="row explanation-grades">
        <div class="small-12 island">
            <h2 class="subheader">Explanation of Grades</h2>
            <section class="content">
                {{ explanation | purify }}
            </section>
        </div>
    </div>
    {% endif %}
</div>
