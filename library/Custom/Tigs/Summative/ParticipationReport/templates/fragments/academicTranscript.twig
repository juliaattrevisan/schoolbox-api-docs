{#
Data:
    attributes                                                   StudentAttributes
    student                                                      User
    subjects                                                     array
    subjects[idx].name                                           string
    subjects[idx].codes                                          string[]
    subjects[idx].folderId                                       int
    subjects[idx].isPreviousClass                                bool
    data[folderId]                                               array
    data[folderId].folder                                        Folder\Model
    data[folderId].teachers                                      User[]
    data[folderId]['aasData']                                    array
    data[folderId]['aasData']['data']                            array
    data[folderId]['aasData']['data'][unitSpecId]                array
    data[folderId]['aasData']['data'][unitSpecId]['comment']     string
    data[folderId]['aasData']['data'][unitSpecId]['capabilityMarks'] string[]|null[]
    data[folderId]['nesaGraphData'][idx]['showComponent']        string
    data[folderId]['nesaGraphData'][idx]['studentMark']          string
    data[folderId]['unitspecs']                                  array   Sorted by most recent first
    data[folderId]['unitspecs'][idx][id]                         int
    data[folderId]['unitspecs'][idx][dueDate]                    ADF     Copied from a relevant dueWork inside the unit
    data[folderId]['unitspecs'][idx][title]                      string
    reportDate                                                   null|string
#}
<style>
    .legend {
        position: absolute;
        right: 2rem;
        top: 1rem;
    }
    .results {
        color: black;
        text-align: right;
    }
    .result-group {
        display: inline-block;
        background-color: #ccc;
        text-align: center;
        vertical-align: top;
    }
    .result-group.error{
        background-color: #fa4a47;
        color: white;
    }
    .result-item {
        display: inline-block;
        padding: 4px 12px;
    }
    .result-heading {
        font-weight: bold;
    }
    .subject-list > .subject-list-item{
        margin-bottom: 0.5rem;
        background-color: white;
    }
    .teacher-comment{
        color: black;
    }
    @media (max-width: 640px) {
        .results {
            text-align: left;
        }
    }
    @media (max-width: 340px) {
        .legend {
            position: relative;
            right: 0;
            top: 0;
        }
    }
</style>

<h2 class="subheader">Academic Transcript</h2>
<div>
    {#
        We need to assign the subjectList markup to a variable and defer its render, so that we
        can detect if any interim grades are present, and print a legend above the markup if they are.
     #}
    {% set hasInterminGrades = false %}
    {% set subjectListHtml %}
        <ul class="subject-list">
            {% for subject in subjects %}
                {% set folderId = subject.folderId %}
                {% set folderData = data[folderId] %}
                {% set firstTeacher = folderData.teachers | first %}

                <li class="subject-list-item">
                    <a href="{{ routeLookup('tigsSubjectReport.getReport', {userId: student.id, folderId: subject.folderId, reportDate: reportDate}) }}" class="link-row">
                        <div class="card small-12 medium-6">

                            {% if firstTeacher %}
                            <img src="/portrait.php?id={{ firstTeacher.id }}&amp;size=square64" width="48" alt="{{ firstTeacher.fullName }}">
                            {% endif %}
                            <h3 class="subject-name">{{ subject.name }}
                                <span class="meta">
                                {% for code in subject.codes %}
                                    ({{ code }}){% if not loop.last %},{% endif %}
                                {% endfor %}
                            </span>
                            </h3>

                            {% if firstTeacher %}
                            <div class="meta">
                                <p class="teacher-name">{{ firstTeacher.fullName }} <span class="pipe meta">{{ firstTeacher.role.name }}</span></p>
                            </div>
                            {% endif %}
                        </div>
                        <div class="column small-12 medium-6 results">
                            {% if not subject.isPreviousClass %}
                                <div class="result-group fal">

                                    {# No explicit FAL data found, fall back to latest AAS assessment #}
                                    {% set aasFound = false %}
                                    {# These units are ordered from latest to oldest #}
                                    {% for unitSpecData in folderData.unitSpecs if not aasFound %}
                                        {% if folderData.aasData|length %}
                                            {% if folderData.aasData.data[unitSpecData.id].capabilityMarks %}
                                                {% set aasFound = true %}
                                                {% set hasInterminGrades = true %}
                                                {% for label, value in folderData.aasData.data[unitSpecData.id].capabilityMarks %}
                                                    <div class="result-item">
                                                        <span class="result-heading">{{ label | last }}{% if loop.last %} *{% endif %}</span><br>
                                                        <span class="result-value">{{ value|default('-') }}</span>
                                                    </div>
                                                {% endfor %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                </div>

                                {# If we have explicit HscRank data, use that, otherwise fall back to most recent HscTaskMark assessment #}
                                {% if attributes.isHsc %}
                                    {% if folderData.hscRankData %}
                                        <div class="result-group hsc-rank">
                                            {% if folderData.hscRankData.assessmentMark is defined %}
                                                <div class="result-item hsc-rank-mark">
                                                    <span class="result-heading">Mark</span><br>
                                                    <span class="result-value">{{ folderData.hscRankData.assessmentMark|default('-') }}</span>
                                                </div>
                                            {% endif %}
                                            {% if folderData.hscRankData.assessmentAverage is defined %}
                                                <div class="result-item hsc-rank-average">
                                                    <span class="result-heading">Average</span><br>
                                                    <span class="result-value">{{ folderData.hscRankData.assessmentAverage|default('-') }}</span>
                                                </div>
                                            {% endif %}
                                            {% if folderData.hscRankData.assessmentRank is defined %}
                                            <div class="result-item hsc-rank-rank">
                                                <span class="result-heading">Rank</span><br>
                                                <span class="result-value">{{ folderData.hscRankData.assessmentRank|default('-') }}</span>
                                            </div>
                                            {% endif %}
                                        </div>
                                    {% else %}
                                        <div class="result-group hsc-rank">
                                        {% set hasTaskFound = false %}
                                        {% for unitSpecData in folderData.unitSpecs if not hasTaskFound %}
                                            {% if folderData.hscTaskMarks.data[unitSpecData.id] ?? false %}
                                                {% set hasTaskFound = true %}
                                                {% set hasInterminGrades = true %}
                                                {% set hscTaskMarkData = folderData.hscTaskMarks.data[unitSpecData.id] %}
                                                {% if hscTaskMarkData.studentMark is defined %}
                                                    <div class="result-item hsc-rank-mark">
                                                        <span class="result-heading">Mark*</span><br>
                                                        <span class="result-value">{{ hscTaskMarkData.studentMark|default('-') }}</span>
                                                    </div>
                                                {% endif %}
                                                {% if hscTaskMarkData.cohortAverage is defined %}
                                                    <div class="result-item hsc-rank-average">
                                                        <span class="result-heading">Average*</span><br>
                                                        <span class="result-value">{{ hscTaskMarkData.cohortAverage|default('-') }}</span>
                                                    </div>
                                                {% endif %}
                                                {% if hscTaskMarkData.cohortRank is defined %}
                                                    <div class="result-item hsc-rank-rank">
                                                        <span class="result-heading">Rank*</span><br>
                                                        <span class="result-value">{{ hscTaskMarkData.cohortRank|default('-') }}</span>
                                                    </div>
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                        </div>
                                    {% endif %}
                                {% elseif attributes.isMiddleYear %}
                                    {% if folderData.middleYearsRankData %}
                                        <div class="result-group middle-years-rank">
                                            {% if folderData.middleYearsRankData.assessmentMark is defined %}
                                                <div class="result-item middle-years-rank-mark">
                                                    <span class="result-heading">Mark</span><br>
                                                    <span class="result-value">{{ folderData.middleYearsRankData.assessmentMark|default('-') }}</span>
                                                </div>
                                            {% endif %}
                                            {% if folderData.middleYearsRankData.assessmentAverage is defined %}
                                                <div class="result-item middle-years-rank-average">
                                                    <span class="result-heading">Average</span><br>
                                                    <span class="result-value">{{ folderData.middleYearsRankData.assessmentAverage|default('-') }}</span>
                                                </div>
                                            {% endif %}
                                            {% if folderData.middleYearsRankData.assessmentRank is defined %}
                                                <div class="result-item middle-years-rank-rank">
                                                    <span class="result-heading">Rank</span><br>
                                                    <span class="result-value">{{ folderData.middleYearsRankData.assessmentRank|default('-') }}</span>
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% else %}
                                        <div class="result-group middle-years-rank">
                                            {% set middleYearsTaskMarks = null %}

                                            {% for unitSpecData in folderData.unitSpecs if not hasTaskFound %}

                                                {# folderData.unitSpecs might not be in the intended order
                                                 # Unit 2 might appear before Unit 1 if their unitSpecs are
                                                 # in the wrong order somehow. It can be manufactured though
                                                 # I don't know the steps to do it, exactly
                                                 #
                                                 # Anyway traverse until you find the most recent publishAt
                                                 # then use that data
                                                 #}
                                                {% if folderData.middleYearsTaskMarks.data[unitSpecData.id] ?? false %}
                                                    {% set middleYearsTaskMarks = folderData.middleYearsTaskMarks.data[unitSpecData.id] %}

                                                    {# Remember the data which the most recent publishAt
                                                     # Keep looking until there aren't any records more recent
                                                     #}
                                                    {% if middleYearsTaskMarks.publishAt > mostRecentData.publishAt or middleYearsTaskMarks is null%}
                                                        {% set mostRecentData = middleYearsTaskMarks %}
                                                    {% endif %}
                                                {% endif %}
                                            {% endfor %}

                                            {% set hasInterminGrades = true %}

                                            {# Render the grey bricks as you intended, when each is available
                                             #}
                                            {% if middleYearsTaskMarks.studentMark is defined %}
                                                <div class="result-item middle-years-rank-mark">
                                                    <span class="result-heading">Mark*</span><br>
                                                    <span class="result-value">{{ middleYearsTaskMarks.studentMark|default('-') }}</span>
                                                </div>
                                            {% endif %}
                                            {% if middleYearsTaskMarks.cohortAverage is defined %}
                                                <div class="result-item middle-years-rank-average">
                                                    <span class="result-heading">Average*</span><br>
                                                    <span class="result-value">{{ middleYearsTaskMarks.cohortAverage|default('-') }}</span>
                                                </div>
                                            {% endif %}
                                            {% if middleYearsTaskMarks.cohortRank is defined %}
                                                <div class="result-item middle-years-rank-rank">
                                                    <span class="result-heading">Rank*</span><br>
                                                    <span class="result-value">{{ middleYearsTaskMarks.cohortRank|default('-') }}</span>
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                {% endif %}

                                {% set nesaGraphData = folderData.nesaGraphData.data | default(null) %}

                                {% if nesaGraphData %}
                                    {% set nesaGraphDatum = folderData.nesaGraphData.data | first %}
                                    {% if nesaGraphDatum  %}
                                        <div class="result-group{% if nesaGraphDatum.error|default(false) %} error{% endif %}">
                                            <div class="result-item nesa-grade">
                                                <span class="result-heading">NESA Grade</span><br>
                                                <span class="result-value">{{ nesaGraphDatum.studentMark|default('-') }}</span>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endif %}

                            {% endif %}
                        </div>

                        {# Search for comments. If they were in a previous class - it's now rolled over etc. - then
                         # just say that and carry onwards. There's nothing we can show
                         #
                         # If there is a NESA worktype feedback, then show its comment first
                         #
                         # Otherwise fall back to showing the most recent comment from the student's feedbacks
                         #}
                        {% if subject.isPreviousClass %}
                            {% set commentData = { comment: 'Student is no longer enrolled in this class.' } %}
                        {% else %}
                            {% set commentData = { comment: null } %}

                            {# buildNesaScoreData returns an empty array or an array with data
                             # If there's data in it, try loading semester 2 comment first,
                             # otherwise try to load semester 1 comment instead.
                             #
                             # An empty array means there isn't any NESA data and you should fall
                             # back to finding the most recent feedbacks' comment instead
                             #}
                            {% if folderData.nesaGraphData.data.2 is defined and folderData.nesaGraphData.data.2.comment|length %}
                                {% set commentData = folderData.nesaGraphData.data.2.comment %}
                            {% elseif folderData.nesaGraphData.data.1 is defined and folderData.nesaGraphData.data.1.comment|length %}
                                {% set commentData = folderData.nesaGraphData.data.1.comment %}
                            {% else %}

                                {# Render the first comment only #}
                                {% set commentFound = false %}

                                {% for unitSpec in folderData.unitSpecs if not commentFound %}
                                    {% if attributes.isHsc %}
                                        {% set commentData = folderData.hscTaskMarks.data[unitSpecId] %}
                                    {% else %}
                                        {% set commentData = folderData.aamData.data[unitSpecId] %}
                                    {% endif %}

                                    {# bust out of the for() once we find meaningful data
                                     #}
                                    {% if commentData.comment is not null %}
                                        {% set commentFound = true %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        {% endif %}

                        <div class="column small-12 teacher-comment content">
                            {{ commentData.comment | nl2br }}
                        </div>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endset %}

    {# We can now print the optional legend, and then the subject list markup #}
    {% if hasInterminGrades %}<span class="meta legend">* - marks from most recent task only</span>{% endif %}
    {{ subjectListHtml }}
</div>


