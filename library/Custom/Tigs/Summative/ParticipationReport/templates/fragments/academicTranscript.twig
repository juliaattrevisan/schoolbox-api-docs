{#
Data:
    attributes                                                   StudentAttributes
    student                                                      User
    subjects                                                     array
    subjects[idx].name                                           string
    subjects[idx].codes                                          string[]
    subjects[idx].folderId                                       int
    subjects[idx].teachers                                       User[]
    data[folderId]                                               array
    data[folderId]['falData']                                    array
    data[folderId]['falData']['data']                            float[]    eg, ['Criterion A' => 6.0, ...]
    data[folderId]['aasData']                                    array
    data[folderId]['aasData']['data']                            array
    data[folderId]['aasData']['data'][unitSpecId]                array
    data[folderId]['aasData']['data'][unitSpecId]['comment']     string
    data[folderId]['aasData']['data'][unitSpecId]['capabilityMarks'] string[]|null[]
    data[folderId]['ibGraphData'][idx]['showComponent']          bool
    data[folderId]['ibGraphData'][idx]['header']                 string
    data[folderId]['ibGraphData'][idx]['studentMark']            int
    data[folderId]['nesaGraphData'][idx]['showComponent']        string
    data[folderId]['nesaGraphData'][idx]['studentMark']          string
    data[folderId]['unitspecs']                                  array   Sorted by most recent first
    data[folderId]['unitspecs'][idx][id]                         int
    data[folderId]['unitspecs'][idx][dueDate]                    ADF     Copied from a relevant dueWork inside the unit
    data[folderId]['unitspecs'][idx][title]                      string
    reportDate                                                   null|string
#}
<style>
    .results {
        color: black;
        text-align: right;
    }
    .result-group {
        display: inline-block;
        background-color: #cccccc;
        text-align: center;
        vertical-align: top;
    }
    .result-group.error{
        background-color: #fa4a47;
        color: white;
    }
    .result-item {
        display: inline-block;
        padding: 3px 10px;
    }
    .result-heading {
        font-weight: bold;
    }
    .subject-list > .subject-list-item{
        margin-bottom: 0.5rem;
        background-color: white;
    }
    .teacher-comment{
        color: black;
    }
</style>

<h2 class="subheader">Academic Transcript</h2>
<div>
    <ul class="subject-list">
        {% for subject in subjects %}
            {% set folderId = subject.folderId %}
            {% set folderData = data[folderId] %}
            {% set firstTeacher = subject.teachers | first %}
            <li class="subject-list-item">
                <a href="{{ routeLookup('tigsSubjectReport.getReport', {userId: student.id, folderId: subject.folderId, reportDate: reportDate}) }}" class="link-row">
                    <div class="list-item">
                        <div class="card column small-12 medium-6">

                            <img src="/portrait.php?id={{ firstTeacher.id }}&amp;size=square64" width="48" alt="{{ firstTeacher.fullName }}">
                            <h3 class="subject-name">{{ subject.name }}
                                <span class="meta">
                                {% for code in subject.codes %}
                                    ({{ code }}){% if not loop.last %},{% endif %}
                                {% endfor %}
                            </span>
                            </h3>

                            <div class="meta">
                                <p class="teacher-name">{{ firstTeacher.fullName }} <span class="pipe meta">{{ firstTeacher.role.name }}</span></p>
                            </div>
                        </div>
                        <div class="column small-12 medium-6 results">
                            <div class="result-group fal">
                                {# If we have explicit FinalAchievementLevel data, use that, otherwise fall back to most recent AAS assessment #}
                                {% if folderData.falData.data %}
                                    {# Explicit FAL data found, use that #}
                                    {% for label, value in folderData.falData.data %}
                                        <div class="result-item">
                                            <span class="result-heading">{{ label | last }}</span><br>
                                            <span class="result-value">{{ value|default('-') }}</span>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    {# No explicit FAL data found, fall back to latest AAS assessment #}
                                    {% set aasFound = false %}
                                    {# These units are ordered from latest to oldest #}
                                    {% for unitSpecId, unitSpecData in folderData.unitSpecs if not aasFound %}
                                        {% if folderData.aasData.data[unitSpecData.id].capabilityMarks %}
                                            {% set aasFound = true %}
                                            {% for label, value in folderData.aasData.data[unitSpecData.id].capabilityMarks %}
                                                <div class="result-item">
                                                    <span class="result-heading">{{ label | last }}</span><br>
                                                    <span class="result-value">{{ value|default('-') }}</span>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            </div>

                            {% set ibGraphData = folderData.ibGraphData.data | default(null) %}
                            {% if ibGraphData %}
                                {% set ibGraphDatum = ibGraphData | first %}
                                <div class="result-group{% if ibGraphDatum.error|default(false) %} error{% endif %}">
                                    <div class="result-item myp-grade">
                                        <span class="result-heading">{{ ibGraphDatum.header }}</span><br>
                                        <span class="result-value">{{ ibGraphDatum.studentMark|default('-') }}</span>
                                    </div>
                                </div>
                            {% endif %}

                            {% if folderData.hscRankData %}
                                <div class="result-group hsc-rank">
                                    {% if folderData.hscRankData.assessmentMark is defined %}
                                        <div class="result-item hsc-rank-mark">
                                            <span class="result-heading">Mark</span><br>
                                            <span class="result-value">{{ folderData.hscRankData.assessmentMark }}</span>
                                        </div>
                                    {% endif %}
                                    {% if folderData.hscRankData.assessmentAverage is defined %}
                                        <div class="result-item hsc-rank-average">
                                            <span class="result-heading">Average</span><br>
                                            <span class="result-value">{{ folderData.hscRankData.assessmentAverage }}</span>
                                        </div>
                                    {% endif %}
                                    {% if folderData.hscRankData.assessmentRank is defined %}
                                    <div class="result-item hsc-rank-rank">
                                        <span class="result-heading">Rank</span><br>
                                        <span class="result-value">{{ folderData.hscRankData.assessmentRank }}</span>
                                    </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% set nesaGraphData = folderData.nesaGraphData.data | default(null) %}

                            {% if nesaGraphData  %}
                                {% set nesaGraphDatum = folderData.nesaGraphData.data | first %}
                                {% if nesaGraphDatum  %}
                                    <div class="result-group{% if nesaGraphDatum.error|default(false) %} error{% endif %}">
                                        <div class="result-item nesa-grade">
                                            <span class="result-heading">NESA Grade</span><br>
                                            <span class="result-value">{{ nesaGraphDatum.studentMark|default('-') }}</span>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                        <div class="column small-12 teacher-comment">

                            {# Render the first comment only #}
                            {% set commentFound = false %}
                            {% for unitSpec in folderData.unitSpecs if not commentFound %}
                                {% if attributes.isDp %}
                                    {% set commentData = folderData.aamData.data[unitSpec.id] %}
                                {% elseif attributes.isHsc %}
                                    {% set commentData = folderData.hscTaskMarks.data[unitSpec.id] %}
                                {% elseif attributes.isMyp %}
                                    {% set commentData = folderData.aasData.data[unitSpec.id] %}
                                {% endif %}

                                {% if commentData.comment %}
                                    {% set commentFound = true %}
                                    {{ commentData.comment | nl2br }}
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </a>
            </li>
        {% endfor %}
    </ul>
</div>


