{#
Data:
    attributes                                                   StudentAttributes
    student                                                      User
    subjects                                                     array
    subjects[idx].name                                           string
    subjects[idx].codes                                          string[]
    subjects[idx].folderId                                       int
    subjects[idx].isPreviousClass                                bool
    data[folderId]                                               array
    data[folderId].folder                                        Folder\Model
    data[folderId].teachers                                      User[]
    data[folderId]['aasData']                                    array
    data[folderId]['aasData']['data']                            array
    data[folderId]['aasData']['data'][unitSpecId]                array
    data[folderId]['aasData']['data'][unitSpecId]['comment']     string
    data[folderId]['aasData']['data'][unitSpecId]['capabilityMarks'] string[]|null[]
    data[folderId]['nesaGraphData'][idx]['showComponent']        string
    data[folderId]['nesaGraphData'][idx]['studentMark']          string
    data[folderId]['unitspecs']                                  array   Sorted by most recent first
    data[folderId]['unitspecs'][idx][id]                         int
    data[folderId]['unitspecs'][idx][dueDate]                    ADF     Copied from a relevant dueWork inside the unit
    data[folderId]['unitspecs'][idx][title]                      string
    reportDate                                                   null|string
#}
<style>

    /* Greyboxes, in the Academic Transcript
     * A group consists of several items
     */
    .tigs-crp .result-group {
        display: inline-block;
    }

    .tigs-crp .result-group .result-item {
        background-color: #ccc;
        display: inline-block;
        padding: 4px 12px;
        text-align: center;
        vertical-align: top;
    }

    /* A Greybox for the Formative Assessment in the Academic Transcript
     */
    .tigs-crp .result-group .result-item.hsc-rank-assessment-title {
        background-color: transparent;
        font-style: italic
    }

    .legend {
        position: absolute;
        right: 2rem;
        top: 1rem;
    }

    .results {
        color: black;
        text-align: right;
    }

    .result-group.error{
        background-color: #fa4a47;
        color: white;
    }

    .result-heading {
        font-weight: bold;
    }

    .subject-list > .subject-list-item{
        margin-bottom: 0.5rem;
        background-color: white;
    }
    .teacher-comment{
        color: black;
    }
    @media (max-width: 640px) {
        .results {
            text-align: left;
        }
    }
    @media (max-width: 340px) {
        .legend {
            position: relative;
            right: 0;
            top: 0;
        }
    }
</style>

{% if subjects | length > 0 %}
    <h2 class="subheader">Student Results</h2>
    <p>Click on subject name for more information.</p>
    <div>

        {# Decide whether we need to show this little legend depending on the massive
         # massive processing about to take place...which should have been elsewhere
         #}
        {% set displayLegend = false %}

        {#
            We need to assign the subjectList markup to a variable and defer its render, so that we
            can detect if any interim grades are present, and print a legend above the markup if they are.
         #}
        {% set subjectListHtml %}
            <ul class="subject-list">
                {% for subject in subjects %}
                    {% set folderId = subject.folderId %}
                    {% set folderData = data[folderId] %}
                    {% set firstTeacher = folderData.teachers | first %}

                    {# Reinit flag for each subject
                     # Each subject can be in either Formative or Summative evaluation scenarios
                     #}
                    {% set hasInterimGrades = false %}

                    <li class="subject-list-item">
                        <a href="{{ routeLookup('tigsSubjectReport.getReport', {userId: student.id, folderId: subject.folderId, reportDate: reportDate}) }}" class="link-row">
                            <div class="card small-12">
                                {% if firstTeacher %}
                                <img src="/portrait.php?id={{ firstTeacher.id }}&amp;size=square64" width="48" alt="{{ firstTeacher.fullName }}">
                                {% endif %}
                                <h3 class="subject-name">{{ subject.name }}
                                    <span class="meta">
                                    {% for code in subject.codes %}
                                        ({{ code }}){% if not loop.last %},{% endif %}
                                    {% endfor %}
                                </span>
                                </h3>

                                {% if firstTeacher %}
                                <div class="meta">
                                    <p class="teacher-name">{{ firstTeacher.fullName }} <span class="pipe meta">{{ firstTeacher.role.name }}</span></p>
                                </div>
                                {% endif %}
                            </div>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endset %}

        {# We can now print the optional legend, and then the subject list markup #}
        {% if displayLegend %}<span class="meta legend">* - marks from most recent task only</span>{% endif %}
        {{ subjectListHtml }}
    </div>
{% endif %}
