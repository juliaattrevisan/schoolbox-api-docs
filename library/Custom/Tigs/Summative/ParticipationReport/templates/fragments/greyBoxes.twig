{##
 # Grey Boxes
 #
 # As the title suggests, this renders the little grey box things on each subject
 # in the Academic Transcript. Typically contains the student's mark, average, rank
 # and NESA grade depending on availability.
 #
 # The default value of a hyphen might seem a bit weird, because the boxes will show
 # with a hyphen in them, which sounds like "this page is intentionally left blank"
 #
 # "so the reasoning behind showing them empty, is a reminder for staff to start pushing formative marks through"
 #
 # ----
 #
 # Also, there's a special case for Middle Year Semester 1 layout of this greyboxes thing
 # That's why you need $attributes
 #
 # @param StudentAttributes $attributes  An instance of StudentAtributes, for a special case
 # @param bool $hasInterimGrades         Decide whether to render an asterisk in the heading
 # @param array $rankData                A (studentMark, cohortAverage, cohortRank) tuple
 # @param array $nesa                    A tuple for (NESA Grade, NESA Semester, NESA Error)
 #                                       the student's NESA grade, if applicable and any error messages
 #}

{# Show the assessment that had their Mark value, but only show it when
 # you're providing Formative information
#}
{% if hasInterimGrades and (rankData.assessmentTitle ?? '')|length %}
    <div class="result-group">
        <div class="result-item hsc-rank-assessment-title">
            <span class="result-value">{{ rankData.assessmentTitle }}</span>
        </div>
    </div>
{% endif %}

{# Special conditions for middle year, semester 1 NESA data
 #}
{% if attributes.isMiddleYear %}

    {% if attributes.curriculumSemester == 1 and nesaSemester == 1 %}
        {# Special case for Middle Years and it's currently Semester 1
         # They won't show any Formative grey boxes if there's a NESA Grade for semester 1
         #}
        <div class="result-group {% if nesa.error|default(false) %} error{% endif %}">
            <div class="result-item nesa-grade">
                <span class="result-heading">NESA Grade</span><br />
                <span class="result-value">{{ nesa.grade|default('-') }}</span>
            </div>
        </div>
    {% else %}
        <div class="result-group hsc-rank">
            {% if rankData.studentMark is defined %}
                <div class="result-item hsc-rank-mark">
                    <span class="result-heading">Mark{% if hasInterimGrades %}*{% endif %}</span><br />
                    <span class="result-value">{{ rankData.studentMark|default('-') }}</span>
                </div>
            {% endif %}
            {% if rankData.cohortAverage is defined %}
                <div class="result-item hsc-rank-average">
                    <span class="result-heading">Average{% if hasInterimGrades %}*{% endif %}</span><br />
                    <span class="result-value">{{ rankData.cohortAverage|default('-') }}</span>
                </div>
            {% endif %}

            {# Special case for Middle Years and it's currently Semester 2
             #
             # If they had a NESA Grade for semester 1, show it, until you start evaluating Semester 2
             # Formative feedbacks. At that point you're looking at interim grades for Formative
             # feedbacks in semester 2 and at this particular point, hide the NESA Semester 1.
             #
             # Only show the previous semester's NESA grade when:
             # - you're in semester 2
             # - a semester 1 nesa grade exists
             #
             # In this circumstance, nesa.grade will have been previously populated elsewhere with
             # that data set. Otherwise it'll be the semester 2 grade. It's messed up, I know.
             #}
            {% if nesa.grade %}
                <div class="result-group {% if nesa.error|default(false) %} error{% endif %}">
                    <div class="result-item nesa-grade">
                        <span class="result-heading">NESA Grade</span><br />
                        <span class="result-value">{{ nesa.grade|default('-') }}</span>
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% else %}

    {# Special case for HSC Year 12 students
     # HSC 12 students only have a rank, they don't have Student Mark or Cohort Average in semester 2
     #}
    {% if attributes.isHsc and attributes.getYearLevel == 12 and attributes.curriculumSemester == 2 and not hasInterimGrades %}
        <div class="result-group hsc-rank">
            {% if rankData.cohortRank is defined %}
                <div class="result-item hsc-rank-rank">
                    <span class="result-heading">Rank{% if hasInterimGrades %}*{% endif %}</span><br />
                    <span class="result-value">{{ rankData.cohortRank|default('-') }}</span>
                </div>
            {% endif %}
        </div>
    {% else %}

        {# Just do the usual thing like everyone else
         # putting the Formative values into the grey boxes, show a NESA grade if available, etc
         #}
        <div class="result-group hsc-rank">
            {% if rankData.studentMark is defined %}
                <div class="result-item hsc-rank-mark">
                    <span class="result-heading">Mark{% if hasInterimGrades %}*{% endif %}</span><br />
                    <span class="result-value">{{ rankData.studentMark|default('-') }}</span>
                </div>
            {% endif %}
            {% if rankData.cohortAverage is defined %}
                <div class="result-item hsc-rank-average">
                    <span class="result-heading">Average{% if hasInterimGrades %}*{% endif %}</span><br />
                    <span class="result-value">{{ rankData.cohortAverage|default('-') }}</span>
                </div>
            {% endif %}

            {# Rank only relevant to HSC students
             #}
            {% if rankData.cohortRank is defined and attributes.isHsc %}
                <div class="result-item hsc-rank-rank">
                    <span class="result-heading">Rank{% if hasInterimGrades %}*{% endif %}</span><br />
                    <span class="result-value">{{ rankData.cohortRank|default('-') }}</span>
                </div>
            {% endif %}
        </div>

        {% if nesa.grade %}
        <div class="result-group {% if nesa.error|default(false) %} error{% endif %}">
            <div class="result-item nesa-grade">
                <span class="result-heading">NESA Grade</span><br />
                <span class="result-value">{{ nesa.grade|default('-') }}</span>
            </div>
        </div>
        {% endif %}
    {% endif %}
{% endif %}
