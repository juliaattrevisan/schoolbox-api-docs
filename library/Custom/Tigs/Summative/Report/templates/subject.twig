{#
Displays a report for the selected user and folder for the current term.

Data:
    user:                User           - a student in years 7-12
    folder:              Folder\Model   - a class folder
    isEnabled:           bool           - is this report enabled for the student and their parents?
    isHsc:               bool           - is user reported on using HSC
    isIb:                bool           - is user reported on using IB
    sbSem:               int            - an integer from 1-2
    term:                int            - an integer from 1-4
    curriculumYearLevel: int            - an integer from 7-12
    curriculumSemester:  int            - an integer from 1-2
    errors               string[]       - Any errors that affect the whole page
    unitImpls            UnitImpl\Model - All units imported to this folder.
    aasData              array          - Data to render the Academic Achievement Summary components
    aamData              array          - Data to render the Academic Achievement Matrix components
    falData              array|null     - Data to render the Final Achievement Level component
    dpData               array          - Data to render the MYP/DP Graph component
#}
<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<div class="row">
    <div class="island small-12">
        <h1>{{ folder.title }}</h1>
        {% if not isEnabled %}
            <div data-alert class="alert-box highlight">
                This report is currently not visible to the student or their parents.
            </div>
        {% endif %}
        {% for error in errors %}
            <div data-alert class="alert-box alert">
                {{ error|raw }}
            </div>
        {% endfor %}
        {% if aasData.error is defined %}
            <div data-alert class="alert-box alert">
                {{ aasData.error|raw }}
            </div>
        {% endif %}
        {% if aamData.error is defined %}
            <div data-alert class="alert-box alert">
                {{ aamData.error|raw }}
            </div>
        {% endif %}
    </div>

    <div class="column small-12 medium-6">
        <h2 class="subheader">{{ dpData.header }}</h2>
        {% include '@tigsSummativeReport/components/diplomaProgrammeGraph.twig' with dpData only %}
    </div>

    <div class="column small-12 medium-6">
        <h2 class="subheader">NESA Score</h2>
    </div>

    {% if falData %}
    <div class="small-12">
        {% include '@tigsSummativeReport/components/finalAchievementLevels.twig' with falData only %}
    </div>
    {% endif %}

    <div class="small-12">
        {% for unitId, unit in unitImpls %}
            {# Do we have a link to an AAS assessment for this unit? #}
            {% set unitRoute = (aasData.data is defined and aasData.data[unitId] is defined) ? aasData.data[unitId].link : '' %}
            {% if unitRoute %}
                <h2 class="subheader"><a href="{{ unitRoute }}"><span class="icon-link" style="color: inherit;"></span>{{ unit.title }}</a></h2>
            {% else %}
                <h2 class="subheader">{{ unit.title }}</h2>
            {% endif %}

            {# Were we given AAS data for this unit? #}
            {% if aasData.data is defined and aasData.data[unitId] is defined %}
                {% include '@tigsSummativeReport/components/academicAchievementSummary.twig' with aasData.data[unitId] only %}
            {% endif %}
            {# Were we given AAM data for this unit? #}
            {% if aamData.data is defined and aamData.data[unitId] is defined %}
                {% include '@tigsSummativeReport/components/academicAchievementMatrix.twig' with aamData.data[unitId] only %}
            {% endif %}
            {% if not loop.last %}<br>{% endif %}
        {% endfor %}
    </div>
</div>

<div class="row">
    <div class="island small-12">
        <section class="meta" style="padding-left: 10px;">
            <h2 class="subheader">Dev Debug data:</h2>
            <p>userId: {{ user.id }}</p>
            <p>folderId: {{ folder.id }}</p>
            <br>
            <p>isIb: {% if isIb %}true{% else %}false{% endif %}</p>
            <p>isMyp: {% if isMyp %}true{% else %}false{% endif %}</p>
            <p>isDp: {% if isDp %}true{% else %}false{% endif %}</p>
            <p>isHsc: {% if isHsc %}true{% else %}false{% endif %}</p>
            <br>
            <p>SB Term: {{ term }}</p>
            <br>
            <p>SB Year Level: {{ user.year }}</p>
            <p>SB Semester: {{ sbSem }}</p>
            <br>
            <p>Curriculum Year Level: {{ curriculumYearLevel }}</p>
            <p>Curriculum Semester: {{ curriculumSemester }}</p>
        </section>
    </div>
</div>
