{#
Displays a report for the selected user and folder for the current term.

Data:
    user:                User           - a student in years 7-12
    folder:              Folder\Model   - a class folder
    isEnabled:           bool           - is this report enabled for the student and their parents?
    attributes:          StudentAttributes
    errors               string[]       - Any errors that affect the whole page
    unitSpecs            unitSpec\Model - All unit specs imported to this folder. (TODO filter to only unitSpecs that contain visible data, defferred till later)
    aasData              array          - Data to render the Academic Achievement Summary components
    aamData              array          - Data to render the Academic Achievement Matrix components
    falData              array|null     - Data to render the Final Achievement Level component
    ibGraphData          array          - Data to render the MYP/DP Graph component
    nesaGraphData        array          - Data to render the NESA Score Graph component
#}
<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<div class="row">
    <div class="island small-12">
        <h1>{{ folder.title }}</h1>
        {% if not isEnabled %}
            <div data-alert class="alert-box highlight">
                This report is currently not visible to the student or their parents.
            </div>
        {% endif %}
        {% for error in errors %}
            <div data-alert class="alert-box alert">
                {{ error|raw }}
            </div>
        {% endfor %}
        {% if aasData.error is defined %}
            <div data-alert class="alert-box alert">
                {{ aasData.error|raw }}
            </div>
        {% endif %}
        {% if aamData.error is defined %}
            <div data-alert class="alert-box alert">
                {{ aamData.error|raw }}
            </div>
        {% endif %}
    </div>

    <div class="column small-12 medium-6">
        {% if ibGraphData %}
            <h2 class="subheader">{{ ibGraphData.header }}</h2>
            {% include '@tigsSummativeReport/components/internationalBaccalaureateGraph.twig' with ibGraphData only %}
        {% else %}
            <p></p>
        {% endif %}
    </div>

    <div class="column small-12 medium-6">
        {% if nesaGraphData %}
            <h2 class="subheader">NESA Score</h2>
            {% include '@tigsSummativeReport/components/nesaScoreGraph.twig' with nesaGraphData only %}
        {% else %}
            <p></p>
        {% endif %}
    </div>

    {% if falData %}
    <div class="column small-12">
        {% include '@tigsSummativeReport/components/finalAchievementLevels.twig' with falData only %}
    </div>
    {% endif %}
    {% for unitSpecId, unitSpec in unitSpecs %}
    <div class="column small-12">
            {# Do we have a link to an AAS assessment for this unit? #}
            {% set unitRoute = (aasData.data is defined and aasData.data[unitSpecId] is defined) ? aasData.data[unitSpecId].link : '' %}
            {% if unitRoute %}
                <h2 class="subheader"><a href="{{ unitRoute }}"><span class="icon-link" style="color: inherit;"></span>{{ unitSpec.title }}</a></h2>
            {% else %}
                <h2 class="subheader">{{ unitSpec.title }}</h2>
            {% endif %}

            {# Were we given AAS data for this unit? #}
            {% if aasData.data is defined and aasData.data[unitSpecId] is defined %}
                {% include '@tigsSummativeReport/components/academicAchievementSummary.twig' with aasData.data[unitSpecId] only %}
            {% endif %}
            {# Were we given AAM data for this unit? #}
            {% if aamData.data is defined and aamData.data[unitSpecId] is defined %}
                {% include '@tigsSummativeReport/components/academicAchievementMatrix.twig' with aamData.data[unitSpecId] only %}
            {% endif %}
    </div>
        {% if aasData.data[unitSpecId].comment %}
        <div class="column island small-12">
            <h2 class="subheader">Comments by {{ aasData.data[unitSpecId].commentBy.fullname }}</h2>
            <section class="content">
                <p>{{ aasData.data[unitSpecId].comment }}</p>
            </section>
        </div>
        {% endif %}
    {% endfor %}
</div>

<div class="row">
    <div class="island small-12">
        <section class="meta" style="padding-left: 10px;">
            <h2 class="subheader">Dev Debug data:</h2>
            <p>userId: {{ user.id }}</p>
            <p>folderId: {{ folder.id }}</p>
            <br>
            <p>isIb: {{ attributes.isIb ? 'true' : 'false' }}</p>
            <p>userYearLevel: {{ attributes.yearLevel }}</p>
            <p>term: {{ attributes.term }}</p>
            <br>
            <p>Curriculum Year Level: {{ attributes.curriculumYearLevel }}</p>
            <p>Curriculum Semester: {{ attributes.curriculumSemester }}</p>
            <p>Report Start: {{ attributes.reportStart.database }}</p>
            <p>Report Finish: {{ attributes.reportFinish.database }}</p>
            <p>isMyp: {% if attributes.isMyp %}true{% else %}false{% endif %}</p>
            <p>isDp: {% if attributes.isDp %}true{% else %}false{% endif %}</p>
            <p>isHsc: {% if attributes.isHsc %}true{% else %}false{% endif %}</p>
        </section>
    </div>
</div>
