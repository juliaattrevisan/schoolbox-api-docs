{#
Renders a MYP/DP graph.

Data:
    error: string - Optional. If present, the reason why we can't render the component
    data:  array  - The results to render. key: column, value: height
#}

{% if error|default(null) %}
    <div class="empty-state">
        <p>{{ error }}</p>
    </div>
{% else %}
    {% autoescape 'js' %}
    <script type="text/javascript">
        $(function(){
            $("#myp-graph").highcharts({
                legend: {
                    enabled: false
                },
                credits: {
                    enabled: false
                },
                title: {
                    text: null
                },
                xAxis: {
                    categories: [0,1,2,3,4,5,6,7],
                    title: {
                        text: null
                    }
                },
                yAxis: {
                    title: {
                        text: '# Students (Cohort)'
                    },
                    tickInterval: 10
                },
                series: [
                    {
                        type: 'column',
                        data: {{ data|json_encode|raw }},
                        label: {
                            enabled: false
                        }
                    }
                ]
            });
        });
    </script>
    {% endautoescape %}
    <div id="myp-graph"></div>
{% endif %}
