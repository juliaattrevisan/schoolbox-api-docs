{#
Renders a MYP/DP graph.

Data:
    error:        string   - Optional. If present, the reason why we can't render the component
    studentValue: int|null - Optional. The student's mark for the IB graph assessment
    data:         array    - The results to render. key: column, value: height
#}
{% if error|default(null) %}
    <div data-alert class="alert-box alert">{{ error|raw }}</div>
{% else %}

    {% if studentValue is not null %}
        {# TODO style this properly, of course #}
        <div style="background-color: #DBCB46;">
            <h3 style="color: white; text-align: center; margin-bottom: 0;">{{ studentValue }}</h3>
        </div>
    {% endif %}

    {% autoescape 'js' %}
    <script type="text/javascript">

        /**
         * Returns a set of colours for the columns
         *
         * @param {Array}    data
         * @param {null|int} studentValue
         * @param {string}   highlightColor
         * @param {string}   defaultColor
         * @return {Array}
         */
        var buildColorList = function(data, studentValue, highlightColor, defaultColor) {
            var dataLength = data.length,
                colorList  = [];
            for (var i = 0; i < dataLength; i++) {
                colorList.push(defaultColor);
            }

            if (studentValue in colorList) {
                colorList[studentValue - 1] = highlightColor;
            }

            return colorList;
        };

        $(function(){

            var data = {{ data|json_encode|raw }},
                dataCategories = {{ dataCategories|json_encode|raw }},
                studentValue = Number("{{ studentValue }}");

                {# Convert JSON object to plain array #}
                data = Object.values(data);

            $("#ib-graph").highcharts({
                legend: {
                    enabled: false
                },
                credits: {
                    enabled: false
                },
                title: {
                    text: null
                },
                tooltip: {
                    enabled: false
                },
                xAxis: {
                    categories: dataCategories,
                    title: {
                        text: null
                    }
                },
                yAxis: {
                    title: {
                        text: '# Students (Cohort)'
                    },
                    allowDecimals: false
                },
                series: [
                    {
                        type: 'column',
                        data: data,
                        label: {
                            enabled: false
                        },
                        colorByPoint: true,
                        colors: buildColorList(data, studentValue, '#DBCB46', '#454549')
                    }
                ]
            });
        });
    </script>
    {% endautoescape %}
    {# TODO style this properly #}
    <div id="ib-graph" style="margin-bottom: 30px;"></div>
{% endif %}
