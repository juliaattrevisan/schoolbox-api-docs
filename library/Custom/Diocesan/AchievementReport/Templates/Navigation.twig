<div class="row">
    <div class="small-12 columns">
        <ul class="sub-nav">
            {% for url, label in navigation.all %}
                <li {% if url == navigation.selected %}class="active"{% endif %}>
                    <a href="/modules/custom/diocesan/achievementreport/{{ url }}/{{ externalUser.StudentID }}">{{ label }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
