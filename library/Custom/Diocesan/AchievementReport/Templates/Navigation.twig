{##
 # Navigation
 #
 # Adds a row of buttons so people can navigate betwen NCEA, School Grades, IB and Comments reports
 #
 # @param array navigation
 # @param array externalUser
 # @param User  user
 #}
<div class="row">
    <div class="small-12 columns">
        <ul class="sub-nav">
            {% for url, label in navigation.all %}

                {# Special case for PDF Reports:
                 # This links to a non-AchievementReport destination
                 #}
                {% if url == 'PDF Reports' %}
                <li>
                    <a href="/user/profile/documents/reports/{{ user.id }}">PDF Reports</a>
                </li>
                {% else %}
                    <li {% if url == navigation.selected %}class="active"{% endif %}>
                        <a href="/modules/custom/diocesan/achievementreport/{{ url }}/{{ externalUser.StudentID }}">{{ label }}</a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
</div>
