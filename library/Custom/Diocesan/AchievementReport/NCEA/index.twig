<link href="/custom/diocesan/achievementreport/css/styles.css" media="screen" rel="stylesheet" type='text/css' />
<script type="text/javascript" src="/javascript/components/highcharts/highcharts.js"></script>
<script type="text/javascript" src="/custom/diocesan/achievementreport/js/ncea/stackedBar.js"></script>

{% include '@templates/Avatar.twig' %}
{% include '@templates/Navigation.twig' %}

<div class="achievement-report ncea">
    <h1>NCEA Index</h1>

    {% include '@ncea/LiteracyNumeracyCheckbox.twig' %}
    {% include '@ncea/CreditSummary.twig' %}
    {% include '@ncea/CreditSummaryGraphs.twig' with {dataset: creditSummary} %}

    {% if year > 0 %}
        <div class='clearfix'></div>

        <h2>Credit Summary - {{ year }}</h2>
        {% include '@ncea/CreditSummaryGraphs.twig' with {dataset: creditSummaryYear} %}

        {% include '@ncea/CourseCreditSummary.twig' %}
    {% endif %}

    <div class='clearfix'></div>

    <dl class="key float-left">
        <dt>N</dt>
        <dd>Not Achieved</dd>

        <dt>A</dt>
        <dd>Achieved</dd>

        <dt>M</dt>
        <dd>Achieved With Merit</dd>

        <dt>E</dt>
        <dd>Achieved With Excellence</dd>
    </dl>

    <dl class="key float-right">
        <dt>ABS</dt>
        <dd>Absent</dd>

        <dt>SNA</dt>
        <dd>Standard Not Attempted</dd>

        <dt>RNA</dt>
        <dd>Result Not Yet Available</dd>
    </dl>

    <h2>Further Information</h2>
    <p>
        Further information about your results, reviews and reconsiderations,
        endorsements, credit inclusion, and booklet return is available from
        NZQA site on the <a href="http://www.nzqa.govt.nz/qualifications-standards/qualifications/ncea/ncea-results/results-publication/">Results Publication Information</a>
        page. You should also review the <a href="http://www.nzqa.govt.nz/qualifications-standards/qualifications/ncea/subjects/judgement-statements">judgement statements</a>
        (which include cut scores for Level 1 standards).
    </p>

    <p>
        Further information about University entrance, Literacy and Numeracy
        requirements is available on NZQA site <a href="http://www.nzqa.govt.nz/qualifications-standards/awards/university-entrance/">University Entrance Requirements</a>.
    </p>
</div>