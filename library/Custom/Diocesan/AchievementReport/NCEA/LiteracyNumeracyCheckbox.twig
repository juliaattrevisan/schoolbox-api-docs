{% if literacyNumeracyCheckbox.data|length %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Literacy/Numeracy</h2>
        <section class="content">
            {% for checkboxName, selected in literacyNumeracyCheckbox.data %}
            <div>
                <input id='literacy-numeracy-{{ loop.index }}' type="checkbox" disabled {% if selected > 0 %}checked="checked"{% endif %} />
                <label for="literacy-numeracy-{{ loop.index }}" class="checkbox-label">{{ checkboxName }}</label>
            </div>
            {% endfor %}
        </section>
    </div>
</div>
{% endif %}
