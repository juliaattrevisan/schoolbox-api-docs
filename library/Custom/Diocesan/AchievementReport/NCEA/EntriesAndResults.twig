{## NCEA Entries And Results
 #
 # @param int $year
 # @param array $entriesAndResults
 # @param array $comments
 #}
{% import '@achievementreport/macro.twig' as macro %}

<div class="row">
    <div class="small-12 island">
        <section class="content generic-heading-highlight no-margin">
            Entries And Results {{ year }}
        </section>
    </div>
</div>

{% for courseName, allData in entriesAndResults.data %}
<div class="row">
    <div class="small-12 island">
        <section class="content no-margin">
            <p class="subheading">{{ courseName }}</p>

            {% if allData.allTeachers|length %}
                <p class="meta">
                    {{ macro.renderTeachers(allData.allTeachers) }}
                </p>
            {% endif %}
        </section>
    </div>

    <div class="small-12 columns sequential-table">
        <div class="scrollable">
            <table>
                <tbody>
                <tr>
                    <td class="subheading centered numeric">Std</td>
                    <td class="subheading centered numeric">Int/Ext</td>
                    <td class="subheading">Title</td>
                    <td class="subheading centered numeric">Lvl</td>
                    <td class="subheading centered numeric">Credits</td>
                    <td class="subheading centered numeric">Result</td>
                </tr>
                {% for currentEntry in allData.allEntries %}
                    {% if (currentEntry.Result|length > 0) or (entriesAndResults.year == entriesAndResults.currentYear) %}
                        <tr>
                            <td class="centered numeric">{{ currentEntry.NCEAStandardNumber }}</td>
                            <td class="centered numeric">{{ currentEntry.InternalorExternalAssessment }}</td>
                            <td>{{ currentEntry.StandardTitle }}</td>
                            <td class="centered numeric">{{ currentEntry.Level }}</td>
                            <td class="centered numeric">{{ currentEntry.EnteredCredits }}</td>
                            <td class="centered numeric">{{ currentEntry.Result }}</td>
                        </tr>
                    {% endif %}
                {% endfor %}

                {# Summary table for Internally and Externally graded assessments
                 # This is the pink and blue table
                 #}
                <tr>
                    <td colspan="6">
                        <table class="no-margin">
                            <thead>
                            <tr>
                                <th colspan="2"></th>
                                {% for currentType, typeSettings in creditSummary.allTypes %}
                                    <th colspan="6" class="centered {{ typeSettings.css }}">{{ typeSettings.long }}</th>
                                {% endfor %}
                            </tr>
                            <tr>
                                <th class="level">Level</th>
                                <th class="numeric">Total Entered Credits</th>
                                {% for currentType, typeSettings in entriesAndResults.allTypes %}
                                    <th class="numeric">Entered Credits</th>
                                    {% for currentLetter in entriesAndResults.allLetters %}
                                        <th class="numeric">{{ currentLetter }}</th>
                                    {% endfor %}
                                    <th class="numeric">Available</th>
                                {% endfor %}
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td class="level">{{ allData.summary.level }}</td>
                                <td class="numeric">{{ allData.summary.totalEnteredCredits }}</td>

                                {% for currentType, typeSettings in entriesAndResults.allTypes %}
                                    <td class="numeric">{{ allData.summary.type[currentType].enteredCredits }}</td>
                                    {% for currentLetter in entriesAndResults.allLetters %}
                                        <td class="numeric">{{ allData.summary.type[currentType].letters[currentLetter] }}</td>
                                    {% endfor %}
                                    <td class="numeric">{{ allData.summary.type[currentType].availableCredits }}</td>
                                {% endfor %}
                            </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>

                {# Comments
                 # A list of comments per subject, ordered by Term
                 # Only show this section if there are comments to display
                 #}
                {% if entriesAndResults.comments[year].courses[courseName].terms|length %}
                <tr>
                    <td colspan="6">
                        <p class="subheading">Comments</p>
                        {% for term, commentData in entriesAndResults.comments[year].courses[courseName].terms %}
                            {% if commentData.comment|length %}
                                <p>Term {{ term }} - {{ commentData.comment }}&mdash;{{ macro.renderTeachers(commentData.teachers) }}</p>
                            {% endif %}
                        {% endfor %}
                    </td>
                </tr>
                {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endfor %}
