<script type="text/javascript">
    $(function() {
        $('[data-graph="standard-type-{{ dataset.suffix }}"]').ncea_stackedBar({
            title: 'Standard Type',

            colors: ['#32cd32', '#4169e1', '#001933'],

            categories: [
                {% for currentLevel, allLevelValues in dataset.data.graph.standardType %}
                '{{ currentLevel }}'{% if not loop.last %}, {% endif %}
                {% endfor %}
            ],

            series: [
                {
                    name: 'Unit',
                    data: [
                        {% for currentLevel, allLevelValues in dataset.data.graph.standardType %}
                        {{ allLevelValues.unit }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                },
                {
                    name: 'Achievement',
                    data: [
                        {% for currentLevel, allLevelValues in dataset.data.graph.standardType %}
                        {{ allLevelValues.achievement }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                },
                {
                    name: 'Available',
                    data: [
                        {% for currentLevel, allLevelValues in dataset.data.graph.standardType %}
                        {{ allLevelValues.available }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                }
            ]
        });
    });
</script>
<div data-graph="standard-type-{{ dataset.suffix }}"></div>
