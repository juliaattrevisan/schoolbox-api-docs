<script type="text/javascript">
    $(function() {
        $('[data-graph="assessment-type"]').ncea_stackedBar({
            title: 'Assessment Type',

            categories: [
                {% for currentLevel, allLevelValues in creditSummary.data.graph.assessmentType %}
                '{{ currentLevel }}'{% if not loop.last %}, {% endif %}
                {% endfor %}
            ],

            series: [
                {
                    name: 'Internal',
                    data: [
                        {% for currentLevel, allLevelValues in creditSummary.data.graph.assessmentType %}
                        {{ allLevelValues.IN }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                },
                {
                    name: 'External',
                    data: [
                        {% for currentLevel, allLevelValues in creditSummary.data.graph.assessmentType %}
                        {{ allLevelValues.EX }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                },
                {
                    name: 'Available',
                    data: [
                        {% for currentLevel, allLevelValues in creditSummary.data.graph.assessmentType %}
                        {{ allLevelValues.available }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                }
            ]
        });
    });
</script>
<div data-graph="assessment-type"></div>
