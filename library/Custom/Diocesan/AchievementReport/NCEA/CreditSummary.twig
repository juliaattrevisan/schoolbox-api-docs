<h2>{{ creditSummary.heading }}</h2>

<table class="credit-summary">
    <thead>
        <tr>
            <th></th>
            <th></th>
            <th colspan="6" class="centered">Internally Assessed</th>
            <th colspan="6" class="centered">Externally Assessed</th>
        </tr>
        <tr class="equal-widths">
            <th class="centered">Level</th>
            <th class="numeric">Total Entered Credits</th>
            {% for currentType in creditSummary.allTypes %}
            <th class="numeric">Entered Credits</th>
            {% for currentLetter in creditSummary.allLetters %}
            <th class="letter">{{ currentLetter }}</th>
            {% endfor %}
            <th class="numeric">Available</th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for currentLevel, allLevelValues in creditSummary.data.table.creditSummary %}
        <tr>
            <td class="centered">{{ currentLevel }}</td>
            <td class="numeric">{{ allLevelValues.totalEnteredCredits }}</td>
            {% for currentType in creditSummary.allTypes %}
            <td class="numeric">{{ allLevelValues[currentType].enteredCredits }}</td>
            {% for currentLetter in creditSummary.allLetters %}
            <td class="letter">{{ allLevelValues[currentType].letters[currentLetter] }}</td>
            {% endfor %}
            <td class="numeric">{{ allLevelValues[currentType].availableCredits }}</td>
            {% endfor %}
        </tr>
        {% endfor %}
    </tbody>
</table>

<style type="text/css">
    .achievement-report.ncea div.graph-socket {
        width:25%;
        height:400px;
        margin-bottom:32px;
        float:left;
    }
</style>

<div class="graph-socket">
    {% include '@ncea/Graphs/TotalAchievedCredits.twig' %}
</div>
<div class="graph-socket">
    {% include '@ncea/Graphs/StandardType.twig' %}
</div>
<div class="graph-socket">
    {% include '@ncea/Graphs/AssessmentType.twig' %}
</div>
<div class="graph-socket">
    {% include '@ncea/Graphs/Result.twig' %}
</div>