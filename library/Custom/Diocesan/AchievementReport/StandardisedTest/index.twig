{##
 # Standardised Test
 #
 # @param array     externalUser
 # @param int|null  year
 #}

{% include '@templates/Avatar.twig' %}

{% include '@templates/Navigation.twig' with {
    elements: navigation
} %}

{% include '@templates/Navigation.twig' with {
    elements: subnavigation
} %}

<div class="row">
    <div class="small-12 columns">
        {% include '@standardisedTest/PATTable.twig' with {
            data: PATTable
        } %}
    </div>
</div>

{% if PATMathematics.visible %}
<div class="row">
    <div class="small-12 columns">
        {% include '@standardisedTest/Stanine/Graph.twig' with {
            identifier: 'PATMathematics',
            title: PATMathematics.data.graph.title,
            yAxis: PATMathematics.data.graph.y,
            series: PATMathematics.data.series
        } %}
    </div>
</div>
{% endif %}
