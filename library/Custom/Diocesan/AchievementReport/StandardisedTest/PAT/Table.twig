{##
 # PAT Progressive Achievement Test
 #
 # Table of data across all year levels for a particular student
 #
 # @param array data
 #}
<table>
    <thead>
        <tr>
            <th>Year</th>
            <th>PAT Mathematics</th>
            <th>PAT Listening Comprehension</th>
            <th>PAT Reading Vocabulary</th>
            <th>PAT Reading Comprehension</th>
            <th>PAT Punctuation And Grammar</th>
        </tr>
    </thead>
    <tbody>
        {% for year, values in data %}
        <tr>
            <td>{{ year }}</td>
            <td>{{ values.mathematics }}</td>
            <td>{{ values.listeningComprehension }}</td>
            <td>{{ values.readingVocabulary }}</td>
            <td>{{ values.readingComprehension }}</td>
            <td>{{ values.punctuationGrammar }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
