{##
 # Standardised Test
 #
 # @param array     externalUser
 # @param int|null  year
 #}

{% include '@achievementreport/Avatar.twig' %}

{% include '@achievementreport/Navigation.twig' with {
    elements: navigation
} %}

{% include '@achievementreport/Navigation.twig' with {
    elements: subnavigation
} %}

<div class="achievement-report standardised-test">
    <div class="row">
        <div class="small-12 columns">
            {% include '@standardisedTest/PAT/Table/Table.twig' with {
                data: PATTable.data
            } %}
        </div>
    </div>

    {% include '@standardisedTest/PAT/Navigation.twig' with {
        elements: PATNavigation
    } %}

    {% if PATHeading.visible %}
    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">{{ PATHeading.label }}</h2>
        </div>
    </div>
    {% endif %}

    {% if PATMathematics.visible or PATListeningComprehension.visible or PATReadingVocabulary.visible or PATReadingComprehension.visible %}
    <div class="row">
        <div class="small-12 island">
            <section>
                <div class="row">
                    {% if PATMathematics.visible %}
                        <div class="small-12 large-6 columns">
                            {% include '@standardisedTest/Stanine/Graph.twig' with {
                                identifier: 'PATMathematics',
                                title: PATMathematics.data.graph.title,
                                yAxis: PATMathematics.data.graph.y,
                                series: PATMathematics.data.series
                            } %}
                        </div>
                    {% endif %}

                    {% if PATListeningComprehension.visible %}
                        <div class="small-12 large-6 columns">
                            {% include '@standardisedTest/Stanine/Graph.twig' with {
                                identifier: 'PATListeningComprehension',
                                title: PATListeningComprehension.data.graph.title,
                                yAxis: PATListeningComprehension.data.graph.y,
                                series: PATListeningComprehension.data.series
                            } %}
                        </div>
                    {% endif %}

                    {% if PATReadingVocabulary.visible %}
                        <div class="small-12 large-6 columns">
                            {% include '@standardisedTest/Stanine/Graph.twig' with {
                                identifier: 'PATReadingVocabulary',
                                title: PATReadingVocabulary.data.graph.title,
                                yAxis: PATReadingVocabulary.data.graph.y,
                                series: PATReadingVocabulary.data.series
                            } %}
                        </div>
                    {% endif %}

                    {% if PATReadingComprehension.visible %}
                        <div class="small-12 large-6 columns">
                            {% include '@standardisedTest/Stanine/Graph.twig' with {
                                identifier: 'PATReadingComprehension',
                                title: PATReadingComprehension.data.graph.title,
                                yAxis: PATReadingComprehension.data.graph.y,
                                series: PATReadingComprehension.data.series
                            } %}
                        </div>
                    {% endif %}
                </div>
            </section>
        </div>
    </div>
    {% endif %}

    <div class="row">
        <div class="small-12 island">
            <section class="content">
                <p>
                    <strong>PAT Tests:</strong> Progressive Achievement Tests are a series of standardised tests
                    developed specifically for New Zealand Schools. There are four different tests:

                    <span class="has-tip tip-top" title="
                        <strong>Reading Comprehension</strong> is a test of how well students understand what they read.
                        The test is made up of a number of short texts (for instance, stories, explanations, descriptions,
                        and poems) each of which is followed by a series of questions. Students read each text and show
                        their understanding by answering the questions.
                    " data-tooltip>Reading Comprehension</span>,

                    <span class="has-tip tip-top" title="
                        <strong>Reading Vocabulary</strong> is a test of how well students understand the words that
                        they read. Each question in the test is made up of a sentence containing a word printed in bold.
                        Students must choose a word from a list of options that has the same or nearly the same meaning
                        as the bolded word. Strong vocabulary knowledge is associated with high levels of
                        reading achievement.
                    " data-tooltip>Reading Vocabulary</span>,

                    <span class="has-tip tip-top" title="
                        <strong>Listening Comprehension</strong> is a test of assessing students' comprehension of texts
                        read to them. The test is made up of a number of short texts (for instance, narratives, poems,
                        and informational texts) each of which is followed by a series of questions. Students listen to
                        each text and show their understanding by answering the questions.
                    " data-tooltip>Listening Comprehension</span>, and

                    <span class="has-tip tip-top" title="
                        <strong>Mathematics</strong> is a test of mathematics. The questions are chosen to assess the
                        skills and knowledge described in the New Zealand mathematics curriculum. Students answer
                        questions involving number knowledge, number strategies, algebra, geometry and measurement,
                        and statistics.
                    " data-tooltip>Mathematics</span>.
                </p>

                <p>
                    <strong>Stanines:</strong> Each set of year level results is depicted as a graph showing the
                    percentage of students gaining stanine 1 to 9 on a national level compared to Diocesan Junior
                    School. There is no notion of a pass or fail in these scores. They merely represent the ability of
                    the student in comparison to other students of the same age in New Zealand at that point in time.
                </p>

                <p>
                    Your daughter's results are indicated by the star, unless absent on testing dates.
                </p>
            </section>
        </div>
    </div>
</div>
