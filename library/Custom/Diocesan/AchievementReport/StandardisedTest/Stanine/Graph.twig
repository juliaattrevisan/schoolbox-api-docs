{##
 # PAT Graph
 #
 # @param string identifier  the div in which to spawn the graph
 # @param array  data        series data for student, diocesan, national
 # @param string title       graph title
 # @param string yAxis       y axis label
 #}
<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<script>
    $(function () {
        $('#{{ identifier }}').highcharts({
            credits: {
                enabled: false
            },
            legend: {
                enabled: false
            },
            series: [
                {
                    color: '#17419b',
                    data: [{{ series.diocesan|join(',') }}],
                    type: 'column'

                },
                {
                    color: '#a01c1c',
                    data: [{{ series.national|join(',') }}],
                    type: 'spline'

                },
                {
                    color: '#bfaf03',
                    data: [{{ series.student|join(',') }}],
                    marker: {
                        lineColor: '#847700',
                        lineWidth: 1,
                        radius: 7,
                        symbol: 'circle'
                    },
                    type: 'scatter'
                }
            ],
            title: {
                text: '{{ title }}'
            },
            tooltip: {
                enabled: false
            },
            xAxis: {

                {# I think these stay the same, so I've hardcoded them for now #}
                categories: [1,2,3,4,5,6,7,8,9]
            },
            yAxis: {
                title: {
                    text: '{{ yAxis }}'
                }
            }
        });
    });
</script>

<div id="{{ identifier }}"></div>
