{% include '@templates/Avatar.twig' %}
{% include '@templates/Navigation.twig' %}

<table>
    <thead>
        <th>Subject</th>
        <th>Term</th>
        <th>Comment</th>
        <th>Teacher</th>
    </thead>
    <tbody>
        {% for year, courseData in comments %}
            {% for course, termData in courseData.courses %}
                <tr>
                    <td colspan="4">{{ course }}</td>
                </tr>

                {# Inspect every term for content
                 # Only render terms which have comments in them
                 #}
                {% for term in [1,2,3,4] %}
                    {% if termData.terms[term] != '' %}
                    <tr>
                        <td>&nbsp;</td>
                        <td>{{ term }}</td>
                        <td>{{ termData.terms[term].comment }}</td>
                        <td>
                            {% for teacher in termData.terms[term].teachers %}
                                <p>{{ teacher.name }} {{ teacher.email }}</p>
                            {% endfor %}
                        </td>
                    </tr>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        {% endfor %}
    </tbody>
</table>