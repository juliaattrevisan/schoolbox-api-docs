{##
 # Comments Navigation
 #
 # A series of tabs that link to places that contain data
 #
 # @param array commentsNavigation
 #}
{% if commentsNavigation.all|length > 0 %}
    <div class="row">
        <div class="small-12 island">
            <h2 id="comments-summary" class="subheader">Comments Summary</h2>

            <section>
                <ul class="sub-nav">
                    {% for year in commentsNavigation.all %}
                        <li {% if year == commentsNavigation.selected %}class="active"{% endif %}>
                            <a href="/modules/custom/diocesan/achievementreport/comments/{{ externalUser.StudentID }}/{{ year }}#comments-summary">{{ year }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endif %}