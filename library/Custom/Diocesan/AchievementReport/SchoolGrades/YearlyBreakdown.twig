<script type="text/javascript">
    $(function() {

        /* Preselected breakdown year
         */
        var preselectedYear = '{{ preselectedYear }}';

        if (!isNaN(preselectedYear)) {
            $('[data-year="' + preselectedYear + '"').addClass('current');
            $('[data-yearly-breakdown-year="' + preselectedYear + '"]').show();

            /* Move to navigation element
             */
            $(document).scrollTop($('[data-year-selector="true"]').offset().top);
        }

        /* Select a breakdown to view
         */
        $('[data-year-selector]').find('a').click(function(event) {
            event.preventDefault();

            $('[data-year-selector]').find('a').removeClass('current');
            $(this).addClass('current');

            $('[data-yearly-breakdown="true"]').hide();
            $('[data-yearly-breakdown-year="' + $(this).attr('data-year') + '"]').show();

            /* Update url by removing the last four digits (selected year)
             * and appending the newly selected year
             *
             * This allows you to bookmark hidden divs, since it works in
             * conjunction with aura routing
             */
            var baseUrl = window.location.href.replace(/\/(\d{4})$/, '');
            window.history.pushState('', '', baseUrl + '/' + $(this).attr('data-year'));

            /* Move to navigation element
             */
            $(document).scrollTop($('[data-year-selector="true"]').offset().top);
        });
    });
</script>

<h1>School Grades Summary by Year</h1>

<ul class="admin-nav" data-year-selector="true">
    {% for year, allCourses in yearlyBreakdown.data.yearStack %}
    <li>
        <a href='#' data-year="{{ year }}">{{ year }}</a>
    </li>
    {% endfor %}
</ul>

<div class="clearfix"></div>

{% for year, allCourses in yearlyBreakdown.data.yearStack %}
<div data-yearly-breakdown='true' data-yearly-breakdown-year="{{ year }}" class="hide">
    <table>
        <thead>
            <tr class="generic-heading-highlight">
                <th colspan="8">{{ yearlyBreakdown.heading }} {{ year }}</th>
            </tr>
            <tr>
                <th>Course</th>
                <th class="numeric">Entered Grades</th>
                <th class="letter">N</th>
                <th class="letter">A</th>
                <th class="letter">M</th>
                <th class="letter">E</th>
                <th class="numeric">Achieved</th>
                <th class="numeric">Available</th>
            </tr>
        </thead>
        <tbody>
            {% for courseName, yearlyValues in allCourses %}
            <tr>
                <td>{{ courseName }}</td>
                <td class="numeric">{{ yearlyValues.enteredGrades }}</td>
                <td class="letter">{{ yearlyValues.letters.N }}</td>
                <td class="letter">{{ yearlyValues.letters.A }}</td>
                <td class="letter">{{ yearlyValues.letters.M }}</td>
                <td class="letter">{{ yearlyValues.letters.E }}</td>
                <td class="numeric">{{ yearlyValues.achievedGrades }}</td>
                <td class="numeric">{{ yearlyValues.availableGrades }}</td>
            </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr class="totals">
                <td></td>
                <td class="numeric">{{ yearlyBreakdown.data.totals[year].enteredGrades }}</td>
                <td class="letter">{{ yearlyBreakdown.data.totals[year].letters.N }}</td>
                <td class="letter">{{ yearlyBreakdown.data.totals[year].letters.A }}</td>
                <td class="letter">{{ yearlyBreakdown.data.totals[year].letters.M }}</td>
                <td class="letter">{{ yearlyBreakdown.data.totals[year].letters.E }}</td>
                <td class="numeric">{{ yearlyBreakdown.data.totals[year].achievedGrades }}</td>
                <td class="numeric">{{ yearlyBreakdown.data.totals[year].availableGrades }}</td>
            </tr>
        </tfoot>
    </table>

    {% include '@schoolgrades/EntriesAndResults.twig' %}
</div>
{% endfor %}