<script type="text/javascript">
    $(function() {
        /*
         * available: fe07fe (pink)
         * N: a0a0a0 (black)
         * A: 5f0466 (purple)
         * M: 6399fd (light blue)
         * E: 2e9c2f (green)
         */
        $('[data-graph="resultSummary"]').schoolGrades_nameGraph({
            title: 'Result Summary',

            /* N, A, M, E, available
             */
            colors: ['#a0a0a0', '#5f0466', '#6399fd', '#2e9c2f', '#fe07fe'],

            categories: [{% for year, values in gradeSummary.data %}'Year {{ year }}'{% if not loop.last %}, {% endif %}{% endfor %}],

            series: [
                {% for currentColumn in gradeSummary.columns %}
                {% if currentColumn == 'availableGrades' %}
                {
                    name: 'Available Grades',
                    data: [{% for year, values in gradeSummary.data %}{{ values[currentColumn] }}{% if not loop.last %}, {% endif %}{% endfor %}]
                }
                {% else %}
                {
                    name: '{{ currentColumn }}',
                    data: [{% for year, values in gradeSummary.data %}{{ values.letters[currentColumn] }}{% if not loop.last %}, {% endif %}{% endfor %}]
                },
                {% endif %}
                {% endfor %}
            ]
        });
    });
</script>

<h1>{{ gradeSummary.heading }}</h1>

<table>
    <thead class="generic-heading-highlight">
        <tr>
            <th class="numeric">Year</th>
            <th class="numeric">Entered Grades</th>
            <th class="letter">N</th>
            <th class="letter">A</th>
            <th class="letter">M</th>
            <th class="letter">E</th>
            <th class="numeric">Available</th>
        </tr>
    </thead>
    <tbody>
        {% for year, values in gradeSummary.data %}
        <tr>
            <td class="numeric">{{ year }}</td>
            <td class="numeric">{{ values.enteredGrades }}</td>
            <td class="letter">{{ values.letters.N }}</td>
            <td class="letter">{{ values.letters.A }}</td>
            <td class="letter">{{ values.letters.M }}</td>
            <td class="letter">{{ values.letters.E }}</td>
            <td class="numeric">{{ values.availableGrades }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<div data-graph="resultSummary"></div>