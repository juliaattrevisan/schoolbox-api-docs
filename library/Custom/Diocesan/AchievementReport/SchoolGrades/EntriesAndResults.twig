<table>
    <thead class="generic-heading-highlight">
    <tr>
        <th colspan="3">{{ entriesAndResults.heading }} {{ year }}</th>
    </tr>
    </thead>
    <tbody>
    {% for courseName, areaData in entriesAndResults.data[year] %}
        <tr>
            <td class="subheading">
                {{ courseName }}

                <ul class="teacher-list">
                    {% for currentTeacherName, currentTeacherEmail in areaData.allTeachers %}
                    <li>
                        <em>{% if currentTeacherEmail != '' %}<a href='mailto:{{ currentTeacherEmail }}'>{{ currentTeacherName }}</a></em>{% else %}{{ currentTeacherName }}{% endif %}</em>{% if not loop.last %}, {% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </td>
            <td class="subheading">Result</td>
        </tr>
        {#
            Hide subjects with no term4 and no term2 values only
            for previous years - this indicates students didn't
            get round to doing the subject properly and thus the
            entire thing should be ignored
        #}
        {% for currentArea, values in areaData.allAreas %}
        {% if year != currentYear and (values.letters.term4 != '' or values.letters.term2 != '') %}
        <tr>
            <td>{{ currentArea }}</td>
            <td>
                {% if values.letters.term4 != '' %}
                    {{ values.letters.term4 }}
                {% else %}
                    {{ values.letters.term2 }}
                {% endif %}
            </td>
        </tr>
        {% endif %}
        {% endfor %}
        {% if not loop.last %}
            <tr class="spacer">
                <td colspan="2"></td>
            </tr>
        {% endif %}
    {% endfor %}
    </tbody>
</table>