<link href="/custom/diocesan/achievementreport/css/styles.css" media="screen" rel="stylesheet" type='text/css' />
<script type="text/javascript" src="/javascript/components/highcharts/highcharts.js"></script>
<script type="text/javascript" src="/custom/diocesan/achievementreport/js/nameGraph.js"></script>
<script type="text/javascript">
    $(function() {
        $('[data-graph="resultSummary"]').nameGraph({
            title: 'Result Summary',
            categories: [{% for year, values in gradeSummary.data %}'Year {{ year }}'{% if not loop.last %}, {% endif %}{% endfor %}],
            series: [
                {% for currentColumn in gradeSummary.columns %}
                {% if currentColumn == 'availableGrades' %}
                {
                    name: 'Available Grades',
                    data: [{% for year, values in gradeSummary.data %}{{ values[currentColumn] }}{% if not loop.last %}, {% endif %}{% endfor %}]
                }
                {% else %}
                {
                    name: '{{ currentColumn }}',
                    data: [{% for year, values in gradeSummary.data %}{{ values.letters[currentColumn] }}{% if not loop.last %}, {% endif %}{% endfor %}]
                },
                {% endif %}
                {% endfor %}
            ]
        });
    });
</script>

<h2>{{ gradeSummary.heading }}</h2>

<table>
    <thead>
        <tr>
            <th>Year</th>
            <th>Entered Grades</th>
            <th>N</th>
            <th>A</th>
            <th>M</th>
            <th>E</th>
            <th>Available Grades</th>
        </tr>
    </thead>
    <tbody>
        {% for year, values in gradeSummary.data %}
        <tr>
            <td>{{ year }}</td>
            <td>{{ values.enteredGrades }}</td>
            <td>{{ values.letters.N }}</td>
            <td>{{ values.letters.A }}</td>
            <td>{{ values.letters.M }}</td>
            <td>{{ values.letters.E }}</td>
            <td>{{ values.availableGrades }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<div data-graph="resultSummary"></div>