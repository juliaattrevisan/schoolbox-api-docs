<style type="text/css">
    table {
        border-collapse: collapse;
    }
    table, td, th {
        border: 1px dashed #f00;
        padding: 20px;
        text-align: left;
    }
</style>

<h2>{{ gradeSummary.heading }}</h2>

<table>
    <thead>
        <tr>
            <th>Year</th>
            <th>Entered Grades</th>
            <th>N</th>
            <th>A</th>
            <th>M</th>
            <th>E</th>
            <th>D</th>
            <th>S</th>

        </tr>
    </thead>
    <tbody>
        {% for year, values in gradeSummary.data %}
        <tr>
            <td>{{ year }}</td>
            <td>{{ values.total }}</td>
            <td>{{ values.N }}</td>
            <td>{{ values.A }}</td>
            <td>{{ values.M }}</td>
            <td>{{ values.E }}</td>
            <td>{{ values.D }}</td>
            <td>{{ values.S }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>