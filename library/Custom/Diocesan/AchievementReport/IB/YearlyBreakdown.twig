<div class="row">
    <div class="small-12 columns">
        <div class="scrollable">
            <table>
                <tbody>
                    {% for courseName, courseData in yearlyBreakdown.data %}
                    <tr>
                        <td class="subheading">{{ courseName }}</td>
                        <td class="subheading numeric">Result</td>
                    </tr>

                    <tr>
                        <td>TeacherName</td>
                        <td>&nbsp;</td>
                    </tr>

                    {% if courseData.assessments|length %}
                        {% for assessment, result in courseData.assessments %}
                        <tr>
                            <td>{{ assessment }}</td>
                            <td class="numeric">{{ result }}</td>
                        </tr>
                        {% endfor %}
                    {% endif %}

                    <tr>
                        <td colspan="2">
                            <p class="subheading">Comments</p>

                            {% if commentData.comment|length %}
                                <p>Term {{ term }} - {{ commentData.comment }}&mdash;{{ macro.renderTeachers(commentData.teachers) }}</p>
                            {% endif %}
                        </td>
                    </tr>

                        {% if not loop.last %}
                            <tr class="spacer">
                                <td colspan="2"></td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
