<ul class="breadcrumb">
    <li><a href="/search/user/{{ student.getId()|e('url') }}">{{ student.formatName() }}</a></li>
    <li class="active"><a href="#">Course List</a></li>
</ul>

<div class="row">
    <div class="small-12 island">
        <h1>Course List</h1>
    </div>

    <div class="small-12 island">
        <section>
            <div class="avatar card small-12">
                <a href="/search/user/{{ student.getId()|e('url') }}">
                    <img src="/portrait.php?userId={{ student.getExternalId()|e('url') }}&size=square64" />
                    <h3>{{ student.formatName() }}</h3>
                </a>
                <p class="meta">
                    {{ student.formatMetadata() }}
                </p>
            </div>
        </section>
    </div>

    <div class="small-12 island">
        <section>
            <ul class="action-list">
                {% for subject in subjects %}
                    {% if courses[subject.getId()] is not empty %}
                        <li class="compact avatar card small-12">
                            <a href="/homepage/{{ subject.getId() }}">
                                <span class="icon-home"></span>
                                <h3>{{ subject.getNameWithCodes() }}</h3>
                            </a>
                        </li>
                        {% for course in courses[subject.getId()] %}
                            <li class="compact avatar card small-12">
                                <a href="/homepage/{{ course.getId() }}">
                                    <span class="icon-course"></span>
                                    <h4>{{ course.getNameWithCodes() }}</h4>
                                </a>
                            </li>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </ul>
        </section>
    </div>
</div>
