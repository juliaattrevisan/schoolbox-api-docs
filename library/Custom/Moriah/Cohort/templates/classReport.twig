<ul class="breadcrumb">
    <li><a href="/search/user/{{ student.getId()|e('url') }}">{{ student.formatName() }}</a></li>
    <li><a href="{{ routeLookup('customMoriahCohort.classList', {studentId: student.getId()}) }}">Class List</a></li>
    <li class="active"><a href="#">{{ class.getNameWithCodes() }}</a></li>
</ul>

<div class="row">
    <div class="small-12 island">
        <h1>{{ class.getNameWithCodes() }}</h1>
    </div>

    <div class="small-12 island">
        <section>
            <div class="avatar card small-12">
                <a href="/search/user/{{ student.getId()|e('url') }}">
                    <img src="/portrait.php?userId={{ student.getExternalId()|e('url') }}&size=square64" />
                    <h3>{{ student.formatName() }}</h3>
                </a>
                <p class="meta">
                    {{ student.formatMetadata() }}
                </p>
            </div>
        </section>
    </div>

    <div class="small-12 island">
        <section>
            <ul class="action-list">
                <li>
                    {% for course in courses %}
                        <div class="avatar card small-12">
                            <span class="icon-course icon-32"></span>
                            <h3>{{ course.getNameWithCodes() }}</h3>
                            <p class="meta">
                                Used by 2 other classes.
                            </p>
                        </div>
                    {% endfor %}
                </li>
            </ul>
        </section>
    </div>
</div>
