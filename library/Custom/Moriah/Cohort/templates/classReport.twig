<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts-more.js"></script>
<script type="text/javascript" src="/javascript/shared/submissions/reportCardBoxplot.js"></script>
<script type="text/javascript">
    var graphData = {};
    {% for courseId, result in results %}
    {% for baseUnitId, unitResult in result.units %}
    graphData[{{ baseUnitId }}] = {{ unitResult|json_encode|raw }};
    {% endfor %}
    {% endfor %}

    $(function() {
        $('[data-unit-graph]').each(function() {
            var unitId = $(this).data('unitGraph');

            /**
             * Boxplots for each Task in the Unit
             */
            $.fn.reportCardBoxplotRender({
                element: this,
                /* Title of the graph
                 */
                title: '',
                /* Orientation of the box plots
                 */
                orientation: 'vertical',
                /* A list of all the assessment names that are being graphed
                 * These correspond to a series of data and their respective
                 * five-point summaries
                 */
                allAssessments: graphData[unitId].titles,
                /* All the raw data
                 */
                allData: $.fn.reportCardBoxplotCalculateAllSeriesData(graphData[unitId].allMarks),
                /* You
                 */
                additionalSeries: [
                    {
                        type: 'scatter',
                        name: 'You',
                        color: 'rgb(255, 87, 87)',
                        marker: {
                            radius: 6
                        },
                        data: graphData[unitId].myMarks.map(function(v) { return v.marks.mark; }),
                        tooltip: {
                            headerFormat: '',
                            borderColor: '#000000',
                            pointFormatter: function() {
                                // Pluck it out of myMarks
                                var myMark = graphData[unitId].myMarks[this.x].marks;
                                var displayMark = myMark.display_mark;
                                /* Basic template for each outlier
                                 */
                                var template =
                                        '<div style="width:200px!important;overflow:auto;white-space:normal !important;">' +
                                        '<p class="grade gradient-{GRADIENTMARK}"><span>{DISPLAYMARK}</span></p>' +
                                        '<p class="comment">{INFO}</p>' +
                                        '</div>';
                                /* Concatenate everything
                                 */
                                if (typeof displayMark != 'undefined') {
                                    var tooltipContent = template;
                                    if (displayMark != null) {
                                        tooltipContent = tooltipContent.replace(/\{DISPLAYMARK}/, displayMark);
                                        tooltipContent = tooltipContent.replace(/\{GRADIENTMARK}/, Math.floor(myMark.mark / 10));
                                    } else {
                                        tooltipContent = tooltipContent.replace(/\{DISPLAYMARK}/, '');
                                        tooltipContent = tooltipContent.replace(/\{GRADIENTMARK}/, '');
                                    }
                                    tooltipContent = tooltipContent.replace(/\{INFO}/, myMark.comment);

                                    /* Show tooltip
                                     */
                                    $('.highcharts-tooltip').show();
                                    return tooltipContent;
                                } else {

                                    /* Hide tooltip when no data
                                     */
                                    $('.highcharts-tooltip').hide();
                                }
                                return null;
                            }
                        }
                    }
                ]
            });
        });
    });
</script>

<ul class="breadcrumb">
    <li><a href="/search/user/{{ student.getId()|e('url') }}">{{ student.formatName() }}</a></li>
    <li><a href="{{ routeLookup('customMoriahCohort.classList', {studentId: student.getId()}) }}">Class List</a></li>
    <li class="active"><a href="#">{{ class.getNameWithCodes() }}</a></li>
</ul>

<div class="row">
    <div class="small-12 island">
        <h1>{{ class.getNameWithCodes() }}</h1>
    </div>

    <div class="small-12 island">
        <section>
            <div class="avatar card small-12">
                <a href="/search/user/{{ student.getId()|e('url') }}">
                    <img src="/portrait.php?userId={{ student.getExternalId()|e('url') }}&size=square64" />
                    <h3>{{ student.formatName() }}</h3>
                </a>
                <p class="meta">
                    {{ student.formatMetadata() }}
                </p>
            </div>
        </section>
    </div>

    <div class="small-12 island">
        <section>
            <ul class="action-list">
                <li>
                    {% for result in results %}
                        {% set otherUsageCount = max(0, (result.folders|length)-1) %}
                        <div class="avatar card small-12">
                            <span class="icon-course icon-32"></span>
                            <h3>{{ result.course.getNameWithCodes() }}</h3>
                            <p class="meta">
                                Used by {{ otherUsageCount ?: 'no' }}
                                other {% if otherUsageCount == 1 %}class{% else %}classes{% endif %}.
                            </p>
                        </div>
                        <ul class="action-list reply">
                        {% for baseUnitId, unitResult in result.units %}
                            <li>
                                <div class="avatar card small-12">
                                    <span class="icon-folder icon-32"></span>
                                    <h3>{{ unitResult.unit.getTitle() }}</h3>
                                </div>
                                <div data-unit-graph="{{ baseUnitId|e('html_attr') }}"
                                     id="unit-graph-{{ baseUnitId|e('html_attr') }}"></div>
                            </li>
                        {% endfor %}
                        </ul>
                    {% endfor %}
                </li>
            </ul>
        </section>
    </div>
</div>
