<ul class="breadcrumb">
    <li><a href="/search/user/{{ student.getId()|e('url') }}">{{ student.formatName() }}</a></li>
    <li class="active"><a href="#">Class List</a></li>
</ul>

<div class="row">
    <div class="small-12 island">
        <h1>Class List</h1>
    </div>

    <div class="small-12 island">
        <section>
            <div class="avatar card small-12">
                <a href="/search/user/{{ student.getId()|e('url') }}">
                    <img src="/portrait.php?userId={{ student.getExternalId()|e('url') }}&size=square64" />
                    <h3>{{ student.formatName() }}</h3>
                </a>
                <p class="meta">
                    {{ student.formatMetadata() }}
                </p>
            </div>
        </section>
    </div>

    <div class="small-12 island">
        <section>
            <ul class="action-list">
                {% for class in classes %}
                    {% set courseCount = courses[class.getId()]|length %}
                    {% if courseCount > 0 %}
                    <li>
                        <div class="list-item">
                            <div class="compact avatar card small-12">
                                <a href="{{ routeLookup('customMoriahCohort.classReport', {studentId: student.getId(), classId: class.getId()}) }}">
                                    <span class="icon-home"></span>
                                    <h3>{{ class.getNameWithCodes() }}</h3>
                                    <p class="meta">
                                        {{ courseCount }} {% if courseCount == 1 %}course{% else %}courses{% endif %}
                                    </p>
                                </a>
                            </div>
                        </div>
                    </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </section>
    </div>
</div>
