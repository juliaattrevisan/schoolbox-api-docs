<div class="row">
    <div class="small-12 island">
        <h1>Course Participation API Test</h1>
{% if codes | length %}
        <section>
            <p class="content">The links in this list will all expire 10 seconds after page-load. If you click a link after that, you'll simply receive a generic 400 response.</p>
            <ul class="information-list">
                {% for code in codes %}
                    {% set school = code.siteSchoolCode %}
                    {% set digest  = hashes[school] %}
                    <li>
                        <a class="link-row content" href="{{ routeLookup('helpCourseParticipation.getFolderAccessBySchool', { schoolCode: school }) }}?ts={{ ts }}&digest={{ digest }}">{{ school }} participations</a>
                    </li>
                    <li>
                        <a class="link-row content" href="{{ routeLookup('helpCourseParticipation.getUsersBySchool', { schoolCode: school }) }}?ts={{ ts }}&digest={{ digest }}">{{ school }} user list</a>
                    </li>
                {% endfor %}
            </ul>
            <p class="content">
                Run SQL similar to the following to inject some school codes:
                <code>INSERT INTO site_access VALUES ('my_code', sha1('my_code'));</code>
            </p>
        </section>
        <div class="alert-box warning">
            If you attempt to make requests against a server other than yourself, you'll need to make sure
            that the school code and secret match on both servers.
        </div>
        <form method="post" action="{{ routeLookup('helpCourseParticipation.postApiTest') }}">
            <section>
                <fieldset class="content">
                    <legend>Register a User</legend>
                    <div class="small-12 columns">
                        <label for="host">Server</label>
                        <input id="host" type="text" value="192.168.36.10" name="host" />

                        <label for="schoolCode">School Code</label>
                        <input id="schoolCode" type="text" name="schoolCode" value="" />

                        {% for field in fields %}
                            {% set field_id = field ~ '-' ~ loop.index %}
                            <label for="{{ field_id }}">{{ field | capitalize }}</label>
                            <input id="{{ field_id }}" type="text" name="user[0][{{ field }}]" value="" />
                        {% endfor %}
                    </div>
                </fieldset>
            </section>
            <input type="submit" value="Register User" />
        </form>
        <form method="post" action="#" id="enrolment-form">
            <section>
                <fieldset class="content">
                    <legend>Enrol or Unenrol Users</legend>
                    <div class="small-12 columns">
                        <fieldset id="host">
                            <label for="enrolment-host-name">Server</label>
                            <input id="enrolment-host-name" type="text" value="192.168.36.10" name="host" />

                            <div class="long switch">
                                <input id="enrolment-host-https" type="checkbox" value="1" />
                                <label for="enrolment-host-https">
                                    <span>HTTPS</span>
                                    <span>HTTP</span>
                                </label>
                            </div>
                        </fieldset>

                        <div id="user-list">
                            <p>Load users for:</p>
                            {% for code in codes %}
                                <button data-load-users value="{{ code.siteSchoolCode }}">{{ code.siteSchoolCode }}</button>
                            {% endfor %}
                        </div>
                    </div>
                </fieldset>
            </section>
            <input id="submit-enrolment" type="submit" value="Update Enrolments" class="hide" />
        </form>

{% else %}
        <div class="empty-state">
            <sbx-icon name="info" size="2.5rem"></sbx-icon>
            <p>
                Run SQL similar to the following to inject some school codes:
                <code>INSERT INTO site_access VALUES ('my_code', sha1('my_code'));</code>
            </p>
        </div>
{% endif %}
    </div>
</div>
<script>
    $(function () {
        var digestGetRoute      = "{{ routeLookup('helpCourseParticipation.getRefreshDigest') }}";
        var enrolmentGetRoute  = "{{ routeLookup('helpCourseParticipation.getApiTestEnrolmentTable') }}";
        var enrolmentPostRoute = "{{ routeLookup('helpCourseParticipation.postFolderAccessBySchool') }}";

        var $submit   = $('#submit-enrolment');
        var $ul       = $('#user-list');
        var $host     = $('#host');
        var $hostname = $('#enrolment-host-name');
        var $scheme   = $('#enrolment-host-https');
        var $form     = $('#enrolment-form');

        $form.on('submit', function (e) {
            e.preventDefault();

            var schoolCode = $form.data('schoolCode');

            var data = $(this).serialize();

            fetch(getServer() + digestGetRoute, schoolCode).done(function (auth) {
                $.ajax($form.attr('action') + '?' + $.param(auth), {
                    method: $form.attr('method'),
                    data: data
                }).done(function () {
                    loadEnrolments(schoolCode);
                }).fail(function (xhr, status, reason) {
                    console.log(reason);
                });
            });
        });

        $ul.on('click', '[data-load-users]', function (e) {
            e.preventDefault();
            loadEnrolments($(this).val());
        });

        function loadEnrolments(schoolCode)
        {
            var host   = $hostname.val();
            var server = getServer();

            $host.prop('disabled', true);

            $ul.html('<p>Getting a fresh digest for ' + schoolCode + ' from ' + host + '&hellip;</p>');

            fetch(server + digestGetRoute, schoolCode).done(function (auth) {
                $ul.html('<p>Getting enrolment data for ' + schoolCode + ' from ' + host + '&hellip;</p>');

                fetch(server + enrolmentGetRoute, schoolCode, auth).done(function (tableHtml) {
                    $ul.html(tableHtml);

                    $submit.removeClass('hide');

                    $form.attr('action', server + enrolmentPostRoute.replace('{schoolCode}', schoolCode));
                    $form.attr('data-school-code', schoolCode);

                }).fail(function (xhr, status, reason) {
                    $ul.html('<p>Enrolment fetch failed: '+reason+'. <button data-load-users value="' + schoolCode + '">Try again</button></p>');
                    $host.prop('disabled', false);
                });

            }).fail(function (xhr, status, reason) {
                $ul.html('<p>Digest fetch failed: '+reason+'. <button data-load-users value="' + schoolCode + '">Try again</button></p>');
                $host.prop('disabled', false);
            });
        }


        function fetch(route, schoolCode, data) {
            if (schoolCode === undefined) {
                throw "School code is undefined";
            }

            return $.get(route.replace('{schoolCode}', schoolCode), data);
        }


        function getServer() {
            var host   = $hostname.val();
            var scheme = $scheme.prop('checked') ? 'https://' : 'http://';

            return scheme + host;
        }

    });
</script>
