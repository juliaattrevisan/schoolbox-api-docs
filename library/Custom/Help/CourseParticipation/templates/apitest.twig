<div class="row">
    <div class="small-12 island">
        <h1>Course Participation API Test</h1>
{% if codes | length %}
        <section>
            <p class="content">The links in this list will all expire 10 seconds after page-load. If you click a link after that, you'll simply receive a generic 400 response.</p>
            <ul class="information-list">
                {% for code in codes %}
                    {% set school = code.siteSchoolCode %}
                    {% set token  = hashes[school] %}
                    <li>
                        <a class="link-row content" href="{{ routeLookup('helpCourseParticipation.getFolderAccessBySchool', { schoolCode: school }) }}?ts={{ ts }}&token={{ token }}">{{ school }} participations</a>
                    </li>
                    <li>
                        <a class="link-row content" href="{{ routeLookup('helpCourseParticipation.getUsersBySchool', { schoolCode: school }) }}?ts={{ ts }}&token={{ token }}">{{ school }} user list</a>
                    </li>
                {% endfor %}
            </ul>
            <p class="content">
                Run SQL similar to the following to inject some school codes:
                <code>INSERT INTO site_access VALUES ('my_code', sha1('my_code'));</code>
            </p>
        </section>
        <form method="post" action="{{ routeLookup('helpCourseParticipation.postApiTest') }}">
            <section>
                <fieldset class="content">
                    <legend>Register a User</legend>
                    <div class="small-12 columns">
                        <p>
                            If you attempt to POST against a server other than yourself, you'll need to make sure
                            that the school code and secret match on both servers.
                        </p>
                        <label>Server to POST
                            <input type="text" value="192.168.36.10" name="host" />
                        </label>
                        <label>School Code
                            <input type="text" name="schoolCode" value="" />
                        </label>
                        {% for field in fields %}
                            <label>{{ field | capitalize }}
                                <input type="text" name="user[0][{{ field }}]" value="" />
                            </label>
                        {% endfor %}

                    </div>
                </fieldset>
            </section>
            <input type="submit" value="Register User" />
        </form>
{% else %}
        <div class="empty-state">
            <i class="icon-info"></i>
            <p>
                Run SQL similar to the following to inject some school codes:
                <code>INSERT INTO site_access VALUES ('my_code', sha1('my_code'));</code>
            </p>
        </div>
{% endif %}
    </div>
</div>
