<div class="row">
    <div class="small-12 island">
        <h1>NESA Report</h1>


        <form action="{{ routeLookup('helpNesa.postNesa') }}" method="post">
            <h2 class="subheader">Options</h2>
            <section class="content">
            <ul class="option-list">
            {# Default NSW #}
            {% for state in states %}
                {% if state == 'NSW' %}
                    {% set checked = 'checked="checked"' %}
                {% else %}
                    {% set checked = '' %}
                {% endif %}
                <li>
                    <input id="state-{{ state }}" name="state[]" type="checkbox" value="{{ state }}" {{ checked }}/>
                    <label for="state-{{ state }}" class="checkbox-label">{{ state }}</label>
                </li>
            {% endfor %}
            </ul>
            </section>

            <section class="content">
                <input id="include-accredited" name="unaccreditedOnly" type="checkbox" value="1" checked="checked" />
                <label for="include-accredited" class="checkbox-label">Show only unaccredited teachers</label>
            </section>

            <h2 class="subheader">{{ course.title }}</h2>

            <table>
                <thead>
                    <th></th>
                    <th>Capability</th>
                    <th>Indicator</th>
                    <th>Descriptor</th>
                </thead>

                {% for id, data in descriptors  %}
                    {% if data.indicator.capability.name == 'Australian Professional Teaching Standards' %}
                        {% set checked = 'checked="checked"' %}
                    {% else %}
                        {% set checked = '' %}
                    {% endif %}
                <tr>
                    <td>
                        <input id="indicator-{{ loop.index0 }}" name='indicators[]' type="checkbox" value="{{ data.indicator.name }}" {{ checked }}/>
                        <label for="indicator-{{ loop.index0 }}" class="checkbox-label"></label>
                    </td>
                    <td style="width:33%">{{ data.indicator.capability.name }}</td>
                    <td style="width:33%">{{ data.indicator.name }}</td>
                    <td style="width:33%">{{ data.description }}</td>
                </tr>
                {% endfor %}
            </table>
            <input type="submit" value="Generate" />
        </form>
    </div>
</div>
