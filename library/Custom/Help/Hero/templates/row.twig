<tr>
    <td><a href="/search/user/{{ id }}" title="View Profile for {{ userData.fullname }}">{{ userData.fullname }}</a></td>
    <td><a href="/homepage/{{ userData.folderId }}" title="Visit Teacher Course homepage for {{ userData.folderName }}">{{ userData.folderName }}</a></td>
    <td>
        {% if userData.qualified %}
            Qualified
        {% endif %}
    </td>
    <td>
        <a href="{{ routeLookup('learningGrades.getGrades', {userId: id }) }}" title="Visit Grades page for {{ userData.fullname }}">Grades</a>
    </td>
    <td class="actions-small-1">
        {% if userData.heroised %}
            <a class="icon-favourite" title="{{ userData.fullname }} is on the Hero Wall"></a>
        {% endif %}
    </td>
</tr>