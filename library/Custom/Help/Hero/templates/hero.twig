<div class="row">
    <div class="small-12 columns">
        <h1>Hero Report</h1>
        <ul class="meta">
            <li class="icon-timetable">Took approx. {{ duration }} seconds</li>
        </ul>
    </div>
</div>

{# Process this in two parts:
 # First get the people who have qualified, but aren't on the wall
 #}
<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">Hero Candidates</h2>
        <table>
            <thead>
                <tr>
                    <th>User</th>
                    <th>Qualification</th>
                    <th>Grades</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            {% for id, userData in aggregatedData %}
            {% if userData.qualified and not userData.heroised %}
                <tr>
                    <td><a href="/search/user/{{ id }}">{{ userData.fullname }}</a></td>
                    <td>
                        {% if userData.qualified %}
                            Qualified
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ routeLookup('learningGrades.getGrades', {userId: id }) }}" title="Grades">Grades</a>
                    </td>
                    <td class="actions-small-1">
                    </td>
                </tr>
            {% endif %}
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# Then get the people who have qualified and are on the wall
 #}
<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">Heroes</h2>
        <table>
            <thead>
                <tr>
                    <th>User</th>
                    <th>Qualification</th>
                    <th>Grades</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            {% for id, userData in aggregatedData %}
            {% if userData.heroised %}
                <tr>
                    <td><a href="/search/user/{{ id }}">{{ userData.fullname }}</a></td>
                    <td>
                        {% if userData.qualified %}
                            Qualified
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ routeLookup('learningGrades.getGrades', {userId: id }) }}" title="Grades">Grades</a>
                    </td>
                    <td class="actions-small-1">
                        {% if userData.heroised %}
                            <a class="icon-favourite" title="{{ userData.fullname }} is on the Hero Wall"></a>
                        {% endif %}
                    </td>
                </tr>
            {% endif %}
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
