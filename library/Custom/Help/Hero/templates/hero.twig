<div class="row">
    <div class="small-12 columns">
        <h1>Hero Report</h1>
        <ul class="meta">
            <li class="icon-timetable">Took approx. {{ duration }} seconds</li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <table>
            <thead>
                <tr>
                    <th>User</th>
                    <th>Qualification</th>
                    <th>Status</th>
                </tr>
            </thead>
            {% for id, userData in aggregatedData %}
            {% if userData.qualified or heroes[id]%}
            <tr>
                <td><a href="/search/user/{{ id }}">{{ userData.firstname }} {{ userData.lastname }}</a></td>
                <td>
                    {% if userData.qualified %}
                    Qualified
                    {% endif %}
                </td>
                <td class="actions-small-1">
                    {% if heroes[id] %}
                        <a class="icon-favourite" title="{{ userData.firstname }} {{ userData.lastname }} is on the Hero Wall"></a>
                    {% endif %}
                </td>
            </tr>
            {% endif %}
            {% endfor %}
        </table>
    </div>
</div>
