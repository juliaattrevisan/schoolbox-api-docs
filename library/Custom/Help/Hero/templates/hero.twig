<style type="text/css">
    td.center, th.center {
        text-align: center;
    }
</style>

<div class="row">
    <div class="small-12 columns">
        <h1>Hero Report</h1>
        <ul class="meta">
            <li class="icon-timetable">Took approx. {{ duration }} seconds</li>
        </ul>
    </div>
</div>

{# Process this in two parts:
 # First get the people who have qualified, but aren't on the wall
 #}
<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">Hero Candidates</h2>
        <table>
            <thead>
                <tr>
                    <th style="width:30%">User</th>
                    <th style="width:36%">Course</th>
                    <th style="width:12%" class="center">Qualification</th>
                    <th style="width:12%" class="center">Grades</th>
                    <th style="width:10%" class="center">Status</th>
                </tr>
            </thead>
            <tbody>
            {% for id, userData in aggregatedData %}
            {% if userData.qualified and not userData.heroised %}
                {% include '@helpHero/row.twig' with {
                    id: id,
                    userData: userData
                } %}
            {% endif %}
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# Then get the people who have qualified and are on the wall
 #}
<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">Heroes</h2>
        <table>
            <thead>
                <tr>
                    <th style="width:30%">User</th>
                    <th style="width:36%">Course</th>
                    <th style="width:12%" class="center">Qualification</th>
                    <th style="width:12%" class="center">Grades</th>
                    <th style="width:10%" class="center">Status</th>
                </tr>
            </thead>
            <tbody>
            {% for id, userData in aggregatedData %}
            {% if userData.heroised %}
                {% include '@helpHero/row.twig' with {
                    id: id,
                    userData: userData
                } %}
            {% endif %}
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
