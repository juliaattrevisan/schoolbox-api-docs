<div class="row">
    <div class="small-12 columns">
        <h1>Hero Report</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <table>
            <thead>
                <tr>
                    <th>User</th>
                    <th>Qualification</th>
                    <th>Put On The Wall</th>
                </tr>
            </thead>
            {% for id, userData in aggregatedData %}
            <tr>
                <td><a href="/search/user/{{ id }}">{{ userData.firstname }} {{ userData.lastname }}</a></td>
                <td>
                    {% if userData.qualified %}
                    Qualified
                    {% endif %}
                </td>
                <td>
                    {% if heroes[id] %}
                    Already on wall
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </table>
    </div>
</div>
