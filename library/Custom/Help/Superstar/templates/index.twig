{##
 # OLC Superstar Report
 #
 # @param string $report         Metadata about this report, currently containing the official name of this report
 # @param array $badgeMapping    A set of (unit spec id, badge urls) as a shortcut to repeated route generation
 # @param array $previousAwards  A set of (user id, badge id) tuples for guys who got an achievement previously
 # @param array $stack           A set of candidacy outcomes per person, grouped by unit spec id
 #}
<div class="row">
    <div class="small-12 columns">
        <h1>{{ report.title }}</h1>
    </div>
</div>

{% for unitSpecId, unitSpecData in stack %}
    {% if unitSpecData.actionables|length %}
        <div class="row">
            <div class="small-12 island">
                <h2 class="subheader">{{ unitSpecData.title }}</h2>
                <section class="content">
                    {% if unitSpecData.actionables.superstar|length %}
                        <h3>Superstar</h3>
                        {{ _self.renderActionable('superstar', previousAwards, badgeMapping, unitSpecId, unitSpecData.actionables) }}
                    {% endif %}

                    {% if unitSpecData.actionables.star|length %}
                        <h3>Star</h3>
                        {{ _self.renderActionable('star', previousAwards, badgeMapping, unitSpecId, unitSpecData.actionables) }}
                    {% endif %}
                </section>
            </div>
        </div>
    {% endif %}
{% endfor %}

{##
 # Generic renderer for each guy you can award a badge
 #
 # @param array $badgeMapping  A set of (unit spec id, badge urls) as a shortcut to repeated route generation
 # @param int $unitSpecId      Identifier for a unit spec
 # @param array $actionables   A list of superstars/stars who can be awarded something
 #}
{% macro renderActionable(type, previousAwards, badgeMapping, unitSpecId, actionables) %}
    <ul class="action-list">
        {% for actionable in actionables[type] %}
        <li class="actions-small-1">
            <div class="list-item">
                <a href="/search/user/{{ actionable.id }}">
                    {{ actionable.firstname }} {{ actionable.lastname }}
                </a>
                -
                <a href="/homepage/{{ actionable.school.folderId }}">{{ actionable.school.name }} ({{ actionable.school.code }})</a>
            </div>
            <nav>
                <a class='icon-badge' href="{{ badgeMapping[unitSpecId][type].route }}"></a>
            </nav>
        </li>
        {% endfor %}
    </ul>
{% endmacro %}
