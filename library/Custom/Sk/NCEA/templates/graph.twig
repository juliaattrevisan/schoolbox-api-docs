{% import '@nceaReport/macro.twig' as macro %}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/highcharts.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/custom/sk/ncea/js/stackedBar.js?v={{ config.site_version }}"></script>

<script type="text/javascript">
    $(function() {
        $('#graph').ncea_stackedBar({
            title: 'Running Total of Credits to Date',

            colors: ['#4394FF', '#FFB37C', '#409F40'],

            categories: [
                {{ macro.renderDataLevels(data.levels) }}
            ],

            series: [
                {
                    name: 'Achieved',
                    data: [
                        {{ macro.renderCreditsforAchievement(data, 'A') }}
                    ]
                },
                {
                    name: 'Merit',
                    data: [
                        {{ macro.renderCreditsforAchievement(data, 'M') }}
                    ]
                },
                {
                    name: 'Excellence',
                    data: [
                        {{ macro.renderCreditsforAchievement(data, 'E') }}
                    ]
                }
            ],

            stacking: 'normal',
            stackLabels: true
        });
    });
</script>

<div id="graph"></div>

