{# Only render $total if it wasn't zero
 # Otherwise render it as an empty string
 #}
{% macro renderLevelTotal(total) %}
    {% if total != 0 %}
        {{ total }}
    {% endif %}
{% endmacro %}

{# Render a comma-separated list of values for a given Achievement letter
 # Used to populate the stacked barchart's array of values
 #}
{% macro renderCreditsforAchievement(data, achievement) %}
    {% for level, value in data.graph[achievement] %}
        {% if value %}{{ value }}{% else %}null{% endif %}{% if not loop.last %}, {% endif %}
    {% endfor %}
{% endmacro %}

{# Render "categories" (the y-axis) on the barchart
 # but only for the levels that we know exist, otherwise it renders stupidly and reserves a space
 # for a nonexistent bar
 #}
{% macro renderDataLevels(levels) %}
    {% for level in levels %}
        "{{ level|replace({'L': 'Level '}) }}"{% if not loop.last %}, {% endif %}
    {% endfor %}
{% endmacro %}