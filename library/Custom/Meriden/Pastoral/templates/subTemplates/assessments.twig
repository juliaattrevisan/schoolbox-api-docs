{% set thead %}
<div class="row" id="assessments">
    <div class="small-12 column">
        <h2>Assessments <span class="explanation">(Feedback is provided with the marked task)</span></h2>
        <table class="bordered-table">
            <colgroup>
                <col class="title" />
                <col class="result" />
                <col class="distribution" />
            </colgroup>
            <thead>
            <tr>
                <th class="title">Title</th>
                <th class="result">Result %</th>
                <th class="distribution">Distribution</th>
            </tr>
            </thead>
            <tbody>
{% endset %}

{% set tfoot %}
            </tbody>
        </table>
    </div>
</div>
{% endset %}

{% set first = true %}
{% for workItem in work %}
    {# Is this work item shown to the logged in user? #}
    {% if workItem.distribution %}
        {# Is this the first row that's getting displayed? show the header and that #}
        {% if first %}
            {% set first = false %}
            {{ thead }}
        {% endif %}
        <tr>
            <td class="title">
                <a href="/learning/assessments/{{ workItem.assessment.id }}/{{ student.id }}">
                    {{ workItem.assessment.title }}
                </a>
            </td>
            <td class="result">{{ workItem.pretty_mark | replace({'%': ''}) }}</td>
            <td class="distribution">
                {% if workItem.distribution.continuous.series is defined %}
                    {# Graph goes here #}
                    <div class="chart" id="assessmentGraph-{{ workItem.assessment.id }}-{{ student.id }}"></div>

                    {% autoescape 'js' %}
                    <script type="text/javascript">
                        (function($){
                            $(function() {
                                var prettyMark = "{{ workItem.pretty_mark | replace({'%': ''}) }}",
                                    seriesData = {{ workItem.distribution.continuous.series|json_encode|raw }},
                                    yMax       = 100,
                                    yMin       = 0;

                                $('#assessmentGraph-{{ workItem.assessment.id }}-{{ student.id }}').highcharts({
                                    chart: {
                                        inverted: true,
                                        height: 100,
                                        {% if graphWidth %}width: Number('{{ graphWidth }}'),{% endif %}
                                        reflow: true,
                                    },
                                    title: {
                                        text: null
                                    },
                                    legend: {
                                        enabled: false
                                    },
                                    credits: {
                                        enabled: false
                                    },
                                    xAxis: {
                                        title: {
                                            text: null
                                        },
                                        labels: {
                                            enabled: false
                                        },
                                        tickLength: 0
                                    },
                                    yAxis: {
                                        min: yMin,
                                        floor: yMin,
                                        max: yMax,
                                        ceiling: yMax,
                                        tickPositioner: function () {
                                            var yMean = (yMin + yMax) / 2;
                                            return [yMin, (yMin + yMean) / 2, yMean, (yMax + yMean) / 2, yMax];
                                        },
                                        title: {
                                            text: null
                                        },
                                        labels: {
                                            step: 2
                                        }
                                    },
                                    plotOptions: {
                                        series: {
                                            shadow: false,
                                            animation: false
                                        }
                                    },
                                    series: [
                                        {
                                            type: 'boxplot',
                                            name: null,
                                            data: [seriesData],
                                            tooltip: {
                                                headerFormat: '',
                                                pointFormat:
                                                        'Mean: {{ workItem.distribution.continuous.mean.mark | number_format(1) }}' +
                                                        '<br/>Median: {point.median}<br/>'
                                            }
                                        },
                                        {
                                            type: 'scatter',
                                            name: null,
                                            color: 'rgb(255, 87, 87)',
                                            marker: {
                                                radius: 6
                                            },
                                            data: [{{ (workItem.mark == null or workItem.mark == '') ? null : (workItem.mark|number_format) }}],
                                            tooltip: {
                                                headerFormat: '',
                                                borderColor: '#000000',
                                                pointFormatter: function () {
                                                    /* Basic template for each outlier
                                                     */
                                                    var template =
                                                            '<div style="width:200px!important;overflow:auto;white-space:normal !important;">' +
                                                            '<div class="grade gradient-{GRADIENTMARK}"><span>{DISPLAYMARK}</span></div>' +
                                                            // '<p class="comment">{INFO}</p>' +
                                                            '</div>';
                                                    /* Concatenate everything
                                                     */
                                                    if (typeof prettyMark !== 'undefined') {
                                                        var tooltipContent = template;

                                                        if (prettyMark !== null) {
                                                            tooltipContent = tooltipContent.replace(/{DISPLAYMARK}/, prettyMark);
                                                            tooltipContent = tooltipContent.replace(/{GRADIENTMARK}/, '10');
                                                        }
                                                        else {
                                                            tooltipContent = tooltipContent.replace(/{DISPLAYMARK}/, '');
                                                            tooltipContent = tooltipContent.replace(/{GRADIENTMARK}/, '10');
                                                        }
                                                        // tooltipContent = tooltipContent.replace(/{INFO}/, infoIndex[this.x].info);

                                                        /* Show tooltip
                                                         */
                                                        $('.highcharts-tooltip').show();

                                                        return tooltipContent;
                                                    } else {

                                                        /* Hide tooltip when no data
                                                         */
                                                        $('.highcharts-tooltip').hide();
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                });
                            })
                        })(jQuery);
                    </script>
                    {% endautoescape %}
                {% endif %}
            </td>
        </tr>
    {% endif %}
{% endfor %}

{# Have any rows been shown? If so show the footer #}
{% if not first %}
    {{ tfoot }}
{% endif %}
