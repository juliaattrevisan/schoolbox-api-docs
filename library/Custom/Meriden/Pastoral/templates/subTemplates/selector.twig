{# Selector - like the grades selector, but displays only years #}
{% set currentYear = (tutorGroupReport.year ?: subjectReport.year) %}
{% set hasSubjectReports = subjectReport is not null or tutorGroupReport.hasSubjectReports %}

{# Role type query string: included in selector menu #}
{% set roleTypeQueryString = (roleTypeOverride ? "?role-type=#{roleTypeOverride}" : '') %}
<div class="content hide-on-print">
    <div class="context-switch clearfix">
        <nav>
            <a data-interaction="previous"
               {% if not tutorGroupList[currentYear-1] %}disabled{% endif %}
               href="{{ routeLookup('customMeridenPastoral.index', {year: currentYear-1, id: student.id}) }}{{ roleTypeQueryString }}"></a>
        </nav>
        <div class="semester">
            <select id="context-selector-semester">
                {% for level in tutorGroupList %}
                    <option value="{{ routeLookup('customMeridenPastoral.index', {year: level.year, id: student.id}) }}{{ roleTypeQueryString }}"
                            label="{{ level.name }}"
                            {% if level.year == currentYear %}selected{% endif %}>{{ level.name }}</option>
                {% endfor %}
            </select>
        </div>
        <nav>
            <a data-interaction="next"
               {% if not tutorGroupList[currentYear+1] %}disabled{% endif %}
               href="{{ routeLookup('customMeridenPastoral.index', {year: currentYear+1, id: student.id}) }}{{ roleTypeQueryString }}"></a>
        </nav>

        {% if hasSubjectReports %}
            <div class="subject">
                <select id="context-selector-enrolled-subjects">
                    {# Subject report? show a "Back to eReport" option #}
                    {% if tutorGroupReport.subjectCode %}
                        <option disabled="disabled" selected="selected">Select a subject</option>
                    {% elseif subjectReport.subjectCode %}
                        <option value="{{ routeLookup('customMeridenPastoral.index', {year: subjectReport.year, id: student.id}) }}{{ roleTypeQueryString }}"
                                label="« {{ subjectReport.year }} eReport"
                        >« {{ subjectReport.year }} eReport</option>
                    {% endif %}
                    {% for currentSubject in subjectList %}
                        <option value="{{ routeLookup('customMeridenPastoral.subject', {year: currentSubject.year, id: student.id, subjectCode: currentSubject.subjectCode}) }}{{ roleTypeQueryString }}"
                                label="{{ currentSubject.name }} ({{ currentSubject.subjectCode }})"
                                {% if currentSubject.subjectCode == subjectReport.subjectCode %}selected{% endif %}
                        >{{ currentSubject.name }} ({{ currentSubject.subjectCode }})</option>
                    {% endfor %}
                </select>
            </div>
        {% endif %}
    </div>
</div>
