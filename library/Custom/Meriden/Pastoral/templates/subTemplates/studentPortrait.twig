{# Student's portrait #}
<section>
    <div class="card small-12">
        <a href="/search/user/{{ student.getId() }}" title="View Profile">
            {% include 'include/portrait.twig' with {user: student, description: student.fullName} only %}
            <p>{{ student.formatName() }}</p>
            <p class="meta">Year {{ student.year.name }} Student</p>
        </a>
    </div>
</section>
