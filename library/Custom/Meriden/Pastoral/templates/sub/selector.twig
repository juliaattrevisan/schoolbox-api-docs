{# Selector - like the grades selector, but displays only years #}
{% set currentYear = (tutorGroupReport.year ?: subjectReport.year) %}
<div id="enrolment">
    <form id="semesters">
        <a class="sem-back"
           {% if not tutorGroupList[currentYear-1] %}disabled{% endif %}
           href="{{ routeLookup(
            'customMeridenPastoral.index',
            {year: currentYear-1, id: student.id})
           }}">&lsaquo;</a>
        <select id="semester">
            {% for level in tutorGroupList %}
                <option value="{{ routeLookup(
                            'customMeridenPastoral.index',
                            {year: level.year, id: student.id})
                        }}"
                        label="{{ level.year }} eReport"
                        {% if level.year == currentYear %}selected{% endif %}
                        >{{ level.year }} eReport</option>
            {% endfor %}
        </select>
        <a class="sem-fwd"
           {% if not tutorGroupList[currentYear+1] %}disabled{% endif %}
           href="{{ routeLookup(
            'customMeridenPastoral.index',
            {year: currentYear+1, id: student.id})
           }}">&rsaquo;</a>
    </form>
    <form id="subjects" method="get">
        <span class="elbow">&#9492;</span>
        <select id="enrolled-subjects">
            {# Subject report? show a "Back to eReport" option #}
            {% if tutorGroupReport.subjectCode %}
                <option disabled="disabled" selected="selected">Select a subject</option>
            {% elseif subjectReport.subjectCode %}
                <option value="{{ routeLookup(
                            'customMeridenPastoral.index',
                            {year: subjectReport.year, id: student.id})
                        }}"
                        label="« {{ subjectReport.year }} eReport"
                        >« {{ subjectReport.year }} eReport</option>
            {% endif %}
            {% for currentSubject in subjectList %}
                <option value="{{ routeLookup(
                            'customMeridenPastoral.subject',
                            {year: currentSubject.yr_study, id: student.id, subjectCode: currentSubject.code})
                        }}"
                        label="{{ currentSubject.sub_desc }} ({{ currentSubject.code }})"
                        {% if currentSubject.code == subjectReport.subjectCode %}selected{% endif %}
                        >{{ currentSubject.sub_desc }} ({{ currentSubject.code }})</option>
            {% endfor %}
        </select>
    </form>
</div>