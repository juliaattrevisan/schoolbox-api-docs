{# Selector - like the grades selector, but displays only years #}
<div id="enrolment">
    <form id="semesters">
        <a class="sem-back"
           {% if not year.previous %}disabled{% endif %}
           href="{{ routeLookup('customMeridenPastoral.index', {year: year.current-1, id: student.id}) }}">&lsaquo;</a>
        <select id="semester">
            {% for level in year.levels %}
                <option value="{{ routeLookup('customMeridenPastoral.index', {year: level.yr_study, id: student.id}) }}"
                        label="{{ level.yr_study }} eReport"
                        {% if level.yr_study == year.current %}selected{% endif %}
                        >{{ level.yr_study }} eReport</option>
            {% endfor %}
        </select>
        <a class="sem-fwd"
           {% if not year.next %}disabled{% endif %}
           href="{{ routeLookup('customMeridenPastoral.index', {year: year.current+1, id: student.id}) }}">&rsaquo;</a>
    </form>
    <form id="subjects" method="get">
        <span class="elbow">&#9492;</span>
        <select id="enrolled-subjects">
            <option disabled="disabled" selected="selected">Select a subject</option>
            {% for currentSubject in year.subjects %}
                <option value="{{ routeLookup('customMeridenPastoral.subject', {year: year.current, id: student.id, subjectCode: currentSubject.code}) }}"
                        label="{{ currentSubject.sub_desc }} ({{ currentSubject.code }})"
                        {% if currentSubject.code == subject.current %}selected{% endif %}
                        >{{ currentSubject.sub_desc }} ({{ currentSubject.code }})</option>
            {% endfor %}
        </select>
    </form>
</div>