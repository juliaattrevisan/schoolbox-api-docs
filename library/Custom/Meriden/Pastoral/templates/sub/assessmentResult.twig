{% if grade.rubric %}
    <table class="width-auto bordered-table">
        {% for capabilityMark in grade.rubric.capabilityMarks %}
            {% for indicatorMark in capabilityMark.indicatorMarks %}
                <tr>
                    <td>{{ indicatorMark.indicatorUsage.indicator.name }}</td>
                    <td>{{ indicatorMark.descriptor.description|default('N/A') }}</td>
                </tr>
            {% endfor %}
        {% endfor %}
    </table>
{% else %}
    {{ grade.pretty_mark }}
{% endif %}
