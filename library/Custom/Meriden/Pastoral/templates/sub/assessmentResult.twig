{% if grade.rubric.groups %}
    <div class="scrollable">
        <table>
            {% for group in grade.rubric.groups %}
                {% for criterion in group.criteria %}
                    {% for descriptor in criterion.descriptors %}
                        {% if descriptor.selected %}
                            <tr>
                                <th>{{ criterion.name }}</th>
                                <td>{{ descriptor.text }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            {% endfor %}
        </table>
    </div>
{% else %}
    <div class="content">
        {{ grade.pretty_mark }}
    </div>
{% endif %}
