{# Student's portrait #}
<section>
    <div class="card small-12">
        <a href="/search/user/{{ student.getId() }}" title="View Profile">
            <img src="/portrait.php?userId={{ student.getExternalId() }}&amp;size=square64" alt="{{ student.formatName() }}" />
            <p>{{ student.formatName() }}</p>
            <p class="meta">Year {{ student.getYear() }} Student</p>
        </a>
    </div>
</section>
