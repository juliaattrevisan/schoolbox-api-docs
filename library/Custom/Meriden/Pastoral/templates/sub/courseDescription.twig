{##
 # Course description for subject and lateral learning reports.
 #
 # Parameters:
 # * description: the course's textual description
#}
{% if description %}
<div class="row" id="course-description">
    <div class="small-12 column">
        <h2>Course Description</h2>
        <section>
            <article class="content" id="course-description">
                <p>{{ description }}</p>
            </article>
        </section>
    </div>
</div>
{% endif %}
