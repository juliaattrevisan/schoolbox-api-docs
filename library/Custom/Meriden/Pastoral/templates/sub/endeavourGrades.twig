{# Endeavor Grades - was a rubric, now four separate assessments. Check for both #}

{# Is each individual term accessible by current user? #}
{% set display1 =
    (report.subjectReport.namedGrades.endeavourGrade1
    and report.subjectReport.namedGrades.endeavourGrade1.assessment.isFeedbackVisibleToUser(USER))
%}
{% set display2 =
    (report.subjectReport.namedGrades.endeavourGrade2
    and report.subjectReport.namedGrades.endeavourGrade2.assessment.isFeedbackVisibleToUser(USER))
%}
{% set display3 =
    (report.subjectReport.namedGrades.endeavourGrade3
    and report.subjectReport.namedGrades.endeavourGrade3.assessment.isFeedbackVisibleToUser(USER))
%}
{% set display4 =
    (report.subjectReport.namedGrades.endeavourGrade4
    and report.subjectReport.namedGrades.endeavourGrade4.assessment.isFeedbackVisibleToUser(USER))
%}
{% set displaySeparate = display1 or display2 or display3 or display4 %}

{# Is the rubric accessible by current user? #}
{% set displayRubric =
    (report.subjectReport.namedGrades.endeavourGrades
    and report.subjectReport.namedGrades.endeavourGrades.assessment.isFeedbackVisibleToUser(USER))
%}

{% if displaySeparate or displayRubric %}
<div class="row" id="endeavour-grades">
    <div class="small-12 column">
        <dl class="small-gap">
            <dt>Endeavour {{ locale.grades.properPlural }}</dt>
            <dd class="explanation hide-for-print"><a href="/homepage/3461">[{{ locale.grades.proper }} Description]</a></dd>
        </dl>
    </div>

    <div class="small-12 column">
        <table class="width-auto bordered-table">
            <thead>
            <tr>
                {% if displaySeparate %}
                    <th>Term 1</th>
                    <th>Term 2</th>
                    <th>Term 3</th>
                    <th>Term 4</th>
                {% else %}
                    {% for capabilityMark in report.subjectReport.namedGrades.endeavourGrades.rubric.capabilityMarks %}
                        {% for indicatorMark in capabilityMark.indicatorMarks %}
                            {{ indicatorMark.indicatorUsage.indicator.name }}
                        {% endfor %}
                    {% else %}
                        {# fill all with N/A #}
                        <th>Term 1</th>
                        <th>Term 2</th>
                        <th>Term 3</th>
                        <th>Term 4</th>
                    {% endfor %}
                {% endif %}
            </tr>
            </thead>
            <tbody>
            <tr>
                {% if displaySeparate %}
                    <td>
                        {% if display1 %}
                            {{ report.subjectReport.namedGrades.endeavourGrade1.pretty_mark|default('N/A') }}
                        {% else %}
                            N/A
                        {% endif %}
                    </td>
                    <td>
                        {% if display2 %}
                            {{ report.subjectReport.namedGrades.endeavourGrade2.pretty_mark|default('N/A') }}
                        {% else %}
                            N/A
                        {% endif %}
                    </td>
                    <td>
                        {% if display3 %}
                            {{ report.subjectReport.namedGrades.endeavourGrade3.pretty_mark|default('N/A') }}
                        {% else %}
                            N/A
                        {% endif %}
                    </td>
                    <td>
                        {% if display4 %}
                            {{ report.subjectReport.namedGrades.endeavourGrade4.pretty_mark|default('N/A') }}
                        {% else %}
                            N/A
                        {% endif %}
                    </td>
                {% else %}
                    {# Old-style rubric endeavor grade #}
                    {% for capabilityMark in report.subjectReport.namedGrades.endeavourGrades.rubric.capabilityMarks %}
                        {% for indicatorMark in capabilityMark.indicatorMarks %}
                            {{ indicatorMark.descriptor.description|default('N/A') }}
                        {% endfor %}
                    {% else %}
                        <td>N/A</td>
                        <td>N/A</td>
                        <td>N/A</td>
                        <td>N/A</td>
                    {% endfor %}
                {% endif %}
            </tr>
            </tbody>
        </table>
    </div>
</div>
{% endif %}
