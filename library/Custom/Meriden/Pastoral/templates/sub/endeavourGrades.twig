{# Endeavor Grades - was a rubric, now four separate assessments. Check for both #}

{# Is each individual term accessible by current user? #}
{% set display1 =
    (report.subjectReport.namedGrades.endeavourGrade1
    and report.subjectReport.namedGrades.endeavourGrade1.assessment.isMarkShownToRole(user.role))
%}
{% set display2 =
    (report.subjectReport.namedGrades.endeavourGrade2
    and report.subjectReport.namedGrades.endeavourGrade2.assessment.isMarkShownToRole(user.role))
%}
{% set display3 =
    (report.subjectReport.namedGrades.endeavourGrade3
    and report.subjectReport.namedGrades.endeavourGrade3.assessment.isMarkShownToRole(user.role))
%}
{% set display4 =
    (report.subjectReport.namedGrades.endeavourGrade4
    and report.subjectReport.namedGrades.endeavourGrade4.assessment.isMarkShownToRole(user.role))
%}
{% set displaySeparate = display1 or display2 or display3 or display4 %}

{# Is the rubric accessible by current user? #}
{% set displayRubric =
    (report.subjectReport.namedGrades.endeavourGrades
    and report.subjectReport.namedGrades.endeavourGrades.assessment.isMarkShownToRole(user.role))
%}

{% if displaySeparate or displayRubric %}
<dt class="fullwidth">
    Endeavour Grades
    <div class="description-link">[<a href="/homepage/3461">Grade Description</a>]</div>
</dt>
<dd class="fullwidth">
    <table>
        <thead>
        <tr>
            {% if displaySeparate %}
                <th>Term 1</th>
                <th>Term 2</th>
                <th>Term 3</th>
                <th>Term 4</th>
            {% else %}
                {% for criterion in report.subjectReport.namedGrades.endeavourGrades.rubric.criteria %}
                    <th>{{ criterion.label }}</th>
                {% else %}
                    {# fill all with N/A #}
                    <th>Term 1</th>
                    <th>Term 2</th>
                    <th>Term 3</th>
                    <th>Term 4</th>
                {% endfor %}
            {% endif %}
        </tr>
        </thead>
        <tbody>
        <tr>
            {% if displaySeparate %}
                <td>
                    {% if display1 %}
                        {{ report.subjectReport.namedGrades.endeavourGrade1.pretty_mark|default('N/A') }}
                    {% else %}
                        N/A
                    {% endif %}
                </td>
                <td>
                    {% if display2 %}
                        {{ report.subjectReport.namedGrades.endeavourGrade2.pretty_mark|default('N/A') }}
                    {% else %}
                        N/A
                    {% endif %}
                </td>
                <td>
                    {% if display3 %}
                        {{ report.subjectReport.namedGrades.endeavourGrade3.pretty_mark|default('N/A') }}
                    {% else %}
                        N/A
                    {% endif %}
                </td>
                <td>
                    {% if display4 %}
                        {{ report.subjectReport.namedGrades.endeavourGrade4.pretty_mark|default('N/A') }}
                    {% else %}
                        N/A
                    {% endif %}
                </td>
            {% else %}
                {# Old-style rubric endeavor grade #}
                {% for criterion in report.subjectReport.namedGrades.endeavourGrades.rubric.criteria %}
                    <td>{{ criterion.results[criterion.value]|default('N/A') }}</td>
                {% else %}
                    <td>N/A</td>
                    <td>N/A</td>
                    <td>N/A</td>
                    <td>N/A</td>
                {% endfor %}
            {% endif %}
        </tr>
        </tbody>
    </table>
</dd>
{% endif %}