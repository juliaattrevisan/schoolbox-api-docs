{% set thead %}
<div class="row" id="assessments">
    <div class="small-12 column">
        <h2>Assessments <span class="explanation">(Feedback is provided with the marked task)</span></h2>
        <div class="scrollable">
            <table class="bordered-table">
                <thead>
                <tr>
                    <th class="fixed-40">Title</th>
                    <th>Result %</th>
                    <th>Mean %</th>
                    <th>Distribution</th>
                </tr>
                </thead>
                <tbody>
{% endset %}

{% set tfoot %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endset %}

{% set first = true %}
{% for workItem in work %}
    {# Is this work item shown to the logged in user? #}
    {% if workItem.distribution and workItem.assessment.isFeedbackVisibleToUser(USER) %}
        {# Is this the first row that's getting displayed? show the header and that #}
        {% if first %}
            {% set first = false %}
            {{ thead }}
        {% endif %}
        <tr>
            <td>
                <a href="/learning/assessments/{{ workItem.assessment.id }}/{{ student.id }}">
                    {{ workItem.assessment.title }}
                </a>
            </td>
            <td>{{ workItem.pretty_mark | replace({'%': ''}) }}</td>
            <td>{{ workItem.distribution.continuous.mean.mark | number_format(1) }}</td>
            <td>
                {# Graph goes here #}
                <div id="assessmentGraph-{{ workItem.assessment.id }}-{{ student.id }}"></div>

                {% autoescape 'js' %}
                <script type="text/javascript">
                    (function($){
                        $(function() {
                            $('#assessmentGraph-{{ workItem.assessment.id }}-{{ student.id }}').highcharts({
                                chart: {
                                    type: 'boxplot'
                                },
                                title: {
                                    text: null
                                },
                                series: [{
                                    name: "{{ workItem.assessment.title }}",
                                    data: [{{ workItem.distribution.continuous.series|json_encode|raw }}]
                                }],
                                yAxis: {
                                    min: 0,
                                    max: 100
                                }
                            });
                        })
                    })(jQuery);
                </script>
                {% endautoescape %}
            </td>
        </tr>
    {% endif %}
{% endfor %}

{# Have any rows been shown? If so show the footer #}
{% if not first %}
    {{ tfoot }}
{% endif %}
