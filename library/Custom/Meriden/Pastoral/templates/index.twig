<script type="text/javascript">
    (function($){
        $(function(){
            // Jump menu for changing semester
            $('#semester, #enrolled-subjects').on('change', function() {
                window.location.href = this.value;
            });
        })
    })(jQuery);
</script>

<style type="text/css">
    /* TODO remove inline styles */
    #meriden-crest {
        text-align: center;
    }
    #house-info dt {

    }
    #house-info dd {

    }
    .teacher-profile.no-email {
         margin-right: 0;
     }
</style>

<h1>School Report - {{ report.year.current }}</h1>

<div id="context">
    {% include '@customMeridenPastoral/sub/studentPortrait.twig' with {student: report.student} %}

    {# Selector - like the grades selector, but displays only years #}
    <div id="enrolment">
        <form id="semesters">
            <a class="sem-back"
               {% if not report.year.previous %}disabled{% endif %}
               href="{{ routeLookup('customMeridenPastoral.index', {year: report.year.current-1, id: report.student.id}) }}">&lsaquo;</a>
            <select id="semester">
                {% for year in report.year.levels %}
                <option value="{{ routeLookup('customMeridenPastoral.index', {year: year.yr_study, id: report.student.id}) }}"
                        label="{{ year.yr_study }} eReport"
                        {% if year.yr_study == report.year.current %}selected{% endif %}
                        >{{ year.yr_study }} eReport</option>
                {% endfor %}
            </select>
            <a class="sem-fwd"
               {% if not report.year.next %}disabled{% endif %}
               href="{{ routeLookup('customMeridenPastoral.index', {year: report.year.current+1, id: report.student.id}) }}">&rsaquo;</a>
        </form>
        <form id="subjects" method="get">
            <span class="elbow">&#9492;</span>
            <select id="enrolled-subjects">
                <option disabled="disabled" selected="selected">Select a subject</option>
                {% for subject in report.year.subjects %}
                <option value="{{ routeLookup('customMeridenPastoral.subject', {year: report.year.current, id: report.student.id, subjectCode: subject.code}) }}"
                        label="{{ subject.sub_desc }} ({{ subject.code }})"
                        >{{ subject.sub_desc }} ({{ subject.code }})</option>
                {% endfor %}
            </select>
        </form>
    </div>
</div>

{# Table of contents #}
<div id="meriden-crest">
    <img src="/images/meriden/crest.png" />
</div>

<dl id="house-info">
    <dt>House</dt>
    <dd>{{ report.student.house.name }}</dd>

    <dt>Year Coordinator</dt>
    <dd>{{ report.studentExternal.coordinator.name }}</dd>

    <dt>Tutor</dt>
    {% for tutor in report.studentExternal.tutors %}
        <dd>{{ tutor.tch_name }} (Semester {{ tutor.semester }})</dd>
    {% endfor %}
</dl>

<dl id="attendance-info">
    <dt>Days Absent</dt>
    <dd>{{ report.studentExternal.attendance.absent }}</dd>

    <dt>Days Late</dt>
    <dd>{{ report.studentExternal.attendance.late }}</dd>

    <dt>Detentions</dt>
    <dd>{{ report.studentExternal.attendance.detentions }}</dd>

    {# Don't show endorsed leave at all if there is none #}
    {% if report.studentExternal.attendance.endorsedLeave %}
        <dt>Endorsed Leave</dt>
        <dd>{{ report.studentExternal.attendance.endorsedLeave }}</dd>
    {% endif %}

    {##
     # Athletics, Swimming, Camp, Uniform, Pastoral Services:
     # All these are attendances, and are based off of assessments in the grade page.
     #}
    {% for assessment in report.studentExternal.assessments %}
        <dt>{{ assessment.name }}</dt>
        <dd>{{ assessment.grade }}</dd>
    {% endfor %}
</dl>

<dl id="awards-info">
    <dt>Awards and Prizes</dt>
    {% for award in report.studentExternal.activities.awards %}
        <dd>{{ award.act_desc }}</dd>
    {% endfor %}

    <dt>Co-curricular Activities</dt>
    {% for activity in report.studentExternal.activities.cocurricular %}
        <dd>{{ activity.act_desc }}</dd>
    {% endfor %}

    <dt>Community Service</dt>
    {% for service in report.studentExternal.activities.service %}
        <dd>{{ service.act_desc }}</dd>
    {% endfor %}

    <dt>Positions of Office</dt>
    {% for position in report.studentExternal.activities.positions %}
        <dd>{{ position.act_desc }}</dd>
    {% endfor %}
</dl>

{##
 # Subjects: exactly the same as the subject list on /search/user/{{ report.student.id }},
 # except I guess they will link to this page instead.
 #
 # Meriden have requested that no email links display on this page,
 # due to the possiblilty of parents getting drunk and sending emails to teachers.
 # Whatever happened to the saying "Give a man enough rope..."?
 #}
<div class="directory">
    <div class="subjects">
        <h2>Subjects</h2>
        {# Split half the subjects in one column, half in the other #}
        {% set reportHalf = (report.year.subjects|length / 2)|round(0, 'ceil') %}
        <ul>
            {% for subject in report.year.subjects|slice(0, reportHalf) %}
                {% include '@customMeridenPastoral/sub/subject.twig' with {subject: subject, showEmail: false} %}
            {% endfor %}
        </ul>
        {##
         # The second half has a ul per subject,
         # the first only has a single ul for all subjects.
         # Go figure!
         #}
        {% for subject in report.year.subjects|slice(reportHalf) %}
            <ul>
                {% include '@customMeridenPastoral/sub/subject.twig' with {subject: subject, showEmail: false} %}
            </ul>
        {% endfor %}
    </div>
</div>
