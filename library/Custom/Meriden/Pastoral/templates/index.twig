<script type="text/javascript">
    (function($){
        $(function(){
            // Jump menu for changing semester
            $('#context-selector-semester, #context-selector-enrolled-subjects').on('change', function() {
                window.location.href = this.value;
            });
        })
    })(jQuery);
</script>

<div id="pastoral-report" class="e-report">
    <div class="row">
        <div class="small-12 columns">
            <div class="meriden-crest">
                {% include '@customMeridenPastoral/sub/crestSvg.twig' %}
            </div>
        </div>
    </div>

    <div class="row" id="context">
        {% include '@customMeridenPastoral/sub/context.twig' with {report: report} %}
    </div>

    {# House info #}
    <div class="row" id="house-info">
        <div class="small-12 medium-4 column">
            <dl>
                <dt>House</dt>
                <dd>{{ report.student.schoolHouse.house }}</dd>
            </dl>
        </div>
        <div class="small-12 medium-4 column">
            <dl>
                <dt>Year Coordinator</dt>
                {% for coordinator in report.tutorGroupReport.coordinators %}
                    <dd><a href="/search/user/{{ coordinator.id }}">{{ coordinator.formatName }}</a></dd>
                {% endfor %}
            </dl>
        </div>
        <div class="small-12 medium-4 column end">
            <dl>
                <dt>Tutor</dt>
                {% for tutor in report.tutorGroupReport.tutors %}
                    <dd>{{ tutor.tch_name }}</dd>
                {% endfor %}
            </dl>
        </div>
    </div>

    {# Attendance info #}
    <div class="row" id="attendance-info">
        <div class="small-12 medium-4 column">
            <dl>
                <dt>Days Absent</dt>
                <dd>{{ report.tutorGroupReport.attendances.absent }}</dd>
            </dl>
        </div>
        <div class="small-12 medium-4 column">
            <dl>
                <dt>Days Late</dt>
                <dd>{{ report.tutorGroupReport.attendances.late }}</dd>
            </dl>
        </div>
        <div class="small-12 medium-4 column">
            <dl>
                <dt>Detentions</dt>
                <dd>{{ report.tutorGroupReport.attendances.detentions }}</dd>
            </dl>
        </div>
        {# Don't show endorsed leave at all if there is none #}
        {% if report.tutorGroupReport.attendances.endorsedLeave %}
            <div class="small-12 medium-4 column">
                <dl>
                    <dt>Endorsed Leave</dt>
                    <dd>{{ report.tutorGroupReport.attendances.endorsedLeave }}</dd>
                </dl>
            </div>
        {% endif %}
        <div class="small-12 medium-4 column">
            <dl>
                <dt>Athletics Carnival</dt>
                <dd>
                    {% if report.tutorGroupReport.namedGrades.athletics %}
                        {%
                        include '@customMeridenPastoral/sub/assessmentResult.twig'
                        with {grade: report.tutorGroupReport.namedGrades.athletics}
                        %}
                    {% else %}
                        Unknown
                    {% endif %}
                </dd>
            </dl>
        </div>
        <div class="small-12 medium-4 column">
            <dl>
                <dt>Swimming Carnival</dt>
                <dd>
                    {% if report.tutorGroupReport.namedGrades.swimming %}
                        {%
                        include '@customMeridenPastoral/sub/assessmentResult.twig'
                        with {grade: report.tutorGroupReport.namedGrades.swimming}
                        %}
                    {% else %}
                        Unknown
                    {% endif %}
                </dd>
            </dl>
        </div>
        <div class="small-12 medium-4 column">
            <dl>
                <dt>School Camp</dt>
                <dd>
                    {% if report.tutorGroupReport.namedGrades.camp %}
                        {%
                        include '@customMeridenPastoral/sub/assessmentResult.twig'
                        with {grade: report.tutorGroupReport.namedGrades.camp}
                        %}
                    {% else %}
                        Unknown
                    {% endif %}
                </dd>
            </dl>
        </div>
        <div class="small-12 medium-4 column">
            <dl>
                <dt>Uniform</dt>
                <dd class="explanation hide-for-print"><a href="/homepage/5648/">[Explanation]</a></dd>
                <dd>
                    {% if report.tutorGroupReport.namedGrades.uniform %}
                        {%
                        include '@customMeridenPastoral/sub/assessmentResult.twig'
                        with {grade: report.tutorGroupReport.namedGrades.uniform}
                        %}
                    {% else %}
                        Unknown
                    {% endif %}
                </dd>
            </dl>
        </div>
        <div class="small-12 medium-4 column">
            <dl>
                <dt>Pastoral activities involvement</dt>
                <dd class="explanation hide-for-print"><a href="/homepage/5648/">[Explanation]</a></dd>
                <dd>
                    {% if report.tutorGroupReport.namedGrades.pastoral %}
                        {%
                        include '@customMeridenPastoral/sub/assessmentResult.twig'
                        with {grade: report.tutorGroupReport.namedGrades.pastoral}
                        %}
                    {% else %}
                        Unknown
                    {% endif %}
                </dd>
            </dl>
        </div>
        <div class="small-12 medium-4 column end">
            <dl>
                {##
                 # Athletics, Swimming, Camp, Uniform, Pastoral Services:
                 # All these are attendances, and are based off of assessments in the grade page.
                 #}
                {% for grade in report.tutorGroupReport.grades %}
                    <dt>{{ grade.assessment.title }}</dt>
                    <dd>{{ grade.pretty_mark }}</dd>
                {% endfor %}
            </dl>
        </div>
    </div>

    {# Awards info #}
    <div class="row" id="awards-info">
        {% if not report.tutorGroupReport.activities.awards is empty %}
            {% include '@customMeridenPastoral/sub/activity.twig' with {
                header: 'Awards and Prizes',
                activityList: report.tutorGroupReport.activities.awards
            } %}
        {% endif %}
        {% if not report.tutorGroupReport.activities.cocurricular is empty %}
            {% include '@customMeridenPastoral/sub/activity.twig' with {
                header: 'Cocurricular Activities',
                activityList: report.tutorGroupReport.activities.cocurricular
            } %}
        {% endif %}
        {% if not report.tutorGroupReport.activities.service is empty %}
            {% include '@customMeridenPastoral/sub/activity.twig' with {
                header: 'Community Service',
                activityList: report.tutorGroupReport.activities.service
            } %}
        {% endif %}
        {% if not report.tutorGroupReport.activities.positions is empty %}
            {% include '@customMeridenPastoral/sub/activity.twig' with {
                header: 'Positions of Office',
                activityList: report.tutorGroupReport.activities.positions
            } %}
        {% endif %}
    </div>

    {# Tutor comment #}
    {% if report.tutorGroupReport.namedGrades.tutorComment %}
    <div class="row" id="tutor-comment">
        <div class="small-12 column">
            <dl>
                <dt>Tutor Comment</dt>
                <dd>{{ report.tutorGroupReport.namedGrades.tutorComment.comment|e('html')|nl2br }}</dd>
            </dl>
        </div>
    </div>
    {% endif %}

    {# Subject list #}
    <div class="row subject-list" id="subject-list">
        <div class="small-12 column">
            <h2 class>Subjects</h2>
        </div>
        <section>
            {##
             # Subjects: exactly the same as the subject list on /search/user/{{ report.student.id }},
             # except I guess they will link to this page instead.
             #
             # Meriden have requested that no email links display on this page,
             # due to the possiblilty of parents getting drunk and sending emails to teachers.
             #}
            <div class="row">
                {% set reportHalf = (report.subjectList|length / 2)|round(0, 'ceil') %}
                <div class="small-12 medium-6 column">
                    {% for subject in report.subjectList|slice(0, reportHalf) %}
                        {% include '@customMeridenPastoral/sub/subject.twig' with {
                            student: report.student,
                            year: report.tutorGroupReport.year,
                            subject: subject,
                            showEmail: false,
                            showPortrait: false
                        } %}
                    {% endfor %}
                </div>
                <div class="small-12 medium-6 column">
                    {% for subject in report.subjectList|slice(reportHalf) %}
                        {% include '@customMeridenPastoral/sub/subject.twig' with {
                        student: report.student,
                        year: report.tutorGroupReport.year,
                        subject: subject,
                        showEmail: false,
                        showPortrait: false
                        } %}
                    {% endfor %}
                </div>
            </div>
        </section>
    </div>
</div>
