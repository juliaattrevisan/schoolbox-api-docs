{# Table of contents #}
<img src="/images/meriden/crest.png" />
<dl>
    <dt>House</dt>
    <dd>{{ report.student.house.name }}</dd>

    <dt>Year Coordinator</dt>
    <dd>{{ report.studentExternal.coordinator.name }}</dd>

    <dt>Tutor</dt>
    <dd>{{ report.studentExternal.tutor.name }}</dd>

    <dt>Days Absent</dt>
    <dd>{{ report.studentExternal.absent }}</dd>

    <dt>Days Late</dt>
    <dd>{{ report.studentExternal.late }}</dd>

    <dt>Detentions</dt>
    <dd>{{ report.studentExternal.detentions }}</dd>

    <dt>Endorsed Leave</dt>
    <dd>{{ report.studentExternal.endorsedLeave }}</dd>

    <dt>Athletics Carnival</dt>
    <dd>{{ report.studentExternal.attendedAthletics ? "In Attendance" : "Absent" }}</dd>

    <dt>Swimming Carnival</dt>
    <dd>{{ report.studentExternal.attendedSwimming ? "In Attendance" : "Absent" }}</dd>

    <dt>School Camp</dt>
    <dd>{{ report.studentExternal.attendedCamp ? "In Attendance" : "Absent" }}</dd>

    <dt>Uniform</dt>
    <dd>{{ report.studentExternal.uniformOkay ? "Satisfactory" : "Unsatisfactory" }}</dd>

    <dt>Pastoral Activities Involvement</dt>
    <dd>{{ report.studentExternal.pastoralOkay ? "Satisfactory" : "Unsatisfactory" }}</dd>
</dl>

<dl>
    <dt>Awards and Prizes</dt>
    {% for award in report.studentExternal.awards %}
        <dd>{{ award.name }}</dd>
    {% endfor %}

    <dt>Co-curricular Activities</dt>
    {% for activity in report.studentExternal.activities %}
        <dd>{{ activity.name }}</dd>
    {% endfor %}

    <dt>Community Service</dt>
    {% for service in report.studentExternal.communityService %}
        <dd>{{ service.name }}</dd>
    {% endfor %}

    <dt>Positions of Office</dt>
    {% for position in report.studentExternal.positions %}
        <dd>{{ position.name }}</dd>
    {% endfor %}
</dl>

{##
 # Subjects: exactly the same as the subject list on /search/user/{{ report.student.id }},
 # except I guess they will link to this page instead.
 #}
{% for subjectGroup in report.subjects %}
    {% set emailList = [] %}
    <h2>{{ subjectGroup.name }}</h2>
    <ul>
        {% for subject in subjectGroup.subjects %}
            <li>
                <div class="subject">
                    <a class="to-subject" href="#">
                        {{ subject.code }}
                        <span class="icon"></span>
                    </a>
                </div>
                {% for teacher in subject.teachers %}
                    <div class="profile">
                        <a href="/search/user/{{ teacher.id }}" class="teacher-profile">
                            <img src="/portrait.php?userId={{ teacher.externalId }}&amp;size=square32">
                            <span class="name">{{ teacher.formatName }}</span>
                            <span class="role">{{ teacher.role.name }}</span>
                        </a>
                        {% if teacher.email %}
                            {% set emailList = emailList ~ ',' ~ teacher.email %}
                            <a class="mail-teacher" href="/mail/createMail.php?replyto={{ teacher.email }}">Mail</a>
                        {% endif %}
                    </div>
                {% endfor %}
            </li>
        {% endfor %}
    </ul>
    {# Email all teachers #}
    {% if emailList|length %}
        <a class="mail-teacher" href="/mail/createMail.php?replyto={{ emailList|join(',') }}">Email all</a>
    {% endif %}
{% endfor %}
