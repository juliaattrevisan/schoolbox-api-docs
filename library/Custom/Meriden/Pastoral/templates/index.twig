<script type="text/javascript">
    (function($){
        $(function(){
            // Jump menu for changing semester
            $('#semester, #enrolled-subjects').on('change', function() {
                window.location.href = this.value;
            });
        })
    })(jQuery);
</script>

<style type="text/css">
    /* TODO remove inline styles */
    #meriden-crest {
        text-align: center;
    }
    #house-info dt {

    }
    #house-info dd {

    }
    .teacher-profile.no-email {
         margin-right: 0;
     }
</style>

<h1>School Report - {{ report.year.current }}</h1>

<div id="context">
    {% include '@customMeridenPastoral/sub/studentPortrait.twig' with {student: report.student} %}
    {% include '@customMeridenPastoral/sub/selector.twig' with {year: report.year, student: report.student} %}
</div>

{# Table of contents #}
<div id="meriden-crest">
    <img src="/images/meriden/crest.png" />
</div>

<dl id="house-info">
    <dt>House</dt>
    <dd>{{ report.student.house.name }}</dd>

    <dt>Year Coordinator</dt>
    <dd>{{ report.yearLevelReport.coordinator.name }}</dd>

    <dt>Tutor Group</dt>
    <dd>
        {% if report.yearLevelReport.tutorGroup.folder.id %}
            <a href="/homepage/{{ report.yearLevelReport.tutorGroup.folder.id }}">
                {{ report.yearLevelReport.tutorGroup.code }}
            </a>
        {% else %}
            {{ report.yearLevelReport.tutorGroup.code }}
        {% endif %}
    </dd>

    <dt>Tutor</dt>
    {% for tutor in report.yearLevelReport.tutors %}
        <dd>{{ tutor.tch_name }} (Semester {{ tutor.semester }})</dd>
    {% endfor %}
</dl>

<dl id="attendance-info">
    <dt>Days Absent</dt>
    <dd>{{ report.yearLevelReport.attendance.absent }}</dd>

    <dt>Days Late</dt>
    <dd>{{ report.yearLevelReport.attendance.late }}</dd>

    <dt>Detentions</dt>
    <dd>{{ report.yearLevelReport.attendance.detentions }}</dd>

    {# Don't show endorsed leave at all if there is none #}
    {% if report.yearLevelReport.attendance.endorsedLeave %}
        <dt>Endorsed Leave</dt>
        <dd>{{ report.yearLevelReport.attendance.endorsedLeave }}</dd>
    {% endif %}

    {##
     # Athletics, Swimming, Camp, Uniform, Pastoral Services:
     # All these are attendances, and are based off of assessments in the grade page.
     #}
    {% for assessment in report.yearLevelReport.assessments %}
        <dt>{{ assessment.name }}</dt>
        <dd>{{ assessment.grade }}</dd>
    {% endfor %}
</dl>

<dl id="awards-info">
    <dt>Awards and Prizes</dt>
    {% for award in report.yearLevelReport.activities.awards %}
        <dd>{{ award.act_desc }}</dd>
    {% endfor %}

    <dt>Co-curricular Activities</dt>
    {% for activity in report.yearLevelReport.activities.cocurricular %}
        <dd>{{ activity.act_desc }}</dd>
    {% endfor %}

    <dt>Community Service</dt>
    {% for service in report.yearLevelReport.activities.service %}
        <dd>{{ service.act_desc }}</dd>
    {% endfor %}

    <dt>Positions of Office</dt>
    {% for position in report.yearLevelReport.activities.positions %}
        <dd>{{ position.act_desc }}</dd>
    {% endfor %}
</dl>

{##
 # Subjects: exactly the same as the subject list on /search/user/{{ report.student.id }},
 # except I guess they will link to this page instead.
 #
 # Meriden have requested that no email links display on this page,
 # due to the possiblilty of parents getting drunk and sending emails to teachers.
 # Whatever happened to the saying "Give a man enough rope..."?
 #}
<div class="directory">
    <div class="subjects">
        <h2>Subjects</h2>
        {# Split half the subjects in one column, half in the other #}
        {% set reportHalf = (report.year.subjects|length / 2)|round(0, 'ceil') %}
        <ul>
            {% for subject in report.year.subjects|slice(0, reportHalf) %}
                {% include '@customMeridenPastoral/sub/subject.twig' with {subject: subject, showEmail: false} %}
            {% endfor %}
        </ul>
        {##
         # The second half has a ul per subject,
         # the first only has a single ul for all subjects.
         # Go figure!
         #}
        {% for subject in report.year.subjects|slice(reportHalf) %}
            <ul>
                {% include '@customMeridenPastoral/sub/subject.twig' with {subject: subject, showEmail: false} %}
            </ul>
        {% endfor %}
    </div>
</div>
