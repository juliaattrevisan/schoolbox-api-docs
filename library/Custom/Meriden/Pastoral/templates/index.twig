<h1>School Report - {{ report.year.current }}</h1>

<div id="context">
    {# Student's portrait - exactly the same as /submission/allWork/{{ report.student.id }} #}
    <div id="student">
        <a class="bar large button" href="/search/user/{{ report.student.id }}">
            <img src="/portrait.php?userId={{ report.student.externalId }}&amp;size=square64">
            <span class="name">{{ report.student.formatName }}</span>
            <span class="group">Year {{ report.student.year }} Student</span>
        </a>
    </div>

    {# Selector - like the grades selector, but displays only years #}
    <div id="enrolment">
        <form id="semesters">
            <a class="sem-back" href="#">&lsaquo;</a>
            <select id="semester">
                {% for year in report.year.list %}
                <option value="{{ year }}"
                        label="{{ year }} eReport"
                        >{{ year }} eReport</option>
                {% endfor %}
            </select>
            <a class="sem-fwd" href="#">&rsaquo;</a>
        </form>
        <form id="subjects" method="get">
            <span class="elbow">&#9492;</span>
            <select id="enrolled-subjects">
                <option disabled="disabled" selected="selected">Select a subject</option>
                {% for subject in report.student.subjectCollection %}
                <option value="{{ subject.code }}"
                        label="{{ subject.name }} ({{ subject.code }})"
                        >{{ subject.name }} ({{ subject.code }})</option>
                {% endfor %}
            </select>
        </form>
    </div>
</div>

{# Table of contents #}
<img src="/images/meriden/crest.png" />
<dl>
    <dt>House</dt>
    <dd>{{ report.student.house.name }}</dd>

    <dt>Year Coordinator</dt>
    <dd>{{ report.studentExternal.coordinator.name }}</dd>

    <dt>Tutor</dt>
    <dd>{{ report.studentExternal.tutor.name }}</dd>

    <dt>Days Absent</dt>
    <dd>{{ report.studentExternal.attendance.absent }}</dd>

    <dt>Days Late</dt>
    <dd>{{ report.studentExternal.attendance.late }}</dd>

    <dt>Detentions</dt>
    <dd>{{ report.studentExternal.attendance.detentions }}</dd>

    {# Don't show endorsed leave at all if there is none #}
    {% if report.studentExternal.attendance.endorsedLeave %}
        <dt>Endorsed Leave</dt>
        <dd>{{ report.studentExternal.attendance.endorsedLeave }}</dd>
    {% endif %}

    {##
     # Athletics, Swimming, Camp, Uniform, Pastoral Services:
     # All these are based off of assessments in the grade page.
     #}
    {% for assessment in report.studentExternal.assessments %}
        <dt>{{ assessment.name }}</dt>
        <dd>{{ assessment.grade }}</dd>
    {% endfor %}
</dl>

<dl>
    <dt>Awards and Prizes</dt>
    {% for award in report.studentExternal.activities.awards %}
        <dd>{{ award.act_desc }}</dd>
    {% endfor %}

    <dt>Co-curricular Activities</dt>
    {% for activity in report.studentExternal.activities.cocurricular %}
        <dd>{{ activity.act_desc }}</dd>
    {% endfor %}

    <dt>Community Service</dt>
    {% for service in report.studentExternal.activities.service %}
        <dd>{{ service.act_desc }}</dd>
    {% endfor %}

    <dt>Positions of Office</dt>
    {% for position in report.studentExternal.activities.positions %}
        <dd>{{ position.act_desc }}</dd>
    {% endfor %}
</dl>

{##
 # Subjects: exactly the same as the subject list on /search/user/{{ report.student.id }},
 # except I guess they will link to this page instead.
 #
 # Meriden have requested that no email links display on this page,
 # due to the possiblilty of parents getting drunk and sending emails to teachers.
 # Whatever happened to the saying "Give a man enough rope..."?
 #}
{% for subjectGroup in report.subjects %}
    <h2>{{ subjectGroup.name }}</h2>
    <ul>
        {% for subject in subjectGroup.subjects %}
            <li>
                <div class="subject">
                    <a class="to-subject" href="#">
                        {{ subject.code }}
                        <span class="icon"></span>
                    </a>
                </div>
                {% for teacher in subject.teachers %}
                    <div class="profile">
                        <a href="/search/user/{{ teacher.id }}" class="teacher-profile">
                            <img src="/portrait.php?userId={{ teacher.externalId }}&amp;size=square32">
                            <span class="name">{{ teacher.formatName }}</span>
                            <span class="role">{{ teacher.role.name }}</span>
                        </a>
                    </div>
                {% endfor %}
            </li>
        {% endfor %}
    </ul>
{% endfor %}
