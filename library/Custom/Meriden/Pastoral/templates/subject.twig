<link rel="stylesheet" type="text/css" href="/css/meriden/pastoral.css" />
<script type="text/javascript">
    (function($){
        $(function(){
            // Jump menu for changing semester
            $('#context-selector-semester, #context-selector-enrolled-subjects').on('change', function() {
                window.location.href = this.value;
            });
        })
    })(jQuery);
</script>

<div id="subject-report" class="e-report">
    <div class="row">
        <div class="small-12 columns">
            <div class="meriden-crest">
                {% include '@customMeridenPastoral/sub/crestSvg.twig' %}
            </div>
        </div>
    </div>

    <div class="row" id="context">
        {% include '@customMeridenPastoral/sub/context.twig' with {report: report} %}
    </div>

    {# course description #}
    <div class="row" id="course-description">
        <div class="small-12 column">
            <h2>Course Description</h2>
            <section>
                <article class="content" id="course-description">
                    <p>{{ report.subjectReport.description }}</p>
                </article>
            </section>
        </div>
    </div>

    {# course grade - derived from grade for this class #}
    {% if report.subjectReport.namedGrades.courseGrade and report.subjectReport.namedGrades.courseGrade.assessment.isMarkShownToRole(user.role) %}
        <div class="row" id="course-info">
            <div class="small-12 medium-2 column">
                <dl>
                    <dt>Course Grade</dt>
                    <dd class="explanation hide-for-print"><a href="/homepage/3403">[Grade Description]</a></dd>
                </dl>
            </div>
            <div class="small-12 medium-10 column">
                <div class="content">
                    <h3>{{ report.subjectReport.namedGrades.courseGrade.pretty_mark }}</h3>
                </div>
            </div>
        </div>

        <div class="row" id="grade-distribution">
            <div class="small-12 medium-2 column">
                <dl>
                    <dt>Grade Distribution</dt>
                </dl>
            </div>
            <div class="small-12 medium-10 column">
                <table class="width-auto bordered-table">
                    <thead>
                    <tr>
                        {% for gradeLevel,_ in report.subjectReport.namedGrades.courseGrade.distribution.grouped %}
                            <th>{{ gradeLevel }}</th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        {% for _,results in report.subjectReport.namedGrades.courseGrade.distribution.grouped %}
                            <td>{{ results|length }}</td>
                        {% endfor %}
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {# Endeavor Grades - complicated enough to be its own template #}
    {% include '@customMeridenPastoral/sub/endeavourGrades.twig' %}

    {# Approaches to learning - another rubric #}
    {% if report.subjectReport.namedGrades.learningApproaches and report.subjectReport.namedGrades.learningApproaches.assessment.isMarkShownToRole(user.role) %}
        <div class="row" id="learning-approaches">
            <div class="small-12 column">
                <dl>
                    <dt>Approaches to Learning</dt>
                    <dd class="explanation hide-for-print"><a href="/homepage/3462">[Grade Description]</a></dd>
                </dl>
            </div>
            <div class="small-12 column">
                {% include '@customMeridenPastoral/sub/assessmentResult.twig' with {grade: report.subjectReport.namedGrades.learningApproaches} %}
            </div>
        </div>
    {% endif %}

    {# Assessments #}
    {% if report.subjectReport.grades %}
        {% include '@customMeridenPastoral/sub/assessments.twig' with {work: report.subjectReport.grades, student: report.student} %}
    {% endif %}
</div>
