<link rel="stylesheet" type="text/css" href="/css/meriden/pastoral.css" />
<script type="text/javascript">
    (function($){
        $(function(){
            // Jump menu for changing semester
            $('#semester, #enrolled-subjects').on('change', function() {
                window.location.href = this.value;
            });
        })
    })(jQuery);
</script>

<div id="subject-report">
    <div id="meriden-crest">
        {% include '@customMeridenPastoral/sub/crestSvg.twig' %}
    </div>

    <h1>{{ report.subjectReport.name }}</h1>

    <div id="context">
        {% include '@customMeridenPastoral/sub/studentPortrait.twig' with {student: report.student} %}
        {% include '@customMeridenPastoral/sub/selector.twig' with {
            tutorGroupList: report.tutorGroupList,
            subjectList:    report.subjectList,
            student:        report.student,
            subjectReport:  report.subjectReport
        } %}
    </div>

    {# course description #}
    <h2 class="clear">Course Description</h2>
    <p id="course-description">
    {{ report.subjectReport.description }}
    </p>

    <dl id="course-info">
        {# course grade - derived from grade for this class #}
        {% if report.subjectReport.namedGrades.courseGrade
           and report.subjectReport.namedGrades.courseGrade.assessment.isMarkShownToRole(user.role)
        %}
        <dt>
            Course Grade
            <div class="description-link">[<a href="/homepage/3403">Grade Description</a>]</div>
        </dt>
        <dd class="course-grade">
            {%
                include '@customMeridenPastoral/sub/assessmentResult.twig'
                with {grade: report.subjectReport.namedGrades.courseGrade}
            %}
        </dd>

        {# grade distribution - other student's values for course grade #}
        <dt>Grade Distribution</dt>
        <dd>
            <table>
                <thead>
                <tr>
                    {% for gradeLevel,_ in report.subjectReport.namedGrades.courseGrade.distribution.grouped %}
                        <th>{{ gradeLevel }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                <tr>
                    {% for _,results in report.subjectReport.namedGrades.courseGrade.distribution.grouped %}
                        <td>{{ results|length }}</td>
                    {% endfor %}
                </tr>
                </tbody>
            </table>
        </dd>
        {% endif %}

        {# Endeavor Grades - complicated enough to be its own template #}
        {% include '@customMeridenPastoral/sub/endeavourGrades.twig' %}

        {# Approaches to learning - another rubric #}
        {% if report.subjectReport.namedGrades.learningApproaches
           and report.subjectReport.namedGrades.learningApproaches.assessment.isMarkShownToRole(user.role)
        %}
        <dt class="fullwidth">
            Approaches to Learning
            <div class="description-link">[<a href="/homepage/3462">Grade Description</a>]</div>
        </dt>
        <dd class="fullwidth">
            <table class="learning-approaches">
            {% for criterion in report.subjectReport.namedGrades.learningApproaches.rubric.criteria %}
                <tr>
                    <td>{{ criterion.label }}:</td>
                    <td><strong>{{ criterion.results[criterion.value] }}</strong></td>
                </tr>
            {% endfor %}
            </table>
        </dd>
        {% endif %}
    </dl>

    {% if report.subjectReport.grades %}
        {%
            include '@customMeridenPastoral/sub/assessments.twig'
            with {work: report.subjectReport.grades, student: report.student}
        %}
    {% endif %}
</div>
