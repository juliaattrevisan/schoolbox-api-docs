<script type="text/javascript">
    (function($){
        $(function(){
            // Jump menu for changing semester
            $('#context-selector-semester, #context-selector-enrolled-subjects').on('change', function() {
                window.location.href = this.value;
            });
        })
    })(jQuery);
</script>
<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts-more.js"></script>

<div id="subject-report" class="e-report">
    <div class="row">
        <div class="small-12 columns">
            <div class="meriden-crest">
                {% include '@customMeridenPastoral/sub/crestSvg.twig' %}
            </div>
        </div>
    </div>

    <div class="row" id="context">
        {% include '@customMeridenPastoral/sub/context.twig' with {report: report} %}
    </div>

    {# course description #}
    <div class="row" id="course-description">
        <div class="small-12 column">
            <h2>Course Description</h2>
            <section>
                <article class="content" id="course-description">
                    <p>{{ report.subjectReport.description }}</p>
                </article>
            </section>
        </div>
    </div>

    {# course grade - derived from grade for this class #}
    {% if report.subjectReport.namedGrades.courseGrade and report.subjectReport.namedGrades.courseGrade.assessment.isFeedbackVisibleToUser(USER) %}
        <div class="row" id="course-info">
            <div class="small-6 medium-3 column">
                <dl>
                    <dt>Course {{ locale.grades.proper }}</dt>
                    <dd class="explanation hide-for-print"><a href="/homepage/3403">[{{ locale.grades.proper }} Description]</a></dd>
                </dl>
            </div>
            <div class="small-6 medium-9 column">
                <div class="content">
                    <p><strong>{{ report.subjectReport.namedGrades.courseGrade.pretty_mark }}</strong></p>
                </div>
            </div>
        </div>

        <div class="row" id="grade-distribution">
            <div class="small-12 column">
                <dl class="small-gap">
                    <dt>{{ locale.grades.proper }} Distribution</dt>
                </dl>
            </div>
            <div class="small-12 column">
                <table class="width-auto bordered-table">
                    <thead>
                    <tr>
                        {% for gradeLevel,_ in report.subjectReport.namedGrades.courseGrade.distribution.grouped %}
                            <th>{{ gradeLevel }}</th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        {% for _,results in report.subjectReport.namedGrades.courseGrade.distribution.grouped %}
                            <td>{{ results|length }}</td>
                        {% endfor %}
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {# Endeavor Grades - complicated enough to be its own template #}
    {% include '@customMeridenPastoral/sub/endeavourGrades.twig' %}

    {# Approaches to learning - another rubric #}
    {% if report.subjectReport.namedGrades.learningApproaches and report.subjectReport.namedGrades.learningApproaches.assessment.isFeedbackVisibleToUser(USER) %}
        <div class="row" id="learning-approaches">
            <div class="small-12 column">
                <dl class="small-gap">
                    <dt>Approaches to Learning</dt>
                    <dd class="explanation hide-for-print"><a href="/homepage/3462">[{{ locale.grades.proper }} Description]</a></dd>
                </dl>
            </div>
            <div class="small-12 column">
                {% include '@customMeridenPastoral/sub/assessmentResult.twig' with {grade: report.subjectReport.namedGrades.learningApproaches} %}
            </div>
        </div>
    {% endif %}

    {# Assessments #}
    {% if report.subjectReport.grades %}
        {% include '@customMeridenPastoral/sub/assessments.twig' with {work: report.subjectReport.grades, student: report.student} %}
    {% endif %}

    {# Class Teacher(s) #}
    {% if report.subjectReport.teachers is not empty %}
        <div class="row teacher-list" id="course-teacher">
            <div class="small-12 column">
                <section>
                    {% for teacher in report.subjectReport.teachers %}
                        <div class="small-12 card">
                            <img class="teacher-image" src="/portrait.php?userId={{ teacher.externalId }}&amp;size=square64" alt="{{ teacher.formatName }}">
                            <p class="teacher-name">{{ teacher.formatName }}</p>
                        </div>
                    {% endfor %}
                </section>
            </div>
        </div>
    {% endif %}
</div>
