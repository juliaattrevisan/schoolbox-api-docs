{##
 # Contents of the eReport lateral learning report page.
 #
 # Parameters:
 # * report.student:       the student whose report this is
 # * report.subjectList:   the list of the student's subjects
 # * report.subjectReport: the subject report for this student
 # * showSubjectSelector:  is the subject selector shown?
#}
<div class="row">
    <div class="small-12 columns">
        <div class="meriden-crest">
            {% include '@customMeridenPastoral/sub/crestSvg.twig' %}
        </div>
    </div>
</div>

<div class="row" id="context">
    {% include '@customMeridenPastoral/sub/context.twig' with {report: report, showSubjectSelector: showSubjectSelector ?? true} %}
</div>

{# course description #}
<div class="row" id="course-description">
    <div class="small-12 column">
        <h2>Course Description</h2>
        <section>
            <article class="content" id="course-description">
                <p>{{ report.subjectReport.description }}</p>
            </article>
        </section>
    </div>
</div>

{# Lateral Learning - a rubric rendered somehow #}
<div class="row">
    <h2 class="subheader">Lateral Learning</h2>
</div>
{#
{% if report.subjectReport.namedGrades.learningApproaches %}
    <div class="row" id="learning-approaches">
        <div class="small-12 column">
            <dl class="small-gap">
                <dt>Approaches to Learning</dt>
                <dd class="explanation hide-for-print"><a href="/homepage/3462">[{{ locale.grades.proper }} Description]</a></dd>
            </dl>
        </div>
        <div class="small-12 column">
            {% include '@customMeridenPastoral/sub/assessmentResult.twig' with {grade: report.subjectReport.namedGrades.learningApproaches} %}
        </div>
    </div>
{% endif %}
#}

{# Class Teacher(s) #}
{% if report.subjectReport.teachers is not empty %}
    <div class="row teacher-list" id="course-teacher">
        <div class="small-12 column">
            <section>
                {% for teacher in report.subjectReport.teachers %}
                    <div class="small-12 card">
                        <img class="teacher-image" src="/portrait.php?userId={{ teacher.externalId }}&amp;size=square64" alt="{{ teacher.formatName }}">
                        <p class="teacher-name">{{ teacher.formatName }}</p>
                    </div>
                {% endfor %}
            </section>
        </div>
    </div>
{% endif %}
