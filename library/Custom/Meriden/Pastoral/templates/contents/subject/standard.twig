{##
 # Contents of the eReport subject page.
 #
 # Parameters:
 # * report.student:       the student whose report this is
 # * report.subjectList:   the list of the student's subjects
 # * report.subjectReport: the subject report for this student
 # * showSubjectSelector:  is the subject selector shown?
#}
{% extends '@customMeridenPastoral/contents/base.twig' %}

{% block contents %}
    {% include '@customMeridenPastoral/subTemplates/courseDescription.twig' with {description: report.subjectReport.description} only %}

    {# course grade - derived from grade for this class #}
    {% if report.subjectReport.namedGrades.courseGrade %}
        <div class="row" id="course-info">
            <div class="small-6 medium-3 column">
                <dl>
                    <dt>Course {{ locale.grades.proper }}</dt>
                    <dd class="explanation hide-for-print"><a href="/homepage/3403">[{{ locale.grades.proper }} Description]</a></dd>
                </dl>
            </div>
            <div class="small-6 medium-9 column">
                <div class="content">
                    <p><strong>{{ report.subjectReport.namedGrades.courseGrade.pretty_mark }}</strong></p>
                </div>
            </div>
        </div>
    {% endif %}

    {# Grade distribution, endeavour grades, approaches to learning #}
    <div class="row">
        <div class="small-12 medium-6 column">
            {# Grade distribution: show collated grades for all students #}
            {% if report.subjectReport.namedGrades.courseGrade %}
                <div class="row" id="grade-distribution">
                    <div class="small-12 column">
                        <dl class="small-gap">
                            <dt>{{ locale.grades.proper }} Distribution</dt>
                        </dl>
                    </div>
                    <div class="small-12 column">
                        <table class="width-auto bordered-table">
                            <thead>
                            <tr>
                                {% for gradeLevel,_ in report.subjectReport.namedGrades.courseGrade.distribution.grouped %}
                                    <th>{{ gradeLevel }}</th>
                                {% endfor %}
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                {% for _,results in report.subjectReport.namedGrades.courseGrade.distribution.grouped %}
                                    <td>{{ results|length }}</td>
                                {% endfor %}
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

            {# Endeavor Grades - complicated enough to be its own template #}
            {% include '@customMeridenPastoral/subTemplates/endeavourGrades.twig' %}
        </div>

        <div class="small-12 medium-6 column">
            {# Approaches to learning - another rubric #}
            {% if report.subjectReport.namedGrades.learningApproaches %}
                <div class="row" id="learning-approaches">
                    <div class="small-12 column">
                        <dl class="small-gap">
                            <dt>Approaches to Learning</dt>
                            <dd class="explanation hide-for-print"><a href="/homepage/3462">[{{ locale.grades.proper }} Description]</a></dd>
                        </dl>
                    </div>
                    <div class="small-12 column">
                        {% include '@customMeridenPastoral/subTemplates/assessmentResult.twig' with {grade: report.subjectReport.namedGrades.learningApproaches} %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    {# Assessments #}
    {% if report.subjectReport.grades %}
        {% include '@customMeridenPastoral/subTemplates/assessments.twig' with {work: report.subjectReport.grades, student: report.student, graphWidth: graphWidth} %}
    {% endif %}
{% endblock contents %}

{% block footer %}
    {% include '@customMeridenPastoral/subTemplates/classTeachers.twig' with {teachers: report.subjectReport.teachers} only %}
{% endblock footer %}
