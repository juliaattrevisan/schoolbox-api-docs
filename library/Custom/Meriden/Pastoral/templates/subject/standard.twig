<script type="text/javascript">
    (function($){
        $(function(){
            // Jump menu for changing semester
            $('#context-selector-semester, #context-selector-enrolled-subjects').on('change', function() {
                window.location.href = this.value;
            });
        })
    })(jQuery);
</script>

{# The printable report has already loaded Highcharts: don't load it again #}
{% if reloadHighcharts ?? true %}
    {% include '@customMeridenPastoral/subTemplates/loadHighcharts.twig' %}
{% endif %}

<div id="subject-report" class="e-report">
    {% include '@customMeridenPastoral/contents/subject/standard.twig' with {
        report:              report,
        showSubjectSelector: true,
        graphWidth:          graphWidth,
    } only %}
</div>
