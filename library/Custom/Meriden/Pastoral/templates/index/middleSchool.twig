<script type="text/javascript">
    (function($){
        $(function(){
            // Jump menu for changing semester
            $('#context-selector-semester, #context-selector-enrolled-subjects').on('change', function() {
                window.location.href = this.value;
            });
        })
    })(jQuery);
</script>

<div id="pastoral-report" class="e-report">
    {% include '@customMeridenPastoral/contents/index/middleSchool.twig' with {
        report:              report,
        showSubjectSelector: true,
    } only %}
</div>

{# Printable report: hardcode a graph width of 450 if none is set #}
<a href="{{ routeLookup('customMeridenPastoral.printableReport', {year: report.year, id: report.student.id}) }}?graph-width={{ graphWidth ?? 450 }}"
   target="_blank"
   class="button full-width">Print full report</a>
