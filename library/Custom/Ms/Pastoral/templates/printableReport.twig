{% include '@customMeridenPastoral/subTemplates/loadHighcharts.twig' %}
<script type="text/javascript">
    // Print slightly after load (so that the highcharts can load)
    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(window.print, 100);
    });
</script>

<div id="printable-report" class="e-report">
    {% include baseReport.template
        with baseReport | merge({showSubjectSelector: false})
        only
    %}
    <div class="row" style="break-after: page"></div>

    {% for subjectReport in subjectReports %}
        {% include subjectReport.template
            with subjectReport | merge({showSubjectSelector: false, reloadHighcharts: false})
            only
        %}
        <div class="row" style="break-after: page"></div>
    {% endfor %}
</div>

{# Hack in the pdf export CSS #}
<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/ms/pdfExport.css?v={{ config.site_version }}" />
