{% for classCode, subjectData in subjects %}
    <div class="row">
        <div class="small-12 island">
            <section class="type-blue content">
                <strong>{{ headings[classCode].subjectName }}</strong>
                <p class="meta">
                    <a href="mailto:{{ headings[classCode].staffEmail }}">{{ headings[classCode].staffName }}</a>
                </p>
            </section>
        </div>
    </div>
    <div class="row">
        <div class="small-12 island">
            <section class="content">
                <p>{{ subjectData.overview }}</p>
            </section>
        </div>
    </div>
    <div class="row">
        <div class="small-12 island">
            <section>
                <table>
                    <thead>
                    <tr>
                        <th class="fixed"></th>
                        {% for shortHeading in headings[classCode].shortHeadings %}
                            <th class="centered fixed">{{ shortHeading }}</th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for topicHeading in headings[classCode].topicHeadings %}
                        <tr>
                            <th>{{ topicHeading }}</th>
                            {% for shortCode, shortHeading in headings[classCode].shortHeadings %}
                                <td class="centered">{{ subjectData.topics[topicHeading][shortCode] ?? '' }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    <tr>
                        <td colspan="{{ (headings[classCode].shortHeadings | length) + 1 }}" class="spacer"></td>
                    </tr>
                    <tr>
                        <th>Interim Achievement Level</th>
                        {% for shortCode, shortHeading in headings[classCode].shortHeadings %}
                            <td class="centered">{{ grades[classCode][2][shortCode]['AssessResultsResult'] ?? '' }}</td>
                        {% endfor %}
                    </tr>
                    <tr>
                        <td colspan="{{ (headings[classCode].shortHeadings | length) + 1 }}" class="spacer"></td>
                    </tr>
                    <tr>
                        <th>Final Achievement Level</th>
                        {% for shortCode, shortHeading in headings[classCode].shortHeadings %}
                            <td class="centered">{{ grades[classCode][4][shortCode]['AssessResultsResult'] ?? '' }}</td>
                        {% endfor %}
                    </tr>
                    </tbody>
                </table>
            </section>
        </div>
    </div>
    <div class="row">
        <div class="small-12 island">
            <section class="content">
                <p class="subheading">Comments</p>
                {% for comment in subjectData.comments ?? [] %}
                <p>{{ comment.comment }}
                    {% if comment.comment is not empty and comment.staffName is not empty %}
                        &mdash; <a href="mailto:{{ comment.staffEmail }}">{{ comment.staffName }}</a>
                    {% endif %}
                </p>
                {% endfor %}
            </section>
        </div>
    </div>
{% endfor %}
