{# #
 # MYP tab
 #
 # @param array navigation
#}
{% include '@achievementreport/Avatar.twig' %}

{% include '@achievementreport/Navigation.twig' with {
    elements: navigation
} %}
<div class="row achievement-report myp">
    <div class="row">
        <div class="small-12 columns">
            <ul id="year-links" class="sub-nav">
                {% for year, data in dataByYear %}
                    <li data-year id="data-{{ year }}"{% if year == selectedYear %} class="active"{% endif %}>
                        <a>{{ year }}</a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% for year, data in dataByYear %}
        <div data-result id="data-{{ year }}-result" class="hide">
            {% include '@myp/result.twig' with {subjects: data.subjects, grades: data.grades, headings: data.headings} %}
        </div>
    {% endfor %}
    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">Further Information</h2>
            <section class="content">
                {{ (config.dio_achievement_report_myp_footer ?? '')|purify }}
            </section>
        </div>
    </div>
</div>
<script>
    $('#year-links').on('click', '[data-year]', function () {
        $('[data-year]').removeClass('active');
        $('[data-result]').addClass('hide');
        $(this).addClass('active');
        let name = $(this).attr('id');
        $('#' + name + '-result').removeClass('hide');
    })
</script>
