{##
 # Numeracy Graph
 #
 # @param array numeracy
 #}
<script>
    $(function () {
        var chart = new Highcharts.Chart({
            chart: {
                height: 720,
                reflow: true,
                renderTo: 'numeracy',
                spacingBottom: 30
            },
            credits: {
                enabled: false
            },
            legend: {
                enabled: true
            },
            plotOptions: {
                area: {
                    fillOpacity: 0.2
                }
            },
            series: [

                {# First set of grey squares #}
                {
                    data: [{{ numeracy.data.series.grey1|join(',') }}],
                    enableMouseTracking: false,
                    marker: {
                        radius: 13,
                        fillColor: '#cccccc',
                        symbol: 'square'
                    },
                    showInLegend: false,
                    states: {
                        inactive: {
                            opacity: 1.0
                        }
                    },
                    type: 'scatter',
                    yAxis: 1
                },

                {# Second set of grey squares #}
                {
                    data: [{{ numeracy.data.series.grey2|join(',') }}],
                    enableMouseTracking: false,
                    marker: {
                        radius: 13,
                        fillColor: '#cccccc',
                        symbol: 'square'
                    },
                    showInLegend: false,
                    states: {
                        inactive: {
                            opacity: 1.0
                        }
                    },
                    type: 'scatter',
                    yAxis: 1
                },

                {# Third set of grey squares #}
                {
                    data: [{{ numeracy.data.series.grey3|join(',') }}],
                    enableMouseTracking: false,
                    marker: {
                        radius: 13,
                        fillColor: '#cccccc',
                        symbol: 'square'
                    },
                    showInLegend: false,
                    states: {
                        inactive: {
                            opacity: 1.0
                        }
                    },
                    type: 'scatter',
                    yAxis: 1
                },

                {# Fourth set of grey squares #}
                {
                    data: [{{ numeracy.data.series.grey4|join(',') }}],
                    enableMouseTracking: false,
                    marker: {
                        radius: 13,
                        fillColor: '#cccccc',
                        symbol: 'square'
                    },
                    showInLegend: false,
                    states: {
                        inactive: {
                            opacity: 1.0
                        }
                    },
                    type: 'scatter',
                    yAxis: 1
                },

                {# Student Data: Red (Number & Algebra) #}
                {
                    data: [{{ numeracy.data.series.red|join(',') }}],
                    enableMouseTracking: false,
                    marker: {
                        symbol: 'url(/static/custom/dsfg/achievementreport/img/star-red.png)'
                    },
                    name: 'Number & Algebra',
                    states: {
                        inactive: {
                            opacity: 1.0
                        }
                    },
                    type: 'scatter',
                },

                {# Student Data: Blue (Geometry & Measure) #}
                {
                    data: [{{ numeracy.data.series.blue|join(',') }}],
                    enableMouseTracking: false,
                    marker: {
                        symbol: 'url(/static/custom/dsfg/achievementreport/img/star-blue.png)'
                    },
                    name: 'Geometry & Measure',
                    states: {
                        inactive: {
                            opacity: 1.0
                        }
                    },
                    type: 'scatter',
                },

                {# Student Data: Green (Statistics & Probability) #}
                {
                    data: [{{ numeracy.data.series.green|join(',') }}],
                    enableMouseTracking: false,
                    marker: {
                        symbol: 'url(/static/custom/dsfg/achievementreport/img/star-green.png)'
                    },
                    name: 'Statistics & Probability',
                    states: {
                        inactive: {
                            opacity: 1.0
                        }
                    },
                    type: 'scatter',
                }
            ],
            title: {
                text: 'Maths'
            },
            tooltip: {
                enabled: false,
            },
            xAxis: {
                categories: {{ numeracy.data.x.categories|json_encode|purify }},
                gridLineWidth: 1,
                title: {
                    text: 'Time at school',
                    y: 10
                }
            },
            yAxis: [
                {
                    categories: {{ numeracy.data.y.stages|json_encode|purify }},
                    max: {{ numeracy.data.y.stages|length - 1}},
                    min: 1,
                    title: {
                        text: ''
                    }
                },
                {
                    categories: {{ numeracy.data.y.levelGroups|json_encode|purify }},
                    gridLineWidth: 0,
                    labels: {
                        x: -100,
                        y: 34
                    },
                    max: {{ numeracy.data.y.levelGroups|length - 1}},
                    min: 1,
                    offset: 0,
                    startOnTick: false,
                    tickColor: '#dddddd',
                    tickLength: 150,
                    tickmarkPlacement: 'between',
                    tickPositions: {{ range(3, numeracy.data.y.levelGroups|length - 1, 3)|json_encode }},
                    tickWidth: 1,
                    title: {
                        text: ''
                    }
                }
            ],
        });

        chart.reflow();
    });
</script>
<div id="numeracy"></div>
