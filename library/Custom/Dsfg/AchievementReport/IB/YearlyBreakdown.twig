{##
 # Yearly Breakdown
 # A list of all the subjects, their assessments, results and comments
 #
 # @param array yearlyBreakdown
 # @param int   year
 #}
{% import '@achievementreport/macro.twig' as macro %}

<div class="row">
    <div class="small-12 island">
        <section class="content generic-heading-highlight no-margin">
            IB Summary for {{ year }}
        </section>
    </div>
</div>

{% for courseName, courseData in yearlyBreakdown.data %}
<div class="row">
    <div class="small-12 island">
        <section class="content no-margin">
            <p class="subheading">{{ courseName }}</p>
            <p class="meta">{{ macro.renderTeachers(courseData.teachers) }}</p>
        </section>
    </div>
</div>
<div class="row">
    <div class="small-12 columns sequential-table">
        <div class="scrollable">
            <table>
                <tbody>
                    {% if courseData.assessments|length %}
                        <tr>
                            <td class="subheading">Assessment</td>
                            <td class="subheading result">Result</td>
                        </tr>

                        {% for assessment, result in courseData.assessments %}
                            <tr>
                                <td>{{ assessment }}</td>
                                <td class="result">{{ result }}</td>
                            </tr>
                        {% endfor %}
                    {% endif %}

                    {# Find out if the Comments section should show
                     # Inspect each term's contents
                     #}
                    {% set hasComments = false %}
                    {% for term in yearlyBreakdown.terms|keys %}
                        {% if courseData.comments[term]|length %}
                            {% set hasComments = true %}
                        {% endif %}
                    {% endfor %}

                    {% if hasComments %}
                    <tr>
                        <td colspan="2">
                            <p class="subheading">Comments</p>

                            {% for term in yearlyBreakdown.terms|keys %}
                                {% if courseData.comments[term]|length %}
                                    <p>Term {{ term }} - {{ courseData.comments[term] }} &mdash; {{ macro.renderTeachers(courseData.teachers) }}</p>
                                {% endif %}
                            {% endfor %}
                        </td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endfor %}
