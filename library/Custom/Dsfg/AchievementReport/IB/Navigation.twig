{##
 # IB Navigation
 #
 # A series of tabs that link to places that contain data
 #
 # @param array navigation
 # @param array externalUser
 #}
{% if navigation.all|length > 0 %}
    <div class="row">
        <div class="small-12 columns">
            <h2 class="subheader">IB Summary By Year</h2>
            <section>
                <ul class="sub-nav">
                    {% for year in navigation.all %}
                        <li {% if year == navigation.selected %}class="active"{% endif %}>

                            {# Provide button only if you can get there
                             # Other places hardcode this url, but we can do it properly here
                             #}
                            {% set ibRoute = routeLookupIfAuthorized('achievementreport.getIb', {
                                externalUserId: externalUser.StudentID,
                                year: year
                            }) %}

                            {% if ibRoute %}
                                <a href="{{ ibRoute }}">{{ year }}</a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endif %}