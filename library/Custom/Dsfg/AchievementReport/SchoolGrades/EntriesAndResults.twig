{##
 #SchoolGrades Entries And Results
 #
 # @param int year
 # @param array entriesAndResults
 #}
{% import '@achievementreport/macro.twig' as macro %}

<div class="row">
    <div class="small-12 island">
        <section class="content generic-heading-highlight no-margin">
            {{ entriesAndResults.heading }} {{ year }}
        </section>
    </div>
</div>

<div class="scrollable">
    <table>
        <tbody>
            {% for courseName, areaData in entriesAndResults.data[year] %}
                <tr>
                    <td class="subheading">
                        {{ courseName }}

                        {% if areaData.allTeachers|length %}
                        <p class="meta">
                            {% for currentTeacherName, currentTeacherEmail in areaData.allTeachers %}{% if currentTeacherEmail != '' %}<a href='mailto:{{ currentTeacherEmail }}'>{{ currentTeacherName }}</a>{% else %}{{ currentTeacherName }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
                        </p>
                        {% endif %}
                    </td>
                    <td class="subheading">Result</td>
                </tr>
                {#
                    Hide subjects with no term4 and no term2 values only
                    for previous years - this indicates students didn't
                    get round to doing the subject properly and thus the
                    entire thing should be ignored
                #}
                {% for currentArea, values in areaData.allAreas %}
                {% if year == entriesAndResults.currentYear %}
                <tr>
                    <td>{{ currentArea }}</td>
                    <td>
                        {% set letter = '' %}

                        {% for i in ['term1', 'term2', 'term3', 'term4'] %}
                            {% if values.letters[i] != '' %}
                                {% set letter = values.letters[i] %}
                            {% endif %}
                        {% endfor %}

                        {{ letter }}
                    </td>
                </tr>
                {% else %}

                    {# Hide course areas that did not get a mark, in a previous year
                     # Not sure if they still want to do this, though
                     #}
                    {% set letter = '' %}

                    {% for i in ['term1', 'term2', 'term3', 'term4'] %}
                        {% if values.letters[i] != '' %}
                            {% set letter = values.letters[i] %}
                        {% endif %}
                    {% endfor %}

                    {% if letter|length %}
                    <tr>
                        <td>{{ currentArea }}</td>
                        <td>{{ letter }}</td>
                    </tr>
                    {% endif %}
                {% endif %}
                {% endfor %}

                {# Comments
                 # A list of comments per subject, ordered by Term
                 # Only show this section if there are comments to display
                 #}
                {% if areaData.comments|length %}
                    <tr>
                        <td colspan="6">
                            <p class="subheading">Comments</p>

                            {% for term, commentData in areaData.comments %}
                                {% if commentData.comment|length %}
                                <p>
                                    Term {{ term }} - {{ commentData.comment }}&mdash;
                                    {{ macro.renderTeachers(commentData.teachers) }}
                                </p>
                                {% endif %}
                            {% endfor %}
                        </td>
                    </tr>
                {% endif %}

                {# Spacer row between subjects in this year
                 # ...because padding
                 #}
                {% if not loop.last %}
                <tr class="spacer">
                    <td colspan="2"></td>
                </tr>
                {% endif %}
        {% endfor %}
        </tbody>
    </table>
</div>
