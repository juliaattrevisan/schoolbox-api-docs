<script type="text/javascript">
    $(function() {
        $('[data-graph="total-achieved-credits-{{ dataset.suffix }}"]').ncea_stackedBar({
            title: 'Total Achieved Credits',

            colors: ['#C0C0C0', '#001933'],

            categories: [
                {% for currentLevel, allLevelValues in dataset.data.graph.totalAchievedCredits %}
                '{{ currentLevel }}'{% if not loop.last %}, {% endif %}
                {% endfor %}
            ],

            series: [
                {
                    name: 'Total Achieved',
                    data: [
                        {% for currentLevel, allLevelValues in dataset.data.graph.totalAchievedCredits %}
                        {{ allLevelValues.achieved }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                },
                {
                    name: 'Total Available',
                    data: [
                        {% for currentLevel, allLevelValues in dataset.data.graph.totalAchievedCredits %}
                        {{ allLevelValues.available }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                }
            ]
        });
    });
</script>
<div data-graph="total-achieved-credits-{{ dataset.suffix }}"></div>
