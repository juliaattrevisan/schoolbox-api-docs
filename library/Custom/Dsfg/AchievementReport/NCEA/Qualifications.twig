{% if qualifications.data.num > 0 %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Qualifications</h2>

        <section>
            <ul class="information-list no-margin">
                {% for level, displayText in qualifications.data.qualifications %}
                    {% if displayText|length > 0 %}
                    <li>
                        <div class="list-item">
                            <div class="compact card small-12">
                                <div class="icon-approve"></div>
                                <p> {{ displayText }}</p>
                            </div>
                        </div>
                    </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </section>
    </div>
</div>
{% endif %}