{% if literacyNumeracyCheckbox.data|length %}
<style>
.subheader-suffix {
    text-transform: none;
}
</style>
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ literacyNumeracyCheckbox.heading }} <span class="subheader-suffix">{{ literacyNumeracyCheckbox.headingSuffix }}</span></h2>
        <section>
            <ul class="information-list">
                {% for checkboxName, selected in literacyNumeracyCheckbox.data %}
                <li>
                    <div class="list-item">
                        <div class="compact card small-12">
                            {% if selected > 0 %}
                            <div class="icon-approve"></div>
                            {% endif %}
                            <p> {{ checkboxName }}</p>
                        </div>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </section>
    </div>
</div>
{% endif %}
