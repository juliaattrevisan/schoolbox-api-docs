<div class="row">
    <div class="small-12 island">
        <section class="content generic-heading-highlight no-margin">
            Course Credit Summary {{ year }}
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 columns sequential-table">
        <div class="scrollable">
            <table>
                <thead>
                <tr>
                    <th>Course</th>
                    <th class="numeric">Entered Credits</th>
                    {% for currentLetter in courseCreditSummary.allLetters %}
                        <th class="numeric">{{ currentLetter }}</th>
                    {% endfor %}
                    <th class="numeric">Achieved</th>
                    <th class="numeric">Attempted</th>
                    <th>Endorsement Status</th>
                </tr>
                </thead>
                <tbody>
                {% for courseName, allValues in courseCreditSummary.data.courses %}
                    <tr>
                        <td>{{ courseName }}</td>
                        <td class="numeric">{{ allValues.enteredCredits }}</td>
                        {% for currentLetter in courseCreditSummary.allLetters %}
                            <td class="numeric">{{ allValues.letters[currentLetter] }}</td>
                        {% endfor %}
                        <td class="numeric">{{ allValues.achieved }}</td>
                        <td class="numeric">{{ allValues.attempted }}</td>
                        <td>{{ allValues.endorsement }}</td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                <tr class="totals">
                    <td></td>
                    <td class="numeric">{{ courseCreditSummary.data.totals.enteredCredits }}</td>
                    {% for currentLetter in courseCreditSummary.allLetters %}
                        <td class="numeric">{{ courseCreditSummary.data.totals.letters[currentLetter] }}</td>
                    {% endfor %}
                    <td class="numeric">{{ courseCreditSummary.data.totals.achieved }}</td>
                    <td class="numeric">{{ courseCreditSummary.data.totals.attempted }}</td>
                    <td></td>
                </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
