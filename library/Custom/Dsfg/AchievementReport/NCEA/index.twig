<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/highcharts.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/custom/dsfg/achievementreport/js/ncea/stackedBar.js?v={{ config.site_version }}"></script>

{% include '@achievementreport/Avatar.twig' %}

{% include '@achievementreport/Navigation.twig' with {
    elements: navigation
} %}

<div class="row">
    <div class="small-12 columns achievement-report ncea">
        {% include '@ncea/LiteracyNumeracyCheckbox.twig' %}
        {% include '@ncea/Qualifications.twig' %}
        {% include '@ncea/CreditSummary.twig' %}
        {% include '@ncea/CreditSummaryGraphs.twig' with {dataset: creditSummary} %}

        {% include '@ncea/CourseCreditSummaryNavigation.twig' %}

        {% if year > 0 %}
            {% include '@ncea/CreditSummaryGraphs.twig' with {dataset: creditSummaryYear} %}
            {% include '@ncea/CourseCreditSummary.twig' %}
            {% include '@ncea/EntriesAndResults.twig' %}
        {% endif %}

        {% include '@ncea/Footer.twig' %}
    </div>
</div>
