{##
 # Comments Navigation
 #
 # A series of tabs that link to places that contain data
 #
 # @param array commentsNavigation
 # @param array externalUser
 #}
{% if commentsNavigation.all|length > 0 %}
    <div class="row">
        <div class="small-12 columns">
            <h2 id="comments-summary" class="subheader">Comments Summary</h2>
            <section>
                <ul class="sub-nav">
                    {% for year in commentsNavigation.all %}
                        <li {% if year == commentsNavigation.selected %}class="active"{% endif %}>

                            {# Provide button only if you can get there
                             # Other places hardcode this url, but we can do it properly here
                             #}
                            {% set commentsRoute = routeLookupIfAuthorized('achievementreport.getComments', {
                                externalUserId: externalUser.StudentID,
                                year: year
                            }) %}

                            {% if commentsRoute %}
                            <a href="{{ commentsRoute }}#comments-summary">{{ year }}</a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endif %}