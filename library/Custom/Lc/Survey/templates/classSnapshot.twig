{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
[ folder.name,                   '/homepage/' ~ folder.id ],
[ 'Classroom Learning Snapshot', '#' ],
[ pageTitle ]
) }}

<div class="row">
    <div class="small-12 island">
        <h1>Classroom Learning Snapshot</h1>

        {% if surveys | length %}
            <h2 class="subheader">Select Snapshot To Download</h2>

            <section>
                <ul class="information-list">
                    {% for survey in surveys %}
                    <li>
                        <div class="card small-12">
                            <h3>
                                <a href="{{ routeLookup('surveySnapshot.getClassSnapshot', {folderId: folder.id, surveyId: survey.id}) }}">
                                    {% if survey.assessment.title is not empty %}
                                        {{ survey.assessment.title }} -
                                    {% endif %}
                                    {{ survey.title }}
                                </a>
                            </h3>
                            <p class="meta">
                                <a href="/homepage/{{ survey.folder.id }}" title="{{ survey.folder.title }}">{{ survey.folder.title }}</a><br />
                                Due <time datetime="{{ survey.finish }}">{{ survey.finish.short|replace({'11:59pm': ''}) }}</time>
                            </p>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-report"></i>
                <p>No snapshots available!</p>
                <p>Students enrolled in {{ folder.name }} must have attempted one or more surveys</p>
            </div>
        {% endif %}
    </div>
</div>
