<style type="text/css" media="screen">
    span.disclaimer {
        font-weight: bold;
        text-decoration: underline;
    }

    th, td {
        border: 1px solid #000 !important;
    }

    .center {
        text-align: center;
    }

    td span {
        font-weight: bold;
    }

    td.total {
        background-color: #ededed;
        font-weight: bold;
    }
</style>
<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<script type="text/javascript" src="/custom/stk/ncea/js/stackedBar.js"></script>

<script type="text/javascript">
    $(function() {
        $('#graph').ncea_stackedBar({
            title: 'Running Total of Credits to Date',

            colors: ['#4394FF', '#FFB37C', '#409F40'],

            categories: [
                {% for currentLevel, allLevelValues in dataset.data.graph.result %}
                '{{ currentLevel }}'{% if not loop.last %}, {% endif %}
                {% endfor %}
            ],

            series: [
                {
                    name: 'Achieved',
                    data: [
                        {% for currentLevel, allLevelValues in dataset.data.graph.result %}
                        {{ allLevelValues.A }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                },
                {
                    name: 'Merit',
                    data: [
                        {% for currentLevel, allLevelValues in dataset.data.graph.result %}
                        {{ allLevelValues.M }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                },
                {
                    name: 'Excellence',
                    data: [
                        {% for currentLevel, allLevelValues in dataset.data.graph.result %}
                        {{ allLevelValues.E }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    ]
                }
            ]
        });
    });
</script>
<div data-graph="result-{{ dataset.suffix }}"></div>

<div class="row">
    <div class="small-12 island">
        <h1>Summary of Progress towards NCEA for {{ currentYear }}</h1>
        <h2>
            Student Name: {{ user.lastname }}, {{ user.firstname }}<br />
            Tutor Group: {{ studentTutor }}
        </h2>

        <section class="content">
            <div id="graph"></div>

            <p>
                {{ user.firstname }} is enrolled in the standards below.
                Only <u>final</u> results are shown, practice and interim results are excluded.
            </p>
        </section>

        <table>
            <thead>
                <tr>
                    <th rowspan="2">Course</th>
                    <th rowspan="2" class="center">Standard Number</th>
                    <th rowspan="2" class="center">Level</th>
                    <th rowspan="2" class="center">Credit Value</th>
                    <th rowspan="2" class="center">Internal or External</th>
                    <th rowspan="2" class="center">Grade</th>
                    <th colspan="3" class="center">Total Credits Gained</th>
                </tr>
                <tr>
                    <th class="center">L1</th>
                    <th class="center">L2</th>
                    <th class="center">L3</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>13 English Visual</td>
                    <td class="center">91473</td>
                    <td class="center">3</td>
                    <td class="center">4</td>
                    <td class="center">External</td>
                    <td class="center">A</td>
                    <td class="center">1</td>
                    <td class="center">2</td>
                    <td class="center">3</td>
                </tr>
                <tr>
                    <td colspan="3"><span>Available Credits:</span></td>
                    <td class="center"><span>15</span></td>
                    <td colspan="2"><span>Gained Credits:</span></td>
                    <td class="center"></td>
                    <td class="center"></td>
                    <td class="center"><span>11</span></td>
                </tr>
                <tr>
                    <td colspan="6"><span>Credits Gained This Year</span></td>
                    <td class="total center"></td>
                    <td class="total center"></td>
                    <td class="total center">58</td>
                </tr>
                <tr>
                    <td colspan="6"><span>Credits Brought Forward From Previous Years</span></td>
                    <td class="total center">178</td>
                    <td class="total center">94</td>
                    <td class="total center"></td>
                </tr>
                <tr>
                    <td colspan="6"><span>Current Grand Total of Credits</span></td>
                    <td class="total center">178</td>
                    <td class="total center">94</td>
                    <td class="total center">58</td>
                </tr>
            </tbody>
        </table>

        <section class="content">
            <p>
                <span class="disclaimer">Disclaimer</span>: This report has been generated by the College for the purpose of sharing NCEA assessment
                information with students and parents. The grades shown here are subject to change. It is not an
                official document. Should you wish to obtain an official copy of your child’s NCEA results please
                consult the NZQA website: <a href="http://www.nzqa.govt.nz/login" target="_blank">http://www.nzqa.govt.nz/login</a>
            </p>
        </section>
    </div>
</div>

