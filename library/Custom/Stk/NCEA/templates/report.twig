{% import '@nceaReport/macro.twig' as macro %}

<style type="text/css" media="screen, print">
    #nceaReport span.disclaimer {
        font-weight: bold;
        text-decoration: underline;
    }

    #nceaReport th, td {
        border: 1px solid #000 !important;
    }

    #nceaReport .center {
        text-align: center;
    }

    #nceaReport p.center {
        margin: 0 auto;
    }

    #nceaReport td span {
        font-weight: bold;
    }

    #nceaReport td.total {
        background-color: #ededed;
        font-weight: bold;
    }
</style>

<style type="text/css" media="print">
    h1 {
        margin: 0 !important;
        padding: 0 !important;
    }
</style>

<div data-graph="result-{{ dataset.suffix }}"></div>


<div class="row">
    <div class="small-12 island" id="nceaReport">
        <section class="content">
            <div class="row">
                <div class="small-8 columns">
                    <h1>Summary of Progress towards NCEA for {{ data.meta.year }}</h1>
                    <h2>
                        Student Name: {{ data.meta.fullname ?: user.fullname }}<br />
                        Tutor Group: {{ data.meta.tutorGroup }}
                    </h2>
                </div>
                <div class="small-4 columns text-right">
                    <img src="/images/logo.php?logo=skin_logo_large&size=normal" srcset="/images/logo.php?logo=skin_logo_large&size=normal 1x,/images/logo.php?logo=skin_logo_large&size=hidpi 2x" alt="Saint Kentigern"/>
                </div>
            </div>

            {# Show data, if there is any to display; otherwise "empty state" message #}
            {% if data.records|length %}
                {% include '@nceaReport/data.twig' with {
                    user: user,
                    data: data
                } %}
            {% else %}
                <p>
                    We are still in the process of enrolling {{ user.fullname }} into NCEA standards this year.
                </p>
            {% endif %}

            <p>
                <span class="disclaimer">Disclaimer</span>: This report has been generated by the College for the purpose of sharing NCEA assessment
                information with students and parents. The grades shown here are subject to change. It is not an
                official document. Should you wish to obtain an official copy of your child’s NCEA results please
                consult the NZQA website: <a href="http://www.nzqa.govt.nz/login" target="_blank">http://www.nzqa.govt.nz/login</a>
            </p>
        </section>
    </div>
</div>
