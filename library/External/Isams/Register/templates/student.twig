<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/dataTables.js?v={{ config.site_version }}"></script>
<div class="small-12 island">
    <h2 class="subheader">{{ register.name }}</h2>
        <div class="l-flex-col l-gap-m">
            {% for child in studentData %}
                <div class="l-flex-col">
                    <div class="c-card">
                        <div class="l-flex-row l-gap-m l-pad-m">
                            <div class="c-img c-img--round">
                                <div class="c-img__wrapper">
                                    <img
                                        src="/portrait.php?id={{ child.user.id }}&amp;size=square64"
                                        alt="Photo of {{ child.user.formatName }}"
                                    />
                                </div>
                            </div>
                            <div class="l-flex-col l-flex--justify-center l-flex__item--1 f-no-margins">
                                <h3>{{ child.user.formatName }}</h3>
                            </div>
                        </div>
                    </div>
                    {# Field Group details #}
                    <div class="c-island l-pad-m--horiz scrollable">
                        {% if child.data.FieldGroup is defined %}
                            {% for group in child.data.FieldGroup %}
                                <h2>{{ group.groupName }}</h2>
                                {% if group.data ?? [] is not empty %}
                                    <table>
                                        <colgroup>
                                            {% for numberCol in range(0, 1) %}
                                                <col>
                                            {% endfor %}
                                        </colgroup>
                                        <tbody>
                                        {% for row in group.data %}
                                            {% set rowValue = row.value ?? '' %}
                                            <tr>
                                                <td>{{ row.name }}</td>
                                                <td>
                                                    {% if row.type == 'url' and rowValue %}
                                                        <a href="{{ rowValue }}">{{ rowValue }}</a>
                                                    {% elseif row.type == 'html' %}
                                                        {{ rowValue | purify }}
                                                    {% else %}
                                                        {{ rowValue }}
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                {% else %}
                                    <p><em>No data available.</em></p>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                        {# Record Collection details #}
                        {% set recordCollection = child.data.RecordCollection %}
                        {% if recordCollection is defined %}
                            {% for collection in recordCollection %}
                                <h2>{{ collection.groupName }}</h2>
                                {% if collection.data ?? [] is not empty %}
                                    {% set dateTimeFields = [] %} {# This is used to create a default ordering later on.. #}
                                    <table data-sortable="{{ child.user.id }}-recordCollection">
                                        <thead>
                                        <tr>
                                            {% for key, name in (collection.headers ?? []) %}
                                                <th data-field="{{ key }}">{{ name }}</th>
                                            {% endfor %}
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for record in (collection.data) %}
                                            <tr>
                                                {% for key, field in record %}
                                                    {% set fieldValue = field.value ?? '' %}
                                                    <td
                                                        {% if field.type == 'DateTimeField' %}
                                                            {# Twig can't pass the date value as "DD/MM/YYYY",
                                                             # so we need to convert it to "YYYY-MM-DD" first to do the sorting #}
                                                            {% if fieldValue is not empty %}
                                                                {% set parts = fieldValue|split('/') %}
                                                                {% if parts|length == 3 %}
                                                                    {% set formattedDate = parts[2] ~ '-' ~ parts[1] ~ '-' ~ parts[0] %}
                                                                    data-order="{{ formattedDate|date('U') }}"
                                                                {% endif %}
                                                            {% endif %}

                                                            {# Add the field's index to dateTimeFields if it isn't already there #}
                                                            {% if key not in dateTimeFields %}
                                                                {% set dateTimeFields = dateTimeFields|merge([key]) %}
                                                            {% endif %}
                                                        {% endif %}
                                                    >
                                                        {% if field.type == 'url' and fieldValue %}
                                                            <a href="{{ fieldValue }}">{{ collection.headers[key] }}</a>
                                                        {% elseif field.type == 'html' %}
                                                            {{ fieldValue | purify }}
                                                        {% else %}
                                                            {{ fieldValue }}
                                                        {% endif %}
                                                    </td>
                                                {% endfor %}
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                    <script type="text/javascript">
                                        // Sortable table
                                        $(function () {
                                            $('table[data-sortable="{{ child.user.id }}-recordCollection"]').DataTable({
                                                info: true,
                                                paging: true,
                                                searching: true,
                                                drawCallback: function() {
                                                    {# The most jank workaround, this aligns the datatables pagination buttons to our styles... #}
                                                    $('.dataTables_paginate .paginate_button.previous').text('‹');
                                                    $('.dataTables_paginate .paginate_button').addClass('button');
                                                    $('.dataTables_paginate .ellipsis').addClass('button disabled');
                                                    $('.dataTables_paginate .paginate_button.next').text('›');

                                                    {# Disable the current page button (as it's not a <ul> list so our styles won't work) #}
                                                    $('.dataTables_paginate .paginate_button.current').addClass('disabled');
                                                },
                                                {# order by the dateTimeFields, desc by default
                                                 # technically this limits to only default sorting by date fields, but it's a start.
                                                 # this means the date field can be in any position, rather than just the leftmost column
                                                 #}
                                                {% if dateTimeFields is not empty %}
                                                    order: [
                                                        {% for field in dateTimeFields %}[{{ field }}, 'desc'],{% endfor %}
                                                    ],
                                                {% endif %}
                                            });
                                        });
                                    </script>
                                {% else %}
                                    <p><em>No data available.</em></p>
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            <p><em>No data available.</em></p>
                        {% endif %}
                        {% if child.data is empty %}
                            {# No data found against the student #}
                            <p><em>No data available.</em></p>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
</div>
