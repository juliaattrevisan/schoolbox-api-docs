{% for child in studentData %}
    <div class="small-12 card">
        {% include 'include/portrait.twig' with {user: child.user, description: child.user.formatName} only %}
        <h1>{{ child.user.formatName }}</h1>
    </div>


<table>
    <thead>
    <tr>
        {% if child.data.hasDateRange %}
            <th>Date</th>
        {% endif %}
        <th>Name</th>
        <th>Result</th>
    </tr>
    </thead>
    <tbody>
        {% for field in (child.data.fields ?? []) %}
            <tr>
            {% if child.data.hasDateRange and child.data.dateRanges is defined and child.data.dateRanges %}
                <td>
                {%- for dateRange in child.data.dateRanges -%}
                    {{ dateRange.from.localShort }}&mdash;{{ dateRange.to.localShort }}
                    {% if not loop.last %}, {% endif %}
                {%- endfor -%}
            </td>
            {%  endif %}
            <td>{{ field.name }}</td>
            <td>
            {% if field.type == 'url' %}
                <a href="{{ field.value }}">Download</a>
            {% else %}
                {{ field.value }}
            {% endif %}
            </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{% endfor %}
