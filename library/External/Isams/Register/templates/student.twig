{{ studentData.register.name }} ({{ studentData.recordCollection.name }})
            <table>
                <thead>
                <tr>
                    {% for key,name in (studentData.knownFields ?? []) %}
                    <th data-field="{{ key }}">{{ name }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                    {% for record in (studentData.userRecords ?? []) %}
                    <tr>
                        {% for field in record %}
                            <td>{{ field.value }}</td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
