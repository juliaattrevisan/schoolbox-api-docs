<h1>{{ student.formatName }}</h1>

<table>
    <thead>
    <tr>
        {% if hasDateRange %}
            <th>Date</th>
        {% endif %}
        <th>Name</th>
        <th>Result</th>
    </tr>
    </thead>
    <tbody>
    {% for studentDatum in studentData %}
        {% for field in (studentDatum.fields ?? []) %}
            <tr>
            {% if hasDateRange and studentDatum.dateRanges is defined and studentDatum.dateRanges %}
                <td>
                {%- for dateRange in studentDatum.dateRanges -%}
                    {{ dateRange.from.localShort }}&mdash;{{ dateRange.to.localShort }}
                    {% if not loop.last %}, {% endif %}
                {%- endfor -%}
            </td>
            {%  endif %}
            <td>{{ field.name }}</td>
            <td>
            {% if field.type == 'url' %}
                <a href="{{ field.value }}">Download</a>
            {% else %}
                {{ field.value }}
            {% endif %}
            </td>
            </tr>
        {% endfor %}
    {% endfor %}
    </tbody>
</table>
