 protected function getCampusFromCode($code)
    {
        switch ($code) {
            case 'J':
                return 3;
            case 'M':
                return 1;
            case 'S':
                return 1;
            case 'T':
                return 4;
            case 'TS':
                return 2;
            case 'YR9':
                return 1;
            case 'TK4':
                return 4;
            case 'TK3':
                return 4;
            case 'EL4':
                return 3;
            case 'EL3':
                return 3;
            default:
                return 1;
        }
    }

    /**
     * Figure out the Group ID based on a Student's year level
     *
     * @param  $year
     * @return bool|int
     */
    protected function getGroupIDFromYearLevel($year)
    {
        switch ($year) {

            case 1:
                return 8;
            case 2:
                return 9;
            case 3:
                return 10;
            case 4:
                return 11;
            case 5:
                return 12;
            case 6:
                return 13;
            case 7:
                return 14;
            case 8:
                return 15;
            case 9:
                return 16;
            case 10:
                return 17;
            case 11:
                return 18;
            case 12:
                return 19;
            default:
                return false;
        }
    }
