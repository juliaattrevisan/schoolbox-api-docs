{##
 # Video
 #
 # A representation of a video when you preview through the Preview subsystem
 #
 # @param string $type  either sbfs or storage
 # @param string $hash  the file hash
 # @param int error     whether it processed into an error state or completed successfully
 #}

<script type="text/javascript">
    $(function(){
        $("#schoolbox_video_preview").mediaelementplayer();

        {# Hide the interactives if the video's not actually playable
         # Eventually shank this into a css stylesheet somewhere
         # but how
         #}
        {% if error %}
            $('.mejs__overlay.mejs__layer.mejs__overlay-play, .mejs__overlay-button, .mejs__controls').remove();
        {% endif %}
    });
</script>
<video id="schoolbox_video_preview"
       controls
       preload="none"
       poster="/cms/videoThumb.php?type={{ type }}&id={{ hash }}&size=poster"
       width="100%"
       height="500"
       style="max-width: 100%; height: 500px;"
       >
    <source src="/cms/sendVideo.php?type={{ type }}&id={{ hash }}" type='video/mp4'>
</video>

