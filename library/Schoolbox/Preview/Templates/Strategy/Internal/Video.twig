<div>
    <link href="/javascript/components/mediaelement/build/mediaelementplayer.min.css" rel="stylesheet">
    <script src="/javascript/components/mediaelement/build/mediaelement-and-player.min.js"></script>
    <script type="text/javascript">
        $(function(){
            $("#schoolbox_video_preview").mediaelementplayer();
        });
    </script>
    <div class="videoWrapper">
        <video id="schoolbox_video_preview"
               controls
               preload="none"
               poster="/cms/videoThumb.php?type={{ type }}&id={{ hash }}&size=poster"
               height="400"
               width="100%">
            <source src="/cms/sendVideo.php?type={{ type }}&id={{ hash }}" type='video/mp4'>
        </video>
    </div>
</div>