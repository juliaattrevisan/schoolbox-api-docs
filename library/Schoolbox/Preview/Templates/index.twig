<style type="text/css">
    table {
        border-collapse:collapse;
    }

    tr:nth-child(even) {
        background: #eee
    }

    tr:nth-child(odd) {
        background: #fff
    }

    td {
        border: 1px solid #666;
        font-family: Arial;
        font-size: 13px;
        padding: 16px;
    }
</style>
<table>
    {% for url, resultType in results %}
    <tr>
        <td width="50%">{{ url }}</td>
        <td width="50%">{{ resultType }}</td>
    </tr>
    {% endfor %}
</table>