<style type="text/css">
    table {
        border-collapse:collapse;
    }

    tr:nth-child(even) {
        background: #eee
    }

    tr:nth-child(odd) {
        background: #fff
    }

    td {
        border: 1px solid #666;
        font-family: Arial;
        font-size: 13px;
        padding: 16px;
    }
</style>
<script type="text/javascript" src="/javascript/preview/preview.js"></script>
<script type="text/javascript">
    $(function() {
        $('[data-modal=preview]').preview();
    });
</script>
<table>
    {% for currentUrl in allUrls %}
    <tr>
        <td><a data-modal='preview' href="/preview/{{ currentUrl|url_encode }}">{{ currentUrl }}</td>
    </tr>
    {% endfor %}
</table>