<style type="text/css">
    table {
        border-collapse:collapse;
    }

    tr:nth-child(even) {
        background: #eee
    }

    tr:nth-child(odd) {
        background: #fff
    }

    td {
        border: 1px solid #666;
        font-family: Arial;
        font-size: 13px;
        padding: 16px;
    }
</style>
<table>
    {% for currentUrl in allUrls %}
    <tr>
        <td><a href="/preview/{{ currentUrl|url_encode }}">{{ currentUrl }}</td>
    </tr>
    {% endfor %}
</table>