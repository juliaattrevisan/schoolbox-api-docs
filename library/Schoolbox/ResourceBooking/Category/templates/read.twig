<ul class="breadcrumb">
    <li><a href="{{ routeLookup('resourceItem.browse') }}">Resources</a></li>
    <li><a href="{{ routeLookup('resourceCategory.browse') }}">Categories</a></li>
    <li class="active"><a href="{{ routeLookup('resourceCategory.browse') }}?category={{ item.id|e('url') }}" >{{ item.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>{{ item.name }} Availability</h1>
    </div>
</div>

<script type="text/javascript">
    var calendarView = {{ calendar.view|json_encode|raw }};
    var calendarDate = moment({{ calendar.date|json_encode|raw }});

    if (calendarDate.isValid()) {
        calendarDate = calendarDate.toDate();
    } else {
        calendarDate = new Date();
    }

    switch (calendarView) {
        case 'day':
            calendarView = 'resourceTimelineDay';
            break;
        case 'month':
            calendarView = 'resourceTimelineMonth';
            break;
        case 'week':
        default:
            calendarView = 'resourceTimelineWeek';
            break;
    }

    window.fullCalendarConfig = {
        token:                  '{{ token }}',
        selectedFilters:        [1,2],
        defaultDate:            calendarDate,
        eventLimit:             Boolean('{{ config.calendar_collapse_events }}'),
        firstDay:               Number('{{ config.calendar_start_day }}'),
        defaultView:            calendarView,
        schedulerLicenseKey:    {{ config.fullcalendar_scheduler_license_key|json_encode|raw }},
        dateDisplayFormats:     dateDisplayFormats,
        resourceBookingEndpoint:{{ routeLookup('resourceCategory.calendar', {id: item.id})|json_encode|raw }},
        bookingIsAuthorized:    Boolean('{{ isRouteAuthorized('resourceBooking.book', {id: item.id, item: item}) }}'),
        createBookingPath:      {{ routeLookup('resourceBooking.book', {id: ''})|json_encode|raw }},
        resourceId:             Number('{{ item.id }}'),
        resourceColumns: [{
            labelText: 'Resource',

            text: function(resource) {
                var extendedProps = resource.extendedProps;
                var name = extendedProps.name;
                var roomCode = extendedProps.room_code;

                if (roomCode) {
                    name = name + ' [' + roomCode + ']';
                }

                return name;
            },
            render: function(resource, el) {
                var name = el.getElementsByClassName('fc-cell-text')[0].innerText;

                var link = document.createElement("a");
                    link.setAttribute('href', '/resource-booking/item/' + resource.id);
                    link.innerHTML = name;

                el.getElementsByClassName('fc-cell-text')[0].innerHTML = '';
                el.getElementsByClassName('fc-cell-text')[0].appendChild(link);
                el.getElementsByClassName('fc-cell-text')[0].setAttribute('class', 'resource-link');

            }
        }],
        resources: {{ resources|json_encode|raw }},
    };
</script>
{% autoescape 'js' %}
{% endautoescape %}

<div class="row">
    <section class="small-12 island">
        <h2 class="subheader">
            Bookings
            <span class="hint has-tip tip-top" data-tooltip title="Click the calendar to add a booking for that time.">?</span>
        </h2>
        <section>
            <div id="calendar"></div>
        </section>
    </section>
</div>

<script type="text/javascript" src="/javascript/components/resourceBookingCategoryCalendar.bundle.js"></script>
