<ul class="breadcrumb">
    <li><a href="{{ routeLookup('resourceItem.browse') }}">Resources</a></li>
    <li><a href="{{ routeLookup('resourceCategory.browse') }}">Categories</a></li>
    <li class="active"><a href="{{ routeLookup('resourceCategory.browse') }}?category={{ category.id|e('url') }}" >{{ category.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>{{ category.name }} Availability</h1>
    </div>
</div>

<script type="text/javascript">
    var calendarView = {{ calendar.view|json_encode|raw }};
    var calendarDate = moment({{ calendar.date|json_encode|raw }});

    if (calendarDate.isValid()) {
        calendarDate = calendarDate.toDate();
    } else {
        calendarDate = new Date();
    }

    switch (calendarView) {
        case 'day':
            calendarView = 'resourceTimelineDay';
            break;
        case 'month':
            calendarView = 'resourceTimelineMonth';
            break;
        case 'week':
        default:
            calendarView = 'resourceTimelineWeek';
            break;
    }

    window.fullCalendarConfig = {
        token:                  '{{ token }}',
        selectedFilters:        [1,2],
        defaultDate:            calendarDate,
        eventLimit:             Boolean('{{ config.calendar_collapse_events }}'),
        firstDay:               Number('{{ config.calendar_start_day }}'),
        defaultView:            calendarView,
        schedulerLicenseKey:    '{{ config.fullcalendar_scheduler_license_key }}',
        dateDisplayFormats:     dateDisplayFormats,
        resourceBookingEndpoint:{{ routeLookup('resourceCategory.calendar', {id: category.id})|json_encode|raw }},
        createBookingPath:      {{ routeLookup('resourceBooking.book', {id: ''})|json_encode|raw }},
        resourceId:             Number('{{ category.id }}'),
        resourceColumns: [{
            headerContent: 'Resource',
            cellContent: function(args) {
                let link = document.createElement('a');
                link.setAttribute('href', '/resource-booking/item/' + args.fieldValue);
                link.setAttribute('class', 'resource-link');
                link.innerText = args.resource.extendedProps.name;
                return { domNodes: [ link ] }
            }
        }],
        resources: {{ resources|json_encode|raw }},
        returnUrl: '{{ RETURN_URL.name }}={{ RETURN_URL.current }}'
    };
</script>
{% autoescape 'js' %}
{% endautoescape %}

<div class="row">
    <section class="small-12 island">
        <h2 class="subheader">
            Bookings
            <span class="hint has-tip tip-top" data-tooltip title="Click the calendar to add a booking for that time.">?</span>
        </h2>
        <section>
            <div id="calendar">
                <resource-booking-category-calendar />
            </div>
            <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/resourceBookingCategoryCalendar.js?v={{ config.site_version }}"></script>
        </section>
    </section>
</div>
