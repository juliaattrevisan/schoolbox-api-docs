{# I need some way of adding custom_head #}

<h1>Resource Category - {% if item.id %}Edit{% else %}Add New{% endif %}</h1>

<form
    action="{% if item.id %}{{ routeLookup('resourceCategory.update:post', {id: item.id}) }}{% else %}{{ routeLookup('resourceCategory.create') }}{% endif %}"
    method="post"
    name="form" class="clearfix"
>
    <input type="hidden" name="id" value="{{ item.id }}"/>
    <table class="standardForm table">
        <tr>
            <td class="formLabelWidth"><h4>Title</h4></td>
            <td><input class="required" name="name" type="text" value="{{ item.name }}" size="30"/></td>
        </tr>
    </table>

    <input type="submit" name="{% if item.id %}Add{% else %}Save{% endif %}" class="submit-btn-plain"/>

    {# I need some sort of permission check method, because not all users can delete #}
    {% if item.id %}
    <input type="button" class="submit-btn-plain" value="Delete" />
    {% endif %}
</form>
