{# I need some way of adding custom_head #}
<script type="text/javascript">
    (function($){
        $(function(){
            var form = $('#resourcecategory-form');
            form.on('click', 'a#resourcecategory-delete', function(event) {
                event.preventDefault();
                form.attr('action', this.href).submit();
            })
        })
    })(jQuery);
</script>

<h1>Resource Category - {% if item.id %}Edit{% else %}Add New{% endif %}</h1>

<form id="resourcecategory-form"
    action="{% if item.id %}{{ routeLookup('resourceCategory.update:post', {id: item.id}) }}{% else %}{{ routeLookup('resourceCategory.create') }}{% endif %}"
    method="post"
    name="form" class="clearfix"
>
    <input type="hidden" name="id" value="{{ item.id }}"/>
    <table class="standardForm table">
        <tr>
            <td class="formLabelWidth"><h4>Title</h4></td>
            <td><input class="required" name="name" type="text" value="{{ item.name }}" size="30"/></td>
        </tr>
    </table>

    <input id="resourcecategory-save" type="submit" value="{% if item.id %}Create{% else %}Update{% endif %}" class="submit-btn-plain"/>

    {# I need some sort of permission check method, because not all users can delete #}
    {% if item.id %}
    <a href="{{ routeLookup('resourceCategory.delete:post', {id: item.id}) }}" id="resourcecategory-delete" class="submit-btn-plain">Delete</a>
    {% endif %}
</form>
