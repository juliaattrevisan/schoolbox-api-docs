{# I need some way of adding custom_head #}
<script type="text/javascript">
    $(function(){
        var form = $('#resourcecategory-form');

        $(document).on('click', '#resourcecategory-delete', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this item?',
                confirmEvent: function() {
                    form.attr('action', $(element).data('action')).submit();
                }
            });
        });

        form.alaressValidate({
            rules: {
                name: {
                    minlength: 2
                }
            }
        });
    })
</script>
{# rel="edit-form" and rel="create-form" - RFC 6861 #}
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('resourceItem.browse') }}">Resources</a></li>
    <li><a href="{{ routeLookup('resourceCategory.browse') }}">Resource Categories</a></li>
    <li class="active"><a href="#">{% if category.id %}Edit{% else %}Add{% endif %}</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{% if category.id %}Edit{% else %}Add{% endif %} Resource Category</h1>
        </div>
    </div>
    {% if category.id and isRouteAuthorized('resourceCategory.delete:post', {id: category.id, category: category}) %}
    <nav>
        <a class="icon-more" title="Actions" data-dropdown="header-options"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        <li><a id="resourcecategory-delete" class="icon-delete" title="Delete" data-action="{{ routeLookup('resourceCategory.delete:post', {id: category.id}) }}">Delete</a></li>
    </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        <form id="resourcecategory-form" action="{% if category.id %}{{ routeLookup('resourceCategory.update:post', {id: category.id}) }}{% else %}{{ routeLookup('resourceCategory.create') }}{% endif %}" method="post" name="form">
            <input type="hidden" name="id" value="{{ category.id }}"/>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="name" class="required">Title</label>
                        <input class="required" name="name" id="name" type="text" value="{{ category.name }}" maxlength="250" required/>
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <input id="resourcecategory-save" type="submit" value="{% if category.id %}Update{% else %}Create{% endif %}" />
                </div>
            </div>
        </form>
    </div>
</div>
