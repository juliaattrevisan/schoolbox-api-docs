<div class="row">
    <div class="small-12 island">
        <section>
            {% if list|length %}
            <ul class="action-list">
                {% for item in list %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 card">
                            {% if isRouteAuthorized('resourceCategory.read', {id: item.id, item: item}) %}
                                <a id="resourcecategory-read-{{item.id}}"
                                   href="{{ routeLookup('resourceCategory.read', {id: item.id}) }}">{{ item.name }}</a>
                            {% else %}
                                {{ item.name }}
                            {% endif %}
                        </div>
                    </div>
                    <nav>
                        {% if isRouteAuthorized('resourceCategory.edit', {id: item.id, item: item}) %}
                            <a id="resourcecategory-edit-{{item.id}}"
                               href="{{ routeLookup('resourceCategory.edit', {id: item.id}) }}"
                               title="Edit"
                               class="icon"><sbx-icon name="modify"></sbx-icon></a>
                        {% endif %}
                    </nav>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <div class="content">
                <p>There are no resource categories in the system.</p>
            </div>
            {% endif %}
        </section>
    </div>
</div>
