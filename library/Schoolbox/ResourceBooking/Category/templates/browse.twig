{# rel="edit-form" and rel="create-form" - RFC 6861 #}
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('resourceItem.browse') }}">Resources</a></li>
    <li class="active"><a href="#">Resource Categories</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Resource Category List</h1>
        </div>
    </div>
    <nav>
        {# New item: only if I have the permission to do this #}
