<h1>Resource Category List</h1>
<ul>
    {% for item in list %}
    <li><a href="{{ routeLookup('resourceCategory.edit', {id: item.id}) }}">{{ item.name }}</a></li>
    {% else %}
    <li>There are no resource categories in the system.</li>
    {% endfor %}
</ul>

{# New item: only if I have the permission to do this #}
<a class="submit-btn-plain" href="{{ routeLookup('resourceCategory.add') }}">Add New</a>