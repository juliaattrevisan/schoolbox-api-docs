{# Need some method for adding custom_head #}

<h1>Resource Category - {% if item.id %}Add New{% else %}Edit{% endif %}</h1>

{# I'd like routeLookup in my controllers #}
<form action="{{ routeLookup('resourceCategory.create') }}" method="post" name="form" class="clearfix">
    <input type="hidden" name="id" value="{{ item.id }}"/>
    <table class="standardForm table">
        <tr>
            <td class="formLabelWidth"><h4>Title</h4></td>
            <td><input class="required" name="name" type="text" value="{{ item.name }}" size="30"/></td>
        </tr>
    </table>

    <input type="submit" name="{% if item.id %}Add{% else %}Save{% endif %}" class="submit-btn-plain"/>

    {# I need some sort of permission check method #}
    {% if item.id %}
    <input type="button" class="submit-btn-plain" value="Delete" />
    {% endif %}
</form>
