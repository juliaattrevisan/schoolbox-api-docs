<ul class="breadcrumb">
    <li><a href="{{ routeLookup('resourceItem.browse') }}">Resources</a></li>
    <li class="active"><span>{{ category.getName() }}</span></li>
</ul>

<div class="actions-small-2 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Resources</h1>
        </div>
    </div>
    <nav>
        <sbx-pop-out content-id="options"></sbx-pop-out>
    </nav>
    <ul class="f-dropdown" data-dropdown-content id="options">
        <li>
            <a class="icon-search" data-reveal-id="search-modal" title="Search Resources">Search Resources</a>
        </li>
        {% if isRouteAuthorized('resourceCategory.browse') %}
            <li>
                <a class="icon-list" href="{{  routeLookup('resourceCategory.browse') }}" title="Resource Categories">Resource Categories</a>
            </li>
        {% endif %}
        {% if isRouteAuthorized('resourceBookingReport.index') %}
            <li>
                <a class="icon-report" href="{{  routeLookup('resourceBookingReport.index') }}" title="Booking Report">Booking Report</a>
            </li>
        {% endif %}
        {% if categoryId %}
        <li>
            <a class="icon-calendar" href="{{  routeLookup('resourceCategory.read', {id: categoryId}) }}" title="Availability Calendar">Availability Calendar</a>
        </li>
        {% endif %}
        {% if isRouteAuthorized('resourceItem.add') %}
            <li class="separator">Admin Actions</li>
            <li>
                <a id="resource-create" rel="create-form" class="icon-add" href="{{ routeLookup('resourceItem.add') }}" title="Add Resource">Add Resource</a>
            </li>
            <li>
                <a id="resource-create" rel="create-form" class="icon-add" href="{{ routeLookup('resourceCategory.add') }}" title="Add Category">Add Category</a>
            </li>
        {% endif %}
    </ul>
</div>

<div id="search-modal" class="reveal-modal small" data-reveal>
    <h2>Search Resources</h2>
    <form action="{{ routeLookup('resourceItem.browse') }}" method="get">
        <input type="search" id="resource-search-term" placeholder="Search Resources" name="search" value="{{ search|default('') }}" />
        <input type="submit" id="resource-search" value="Search" />
    </form>

    <a class="close-reveal-modal">&#215;</a>
</div>

<div class="row">
    <div class="small-12 columns">
        <dl class="tabs">
            <dd class="{% if not categoryId %}active{% endif %}"><a href="{{ routeLookup('resourceItem.browse') }}">All</a></dd>
            {% for item in categoryList %}
            {% include '@resourceItem/sub/searchLink.twig' with {currentId: categoryId} %}
            {% endfor %}
        </dl>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            {% if list|length %}
            <ul class="action-list">
                {% for item in list %}
                <li class="actions-small-2">
                    <div class="list-item">
                        <div class="small-12 card">
                            <a href="{{ routeLookup('resourceItem.read', {id: item.id}) }}">
                                {% if item.image and item.image.hash %}
                                <img src="/storage/image.php?size=square64&hash={{ item.image.hash|e('url') }}" />
                                {% endif %}

                                <h3>
                                    {% include '@resourceItem/sub/itemName.twig' with {item: item} %}
                                </h3>
                            </a>

                            <p class="meta">
                                {% if item.category.isDeleted %}
                                    <span>{{ item.category.name }}</span>
                                {% else %}
                                    <a href="{{ routeLookup('resourceCategory.read', {id: item.category.id}) }}" >{{ item.category.name }}</a>
                                {% endif %}

                                {% if item.moderatorList is not empty %}
                                    {% include '@resourceItem/sub/moderated.twig' with {item: item} %}
                                    {% include '@resourceItem/sub/moderatorList.twig' with {moderatorList: item.moderatorList} %}
                                {% endif %}
                            </p>
                        </div>
                    </div>
                    <nav>
                        {#
                        Is there some more semantically correct way of saying that this is a
                        resource, apart from adding classes?
                        #}

                        {% if isRouteAuthorized('resourceBooking.book', {id: item.id, item: item}) %}
                        <a class="icon-add resource-book-link" id="resource-book-{{item.id}}" title="Book" href="{{ routeLookup('resourceBooking.book', {id: item.id}) }}"></a>
                        {% endif %}

                        {% if isRouteAuthorized('resourceItem.edit', {id: item.id, item: item}) %}
                        <a class="icon-modify resource-name resource-edit-link" id="resource-edit-{{item.id}}" title="Edit" rel="edit-form" href="{{ routeLookup('resourceItem.edit', {id: item.id}) }}"></a>
                        {% endif %}
                    </nav>
                    <article>{{ item.description|purify }}</article>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <div class="content">
                <p>There are no resources in the system.</p>
            </div>
            {% endif %}
        </section>
        {% include 'sub/paginator.twig' with {paginator: paginator, currentPage: page, class:'pagination'} %}
    </div>
</div>
