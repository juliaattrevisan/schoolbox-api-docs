<ul class="breadcrumb">
    <li><a href="#">Resources</a></li>
    <li class="active"><a href="#">All</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>All Resources</h1>
        </div>
    </div>
    <nav>
        <a class="icon-search" data-reveal-id="search-modal" title="Search Resources"></a>
    </nav>
</div>

<div id="search-modal" class="reveal-modal" data-reveal>
    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">Search Resources</h2>
            <form action="{{ routeLookup('resourceItem.browse') }}" method="get">
                <section>
                    <label>
                        <input type="search" id="resource-search-term" placeholder="Search Resources" name="search" value="{{ search|default('') }}" />
                    </label>
                </section>
            </form>
            <div class="row">
                <div class="small-12 columns">
                    <input type="submit" id="resource-search" value="Search" class="expand" />
                </div>
            </div>
        </div>
    </div>

    <a class="close-reveal-modal">&#215;</a>
</div>

<div class="row">
    <div class="small-12 columns">
        <dl class="sub-nav">
            <dd><a href="{{ routeLookup('resourceItem.browse') }}" class="{% if not categoryId %}current{% endif %}">All</a></dd>
            {% for item in categoryList %}
            {% include '@resourceItem/sub/searchLink.twig' with {currentId: categoryId} %}
            {% endfor %}
        </dl>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            {% if list|length %}
            <ul class="action-list">
                {% for item in list %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <a href="{{ routeLookup('resourceItem.read', {id: item.id}) }}">
                                {% if item.image.hash %}
                                <img src="/storage/image.php?size=square64&hash={{ item.image.hash|e('url') }}" />
                                {% endif %}

                                <p>
                                    {% include '@resourceItem/sub/itemName.twig' with {item: item} %}
                                </p>
                            </a>

                            <p class="meta">
                                <a href="{{ routeLookup('resourceCategory.read', {id: item.category.id}) }}" >{{ item.category.name }}</a>

                                {% if item.moderatorList is not empty %}
                                    {% include '@resourceItem/sub/moderated.twig' with {item: item} %}
                                    {% include '@resourceItem/sub/moderatorList.twig' with {moderatorList: item.moderatorList} %}
                                {% endif %}
                            </p>
                        </div>
                        <article>
                            {{ item.description|e("purify")|raw }}
                        </article>
                    </div>
                    <nav>
                        {#
                        Is there some more semantically correct way of saying that this is a
                        resource, apart from adding classes?
                        #}
                        <a class="resource-read-link" id="resource-read-{{item.id}}" title="View" href="{{ routeLookup('resourceItem.read', {id: item.id}) }}"></a>

                        {% if isRouteAuthorized('resourceBooking.book', {id: item.id, item: item}) %}
                        <a class="resource-book-link" id="resource-book-{{item.id}}" title="Book" href="{{ routeLookup('resourceBooking.book', {id: item.id}) }}"></a>
                        {% endif %}

                        {% if isRouteAuthorized('resourceItem.edit', {id: item.id, item: item}) %}
                        <a class="resource-name resource-edit-link" id="resource-edit-{{item.id}}" title="Edit" rel="edit-form" href="{{ routeLookup('resourceItem.edit', {id: item.id}) }}"></a>
                        {% endif %}
                    </nav>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <div class="content">
                <p>There are no resources in the system.</p>
            </div>
            {% endif %}

            {% include 'sub/paginator.twig' with {paginator: paginator, currentPage: currentPage, class:'admin-nav'} %}

            {# New item: only if I have the permission to do this #}
            {% if isRouteAuthorized('resourceItem.add') %}
            <div class="content">
                <a id="resource-create" rel="create-form" class="button icon-add" href="{{ routeLookup('resourceItem.add') }}">Add New</a>
            </div>
            {% endif %}
        </section>
    </div>
</div>



