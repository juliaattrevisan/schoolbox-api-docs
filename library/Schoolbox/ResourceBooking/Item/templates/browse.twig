<h1>Resource List</h1>
<ul class="resource-list">
    {% for item in list %}
    <li class="resource">
        <a id="resource-edit-{{item.id}}" rel="edit-form" href="{{ routeLookup('resource.edit', {id: item.id}) }}">{{ item.name }}</a>
    </li>
    {% else %}
    <li>There are no resources in the system.</li>
    {% endfor %}
</ul>
