<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<link type="text/css" rel="stylesheet" href="/javascript/components/selectize/dist/css/selectize.css" />
<link type="text/css" rel="stylesheet" href="/javascript/components/selectize/dist/css/selectize.default.css" />
<script type="text/javascript" src="/javascript/jquery.selectizeSelector.js"></script>
<script type="text/javascript" src="/javascript/jquery.prettyFileInput.js"></script>
<script type="text/javascript" src="/javascript/tiny_mce/tiny_mce.js"></script>

<script type="text/javascript">

    tinyMCE.init({
        mode : "textareas",
        theme : "advanced",
        skin : "cirkuit",
        plugins : "pdw,table,tabfocus,media,inlinepopups,advimage,assetmanager,directionality,paste,spellchecker",
        browser_spellcheck : true,
        content_css : "/css/core/tiny.css",
        theme_advanced_toolbar_location : "top",
        theme_advanced_toolbar_align : "left",
        theme_advanced_statusbar_location : "bottom",
        theme_advanced_buttons1 : "bold,italic,underline,separator,bullist,numlist,separator,link,unlink,image,media,separator,undo,redo,separator,pdw_toggle",
        theme_advanced_buttons2 : "forecolor,formatselect,fontsizeselect,separator,justifyleft,justifycenter,justifyright,z,spellchecker",
        theme_advanced_buttons3 : "outdent,indent,sub,sup,separator,hr,charmap,separator,seperator,ltr,rtl,selectall,pastetext,pasteword,separator,removeformat,cleanup,code",
        theme_advanced_buttons4 : "tablecontrols",
        accessibility_warnings : false,
        pdw_toggle_on : 1,
        pdw_toggle_toolbars : '2, 3, 4',
        extended_valid_elements : "a[class|name|href|target|title|onclick],img[class|src|border=0|alt|title|hspace|vspace|width|height|align|onmouseover|onmouseout|name|style],hr[class|width|size|noshade],font[face|size|color|style],span[class|align|style]",
        theme_advanced_blockformats : "h3,h4,p,address,pre",
        file_browser_callback : 'tinyMCE.activeEditor.plugins.assetmanager.fileBrowser',
        file_uploader_callback : 'tinyMCE.activeEditor.plugins.assetmanager.fileUploader',
        file_browser_category_id : 0,
        tabfocus_elements : ":prev,:next",
        convert_urls : false
    });

    (function($){
        $(function(){

            // Hijack save form to allow delete
            var form = $('#resource-form');
            form.on('click', '#resource-delete', function(event) {
                event.preventDefault();
                form.attr('action', $(this).data('action')).submit();
            })

            // Add selectize for user selection and selector for related items
            form.find('select#resource-moderator-selector').selectizeSelector({
                ajax: {
                    url:      '/ajax/user.php',
                    type:     'GET',
                    data:     {groupID: 0},
                    dataType: 'json'
                },
                multiple: true,
                value: {{ moderatorList|json_encode|raw }}
            })
            form.find('select#resource-related-resource-selector').selectizeSelector({
                ajax: {
                    url:      {{ routeLookup('resourceItem.search', {id: item.id, format:'.json'}) | json_encode|raw}},
                    type:     'GET',
                    data:     {thisId: {{ item.id|json_encode|raw }}},
                    dataType: 'json'
                },
                multiple: true,
                value: {{ relatedItemList|json_encode|raw }}
            })

            form.find('input[type="file"].prettify').prettyFileInput({
                additionalButtonClasses: 'up-arrow no-marg float-right',
                buttonActiveClass: 'tick',
                defaultText: '<span></span>Upload Image',
                defaultFileSelectedText: '<span></span>File selected'
            });

        })
    })(jQuery);
</script>

<h1>Resource - {% if item.id %}Edit{% else %}Add New{% endif %}</h1>

<form id="resource-form"
    action="{% if item.id %}{{ routeLookup('resourceItem.update:post', {id: item.id}) }}{% else %}{{ routeLookup('resourceItem.create') }}{% endif %}"
    method="post"
    name="form" class="clearfix"
    enctype="multipart/form-data"
>
    <input type="hidden" name="id" value="{{ item.id }}"/>
    <table class="standardForm table">
        <tr>
            <td class="formLabelWidth"><h4>Name</h4></td>
            <td><input class="required" name="name" type="text" value="{{ item.name }}" size="30"/></td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Category</h4></td>
            <td>
                <select name="resource_category_id">
                    <option>-- select --</option>
                    {% for category in categoryList %}
                        <option {{ category.id == item.category.id ? 'selected' : '' }}
                                value="{{ category.id|e('html_attr') }}"
                                label="{{ category.name|e('html_attr') }}"
                        >{{ category.name }}</option>
                    {% endfor %}
                </select>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Moderation</h4></td>
            <td>
                <select name="resource_moderation_type_id">
                    {% for moderation in moderationList %}
                        <option {{ moderation.id == item.moderationType.id ? 'selected' : '' }}
                                value="{{ moderation.id|e('html_attr') }}"
                                label="{{ moderation.name|e('html_attr') }}"
                        >{{ moderation.name }}</option>
                    {% endfor %}
                </select>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Moderators</h4></td>
            <td>
                <select id="resource-moderator-selector" name="moderator_id[]" multiple></select>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Related Resources</h4></td>
            <td>
                <select id="resource-related-resource-selector" name="related_resource_id[]" multiple></select>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Description</h4></td>
            <td><textarea name="description" style="width:100%;">{{ item.name }}</textarea></td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Image</h4></td>
            <td>
                {% if item.image.hash %}
                    <input type="hidden" name="image" value="{{ item.image.id }}">
                    <img src="/storage/image.php?size=constrain200&hash={{ item.image.hash|e('url') }}" />
                    <label><input type="checkbox" name="image" value="" /> Delete Image</label>
                    <input type="file" name="image" class="prettify">
                {% else %}
                    <input type="file" name="image" class="prettify">
                {% endif %}
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Minimum Lead Time</h4>
                <em>Somebody reserving this item must give this period of notice before their reservation.</em>
            </td>
            <td>
                <input class="interval-input" value="{{ item.minLeadTime.dayTotal        }}" name="min_lead_time[day]"    placeholder="days">
                <input class="interval-input" value="{{ item.minLeadTime.hourRemainder   }}" name="min_lead_time[hour]"   placeholder="hours">
                <input class="interval-input" value="{{ item.minLeadTime.minuteRemainder }}" name="min_lead_time[minute]" placeholder="minutes">
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Minimum Reservation Time</h4>
                <em>This item must be reserved for at least this period of time.</em>
            </td>
            <td>
                <input class="interval-input" value="{{ item.minReservationTime.dayTotal        }}" name="min_reservation_time[day]"    placeholder="days">
                <input class="interval-input" value="{{ item.minReservationTime.hourRemainder   }}" name="min_reservation_time[hour]"   placeholder="hours">
                <input class="interval-input" value="{{ item.minReservationTime.minuteRemainder }}" name="min_reservation_time[minute]" placeholder="minutes">
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Maximum Reservation Time</h4>
                <em>This item cannot be reserved for longer than this period.</em>
            </td>
            <td>
                <input class="interval-input" value="{{ item.maxReservationTime.dayTotal        }}" name="max_reservation_time[day]"    placeholder="days">
                <input class="interval-input" value="{{ item.maxReservationTime.hourRemainder   }}" name="max_reservation_time[hour]"   placeholder="hours">
                <input class="interval-input" value="{{ item.maxReservationTime.minuteRemainder }}" name="max_reservation_time[minute]" placeholder="minutes">
            </td>
        </tr>
    </table>

    <input id="resource-save"
           type="submit"
           value="{% if item.id %}Update{% else %}Create{% endif %}"
           class="submit-btn-plain"
    />

    {% if item.id and isRouteAuthorized('resourceItem.delete:post', {id: item.id}) %}
    <input id="resource-delete"
           type="submit"
           value="Delete"
           class="submit-btn-plain"
           data-action="{{ routeLookup('resourceItem.delete:post', {id: item.id}) }}"
    />
    {% endif %}
</form>
