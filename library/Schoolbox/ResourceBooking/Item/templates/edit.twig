{# I need some way of adding custom_head #}
<script type="text/javascript" src="/javascript/components/magicsuggest/src/magicsuggest-1.3.1.js"></script>
<script type="text/javascript" src="/javascript/jquery.userSelector.js"></script>
<script type="text/javascript">
    (function($){
        $(function(){

            // Hijack save form to allow delete
            var form = $('#resource-form');
            form.on('click', '#resource-delete', function(event) {
                event.preventDefault();
                form.attr('action', $(this).data('action')).submit();
            })

            // Add magicsuggest for user selection
            form.find('input[name="moderator_id"]').userSelector({
                plugin: {
                    data:'/ajax/user.php?groupID=0',
                    width: 200
                },
                multiple: true
            })

        })
    })(jQuery);
</script>

<h1>Resource - {% if item.id %}Edit{% else %}Add New{% endif %}</h1>

<form id="resource-form"
    action="{% if item.id %}{{ routeLookup('resourceItem.update:post', {id: item.id}) }}{% else %}{{ routeLookup('resourceItem.create') }}{% endif %}"
    method="post"
    name="form" class="clearfix"
>
    <input type="hidden" name="id" value="{{ item.id }}"/>
    <table class="standardForm table">
        <tr>
            <td class="formLabelWidth"><h4>Name</h4></td>
            <td><input class="required" name="name" type="text" value="{{ item.name }}" size="30"/></td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Category</h4></td>
            <td>
                <select name="resource_category_id">
                    <option>-- select --</option>
                    {% for category in categoryList %}
                        <option {{ category.id == item.category.id ? 'selected' : '' }}
                                value="{{ category.id|e('html_attr') }}"
                                label="{{ category.name|e('html_attr') }}"
                        >{{ category.name }}</option>
                    {% endfor %}
                </select>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Moderation</h4></td>
            <td>
                <select name="resource_moderation_type_id">
                    {% for moderation in moderationList %}
                        <option {{ moderation.id == item.moderationType.id ? 'selected' : '' }}
                                value="{{ moderation.id|e('html_attr') }}"
                                label="{{ moderation.name|e('html_attr') }}"
                        >{{ moderation.name }}</option>
                    {% endfor %}
                </select>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Moderators</h4></td>
            <td>
                <input name="moderator_id" />
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Description</h4></td>
            <td><textarea name="description">{{ item.name }}</textarea></td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Rules</h4></td>
            <td>
                <label for="min_lead_time">Minimum Lead Time</label>
                <input id="min_lead_time" name="min_lead_time" />
                <label for="min_reservation_time">Minimum Reservation Time</label>
                <input id="min_reservation_time" name="min_reservation_time" />
                <label for="max_reservation_time">Maximum Reservation Time</label>
                <input id="max_reservation_time" name="max_reservation_time" />
                {#
                <!-- Datespan input -->
                <input name="min_lead_time[day]"    placeholder="days"> .
                <input name="min_lead_time[hour]"   placeholder="hours"> :
                <input name="min_lead_time[minute]" placeholder="minutes">
                #}
            </td>
        </tr>
    </table>

    <input id="resource-save"
           type="submit"
           value="{% if item.id %}Update{% else %}Create{% endif %}"
           class="submit-btn-plain"
    />

    {# I need some sort of permission check method, because not all users can delete #}
    {% if item.id %}
    <input id="resource-delete"
           type="submit"
           value="Delete"
           class="submit-btn-plain"
           data-action="{{ routeLookup('resourceItem.delete:post', {id: item.id}) }}"
    />
    {% endif %}
</form>
