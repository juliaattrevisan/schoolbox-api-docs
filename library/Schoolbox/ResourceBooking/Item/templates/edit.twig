<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/jquery.selectizeSelector.js"></script>
<script type="text/javascript" src="/javascript/jquery.prettyFileInput.js"></script>
<script type="text/javascript" src="/javascript/tiny_mce/tiny_mce.js"></script>
<script type="text/javascript" src="/javascript/jquery.alaressTiny.js"></script>
<script type="text/javascript" src="/javascript/components/jquery-timepicker-jt/jquery.timepicker.min.js"></script>
<script type="text/javascript" src="/javascript/jquery.hourpicker.js"></script>
<script type="text/javascript" src="/javascript/jquery.minutepicker.js"></script>

<script type="text/javascript">
    (function($){
        $(function(){
            $.fn.alaressTiny({
                mode: 'textareas'
            });

            // Hijack save form to allow delete
            var form = $('#resource-form');
            form.on('click', '#resource-delete', function(event) {
                event.preventDefault();
                form.attr('action', $(this).data('action')).submit();
            })

            // Add selectize for user selection and selector for related items
            form.find('select#resource-moderator-selector').selectizeSelector({
                ajax: {
                    url:      '/ajax/user.php',
                    type:     'GET',
                    data:     {roleTypeID: 'staff'},
                    dataType: 'json'
                },
                multiple: true,
                value: {{ moderatorList|json_encode|raw }}
            })
            form.find('select#resource-related-resource-selector').selectizeSelector({
                ajax: {
                    url:      {{ routeLookup('resourceItem.search', {id: item.id, format:'.json'}) | json_encode|raw}},
                    type:     'GET',
                    data:     {thisId: {{ item.id|json_encode|raw }}},
                    dataType: 'json'
                },
                multiple: true,
                value: {{ relatedItemList|json_encode|raw }}
            })

            form.find('input[type="file"].prettify').prettyFileInput({
                additionalButtonClasses: 'up-arrow no-marg float-right',
                buttonActiveClass: 'tick',
                defaultText: '<span></span>Upload Image',
                defaultFileSelectedText: '<span></span>File selected'
            });

            form.validate({
                rules: {
                    name: {
                        required: true,
                        minlength: 2
                    },
                    resource_category_id: {
                        min: 1
                    },
                    "min_lead_time[day]": {
                        digits: true
                    },
                    "min_reservation_time[day]": {
                        digits: true
                    },
                    "max_reservation_time[day]": {
                        digits: true
                    },
                    "min_lead_time[hour]": {
                        digits: true,
                        range: [0,23]
                    },
                    "min_reservation_time[hour]": {
                        digits: true,
                        range: [0,23]
                    },
                    "max_reservation_time[hour]": {
                        digits: true,
                        range: [0,23]
                    },
                    "min_lead_time[minute]": {
                        digits: true,
                        range: [0,59]
                    },
                    "min_reservation_time[minute]": {
                        digits: true,
                        range: [0,59]
                    },
                    "max_reservation_time[minute]": {
                        digits: true,
                        range: [0,59]
                    }
                },
                messages: {
                    resource_category_id:           "Please select a category.",
                    "min_reservation_time[day]":    "If entered, day count must be a number.",
                    "max_reservation_time[day]":    "If entered, day count must be a number.",
                    "min_lead_time[hour]":          "If entered, hour count must be a number from 0 to 23",
                    "min_reservation_time[hour]":   "If entered, hour count must be a number from 0 to 23",
                    "max_reservation_time[hour]":   "If entered, hour count must be a number from 0 to 23",
                    "min_lead_time[minute]":        "If entered, minute count must be a number from 0 to 59",
                    "min_reservation_time[minute]": "If entered, minute count must be a number from 0 to 59",
                    "max_reservation_time[minute]": "If entered, minute count must be a number from 0 to 59"
                },
                errorPlacement: function(error, element) {
                    switch (element.attr('name')) {
                        case "min_lead_time[day]":
                        case "min_reservation_time[day]":
                        case "max_reservation_time[day]":
                        case "min_lead_time[hour]":
                        case "min_reservation_time[hour]":
                        case "max_reservation_time[hour]":
                        case "min_lead_time[minute]":
                        case "min_reservation_time[minute]":
                        case "max_reservation_time[minute]":
                            element.parent().append(error)
                            break
                        default:
                            element.after(error)
                            break
                    }
                }
            })

            $('input[data-timepicker="hour"]').hourpicker({
                hours: 24,
                appendTo: function ($input) {
                    return $input.closest('.timepick');
                }
            });
            $('input[data-timepicker="minute"]').minutepicker({
                appendTo: function ($input) {
                    return $input.closest('.timepick');
                }
            });
        })
    })(jQuery);
</script>

<h1>Resource - {% if item.id %}Edit{% else %}Add New{% endif %}</h1>

<form id="resource-form"
    action="{% if item.id %}{{ routeLookup('resourceItem.update:post', {id: item.id}) }}{% else %}{{ routeLookup('resourceItem.create') }}{% endif %}"
    method="post"
    name="form" class="clearfix"
    enctype="multipart/form-data"
>
    <input type="hidden" name="id" value="{{ item.id }}"/>
    <table class="standardForm table">
        <tr>
            <td class="formLabelWidth"><h4>Name</h4></td>
            <td><label><input class="required" name="name" type="text" value="{{ item.name }}" /></label></td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Room Code</h4>
                <em>
                    If this resource is a room, enter its room code here.
                    This will prevent the room from being booked when there is a
                    class timetabled there.
                </em>
            </td>
            <td><label><input name="room_code" type="text" value="{{ item.roomCode }}" /></label></td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Category</h4></td>
            <td>
                <select name="resource_category_id">
                    <option>-- select --</option>
                    {% for category in categoryList %}
                        <option {{ category.id == item.category.id ? 'selected' : '' }}
                                value="{{ category.id|e('html_attr') }}"
                                label="{{ category.name|e('html_attr') }}"
                        >{{ category.name }}</option>
                    {% endfor %}
                </select>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Allowed Roles</h4>
                <em>Users in the selected roles will be able to book this resource.</em>
                <em>Moderators (whether for this item or the whole resource booking module)
                    will be able to book this resource even if they aren't in a selected role.</em>
            </td>
            <td>
                <div class="clearfix checkboxes groups">
                {% for role in roleList %}
                    {# Default for new items: staff roles are selected, others are not #}
                    <input type="hidden" name="role[{{ role.id }}]" value="0" />
                    <label class="float-left clear">
                        <input type="checkbox"
                               name="role[{{ role.id }}]" value="1"
                               {% if item.id %}
                                   {% for resourceRole in item.roleList if resourceRole.role.id == role.id %}
                                       {% if resourceRole.allowed %}checked{% endif %}
                                   {% endfor %}
                               {% else %}
                                   {% if role.type == 'staff' %}checked{% endif %}
                               {% endif %}
                        />
                        {{ role.name }}
                    </label>
                {% endfor %}
                <label class="float-left clear">
                    <input type="checkbox" value="1" class="select_all" />
                    Select All
                </label>
                </div>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Moderation</h4></td>
            <td>
                <select name="resource_moderation_type_id">
                    {% for moderation in moderationList %}
                        <option {{ moderation.id == item.moderationType.id ? 'selected' : '' }}
                                value="{{ moderation.id|e('html_attr') }}"
                                label="{{ moderation.name|e('html_attr') }}"
                        >{{ moderation.name }}</option>
                    {% endfor %}
                </select>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Moderators</h4></td>
            <td>
                <select id="resource-moderator-selector" name="moderator_id[]" multiple placeholder="Search Staff"></select>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Related Resources</h4></td>
            <td>
                <select id="resource-related-resource-selector" name="related_resource_id[]" multiple placeholder="Search Resources"></select>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Description</h4></td>
            <td><textarea name="description" style="width:100%;">{{ item.description }}</textarea></td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Image</h4></td>
            <td>
                {% if item.image.hash %}
                    <input type="hidden" name="image" value="{{ item.image.hash }}">
                    <img src="/storage/image.php?size=constrain200&hash={{ item.image.hash|e('url') }}" />
                    <label><input type="checkbox" name="image" value="" /> Delete Image</label>
                    <input type="file" name="image" class="prettify">
                {% else %}
                    <input type="file" name="image" class="prettify">
                {% endif %}
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Minimum Lead Time</h4>
                <em>If this is set, somebody reserving this item must give this period of notice before their reservation.</em>
            </td>
            <td>
                {% set isEmpty = item.minLeadTime.secondTotal == 0 %}
                <label class="interval-input"><input type="text" value="{{ isEmpty ? '' : item.minLeadTime.dayTotal        }}" name="min_lead_time[day]"> days,</label>
                <label class="interval-input">
                    <div class="timepick">
                        <input type="text" value="{{ isEmpty ? '' : item.minLeadTime.hourRemainder   }}" name="min_lead_time[hour]" data-timepicker="hour">
                    </div>
                    hours,
                </label>
                <label class="interval-input">
                    <div class="timepick">
                        <input type="text" value="{{ isEmpty ? '' : item.minLeadTime.minuteRemainder }}" name="min_lead_time[minute]" data-timepicker="minute">
                    </div>
                    minutes
                </label>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Minimum Reservation Time</h4>
                <em>If this is set, this item must be reserved for at least this period of time.</em>
            </td>
            <td>
                {% set isEmpty = item.minReservationTime.secondTotal == 0 %}
                <label class="interval-input"><input type="text" value="{{ isEmpty ? '' : item.minReservationTime.dayTotal        }}" name="min_reservation_time[day]"> days,</label>
                <label class="interval-input">
                    <div class="timepick">
                        <input type="text" value="{{ isEmpty ? '' : item.minReservationTime.hourRemainder   }}" name="min_reservation_time[hour]" data-timepicker="hour">
                    </div>
                    hours,
                </label>
                <label class="interval-input">
                    <div class="timepick">
                        <input type="text" value="{{ isEmpty ? '' : item.minReservationTime.minuteRemainder }}" name="min_reservation_time[minute]" data-timepicker="minute">
                    </div>
                    minutes
                </label>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Maximum Reservation Time</h4>
                <em>If this is set, this item cannot be reserved for longer than this period.</em>
            </td>
            <td>
                {% set isEmpty = item.maxReservationTime.secondTotal == 0 %}
                <label class="interval-input"><input type="text" value="{{ isEmpty ? '' : item.maxReservationTime.dayTotal        }}" name="max_reservation_time[day]"> days,</label>
                <label class="interval-input"><input type="text" value="{{ isEmpty ? '' : item.maxReservationTime.hourRemainder   }}" name="max_reservation_time[hour]" data-timepicker="hour"> hours,</label>
                <label class="interval-input"><input type="text" value="{{ isEmpty ? '' : item.maxReservationTime.minuteRemainder }}" name="max_reservation_time[minute]" data-timepicker="minute"> minutes</label>
            </td>
        </tr>
    </table>

    <input id="resource-save"
           type="submit"
           value="{% if item.id %}Update{% else %}Create{% endif %}"
           class="submit-btn-plain"
    />

    {% if item.id and isRouteAuthorized('resourceItem.delete:post', {id: item.id, item: item}) %}
    <input id="resource-delete"
           type="submit"
           value="Delete"
           class="submit-btn-plain"
           data-action="{{ routeLookup('resourceItem.delete:post', {id: item.id}) }}"
    />
    {% endif %}
</form>
