{# I need some way of adding custom_head #}
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/jquery.selectizeSelector.js"></script>
<script type="text/javascript" src="/javascript/jquery.prettyFileInput.js"></script>
<script type="text/javascript" src="/javascript/tiny_mce/tiny_mce.js"></script>
<script type="text/javascript" src="/javascript/jquery.alaressTiny.js"></script>
<script type="text/javascript" src="/javascript/components/jquery-timepicker-jt/jquery.timepicker.min.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/jquery.hourpicker.js"></script>
<script type="text/javascript" src="/javascript/jquery.minutepicker.js"></script>

<script type="text/javascript">
    (function($){
        $(function(){
            $.fn.alaressTiny({
                mode: 'textareas'
            });

            // Hijack save form to allow delete
            var form = $('#resource-form');
            $(document).on('click', '#resource-delete', function(event) {
                event.preventDefault();

                var element = $(this);

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this item?',
                    confirmEvent: function() {
                        form.attr('action', $(element).data('action')).submit();
                    }
                });
            })

            // Add selectize for user selection and selector for related items
            form.find('select#resource-moderator-selector').selectizeSelector({
                ajax: {
                    url:      '/ajax/user.php',
                    type:     'GET',
                    data:     {roleTypeID: 'staff'},
                    dataType: 'json'
                },
                multiple: true,
                value: {{ moderatorList|json_encode|raw }}
            })
            form.find('select#resource-related-resource-selector').selectizeSelector({
                ajax: {
                    url:      {{ routeLookup('resourceItem.search', {id: item.id, format:'.json'}) | json_encode|raw}},
                    type:     'GET',
                    data:     {thisId: {{ item.id|json_encode|raw }}},
                    dataType: 'json'
                },
                multiple: true,
                value: {{ relatedItemList|json_encode|raw }}
            })

            form.find('input[type="file"].prettify').prettyFileInput({
                additionalButtonClasses: 'up-arrow no-marg float-right',
                buttonActiveClass: 'tick',
                defaultText: '<span></span>Upload Image',
                defaultFileSelectedText: '<span></span>File selected'
            });

            form.validate({
                rules: {
                    name: {
                        required: true,
                        minlength: 2
                    },
                    resource_category_id: {
                        min: 1
                    },
                    "min_lead_time[day]": {
                        digits: true
                    },
                    "min_reservation_time[day]": {
                        digits: true
                    },
                    "max_reservation_time[day]": {
                        digits: true
                    },
                    "min_lead_time[hour]": {
                        digits: true,
                        range: [0,23]
                    },
                    "min_reservation_time[hour]": {
                        digits: true,
                        range: [0,23]
                    },
                    "max_reservation_time[hour]": {
                        digits: true,
                        range: [0,23]
                    },
                    "min_lead_time[minute]": {
                        digits: true,
                        range: [0,59]
                    },
                    "min_reservation_time[minute]": {
                        digits: true,
                        range: [0,59]
                    },
                    "max_reservation_time[minute]": {
                        digits: true,
                        range: [0,59]
                    }
                },
                messages: {
                    resource_category_id:           "Please select a category.",
                    "min_reservation_time[day]":    "If entered, day count must be a number.",
                    "max_reservation_time[day]":    "If entered, day count must be a number.",
                    "min_lead_time[hour]":          "If entered, hour count must be a number from 0 to 23",
                    "min_reservation_time[hour]":   "If entered, hour count must be a number from 0 to 23",
                    "max_reservation_time[hour]":   "If entered, hour count must be a number from 0 to 23",
                    "min_lead_time[minute]":        "If entered, minute count must be a number from 0 to 59",
                    "min_reservation_time[minute]": "If entered, minute count must be a number from 0 to 59",
                    "max_reservation_time[minute]": "If entered, minute count must be a number from 0 to 59"
                },
                errorPlacement: function(error, element) {
                    switch (element.attr('name')) {
                        case "min_lead_time[day]":
                        case "min_reservation_time[day]":
                        case "max_reservation_time[day]":
                        case "min_lead_time[hour]":
                        case "min_reservation_time[hour]":
                        case "max_reservation_time[hour]":
                        case "min_lead_time[minute]":
                        case "min_reservation_time[minute]":
                        case "max_reservation_time[minute]":
                            element.parent().append(error)
                            break
                        default:
                            element.after(error)
                            break
                    }
                }
            })

            $('input[data-timepicker="hour"]').hourpicker({
                hours: 24,
                appendTo: function ($input) {
                    return $input.closest('.timepick');
                }
            });
            $('input[data-timepicker="minute"]').minutepicker({
                appendTo: function ($input) {
                    return $input.closest('.timepick');
                }
            });
        })
    })(jQuery);
</script>

<ul class="breadcrumb">
    <li><a href="/resource-booking/item">Resources</a></li>
    {% if item.id %}
    <li><a href="#">{{ item.name }}</a></li>
    <li class="active"><a href="#">Edit</a></li>
    {% else %}
    <li class="active"><a href="#">Add New</a></li>
    {% endif %}
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ item.name }}</h1>
        </div>
    </div>
    <nav>
        <a class="icon-more" title="" data-dropdown="header-options"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        {% if item.id and isRouteAuthorized('resourceItem.delete:post', {id: item.id, item: item}) %}
        <li><a id="resource-delete" title="Delete" class="icon-delete" data-action="{{ routeLookup('resourceItem.delete:post', {id: item.id}) }}">Delete</a></li>
        {% endif %}
    </ul>
</div>

<div class="row">
    <div class="small-12 island">
        <form id="resource-form" action="{% if item.id %}{{ routeLookup('resourceItem.update:post', {id: item.id}) }}{% else %}{{ routeLookup('resourceItem.create') }}{% endif %}" method="post" name="form" enctype="multipart/form-data">
            <input type="hidden" name="id" value="{{ item.id }}"/>

            <section>
                <fieldset class="content">
                    <legend>Resource Information</legend>
                    <div class="small-12 columns">
                        <label>
                            Name
                            <input class="required" name="name" type="text" value="{{ item.name }}" />
                        </label>

                        <label>
                            Description
                            <textarea name="description">{{ item.description }}</textarea>
                        </label>

                        <label>
                            Room Code
                            <span class="hint has-tip tip-top" data-tooltip title="If this resource is a room, enter its room code here. This will prevent the room from being booked when there is a class timetabled there.">?</span>
                            <input name="room_code" type="text" value="{{ item.roomCode }}" /></label>
                        </label>

                        <label>
                            Category
                            <select name="resource_category_id">
                                <option>-- select --</option>
                                {% for category in categoryList %}
                                    <option {{ category.id == item.category.id ? 'selected' : '' }}
                                            value="{{ category.id|e('html_attr') }}"
                                            label="{{ category.name|e('html_attr') }}"
                                            >{{ category.name }}</option>
                                {% endfor %}
                            </select>
                        </label>

                        <label>
                            Related Resources
                            <select id="resource-related-resource-selector" name="related_resource_id[]" multiple placeholder="Search Resources"></select>
                        </label>

                        <label>
                            Image
                        </label>
                        {% if item.image.hash %}
                            <input type="hidden" name="image" value="{{ item.image.hash }}">
                            <img src="/storage/image.php?size=constrain200&hash={{ item.image.hash|e('url') }}" />
                            <input id='delete-image' type="checkbox" name="image" value="" />
                            <label for="delete-image" class="checkbox-label">Delete Image</label>
                            <input type="file" name="image" class="prettify">
                        {% else %}
                            <input type="file" name="image" class="prettify">
                        {% endif %}
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Roles And Moderation</legend>
                    <div class="small-12 columns">
                        <label>
                            Allowed Roles
                            <span class="hint has-tip tip-top" data-tooltip title="Users in the selected roles will be able to book this resource. Moderators (whether for this item or the whole resource booking module) will be able to book this resource even if they aren't in a selected role.">?</span>
                        </label>

                        <input type="checkbox" id='select-all' value="1" />
                        <label for="select-all" class="checkbox-label">Select All</label>

                        <div data-allowed-roles>
                        {% for role in roleList %}
                            {# Default for new items: staff roles are selected, others are not #}
                            <input type="hidden" id="role[{{ role.id }}]" name="role[{{ role.id }}]" value="0" />
                            <input type="checkbox" name="role[{{ role.id }}]" value="1"
                                {% if item.id %}
                                    {% for resourceRole in item.roleList if resourceRole.role.id == role.id %}
                                        {% if resourceRole.allowed %}checked{% endif %}
                                    {% endfor %}
                                {% else %}
                                    {% if role.type == 'staff' %}checked{% endif %}
                                {% endif %}
                                />
                            <label for="role[{{ role.id }}]" class="checkbox-label">{{ role.name }}</label>
                        {% endfor %}
                        </div>

                        <label>
                            Moderation
                            <select name="resource_moderation_type_id">
                                {% for moderation in moderationList %}
                                    <option {{ moderation.id == item.moderationType.id ? 'selected' : '' }}
                                            value="{{ moderation.id|e('html_attr') }}"
                                            label="{{ moderation.name|e('html_attr') }}"
                                            >{{ moderation.name }}</option>
                                {% endfor %}
                            </select>
                        </label>

                        <label>
                            Moderators
                            <select id="resource-moderator-selector" name="moderator_id[]" multiple placeholder="Search Staff"></select>
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>
                        Minimum Lead Time
                        <span class='hint has-tip tip-top' data-tooltip title="If this is set, somebody reserving this item must give this period of notice before their reservation.">?</span>
                    </legend>
                    {% set isEmpty = item.minLeadTime.secondTotal == 0 %}
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Days
                            <input type="text" value="{{ isEmpty ? '' : item.minLeadTime.dayTotal }}" name="min_lead_time[day]">
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Hours
                            <div class="timepick">
                                <input type="text" value="{{ isEmpty ? '' : item.minLeadTime.hourRemainder }}" name="min_lead_time[hour]" data-timepicker="hour">
                            </div>
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Minutes
                            <div class="timepick">
                                <input type="text" value="{{ isEmpty ? '' : item.minLeadTime.minuteRemainder }}" name="min_lead_time[minute]" data-timepicker="minute">
                            </div>
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>
                        Minimum Reservation Time
                        <span class='hint has-tip tip-top' data-tooltip title="If this is set, this item must be reserved for at least this period of time.">?</span>
                    </legend>

                    <div class="small-4 columns">
                        {% set isEmpty = item.minReservationTime.secondTotal == 0 %}
                        <label class="interval-input">
                            Days
                            <input type="text" value="{{ isEmpty ? '' : item.minReservationTime.dayTotal }}" name="min_reservation_time[day]">
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Hours
                            <div class="timepick">
                                <input type="text" value="{{ isEmpty ? '' : item.minReservationTime.hourRemainder }}" name="min_reservation_time[hour]" data-timepicker="hour">
                            </div>
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Minutes
                            <div class="timepick">
                                <input type="text" value="{{ isEmpty ? '' : item.minReservationTime.minuteRemainder }}" name="min_reservation_time[minute]" data-timepicker="minute">
                            </div>
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>
                        Maximum Reservation Time
                        <span class='hint has-tip tip-top' data-tooltip title="If this is set, this item cannot be reserved for longer than this period.">?</span>
                    </legend>
                    <div class="small-12 columns">
                        <label>
                        </label>
                    </div>
                    <div class="small-4 columns">
                        {% set isEmpty = item.maxReservationTime.secondTotal == 0 %}
                        <label class="interval-input">
                            Days
                            <input type="text" value="{{ isEmpty ? '' : item.maxReservationTime.dayTotal        }}" name="max_reservation_time[day]">
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Hours
                            <input type="text" value="{{ isEmpty ? '' : item.maxReservationTime.hourRemainder   }}" name="max_reservation_time[hour]" data-timepicker="hour">
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Minutes
                            <input type="text" value="{{ isEmpty ? '' : item.maxReservationTime.minuteRemainder }}" name="max_reservation_time[minute]" data-timepicker="minute">
                        </label>
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <input id="resource-save" type="submit" value="{% if item.id %}Update{% else %}Create{% endif %}" />
                </div>
            </div>
        </form>
    </div>
</div>