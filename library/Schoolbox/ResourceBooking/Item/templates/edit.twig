{# I need some way of adding custom_head #}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/select-all/attacher.select-all.js?v={{ config.site_version }}"></script>

<script type="text/javascript">
    (function($){
        $(function(){
            $.fn.alaressEditor();

            // Hijack save form to allow delete
            var form = $('#resource-form');
            $(document).on('click', '#resource-delete', function(event) {
                event.preventDefault();

                var element = $(this);

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this Resource?',
                    confirmLabel: 'Delete',
                    confirmEvent: function() {
                        form.attr('action', $(element).data('action')).submit();
                    }
                });
            })

            // Add selectize for user selection and selector for related items
            form.find('select#resource-moderator-selector').selectizeSelector({
                ajax: {
                    url:      '/ajax/user.php',
                    type:     'GET',
                    data:     {roleTypeID: 'staff'},
                    dataType: 'json'
                },
                multiple: true,
                value: {{ moderatorList|json_encode|raw }}
            })
            form.find('select#resource-related-resource-selector').selectizeSelector({
                ajax: {
                    url:      {{ routeLookup('resourceItem.search', {id: item.id, format:'.json'}) | json_encode|raw}},
                    type:     'GET',
                    data:     {thisId: {{ item.id|json_encode|raw }}},
                    dataType: 'json'
                },
                multiple: true,
                value: {{ relatedItemList|json_encode|raw }}
            })

            form.alaressValidate({
                rules: {
                    name: {
                        minlength: 2
                    },
                    resource_category_id: {
                        min: 1
                    },
                    "min_lead_time[day]": {
                        digits: true
                    },
                    "min_reservation_time[day]": {
                        digits: true
                    },
                    "max_reservation_time[day]": {
                        digits: true
                    },
                    "min_lead_time[hour]": {
                        digits: true,
                        range: [0,23]
                    },
                    "min_reservation_time[hour]": {
                        digits: true,
                        range: [0,23]
                    },
                    "max_reservation_time[hour]": {
                        digits: true,
                        range: [0,23]
                    },
                    "min_lead_time[minute]": {
                        digits: true,
                        range: [0,59]
                    },
                    "min_reservation_time[minute]": {
                        digits: true,
                        range: [0,59]
                    },
                    "max_reservation_time[minute]": {
                        digits: true,
                        range: [0,59]
                    }
                },
                messages: {
                    resource_category_id:           "Please select a category.",
                    "min_reservation_time[day]":    "If entered, day count must be a number.",
                    "max_reservation_time[day]":    "If entered, day count must be a number.",
                    "min_lead_time[hour]":          "If entered, hour count must be a number from 0 to 23",
                    "min_reservation_time[hour]":   "If entered, hour count must be a number from 0 to 23",
                    "max_reservation_time[hour]":   "If entered, hour count must be a number from 0 to 23",
                    "min_lead_time[minute]":        "If entered, minute count must be a number from 0 to 59",
                    "min_reservation_time[minute]": "If entered, minute count must be a number from 0 to 59",
                    "max_reservation_time[minute]": "If entered, minute count must be a number from 0 to 59"
                },
                errorPlacement: function(error, element) {
                    switch (element.attr('name')) {
                        case "min_lead_time[day]":
                        case "min_reservation_time[day]":
                        case "max_reservation_time[day]":
                        case "min_lead_time[hour]":
                        case "min_reservation_time[hour]":
                        case "max_reservation_time[hour]":
                        case "min_lead_time[minute]":
                        case "min_reservation_time[minute]":
                        case "max_reservation_time[minute]":
                            element.parent().append(error)
                            break
                        default:
                            $.alaressValidate.defaultErrorPlacement(error, element);
                            break
                    }
                }
            })
        })
    })(jQuery);
</script>

<ul class="breadcrumb">
    <li><a href="/resource-booking/item">Resources</a></li>
    {% if item.id %}
    <li><a href="{{ routeLookup('resourceItem.read', {id: item.id}) }}">{{ item.name }}</a></li>
    <li class="active"><span>Edit</span></li>
    {% else %}
    <li class="active"><span>Add New</span></li>
    {% endif %}
</ul>

{% if item.id  %}
<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ item.name }}</h1>
        </div>
    </div>
    <nav>
        <a class="icon-more" title="Actions" data-dropdown="header-options"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        {% if item.id and isRouteAuthorized('resourceItem.delete:post', {id: item.id, item: item}) %}
        <li><a id="resource-delete" title="Delete" class="icon-delete" data-action="{{ routeLookup('resourceItem.delete:post', {id: item.id}) }}">Delete</a></li>
        {% endif %}
    </ul>
</div>
{% else %}
<div class="row">
    <div class="small-12 columns">
        <h1>Add New Resource</h1>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <form id="resource-form" action="{% if item.id %}{{ routeLookup('resourceItem.update:post', {id: item.id}) }}{% else %}{{ routeLookup('resourceItem.create') }}{% endif %}" method="post" name="form" enctype="multipart/form-data">
            <input type="hidden" name="id" value="{{ item.id }}"/>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="name" class="required">Name</label>
                        <input name="name" id="name" type="text" value="{{ item.name }}" maxlength="250" required />

                        <label>
                            Description
                            <textarea name="description">{{ item.description }}</textarea>
                        </label>

                        <label>
                            Room Code
                            <span class="hint has-tip tip-top" data-tooltip title="If this resource is a room, enter its room code here. This will prevent the room from being booked when there is a class timetabled there.">?</span>
                            <input name="room_code" type="text" value="{{ item.roomCode }}" /></label>
                        </label>

                        <label for="resource_category" class="required">Category</label>
                        <select name="resource_category_id" id="resource_category">
                            <option>-- select --</option>
                            {% for category in categoryList %}
                                <option {{ item.category and category.id == item.category.id ? 'selected' : '' }}
                                        value="{{ category.id|e('html_attr') }}"
                                        label="{{ category.name|e('html_attr') }}"
                                        >{{ category.name }}</option>
                            {% endfor %}
                        </select>

                        <label>
                            Related Resources
                            <select id="resource-related-resource-selector" name="related_resource_id[]" multiple placeholder="Search Resources"></select>
                        </label>

                        <label>
                            Image
                        </label>
                        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Permissions</legend>
                    <div class="small-12 columns">
                        <label>
                            Allowed Roles
                            <span class="hint has-tip tip-top" data-tooltip title="Users in the selected roles will be able to book this resource. Moderators (whether for this item or the whole resource booking module) will be able to book this resource even if they aren't in a selected role.">?</span>
                        </label>

                        <input type="checkbox" id='select-all' value="1" data-select-all data-select-all-for-group="role"/>
                        <label for="select-all" class="checkbox-label">Select All</label>

                        <div data-allowed-roles>
                        <ul class="option-list">
                        {% for role in roleList %}
                            <li>
                                {# Default for new items: staff roles are selected, others are not #}
                                <input type="hidden" name="role[{{ role.id }}]" value="0" />
                                <input type="checkbox" name="role[{{ role.id }}]" id="role[{{ role.id }}]" value="1"
                                    data-select-all-group="role"
                                    {% if item.id %}
                                        {% for resourceRole in item.roleList | filter(resourceRole => resourceRole.role.id == role.id )  %}
                                            {% if resourceRole.allowed %}checked{% endif %}
                                        {% endfor %}
                                    {% else %}
                                        {% if role.type == 'staff' %}checked{% endif %}
                                    {% endif %}
                                    />
                                <label for="role[{{ role.id }}]" class="checkbox-label">{{ role.name }}</label>
                            </li>
                        {% endfor %}
                        </ul>
                        </div>

                        <label>
                            Moderation
                            <select name="resource_moderation_type_id">
                                {% for moderation in moderationList %}
                                    <option {{ item.moderationType and moderation.id == item.moderationType.id ? 'selected' : '' }}
                                            value="{{ moderation.id|e('html_attr') }}"
                                            label="{{ moderation.name|e('html_attr') }}"
                                            >{{ moderation.name }}</option>
                                {% endfor %}
                            </select>
                        </label>

                        <label>
                            Moderators
                            <select id="resource-moderator-selector" name="moderator_id[]" multiple placeholder="Search Staff"></select>
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>
                        Minimum Lead Time
                        <span class='hint has-tip tip-top' data-tooltip title="If this is set, somebody reserving this item must give this period of notice before their reservation.">?</span>
                    </legend>
                    {% set isEmpty = item.minLeadTime.secondTotal ?? 0 == 0 %}
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Days
                            <input type="text" inputmode="numeric"
                                   value="{{ isEmpty ? '' : item.minLeadTime.dayTotal }}"
                                   name="min_lead_time[day]"
                            >
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Hours
                            <input type="text"
                                   inputmode="numeric"
                                   min="0"
                                   max="23"
                                   value="{{ isEmpty ? '' : item.minLeadTime.hourRemainder }}"
                                   name="min_lead_time[hour]"
                            >
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Minutes
                            <input type="text"
                                   inputmode="numeric"
                                   min="0"
                                   max="59"
                                   value="{{ isEmpty ? '' : item.minLeadTime.minuteRemainder }}"
                                   name="min_lead_time[minute]"
                            >
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>
                        Minimum Reservation Time
                        <span class='hint has-tip tip-top' data-tooltip title="If this is set, this item must be reserved for at least this period of time.">?</span>
                    </legend>

                    <div class="small-4 columns">
                        {% set isEmpty = item.minReservationTime.secondTotal ?? 0 == 0 %}
                        <label class="interval-input">
                            Days
                            <input type="text"
                                   inputmode="numeric"
                                   value="{{ isEmpty ? '' : item.minReservationTime.dayTotal }}"
                                   name="min_reservation_time[day]"
                            >
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Hours
                            <input type="text"
                                   inputmode="numeric"
                                   min="0"
                                   max="23"
                                   value="{{ isEmpty ? '' : item.minReservationTime.hourRemainder }}"
                                   name="min_reservation_time[hour]"
                            >
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Minutes
                            <input type="text"
                                   inputmode="numeric"
                                   min="0"
                                   max="59"
                                   value="{{ isEmpty ? '' : item.minReservationTime.minuteRemainder }}"
                                   name="min_reservation_time[minute]"
                            >
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>
                        Maximum Reservation Time
                        <span class='hint has-tip tip-top' data-tooltip title="If this is set, this item cannot be reserved for longer than this period.">?</span>
                    </legend>
                    <div class="small-12 columns">
                        <label>
                        </label>
                    </div>
                    <div class="small-4 columns">
                        {% set isEmpty = item.maxReservationTime.secondTotal ?? 0 == 0 %}
                        <label class="interval-input">
                            Days
                            <input type="text"
                                   inputmode="numeric"
                                   value="{{ isEmpty ? '' : item.maxReservationTime.dayTotal }}"
                                   name="max_reservation_time[day]">
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Hours
                            <input type="text"
                                   inputmode="numeric"
                                   min="0"
                                   max="23"
                                   value="{{ isEmpty ? '' : item.maxReservationTime.hourRemainder }}"
                                   name="max_reservation_time[hour]"
                            >
                        </label>
                    </div>
                    <div class="small-4 columns">
                        <label class="interval-input">
                            Minutes
                            <input type="text"
                                   inputmode="numeric"
                                   min="0"
                                   max="59"
                                   value="{{ isEmpty ? '' : item.maxReservationTime.minuteRemainder }}"
                                   name="max_reservation_time[minute]"
                            >
                        </label>
                    </div>
                </fieldset>
                <fieldset>
                    <legend>
                        Restrict bookings to current {{ locale.term }}
                        <span class='hint has-tip tip-top' data-tooltip title="If this is set, this item cannot be reserved outside of the current {{ locale.term }}">?</span>
                    </legend>
                    <div class="small-12 columns">
                        <div class="switch">
                            <input type="checkbox" value="1" {% if item.currentTermRestriction %}checked{% endif %} id="current_term_restriction" name="current_term_restriction">
                            <label for="current_term_restriction">
                                <span>On</span>
                                <span>Off</span>
                            </label>
                        </div>
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <input id="resource-save" type="submit" value="{% if item.id %}Update{% else %}Create{% endif %}" />
                </div>
            </div>
        </form>
    </div>
</div>
