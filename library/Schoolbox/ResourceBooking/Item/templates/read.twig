{#
    item         ResourceBooking\Item\Model
    search       string                      TODO, investigate this as it appears to never be provided by any current usage
    token        string
    selectedDate string|DateTime|DateInterval Passed to twig 'date' filter, see https://twig.symfony.com/doc/3.x/filters/date.html
    calendarView string
    currentTerm  Term\Model
#}

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('resourceItem.browse') }}">Resources</a></li>
    <li><a href="{{ routeLookup('resourceItem.browse') }}?category={{ item.category.id|e('url') }}" >{{ item.category.name }}</a></li>
    <li class="active"><a href="#">{% include '@resourceItem/sub/itemName.twig' with {item: item} %}</a></li>
</ul>

<div class="actions-small-3 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{% include '@resourceItem/sub/itemName.twig' with {item: item} %}</h1>

            <ul class="meta">
                {% if item.moderatorList is not empty %}
                    <li class="icon-staff-students">
                        {% include '@resourceItem/sub/moderated.twig' with {item: item} %}
                        {% include '@resourceItem/sub/moderatorList.twig' with {moderatorList: item.moderatorList} %}
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
    <nav>
        <a class="icon-eye" data-reveal-id="dialog-description" title="View Description"></a>
        <a class="icon-search" data-reveal-id="search-modal" title="Search Resources"></a>
        {% if isRouteAuthorized('resourceItem.edit', {id: item.id, item: item}) %}
            <a class="resource-name resource-edit-link icon-modify" id="resource-edit-{{item.id}}" title="Edit" rel="edit-form" href="{{ routeLookup('resourceItem.edit', {id: item.id}) }}"></a>
        {% endif %}
    </nav>
</div>

<div id="search-modal" class="reveal-modal" data-reveal>
    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">Search Resources</h2>
            <section>
                <form action="{{ routeLookup('resourceItem.browse') }}" method="get">
                    <input type="search" id="resource-search-term" placeholder="Search Resources" name="search" value="{{ search|default('') }}" />
                    <input type="submit" id="resource-search" value="Search" class="expand" />
                </form>
            </section>
        </div>
    </div>

    <a class="close-reveal-modal">&#215;</a>
</div>

<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">
            Bookings
            <span class="hint has-tip tip-top" data-tooltip title="Click the calendar to add a booking for that time.">?</span>
        </h2>
    </div>
</div>

{% autoescape 'js' %}
    <script type="text/javascript">
        // Which view gets shown?
        var anchorView = '',
            parts      = location.href.split('#');

        if (parts.length > 1) {
            anchorView = parts[1];
            switch (anchorView) {
                case 'month':
                    anchorView = 'dayGridMonth';
                    break;
                case 'week':
                case 'agendaWeek':
                case 'basicWeek':
                    anchorView = 'timeGridWeek';
                    break;
                case 'day':
                case 'agendaDay':
                case 'basicDay':
                    anchorView = 'timeGridDay';
                    break;
                default:
                    anchorView = '';
                    break;
            }
        }

        window.fullCalendarConfig = {
            token:                  '{{ token }}',
            selectedFilters:        [1,2],
            defaultDate:            '{{ selectedDate|date('Y-m-d') }}',
            eventLimit:             Boolean('{{ config.calendar_collapse_events }}'),
            firstDay:               Number('{{ config.calendar_start_day }}'),
            defaultView:            anchorView || '{{ calendarView }}',
            dateDisplayFormats:     dateDisplayFormats,
            resourceBookingEndpoint:{{ routeLookup('resourceBooking.bookingCalendar', {id: item.id})|json_encode|raw }},
            bookingIsAuthorized:    Boolean('{{ isRouteAuthorized('resourceBooking.book', {id: item.id, item: item}) }}'),
            createBookingPath:      {{ routeLookup('resourceBooking.book', {id: item.id})|json_encode|raw }},
            resourceId:             Number('{{ item.id }}')
        };
    </script>
{% endautoescape %}

<div class="row">
    <div class="small-12 island">
        <section>
            <div id="calendar"></div>
        </section>
    </div>
</div>

<script type="text/javascript" src="/javascript/components/resourceBookingItemCalendar.bundle.js"></script>

{# Dialog for showing description and rules #}
<div class="reveal-modal" data-reveal aria-labelledby="dialog-description-title" aria-hidden="true" role="dialog" id="dialog-description">
    <div class="row">
        <div class="small-12 island">
            <div class="row">
                <div class="small-12 columns">
                    <h2 id="dialog-description-title">{% include '@resourceItem/sub/itemName.twig' with {item: item} %}</h2>
                </div>
            </div>
            <div class="row">
                <div class="small-12 medium-4 large-5 columns">
                    <section class="content">
                        {% if item.image.hash %}
                            <img src="/storage/image.php?size=maxsize&hash={{ item.image.hash|e('url') }}" />
                        {% endif %}
                    </section>
                </div>
                <div class="small-12 medium-8 large-7 columns">
                    <section class="content">
                        {# Resource manager: could be set in the edit form, or the default resource manager #}
                        <article>{{ item.description|purify }}</article>

                        <h3>Rules</h3>
                        {% include '@resourceItem/sub/rules.twig' with {item: item} %}
                    </section>
                </div>
            </div>
        </div>
    </div>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>
