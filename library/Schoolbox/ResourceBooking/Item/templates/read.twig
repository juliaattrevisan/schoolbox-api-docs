<style type="text/css">
    .fc .fc-event.booking.approved .fc-event-inner:before {
        content: '✓';
    }
    .fc .fc-event.booking.rejected {
        font-style: italic;
        text-decoration: line-through;
    }
</style>

<script type="text/javascript" src="/javascript/jquery.calendar_export.js"></script>
<script type="text/javascript" src="/javascript/jquery.fullcalendar.js"></script>
<script type="text/javascript">

    // provide page-wide access to the calendar object so the callbacks can actually use it
    //var c;

    // once the DOM has loaded, punch a fancy calendar into it
    $(document).ready(function() {
        var now = new Date();
        var c   = new Calendar('calendar', 'calendar-bubble', {
//            crud: {
//                c: '/calendar/ajax/create',
//                // r: don't need it
//                u: '/calendar/ajax/update',
//                d: '/calendar/ajax/delete'
//            },
            filter: {
                enabled: true,
                ajax: false,
                // This AJAX lookup should always be a GET request
                parentSelector: '#calendar-controls',
                exportButtonSelector: false,
                checkboxSelector: false,
                applyFiltersSelector: false
            },
            fullCalendar: {
                firstHour: 9,
                allDaySlot: false,
                date:  now.getDate(),
                month: now.getMonth(),
                year:  now.getFullYear(),
                columnFormat: 'ddd d/M',
                defaultView: 'month',
                timeFormat: { month: 'h(:mm)tt' },
                events: function(start, end, callback) {
                    var data = [
                        {name: 'start', value: Math.round(start.getTime()/1000)},
                        {name: 'end',   value: Math.round(end.getTime()/1000)},
                    ];
                    $.ajax({
                        data:     data.concat($('#calendar-controls').find('form').serializeArray()),
                        dataType: 'json',
                        url:      {{ routeLookup('resourceBooking.bookingCalendar', {id: item.id})|json_encode|raw }},
                        success: function(data) {
                            callback(data);
                        },
                        cache: false
                    });
                },
                loading: function(isLoading) {
                    if (isLoading === true) {
                        $('#calendar-loading').css({
                            top: ($j('#calendar').height() - $j('#calendar-loading').height())/2,
                            left: ($j('#calendar').width() - $j('#calendar-loading').width())/2
                        }).show();
                    }
                    else {
                        $('#calendar-loading').hide();
                    }
                },
                /**
                 * Event rendering: put the event's start and end time into data
                 */
                eventRender: function(event, element) {
                    // formatDate has no timezone support, and ISO 8601 outputs
                    // a Z as timezone always. Fail!
                    var getTimeWithTimezone = function(date) {
                        var offset = date.getTimezoneOffset()
                        var sign   = '';
                        if (offset === 0) {
                            return 'Z'
                        }
                        if (offset < 0) {
                            // < 0 actually means +xxxx
                            sign   = '+'
                            offset = offset * -1
                        }
                        else {
                            sign = '-'
                        }
                        var hours = String(Math.floor(offset / 60))
                        if (hours.length === 1) {
                            hours = '0' + hours;
                        }
                        var minutes = String(offset % 60)
                        if (minutes.length === 1) {
                            minutes = '0' + minutes;
                        }
                        return $.fullCalendar.formatDate(date, "yyyy-MM-dd'T'HH:mm:ss") + sign + hours + ':' + minutes
                    }
                    // Set data as attributes, that way selectors can query them
                    element.attr({
                        'data-start':  getTimeWithTimezone(event.start),
                        'data-end':    getTimeWithTimezone(event.end),
                        'data-allday': event.allDay ? 1 : 0
                    })
                    return element
                },
                /**
                 * When an event is clicked
                 *
                 * @param calEvent
                 * @param jsEvent
                 */
                eventClick: function(calEvent, jsEvent) {

                    // setup data to be displayed
                    var data = $j.extend(true, {}, calEvent.data.meta)

                    // Note: depends on whether this item is approved, rejected or
                    // pending.
                    data.note = '('+calEvent.data.booking.status.name+') '+calEvent.title

                    data.date = calendarDate(calEvent.start)
                    data.date += " &ndash; "
                    data.date += calendarDate(calEvent.end)

                    // Custom butonyes for bookings
                    data.actions = []
                    $.each(calEvent.data.booking.buttons, function() {
                        data.actions.push(
                                $('<a class="btn float-right" />')
                                        .addClass(this.class)
                                        .attr('href', this.href)
                                        .text(this.label)
                                        .prepend('<span />')
                        )
                    })
                    c.bubble.display('edit', data, jsEvent, this)
                },

                /**
                 * Event that is triggered when clicking on a calendar day or time.
                 *
                 * @param date
                 * @param allDay
                 * @param jsEvent
                 */
                dayClick: function(date, allDay, jsEvent) {
                    // Bookings may not be made in the past.
                    var dateFormat = allDay ? 'ddd d MMMM' : 'h(:mm)tt, ddd d MMMM';
                    var eventData  = {
                        startDate:   $.fullCalendar.formatDate(date, 'yyyy-MM-dd'),
                        displayDate: $.fullCalendar.formatDate(date, dateFormat)
                    }
                    if (!allDay) {
                        eventData.startTime = $.fullCalendar.formatDate(date, 'HH:mm')
                    }
                    c.bubble.display('create', eventData, jsEvent, this)
                },
                eventStartEditable: false
            },
            x: false
        }).init()

        // Event filter - reload events when the filter button is pressed.
        $('#calendar-controls').on('click', 'a#applyFilters', function(event) {
            event.preventDefault()
            c.dom.fullCalendar('refetchEvents')
        })
    })
</script>

<!-- END custom_header -->


<h1>Resource - {{ item.name }}</h1>

<p class="description">
    {% if item.image.hash %}
        <img src="/storage/image.php?size=constrain200&hash={{ item.image.hash|e('url') }}" />
    {% endif %}
    {{ item.description|e|nl2br }}
</p>

<p class="category">
    Category: <a href="{{ routeLookup('resourceCategory.read', {id: item.category.id}) }}" >{{ item.category.name }}</a>
</p>

{# Resource manager: could be set in the edit form, or the default resource manager #}
<p class="management">
    Resource managed by: somebody
</p>

<h2>Rules</h2>
<ul>
    {% if item.minLeadTime.minuteTotal %}
    <li>
        Must be booked
        {# Piece together a format - %D days, %H hours, %I minutes #}
        {% spaceless %}
        {% if item.minLeadTime.dayTotal %}
            {{ item.minLeadTime.dayTotal }} day(s)
            {%- if item.minLeadTime.hourRemainder -%}
                , {{ item.minLeadTime.hourRemainder }} hour(s)
            {%- endif -%}
            {%- if item.minLeadTime.minuteRemainder -%}
                , {{ item.minLeadTime.minuteRemainder }} minute(s)
            {%- endif -%}
        {% elseif item.minLeadTime.hourTotal %}
            {{ item.minLeadTime.hourTotal }} hour(s)
            {%- if item.minLeadTime.minuteRemainder -%}
                , {{ item.minLeadTime.minuteRemainder }} minute(s)
            {%- endif -%}
        {% elseif item.minLeadTime.minuteRemainder %}
            {{ item.minLeadTime.minuteRemainder }} minute(s)
        {% endif %}
        in advance.
        {% endspaceless %}
    </li>
    {% endif %}

    {% if item.minReservationTime.minuteTotal %}
        <li>
            {% spaceless %}
            Must be booked for at least
            {% if item.minReservationTime.dayTotal %}
                {{ item.minReservationTime.dayTotal }} day(s)
                {%- if item.minReservationTime.hourRemainder -%}
                    , {{ item.minReservationTime.hourRemainder }} hour(s)
                {%- endif -%}
                {%- if item.minReservationTime.minuteRemainder -%}
                    , {{ item.minReservationTime.minuteRemainder }} minute(s)
                {%- endif -%}
            {% elseif item.minReservationTime.hourTotal %}
                {{ item.minReservationTime.hourTotal }} hour(s)
                {% if item.minReservationTime.minuteRemainder %}
                    , {{ item.minReservationTime.minuteRemainder }} minute(s)
                {% endif %}
            {% elseif item.minReservationTime.minuteRemainder %}
                {{ item.minReservationTime.minuteRemainder }} minute(s)
            {% endif %}.
            {% endspaceless %}
        </li>
    {% endif %}

    {% if item.maxReservationTime.minuteTotal %}
        <li>
            {% spaceless %}
            May not be booked for more than
            {% if item.maxReservationTime.dayTotal %}
                {{ item.maxReservationTime.dayTotal }} day(s)
                {%- if item.maxReservationTime.hourRemainder -%}
                    , {{ item.maxReservationTime.hourRemainder }} hour(s)
                {%- endif -%}
                {%- if item.maxReservationTime.minuteRemainder -%}
                    , {{ item.maxReservationTime.minuteRemainder }} minute(s)
                {%- endif -%}
            {% elseif item.maxReservationTime.hourTotal %}
                {{ item.maxReservationTime.hourTotal }} hour(s)
                {%- if item.maxReservationTime.minuteRemainder -%}
                    , {{ item.maxReservationTime.minuteRemainder }} minute(s)
                {%- endif -%}
            {% elseif item.maxReservationTime.minuteRemainder %}
                {{ item.maxReservationTime.minuteRemainder }} minute(s)
            {% endif %}.
            {% endspaceless %}
        </li>
    {% endif %}

    {# Booking moderation status #}
    {% if item.moderationType.open %}
        <li>This item may be booked by anybody, and the booking will be automatically confirmed.</li>
    {% endif %}
    {% if item.moderationType.moderated %}
        <li>This item may be booked by anybody, but the booking must be confirmed by a moderator.</li>
    {% endif %}
    {% if item.moderationType.managed %}
        <li>This item may only be booked by its moderators.</li>
    {% endif %}
</ul>

<div id="calendar-loading">
    <p><strong>Loading events...</strong></p>
</div>

{# Forms for calendar bubbles #}
<div id="calendar-bubble" class="cal-bubble">
    <div class="middle">
        <div class="close">&times;</div>
        <div class="js-data clearfix">

            {#
             # Create Event Form
             # calendar adds a form listener, which I don't want.
             #}
            <form id="createEvent" data-no-calendar-listener="" method="get" action="{{ routeLookup('resourceBooking.book', {id: item.id}) }}">
                <input type="hidden" name="startDate" />
                <input type="hidden" name="startTime" />
                {# In this case, item ID is preset #}
                Create booking for: <span class="displayDate"></span>
                <div class="actions">
                    <input class="btn float-right modify no-icon" type="submit" value="Continue" />
                </div>
            </form>

            <form id="editEvent">
                <input type="hidden" name="eventId" />
                <dl>
                    <dd><h3 class="note"></h3></dd>
                    <dd><h4><span class="date"></span></h4></dd>
                    <dd><p class="location"></p></dd>
                    <dd><p class="detail wysiwyg"></p></dd>
                    <dd class="post-by">Requested by <a class="author" href="#"></a></dd>
                </dl>
                <div class="actions">
                </div>
            </form>
        </div>
        <div class="bottom"><strong></strong></div>
    </div>
</div>

{##
 # Calendar controls
 # Add the popup event
 #}
<div id="calendar-controls" class="calendar-controls no-height clearfix">
    <div class="link-case">
        <div class="filter-drop clearfix">
            <div class="filter-list">
                <form class="clearfix">
                    <div class="filter-cat groups clearfix"><span class="filter-title">Status</span>
                        <label title="Pending">
                            <input type="checkbox" name="status[]" value="1" class="checkbox" checked />
                            Pending
                        </label>
                        <label title="Approved">
                            <input type="checkbox" name="status[]" value="2" class="checkbox" checked />
                            Approved
                        </label>
                        <label title="Rejected">
                            <input type="checkbox" name="status[]" value="3" class="checkbox"/>
                            Rejected
                        </label>
                    </div>
                </form>
                <p class="clearfix">
                    <a href="#" id="applyFilters" class="btn float-right"><span></span>Apply Filters</a>
                </p>
                <!--/filter-drop-->
            </div>
        </div>
    </div>
</div>

<h2>Bookings - click the calendar to add a booking for that time</h2>
<div id="calendar"></div>
