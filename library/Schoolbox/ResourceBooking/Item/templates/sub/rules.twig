{# Booking rules for a resource. #}
<ul>
    {% if item.minLeadTime.minuteTotal %}
        <li>
            Must be booked at least
            {% include 'sub/interval.twig' with {interval: item.minLeadTime} %}
            in advance.
        </li>
    {% endif %}

    {% if item.minReservationTime.minuteTotal %}
        <li>
            Must be booked for at least
            {% include 'sub/interval.twig' with {interval: item.minReservationTime} %}.
        </li>
    {% endif %}

    {% if item.maxReservationTime.minuteTotal %}
        <li>
            May not be booked for more than
            {% include 'sub/interval.twig' with {interval: item.maxReservationTime} %}.
        </li>
    {% endif %}

    {% if item.currentTermRestriction %}
        <li>
            This item cannot be booked beyond <strong>{{ currentTerm.displayFinish.longDateOnly }}</strong>, the end of the current school {{ locale.term }}.
        </li>
    {% endif %}

    {# Booking moderation status #}

    {# Are any roles allowed to book this? #}
    {% set bookableByRole = false %}
    {% for role in item.getRoleList() %}
        {% if role.getAllowed() %}
            {% set bookableByRole = true %}
        {% endif %}
    {% endfor %}

    {% if item.moderationType.managed or not bookableByRole %}
        <li>This item may only be booked by its moderators.</li>
    {% else %}
        <li>
            This item may be booked by any member of these roles:
            <ul>
                {% for role in item.getRoleList() %}
                    {% if role.getAllowed() %}
                        <li>{{ role.getRole().getName() }}</li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>
        <li>
            {% if item.moderationType.open %}
                Your booking will be automatically confirmed.
            {% endif %}
            {% if item.moderationType.moderated %}
                Your booking must be confirmed by a moderator.
            {% endif %}
        </li>
    {% endif %}
</ul>
