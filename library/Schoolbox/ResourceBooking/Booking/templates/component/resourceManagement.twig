<script type="text/javascript">
    $(function(){

        var component = $('#component{{ component.instance.id }}');

        var updateSeriesDialog = component.find('[data-role="bulk-update-dialog"]').dialog({
            autoOpen:false,
            resizable:false,
            height:180,
            width:400,
            modal:true,
            draggable:false,
            close: function () {
                return false;
            }
        });

        // Series bookings
        component.on('click', '[data-set-status]', function(event) {
            var link     = $(this);
            var seriesId = link.data('seriesId');
            if (seriesId) {
                event.preventDefault();
                // Remove all previous change status events, and reapply to this
                // dialog box.
                updateSeriesDialog.find('[data-role="action-text"]')
                    .text($(this).text().toLowerCase());
                updateSeriesDialog
                    .dialog(
                        'option',
                        'buttons',
                        [{
                            text: "Only this booking",
                            click: function () {
                                updateSeriesDialog.dialog('close');
                                window.location.href = link.attr('href');
                            }
                        }, {
                            text: "All bookings in the series",
                            click: function () {
                                updateSeriesDialog.dialog('close');
                                window.location.href = link.attr('href') + '?efficacy=series';
                            }
                        }]
                    )
                    .dialog('open')
            }

        });
    });
</script>
<ul class="information-list">
    {% for item in bookingsByResource %}
    <li class="row">
        {# Show image for item if it's there, otherwise some empty image? #}
        <div class="small-12 columns no-pad">
            <div class="avatar card">
                <a href="{{ routeLookup('resourceItem.read', {id: item.resource.id}) }}">
                    {% if item.resource.image.hash %}
                        <img src="/storage/image.php?size=square64&amp;hash={{ item.resource.image.hash|e('url') }}" />
                    {% else %}
                        {# this icon needs to be responsive to screen size #}
                        <span class="icon-resource-booking icon-64 no-text"></span>
                    {% endif %}
                    <h3>{{ item.resource.name }}</h3>
                </a>
            </div>

            <div class="list-item-content">
                <ul class="action-list">
                    {% for event in item.bookingEvents %}
                        <li class="row" data-equalizer>
                            <div class="small-10 column no-pad" data-equalizer-watch>
                                {# show booker's avatar card #}
                                <div class="avatar card">
                                    <a href="/search/user/{{ event.booking.event.owner.id }}">
                                        <img src="/portrait.php?userId={{ event.booking.event.owner.externalId|e('url') }}&amp;size=square64" />
                                    </a>

                                    <h4>
                                        {% include 'sub/timespan.twig' with {
                                        start: event.booking.event.startDateTime,
                                        end:   event.booking.event.endDateTime
                                        } %}
                                    </h4>

                                    <p class="meta">
                                        Requested by
                                        <a href="/search/user/{{ event.booking.event.owner.id }}">{{ event.booking.event.owner.formatName }}</a>
                                        on <time datetime="{{ event.booking.createdAt.database }}">{{ event.booking.createdAt.short }}</time>
                                        {% if event.booking.event.owner.id != event.booking.event.author.id %}
                                            by
                                            <a href="/search/user/{{ event.booking.event.owner.id }}">{{ event.booking.event.owner.formatName }}</a>
                                        {% endif %}
                                    </p>
                                </div>
                            </div>

                            <div class="two actions">
                                <a class="icon-modify no-text" href="/resource-booking/booking/{{ event.booking.id }}/edit" title="Modify Booking"></a>
                                <a href="#" data-equalizer-watch data-dropdown="resourceManagement-status-{{ event.booking.id }}" aria-controls="resourceManagement-status-{{ event.booking.id }}" aria-expanded="false" title="Set Status" data-tooltip class="icon-more no-text dropdown"></a>
                                <ul data-dropdown-content id="resourceManagement-status-{{ event.booking.id }}" class="f-dropdown" aria-hidden="true">
                                    <li>
                                        <a href="{{ routeLookup('resourceBooking.approve', {id: event.booking.id}) }}"
                                           data-series-id="{{ event.booking.event.seriesId }}"
                                           data-set-status="approved"
                                           class="icon-approve">Approved</a>
                                    </li>
                                    <li>
                                        <a href="{{ routeLookup('resourceBooking.setPending', {id: event.booking.id}) }}"
                                           data-series-id="{{ event.booking.event.seriesId }}"
                                           data-set-status="pending"
                                           class="icon-undo">Pending</a>
                                    </li>
                                    <li>
                                        <a href="{{ routeLookup('resourceBooking.reject', {id: event.booking.id}) }}"
                                           data-series-id="{{ event.booking.event.seriesId }}"
                                           data-set-status="rejected"
                                           class="icon-close">Rejected</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </li>
    {% else %}
    <li class="row">
        <div class="small-12 columns content">
            <p>There are no upcoming bookings for you to confirm.</p>
        </div>
    </li>
    {% endfor %}
</ul>
<div data-role="bulk-update-dialog" title="This booking is part of a series">
    Would you like to <span data-role="action-text"></span> only this booking, or all in the series?
</div>
