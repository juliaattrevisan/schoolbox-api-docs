<div class="box clearfix" id="component{{ component.instance.id }}">
    <h2>{{ component.getConfig('componentname') }}</h2>
    <div class="listing">
        <ul>
            {% for item in bookings %}
                <li>
                    <a href="{{ routeLookup('resourceItem.read', {id: item.resource.id}) }}">{{ item.resource.name }}</a>
                </li>
                <ul>
                    {% for booking in item.bookings %}
                        <li class="{% if loop.index0 is even %}dark{% endif %} clearfix">
                            <span class="eventListing">
                                <strong>
                                    {# getEventSpan() dumps out htmlentities, so need to disable filter #}
                                    {{ booking.eventSpan|raw }}
                                </strong>

                                {# User: requested by and for could be different. #}
                                <span>
                                {% if booking.booking.event.owner.id != booking.booking.event.author.id %}
                                    requested for
                                    {% include 'sub/userLink.twig' with {user: booking.booking.event.owner} %}
                                    by
                                    {% include 'sub/userLink.twig' with {user: booking.booking.event.author} %}
                                {% else %}
                                    requested by
                                    {% include 'sub/userLink.twig' with {user: booking.booking.event.owner} %}
                                {% endif %}
                                    on {{ booking.booking.createdAt.long }}
                                </span>

                                {##
                                 # Approve/reject buttons
                                 # (as long as this user has permission)
                                 # These should be AJAXy buttons?
                                 #}
                                <a href="{{ routeLookup('resourceBooking.edit', {id: booking.booking.id}) }}">Edit</a>
                                <a href="{{ routeLookup('resourceBooking.approve', {id: booking.booking.id}) }}">Approve</a>
                                <a href="{{ routeLookup('resourceBooking.reject', {id: booking.booking.id}) }}">Reject</a>
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
            <li class="dark clearfix no_events">
                <em>There are no recent upcoming bookings for you to confirm.</em>
            </li>
            {% endfor %}
        </ul>
    </div>
</div>