<div class="box clearfix" id="component{{ component.instance.id }}">
    <h2>{{ component.getConfig('componentname') }}</h2>
    <div class="listing">
        <ul>
            {% for item in bookings %}
            <li class="{% if loop.index0 is even %}dark{% endif %} clearfix">
                <span class="eventListing">
                    <strong>
                        {# getEventSpan() dumps out htmlentities, so need to disable filter #}
                        {{ item.event.eventSpan|raw }}
                    </strong>
                    <span>
                        {{ item.booking.resource.category.name }} -
                        {{ item.booking.resource.name }}
                    </span>

                    {# User: requested by and for could be different. #}
                    <span>
                    {% if item.booking.event.owner.id != item.booking.event.author.id %}
                        requested for
                        {% include 'sub/userLink.twig' with {user: item.booking.event.owner} %}
                        by
                        {% include 'sub/userLink.twig' with {user: item.booking.event.author} %}
                    {% else %}
                        requested by
                        {% include 'sub/userLink.twig' with {user: item.booking.event.owner} %}
                    {% endif %}
                    </span>

                    {##
                     # Approve/reject buttons
                     # (as long as this user has permission)
                     # These should be AJAXy buttons?
                     #}
                    <a href="{{ routeLookup('resourceItem.read', {id: item.booking.resource.id}) }}">View bookings for item</a>
                    <a href="{{ routeLookup('resourceBooking.edit', {id: item.booking.id}) }}">Edit</a>
                    <a href="{{ routeLookup('resourceBooking.approve', {id: item.booking.id}) }}">Approve</a>
                    <a href="{{ routeLookup('resourceBooking.reject', {id: item.booking.id}) }}">Reject</a>
                </span>
            </li>
            {% else %}
            <li class="dark clearfix no_events">
                <em>There are no recent upcoming bookings for you to confirm.</em>
            </li>
            {% endfor %}
        </ul>
    </div>
</div>