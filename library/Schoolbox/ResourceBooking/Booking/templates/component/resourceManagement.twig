<div class="box clearfix" id="component{{ component.instance.id }}">
    <style type="text/css">
        /**
         * Provisional styles
         * IE9 doesn't support flex, and other browsers support it only with prefixes?
         * Anyway it works in IE10, and the buttons are down the bottom or something
         * in IE9.
         */
        #component{{ component.instance.id }} {
            overflow: visible;
        }
        #component{{ component.instance.id }} .resource h3 {
            float: none;
            display: inline-block;
        }
        #component{{ component.instance.id }} .resource.no-image h3 {
            margin-left: 32px;
        }
        #component{{ component.instance.id }} .resource .resource-image {
            display: inline-block;
        }
        #component{{ component.instance.id }} .booking-details {
            display: flex;
            justify-content: space-between;
        }
        #component{{ component.instance.id }} .booking-event {
            display: inline-flex;
        }
        #component{{ component.instance.id }} .booking-event .portrait {
            float:left;
            padding-right: 1em;
        }
        #component{{ component.instance.id }} .booking-event .event-timespan {
            display: block;
            font-weight: bold;
        }
        #component{{ component.instance.id }} .booking-event .event-data {
            display: block;
        }
        #component{{ component.instance.id }} .booking-controls {
            display: inline-flex;
        }

        /** styles for menu rollover **/
        #component{{ component.instance.id }} .status-buttons {
            display: none;
            position: absolute;
            text-align: right;
            top: 27px;
            right: 0;
            background-color: #FAFAFA;
            border: 1px solid #DEDEDE;
            z-index:199;
        }
        #component{{ component.instance.id }} .status-buttons li {
            padding: 0;
        }
        #component{{ component.instance.id }} .status-buttons .status-header {
            font-weight: bold;
            text-align: center;
            padding: 2px;
            display: block;
        }
        #component{{ component.instance.id }} .status-buttons .status-option {
            display: flex;
            justify-content: space-between;
            white-space: nowrap;
            padding: 2px;
        }
        #component{{ component.instance.id }} .status-buttons .status-option:hover {
            background-color: white;
        }
        #component{{ component.instance.id }} .status-buttons .status-option .status-label,
        #component{{ component.instance.id }} .status-buttons .status-option .btn {
            float: none;
            display: inline-flex;
            margin: 2px;
            line-height: 28px;
        }
        #component{{ component.instance.id }} .status-selector {
            cursor: pointer;
            margin-left: 0;
            /** Something for absolute positioned rollover to be relative to **/
            position: relative;
        }
        #component{{ component.instance.id }} .status-selector:hover .status-buttons,
        #component{{ component.instance.id }} .status-buttons:hover {
            display: block;
        }
    </style>
    <h2>{{ component.getConfig('componentname') }}</h2>
    <ul>
        {% for item in bookingsByResource %}
            <li class="resource {% if item.resource.image.hash is empty %}no-image{% endif %}">
                {# Show image for item if it's there, otherwise some empty image? #}
                {% if item.resource.image.hash %}
                    <img class="resource-image" src="/storage/image.php?size=square32&amp;hash={{ item.resource.image.hash|e('url') }}" />
                {% endif %}
                <h3>
                    <a href="{{ routeLookup('resourceItem.read', {id: item.resource.id}) }}">{{ item.resource.name }}</a>
                </h3>
                <ul>
                    {% for event in item.bookingEvents %}
                        <li class="{% if loop.index0 is even %}dark{% endif %} booking-details">

                            <div class="booking-event">
                                {# Show event's owner #}
                                <a href="/search/user/{{ event.booking.event.owner.id }}">
                                    <img class="portrait" src="/portrait.php?userId={{ event.booking.event.owner.externalId|e('url') }}&amp;size=square32" />
                                </a>

                                <span class="event-data">
                                    <span class="event-timespan">{{ event.eventSpan|raw }}</span>
                                    <span class="event-ownership">
                                        {% if event.booking.event.owner.id != event.booking.event.author.id %}
                                            requested for
                                            <a href="/search/user/{{ event.booking.event.owner.id }}">{{ event.booking.event.owner.formatName }}</a>
                                            by
                                            <a href="/search/user/{{ event.booking.event.author.id }}">{{ event.booking.event.author.formatName }}</a>
                                            {% include 'sub/userLink.twig' with {user: event.booking.event.author} %}
                                        {% else %}
                                            requested by
                                            <a href="/search/user/{{ event.booking.event.owner.id }}">{{ event.booking.event.owner.formatName }}</a>
                                        {% endif %}
                                        on {{ event.booking.createdAt.long }}
                                    </span>
                                </span>
                            </div>
                            <div class="booking-controls">
                                {##
                                 # approve/reject selector
                                 #}
                                <div class="status-selector">
                                    <span class="btn no-text
                                            {% if event.booking.status.approved %}tick
                                            {% elseif event.booking.status.pending %}report
                                            {% elseif event.booking.status.rejected %}translate
                                            {% endif %}"
                                          title="Current Status: {{ event.booking.status.name }}"><span></span></span>
                                    <ul class="status-buttons">
                                        <li class="status-header">Set Status</li>
                                        <li>
                                            <a href="{{ routeLookup('resourceBooking.approve', {id: event.booking.id}) }}"
                                               class="status-option">
                                                <span class="status-label">Approved</span>
                                                <span class="btn no-text tick"><span></span></span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="{{ routeLookup('resourceBooking.setPending', {id: event.booking.id}) }}"
                                               class="status-option">
                                                <span class="status-label">Pending</span>
                                                <span class="btn no-text report"><span></span></span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="{{ routeLookup('resourceBooking.reject', {id: event.booking.id}) }}"
                                               class="status-option">
                                                <span class="status-label">Rejected</span>
                                                <span class="btn no-text translate"><span></span></span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <a class="btn no-text modify" href="{{ routeLookup('resourceBooking.edit', {id: event.booking.id}) }}" title="Modify Booking">
                                    <span></span>
                                </a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </li>
        {% else %}
        <li class="dark clearfix no_events">
            <em>There are no recent upcoming bookings for you to confirm.</em>
        </li>
        {% endfor %}
    </ul>
</div>