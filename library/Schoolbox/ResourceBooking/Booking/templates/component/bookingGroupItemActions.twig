{##
 # The actions tot for an individual booking within a booking group
 #
 # @param array $item
 # @param array $booking
 # @param array $event
 # @param string $returnUrl
 #}

<nav>
    <sbx-pop-out content-id="resourceManagement-status-{{ event.booking.id }}"></sbx-pop-out>
</nav>
{% if booking.clash %} {# special clash tot options, special options, for modifying / approving each the original (approved) and the pending booking #}
    {#
     # Modify approved booking
     # Modify clash booking
     # Approve clash booking / Reject original booking
     # Reject clash booking
     #}
    <ul id="resourceManagement-status-{{ event.booking.id }}" class="f-dropdown" aria-hidden="true" data-dropdown-content>
        {% if booking.clash | length == 1 %}
            <li>
                <a href="{{ routeLookup('resourceBooking.edit', {id: booking.clash[0].booking.id}) }}?returnUrl={{ returnUrl }}"
                    class="icon-modify">Modify approved booking</a>
            </li>
        {% endif %}
        <li>
            <a href="{{ routeLookup('resourceBooking.edit', {id: event.booking.id}) }}?returnUrl={{ returnUrl }}"
                class="icon-modify">Modify clash booking</a>
        </li>
        {% if booking.clash | length > 1 %}
            <li>
                <a href="{{ routeLookup('resourceItem.read', {id: item.resource.id}) }}"
                    class="icon-modify">Manage clashes on Calendar</a>
            </li>
        {% endif %}
        <li class="separator">Set Status</li>

        {% if booking.clash | length == 1 %}
            <li>
                <a href="{{ routeLookup('resourceBooking.clashApprove', {old: booking.clash[0].booking.id, new: event.booking.id}) }}"
                    data-set-status="approved"
                    class="icon-approve">Approve clash booking / Reject original booking</a>
            </li>
        {% endif %}
        <li>
            <a href="{{ routeLookup('resourceBooking.reject', {id: event.booking.id}) }}"
                data-series-id="{{ event.booking.event.seriesId }}"
                data-set-status="rejected"
                class="icon-close">Reject clash booking</a>
        </li>
    </ul>
{% else %} {# standard pending booking tot options #}
    <ul id="resourceManagement-status-{{ event.booking.id }}" class="f-dropdown" aria-hidden="true" data-dropdown-content>
        <li>
            <a
                href="{{ routeLookup('resourceBooking.edit', {id: event.booking.id}) }}?returnUrl={{ returnUrl }}"
                class="icon-modify"
            >Modify Booking</a>
        </li>

        <li class="separator">Set Status</li>
        <li>
            <a
                href="{{ routeLookup('resourceBooking.approve', {id: event.booking.id}) }}"
                data-series-id="{{ event.booking.event.seriesId }}"
                data-set-status="approved"
                class="icon-approve"
            >Approve</a>
        </li>
        <li>
            <a
                href="{{ routeLookup('resourceBooking.reject', {id: event.booking.id}) }}"
                data-series-id="{{ event.booking.event.seriesId }}"
                data-set-status="rejected"
                class="icon-close"
            >Reject</a>
        </li>
    </ul>
{% endif %}
