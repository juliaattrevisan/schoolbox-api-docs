<div class="row">
    <div class="small-12 columns">
        <label>Start Time</label>

        {#{% include 'sub/errors.twig' with {errors: errors.start_datetime} %}#}
        {% include 'sub/datetimeInput.twig' with {
        value: item.event.startDateTime,
        name:  'start_datetime',
        id:    'start_datetime'
        } %}
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <label>End Time</label>

        {% include 'sub/datetimeInput.twig' with {
        value: item.event.endDateTime,
        name:  'end_datetime',
        id:    'end_datetime'
        } %}
    </div>
</div>