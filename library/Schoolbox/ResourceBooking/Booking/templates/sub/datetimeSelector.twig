<fieldset>
    {#{% include 'sub/errors.twig' with {errors: errors.start_datetime} %}#}
    {% include 'sub/datetimeInput.twig' with {
    title: 'Start Time',
    value: item.event.startDateTime,
    name:  'start_datetime',
    id:    'start_datetime'
    } %}
</fieldset>

<fieldset>
    {% include 'sub/datetimeInput.twig' with {
    title: 'End Time',
    value: item.event.endDateTime,
    name:  'end_datetime',
    id:    'end_datetime'
    } %}
</fieldset>

<div id="timetableSelectorDialog"
     data-role="timetable-selector"
     class="reveal-modal"
     data-reveal
     aria-labelledby="timetableSelectorDialogLabel"
     aria-hidden="true"
     role="dialog">
    <h2 id="timetableSelectorDialogLabel">Choose a date from timetable</h2>
    {% include 'sub/timetableSelector.twig' with {select: select} %}
    <a href="#" data-action="useTime" class="primary button">Use</a>
    <a href="#" data-action="close" class="button">Cancel</a>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>