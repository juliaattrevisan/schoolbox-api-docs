<em>You may select a timetable day and period to book this item for here.</em>
<em>If you want this booking to recur for a timetable period, then
    make sure you select the "Timetable Based" option in "Repeat".</em>

<dl class="clearfix" data-interaction="timetableSelector">
    <dt>Campus</dt>
    <dd>
        <select id="timetableCampus" name="timetable[campus]" data-role="campusSelector">
            <option disabled>-- select campus --</option>
            {% for campus in campusList %}
                <option value="{{ campus.id }}"
                        label="{{ campus.name }}"
                        >{{ campus.name }}</option>
            {% endfor %}
        </select>
    </dd>
    <dt>Day</dt>
    <dd>
        <select id="timetableDay" name="timetable[day]" disabled data-role="daySelector">
            <option disabled>-- select day --</option>
        </select>
    </dd>
    <dt>Period</dt>
    <dd>
        <select id="timetablePeriod" name="timetable[period]" disabled data-role="periodSelector">
            <option disabled>-- select period --</option>
        </select>
    </dd>
    <dt>Date</dt>
    <dd>
        <time data-role="selectedDate">Please select a campus and day.</time>
        <a data-interaction="previousDate" class="btn go-back no-text float-left" title="Previous" href="#"><span></span></a>
        <a data-interaction="nextDate" class="btn go-to no-text float-left" title="Next" href="#"><span></span></a>
        <a data-interaction="useDate" class="btn tick no-text float-left" title="Use this date" href="#"><span></span></a>
    </dd>
    <dt>Start Time</dt>
    <dd>
        <time data-role="selectedTimeStart">Please select a period.</time>
    </dd>
    <dt>End Time</dt>
    <dd>
        <time data-role="selectedTimeEnd">Please select a period.</time>
    </dd>
</dl>

{# Form inputs for the date and time - match the datepicker inputs #}
<input name="start_datetime[date]" type="hidden" />
<input name="start_datetime[hour]" type="hidden" />
<input name="start_datetime[minute]" type="hidden" />
<input name="start_datetime[meridien]" type="hidden" />
<input name="end_datetime[date]" type="hidden" />
<input name="end_datetime[hour]" type="hidden" />
<input name="end_datetime[minute]" type="hidden" />
<input name="end_datetime[meridien]" type="hidden" />
