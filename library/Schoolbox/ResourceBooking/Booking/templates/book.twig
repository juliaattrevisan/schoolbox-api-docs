{# Datepicker is always included. Load the timepicker, because it isn't. #}
<script type='text/javascript' src='/javascript/components/jquery-timepicker-jt/jquery.timepicker.js'></script>

<script type="text/javascript">

// provide page-wide access to the calendar object so the callbacks can actually use it
//var c;

// once the DOM has loaded, punch a fancy calendar into it
$(document).ready(function() {

    // Datepickers
    $('input[data-datepicker]').datepicker({
        dateFormat:'dd/mm/yy',
        showOn:'both',
        buttonImage:'/images/core/calendar/calendar-click.png',
        buttonImageOnly:true,
        constrainInput:false,
        minDate: 0,
        beforeShow: function() {
            // Make sure the stupid datepicker shows above everything else,
            // because it doesn't respect any CSS datepicker setting I give it
            setTimeout(function() {
                $('.ui-datepicker').css('z-index', 99999999999999);
            }, 0);
        }
//        onClose:function (string) {
//            var input = $j(this);
//            $j.getJSON('/ajax/strtotime.php', {string:string}, function (data) {
//                input.val(data.time);
//            })
//        }
    });

    // Timepickers
    $('input[data-timepicker]').timepicker({
        timeFormat:'H:i',
        step:15
    });

    var now = new Date();
    var c   = new Calendar('calendar', 'calendar-bubble', {
//        crud: {
//            c: '/calendar/ajax/create',
//            // r: don't need it
//            u: '/calendar/ajax/update',
//            d: '/calendar/ajax/delete'
//        },
        filter: {
            enabled: true,
            ajax: false,
            // This AJAX lookup should always be a GET request
            {#ajax: {{ routeLookup('resourceBooking.bookingCalendar', {id: resource.id})|json_encode|raw }},#}
            parentSelector: '#calendar-controls',
            exportButtonSelector: false,
            checkboxSelector: false,
            applyFiltersSelector: false
        },
        fullCalendar: {
            date:  now.getDate(),
            month: now.getMonth(),
            year:  now.getFullYear(),
            columnFormat: 'ddd d/M',
            defaultView: 'month',
            timeFormat: { month: 'h(:mm)tt' },
            events: function(start, end, callback) {
                var data = [
                    {name: 'start', value: Math.round(start.getTime()/1000)},
                    {name: 'end',   value: Math.round(end.getTime()/1000)},
                ];
                $.ajax({
                    data:     data.concat($('#calendar-controls').find('form').serializeArray()),
                    dataType: 'json',
                    url:      {{ routeLookup('resourceBooking.bookingCalendar', {id: resource.id})|json_encode|raw }},
                    success: function(data) {
                        callback(data);
                    },
                    cache: false
                });
            },
            loading: function(isLoading) {
                if (isLoading === true) {
                    $('#calendar-loading').css({
                        top: ($j('#calendar').height() - $j('#calendar-loading').height())/2,
                        left: ($j('#calendar').width() - $j('#calendar-loading').width())/2
                    }).show();
                }
                else {
                    $('#calendar-loading').hide();
                }
            },

            /**
             * When an event is clicked
             *
             * @param calEvent
             * @param jsEvent
             */
            eventClick: function(calEvent, jsEvent) {

                // setup data to be displayed
                var data = $j.extend(true, {}, calEvent.data.meta)
                data.note = calEvent.title

                data.date = calendarDate(calEvent.start)
                data.date += " &ndash; "
                data.date += calendarDate(calEvent.end)

                // Custom butonyes
                data.actions = []
                $.each(calEvent.data.booking.buttons, function() {
                    data.actions.push(
                        $('<a class="btn float-right" />')
                            .addClass(this.class)
                            .attr('href', this.href)
                            .text(this.label)
                            .prepend('<span />')
                    )
                })
                c.bubble.display('edit', data, jsEvent, this)
            }
        },
        x: false
    }).init()

    // Event filter - reload events when the filter button is pressed.
    $('#calendar-controls').on('click', 'a#applyFilters', function(event) {
        event.preventDefault()
        c.dom.fullCalendar('refetchEvents')
    })
})
</script>

<div id="calendar-loading">
    <p><strong>Loading events...</strong></p>
</div>

<h1>Book item: {{ resource.name }}</h1>

{# booking form #}
