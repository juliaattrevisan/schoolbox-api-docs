<!-- BEGIN custom_header -->
<script type="text/javascript" src="/javascript/jquery.syncDates.js"></script>
<script type="text/javascript" src="/javascript/jquery.timetableDaySelector.js"></script>
<script type="text/javascript" src="/javascript/tiny_mce/tiny_mce.js"></script>
<script type="text/javascript" src="/javascript/jquery.alaressTiny.js"></script>
<script type="text/javascript" src="/javascript/components/jquery-validation/additional-methods.js"></script>
<script type="text/javascript" src="/javascript/jquery.validate.extensions.js"></script>
<script type="text/javascript">
$(function() {
    // A global variable
    var momentFormat = dateDisplayFormats.momentJs;
    $.fn.alaressTiny({
       mode: 'textareas'
    });

    // Datepickers
    $('input[data-datepicker]').datepicker({
        constrainInput:false,
        minDate: 0
//        onClose:function (string) {
//            var input = $j(this);
//            $j.getJSON('/ajax/strtotime.php', {string:string}, function (data) {
//                input.val(data.time);
//            })
//        }
    })
    $('input[name="start_datetime[date]"]').syncDates({
        endDate: $('input[name="end_datetime[date]"]')
    })

    // Set up tabz for the projector.
    // Always default to setting a date and time directly, though.

    /* Prevent tab onchange from firing twice
     * https://github.com/zurb/foundation/issues/6009
     */
    var lastTab = false;

    $('[data-interaction="tabs"]').on('toggled', function(event, tab) {
        var id = tab.attr('id');

        if (lastTab != id) {
            lastTab = id;

            /* Disable all inputs in all tabs
             */
            $.each($('[data-interaction="tabs"] a'), function(index, element) {
                $($(element).attr('href')).find('input, select').prop('disabled', true);
            });

            /* Enable all inputs in this tab
             */
            tab.find('input, select').prop('disabled', false);
        }
    });

    // Timetable selector
    {#var campusList         = {{ campusList|json_encode|raw }}#}
    $('[data-interaction="timetableSelector"]')
        .timetableDaySelector({
            dateFormat: momentFormat,
            campusList: {{ campusList|json_encode|raw }},
            getChangeDateAjax: function(campus, day, date, previous) {
                return {
                    url:      {{ routeLookup('timetable.dateForTimetableDay')|json_encode|raw }},
                    dataType: 'json',
                    data:     {
                        campus:   campus,
                        day:      day,
                        previous: (previous ? 1 : 0),
                        date:     date
                    }
                }
            }
        })
        .on('selectDate.timetableDaySelector', function(event, date, startTime, endTime) {
            var timetableTab = $('#timetableSelector')
            date = moment(date)
            if (date.isValid()) {
                var dateOutput = date.format(momentFormat)
                timetableTab.find('input[name="start_datetime[date]"]').val(dateOutput)
                timetableTab.find('input[name="end_datetime[date]"]').val(dateOutput)
            }

            startTime = moment(startTime, 'HH:mm')
            if (startTime.isValid()) {
                timetableTab.find('input[name="start_datetime[hour]"]').val(startTime.format('h'))
                timetableTab.find('input[name="start_datetime[minute]"]').val(startTime.format('mm'))
                timetableTab.find('input[name="start_datetime[meridien]"]').val(startTime.format('a'))
            }

            endTime = moment(endTime, 'HH:mm')
            if (endTime.isValid()) {
                timetableTab.find('input[name="end_datetime[hour]"]').val(endTime.format('h'))
                timetableTab.find('input[name="end_datetime[minute]"]').val(endTime.format('mm'))
                timetableTab.find('input[name="end_datetime[meridien]"]').val(endTime.format('a'))
            }
        })

    // remote validation rules
    // Have some sort of helper for creating remote validations.
    var getValidatorRemoteMethod = function(code, key) {
        return function(value, element) {
            return (errors[key || element.name] || []).indexOf(code) < 0;
        }
    }

    // Remote rules for start date
    // Some of these should be made into local rules.
    $.validator.addMethod(
        'remote.invalidStart',
        getValidatorRemoteMethod('invalid', 'start_datetime'),
        'Please enter a valid date.'
    )
    $.validator.addMethod(
        'remote.conflict',
        getValidatorRemoteMethod('conflict', 'start_datetime'),
        'This item has already been booked for this time.'
    )
    $.validator.addMethod(
        'remote.timetabledClass',
        getValidatorRemoteMethod('timetabled_class', 'start_datetime'),
        'This room is already timetabled for this time.'
    )
    $.validator.addMethod(
        'remote.inPast',
        getValidatorRemoteMethod('in_past', 'start_datetime'),
        'Items may not be booked for the past.'
    )
    $.validator.addMethod(
        'remote.tooEarly',
        getValidatorRemoteMethod('too_early', 'start_datetime'),
        'This item must be booked at least ' + {{ include('sub/interval.twig', {interval: item.resource.minLeadTime})|json_encode|raw }} + ' in advance.'
    )

    // Remote rules for end date
    $.validator.addMethod(
        'remote.invalidEnd',
        getValidatorRemoteMethod('invalid', 'end_datetime'),
        'Please enter a valid date.'
    )
    $.validator.addMethod(
        'remote.beforeStart',
        getValidatorRemoteMethod('before_start', 'end_datetime'),
        'The booking start time must be before the end time.'
    )
    $.validator.addMethod(
        'remote.tooShort',
        getValidatorRemoteMethod('too_short', 'end_datetime'),
        'This item must be booked for at least ' + {{ include('sub/interval.twig', {interval: item.resource.minReservationTime})|json_encode|raw }} + '.'
    )
    $.validator.addMethod(
        'remote.tooLong',
        getValidatorRemoteMethod('too_long', 'end_datetime'),
        'This item may not be booked for more than ' + {{ include('sub/interval.twig', {interval: item.resource.maxReservationTime})|json_encode|raw }} + '.'
    )

    // Set up errors, dialog boxes, form
    var errors = {}
    var form   = $('form#resource-booking-form')

    // Input for efficacy of update for series bookings (update all, or this only)
    var efficacyInput = form.find('input[name="efficacy"]')

    // Set up dialog boxes for cancel and update
    var updateDialog = $('#dialog-bulk-update')
    var cancelDialog = $('#dialog-bulk-cancel')
    $().add(updateDialog).add(cancelDialog).dialog({
        autoOpen:false,
        resizable:false,
        width:400,
        modal:true,
        draggable:false,
        buttons:[
            {
                text: "Only this event",
                click: function() {
                    efficacyInput.val('self')
                    $(this).trigger('confirm')
                }
            },
            {
                text: "All events in the series",
                click: function() {
                    efficacyInput.val('series')
                    $(this).trigger('confirm')
                }
            }
        ],
        close:function () {
            return false;
        }
    }).on('confirm', function() {
        $(this).dialog('close')
        callback()
    })

    // Callback for form validation and save in one step
    var callback = function() {
        // Update the textarea behind the TinyMCE box -_-
        tinyMCE.triggerSave();
        var ajaxParams = {
            url:      form.attr('action'),
            type:     form.attr('method'),
            data:     form.serializeArray(),
            dataType: 'json'
        }
        var ajaxDone = function(data) {

            /* Use a calling module's callback url, pass it booking ids
             * that were just created for it
             */
            if (data.callbackUrl.length) {
                var ids = data.item.map(function(v) { return v.id; }).join();
                window.location.href = data.callbackUrl + '?ids=' + ids;
            } else {
                // Get the time of the first booking, direct to that date
                var dateQuery = '';
                try {
                    var date = moment(data.item[0].event.start);
                    dateQuery += '?date='+date.format('DD-MM-YYYY');
                } catch (e) {
                    // noop
                }
                window.location.href = $('#resource-booking-back').attr('href')+dateQuery;
            }
        }
        var ajaxFail = function(jqXHR) {
            errors = jqXHR.responseJSON.errors
            form.valid()
        }

        // Deactivate the button
        var button   = form.find('input#resource-booking-save');
        var oldValue = button.attr('value');
        button.prop('disabled', true).attr('value', button.data('loading-value'));
        $.ajax(ajaxParams)
            .done(ajaxDone)
            .fail(ajaxFail)
            .always(function() {
                button.prop('disabled', false).attr('value', oldValue);
            });
    }

    // Submit resource booking form via AJAX
    form.validate({
        ignore: ':disabled',
        rules: {
            'start_datetime[date]': {
                required: true,
                datepickerDate: true,
                'remote.invalidStart': true,
                'remote.inPast': true,
                'remote.tooEarly': true,
                'remote.conflict': true,
                'remote.timetabledClass': true
            },
            'end_datetime[date]': {
                required: true,
                datepickerDate: true,
                'remote.invalidEnd': true,
                'remote.beforeStart': true,
                'remote.tooShort': true,
                'remote.tooLong': true
            },
            'start_datetime[hour]': {
                required: true,
                digits: true,
                range: [1, 12]
            },
            'end_datetime[hour]': {
                required: true,
                digits: true,
                range: [1, 12]
            },
            'start_datetime[minute]': {
                required: true,
                digits: true,
                range: [0, 59]
            },
            'end_datetime[minute]': {
                required: true,
                digits: true,
                range: [0, 59]
            },
            'start_datetime[meridien]': {
                required: true,
                pattern:  /^(?:am|pm)$/i
            },
            'end_datetime[meridien]': {
                required: true,
                pattern:  /^(?:am|pm)$/i
            }
        },
        errorPlacement: function(label, element) {
            var name = element.attr('name')
            switch (element.attr('name')) {
                case 'start_datetime[date]':
                case 'start_datetime[hour]':
                case 'start_datetime[minute]':
                case 'start_datetime[meridien]':
                case 'end_datetime[date]':
                case 'end_datetime[hour]':
                case 'end_datetime[minute]':
                case 'end_datetime[meridien]':
                    element.closest('td').append(label)
                    break
                default:
                    label.insertAfter(element)
                    break
            }
        },
        submitHandler: function() {
            // Consider: one pass for validation, another pass for saving
            var bookingId = form.find('input[name="id"]').val()
            var repeat    = form.find('input[name="repeat"]').val()
            if (bookingId && repeat) {
                // Show a different dialog for deletes
                if (form.data('action') === 'cancel') {
                    cancelDialog.dialog('open')
                }
                else {
                    updateDialog.dialog('open')
                }
            }
            else {
                callback()
            }
        },
        messages: {
            'start_datetime[date]': {
                required:       'Please enter a valid date.',
                datepickerDate: 'Please enter a valid date.'
            },
            'end_datetime[date]': {
                required:       'Please enter a valid date.',
                datepickerDate: 'Please enter a valid date.'
            },
            'start_datetime[hour]':     "Please enter a valid hour value.",
            'end_datetime[hour]':       "Please enter a valid hour value.",
            'start_datetime[minute]':   "Please enter a valid minute value.",
            'end_datetime[minute]':     "Please enter a valid minute value.",
            'start_datetime[meridien]': "Please select AM or PM.",
            'end_datetime[meridien]':   "Please select AM or PM."
        }
    })

    // On submission attempt: clear list of errors
    form.find('#resource-booking-save')
        .click(function() {
            errors = {}
            form.valid()
        })
        .click(function() {
            // Record that I clicked Save
            form.data('action', 'save')
        })
    form.find('#resource-booking-cancel')
        .click(function() {
            // Record that I clicked Cancel
            form.data('action', 'cancel')
        })

    // did I click the cancel button? If so, cancel this booking.
    // This should be in a different form to everything else.
    form.on('click', '#resource-booking-cancel', function(event) {
        event.preventDefault();
        $('#resource-booking-cancel-form').submit();
    })

    // Show/hide the repeat until input, depending on if a repeat is chosen.
    form.find('#repeatUntilSelect')
        .change(function() {
            if ($(this).val() !== '') {
                $('#repeatUntil').show();
                $("#repeat_until").rules("add", "required");
            }
            else {
                $('#repeatUntil').hide();
                $("#repeat_until").rules("remove", "required");
            }
        })
        .change()

    // Related Resources:
    // show/hide name and notes
    form.on(
        'change',
        'input[data-interaction="display-notes"]',
        function(event) {
            var notes = $(this)
                .closest('[data-relation="related-resource"]')
                .find('[data-relation="related-resource-notes"]')
            ;
            if (this.checked) {
                // Dunno if this disables tinyboxes
                notes.slideDown('fast', function() {
                    notes.find(':input').prop('disabled', false);
                });
            } else {
                notes.slideUp('fast', function() {
                    notes.find(':input').prop('disabled', true);
                });
            }
        }
    )
})
</script>
<!-- END custom_header -->

<ul class="breadcrumb">
    <li><a href="/resource-booking/item">Resource Booking</a>
    <li><a id="resource-booking-back" href="{{ routeLookup('resourceItem.read', {id: item.resource.id}) }}">{{ item.resource.name }}</a></li>
    <li class="active"><a href="#">Booking</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>
            {% if item.id is empty %}
                Book Item
            {% else %}
                Update Booking
            {% endif %}
        </h1>

        <ul class="meta">
            <li class="icon-resource-booking">{% include '@resourceItem/sub/itemName.twig' with {item: item.resource} %}</li>
        </ul>
    </div>
</div>

{# booking form #}
{% set saveAction = item.id is empty ?
    routeLookup('resourceBooking.createBooking', {id: item.resource.id}) :
    routeLookup('resourceBooking.update:post',   {id: item.id})
%}

<div class="row">
    <div class="small-12 island">
        <form id="resource-booking-form" action="{{ saveAction }}" method="post" name="form">
            <input type="hidden" name="id" value="{{ item.id }}"/>
            <input type="hidden" name="callbackUrl" value="{{ callbackUrl }}" />

            {# Inputs for editing bookings in a series #}
            <input type="hidden" name="efficacy" value="self" />

            {# Input for determining which action to run #}
            <input type="hidden" name="action" />

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Title
                            <input name="name" type="text" value="{{ item.name }}" />
                        </label>

                        {% include '@resourceItem/sub/rules.twig' with {item: item.resource} %}

                        <label>
                            Booking Time
                        </label>

                        {# Existing items - only show the date and time (for now) #}
                        {# New items - allow choice of timetable or date/time #}
                        {% if item.id %}
                            {% include '@resourceBooking/sub/datetimeSelector.twig' with {item: item} %}
                        {% else %}
                            <dl class="tabs" data-tab data-interaction="tabs">
                                <dd class="active"><a href="#dateSelector">Choose a Time</a></dd>
                                <dd><a href="#timetableSelector">Choose from Timetable</a></dd>
                            </dl>

                            <div class="tabs-content">
                                <div class="content active" id="dateSelector">
                                    {% include '@resourceBooking/sub/datetimeSelector.twig' with {item: item} %}
                                </div>
                                <div class="content" id="timetableSelector">
                                    {% include '@resourceBooking/sub/timetableSelector.twig' with {campusList: campusList} %}
                                </div>
                            </div>
                        {% endif %}

                        {# Only a user who may moderate this item may ignore the rules. #}
                        {% if allowOverride %}
                        <input id="resource-booking-override-validation" type="checkbox" name="override_validation" value="1" />
                        <label for="resource-booking-override-validation" class="checkbox-label">
                            Bypass Validation
                            <span class='hint has-tip tip-top' data-tooltip title="Only select this if you are certain you wish to override the system rules">?</span>
                        </label>
                        {% endif %}
                    </div>
                </fieldset>

                {% if item.event.id is empty %}
                <fieldset class="content" id="repeatUntil">
                    <legend>Repeat</legend>
                    <div class="small-12 columns">
                        <label>
                            Repeat
                            <span class='hint has-tip tip-top' data-tooltip title="The frequency with which this booking recurs, if at all.">?</span>
                            <select name="repeat" id="repeatUntilSelect">
                                <option value="">Single Booking</option>
                                <optgroup label="Recurring">
                                    <option value="daily">Daily</option>
                                    <option value="weekly">Weekly</option>
                                    <option value="fortnightly">Fortnightly</option>
                                    <option value="monthly">Monthly</option>
                                    <option value="timetable">Timetable Based</option>
                                </optgroup>
                            </select>
                        </label>

                        <label>
                            Repeat Until
                            <span class='hint has-tip tip-top' data-tooltip title="The date at which recurrence should cease.">?</span>
                            <input data-datepicker name="repeat_until" id="repeat_until" type="text" size="15" maxlength="30" value=""/>
                        </label>
                    </div>
                </fieldset>
                {% elseif recurrence %}
                <fieldset class="content">
                    <legend>Repeat</legend>
                    <div class="small-12 columns">
                        <label>
                            Repeat
                            <span class='hint has-tip tip-top' data-tooltip title="This booking is part of a recurring series.">?</span>
                            <input name="repeat" type="hidden" value="{{ recurrence.freq }}" />
                            {% include 'sub/recurrence.twig' with {recurrence: recurrence} %}
                        </label>
                    </div>
                </fieldset>
                {% endif %}

                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Notes
                            <textarea name="notes">{{ item.notes }}</textarea>
                        </label>
                    </div>
                </fieldset>

                <fieldset>
                    <div class="small-12 columns">
                        <div class="content">
                            <label>
                                Related Resources
                                {% if item.resource.relatedResourceList|length %}
                                <span class='hint has-tip tip-top' data-tooltip title="If you want to book any related resources, select them here.">?</span>
                                {% endif %}
                            </label>
                        </div>
                    </div>
                    <div class="small-12 columns">

                        {% if item.resource.relatedResourceList|length %}
                        {# Related resources - not sure whether this list should be editable after save #}
                        <ul class="action-list">
                        {% for relatedItem in item.resource.relatedResourceList %}
                            {% if item.hasRelatedBookingForResource(relatedItem.id) %}
                                {% set relatedBooking = item.getRelatedBookingForResource(relatedItem.id) %}
                            {% else %}
                                {% set relatedBooking = {} %}
                            {% endif %}
                            <li class="actions-small-1" data-relation="related-resource">
                                <div class="list-item">
                                    <div class="small-1 columns">
                                        <input id="related-item-{{ relatedItem.id }}" type="checkbox" name="related_item[{{ relatedItem.id }}][resource_id]" value="{{ relatedItem.id }}" data-interaction="display-notes" {% if relatedBooking is not empty %}checked{% endif %} />
                                        <label for="related-item-{{ relatedItem.id }}" class="checkbox-label"></label>
                                    </div>
                                    <div class="small-11 info card">
                                        <p>{{ relatedItem.name }}</p>
                                    </div>

                                    <div data-relation="related-resource-notes" class="{% if relatedBooking is empty %}hide{% endif %}">
                                        <textarea name="related_item[{{ relatedItem.id }}][notes]">{{ relatedBooking.notes }}</textarea>
                                    </div>
                                </div>
                                <nav>
                                    <a href="{{ routeLookup('resourceItem.read', {id: relatedItem.id}) }}" class="icon-view" id="resource-read-{{relatedItem.id}}" title="View Bookings"></a>
                                </nav>
                            </li>
                            {% endfor %}
                        </ul>
                        {% else %}
                        <div class="content">
                            <p>This resource has no related resources.</p>
                        </div>
                        {% endif %}
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <input id="resource-booking-save" type="submit" value="{% if item.id %}Update Booking{% else %}Book{% endif %}" data-action="{{ saveAction }}" data-loading-value="Validating..." />

                    {% if item.id %}
                        <input id="resource-booking-cancel" type="submit" value="Cancel Booking" data-action="{{ routeLookup('resourceBooking.cancel', {id: item.id}) }}" />
                    {% endif %}
                </div>
            </div>
        </form>
    </div>
</div>

{# Hidden form for cancelling a booking.
 # This should redirect to the last page I was on.
 #}
<form id="resource-booking-cancel-form" action="{{ routeLookup('resourceBooking.cancel', {id: item.id}) }}">
    <input type="hidden" name="callbackUrl" value="{{ cancelCallbackUrl }}" />
</form>

{# Booking for bulk events #}
<div id="dialog-bulk-cancel" title="This booking is part of a series" class="wysiwyg">
    Would you like to cancel only this booking, or all in the series?
    <ul>
        <li>
            Bookings in this series that have already occured will not be
            retrospectively cancelled.
        </li>
    </ul>
</div>

<div id="dialog-bulk-update" title="This booking is part of a series" class="wysiwyg">
    Would you like to update only this booking, or all in the series? If you
    update all bookings in the series:
    <ul>
        <li>
            The start and end time of the other bookings in the series will be
            adjusted by the amount you adjusted this booking.
        </li>
        <li>
            Any approved bookings whose start or end time have changed will need
            to be approved again.
        </li>
        <li>
            Bookings in this series that have already occured will not be
            retrospectively changed.
        </li>
    </ul>
</div>
