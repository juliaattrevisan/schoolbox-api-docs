<script type="text/javascript">
$(document).ready(function() {

    // Datepickers
    $('input[data-datepicker]').datepicker({
        dateFormat:'dd/mm/yy',
        showOn:'both',
        buttonImage:'/images/core/calendar/calendar-click.png',
        buttonImageOnly:true,
        constrainInput:false,
        minDate: 0,
        beforeShow: function() {
            // Make sure the stupid datepicker shows above everything else,
            // because it doesn't respect any CSS datepicker setting I give it
            setTimeout(function() {
                $('.ui-datepicker').css('z-index', 99999999999999);
            }, 0);
        }
//        onClose:function (string) {
//            var input = $j(this);
//            $j.getJSON('/ajax/strtotime.php', {string:string}, function (data) {
//                input.val(data.time);
//            })
//        }
    });
})
</script>
<!-- END custom_header -->

<h1>Book item: {{ item.resource.name }}</h1>

{# booking form #}
<form id="resource-booking-form"
      action="{{ routeLookup('resourceBooking.createBooking', {id: item.resource.id}) }}"
      method="post"
      name="form" class="clearfix"
>
    <input type="hidden" name="id" value="{{ item.id }}"/>
    <table class="standardForm table">
        <tr>
            <td class="formLabelWidth"><h4>Begin</h4></td>
            <td>
                {% include 'sub/datetimeInput.twig' with {
                    value: item.event.startDateTime,
                    name:  'start_datetime'
                } %}
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>End</h4></td>
            <td>
                {% include 'sub/datetimeInput.twig' with {
                    value: item.event.endDateTime,
                    name:  'end_datetime'
                } %}
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth"><h4>Notes</h4></td>
            <td><textarea name="notes">{{ item.event.detail }}</textarea></td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Related Resources</h4>
                <em>If you want to book any related resources, select them here.</em>
            </td>
            <td>
                {# Related resources #}
                <ul>
                {% for relatedItem in item.resource.relatedResourceList %}
                    <li>
                        <input id="related-item-{{ relatedItem.id }}" type="checkbox" name="related_item[]" value="{{ relatedItem.id }}" />
                        <label for="related-item-{{ relatedItem.id }}">{{ relatedItem.name }}</label>
                    </li>
                {% else %}
                    <li>This resource has no related resources.</li>
                {% endfor %}
                </ul>
            </td>
        </tr>
    </table>

    <input id="resource-booking-save"
           type="submit"
           value="{% if item.id %}Update Booking{% else %}Book{% endif %}"
           class="submit-btn-plain"
    />

</form>
