<!-- BEGIN custom_header -->
<script type="text/javascript" src="/javascript/jquery.syncDates.js"></script>
<script type="text/javascript" src="/javascript/jquery.timetableDaySelector.js"></script>
<script type="text/javascript" src="/javascript/tiny_mce/tiny_mce.js"></script>
<script type="text/javascript" src="/javascript/jquery.validate.extensions.js"></script>
<script type="text/javascript">
$(document).ready(function() {

    tinyMCE.init({
        mode : "textareas",
        theme : "advanced",
        skin : "cirkuit",
        plugins : "pdw,table,tabfocus,media,inlinepopups,advimage,assetmanager,directionality,paste,spellchecker",
        browser_spellcheck : true,
        content_css : "/css/core/tiny.css",
        theme_advanced_toolbar_location : "top",
        theme_advanced_toolbar_align : "left",
        theme_advanced_statusbar_location : "bottom",
        theme_advanced_buttons1 : "bold,italic,underline,separator,bullist,numlist,separator,link,unlink,image,media,separator,undo,redo,separator,pdw_toggle",
        theme_advanced_buttons2 : "forecolor,formatselect,fontsizeselect,separator,justifyleft,justifycenter,justifyright,z,spellchecker",
        theme_advanced_buttons3 : "outdent,indent,sub,sup,separator,hr,charmap,separator,seperator,ltr,rtl,selectall,pastetext,pasteword,separator,removeformat,cleanup,code",
        theme_advanced_buttons4 : "tablecontrols",
        accessibility_warnings : false,
        pdw_toggle_on : 1,
        pdw_toggle_toolbars : '2, 3, 4',
        extended_valid_elements : "a[class|name|href|target|title|onclick],img[class|src|border=0|alt|title|hspace|vspace|width|height|align|onmouseover|onmouseout|name|style],hr[class|width|size|noshade],font[face|size|color|style],span[class|align|style]",
        theme_advanced_blockformats : "h3,h4,p,address,pre",
        file_browser_callback : 'tinyMCE.activeEditor.plugins.assetmanager.fileBrowser',
        file_uploader_callback : 'tinyMCE.activeEditor.plugins.assetmanager.fileUploader',
        file_browser_category_id : 0,
        tabfocus_elements : ":prev,:next",
        convert_urls : false
    });

    // Datepickers
    $('input[data-datepicker]').datepicker({
        dateFormat:'dd/mm/yy',
        showOn:'both',
        buttonImage:'/images/core/calendar/calendar-click.png',
        buttonImageOnly:true,
        constrainInput:false,
        minDate: 0
//        onClose:function (string) {
//            var input = $j(this);
//            $j.getJSON('/ajax/strtotime.php', {string:string}, function (data) {
//                input.val(data.time);
//            })
//        }
    })
    $('input[name="start_datetime[date]"]').syncDates({
        endDate: $('input[name="end_datetime[date]"]')
    })

    // Timetable selector
    {#var campusList         = {{ campusList|json_encode|raw }}#}
    $('[data-interaction="timetableSelector"]')
        .timetableDaySelector({
            campusList: {{ campusList|json_encode|raw }},
            getChangeDateAjax: function(campus, day, date, previous) {
                return {
                    url:      {{ routeLookup('resourceBooking.dateForTimetableDay')|json_encode|raw }},
                    dataType: 'json',
                    data:     {
                        campus:   campus,
                        day:      day,
                        previous: (previous ? 1 : 0),
                        date:     date
                    }
                }
            }
        })
        .on('useDate.timetableDaySelector', function(event, date, startTime, endTime) {
            date = moment(date)
            if (date.isValid()) {
                var dateOutput = date.format('DD/MM/YYYY')
                $('input[name="start_datetime[date]"]').val(dateOutput)
                $('input[name="end_datetime[date]"]').val(dateOutput)
            }

            startTime = moment(startTime, 'HH:mm')
            if (startTime.isValid()) {
                $('input[name="start_datetime[hour]"]').val(startTime.format('h'))
                $('input[name="start_datetime[minute]"]').val(startTime.format('mm'))
                $('select[name="start_datetime[meridien]"]').val(startTime.format('a'))
            }

            endTime = moment(endTime, 'HH:mm')
            if (endTime.isValid()) {
                $('input[name="end_datetime[hour]"]').val(endTime.format('h'))
                $('input[name="end_datetime[minute]"]').val(endTime.format('mm'))
                $('select[name="end_datetime[meridien]"]').val(endTime.format('a'))
            }
        })

    // remote validation rules
    // Have some sort of helper for creating remote validations.
    var getValidatorRemoteMethod = function(code, key) {
        return function(value, element) {
            return (errors[key || element.name] || []).indexOf(code) < 0;
        }
    }

    // Remote rules for start date
    // Some of these should be made into local rules.
    $.validator.addMethod(
        'remote.invalidStart',
        getValidatorRemoteMethod('invalid', 'start_datetime'),
        'Please enter a valid date.'
    )
    $.validator.addMethod(
        'remote.conflict',
        getValidatorRemoteMethod('conflict', 'start_datetime'),
        'This item has already been booked for this time.'
    )
    $.validator.addMethod(
        'remote.timetabledClass',
        getValidatorRemoteMethod('timetabled_class', 'start_datetime'),
        'This room is already timetabled for this time.'
    )
    $.validator.addMethod(
        'remote.inPast',
        getValidatorRemoteMethod('in_past', 'start_datetime'),
        'Items may not be booked for the past.'
    )
    $.validator.addMethod(
        'remote.tooEarly',
        getValidatorRemoteMethod('too_early', 'start_datetime'),
        'This item must be booked at least ' + {{ include('sub/interval.twig', {interval: item.resource.minLeadTime})|json_encode|raw }} + ' in advance.'
    )

    // Remote rules for end date
    $.validator.addMethod(
        'remote.invalidEnd',
        getValidatorRemoteMethod('invalid', 'end_datetime'),
        'Please enter a valid date.'
    )
    $.validator.addMethod(
        'remote.beforeStart',
        getValidatorRemoteMethod('before_start', 'end_datetime'),
        'The booking start time must be before the end time.'
    )
    $.validator.addMethod(
        'remote.tooShort',
        getValidatorRemoteMethod('too_short', 'end_datetime'),
        'This item must be booked for at least ' + {{ include('sub/interval.twig', {interval: item.resource.minReservationTime})|json_encode|raw }} + '.'
    )
    $.validator.addMethod(
        'remote.tooLong',
        getValidatorRemoteMethod('too_long', 'end_datetime'),
        'This item may not be booked for more than ' + {{ include('sub/interval.twig', {interval: item.resource.maxReservationTime})|json_encode|raw }} + '.'
    )

    // Set up errors, dialog boxes, form
    var errors = {}
    var form   = $('form#resource-booking-form')

    // Input for efficacy of update for series bookings (update all, or this only)
    var efficacyInput = form.find('input[name="efficacy"]')

    // Set up dialog boxes for cancel and update
    var updateDialog = $('#dialog-bulk-update')
    var cancelDialog = $('#dialog-bulk-cancel')
    $().add(updateDialog).add(cancelDialog).dialog({
        autoOpen:false,
        resizable:false,
        width:400,
        modal:true,
        draggable:false,
        buttons:[
            {
                text: "Only this event",
                click: function() {
                    efficacyInput.val('self')
                    $(this).trigger('confirm')
                }
            },
            {
                text: "All events in the series",
                click: function() {
                    efficacyInput.val('series')
                    $(this).trigger('confirm')
                }
            }
        ],
        close:function () {
            return false;
        }
    }).on('confirm', function() {
        $(this).dialog('close')
        callback()
    })

    // Callback for form validation and save in one step
    var callback = function() {
        var ajaxParams = {
            url:      form.attr('action'),
            type:     form.attr('method'),
            data:     form.serializeArray(),
            dataType: 'json'
        }
        var ajaxDone = function(data) {

            /* Use a calling module's callback url, pass it booking ids
             * that were just created for it
             */
            if (data.callbackUrl.length) {
                var ids = data.item.join();

                window.location.href = data.callbackUrl + '?ids=' + ids;
            }
            // Go back to bookings list for this item
            else {
                window.location.href = $('#resource-booking-back').attr('href');
            }
        }
        var ajaxFail = function(jqXHR) {
            errors = jqXHR.responseJSON.errors
            form.valid()
        }
        $.ajax(ajaxParams).done(ajaxDone).fail(ajaxFail)
    }

    // Submit resource booking form via AJAX
    form.validate({
        rules: {
            'start_datetime[date]': {
                required: true,
                datepickerDate: true,
                'remote.invalidStart': true,
                'remote.inPast': true,
                'remote.tooEarly': true,
                'remote.conflict': true,
                'remote.timetabledClass': true
            },
            'end_datetime[date]': {
                required: true,
                datepickerDate: true,
                'remote.invalidEnd': true,
                'remote.beforeStart': true,
                'remote.tooShort': true,
                'remote.tooLong': true
            },
            'start_datetime[hour]': {
                required: true,
                digits: true,
                range: [1, 12]
            },
            'end_datetime[hour]': {
                required: true,
                digits: true,
                range: [1, 12]
            },
            'start_datetime[minute]': {
                required: true,
                digits: true,
                range: [0, 59]
            },
            'end_datetime[minute]': {
                required: true,
                digits: true,
                range: [0, 59]
            },
            'start_datetime[meridien]': {
                required: true,
                selected: true
            },
            'end_datetime[meridien]': {
                required: true,
                selected: true
            }
        },
        errorPlacement: function(label, element) {
            var name = element.attr('name')
            switch (element.attr('name')) {
                case 'start_datetime[date]':
                case 'start_datetime[hour]':
                case 'start_datetime[minute]':
                case 'start_datetime[meriden]':
                case 'end_datetime[date]':
                case 'end_datetime[hour]':
                case 'end_datetime[minute]':
                case 'end_datetime[meriden]':
                    element.closest('td').append(label)
                    break
                default:
                    label.insertAfter(element)
                    break
            }
        },
        submitHandler: function() {
            // Consider: one pass for validation, another pass for saving
            var bookingId = form.find('input[name="id"]').val()
            var repeat    = form.find('input[name="repeat"]').val()
            if (bookingId && repeat) {
                // Show a different dialog for deletes
                if (form.data('action') === 'cancel') {
                    cancelDialog.dialog('open')
                }
                else {
                    updateDialog.dialog('open')
                }
            }
            else {
                callback()
            }
        },
        messages: {
            'start_datetime[date]': {
                required:       'Please enter a valid date.',
                datepickerDate: 'Please enter a valid date.'
            },
            'end_datetime[date]': {
                required:       'Please enter a valid date.',
                datepickerDate: 'Please enter a valid date.'
            },
            'start_datetime[hour]':     "Please enter a valid hour value.",
            'end_datetime[hour]':       "Please enter a valid hour value.",
            'start_datetime[minute]':   "Please enter a valid minute value.",
            'end_datetime[minute]':     "Please enter a valid minute value.",
            'start_datetime[meridien]': "Please select AM or PM.",
            'end_datetime[meridien]':   "Please select AM or PM."
        }
    })

    // On submission attempt: clear list of errors
    form.find('#resource-booking-save')
        .click(function() {
            errors = {}
            form.valid()
        })
        .click(function() {
            // Record that I clicked Save
            form.data('action', 'save')
        })
    form.find('#resource-booking-cancel')
        .click(function() {
            // Record that I clicked Cancel
            form.data('action', 'cancel')
        })

    // did I click the cancel button? If so, cancel this booking.
    // This should be in a different form to everything else.
    form.on('click', '#resource-booking-cancel', function(event) {
        event.preventDefault();
        $('#resource-booking-cancel-form').submit();
    })

    // Show/hide the repeat until input, depending on if a repeat is chosen.
    form.find('#repeatUntilSelect')
        .change(function() {
            if ($(this).val() !== '') {
                $('#repeatUntil').show();
                $("#repeat_until").rules("add", "required");
            }
            else {
                $('#repeatUntil').hide();
                $("#repeat_until").rules("remove", "required");
            }
        })
        .change()

    // Set up tabz for the projector.
    // Always default to setting a date and time directly, though.
    $('[data-interaction="tabs"]').tabs({
        heightStyle: 'auto',
        active: 0
    });
})
</script>
<!-- END custom_header -->

<h1>{% if item.id is empty %}Book Item{% else %}Update Booking{% endif %}: {% include '@resourceItem/sub/itemName.twig' with {item: item.resource} %}</h1>

{# booking form #}
{% set saveAction = item.id is empty ?
    routeLookup('resourceBooking.createBooking', {id: item.resource.id}) :
    routeLookup('resourceBooking.update:post',   {id: item.id})
%}
<form id="resource-booking-form"
      action="{{ saveAction }}"
      method="post"
      name="form" class="clearfix"
>
    <input type="hidden" name="id" value="{{ item.id }}"/>
    <input type="hidden" name="callbackUrl" value="{{ callbackUrl }}" />
    <table class="standardForm table">
        <tr>
            <td class="formLabelWidth"><h4>Rules</h4></td>
            <td>
                {% include '@resourceItem/sub/rules.twig' with {item: item.resource} %}
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Name</h4>
            </td>
            <td>
                <input name="name" type="text" value="{{ item.name }}" />
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Booking Time</h4>
            </td>
            <td>
                <div data-interaction="tabs">
                    <ul>
                        <li><a href="#dateSelector">Choose a Time</a></li>
                        <li><a href="#timetableSelector">Choose from Timetable</a></li>
                    </ul>
                    <div id="timetableSelector">
                        <em>You may select a timetable day and period to book this item for here.</em>
                        <em>If you want this booking to recur for a timetable period, then
                            make sure you select the "Timetable Based" option in "Repeat".</em>

                        <dl class="clearfix" data-interaction="timetableSelector">
                            <dt>Campus</dt>
                            <dd>
                                <select id="timetableCampus" name="timetable[campus]" data-role="campusSelector">
                                    <option disabled>-- select campus --</option>
                                    {% for campus in campusList %}
                                        <option value="{{ campus.id }}"
                                                label="{{ campus.name }}"
                                                >{{ campus.name }}</option>
                                    {% endfor %}
                                </select>
                            </dd>
                            <dt>Day</dt>
                            <dd>
                                <select id="timetableDay" name="timetable[day]" disabled data-role="daySelector">
                                    <option disabled>-- select day --</option>
                                </select>
                            </dd>
                            <dt>Period</dt>
                            <dd>
                                <select id="timetablePeriod" name="timetable[period]" disabled data-role="periodSelector">
                                    <option disabled>-- select period --</option>
                                </select>
                            </dd>
                            <dt>Date</dt>
                            <dd>
                                <time data-role="selectedDate"></time>
                                <time data-role="selectedTimeStart"></time>
                                <time data-role="selectedTimeEnd"></time>
                            </dd>
                            <dt>&nbsp;</dt>
                            <dd>
                                <a data-interaction="previousDate" class="btn go-back no-text float-left" title="Previous" href="#"><span></span></a>
                                <a data-interaction="nextDate" class="btn go-to no-text float-left" title="Next" href="#"><span></span></a>
                                <a data-interaction="useDate" class="btn tick no-text float-left" title="Use this date" href="#"><span></span></a>
                            </dd>
                        </dl>
                    </div>
                    <div class="clearfix" id="dateSelector">
                        <dl>
                            <dt>Start Time</dt>
                            <dd>
                                {#{% include 'sub/errors.twig' with {errors: errors.start_datetime} %}#}
                                {% include 'sub/datetimeInput.twig' with {
                                    value: item.event.startDateTime,
                                    name:  'start_datetime',
                                    id:    'start_datetime'
                                } %}
                            </dd>
                            <dt>End Time</dt>
                            <dd>
                                {% include 'sub/datetimeInput.twig' with {
                                    value: item.event.endDateTime,
                                    name:  'end_datetime',
                                    id:    'end_datetime'
                                } %}
                            </dd>
                        </dl>
                    </div>
                </div>
                {# Select campus, day, period #}
                {# on change campus: deselect day and period#}
            </td>
        </tr>
        {% if item.event.id is empty %}
        <tr>
        <td class="formLabelWidth" valign="top">
            <h4>Repeat</h4>
            <em>The frequency with which this booking recurs, if at all.</em>
        </td>
        <td>
            <select name="repeat" id="repeatUntilSelect">
                <option value="">Single Booking</option>
                <optgroup label="Recurring">
                    <option value="daily">Daily</option>
                    <option value="weekly">Weekly</option>
                    <option value="fortnightly">Fortnightly</option>
                    <option value="monthly">Monthly</option>
                    <option value="timetable">Timetable Based</option>
                </optgroup>
            </select>
        </td>
        </tr>
        <tr id="repeatUntil">
            <td class="formLabelWidth" valign="top">
                <h4>Repeat Until</h4>
                <em>The date at which recurrence should cease.</em>
            </td>
            <td>
                <input data-datepicker name="repeat_until" id="repeat_until" type="text" size="15" maxlength="30" value=""/>
            </td>
        </tr>
        {% elseif recurrence %}
        <tr>
            <td class="formLabelWidth" valign="top">
                <h4>Repeat</h4>
                <em>This booking is part of a recurring series.</em>
            </td>
            <td>
                <input name="repeat" type="hidden" value="{{ recurrence.freq }}" />
                {% include 'sub/recurrence.twig' with {recurrence: recurrence} %}
            </td>
        </tr>
        {% endif %}
        <tr>
            <td class="formLabelWidth"><h4>Notes</h4></td>
            <td><textarea name="description" style="width:100%;">{{ item.event.detail }}</textarea></td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Related Resources</h4>
                {% if item.resource.relatedResourceList|length %}
                <em>If you want to book any related resources, select them here.</em>
                {% endif %}
            </td>
            <td>
                {# Related resources - not sure whether this list should be editable after save #}
                <ul>
                {% for relatedItem in item.resource.relatedResourceList %}
                    <li>
                        <input id="related-item-{{ relatedItem.id }}"
                               type="checkbox"
                               name="related_item[]"
                               value="{{ relatedItem.id }}"
                               {% if item.hasRelatedBookingForResource(relatedItem.id) %}checked{% endif %}
                        />
                        <label for="related-item-{{ relatedItem.id }}">{{ relatedItem.name }}</label>
                    </li>
                {% else %}
                    <li>This resource has no related resources.</li>
                {% endfor %}
                </ul>
            </td>
        </tr>
    </table>

    {# Inputs for editing bookings in a series #}
    <input name="efficacy" type="hidden" value="self" />

    {# Input for determining which action to run #}
    <input name="action" type="hidden" />

    <input id="resource-booking-save"
           type="submit"
           value="{% if item.id %}Update Booking{% else %}Book{% endif %}"
           class="submit-btn-plain"
           data-action="{{ saveAction }}"
    />

    {% if item.id %}
        <input id="resource-booking-cancel"
               type="submit"
               value="Cancel Booking"
               class="submit-btn-plain"
               data-action="{{ routeLookup('resourceBooking.cancel', {id: item.id}) }}"
        />
    {% endif %}

    <a id="resource-booking-back"
       class="submit-btn-plain"
       href="{{ routeLookup('resourceItem.read', {id: item.resource.id}) }}">Back to list</a>

</form>

{# Hidden form for cancelling a booking.
 # This should redirect to the last page I was on.
 #}
<form id="resource-booking-cancel-form" action="{{ routeLookup('resourceBooking.cancel', {id: item.id}) }}">
    <input type="hidden" name="callbackUrl" value="{{ cancelCallbackUrl }}" />
</form>

{# Booking for bulk events #}
<div id="dialog-bulk-cancel" title="This booking is part of a series" class="wysiwyg">
    Would you like to cancel only this booking, or all in the series?
    <ul>
        <li>
            Bookings in this series that have already occured will not be
            retrospectively cancelled.
        </li>
    </ul>
</div>

<div id="dialog-bulk-update" title="This booking is part of a series" class="wysiwyg">
    Would you like to update only this booking, or all in the series? If you
    update all bookings in the series:
    <ul>
        <li>
            The start and end time of the other bookings in the series will be
            adjusted by the amount you adjusted this booking.
        </li>
        <li>
            Any approved bookings whose start or end time have changed will need
            to be approved again.
        </li>
        <li>
            Bookings in this series that have already occured will not be
            retrospectively changed.
        </li>
    </ul>
</div>
