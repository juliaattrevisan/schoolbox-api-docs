<link rel="stylesheet" type="text/css" href="/javascript/components/fullcalendar/fullcalendar.css" />
<link rel="stylesheet" type="text/css" href="/javascript/components/fullcalendar/fullcalendar.print.css" media="print" />
<link rel="stylesheet" type="text/css" href="/css/core/fullcalendar/fullcalendar.overrides.css" />
<script type="text/javascript" src="/javascript/jquery.calendar_export.js"></script>
<script type="text/javascript" src="/javascript/jquery.fullcalendar.js"></script>

{# Datepicker is always included. Load the timepicker, because it isn't. #}
<script type='text/javascript' src='/javascript/components/jquery-timepicker-jt/jquery.timepicker.js'></script>

<script type="text/javascript">

// provide page-wide access to the calendar object so the callbacks can actually use it
//var c;

// once the DOM has loaded, punch a fancy calendar into it
$(document).ready(function() {

    // Datepickers
    $('input[data-datepicker]').datepicker({
        dateFormat:'dd/mm/yy',
        showOn:'both',
        buttonImage:'/images/core/calendar/calendar-click.png',
        buttonImageOnly:true,
        constrainInput:false,
        minDate: 0,
        beforeShow: function() {
            // Make sure the stupid datepicker shows above everything else,
            // because it doesn't respect any CSS datepicker setting I give it
            setTimeout(function() {
                $('.ui-datepicker').css('z-index', 99999999999999);
            }, 0);
        }
//        onClose:function (string) {
//            var input = $j(this);
//            $j.getJSON('/ajax/strtotime.php', {string:string}, function (data) {
//                input.val(data.time);
//            })
//        }
    });

    // Timepickers
    $('input[data-timepicker]').timepicker({
        timeFormat:'H:i',
        step:15
    });

    var now = new Date();
    var c   = new Calendar('calendar', 'calendar-bubble', {
        crud: {
            c: '/calendar/ajax/create',
            // r: don't need it
            u: '/calendar/ajax/update',
            d: '/calendar/ajax/delete'
        },
        filter: {
            enabled: false
        },
        fullCalendar: {
            date:  now.getDate(),
            month: now.getMonth(),
            year:  now.getFullYear(),
            columnFormat: 'ddd d/M',
            defaultView: 'month',
            timeFormat: { month: 'h(:mm)tt' },
            events: function(start, end, callback) {
                $.ajax({
                    dataType: 'json',
                    url:      {{ routeLookup('resourceBooking.bookingCalendar', {id: resource.id})|json_encode|raw }},
                    data: {
                        start:  Math.round(start.getTime()/1000),
                        end:    Math.round(end.getTime()/1000),
                        userId: 19
                    },
                    success: function(data) {
                        callback(data);
                    },
                    cache: false
                });
            },
            loading: function(isLoading) {
                if (isLoading === true) {
                    $('#calendar-loading').css({
                        top: ($j('#calendar').height() - $j('#calendar-loading').height())/2,
                        left: ($j('#calendar').width() - $j('#calendar-loading').width())/2
                    }).show();
                }
                else {
                    $('#calendar-loading').hide();
                }
            }
        },
        x: false
    }).init()
})
</script>

<div id="calendar-loading">
    <p><strong>Loading events...</strong></p>
</div>

<h1>Book item: {{ resource.name }}</h1>

{# booking form #}
<form action="{{ routeLookup('resourceBooking.createBooking', {id: resource.id}) }}" method="post"></form>

<form id="resource-booking-form"
      action="{{ routeLookup('resourceBooking.createBooking', {id: resource.id}) }}"
      method="post"
      name="form" class="clearfix"
>
    from: <input name="start-date" data-datepicker="" />, <input name="start-time" data-timepicker="" />
    to: <input name="end-date" data-datepicker="" />, <input name="end-time" data-timepicker="" />
    notes: <textarea name="notes"></textarea>

    <input id="resource-save"
           type="submit"
           value="Book"
           class="submit-btn-plain"
    />

</form>

<div id="calendar"></div>
<div id="calendar-export-dialog">
    <div id="calendar-export-dialog-text">
        Use the following URL as the source for your feed.
    </div>
    <textarea readonly id="calendar-export-dialog-url"></textarea>
</div>
