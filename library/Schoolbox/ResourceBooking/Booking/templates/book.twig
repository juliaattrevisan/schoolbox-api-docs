<!-- BEGIN custom_header -->
<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" src="/javascript/components/jquery-validation/dist/additional-methods.js"></script>
<script type="text/javascript">

$(function() {
    // A global variable
    var momentFormat = dateDisplayFormats.momentJs;
    $.fn.alaressEditor();

    // remote validation rules
    // Have some sort of helper for creating remote validations.
    var getValidatorRemoteMethod = function(code, key) {
        return function(value, element) {
            return (errors[key || element.name] || []).indexOf(code) < 0;
        }
    };

    // Remote rules for start date
    // Some of these should be made into local rules.
    $.validator.addMethod(
        'remote.invalidStart',
        getValidatorRemoteMethod('{{ validationErrors.invalid }}', '{{ validationData.start }}'),
        'Please enter a valid date.'
    );
    $.validator.addMethod(
        'remote.conflict',
        getValidatorRemoteMethod('{{ validationErrors.conflict }}', '{{ validationData.start }}'),
        'This item has already been booked for this time.'
    );
    $.validator.addMethod(
        'remote.timetabledClass',
        getValidatorRemoteMethod('{{ validationErrors.timetabledClass }}', '{{ validationData.start }}'),
        'This room is already timetabled for this time.'
    );
    $.validator.addMethod(
        'remote.inPast',
        getValidatorRemoteMethod('{{ validationErrors.inPast }}', '{{ validationData.start }}'),
        'Items may not be booked for the past.'
    );
    $.validator.addMethod(
        'remote.tooEarly',
        getValidatorRemoteMethod('{{ validationErrors.tooEarly }}', '{{ validationData.start }}'),
        'This item must be booked at least ' + {{ include('sub/interval.twig', {interval: item.resource.minLeadTime})|json_encode|raw }} + ' in advance.'
    );

    // Remote rules for end date
    $.validator.addMethod(
        'remote.invalidEnd',
        getValidatorRemoteMethod('{{ validationErrors.invalid }}', '{{ validationData.end }}'),
        'Please enter a valid date.'
    );
    $.validator.addMethod(
        'remote.beforeStart',
        getValidatorRemoteMethod('{{ validationErrors.beforeStart }}', '{{ validationData.end }}'),
        'The booking start time must be before the end time.'
    );
    $.validator.addMethod(
        'remote.tooShort',
        getValidatorRemoteMethod('{{ validationErrors.tooShort }}', '{{ validationData.end }}'),
        'This item must be booked for at least ' + {{ include('sub/interval.twig', {interval: item.resource.minReservationTime})|json_encode|raw }} + '.'
    );
    $.validator.addMethod(
        'remote.tooLong',
        getValidatorRemoteMethod('{{ validationErrors.tooLong }}', '{{ validationData.end }}'),
        'This item may not be booked for more than ' + {{ include('sub/interval.twig', {interval: item.resource.maxReservationTime})|json_encode|raw }} + '.'
    );
    $.validator.addMethod(
        'remote.currentTerm',
        getValidatorRemoteMethod('{{ validationErrors.currentTerm }}', '{{ validationData.end }}'),
        'This item may not be booked outside of the current term.'
    );

    // Repeat-Until must be after StartDate
    $.validator.addMethod(
            'afterStart',
            function(value,element){
                var startDate       = moment($('#startDate').val(),momentFormat);
                var repeatUntilDate = moment(value,momentFormat);

                return '' == value || startDate.valueOf() < repeatUntilDate.valueOf();
            },
            'Repeat-Until date must be after start date'
    );


    // Set up errors, dialog boxes, form
    var errors = {};
    var form   = $('form#resource-booking-form');

    // Input for efficacy of update for series bookings (update all, or this only)
    var efficacyInput = form.find('input[name="efficacy"]');

    // Set up dialog boxes for cancel and update
    var updateDialog = $('#dialog-bulk-update');
    var cancelDialog = $('#dialog-bulk-cancel');
    var dialogs      = $().add(updateDialog).add(cancelDialog);
    dialogs
        .on('click', '[data-efficacy="{{ efficacySelf }}"]', function(e) {
            e.preventDefault();
            efficacyInput.val('{{ efficacySelf }}');
            dialogs.foundation('reveal', 'close');
            callback();
        })
        .on('click', '[data-efficacy="{{ efficacySeries }}"]', function(e) {
            e.preventDefault();
            efficacyInput.val('{{ efficacySeries }}');
            dialogs.foundation('reveal', 'close');
            callback();
        })
        .on('click', '[data-interaction="close"]', function(e) {
            e.preventDefault();
            dialogs.foundation('reveal', 'close');
        });

    // Callback for form validation and save in one step
    var callback = function() {

        /* Update the textarea behind the CK box -_-
         * Occurs when submit event listener is used
         * for things like validation etc.
         */
        $.each(CKEDITOR.instances, function() {
            this.updateElement();
        });

        var ajaxParams = {
            url:      form.attr('action'),
            type:     form.attr('method'),
            data:     form.serializeArray(),
            dataType: 'json'
        };
        var ajaxDone = function(data) {

            /* Use a calling module's callback url, pass it booking ids
             * that were just created for it
             */
            if (data.callbackUrl.length) {
                if (!data.callbackUrl.includes('#resourceBookingByCategory')) {
                    var ids = data.item.map(function(v) { return v.id; }).join();

                    window.location.href = data.callbackUrl + '?ids=' + ids;
                }

                window.location.href = data.callbackUrl;
            } else {
                // Get the time of the first booking, direct to that date
                var dateQuery = '';
                try {
                    var date = moment(data.item[0].event.start);
                    dateQuery += '?date='+date.format('DD-MM-YYYY');
                } catch (e) {
                    // noop
                }
                window.location.href = $('#resource-booking-back').attr('href')+dateQuery;
            }
        };
        var ajaxFail = function(jqXHR) {
            errors = jqXHR.responseJSON.errors;
            form.valid()
        };

        // Deactivate the button
        var button   = form.find('input#resource-booking-save');
        var oldValue = button.attr('value');
        button.prop('disabled', true).attr('value', button.data('loading-value'));
        $.ajax(ajaxParams)
            .done(ajaxDone)
            .fail(ajaxFail)
            .always(function() {
                button.prop('disabled', false).attr('value', oldValue);
            });
    };

    // Submit resource booking form via AJAX
    form.alaressValidate({
        ignore: ':disabled',
        rules: {
            'startDate': {
                required: true,
                datepickerDate: true,
                'remote.invalidStart': true,
                'remote.inPast': true,
                'remote.conflict': true,
                'remote.timetabledClass': true,
                'remote.tooEarly': true
            },
            'endDate': {
                required: true,
                datepickerDate: true,
                'remote.invalidEnd': true,
                'remote.beforeStart': true,
                'remote.currentTerm': true,
                'remote.tooShort': true,
                'remote.tooLong': true
            },
            'repeat_until': {
                datepickerDate: {
                    depends: function() {
                        return $('#repeatUntilSelect').val() !== ''
                    }
                },
                'afterStart': {
                    depends: function() {
                        return $('#repeatUntilSelect').val() !== ''
                    }
                },
            },
            'campus': {
                required: {
                    depends: function() {
                        return $('#repeatUntilSelect').val() == "timetable"
                    }
                }
            }
        },
        submitHandler: function() {
            // Consider: one pass for validation, another pass for saving
            var bookingId = form.find('input[name="id"]').val();
            var repeat    = form.find('input[name="repeat"]').val();
            if (bookingId && repeat) {
                // Show a different dialog for deletes
                if (form.data('action') === 'cancel') {
                    cancelDialog.foundation('reveal', 'open');
                }
                else {
                    updateDialog.foundation('reveal', 'open');
                }
            }
            else {
                callback()
            }
        },
        messages: {
            'startDate': {
                required:       'Please enter a valid date',
                datepickerDate: 'Please enter a valid date'
            },
            'endDate': {
                required:       'Please enter a valid date',
                datepickerDate: 'Please enter a valid date'
            },
            'repeat_until': {
                datepickerDate: 'Please enter a valid date',
                'afterStart':   'Repeat-until date must be after start date'
            }
        }
    });

    // On submission attempt: clear list of errors
    form.find('#resource-booking-save')
        .click(function() {
            errors = {};
            form.valid()
        })
        .click(function() {
            // Record that I clicked Save
            form.data('action', 'save')
        });
    form.find('#resource-booking-cancel')
        .click(function() {
            // Record that I clicked Cancel
            form.data('action', 'cancel')
        });

    // did I click the cancel button? If so, cancel this booking.
    // This should be in a different form to everything else.
    form.on('click', '#resource-booking-cancel', function(event) {
        event.preventDefault();
        $('#resource-booking-cancel-form').submit();
    });

    // Show/hide the repeat until input, depending on if a repeat is chosen.
    form.find('#repeatUntilSelect')
        .change(function() {
            if ($(this).val() !== '') {
                $('#repeatUntil').show();
                $("#repeat_until").rules("add", "required");
            }
            else {
                $('#repeatUntil').hide();
                $("#repeat_until").rules("remove", "required");
            }
        })
        .change();

    // Related Resources:
    // show/hide name and notes
    form.on(
        'change',
        'input[data-interaction="display-notes"]',
        function(event) {
            var notes = $(this)
                .closest('[data-relation="related-resource"]')
                .find('[data-relation="related-resource-notes"]')
            ;
            if (this.checked) {
                // Dunno if this disables tinyboxes
                notes.slideDown('fast', function() {
                    notes.find(':input').prop('disabled', false);
                });
            } else {
                notes.slideUp('fast', function() {
                    notes.find(':input').prop('disabled', true);
                });
            }
        }
    )

    $('#campusList').hide();
    form.on('change', '#repeatUntilSelect', function(event) {
        if($('#repeatUntilSelect').val() == "timetable" && $('#campusList').find('input[name="campus"]').length > 1){
            $('#campusList').show();
        }
        else{
            $('#campusList').hide();
        }
    });
});
</script>
<!-- END custom_header -->

<ul class="breadcrumb">
    <li><a href="/resource-booking/item">Resource Booking</a>
    <li><a href="{{ routeLookup('resourceItem.browse', {id: item.resource.category.id}) }}">{{  item.resource.category.name }}</a></li>
    <li><a id="resource-booking-back" href="{{ routeLookup('resourceItem.read', {id: item.resource.id}) }}">{{ item.resource.name }}</a></li>
    <li class="active"><a href="#">Booking</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>
            {% if item.id is empty %}
                Book Item
            {% else %}
                Update Booking
            {% endif %}
        </h1>

        <ul class="meta">
            <li class="icon-resource-booking">{% include '@resourceItem/sub/itemName.twig' with {item: item.resource} %}</li>
        </ul>
    </div>
</div>

{# booking form #}
{% set saveAction = item.id is empty ?
    routeLookup('resourceBooking.createBooking', {id: item.resource.id}) :
    routeLookup('resourceBooking.update:post',   {id: item.id})
%}

<div class="row">
    <div class="small-12 island">
        <div class="alert-box">
            {% include '@resourceItem/sub/rules.twig' with {item: item.resource, currentTerm: currentTerm} %}
        </div>
        <form id="resource-booking-form" action="{{ saveAction }}" method="post" name="form">
            <input type="hidden" name="id" value="{{ item.id }}"/>
            <input type="hidden" name="callbackUrl" value="{{ callbackUrl }}" />

            {# Inputs for editing bookings in a series #}
            <input type="hidden" name="efficacy" value="{{ efficacySelf }}" />

            {# Input for determining which action to run #}
            <input type="hidden" name="action" />

            <section>
                <fieldset class="content">
                    <legend>Overview</legend>
                    <div class="small-12 columns">
                        <label>
                            Purpose
                            <input name="name" type="text" value="{{ item.name }}" />
                        </label>
                    </div>
                    <div class="small-6 columns">
                        <label for="startDate" class="required">
                            From
                        </label>
                        <input name="startDate"
                               id="startDate"
                               data-datepicker
                               data-datepicker-time
                               data-datepicker-call="event"
                               data-datesync-enddate="#endDate"
                               type="text"
                               size="15"
                               maxlength="30"
                               value="{{ item.event.startDateTime.local }}"/>
                    </div>
                    <div class="small-6 columns">
                        <label for="endDate" class="required">
                            Until
                        </label>
                        <input name="endDate"
                               id="endDate"
                               data-datepicker
                               data-datepicker-time
                               data-datepicker-call="event"
                               data-datepicker-endofperiod
                               data-datesync-startdate="#startDate"
                               type="text"
                               size="15"
                               maxlength="30"
                               value="{{ item.event.endDateTime.local }}"/>
                    </div>
                </fieldset>

                {% if item.event.id is empty %}
                <fieldset class="content">
                    <legend>Recurrence</legend>
                    <div class="small-12 columns">
                        <label>
                            Repeat
                            <span class='hint has-tip tip-top' data-tooltip title="The frequency with which this booking recurs, if at all.">?</span>
                            <select name="repeat" id="repeatUntilSelect">
                                <option value="">Single Booking</option>
                                <optgroup label="Recurring">
                                    {% for key, value in recurrence %}
                                        <option value="{{ key }}">{{ value }}</option>
                                    {% endfor %}
                                </optgroup>
                            </select>
                        </label>

                        <div id="campusList">
                            <fieldset class="radiolist" data-equalizer-watch>
                                <legend>Campus Timetable:</legend>
                                {% for campus in campusList %}
                                    <input type="radio"
                                           name="campus"
                                           value="{{ campus.id }}"
                                           id="campus-{{ campus.id }}"
                                           {% if loop.first %}checked{% endif %}>
                                    <label for="campus-{{ campus.id }}">{{ campus.name }}</label>
                                {% endfor %}
                            </fieldset>
                        </div>

                        <div id="repeatUntil"> {# This ID must be on a div wrapping the label, because the input will be taken out of the label via JS #}
                            <label>
                                Repeat Until
                                <span class='hint has-tip tip-top' data-tooltip title="The date at which recurrence should cease.">?</span>
                                <input name="repeat_until" id="repeat_until" data-datepicker type="text" size="15" maxlength="30" value="" />
                            </label>
                        </div>
                    </div>
                </fieldset>
                {% elseif recurrence %}
                <fieldset class="content">
                    <legend>Repeat</legend>
                    <div class="small-12 columns">
                        <label>
                            Repeat
                            <span class='hint has-tip tip-top' data-tooltip title="This booking is part of a recurring series.">?</span>
                            <input name="repeat" type="hidden" value="{{ recurrence.freq }}" />
                            {% include 'sub/recurrence.twig' with {recurrence: recurrence} %}
                        </label>
                    </div>
                </fieldset>
                {% endif %}

                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Notes
                            <textarea name="notes" id="resource-booking-notes" >{{ item.notes }}</textarea>
                        </label>

                        {# Only a user who may moderate this item may ignore the rules. #}
                        {% if allowOverride %}
                            <input id="resource-booking-override-validation" type="checkbox" name="override_validation" value="1" />
                            <label for="resource-booking-override-validation" class="checkbox-label">
                                Bypass Validation
                                <span class='hint has-tip tip-top' data-tooltip title="Only select this if you are certain you wish to override the system rules">?</span>
                            </label>
                        {% endif %}
                    </div>
                </fieldset>

                <fieldset>
                    <div class="small-12 columns">
                        <fieldset>
                        <legend>
                            Related Resources
                            {% if item.resource.relatedResourceList|length %}
                            <span class='hint has-tip tip-top' data-tooltip title="If you want to book any related resources, select them here.">?</span>
                            {% endif %}
                        </legend>

                        {% if item.resource.relatedResourceList|length %}
                        {# Related resources - not sure whether this list should be editable after save #}
                        <ul class="action-list">
                        {% for relatedItem in item.resource.relatedResourceList %}
                            {% if item.hasRelatedBookingForResource(relatedItem.id) %}
                                {% set relatedBooking = item.getRelatedBookingForResource(relatedItem.id) %}
                            {% else %}
                                {% set relatedBooking = {} %}
                            {% endif %}
                            <li class="actions-small-1" data-relation="related-resource">
                                <div class="list-item">
                                    <div class="small-1 columns">
                                        <input id="related-item-{{ relatedItem.id }}" type="checkbox" name="related_item[{{ relatedItem.id }}][resource_id]" value="{{ relatedItem.id }}" data-interaction="display-notes" {% if relatedBooking is not empty %}checked{% endif %} />
                                        <label for="related-item-{{ relatedItem.id }}" class="checkbox-label"></label>
                                    </div>
                                    <div class="small-11 columns">
                                        <label for="related-item-{{ relatedItem.id }}">{{ relatedItem.name }}</label>
                                        <div data-relation="related-resource-notes" style="{% if relatedBooking is empty %}display:none{% endif %}">
                                            <textarea id="related-item-{{ relatedItem.id }}-notes" name="related_item[{{ relatedItem.id }}][notes]">{{ relatedBooking.notes }}</textarea>
                                        </div>

                                    </div>


                                </div>
                                <nav>
                                    <a href="{{ routeLookup('resourceItem.read', {id: relatedItem.id}) }}" class="icon-view" id="resource-read-{{relatedItem.id}}" title="View Bookings"></a>
                                </nav>
                            </li>
                            {% endfor %}
                        </ul>
                        {% else %}
                        <div class="content">
                            <p>This resource has no related resources.</p>
                        </div>
                        {% endif %}
                        </fieldset>
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <ul class="flex-list buttons">
                        <li>
                            <input id="resource-booking-save" type="submit" value="{% if item.id %}Update Booking{% else %}Book{% endif %}" data-action="{{ saveAction }}" data-loading-value="Validating..." />
                        </li>
                        {% if item.id %}
                        <li>
                            <a id="resource-booking-cancel" class="button" data-action="{{ routeLookup('resourceBooking.cancel', {id: item.id}) }}">Cancel Booking</a>
                        </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </form>
    </div>
</div>

{# Hidden form for cancelling a booking.
 # This should redirect to the last page I was on.
 #}
<form id="resource-booking-cancel-form" action="{{ routeLookup('resourceBooking.cancel', {id: item.id}) }}">
    <input type="hidden" name="callbackUrl" value="{{ cancelCallbackUrl }}" />
</form>

{# Booking for bulk events #}
<div class="reveal-modal" data-reveal aria-labelledby="dialog-booking-bulk-cancel-title" aria-hidden="true" role="dialog" id="dialog-bulk-cancel">
    <h2 id="dialog-booking-bulk-cancel-title">This booking is part of a series</h2>
    <p>Would you like to cancel only this booking, or all in the series?</p>
    <article>
        <ul>
            <li>
                Bookings in this series that have already occured will not be
                retrospectively cancelled.
            </li>
        </ul>
    </article>
</div>

<div class="reveal-modal" data-reveal aria-labelledby="dialog-booking-bulk-update-title" aria-hidden="true" role="dialog" id="dialog-bulk-update">
    <h2 id="dialog-booking-bulk-update-title">This booking is part of a series</h2>
    <p>Would you like to update only this booking, or all in the series? If you update all bookings in the series:</p>
    <article>
        <ul>
            <li>
                The start and end time of the other bookings in the series will be
                adjusted by the amount you adjusted this booking.
            </li>
            <li>
                Any approved bookings whose start or end time have changed will need
                to be approved again.
            </li>
            <li>
                Bookings in this series that have already occurred will not be
                retrospectively changed.
            </li>
        </ul>
    </article>
    <ul class="flex-list buttons">
        <li><a href="#" class="button" data-efficacy="{{ efficacySelf }}">Only this booking</a></li>
        <li><a href="#" class="button" data-efficacy="{{ efficacySeries }}">All bookings in the series</a></li>
        <li><a href="#" class="button" data-interaction="close">Cancel</a></li>
    </ul>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>
