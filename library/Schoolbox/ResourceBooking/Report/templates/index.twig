<!-- BEGIN custom_head -->
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/select-all/jquery.select-all.js?v={{ config.site_version }}"></script>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/dataTables.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        /* Search Form
         */
        var form = $('form[data-action="search"]');
        form.selectAll({
            selector: form.find(':checkbox[data-selectall="category[]"]'),
            checkboxes: form.find(':checkbox[name="category[]"]')
        });

        /* Results table
         */
        $('table[data-sortable]').DataTable({
            info: false,
            paging: false,
            searching: false
        });

        onChangeDate('start'); // In case the initial dates are ever set too far apart.
    });

    // This is the maximum date range period
    // (enforced to limit the amount of data the report can generate, and hence avoid timeout errors).
    const MAX_REPORTING_PERIOD_MONTHS = 3;

    /**
     * Ensure that:
     *  - start date is always on or before end date AND
     *  - the date range period never exceeds MAX_REPORTING_PERIOD_MONTHS.
     *
     * The MAX_REPORTING_PERIOD_MONTHS restriction is enforced at the server too.
     * So check ResourceBooking/Report/Controller.php after any changes here.
     */
    function onChangeDate(changedDateName)
    {
        const $startDate = $('#startDate');
        const $endDate = $('#endDate');
        const dateFormat = window.dateDisplayFormats.dayjs;

        let startDateObj = window.dayjs($startDate.val(), dateFormat);
        let endDateObj = window.dayjs($endDate.val(), dateFormat);

        switch (changedDateName) {
          case 'start':
                // If end date is behind start date, set end date to match start date.
                if (endDateObj.isBefore(startDateObj)) {
                    $endDate.val(startDateObj.format(dateFormat));
                } else {
                    // If end date is too far ahead of start date, set end date for maximum period.
                    let startDatePlusPeriodObj = startDateObj.add(MAX_REPORTING_PERIOD_MONTHS, 'month');
                    if (endDateObj.isAfter(startDatePlusPeriodObj)) {
                        $endDate.val(startDatePlusPeriodObj.format(dateFormat));
                    }
                }
                break;
            case 'end':
                // If start date is ahead of end date, set start date to match end date.
                if (startDateObj.isAfter(endDateObj)) {
                    $startDate.val(endDateObj.format(dateFormat));
                } else {
                    // If start date is too far behind end date, set start date for maximum period.
                    let endDateMinusPeriodObj = endDateObj.add(-MAX_REPORTING_PERIOD_MONTHS, 'month');
                    if (startDateObj.isBefore(endDateMinusPeriodObj)) {
                        $startDate.val(endDateMinusPeriodObj.format(dateFormat));
                    }
                }
                break;
        }
    }
</script>
<!-- END custom_head -->

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('resourceItem.browse') }}">Resources</a></li>
    <li class="active"><span>Booking Report</span></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Resource Booking Report</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <!-- Only show if printing -->
        <h2 class="hide printable">
            Bookings: {{ search.start.getLongDateOnly() }} – {{ search.end.getLongDateOnly() }},
            categories:
            {% if search.category|length == categoryList|length %}
                All
            {% else %}
                {% apply spaceless %}
                    {% for categoryId in search.category %}
                        {{ categoryList[categoryId].getName() }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                {% endapply %}
            {% endif %}
        </h2>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <!-- Do not include search form in printable version -->
        <form action="?" method="get" class="top" data-action="search">
            <h2 class="subheader">Search Filter Options</h2>
            <section>
                <fieldset class="content">
                    <legend>
                        Dates
                        <span class="hint has-tip tip-top" title="You can filter the resource calendar for up to a maximum period of 3 months">?</span>
                    </legend>
                    <div class="small-12 large-6 columns">
                        <label>
                            From
                            <input data-datepicker type='text' name="start" id="startDate" value="{{ search.start.getLocalShort() }}" onchange="onChangeDate('start')" />
                        </label>
                    </div>
                    <div class="small-12 large-6 columns">
                        <label>
                            To
                            <input data-datepicker type='text' name="end" id="endDate" value="{{ search.end.getLocalShort() }}" onchange="onChangeDate('end')" />
                        </label>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-6 columns">
                        <fieldset>
                            <legend>Categories</legend>
                            <ul class="option-list">
                                <li>
                                    <input id='select-all' type="checkbox" data-selectall="category[]" {% if search.category|length == categoryList|length %}checked{% endif %} />
                                    <label for="select-all" class="checkbox-label">All</label>
                                </li>
                                {% for category in categoryList %}
                                <li>
                                    <input id='category-checkbox-{{ category.getId() }}' type="checkbox" name="category[]" value="{{ category.getId() }}" {% if category.getId() in search.category %}checked{% endif %} />
                                    <label for='category-checkbox-{{ category.getId() }}' class="checkbox-label">
                                        {{ category.getName() }}
                                    </label>
                                </li>
                                {% endfor %}
                            </ul>
                        </fieldset>
                    </div>

                    <div class="small-6 columns">
                        <fieldset class="radiolist">
                            <legend>Clashes</legend>
                            <ul class="option-list">
                                <li><input type="radio" name="clashesOnly" value="0" id="clashesAllOption" {% if not search.clashesOnly %}checked{% endif %}><label for="clashesAllOption">Show All Bookings</label></li>
                                <li><input type="radio" name="clashesOnly" value="1" id="clashesOnlyOption" {% if search.clashesOnly %}checked{% endif %} ><label for="clashesOnlyOption">Only Show Conflicting Booking Requests</label></li>
                            </ul>
                        </fieldset>

                        <fieldset>
                            <legend>Classes</legend>
                            <input type="hidden" name="classes" value="0" />
                            <input id='show-classes-checkbox' type="checkbox" name="classes" value="1" {% if search.classes %}checked{% endif %} />
                            <label for="show-classes-checkbox" class="checkbox-label">Show Classes</label>
                        </fieldset>
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <input type="submit" value="Search" />
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="scrollable">
            <table data-sortable>
                <thead>
                <tr>
                    <th>Start</th>
                    <th>End</th>
                    <th>Booking</th>
                    <th>Venue/Resource</th>
                    <th>Quantity</th>
                    <th>Booker</th>
                    <th>Status</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for event in eventList %}
                    {% set booking = event.getBooking() ?? null %}
                    <tr>
                        <td data-sort="{{ event.getStartTime().getUnixTimeStamp() }}">
                             <time>
                                {{ event.getStartTime().getLocal() }}
                            </time>
                        </td>
                        <td data-sort="{{ event.getEndTime().getUnixTimeStamp() }}">
                            <time>
                                {{ event.getEndTime().getLocal() }}
                            </time>
                        </td>
                        <td>
                            {% set title = attribute(event, 'getTitleForResourceBooking') is defined ? event.getTitleForResourceBooking() : event.getTitle() %}
                            {% if booking is empty %}
                                {{ title }}
                            {% else %}
                                {% if event.getEventVariant() == 'event' %}
                                    {% set route = routeLookup('calendarEvent.getEvent', {eventId: event.getOriginalEvent().getId()}) %}
                                {% else %}
                                    {% set route = routeLookup('resourceBooking.edit', {id: booking.getId()}) %}
                                {% endif %}
                                <a href="{{ route }}">
                                    {{ title }}
                                </a>
                            {% endif %}
                        </td>
                        <td>
                            {% if booking is empty %}
                                {% if event.resourceId is empty %}
                                    {{ event.getLocation() }}
                                {% else %}
                                    <a href="{{ routeLookup('resourceItem.read', {id: event.resourceId}) }}">
                                        {{ event.getLocation() }}
                                    </a>
                                {% endif %}
                            {% else %}
                                <a href="{{ routeLookup('resourceItem.read', {id: booking.getResource().getId()}) }}">
                                    {{ booking.getResource().getRoomCode() | default(booking.getResource().getName()) }}
                                </a>
                            {% endif %}
                        </td>
                        <td>
                            {% if booking is empty %}
                                &nbsp;
                            {% else %}
                                {{ bookingQuantity }}
                            {% endif %}
                        </td>
                        <td>
                            {% if booking is empty %}
                                &nbsp;
                            {% else %}
                                {% set booker = booking.getEvent().getOwner() %}
                                <a href="/search/user/{{ booker.getId() }}">
                                    {{ booker.formatName() }}
                                </a>
                            {% endif %}
                        </td>
                        <td>
                            {% if booking is empty %}
                                &nbsp;
                            {% else %}
                                {{ booking.getStatus().getName() }}
                            {% endif %}
                        </td>
                        <td>
                            {% if booking is empty %}
                                &nbsp;
                            {% else %}
                            <article>{{ booking.getNotes()|purify }}</article>
                            {% endif %}
                        </td>
                        <td>
                            {% if booking is empty or not booking.getStatus().isPending() %}
                                &nbsp;
                            {% else %}
                                {% set approveRoute = routeLookupIfAuthorized('resourceBooking.approve', {id: booking.getId(), item: booking}) %}
                                {% set rejectRoute = routeLookupIfAuthorized('resourceBooking.reject', {id: booking.getId(), item: booking}) %}
                                {% if approveRoute or rejectRoute %}
                                    <ul class="flex-list buttons">
                                        {% if approveRoute %}
                                            <li>
                                                <a href="{{ approveRoute }}" class="sbx-button--has-icon">
                                                    <sbx-icon name="approve"></sbx-icon>
                                                    Approve
                                                </a>
                                            </li>
                                        {% endif %}
                                        {% if rejectRoute %}
                                            <li>
                                                <a href="{{ rejectRoute }}" class="sbx-button--has-icon">
                                                    <sbx-icon name="close"></sbx-icon>
                                                    Reject
                                                </a>
                                            </li>
                                        {% endif %}
                                    </ul>
                                {% else %}
                                    &nbsp;
                                {% endif %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
