<h1>Bookings: {{ search.start.getLongDateOnly() }} – {{ search.end.getLongDateOnly() }}</h1>

<div class="directory">

    <form method='get' action='?' class="noprint" data-action="search">
    <h2>Search Filter Options</h2>
    <table class="standardForm table">
        <colgroup>
            <col width="250"/>
        </colgroup>
        <tr>
            <td><h4>From Date</h4></td>
            <td><input data-datepicker name="start" value="{{ search.start.getLocalShort() }}" /></td>
        </tr>
        <tr>
            <td><h4>To Date</h4></td>
            <td><input data-datepicker name="end" value="{{ search.end.getLocalShort() }}" />
            </td>
        </tr>
        <tr>
            <td><h4>Categories</h4></td>
            <td>
                <label>
                    <input type="checkbox"
                           data-selectall="category[]"
                           {% if search.category is empty or search.category|length == categoryList|length %}checked{% endif %}
                    />
                    All
                </label>
                {% for category in categoryList %}
                <label>
                    <input type="checkbox"
                           name="category[]"
                           value="{{ category.getId() }}"
                           {% if search.category is empty or category.getId() in search.category %}checked{% endif %}
                    />
                    {{ category.getName() }}
                </label>
                {% endfor %}
            </td>
        </tr>
        <tr>
            <td></td>
            <td><input class='submit-btn-plain' type='submit' value='Search' /></td>
        </tr>
    </table>
    </form>

    <table class="fullwidth table" data-sortable>
        <thead>
        <tr>
            <th>Start</th>
            <th>End</th>
            <th>Name</th>
            <th>Venue</th>
            <th>Notes</th>
        </tr>
        </thead>
        <tbody>
        {% for booking in bookingList %}
            <tr>
                <td>
                    <time datetime="{{ booking.getEvent().getStartDateTime().getDatabase() }}">
                        {{ booking.getEvent().getStartDateTime().getLocal() }}
                    </time>
                </td>
                <td>
                    <time datetime="{{ booking.getEvent().getEndDateTime().getDatabase() }}">
                        {{ booking.getEvent().getEndDateTime().getLocal() }}
                    </time>
                </td>
                <td>
                    <a href="{{ routeLookup('resourceBooking.edit', {id: booking.getId()}) }}">
                        {{ booking.getName() }}
                    </a>
                </td>
                <td>
                    <a href="{{ routeLookup('resourceItem.read', {id: booking.getResource().getId()}) }}">
                        {% include "@resourceItem/sub/itemName.twig" with {item: booking.getResource()} %}
                    </a>
                </td>
                <td>{{ booking.getNotes()|purify }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<script type="text/javascript" src="/javascript/components/jquery.tablesorter/js/jquery.tablesorter.js"></script>
<script type="text/javascript" src="/javascript/components/jquery.tablesorter/js/jquery.tablesorter.widgets.js"></script>
<script type="text/javascript" src="/javascript/jquery.selectAll.js"></script>
<script type="text/javascript">
    $.tablesorter.addParser({
        id: 'datetime',
        is: function() { return false },
        format: function(value, table, cell) {
            return $(cell).find('time').attr('datetime')
        },
        type: 'text'
    });
    $(function() {
        $('[data-sortable]').tablesorter({
            headers:{
                0:{sorter:'datetime'},
                1:{sorter:'datetime'},
                4:{sorter:false}
            },
            widgets:['zebra'],
            widgetZebra:{
                css:["", "dark"]
            },
            cssHeader:"directory-sorter"
        });
        $('[data-datepicker]').datepicker();

        var form = $('form[data-action="search"]');
        form.selectAll({
            selector: form.find(':checkbox[data-selectall="category[]"]'),
            checkboxes: form.find(':checkbox[name="category[]"]')
        });
    });
</script>
