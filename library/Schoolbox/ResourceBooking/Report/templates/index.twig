<h1>Resource Booking Report</h1>

<div class="directory">

    <!-- Only show if printing -->
    <h2 class="hide printable">
        Bookings: {{ search.start.getLongDateOnly() }} – {{ search.end.getLongDateOnly() }},
        categories:
        {% if search.category|length == categoryList|length %}
            All
        {% else %}
            {% spaceless %}
                {% for categoryId in search.category %}
                    {{ categoryList[categoryId].getName() }}{% if not loop.last %}, {% endif %}
                {% endfor %}
            {% endspaceless %}
        {% endif %}
    </h2>

    <form method='get' action='?' class="noprint" data-action="search">
    <h2>Search Filter Options</h2>
    <table class="standardForm table">
        <colgroup>
            <col width="250"/>
        </colgroup>
        <tr>
            <td><h4>From Date</h4></td>
            <td><input data-datepicker name="start" value="{{ search.start.getLocalShort() }}" /></td>
        </tr>
        <tr>
            <td><h4>To Date</h4></td>
            <td><input data-datepicker name="end" value="{{ search.end.getLocalShort() }}" />
            </td>
        </tr>
        <tr>
            <td><h4>Categories</h4></td>
            <td>
                <label>
                    <input type="checkbox"
                           data-selectall="category[]"
                           {% if search.category|length == categoryList|length %}checked{% endif %}
                    />
                    All
                </label>
                {% for category in categoryList %}
                <label>
                    <input type="checkbox"
                           name="category[]"
                           value="{{ category.getId() }}"
                           {% if category.getId() in search.category %}checked{% endif %}
                    />
                    {{ category.getName() }}
                </label>
                {% endfor %}
            </td>
        </tr>
        <tr>
            <td></td>
            <td><input class='submit-btn-plain' type='submit' value='Search' /></td>
        </tr>
    </table>
    </form>

    <table class="fullwidth table" data-sortable>
        <thead>
        <tr>
            <th>Start</th>
            <th>End</th>
            <th>Name</th>
            <th>Venue</th>
            <th>Notes</th>
        </tr>
        </thead>
        <tbody>
        {% for event in eventList %}
            <tr>
                <td>
                    <time datetime="{{ event.getStartTime().getDatabase() }}">
                        {{ event.getStartTime().getLocal() }}
                    </time>
                </td>
                <td>
                    <time datetime="{{ event.getEndTime().getDatabase() }}">
                        {{ event.getEndTime().getLocal() }}
                    </time>
                </td>
                <td>
                    {{ event.getTitle() }}
                    {#
                    <a href="{{ routeLookup('resourceBooking.edit', {id: event.getId()}) }}">
                        {{ event.getTitle() }}
                    </a>
                    #}
                </td>
                <td>
                    {% include "@resourceItem/sub/itemName.twig" with {item: event.getBooking().getResource()} %}
                    {{ event.getLocation() }}
                    {#
                    <a href="{{ routeLookup('resourceItem.read', {id: event.getResource().getId()}) }}">
                        {% include "@resourceItem/sub/itemName.twig" with {item: event.getResource()} %}
                    </a>
                    #}
                </td>
                <td>{{ event.getTitle()|purify }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<script type="text/javascript" src="/javascript/components/jquery.tablesorter/js/jquery.tablesorter.js"></script>
<script type="text/javascript" src="/javascript/components/jquery.tablesorter/js/jquery.tablesorter.widgets.js"></script>
<script type="text/javascript" src="/javascript/jquery.selectAll.js"></script>
<script type="text/javascript">
    $.tablesorter.addParser({
        id: 'datetime',
        is: function() { return false },
        format: function(value, table, cell) {
            return $(cell).find('time').attr('datetime')
        },
        type: 'text'
    });
    $(function() {
        $('[data-sortable]').tablesorter({
            headers:{
                0:{sorter:'datetime'},
                1:{sorter:'datetime'}
            },
            widgets:['zebra'],
            widgetZebra:{
                css:["", "dark"]
            },
            cssHeader:"directory-sorter"
        });
        $('[data-datepicker]').datepicker();

        var form = $('form[data-action="search"]');
        form.selectAll({
            selector: form.find(':checkbox[data-selectall="category[]"]'),
            checkboxes: form.find(':checkbox[name="category[]"]')
        });
    });
</script>
