<style>
    .flatpickr-calendar.arrowTop:before, .flatpickr-calendar.arrowTop:after {
        bottom: 0;
    }
    .flatpickr-calendar.inline {
        max-height: 370px;
        border-radius: 0;
    }
    .flatpickr-innerContainer{
        border-bottom: 1px solid #e6e6e6;
    }
    .dateIsPicked .flatpickr-innerContainer+.flatpickr-time {
        border-top: none;
        border-bottom: 1px solid #e6e6e6;
    }
    .time-switch {
        width: 100px;
        margin: 13px 10px;
    }
    .has-time .time-switch {
        opacity: 0.3;
    }
    .all-day .time-switch {
        opacity: 1;
    }
    .flatpickr-month {
        height: 44px;
    }
    .flatpickr-prev-month, .flatpickr-next-month {
        top: 18px;
    }
    .flatpickr-current-month .numInputWrapper {
        width: 70px;
    }
    .submit-calendar {
        float: right;
        margin: 5px 10px 1px;
    }
    table.timetablePicker {
        padding: 0;
        margin: 0;
        border: 1px solid rgb(230, 230, 230);
    }
    table.timetablePicker td {
        padding: 0;
        margin: 0;
        vertical-align: middle;
        text-align: center;
    }
    table.timetablePicker tr {
    }
    table.timetablePicker th {
        width: 36px;
        height: 36px;
        border: none;
    }
    .has-period {
        width: 36px;
        height: 36px;
        cursor: pointer;
        border-radius: 150px;
        border-color: #fff;
        border-width: 10px;
        border: 10px solid #fff;
    }
    .has-period:hover, td.period-hover {
        background: rgb(230, 230, 230);
    }
    .has-period.period-selected, td.period-selected {
        background: #569ff7;
        color: #fff;
    }
    .reveal-modal a.picker-submit.close-reveal-modal, .reveal-modal a.timetable-submit.close-reveal-modal {
        border: none;
        color: #fff;
        background-color: #0066b0;
        font-size: 16px;
        top: inherit;
        line-height: inherit;
    }
    .reveal-link {
        cursor: pointer;
    }
    .expand-list {
        display: none;
    }
</style>
<div class="row">
    <dl class="tabs" data-tab>
        <dd class=""><a href="#" id="tab-1-{{ id }}"  tabindex="0"><span class="splash animate" style="height: 54px; width: 54px; top: 4.19999px; left: 4px;"></span>Date</a></dd>
        <dd class=""><a href="#" id="tab-2-{{ id }}"  tabindex="0"><span class="splash animate" style="height: 54px; width: 54px; top: -9.80001px; left: 1.29999px;"></span>Timetable</a></dd>
    </dl>
</div>
<div class="row">
    <div class="tabs-content">
        <div class='content active' id="byDate-{{ id }}">
                <div class="small-12 medium-4 columns">

                    {# Placeholder for calendar ot be rendered in #}
                    <div id="pickerCalendar{{ id }}"></div>

                </div>
                <div class="small-12 medium-8 columns">

                    {# Placeholder for appointments to be rendered in #}
                    <div id="pickerResponse{{ id }}"></div>

                </div>
        </div>
    </div>
    <div class='content' id="byTimetable-{{ id }}" style="display: none;">
            <div class="row">
                <div class="small-12 medium-4 columns">

                    {# Placeholder for timetable ot be rendered in #}
                    <div id="timetable{{ id }}">
                        <form>
                            <select name="campus">
                                {% for campus in timetable %}
                                    <option value="{{ campus.campusId }}" data-days="{{ campus.dayCount }}" >{{ campus.campusName }}</option>
                                {% endfor %}
                            </select>
                            <select name = "term">
                                {% for term in terms %}
                                    <option value="{{ term.id }}" data-duration="{{ term.duration }}" {% if term.id == timetableDay.term %} selected {% endif %}>{{ term.title }} </option>
                                {% endfor %}
                            </select>
                            <select name="cycle">
                                {# Options will be appended here #}
                            </select>
                        </form>
                        {# Build all, hide, reveal one later #}
                        {% for campus in timetable %}
                            <table class="timetablePicker timetablePicker{{ id }}" id="timetable{{ id }}-{{ campus.campusId }}" style="display:none;">
                                <th>
                                    {% for i in 1..timetable[campus.campusId].dayCount %}
                                        <td class="day-{{ i }}">{{ i }}</td>
                                    {% endfor %}
                                </th>
                                {% set k=0 %}
                            {% for description in timetable[campus.campusId].desc %}
                                <tr><td class="period-description description-{{ k }}" data-period-number="{{ k }}"  data-period-start="{{ timetable[campus.campusId].start[k] }}" data-period-end="{{ timetable[campus.campusId].end[k]  }}">{{ description }}</td>
                                    {% for i in 1..timetable[campus.campusId].dayCount %}
                                        <td><div class="has-period period-{{ i }}-{{ k }}" data-day="{{ i }}" data-period="{{ k }}" data-selected="0"></div></td>

                                    {% endfor %}
                                    {% set k=k+1 %}
                                </tr>
                            {% endfor %}
                            </table>
                        {% endfor %}
                    </div>
                </div>
                <div class="small-12 medium-8 columns">

                    {# Placeholder for appointments to be rendered in #}

                    <div id="timetableAppointments{{ id }}"></div>



                </div>
            </div>
            <div class="row">
                <div class="small-4 columns"></div>
                <div class="small-4 columns"></div>
                <div class="small-4 columns">
                    <a href="#" class="button submit timetable-submit close-reveal-modal" >Update</a>
                </div>
            </div>
    </div>
</div>
<script>

    var allDaySwitch = ($('#allday').val());
    {# Tabs #}

    $('#tab-1-{{ id }}').click(function(){
        $('#byDate-{{ id }}').css('display', 'block');
        $('#byTimetable-{{ id }}').css('display', 'none');

    });

    $('#tab-2-{{ id }}').click(function(){
        $('#byDate-{{ id }}').css('display', 'none');
        $('#byTimetable-{{ id }}').css('display', 'block');

    });

    {# Prepare and append response HTML #}

    function appendResponse(data, template) {

        var pickerResponse = $('#pickerResponse{{ id }}');

        {# Clear out any old response display #}
        pickerResponse.html('');
        var html = '';

        {# Ajax returned date #}
        timetableDate = moment(data.date, convertFormat('{{ displayFormat }}')).format(convertFormat('F d, Y'));

        if (template == 'duework') {

            if (data.students.length == 0) {
                html += 'Nothing due on ' + timetableDate + '';
            }
            else {

                {# Populate with results for the selected date #}

                html += '<div class="row">';
                html += '<div class="small-12 medium-6 columns">';
                html += '<h3>Work due on ' + timetableDate + '</h3>';
                html += '<ul class="information-list expandable-card">';
                for (var i = 0; i < data.students.length; i++) {
                    html += '<li>';
                    html += '<div class="expander icon-down-arrow" data-collapser="collap-' + i + '"></div>';
                    html += '<div class="card small-12">';
                    html += '<a href="/search/user/' + data.students[i].id + '">';
                    html += '<img src="/portrait.php?userId=' + data.students[i].id + '&amp;size=square64">';
                    html += '<h3>' + data.students[i].firstname + ' ' + data.students[i].lastname + '</h3>';
                    html += '<p class="meta">' + data.students[i].assessmentsDue + ' due' + '</p>';
                    html += '</a>';
                    html += '</div>';
                    html += '<div class="small-12 column" data-collapse-state="collapsed" data-collapsable="collap-' + i + '" style="display: none;">';
                    //                                    html += '<ul>';
                    for (var k = 0; k < data.students[i].assessmentList.length; k++) {
                        html += '<p><span>';
                        if (data.students[i].assessmentList[k]['duetime'] !== '11:59pm') {
                            html += data.students[i].assessmentList[k]['duetime'];
                        }
                        html += '</span>' + data.students[i].assessmentList[k]['title'] + '</p>';
                    }
                    //                                    html += '</ul>';
                    html += '</div>';
                    html += '</li>';
                }
                html += '</ul>';
                html += '</div>';
                html += '</div>';

            }
        }
        else if (temlate == 'events') {
            if (data.appointments.length == 0) {
                html += 'No events found for ' + timetableDate;
            }
            else {
                {# Populate with appointments for the selected date #}
                for (var i = 0; i < data.appointments.length; i++) {
                    html += '<h3>' + data.appointments[i].title + '</h3>';
                    html += '<p class="meta")>' + data.appointments[i].startDateTime;
                    if (data.appointments[i].startDateTime !== data.appointments[i].endDateTime) {
                        html += ' - ' + data.appointments[i].endDateTime;
                    }
                    html += '</p>';
                }
            }
        }
        else {
            {# nope #}
            html = '';
        }

        pickerResponse.append(html);
        if(template == 'duework' && data.students.length > 0) {
            $('[data-collapser]').collapsable();
        }
    }


    {# Timtable picker #}

    {# Build cycles dynamically #}
//    function buildCycles(onFirstLoad) {
    function buildCycles() {

        var daysInCycle = $('select[name*="campus"]').find(':selected').attr('data-days');
        var termDuration = $('select[name*="term"]').find(':selected').attr('data-duration');
        var optionsHtml = '';
        //Select cycle number on first load
//        if(onFirstLoad === true) {
            cycleSelected = parseInt({{ timetableDay.daysUntilDate }}/daysInCycle);
//        }
        for (i = 1; i <= (termDuration / daysInCycle); i++) {
            var selected = '';

//            if(onFirstLoad && cycleSelected == i ){
            if(cycleSelected == i ){
                selected = 'selected';
            }
            optionsHtml += '<option value="' + i + '" ' + selected + '>Week ' + i + '</option>';
        }
        $('select[name*="cycle"]').empty().append(optionsHtml);
    }

    {# Highlight day and period #}
    function showPeriod() {
        var daysInCycle = $('select[name*="campus"]').find(':selected').attr('data-days');
        var isWeekend = {{ timetableDay.isWeekend }};
        {# Highlight day if it doen't fall on a weekend #}
        if(isWeekend == 0) {
            var period = 0;
            {# Get day of the cycle #}
            var cycleDay = {{ timetableDay.daysUntilDate }}%daysInCycle;
            if(cycleDay == 0) {
                cycleDay = daysInCycle;
            }
            $('.day-' + cycleDay).addClass('period-selected');

            $('.period-description').each(function() {

                var s = moment($(this).attr('data-period-start'), 'HH:mmA').format('HHmm');
                var e = moment($(this).attr('data-period-end'), 'HH:mmA').format('HHmm');
                var t = moment('{{ value }}').format('HHmm');
                if((t >= s) && (t < e)) {
                    $(this).addClass('period-selected');
                    period = $(this).attr('data-period-number');
                }

                if((cycleDay > 0) && (period > 0)) {
                    $('.period-'+cycleDay+'-'+period).addClass('period-selected');
                }
            })
        }
    }

    {# Reveal Timetable#}
    function revealTimetable() {
        var campus = $('select[name*="campus"]').find(':selected').val();
        $('.timetablePicker{{ id }}').css('display', 'none');
        $('#timetable{{ id }}'+'-'+campus).css('display', 'table');
    }

    {# Put cycles on load #}
    buildCycles(true);
    showPeriod();
    revealTimetable();

    {# Update cycles on Campus or Term change #}
    $('select[name*="campus"]').change(function(){
        buildCycles();
        {# Clear selected #}
        $('.period-selected').removeClass('period-selected');
        $('table').find('[data-selected=1]').attr('data-selected', 0);
        revealTimetable();
    });

    $('select[name*="term"]').change(function(){
        buildCycles();
    });

    var timetableAppointments = $('#timetableAppointments{{ id }}');

    {# Timetable picker behaviour #}
    $('table.timetablePicker').mouseout(function(){
        $('.period-hover').removeClass('period-hover');
    });

    $('.has-period').hover(function(){

        $('.period-hover').removeClass('period-hover');
        var day = $(this).attr('data-day');
        var period = $(this).attr('data-period');
        $('.day-'+day).addClass('period-hover');
        $('.description-'+period).addClass('period-hover');

    });

    {# Loading events on timetable picker click #}
    var timetableDate = moment().format(convertFormat('{{ displayFormat }}')); //today
    $('.has-period').click(function(){

        var day = $(this).attr('data-day');
        var period = $(this).attr('data-period');

        $('.period-selected').removeClass('period-selected');
        $('table').find('[data-selected=1]').attr('data-selected', 0);
        $(this).addClass('period-selected');
        $(this).attr('data-selected', 1);
        $('.day-'+day).addClass('period-selected');
        $('.description-'+period).addClass('period-selected');
        periodClicked = 'period'+day+'_'+period;

        var campus = $('select[name*="campus"]').val();
        var term = $('select[name*="term"]').val();
        var cycle = $('select[name*="cycle"]').val();

        {% if type == 'duework'  %}
        $.get(('{{ routeLookup('pickerDatetime.getByClassCode') }}').replace(/{campusId}/g, campus).replace(/{termId}/g, term).replace(/{cycle}/g, cycle).replace(/{day}/g, day))
                .done(function (data) {

                    appendResponse(data, 'duework');

                })
                .fail(function () {
                    console.log('Failed to retrieve appointments for specified period');
                });

        {% elseif type == 'events' %}
        {# Or fetch events #}
        $.get(('{{ routeLookup('pickerDatetime.getByTimetableDay') }}').replace(/{campusId}/g, campus).replace(/{termId}/g, term).replace(/{cycle}/g, cycle).replace(/{day}/g, day))
                .done(function (data) {

                    appendResponse(data, 'events');

                })
                .fail(function () {
                    console.log('Failed to retrieve appointments for specified period');
                });
        {% else %}
            {# Don't fetch anything#}
        {% endif %}
    });

    {# Submit timetable datetime #}

    $('.timetable-submit').click(function() {
        var periodSelected = $('table').find('[data-selected=1]').attr('data-period');
        var newTime = moment($('[data-period-number='+periodSelected+']').attr('data-period-start'), 'HH:mmA');
        var newDate = (timetableDate.hours(newTime.hours()).minutes(newTime.minutes()).seconds(0)).format(convertFormat('Y-m-d H:i:s'));
        {# Turn AllDay off #}
        $('#allday').val(0);
        window.pickerInstance[{{ id }}].setDate(newDate);
    });

    {# Setup calendar #}
    var newDate, latestDate;

    window.pickerInstance[{{ id }}] = flatpickr("#pickerCalendar{{ id }}", {
        defaultDate: new Date({{ value }}),
        dateFormat: '{{ displayFormat }}',
        inline: true,
        altInput: false,
        enableTime: {{ enableTime }},
        allowInput: true,
        disableMobile: true,
        minuteIncrement: 1,
        onReady: function(selectedDates, dateStr, instance) {
            //Wrong format, swaps day with month
            var timeDiv = $('#pickerCalendar{{ id }}').closest('#picker{{ id }}').find('.flatpickr-time');
            var calendarDiv = $('#picker{{ id }}').find('.flatpickr-calendar');
            var presetObj = new Date('{{ value }}');

            timeDiv.after(
                '<div class="row"><div class="small-6 columns">' +
                '<div class="time-switch"><input id="hideTime{{ id }}" type="checkbox" value="1" checked>' +
                '<label for="hideTime{{ id }}" class="checkbox-label">All Day</label></div>' +
                '</div><div class="small-6 columns">' +
                '<div class="submit-calendar"><a href="#" class="button submit picker-submit close-reveal-modal" >Update</a><div>' +
                '</div></div>'
            );
            
            {# Hide time picker if allday hidden field is set to 1 #}
            if($('#allday').val() == 1) {
                timeDiv.css('display', 'none');
                calendarDiv.addClass('all-day');
                calendarDiv.removeClass('has-time');
            }
            else {
                $('#hideTime{{ id }}').prop('checked', false);
            }
            $('#hideTime{{ id }}').click(function () {
                if ($('#hideTime{{ id }}').is(':checked')) {
                    timeDiv.css('display', 'none');
                    calendarDiv.addClass('all-day');
                    calendarDiv.removeClass('hasTime');
                    $('#allday').val(1);
                    // Get rid of time
                    var allDay = moment(instance.input.value, convertFormat('{{ displayFormat }}')).format(convertFormat('Y-m-d'));
                    instance.setDate(allDay);
                    $('*[data-pickerid="{{ id }}"]').val(allDay);
                }
                else {
                    $('#allday').val(0);
                    timeDiv.css('display', 'block');
                    calendarDiv.addClass('has-time');
                    calendarDiv.removeClass('all-day');
                }
            });
        },
        onChange: function(selectedDates, dateString, instance) {
            {# Put the display date onto the calendar div so we can capture it when the modal is closed #}

            var dateSplit = dateString.split(' ');
            $('#pickerCalendar{{ id }}').attr('data-date', dateSplit[0]);
            $('#pickerCalendar{{ id }}').attr('data-time', dateSplit[1]);


            {# Check if selected date has changed and don't send an ajax on time change #}
            var selectedObj = new Date(selectedDates);
            newDate = selectedObj.getDate()+'/'+(selectedObj.getMonth()+1)+'/'+selectedObj.getFullYear();
            if(newDate !== latestDate) {

                {% if type == 'duework'  %}

                var pickerResponse = $('#pickerResponse{{ id }}');

                // Can the assessment form have dates and be called outside the class page?
                var classCode = $('*[name = "classCode"]').val();

                pickerResponse.html('Loading results');
                $.get(('{{ routeLookup('pickerDatetime.getByClassCode') }}').replace(/{classCode}/g, classCode).replace(/{date}/g,  encodeURIComponent(dateSplit[0])))

                        .done(function (data) {

                            appendResponse(data, 'duework')

                        })
                        .fail(function () {
                            console.log('Failed to retrieve appointments for specified date');
                        });

                {% elseif (type == 'event') %}

                {# AJAX in appointments for the selected date #}

                var pickerResponse = $('#pickerResponse{{ id }}');

                pickerResponse.html('Loading events');

                $.get('{{ routeLookup('pickerDatetime.getByDate', {date: '_date_'}) }}'.replace(/_date_/g, encodeURIComponent(dateSplit[0])))
                        .done(function (data) {

                            appendResponse(data, 'events')

                        })
                        .fail(function () {
                            console.log('Failed to retrieve appointments for specified date');
                        });
                {% else %}
                    {#Do nothing#}
                {% endif %}
            }
            latestDate = newDate;
        }
    });
</script>
