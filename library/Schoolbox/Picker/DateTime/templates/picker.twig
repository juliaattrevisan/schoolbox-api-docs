{# Placeholder for calendar ot be rendered in #}

<div id="pickerCalendar{{ id }}"></div>

{# Placeholder for appointments to be rendered in #}

<div id="pickerApointments{{ id }}"></div>

{# Setup calendar #}

<script>

    var newDate, latestDate;

    window.pickerInstance[{{ id }}] = flatpickr("#pickerCalendar{{ id }}", {
        defaultDate: '{{ value }}',
        dateFormat: '{{ displayFormat }}',
        inline: true,
        altInput: true,
        altFormat: '{{ databaseFormat }}',
        enableTime: true,
        onReady: function(selectedDates, dateStr, instance) {
            var presetObj = new Date('{{ value }}');
            $('#picker{{ id }} > .flatpickr-calendar').children('.flatpickr-time').after('<div class="timeSwitch"><input id="hideTime{{ id }}" name="hideTime" type="checkbox" value="1" checked><label for="hideTime{{ id }}" class="checkbox-label">All Day</label></div>');

            {# Hide time picker if enableTime option set equals false or no event time set #}
            if($('#picker{{ id }} > .hasTime') && (presetObj.getHours()+presetObj.getMinutes()) === 0) {
                $('#picker{{ id }} > .flatpickr-calendar').children('.flatpickr-time').css('display', 'none');
                $('#picker{{ id }} > .flatpickr-calendar').addClass('allDay');
                $('#picker{{ id }} > .flatpickr-calendar').removeClass('hasTime');
            }
            else {
                $('#hideTime{{ id }}').prop('checked', false);
            }
            $('#hideTime{{ id }}').click(function () {
                if ($('#hideTime{{ id }}').is(':checked')) {
                    $('#picker{{ id }} > .flatpickr-calendar').children('.flatpickr-time').css('display', 'none');
                    var dateObj = new Date(instance.altInput.value);
                    dateObj.setMinutes(0);
                    dateObj.setHours(0);
                    instance.setDate(dateObj);
                    alert(instance.altInput.value);
                }
                else {
                    $('#picker{{ id }} > .flatpickr-calendar').children('.flatpickr-time').css('display', 'block');
                    $('#picker{{ id }} > .flatpickr-calendar').addClass('hasTime');
                    $('#picker{{ id }} > .flatpickr-calendar').removeClass('allDay');
                }
            });

        },
        onChange: function(selectedDates, dateString, instance) {

            {# Put the display date onto the calendar div so we can capture it when the modal is closed #}

            $('#pickerCalendar{{ id }}').data('dateDisplay', dateString);


            {# Check if selected date has changed and don't send an ajax on time change #}
            var selectedObj = new Date(selectedDates);
            newDate = selectedObj.getFullYear()+' '+selectedObj.getMonth()+' '+selectedObj.getDate();

            if(newDate !== latestDate) {

                {# AJAX in appointments for the selected date #}

                var pickerApointments = $('#pickerApointments{{ id }}');

                pickerApointments.html('Loading events');

                $.get('{{ routeLookup('pickerDatetime.getByDate', {date: '_date_'}) }}'.replace(/_date_/g, encodeURIComponent(instance.altInput.value)))
                        .done(function (data) {

                            if (data.appointments.length == 0) {

                                {# There we no appointment on the selected date #}

                                pickerApointments.html('No events found');

                            } else {

                                {# Clear out any old appointments #}

                                pickerApointments.html('');

                                {# Populate with appointments for the selected date #}

                                for (var i = 0; i < data.appointments.length; i++) {
                                    pickerApointments.append(
                                            data.appointments[i].title + '<br>' +
                                            data.appointments[i].startDateTime + '<br>'
                                    )
                                }
                            }
                        })
                        .fail(function () {
                            console.log('Failed to retrieve appointments for specified date');
                        });

            }
            latestDate = newDate;
        }
    });
</script>
