<h2 class="subheader">{{ heading }}</h2>
<div class="row">
    <div class="small-12 island">

        {# Tabs #}

        <dl class="tabs" data-tab>

            {# Display topic tabs #}

            {% set active = false %}
            {% for topic in topics %}

                {# Only display topic if there is actually news in it #}

                {% if news[topic.id] is defined %}
                    <dd {% if not active and not allDefault %}class="active"{% set active = true %}{% endif %}>
                        <a href="#component{{ componentInstanceId }}-{{ topic.id }}">{{ topic.name }}</a>
                    </dd>
                {% endif %}
            {% endfor %}

            {# Display special 'All' grouping #}

            <dd {% if allDefault %}class="active"{% endif %}>
                <a href="#component{{ componentInstanceId }}-all">All</a>
            </dd>
        </dl>

        {# Articles #}

        <section>
            <div class="tabs-content">

                {# Articles grouped by topic #}

                {% set active = false %}

                {% for topic in topics %}
                    {% if news[topic.id] is defined %}
                        <ul class="news-list content {% if not active and not allDefault %}active{% set active = true %}{% endif %}" id="component{{ componentInstanceId }}-{{ topic.id }}">
                            {% for item in news[topic.id] %}
                                <li>
                                    <div class="list-item">
                                        <div class="card small-12">
                                            {% if item.showLink %}
                                                <a href="/news/item/{{ item.id }}" title="{{ item.heading }}">
                                            {% endif %}

                                                {% if item.image %}
                                                    <img src="/storage/image.php?hash={{ item.image }}&size=square64">
                                                {% endif %}
                                                <h3>{{ item.heading }}</h3>

                                            {% if item.showLink %}
                                                </a>
                                            {% endif %}

                                            <p class="meta">
                                                Posted by
                                                {% if item.authorDeleted %}
                                                    {{ item.author }}
                                                {% else %}
                                                    <a href="/search/user/{{ item.uid }}">{{ item.author }}</a>
                                                {% endif %}
                                                {{ item.date.getRelativeTime }}
                                            </p>
                                        </div>
                                    </div>
                                    {% if not compact %}
                                        <article>{{ item.blurb | purify }}</article>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endfor %}

                {# Special 'All' grouping with every article #}

                <ul class="news-list content {% if allDefault %}active{% endif %}" id="component{{ componentInstanceId }}-all">
                    {% for item in newsAll %}
                        <li>
                            <div class="list-item">
                                <div class="card small-12">
                                    {% if item.showLink %}
                                        <a href="/news/item/{{ item.id }}" title="{{ item.heading }}">
                                    {% endif %}

                                        {% if item.image %}
                                            <img src="/storage/image.php?hash={{ item.image }}&size=square64">
                                        {% endif %}
                                        <h3>{{ item.heading }}</h3>

                                    {% if item.showLink %}
                                        </a>
                                    {% endif %}

                                    <p class="meta">
                                        Posted by
                                        {% if item.authorDeleted %}
                                            {{ item.author }}
                                        {% else %}
                                            <a href="/search/user/{{ item.uid }}">{{ item.author }}</a>
                                        {% endif %}
                                        {{ item.date.getRelativeTime }}
                                    </p>
                                </div>
                            </div>
                            {% if not compact %}
                            <article>{{ item.blurb | purify }}</article>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>

            </div>
        </section>
    </div>
</div>
