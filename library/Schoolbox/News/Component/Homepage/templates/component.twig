{% if news is empty %}

    <div class="empty-state">
        <i class="icon-news"></i>

        {% if modify %}

            {% if showArchive %}
                <p><a href="/news/homepage/new/{{ code }}">Post a news article</a> to share new information on this homepage, <a href="/homepage/newsArchive/{{ code }}">view the news archive</a>.</p>
            {% else %}
                <p><a href="/news/homepage/new/{{ code }}">Post a news article</a> to share new information on this homepage.</p>
            {% endif %}

        {% else %}

            <p>There is no news to view at this time.</p>
            {% if showArchive %}
                <p><a href="/homepage/newsArchive/{{ code }}">View the news archive</a>.</p>
            {% endif %}

        {% endif %}
    </div>

{% else %}
    <section>
        <ul class="information-list">

            {% if compact %}

                {# Compact view #}
                {% for item in news %}
                    <li {% if ( moderate or ( modify and config.news_edit_other ) ) %}class="actions-small-1"{% endif %}>
                        <div class="list-item">
                            <div class="card small-12">
                                <h3><a href="/homepage/news/{{ item.code }}/{{ item.id }}">{{ item.heading }}</a></h3>
                                <p class="meta">Posted by <a href="/search/user/{{ item.synid }}">{{ item.firstname }} {{ item.lastname }}</a> <span title="Published on {{ item.published.getLongDateOnly }}">{{ item.posted.getRelativeTime }}</span></p>
                            </div>
                        </div>
                        {% if ( moderate or ( modify and config.news_edit_other ) ) %}
                            <nav>
                                <a class="icon-modify" href="/news/homepage/{{ item.id }}" title="Modify News"></a>
                            </nav>
                        {% endif %}
                    </li>
               {% endfor %}

            {% else %}

                {# Non compact view #}
                {% for item in news %}
                    <li {% if modify %}class="actions-small-1"{% endif %}>
                        <div class="list-item">
                            <div class="card small-12">
                                <a href="/search/user/{{ item.owner }}">
                                    <img src="/portrait.php?userId={{ item.synid }}&size=square64" alt="View Profile" />
                                </a>
                                <h3>{{ item.heading }}</h3>
                                <p class="meta">Posted by <a href="/search/user/{{ item.synid }}">{{ item.firstname }} {{ item.lastname }}</a> <span title="Published on {{ item.published.getLongDateOnly }}">{{ item.posted.getRelativeTime }}</span></p>
                            </div>
                        </div>
                        {% if modify %}
                            <nav>
                                <a class="icon-modify" href="/news/homepage/{{ item.id }}" title="Modify News"></a>
                            </nav>
                        {% endif %}
                        <article>{{ item.body | raw }}</article>
                    </li>
                {% endfor %}

            {% endif %}

        </ul>

        {# Component Actions #}
        {% if showArchive or modify %}
            <div class="component-action">
                <section>
                    {% if showArchive %}
                        <a href="/homepage/newsArchive/{{ code }}" class="button">View Archive</a>
                    {% endif %}
                    {% if modify %}
                        <a href="/news/homepage/new/{{ code }}" class="button">Post News</a>
                    {% endif %}
                </section>
            </div>
        {% endif %}

    </section>
{% endif %}