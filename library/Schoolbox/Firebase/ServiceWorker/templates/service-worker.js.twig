/**
 * Give the service worker access to Firebase Messaging.
 * Note that you can only use Firebase Messaging here. Other Firebase libraries
 * are not available in the service worker.
 */
importScripts("https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js");
importScripts("https://www.gstatic.com/firebasejs/10.9.0/firebase-messaging-compat.js");

const firebaseApps = [];
{% for app in firebase.apps %}
{# Firebase public configuration will generally be provided as JS, so must be output raw #}
firebaseApps.push({
    appIdentifier: '{{ app.appIdentifier ?? '' }}',
    publicConfiguration: {{ (app.publicConfiguration ?? 'null') | raw }},
    webPushPublicKey: '{{ app.webPushPublicKey ?? '' }}',
});
{% endfor %}

firebaseApps.forEach((app) => {
    firebase.initializeApp(app.publicConfiguration);
    const messaging = firebase.messaging();
    messaging.onBackgroundMessage(function (payload) {
        console.warn("[firebase-messaging-sw.js] Received background message ", payload);
        // Customize notification here
        const data = JSON.parse(payload.data);
        const notificationOptions = {
            body: payload.notification.body,
            icon: "/images/logo.php?logo=skin_logo_square&size=apple72",
            image: data.icon,
            badge: "/images/logo.php?logo=skin_logo_square&size=apple72",
            renotify: false,
            data: data
        };
        if (data.timestamp !== '0') {
            notificationOptions.timestamp = data.timestamp;
        }
        self.registration.showNotification(payload.notification.title, notificationOptions);
    });


    // example from: https://developer.mozilla.org/en-US/docs/Web/API/Clients/openWindow
    // Notification click event listener
    self.addEventListener("notificationclick", (e) => {
        // Close the notification popout
        e.notification.close();
        // Get all the Window clients
        e.waitUntil(
                clients.matchAll({ type: "window" }).then((clientsArr) => {
                    // If a Window tab matching the targeted URL already exists, focus that;
                    const hadWindowToFocus = clientsArr.some((windowClient) =>
                            windowClient.url === e.notification.data.href
                                    ? (windowClient.focus(), true)
                                    : false,
                    );
                    // Otherwise, open a new tab to the applicable URL and focus it.
                    if (!hadWindowToFocus)
                        clients
                                .openWindow(e.notification.data.href)
                                .then((windowClient) => (windowClient ? windowClient.focus() : null));
                }),
        );
    });
});
