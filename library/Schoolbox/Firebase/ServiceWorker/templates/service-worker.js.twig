
import { initializeApp, getMessaging, onBackgroundMessage } from '/static/js/bundle/firebaseMessaging.js';

{#const b = self.importScripts('/static/js/bundle/firebaseMessaging.js');#}
{#console.log(b);#}

const firebaseApps = [];
{% for app in firebase.apps %}
{# Firebase public configuration will generally be provided as JS, so must be output raw #}
firebaseApps.push({
    appIdentifier: '{{ app.appIdentifier ?? '' }}',
    publicConfiguration: {{ (app.publicConfiguration ?? 'null') | raw }},
    webPushPublicKey: '{{ app.webPushPublicKey ?? '' }}',
});
{% endfor %}

window.sbProps.firebaseApps.forEach((app) => {
    const firebaseApp = initializeApp(app.publicConfiguration);
    const messaging   = getMessaging(firebaseApp);
    console.log(messaging);
    onBackgroundMessage(messaging, (payload) => {
        console.log(payload);
    })
});
