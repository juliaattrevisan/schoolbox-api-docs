{% extends '@intellischool/base.twig' %}

{% block header %}
    <h1>Intellischool Class Dashboard - {{ folder.name }} ({{ classCode }})</h1>

    {# Selector for each class code (if there are multiples) #}
    {% if folder.codes | length > 1 %}
        <dl class="tabs">
            {% for code in folder.codes %}
                <dd class="{% if code.code == classCode %}active{% endif %}">
                    <a href="{{ routeLookup('intellischool.getClassDashboard', {folderId: folder.id, classCode: code.code}) }}">{{ code.code }}</a>
                </dd>
            {% endfor %}
        </dl>
    {% endif %}
{% endblock header %}
