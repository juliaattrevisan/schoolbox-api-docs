{% extends '@intellischool/base.twig' %}

{% import 'sub/breadcrumbs.twig' as bread %}

{% block breadcrumbs %}
    {{ bread.crumbs(
        [ folder.title, '/homepage/' ~ folder.id ],
        ['Class Analytics']
    ) }}
{% endblock breadcrumbs %}

{% block header %}
    <h1>Class Analytics - {{ folder.title }}</h1>

    {# Selector for each class code (if there are multiples) #}
    {% if folder.codes | length > 1 %}
        <dl class="tabs">
            {% for code in folder.codes %}
                <dd class="{% if code.code == classCode %}active{% endif %}">
                    <a href="{{ routeLookup('intellischool.getClassCodeAnalytics', {folderId: folder.id, classCode: code.code}) }}">{{ code.code }}</a>
                </dd>
            {% endfor %}
        </dl>
    {% endif %}
{% endblock header %}
