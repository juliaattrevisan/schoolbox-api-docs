{% if hasError %}
    <div class="empty-state">
        <i class="icon-intellischool"></i>
        <p>
            Unfortunately Intellischool Integration is currently not configured;
        </p>
        <p>
            Please contact your system administrator for support, or just delete this component.
        </p>
    </div>
{% else %}
    <form id="iframeForm" method="post" action="{{ ltiEndpoint }}" target="intellischoolIframe">
        <input type="hidden" name="id_token" value="{{ jwt }}">
    </form>
    <iframe style="min-height:200px;overflow: hidden;" name="intellischoolIframe" id="intellischoolIframe">
    </iframe>
    <script type="text/javascript">
        /**
         * Decide if url is an allowed domain
         * Whitelist allowed domains
         *
         * @param url
         */
        function isAllowed(url) {
            /* Test new domains
             */
            if (url.match(/^https:\/\/(.*)intellischool\.app$/) != null) {
                return true;
            }

            /* If that's not allowed, test the old domains
             * (These old domains will eventually be phased out at some point)
             */
            if ([
                "https://analytics.intellischool.cloud",
                "https://analytics.intellischool.xyz",
                "https://analytics.intellischool.dev"
            ].includes(url)) {
                return true;
            }

            /* Everything else get out
             */
            return false;
        }

        window.addEventListener("message", event => {
            if (!isAllowed(event.origin.toString())) {
                return;
            }

            // Act on the event
            if (event.data && event.data.intellischool && typeof(event.data.intellischool) === "object")  {
                switch (event.data.intellischool.action)
                {
                    case "resize":
                        if (event.data.intellischool.height) {
                            document.getElementById('intellischoolIframe').height = Math.ceil(event.data.intellischool.height);
                        }
                        return;

                    default:
                        // Unknown event, do nothing
                        return;
                }
            }
        }, false);
        document.addEventListener("DOMContentLoaded", function() {
            document.getElementById('iframeForm').submit();
        });
        if ('complete' === window.document.readyState) {
            document.getElementById('iframeForm').submit();
        }
    </script>
{% endif %}
