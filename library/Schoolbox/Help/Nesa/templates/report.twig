{% macro demonstrated(value, tooltip) %}
    <span class="demonstrated" title="{{ tooltip }}">{{ value }}</span>
{% endmacro %}

{% macro notDemonstrated(value, tooltip) %}
    <span class="not-demonstrated" title="{{ tooltip }}">{{ value }}</span>
{% endmacro %}

{% macro undecided(value, tooltip) %}
    <span class="undecided" title="{{ tooltip }}">{{ value }}</span>
{% endmacro %}

{% import _self as macro %}
<style type="text/css">
    th:first-child {
        width: 20%;
    }

    th.center,
    td.center {
        text-align: center;
    }

    .demonstrated {
        background-color: #aea;
        display: block;
        padding: 3px;
        font-weight: bold;
    }

    .not-demonstrated {
        background-color: #fdd;
        display: block;
        padding: 3px;
        font-weight: bold;
    }

    .undecided {
        background-color: #eee;
        display: block;
        padding: 3px;
        font-weight: bold;
    }
</style>
<div class="row">
    <div class="small-12 columns">
        <h1>NESA Report</h1>

        <h2 class="subheader">{{ folder.name }}</h2>
        <section>
            <table>
                <thead>
                    <th>User</th>
                    {% for indicator in indicators %}
                        <th class="center">{{ indicator }}</th>
                    {% endfor %}
                </thead>
                <tbody>
                    {% for row in report %}
                    <tr>
                        <td><a href="/search/user/{{ row.user.id }}">{{ row.user.fullname }}</a></td>

                        {# Render data in the same order as headings #}

                        {% for indicator in indicators %}

                        <td class="center">

                            {% if row.condensed[indicator].outcome == 'Y' %}
                                {{ macro.demonstrated('Y', row.condensed[indicator].text) }}
                            {% elseif row.condensed[indicator].outcome == 'N' %}
                                {{ macro.notDemonstrated('N', row.condensed[indicator]) }}
                            {% else %}
                                {{ macro.undecided('-', row.condensed[indicator]) }}
                            {% endif %}
                        </td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </div>
</div>




