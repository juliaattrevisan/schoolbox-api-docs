{% macro demonstrated(value, tooltip) %}
    <span style="background-color:#aea;display:block;padding:3px;font-weight:bold;" title="{{ tooltip }}">Y</span>
{% endmacro %}

{% macro notDemonstrated(value, tooltip) %}
    <span style="background-color:#fdd;display:block;padding:3px;font-weight:bold;" title="{{ tooltip }}">N</span>
{% endmacro %}

{% import _self as macro %}

<div class="row">
    <div class="small-12 columns">
        <h1>NESA Report</h1>
        <section>
            <table>
                <thead>
                    <th style="width:20%">User</th>
                    {% for indicator in indicators %}
                        <th style="text-align:center">{{ indicator }}</th>
                    {% endfor %}
                </thead>
                <tbody>
                    {% for row in report %}
                    <tr>
                        <td><a href="/search/user/{{ row.user.id }}">{{ row.user.fullname }}</a></td>

                        {# Render data in the same order as headings #}

                        {% for indicator in indicators %}

                        <td style="text-align:center">
                            {% if row.condensed[indicator]|length %}
                                {{ macro.demonstrated('Y', row.condensed[indicator]) }}
                            {% else %}
                                {{ macro.notDemonstrated('N', row.condensed[indicator]) }}
                            {% endif %}
                        </td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </div>
</div>




