{# Where to put these styles?
 # Normally I'd put them into Skin Config but I don't really want to lose them
 #}
<style type="text/css">
    th:first-child {
        width: 20%;
    }

    th.center,
    td.center {
        text-align: center;
    }

    .demonstrated {
        background-color: #aea;
        display: block;
        padding: 3px;
        font-weight: bold;
    }

    .not-demonstrated {
        background-color: #fdd;
        display: block;
        padding: 3px;
        font-weight: bold;
    }

    .undecided {
        background-color: #eee;
        display: block;
        padding: 3px;
        font-weight: bold;
    }
</style>

<script type="text/javascript">
    $(function() {
        $('[data-accredit]').on('click', function(event) {
            event.preventDefault();

            var self = $(this);
            var username = self.attr('data-accredit-name');

            var toast = $('#accreditation-toast');
            toast.toastActivate({text: 'Accreditting ' + username + '...'});

            $.post($(this).attr('href'), {userId: $(this).attr('data-accredit')})
                .success(function(response) {
                    if (response.status == 1) {
                        self.removeClass().addClass('icon-approve');
                    }

                    toast.toastTimeout({text: username + ' accredited.', css: 'success'});
                })
                .error(function() {
                    toast.toastTimeout({text: 'Could not accredit ' + username, css: 'alert'});
                });
        });
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>NESA Report</h1>
        <ul class="meta">
            <li class="icon-timetable">Took approx. {{ duration }} seconds</li>
            <li class="icon-staff-students">{{ report|length }} users found</li>
            <li class="icon-weather">States:
                {% for state in states %}
                    {{ state }}{% if not loop.last %},{% endif %}
                {% endfor %}
            </li>
        </ul>

        {% if report|length %}
        <section>
            <table>
                <thead>
                    <th>User</th>
                    <th>PD Number</th>
                    {% for indicator in indicators %}
                        <th class="center">{{ indicator }}</th>
                    {% endfor %}
                    <th>Action</th>
                </thead>
                <tbody>
                    {% for row in report %}
                    <tr>
                        <td><a href="/search/user/{{ row.user.id }}">{{ row.user.fullname }}</a></td>
                        <td>{{ row.user.number }}</td>

                        {# Render data in the same order as headings #}

                        {% for indicator in indicators %}

                        <td class="center">
                            {% if row.condensed[indicator].outcome is defined %}
                                {% if row.condensed[indicator].outcome %}
                                    <span class="demonstrated" title="{{ row.condensed[indicator].text }}">Y</span>
                                {% else %}
                                    <span class="not-demonstrated" title="{{ row.condensed[indicator].text }}">N</span>
                                {% endif %}
                            {% else %}
                                <span class="undecided" title="">-</span>
                            {% endif %}
                        </td>
                        {% endfor %}
                        <td class="actions-small-1">
                            <nav>
                                {% set accreditRoute = routeLookupIfAuthorized('professionaldevelopment.postAccredit', {
                                    userId: row.user.id
                                }) %}

                                {% if accreditRoute and row.condensed|length %}
                                    <a href="{{ accreditRoute }}" class="icon-favourite" title="Accredit {{ row.user.fullname }}" data-accredit-name="{{ row.user.fullname }}" data-accredit="{{ row.user.id }}"></a>
                                {% endif %}
                            </nav>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-progress"></i>
            <p>There are no users who match the criteria you've chosen.</p>
            <p>You should <a href="{{ routeLookup('help.getNesa') }}">refine your selection criteria</a>.</p>
        </div>
        {% endif %}
    </div>
</div>

{% if report|length %}
<div id="accreditation-toast" class="toast"></div>

{# For CSV generation #}

<div class="row">
    <div class="small-12 columns">
        <form action="{{ routeLookup('help.postNesaCsv') }}" method="post">
            <input type="hidden" name="unaccreditedOnly" value="{{ unaccreditedOnly }}" />

            {% for indicator in indicators %}
                <input type="hidden" name="indicators[]" value="{{ indicator }}" />
            {% endfor %}

            {% for state in states %}
                <input type="hidden" name="state[]" value="{{ state }}" />
            {% endfor %}

            <input type="submit" value="Generate CSV" />
        </form>
    </div>
</div>
{% endif %}