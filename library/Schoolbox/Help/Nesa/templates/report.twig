{% macro demonstrated(value, tooltip) %}
    <span class="demonstrated" title="{{ tooltip }}">{{ value }}</span>
{% endmacro %}

{% macro notDemonstrated(value, tooltip) %}
    <span class="not-demonstrated" title="{{ tooltip }}">{{ value }}</span>
{% endmacro %}

{% macro undecided(value, tooltip) %}
    <span class="undecided" title="{{ tooltip }}">{{ value }}</span>
{% endmacro %}

{% import _self as macro %}
<style type="text/css">
    th:first-child {
        width: 20%;
    }

    th.center,
    td.center {
        text-align: center;
    }

    .demonstrated {
        background-color: #aea;
        display: block;
        padding: 3px;
        font-weight: bold;
    }

    .not-demonstrated {
        background-color: #fdd;
        display: block;
        padding: 3px;
        font-weight: bold;
    }

    .undecided {
        background-color: #eee;
        display: block;
        padding: 3px;
        font-weight: bold;
    }
</style>

<script type="text/javascript">
    $(function() {
        $('[data-accredit]').on('click', function(event) {
            event.preventDefault();

            var self = $(this);
            var username = self.attr('data-accredit-name');

            var toast = $('#accreditation-toast');
            toast.toastActivate({text: 'Accreditting ' + username + '...'});

            $.post($(this).attr('href'), {userId: $(this).attr('data-accredit')})
                .success(function(response) {
                    if (response.status == 1) {
                        self.removeClass().addClass('icon-approve');
                    }

                    toast.toastTimeout({text: username + ' accredited.', css: 'success'});
                })
                .error(function() {
                    toast.toastTimeout({text: 'Could not accredit ' + username, css: 'alert'});
                });
        });
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>NESA Report</h1>
        <ul class="meta">
            <li class="icon-timetable">Took approx. {{ duration }} seconds</li>
            <li class="icon-weather">States:
                {% for state in states %}
                    {{ state }}{% if not loop.last %},{% endif %}
                {% endfor %}
            </li>
        </ul>

        <section>
            <table>
                <thead>
                    <th>User</th>
                    <th>PD Number</th>
                    {% for indicator in indicators %}
                        <th class="center">{{ indicator }}</th>
                    {% endfor %}
                    <th>Action</th>
                </thead>
                <tbody>
                    {% for row in report %}
                    <tr>
                        <td><a href="/search/user/{{ row.user.id }}">{{ row.user.fullname }}</a></td>
                        <td>{{ row.user.number }}</td>

                        {# Render data in the same order as headings #}

                        {% for indicator in indicators %}

                        <td class="center">

                            {% if row.condensed[indicator].outcome == 'Y' %}
                                {{ macro.demonstrated('Y', row.condensed[indicator].text) }}
                            {% elseif row.condensed[indicator].outcome == 'N' %}
                                {{ macro.notDemonstrated('N', row.condensed[indicator]) }}
                            {% else %}
                                {{ macro.undecided('-', row.condensed[indicator]) }}
                            {% endif %}
                        </td>
                        {% endfor %}
                        <td class="actions-small-1">
                            <nav>
                                {% set accreditRoute = routeLookupIfAuthorized('professionaldevelopment.postAccredit', {
                                    userId: row.user.id
                                }) %}

                                {% if accreditRoute %}
                                    <a href="{{ accreditRoute }}" class="icon-favourite" title="Accredit {{ row.user.fullname }}" data-accredit-name="{{ row.user.fullname }}" data-accredit="{{ row.user.id }}"></a>
                                {% endif %}
                            </nav>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </div>
</div>

<div id="accreditation-toast" class="toast"></div>

{# For CSV generation #}

<form action="{{ routeLookup('help.postNesaCsv') }}" method="post">
    <input type="text" name="unaccreditedOnly" value="{{ unaccreditedOnly }}" />

    {% for indicator in indicators %}
    <input type="text" name="indicators[]" value="{{ indicator }}" />
    {% endfor %}

    {% for state in states %}
    <input type="text" name="state[]" value="{{ state }}" />
    {% endfor %}

    <input type="submit" value="Generate CSV" />
</form>

