<div class="row">
    <div class="small-12 columns">
        <h1>NESA Report</h1>

        <h2 class="subheader">{{ course.title }}</h2>
        <form action="{{ routeLookup('help.postNesa') }}" method="post">
            <table>
                <thead>
                    <th></th>
                    <th>Capability</th>
                    <th>Indicator</th>
                    <th>Descriptor</th>
                </thead>

                {% for id, data in descriptors  %}
                <tr>
                    <td>
                        <input id="indicator-{{ loop.index0 }}" name='indicators[]' type="checkbox" value="{{ data.criterion.name }}" />
                        <label for="indicator-{{ loop.index0 }}" class="checkbox-label"></label>
                    </td>
                    <td>{{ data.criterion.grouping }}</td>
                    <td>{{ data.criterion.name }}</td>
                    <td>{{ data.description }}</td>
                </tr>
                {% endfor %}
            </table>
            <input type="submit" value="Generate" />
        </form>
    </div>
</div>