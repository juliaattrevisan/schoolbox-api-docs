<div class="row">
    <div class="small-12 island">
        <h1>NESA Report</h1>

        <h2 class="subheader">{{ course.title }}</h2>
        <form action="{{ routeLookup('help.postNesa') }}" method="post">
            <section class="content">

            {# Default NSW #}
            {% for state in states %}
                {% if state == 'NSW' %}
                    {% set checked = 'checked="checked"' %}
                {% else %}
                    {% set checked = '' %}
                {% endif %}

                <input id="state-{{ state }}" name="state[]" type="checkbox" value="{{ state }}" {{ checked }}/>
                <label for="state-{{ state }}" class="checkbox-label">{{ state }}</label>
            {% endfor %}
            </section>

            <table>
                <thead>
                    <th></th>
                    <th>Capability</th>
                    <th>Indicator</th>
                    <th>Descriptor</th>
                </thead>

                {% for id, data in descriptors  %}
                    {% if data.criterion.grouping == 'Australian Professional Teaching Standards' %}
                        {% set checked = 'checked="checked"' %}
                    {% else %}
                        {% set checked = '' %}
                    {% endif %}
                <tr>
                    <td>
                        <input id="indicator-{{ loop.index0 }}" name='indicators[]' type="checkbox" value="{{ data.criterion.name }}" {{ checked }}/>
                        <label for="indicator-{{ loop.index0 }}" class="checkbox-label"></label>
                    </td>
                    <td style="width:33%">{{ data.criterion.grouping }}</td>
                    <td style="width:33%">{{ data.criterion.name }}</td>
                    <td style="width:33%">{{ data.description }}</td>
                </tr>
                {% endfor %}
            </table>
            <input type="submit" value="Generate" />
        </form>
    </div>
</div>