{% macro demonstrated(value) %}
    <span style="background-color:#aea;display:block;padding:3px;font-weight:bold;">Y</span>
{% endmacro %}

{% macro notDemonstrated(value) %}
    <span style="background-color:#fdd;display:block;padding:3px;font-weight:bold;">N</span>
{% endmacro %}

{% import _self as macro %}

<div class="row">
    <div class="small-12 columns">
        <h1>NESA Report</h1>
        <section>
            <table>
                <thead>
                    <th>User</th>
                    <th>Assessment</th>
                    {% for descriptor in descriptors %}
                        <th>{{ descriptor }}</th>
                    {% endfor %}
                </thead>
                <tbody>
                    {% for row in report %}
                    <tr>
                        <td>{{ row.user.fullname }} {{ row.user.id }}</td>
                        <td>{{ row.assessmentId }}</td>


                        {# Render data in the same order as headings #}

                        {% for descriptor in descriptors %}
                        <td style="text-align:center">
                            {% set outcome = false %}

                            {% for capability in row.groups %}
                                {% for indicatorId, indicator in capability.criteria %}
                                    {% for descriptorId, descriptorData in indicator.descriptors %}
                                        {% if descriptorId == descriptor %}

                                            {# Only render success in one way #}
                                            {% if indicator.descriptors[descriptor].text == 'Y' %}
                                                {% set outcome = true %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                {% endfor %}
                            {% endfor %}

                            {# When a Capability was selected, but no descriptors chosen
                             # This usually renders as empty as the info was never traversed and collected
                             #}
                            {% if outcome %}
                                {{ macro.demonstrated('Y') }}
                            {% else %}
                                {{ macro.notDemonstrated('N') }}
                            {% endif %}
                        </td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </div>
</div>




