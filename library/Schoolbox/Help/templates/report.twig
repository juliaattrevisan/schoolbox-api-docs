<div class="row">
    <div class="small-12 columns">
        <h1>NESA Report</h1>
        <section>
            <table>
                <thead>
                    <th>User</th>
                    <th>Assessment</th>
                    {% for descriptor in descriptors %}
                        <th>{{ descriptor }}</th>
                    {% endfor %}
                </thead>
                <tbody>
                    {% for row in report %}
                        {% for capabilities in row.groups %}
                            {% for indicatorId, indicator in capabilities.criteria %}
                                <tr>
                                    <td>{{ row.user.fullname }} {{ row.user.id }}</td>
                                    <td>{{ row.assessmentId }}</td>

                                    {% for descriptor in descriptors %}
                                    <td>
                                        {# When a Capability was selected, but nothing attempted
                                         # This renders as empty as the info was never traversed and collected
                                         # Default to "N"
                                         #}
                                        {% if indicator.descriptors[descriptor].text == '' %}
                                            N
                                        {% else %}
                                            {{ indicator.descriptors[descriptor].text }}
                                        {% endif %}
                                    </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </div>
</div>
