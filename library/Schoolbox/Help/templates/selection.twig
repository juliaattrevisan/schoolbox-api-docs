<div class="row">
    <div class="small-12 island">
        <h1>NESA Report</h1>

        <section>
            <table>
                <thead>
                    <th>Descriptor ID</th>
                    <th>Capability</th>
                    <th>Indicator</th>
                    <th>Descriptor</th>
                </thead>

                {% for id, data in descriptors  %}
                <tr>
                    <td>{{ data.id }}</td>
                    <td>{{ data.criterion.grouping }}</td>
                    <td>{{ data.criterion.name }}</td>
                    <td>{{ data.description }}</td>
                </tr>
                {% endfor %}
            </table>
        </section>
    </div>
</div>