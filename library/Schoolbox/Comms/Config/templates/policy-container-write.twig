{% set formRoute = routeLookupIfAuthorized('commsConfig.postConfig') %}

<form action="{{ formRoute }}" method="post">
    <section>
    {% for policy in policies %}
        <fieldset>
            {% include '@commsConfig/policies/' ~ policy.template ~ '.twig' with { policy: policy } %}
        </fieldset>
    {% endfor %}
    </section>

    <input type="submit" value="Update Comms settings"/>
</form>

