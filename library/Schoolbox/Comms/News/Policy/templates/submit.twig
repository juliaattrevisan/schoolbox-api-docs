
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">POST contents</h2>
        <section>
            <ul class="information-list">
                {% for policy in policies %}
                <li class="content">
                    {{ policy.name }} ({{ policy.identifier }})
                    {% if policy.isActive %}
                        is now active.
                    {% else %}
                        is now inactive.
                    {% endif %}
                </li>
                {% endfor %}
            </ul>

            {% set formRoute = routeLookupIfAuthorized('commsNewsPolicy.getPolicies', {id: user.id}) %}

            {% if formRoute %}
                <div class="content">
                    <a href="{{ formRoute }}" class="button icon-previous">Back to {{ formRoute }}</a>
                </div>
            {% else %}
                Not authorised to POST
            {% endif %}
        </section>
    </div>
</div>

