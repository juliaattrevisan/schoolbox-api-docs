{#
 # title: The human-readable title for this policy
 # subtext: A short explanation of what this policy lets you do
 # active: The string which shows when it's active (for non-comms-officers)
 # inactive: The string which shows when it's inactive (for non-comms-officers)
 # name: The input name (comes out in POST)
 # identifier: A unique identifier for this policy (stored in db)
 # value: The value that was set for this policy (stored in db)
 #}
{% set specifications = {
    'global-moderation': {
        'title': 'Global Moderation',
        'subtext': 'Enable to require moderation on every article before they are made publicly available',
        'active': '<strong>Global moderation is on</strong>. Every article requires moderator approval',
        'inactive': '<strong>Global moderation is off</strong>. You can freely post articles',
        'name': 'policy[global-moderation]',
        'identifier': 'global-moderation',
        'value': 0
    }
} %}

{# Acrobatics thanks Andy
 # Get the values from the db, pipe it into the Specification, so that everything is together
 #}
{% for policy in policies %}
    {% set key = policy.identifier %}

    {% set specifications = specifications|merge({(key): attribute(specifications, key)|merge({'value': policy.value})}) %}
{% endfor %}



{% set formRoute = routeLookupIfAuthorized('commsNewsPolicy.postPolicies') %}

<form action="{{ formRoute }}" method="post">
    <section>
    {% for specification in specifications %}
        <fieldset>
            {% include 'sub/switch.twig' with {
                label: specification.title,
                name: specification.name,
                identifier: specification.identifier,
                subtext: specification.subtext,
                isChecked: specification.value,
                checkedValue: 1
            } %}
        </fieldset>
    {% endfor %}
    </section>

    <input type="submit" value="Update Comms settings"/>
</form>

