{##
 # Comms Officers
 #
 # A list of people who have the Comms Officer service permission
 #
 # @param Collection|User[] commsOfficers
 #}
<div class="row">
    <div class="small-12 island">

        {% if USER.isSuperuser %}
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">News Moderators</h2>
                </div>
            </div>
            <nav>
                <a href="/adminv2/user" class="icon-add" title="Manage News Moderators"></a>
            </nav>
        </div>
        {% else %}
        <h2 class="subheader">News Moderators</h2>
        {% endif %}

        {% if commsOfficers|length %}
        <section>
            <ul class="grid medium-block-grid-2 large-block-grid-4">
                {% for officer in commsOfficers %}
                <li>
                    <div class="card small-12">
                        <a href="/search/user/{{ officer.id }}" title="View Profile">
                            <img src="/portrait.php?userId={{ officer.externalId }}&size=square64" alt="View Profile" />
                            <p>{{ officer.fullname }}</p>
                        </a>
                        <p class="meta">{{ officer.role.name }}</p>
                    </div>

                </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-staff-students"></i>
            <p>There are currently no news moderators setup.</p>
            {% if USER.isSuperuser %}
            <p><a href="/adminv2/user" title="Add Comms Officers">Assign news moderatation service permissions</a> to a user.</p>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
