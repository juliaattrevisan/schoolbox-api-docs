{#
 # title: The human-readable title for this policy
 # subtext: A short explanation of what this policy lets you do
 # active: The string which shows when it's active (for non-comms-officers)
 # inactive: The string which shows when it's inactive (for non-comms-officers)
 # name: The input name (comes out in POST)
 # identifier: A unique identifier for this policy (stored in db)
 # value: The value that was set for this policy (stored in db)
 # checkedValue: The value of the checkbox when activated (stored in db, switch.twig only)
 # type: The type of input it is
 #}
{% set specifications = {
    'global_moderation': {
        'title': 'Global Moderation',
        'subtext': 'Enable to require moderation on every article before they are made publicly available.',
        'active': '<strong>Global moderation is on</strong>. Every article requires moderator approval.',
        'inactive': '<strong>Global moderation is off</strong>. You can freely post articles.',
        'identifier': 'global_moderation',
        'value': 0,
        'checkedValue': 1,
        'type': 'switch'
    },
    'news_staff_post': {
        'title': 'Allow Staff To Post To All Audiences',
        'subtext': 'Enable staff to audience ' ~ locale.news ~ ' to campus, roles, houses and year levels.',
        'active': 'Staff may publish ' ~ locale.news ~ ' to all audiences',
        'inactive': 'Staff may publish ' ~ locale.news ~ ' only to groups they have write access to',
        'identifier': 'news_staff_post',
        'value': 0,
        'checkedValue': 1,
        'type': 'switch'
    },
    'news_edit_other': {
        'title': 'Allow Staff to Modify ' ~ locale.news.proper,
        'subtext': 'Enable staff to modify ' ~ locale.news ~ ' posted by other users if they have write access',
        'active': 'Staff may modify ' ~ locale.news ~ ' posted by other users to their groups',
        'inactive': 'Staff can only modify ' ~ locale.news ~ ' they posted',
        'identifier': 'news_edit_other',
        'value': 0,
        'checkedValue': 1,
        'type': 'switch'
    },
    'publish_date_offset': {
        'title': 'Publish Date Offset',
        'subtext': locale.news.proper ~ ' will initially have their default publish date set to the current datetime plus this value.',
        'active': locale.news.proper ~ ' are set to <strong>publish using an offset</strong> from time of authorship',
        'inactive': locale.news.proper ~ ' are set to <strong>publish immediately</strong>.',
        'identifier': 'publish_date_offset',
        'value': '',
        'type': 'input'
    },
    'expiry_date_offset': {
        'title': 'Expiry Date Offset',
        'subtext': locale.news.proper ~ ' will initially have their default expiry date set to the current datetime plus this value.',
        'active': locale.news.proper ~ ' are set to <strong>expire using an offset</strong> from time of authorship',
        'inactive': locale.news.proper ~ ' are set to <strong>expire one week from time of authorship</strong>.',
        'identifier': 'expiry_date_offset',
        'value': '+1 week',
        'type': 'input'
    },
    'read_more': {
        'title': '"Read More" link for long articles',
        'subtext': locale.news.proper ~ ' that are truncated will have a link containing this text, prompting audience to "read more". To disable it, leave this blank.',
        'active': 'Long ' ~ locale.news ~ ' <strong>will</strong> have a "read more" link with this text',
        'inactive': 'Long ' ~ locale.news ~ ' <strong>will not</strong> have a "read more" link.',
        'identifier': 'read_more',
        'value': '',
        'type': 'input'
    },
    'save_for_later': {
        'title': 'Saving Articles',
        'subtext': 'Allow users to add ' ~ locale.news ~ ' articles to their saved items.',
        'active': locale.news.proper ~ ' <strong>can</strong> be Saved For Later.',
        'inactive': locale.news.proper ~ ' <strong>cannot</strong> be Saved For Later.',
        'identifier': 'save_for_later',
        'value': 0,
        'checkedValue': 1,
        'type': 'switch'
    }
} %}

{# Acrobatics thanks Andy
 # Get the values from the db, pipe it into the Specification, so that everything is together
 #}
{% for policy in policies %}
    {% set key = policy.identifier %}

    {# https://craftcms.stackexchange.com/questions/22619/overwrite-value-in-object-in-array #}
    {% set specifications = specifications|merge({(key): attribute(specifications, key)|merge({'value': policy.value})}) %}
{% endfor %}

{# Ram it onto screen #}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">News Policy Settings</h2>

        {# Comms Officers can change the configuration of the policies
         # Everyone else gets a readonly version of those settings chosen
         #}
        {% if configurable %}
            {% set formRoute = routeLookupIfAuthorized('commsNewsPolicy.postPolicies') %}

            <form action="{{ formRoute }}" method="post">
                <section>
                    {% for specification in specifications %}
                        <fieldset>
                            {% import '@commsNewsPolicy/' ~ specification.type ~ '.twig' as policyMacro %}
                            {{ policyMacro.writable(specification) }}
                        </fieldset>
                    {% endfor %}
                </section>

                <input type="submit" value="Save" />
            </form>
        {% else %}
            <section>
                <ul class="information-list">
                    {% for specification in specifications %}
                        <li class="content">
                            {% import '@commsNewsPolicy/' ~ specification.type ~ '.twig' as policyMacro %}
                            {{ policyMacro.readable(specification) }}
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </div>
</div>

