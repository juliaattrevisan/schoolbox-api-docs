{#
 # title: The human-readable title for this policy
 # subtext: A short explanation of what this policy lets you do
 # active: The string which shows when it's active (for non-comms-officers)
 # inactive: The string which shows when it's inactive (for non-comms-officers)
 # name: The input name (comes out in POST)
 # identifier: A unique identifier for this policy (stored in db)
 # value: The value that was set for this policy (stored in db)
 # checkedValue: The value of the checkbox when activated (stored in db, switch.twig only)
 # type: The type of input it is
 #}
{% set specifications = {
    'global_moderation': {
        'title': 'Global Moderation',
        'subtext': 'Enable to require moderation on every article before they are made publicly available.',
        'active': '<strong>Global moderation is on</strong>. Every article requires moderator approval.',
        'inactive': '<strong>Global moderation is off</strong>. You can freely post articles.',
        'name': 'policy[global_moderation]',
        'identifier': 'global_moderation',
        'value': 0,
        'checkedValue': 1,
        'type': 'switch'
    },
    'publish_date_offset': {
        'title': 'Publish Date Offset',
        'subtext': 'News Articles will have their default publish date set to the current datetime plus this value.',
        'active': '<strong>News Articles are set to publish using an offset</strong>',
        'inactive': '<strong>News Articles are set to publish immediately</strong>.',
        'name': 'policy[publish_date_offset]',
        'identifier': 'publish_date_offset',
        'value': '',
        'type': 'input'
    },
    'expiry_date_offset': {
        'title': 'Expiry Date Offset',
        'subtext': 'News Articles will have their default expiry date set to the current datetime plus this value.',
        'active': '<strong>News Articles are set to expire using an offset</strong>',
        'inactive': '<strong>News Articles are set to expire one week from time of authorship</strong>.',
        'name': 'policy[expiry_date_offset]',
        'identifier': 'expiry_date_offset',
        'value': '+1 week',
        'type': 'input'
    }
} %}

{# Acrobatics thanks Andy
 # Get the values from the db, pipe it into the Specification, so that everything is together
 #}
{% for policy in policies %}
    {% set key = policy.identifier %}

    {# https://craftcms.stackexchange.com/questions/22619/overwrite-value-in-object-in-array #}
    {% set specifications = specifications|merge({(key): attribute(specifications, key)|merge({'value': policy.value})}) %}
{% endfor %}

{# Ram it onto screen #}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Comms Policy Settings</h2>

        {# Comms Officers can change the configuration of the policies
         # Everyone else gets a readonly version of those settings chosen
         #}
        {% if configurable %}
            {% set formRoute = routeLookupIfAuthorized('commsNewsPolicy.postPolicies') %}

            <form action="{{ formRoute }}" method="post">
                <section>
                    {% for specification in specifications %}
                        <fieldset>
                            {% import '@commsNewsPolicy/' ~ specification.type ~ '.twig' as policyMacro %}
                            {{ policyMacro.writable(specification) }}
                        </fieldset>
                    {% endfor %}
                </section>

                <input type="submit" value="Update Comms settings" />
            </form>
        {% else %}
            <section>
                <ul class="information-list">
                    {% for specification in specifications %}
                        <li class="content">
                            {% import '@commsNewsPolicy/' ~ specification.type ~ '.twig' as policyMacro %}
                            {{ policyMacro.readable(specification) }}
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
        </section>
    </div>
</div>

