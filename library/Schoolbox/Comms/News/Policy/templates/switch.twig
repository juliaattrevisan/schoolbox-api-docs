{# Write representation #}
{% macro writable(specification) %}
<label for="{{ specification.identifier }}">{{ specification.title }}</label>

{% if specification.subtext|length %}
<p>{{ specification.subtext }}</p>
{% endif %}

<div class="switch">
    <input id="{{ specification.identifier }}" name="policy[{{ specification.identifier }}]" type="checkbox" {% if specification.value %}checked{% endif %} value="{{ specification.checkedValue }}">
    <label for="{{ specification.identifier }}">
        <span>On</span>
        <span>Off</span>
    </label>
</div>
{% endmacro %}

{# Read-only representation #}
{% macro readable(specification) %}
    {% if specification.value %}
        {{ specification.active|purify }}
    {% else %}
        {{ specification.inactive|purify }}
    {% endif %}
{% endmacro %}
