{% set policy = {
    'identifier': 'global-moderation',
    'name': 'Global Moderation',
    'subtext': 'Enable to require moderation on every article before they are made publicly available',
    'active': '<strong>Global moderation is on</strong>. Every article requires moderator approval',
    'inactive': '<strong>Global moderation is off</strong>. You can freely post articles',
    'isActive': false
} %}

{% include 'sub/switch.twig' with {
    label: policy.name,
    name: 'policy[' ~ policy.identifier ~ ']',
    identifier: policy.identifier,
    subtext: policy.subtext,
    isChecked: policy.isActive,
    checkedValue: 1
} %}
