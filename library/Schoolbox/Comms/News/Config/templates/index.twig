<div class="row">
    <div class="small-12 columns">
        <h1>Comms Settings</h1>
    </div>
</div>

{# Add a list of current Comms Officers
 #}
{% include '@commsNewsConfig/comms-officers.twig' with { commsOfficers: commsOfficers } %}

{# Show a list of configuration options that can be changed by super
 # Otherwise just show the conclusion to everyone else
 #}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Comms Policy Settings</h2>
            {% if USER.isSuperuser %}
                {% include '@commsNewsConfig/policy-container-write.twig' with { policies: policies } %}
            {% else %}
                {% include '@commsNewsConfig/policy-container-read.twig' with { policies: policies } %}
            {% endif %}
        </section>
    </div>
</div>

