{#
Sets up a container for async article loading.

Data:
    componentInstanceId int
    compactMode         int
    limit               int
    folderId            int
    key                 string
    referrer            string
 #}
<div id="toast" class="toast"></div>
<script src="/javascript/shared/comms/articletabs.js"></script>
<script src="/javascript/shared/comms/saveforlater.js"></script>
<script>
    {% set querystringParams = [
        'c=' ~ compactMode,
        'l=' ~ limit,
        'f=' ~ folderId,
        'hp=1',
        'ref=' ~ referrer
    ] |join('&') %}

    {% set getListHomePagePath = routeLookup('commsNews.getListForHomepage', {folderId: folderId}) %}

    $(function () {
        var $articleList = $('#news-container-{{ componentInstanceId }}'),
            $actionBar = $('#news-component-actions-{{ componentInstanceId }}');

        $.ajax({
            type: 'GET',
            url: "{{ getListHomePagePath }}?{{ querystringParams|raw }}",
            dataType: 'json'
        }).success(function (response) {
            $articleList.html(response.fragment);
            if ($articleList.find('.information-list').length > 0) {
                $actionBar.removeClass('hide');
            }
        }).error(function (response) {
            console.log(response);
        });

        $('#news-container-{{ componentInstanceId }}').saveForLater();
    });
</script>

<div id="news-container-{{ componentInstanceId }}">
    <div class="loader"></div>
</div>

{% set rssRoute = routeLookupIfAuthorized('commsNewsFeed.getFeed', {key: key, folderId: folderId}) %}
{% set createRoute = routeLookupIfAuthorized('commsNews.getCreateInFolder', {folderId: folderId}) %}
{% if rssRoute or createRoute %}
<div class="component-action hide" id="news-component-actions-{{ componentInstanceId }}">
    <section>
        {% if rssRoute %}
            <a href="{{ rssRoute }}" class="button" title="Download RSS feed for this topic" data-rss>RSS</a>
            {# ^ href is populated by js in articletabs.js #}
        {% endif %}

        {% if createRoute %}
            <a href="{{ createRoute }}" class="button">Create {{ locale.news }}</a>
        {% endif %}
    </section>
</div>
{% endif %}
