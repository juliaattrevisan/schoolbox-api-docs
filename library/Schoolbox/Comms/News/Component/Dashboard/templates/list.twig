{% import _self as macro %}

{##
 # Pacify $text by removing everything except <p> tags
 # Cut to the maximum length specified
 # Provide a "Read More" link if specified
 #
 # @param News\Model text
 # @param string policy
 #}
{% macro pacify(article, readmore) %}
{% spaceless %}
    {% set pacified = article.blurb|striptags %}

    {# Maximum length chars #}
    {% set max = 300 %}

    {# Split on the nearest word #}
    {% if pacified|length > max %}
        {% set detailUrl = routeLookup('commsNews.getDetail', {articleId: article.id}) %}
        {% set pacified = pacified|slice(0, max+1)|split(' ')|slice(0, -1)|join(' ') ~ '...'%}

        {# If policy has a value, append a "Read More" style link
         # Otherwise, don't do anything except the appended  ellipsis
         #}
        {% if readmore|length %}
            {% set pacified = pacified ~ '<a href="' ~ detailUrl ~ '">' ~ readmore ~ '</a>' %}
        {% endif %}
    {% endif %}

    {{ pacified|trim|purify }}
{% endspaceless %}
{% endmacro %}

{# A list of news articles that can be seen by the world
 # Typically async'd into components
 #}
<ul class="information-list">
    {% for article in articles %}
        <li class="actions-small-1">
            <div class="list-item">
                <div class="small-12 card">
                    <a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}">
                        {% if article.featureImage.hash %}
                        <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=square64">
                        {% endif %}

                        <h3>{{ article.title }}</h3>
                    </a>

                    <p class="meta">Published by {{ article.author.fullname }} on {{ article.publishAt.local }}</p>

                    {# TODO: Have a /news/topic url lol #}
                    {% if article.topics|length %}
                        <p class="meta">Related topics:
                            {% for topic in article.topics %}
                                <a href="/news/topic/{{ topic.slug }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </p>
                    {% endif %}
                </div>
            </div>
            <nav>
                {% if savedArticleIds[article.id] is defined %}
                    {% set state = savedArticleIds[article.id] %}
                {% else %}
                    {% set state = unsaved %}
                {% endif %}

                <a data-saveforlater="{{ state }}" href="{{ routeLookup('commsNewsSaveForLater.postToggle', {articleId: article.id}) }}"></a>
            </nav>

            {# Hide the article tag when there's no content to show #}
            {% set blurb = macro.pacify(article, "Read more") %}

            {% if blurb|length %}
            <article>{{ blurb }}</article>
            {% endif %}
        </li>
    {% endfor %}
</ul>