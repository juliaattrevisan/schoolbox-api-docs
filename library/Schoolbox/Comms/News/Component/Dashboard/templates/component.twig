<script src="/javascript/shared/comms/articletabs.js"></script>
<script src="/javascript/shared/comms/saveforlater.js"></script>
<script>
    $(function() {
        $('#news-container-{{ componentInstanceId }}').articleTabs({
            'firstUrl': "{{ routeLookup('commsNews.getListByTopic', {topicId: firstTopicId, limit: limit}) ~ '?compactMode=' ~ compactMode }}",
            'topicTabs': '#news-topics-{{ componentInstanceId }}'
        });
    });
</script>

<dl class="tabs-material" data-tab="" id="news-topics-{{ componentInstanceId }}">
    {% for topic in topics %}
    <dd {% if loop.first and not allDefault %}class="active"{% endif %}><a href="{{ routeLookup('commsNews.getListByTopic', {topicId: topic.id, limit: limit}) ~ '?compactMode=' ~ compactMode }}">{{ topic.name }}</a></dd>
    {% endfor %}

    {# Select "All" by default if the component config is set #}
    <dd {% if allDefault %}class="active"{% endif %}><a href="{{ routeLookup('commsNews.getListByTopic', {topicId: 0, limit: limit}) ~ '?compactMode=' ~ compactMode }}">All</a></dd>
</dl>

<div id="news-container-{{ componentInstanceId }}">
    <div class="loader"></div>
</div>