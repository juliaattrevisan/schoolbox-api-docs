<script src="/javascript/shared/comms/saveforlater.js"></script>
<script>
    $(function() {
        $.ajax({
            type: 'GET',
            url: "{{ routeLookup('commsNews.getListByTopic', {topicId: 1}) }}",
            dataType: 'html'
        }).success(function (response) {
            var container = $('#news-container-{{ componentInstanceId }}');

            container.html(response).saveForLater();
        }).error(function (response) {

        });
    });
</script>

<dl class="tabs" data-tab="">
    {% for topic in topics %}
    <dd {% if loop.first %}class="active"{% endif %}><a data-topic="{{ topic.id }}">{{ topic.name }}</a></dd>
    {% endfor %}
</dl>

<div id="news-container-{{ componentInstanceId }}">
    <div class="loader"></div>
</div>