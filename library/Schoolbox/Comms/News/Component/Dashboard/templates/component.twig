{#
 # News dashboard component
 #
 # @param int componentInstanceId
 # @param string queryStringPage
 # @param string queryStringReferrer
 # @param string queryStringTopic
 # @param string topicAll
 # @param string referrer
 # @param string compactMode
 # @param int limit
 # @param bool showTopicByDefault
 #}

<script src="/javascript/components/schoolbox-vue.min.js"></script>

<div id="news-container-{{ componentInstanceId }}">
    {% include '@commsNews/article-list.twig' with {
        queryStringPage: queryStringPage,
        queryStringReferrer: queryStringReferrer,
        queryStringTopic: queryStringTopic,
        topicAll: topicAll,
        topic: topic,
        referrer: referrer,
        changeTabOnMeta: false,
        modifyWindowState: false,
        compactMode: compactMode,
        initialPage: 1,
        limit: limit,
        disablePagination: true,
        showTopicByDefault: showTopicByDefault,
        showMore: true
    } %}
</div>
