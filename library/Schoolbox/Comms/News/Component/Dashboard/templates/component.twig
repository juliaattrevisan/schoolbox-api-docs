{# TODO: Probably remove this magic number 0, which means "all topics" #}
{% set firstTopic = allDefault ? 0 : topics.first.id %}

<script src="/javascript/shared/comms/saveforlater.js"></script>
<script>
    $(function() {
        var container = $('#news-container-{{ componentInstanceId }}');

        /**
         * Get articles via url specified
         */
        function getArticles(url) {
            $.ajax({
                type: 'GET',
                url: url,
                dataType: 'html'
            }).success(function (response) {
                container.html(response).saveForLater();
            }).error(function (response) {
            });
        }

        /* Initial conditions
         */
        getArticles("{{ routeLookup('commsNews.getListByTopic', {topicId: firstTopic, limit: limit}) }}");

        {# Retrieve a new set of articles based on topic #}
        $('#news-topics-{{ componentInstanceId }}').on('click', 'a', function(event) {
            event.preventDefault();

            container.html('<div class="loader"></div>');

            getArticles($(this).attr('href'));
        });
    });
</script>

<dl class="tabs" data-tab="" id="news-topics-{{ componentInstanceId }}">
    {% for topic in topics %}
    <dd {% if loop.first and not allDefault %}class="active"{% endif %}><a href="{{ routeLookup('commsNews.getListByTopic', {topicId: topic.id, limit: limit}) }}">{{ topic.name }}</a></dd>
    {% endfor %}

    {# Select "All" by default if the component config is set #}
    <dd {% if allDefault %}class="active"{% endif %}><a href="{{ routeLookup('commsNews.getListByTopic', {topicId: 0, limit: limit}) }}">All</a></dd>
</dl>

<div id="news-container-{{ componentInstanceId }}">
    <div class="loader"></div>
</div>