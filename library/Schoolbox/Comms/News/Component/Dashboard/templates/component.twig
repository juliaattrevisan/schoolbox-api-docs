{##
 # A list of all the available Topics to chooze
 # Sets up a container for async article loading
 #
 # @param int componentInstanceId
 # @param Collection|Topic[] topics
 # @param int topicAll
 # @param string slug
 # @param int compactMode
 # @param int limit
 # @param string referrer
 #}
<script src="/javascript/shared/comms/articletabs.js"></script>
<script src="/javascript/shared/comms/saveforlater.js"></script>
<script>

    {% set querystringParams = [
        'topic=' ~ slug,
        'c=' ~ compactMode,
        'l=' ~ limit,
        'hp=1',
        'ref=' ~ referrer
    ]|join('&') %}

    $(function() {
        $('#news-container-{{ componentInstanceId }}').articleTabs({
            'selectedUrl': "{{ routeLookup('commsNews.getListByTopic') }}?{{ querystringParams|raw }}",
            'topicTabs': $("#news-topics-{{ componentInstanceId }}"),
            onChange: function() {
                // Hide the component action bar
                $('#news-component-actions-{{ componentInstanceId }}').addClass('hide');
            },
            onChangeSuccess: function (response) {
                if (response.viewAllLink !== null) {
                    var $actionBar = $('#news-component-actions-{{ componentInstanceId }}');
                    var $viewAllBtn = $actionBar.find('a[data-news-component-view-all]');

                    // Update view all href with the topic
                    $viewAllBtn.attr('href', response.viewAllLink);

                    // Show the action bar
                    $actionBar.removeClass('hide');
                }
            }
        });

        $('#news-container-{{ componentInstanceId }}').saveForLater();
    });
</script>

{% include '@commsNews/tabs.twig' with {
    url: routeLookup('commsNews.getListByTopic'),
    topicContainerId: 'news-topics-' ~ componentInstanceId,
    topics: topics,
    topicAll: topicAll,
    slug: slug,
    compactMode: compactMode,
    limit: limit,
    hidePaginator: true,
    referrer: referrer
} %}

<div id="news-container-{{ componentInstanceId }}">
    <div class="loader"></div>
</div>

<div class="component-action hide" id="news-component-actions-{{ componentInstanceId }}">
    <section>
        <a href="#" class="button" data-news-component-view-all>View All</a>
        {# ^ href is populated by js in articletabs.js #}
    </section>
</div>
