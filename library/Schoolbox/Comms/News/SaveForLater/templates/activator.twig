{##
 # Save For Later
 #
 # UI element and behaviours for this feature
 #
 # @param Model news
 # @param string state
 #}

<script>
    $(function() {

        {# Title indicates the next state, because this is a toggle #}
        var states = {
            saved: {
                url: "{{ routeLookup('commsNewsSaveForLater.postRemove', {newsId: news.id}) }}",
                toast: {
                    processing: 'Saving...',
                    complete: 'Saved'
                },
                value: 1,
                icon: 'icon-favourite',
                title: 'Unsave article'
            },
            unsaved: {
                url: "{{ routeLookup('commsNewsSaveForLater.postActivate', {newsId: news.id}) }}",
                toast: {
                    processing: 'Unsaving...',
                    complete: 'Unsaved'
                },
                value: 0,
                icon: 'icon-favourite-hollow',
                title: 'Save article'
            }
        };

        function init(currentValue) {
            var currentState;

            if (parseInt(currentValue)) {
                currentState = states.saved;
            }
            else {
                currentState = states.unsaved;
            }

            $('#saveforlater a')
                .attr('href', currentState.url)
                .attr('title', currentState.title)
                .addClass(currentState.icon)
                .attr('data-saveforlater', currentState.value)
        }

        init({{ state }});


        $('#saveforlater').on('click', 'a[data-saveforlater]', function(event) {
            event.preventDefault();

            var $element = $(this);
            var $toast = $('#toast');

            {# The state of everything after the action takes place
             # Save it, if it's currently unsaved
             # Unsave it, if it's currently saved
             #}
            var newState;

            if ($element.attr('data-saveforlater') === '1') {
                newState = states.unsaved;
            } else {
                newState = states.saved;
            }

            $toast.toastActivate({
                text: newState.toast.processing
            });

            $.ajax({
                type: 'POST',
                url: $element.attr('href'),
                dataType: 'json'
            }).success(function () {
                $toast.toastTimeout({
                    text: newState.toast.complete,
                    css: 'success'
                });

                // Update data attribute
                $element.attr('data-saveforlater', newState.value);

                // Update icon by removing all classes and adding the new one
                $element.removeClass().addClass(newState.icon);

                // Update title
                $element.attr('title', newState.title);

            }).error(function (response) {
                var temp = $.parseJSON(response.responseText);

                $toast.toastTimeout({
                    text: 'Error: ' + temp.message,
                    css: 'alert'
                });
            });

        });
    });
</script>

<span id="saveforlater"><a data-saveforlater></a></span>
