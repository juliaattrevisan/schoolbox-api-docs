{##
 # Save For Later
 #
 # UI element and behaviours for this feature
 #
 # @param News\Model article   The article the session user wishes to add/remove from saved list
 # @param bool       isSaved   Is this article currently saved to user's list?
 #}

{% set routeAdd    = routeLookupIfAuthorized('commsNewsSaveForLater.postAdd', {article: article, articleId: article.id}) %}
{% set routeRemove = routeLookupIfAuthorized('commsNewsSaveForLater.postRemove', {article: article, articleId: article.id}) %}

<span data-save-for-later="{{ article.id }}">
    {# Add to List #}
    {% if routeAdd %}
    <a
            data-action="add"
            href="{{ routeAdd }}"
            class="sbx-icon-only-button {% if isSaved %}hide{% endif %}"
            title="Save article"
            aria-label="Save article"
            data-toast-processing="Saving..."
            data-toast-complete="Saved"
    ><sbx-icon name="favourite-hollow"></sbx-icon></a>
    {% endif %}

    {# Remove from list #}
    {% if routeRemove %}
    <a
            data-action="remove"
            href="{{ routeRemove }}"
            class="sbx-icon-only-button {% if not isSaved %}hide{% endif %}"
            title="Remove article from saved items"
            aria-label="Remove article from saved items"
            data-toast-processing="Removing..."
            data-toast-complete="Removed"
    ><sbx-icon name="favourite"></sbx-icon></a>
    {% endif %}
</span>
