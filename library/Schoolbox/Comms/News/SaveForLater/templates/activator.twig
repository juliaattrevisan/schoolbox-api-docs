{##
 # Save For Later
 #
 # UI element and behaviours for this feature
 #
 # @param Model news
 # @param string state
 #}
<script>
    $(function() {
        $('#saveforlater').on('click', function(event) {
            event.preventDefault();

            var $element = $(this);
            var $toast = $('#toast');

            $toast.toastActivate({
                text: 'Saving for later...'
            });

            $.ajax({
                type: 'POST',
                url: $element.attr('href'),
                dataType: 'json'
            }).success(function () {
                $toast.toastTimeout({
                    text: 'Saved',
                    css: 'success'
                });

                {# Update icon #}
                $element.removeClass('icon-favourite-hollow').addClass('icon-favourite');
            }).error(function (response) {
                var temp = $.parseJSON(response.responseText);

                $toast.toastTimeout({
                    text: 'Error: ' + temp.message,
                    css: 'alert'
                });
            });
        });
    });
</script>
{% if state %}
    <a href="{{ routeLookup('commsNewsSaveForLater.getList') }}" class="icon-favourite" title="This {{ locale.news }} article is already Saved For Later"></a>
{% else %}
    <a href="{{ routeLookup('commsNewsSaveForLater.postActivate', {newsId: news.id}) }}" class="icon-favourite-hollow" title="Save for later" id="saveforlater"></a>
{% endif %}
