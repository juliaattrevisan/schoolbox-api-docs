{##
 # Save For Later
 #
 # UI element and behaviours for this feature
 #
 # @param Model news
 # @param string state
 #}
<a data-saveforlater="{{ state }}" data-save-url="{{ routeLookup('commsNewsSaveForLater.postActivate', {newsId: news.id}) }}" data-unsave-url="{{ routeLookup('commsNewsSaveForLater.postRemove', {newsId: news.id}) }}"></a>
