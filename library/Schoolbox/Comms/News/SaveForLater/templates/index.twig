{% import '@commsNews/macro/newsBlurb.twig' as macro %}

{##
 # Saved items
 #
 # A list of articles that you've saved for later
 #}

{% extends '@commsNews/page-layout.twig' %}

{% block breadCrumbs %}
    {% import 'sub/breadcrumbs.twig' as bread %}
    {{ bread.crumbs([locale.news.properPlural, routeLookup('commsNews.getIndex')], ['My Saved ' ~ locale.news.properPlural]) }}
{% endblock %}

{% block newsTitle %}My Saved {{ locale.news.proper }}{% endblock %}

{% block createLink %}
{% endblock %}

{% block newsContent %}
    {% if articles|length %}
        <section id="savedArticlesSection">
            <ul class="information-list" id="saveForLaterList">
                {% for article in articles %}
                    {% set routeRemove = routeLookupIfAuthorized('commsNewsSaveForLater.postRemove', {article: article, articleId: article.id}) %}
                    <li class="{% if routeRemove %}actions-small-1{% endif %}">
                        <div class="list-item">
                            <div class="small-12 card">

                                {% if article.featureImage %}
                                    <a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}?ref={{ referrer }}">
                                        <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=square64">
                                    </a>
                                {% elseif fallbackImage.type == 'school-logo' %}
                                    <a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}?ref={{ referrer }}">
                                        <img src="/images/logo.php?logo=skin_logo_large&size=favicon">
                                    </a>
                                {% elseif fallbackImage.type == 'author' %}
                                    {% if article.author.portrait and article.author.portrait.hash %}
                                        <a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}?ref={{ referrer }}">
                                            <img src="/storage/image.php?hash={{ article.author.portrait.hash }}&size=square64">
                                        </a>
                                    {% endif %}
                                {% endif %}

                                <h3><a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}?ref={{ referrer }}">{{ article.title|default('(untitled)') }}</a></h3>
                                <p class="meta">
                                    Published by
                                    {% if article.author.deletedAt.isNull %}
                                        <a href="/search/user/{{ article.author.id }}" title="View Profile">{{ article.author.fullname }}</a>
                                    {% else %}
                                        {{ article.author.fullname }}
                                    {% endif %}
                                    <time title="{{ article.publishAt.long }}">{{ article.publishAt.relativeTime }}</time>

                                    {# Attachment Count #}
                                    {% if attachmentCounts[article.id] ?? false %}
                                        <span>
                                        | <a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}?ref={{ referrer }}">{{ attachmentCounts[article.id] }} attachments</a>
                                    </span>
                                    {% endif %}
                                </p>

                                {% if article.topics|length %}
                                    <p class="meta">Related topics:
                                        {% for topic in article.topics %}
                                            <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                        {% if routeRemove %}
                        <nav>
                            <a class="icon-favourite" href="{{ routeRemove }}" title="Remove this from your saved items" data-remove="{{ article.title }}"></a>
                        </nav>
                        {% endif %}

                        {% set blurb = macro.newsBlurb(article) %}
                        <article>
                            {% if blurb|length %}
                            {{ blurb }}
                            {% endif %}

                            {% if readMores[article.id].available %}
                                {% set detailUrl = routeLookup('commsNews.getDetail', {articleId: article.id}) %}
                                {% set readMoreLink = '<div class="article-read-more"><a href="' ~ detailUrl ~ '" title="Read more">' ~ readMores[article.id].string ~ '</a></div>' %}

                                {{ readMoreLink|trim|purify }}
                            {% endif %}
                        </article>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if articles|length %}
        {% set initialEmptyState = 'display:none' %}
    {% else %}
        {% set initialEmptyState = '' %}
    {% endif %}

    <div class="empty-state" id="emptyState" style="{{ initialEmptyState }}">
        <i class="icon-news"></i>
        <p>You don't have any saved articles yet.</p>
    </div>
{% endblock %}

{% block newsScripts %}
    {% if articles|length %}
        <script>
            $(function() {

                $('#saveForLaterList [data-remove]').on('click', function(event) {
                    event.preventDefault();

                    var element = $(this);
                    var toast = $('#toast');

                    $(this).confirmDialog({
                        format: 'html',
                        text: 'Are you sure you want to remove <em>' + element.attr('data-remove') + '</em>?',
                        confirmEvent: function() {
                            toast.toastActivate({
                                text: 'Removing...'
                            });

                            $.ajax({
                                type: 'POST',
                                url: element.attr('href'),
                                dataType: 'json'
                            }).done(function () {
                                toast.toastTimeout({
                                    text: 'Removed',
                                    css: 'success'
                                });

                                element.closest('li').remove();
                                {# If this was the last in the list, respawn Empty State #}
                                if (!$('#saveForLaterList li').length) {
                                    $('#savedArticlesSection').remove();
                                    $('#emptyState').show();
                                }
                            }).error(function () {
                                toast.toastTimeout({
                                    text: 'Unable to remove item from list',
                                    css: 'alert'
                                });
                            });
                        }
                    });
                });
            });
        </script>
    {% endif %}
{% endblock %}
