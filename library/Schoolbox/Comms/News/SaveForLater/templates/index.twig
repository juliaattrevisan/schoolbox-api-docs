{##
 # Saved items
 #
 # A list of articles that you've saved for later
 #}

{% import _self as macro %}

{##
 # Pacify $text by removing everything except <p> tags
 # Cut to the maximum length specified
 # Provide a "Read More" link if specified
 #
 # @param News\Model article
 # @param string readMore
 #}
{% macro pacify(article, readMore) %}
    {% spaceless %}
        {% set pacified = article.blurb|striptags %}

        {# If the blurb was nonexistent, assume some body content instead #}
        {% if pacified|length == 0 %}
            {% set pacified = article.body|striptags %}
        {% endif %}

        {# Maximum length chars #}
        {% set max = 300 %}

        {# Split on the nearest word #}
        {% if pacified|length > max %}
            {% set detailUrl = routeLookup('commsNews.getDetail', {articleId: article.id}) %}
            {% set pacified = pacified|slice(0, max+1)|split(' ')|slice(0, -1)|join(' ') ~ '...'%}

            {# If read_more policy has a value, append a "Read More" style link
             # Otherwise, don't do anything except the appended  ellipsis
             #}
            {% if readMore|length %}
                {% set pacified = pacified ~ '<a href="' ~ detailUrl ~ '" title="Read more">' ~ readMore ~ '</a>' %}
            {% endif %}
        {% endif %}

        {{ pacified|trim|purify }}
    {% endspaceless %}
{% endmacro %}

{% extends '@commsNews/page-layout.twig' %}

{% block newsTitle %}My Saved {{ locale.news | capitalize }}{% endblock %}

{% block createLink %}
{% endblock %}

{% block newsContent %}
    {% if articles|length %}
        <section class="saved-articles">
            <ul class="information-list" id="saveForLaterList">
                {% for article in articles %}
                    {% set routeRemove = routeLookupIfAuthorized('commsNewsSaveForLater.postRemove', {article: article, articleId: article.id}) %}
                    <li class="{% if routeRemove %}actions-small-1{% endif %}">
                        <div class="list-item">
                            <div class="small-12 card">

                                {% if article.featureImage.hash %}
                                    <a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}?ref={{ referrer }}">
                                        <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=square64">
                                    </a>
                                {% endif %}

                                <h3><a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}?ref={{ referrer }}">{{ article.title }}</a></h3>
                                <p class="meta">
                                    Authored by
                                    {% if article.author.deletedAt.isNull %}
                                        <a href="/search/user/{{ article.author.id }}" title="View Profile">{{ article.author.fullname }}</a>
                                    {% else %}
                                        {{ article.author.fullname }}
                                    {% endif %}
                                    <time title="{{ article.publishAt.long }}">{{ article.publishAt.relativeTime }}</time>
                                </p>

                                {% if article.topics|length %}
                                    <p class="meta">Related topics:
                                        {% for topic in article.topics %}
                                            <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                        {% if routeRemove %}
                        <nav>
                            <a class="icon-favourite" href="{{ routeRemove }}" title="Remove this from your saved items" data-remove="{{ article.title }}"></a>
                        </nav>
                        {% endif %}
                        {# Hide the article tag when there's no content to show, or when compactMode is on #}
                        {% if not compactMode %}
                            {% set blurb = macro.pacify(article, readMore) %}

                            {% if blurb|length %}
                                <article>{{ blurb }}</article>
                            {% endif %}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if articles|length %}
        {% set initialEmptyState = 'display:none' %}
    {% else %}
        {% set initialEmptyState = '' %}
    {% endif %}

    <div class="empty-state" id="emptyState" style="{{ initialEmptyState }}">
        <i class="icon-news"></i>
        <p>You don't have any saved articles yet.</p>
    </div>
{% endblock %}

{% block newsScripts %}
    {% if articles|length %}
        <script>
            $(function() {

                $('#saveForLaterList [data-remove]').on('click', function(event) {
                    event.preventDefault();

                    var element = $(this);
                    var toast = $('#toast');

                    $(this).confirmDialog({
                        format: 'html',
                        text: 'Are you sure you want to remove <em>' + element.attr('data-remove') + '</em>?',
                        confirmEvent: function() {
                            toast.toastActivate({
                                text: 'Removing...'
                            });

                            $.ajax({
                                type: 'POST',
                                url: element.attr('href'),
                                dataType: 'json'
                            }).success(function () {
                                toast.toastTimeout({
                                    text: 'Removed',
                                    css: 'success'
                                });

                                element.closest('li').remove();
                                {# If this was the last in the list, respawn Empty State #}
                                if (!$('#saveForLaterList li').length) {
                                    $('section').remove( ".saved-articles" );
                                    $('#emptyState').show();
                                }
                            }).error(function () {
                                toast.toastTimeout({
                                    text: 'Unable to remove item from list',
                                    css: 'alert'
                                });
                            });
                        }
                    });
                });
            });
        </script>
    {% endif %}
{% endblock %}
