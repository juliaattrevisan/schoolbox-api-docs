{##
 # Referrer Demographics, Periodic
 #
 # A breakdown of referrers during this period

 # @param array referrerDemographic
 #}
<script>
    $(function() {
        $('#referrerDemographic').highcharts({
            chart: {
                spacingBottom: 64,
                type: 'bar',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            plotOptions: {
                series: {
                    stacking: 'normal'
                }
            },

            time: {
                useUTC: false
            },

            title: {
                text: 'Referrer Demographic'
            },

            tooltip: {
                useHTML: true
            },

            xAxis: {
                categories: ['Impressions', 'Conversions']
            },

            yAxis: [
                {
                    allowDecimals: false,
                    min: 0,
                    title: {
                        text: 'Number of interactions'
                    }
                }
            ],

            series: [
                {
                    color: '#6ed0e0',
                    name: 'Dashboard',
                    data: [
                        {{ referrerDemographic['impression']['dashboard'] }},
                        {{ referrerDemographic['conversion']['dashboard'] }}
                    ]
                },
                {
                    color: '#1f78c1',
                    name: 'Homepage',
                    data: [
                        {{ referrerDemographic['impression']['homepage'] }},
                        {{ referrerDemographic['conversion']['homepage'] }}
                    ]
                },
                {
                    color: '#0a437c',
                    name: 'Index',
                    data: [
                        {{ referrerDemographic['impression']['index'] }},
                        {{ referrerDemographic['conversion']['index'] }}
                    ]
                },
                {
                    color: '#806eb7',
                    name: 'Archive',
                    data: [
                        {{ referrerDemographic['impression']['archive'] }},
                        {{ referrerDemographic['conversion']['archive'] }}
                    ]
                },
                {
                    color: '#ba43a9',
                    name: 'Email',
                    data: [
                        {{ referrerDemographic['impression']['email'] }},
                        {{ referrerDemographic['conversion']['email'] }}
                    ]
                }
            ]
        });
    });
</script>
<div id="referrerDemographic"></div>
