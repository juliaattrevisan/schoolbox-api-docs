{##
 # Referrer Demographics, Periodic
 #
 # A breakdown of referrers during this period
 #
 # @param array referrerDemographic
 #}
<script>
    $(function() {
        $('#referrerDemographic').highcharts({
            chart: {
                spacingRight: 48,
                type: 'column',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            plotOptions: {
                column: {
                    dataLabels: {
                        enabled: true,
                        formatter: function() {
                            return '<span style="color:' + this.series.color + '">' + this.y + '</span>'
                        }
                    }
                }
            },

            time: {
                useUTC: false
            },

            title: {
                text: 'Referrer Demographic'
            },

            tooltip: {
                pointFormat: '{point.y} {point.category} came<br />from the <span style="color:{series.color}">{series.name}</span> referrer',
                useHTML: true
            },

            xAxis: {
                categories: ['Opens']
            },

            yAxis: {
                allowDecimals: false,
                min: 0,
                title: {
                    text: 'People'
                }
            },

            series: [
                {
                    color: '#82b5d8',
                    name: 'Archive',
                    data: [
                        {{ referrerDemographic['open']['archive'] }}
                    ]

                },
                {
                    color: '#1f78c1',
                    name: 'Dashboard',
                    data: [
                        {{ referrerDemographic['open']['dashboard'] }}
                    ]
                },
                {
                    color: '#0a437c',
                    name: 'Email',
                    data: [
                        {{ referrerDemographic['open']['email'] }}
                    ]
                },
                {
                    color: '#806eb7',
                    name: 'Homepage',
                    data: [
                        {{ referrerDemographic['open']['homepage'] }}
                    ]
                },
                {
                    color: '#ba43a9',
                    name: 'Index',
                    data: [
                        {{ referrerDemographic['open']['index'] }}
                    ]
                },
                {
                    color: '#c1263c',
                    name: 'Search',
                    data: [
                        {{ referrerDemographic['open']['search'] }}
                    ]
                },
                {
                    color: '#888888',
                    name: 'None',
                    data: [
                        {{ referrerDemographic['open']['unknown'] }}
                    ]
                }
            ]
        });
    });
</script>

<section class="content">
    <div id="referrerDemographic"></div>
</section>

<section>
    <table class="ico" data-cumulative>
        <thead>
            <tr>
                <th>Referrer</th>
                <th>Opens</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Archive</td>
                <td>{{ referrerDemographic.open.archive }}</td>
            </tr>
            <tr>
                <td>Dashboard</td>
                <td>{{ referrerDemographic.open.dashboard }}</td>
            </tr>
            <tr>
                <td>Email</td>
                <td>{{ referrerDemographic.open.email }}</td>
            </tr>
            <tr>
                <td>Homepage</td>
                <td>{{ referrerDemographic.open.homepage }}</td>
            </tr>
            <tr>
                <td>Index</td>
                <td>{{ referrerDemographic.open.index }}</td>
            </tr>
            <tr>
                <td>Search</td>
                <td>{{ referrerDemographic.open.search }}</td>
            </tr>
            <tr>
                <td>None</td>
                <td>{{ referrerDemographic.open.unknown }}</td>
            </tr>
        </tbody>
    </table>
</section>
