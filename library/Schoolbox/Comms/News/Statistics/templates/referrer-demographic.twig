{##
 # Referrer Demographics, Periodic
 #
 # A breakdown of referrers during this period
 #
 # @param array referrerDemographic
 #}
<script>
    $(function() {
        $('#referrerDemographic').highcharts({
            chart: {
                spacingRight: 48,
                type: 'column',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            plotOptions: {
                column: {
                    dataLabels: {
                        enabled: true,
                        formatter: function() {
                            return '<span style="color:' + this.series.color + '">' + this.y + '</span>'
                        }
                    }
                }
            },

            time: {
                useUTC: false
            },

            title: {
                text: 'Referrer Demographic'
            },

            tooltip: {
                pointFormat: '{point.y} {point.category} came<br />from the <span style="color:{series.color}">{series.name}</span> referrer',
                useHTML: true
            },

            xAxis: {
                categories: ['Opens']
            },

            yAxis: {
                allowDecimals: false,
                min: 0,
                title: {
                    text: 'People'
                }
            },

            series: [
                {
                    color: '#82b5d8',
                    name: 'Dashboard',
                    data: [
                        {{ referrerDemographic['open']['dashboard'] }}

                    ]
                },
                {
                    color: '#1f78c1',
                    name: 'Homepage',
                    data: [
                        {{ referrerDemographic['open']['homepage'] }}
                    ]
                },
                {
                    color: '#0a437c',
                    name: 'Index',
                    data: [
                        {{ referrerDemographic['open']['index'] }}

                    ]
                },
                {
                    color: '#806eb7',
                    name: 'Archive',
                    data: [
                        {{ referrerDemographic['open']['archive'] }}
                    ]
                },
                {
                    color: '#ba43a9',
                    name: 'Email',
                    data: [
                        {{ referrerDemographic['open']['email'] }}
                    ]
                },
                {
                    color: '#888888',
                    name: 'None',
                    data: [
                        {{ referrerDemographic['open']['unknown'] }}
                    ]
                }
            ]
        });
    });
</script>
<div id="referrerDemographic"></div>
