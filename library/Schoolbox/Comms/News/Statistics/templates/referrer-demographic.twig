{##
 # Referrer Demographics, Periodic
 #
 # A breakdown of referrers during this period
 #
 # @param array referrerDemographic
 #}
<script>
    $(function() {
        var chart = new Highcharts.Chart({
            chart: {
                renderTo: 'referrerDemographic',
                spacingRight: 48,
                type: 'column',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            plotOptions: {
                column: {
                    dataLabels: {
                        enabled: true,
                        formatter: function() {
                            return '<span style="color:' + this.series.color + '">' + this.y + '</span>'
                        }
                    }
                }
            },

            time: {
                useUTC: false
            },

            title: {
                text: ''
            },

            tooltip: {
                pointFormat: '{point.y} - Accessed via <span style="color:{series.color}">{series.name}</span>',
                useHTML: true
            },

            xAxis: {
                categories: ['Source']
            },

            yAxis: {
                allowDecimals: false,
                min: 0,
                title: {
                    text: 'People'
                }
            },

            series: [
                {
                    color: '#82b5d8',
                    name: 'Archive',
                    data: [
                        {{ referrerDemographic['open']['archive'] }}
                    ]

                },
                {
                    color: '#1f78c1',
                    name: 'Dashboard',
                    data: [
                        {{ referrerDemographic['open']['dashboard'] }}
                    ]
                },
                {
                    color: '#0a437c',
                    name: 'Notification',
                    data: [
                        {{ referrerDemographic['open']['email'] }}
                    ]
                },
                {
                    color: '#806eb7',
                    name: 'Homepage',
                    data: [
                        {{ referrerDemographic['open']['homepage'] }}
                    ]
                },
                {
                    color: '#ba43a9',
                    name: '{{ locale.news.proper }} Feed',
                    data: [
                        {{ referrerDemographic['open']['index'] }}
                    ]
                },
                {
                    color: '#c1263c',
                    name: 'RSS',
                    data: [
                        {{ referrerDemographic['open']['rss'] }}
                    ]
                },
                {
                    color: '#f86727',
                    name: 'Saved',
                    data: [
                        {{ referrerDemographic['open']['saved'] }}
                    ]
                },
                {
                    color: '#f8ce27',
                    name: 'Search',
                    data: [
                        {{ referrerDemographic['open']['search'] }}
                    ]
                },
                {
                    color: '#888888',
                    name: 'Unknown',
                    data: [
                        {{ referrerDemographic['open']['none'] }}
                    ]
                }
            ]
        });

        {# Because Foundation... #}
        setTimeout(function() {
            chart.reflow();
        }, 250)
    });
</script>

<section class="content">
    <div id="referrerDemographic"></div>
</section>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/dataTables.js?v={{ config.site_version }}"></script>
<script>
    $(function() {
        $('[data-cumulative]').DataTable({
            info: false,
            paging: false,
            searching: false
        });
    });
</script>

