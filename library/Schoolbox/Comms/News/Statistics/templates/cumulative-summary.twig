<div class="content">
    <div class="row">
        <div class="small-12 medium-4 columns">
            <p class="infographic">
                <span class="title">{% block cumulativeDateHeading %}First Open <span class='hint has-tip tip-top' data-tooltip title="The date when the {{ locale.news }} was first opened">?</span>{% endblock %}</span>
                <span class="value">{% if cumulative.date %}{{ cumulative.date|date('j M') }}{% else %}n/a{% endif %}</span>
            </p>
        </div>
        <div class="small-12 medium-4 columns">
            <p class="infographic">
                <span class="title">Conversions <span class="hint has-tip tip-top" data-tooltip title="The number of people who saw a link with a referrer, and then clicked through to view the {{ locale.news }}">?</span></span>
                <span class="value">{{ cumulative.numConversions }}</span>
            </p>
        </div>
    </div>
</div>

<table class="ico" data-cumulative>
    <thead>
    <tr>
        <th>Referrer</th>
        <th>Conversions</th>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td>Dashboard</td>
        <td>{{ cumulative.breakdown.grid.conversion.dashboard }}</td>
    </tr>
    <tr>
        <td>Homepage</td>
        <td>{{ cumulative.breakdown.grid.conversion.homepage }}</td>
    </tr>
    <tr>
        <td>Index</td>
        <td>{{ cumulative.breakdown.grid.conversion.index }}</td>
    </tr>
    <tr>
        <td>Archive</td>
        <td>{{ cumulative.breakdown.grid.conversion.archive }}</td>
    </tr>
    <tr>
        <td>Email</td>
        <td>{{ cumulative.breakdown.grid.conversion.email }}</td>
    </tr>
    </tbody>
</table>

{% if cumulative.breakdown.grid.open.unknown %}
<div class="content">
    <div class="row">
        <div class="small-12 columns">
            <p>Additionally, people opened this article <strong>{{ cumulative.breakdown.grid.open.unknown }} times</strong> without a referrer.</p>
        </div>
    </div>
</div>
{% endif %}
