{##
 # Cumulative Summary
 #
 # @param array cumulative
 #}

<section>
    <div class="content">
        <div class="row">
            <div class="small-12 medium-3 columns">
                <p class="infographic">
                    <span class="title">Unique Opens</span>
                    <span class="value">{{ cumulative.numUniqueOpens }}</span>
                </p>
            </div>
            <div class="small-12 medium-3 columns">
                <p class="infographic">
                    <span class="title">Audience <span class="hint has-tip tip-top" data-tooltip title="The total number of users that can see this {{ locale.news }}">?</span></span>
                    <span class="value">{{ audience }}</span>
                </p>
            </div>
            <div class="small-12 medium-3 columns">
                <p class="infographic">
                    <span class="title">Comments</span>
                    <span class="value">{{ cumulative.numComments }}</span>
                </p>
            </div>
            <div class="small-12 medium-3 columns">
                <p class="infographic">
                    <span class="title">Saved</span>
                    <span class="value">{{ cumulative.numSaved }}</span>
                </p>
            </div>
        </div>
    </div>
</section>
