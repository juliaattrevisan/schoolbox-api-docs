{##
 # Cumulative Summary
 #
 # @param array cumulative
 #}

<script>
    $(function() {
        var chart = new Highcharts.Chart({
            chart: {
                renderTo: 'audienceViews',
                plotBorderWidth: null,
                type: 'pie',
                height: 180,
                marginTop: 0,
                marginBottom: 35
            },

            credits: {
                enabled: false
            },

            time: {
                useUTC: false
            },

            title: {
                text: ''
            },
            tooltip: {
                pointFormat: '<b>{point.percentage:.1f}%</b>'
            },
            plotOptions: {
                pie: {
                    point: {
                        events: {
                            legendItemClick: function () {
                                return false; // <== returning false will cancel the default action
                            }
                        }
                    },
                    dataLabels: {
                        enabled: false,
                    },
                    showInLegend: true
                }
            },
            legend: {
                padding: 0
            },
            series: [
                {
                    name: 'Audience',
                    data: [{
                        name: 'Visited',
                        y: {{ cumulative.numUniqueOpens }}
                    }, {
                        name: 'Yet to visit',
                        y: {{ audience - cumulative.numUniqueOpens }}
                    }]
                }
            ]
        });

        {# Because Foundation... #}
        setTimeout(function() {
            chart.reflow();
        }, 250)
    });
</script>

<section>
    <div class="content">
        <div class="row">
            <div class="small-12 medium-6 columns">
                <div class="row">
                    <div class="small-12 medium-6 columns">
                        <p class="infographic">
                            <span class="title">First Open</span>
                            <span class="value">{% if cumulative.date %}{{ cumulative.date|date('j M') }}{% else %}n/a{% endif %}</span>
                        </p>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <p class="infographic">
                            <span class="title">Total Opens</span>
                            <span class="value">{{ cumulative.numOpens }}</span>
                        </p>
                    </div>
                </div>
                <div class="row">
                    <div class="small-12 medium-6 columns">
                        <p class="infographic">
                            <span class="title">Unique Opens</span>
                            <span class="value">{{ cumulative.numUniqueOpens }}</span>
                        </p>
                    </div>

                    <div class="small-12 medium-6 columns">
                        <p class="infographic">
                            <span class="title">Audience <span class="hint has-tip tip-top" data-tooltip title="The total number of users that can see this {{ locale.news }}">?</span></span>
                            <span class="value">{{ audience }}</span>
                        </p>
                    </div>
                </div>
                <div class="row">
                    <div class="small-12 medium-6 columns">
                        <p class="infographic">
                            <span class="title">Comments</span>
                            <span class="value">{{ cumulative.numComments }}</span>
                        </p>
                    </div>

                    <div class="small-12 medium-6 columns">
                        <p class="infographic">
                            <span class="title">Saved</span>
                            <span class="value">{{ cumulative.numSaved }}</span>
                        </p>
                    </div>
                </div>

            </div>
            <div class="small-12 medium-6 columns">
                <p class="infographic">
                    <span class="title">Audience Reach <span class="hint has-tip tip-top" data-tooltip title="The percentage of the audience who has opened the {{ locale.news }}">?</span></span>
                    <div id="audienceViews"></div>
            </p>
            </div>
        </div>
    </div>
</section>
