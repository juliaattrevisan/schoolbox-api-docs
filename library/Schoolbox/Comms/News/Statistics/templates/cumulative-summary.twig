
<script>
    $(function() {
        $('#ico-cumulative').DataTable({
            info: false,
            paging: false,
            searching: false
        });
    });
</script>

<div class="content">
    <div class="row">
        <div class="small-12 medium-3 columns">
            <p class="infographic">
                <span class="title">{% block cumulativeDateHeading %}First Open{% endblock %}</span>
                <span class="value">{% block cumulativeDateValue %}{{ cumulative.firstOpen|date('j M') }}{% endblock %}</span>
            </p>
        </div>
        <div class="small-12 medium-3 columns">
            <p class="infographic">
                <span class="title">Conversions</span>
                <span class="value">{{ cumulative.numConversions }}</span>
            </p>
        </div>
        <div class="small-12 medium-3 columns">
            <p class="infographic">
                <span class="title">Impressions</span>
                <span class="value">{{ cumulative.numImpressions }}</span>
            </p>
        </div>
        <div class="small-12 medium-3 columns">
            <p class="infographic">
                <span class="title">Conversion Ratio</span>
                <span class="value percentage">{{ cumulative.conversionRatio }}<span>%</span></span>
            </p>
        </div>
    </div>
</div>

<table class="ico" id="ico-cumulative">
    <thead>
    <tr>
        <th>Referrer</th>
        <th>Conversions</th>
        <th>Impressions</th>
        <th>Ratio</th>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td>Dashboard</td>
        <td>{{ cumulative.breakdown.grid.conversion.dashboard }}</td>
        <td>{{ cumulative.breakdown.grid.impression.dashboard }}</td>
        <td>{{ cumulative.breakdown.ratio.dashboard }}%</td>
    </tr>
    <tr>
        <td>Homepage</td>
        <td>{{ cumulative.breakdown.grid.conversion.homepage }}</td>
        <td>{{ cumulative.breakdown.grid.impression.homepage }}</td>
        <td>{{ cumulative.breakdown.ratio.homepage }}%</td>
    </tr>
    <tr>
        <td>Index</td>
        <td>{{ cumulative.breakdown.grid.conversion.index }}</td>
        <td>{{ cumulative.breakdown.grid.impression.index }}</td>
        <td>{{ cumulative.breakdown.ratio.index }}%</td>
    </tr>
    <tr>
        <td>Archive</td>
        <td>{{ cumulative.breakdown.grid.conversion.archive }}</td>
        <td>{{ cumulative.breakdown.grid.impression.archive }}</td>
        <td>{{ cumulative.breakdown.ratio.archive }}%</td>
    </tr>
    <tr>
        <td>Email</td>
        <td>{{ cumulative.breakdown.grid.conversion.email }}</td>
        <td>{{ cumulative.breakdown.grid.impression.email }}</td>
        <td>{{ cumulative.breakdown.ratio.email }}%</td>
    </tr>
    </tbody>
</table>
