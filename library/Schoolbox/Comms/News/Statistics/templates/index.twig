<div class="row">
    <div class="small-12 columns">
        <h1>Statistics for {{ article.title }}</h1>
    </div>
</div>

<script src="https://code.highcharts.com/highcharts.js"></script>

<div class="row">
    <div class="small-12 island">
        {% include '@commsNewsStatistics/cumulative-summary.twig' with {
            cumulative: cumulative
        } %}
    </div>
</div>


<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Periodic Data</h2>
        <p class="meta">Statistics from the last 30 days. Click and drag graphs to zoom.</p>

        <section class="content">
            {% include '@commsNewsStatistics/accuracy.twig' with {
                article: article,
                accuracies: accuracies
            } %}

            {% include '@commsNewsStatistics/conversions-chronological.twig' with {
                conversions: conversions
            } %}

            {% include '@commsNewsStatistics/referrer-demographic.twig' with {
                referrerDemographic: referrerDemographic
            } %}

            {% include '@commsNewsStatistics/referrer-chronological.twig' with {
                article: article,
                accuracy: accuracy,
                series: series
            } %}
        </section>
    </div>
</div>


