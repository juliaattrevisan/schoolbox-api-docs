{##
 # Statistics Index
 #
 # @param News\Model article
 # @param int        period
 # @param array      cumulative
 # @param array      referrerDemographic
 # @param array      roleTypeDemographic
 # @param array      scaleOptions
 # @param string     scale
 # @param array      historic
 #}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/highcharts.js?v={{ config.site_version }}"></script>

{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    [locale.news.properPlural, routeLookup('commsNews.getIndex')],
    [article.title |default("(untitled)"), routeLookup('commsNews.getDetail', {articleId: article.id})],
    ['Statistics']
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>Statistics for {{ article.title }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="cumulatives">
        <h2 class="subheader">Summary</h2>

        {% include '@commsNewsStatistics/cumulative-summary.twig' with {
            cumulative: cumulative
        } %}
    </div>
</div>

<div class="row">
    <div class="small-12 medium-6 island">
        <h2 class="subheader">Audience Reach</h2>
        {% include '@commsNewsStatistics/audience-reach.twig' with {
            article: article,
        } %}
    </div>
    <div class="small-12 medium-6 island">
        <h2 class="subheader">Recent Visitors</h2>
        {% if recentVisitors|length %}
            {% include '@commsNewsStatistics/recent-visitors.twig' with {
                article: article,
                users: recentVisitors
            } %}
        {% else %}
            <div class="empty-state">
                <i class="icon-staff"></i>
                <p>Nobody has visited yet.</p>
            </div>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Open Rate</h2>
        <p class="meta">
            Click and drag graphs to zoom; click and drag while holding down <strong>Shift</strong> to pan while zoomed in.
        </p>

        {% include '@commsNewsStatistics/interactions-chronological.twig' with {
            article: article,
            scaleOptions: scaleOptions,
            scale: scale
        } %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Source</h2>

        {% include '@commsNewsStatistics/referrer-demographic.twig' with {
            referrerDemographic: referrerDemographic
        } %}

        {# Temporarily disabled
        {% include '@commsNewsStatistics/roletype-demographic.twig' with {
            roleTypeDemographic: roleTypeDemographic
        } %}
        #}
    </div>
</div>

<div class="row">
    <div class="small-12 island">

</div>


{# Historical Dailies: temporarily disabled
 #
 # This seems to confuse people a lot, and there's a lot of numbers here
 # We'd need to design the way we present this information, either as a
 # line graph or as a series of tables as per below
 #
 # We also don't know the utility of this information yet. Regardless, we
 # continue to capture enough data points to show this kind of information
 # such that we can enable/re-present this later.
 #}
{#
{% if historic|length %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Historic Dailies</h2>
        <p class="meta">Daily statistics from all time.</p>

        {% include '@commsNewsStatistics/cumulative-historic.twig' with {
            historic: historic
        } %}
    </div>
</div>
{% endif %}
#}
