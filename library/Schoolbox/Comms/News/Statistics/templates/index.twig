<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<script>
    $(function() {
        $('[data-cumulative]').DataTable({
            info: false,
            paging: false,
            searching: false
        });
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>Statistics for {{ article.title }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="cumulatives">
        <h2 class="subheader">Cumulative Summary</h2>
        <p class="meta">Overall cumulative statistics from all time.</p>

        <section>
            {% include '@commsNewsStatistics/cumulative-summary.twig' with {
                cumulative: cumulative
            } %}
        </section>

        <section class="content">
            {% include '@commsNewsStatistics/referrer-demographic.twig' with {
                referrerDemographic: referrerDemographic
            } %}
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Periodic Data</h2>
        <p class="meta">Statistics from the last 30 days. Click and drag graphs to zoom; click and drag while holding down <strong>Shift</strong> to pan while zoomed in.</strong></p>

        <section class="content">
            {% include '@commsNewsStatistics/accuracy.twig' with {
                article: article,
                accuracies: accuracies
            } %}

            {% include '@commsNewsStatistics/conversions-chronological.twig' with {
                conversions: conversions
            } %}

            {% include '@commsNewsStatistics/referrer-chronological.twig' with {
                article: article,
                accuracy: accuracy,
                series: series
            } %}
        </section>
    </div>
</div>

{% if historic|length %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Historic Dailies</h2>
        <p class="meta">Daily cumulative statistics from all time.</p>

        {% for daily in historic %}
        <section>
            {% include '@commsNewsStatistics/cumulative-historic.twig' with {
                cumulative: daily
            } %}
        </section>
        {% endfor %}
    </div>
</div>
{% endif %}