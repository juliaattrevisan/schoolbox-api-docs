<script src="https://code.highcharts.com/highcharts.js"></script>
<script>
    $(function() {
        $('#graph').highcharts({

            /* can use inverted:true to make it horizontal'
             */
            chart: {
                type: 'column',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            time: {
                useUTC: false
            },

            title: {
                text: 'Interactions over time'
            },

            xAxis: {
                title: {
                    text: 'Date'
                },
                type: 'datetime'
            },

            yAxis: {
                allowDecimals: false,
                min: 0,
                title: {
                    text: 'Number of interactions'
                }
            },

            tooltip: {
                useHTML: true
            },

            plotOptions: {
                column: {
                    stacking: 'normal'
                }
            },

            series: [
                {
                    color: '#e8bf68',
                    name: 'Impressions',
                    data: {{ series['impression']|json_encode|raw }}
                },
                {
                    color: '#9eea8f',
                    name: 'Conversions',
                    data: {{ series['conversion']|json_encode|raw }}
                },
                {
                    color: '#80B1D5',
                    name: 'Non-referred Opens',
                    data: {{ series['open']|json_encode|raw }}
                }
            ]
        });
    });
</script>
<div class="row">
    <div class="small-12 columns">
        <h1>Statistics for {{ article.title }}</h1>
    </div>
</div>

<div id="graph"></div>
