{##
 # Historic Dailies
 #
 # @param array historic
 #}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/dataTables.js?v={{ config.site_version }}"></script>
<script>
    $(function() {
        $('[data-historic]').DataTable({
            info: false,
            paging: false,
            searching: false
        });
    });
</script>

<table data-historic>
    <thead>
        <tr>
            <th class="u-ta-center">Date</th>
            <th class="u-ta-center">Opens</th>
            <th class="u-ta-center">Comments</th>
        </tr>
    </thead>
    <tbody>
        {% for daily in historic %}
        <tr>
            <td class="u-ta-center" data-order="{{ daily.date|date('U') }}">{% if daily.date %}{{ daily.date|date('j M') }}{% else %}n/a{% endif %}</td>
            <td class="u-ta-center">{{ daily.numOpens }}</td>
            <td class="u-ta-center">{{ daily.numComments }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
