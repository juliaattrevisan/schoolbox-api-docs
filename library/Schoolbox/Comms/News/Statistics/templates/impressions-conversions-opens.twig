<style type="text/css">
    .infographic {
        text-align: center;
    }

    .infographic .title {
        clear: both;
        display: block;
    }

    .infographic .value {
        font-size: 2.5rem;
        font-weight:bold;
    }

    .infographic .value.percentage span {
        font-size: 1.25rem;
    }
</style>
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Overview</h2>
        <p class="meta">Overall cumulative statistics from all time.</p>

        <section class="content">
            <div class="row">
                <div class="small-12 medium-3 columns">
                    <p class="infographic">
                        <span class="title">First Open</span>
                        <span class="value">{{ cumulative.firstOpen|date('j M') }}</span>
                    </p>
                </div>
                <div class="small-12 medium-3 columns">
                    <p class="infographic">
                        <span class="title">Conversion Ratio</span>
                        <span class="value percentage">{{ cumulative.conversionRatio }}<span>%</span></span>
                    </p>
                </div>
                <div class="small-12 medium-3 columns">
                    <p class="infographic">
                        <span class="title">Conversions</span>
                        <span class="value">{{ cumulative.numConversions }}</span>
                    </p>
                </div>
                <div class="small-12 medium-3 columns">
                    <p class="infographic">
                        <span class="title">Impressions</span>
                        <span class="value">{{ cumulative.numImpressions }}</span>
                    </p>
                </div>
            </div>
        </section>
    </div>
</div>


{##
 # @param News\Model $article
 # @param array series
 # @param int accuracy
 #}
<script src="https://code.highcharts.com/highcharts.js"></script>
<script>
    $(function() {
        $('#graph').highcharts({

            /* can use inverted:true to make it horizontal'
             */
            chart: {
                type: 'column',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            time: {
                useUTC: false
            },

            title: {
                text: ''
            },

            xAxis: {

                {# We don't care about seconds/milliseconds in display
                 # Our highest granularity is Minutes.
                 #}
                dateTimeLabelFormats: {
                    millisecond: '%l:%M%P',
                    second: '%l:%M%P',
                    minute: '%l:%M%P',
                    hour: '%l:%M%P'
                },
                title: {
                    text: 'Date'
                },
                type: 'datetime'
            },

            yAxis: {
                allowDecimals: false,
                min: 0,
                title: {
                    text: 'Number of interactions'
                }
            },

            legend: {
                itemMarginBottom: 8
            },

            tooltip: {
                useHTML: true
            },

            plotOptions: {
                column: {
                    stacking: 'normal'
                }
            },

            series: [
                {
                    color: '#f9e2d2',
                    name: 'Impressions/Dashboard',
                    data: {{ series['impression']['dashboard']|json_encode|raw }}
                },
                {
                    color: '#f2c96d',
                    name: 'Impressions/Homepage',
                    data: {{ series['impression']['homepage']|json_encode|raw }}
                },
                {
                    color: '#f9934e',
                    name: 'Impressions/Index',
                    data: {{ series['impression']['index']|json_encode|raw }}
                },
                {
                    color: '#bf1b00',
                    name: 'Impressions/Archive',
                    data: {{ series['impression']['archive']|json_encode|raw }}
                },
                {
                    color: '#58140c',
                    name: 'Impressions/Email',
                    data: {{ series['impression']['email']|json_encode|raw }}
                },
                {
                    color: '#6ed0e0',
                    name: 'Conversions/Dashboard',
                    data: {{ series['conversion']['dashboard']|json_encode|raw }}
                },
                {
                    color: '#1f78c1',
                    name: 'Conversions/Homepage',
                    data: {{ series['conversion']['homepage']|json_encode|raw }}
                },
                {
                    color: '#0a437c',
                    name: 'Conversions/Index',
                    data: {{ series['conversion']['index']|json_encode|raw }}
                },
                {
                    color: '#806eb7',
                    name: 'Conversions/Archive',
                    data: {{ series['conversion']['archive']|json_encode|raw }}
                },
                {
                    color: '#ba43a9',
                    name: 'Conversions/Email',
                    data: {{ series['conversion']['email']|json_encode|raw }}
                },
                {
                    color: '#878787',
                    name: 'Non-referred Opens',
                    data: {{ series['open']['unknown']|json_encode|raw }}
                }
            ]
        });

        {# Accuracy selector #}
        $('#accuracy').on('change', function(event) {
            event.preventDefault();

            window.location.href = $(this).val();
        });
    });
</script>
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Periodic Outlook</h2>
        <p class="meta">Statistics from the last 30 days. Click and drag the graph to zoom.</p>

        <section class="content">
            <div id="graph"></div>

            <label for="accuracy">Accuracy</label>
            <p class="meta">Change the way the graph condenses data.</p>

            {% set route = routeLookupIfAuthorized('commsNewsStatistics.getOverview', {articleId: article.id}) %}

            <select id="accuracy">
                {% for value, label in accuracies %}
                    <option value="{{ route }}?accuracy={{ value }}" {% if value == accuracy %}selected="selected"{% endif %}>{{ value }}</option>
                {% endfor %}
            </select>
        </section>
    </div>
</div>

