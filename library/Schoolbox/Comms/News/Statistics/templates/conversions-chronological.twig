{##
 # Conversions (Chronological)
 #
 # A graph showing Conversions over time
 #
 # @param array conversions
 # @param array conversionRatio
 #}
<script>
    $(function() {
        $('#conversions-chronological').highcharts({
            chart: {
                height: 500,
                spacingBottom: 64,
                type: 'line',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            plotOptions: {
                column: {
                    stacking: 'normal'
                },
                series: {
                    marker: {
                        enabled: true
                    }
                }
            },

            time: {
                useUTC: false
            },

            title: {
                text: 'Interactions and Conversions vs Time'
            },

            tooltip: {
                useHTML: true
            },

            xAxis: {

                {# We don't care about seconds/milliseconds in display
                 # Our highest granularity is Minutes.
                 #}
                dateTimeLabelFormats: {
                    millisecond: '%l:%M%P',
                    second: '%l:%M%P',
                    minute: '%l:%M%P',
                    hour: '%l:%M%P'
                },
                title: {
                    text: 'Date'
                },
                type: 'datetime'
            },

            yAxis: [
                {
                    allowDecimals: false,
                    min: 0,
                    title: {
                        text: 'Number of Conversions'
                    }
                },
                {
                    labels: {
                        style: {
                            color: '#629e51'
                        }
                    },
                    lineColor: '#629e51',
                    lineWidth: 1,
                    max: 100,
                    min: 0,
                    tickInterval: 10,
                    title: {
                        allowDecimals: true,
                        style: {
                            color: '#629e51'
                        },
                        text: 'Conversion Ratio (%)'
                    },
                    opposite: true
                }
            ],

            series: [
                {
                    color: '#f2c96d',
                    name: 'Impressions',
                    data: {{ conversions['impression']|json_encode|raw }}
                },
                {
                    color: '#82b5d8',
                    name: 'Conversions',
                    data: {{ conversions['conversion']|json_encode|raw }}
                },
                {
                    color: '#878787',
                    name: 'Non-referred Opens',
                    data: {{ conversions['open']|json_encode|raw }}
                },
                {
                    color: '#629e51',
                    lineWidth: 1,
                    marker: {
                        radius: 3
                    },
                    name: 'Conversion Ratio (%)',
                    data: {{ conversionRatio|json_encode|raw }},
                    type: 'spline',
                    yAxis: 1
                }
            ]
        });
    });
</script>
<div id="conversions-chronological"></div>
