{##
 # Conversions (Chronological)
 #
 # A graph showing Conversions over time
 #
 # @param array conversions
 # @param array conversionRatio
 #}
<script>
    $(function() {
        var chart = new Highcharts.Chart({
            chart: {
                height: 500,
                panning: true,
                panKey: 'shift',
                renderTo: 'conversions-chronological',
                spacingBottom: 64,
                type: 'line',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            plotOptions: {
                column: {
                    stacking: 'normal'
                }
            },

            time: {
                useUTC: false
            },

            title: {
                text: 'Conversions, Impressions vs Time'
            },

            tooltip: {
                useHTML: true
            },

            xAxis: {

                {# We don't care about seconds/milliseconds in display
                 # Our highest granularity is Minutes.
                 #}
                dateTimeLabelFormats: {
                    millisecond: '%l:%M%P',
                    second: '%l:%M%P',
                    minute: '%l:%M%P',
                    hour: '%l:%M%P'
                },
                title: {
                    text: 'Date'
                },
                type: 'datetime'
            },

            yAxis: [
                {
                    allowDecimals: false,
                    min: 0,
                    title: {
                        text: 'Quantity'
                    }
                },
                {
                    labels: {
                        style: {
                            color: '#629e51'
                        }
                    },
                    lineColor: '#629e51',
                    lineWidth: 1,
                    max: 100,
                    min: 0,
                    tickInterval: 10,
                    title: {
                        allowDecimals: true,
                        style: {
                            color: '#629e51'
                        },
                        text: 'Conversion Ratio This Period (%)'
                    },
                    opposite: true
                }
            ],

            series: [
                {
                    color: '#82b5d8',
                    name: 'Conversions',
                    data: {{ conversions['conversion']|json_encode|raw }}
                },
                {
                    color: '#f2c96d',
                    name: 'Impressions',
                    data: {{ conversions['impression']|json_encode|raw }}
                },
                {
                    color: '#888888',
                    name: 'Non-referred Opens',
                    data: {{ conversions['open']|json_encode|raw }}
                },
                {
                    color: '#629e51',
                    lineWidth: 1,
                    name: 'Conversion Ratio This Period (%)',
                    type: 'spline',
                    yAxis: 1,
                    data: {{ conversionRatio|json_encode|raw }}
                }
            ]
        });

        {# Zoom into the last seven days to start with #}
        var d = new Date();
        chart.xAxis[0].setExtremes(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate() - 7), Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
        chart.showResetZoom();
    });
</script>
<div id="conversions-chronological"></div>
