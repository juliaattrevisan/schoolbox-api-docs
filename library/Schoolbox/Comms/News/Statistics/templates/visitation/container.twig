{##
 # Container
 #
 # Twig container from which to launch our vue component with the provided payload
 #
 # @param News\Model $article  An instance of News\Model
 # @param int $numPerPage      Number of articles per page to display, for pagination
 #}

{% import 'sub/breadcrumbs.twig' as bread %}

{% set payload = {
    'article': article,
    'numPerPage': 25
} %}

{{ bread.crumbs(
    [locale.news.properPlural, routeLookup('commsNews.getIndex')],
    [article.title |default("(untitled)"), routeLookup('commsNews.getDetail', {articleId: article.id})],
    ['Statistics', routeLookup('commsNewsStatistics.getOverview', {articleId: article.id})],
    ['Visitors']
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>Visitors to {{ article.title }}</h1>
    </div>
</div>

<div id="visitation-list-full-container">
    <visitation-list-full :payload="{{ payload | json_encode }}"></visitation-list-full>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/visitationListFull.js?v={{ config.site_version }}"></script>
