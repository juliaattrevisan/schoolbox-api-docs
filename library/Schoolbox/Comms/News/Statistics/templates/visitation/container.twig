{##
 # Container
 #
 # Twig container from which to launch our vue component with the provided payload
 #
 # @param News\Model $article  An instance of News\Model
 #}
{% set payload = {
    'article': article
} %}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ article.title }}</h1>
    </div>
</div>

<div id="visitation-list-container">
    <visitation-list-top10 :payload="{{ payload | json_encode }}"></visitation-list-top10>
</div>

<!-- You need this; spawns after you "npm run build" for the first time -->
<script src="/javascript/components/visitationListTop10.bundle.js"></script>
