{##
 # Conversions, Impressions vs Time
 #
 # @param News\Model article
 # @param array      scaleOptions
 # @param string     scale
 # @param array      interactions
 # @param array      conversionRatio
 #}
<script>
    $(function() {

        /**
         * Reloads the graph with the selected scale
         *
         * @param url
         * @param scale
         */
        function reloadInteractionsVsTime(url, scale) {
            $.getJSON(url, {scale: scale}, function (data) {
                var chart = new Highcharts.Chart({
                    chart: {
                        height: 500,
                        panning: true,
                        panKey: 'shift',
                        reflow: true,
                        renderTo: 'opens-chronological',
                        spacingBottom: 64,
                        type: 'line',
                        zoomType: 'xy'
                    },

                    credits: {
                        enabled: false
                    },

                    plotOptions: {
                        column: {
                            stacking: 'normal'
                        }
                    },

                    time: {
                        useUTC: false
                    },

                    title: {
                        text: ''
                    },

                    tooltip: {
                        useHTML: true
                    },

                    xAxis: {

                        {# We don't care about seconds/milliseconds in display
                         # Our highest granularity is Minutes.
                         #}
                        dateTimeLabelFormats: {
                            millisecond: '%l:%M%P',
                            second: '%l:%M%P',
                            minute: '%l:%M%P',
                            hour: '%l:%M%P'
                        },
                        title: {
                            text: 'Date'
                        },
                        type: 'datetime'
                    },

                    yAxis: [
                        {
                            allowDecimals: false,
                            min: 0,
                            title: {
                                text: 'People'
                            }
                        }
                    ],

                    series: [
                        {
                            color: '#82b5d8',
                            name: 'Staff',
                            data: data.interactions.staff
                        },
                        {
                            color: '#1f78c1',
                            name: 'Parent',
                            data: data.interactions.parent
                        },
                        {
                            color: '#0a437c',
                            name: 'Student',
                            data: data.interactions.student
                        },
                        {
                            color: '#806eb7',
                            name: 'Guest',
                            data: data.interactions.guest
                        },
                        {
                            color: '#99D68E',
                            name: 'Total',
                            data: data.interactions.total
                        }
                    ]
                });

                {# Zoom into the last seven days to start with #}
                {#var d = new Date();#}
                {#chart.xAxis[0].setExtremes(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate() - 7), Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));#}
                {#chart.showResetZoom();#}

                {# Because Foundation... #}
                chart.reflow();
            });
        }

        {# Load initially #}
        reloadInteractionsVsTime("{{ routeLookupIfAuthorized('commsNewsStatistics.getInteractionsVsTime', {article: article, articleId: article.id}) }}", $('#scale').val());

        {# Reload upon selection #}
        $('#scale').on('change', function (event) {
            event.preventDefault();

            reloadInteractionsVsTime("{{ routeLookupIfAuthorized('commsNewsStatistics.getInteractionsVsTime', {article: article, articleId: article.id}) }}", $(this).val());
        });
    });
</script>

<section class="content">
    <label for="scale">Scale</label>
    <p class="meta">Change the way the graph aggregates data.</p>

    <select id="scale">
        {% for value, label in scaleOptions %}
            <option value="{{ value }}" {% if value == scale %}selected="selected"{% endif %}>{{ value }}</option>
        {% endfor %}
    </select>

    <div id="opens-chronological"></div>
</section>
