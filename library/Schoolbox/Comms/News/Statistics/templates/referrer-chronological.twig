{##
 # Interaction Referrers This Period
 #
 # A breakdown of total referrers for Impressions and Conversions this period
 #
 # @param News\Model $article
 # @param array series
 # @param array conversionRatio
 #}
<script>
    $(function() {
        $('#interaction-referrers').highcharts({
            chart: {
                height: 500,
                spacingBottom: 64,
                type: 'column',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            legend: {
                itemMarginBottom: 8
            },

            title: {
                text: 'Interaction Referrers This Period'
            },

            tooltip: {
                useHTML: true
            },

            xAxis: {
                categories: ['Dashboard', 'Homepage', 'Index', 'Archive', 'Email']
            },

            yAxis: {
                allowDecimals: false,
                min: 0,
                title: {
                    text: 'Quantity'
                }
            },

            series: [
                {
                    color: '#82b5d8',
                    name: 'Conversions',
                    data: {{ referrersThisPeriod['conversion']|json_encode|raw }}
                },
                {
                    color: '#f2c96d',
                    name: 'Impressions',
                    data: {{ referrersThisPeriod['impression']|json_encode|raw }}
                }
            ]
        });
    });
</script>
<div id="interaction-referrers"></div>
