{##
 # Interaction Referrers vs Time
 #
 # A breakdown of total referrers for Impressions and Conversions, charted over time
 #
 # @param News\Model $article
 # @param array series
 # @param array conversionRatio
 # @param int accuracy
 #}
<script>
    $(function() {
        $('#interaction-referrers').highcharts({
            chart: {
                height: 500,
                spacingBottom: 64,
                type: 'column',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            legend: {
                itemMarginBottom: 8
            },

            plotOptions: {
                column: {
                    stacking: 'normal'
                }
            },

            time: {
                useUTC: false
            },

            title: {
                text: 'Interaction Referrers vs Time'
            },

            tooltip: {
                useHTML: true
            },

            xAxis: {

                {# We don't care about seconds/milliseconds in display
                 # Our highest granularity is Minutes.
                 #}
                dateTimeLabelFormats: {
                    millisecond: '%l:%M%P',
                    second: '%l:%M%P',
                    minute: '%l:%M%P',
                    hour: '%l:%M%P'
                },
                title: {
                    text: 'Date'
                },
                type: 'datetime'
            },

            yAxis: [
                {
                    allowDecimals: false,
                    min: 0,
                    title: {
                        text: 'Number of interactions'
                    }
                },
                {
                    labels: {
                        style: {
                            color: '#629e51'
                        }
                    },
                    lineColor: '#629e51',
                    lineWidth: 1,
                    max: 100,
                    tickInterval: 10,
                    title: {
                        allowDecimals: true,
                        style: {
                            color: '#629e51'
                        },
                        text: 'Conversion Ratio (%)'
                    },
                    opposite: true
                }
            ],

            series: [
                {
                    color: '#f9e2d2',
                    name: 'Impressions/Dashboard',
                    data: {{ series['impression']['dashboard']|json_encode|raw }}
                },
                {
                    color: '#f2c96d',
                    name: 'Impressions/Homepage',
                    data: {{ series['impression']['homepage']|json_encode|raw }}
                },
                {
                    color: '#f9934e',
                    name: 'Impressions/Index',
                    data: {{ series['impression']['index']|json_encode|raw }}
                },
                {
                    color: '#bf1b00',
                    name: 'Impressions/Archive',
                    data: {{ series['impression']['archive']|json_encode|raw }}
                },
                {
                    color: '#58140c',
                    name: 'Impressions/Email',
                    data: {{ series['impression']['email']|json_encode|raw }}
                },
                {
                    color: '#82b5d8',
                    name: 'Conversions/Dashboard',
                    data: {{ series['conversion']['dashboard']|json_encode|raw }}
                },
                {
                    color: '#1f78c1',
                    name: 'Conversions/Homepage',
                    data: {{ series['conversion']['homepage']|json_encode|raw }}
                },
                {
                    color: '#0a437c',
                    name: 'Conversions/Index',
                    data: {{ series['conversion']['index']|json_encode|raw }}
                },
                {
                    color: '#806eb7',
                    name: 'Conversions/Archive',
                    data: {{ series['conversion']['archive']|json_encode|raw }}
                },
                {
                    color: '#ba43a9',
                    name: 'Conversions/Email',
                    data: {{ series['conversion']['email']|json_encode|raw }}
                },
                {
                    color: '#878787',
                    name: 'Non-referred Opens',
                    data: {{ series['open']['unknown']|json_encode|raw }}
                },
                {
                    color: '#629e51',
                    lineWidth: 1,
                    marker: {
                        radius: 3
                    },
                    name: 'Conversion Ratio (%)',
                    data: {{ conversionRatio|json_encode|raw }},
                    type: 'line',
                    yAxis: 1
                }
            ]
        });
    });
</script>
<div id="interaction-referrers"></div>
