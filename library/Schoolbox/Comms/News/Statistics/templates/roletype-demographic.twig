{##
 # RoleType Demographics, Periodic
 #
 # A breakdown of roletypes during this period
 #
 # @param array roleTypeDemographic
 #}
<script>
    $(function() {
        $('#roleTypeDemographic').highcharts({
            chart: {
                spacingRight: 48,
                type: 'column',
                zoomType: 'xy'
            },

            credits: {
                enabled: false
            },

            plotOptions: {
                column: {
                    dataLabels: {
                        enabled: true,
                        formatter: function() {
                            return '<span style="color:' + this.series.color + '">' + this.y + '</span>'
                        }
                    }
                }
            },

            time: {
                useUTC: false
            },

            title: {
                text: 'User Demographic'
            },

            tooltip: {
                pointFormat: '{point.y} {point.category}',
                useHTML: true
            },

            xAxis: {
                categories: ['Opens']
            },

            yAxis: {
                allowDecimals: false,
                min: 0,
                title: {
                    text: 'People'
                }
            },

            series: [
                {
                    color: '#82b5d8',
                    name: 'Staff',
                    data: [
                        {{ roleTypeDemographic['open']['staff'] }}
                    ]
                },
                {
                    color: '#1f78c1',
                    name: 'Parent',
                    data: [
                        {{ roleTypeDemographic['open']['parent'] }}
                    ]
                },
                {
                    color: '#0a437c',
                    name: 'Student',
                    data: [
                        {{ roleTypeDemographic['open']['student'] }}

                    ]
                },
                {
                    color: '#806eb7',
                    name: 'Guest',
                    data: [
                        {{ roleTypeDemographic['open']['guest'] }}
                    ]
                }
            ]
        });
    });
</script>
<div id="roleTypeDemographic"></div>
