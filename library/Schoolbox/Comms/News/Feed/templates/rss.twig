<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>{{ schoolName }} {{ locale.news.proper }}</title>
        <link>{{ url }}</link>
        <description>Recent {{ locale.news }} items from {{ title }} {% if folder %} in {{ folder.name }}{% endif %}</description>
        <language>en-us</language>
        <lastBuildDate>{{ 'now'|date('r') }}</lastBuildDate>
        <ttl>1</ttl>
        <atom:link href="{{ url }}" rel="self" type="application/rss+xml" />
        {% for article in articles %}
            {% set image = '' %}
            {% if article.featureImage %}
                {% set image = '<img src="'~ baseUrl ~'/storage/image.php?hash=' ~ article.featureImage.hash ~ '&size=constrain200">' %}
            {% endif %}
        <item>
            <title>{{ article.title }}</title>
            <category>{% for topic in article.topics %}{{ topic.name }}{% if not loop.last %}, {% endif %}{% endfor %}</category>
            <description>
                {# image|raw is okay, as it's outputting only a single <img> tag #}
                <![CDATA[{{ image|raw }}{{ article.body|purify }}]]>
            </description>
            <link>{{ baseUrl }}{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}</link>
            <pubDate>{{ article.publishAt|date('r') }}</pubDate>
            <guid>{{ baseUrl }}{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}</guid>
        </item>
        {% endfor %}
    </channel>
</rss>
