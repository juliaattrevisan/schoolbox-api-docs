{#
 # Audience segment selectize items on the create/modify form
 #
 # @param string name
 # @param string entityType
 # @param string modifier
 #}
<div>
    {{ name }}
    <span class="meta">({{ entityType }})</span>
    {% if modifier %}
        <span class="meta">[{{ modifier }}]</span>
    {% endif %}
</div>