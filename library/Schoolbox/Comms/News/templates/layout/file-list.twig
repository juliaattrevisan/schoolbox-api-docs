{##
 # File List
 #
 # A list of files attached to this news article
 # The identifier string is used to segregate one gallery from other galleries
 #
 # In homepages you can have multiple news components showing the same content so one gallery
 # should be quarantined from other galleries
 #
 # @param News\Model $article  An article instance
 # @param string $identifier   A string with namespaces each gallery instance from others
 #}
{% if article.attachedFiles|length %}
<div id="article-attachments">
    <hr />

    {# Images are processed first into their own little lightbox gallery
     # Can probably split these attachedFiles further, but nobody's really sure
     #}
    {% if article.getImages|length %}
        <script>
            $(function() {
                $('[data-image-gallery={{ identifier }}] li').magnificPopup({
                    delegate: 'a',
                    type: 'image',
                    gallery: {
                        enabled:true
                    }
                });
            });
        </script>
        <ul class="img-gallery" data-image-gallery="{{ identifier }}">
            {% for file in article.getImages %}
                <li>
                    <a href="/storage/image.php?hash={{ file.hash }}&size=maxsize" rel="lightbox[{{ identifier }}]" title="{{ file.filename }}">
                        <img src="/storage/image.php?hash={{ file.hash }}&size=square128" title="{{ file.filename }}">
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {# Other filetypes just stashed here, for now
     # Probably need special treatments for audio/video media etc.
     #}
    {% if article.getFiles|length %}
        <script>
            $(function() {
                $('[data-plugin="preview-{{ identifier }}"]').preview();
            });
        </script>
        <ul class="article-files grid small-block-grid-1 medium-block-grid-2">
            {% for currentFile in article.getFiles %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="card attachment small-12">
                            <a data-plugin="preview-{{ identifier }}" href="/storage/fetch.php?hash={{ currentFile.hash }}&name={{ currentFile.basename|url_encode }}" title="{{ currentFile.filename }}">
                                {% if currentFile.mimetype.image %}
                                    <img src="/storage/image.php?hash={{ currentFile.hash }}&size=square64" alt="Download" />
                                {% else %}
                                    <img src="/ajax/mime/{{ currentFile.mime }}" alt="Download" />
                                {% endif %}

                                <p>{{ currentFile.filename }}</p>
                                <p class="meta">{{ currentFile.size|bytes }}</p>
                            </a>
                        </div>
                    </div>
                    <nav>
                        <a href="/storage/fetch.php?hash={{ currentFile.hash }}&save=1&name={{ currentFile.basename|url_encode }}" title="Download" class="icon-download"></a>
                    </nav>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
{% endif %}
