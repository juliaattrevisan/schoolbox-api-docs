{% import '@commsNews/macro/indicator.twig' as indicator %}

<div class="small-12 island">
    {% if article.featureImage.hash %}
        <section class="banner content">
            <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=coverPhoto" alt="" />
        </section>
    {% endif %}

    <section class="article content">
        <div class="title-section">
            <h1>{{ article.title |default("(untitled)") }}</h1>
            {% if modifyRoute or isAuthor %}{{ indicator.render(article) }}{% endif %}
        </div>

        {# TODO this metadata should be in a span tag, but that causes the audience-container to flip out #}
        <div class="meta">
            {# Topics #}
            <span>By <a href="/search/user/{{ article.author.id }}">{{ article.author.fullName }}</a></span>
            <span> &mdash; <time datetime="{{ article.publishAt.database }}" title="{{ article.publishAt.long }}">{{ article.publishAt.relativeDay }}</time></span>
            {% if article.topics|length %}
                <span>in
                        {% for topic in article.topics %}
                            <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </span>
            {% endif %}

            <span id="audience-container" v-if="audienceBricks.length > 0">
                <template v-show="audienceBricks.length" v-for="(audienceBrick, index) in audienceBricks">
                    <span class="pipe meta">
                        <span v-if="audienceBrick.isComposite()" class="meta">
                            <a href="#" title="Click to view audience information" v-if="audienceBrick.isComposite()" @click.prevent="showCompositeInfo(audienceBrick)">${ audienceBrick.nameLabel }</a>
                        </span>

                        {# has to be on one line or you get weird whitespace #}
                        <span v-else class="meta">${ audienceBrick.modifierLabel.length > 0 ? audienceBrick.nameLabel + ' ' + audienceBrick.modifierLabel : audienceBrick.nameLabel }</span>
                    </span>
                </template>

                {# modal #}
                <div data-reveal id="audience-composite" class="reveal-modal">
                    <a class="close-reveal-modal" aria-label="Close">×</a>
                    <p v-if="selectedCompositeBrick.modalData">
                        This portion of the audience consists of users who are in <strong>both</strong> one or more of these
                        <strong>${ selectedCompositeBrick.modalData[0].typeLabel.plural.toLowerCase() }</strong> and one or more of these
                        <strong>${ selectedCompositeBrick.modalData[1].typeLabel.plural.toLowerCase() }</strong>.
                    </p>

                    <hr />

                    <div class="row">
                        <div class="small-12 medium-6 columns no-pad audience-composite-row" v-for="dimensionData in selectedCompositeBrick.modalData">
                            <p><strong>${ dimensionData.typeLabel.plural }</strong></p>

                            <ul>
                                <template v-for="(label, index) in dimensionData.valueLabels">
                                <li>${ label }</li>
                                </template>
                            </ul>
                        </div>
                    </div>
                </div>
            </span>
        </div>
        {{ article.body|purify }}
    </section>
</div>
<div class="small-12 island">
    <section class="comments content">
        <div class="comments-threads">
            <div id="threads-section">
                <div class="row">
                    <div class="small-6 columns">
                        <h2>Comments (11)</h2>
                    </div>
                    <div class="checklist small-6 columns">
                        {% if modifyRoute or isAuthor and article.discussionThread.id %}
                            <input id="allow-comments" name="allowComments" type="checkbox" v-on:click="enableDisableThread" v-model="threadCheckboxEnabled" />
                            <label for="allow-comments">Allow comments</label>
                        {% endif %}
                    </div>
                </div>
                <template v-if="threadEnabled">
                    <template v-if="isPublished">
                        <form action="/" method="post">
                            <label>
                                <textarea id='comment-area' name='comment-area' rows="5"></textarea>
                            </label>
                            <input type="submit" value="Post" />
                        </form>
                    </template>
                    <template v-else>
                        <div data-alert="" class="alert-box">
                            <span class="icon-locked">Comments will be available once this article is published.</span>
                        </div>
                    </template>
                </template>
                <template v-else>
                    <!-- Only show alert if comments are locked -->
                    <div data-alert="" class="alert-box">
                        <span class="icon-locked">Comments are currently disabled for this article.</span>
                    </div>
                </template>
            </div>

            <ul class="information-list social-stream">
                <li class="actions-small-2">
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="#" title="View Profile">
                                <img src="/portrait.php?userId=507&amp;size=square64" alt="Ms Jana Reed">
                            </a>
                            <p><a href="/search/user/25" title="View Profile">Ms Jana Reed</a></p>
                            <p class="meta" title="Friday March 9th 2018 11:22am">Posted 1 year ago</p>
                        </div>
                    </div>
                    <nav>
                        <a href="#" class="icon-delete no-text" title="Delete post"></a>
                        <a href="#" class="icon-reply no-text" title="Add Reply"></a>
                    </nav>
                    <article>
                        <p>My group will be working on the balcony scene for the scene presentation task, what scenes are others doing?</p>
                    </article>

                    <!-- Reply -->
                    <ul class="information-list reply">
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="card small-12">
                                    <a href="/search/user/22" title="View Profile">
                                        <img src="/portrait.php?userId=499&amp;size=square32" alt="Mr Jack Coles">
                                    </a>
                                    <p>
                                        <a href="#" title="View Profile">Mr Jack Coles</a>
                                        <span class="pipe meta" title="Wednesday March 13th 2019 2:42pm">Replied 1 minute ago</span>
                                    </p>
                                </div>
                            </div>
                            <nav>
                                <a class="icon-delete" href="#" title="Delete Comment"></a>
                            </nav>
                            <article>
                                <p>Cosmic ocean trillion Apollonius of Perga great turbulent clouds a still more glorious
                                    dawn awaits tesseract. Jean-François Champollion at the edge of forever Cambrian
                                    explosion courage of our questions gathered by gravity laws of physics.</p>
                            </article>
                        </li>
                    </ul>
                    <!-- Reply -->
                </li>
                <li class="actions-small-2">
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="#" title="View Profile">
                                <img src="/portrait.php?userId=499&amp;size=square64" alt="Mr Jack Coles">
                            </a>
                            <p><a href="#" title="View Profile">Mr Jack Coles</a></p>
                            <p class="meta" title="Wednesday March 13th 2019 2:42pm">Posted 10 seconds ago</p>
                        </div>
                    </div>
                    <nav>
                        <a href="#" class="icon-delete no-text" title="Delete post"></a>
                        <a href="#" class="icon-reply no-text" title="Add Reply"></a>
                    </nav>
                    <article data-body="">
                        <p>How far away a mote of dust suspended in a sunbeam a mote of dust suspended in a sunbeam across the centuries gathered by gravity?</p>
                    </article>
                </li>
            </ul>
            <a href="#" class="button expand" title="Load more">Load more</a>
        </div>
    </section>
</div>
<div id='toaster' class="toast" data-toast></div>

<script src="/javascript/components/schoolbox-vue.min.js"></script>

{% autoescape 'js' %}
<script>

    var postHeaders = {
        'X-Requested-With' : 'XMLHttpRequest'
    };

    var app = new Vue({
        el: '#threads-section',
        delimiters: ['${', '}'],
        data: {
            threadCheckboxEnabled: '{{ (article.discussionThread.open) ? 'checked' : '' }}',
            threadEnabled: Boolean({{ article.discussionThread.open }}),
            isPublished: Boolean({{ article.isPublic }})
        },
        // define methods under the `methods` object
        methods: {
            enableDisableThread: function (event) {
                this.$data.threadEnabled = event.target.checked;

                var $toast = $('#toaster');
                $toast.toastActivate({text: 'Saving...'});

                axios.put('/threads/'+ {{ article.discussionThread.id }} +'/status', {threadEnabled: this.$data.threadEnabled}, { headers: postHeaders }).then(function () {
                    $toast.toastTimeout({text: 'Saved', duration: 2000});
                }).catch(function (error) {
                    console.log(error);
                    $toast.toastTimeout({text: 'Unable to save', duration: 2000, css: 'alert'});
                });
            }
        }
    })
</script>
{% endautoescape %}
