{% import '@commsNews/macro/indicator.twig' as indicator %}

<div class="small-12 island">
    {% if article.featureImage.hash %}
        <section class="banner content">
            <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=coverPhoto" alt="" />
        </section>
    {% endif %}

    <section class="detail content">
        <div class="title-section">
            <h1>{{ article.title |default("(untitled)") }}</h1>
            {% if modifyRoute or isAuthor %}{{ indicator.render(article) }}{% endif %}
        </div>

        {# TODO this metadata should be in a span tag, but that causes the audience-container to flip out #}
        <div class="meta">
            {# Topics #}
            <span>By <a href="/search/user/{{ article.author.id }}">{{ article.author.fullName }}</a></span>
            <span> &mdash; <time datetime="{{ article.publishAt.database }}" title="{{ article.publishAt.long }}">{{ article.publishAt.relativeDay }}</time></span>
            {% if article.topics|length %}
                <span>in
                        {% for topic in article.topics %}
                            <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </span>
            {% endif %}

            <span id="audience-container" v-if="audienceBricks.length > 0">
                <template v-show="audienceBricks.length" v-for="(audienceBrick, index) in audienceBricks">
                    <span class="pipe meta">
                        <span v-if="audienceBrick.isComposite()" class="meta">
                            <a href="#" title="Click to view audience information" v-if="audienceBrick.isComposite()" @click.prevent="showCompositeInfo(audienceBrick)">${ audienceBrick.nameLabel }</a>
                        </span>
                        <span v-else-if="brickHref(audienceBrick)"><a :href="brickHref(audienceBrick)">${ brickName(audienceBrick) }</a></span>
                        <span v-else>${ brickName(audienceBrick) }</span> {#- Dessicate -#}
                    </span>
                </template>

                {# modal #}
                <div data-reveal id="audience-composite" class="reveal-modal">
                    <a class="close-reveal-modal" aria-label="Close">×</a>
                    <p v-if="selectedCompositeBrick.modalData">
                        This portion of the audience consists of users who are in <strong>both</strong> one or more of these
                        <strong>${ selectedCompositeBrick.modalData[0].typeLabel.plural.toLowerCase() }</strong> and one or more of these
                        <strong>${ selectedCompositeBrick.modalData[1].typeLabel.plural.toLowerCase() }</strong>.
                    </p>

                    <hr />

                    <div class="row">
                        <div class="small-12 medium-6 columns no-pad audience-composite-row" v-for="dimensionData in selectedCompositeBrick.modalData">
                            <p><strong>${ dimensionData.typeLabel.plural }</strong></p>

                            <ul>
                                <template v-for="(label, index) in dimensionData.valueLabels">
                                <li>${ label }</li>
                                </template>
                            </ul>
                        </div>
                    </div>
                </div>
            </span>
        </div>
        <article>
            {{ article.body|purify }}
        </article>
    </section>
</div>

{% if commentsIsEnabled %}

<div class="small-12 island" id="discussion">
    <section class="discussion content" id="threads-section" v-if="showCommentsSection">
        <div class="discussion-threads">
            <div class="row">
                <div class="small-6 columns">
                    <h2>Comments <span v-if="showCommentsCount">(${ totalCommentsCount })</span></h2>
                </div>
                <div class="checklist small-6 columns" v-if="threadCheckboxVisible">
                    <input id="allow-comments" name="allowComments" type="checkbox" @click="changeThreadStatus" v-model="threadCheckboxEnabled" />
                    <label for="allow-comments">Allow comments</label>
                </div>
            </div>
            <template v-if="threadEnabled">
                <template v-if="isPublished">
                    <form>
                        <label>
                            <textarea id="comment" name="comment" rows="5" v-model="comment" required></textarea>
                        </label>
                        <a class="button submit" @click="postComment" :disabled="! postCommentButtonIsEnabled || comment.trim() === ''">Post Comment</a>
                    </form>
                </template>
                <template v-else>
                    <div data-alert="" class="alert-box">
                        <span class="icon-locked">Comments will be available once this article is published.</span>
                    </div>
                </template>
            </template>
            <template v-else>
                <!-- Only show alert if comments are locked -->
                <div data-alert="" class="alert-box">
                    <span class="icon-locked">Comments are currently disabled for this article.</span>
                </div>
            </template>

            <ul class="information-list social-stream">
                <li class="actions-small-2" v-for="(comment, index) in comments">
                    <div class="list-item">
                        <div class="card small-12">
                            <a :href="'/search/user/' + comment.author.id" title="View Profile">
                                <img :src="'/portrait.php?userId=' + comment.author.externalId + '&size=square64'"></a>
                            <p>
                                <a :href="'/search/user/' + comment.author.id" title="View Profile">
                                    ${ comment.author.title + ' ' + comment.author.firstname + ' ' + comment.author.lastname }
                                </a>
                            </p>
                            <p class="meta" :title="comment.createdAt | fullString ">Posted ${ comment.createdAt | fromNow }</p>
                        </div>
                    </div>
                    <nav>
                        <a href="#" class="icon-delete no-text" data-reveal-id="confirm-delete" title="Delete comment" v-if="comment._links.delete.auth" v-on:click="deleteComment(comment.id, index)"></a>
                        {#<a href="#" class="icon-reply no-text" title="Add Reply"></a>#}
                    </nav>

                    <article v-html="comment.content"></article>
                </li>
                <li class="actions-small-1" v-if="showSkeletonLoader" v-for="n in 3">
                    <div class="list-item">
                        <div class="small-12 card skeleton">
                            <div class="img"></div>
                            <h3></h3>
                            <p class="meta"></p>
                        </div>
                    </div>
                </li>
            </ul>
            <a @click="getThread" v-if="showLoadMoreButton" class="button expand" :disabled="! loadMoreIsEnabled">Show older comments</a>
            <div id='confirm-delete' class="reveal-modal" data-reveal title="Delete Comment">
                <h2>Please Confirm</h2>
                <p>Are you sure you want to delete this comment?</p>

                <ul class="flex-list buttons">
                    <li><a v-on:click="deleteComment(commentIdToDelete, commentIndexToDelete, true)" class="button icon-approve submit" :disabled="! confirmDeleteButton">OK</a></li>
                    <li><a v-on:click="closeModal" class="button icon-close" :disabled="! cancelDeleteButton">Cancel</a></li>
                </ul>
            </div>
        </div>
    </section>
</div>
<div id='toaster' class="toast" data-toast></div>

<script src="/javascript/ckeditor/ckeditor.js"></script>
<script src="/javascript/shared/editor/jquery.editor.js"></script>

<script src="/javascript/components/schoolbox-vue.min.js"></script>

{% autoescape 'js' %}
<script>
    var postHeaders = {
        'X-Requested-With' : 'XMLHttpRequest',
    };

    var $toast = $('#toaster');

    var app = new Vue({
        el: '#threads-section',
        delimiters: ['${', '}'],
        data: {
            articleId: Number({{ article.id }}),
            threadId: Number({{ article.discussionThread.id }}),
            threadCheckboxVisible: Boolean({{ modifyRoute or isAuthor }}),
            threadCheckboxEnabled: Boolean({{ article.discussionThread.open }}),
            threadEnabled: Boolean({{ article.discussionThread.open }}),
            isPublished: Boolean({{ article.isPublic }}),
            comments: [],
            commentsOriginal: [], // Will contain the unmodified content of comments. In preparation for comment update.
            showCommentsCount: false,
            totalCommentsCount: 0,
            cursorNext: '',
            loadMoreIsEnabled: false,
            errorLoadingCommentsText: 'Unable to load comments',
            savingText: 'Saving...',
            savedText: 'Saved',
            unableToSaveText: 'Unable to save',
            showSkeletonLoader: true,
            showLoadMoreButton: false,
            deletingCommentText: 'Deleting comment...',
            commentDeletedText: 'Comment deleted',
            errorDeletingCommentText: 'Unable to delete comment',
            commentIdToDelete: undefined,
            commentIndexToDelete: undefined,
            confirmDeleteButton: true,
            cancelDeleteButton: true,
            comment: '',
            postingCommentText: 'Posting comment...',
            commentHasBeenAddedText: 'Comment has been added',
            errorAddingCommentText: 'Unable to post comment',
            postCommentButtonIsEnabled: true,
            createThreadEndpoint: "{{ routeLookup('commsDiscussionThreads.createThread', {contextId: article.id}) }}",
            showCommentsSection: false,
            initialLoad: true,
        },
        // define methods under the `methods` object
        methods: {
            changeThreadStatus: function (event) {
                var self = this;
                self.threadEnabled = event.target.checked;

                var changeThreadStatusAction;
                if (self.threadId) {
                    // I already have a thread ID: switch it on/off
                    changeThreadStatusAction = new Promise(function(resolve, reject) {
                        // TODO don't construct this endpoint manually
                        var changeThreadStatusEndpoint = '/discussion/comms/' + String(self.articleId) + '/threads/' + String(self.threadId) + '/';

                        if (self.threadEnabled) {
                            changeThreadStatusEndpoint += 'open';
                        } else {
                            changeThreadStatusEndpoint += 'close';
                        }

                        axios.put(changeThreadStatusEndpoint, {}, { headers: postHeaders }).then(function () {
                            resolve();
                        }).catch(function (error) {
                            reject(error);
                        });
                    });
                } else {
                    // No thread ID.
                    // 1: create a new thread
                    // 2: associate it with this context
                    // 3: set this object's thread ID
                    changeThreadStatusAction = new Promise(function(resolve, reject) {
                        axios
                            .post(self.createThreadEndpoint, { open: self.threadEnabled }, { headers: postHeaders })
                            .then(function (response) {
                                self.threadId = response.data.id;
                                resolve();
                            })
                            .catch(function () {
                                reject(error);
                            });
                    });
                }


                // Actually run the promise, setting the toast accordingly
                $toast.toastActivate({text: self.savingText});
                changeThreadStatusAction
                    .then(function () {
                        self.loadCkEditor();
                        $toast.toastTimeout({text: self.savedText, duration: 2000});
                    })
                    .catch(function (error) {
                        $toast.toastTimeout({text: self.unableToSaveText, duration: 2000, css: 'alert'});
                    });
            },
            getThread: function() {
                var self = this;

                // Short-circuit if no thread ID
                if (!self.threadId) {
                    self.showSkeletonLoader = false;
                    self.loadMoreIsEnabled = false;
                    self.showCommentsCount = true;
                    self.showCommentsSection = self.threadCheckboxVisible;
                    return;
                }

                self.loadMoreIsEnabled = false;
                self.showSkeletonLoader = true;

                // TODO don't construct this endpoint manually
                axios.get('/discussion/comms/' + String(self.articleId) + '/threads/' + String(self.threadId) + '/comments/', {
                    params: {
                        cursor: self.cursorNext
                    }
                }).then(function (response) {

                    var responseData = response.data;
                    var index;

                    self.totalCommentsCount = responseData.metadata.count;
                    self.cursorNext = responseData.metadata.cursor.next;

                    for (index = 0; index < responseData.data.length; index++) {
                        self.comments.push(responseData.data[index]);
                        self.commentsOriginal.push(responseData.data[index].content);
                    }

                    // Hide skeleton loader once the request is done
                    self.showSkeletonLoader = false;
                    // Enable back load more button once the request is done
                    self.loadMoreIsEnabled = true;
                    // Make comments count visible when the request is done
                    self.showCommentsCount = true;

                    /**
                     * TODO: Maybe the API should return a metadata that will let the front-end know if there's still
                     * a next page to render rather than comparing the value of the length of array and the comment's total count?
                     *
                     * Do not show load more button when all the comments has been loaded
                     */
                    self.showLoadMoreButton = self.comments.length < responseData.metadata.count;

                    /**
                     * If the user have the rights to modify the thread, despite that there's comments, comments section
                     * must be rendered
                     */
                    self.showCommentsSection = (self.threadCheckboxVisible || self.totalCommentsCount > 0 || self.threadEnabled);

                }).catch(function (error) {
                    self.showSkeletonLoader = false;
                    self.showCommentsCount = true;
                    self.loadMoreIsEnabled = true;
                    $toast.toastActivate({text: self.errorLoadingCommentsText});
                    $toast.toastTimeout({text: self.errorLoadingCommentsText, duration: 2000, css: 'alert'});
                }).finally(function () {
                    /**
                     * Since schoolbox.min.js is being executed first before VueJS content gets rendered,
                     * the schoolboxResource_ProxyReplacement is unable to locate the DOM yet.
                     * With that for a quick fix, we need to read the DOM when the contents has been loaded and let
                     * schoolboxResource_ProxyReplacement do what it's supposed to do.
                     */
                    self.reInitialiseMediaPlayer();

                    if (self.initialLoad) {
                        self.loadCkEditor();

                        // Anchored? go to the element once the component has been loaded
                        // We will need to do this for now to make the anchor behaviour more consistent
                        if (window.location.hash == '#discussion')
                        {
                            var offset = $('.banner.content').outerHeight() + $('.article.content').outerHeight() + $('.news-article').offset().top;
                            $("html, body").animate({ scrollTop: offset }, 500);
                        }

                        self.initialLoad = false;
                    }
                });
            },
            deleteComment: function(id, index, confirmed) {
                var self = this;

                self.commentIdToDelete = id;
                self.commentIndexToDelete = index;

                // If the user has agreed to delete the comment...
                if (confirmed) {
                    // Disable 'OK' and 'CANCEL' button from the delete confirmation modal temporarily while the delete request is being processed
                    // 'CANCEL' button will be disabled while the request is being processed so that, the users won't have a wrong understanding that they can still cancel the request
                    self.confirmDeleteButton = false;
                    self.cancelDeleteButton = false;

                    $toast.toastActivate({text: self.deletingCommentText});

                    // TODO don't construct this endpoint manually
                    axios.delete('/discussion/comms/' + String(self.articleId) + '/comments/' + self.commentIdToDelete, {}, { headers: postHeaders }).then(function () {
                        self.comments.splice(self.commentIndexToDelete, 1);

                        // On successful delete, reduce the total comments count in the UI without hitting the backend
                        self.totalCommentsCount--;

                        // Bring 'OK' and 'CANCEL' button from the delete confirmation modal back to it's original state
                        self.confirmDeleteButton = true;
                        self.cancelDeleteButton = true;

                        $toast.toastTimeout({text: self.commentDeletedText, duration: 2000});

                        // Automatically trigger show previous comments to show the next set of records when the list has gone down to 0
                        if (self.comments.length < 1 && self.totalCommentsCount > 0) {
                            self.getThread();
                        }

                        setTimeout(function() {
                            $.fn.schoolboxResource_InitialiseMediaElementPlayer($('#threads-section'));
                        }, 300);

                        self.closeModal();
                    }).catch(function (error) {
                        self.confirmDeleteButton = true;
                        self.cancelDeleteButton = true;

                        $toast.toastTimeout({text: self.errorDeletingCommentText, duration: 2000, css: 'alert'});
                    });
                }
            },
            closeModal: function() {
                $('#confirm-delete').foundation('reveal', 'close');
            },
            postComment: function() {
                var self = this;

                if (self.comment !== '') {
                    $toast.toastActivate({text: self.postingCommentText});

                    self.postCommentButtonIsEnabled = false;

                    // TODO don't construct this endpoint manually
                    axios.post('/discussion/comms/' + String(self.articleId) + '/threads/' + self.threadId + '/comments', {
                        content: self.comment
                    }).then(function (response) {

                        var responseData = response.data;
                        // Add the latest comment into the top of array
                        self.comments.splice(0,0, responseData);
                        self.commentsOriginal.splice(0,0, responseData.content);

                        // On successful comment posting, add one into the total comments count in the UI without hitting the backend
                        self.totalCommentsCount++;

                        $toast.toastTimeout({text: self.commentHasBeenAddedText, duration: 2000});

                        // Bring post comment components back to their original states and reset CKEditor content on successful request
                        self.postCommentButtonIsEnabled = true;
                        self.comment = '';
                        CKEDITOR.instances['comment'].setData(self.comment);

                    }).catch(function (error) {
                        self.postCommentButtonIsEnabled = true;
                        $toast.toastTimeout({text: self.errorAddingCommentText, duration: 2000, css: 'alert'});
                    }).finally(function () {
                        self.reInitialiseMediaPlayer();
                    });
                }
            },
            loadCkEditor: function () {
                var self = this;

                if (this.threadEnabled) {
                    $.fn.alaressEditor({
                        targetElements: $('#comment'),
                        removePlugins: 'uploadimage,link,schoolboxanchor',
                        removeButtons: 'Subscript,Superscript,RemoveFormat,Table,HorizontalRule,SpecialChar,EqnEditor,Embed',
                        toolbarGroups: [
                            {name: 'basicstyles', groups: ['basicstyles', 'cleanup']},
                            {name: 'paragraph', groups: ['list', 'blocks', 'bidi']},
                            {name: 'links', groups: ['links']},
                            {name: 'insert', groups: ['insert']},
                            /* Custom schoolbox-specific plugin stuff can go here
                             * This is a hole into which you may put once-off abilities
                             * for the ckeditor (such as Make Blank, in Quiz/Fillgap)
                             * This is typically not used for anything else for now
                             */
                            {name: 'schoolbox', groups: ['schoolboxlink']},
                        ],
                        on: {
                            change: function (evt) {
                                // Bind the content of ckeditor into the comment model on change
                                self.comment = CKEDITOR.instances['comment'].getData();
                            }
                        }
                    });
                }
            },
            reInitialiseMediaPlayer: function () {
                var self = this;

                Object.keys(self.comments).forEach(function(key) {
                    var content = $('<div>' + self.comments[key].content + '</div>');
                    var replaced = false;

                    $(content).each(function (index, element) {
                        replaced = $.fn.schoolboxResource_ReplaceAll($(element));

                        // Before we render the elements into the front-end, let's try to update the Vue comments model
                        // first so that we can easily initialise mediaelementplayer().
                        // And only update those models who's data has been updated.
                        // Basically those elements that has a videos/audios.
                        if (replaced) {
                            self.comments[key].content = $(element).html();
                        }
                    });
                });

                // Need to add this here. Not really sure why this doesn't get executed when setTimeout is not present...
                setTimeout(function() {
                    $.fn.schoolboxResource_InitialiseMediaElementPlayer('#threads-section');
                }, 100);
            }
        },
        mounted: function() {
            this.getThread();
        },
        filters: {
            fromNow: function (date) {
                return moment(date.database).fromNow();
            },
            fullString: function (date) {
                return moment(date.database).format(dateDisplayFormats.momentJsDatetime);
            }
        }
    });
</script>
{% endautoescape %}

{% endif %}
