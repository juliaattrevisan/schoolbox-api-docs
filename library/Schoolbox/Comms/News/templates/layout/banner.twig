{% import '@commsNews/macro/indicator.twig' as indicator %}
<div class="small-12 island">
    {% if article.featureImage %}
        <section class="banner content">
            <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=coverPhoto" alt="" />
        </section>
    {% endif %}

    <section class="detail content">
        <div class="title-section">
            <h1>{{ article.title |default("(untitled)") }}</h1>
            {% if modifyRoute or isAuthor %}{{ indicator.render(article) }}{% endif %}
        </div>

        {% if routeLookupIfAuthorized('immersiveReader.getTokenAndSubdomain') %}
            <script src="{{ CDN_PREFIX }}/js/immersive-reader/jquery.immersive-reader.js?v={{ config.site_version }}" type="text/javascript"></script>
            <script type="text/javascript">
                $(function () {
                    $('[data-immersive-reader]').immersiveReader({title: '{{ article.title | escape('js') }}' });
                });
            </script>
            <div class='immersive-reader-button' id="ir-button" data-immersive-reader="button"></div>
        {% endif %}

        {# TODO this metadata should be in a span tag, but that causes the audience-container to flip out #}
        <div class="meta">
            {# Topics #}
            <span>By
                {% if article.author.isDeleted %}
                    {{ article.author.fullName }}
                {% else %}
                    <a href="/search/user/{{ article.author.id }}">{{ article.author.fullName }}</a>
                {% endif %}
            </span>
            <span> &mdash; <time datetime="{{ article.publishAt.database }}" title="{{ article.publishAt.long }}">{{ article.publishAt.relativeDay }}</time></span>
            {% if article.topics|length %}
                <span>in
                    {% for topic in article.topics %}
                        <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </span>
            {% endif %}

            <script src="{{ CDN_PREFIX }}/js/comms/audience-bricks.js?v={{ config.site_version }}"></script>
            {% autoescape 'js' %}
            <script>
                /**
                * Encapsulates information about a type of audience, eg 'folder' or 'campus'
                *
                * @param {string}  entityType
                * @param {string}  name
                * @param {string}  namePlural
                * @constructor
                */
                const AudienceOption = function(entityType, name, namePlural){
                    this.entityType     = entityType;
                    this.name           = name;
                    this.namePlural     = namePlural;
                };

                /** @var {AudienceOption[]|Object} audienceOptions */
                const audienceOptions = {};
                {% for entityType in availableEntityTypes | filter(entityType => entityTypesData[entityType] is defined)  %}
                {% set data = entityTypesData[entityType] %}
                {% if data %}
                audienceOptions['{{ entityType }}'] = new AudienceOption(
                    '{{ entityType }}',
                    '{{ data.name }}',
                    '{{ data.namePlural | raw }}'
                );
                {% endif %}
                {% endfor %}

                // Bricks need to render various human-friendly labels, so inject the entityType labels
                // into the BrickManager so it can supply it to Bricks that it creates.
                const entityTypeLabelMap = {
                    composite: { // -_-
                        singular: 'Composite Audience',
                        plural: 'Composite Audience'
                    }
                };
                for (let entityType in audienceOptions) {
                    entityTypeLabelMap[entityType] = {
                        singular: audienceOptions[entityType].name,
                        plural: audienceOptions[entityType].namePlural
                    };
                }

                //these two will be referenced within library/Schoolbox/Comms/News/vue/news-item-audience-info.vue
                const audienceSegments = {{ encodedSegments|json_encode|raw }};
                const codec = new Codec();

            </script>
            {% endautoescape %}
            <span id="audience-info-container">
                <news-item-audience-info />
            </span>
            <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/newsItemAudienceInfo.js?v={{ config.site_version }}"></script>
        </div>

        <article>
            {{ article.body|purify }}
        </article>

        {% include ('@commsNews/layout/file-list.twig') with {
            article: article,
            identifier: 'article-' ~ article.id
        } %}
    </section>
</div>

{% if commentsIsEnabled %}

<div class="small-12 island" id="discussion">
    <section id="threads-section">
        <article-threads
            cdn-prefix="{{ CDN_PREFIX }}"
            :article-id="{{ article.id }}"
            :thread-id-on-load="{{ article.discussionThread ? article.discussionThread.id : 0 }}"
            :is-thread-checkbox-visible-on-load="Boolean({{ modifyRoute or isAuthor }})"
            :is-thread-checkbox-enabled-on-load="Boolean({{ article.discussionThread ? article.discussionThread.open : 'false' }})"
            :is-thread-enabled-on-load="Boolean({{ article.discussionThread ? article.discussionThread.open : 'false' }})"
            :is-published="Boolean({{ article.isPublic }})"
            :create-thread-endpoint="'{{ routeLookup('commsDiscussionThreads.createThread', { contextId: article.id } ) }}'"
            :site-version="'{{ config.site_version }}'"
        />
    </section>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/articleThreads.js?v={{ config.site_version }}"></script>

{% endif %}
