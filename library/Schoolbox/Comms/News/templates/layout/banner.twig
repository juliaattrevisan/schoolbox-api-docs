{% import '@commsNews/macro/indicator.twig' as indicator %}

<div class="small-12 island">
    {% if article.featureImage.hash %}
        <section class="banner content">
            <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=coverPhoto" alt="" />
        </section>
    {% endif %}

    <section class="article content">
        <div class="title-section">
            <h1>{{ article.title |default("(untitled)") }}</h1>
            {% if modifyRoute or isAuthor %}{{ indicator.render(article) }}{% endif %}
        </div>

        {# TODO this metadata should be in a span tag, but that causes the audience-container to flip out #}
        <div class="meta">
            {# Topics #}
            <span>By <a href="/search/user/{{ article.author.id }}">{{ article.author.fullName }}</a></span>
            <span> &mdash; <time datetime="{{ article.publishAt.database }}" title="{{ article.publishAt.long }}">{{ article.publishAt.relativeDay }}</time></span>
            {% if article.topics|length %}
                <span>in
                        {% for topic in article.topics %}
                            <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </span>
            {% endif %}

            <span id="audience-container" v-if="audienceBricks.length > 0">
                <template v-show="audienceBricks.length" v-for="(audienceBrick, index) in audienceBricks">
                    <span class="pipe meta">
                        <span v-if="audienceBrick.isComposite()" class="meta">
                            <a href="#" title="Click to view audience information" v-if="audienceBrick.isComposite()" @click.prevent="showCompositeInfo(audienceBrick)">${ audienceBrick.nameLabel }</a>
                        </span>

                        {# has to be on one line or you get weird whitespace #}
                        <span v-else class="meta">${ audienceBrick.modifierLabel.length > 0 ? audienceBrick.nameLabel + ' ' + audienceBrick.modifierLabel : audienceBrick.nameLabel }</span>
                    </span>
                </template>

                {# modal #}
                <div data-reveal id="audience-composite" class="reveal-modal">
                    <a class="close-reveal-modal" aria-label="Close">×</a>
                    <p v-if="selectedCompositeBrick.modalData">
                        This portion of the audience consists of users who are in <strong>both</strong> one or more of these
                        <strong>${ selectedCompositeBrick.modalData[0].typeLabel.plural.toLowerCase() }</strong> and one or more of these
                        <strong>${ selectedCompositeBrick.modalData[1].typeLabel.plural.toLowerCase() }</strong>.
                    </p>

                    <hr />

                    <div class="row">
                        <div class="small-12 medium-6 columns no-pad audience-composite-row" v-for="dimensionData in selectedCompositeBrick.modalData">
                            <p><strong>${ dimensionData.typeLabel.plural }</strong></p>

                            <ul>
                                <template v-for="(label, index) in dimensionData.valueLabels">
                                <li>${ label }</li>
                                </template>
                            </ul>
                        </div>
                    </div>
                </div>
            </span>
        </div>
        {{ article.body|purify }}
    </section>
</div>
<div class="small-12 island">
    <section class="discussion content">
        <div class="discussion-threads">
        <div id="threads-section">
            <div class="row">
                <div class="small-6 columns">
                    <h2 v-if="showCommentsCount">Comments (${ totalCommentsCount })</h2>
                </div>
                <div class="checklist small-6 columns">
                    {% if modifyRoute or isAuthor and article.discussionThread.id %}
                        <input id="allow-comments" name="allowComments" type="checkbox" @click="enableDisableThread" v-model="threadCheckboxEnabled" />
                        <label for="allow-comments">Allow comments</label>
                    {% endif %}
                </div>
            </div>
            <template v-if="threadEnabled">
                <template v-if="isPublished">
                    <form action="/" method="post">
                        <label>
                            <textarea id='comment-area' name='comment-area' rows="5"></textarea>
                        </label>
                        <input type="submit" value="Post" />
                    </form>
                </template>
                <template v-else>
                    <div data-alert="" class="alert-box">
                        <span class="icon-locked">Comments will be available once this article is published.</span>
                    </div>
                </template>
            </template>
            <template v-else>
                <!-- Only show alert if comments are locked -->
                <div data-alert="" class="alert-box">
                    <span class="icon-locked">Comments are currently disabled for this article.</span>
                </div>
            </template>

            <ul class="information-list social-stream">
                <li class="actions-small-2" v-for="post in posts">
                    <div class="list-item">
                        <div class="card small-12">
                            <a :href="'/search/user/' + post.author.id" title="View Profile">
                                <img :src="'/portrait.php?userId=' + post.author.externalId + '&size=square64'"></a>
                            <p>
                                <a :href="'/search/user/' + post.author.id" title="View Profile">
                                    ${ post.author.title + ' ' + post.author.firstname + ' ' + post.author.lastname }
                                </a>
                            </p>
                            <p class="meta" :title="post.createdAt | fullString ">Posted ${ post.createdAt | fromNow }</p>
                        </div>
                    </div>
                    <nav>
                        {#<a href="#" class="icon-delete no-text" title="Delete post" v-if="post._links.delete.auth"></a>#}
                        {#<a href="#" class="icon-reply no-text" title="Add Reply"></a>#}
                    </nav>

                    <article>
                        <p v-html="post.content"></p>
                    </article>

                </li>
                <li class="actions-small-1" v-if="commentsLoading" v-for="n in 3">
                    <div class="list-item">
                        <div class="small-12 card skeleton">
                            <div class="img"></div>
                            <h3></h3>
                            <p class="meta"></p>
                        </div>
                    </div>
                </li>
            </ul>
            <a @click="getThread" v-if="showLoadMoreButton" class="button expand" :disabled="loadMoreIsDisabled">Load More</a>
        </div>
        </div>
    </section>
</div>
<div id='toaster' class="toast" data-toast></div>

<script src="/javascript/components/schoolbox-vue.min.js"></script>

{% autoescape 'js' %}
<script>
    
    var postHeaders = {
        'X-Requested-With' : 'XMLHttpRequest',
    };

    var $toast = $('#toaster');

    var app = new Vue({
        el: '#threads-section',
        delimiters: ['${', '}'],
        data: {
            threadCheckboxEnabled: Boolean({{ article.discussionThread.open }}),
            threadEnabled: Boolean({{ article.discussionThread.open }}),
            isPublished: Boolean({{ article.isPublic }}),
            posts: [],
            showCommentsCount: false,
            totalCommentsCount: 0,
            cursorNext: '',
            loadMoreIsDisabled: false,
            loadingCommentsText: 'Loading comments...',
            commentsLoadedText: 'Comments loaded',
            errorLoadingCommentsText: 'Unable to load comments',
            savingText: 'Saving...',
            savedText: 'Saved',
            unableToSaveText: 'Unable to save',
            commentsLoading: true,
            showLoadMoreButton: true,
        },
        // define methods under the `methods` object
        methods: {
            enableDisableThread: function (event) {
                var self = this;

                self.threadEnabled = event.target.checked;

                $toast.toastActivate({text: self.savingText});

                axios.put('/threads/'+ {{ article.discussionThread.id }} +'/status', {threadEnabled: self.threadEnabled}, { headers: postHeaders }).then(function () {
                    $toast.toastTimeout({text: self.savedText, duration: 2000});
                }).catch(function (error) {
                    $toast.toastTimeout({text: self.unableToSaveText, duration: 2000, css: 'alert'});
                });
            },
            getThread: function() {
                var self = this;

                self.loadMoreIsDisabled = true;
                self.commentsLoading = true;

                $toast.toastActivate({text: self.loadingCommentsText});

                axios.get('/threads/' + {{ article.discussionThread.id }} + '/posts/', {
                    params: {
                        cursor: self.cursorNext
                    }
                }).then(function (response) {

                    var responseData = response.data;
                    var index;

                    self.commentsLoading = false;
                    self.totalCommentsCount = responseData.metadata.count;
                    self.cursorNext = responseData.metadata.cursor.next;

                    for (index = 0; index < responseData.data.length; index++) {
                        self.posts.push(responseData.data[index]);
                    }

                    self.loadMoreIsDisabled = false;
                    self.showCommentsCount = true;

                    if (self.posts.length === responseData.metadata.count) {
                        self.showLoadMoreButton = false;
                    }

                    $toast.toastTimeout({text: self.commentsLoadedText, duration: 2000});
                }).catch(function (error) {
                    $toast.toastTimeout({text: self.errorLoadingCommentsText, duration: 2000, css: 'alert'});
                });
            }
        },
        mounted: function() {
            this.getThread();
        },
        filters: {
            fromNow(date) {
                return moment(date.database).fromNow();
            },
            fullString(date) {
                return moment(date.database).format(dateDisplayFormats.momentJsDatetime);
            }
        }
    })
</script>
{% endautoescape %}
