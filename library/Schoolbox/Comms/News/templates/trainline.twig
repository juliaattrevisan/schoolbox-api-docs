{##
 # Trainline
 #
 # Build a set of stops on the trainline with parameterised options so you can change the
 # behaviour and appearance on a per-stop basis. Requires a set of Nodes to function.
 #
 # Arguments:
 # node: an array of Node elements
 #
 # Node Specification
 #
 # {
 #     identifier: a string like a const that says this should be the currently-highlighted stop.
 #     icon: the icon to display; if null, the node displays as a nub, otherwise a knurl.
 #     url: the url to visit when the node is clicked; if empty, clicking does nothing
 #     alt: title text that appears on pointer hover over a node.
 #     label: the text that displays under a node
 # }
 #
 # Glossary
 #
 # Node: a stop on the train line which displays as either a Nub or a Knurl.
 # Knurl: a large icon dot with an icon in it (the typical appearance)
 # Nub: a small icon-less dot (a more streamlined appearance)
 #}
{% if nodes|length %}
<ul class="train-line">
    {% for node in nodes %}
        {% if node is not null %}
            {% if node.identifier == identifier %}
                {% set css = 'current-stop' %}
            {% else %}
                {% set css = '' %}
            {% endif %}

            {# Decide whether to use a nub or a knurl #}
            {% if not node.icon|length %}
                {% set nubClass = 'nub' %}
            {% else %}
                {% set nubClass = '' %}
            {% endif %}

            <li class="{{ css }} {{ nubClass }}">
                <a {% if node.url is not null %}href="{{ node.url }}"{% endif %} title="{{ node.alt }}">
                    <span class="{{ node.icon }}"></span>{{ node.label }}
                </a>
            </li>
        {% endif %}
    {% endfor %}
</ul>
{% endif %}