{#
 # News article list component, with topic tabs and pagination
 # This can become a single file Vue component once we have a bundler
 #
 # Core and querystring params
 # @param int $componentInstanceId     The primary key for this component instance
 # @param string $queryStringPage      The string to use for page number param name in the URL
 # @param string $queryStringReferrer  The string to use for referrer param name in the URL
 # @param string $queryStringTopic     The string to use for topic param name in the URL
 #
 # Topics
 # @param string $topicAll             The topic slug for the 'all' tab
 # @param string|null $topic           The topic slug to load, as chosen by the user
 # @param bool $showTopicByDefault     If true, preselects the first topic tab if a topic wasn't chosen by user
 # @param bool $changeTabOnMeta        On click of a topic in a news card meta- whether to change tab on the current page or not
 #
 # Pagination
 # @param int|null $initialPage        The page number to load by default
 # @param int $limit                   Number of items to display per page
 # @param bool $disablePagination      If true, the pagination palette doesn't render
 #
 # Referrers and Redirects
 # @param bool $modifyWindowState      If true, push changes to the window state to simulate browser history
 # @param string $referrer             Referrer string for stats logging
 # @param string $returnUrl            Return to this location after submitting forms etc
 #
 # Layout
 # @param string $compactMode          Bool for compactMode layout (removes the blurb from the news card)
 # @param bool $showMore               If true, enables the Show More link under articles
 # @param string|null $itemLayout      A string corresponding to which Item Layout was chosen in component config
 # @param string|null $fallbackImage   A string corresponding to which Fallback Image was chosen in component config
 #}

{% if not initialPage %}
    {% set initialPage = 1 %}
{% endif %}

{# page: The active page on the pagination
 #
 # articlesLoading: Whether the articles are still being loaded or not
 # Used to show the placeholder loader
 #
 # topics: A unique list of topics built from the article json
 # Used to display tab options
 #
 # allArticles: *All* the author's articles
 #
 # filteredArticles: A container for a filtered list of authored articles
 # Will be populated as all articles on load
 #
 # getArticlesRoute: Route for retrieving all the articles
 #
 # getSavedArticlesRoute: Route for retrieving all the articles
 #
 # getIndexRoute: Route for news feed page
 #
 # configSaveForLater: Config for whether save for later is enabled
 #
 # configSearchTypeLimit: Config that's used for number of items per page
 #
 # localeNewsPlural: Localisation of news
 #
 # queryStringPage, queryStringReferrer, queryStringTopic: Strings to use for params in the URL
 #
 # topicAll: Object for the 'all' tab
 #
 # tabSelected: If topic has come from the controller- use that to set default tab selected
 #
 # referrer: Referrer for stats logging
 #
 # changeTabOnMeta: Controls whether clicking on a topic in a news card meta will just change tab on the current screen,
 # or link off to the news feed page
 #
 # initialPage: The initial page the user started on, used for history API
 #
 # initialTopic: The initial topic a user started on, has to be set dynamically below after component has mounted
 #
 # modifyWindowState: Controls whether this will modify the window state at all (going to disable this on dashboard component)
 #
 # compactMode: Removes the blurb
 #
 # disablePagination: Disables the pagination and shows everything (used for the dashboard component)
 #
 # limit: Limits the total number of articles (used for dashboard component)
 #
 # showTopicByDefault: Skips over the 'all' tab and shows the first topic by default (used for the dashboard component)
 #
 # showMore: Controls whether the 'show more' component link is enabled or not
 #}
{% set articleListData = {
    'page': initialPage,
    'articlesLoading': true,
    'topics': [],
    'allArticles': [],
    'savedArticleIds': [],
    'filteredArticles': [],
    'getArticlesRoute': routeLookup('commsNews.getListForIndex'),
    'getSavedArticlesRoute': routeLookup('commsNewsSaveForLater.getList'),
    'getIndexRoute': routeLookup('commsNews.getIndex'),
    'configSaveForLater': config.save_for_later,
    'configSearchTypeLimit': config.search_type_limit,
    'localeNewsPlural': locale.news.plural,
    'queryStringPage': queryStringPage,
    'queryStringReferrer': queryStringReferrer,
    'queryStringTopic': queryStringTopic,
    'topicAll': {
        name: '',
        slug: ''
    },
    'tabSelected': topic,
    'referrer': referrer,
    'changeTabOnMeta': changeTabOnMeta,
    'initialPage': initialPage,
    'initialTopic': '',
    'modifyWindowState': modifyWindowState ?: 'false',
    'compactMode': compactMode is defined ? compactMode : 'false',
    'disablePagination': disablePagination is defined ? disablePagination : 'false',
    'limit': limit is defined ? limit : 0,
    'showTopicByDefault': showTopicByDefault is defined and showTopicByDefault ? 'true' : 'false',
    'showMore': showMore is defined ? showMore : 'false'
} %}
<div id="news-component">
    <article-list :data="{{ articleListData | json_encode }}"></article-list>
</div>
<div id='toaster' class="toast" data-toast></div>

<script>
    'use strict';

    var topicAll = '{{ topicAll }}';

    // Axios does not set the XHR header by default, so we have to do it manually.
    var getHeaders = {
        'X-Requested-With' : 'XMLHttpRequest'
    };

    // Axios sends data as JSON by default; we need it urlencoded
    var postHeaders = {
        'X-Requested-With' : 'XMLHttpRequest',
        'content-type': 'application/x-www-form-urlencoded'
    }
</script>
<script src="/javascript/components/articleList.bundle.js"></script>
