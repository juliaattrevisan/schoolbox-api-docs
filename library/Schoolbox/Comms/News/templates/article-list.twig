{#
 # News article list component, with topic tabs and pagination
 # This can become a single file Vue component once we have a bundler
 #
 # Core and querystring params
 # @param int $componentInstanceId     The primary key for this component instance
 # @param string $queryStringPage      The string to use for page number param name in the URL
 # @param string $queryStringReferrer  The string to use for referrer param name in the URL
 # @param string $queryStringTopic     The string to use for topic param name in the URL
 #
 # Topics
 # @param array $topicAll              The topic name and slug for the 'all' tab
 # @param string|null $topic           The topic slug to load, as chosen by the user
 # @param bool $showTopicByDefault     If true, preselects the first topic tab if a topic wasn't chosen by user (used for the dashboard component)
 # @param bool $changeTabOnMeta        On click of a topic in a news card meta- whether to change tab on the current page or not
 #
 # Pagination
 # @param int|null $initialPage        The page number to load by default, used for history API
 # @param int $limit                   Number of items to display per page
 # @param bool $disablePagination      If true, the pagination palette doesn't render and shows everything (used for the dashboard component)
 #
 # Referrers and Redirects
 # @param bool $modifyWindowState      If true, push changes to the window state to simulate browser history
 # @param string $referrer             Referrer string for stats logging
 # @param string $returnUrl            Return to this location after submitting forms etc
 #
 # Layout
 # @param string $compactMode          Bool for compactMode layout (removes the blurb from the news card)
 # @param bool $showMore               If true, enables the Show More link under article list
 # @param string|null $itemLayout      A string corresponding to which Item Layout was chosen in component config
 # @param string|null $fallbackImage   A string corresponding to which Fallback Image was chosen in component config
 #
 # Vue Payload: uses these vars but for some reason we're defining them out here
 # You might be able to specify them in the data() of article-list.vue but can
 # save that for another day
 #
 # Routes
 # @param string $getIndexRoute          Route for news feed page
 # @param string $getArticlesRoute       Route for retrieving all the articles
 # @param string $getSavedArticlesRoute  Route for retrieving all the articles
 #
 # Config
 # @param bool $configSaveForLater       Config for whether save for later is enabled
 # @param int $configSearchTypeLimit     Config that's used for number of items per page
 # @param string $localeNewsPlural       Localisation of news
 #
 # Data stacks for Article/Topic ids
 # @param array $allArticles             *All* the author's articles
 # @param array $savedArticles           A unique list of article ids that the user has currently saved
 # @param array $filteredArticles        A container for a filtered list of authored articles. Will be populated as all articles on load
 # @param array $$topics                 A unique list of topics built from the article json
 #
 # Initial Conditions
 # @param int $page                      The active page on the pagination
 # @param bool $articlesLoading          Whether the articles are still being loaded or not; used to show the placeholder loader
 # @param string $tabSelected            If topic has come from the controller- use that to set default tab selected
 # @param string $initialTopic           The initial topic a user started on, has to be set dynamically below after component has mounted
 #}
{% if not initialPage %}
    {% set initialPage = 1 %}
{% endif %}

{% set articleListData = {
    'queryStringPage': queryStringPage,
    'queryStringReferrer': queryStringReferrer,
    'queryStringTopic': queryStringTopic,

    'topicAll': topicAll,
    'showTopicByDefault': showTopicByDefault is defined and showTopicByDefault,
    'changeTabOnMeta': changeTabOnMeta,

    'initialPage': initialPage,
    'limit': limit is defined ? limit : 0,
    'disablePagination': disablePagination is defined ? disablePagination : false,

    'modifyWindowState': modifyWindowState ?: false,
    'referrer': referrer,

    'compactMode': compactMode is defined ? compactMode : 0,
    'showMore': showMore is defined ? showMore : false,
    'itemLayout': itemLayout is defined ? itemLayout : 'list',
    'fallbackImage': fallbackImage is defined ? fallbackImage : 'author',

    'getIndexRoute': routeLookup('commsNews.getIndex'),
    'getArticlesRoute': getArticlesRoute is defined ? getArticlesRoute : routeLookup('commsNews.getListForIndex'),
    'getSavedArticlesRoute': config.save_for_later ? routeLookup('commsNewsSaveForLater.getList') : null,

    'configSaveForLater': config.save_for_later,
    'configSearchTypeLimit': config.search_type_limit,
    'localeNewsPlural': locale.news.plural,

    'allArticles': [],
    'savedArticleIds': [],
    'filteredArticles': [],
    'topics': [],

    'page': initialPage,
    'articlesLoading': true,
    'tabSelected': topic,
    'initialTopic': ''
} %}

<script>
    'use strict';

    var topicAll = {{ topicAll | json_encode | raw }};

    // Axios does not set the XHR header by default, so we have to do it manually.
    var getHeaders = {
        'X-Requested-With' : 'XMLHttpRequest'
    };

    // Axios sends data as JSON by default; we need it urlencoded
    var postHeaders = {
        'X-Requested-With' : 'XMLHttpRequest',
        'content-type': 'application/x-www-form-urlencoded'
    }
</script>

<div id="news-component">
    <article-list :data="{{ articleListData | json_encode }}"></article-list>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/articleList.js?v={{ config.site_version }}"></script>

<div id='toaster' class="toast" data-toast></div>
