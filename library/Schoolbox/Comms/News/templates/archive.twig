<div class="row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ locale.news.proper }} Archive</h1>
        </div>
    </div>
</div>

<div class="row">

    {# Month/Year Selector #}
    <div class="small-12 medium-3 island">
        <h2 class="subheader">Select Month</h2>
        <section>
            <nav>
                <ul class="side-nav">
                    {% for year, months in availableYears %}
                        <li class="{{ selectedYear|length and year == selectedYear ? 'active' : '' }}" role="menuitem">
                            <a href="{{ routeLookup('commsNews.getArchive', {year: year}) }}">
                                {{ year }}
                            </a>
                            <ul>
                                {% for month, val in months %}
                                    {% set archiveDate = year ~ '-' ~ month ~ '-01' %}
                                    <li class="{{ selectedDate|length and archiveDate == selectedDate ? 'active' : '' }}" role="menuitem">
                                        <a href="{{ routeLookup('commsNews.getArchive', {year: year, month: month}) }}">
                                            {{ archiveDate | date('F') }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                        <li class="divider"></li>
                    {% endfor %}
                </ul>
            </nav>
        </section>
    </div>

    <div class="small-12 medium-9 island">
        <h2 class="subheader">
            {% if year and month %}
                {% set selectedDate = year ~ '-' ~ month ~ '-01' %}

                {{ selectedDate | date('F Y') }}
            {% elseif year %}
                {{ year }}
            {% endif %}
        </h2>
        {% if year %}
        <section>

            {##
             # A list of all the available Topics to chooze
             # Sets up a container for async article loading
             #
             # @param int componentInstanceId
             # @param Collection|Topic[] topics
             # @param int topicAll
             # @param int compactMode
             # @param int pageNum
             # @param int limit
             #}
            <script src="/javascript/shared/comms/articletabs.js"></script>
            <script src="/javascript/shared/comms/saveforlater.js"></script>
            <script>
                $(function() {
                    $('#news-container').articleTabs({
                        'topicTabs': $('#news-topics'),
                        'updateUrl': true,
                        'hidePaginator': false,
                        'pageNum': '{{ pageNum }}',
                        'limit': '{{ limit }}'
                    });
                });
            </script>

            {% include '@commsNews/tabs.twig' with {
                url: routeLookup('commsNews.getListByTopic', {year: year, month: month}),
                topicContainerId: 'news-topics',
                topics: topics,
                topicAll: topicAll,
                slug: slug,
                compactMode: false,
                limit: limit
            } %}

            <div id="news-container">
                {# TODO: Purifying pre-built content strips data-saveforlater var
                 # For now, presume this was previously filtered elsewhere server-side
                 #}
                {{ initialContent|raw }}
            </div>
        </section>
        {% endif %}
    </div>

</div>

<div id="toast" class="toast"></div>