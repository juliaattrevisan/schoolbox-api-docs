{##
 # A list of all the available Topics to chooze
 # Sets up a container for async article loading
 #
 # @param Collection|Topic[] topics
 # @param int topicAll
 # @param string slug
 # @param int compactMode
 # @param int limit
 # @param int year
 # @param int month
 # @param string referrer
 #}
{% extends '@commsNews/page-layout.twig' %}

{% block breadCrumbs %}
    {% import 'sub/breadcrumbs.twig' as bread %}

    {% if folderId is defined %}
        {% set componentParam = (componentId) ? '#component' ~ componentId : '' %}

        {{ bread.crumbs(
            [locale.news.properPlural, routeLookup('commsNews.getIndex')],
            [folderName, '/homepage/' ~ folderId ~ componentParam],
            [locale.news.properPlural ~ ' Archive'])
        }}
    {% else %}
        {{ bread.crumbs(
            [locale.news.properPlural, routeLookup('commsNews.getIndex')],
            [locale.news.properPlural ~ ' Archive'])
        }}
    {% endif %}
{% endblock %}

{% block actionIcons %}
{% endblock %}

{% if year and month %}
    {% set selectedDate = year ~ '-' ~ month ~ '-01' %}
    {% set subheading = selectedDate|date('F Y') %}
{% elseif year %}
    {% set subheading = year %}
{% else %}
    {% set subheading = '' %}
{% endif %}


{% block newsTitle %}{{ locale.news.proper }} Archive{% endblock %}

{% block archiveFilter %}
    {% if availableYearsAndMonths|length %}
        {# Month/Year Selector #}
        <nav>
            <ul class="news-archive-filter side-nav">
                {% set folderParam = '' %}
                {% if folderId is defined %}
                    {% set folderParam = [
                        'f=' ~ folderId,
                    ] %}

                    {% set folderParam = (componentId) ? folderParam|merge([
                        'cid=' ~ componentId,
                    ]) : folderParam|merge([]) %}

                    {% set folderParam = folderParam |join('&') %}
                {% endif %}
                {% for availableYear, availableMonths in availableYearsAndMonths %}

                    <li class="{{ year == availableYear ? 'active' : '' }} {% if month %}has-month-selected{% endif %}" role="menuitem">
                        <a href="{{ routeLookup('commsNews.getArchive', {year: availableYear}) ~ '?' ~ folderParam }}">
                            {{ availableYear }}
                        </a>
                        <ul class="months">
                            {% for availableMonth, val in availableMonths %}
                                {% set archiveDate = availableYear ~ '-' ~ availableMonth ~ '-01' %}

                                <li class="{{ archiveDate == selectedDate is defined ? 'active' : '' }}" role="menuitem">
                                    <a href="{{ routeLookup('commsNews.getArchive', {year: availableYear, month: availableMonth}) ~ '?' ~folderParam }}">
                                        {{ archiveDate | date('F') }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </li>
                    <li class="divider"></li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
{% endblock %}

{% block newsContent %}
    <h2 class="subheader">{{ subheading }}</h2>

    {% if availableYearsAndMonths|length %}

        {% if year %}
            <section>
                <script src="{{ CDN_PREFIX }}/js/comms/articletabs.js?v={{ config.site_version }}"></script>
                <script src="{{ CDN_PREFIX }}/js/comms/saveforlater.js?v={{ config.site_version }}"></script>
                <script>
                    $(function() {
                        var $newsContainer = $('#news-container');

                        $newsContainer.articleTabs({
                            'topicTabs': $('#news-topics'),
                            'updateUrl': true
                        });

                        $newsContainer.saveForLater();
                    });
                </script>

                {% include '@commsNews/tabs.twig' with {
                    url: routeLookup('commsNews.getListByTopic', {year: year, month: month}),
                    topicContainerId: 'news-topics',
                    topics: topics,
                    topicAll: topicAll,
                    slug: slug,
                    compactMode: false,
                    limit: limit is defined ? limit : null,
                    referrer: referrer,
                    folderId: folderId is defined ? folderId : null,
                    componentId: componentId is defined ? componentId : null,
                } %}

                <div id="news-container">
                    {# TODO: Purifying pre-built content strips data-saveforlater var
                     # For now, presume this was previously filtered elsewhere server-side
                     #}
                    {{ initialContent|raw }}
                </div>
            </section>
        {% endif %}

    {% else %}

        <div class="small-12 columns">
            <div class="empty-state">
                <i class="icon-news"></i>
                <p>The archive is empty.</p>

                {% set createRoute = routeLookupIfAuthorized('commsNews.getCreate') %}
                {% if createRoute %}
                    <p>You can <a href="{{ createRoute }}">create some {{ locale.news }}</a>.</p>
                {% endif %}
            </div>
        </div>

    {% endif %}

{% endblock %}

