{##
 # A list of all the available Topics to chooze
 # Sets up a container for async article loading
 #
 # @param Collection|Topic[] topics
 # @param int topicAll
 # @param string slug
 # @param int compactMode
 # @param int limit
 # @param int year
 # @param int month
 # @param string referrer
 #}
<div class="row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ locale.news.proper }} Archive</h1>
        </div>
    </div>
</div>

{% if availableYearsAndMonths|length %}

    {% if year and month %}
        {% set selectedDate = year ~ '-' ~ month ~ '-01' %}
        {% set subheading = selectedDate|date('F Y') %}
    {% elseif year %}
        {% set subheading = year %}
    {% endif %}

    <div class="row">

        {# Month/Year Selector #}
        <div class="small-12 medium-3 island">
            <h2 class="subheader">Filter</h2>
            <section>
                <nav>
                    <ul class="side-nav">
                        {% for availableYear, availableMonths in availableYearsAndMonths %}

                            <li class="{{ year == availableYear and not month ? 'active' : '' }}" role="menuitem">
                                <a href="{{ routeLookup('commsNews.getArchive', {year: availableYear}) }}">
                                    {{ availableYear }}
                                </a>
                                <ul>
                                    {% for availableMonth, val in availableMonths %}
                                        {% set archiveDate = availableYear ~ '-' ~ availableMonth ~ '-01' %}

                                        <li class="{{ archiveDate == selectedDate ? 'active' : '' }}" role="menuitem">
                                            <a href="{{ routeLookup('commsNews.getArchive', {year: availableYear, month: availableMonth}) }}">
                                                {{ archiveDate | date('F') }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                            <li class="divider"></li>
                        {% endfor %}
                    </ul>
                </nav>
            </section>
        </div>

        <div class="small-12 medium-9 island">
            <h2 class="subheader">{{ subheading }}</h2>
            {% if year %}
            <section>
                <script src="/javascript/shared/comms/articletabs.js"></script>
                <script src="/javascript/shared/comms/saveforlater.js"></script>
                <script>
                    $(function() {
                        var $newsContainer = $('#news-container');

                        $newsContainer.articleTabs({
                            'topicTabs': $('#news-topics'),
                            'updateUrl': true
                        });

                        $newsContainer.saveForLater();
                    });
                </script>

                {% include '@commsNews/tabs.twig' with {
                    url: routeLookup('commsNews.getListByTopic', {year: year, month: month}),
                    topicContainerId: 'news-topics',
                    topics: topics,
                    topicAll: topicAll,
                    slug: slug,
                    compactMode: false,
                    limit: limit,
                    referrer: referrer
                } %}

                <div id="news-container">
                    {# TODO: Purifying pre-built content strips data-saveforlater var
                     # For now, presume this was previously filtered elsewhere server-side
                     #}
                    {{ initialContent|raw }}
                </div>
            </section>
            {% endif %}
        </div>
    </div>

    <div id="toast" class="toast"></div>
{% else %}
    <div class="small-12 columns">
        <div class="empty-state">
            <i class="icon-news"></i>
            <p>The archive is empty.</p>

            {% set createRoute = routeLookupIfAuthorized('commsNews.getCreate') %}
            {% if createRoute %}
                <p>You can <a href="{{ createRoute }}">create some {{ locale.news }}</a>.</p>
            {% endif %}
        </div>
    </div>
{% endif %}