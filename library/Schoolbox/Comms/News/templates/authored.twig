{% extends '@commsNews/page-layout.twig' %}

{% block breadCrumbs %}
    {% import 'sub/breadcrumbs.twig' as bread %}
    {{ bread.crumbs([locale.news.properPlural, routeLookup('commsNews.getIndex')], ['Created By Me']) }}
{% endblock %}

{% block newsTitle %}Created By Me{% endblock %}

{% block newsContent %}
    <div id="authored-container">
        <news-authored
            :page-number="{{ pageNum }}"
            tab-selected="{{ status }}"
            news-route="{{ routeLookup('commsNews.getAuthoredArticles') }}"
            :limit-per-page="{{ config.search_type_limit }}"
            :topic-container-id="{{ topicContainerId is defined ? topicContainerId : 0 }}"
            locale-news="{{ locale.news }}"
            locale-news-plural="{{ locale.news.plural }}"
            {% set createRoute = routeLookupIfAuthorized('commsNews.getCreate') %}
            {% if createRoute %}
            :can-create-news="true"
            create-news-route="{{ createRoute }}"
            {% else %}
            :can-create-news="false"
            create-news-route=""
            {% endif %}
        >
        </news-authored>
    </div>
    <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/newsAuthored.js?v={{ config.site_version }}"></script>
{% endblock %}