{% block newsScripts %}
    <script src="/javascript/components/schoolbox-vue.min.js"></script>
    <script>

        window.authoredConfig = {
            // The active page on the pagination
            page: {{ pageNum }},
            // The selected tab, just used for active styling
            tabSelected: '{{ status }}',
            //route to retrieve my news
            route: '{{ routeLookup('commsNews.getAuthoredArticles') }}',
            
            limit: {{ config.search_type_limit }},

            topicContainerId: {{ topicContainerId is defined ? topicContainerId : 0 }},

        }
        
        
    </script>
    <script type="text/javascript" src="/javascript/components/authored.bundle.js?v={{ config.site_version }}"></script>
{% endblock %}
