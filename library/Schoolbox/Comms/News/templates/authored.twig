<div id="authored-container">
    <div class="row actions-small-1">
        <div class="list-item">
            <div class="small-12 columns">
                <h1>My Articles</h1>
            </div>
        </div>
        <nav>
            {% set createRoute = routeLookupIfAuthorized('commsNews.getCreate') %}
            {% if createRoute %}
                <a href="{{ createRoute }}" class="icon-add" title="Create {{ locale.news }}"></a>
            {% endif %}
        </nav>
    </div>

    <div class="row">
        <div class="small-12 island">
            <section>

                {# tabs #}
                <dl class="tabs" id="{{ topicContainerId }}">
                    <dd :class="{active: tabSelected === 'All'}"><a @click="onTabChange('All')">All</a></dd>
                    <dd :class="{active: tabSelected === 'Rejected'}"><a @click="onTabChange('Rejected')">Rejected</a></dd>
                    <dd :class="{active: tabSelected === 'Draft'}"><a @click="onTabChange('Draft')">Drafts</a></dd>
                    <dd :class="{active: tabSelected === 'Awaiting Moderation'}"><a @click="onTabChange('Awaiting Moderation')">Awaiting Moderation</a></dd>
                    <dd :class="{active: tabSelected === 'Awaiting Publication'}"><a @click="onTabChange('Awaiting Publication')">Awaiting Publication</a></dd>
                    <dd :class="{active: tabSelected === 'Published'}"><a @click="onTabChange('Published')">Published</a></dd>
                    <dd :class="{active: tabSelected === 'Archived'}"><a @click="onTabChange('Archived')">Archived</a></dd>
                </dl>

                <div class="tabs-content">
                    <ul class="information-list">

                        <li class="actions-small-1" v-if="!currentArticles.length" v-for="n in 3">
                            <div class="list-item">
                                <div class="small-12 card placeholder">
                                    <div class="img"></div>
                                    <h3></h3>
                                    <p class="meta"></p>
                                </div>
                            </div>
                        </li>

                        <li class="actions-small-1" v-for="article in currentArticles">
                            <div class="list-item">
                                <div class="small-12 card">

                                    <a href="#" v-if="article.featureImage">
                                        <img :src="'/storage/image.php?hash=' + article.featureImage.hash + '&size=square64'">
                                    </a>

                                    <h3><a href="#">${ article.title }</a></h3>

                                    <p class="meta">
                                        <b>${ article.status }</b>
                                        <time :title="article.statusDate.long">${ article.statusDate.relativeTime }</time>
                                    </p>

                                </div>
                            </div>
                            <nav>
                                <a href="#" class="icon-modify no-text" title="Modify this article"></a>
                            </nav>
                        </li>

                    {#{% for article in articles %}
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="small-12 card">

                                    {% if article.featureImage.hash %}
                                        <a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}">
                                            <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=square64">
                                        </a>
                                    {% endif %}

                                    <h3><a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}">{{ article.title }}</a></h3>

                                    {% if article.isRejected %}
                                        {% set articleStatus = 'Rejected' %}
                                        {% set articleStatusDate = article.rejectedAt %}
                                        {% set articleStatusTitle = article.rejectedReason %}
                                    {% elseif article.isDraft %}
                                        {% set articleStatus = 'Drafted' %}
                                        {% set articleStatusDate = article.createdAt %}
                                    {% elseif article.isExpired %}
                                        {% set articleStatus = 'Archived' %}
                                        {% set articleStatusDate = article.expiresAt %}
                                    {% elseif article.isPublished %}
                                        {% set articleStatus = 'Published' %}
                                        {% set articleStatusDate = article.publishAt %}
                                    {% elseif article.isAwaitingPublication %}
                                        {% set articleStatus = 'Awaiting Publication' %}
                                        {% set articleStatusDate = article.publishAt %}
                                    {% elseif article.isAwaitingModeration %}
                                        {% set articleStatus = 'Awaiting Moderation' %}
                                        {% set articleStatusDate = article.publishAt %}
                                    {% endif %}

                                    <p class="meta">
                                        <b>{{ articleStatus }}</b>
                                        <time title="{{ articleStatusDate.long }}">{{ articleStatusDate.relativeTime }}</time>
                                    </p>

                                </div>
                            </div>
                            {% set modifyRoute = routeLookupIfAuthorized('commsNews.getUpdate', {articleId: article.id}) %}
                            {% if modifyRoute %}
                                <nav>
                                    <a href="{{ modifyRoute }}" class="icon-modify no-text" title="Modify this article"></a>
                                </nav>
                            {% endif %}
                        </li>
                    {% endfor %}#}
                </ul>


                </div>
            </section>
            <paginate
                    v-model="page"
                    :page-count="pageCount"
                    :container-class="'pagination'"
                    :prev-text="'‹'"
                    :next-text="'›'"
                    :prev-link-class="'arrow'"
                    :next-link-class="'arrow'"
                    :disabled-class="'unavailable'"
                    :click-handler="onPaginate"
                    v-if="currentArticles.length"
            >
            </paginate>
        </div>
    </div>



</div>

<script src="//unpkg.com/vuejs-paginate@latest"></script>
<script>
    'use strict';

    var app = new Vue({
        el: '#authored-container',
        delimiters: ['${', '}'],
        components: {
            'paginate': VuejsPaginate
        },
        data: {
            // The active page on the pagination
            page: 1,

            // *All* the author's articles
            allArticles: [],

            // A container for a filtered list of authored articles
            // Will be populated as all articles on load
            filteredArticles: [],

            // The current page of articles
            currentArticles: [],

            // The selected tab, just used for active styling
            tabSelected: 'All'
        },
        mounted: function () {
            var vue = this;

            // Find some articles
            axios.get('/comms/news/me/articles').then(function(response) {

                vue.allArticles = response.data;
                vue.filteredArticles = response.data;
                vue.currentArticles = response.data.slice(0, {{ config.search_type_limit }});

            }).catch(function (error) {
                console.log(error);
            });
        },
        methods: {
            onPaginate: function (page) {
                // Show the next set
                var limit = {{ config.search_type_limit }};
                var offset = (page-1) * limit;
                var total = offset + {{ config.search_type_limit }};
                this.currentArticles = this.filteredArticles.slice(offset, total);
            },
            onTabChange: function (tab) {
                var vue = this;
                var limit = {{ config.search_type_limit }};

                vue.tabSelected = tab;
                vue.page = 1;

                if (tab === 'All') {
                    // Reset back to original set
                    vue.filteredArticles = vue.allArticles;
                    vue.currentArticles = vue.allArticles.slice(0, limit);
                } else {
                    // Filter by tab selected
                    var filteredArticles = vue.currentArticles = vue.allArticles.filter(function (article) {
                        return article.status === tab;
                    });

                    vue.filteredArticles = filteredArticles;
                    vue.currentArticles = filteredArticles.slice(0, limit);
                }
            }
        },
        computed: {
            pageCount: function () {
                return this.filteredArticles.length / {{ config.search_type_limit }};
            }
        }
    });
</script>