<div id="authored-container">
    <div class="row actions-small-1">
        <div class="list-item">
            <div class="small-12 columns">
                <h1>My Articles</h1>
            </div>
        </div>
        <nav>
            {% set createRoute = routeLookupIfAuthorized('commsNews.getCreate') %}
            {% if createRoute %}
                <a href="{{ createRoute }}" class="icon-add" title="Create {{ locale.news }}"></a>
            {% endif %}
        </nav>
    </div>

    <div class="row">
        <div class="small-12 island">
            <section>

                {# tabs #}
                <dl class="tabs" id="{{ topicContainerId }}">
                    <dd v-for="status in statuses" :class="{active: tabSelected === status}">
                        <a @click="onTabChange(status)">${ status }</a>
                    </dd>
                    <dd class="placeholder" v-if="articlesLoading" v-for="n in 3">
                        <a></a>
                    </dd>
                </dl>

                <div class="tabs-content no-margin">
                    <ul class="information-list">

                        <li class="actions-small-1" v-if="articlesLoading" v-for="n in 3">
                            <div class="list-item">
                                <div class="small-12 card placeholder">
                                    <div class="img"></div>
                                    <h3></h3>
                                    <p class="meta"></p>
                                </div>
                            </div>
                        </li>

                        <li class="actions-small-1" v-for="article in currentArticles">
                            <div class="list-item">
                                <div class="small-12 card">

                                    <a :href="'/comms/news/' + article.id" v-if="article.featureImage">
                                        <img :src="'/storage/image.php?hash=' + article.featureImage.hash + '&size=square64'">
                                    </a>

                                    <h3><a :href="'/comms/news/' + article.id">${ article.title }</a></h3>

                                    <p class="meta">
                                        <b>${ article.status }</b>
                                        <time :title="article.statusDate.long">${ article.statusDate.relativeTime }</time>
                                    </p>

                                </div>
                            </div>
                            <nav>
                                <a :href="'/comms/news/' + article.id + '/update'" class="icon-modify no-text" title="Modify this article"></a>
                            </nav>
                        </li>
                    </ul>

                    <div class="empty-state no-margin" v-if="!filteredArticles.length && !articlesLoading">
                        <i class="icon-news"></i>
                        <p>You haven't authored any articles.</p>
                        <p><a href="{{ routeLookupIfAuthorized('commsNews.getCreate') }}">Create {{ locale.news }}</a>.</p>
                    </div>

                </div>
            </section>
            <paginate
                    v-model="page"
                    :page-count="pageCount"
                    :container-class="'pagination'"
                    :prev-text="'‹'"
                    :next-text="'›'"
                    :prev-link-class="'arrow'"
                    :next-link-class="'arrow'"
                    :disabled-class="'unavailable'"
                    :click-handler="onPaginate"
                    v-if="currentArticles.length && pageCount > 1"
            >
            </paginate>
        </div>
    </div>

</div>

<script src="/javascript/components/schoolbox-vue.min.js"></script>
<script>
    'use strict';

    var app = new Vue({
        el: '#authored-container',
        delimiters: ['${', '}'],
        components: {
            'paginate': VuejsPaginate
        },
        data: {
            // The active page on the pagination
            page: 1,

            // Whether the articles are still being loaded or not
            // Used to show the placeholder loader
            articlesLoading: true,

            // A unique list of statuses returned from the user's articles
            // Used to display tab options
            statuses: [],

            // *All* the author's articles
            allArticles: [],

            // A container for a filtered list of authored articles
            // Will be populated as all articles on load
            filteredArticles: [],

            // The current page of articles
            currentArticles: [],

            // The selected tab, just used for active styling
            tabSelected: 'All'
        },
        mounted: function () {
            var vue = this;

            // Find some articles
            axios.get('/comms/news/me/articles').then(function(response) {

                vue.articlesLoading = false;
                vue.allArticles = response.data;
                vue.filteredArticles = response.data;
                vue.currentArticles = response.data.slice(0, {{ config.search_type_limit }});

                // Loop the returned articles and populate the 'statuses' array for the status tabs
                vue.statuses.push('All'); // Add 'all' here so that they're all loaded at the same time
                response.data.forEach(function (article) {
                    if (vue.statuses.indexOf(article.status) === -1) {
                        vue.statuses.push(article.status);
                    }
                });

            }).catch(function (error) {
                console.log(error);
            });
        },
        methods: {
            onPaginate: function (page) {
                // Show the next set
                var limit = {{ config.search_type_limit }};
                var offset = (page-1) * limit;
                var total = offset + {{ config.search_type_limit }};
                this.currentArticles = this.filteredArticles.slice(offset, total);
            },
            onTabChange: function (tab) {
                var vue = this;
                var limit = {{ config.search_type_limit }};

                vue.tabSelected = tab;
                vue.page = 1;

                if (tab === 'All') {
                    // Reset back to original set
                    vue.filteredArticles = vue.allArticles;
                    vue.currentArticles = vue.allArticles.slice(0, limit);
                } else {
                    // Filter by tab selected
                    var filteredArticles = vue.currentArticles = vue.allArticles.filter(function (article) {
                        return article.status === tab;
                    });

                    vue.filteredArticles = filteredArticles;
                    vue.currentArticles = filteredArticles.slice(0, limit);
                }
            }
        },
        computed: {
            pageCount: function () {
                return this.filteredArticles.length / {{ config.search_type_limit }};
            }
        }
    });
</script>