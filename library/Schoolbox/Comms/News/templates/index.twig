<div class="row">
    <div class="small-12 columns">
        <h1>{{ locale.news.proper }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section id="news-list">

            {##
             # A list of all the available Topics to chooze
             # Sets up a container for async article loading
             #
             # @param int componentInstanceId
             # @param int firstTopicId
             # @param int topicAll
             # @param int limit
             # @param Collection|Topic[] topics
             # @param bool allDefault
             # @param int compactMode
             #}
            <script src="/javascript/shared/comms/articletabs.js"></script>
            <script src="/javascript/shared/comms/saveforlater.js"></script>
            <script>
                $(function() {
                    $('#news-container').articleTabs({
                        'firstUrl': "{{ routeLookup('commsNews.getListByTopic', {topicId: firstTopicId, limit: limit}) ~ '?compactMode=' ~ compactMode }}",
                        'topicTabs': $('#news-topics'),
                        'updateUrl': true
                    });
                });
            </script>

            <dl class="tabs-material" data-tab="" id="news-topics">

                {# Select "All" by default if the component config is set #}
                <dd {% if not firstTopicId %}class="active"{% endif %}><a href="{{ routeLookup('commsNews.getListByTopic', {topicId: topicAll, limit: limit}) ~ '?compactMode=' ~ compactMode }}">All</a></dd>

                {% for topic in topics %}
                    {% if topic.id == firstTopicId %}
                        {% set selected = 'class="active"' %}
                    {% else %}
                        {% set selected = '' %}
                    {% endif %}

                    <dd {{ selected|purify }}><a href="{{ routeLookup('commsNews.getListByTopic', {topicId: topic.id, limit: limit}) ~ '?compactMode=' ~ compactMode }}">{{ topic.name }}</a></dd>
                {% endfor %}
            </dl>

            <div id="news-container">
                <div class="loader"></div>
            </div>
        </section>
    </div>
</div>

