<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Create {{ locale.news }}</h2>
        <section class="content">
            {% set formAction = routeLookupIfAuthorized('commsNews.postCreate') %}
            {% if formAction %}
                <form action="{{ formAction }}" method="post">
                    <label>var1</label>
                    <input type="text" name="var1" />

                    <input type="submit" />
                </form>
            {% else %}
                Not authorised to POST
            {% endif %}
        </section>
    </div>
</div>

