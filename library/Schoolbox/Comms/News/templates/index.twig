<div class="actions-small-2 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ locale.news.proper }}</h1>
        </div>
    </div>
    <nav>
        {% set createRoute = routeLookupIfAuthorized('commsNews.getCreate') %}
        {% if createRoute %}
            <a href="{{ createRoute }}" class="icon-add" title="Create {{ locale.news }}"></a>
        {% endif %}

        {% set saveForLaterRoute = routeLookupIfAuthorized('commsNewsSaveForLater.getList') %}
        {% if saveForLaterRoute %}
            <a href="{{ saveForLaterRoute }}" class="icon-list" title="View a list of saved articles"></a>
        {% endif %}
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        <section>

            {##
             # A list of all the available Topics to chooze
             # Sets up a container for async article loading
             #
             # @param int componentInstanceId
             # @param Collection|Topic[] topics
             # @param int topicAll
             # @param int compactMode
             # @param int pageNum
             # @param int limit
             #}
            <script src="/javascript/shared/comms/articletabs.js"></script>
            <script src="/javascript/shared/comms/saveforlater.js"></script>
            <script>
                $(function() {
                    $('#news-container').articleTabs({
                        'topicTabs': $('#news-topics'),
                        'updateUrl': true,
                        'showPaginator': true,
                        'pageNum': '{{ pageNum }}',
                        'limit': '{{ limit }}'
                    });
                });
            </script>

            {% include '@commsNews/tabs.twig' with {
                topicContainerId: 'news-topics',
                topics: topics,
                topicAll: topicAll,
                slug: slug,
                compactMode: false,
                limit: limit
            } %}

            <div id="news-container" class="news-container">

                {# TODO: Purifying pre-built content strips data-saveforlater var
                 # For now, presume this was previously filtered elsewhere server-side
                 #}
                {{ initialContent|raw }}
            </div>
        </section>
    </div>
</div>

<div id="toast" class="toast"></div>