{##
 # News feed page
 #
 # Shows the news component, with no limits and pagination, plus an RSS link
 #
 # @param int initialPage
 # @param string topicAll
 # @param string topic
 # @param string referrer
 # @param string queryStringPage
 # @param string queryStringReferrer
 # @param string queryStringTopic
 # @param string key
 #}
{% extends '@commsNews/page-layout.twig' %}

{% set rssRoute = routeLookupIfAuthorized('commsNewsFeed.getFeedForUser', {key: key}) %}

{% block newsTitle %}{{ locale.news.proper }} Feed{% endblock %}

{% block rssLink %}
    {% if rssRoute and topic %}
        <span id="news-rss-link"><a :href="link" class='icon-rss' title="Download RSS feed for this topic" id="rss"></a></span>
    {% endif %}
{% endblock %}

{% block newsContent %}
    {# has to live here instead of the scripts block below :( #}
    <script src="/javascript/components/schoolbox-vue.min.js"></script>

    {% include '@commsNews/article-list.twig' with {
        initialPage: initialPage,
        queryStringPage: queryStringPage,
        queryStringReferrer: queryStringReferrer,
        topic: topic,
        topicAll: topicAll,
        referrer: referrer,
        changeTabOnMeta: true,
        modifyWindowState: true
    } %}
{% endblock %}

{% block newsScripts %}
    <script>
        var rssLink = new Vue({
            el: '#news-rss-link',
            delimiters: ['${', '}'],
            data: {
                route: '{{ rssRoute }}',
                queryStringTopic: '{{ queryStringTopic }}',
                topic: '{{ topic }}'
            },
            computed: {
                link: function() {
                    return this.route + '?' + this.queryStringTopic + '=' + this.topic
                }
            }
        });
    </script>
{% endblock %}
