{##
 # A list of all the available Topics to chooze
 # Sets up a container for async article loading
 #
 # @param initialPage
 # @param topic
 # @param Collection|Topic[] topics
 # @param string topicAll
 # @param string slug
 # @param int compactMode
 # @param int limit
 # @param string referrer
 # @param string queryStringPage
 # @param string queryStringReferrer
 #}
{% extends '@commsNews/page-layout.twig' %}

{% block newsTitle %}{{ locale.news.proper }} Feed{% endblock %}

{% block archiveLink %}
    {% set archiveRoute = routeLookupIfAuthorized('commsNews.getArchive') %}
    {% if archiveRoute %}
        <a href="{{ archiveRoute }}" class='icon-archive' title="View archived {{ locale.news }}"></a>
    {% endif %}
{% endblock %}

{% block rssLink %}
    {% set rssRoute = routeLookupIfAuthorized('commsNewsFeed.getFeed', {key: key}) %}
    {% if rssRoute and slug %}
        <li><a href="{{ rssRoute }}?topic={{ slug }}" class='icon-rss' title="Download RSS feed for this topic" id="rss">RSS Link</a></li>
    {% endif %}
{% endblock %}

{% block newsContent %}
    {% include '@commsNews/article-list.twig' with {
        initialPage: initialPage,
        queryStringPage: queryStringPage,
        queryStringReferrer: queryStringReferrer,
        topicAll: topicAll,
        referrer: referrer,
        changeTabOnMeta: true,
        topic: topic,
        modifyWindowState: true
    } %}
{% endblock %}
