<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Create {{ locale.news }}</h2>

        {% set formAction = routeLookupIfAuthorized('commsNews.postCreate') %}
        {% if formAction %}
        <form action="{{ formAction }}" method="post">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Title</label>
                        <input name="title" type="text" maxlength="255" />
                    </div>

                    <div class="small-12 columns">
                        <label>Body</label>
                        <textarea name="body"></textarea>
                    </div>

                    <div class="small-12 columns">
                        <label>Blurb</label>
                        <textarea name="blurb"></textarea>
                    </div>
                </fieldset>

                <input type="submit" value="Create {{ locale.news }}"/>
            </section>
        </form>
        {% else %}
            Not authorised to POST
        {% endif %}
    </div>
</div>

