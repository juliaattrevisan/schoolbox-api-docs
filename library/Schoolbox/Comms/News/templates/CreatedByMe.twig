{% extends '@commsNews/page-layout.twig' %}

{% block newsTitle %}Created By Me{% endblock %}

{% block newsContent %}
    <div>
        <div
            data-component="CreatedByMe"
            data-n-prop-initial-page="{{ pageNum }}"
            data-prop-initial-tab="{{ status }}"
            data-prop-get-authored-route="{{ routeLookup('commsNews.getAuthoredArticles') }}"
            data-n-prop-articles-per-page="{{ config.search_type_limit }}"
            data-prop-locale-news="{{ locale.news }}"
            data-prop-locale-news-plural="{{ locale.news.plural }}"
        ></div>
    </div>
{% endblock %}

{% block newsScripts %}
    <script src="/javascript/components/news.bundle.js"></script>
{% endblock %} 