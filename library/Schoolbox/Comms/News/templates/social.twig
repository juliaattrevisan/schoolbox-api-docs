{##
 # A list of active social features that audiences can use
 #
 # @param saveForLaterEnabled bool
 # @param news                News\Model
 #}

{% if article.isAccepted %}
    {% set socialPolicies = {
        'save_for_later': {
            'value': saveForLaterEnabled,
            'activator': '@commsNewsSaveForLater/activator.twig'
        }
    } %}

    {# Decide whether to show the social features island #}
    {% set hasSocial = false %}

    {% for socialPolicy, settings in socialPolicies %}
        {% if settings.value %}
            {% set hasSocial = true %}
        {% endif %}
    {% endfor %}

    {% if hasSocial %}
        <div class="row">
            <div class="small-12 island">
                <section class="content">
                    {% for socialPolicy, settings in socialPolicies %}
                        {% if settings.value %}
                            {% include settings.activator with {
                                article: article,
                                state: states[socialPolicy]
                            } %}
                        {% endif %}
                    {% endfor %}
                </section>
            </div>
        </div>
    {% endif %}
{% endif %}
