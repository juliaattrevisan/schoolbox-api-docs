{% macro newsBlurb(article, readMore) %}
    {% spaceless %}
        {% if article.blurb %}
            {{ article.blurb|purify }}
        {% else %}
            {% set detailUrl = routeLookup('commsNews.getDetail', {articleId: article.id}) %}
            {% set pacified = article.body|cutSentence(300, true) %}

            {# If read_more policy has a value, append a "Read More" style link
             # Otherwise, don't do anything except the appended  ellipsis
             #}
            {% if readMore|length %}
                {% set pacified = pacified ~ '<div class="article-read-more"><a href="' ~ detailUrl ~ '" title="Read more">' ~ readMore ~ '</a></div>' %}
            {% endif %}
            {{ pacified|trim|purify }}
        {% endif %}
    {% endspaceless %}
{% endmacro %}