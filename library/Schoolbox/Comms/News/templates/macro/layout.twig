{# Standard feature image plus text representation of news article
 # Shown in two columns; one for image, one for text
 #
 # @param News\Model article
 #}
{% macro standard(article) %}
    <div class="small-12 medium-3 columns">
        <article class="content">
            <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=constrain200" />
        </article>
    </div>

    <div class="small-12 medium-9 columns">
        <article class="content">
            {{ article.body|purify }}
        </article>
    </div>
{% endmacro %}


{# Reversed standard feature image plus text representation of news article
 # Shown in two columns; one for image, one for text
 #}
{% macro standardReversed(article) %}
    <div class="small-12 medium-9 columns">
        <article class="content">
            {{ article.body|purify }}
        </article>
    </div>

    <div class="small-12 medium-3 columns">
        <article class="content">
            <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=constrain200" />
        </article>
    </div>
{% endmacro %}


{# Text-only representation of news article
 # Used when there isn't a feature image to shows
 #}
{% macro textonly(article) %}
    <div class="small-12 columns">
        <div class="content">
            {{ article.body|purify }}
        </div>
    </div>
{% endmacro %}


{# Feature-Image prominence
 # Used when images are more important than words
 #}
{% macro banner(article) %}
{% endmacro %}


