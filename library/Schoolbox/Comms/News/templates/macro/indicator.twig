{#
    Render an indicator of the news article's current state
#}

{# @param article: News\Model #}
{% macro render(article) %}
    {% spaceless %}
    {% import _self as self %}
    {% set label    = self.label(article) %}
    {% set cssClass = self.cssClass(article) %}
    {% if label %}
    <span id="status-new" class="label {{ cssClass }}">{{ label }}</span>
    {% endif %}
    {% endspaceless %}
{% endmacro %}

{# @param article: News\Model #}
{%- macro label(article) -%}
    {% spaceless %}
        {% if article.isDraft %}
            Draft
        {% elseif article.isAwaitingModeration %}
            Awaiting Moderation
        {% elseif article.isRejected %}
            Rejected
        {% elseif article.isAwaitingPublication %}
            Awaiting Publication
        {% elseif article.isPublished %}
            Published
        {% elseif article.isExpired %}
            Archived
        {% endif %}
    {% endspaceless %}
{%- endmacro -%}

{# @param article: News\Model #}
{%- macro cssClass(article) -%}
    {% spaceless %}
        {% if article.isDraft %}
            unsubmitted
        {% elseif article.isAwaitingModeration %}
            submitted
        {% elseif article.isRejected %}
            submitted-late
        {% elseif article.isAwaitingPublication %}
            submitted
        {% elseif article.isPublished %}
            reviewed
        {% elseif article.isExpired %}
            highlight
        {% endif %}
    {% endspaceless %}
{%- endmacro -%}

{# @param article: News\Model #}
{%- macro byLine(article) -%}
    {% spaceless %}
    {% if article.isDraft or article.isRejected %}
        {% set metaPrefix = 'Created by' %}
        {% set metaDate = {displayDate: {long: article.createdAt.long, short: article.createdAt.short}} %}

    {% elseif article.isApproved and article.publishAt.unixTimestamp <= NOW.unixTimestamp %}
        {% set metaPrefix = 'Published by' %}
        {% set metaDate = {displayDate: {long: article.publishAt.long, short: article.publishAt.short}} %}

    {% else %}
        {% set metaPrefix = 'Submitted by' %}
        {% set metaDate = {
                displayDate:        {long: article.submittedAt.long, short: article.submittedAt.short},
                publicationDate:    {long: article.publishAt.long, short: article.publishAt.short}
            }
        %}
    {% endif %}

    {% if article.author.deletedAt.isNull %}
        {% set author = '<a href="/search/user/'~ article.author.id ~ '" title="View Profile">'~ article.author.fullname ~ '</a>' %}
    {% else %}
        {% set author = article.author.fullname %}
    {% endif %}

    <li class="icon-user">{{ metaPrefix }} {{ author|raw }} on <span title="{{ metaDate.displayDate.long }}">{{ metaDate.displayDate.short }}</span></li>
    {% if metaDate.publicationDate is defined %}
        <li class="icon-clock">Publish date: <span title="{{ metaDate.publicationDate.long }}">{{ metaDate.publicationDate.short }}</span></li>
    {% endif %}

    {% endspaceless %}

{%- endmacro -%}
