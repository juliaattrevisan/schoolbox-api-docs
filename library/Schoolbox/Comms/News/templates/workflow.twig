{##
 # A trainline for all the nodes you might visit from the birth of an article
 # to its ultimate fate - publishing to the public, or the bin
 #
 # Trainline only appears when an article hasn't been broadcast yet to its audience
 # i.e. publishAt hasn't been reached yet
 #
 # @param News\Model article
 # @param bool       moderationEnabled Can users audience articles to segments where the user only has READ perm
 # @param bool       isCommsOfficer
 #}


{# Preselection
 # Choose the active node depending on the current state of the news article
 #}
{% set identifier = 'compose' %}

{% if article.id %}
    {% set identifier = 'preview' %}

    {% if moderationEnabled %}
        {% if article.isSubmitted %}
            {% set identifier = 'awaiting-moderation' %}

            {# Moderation is required and the acceptedAt is set; then we're awaiting publication #}
            {% if article.isAccepted %}
                {% set identifier = 'awaiting-publication' %}

                {# If the publish date is reached: sent it. Presumably. #}
                {% if article.publishAt.isPast %}
                    {% set identifier = 'published' %}
                {% endif %}
            {% endif %}
        {% endif %}
    {% else %}

        {# or, Moderation isn't required; then we're awaiting publication straight out of the gate
         # The publish date offset should be used to prevent ultra-immediate broadcast if people are
         # finding themselves publishing too quickly
         #}
        {% if article.isSubmitted %}
            {% set identifier = 'awaiting-publication' %}

            {# If the publish date is reached: sent it. Presumably. #}
            {% if article.publishAt.isPast %}
                {% set identifier = 'published' %}
            {% endif %}
        {% endif %}
    {% endif %}

    {# Expired news #}
    {% if article.expiresAt.isPast %}
        {% set identifier = 'expired' %}
    {% endif %}
{% endif %}


{# Compose Node
 # Varies depending on when you're creating a new article, or editing an existing
 #}
{% set composeUrl = null %}

{% if article.id %}
    {% if isCommsOfficer %}
        {% set composeUrl = routeLookup('commsNews.getUpdate', {articleId: article.id}) %}
    {% elseif moderationEnabled and not article.isAccepted %}
        {% set composeUrl = routeLookup('commsNews.getUpdate', {articleId: article.id}) %}
    {% elseif not moderationEnabled %}
        {% set composeUrl = routeLookup('commsNews.getUpdate', {articleId: article.id}) %}
    {% endif %}
{% endif %}

{% set composeNode = {
    identifier: 'compose',
    icon: null,
    url: composeUrl,
    alt: 'Compose the contents of your article',
    label: 'Compose'
} %}


{# Preview Node
 # From here you can Submit For Moderation (if required)
 # Varies depending on the moderation policy
 #}
{% if article.id %}
    {% set previewUrl = routeLookup('commsNews.getDetail', {articleId: article.id}) %}
{% else %}
    {% set previewUrl = null %}
{% endif %}

{% if moderationEnabled %}
    {% set previewAlt = 'Preview your article and submit it for moderation' %}
{% else %}
    {% set previewAlt = 'Preview your article and submit it for publishing' %}
{% endif %}

{% set previewNode = {
    identifier: 'preview',
    icon: null,
    url: previewUrl,
    alt: previewAlt,
    label: 'Preview'
} %}


{# Awaiting Moderation
 # Varies depending on the moderation policy
 #}
{% if moderationEnabled %}
    {% if article.isAccepted %}
        {% set alt = 'This article was accepted on ' ~ article.acceptedAt.local  %}
    {% elseif article.isSubmittedAt %}
        {% set alt = 'This article is awaiting moderation since ' ~ article.submittedAt.local %}
    {% else %}
        {% set alt = 'This article will require moderation before being made available to the audience' %}
    {% endif %}

    {% set awaitingModerationNode = {
        identifier: 'awaiting-moderation',
        icon: null,
        url: null,
        alt: alt,
        label: 'Awaiting Moderation'
    } %}
{% else %}
    {% set awaitingModerationNode = null %}
{% endif %}


{# Awaiting Publication To Audience
 # An alternative fate for your article is to be deleted
 # Anyway, tell the user when it was last published
 #}
{% set alt = 'This article is awaiting publication to its audience' %}

{% if article.id %}
    {% set alt = alt ~ ' on ' ~ article.publishAt.local %}
{% endif %}

{% set awaitingPublicationNode = {
    identifier: 'awaiting-publication',
    icon: null,
    url: null,
    alt: alt,
    label: 'Awaiting Publication'
} %}


{# Published To Audience
 # The final node in the proscribed flow; only highlighted once the publish date is reached
 #}
{% set alt = 'This article is awaiting publication to its audience' %}

{% if article.id %}
    {% set alt = alt ~ ' on ' ~ article.publishAt.local %}

    {% if moderationEnabled and article.isAccepted and article.acceptedAt.isPast %}
        {% if article.publishAt.isPast %}
            {% set alt = 'This article publishes on ' ~ article.publishAt.local  %}
        {% endif %}
    {% endif %}
{% endif %}

{% set publishedNode = {
    identifier: 'published',
    icon: null,
    url: null,
    alt: alt,
    label: 'Published'
} %}


{# Expired
 # This article is automatically archived once the expiresAt date is reached
 #}
{% set alt = 'This article expires and automatically archives' %}

{% if article.id %}
    {% set alt = 'Expires and automatically archives on ' ~ article.expiresAt.local %}
{% endif %}

{% set expiredNode = {
    identifier: 'expired',
    icon: null,
    url: null,
    alt: alt,
    label: 'Expired'
} %}


{# The Great Train Robbery
 # Conditionally manufacture all the stops and their assigned urls
 # Ignore null nodes (they aren't intended to show)
 #}
{% include '@commsNews/trainline.twig' with {nodes: [
    composeNode,
    previewNode,
    awaitingModerationNode,
    awaitingPublicationNode,
    publishedNode,
    expiredNode
]} %}
