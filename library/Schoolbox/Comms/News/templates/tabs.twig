{##
 # A list of all the available Topics to chooze
 # Sets up a container for async article loading
 #
 # @param string topicContainerId
 # @param int selectedTopicId
 # @param Collection|Topic[] topics
 # @param int topicAll
 # @param int limit
 # @param int compactMode
 #}

{% set params = [
    'compactMode=' ~ compactMode,
    'p=' ~ pageNum,
    'l=' ~ limit
]|join('&')
%}

<dl class="tabs-material" data-tab="" id="{{ topicContainerId }}">

    {# Select "All" by default if the component config is set #}
    <dd {% if not selectedTopicId %}class="active"{% endif %}><a href="{{ routeLookup('commsNews.getListByTopic', {topicId: topicAll}) ~ '?' ~ params}}">All</a></dd>

    {% for topic in topics %}
        {% if topic.id == selectedTopicId %}
            {% set selected = 'class="active"' %}
        {% else %}
            {% set selected = '' %}
        {% endif %}

        <dd {{ selected|purify }}><a href="{{ routeLookup('commsNews.getListByTopic', {topicId: topic.id}) ~ '?' ~ params }}">{{ topic.name }}</a></dd>
    {% endfor %}
</dl>

