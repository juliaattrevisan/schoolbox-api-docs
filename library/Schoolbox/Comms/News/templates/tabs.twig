{##
 # A list of all the available Topics to chooze
 # Sets up a container for async article loading
 #
 # @param string url
 # @param string topicContainerId
 # @param Collection|Topic[] topics
 # @param int topicAll
 # @param string slug
 # @param int compactMode
 # @param int limit
 #}

{% set params = '' %}

{% if compactMode %}
    {% set params = params ~ '&c=' ~ compactMode %}
{% endif %}

{% if limit %}
    {% set params = params ~ '&l=' ~limit %}
{% endif %}

{% if showPaginator %}
    {% set params = params ~ '&sp=' ~ showPaginator %}
{% endif %}

<dl class="tabs" data-tab="" id="{{ topicContainerId }}">

    {# Select "All" by default if the component config is set #}
    <dd {% if slug == 'all' or not slug %}class="active"{% endif %}>
        <a href="{{ url ~ '?topic=' ~ topicAll ~ params}}">All</a>
    </dd>

    {% for topic in topics %}
        {% if topic.getSlug == slug %}
            {% set selected = 'class="active"' %}
        {% else %}
            {% set selected = '' %}
        {% endif %}

        <dd {{ selected|purify }}>
            <a href="{{ url ~ '?&topic=' ~ topic.getSlug ~ params }}">{{ topic.name }}</a>
        </dd>
    {% endfor %}
</dl>

