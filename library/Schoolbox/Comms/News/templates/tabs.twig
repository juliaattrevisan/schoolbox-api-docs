{##
 # A list of all the available Topics to chooze
 # Sets up a container for async article loading
 #
 # @param string url
 # @param string topicContainerId
 # @param Collection|Topic[] topics
 # @param int topicAll
 # @param string slug
 # @param int|null compactMode
 # @param int|null limit
 # @param int|null folderId
 # @param bool hidePaginator
 # @param string referrer
 #}

{% set params = '' %}

{% if compactMode %}
    {% set params = params ~ '&c=' ~ compactMode %}
{% endif %}

{% if limit is not null %}
    {% set params = params ~ '&l=' ~limit %}
{% endif %}

{% if folderId %}
    {% set params = params ~ '&f=' ~ folderId %}
{% endif %}

{% if referrer %}
    {% set params = params ~ '&ref=' ~ referrer %}
{% endif %}

{% if componentId %}
    {% set params = params ~ '&cid=' ~ componentId %}
{% endif %}

{# The paginator is enabled by default
 # You can provide a param here to turn it off
 #}
{% if hidePaginator is defined and hidePagenator %}
    {% set params = params ~ '&hp=1' %}
{% endif %}

<dl class="tabs" data-tab="" id="{{ topicContainerId }}">

    {# Select "All" by default if the component config is set #}
    <dd {% if slug == 'all' or not slug %}class="active"{% endif %}>
        <a href="{{ url ~ '?topic=' ~ topicAll ~ params}}">All</a>
    </dd>

    {% for topic in topics %}
        {% if topic.getSlug == slug %}
            {% set selected = 'class="active"' %}
        {% else %}
            {% set selected = '' %}
        {% endif %}

        <dd {{ selected|purify }}>
            <a href="{{ url ~ '?topic=' ~ topic.getSlug ~ params }}">{{ topic.name }}</a>
        </dd>
    {% endfor %}
</dl>

