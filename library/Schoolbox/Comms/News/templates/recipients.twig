{% if users|length %}
<ul class="information-list">
    {% for user in users %}
    <li>
        <div class="card small-12">
            <a href="#" title="View Profile">
                <img src="/portrait.php?userId={{ user.externalId }}&size=square64" alt="View Profile" />
                <p>{{ user.fullname }}</p>
            </a>
            <p class="meta">{{ user.role.name }}</p>
        </div>
    </li>
    {% endfor %}
</ul>
{% else %}
    <p>No recipients were found for this {{ locale.news }}.</p>
{% endif %}