{% import _self as macro %}

{##
 # Pacify $text by removing everything except <p> tags
 # Cut to the maximum length specified
 # Provide a "Read More" link if specified
 #
 # @param News\Model article
 # @param string readMore
 #}
{% macro pacify(article, readMore) %}
{% spaceless %}
    {% set pacified = article.blurb|striptags %}

    {# If the blurb was nonexistent, assume some body content instead #}
    {% if pacified|length == 0 %}
        {% set pacified = article.body|striptags %}
    {% endif %}

    {# Maximum length chars #}
    {% set max = 300 %}

    {# Split on the nearest word #}
    {% if pacified|length > max %}
        {% set detailUrl = routeLookup('commsNews.getDetail', {articleId: article.id}) %}
        {% set pacified = pacified|slice(0, max+1)|split(' ')|slice(0, -1)|join(' ') ~ '...'%}

        {# If read_more policy has a value, append a "Read More" style link
         # Otherwise, don't do anything except the appended  ellipsis
         #}
        {% if readMore|length %}
            {% set pacified = pacified ~ '<a href="' ~ detailUrl ~ '" title="Read more">' ~ readMore ~ '</a>' %}
        {% endif %}
    {% endif %}

    {{ pacified|trim|purify }}
{% endspaceless %}
{% endmacro %}

{##
 # A list of news articles that can be seen by the world
 # Typically async'd into components
 #
 # @param Collection|News\Model[] articles
 # @param array|int[] savedArticleIds
 # @param int unsaved
 # @param int compactMode
 # @param bool hidePaginator
 #}
{% if articles|length %}
    <ul class="information-list">
        {% for article in articles %}
            <li class="actions-small-1">
                <div class="list-item">
                    <div class="small-12 card">

                        {% if article.featureImage.hash %}
                            <a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}?ref={{ referrer }}">
                                <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=square64">
                            </a>
                        {% endif %}

                        <h3><a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}?ref={{ referrer }}">{{ article.title }}</a></h3>

                        <p class="meta">Published by
                            {% if article.author.deletedAt.isNull %}
                                <a href="/search/user/{{ article.author.id }}" title="View Profile">{{ article.author.fullname }}</a>
                            {% else %}
                                {{ article.author.fullname }}
                            {% endif %}
                            <time title="{{ article.publishAt.local }}">{{ article.publishAt.relativeTime }}</time>
                        </p>

                        {% if article.topics|length %}
                            <p class="meta">Related topics:
                                {% for topic in article.topics %}
                                    <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </p>
                        {% endif %}
                    </div>
                </div>
                <nav>
                    {% set modifyRoute = routeLookupIfAuthorized('commsNews.getUpdate', {article: article, articleId: article.id}) %}
                    {% if modifyRoute %}
                        <a class="icon-modify" href="{{ routeLookup('commsNews.getUpdate', { article: article, articleId: article.id }) }}" title="Modify this {{ locale.news }}"></a>
                    {% endif %}
                    {% include '@commsNewsSaveForLater/activator.twig' with {
                        article: article,
                        isSaved: savedArticleIds[article.id]
                    } only %}
                </nav>

                {# Hide the article tag when there's no content to show, or when compactMode is on #}
                {% if not compactMode %}
                    {% set blurb = macro.pacify(article, readMore) %}

                    {% if blurb|length %}
                    <article>{{ blurb }}</article>
                    {% endif %}
                {% endif %}
            </li>
        {% endfor %}
    </ul>

    {# Paginator is enabled by default #}
    {% if not hidePaginator %}
        {% include 'sub/paginator.twig' with {
            paginator: paginator,
            page: pageNum
        } %}
    {% endif %}
{% else %}
    <div class="empty-state no-margin">
        <i class="icon-news"></i>
        {% set createRoute = routeLookupIfAuthorized('commsNews.getCreate') %}
        {% if createRoute and not readonly %}
            <p><a href="{{ createRoute }}">Post a {{ locale.news }} article</a> to share new information on this homepage.</p>
        {% else %}
            <p>There is no {{ locale.news }} to view at this time.</p>
        {% endif %}
    </div>
{% endif %}
