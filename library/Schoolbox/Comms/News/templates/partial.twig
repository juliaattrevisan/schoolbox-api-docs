{#
 # A list of news articles that can be seen by the world
 # Typically async'd into components
 #
 # @deprecated use article-list.twig instead
 #
 # @param int $componentId                    A component id in which this partial was spawned, if available (null otherwise)
 # @param Collection|News\Model[] $articles   A set of article instances
 # @param array $attachmentCounts             A set of (article_id, count) tuples
 # @param array|int[] $savedArticleIds        A stack of article_id
 # @param int $unsaved                        A const int indicating whether this article is in your Saved For Later list
 # @param int $compactMode                    Whether the payload should be in compact mode or not
 # @param bool $hidePaginator                 Optionally hide the paginator ui element
 # @param array $fallbackImage                A tuple containing (type, hash) keys
 #}
{% if articles|length %}
    {% import '@commsNews/macro/newsBlurb.twig' as macro %}

    <ul class="information-list">
        {% for article in articles %}
            <li class="actions-small-2 {{ article.sticky ? 'sticky' : '' }}">
                <div class="list-item">
                    <div class="small-12 card wrap-down">
                        {% set articleURL = routeLookup('commsNews.getDetail', {article: article, articleId: article.id}) ~ '?ref=' ~ referrer %}

                        {% if article.featureImage %}
                            <a href="{{ articleURL }}">
                                <img src="/storage/image.php?hash={{ article.featureImage.hash }}&size=square64">
                            </a>
                        {% elseif fallbackImage.type == 'school-logo' %}
                            <a href="{{ articleURL }}">
                                <img src="/images/logo.php?logo=skin_logo_large&size=favicon">
                            </a>
                        {% elseif fallbackImage.type == 'author' %}
                            {% if article.author.portrait and article.author.portrait.hash %}
                                <a href="{{ articleURL }}">
                                    <img src="/storage/image.php?hash={{ article.author.portrait.hash }}&size=square64">
                                </a>
                            {% endif %}
                        {% endif %}

                        <h3><a href="{{ articleURL }}">{{ article.title }}</a></h3>

                        <p class="meta">
                            {% if article.sticky %}Pinned by{% else %}By{% endif %}
                            {% if article.author.deletedAt.isNull %}
                                <a href="/search/user/{{ article.author.id }}" title="View Profile">{{ article.author.fullname }}</a>
                            {% else %}
                                {{ article.author.fullname }}
                            {% endif %}
                            <time title="{{ article.publishAt.long }}"> &mdash; {{ article.publishAt.relativeTime }}</time>

                            {% if article.topics|length %}
                                <span class="meta">in
                                {% for topic in article.topics %}
                                    <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                                {% endfor %}
                                </span>
                            {% endif %}
                            {% if article.metadata and article.metadata.commentCount > 0 %}
                            <span> | <a href="{{ articleURL ~ '#discussion' }}">{{ article.metadata.commentCount }} comment{{ article.metadata.commentCount > 1 ? 's':'' }}</a></span>
                            {% endif %}

                            {# Attachment Count #}
                            {% if attachmentCounts[article.id] ?? false %}
                            <span>
                                | <a href="{{ articleURL }}#article-attachments">{{ attachmentCounts[article.id] }} attachments</a>
                            </span>
                            {% endif %}
                        </p>
                    </div>
                </div>
                <nav>
                    {% set modifyRoute = routeLookupIfAuthorized('commsNews.getUpdate', {article: article, articleId: article.id}) %}
                    {% if modifyRoute %}
                        <a class="icon-modify" href="{{ modifyRoute }}" title="Modify this {{ locale.news }}"></a>
                    {% endif %}
                    {% if config.save_for_later %}
                    {% include '@commsNewsSaveForLater/activator.twig' with {
                        article: article,
                        isSaved: savedArticleIds[article.id] is defined
                    } only %}
                    {% endif %}
                </nav>

                {# Show article tag only when there's a content to show and render article's blurb generated by the macro when compact mode is on, otherwise render article's body. #}
                {% set textToDisplay = compactMode ? macro.newsBlurb(article) : article.body %}
                {% set hasReadMore = readMores[article.id].available %}

                {% if textToDisplay|trim|length or hasReadMore %}
                    {% apply spaceless %}
                        <article>
                            {# Unfortunately, we can't add a filter (purify) in the ternary above. So we need to do this for now. #}
                            {% if compactMode %}
                                {{ textToDisplay }}
                            {% else %}
                                {{ textToDisplay|purify }}
                            {% endif %}

                            {% if readMores[article.id].available %}
                                {% set detailUrl = routeLookup('commsNews.getDetail', {articleId: article.id}) %}
                                {% set readMoreLink = '<div class="article-read-more"><a href="' ~ detailUrl ~ '" title="Read more">' ~ readMores[article.id].string ~ '</a></div>' %}

                                {{ readMoreLink|trim|purify }}
                            {% endif %}
                        </article>

                        {# The only time files are rendered via partial.twig is in a homepage context
                         # when users are viewing the non-compact-mode version of their component
                         # Compact Mode usage and Archive usage shouldn't render the file list
                         #}
                        {% if componentId is defined and componentId %}
                            {% include ('@commsNews/layout/file-list.twig') with {
                                article: article,
                                identifier: 'component-' ~ (componentId ?? '') ~ '-article-' ~ article.id
                            } %}
                        {% endif %}
                    {% endapply %}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
    {# Paginator is enabled by default #}
    {% if not hidePaginator %}
        {% include 'sub/paginator.twig' with {
            paginator: paginator,
            page: pageNum
        } %}
    {% endif %}

{% else %} {# Empty States #}
    {% if referrer == 'homepage' %}
        {% set createRoute = routeLookupIfAuthorized('commsNews.getCreateInFolder', {folderId: folderId}) %}
        {% set archiveRoute = routeLookupIfAuthorized('commsNews.getArchive') %}
        {% set archiveRouteSuffix = [
            'f=' ~ folderId,
            'cid=' ~ componentId
        ] |join('&') %}
        <div class="empty-state no-margin">
            <i class="icon-news"></i>
            {% if not createRoute %}
                <p>There is no {{ locale.news }} to view at this time.</p>
                {% if archiveRoute and showArchiveNewsLink %}
                    <p><a href="{{ archiveRoute ~ '?' ~archiveRouteSuffix }}">View the news archive.</a></p>
                {% endif %}
            {% else %}
                {% set createNewsQuerystringParams = [
                    'groupId=' ~ folderId,
                    'type=folder'
                ]|join('&') %}

                {% set createRouteFullPath = createRoute ~ "?" ~ createNewsQuerystringParams %}

                {% set emptyStateMessage = [
                    '<a href="'~ createRouteFullPath ~ '">Post a ' ~ locale.news ~ ' article</a> to share new information on this homepage'
                ] %}

                {% if archiveRoute and showArchiveNewsLink %}
                    {% set emptyStateMessage = emptyStateMessage|merge([
                        ' or <a href="'~ archiveRoute ~ '?' ~ archiveRouteSuffix ~'">view the ' ~ locale.news ~ ' archive</a>'
                    ]) %}
                {% endif %}

                {% set emptyStateMessage = emptyStateMessage|join(',') ~ "." %}

                <p>{{ emptyStateMessage|raw }}</p>
            {% endif %}
        </div>
    {% else %}
        <div class="empty-state no-margin">
            <i class="icon-news"></i>
            <p>
                There is no {{ locale.news }} in this topic to view at this time.
            </p>
        </div>
    {% endif %}

{% endif %}
