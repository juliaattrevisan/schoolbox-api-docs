{% import '@commsNews/indicator.twig' as indicator %}

<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" src="/javascript/shared/comms/draft.js"></script>
<script src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>

<script>
    $(function () {

        {# CKEditors #}
        $.fn.alaressEditor({
            targetElements: $('#createForm textarea[name=body]')
        });

        $.fn.alaressEditor({
            targetElements: $('#createForm textarea[name=blurb]'),
            removePlugins: 'autoembed,uploadimage,schoolboxresource,schoolboxiframe,link'
        });

        {# Drafting mechanism #}
        $('#createForm').draft({
            inputs: ['title', 'publishAt', 'expiresAt'],
            textareas: ['body', 'blurb']
        });

        $('[data-tags]').selectizeSelector({
            ajax: {
                url:      '{{ routeLookup('commsNews.getTags') }}',
                type:     'GET',
                dataType: 'json'
            },
            selectize: {
                placeholder: 'Assign Topics'
            },
            value: {{ news.tags|json_encode|raw }},
            multiple: true
        });
    });
</script>
<div class="row">
    <div class="small-12 island">
        <h1>{{ action|capitalize }} {{ locale.news.proper }} {{ indicator.render(news) }}</h1>

        <ul class="meta">
            {% if news.publishAt %}
            <li class="icon-calendar">Publishes to audience on {{ news.publishAt.local }}</li>
            {% endif %}

            {% if news.expiresAt %}
            <li class="icon-calendar">Automatically archives on {{ news.expiresAt.local }}</li>
            {% endif %}

            {% if news.moderatedBy.id %}
            <li class="icon-staff">Last moderated by {{ news.moderatedBy.fullname }}
                {% if not news.moderatedAt.isNull %}
                    on {{ news.moderatedAt.local }}
                {% endif %}
            </li>
            {% endif %}
        </ul>
    </div>
</div>

{% if policies['global_moderation'].value %}
<div class="row">
    <div class="small-12 columns">
        <div class="alert-box">
            Moderation is required for this {{ locale.news.proper }} article. You can review <a href="{{ routeLookup('commsNewsPolicy.getPolicies') }}" title="view policy settings" target="_blank">current policy settings</a>.
        </div>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">

        {% if news.id %}
            {% set formAction = routeLookupIfAuthorized('commsNews.postUpdate', {newsId: news.id}) %}
        {% else %}
            {% set formAction = routeLookupIfAuthorized('commsNews.postCreate') %}
        {% endif %}

        <form id="createForm" action="{{ formAction }}" method="post">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Title</label>
                        <input name="title" type="text" maxlength="255" value="{{ news.title }}" />
                    </div>

                    <div class="small-12 columns">
                        <label>Body</label>
                        <textarea name="body">{{ news.body }}</textarea>
                    </div>

                    <div class="small-12 columns">
                        <label>Blurb</label>
                        <textarea name="blurb">{{ news.blurb }}</textarea>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Feature Image</label>
                        <p class="meta">Attach a feature image to represent your {{ locale.news.proper }} article.</p>

                        {% include 'sub/attachzone.twig' with { attachzone: featureImageZone } %}
                    </div>
                </fieldset>

                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Topics</label>
                        <p class="meta">You can assign multiple <a href="{{ routeLookup('commsNewsPolicy.getPolicies') }}#topics" title="Find a list of available topics" target="_blank">topics</a> to this {{ locale.news.proper }} article to adjust its exposure.</p>
                        <select data-tags name="tags[]" multiple></select>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Availability</legend>
                    <div class="small-12 large-6 columns">
                        <label for="publishAt">
                            Publish Date
                            <p class="meta">This article becomes available to its audience once this date and time is reached.</p>
                            <input type="text" class="required" name="publishAt" id="publishAt" data-datepicker data-datepicker-time data-datesync-enddate="#expiresAt" maxlength="50" value="{{ news.publishAt.local }}"/>
                        </label>
                    </div>
                    <div class="small-12 large-6 columns">
                        <label for="expiresAt">
                            Expiry Date
                            <p class="meta">This article is automatically archived once this expiry date is reached.</p>
                        </label>
                        <input type="text" class="required" name="expiresAt" id="expiresAt" data-datepicker data-datepicker-time data-datesync-startdate="#publishAt" maxlength="50" value="{{ news.expiresAt.local }}"/>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action|capitalize }} {{ locale.news }}"/>
        </form>
    </div>
</div>

<div class="toast" id="saveDraft"></div>