{% import '@commsNews/indicator.twig' as indicator %}

<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" src="/javascript/shared/comms/draft.js"></script>
<script src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>

<script>
    $(function () {

        {# CKEditors #}
        $.fn.alaressEditor({
            targetElements: $('#createForm textarea[name=body]')
        });

        $.fn.alaressEditor({
            targetElements: $('#createForm textarea[name=blurb]'),
            removePlugins: 'autoembed,uploadimage,schoolboxresource,schoolboxiframe,link'
        });

        {# Drafting mechanism #}
        $('#createForm').draft({
            inputs: ['title', 'publishAt', 'expiresAt'],
            textareas: ['body', 'blurb'],
            attachzones: ['attachment']
        });

        $('[data-topics]').selectizeSelector({
            ajax: {
                url:      '{{ routeLookup('commsNews.getTopics') }}',
                type:     'GET',
                dataType: 'json'
            },
            selectize: {
                placeholder: 'Assign Topics'
            },
            value: {{ article.topics|json_encode|raw }},
            multiple: true
        });

        $('#audience-search').selectizeSelector({
            multiple: true,
            {% if audienceList | length > 0 %} value: {{ audienceList }}, {% endif %}
            ajax: {
                url:      '/ajax/audience.php',
                type:     'GET',
                data:     {groupID: 50},
                dataType: 'json'
            }
        });

    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>{{ action|capitalize }} {{ locale.news }} {{ indicator.render(article) }}</h1>
        <ul class="meta">
            {% if article.acceptedBy.id %}
                <li class="icon-staff">Last moderated by {{ article.acceptedBy.fullname }}
                    {% if article.isAccepted %}
                        on {{ article.acceptedAt.local }}
                    {% endif %}
                </li>
            {% endif %}
        </ul>
    </div>
</div>


{# Train Line #}
{% include '@commsNews/workflow.twig' with {
    article: article,
    moderationRequired: policies['global_moderation'].value
} %}

{% if policies['global_moderation'].value %}
<div class="row">
    <div class="small-12 columns">
        <div class="alert-box">
            Moderation is required for this {{ locale.news }}. You can review <a href="{{ routeLookup('commsNewsPolicy.getPolicies') }}" title="view policy settings" target="_blank">current policy settings</a>.
        </div>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">

        {% if article.id %}
            {% set formAction = routeLookupIfAuthorized('commsNews.postUpdate', {articleId: article.id}) %}
        {% else %}
            {% set formAction = routeLookupIfAuthorized('commsNews.postCreate') %}
        {% endif %}

        <form id="createForm" action="{{ formAction }}" method="post">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Title</label>
                        <input name="title" type="text" maxlength="255" value="{{ article.title }}" />
                    </div>

                    <div class="small-12 columns">
                        <label>Body</label>
                        <textarea name="body">{{ article.body }}</textarea>
                    </div>

                    <div class="small-12 columns">
                        <label>Blurb</label>
                        <textarea name="blurb">{{ article.blurb }}</textarea>
                    </div>
                </fieldset>

                <fieldset class="content" id="audience-select-container">

                    <div class="small-12 columns">
                        <label>Audience</label>
                        <p class="meta">Target your article. Search for campuses, year levels, groups, people, or use Browse to find your audience.</p>
                        <div class="input-group">
                            <input type="text" id="audience-search" />
                            <button class="button icon-drag-drop" @click.prevent="openBrowseModal">Browse...</button>
                        </div>
                    </div>

                    {# the modal #}
                    <div data-reveal id="audience-browse" class="reveal-modal">
                        <h2>Browse Audience</h2>
                        <a class="close-reveal-modal" aria-label="Close">×</a>

                        <div v-show="audienceSelectPage1">
                            <div class="small-12 medium-4 columns" v-for="audienceOption in audienceOptions">
                                <button class="button-block" @click="changePage(audienceOption)">
                                    <i v-bind:class="'icon-' + audienceOption.icon"></i>
                                    ${ audienceOption.name }
                                </button>
                            </div>
                        </div>

                        <div v-show="audienceSelectPage2">

                            <ul class="breadcrumb" style="margin-bottom:10px;">
                                <li><a href="#" @click.prevent="audienceSelectReturn">Browse Audience</a></li>
                                <li class="active"><a>${ audienceSelectBreadcrumb }</a></li>
                            </ul>

                            <p class="meta">Some help text here</p>

                            <fieldset class="checklist checklist-table" id="audience-select-options">
                                <template v-for="audienceListItem in audienceListItems">
                                    <input v-bind:id="'audience-list-' + audienceListItem.id" type="checkbox" />
                                    <label v-bind:for="'audience-list-' + audienceListItem.id">${ audienceListItem.label }</label>
                                </template>
                            </fieldset>

                            <fieldset class="checklist" id="" style="border: none;">
                                <input id="checkbox6" type="checkbox" checked /><label for="checkbox6" id="audience-select-checkbox-label">${ audienceSelectCheckbox }</label>
                                <input id="checkbox7" type="checkbox" /><label for="checkbox7">Parents of students</label>
                            </fieldset>

                            <button class="button submit" @click.prevent="addAudience">Add</button>

                        </div>

                    </div>
                </fieldset>

                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Feature Image</label>
                        <p class="meta">Attach a feature image to represent your {{ locale.article.proper }} article.</p>

                        {% include 'sub/attachzone.twig' with { attachzone: featureImageZone } %}
                    </div>
                </fieldset>

                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Topics</label>
                        <p class="meta">You can assign multiple <a href="{{ routeLookup('commsNewsPolicy.getPolicies') }}#topics" title="Find a list of available topics" target="_blank">topics</a> to this {{ locale.news }} to adjust its exposure.</p>
                        <select data-topics name="topics[]" multiple></select>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Availability</legend>
                    <div class="small-12 large-6 columns">
                        <label for="publishAt">
                            Publish Date
                        </label>
                        <p class="meta">This article becomes available to its audience once this date and time is reached.</p>
                        <input type="text" class="required" name="publishAt" id="publishAt" data-datepicker data-datepicker-time data-datesync-enddate="#expiresAt" maxlength="50" value="{{ article.publishAt.local }}"/>
                    </div>
                    <div class="small-12 large-6 columns">
                        <label for="expiresAt">
                            Expiry Date
                        </label>
                        <p class="meta">This article is automatically archived once this expiry date is reached.</p>
                        <input type="text" class="required" name="expiresAt" id="expiresAt" data-datepicker data-datepicker-time data-datesync-startdate="#publishAt" maxlength="50" value="{{ article.expiresAt.local }}"/>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="Preview" />
        </form>
    </div>
</div>

<div class="toast" id="saveDraft"></div>

<div data-reveal="" id="audience-browse" class="reveal-modal">
    <h2>Browse Audience</h2>
    <a class="close-reveal-modal" aria-label="Close">×</a>

    <div v-show="audienceSelectPage1">
        <div class="small-12 medium-4 columns" v-for="audienceOption in audienceOptions">
            <button class="button-block" @click="changePage(audienceOption)">
                <i v-bind:class="'icon-' + audienceOption.icon"></i>
                ${ audienceOption.name }
            </button>
        </div>
    </div>

    <div v-show="audienceSelectPage2">

        <ul class="breadcrumb" style="margin-bottom:10px;">
            <li><a href="#" @click.prevent="audienceSelectReturn">Browse Audience</a></li>
            <li class="active"><a>${ audienceSelectBreadcrumb }</a></li>
        </ul>

        <p class="meta">Some help text here</p>

        <form @submit.prevent="addAudience">
            <fieldset class="checklist checklist-table" id="audience-select-options">
                <template v-for="audienceListItem in audienceListItems">
                    <input v-bind:id="'audience-list-' + audienceListItem.id" type="checkbox" />
                    <label v-bind:for="'audience-list-' + audienceListItem.id">${ audienceListItem.label }</label>
                </template>
            </fieldset>

            <fieldset class="checklist" id="" style="border: none;">
                <input id="checkbox6" type="checkbox" checked /><label for="checkbox6" id="audience-select-checkbox-label">${ audienceSelectCheckbox }</label>
                <input id="checkbox7" type="checkbox" /><label for="checkbox7">Parents of students</label>
            </fieldset>

            <button type="submit" class="button">Add</button>
        </form>

    </div>

</div>

<style>
    .checklist-table {
        padding: 0;
        height: 200px;
        overflow-y: scroll;
    }

    .checklist-table input {
        border: none;
    }

    .checklist-table input:checked + label {
        background: #eee;
    }

    .checklist-table label {
        border-bottom: 1px solid #eee;
        margin: 0 !important;
        padding: 0.5rem 0 0.5rem 2rem !important;
    }

    .checklist-table label:before {
        background: none !important;
    }

    .checklist.checklist-table input[type=checkbox]:not(.plain) + label:after,
    .checklist.checklist-table input[type=checkbox]:not(.plain) + label:before {
        padding: 0.5rem 0 0.5rem 0 !important;
    }

    .checklist.checklist-table input[type=checkbox]:not(.plain):checked + label:hover:after,
    .checklist.checklist-table input[type=checkbox]:not(.plain):checked + label:hover:before {
        background-color: transparent !important;
    }

    .checklist.checklist-table input[type=checkbox]:not(.plain):checked + label:after,
    .checklist.checklist-table input[type=checkbox]:not(.plain):checked + label:before {
        background-color: transparent !important;
    }

    .checklist-table label:hover {
        background: #f0f0f0;
    }

    .checklist-table.checklist input[type=radio]:not(.plain):not(:disabled) + label:hover:before,
    .checklist-table.checklist input[type=radio]:not(.plain):not(:disabled) + label:hover:after,
    .checklist-table.checklist input[type=checkbox]:not(.plain):not(:disabled) + label:hover:before,
    .checklist-table.checklist input[type=checkbox]:not(.plain):not(:disabled) + label:hover:after {
        background-color: transparent !important;
    }

</style>

<script>

    var app = new Vue({
        el: '#audience-select-container',
        delimiters: ['${', '}'],
        data: {

            // Modal options
            audienceOptions: {
                campus: {
                    name: 'Campuses',
                    icon: 'location',
                    checkbox: 'Students in campus',
                    ajax: 'campus/all'
                },
                roles: {
                    name: 'Roles',
                    icon: 'staff-students',
                    checkbox: 'Users in role',
                    ajax: 'roles/all'
                },
                houses: {
                    name: 'Houses',
                    icon: 'home',
                    checkbox: 'House members',
                    ajax: 'house/all'
                },
                classes: {
                    name: 'Classes',
                    icon: 'teacher',
                    checkbox: 'Users in class',
                    ajax: 'class/all'
                },
                groups: {
                    name: 'Groups',
                    icon: 'group',
                    checkbox: 'Group members',
                    ajax: 'group/all'
                },
                pastoralGroups: {
                    name: 'Pastoral Groups',
                    icon: 'pastoral',
                    checkbox: 'Group members',
                    ajax: 'pastoral_groups/all'
                },
            },

            // Modal sections
            audienceSelectPage1: true,
            audienceSelectPage2: false,

            // Page 2 specifics
            audienceSelectBreadcrumb: '',
            audienceSelectCheckbox: '',
            audienceListItems: [
                {
                    id: 1,
                    label: 'Administration'
                },
                {
                    id: 2,
                    label: 'Teacher'
                },
                {
                    id: 3,
                    label: 'Senior Student'
                },
                {
                    id: 4,
                    label: 'Junior Student'
                },
                {
                    id: 5,
                    label: 'Parent'
                }
            ]
        },
        methods: {
            openBrowseModal: function () {
                // Reset everythang
                this.audienceSelectPage1 = true;
                this.audienceSelectPage2 = false;

                // Open the modal
                $('#audience-browse').foundation('reveal', 'open');
            },

            // Selecting an initial page
            changePage: function (audienceOption) {
                this.audienceSelectPage1 = false;
                this.audienceSelectPage2 = true;
                this.audienceSelectBreadcrumb = audienceOption.name;
                this.audienceSelectCheckbox = audienceOption.checkbox;

                // Get the list of options via ajax
                axios.get(audienceOption.ajax);
            },

            // Returning back to the initial page
            audienceSelectReturn: function () {
                this.audienceSelectPage1 = true;
                this.audienceSelectPage2 = false;
            },

            // Submitting the modal form
            addAudience: function () {
                // Add to selectize

                // Close modal
                $('#audience-browse').foundation('reveal', 'close');
            }
        }
    });
</script>