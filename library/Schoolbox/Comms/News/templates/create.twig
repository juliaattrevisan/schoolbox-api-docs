{% import '@commsNews/indicator.twig' as indicator %}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ action|capitalize }} {{ locale.news }} {{ indicator.render(article) }}</h1>
        <ul class="meta">
            {% if article.acceptedBy.id %}
                <li class="icon-staff">Last moderated by {{ article.acceptedBy.fullname }}
                    {% if article.isAccepted %}
                        on {{ article.acceptedAt.local }}
                    {% endif %}
                </li>
            {% endif %}
        </ul>
    </div>
</div>

{# Train Line #}
{% include '@commsNews/workflow.twig' with {
    article: article,
    moderationRequired: policies['global_moderation'].value
} %}

{% if policies['global_moderation'].value %}
<div class="row">
    <div class="small-12 columns">
        <div class="alert-box">
            Moderation is required for this {{ locale.news }}. You can review <a href="{{ routeLookup('commsNewsPolicy.getPolicies') }}" title="view policy settings" target="_blank">current policy settings</a>.
        </div>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">

        {% if article.id %}
            {% set formAction = routeLookupIfAuthorized('commsNews.postUpdate', {article: article, articleId: article.id}) %}
        {% else %}
            {% set formAction = routeLookupIfAuthorized('commsNews.postCreate') %}
        {% endif %}

        <form id="createForm" action="{{ formAction }}" method="post">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Title</label>
                        <input name="title" type="text" maxlength="255" value="{{ article.title }}" />
                    </div>

                    <div class="small-12 columns">
                        <label>Body</label>
                        <textarea name="body">{{ article.body }}</textarea>
                    </div>

                    <div class="small-12 columns">
                        <label>Blurb</label>
                        <textarea name="blurb">{{ article.blurb }}</textarea>
                    </div>
                </fieldset>

                <fieldset class="content" id="audience-select-container">

                    {% if user.role.staff %}
                        {% set audiencePlaceholder = 'Search for classes, groups, year levels, roles, campuses, individual users...' %}
                    {% else %}
                        {% set audiencePlaceholder = 'Search for classes or groups...' %}
                    {% endif %}

                    <div class="small-12 columns">
                        <label>Audience</label>
                        <p class="meta">Target your article to a specific audience. Use the input box below to search, or use the 'Browse' button to select from a list of available options.</p>

                        <ul class="grid small-block-grid-1 medium-block-grid-2 large-block-grid-4 audience-grid" v-show="selectedAudienceItems.length">
                            <li v-for="selectedAudienceItem in selectedAudienceItems">
                                <div class="actions-small-1">
                                    <div class="card small-12">
                                        <h4 :title="selectedAudienceItem.name">${ selectedAudienceItem.name }</h4>
                                        <p class="meta">
                                            <a href="#" v-if="selectedAudienceItem.compositeModal" @click.prevent="showCompositeInfo(selectedAudienceItem)">${ selectedAudienceItem.entityType }</a>
                                            <slot v-if="!selectedAudienceItem.compositeModal">${ selectedAudienceItem.entityType }</slot>
                                        </p>
                                        <p class="meta" :title="selectedAudienceItem.modifier">
                                            <a href="#" v-if="selectedAudienceItem.compositeModal" @click.prevent="showCompositeInfo(selectedAudienceItem)">${ selectedAudienceItem.modifier }</a>
                                            <slot v-if="!selectedAudienceItem.compositeModal">${ selectedAudienceItem.modifier }</slot>
                                        </p>
                                    </div>
                                    <nav>
                                        <a class="icon-close size-8" :title="'Remove ' + selectedAudienceItem.name + ' from audience'" @click="removeAudienceItem(selectedAudienceItem)"></a>
                                    </nav>
                                </div>
                            </li>
                        </ul>

                        <div class="input-group">
                            <input type="text" id="audience-search" name="audience" placeholder="{{ audiencePlaceholder }}" />
                            <button class="button icon-drag-drop" @click.prevent="{{ (user.role.staff) ? 'openBrowseModal' : 'openBrowseModalRead' }}">Browse&hellip;</button>
                        </div>
                    </div>

                    {# audience browser modal #}
                    <div data-reveal id="audience-browse" class="reveal-modal">
                        <div class="audience-browse-head">
                            <h2>Browse Audience</h2>
                            <small class="advanced-toggle">
                                <a href="#" :class="{ active: pageShow.index || pageShow.valueSelect }" @click.prevent="showPage('index')">Simple</a>
                                |
                                <a href="#" :class="{ active: pageShow.intersect }" @click.prevent="advancedToggle()">Advanced</a>
                            </small>
                        </div>
                        <a class="close-reveal-modal" aria-label="Close">×</a>

                        <div v-show="pageShow.index">
                            <div class="small-12 medium-4 columns" v-for="audienceOption in audienceOptions.base">
                                <button class="button-block" @click="changePage(audienceOption)">
                                    <i :class="'icon-' + audienceOption.icon"></i>
                                    ${ audienceOption.namePlural }
                                </button>
                            </div>
                        </div>

                        <div v-show="pageShow.valueSelect">
                            <ul class="breadcrumb" v-show="writeOnly">
                                <li><a href="#" @click.prevent="showPage('index')">Audience Types</a></li>
                                <li class="active"><a>${ selectedAudienceOption.namePlural }</a></li>
                            </ul>

                            <p class="meta">Select ${ selectedAudienceOption.namePlural } below, then choose whether you would like to include the users themselves, the parents of the users, the teachers of the users, or a combination.</p>

                            <div class="empty-state" v-show="showEmptyState">
                                <p>No ${ selectedAudienceOption.namePlural } found.</p>
                            </div>

                            <fieldset class="checklist checklist-container" v-show="!showEmptyState">
                                <div class="loader" v-show="showLoader"></div>
                                <template v-for="(audienceListItem, index) in audienceListItems">
                                    <input type="checkbox" :id="'audience-list-input-' + index" :value="audienceListItem" v-model="audienceListChecked" />
                                    <label :for="'audience-list-input-' + index">${ audienceListItem.self.name }</label>
                                </template>
                            </fieldset>

                            <fieldset class="checklist border-none" v-show="writeOnly">
                                <input type="checkbox" id="audience-select-users" v-model="includeUsers" />
                                <label for="audience-select-users">${ selectedAudienceOption.selfModifier }</label>
                                {% if user.role.staff %}
                                <input type="checkbox" id="audience-select-parents" v-model="includeParents" />
                                <label for="audience-select-parents">Parents of students</label>
                                <input type="checkbox" id="audience-select-teachers" v-model="includeTeachers" />
                                <label for="audience-select-teachers">Teachers of students</label>
                                {% endif %}
                            </fieldset>

                            <button class="button submit" @click.prevent="addAudience" :disabled="!submitEnable">Add</button>
                        </div>

                        <div v-show="pageShow.intersect">
                            <p class="meta">Use the two columns below to create an intersection audience segment. E.g. Parents in the Senior Campus</p>
                            <div class="small-12 medium-6 columns checklist">
                                <legend>
                                    <select @change="updateIntersectList('primary')" v-model="intersect.primary">
                                        <option :value="audienceOption" v-for="audienceOption in audienceOptions.intersect.primary">
                                            ${ audienceOption.name }
                                        </option>
                                    </select>
                                </legend>
                                <input type="checkbox" id="primary-all" v-model="selectAll.primary" @change="toggleSelectAll('primary')">
                                <label for="primary-all" class="checkbox-label">Select all</label>
                                <slot v-for="(item, index) in audienceListItemsIntersect.primary">
                                    <input type="checkbox" :id="'primary-' + index" :value="item.self" v-model="intersectList.primary">
                                    <label :for="'primary-' + index" class="checkbox-label">${ item.self.name }</label>
                                </slot>
                            </div>
                            <div class="small-12 medium-6 columns checklist">
                                <legend>
                                    <select @change="updateIntersectList('secondary')" v-model="intersect.secondary">
                                        <option :value="audienceOption" v-for="audienceOption in audienceOptions.intersect.secondary">
                                            ${ audienceOption.name }
                                        </option>
                                    </select>
                                </legend>
                                <input type="checkbox" id="secondary-all" v-model="selectAll.secondary" @change="toggleSelectAll('secondary')">
                                <label for="secondary-all" class="checkbox-label">Select all</label>
                                <slot v-for="(item, index) in audienceListItemsIntersect.secondary">
                                    <input type="checkbox" :id="'secondary-' + index" :value="item.self" v-model="intersectList.secondary">
                                    <label :for="'secondary-' + index" class="checkbox-label">${ item.self.name }</label>
                                </slot>
                            </div>
                            <button class="button submit" @click.prevent="addAudienceIntersect" :disabled="!submitEnableAdvanced">Add</button>
                        </div>

                    </div>

                    {# composite info modal #}
                    <div data-reveal id="audience-composite" class="reveal-modal">
                        <h2>Combination Details</h2>
                        <a class="close-reveal-modal" aria-label="Close">×</a>
                        <div class="small-12 medium-6 columns">
                            <h3>${ compositeTypes.primary.name }</h3>
                            <ul>
                                <li v-for="compositeItem in compositeInfo.primary">
                                    ${ compositeItem.values.name }
                                </li>
                            </ul>
                        </div>
                        <div class="small-12 medium-6 columns">
                            <h3>${ compositeTypes.secondary.name }</h3>
                            <ul>
                                <li v-for="compositeItem in compositeInfo.secondary">
                                    ${ compositeItem.values.name }
                                </li>
                            </ul>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Feature Image</label>
                        <p class="meta">Attach a feature image to represent your {{ locale.article.proper }} article.</p>

                        {% include 'sub/attachzone.twig' with { attachzone: featureImageZone } %}
                    </div>
                </fieldset>

                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Topics</label>
                        <p class="meta">You can assign multiple <a href="{{ routeLookup('commsNewsPolicy.getPolicies') }}#topics" title="Find a list of available topics" target="_blank">topics</a> to this {{ locale.news }} to adjust its exposure.</p>
                        <select data-topics name="topics[]" multiple></select>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Availability</legend>
                    <div class="small-12 large-6 columns">
                        <label for="publishAt">
                            Publish Date
                        </label>
                        <p class="meta">This article becomes available to its audience once this date and time is reached.</p>
                        <input type="text" class="required" name="publishAt" id="publishAt" data-datepicker data-datepicker-time data-datesync-enddate="#expiresAt" maxlength="50" value="{{ article.publishAt.local }}"/>
                    </div>
                    <div class="small-12 large-6 columns">
                        <label for="expiresAt">
                            Expiry Date
                        </label>
                        <p class="meta">This article is automatically archived once this expiry date is reached.</p>
                        <input type="text" class="required" name="expiresAt" id="expiresAt" data-datepicker data-datepicker-time data-datesync-startdate="#publishAt" maxlength="50" value="{{ article.expiresAt.local }}"/>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="Preview" />
        </form>
    </div>
</div>

<div class="toast" id="saveDraft"></div>

{# le scripts #}
<script src="/javascript/ckeditor/ckeditor.js"></script>
<script src="/javascript/shared/editor/jquery.editor.js"></script>
<script src="/javascript/shared/comms/draft.js"></script>
<script src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/shared/select-all/jquery.select-all.js"></script>
<script src="/javascript/components/schoolbox-vue.min.js"></script>
<script>
    'use strict';

    $(function () {
        {# CKEditors #}
        $.fn.alaressEditor({
            targetElements: $('#createForm textarea[name=body]')
        });

        $.fn.alaressEditor({
            targetElements: $('#createForm textarea[name=blurb]'),
            removePlugins: 'autoembed,uploadimage,schoolboxresource,schoolboxiframe,link'
        });

        {# Drafting mechanism #}
        $('#createForm').draft({
            inputs: ['title', 'publishAt', 'expiresAt', 'audience'],
            textareas: ['body', 'blurb'],
            attachzones: ['attachment']
        });

        $('[data-topics]').selectizeSelector({
            ajax: {
                url:      '{{ routeLookup('commsNews.getTopics') }}',
                type:     'GET',
                dataType: 'json'
            },
            selectize: {
                placeholder: 'Assign Topics'
            },
            value: {{ article.topics|json_encode|raw }},
            multiple: true
        });
    });

    var audienceOptions = {
        {% if user.role.staff %}
        'campus': {
            id: 'campus',
            name: 'Campus',
            namePlural: 'Campuses',
            icon: 'location',
            selfModifier: 'Users in campus',
            ajax: '/comms/news/audiencebrowser/campuses'
        },
        'role': {
            id: 'role',
            name: 'Role',
            namePlural: 'Roles',
            icon: 'staff-students',
            selfModifier: 'Users in role',
            ajax: '/comms/news/audiencebrowser/roles'
        },
        'school_house': {
            id: 'school_house',
            name: 'House',
            namePlural: 'Houses',
            icon: 'home',
            selfModifier: 'House members',
            ajax: '/comms/news/audiencebrowser/houses'
        },
        'year': {
            id: 'year',
            name: 'Year Level',
            namePlural: 'Year Levels',
            icon: 'teacher',
            selfModifier: 'Users in year level/s',
            ajax: '/comms/news/audiencebrowser/yearlevels'
        },
        {% endif %}
        'folder': {
            id: 'folder',
            name: 'Class/Group',
            namePlural: 'Classes & Groups',
            icon: 'group',
            selfModifier: 'Class/group members',
            ajax: '/comms/news/audiencebrowser/folders'
        },
        {% if user.role.staff %}
        'pastoral_group': {
            id: 'pastoral_group',
            name: 'Pastoral Group',
            namePlural: 'Pastoral Groups',
            icon: 'pastoral',
            selfModifier: 'Group members',
            ajax: '/comms/news/audiencebrowser/pastoralgroups'
        }
        {% endif %}
    };

    var app = new Vue({
        el: '#audience-select-container',
        delimiters: ['${', '}'],
        mounted: function() {
            var vue = this;

            // Audience Selectize
            // A blend of Vue and jQuery, what a world
            $('#audience-search').selectizeSelector({
                ajax: {
                    url: '{{ routeLookup('commsNewsAudienceBrowser.getSearch') }}',
                    type: 'GET',
                    dataType: 'json'
                },
                selectize: {
                    render: {
                        option: function(item, escape) {
                            return item.itemHtml;
                        }
                    },
                    onItemAdd: function(value, $item) {
                        // Selectize doesn't give us all the data of the selected item, find the item in the full list -_-
                        var selectedItem = this.options[value];

                        if (!selectedItem.intersect) {
                            // Loop through the current audience items and check for an item with the same name and entityType to append to
                            var baseItemKey;
                            for (var selectedAudienceItem in vue.selectedAudienceItems) {
                                if (
                                    vue.selectedAudienceItems[selectedAudienceItem].name === selectedItem.name &&
                                    vue.selectedAudienceItems[selectedAudienceItem].entityType === selectedItem.entityType
                                ) {
                                    baseItemKey = selectedAudienceItem;
                                }
                            }

                            if (baseItemKey) {
                                var baseItem = vue.selectedAudienceItems[baseItemKey];

                                // Add the modifier to the object
                                baseItem[selectedItem.modifierOriginal] = true;

                                // Create the new modifier summary based on what modifiers are set
                                var modifierSummary;

                                if (
                                    baseItem.self &&
                                    baseItem.parents_of &&
                                    baseItem.teachers_of
                                ) {
                                    modifierSummary = '(Inc. teachers & parents of students)';
                                } else if (
                                    baseItem.self &&
                                    baseItem.parents_of
                                ) {
                                    modifierSummary = '(Inc. parents of students)';
                                } else if (
                                    baseItem.self &&
                                    baseItem.teachers_of
                                ) {
                                    modifierSummary = '(Inc. teachers of students)';
                                } else if (
                                    baseItem.parents_of &&
                                    baseItem.teachers_of
                                ) {
                                    modifierSummary = '(Teachers & parents of students only)'
                                }

                                vue.$set(vue.selectedAudienceItems[baseItemKey], 'modifier', modifierSummary)
                            } else {
                                // Create a new block
                                var newBlock = {
                                    id: selectedItem.id,
                                    name: selectedItem.name,
                                    entityType: selectedItem.entityType
                                };

                                if (selectedItem.modifier !== '') {
                                    newBlock['modifier'] = '(' + selectedItem.modifier + ' only)';
                                }

                                newBlock[selectedItem.modifierOriginal] = true;
                                vue.selectedAudienceItems.push(newBlock);
                            }
                        } else {
                            var newBlock = {
                                item: selectedItem,
                                name: 'Combination',
                                entityType: vue.intersect.primary.name,
                                modifier: vue.intersect.secondary.name,
                                compositeModal: true,

                            };
                            vue.selectedAudienceItems.push(newBlock);
                        }

                        // Hide this item from the selectize list
                        $item.addClass('hide');

                        // Selectize hides the placeholder once an item is added- we want to keep it, quite hacky
                        $('#audience-search-selectized').attr('placeholder', '{{ audiencePlaceholder }}').css('width', '100%');

                        // The selectize dropdown doesn't position correctly for some reason with this setup so force reposition again after a very short timeout
                        setTimeout(function() {
                            $('#audience-search').data('selectize').positionDropdown();
                        }, 1);
                    },
                    onItemRemove: function() {
                        // Selectize hides the placeholder once an item is removed- we want to keep it, quite hacky
                        $('#audience-search-selectized').attr('placeholder', '{{ audiencePlaceholder }}').css('width', '100%');
                    }
                },
                {% if audience|length %}
                value: {{ audience|json_encode|raw }},
                {% endif %}
                multiple: true
            });
        },
        data: {
            // The audience groups
            audienceOptions: {
                base: Object.assign({}, audienceOptions),
                intersect: {
                    'primary': Object.assign({}, audienceOptions),
                    'secondary': Object.assign({}, audienceOptions)
                }
            },

            // Modal sections showing and hiding
            pageShow: {
                'index': true,
                'valueSelect': false,
                'intersect': false
            },

            // The option selected by the user from the initial modal screen
            selectedAudienceOption: {},

            // The list of options populated by ajax after the user selects an initial option
            audienceListItems: [],
            audienceListItemsIntersect: {
                'primary': [],
                'secondary': []
            },

            // The checked state of the above list items
            audienceListChecked: [],

            // The list of selected audience groups for this article
            selectedAudienceItems: [],

            // Ajax responses of the above are stored in here, so that we don't do multiple ajax calls for the same thing
            cachedOptions: [],

            // Preloader and empty state showing/hiding for the 2nd screen
            showLoader: true,
            showEmptyState: false,

            // The checked state of the three checkboxes at the bottom of the 2nd modal screen
            includeUsers: true,
            includeParents: false,
            includeTeachers: false,

            // Whether the user should see the write version of the modal or not.
            // Read users will not see the write options even if this is set to true (because of twig conditionals), this just makes the experience easier
            // for read users
            writeOnly: {{ (user.role.staff) ? 'true' : 'false' }},

            // The selected intersect groups
            // Default to campus and role
            intersect: {
                'primary': audienceOptions.role,
                'secondary': audienceOptions.campus
            },

            // The models for the checkboxes
            intersectList: {
                'primary': [],
                'secondary': []
            },

            // Just a marker to check if advanced has been clicked for (need to load defaults on first click)
            hasLoadedAdvanced: false,

            // Model for the intersector select alls
            selectAll: {
                'primary': false,
                'secondary': false
            },

            // These will hold the information to display on the composite modal
            compositeTypes: {
                'primary': [],
                'secondary': []
            },
            compositeInfo: {
                'primary': [],
                'secondary': []
            }

        },
        methods: {
            /**
             * Opening the 'browse...' modal
             */
            openBrowseModal: function () {
                // Reset everythang
                this.showPage('index');
                this.resetModal();

                // Open the modal
                $('#audience-browse').foundation('reveal', 'open');
            },

            /**
             * Opening the 'browse...' modal as a read user
             * You get sent straight to the folder select option
             */
            openBrowseModalRead: function () {
                this.resetModal();
                this.changePage(this.audienceOptions.base.folder);

                // Open the modal
                $('#audience-browse').foundation('reveal', 'open');
            },

            /**
             * Selecting one of the initial options
             * @param audienceOption
             */
            changePage: function (audienceOption) {
                var self = this;

                // Reset everything
                self.resetModal();

                // Show the page
                self.showPage('valueSelect');

                // Update the selected option
                self.selectedAudienceOption = audienceOption;

                // Try for cached list
                if (self.cachedOptions[audienceOption.id] !== undefined) {
                    this.populateAudienceList(self.cachedOptions[audienceOption.id]);
                } else { // Nope, ajax time
                    // Request a list of options with the uri listed in the object above
                    axios.get(audienceOption.ajax).then(function(response) {
                        self.populateAudienceList(response.data.data);

                        // Cache the options
                        self.cachedOptions[audienceOption.id] = response.data.data;

                    }).catch(function (error) {
                        console.log(error);
                    });
                }
            },

            /**
             * Show the list of items, or show the empty state
             * @param data
             */
            populateAudienceList: function (data) {
                // Hide the loader
                this.showLoader = false;

                if (data.length) {
                    // Populate the list with cached version
                    this.audienceListItems = data;
                } else {
                    // Show empty state
                    this.showEmptyState = true;
                }
            },

            /**
             * Submitting the modal form
             */
            addAudience: function () {
                var self = this;

                // Add to selectize
                self.audienceListChecked.forEach(function(option) {
                    var selectizeOptions = [];

                    if (self.includeUsers) {
                        selectizeOptions.push(option.self);
                    }

                    if (self.includeParents) {
                        selectizeOptions.push(option.parents_of);
                    }

                    if (self.includeTeachers) {
                        selectizeOptions.push(option.teachers_of);
                    }

                    selectizeOptions.forEach(function (selectizeOption) {
                        $('#audience-search').data('selectize').addOption(selectizeOption);
                        $('#audience-search').data('selectize').addItem(selectizeOption.id);
                    });
                });

                $('#audience-search').data('selectize').refreshItems();

                // Close modal
                $('#audience-browse').foundation('reveal', 'close');
            },

            addAudienceIntersect: function () {
                var self = this;

                // Add to selectize
                var compositeTypes = {
                    primary:  self.intersect.primary,
                    secondary: self.intersect.secondary
                };
                var compositeItems = {
                    all: [],
                    primary: [],
                    secondary: []
                };

                self.intersectList.primary.forEach(function(value) {
                    compositeItems.all.push({
                        type: self.intersect.primary.id,
                        values: value
                    });
                    compositeItems.primary.push({
                        values: value
                    });
                });

                self.intersectList.secondary.forEach(function(value) {
                    compositeItems.all.push({
                        type: self.intersect.secondary.id,
                        values: value
                    });
                    compositeItems.secondary.push({
                        values: value
                    });
                });

                var intersectOption = {
                    // Base64 and stringify a json object of the composite items
                    id: btoa(JSON.stringify({
                        type: 'composite',
                        value: compositeItems.all
                    })),

                    // This will be used in selectize onItemAdd to work out how to display the segment brick
                    intersect: true,

                    // These are stored for the case they click the brick and want to see the composite info
                    compositeTypes: compositeTypes,
                    compositeItems: compositeItems
                };

                $('#audience-search').data('selectize').addOption(intersectOption);
                $('#audience-search').data('selectize').addItem(intersectOption.id);
                $('#audience-search').data('selectize').refreshItems();

                // Close modal
                $('#audience-browse').foundation('reveal', 'close');
            },

            /**
             * Show the page specified, hiding the other
             * @param page
             */
            showPage: function (page) {
                // Set all pages to false to start
                var self = this;
                Object.keys(this.pageShow).forEach(function(page) {
                    self.pageShow[page] = false;
                });

                // Set the specified page to true
                this.pageShow[page] = true;
            },

            /**
             * Reset the second modal section back to a default state
             */
            resetModal: function () {
                this.audienceListItems = [];
                this.audienceListChecked = [];
                this.includeUsers = true;
                this.includeParents = false;
                this.includeTeachers = false;
                this.showLoader = true;
                this.showEmptyState = false;
            },

            /**
             * Remove an audience item
             */
            removeAudienceItem: function(item) {
                // Remove item + any modifiers for item from selectize
                $('#audience-search').data('selectize').removeItem(item.id);
                $('#audience-search').data('selectize').removeItem(item.id + '{{ relationshipParentsOf }}');
                $('#audience-search').data('selectize').removeItem(item.id + '{{ relationshipTeachersOf }}');

                // Remove from vue list
                this.selectedAudienceItems.splice(this.selectedAudienceItems.indexOf(item), 1);
            },

            /**
             * Clicking the 'advanced' tab
             */
            advancedToggle: function() {
                if (!this.hasLoadedAdvanced) {
                    // Load the defaults
                    this.updateIntersectList('primary');
                    this.updateIntersectList('secondary');
                } else {
                    // Update the marker
                    this.hasLoadedAdvanced = true;
                }

                // Show the page always
                this.showPage('intersect');
            },

            /**
             * Update an intersect list with possible options
             * @param list 'primary' or 'secondary'
             */
            updateIntersectList: function(list) {
                var self = this;
                var audienceOption = self.intersect[list];

                // Reset select all
                self.selectAll[list] = false;

                // Reset checked item model
                self.intersectList[list] = [];

                // Urgh
                var otherList = (list === 'primary') ? 'secondary' : 'primary';

                // Remove this option from the other dropdown
                self.audienceOptions.intersect[otherList] = Object.assign({}, audienceOptions);
                Vue.delete(self.audienceOptions.intersect[otherList], audienceOption.id);

                // Try for cached list
                if (self.cachedOptions[audienceOption.id] !== undefined) {
                    //this.populateAudienceList(self.cachedOptions[audienceOption.id]);
                    self.audienceListItemsIntersect[list] = self.cachedOptions[audienceOption.id];
                } else { // Nope, ajax time
                    // Request a list of options with the uri listed in the object above
                    axios.get(audienceOption.ajax).then(function(response) {
                        //self.populateAudienceList(response.data.data);
                        self.audienceListItemsIntersect[list] = response.data.data;

                        // Cache the options
                        self.cachedOptions[audienceOption.id] = response.data.data;

                    }).catch(function (error) {
                        console.log(error);
                    });
                }
            },

            /**
             * Select all
             * @param list 'primary' or 'secondary'
             */
            toggleSelectAll: function(list) {
                var self = this;
                self.intersectList[list] = [];

                // Get ready for something wild...
                if (self.selectAll[list]) {
                    // Loop the possible options and add them to the list of checked options (intersectList)
                    for (var option in this.cachedOptions[this.intersect[list].id]) {
                        self.intersectList[list].push(self.cachedOptions[this.intersect[list].id][option].self);
                    }
                }
            },

            /**
             * Populate and show a modal with info on a composite audience segment
             */
            showCompositeInfo: function(audienceItem) {
                this.compositeTypes = {
                    'primary': audienceItem.item.compositeTypes.primary,
                    'secondary': audienceItem.item.compositeTypes.secondary
                };
                this.compositeInfo = {
                    'primary': [],
                    'secondary': []
                };

                this.compositeInfo.primary = audienceItem.item.compositeItems.primary;
                this.compositeInfo.secondary = audienceItem.item.compositeItems.secondary;

                // Show modal
                $('#audience-composite').foundation('reveal', 'open');
            }
        },
        computed: {
            /**
             * Disable the modal submit button until each of the checklists has something checked
             */
            submitEnable: function () {
                return !!(this.audienceListChecked.length && (this.includeUsers || this.includeParents || this.includeTeachers));
            },
            submitEnableAdvanced: function () {
                return !!(this.intersectList.primary.length && this.intersectList.secondary.length);
            }
        }
    });
</script>

<style>
    .active {
        font-weight: bold;
    }

    .audience-browse-head {
        position: relative;
    }

    .audience-browse-head h2 {
        display: inline-block;
    }

    .advanced-toggle {
        position: absolute;
        right: 0;
    }
</style>
