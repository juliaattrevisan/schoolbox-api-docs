<div class="row">
    <div class="small-12 medium-8 large-9 columns">

        <div class="row">
            <div class="small-9 columns">
                <h1>{% block newsTitle %}{% endblock %}</h1>

            </div>

            {% block actionIcons %}
                <div class="small-3 columns actions-small-2">
                    <nav>
                        {% block createLink %}
                            {% set createRoute = routeLookupIfAuthorized('commsNews.getCreate') %}
                            {% if createRoute %}
                                <a href="{{ createRoute }}" class="icon-add" title="Create {{ locale.news }}"></a>
                            {% endif %}
                        {% endblock %}
                        <a href="#" class="icon-more" data-dropdown="header-options" title="Actions" aria-expanded="false"></a>

                    </nav>
                </div>
                <ul class="f-dropdown fadeInDown" data-dropdown-content="" id="header-options" aria-hidden="true">
                    {% block rssLink %}
                    {% endblock %}
                    {% set adminRoute = routeLookupIfAuthorized('commsNewsPolicy.getPolicies') %}
                    {% if adminRoute %}
                    <li><a class="icon-settings" href="{{ adminRoute }}">{{ locale.news | capitalize }} Administration</a></li>
                    {% endif %}
                </ul>
            {% endblock %}
        </div>
    </div>
</div>


<div class="row">
    {# navigation sidebar #}
    <div class="small-12 medium-4 large-3 island push right">
        <section>
            <nav>
                <ul class="side-nav">
                    {% set indexRoute = routeLookupIfAuthorized('commsNews.getIndex') %}
                    {% if indexRoute %}
                        <li {% if page == indexRoute %}class="active"{% endif %} role="menuitem">
                            <a href="{{ indexRoute }}">{{ locale.news | capitalize }} Feed</a>
                        </li>
                    {% endif %}

                    {% set authoredRoute = routeLookupIfAuthorized('commsNews.getAuthored') %}
                    {% if authoredRoute %}
                        <li {% if page == authoredRoute %}class="active"{% endif %} role="menuitem">
                            <a href="{{ authoredRoute }}">Created By Me</a>
                            {% if authoredCounts | length %}
                                <ul>
                                    {% for state, data in authoredCounts %}
                                        {% if  data.count > 0 %}
                                        <li role="menuitem"><a href="{{ routeLookup('commsNews.getAuthored') }}?status={{ state }}">
                                                {{ state }}
                                            <span class="label {{ data.labelClass }} right round">{{ data.count }}</span>
                                            </a>
                                        </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endif %}

                    {% set moderationRoute = routeLookupIfAuthorized('commsNewsModeration.getList') %}
                    {% if moderationRoute %}
                        <li {% if page == moderationRoute %}class="active"{% endif %} role="menuitem">
                            <a href="{{ moderationRoute }}">
                                Requiring Moderation
                                {% if moderationCount > 0 %}
                                    <span class="label highlight right round" title="{{ moderationCount }} item{% if moderationCount > 1 %}s{% endif %} awaiting moderation">{{ moderationCount }}</span>
                                {% endif %}
                            </a>
                        </li>
                    {% endif %}

                    {% set savedRoute = routeLookupIfAuthorized('commsNewsSaveForLater.getList') %}
                    {% if savedRoute %}
                        <li {% if page == savedRoute %}class="active"{% endif %} role="menuitem">
                            <a href="{{ savedRoute }}">My Saved {{ locale.news | capitalize }}</a>
                        </li>
                    {% endif %}

                    {% set archiveRoute = routeLookupIfAuthorized('commsNews.getArchive') %}
                    {% if archiveRoute %}
                        <li {% if pageWithoutParams == archiveRoute %}class="active"{% endif %} role="menuitem">
                            <a href="{{ archiveRoute }}">{{ locale.news | capitalize }} Archive</a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        </section>

        <section>
            {% block archiveFilter %}
            {% endblock %}
        </section>
    </div>
    
    {# main content #}
    <div class="small-12 medium-8 large-9 island">
        {% block newsContent %}
        {% endblock %}
    </div>

</div>

<div id="toast" class="toast"></div>

{% block newsScripts %}{% endblock %}