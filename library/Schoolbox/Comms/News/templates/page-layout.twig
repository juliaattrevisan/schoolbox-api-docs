{% block breadCrumbs %}{% endblock %}

<div class="row">
    <div class="small-12 medium-8 large-9 island">
        <div class="row actions-small-3">
            <div class="list-item">
                <div class="small-12 column">
                    <h1>{% block newsTitle %}{% endblock %}</h1>
                </div>
            </div>

            {% block actionIcons %}
            <nav>
                {% block createLink %}
                    {% set createRoute = routeLookupIfAuthorized('commsNews.getCreate') %}
                    {% if createRoute %}
                        <a href="{{ createRoute }}" class="sbx-icon-only-button" title="Create {{ locale.news }}" aria-label="Create {{ locale.news }}">
                            <sbx-icon name="add"></sbx-icon>
                        </a>
                    {% endif %}
                {% endblock %}

                {% block rssLink %}
                {% endblock %}

                {% set adminRoute = routeLookupIfAuthorized('commsNewsPolicy.getPolicies') %}
                {% if adminRoute %}
                    <a class="sbx-icon-only-button" href="{{ adminRoute }}" title="{{ locale.news.proper }} Administration" aria-label="{{ locale.news.proper }} Administration">
                        <sbx-icon name="settings"></sbx-icon>
                    </a>
                {% endif %}
            </nav>
            {% endblock %}
        </div>
    </div>
</div>


<div class="row">
    {# navigation sidebar #}
    <div class="small-12 medium-4 large-3 island push right news-nav">
        <section>
            <nav>
                <ul class="side-nav">
                    {% set indexRoute = routeLookupIfAuthorized('commsNews.getIndex') %}
                    {% if indexRoute %}
                        <li {% if page == indexRoute %}class="active"{% endif %} role="menuitem">
                            <a href="{{ indexRoute }}">{{ locale.news.proper }} Feed</a>
                        </li>
                    {% endif %}

                    {% set authoredRoute = routeLookupIfAuthorized('commsNews.getAuthored') %}
                    {% if authoredRoute %}
                        <li {% if page == authoredRoute %}class="active"{% endif %} role="menuitem">
                            <a href="{{ authoredRoute }}">Created By Me</a>
                            {% if authoredCounts | length %}
                                <ul>
                                    {% for state, data in authoredCounts %}
                                        {% if  data.count > 0 %}
                                        <li role="menuitem"><a href="{{ routeLookup('commsNews.getAuthored') }}?status={{ state }}">
                                                {{ state }}
                                            <span class="label {{ data.labelClass }} right round">{{ data.count }}</span>
                                            </a>
                                        </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endif %}

                    {% set moderationRoute = routeLookupIfAuthorized('commsNewsModeration.getList') %}
                    {% if moderationRoute and ( config.global_moderation or moderationCount)  %}
                        <li {% if page == moderationRoute %}class="active"{% endif %} role="menuitem">
                            <a href="{{ moderationRoute }}">
                                Requiring Moderation
                                {% if moderationCount > 0 %}
                                    <span class="label submitted right round" title="{{ moderationCount }} item{% if moderationCount > 1 %}s{% endif %} awaiting moderation">{{ moderationCount }}</span>
                                {% endif %}
                            </a>
                        </li>
                    {% endif %}

                    {% set savedRoute = routeLookupIfAuthorized('commsNewsSaveForLater.getList') %}
                    {% if savedRoute %}
                        <li {% if page == savedRoute %}class="active"{% endif %} role="menuitem">
                            <a href="{{ savedRoute }}">My Saved {{ locale.news.proper }}</a>
                        </li>
                    {% endif %}

                    {% set archiveRoute = routeLookupIfAuthorized('commsNews.getArchive') %}
                    {% if archiveRoute %}
                        <li {% if pageWithoutParams is defined and pageWithoutParams == archiveRoute %}class="active"{% endif %} role="menuitem">
                            <a href="{{ archiveRoute }}">{{ locale.news.proper }} Archive</a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        </section>

        <section>
            {% block archiveFilter %}
            {% endblock %}
        </section>
    </div>

    {# main content #}
    <div class="small-12 medium-8 large-9 island">
        {% block newsContent %}
        {% endblock %}
    </div>

</div>

<div id="toast" class="toast"></div>

{% block newsScripts %}{% endblock %}
