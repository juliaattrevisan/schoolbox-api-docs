{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@commsNews/layout.twig' as layout %}

{# TODO: How to do breadcrumbs now? #}
{% if isCommsOfficer %}
    {{ bread.crumbs(
        [ locale.news.proper, '/news' ],
        [ 'Moderation', routeLookup('commsNewsModeration.getList') ],
        [ news.title ]
    ) }}
{% else %}
{{ bread.crumbs(
    [ locale.news.proper, '/news' ],
    [ news.title ]
) }}
{% endif %}



<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ news.title }}</h1>

            <ul class="meta">

                {# Topics #}
                {% if news.topics|length %}
                    <li class="icon-news">Related Topics:

                        {# TODO: Have a /news/topic url lol #}
                        {% for topic in news.topics %}
                            <a href="/news/topic/{{ topic.slug }}">{{ topic.name }}</a>{% if not loop.last %},{% endif %}
                        {% endfor %}
                    </li>
                {% endif %}

                {# This info only really matters to the author, I suppose
                 # Submitted at; moderated at; moderated by
                 #}
                {% if news.author.id == USER.id %}
                    {% if news.submittedAt.local|length %}
                        <li class="icon-calendar">Submitted on {{ news.submittedAt.local }}</li>
                    {% endif %}

                    {% if news.moderatedAt.local|length %}
                        <li class="icon-calendar">Last moderated on {{ news.moderatedAt.local }} by {{ news.moderatedBy.fullname }}</li>
                    {% endif %}
                {% endif %}
            </ul>
        </div>
    </div>
    <nav>
        <a class="icon-more" title="Actions" data-dropdown="header-options"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        {# Go back to the moderation list #}
        {% set moderationListRoute = routeLookupIfAuthorized('commsNewsModeration.getList') %}

        {% if moderationListRoute %}
            <li><a class="icon-list" href="{{ moderationListRoute }}" title="A list of articles to moderate">Moderation List</a></li>
        {% endif %}

        {# Add a new news article #}
        <li><a class="icon-add" href="{{ routeLookupIfAuthorized('commsNews.getCreate') }}" title="Craete a new article">Create New</a></li>

        {# Modify this news article #}
        {% set modifyRoute = routeLookupIfAuthorized('commsNews.getUpdate', {newsId: news.id}) %}

        {% if modifyRoute %}
            <li><a class="icon-modify" href="{{ modifyRoute }}" title="Modify this article">Modify</a></li>
        {% endif %}

        {# Delete this news article #}
        {% set deleteRoute = routeLookupIfAuthorized('commsNews.postDelete', {newsId: news.id}) %}

        {% if deleteRoute and isDeletable %}
            <script>
                $(function() {
                    $('[data-delete]').on('click', function(event) {
                        event.preventDefault();

                        var element = $(this);
                        var toast = $('#toast');
                        var title = element.attr('data-delete');

                        $(this).confirmDialog({
                            text: 'Are you sure you want to delete ' + title + '?',
                            confirmEvent: function() {
                                toast.toastActivate({
                                    text: 'Deleting ' + title
                                });

                                $.ajax({
                                    type: 'POST',
                                    url: element.attr('href'),
                                    data: {newsId: {{ news.id }}},
                                    dataType: 'json'
                                }).success(function (response) {
                                    toast.toastTimeout({
                                        text: title + ' was deleted',
                                        css: 'success'
                                    });

                                    window.location.href = response.redirect;
                                }).error(function (response) {
                                    var temp = $.parseJSON(response.responseText);

                                    toast.toastTimeout({
                                        text: 'Error: ' + temp.message,
                                        css: 'alert'
                                    });
                                });
                            }
                        });
                    });
                });
            </script>
            <li><a class="icon-delete" href="{{ deleteRoute }}" title="Delete this article" data-delete="{{ news.title }}">Delete</a></li>
        {% endif %}
    </ul>
</div>


{# Train Line
 # One of three possibilities are shown here
 #}
{% include '@commsNews/workflow.twig' with {
    news: news,
    moderationRequired: policies['global_moderation'].value
} %}

<div class="row">
    <div class="small-12 island">
        <section>
            <div class="card small-12">
                <a href="/search/user/{{ news.author.id }}" title="View Profile">
                    <img src="/portrait.php?userId={{ news.author.externalId }}&size=square64" alt="View Profile" />
                    <p>{{ news.author.fullname }}</p>
                </a>
                <p class="meta">{{ news.publishAt.long }}</p>
            </div>
        </section>
    </div>
</div>

{% if news.body|length %}
<div class="row">
    <div class="small-12 island">
        <section>
            <div class="row">
                {% if news.featureImage.hash %}
                    {{ layout.standard(news) }}
                {% else %}
                    {{ layout.textonly(news) }}
                {% endif %}
            </div>
        </section>
    </div>
</div>
{% endif %}


{# Moderation is required
 # You're prompted to consciously submit for moderation
 #}
{% if policies['global_moderation'].value and not news.submittedAt.local|length %}
<div class="row">
    <div class="small-12 island">
        <form action="{{ routeLookup('commsNews.postSubmitForModeration', {newsId: news.id}) }}" method="post">
            <input type="submit" value="Submit for moderation" />
        </form>
    </div>
</div>
{% endif %}


{# Publish #}
{% if policies['global_moderation'].value %}

    {# Moderation is required and you're on the preview screen
     # As a Moderator, you're prompted to consciously publish this to the world
     #}
    {% if isCommsOfficer and news.submittedAt.local|length and not news.moderatedAt.local|length %}
        <div class="row">
            <div class="small-12 island">
                <form action="{{ routeLookup('commsNewsModeration.postAccept', {newsId: news.id}) }}" method="post">
                    <input type="submit" value="Publish" />
                </form>
            </div>
        </div>
    {% endif %}
{% elseif not news.submittedAt.local|length %}

    {# Moderation isn't required and you're on the preview screen
     # You're prompted to consciously publish to the world
     #}
    <div class="row">
        <div class="small-12 island">
            <form action="{{ routeLookup('commsNews.postSubmitForModeration', {newsId: news.id}) }}" method="post">
                <input type="submit" value="Publish" />
            </form>
        </div>
    </div>
{% endif %}

<div class="toast" id="toast"></div>