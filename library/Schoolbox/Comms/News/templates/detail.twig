{% import 'sub/breadcrumbs.twig' as bread %}

{# TODO: How to do breadcrumbs now? #}
{{ bread.crumbs(
    [ 'News', '/news' ],
    [ news.title ]
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ news.title }}</h1>
        </div>
    </div>
    <nav>
        {% set modifyRoute = routeLookupIfAuthorized('commsNews.getUpdate', {newsId: news.id}) %}

        {% if modifyRoute %}
        <a class="icon-modify" href="{{ modifyRoute }}" title="Actions"></a>
        {% endif %}
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            <div class="card small-12">
                <a href="/search/user/{{ news.author.id }}" title="View Profile">
                    <img src="/portrait.php?userId={{ news.author.externalId }}&size=square64" alt="View Profile" />
                    <p>{{ news.author.fullname }}</p>
                </a>
                <p class="meta">{{ news.publishAt.long }}</p>
            </div>
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            <div class="row">
                {% if news.featureImage.hash %}
                    <div class="small-12 medium-3 island">
                        <section class="content">
                            <img src="/storage/image.php?hash={{ news.featureImage.hash }}&size=constrain200" />
                        </section>
                    </div>

                    <div class="small-12 medium-9 island">
                        <section class="content">
                            {{ news.body|purify }}
                        </section>
                    </div>
                {% else %}
                    <div class="small-12 island">
                        <section class="content">
                            {{ news.body|purify }}
                        </section>
                    </div>
                {% endif %}
            </div>
        </section>
    </div>
</div>

