{#
Data:
    article                 News\Model
    isSavedForLater         bool
    availableEntityTypes    string[]         The set of entity types that can be audienced by the current user
    entityTypesData         array
    policies                array
#}

{% import 'sub/breadcrumbs.twig' as bread %}

{# Modify article #}
{% set modifyRoute = routeLookupIfAuthorized('commsNews.getUpdate', {article: article, articleId: article.id}) %}

{# Delete article #}
{% set deleteRoute = routeLookupIfAuthorized('commsNews.postDelete', {article: article, articleId: article.id}) %}

{% set isAuthor = USER.id == article.author.id %}
{% if article.isPublished or article.isExpired %}
    {% set rejectVerb = 'Unpublish' %}
{% else %}
    {% set rejectVerb = 'Reject' %}
{% endif %}
{% set returnUrlQueryString = returnUrl ? '?' ~ RETURN_URL.name ~ '=' ~ returnUrl : '' %}

<script type="text/javascript">
    $(function() {
        history.replaceState({}, '', '{{ article.id }}' + window.location.hash);
    });
</script>

{{ bread.crumbs([locale.news.properPlural, routeLookup('commsNews.getIndex')], [article.title |default("(untitled)")]) }}

<div class="actions-small-2 row">
    {% if deleteRoute %}
        <script>
            $(function() {
                $('#header-options').on('click', 'a[data-delete]', function(event) {
                    event.preventDefault();

                    var $element = $(this);
                    var $toast = $('#toast');
                    var title = $element.attr('data-delete');

                    $element.confirmDialog({
                        text: 'Are you sure you want to delete ' + title + '?',
                        confirmLabel: 'Delete',
                        confirmEvent: function() {
                            $toast.toastActivate({
                                text: 'Deleting ' + title
                            });

                            $.ajax({
                                type: 'POST',
                                url: $element.attr('href'),
                                data: {articleId: {{ article.id }}},
                                dataType: 'json'
                            }).done(function (response) {
                                $toast.toastTimeout({
                                    text: title + ' was deleted',
                                    css: 'success'
                                });

                                window.location.href = response.redirect;
                            }).fail(function (response) {
                                var temp = $.parseJSON(response.responseText);

                                $toast.toastTimeout({
                                    text: 'Error: ' + temp.message,
                                    css: 'alert'
                                });
                            });
                        }
                    });
                });
            });
        </script>
    {% endif %}

    {# Unpublish article (just a reject renamed to unpublish when the article is published or archived) #}
    {% if article.canBeRejected %}
        {% set rejectRoute = routeLookupIfAuthorized('commsNewsModeration.postReject', {article: article, articleId: article.id}) %}
    {% endif %}

    {# Statistics link: must be author or comms officer and article must be published #}
    {% set statisticsRoute = routeLookupIfAuthorized('commsNewsStatistics.getOverview', {article: article, articleId: article.id}) %}

    {# Decide whether the tot shows #}
    {% set hasDropDownRoutes = modifyRoute or deleteRoute or rejectRoute or statisticsRoute %}

    <nav>
        {# Save For Later #}
        <script src="{{ CDN_PREFIX }}/js/comms/saveforlater.js?v={{ config.site_version }}"></script>
        <script>
            $(function() {
                $('#saveforlater-container').saveForLater();
            });
        </script>

        {% if config.save_for_later %}
        <span id="saveforlater-container">
            {% include '@commsNewsSaveForLater/activator.twig' with {
                article: article,
                isSaved: isSavedForLater
            } only %}
        </span>
        {% endif %}

        {% if hasDropDownRoutes %}
            <a class="icon-more" title="Actions" data-dropdown="header-options"></a>
        {% endif %}
    </nav>

    {% if hasDropDownRoutes %}
    <ul id="header-options" class="f-dropdown" data-dropdown-content>

        {% if modifyRoute %}
            <li><a class="icon-modify" href="{{ modifyRoute }}">Modify</a></li>
        {% endif %}

        {% if deleteRoute %}
            <li><a class="icon-delete" href="{{ deleteRoute }}{{ returnUrlQueryString }}" data-delete="{{ article.title|default('(untitled)') }}">Delete</a></li>
        {% endif %}

        {# 'Unpublish' action
         # Only show this after the article is approved because...
         # 'Reject' appears as a button when the article is awaiting moderation, and..
         # anything before awaiting moderation doesn't need a reject/unpublish button
         #}
        {% if rejectRoute is defined and rejectRoute and article.isApproved %}
            <li><a class="icon-undo" id="unpublish-article" href="{{ rejectRoute }}{{ returnUrlQueryString }}" data-reject="{{ article.title }}">{{ rejectVerb }}</a></li>
        {% endif %}

        {% if statisticsRoute %}
            <li><a class="icon-progress" href="{{ statisticsRoute }}">Statistics</a></li>
        {% endif %}
    </ul>
    {% endif %}
</div>

{% if flashMessage|length %}
    <script>
        $(function() {
            $('#flash').on('click', '.close', function(event) {
                event.preventDefault();

                $('#flash').remove();
            });
        });
    </script>
    <div class="small-12 columns">
        <div id="flash" class="alert-box success">
            {{ flashMessage }}
            <a class="close">×</a>
        </div>
    </div>
{% endif %}

{# Always display the whole layout of the news article, as the title isn't shown otherwise #}
<div class="news-post row">
    <div class="small-12 island">
        <section>
            <div class="row">
                {# Always use the banner layout, as it has received the redesign and can trivially adapt to not having a banner #}
                {% include '@commsNews/layout/banner.twig' with {
                    article:     article,
                    modifyRoute: modifyRoute,
                    isAuthor:    isAuthor,
                    availableEntityTypes: availableEntityTypes,
                    entityTypesData: entityTypesData,
                    encodedSegments: encodedSegments,
                    commentsIsEnabled: policies.commentsIsEnabled
                } only %}
            </div>
        </section>
    </div>
</div>

{# Rejection details, if applicable #}
{% if article.isRejected %}
<div class="row">
    <div class="small-12 island">
        <section class="no-pad no-margin">
            <p class="content no-margin"><span class="icon-info"></span>
                This {{ locale.news }} was <strong>rejected</strong>
                by <a href="/search/user/{{ article.rejectedBy.id }}" title="View Profile">{{ article.rejectedBy.fullname }}</a>
                on {{ article.rejectedAt.local }}

                {% if article.rejectedReason|length %}
                    for the following reason:
                {% else %}
                    but no reason was given.
                {% endif %}
            </p>
        </section>

        {% if article.rejectedReason|length %}
        <blockquote>{{ article.rejectedReason|nl2br }}</blockquote>
        {% endif %}
    </div>
</div>
{% endif %}


{# Social Features and assorted functionality #}
{#{% include '@commsNews/social.twig' with {#}
    {#saveForLaterEnabled: saveForLaterEnabled,#}
    {#article: article,#}
    {#states: {#}
        {#'save_for_later': isSavedForLater#}
    {#}#}
{#} only %}#}

{# If you have permission to submit and implicitly approve your own articles, do that, otherwise submit for moderation #}
{% set approveRoute = article.canBeApproved ? routeLookupIfAuthorized('commsNewsModeration.postApprove', {article: article, articleId: article.id}) : null %}
{% set submitRoute  = article.canBeSubmitted ? routeLookupIfAuthorized('commsNewsModeration.postSubmit', {article: article, articleId: article.id}) : null %}
{% if (approveRoute or submitRoute) and not isPublishable %}
<div class="small-12 columns" id="unpublishable-box">
    <div id="flash" class="alert-box highlight">
        <span id="error-message">
            This isn't quite ready for publishing, please <a href="{{ modifyRoute }}">modify this {{ locale.news }}</a> and complete the required fields.
        </span>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 columns">
        <ul class="flex-list buttons" id="actionButtons">
            {# Reject this news article #}
            {% if article.canBeRejected and rejectRoute and not article.isApproved %}
                <li><a href="{{ rejectRoute }}" id="reject-article" title="{{ rejectVerb }} this article" data-reject="{{ article.title }}">{{ rejectVerb }}</a></li>
            {% endif %}

            {% if isPublishable and (approveRoute or submitRoute) %}
                {% if approveRoute %}
                    {% set buttonText = 'Publish ' ~ locale.news %}
                {% elseif article.isRejected %}
                    {% set buttonText = 'Resubmit for moderation' %}
                {% else %}
                    {% set buttonText = 'Submit for moderation' %}
                {% endif %}
                <li>
                    <form action="{{ approveRoute ?: submitRoute }}" method="post" id="article-form">
                        {% if returnUrl|length %}
                            <input type="hidden" name="{{ RETURN_URL.name }}" value="{{ returnUrl }}"/>
                        {% endif %}
                        <input type="submit" value="{{ buttonText }}" id="article-submit"/>
                    </form>
                </li>
            {% endif %}
        </ul>
    </div>
</div>

<div class="toast" id="toast"></div>

<div id="recipientsModal" class="reveal-modal" data-reveal>
    <a class="close-reveal-modal">&#215;</a>
</div>

{% if article.canBeRejected and rejectRoute %}
<script>
    $(function() {
        $(document).on('click', '#reject-article, #unpublish-article', function(event) {
            event.preventDefault();

            var $element = $(this);
            var $toast = $('#toast');
            var title = $element.attr('data-reject');

            $element.confirmDialog({
                header: '{{ rejectVerb }} ' + title,
                format: 'html',
                text: 'Provide brief feedback for {{ rejectVerb|lower }}ing this article to help the author improve their content. <textarea id="rejectedReason" rows="5"></textarea>',
                confirmLabel: '{{ rejectVerb }}',
                cancelLabel: 'Cancel',
                confirmEvent: function() {
                    $toast.toastActivate({
                        text: '{{ rejectVerb }}ing ' + title
                    });

                    $.ajax({
                        type: 'POST',
                        url: $element.attr('href'),
                        data: {articleId: {{ article.id }}, rejectedReason: $('#rejectedReason').val()},
                        dataType: 'json'
                    }).done(function (response) {
                        $toast.toastTimeout({
                            text: title + ' was {{ rejectVerb|lower }}ed',
                            css: 'success'
                        });

                        window.location.href = response.redirect;
                    }).fail(function (response) {
                        var temp = $.parseJSON(response.responseText);

                        $toast.toastTimeout({
                            text: 'Error: ' + temp.message,
                            css: 'alert'
                        });
                    });
                }
            });
        });
    });
</script>
{% endif %}

{# Publish news asynchronous #}
{% if (isPublishable) and (approveRoute or submitRoute) %}
    {% autoescape 'js' %}
    <script>
        $(function() {

            var form = $('#article-form');
            var articleSubmitButton = $('#article-submit');
            var buttonOriginalValue = articleSubmitButton.val();

            form.submit(function( event ) {
                event.preventDefault();
                var $toast     = $('#toast');

                // Prevent clickjacking and update button text...
                articleSubmitButton.prop('disabled', true).attr('value','Working...');

                $.ajax({
                    type: 'POST',
                    url: form.attr('action'),
                    data: {articleId: {{ article.id }}},
                    dataType: 'json'
                }).done(function (response) {
                    window.location.href = response.redirect;
                }).fail(function (response) {

                    $toast.toastActivate({
                        text: 'Error: ' + response.responseJSON.message,
                        css: 'alert',
                    });

                    // Revert text to its original value and enable the button back
                    articleSubmitButton.prop('disabled', false).attr('value',buttonOriginalValue);

                    $toast.toastTimeout({
                        text: 'Error: ' + response.responseJSON.message,
                        duration: 3000
                    });
                });
            });
        });
    </script>
    {% endautoescape %}
{% endif %}
