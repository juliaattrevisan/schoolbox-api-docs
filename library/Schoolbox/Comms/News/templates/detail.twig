{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@commsNews/layout.twig' as layout %}



{# TODO: How to do breadcrumbs now? #}
{{ bread.crumbs(
    [ locale.news.proper, '/news' ],
    [ news.title ]
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ news.title }}</h1>

            <ul class="meta">

                {# Topics #}
                {% if news.topics|length %}
                <li class="icon-news">Related Topics:

                    {# TODO: Have a /news/topic url lol #}
                    {% for topic in news.topics %}
                        <a href="/news/topic/{{ topic.slug }}">{{ topic.name }}</a>{% if not loop.last %},{% endif %}
                    {% endfor %}
                </li>
                {% endif %}

                {# This info only really matters to the author, I suppose
                 # Submitted at; moderated at; moderated by
                 #}
                {% if news.author.id == USER.id %}
                    {% if news.submittedAt.local|length %}
                        <li class="icon-calendar">Submitted on {{ news.submittedAt.local }}</li>
                    {% endif %}

                    {% if news.moderatedAt.local|length %}
                        <li class="icon-calendar">Last moderated on {{ news.moderatedAt.local }} by {{ news.moderatedBy.fullname }}</li>
                    {% endif %}
                {% endif %}
            </ul>
        </div>
    </div>
    <nav>
        {% set modifyRoute = routeLookupIfAuthorized('commsNews.getUpdate', {newsId: news.id}) %}

        {% if modifyRoute %}
        <a class="icon-modify" href="{{ modifyRoute }}" title="Modify this article"></a>
        {% endif %}
    </nav>
</div>

{# Train Line
 # One of three possibilities are shown here
 #}
{% include '@commsNews/workflow.twig' with {
    news: news,
    moderationRequired: policies['global_moderation'].value
} %}

<div class="row">
    <div class="small-12 island">
        <section>
            <div class="card small-12">
                <a href="/search/user/{{ news.author.id }}" title="View Profile">
                    <img src="/portrait.php?userId={{ news.author.externalId }}&size=square64" alt="View Profile" />
                    <p>{{ news.author.fullname }}</p>
                </a>
                <p class="meta">{{ news.publishAt.long }}</p>
            </div>
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            <div class="row">
                {% if news.featureImage.hash %}
                    {{ layout.standard(news) }}
                {% else %}
                    {{ layout.textonly(news) }}
                {% endif %}
            </div>
        </section>
    </div>
</div>

{% if policies['global_moderation'].value and not news.submittedAt.local|length %}
<div class="row">
    <div class="small-12 island">
        <form action="{{ routeLookup('commsNews.postSubmitForModeration', {newsId: news.id}) }}" method="post">
            <input name="submitConfirmation" value="1" type="hidden" />

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <p>Moderation is required for this {{ locale.news.proper }} article. You can review <a href="{{ routeLookup('commsNewsPolicy.getPolicies') }}" title="view policy settings" target="_blank">current policy settings</a>.</p>

                        <p><strong>Policy</strong>. You need to abide by these standards etc.</p>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="Submit For Moderation" />
        </form>
    </div>
</div>
{% endif %}



