{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@commsNews/layout.twig' as layout %}

{# TODO: How to do breadcrumbs now? #}
{% if isCommsOfficer %}
    {{ bread.crumbs(
        [ locale.news.proper, routeLookup('commsNews.getIndex') ],
        [ 'Moderation', routeLookup('commsNewsModeration.getList') ],
        [ article.title ]
    ) }}
{% else %}
    {{ bread.crumbs(
        [ locale.news.proper, routeLookup('commsNews.getIndex') ],
        [ article.title ]
    ) }}
{% endif %}

<script type="text/javascript">
    $(function() {
        history.replaceState({}, '', '{{ article.id }}');
    });
</script>

<div class="actions-small-2 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ article.title }}</h1>

            <ul class="meta">

                {# Topics #}
                {% if article.topics|length %}
                    <li class="icon-news">Related Topics:
                        {% for topic in article.topics %}
                            <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </li>
                {% endif %}

                {# This info only really matters to the author, I suppose
                 # Submitted at; accepted at; accepted by
                 #}
                {% if isAuthor %}
                    {% if article.isSubmitted %}
                        <li class="icon-calendar">Submitted on {{ article.submittedAt.local }}</li>
                    {% endif %}

                    {% if article.isAccepted %}
                        <li class="icon-calendar">Last moderated on {{ article.acceptedAt.local }} by {{ article.acceptedBy.fullname }}</li>
                    {% endif %}
                {% endif %}
            </ul>
        </div>
    </div>
    <nav>
        {# Save For Later #}
        <script src="/javascript/shared/comms/saveforlater.js"></script>
        <script>
            $(function() {
                $('#saveforlater-container').saveForLater();
            });
        </script>

        <span id="saveforlater-container">
            {% include '@commsNewsSaveForLater/activator.twig' with {
                article: article,
                isSaved: isSavedForLater
            } only %}
        </span>

        <a class="icon-more" title="Actions" data-dropdown="header-options"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>

        {# Modify article #}
        {% set modifyRoute = routeLookupIfAuthorized('commsNews.getUpdate', {articleId: article.id}) %}
        {% if modifyRoute and isEditable %}
            <li><a class="icon-modify" href="{{ modifyRoute }}">Modify</a></li>
        {% endif %}

        {# Delete article #}
        {% set deleteRoute = routeLookupIfAuthorized('commsNews.postDelete', {articleId: article.id}) %}

        {% if deleteRoute and isDeletable %}
            <script>
                $(function() {
                    $('#header-options').on('click', 'a[data-delete]', function(event) {
                        event.preventDefault();

                        var $element = $(this);
                        var $toast = $('#toast');
                        var title = $element.attr('data-delete');

                        $element.confirmDialog({
                            text: 'Are you sure you want to delete ' + title + '?',
                            confirmEvent: function() {
                                $toast.toastActivate({
                                    text: 'Deleting ' + title
                                });

                                $.ajax({
                                    type: 'POST',
                                    url: $element.attr('href'),
                                    data: {articleId: {{ article.id }}},
                                    dataType: 'json'
                                }).success(function (response) {
                                    $toast.toastTimeout({
                                        text: title + ' was deleted',
                                        css: 'success'
                                    });

                                    window.location.href = response.redirect;
                                }).error(function (response) {
                                    var temp = $.parseJSON(response.responseText);

                                    $toast.toastTimeout({
                                        text: 'Error: ' + temp.message,
                                        css: 'alert'
                                    });
                                });
                            }
                        });
                    });
                });
            </script>
            <li><a class="icon-delete" href="{{ deleteRoute }}" data-delete="{{ article.title }}">Delete</a></li>
        {% endif %}

        {# Statistics link: must be author or comms officer and article must be published #}
        {% set statisticsRoute = routeLookupIfAuthorized('commsNewsStatistics.getOverview', {articleId: article.id}) %}
        {% if isAuthor or isCommsOfficer %}
            <li><a class="icon-progress" href="{{ statisticsRoute }}">Statistics</a></li>
        {% endif %}

        {# Helper links #}
        {# TODO: maybs delete once there's actual ways to get to these places #}

        {# Create new article #}
        <li><a class="icon-add" href="{{ routeLookupIfAuthorized('commsNews.getCreate') }}" >Create {{ locale.news }}</a></li>

        {# Go to the moderation list #}
        {% if moderationRequired %}
            {# Go back to the moderation list #}
            {% set moderationListRoute = routeLookupIfAuthorized('commsNewsModeration.getList') %}

            {% if moderationListRoute %}
                <li><a class="icon-list" href="{{ moderationListRoute }}" title="A list of articles to moderate">Moderation List</a></li>
            {% endif %}
        {% endif %}

    </ul>
</div>


{# Train Line
 # One of three possibilities are shown here
 # Only useful to authors and moderators
 #}
{% if isAuthor or isCommsOfficer %}
{% include '@commsNews/workflow.twig' with {
    article: article,
    moderationRequired: moderationRequired
} %}
{% endif %}

<div class="row">
    <div class="small-12 island">
        <section>
            <div class="card small-12">

                {% if article.author.deletedAt.isNull %}
                    <a href="/search/user/{{ article.author.id }}" title="View Profile">
                        <img src="/portrait.php?userId={{ article.author.externalId }}&size=square64" alt="View Profile" />
                        <p>{{ article.author.fullname }}</p>
                    </a>
                {% else %}
                    <img src="/portrait.php?userId={{ article.author.externalId }}&size=square64" alt="View Profile" />
                    <p>{{ article.author.fullname }}</p>
                {% endif %}

                <p class="meta">{{ article.publishAt.long }}</p>
            </div>
        </section>
    </div>
</div>

{# Display body when either there's text content, or an image #}
{% if article.body|length or article.featureImage.hash %}
<div class="row">
    <div class="small-12 island">
        <section>
            <div class="row">
                {% if article.featureImage.hash %}
                    {{ layout.standard(article) }}
                {% else %}
                    {{ layout.textonly(article) }}
                {% endif %}
            </div>
        </section>
    </div>
</div>
{% endif %}

{# Rejection details, if applicable
 # Only show rejection info prior to acceptance
 #}
{% if article.isRejected and not article.isAccepted %}
<div class="row">
    <div class="small-12 island">
        <section class="no-pad no-margin">
            <p class="content no-margin"><span class="icon-info"></span>
                This {{ locale.news }} was <strong>rejected</strong>
                by <a href="/search/user/{{ article.rejectedBy.id }}" title="View Profile">{{ article.rejectedBy.fullname }}</a>
                on {{ article.rejectedAt.local }}

                {% if article.rejectedReason|length %}
                    for the following reason:
                {% else %}
                    but no reason was given.
                {% endif %}
            </p>
        </section>

        {% if article.rejectedReason|length %}
        <blockquote>{{ article.rejectedReason|nl2br }}</blockquote>
        {% endif %}
    </div>
</div>
{% endif %}


{# Social Features and assorted functionality #}
{#{% include '@commsNews/social.twig' with {#}
    {#policies: policies,#}
    {#article: article,#}
    {#states: {#}
        {#'save_for_later': isSavedForLater#}
    {#}#}
{#} %}#}


<div class="row">
    <div class="small-12 columns">
        <ul class="flex-list buttons" id="actionButtons">


        {# Modify this news article
         # Only available before the article has been accepted
         #}
        {% if not article.isAccepted %}
            {% set modifyRoute = routeLookupIfAuthorized('commsNews.getUpdate', {articleId: article.id}) %}

            {% if modifyRoute %}
                <li><a class="icon-modify" href="{{ modifyRoute }}" title="Modify this article">Modify</a></li>
            {% endif %}
        {% endif %}


        {# Unsubmitted articles need explicit actions to be made available to the world
         #
         # Moderation is required: you're prompted to consciously submit for moderation
         # Moderation isn't required: you're prompted to consciously publish to the world
         #}
        {% if not article.isSubmitted %}
            {% if moderationRequired %}
                {% set buttonText = 'Submit for moderation' %}
            {% else %}
                {% set buttonText = 'Submit' %}
            {% endif %}
            <li>
                <form action="{{ routeLookup('commsNewsModeration.postSubmit', {articleId: article.id}) }}" method="post">
                    <input type="submit" value="{{ buttonText }}" />
                </form>
            </li>
        {% endif %}


        {# Moderators #}
        {% if isCommsOfficer %}
            {% if isRejectable %}

                {# Reject this news article #}
                {% set rejectRoute = routeLookupIfAuthorized('commsNewsModeration.postReject', {articleId: article.id}) %}

                {% if rejectRoute %}
                    {% if article.isPublished or article.isExpired %}
                        {% set verb = 'Unpublish' %}
                    {% else %}
                        {% set verb = 'Reject' %}
                    {% endif %}
                    <script>
                        $(function() {
                            $('#actionButtons').on('click', 'a[data-reject]', function(event) {
                                event.preventDefault();

                                var $element = $(this);
                                var $toast = $('#toast');
                                var title = $element.attr('data-reject');

                                $element.confirmDialog({
                                    header: '{{ verb }} ' + title,
                                    format: 'html',
                                    text: 'Provide brief feedback for {{ verb|lower }}ing this article to help the author improve their content. <textarea id="rejectedReason" rows="5"></textarea>',
                                    confirmLabel: '{{ verb }}',
                                    cancelLabel: 'Cancel',
                                    confirmEvent: function() {
                                        $toast.toastActivate({
                                            text: '{{ verb }}ing ' + title
                                        });

                                        $.ajax({
                                            type: 'POST',
                                            url: $element.attr('href'),
                                            data: {articleId: {{ article.id }}, rejectedReason: $('#rejectedReason').val()},
                                            dataType: 'json'
                                        }).success(function (response) {
                                            $toast.toastTimeout({
                                                text: title + ' was {{ verb|lower }}ed',
                                                css: 'success'
                                            });

                                            window.location.href = response.redirect;
                                        }).error(function (response) {
                                            var temp = $.parseJSON(response.responseText);

                                            $toast.toastTimeout({
                                                text: 'Error: ' + temp.message,
                                                css: 'alert'
                                            });
                                        });
                                    }
                                });
                            });
                        });
                    </script>
                    <li><a class="icon-undo" href="{{ rejectRoute }}" title="{{ verb }} this article" data-reject="{{ article.title }}">{{ verb }}</a></li>
                {% endif %}
            {% endif %}


            {# Accept this news article for publication to the world #}
            {% if isAcceptable %}
            <li>
                <form action="{{ routeLookup('commsNewsModeration.postAccept', {articleId: article.id}) }}" method="post">
                    <input type="submit" value="Approve" />
                </form>
            </li>
            {% endif %}
        {% endif %}

        </ul>
    </div>
</div>

<div class="toast" id="toast"></div>

<div id="recipientsModal" class="reveal-modal" data-reveal>
    <a class="close-reveal-modal">&#215;</a>
</div>
