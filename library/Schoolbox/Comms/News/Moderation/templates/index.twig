{% extends '@commsNews/page-layout.twig' %}

{% block breadCrumbs %}
    {% import 'sub/breadcrumbs.twig' as bread %}
    {{ bread.crumbs([locale.news.properPlural, routeLookup('commsNews.getIndex')], ['Requiring Moderation']) }}
{% endblock %}

{% block newsTitle %}Requiring Moderation{% endblock %}

{% block createLink %}
{% endblock %}

{% block newsContent %}
    <dl class="tabs" data-tab>
        <dd class="active">
            <a href="#awaiting-acceptance">Requiring Moderation</a>
        </dd>
        <dd>
            <a href="#accepted-articles">Recently Approved</a>
        </dd>
        <dd {{ selected|purify }}>
            <a href="#rejected-articles">Recently Rejected</a>
        </dd>
    </dl>
    <div class="tabs-content">
    {# A list of articles that require moderation
     # Moderation is performed by Comms Officers and their deputy Moderators (if assigned)
     #}
    <div class="content active" id="awaiting-acceptance">
        {% if articles|length %}
        <section>
                <ul class="information-list">
                    {% for article in articles %}
                        <li>
                            <div class="list-item">
                                <div class="small-12 card">
                                    <h3><a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}">{{ article.title }}</a></h3>
                                    <p class="meta">Submitted by

                                        {% if not article.author.deletedAt %}
                                            <a href="/search/user/{{ article.author.id }}" title="View Profile">{{ article.author.fullname }}</a>
                                        {% else %}
                                            {{ article.author.fullname }}
                                        {% endif %}

                                        <time title="{{ article.submittedAt.long }}">{{ article.submittedAt.relativeTime }}</time>
                                    </p>

                                    {% if article.topics|length %}
                                        <p class="meta">Related topics:
                                            {% for topic in article.topics %}
                                                <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <sbx-icon name="news" size="2.5rem"></sbx-icon>
                <p>All {{ locale.news }} have been processed.</p>
            </div>
        {% endif %}
    </div>


    {# A list of recently-accepted articles
     # Not having this is pretty disorienting
     #}
    <div class="content" id="accepted-articles">
    {% if recentlyAcceptedArticles|length %}
        <section>
            <ul class="information-list">
                {% for article in recentlyAcceptedArticles %}
                    <li>
                        <div class="list-item">
                            <div class="small-12 card">
                                <h3><a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}">{{ article.title }}</a></h3>
                                <p class="meta">Submitted by
                                    {% if not article.author.deletedAt %}
                                        <a href="/search/user/{{ article.author.id }}" title="View Profile">{{ article.author.fullname }}</a>
                                    {% else %}
                                        {{ article.author.fullname }}
                                    {% endif %}
                                    <time title="{{ article.submittedAt.long }}">{{ article.submittedAt.relativeTime }}</time>
                                </p>

                                <p class="meta">Approved by
                                    {% if not article.acceptedBy.deletedAt %}
                                        <a href="/search/user/{{ article.acceptedBy.id }}" title="View Profile">{{ article.acceptedBy.fullname }}</a>
                                    {% else %}
                                        {{ article.acceptedBy.fullname }}
                                    {% endif %}
                                    <time title="{{ article.acceptedAt.long }}">{{ article.acceptedAt.relativeTime }}</time>
                                </p>

                                {% if article.topics|length %}
                                    <p class="meta">Related topics:
                                        {% for topic in article.topics %}
                                            <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <div class="empty-state">
            <sbx-icon name="news" size="2.5rem"></sbx-icon>
            <p>No approved {{ locale.news }} has been found.</p>
        </div>
    {% endif %}
    </div>


    {# A list of recently-rejected articles
     # Not having this is pretty disorienting
     #}
    <div class="content" id="rejected-articles">
    {% if recentlyRejectedArticles|length %}
        <section>
                <ul class="information-list">
                    {% for article in recentlyRejectedArticles %}
                        <li>
                            <div class="list-item">
                                <div class="small-12 card">
                                    <h3><a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}">{{ article.title }}</a></h3>
                                    <p class="meta">Submitted by

                                        {% if not article.author.deletedAt %}
                                            <a href="/search/user/{{ article.author.id }}" title="View Profile">{{ article.author.fullname }}</a>
                                        {% else %}
                                            {{ article.author.fullname }}
                                        {% endif %}

                                        <time title="{{ article.submittedAt.long }}">{{ article.submittedAt.relativeTime }}</time>
                                    </p>

                                    <p class="meta">Rejected by
                                        {% if not article.rejectedBy.deletedAt %}
                                            <a href="/search/user/{{ article.rejectedBy.id }}" title="View Profile">{{ article.rejectedBy.fullname }}</a>
                                        {% else %}
                                            {{ article.rejectedBy.fullname }}
                                        {% endif %}

                                        <time title="{{ article.rejectedAt.long }}">{{ article.rejectedAt.relativeTime }}</time>
                                    </p>

                                    {% if article.topics|length %}
                                        <p class="meta">Related topics:
                                            {% for topic in article.topics %}
                                                <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
    {% else %}
        <div class="empty-state">
            <sbx-icon name="news" size="2.5rem"></sbx-icon>
            <p>No rejected {{ locale.news }} has been found.</p>
        </div>
    {% endif %}
    </div>
    </div>
{% endblock %}
