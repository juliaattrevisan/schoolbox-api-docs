{# A list of articles that require moderation
 # Moderation is performed by Comms Officers and their deputy Moderators (if assigned)
 #}
<div class="row">
    <div class="small-12 columns">
        <h1>Moderation List</h1>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Awaiting Acceptance</h2>

        {% if articles|length %}
        <section>
            <ul class="information-list">
                {% for article in articles %}
                    <li>
                        <div class="list-item">
                            <div class="small-12 card">
                                <h3><a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}">{{ article.title }}</a></h3>
                                <p class="meta">Authored by

                                    {% if article.author.deletedAt.isNull %}
                                        <a href="/search/user/{{ article.author.id }}" title="View Profile">{{ article.author.fullname }}</a>
                                    {% else %}
                                        {{ article.author.fullname }}
                                    {% endif %}

                                    on {{ article.updatedAt.local }}
                                </p>

                                {% if article.topics|length %}
                                    <p class="meta">Related topics:
                                        {% for topic in article.topics %}
                                            <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-news"></i>
            <p>All {{ locale.news }} have been processed.</p>
            <p>You can <a href="">view statistics on existing {{ locale.news }} articles</a> to see how they are faring.</p>
        </div>
        {% endif %}
    </div>
</div>

{# A list of recently-accepted articles
 # Not having this is pretty disorienting
 #}
{% if recentlyAcceptedArticles|length %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Recently Accepted</h2>

        <section>
            <ul class="information-list">
                {% for article in recentlyAcceptedArticles %}
                    <li>
                        <div class="list-item">
                            <div class="small-12 card">
                                <h3><a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}">{{ article.title }}</a></h3>
                                <p class="meta">Authored by {{ article.author.fullname }} on {{ article.updatedAt.local }}</p>
                                <p class="meta">Accepted by {{ article.acceptedBy.fullname }} on {{ article.acceptedAt.local }}</p>

                                {% if article.topics|length %}
                                    <p class="meta">Related topics:
                                        {% for topic in article.topics %}
                                            <a href="{{ routeLookup('commsNews.getIndex') }}?topic={{ topic.slug }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>
</div>
{% endif %}

{# A list of recently-rejected articles
 # Not having this is pretty disorienting
 #}
{% if recentlyRejectedArticles|length %}
    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">Recently Rejected</h2>

            <section>
                <ul class="information-list">
                    {% for article in recentlyRejectedArticles %}
                        <li>
                            <div class="list-item">
                                <div class="small-12 card">
                                    <h3><a href="{{ routeLookup('commsNews.getDetail', {articleId: article.id}) }}">{{ article.title }}</a></h3>
                                    <p class="meta">Authored by {{ article.author.fullname }} on {{ article.updatedAt.local }}</p>
                                    <p class="meta">Rejected by {{ article.rejectedBy.fullname }} on {{ article.rejectedAt.local }}</p>

                                    {% if article.topics|length %}
                                        <p class="meta">Related topics:
                                            {% for topic in article.topics %}
                                                <a href="{{ routeLookup('commsNews.getIndex', {slug: topic.slug}) }}" title="More {{ locale.news }} in {{ topic.name }}">{{ topic.name }}</a>{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endif %}