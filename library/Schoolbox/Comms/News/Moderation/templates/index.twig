{# A list of articles that require moderation
 # Moderation is performed by Comms Officers and their deputy Moderators (if assigned)
 #}
<div class="row">
    <div class="small-12 columns">
        <h1>Moderation Queue</h1>

    </div>
</div>
<div class="row">
    <div class="small-12 island">
        {% if articles|length %}
        <section>
            <ul class="information-list">
                {% for article in articles %}
                    <li class="content">
                        <h3><a href="{{ routeLookup('commsNews.getDetail', {newsId: article.id}) }}">{{ article.title }}</a></h3>
                        <p class="meta">Authored by {{ article.author.fullname }} on {{ article.updatedAt.local }}</p>
                        <p>{{ article.blurb|purify }}</p>
                    </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-news"></i>
            {% if moderationRequired %}
                <p>All articles have been processed.</p>
            {% else %}
                <p>According to Comms Policy, Moderation isn't required.</p>
            {% endif %}

            <p>You can <a href="">view statistics on existing articles</a> to see how they are faring.</p>
        </div>
        {% endif %}
    </div>
</div>