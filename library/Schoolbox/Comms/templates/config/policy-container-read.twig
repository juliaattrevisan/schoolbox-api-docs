<section>
    <ul class="information-list">
        {% for policy in policies %}
            <li class="content">
                {% if policy.isActive %}
                    <strong>{{ policy.options.active.state }}</strong>. {{ policy.options.active.description }}
                {% else %}
                    <strong>{{ policy.options.inactive.state }}</strong>. {{ policy.options.inactive.description }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</section>