{# Add a list of current Comms Officers
 #}
{% include '@comms/config/comms-officers.twig' with {
    allCommsOfficers: allCommsOfficers
} %}

{% set isSuperuser = USER.isSuperuser %}

{% set policies = [
    {
        'label': 'Global Moderation',
        'template': 'policy-global-moderation',
        'isActive': true,
        'options': {
            'active': '<strong>Global moderation is on</strong>. Every article requires moderator approval.',
            'inactive': '<strong>Global moderation is off</strong>. You can freely post articles.'
        }
    },
    {
        'label': 'Likes',
        'template': 'policy-likes',
        'isActive': false,
        'options': {
            'active': '<strong>Likes is on</strong>. Every article can receive Likes.',
            'inactive': '<strong>Likes is off</strong>. Articles cannot receive audience feedback like this.'
        }
    }
] %}

{# Show a list of configuration options that can be changed by super
 # Otherwise just show the conclusion to everyone else
 #}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Comms Policy Settings</h2>
            {% if USER.isSuperuser %}
                {% include '@comms/config/policy-container-write.twig' %}
            {% else %}
                {% include '@comms/config/policy-container-read.twig' %}
            {% endif %}
        </section>
    </div>
</div>

