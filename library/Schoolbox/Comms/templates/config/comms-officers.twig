<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Comms Officers</h2>
        {% if allCommsOfficers|length %}
        <section>
            <ul class="information-list">
                {% for officer in allCommsOfficers %}
                <li>
                    <div class="card small-12">
                        <a href="#" title="View Profile">
                            <img src="/portrait.php?userId={{ officer.externalId }}&size=square64" alt="View Profile" />
                            <p>{{ officer.fullname }}</p>
                        </a>
                        <p class="meta">{{ officer.role.name }}</p>
                    </div>

                </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-staff-students"></i>
            <p>There are no Comms Officers.</p>
            {% if user.isSuperuser %}
            <p><a href="/adminv2/home/user" title="Add Comms Officers">Assign Comms Officer service permissions</a> to a user.</p>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
