<label for="policy-global-moderation">Global Moderation</label>
<p>Enable to require moderation on every article before they are made publicly available.</p>
<div class="switch">
    <input id="policy-global-moderation" type="checkbox" {% if policy.isActive %}checked{% endif %}>
    <label for="policy-global-moderation">
        <span>On</span>
        <span>Off</span>
    </label>
</div>