<label for="{{ policy.template }}">{{ policy.label }}</label>
<p>{{ policy.options.config }}.</p>
<div class="switch">
    <input id="{{ policy.template }}" type="checkbox" {% if policy.isActive %}checked{% endif %}>
    <label for="{{ policy.template }}">
        <span>On</span>
        <span>Off</span>
    </label>
</div>