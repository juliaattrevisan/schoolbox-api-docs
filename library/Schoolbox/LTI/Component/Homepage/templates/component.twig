{% if providers is empty %}

    <div id="lti-select-provider{{ componentInstanceId }}" class="row " data-collapsable="true" data-collapse-state="uncollapsed">
        <div class="small-12 island">
            <section>
                <div class="empty-state">
                    <i class="icon-lti"></i>

                    {% if user.superUser %}
                        <p>
                            <a href="/adminv2/lti">Add an LTI provider</a> in the Administration system to allow
                            users to embed third party learning tools in this component.
                        </p>
                    {% else %}
                        <p>Ask your System Administrator to add LTI providers to use this feature.</p>
                    {% endif %}

                </div>
            </section>
        </div>
    </div>

{% else %}
    {% if providerId is empty %}
        <div id="lti-select-provider{{ componentInstanceId }}" class="row" data-collapsable="true" data-collapse-state="uncollapsed">
            <div class="small-12 island">
                <section>
                    <div class="empty-state">
                        <i class="icon-settings"></i>
                            <p>
                                Select a third party learning tool to display in this component for users to
                                interact with.
                            </p>
                            <p>
                                {% for provider in providers %}
                                    {% if provider.isLtiVersion11 %}
                                        <button data-provider="{{ provider.id }}"
                                                data-provider-version="1.1"
                                                data-provider-target="{{ provider.target }}"
                                        >{{ provider.name }}</button>
                                    {% elseif provider.isLtiVersion13 %}
                                        {% set hasMultipleUrls = provider.launchUrl and provider.deepLinkingUrl %}
                                        {% if provider.launchUrl %}
                                            <button data-provider="{{ provider.id }}"
                                                    data-provider-version="1.3"
                                                    data-provider-launch-url="{{ provider.launchUrl }}"
                                                    data-provider-target="{{ provider.target }}"
                                            >{{ provider.name }}{% if hasMultipleUrls %} (Basic Launch){% endif %}</button>
                                        {% endif %}
                                        {% if provider.deepLinkingUrl %}
                                            <button data-provider="{{ provider.id }}"
                                                    data-provider-version="1.3"
                                                    data-provider-target="{{ provider.target }}"
                                            >{{ provider.name }}{% if hasMultipleUrls %} (Picker){% endif %}</button>
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            </p>
                        </div>
                </section>
            </div>
        </div>

        <div id="lti-select-preloader{{ componentInstanceId }}" style="display:none;">
            <div class="small-12 island">
                <section class="content">
                    <div class="loader"></div>
                </section>
            </div>
        </div>

        <iframe id="lti-frame{{ componentInstanceId }}"
                style="height: {{ height }}px; display: none"
                src="about:blank" frameborder="0">
        </iframe>
        <section class="content" style="display: none" >
        <a id="lti-link{{ componentInstanceId }}"
               href="#"
               target="lti-link"
               style="display: none"
               class="button full-width">
            </a>
        </section>

    {% else %}
        {# Another possible case: what if the deep linking request returned a... link? #}
        {% if provider and provider.isLtiVersion13 %}
            {##
             # Has a URL been selected?
             # If so use the launch URL, otherwise show the deep link request
             #}
            {% if embedUrl %}
                {% set src = routeLookup(
                    'ltiPlatformContext.getLaunchResourceLinkRequestForFolderAndComponent',
                    {
                        toolId:      providerId,
                        componentId: componentInstanceId,
                        folderId:    folderId,
                    }
                ) %}
            {% else %}
                {% set src = routeLookup(
                    'ltiPlatformContext.getGenerateDeepLinkingRequestForFolder',
                    {
                        toolId:   providerId,
                        folderId: folderId,
                    }
                ) %}
            {% endif %}
        {% else %}
            {# Use the LTI 1.1 launch URL #}
            {% set src = routeLookup(
                'ltiConsumer.getLaunch',
                {
                    providerId:  providerId,
                    componentId: componentInstanceId,
                    folderId:    folderId,
                }
            ) %}
        {% endif %}

        {# Is this supposed to launch in an iframe, or a window? #}
        {% if provider.isTargetIframe %}
            <iframe id="lti-frame{{ componentInstanceId }}"
                    {% if provider %}
                    style="height: {{ height }}px;"
                    {% endif %}
                    src="{{ src }}?context=componentInstance-{{ componentInstanceId }}"
                    frameborder="0"></iframe>
        {% elseif provider.isTargetWindow %}
            <section class="content">
                <a id="lti-link{{ componentInstanceId }}"
                   target="lti-link"
                   href="{{ src }}?context=componentInstance-{{ componentInstanceId }}"
                   class="button icon-external-link full-width">
                    {% if embedUrl %}Launch embedded tool{% else %}Select content to embed{% endif %}
                </a>
            </section>
        {% endif %}
    {% endif %}
{% endif %}

<div id="lti-toaster{{ componentInstanceId }}" class="toast"></div>

{# LTI component JS configuration #}
{% set providerIdPlaceholder = 'providerIdPlaceholder' %}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/lti/jquery.ltiComponent.js?v={{ config.site_version }}"></script>
{% autoescape 'js' %}
    <script type="text/javascript">
        $(function () {
            $('#component{{ componentInstanceId }}').ltiComponent({
                componentInstanceId: '{{ componentInstanceId }}',
                $componentTitle: $('#component-title-{{ componentInstanceId }}'),
                $toast: $('#lti-toaster{{ componentInstanceId }}'),
                $ltiSelectProvider: $('#lti-select-provider{{ componentInstanceId }}'),
                $ltiSelectPreloader: $('#lti-select-provider{{ componentInstanceId }}'),
                $ltiLink: $('#lti-link{{ componentInstanceId }}'),
                linkTextBeforeContentSelected: 'Select content to embed',
                linkTextAfterContentSelected: 'Launch embedded tool',
                $ltiIframe: $('#lti-frame{{ componentInstanceId }}'),
                providerIdPlaceholder: '{{ providerIdPlaceholder }}',
                postComponentProviderBaseUrl: '{{
                    routeLookup(
                        'ltiConsumer.postComponentProvider',
                        {
                            providerId:  providerId ?: providerIdPlaceholder,
                            componentId: componentInstanceId,
                        }
                    )
                }}',
                lti1p1LaunchUrl: '{{
                    routeLookup(
                        'ltiConsumer.getLaunch',
                        {
                            providerId:  providerId ?: providerIdPlaceholder,
                            componentId: componentInstanceId,
                            folderId:    folderId
                        }
                    )
                }}',
                lti1p3LaunchUrl: '{{
                    routeLookup(
                        'ltiPlatformContext.getLaunchResourceLinkRequestForFolderAndComponent',
                        {
                            toolId:      providerId ?: providerIdPlaceholder,
                            componentId: componentInstanceId,
                            folderId:    folderId,
                        }
                    )
                }}',
                lti1p3DeepLinkingUrl: '{{
                    routeLookup(
                        'ltiPlatformContext.getGenerateDeepLinkingRequestForFolder',
                        {
                            toolId:   providerId ?: providerIdPlaceholder,
                            folderId: folderId,
                        }
                    )
                }}',
            });
        });
    </script>
{% endautoescape %}
