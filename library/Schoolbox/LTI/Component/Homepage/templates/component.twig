{% if providers is empty %}

    <div id="lti-select-provider{{ componentInstanceId }}" class="row " data-collapsable="true" data-collapse-state="uncollapsed">
        <div class="small-12 island">
            <section>
                <div class="empty-state">
                    <i class="icon-lti"></i>

                    {% if user.superUser %}
                        <p>
                            <a href="/adminv2/lti">Add an LTI provider</a> in the Administration system to allow
                            users to embed third party learning tools in this component.
                        </p>
                    {% else %}
                        <p>Ask your System Administrator to add LTI providers to use this feature.</p>
                    {% endif %}

                </div>
            </section>
        </div>
    </div>

{% else %}

    {% set learningfieldProviderId = '' %}
    {% set providerIdPlaceholder   = 'providerIdPlaceholder' %}

    {% if providerId is empty %}
        <div id="lti-select-provider{{ componentInstanceId }}" class="row" data-collapsable="true" data-collapse-state="uncollapsed">
            <div class="small-12 island">
                <section>
                    <div class="empty-state">
                        <i class="icon-settings"></i>
                            <p>
                                Select a third party learning tool to display in this component for users to
                                interact with.
                            </p>
                            <p>
                                {% set foundLearningField = false %}
                                {% for provider in providers %}
                                    {% if provider.isLtiVersion11 %}
                                        {# Disgusting hard-coding for a particular provider (present since inception) #}
                                        {% if provider.url == 'https://bc.vitalsource.com/books/book' %}
                                            {% set learningfieldProviderId = provider.id %}
                                            <button data-reveal-id="modal-learningfield">{{ provider.name }}</button>
                                            {% set foundLearningField = true %}
                                        {% else %}
                                            <button data-provider="{{ provider.id }}"
                                                    data-provider-version="1.1"
                                            >{{ provider.name }}</button>
                                        {% endif %}
                                    {% elseif provider.isLtiVersion13 %}
                                        {% set hasMultipleUrls = provider.launchUrl and provider.deepLinkingUrl %}
                                        {% if provider.launchUrl %}
                                            <button data-provider="{{ provider.id }}"
                                                    data-provider-version="1.3"
                                                    data-provider-launch-url="{{ provider.launchUrl }}"
                                            >{{ provider.name }}{% if hasMultipleUrls %} (Basic Launch){% endif %}</button>
                                        {% endif %}
                                        {% if provider.deepLinkingUrl %}
                                            <button data-provider="{{ provider.id }}"
                                                    data-provider-version="1.3"
                                            >{{ provider.name }}{% if hasMultipleUrls %} (Picker){% endif %}</button>
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            </p>
                        </div>
                </section>
            </div>
        </div>
        <div id="lti-select-preloader{{ componentInstanceId }}" style="display:none;">
            <div class="small-12 island">
                <section class="content">
                    <div class="loader"></div>
                </section>
            </div>
        </div>

        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/lti/jquery.ltiComponent.js"></script>

        {% autoescape 'js' %}
        <script type="text/javascript">
            $(function () {
                $('#component{{ componentInstanceId }}').ltiComponent({
                    componentInstanceId: '{{ componentInstanceId }}',
                    $toast: $('#lti-toaster{{ componentInstanceId }}'),
                    $ltiSelectProvider: $('#lti-select-provider{{ componentInstanceId }}'),
                    $ltiSelectPreloader: $('#lti-select-provider{{ componentInstanceId }}'),
                    $ltiIframe: $('#lti-frame{{ componentInstanceId }}'),
                    providerIdPlaceholder: '{{ providerIdPlaceholder }}',
                    postComponentProviderBaseUrl: '{{
                        routeLookup(
                            'ltiConsumer.postComponentProvider',
                            {
                                providerId:  providerId ?: providerIdPlaceholder,
                                componentId: componentInstanceId,
                            }
                        )
                    }}',
                    lti1p1LaunchUrl: '{{
                        routeLookup(
                            'ltiConsumer.getLaunch',
                            {
                                providerId:  providerId ?: providerIdPlaceholder,
                                componentId: componentInstanceId,
                                folderId:    folderId
                            }
                        )
                    }}',
                    lti1p3LaunchUrl: '{{
                        routeLookup(
                            'ltiPlatformContext.getLaunchResourceLinkRequestForFolderAndComponent',
                            {
                                providerId:  providerId ?: providerIdPlaceholder,
                                componentId: componentInstanceId,
                                folderId:    folderId,
                            }
                        )
                    }}',
                    lti1p3DeepLinkingUrl: '{{
                        routeLookup(
                            'ltiPlatformContext.getGenerateDeepLinkingRequestForFolder',
                            {
                                providerId: providerId ?: providerIdPlaceholder,
                                folderId:   folderId,
                            }
                        )
                    }}',
                });
            });
        </script>
        {% endautoescape %}

        {% autoescape 'js' %}
        <script type="text/javascript">
            $(function () {
                // More disgusting hard-coding for a particular provider
                {% if foundLearningField %}
                let component = $('#component{{ componentInstanceId }}');
                component.find('[data-provider-learningfield]').click(function () {

                    $.post('{{ routeLookup('ltiConsumer.postComponentProvider', {
                        providerId: 'providerId',
                        componentId: componentInstanceId
                    }) }}'.replace(/providerId/g, '{{ learningfieldProviderId }}'), {
                        url: $('#learningfieldUrl').val()
                    }).done(function () {
                        window.location.reload();
                    });
                });
                {% endif %}
            });
        </script>
        {% endautoescape %}

        <div id="modal-learningfield"
             class="reveal-modal"
             data-reveal aria-labelledby="modalTitle"
             aria-hidden="true"
             role="dialog">
            <p class="lead">Book Source</p>
            <p>Please copy/paste the URL of the resource you want to embed below.</p>
            <input type="text" id="learningfieldUrl"
                   placeholder="(e.g. https://bookshelf.vitalsource.com/books/LF9781740813518/pageid/152)">
            <button data-provider-learningfield="learningfieldProviderId">Save</button>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </div>

        <iframe id="lti-frame{{ componentInstanceId }}" style="height:{{ height }}px;display:none;" src="about:blank" frameborder="0"></iframe>

    {% else %}
        {# Another possible case: what if the deep linking request returned a... link? #}
        {% set src = (provider and provider.isLtiVersion13)
            ? (
                provider.url
                    ? routeLookup('ltiPlatformContext.getLaunchResourceLinkRequestForFolderAndComponent', {
                        toolId:      providerId,
                        componentId: componentInstanceId,
                        folderId:    folderId,
                    })
                    : routeLookup('ltiPlatformContext.getGenerateDeepLinkingRequestForFolder', {
                        toolId:   providerId,
                        folderId: folderId,
                    })
            )
            : routeLookup('ltiConsumer.getLaunch', {
                providerId:  providerId,
                componentId: componentInstanceId,
                folderId:    folderId
            })
        %}
        <iframe id="lti-frame{{ componentInstanceId }}"

                {% if provider %}
                style="height:{{ height }}px;"
                {% endif %}

                src="{{ src }}" frameborder="0"></iframe>
    {% endif %}

    {% autoescape 'js' %}
    <script type="text/javascript">
        // If a picker is launched: need to listen for its message,
        // and update the component's config when it happens
        window.addEventListener(
            'message',
            (event) => {
                if (event.data) {
                    // Fill in the component with values from the message data
                    let data         = event.data,
                        tool         = data?.tool,
                        messageType  = data?.messageType,
                        resourceLink = data?.resourceLinks?.[0];

                    // Not a deep linking response: ignore this message
                    if (messageType === '{{ deepLinkingResponseMessageType }}') {
                        // Look at the first resource link, set values based on that
                        let $iframe = $('#lti-frame{{ componentInstanceId }}');
                        if (resourceLink) {
                            let url = resourceLink?.url ?? tool?.launchUrl;
                            if (url) {
                                // Post to the component configuration
                                let postComponentProviderBaseUrl = '{{ routeLookup('ltiConsumer.postComponentProvider', {
                                    providerId:  providerId,
                                    componentId: componentInstanceId,
                                }) }}',
                                postComponentProviderParams = {
                                    url:    url,
                                    custom: resourceLink?.custom ?? {},
                                };

                                $.post(
                                    postComponentProviderBaseUrl,
                                    postComponentProviderParams
                                ).done(function () {
                                    $iframe.attr(
                                        'src',
                                        '{{ routeLookup(
                                            'ltiPlatformContext.getLaunchResourceLinkRequestForFolderAndComponent',
                                            {
                                                toolId:      providerId,
                                                componentId: componentInstanceId,
                                                folderId:    folderId,
                                            }
                                        ) }}'
                                    );
                                });
                            }
                        } else {
                            // Just reload the deep linking launch URL
                            $iframe.attr(
                                'src',
                                '{{ routeLookup(
                                    'ltiPlatformContext.getGenerateDeepLinkingRequestForFolder',
                                    {
                                        toolId:   providerId,
                                        folderId: folderId,
                                    }
                                ) }}'
                            );
                        }
                    }
                }
            }
        );
    </script>
    {% endautoescape %}
{% endif %}

<div id="lti-toaster{{ componentInstanceId }}" class="toast"></div>
