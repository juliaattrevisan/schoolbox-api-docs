{% if providers is empty %}

    <div id="lti-select-provider{{ componentInstanceId }}" class="row " data-collapsable="true" data-collapse-state="uncollapsed">
        <div class="small-12 island">
            <section>
                <div class="empty-state">
                    <i class="icon-lti"></i>

                    {% if user.superUser %}
                        <p>
                            <a href="/adminv2/lti">Add an LTI provider</a> in the Administration system to allow
                            users to embed third party learning tools in this component.
                        </p>
                    {% else %}
                        <p>Ask your System Administrator to add LTI providers to use this feature.</p>
                    {% endif %}

                </div>
            </section>
        </div>
    </div>

{% else %}

    {% set learningfieldProviderId = '' %}

    {% if providerId is empty %}
        <div id="lti-select-provider{{ componentInstanceId }}" class="row" data-collapsable="true" data-collapse-state="uncollapsed">
            <div class="small-12 island">
                <section>
                    <div class="empty-state">
                        <i class="icon-settings"></i>
                            <p>
                                Select a third party learning tool to display in this component for users to
                                interact with.
                            </p>
                            <p>
                                {% set foundLearningField = false %}
                                {% for provider in providers %}
                                    {% if provider.isLtiVersion11 %}
                                        {# Disgusting hard-coding for a particular provider (present since inception) #}
                                        {% if provider.url == 'https://bc.vitalsource.com/books/book' %}
                                            {% set learningfieldProviderId = provider.id %}
                                            <button data-reveal-id="modal-learningfield">{{ provider.name }}</button>
                                            {% set foundLearningField = true %}
                                        {% else %}
                                            <button data-provider="{{ provider.id }}"
                                                    data-provider-version="1.1"
                                            >{{ provider.name }}</button>
                                        {% endif %}
                                    {% elseif provider.isLtiVersion13 %}
                                        {% set hasMultipleUrls = provider.launchUrl and provider.deepLinkingUrl %}
                                        {% if provider.launchUrl %}
                                            <button data-provider="{{ provider.id }}"
                                                    data-provider-version="1.3"
                                                    data-provider-launch-url="{{ provider.launchUrl }}"
                                            >{{ provider.name }}{% if hasMultipleUrls %} (Basic Launch){% endif %}</button>
                                        {% endif %}
                                        {% if provider.deepLinkingUrl %}
                                            <button data-provider="{{ provider.id }}"
                                                    data-provider-version="1.3"
                                            >{{ provider.name }}{% if hasMultipleUrls %} (Picker){% endif %}</button>
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            </p>
                        </div>
                </section>
            </div>
        </div>
        <div id="lti-select-preloader{{ componentInstanceId }}" style="display:none;">
            <div class="small-12 island">
                <section class="content">
                    <div class="loader"></div>
                </section>
            </div>
        </div>

        {% autoescape 'js' %}
        <script type="text/javascript">
            $(function () {

                let component = $('#component{{ componentInstanceId }}');

                {% if foundLearningField %}
                component.find('[data-provider-learningfield]').click(function () {

                    $.post('{{ routeLookup('ltiConsumer.postComponentProvider', {
                        providerId: 'providerId',
                        componentId: componentInstanceId
                    }) }}'.replace(/providerId/g, '{{ learningfieldProviderId }}'), {
                        url: $('#learningfieldUrl').val()
                    }).done(function () {
                        window.location.reload();
                    });
                });
                {% endif %}

                component.find('[data-provider]').click(function () {

                    let $toaster = $('#lti-toaster{{ componentInstanceId }}');
                    $toaster.toastActivate({text: 'Loading LTI Provider...'});

                    {# Display a preloader #}

                    $('#lti-select-provider{{ componentInstanceId }}').hide();
                    $('#lti-select-preloader{{ componentInstanceId }}').show();

                    {# When a provider is clicked we need to dynamically update the component and launch the #}
                    {# LTI request in its iframe #}

                    let $this                        = $(this),
                        providerId                   = $this.attr('data-provider'),
                        providerVersion              = $this.attr('data-provider-version'),
                        providerLaunchUrl            = $this.attr('data-provider-launch-url'),
                        postComponentProviderBaseUrl = '{{ routeLookup('ltiConsumer.postComponentProvider', {
                            providerId: 'providerId',
                            componentId: componentInstanceId,
                        }) }}',
                        postComponentProviderParams  = {};

                    if (providerVersion === '1.3' && providerLaunchUrl) {
                        postComponentProviderParams.url = providerLaunchUrl;
                    }

                    $.post(
                        postComponentProviderBaseUrl.replace(/providerId/g, providerId),
                        postComponentProviderParams
                    ).done(function (result) {

                        {# Hide preloader #}
                        $('#lti-select-preloader{{ componentInstanceId }}').hide();

                        $toaster.toastTimeout({text:'Component loaded'});

                        {# Update selected provider name in component configuration settings #}
                        $('#component{{ componentInstanceId }}-ltiprovider').val(providerId);

                        {# Update heading #}
                        component.find('input[name="componentname"]').val(result.providerName);

                        {# Update component heading #}
                        $('#component-title-{{ componentInstanceId }}').html(result.providerName);

                        {# Launch LTI in the iframe and make it visibile #}
                        let iframe = $('#lti-frame{{ componentInstanceId }}');

                        iframe.attr('src', '{{ routeLookup('ltiConsumer.getLaunch', {
                            providerId: 'providerId',
                            componentId: componentInstanceId,
                            folderId: folderId
                        }) }}'.replace(/providerId/g, providerId));

                        iframe.show();
                    }).fail(function () {
                        {# This shouldn't happen, but just in case something goes wrong #}
                        $('#lti-select-preloader{{ componentInstanceId }}').hide();
                        $('#lti-select-provider{{ componentInstanceId }}').show();

                        $toaster.toastTimeout({text: 'Unable to load LTI Provider', css: 'alert'});
                    });
                });

            });
        </script>
        {% endautoescape %}

        <div id="modal-learningfield"
             class="reveal-modal"
             data-reveal aria-labelledby="modalTitle"
             aria-hidden="true"
             role="dialog">
            <p class="lead">Book Source</p>
            <p>Please copy/paste the URL of the resource you want to embed below.</p>
            <input type="text" id="learningfieldUrl"
                   placeholder="(e.g. https://bookshelf.vitalsource.com/books/LF9781740813518/pageid/152)">
            <button data-provider-learningfield="learningfieldProviderId">Save</button>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </div>

        <iframe id="lti-frame{{ componentInstanceId }}" style="height:{{ height }}px;display:none;" src="about:blank" frameborder="0"></iframe>

    {% else %}
        <iframe id="ltiFrame{{ componentInstanceId }}"

                {% if provider %}
                style="height:{{ height }}px;"
                {% endif %}

                src="{{ routeLookup('ltiConsumer.getLaunch', {
                    providerId: providerId,
                    componentId: componentInstanceId,
                    folderId: folderId
                }) }}" frameborder="0"></iframe>
    {% endif %}

{% endif %}

<div id="lti-toaster{{ componentInstanceId }}" class="toast"></div>
