{##
 # Unavailable
 #
 # For when your LTI provider was previously set, but is now deleted or
 # otherwise unavailable; instead of displaying a 404 page in an iframe
 # give them this semblance of hope
 #
 # @param Provider $provider
 #}
{% include 'include/skin.twig' with { config: config } only %}

<div class="empty-state">
    <sbx-icon name="news" size="2.5rem"></sbx-icon>
    <p>{{ provider.name }} is no longer available - you can safely remove this component.</p>
</div>
