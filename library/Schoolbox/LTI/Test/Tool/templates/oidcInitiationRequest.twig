<h1>LTI Test Tool</h1>

<h2>OIDC initiation request received from platform, for launching a resource link</h2>

<h3>About the resource link request</h3>
<dl>
    <dt>Target link URI</dt>
    <dd>{{ message.parameters.get('redirect_uri') }}</dd>

    <dt>Login hint</dt>
    <dd>{{ message.parameters.get('login_hint') }}</dd>
</dl>

<a href="{{ message.toUrl }}" class="button submit">Send authentication response to platform</a>
