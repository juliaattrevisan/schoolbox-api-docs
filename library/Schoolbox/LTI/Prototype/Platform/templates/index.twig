<h1>LTI Prototype Platform</h1>

<h2>Generate a message</h2>

<form method="get" action="{{ routeLookup('ltiPrototypePlatform.getGenerateMessage') }}" target="_blank">
    <dl>
        <dt><label for="registration">Registration</label></dt>
        <dd>
            <select id="registration" name="registration">
                {% for registration in registrations %}
                    <option value="{{ registration.identifier }}">{{ registration.tool.name }} ({{ registration.clientId }})</option>
                {% endfor %}
            </select>
        </dd>

        <dt><label for="messageType">Message Type</label></dt>
        <dd>
            <select id="messageType" name="messageType">
                {% for value, label in messageTypes %}
                    <option value="{{ value }}" label="{{ label }}">{{ label }}</option>
                {% endfor %}
            </select>
        </dd>

        {% include '@ltiPrototypePlatform/fragments/userSelector.twig' with {
            studentUsers: studentUsers,
            staffUsers: staffUsers,
        } only %}
    </dl>
    <button type="submit">Generate message</button>
</form>
