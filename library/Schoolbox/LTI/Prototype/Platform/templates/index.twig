<h1>LTI Prototype Platform</h1>

<h2>Generate a message</h2>

<form method="get" action="{{ routeLookup('ltiPrototypePlatform.getGenerateMessage') }}">
    <dl>
        <dt><label for="registration">Registration</label></dt>
        <dd>
            <select id="registration" name="registration">
                {% for registration in registrations %}
                    <option value="{{ registration.identifier }}">{{ registration.tool.name }}</option>
                {% endfor %}
            </select>
        </dd>

        <dt><label for="messageType">Message Type</label></dt>
        <dd>
            <select id="messageType" name="messageType">
                {% for value, label in messageTypes %}
                    <option value="{{ value }}" label="{{ label }}">{{ label }}</option>
                {% endfor %}
            </select>
        </dd>

        <dt><label for="loginHint">Login Hint (a username)</label></dt>
        <dd>
            <select id="loginHint" name="loginHint">
                <option value="{{ USER.username }}" selected>{{ USER.username }} ({{ USER.fullname }}: current user)</option>
                <option value="xxxxx">xxxxx (non-existent user)</option>
                <optgroup label="Staff">
                    {% for user in staffUsers %}
                    <option value="{{ user.username }}">{{ user.username }} ({{ user.fullname }})</option>
                    {% endfor %}
                </optgroup>
                <optgroup label="Students">
                    {% for user in studentUsers %}
                        <option value="{{ user.username }}">{{ user.username }} ({{ user.fullname }})</option>
                    {% endfor %}
                </optgroup>
            </select>
        </dd>
    </dl>
    <button type="submit">Generate message</button>
</form>
