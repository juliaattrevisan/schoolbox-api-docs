<h1>LTI Prototype Platform</h1>

<h2>Deep linking response received from tool</h2>

<h3>About the response</h3>
<dl>
    <dt>Valid?</dt>
    <dd>{{ result.hasError ? 'N' : 'Y' }}</dd>

    <dt>Version</dt>
    <dd>{{ result.payload.version ?? '' }}</dd>

    <dt>User identity</dt>
    <dd>{{ result.payload.userIdentity.identifier ?? '' }}</dd>

    <dt>User name</dt>
    <dd>{{ result.payload.userIdentity.name ?? '' }}</dd>

    <dt>User email</dt>
    <dd>{{ result.payload.userIdentity.email ?? '' }}</dd>
</dl>

