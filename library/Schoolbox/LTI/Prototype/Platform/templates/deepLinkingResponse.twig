<h1>LTI Prototype Platform</h1>

<h2>Deep linking response received from tool</h2>

<h3>About the response</h3>

<form method="get" action="{{ routeLookup('ltiPrototypePlatform.getGenerateMessage') }}">
    <input type="hidden" name="registration" value="{{ result.registration.identifier }}" />
    <input type="hidden" name="messageType" value="{{ messageType }}" />
    <dl>
        <dt>Result</dt>
        <dd>
            {% for success in (result.successes ?? []) %}
                <div>✅ {{ success }}</div>
            {% endfor %}
            {% if result.hasError %}
                <div>❌ {{ result.error ?? '' }}</div>
            {% endif %}
        </dd>

        {# From each returned resource link: create a resource link launch request #}
        {% if not result.hasError %}
            <dt>Version</dt>
            <dd>{{ result.payload.version ?? '' }}</dd>

            <dt><label for="targetUrl">Target URL</label></dt>
            <dd>
                <select id="targetUrl" name="targetUrl">
                    {% for resourceLink in resourceLinks %}
                        <option value="{{ resourceLink.url }}">{{ resourceLink.title }} ({{ resourceLink.url }})</option>
                    {% endfor %}
                </select>
            </dd>

            {% include '@ltiPrototypePlatform/fragments/userSelector.twig' with {
                studentUsers: studentUsers,
                staffUsers: staffUsers,
            } only %}
        {% endif %}
    </dl>

    <button type="submit">Generate message</button>
</form>
