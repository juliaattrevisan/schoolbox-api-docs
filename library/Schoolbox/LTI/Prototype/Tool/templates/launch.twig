{% extends '@ltiPrototypeTool/base.twig' %}

{% block content %}
    <h1>LTI Prototype Tool</h1>

    <h2>Resource link launch request received from platform</h2>

    <h3>About the launch request</h3>
    <dl>
        <dt>Valid?</dt>
        <dd>{{ result.hasError ? 'N' : 'Y' }}</dd>

        <dt>Version</dt>
        <dd>{{ result.payload.version ?? '' }}</dd>

        <dt>User identity</dt>
        <dd>{{ result.payload.userIdentity.identifier ?? '' }}</dd>

        <dt>User name</dt>
        <dd>{{ result.payload.userIdentity.name ?? '' }}</dd>

        <dt>User email</dt>
        <dd>{{ result.payload.userIdentity.email ?? '' }}</dd>
    </dl>

    <a href="{{ routeLookup('ltiPrototypePlatform.getIndex') }}">Return to platform</a>
{% endblock content %}
