{% extends '@ltiPrototypeTool/base.twig' %}

{% block content %}
    <h1>LTI Prototype Tool</h1>

    <h2>Resource link launch request + OpenID Connect initiation received from platform</h2>

    <h3>About the resource link request</h3>
    <dl>
        <dt>Target Link URI</dt>
        <dd>{{ message.parameters.get('redirect_uri') }}</dd>

        <dt>Login Hint</dt>
        <dd>{{ message.parameters.get('login_hint') }}</dd>
    </dl>

    <a href="{{ message.toUrl }}">Send OpenID Connect authentication to platform</a>
{% endblock content %}
