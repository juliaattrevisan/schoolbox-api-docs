<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>LTI Platform: Receive Deep Linking Response</title>

    {% set payload = {
        messageType: messageType,
        context: context,
        tool:          {
            id: tool.id,
            launchUrl: tool.launchUrl,
        },
        resourceLinks: resourceLinks,
    } %}
    {% autoescape 'js' %}
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function() {
            let openingWindow, closeCurrentWindow;
            if (window.opener) {
                // this link was opened in a new tab/window: close this window
                openingWindow = window.opener;
                closeCurrentWindow = true;
            } else {
                // this link was opened in an iframe: keep this window open
                openingWindow = window.top;
                closeCurrentWindow = false;
            }

            openingWindow.postMessage(
                {{ payload | json_encode | raw }},
                window.location.origin
            );

            if (closeCurrentWindow) {
                window.close();
            }
        });
    </script>
    {% endautoescape %}
</head>
<body>
</body>
</html>
