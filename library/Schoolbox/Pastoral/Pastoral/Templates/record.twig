{% if role != 'parent' %}

    <script type="text/javascript">
        $(function () {

            // Delete pastoral record

            $('[data-delete]').click(function(event) {
                event.preventDefault();

                var element = $(this);

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this record?',
                    confirmEvent: function() {
                        $.post('/pastoral/delete', {
                            id: {{ record.getId() }}
                        })
                        .done(function() {
                            window.location.href = '/pastoral/{{ record.getStudentId() }}';
                        });
                    }
                });
            });

            // Delete comment

            $('[data-delete-comment]').click(function(event) {
                event.preventDefault();

                var element = $(this);

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this comment?',
                    confirmEvent: function() {
                        $.post('/pastoral/commentDelete', {
                            id: $(event.target).attr('data-delete-comment')
                        })
                        .done(function() {

                            // Remove comment after AJAX return

                            $(event.target).closest('li').remove();
                        });
                    }
                });
            });
        });
    </script>

{% endif %}

<ul class="breadcrumb">
    <li><a href="/search/user/{{ record.getStudentId }}">{{ user.formatName() }}</a></li>
    <li><a href="/pastoral/{{ record.getStudentId }}">Pastoral Care</a></li>
    <li class="active"><a href="#">{{ record.getHeading() }}</a></li>
</ul>

<div class="row">
    <div class="small-12 island">
        <h1>{{ user.formatName() }}</h1>
        <h2>Pastoral Record Details</h2>
        <section>
            <ul class="action-list">
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 avatar card wrap-down">
                            {# Theres no need for the all the twig access checks like the list page, if the user got to this screen they can view everything #}
                            <a href="/search/user/{{ record.owner.getId() }}">
                                <img src="/portrait.php?userId={{ record.getOwner().getExternalId() }}&amp;size=square64" width="64">
                            </a>
                            <h3>{{ record.getHeading() }}</h3>
                            <p class="spaced meta">
                                Posted by <a href="/search/user/{{ record.owner.getId() }}">{{ record.owner.firstName }} {{ record.owner.lastName }}</a> {{  record.getPostDate().getShort() }}
                            </p>
                            {% if record.tags | length > 0 %}
                                <p class="spaced">
                                    {% for tag in record.tags %}
                                        <span class="neutral label">{{ tag.name }}</span>
                                    {% endfor %}
                                </p>
                            {% endif %}
                            <article>
                                <p class="spaced">
                                    {{ record.getBodyText() }}
                                </p>
                                {% if record.attachments.count() > 0 %}
                                    <p class="spaced meta">
                                        {% for attachment in record.attachments %}
                                            Attached: <a target="_blank" href="/storage/fetch.php?hash={{ attachment.getHash() }}">{{  attachment.getFilename() }}</a><br>
                                        {% endfor %}
                                    </p>
                                {% endif %}
                            </article>

                            {% if role != 'parent' %}
                                <p class="spaced meta">
                                    {{ record.getTypeName() }}
                                    {% if session.user.getRole().isStaff() %}
                                        |
                                        {% if record.private %}Contents Private | {% endif %}
                                        {% if record.roles | length + record.users | length == 0 %}No Audience Set{% endif %}
                                        {% if record.roles | length > 0 %}
                                            {% for role in record.roles %}
                                                {{ role.getName() }}{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                        {% if record.users | length > 0 %}
                                            {% if record.roles | length > 0 %}|{% endif %}
                                            {% for user in record.users %}
                                                <a href="/search/user/{{ user.getId() }}">{{ user.firstname }} {{ user.lastname }} ({{ user.getRole.name }})</a>{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    {% endif %}
                                </p>
                            {% endif %}
                        </div>
                    </div>

                    {# Only display the edit/delete links to the owner of the record or pastoral moderators #}
                    {% if session.user.getRole().isStaff() and record.owner.getId() == session.user.getId() or session.user.getPastoralModerator %}
                    <nav>
                        <a class="icon-modify" href="/pastoral/update/{{ user.getId() }}/{{ record.getId() }}" title="Modify Comment"></a>
                        <a data-delete class="icon-delete" href="#" title="Delete Comment"></a>
                    </nav>
                    {% endif %}
                </li>
            </ul>
        </section>

        {# Parents cannot ever add/view comments #}
        {% if role != 'parent' %}

            <h2>Comments</h2>
            {% if comments | length > 0 %}
                <section>
                    <ul class="action-list">
                        {% for comment in comments %}
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <div class="small-12 avatar card wrap-down">
                                        <a href="/search/user/{{ comment.owner.getId() }}" title="View Profile">
                                            <img src="/portrait.php?userId={{ comment.owner.getExternalId() }}&size=square64" alt="" />
                                        </a>
                                        <p class="meta">Posted By <a href="/search/user/{{ comment.owner.getId() }}">{{ comment.owner.firstName }} {{ comment.owner.lastName }}</a> {{ comment.getPostDate().getShort() }}</p>
                                        <p class="spaced">
                                            {{ comment.body | raw }}
                                        </p>
                                    </div>
                                </div>

                                {# Only the author of the comment, author of the pastoral record, or moderators can delete comments #}
                                {%
                                    if  (session.user.getRole().isStaff() and record.owner.getId() == session.user.getId()) or
                                        (session.user.getRole().isStaff() and comment.owner.getId() == session.user.getId()) or
                                        session.user.getPastoralModerator
                                %}
                                    <nav>
                                        <a data-delete-comment="{{ comment.getId }}" class="icon-delete" href="#" title="Delete Comment"></a>
                                    </nav>
                                {% endif %}

                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
            <form method="post" action="/pastoral/comment">
                <input type="hidden" name="pastoral_id" value="{{ record.getId() }}">
                <input type="hidden" name="student_id" value="{{ record.getStudentId() }}">
                <section>
                    <textarea rows="3" cols="50" name="body" placeholder="Add Comment"></textarea>
                </section>
                <input type="submit" class="expand" value="Post">
            </form>

        {% endif %}

        {# Show attached files #}
        {% if attachments.count() > 0 %}

            <h2>Attached Files</h2>

            <section>
                <ul class="action-list">
                    {% for attachment in attachments %}
                        <li class="small avatar card small-12">
                            <img class="mime" src="/images/mime/60x60/{{ attachment.getIcon() }}">
                            <a href="/storage/fetch.php?hash={{ attachment.getHash() }}">{{  attachment.getFilename() }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </section>

        {% endif %}
    </div>
</div>