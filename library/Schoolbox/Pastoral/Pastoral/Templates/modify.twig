<!-- BEGIN custom_head -->
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
<script type="text/javascript" src="/javascript/shared/select-all/attacher.select-all.js"></script>

<script type="text/javascript">
    $(function () {

        var form = $('form#pastoralForm');

        $.fn.alaressEditor();

        $('#tags').selectizeSelector({
            ajax: {
                url:      '/ajax/tags.php',
                type:     'GET',
                dataType: 'json'
            },
            multiple: true,
            selectize: {
                create: function (input) {
                    return {
                        id: input,
                        name: input
                    }
                },
            },
            value: [{% for tag in record.tagsList %}'{{ tag.getName | escape('js') }}',{% endfor %}]
        });

        $('[data-cancel]').click(function(event) {
            event.preventDefault();
            window.location.href = '/pastoral/{{ record.getStudent.getId }}{{ student.getId }}';
        });

        {% if record.getId != '' %}

            var deleteIds = [];

            $('[data-delete]').click(function(event) {
                event.preventDefault();

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this record?',
                    confirmEvent: function() {
                        $.post('/pastoral/delete', {
                            id: {{ record.getId() }}
                        })
                        .done(function() {
                            window.location.href = '/pastoral/{{ record.getStudent.getId() }}';
                        });
                    }
                });
            });

            $('[data-delete-permission]').click(function(event) {
                event.preventDefault();

                $(this).confirmDialog({
                    text: 'Are you sure you want to remove this users permission from the record?',
                    confirmEvent: function() {

                        var selector = $("#deleteIds")
                        var deleteIds = selector.val();
                        if (deleteIds != '') {
                            deleteIds += ',';
                        }
                        selector.val(deleteIds + $(event.target).attr('data-delete-permission'))
                        $(event.target).closest('li').remove();
                    }
                });
            });

        {% endif %}

        $('#addUser').selectizeSelector({
            multiple: true,
            ajax: {
                url:      '/ajax/user.php',
                type:     'GET',
                data:     {roleTypeID: 'staff;'},
                dataType: 'json'
            }
        });

        $('#addStudent').selectizeSelector({
            multiple: true,
            ajax: {
                url:      '/ajax/user.php',
                type:     'GET',
                data:     {roleTypeID: 'student'},
                dataType: 'json'
            }
        });

        $('#private').change(function(event) {
            $('[data-role-parent]').prop('checked', false);

            $('[data-role-parent]').prop('disabled', $('#private').prop('checked'));
        });

        $('[data-role-parent]').prop('disabled', $('#private').prop('checked'));

        $('[data-submit]').click(function(event)
        {
            form.alaressValidate({
                ignore: ':disabled',
                rules: {
                    'heading': { required: true},
                    'body': { required: true}
                },

                messages: {
                    'heading': { required: 'You must enter a title enter a heading before you can proceed.' },
                    'body': { required: 'You must enter a description of the pastoral event before you can proceed.' }
                }
            });
        });
    });
</script>
<!-- END custom_head -->

<ul class="breadcrumb">
    <li>
        <a href="/search/user/{{ student.getId }}">
            {{ record.getStudent.getFirstname }} {{ record.getStudent.getLastname }}
            {{ student.getFirstname }} {{ student.getLastname }}
        </a>
    </li>
    <li><a href="/pastoral/{{ student.getId }}{{ record.getStudent.getId }}">Pastoral Care</a></li>
    <li class="active"><a href="#">{% if record.getId == '' %}Add Record{% else %}Modify Record{% endif %}</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>
                {{ record.getStudent.getFirstname }} {{ record.getStudent.getLastname }}
                {{ student.getFirstname }} {{ student.getLastname }}
            </h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <form class="top" id="pastoralForm" method="post" enctype="multipart/form-data" action="/pastoral/save">
            <input type="hidden" name="id" value="{{ record.getId }}">
            <input type="hidden" id="deleteIds" name="deleteIds" value="">
            <input type="hidden" name="student_id" value="{{ student.getId }}{{ record.getStudent.getId }}">

            <div class="actions-small-1 row">
                <div class="list-item">
                    <div class="small-12 columns">
                        <h2 class="subheader">
                            {% if record.getId == '' %}
                                Add Record
                            {% else %}
                                Modify Record
                            {% endif %}
                        </h2>
                    </div>
                </div>
                {% if record.getId != '' %}
                    {% if owner or pastoralModerator >= 1 %}
                        <nav>
                            <a class="icon-more" title="" data-dropdown="header-options"></a>
                        </nav>
                        <ul id="header-options" class="f-dropdown" data-dropdown-content>
                            <li><a href="#" data-delete class="icon-delete">Delete Pastoral Record</a></li>
                        </ul>
                    {% endif %}
                {% endif %}
            </div>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Title
                            <input type="text" class="required" name="heading" size="35" maxlength="100" value="{{ record.heading }}"/>
                        </label>
                    </div>
                    <div class="small-12 medium-6 columns">
                    <label>
                            Type
                            <select class="required" name="typeId">
                                {% for type in types %}
                                    <option {% if type.id == record.getType.getId %}selected{% endif %} value="{{ type.id }}">{{ type.name }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>
                            Severity
                            <select class="required" name="severityId">
                                {% for severity in severities %}
                                    <option {% if severity.id == record.getSeverity.getId %}selected{% endif %} value="{{ severity.id }}">{{ severity.name }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>
                            Tags
                            <span class="hint has-tip tip-top" data-tooltip title="Multiple tags can be added to aid filtering and reporting. Try to reuse existing tags by searching first. If necessary you may create new tags.">?</span>
                            <input id="tags" name="tags" value="{% for tag in record.tagsList %}{{ tag.getName }},{% endfor %}">
                        </label>

                        <label>
                            Description
                            <textarea id="body" name="body">{{ record.body }}</textarea>
                        </label>
                    </div>
                </fieldset>
            </section>

            <h2 class="subheader">Audience</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Roles
                            <span class="hint has-tip tip-top" data-tooltip title="Select the roles you would like to access this record and its contents. Roles not selected will not be able to see the record.">?</span>
                            {% for role in roles if role.getType != 'student' and role.getType != 'guest' %}

                                {# Default for new items: staff roles are selected, others are not #}

                                <input type="hidden" name="role[{{ role.getId }}]" value="0" />
                                <input {% if role.getType == 'parent' %}data-role-parent{% endif %} type="checkbox" name="role[{{ role.getId }}]" id="role[{{ role.getId }}]" value="1"
                                    {% if record.getId != '' %}
                                        {% for access in record.getAccessList if access.getRole.getId != '' %}
                                            {% if access.getRole.getId == role.getId %}
                                                checked
                                            {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        {% if role.getType == 'staff' %}
                                            checked
                                        {% endif %}
                                    {% endif %}
                                />
                                <label for="role[{{ role.getId }}]" class="checkbox-label">{{ role.getName }} {% if role.getType == 'parent' %}of student{% endif %}</label>

                            {% endfor %}
                        </label>

                        <legend>
                            <label for="private">
                                Hide Content From Selected Roles
                                <span class="hint has-tip tip-top" data-tooltip title="If selected, only yourself and individually selected users will be able to view the detail of this record. If enabled parents can not be audienced.">?</span>
                            </label>
                        </legend>

                        <div class="switch">
                            <input id="private" name="private" {% if record.getPrivate %}checked{% endif %} value="1" type="checkbox">
                            <label for="private">
                                <span>Yes</span>
                                <span>No</span>
                            </label>
                        </div>


                    </div>
                </fieldset>
            </section>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Individual User Access
                            <span class="hint has-tip tip-top" data-tooltip title="Add individual users who you would like to access this record and its contents. These users will be able to see content marked as hidden.">?</span>
                            <select id="addUser" name="user_id[]" multiple placeholder="Individual Users"></select>
                        </label>
                    </div>
                </fieldset>
            </section>

            <section>
                {% if record.getAccessList.count > 0 %}
                    <ul class="grid information-list">
                        {% for access in record.getAccessList if access.getUser.getId != '' %}
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <div class="avatar card small-12">
                                        <a href="/search/user/{{ person.id }}" title="View Profile">
                                            <img src="/portrait.php?userId={{ access.getUser.getExternalId }}&size=square64" alt="View Profile" />
                                            <p>{{ access.getUser.getFirstname }} {{ access.getUser.getLastname }}</p>
                                        </a>
                                        <p class="meta">{{ access.getUser.getRole.getName }}</p>
                                    </div>
                                </div>
                                <nav>
                                    <a data-delete-permission="{{ access.getUser.getId }}" class="icon-close no-text" href="#" title="Remove User Permission"></a>
                                </nav>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            {# Can only involve students when creating a new record #}

            {% if record.getId == '' %}
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>
                                Other Students Involved
                                <span class="hint has-tip tip-top" data-tooltip title="This will create a duplicate report and add it to the pastoral care area for these students.">?</span>
                                <select id="addStudent" name="duplicate_id[]" multiple placeholder="Add Students"></select>
                            </label>
                        </div>
                    </fieldset>
                </section>
            {% endif %}

            <h2 class="subheader">Attach Files</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <section>
                            {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                        </section>
                    </div>
                </fieldset>
            </section>

            <div class="row">
                <div class="small-12 column">
                    <ul class="flex-list buttons">
                        <li><input type="submit" data-submit class="submit" value="Save"></li>
                        <li><a href="#" data-cancel class="button icon-cancel">Cancel Changes</a></li>
                    </ul>
                </div>
            </div>
        </form>
    </div>
</div>
