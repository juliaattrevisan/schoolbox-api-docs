<!-- BEGIN custom_head -->
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
<script type="text/javascript" src="/javascript/shared/select-all/attacher.select-all.js"></script>

<script type="text/javascript">
    $(function () {

        var form = $('form#pastoralForm')

        $.fn.alaressEditor();

        $('#tags').selectize({
            delimiter: ',',
            persist: false,
            create: function(input) {
                return {
                    name: input
                }
            },
            searchField: 'name',
            labelField: 'name',
            valueField: 'name',
            options: [
                {% for tag in tagsAll %}
                {name: '{{ tag.name | escape('js') }}'},
                {% endfor %}
            ]
        });

        $('[data-cancel]').click(function(event) {
            event.preventDefault();
            window.location.href = '/pastoral/{{ user.id }}';
        });

        {% if id != '' %}

            var deleteIds = [];

            $('[data-delete]').click(function(event) {
                event.preventDefault();

                var element = $(this);

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this record?',
                    confirmEvent: function() {
                        $.post('/pastoral/delete', {
                            id: {{ record.getId() }}
                        })
                        .done(function() {
                            window.location.href = '/pastoral/{{ record.getStudentId() }}';
                        });
                    }
                });
            });

            $('[data-delete-permission]').click(function(event) {
                event.preventDefault();

                var element = $(this);

                $(this).confirmDialog({
                    text: 'Are you sure you want to remove this users permission from the record?',
                    confirmEvent: function() {

                        var deleteIds = $("#deleteIds").val();
                        if (deleteIds != '') {
                            deleteIds += ',';
                        }
                        $("#deleteIds").val(deleteIds + $(event.target).attr('data-delete-permission'))
                        $(event.target).closest('li').remove();
                    }
                });
            });

        {% endif %}

        var selector = $('#addUser').selectizeSelector({
            multiple: true,
            ajax: {
                url:      '/ajax/user.php',
                type:     'GET',
                data:     {groupID: 0},
                dataType: 'json'
            }
        });

        var selector2 = $('#addStudent').selectizeSelector({
            multiple: true,
            ajax: {
                url:      '/ajax/user.php',
                type:     'GET',
                data:     {roleTypeID: 'student'},
                dataType: 'json'
            }
        });



        $('[data-submit]').click(function(event)
        {
            form.alaressValidate({
                ignore: ':disabled',
                rules: {
                    'heading': {
                        required:       true,
                    },
                    'body': {
                        required:       true,
                    }
                },

                messages: {
                    'heading': {
                        required:       'You must enter a title before you can proceed.'
                    },
                    'body': {
                        required:       'You must enter a description of the pastoral event before you can proceed.'
                    }
                }
            });
        });
    });
</script>
<!-- END custom_head -->

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ user.formatName() }}</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <form class="top" id="pastoralForm" method="post" enctype="multipart/form-data" action="/pastoral/save">
            <input type="hidden" name="id" value="{{ id }}">
            <input type="hidden" id="deleteIds" name="deleteIds" value="">
            <input type="hidden" name="student_id" value="{{ student_id }}">
            <h2>Pastoral Record Details</h2>
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Title
                            <input type="text" class="required" name="heading" size="35" maxlength="100" value="{{ record.heading }}"/>
                        </label>

                        <label>
                            Pastoral Event Type
                            <select class="required" name="typeId">
                                {% for type in types %}
                                    <option {% if type.id == record.typeId %}selected{% endif %} value="{{ type.id }}">{{ type.name }}</option>
                                {% endfor %}
                            </select>
                        </label>

                        <label>
                            Severity
                            <select class="required" name="severityId">
                                {% for severity in severities %}
                                    <option {% if severity.id == record.severityId %}selected{% endif %} value="{{ severity.id }}">{{ severity.name }}</option>
                                {% endfor %}
                            </select>
                        </label>

                        <label>
                            Tags
                            <input id="tags" name="tags" value="{{ tags }}">
                        </label>

                        <label>
                            Description
                            <textarea id="body" name="body">{{ record.body }}</textarea>
                        </label>
                    </div>
                </fieldset>
            </section>

            <h2>Permissions</h2>

            {% if userPermissions | length > 0 %}
                <section>
                    <ul class="grid information-list">
                        {% for person in userPermissions %}
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="avatar card small-12">
                                    <a href="/search/user/{{ person.id }}" title="View Profile">
                                        <img src="/portrait.php?userId={{ person.externalId }}&size=square64" alt="View Profile" />
                                        <p>{{ person.firstname }} {{ person.lastname }}</p>
                                    </a>
                                    <p class="meta">{{ person.getRole.name }}</p>
                                </div>
                            </div>
                            <nav>
                                <a data-delete-permission="{{ person.id }}" class="icon-close no-text" href="#" title="Delete"></a>
                            </nav>
                        </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Add Authorised User
                            <span class="hint has-tip tip-top" data-tooltip title="These selected users will have access to view this record and its contents.">?</span>
                            <select id="addUser" name="user_id[]" multiple placeholder="Add Authorised User"></select>
                        </label>
                    </div>
                </fieldset>
            </section>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Allow All Users With Role
                            <span class="hint has-tip tip-top" data-tooltip title="Users in the selected roles will be able to see this pastoral care record. Users that are no in one of these roles will see no indication the record exists.">?</span>
                            {% for role in roles if role.type != 'student' and role.type != 'guest' %}
                                {# Default for new items: staff roles are selected, others are not #}
                                <input type="hidden" name="role[{{ role.id }}]" value="0" />
                                <input type="checkbox" name="role[{{ role.id }}]" id="role[{{ role.id }}]" value="1"
                                    {% if id %}
                                        {% for roleCurrent in rolesSelected %}
                                            {% if roleCurrent.getRoleId() == role.id %}
                                                checked
                                            {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        {% if role.type == 'staff' %}checked{% endif %}
                                    {% endif %}
                                />
                                <label for="role[{{ role.id }}]" class="checkbox-label">{{ role.name }}</label>
                            {% endfor %}
                        </label>

                        <fieldset class="checklist">
                            <legend>
                                <label>
                                    Private Body
                                    <span class="hint has-tip tip-top" data-width="200" title="If ticked only you will be able to view the content of this pastoral record. Other users with access to the record will receive a message advising they will need to contact you for further information. Parents will never see private records.">?</span>
                                </label>
                            </legend>
                            <input id="visibilityPrivate" name="private" type="checkbox" {% if record.getPrivate() %}checked{% endif %} value="1"><label for="visibilityPrivate">The body of the record and attachments should only be visible by myself (When selected the title and event type will still be visible to the audiences listed above.)</label>
                        </fieldset>

                    </div>
                </fieldset>
            </section>

            <h2>Attach Files</h2>

            <section>
            {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
            </section>

            <h2>Notifications</h2>
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <fieldset class="checklist">
                            <legend>
                                <label>
                                    Send Notifications To Audience
                                </label>
                            </legend>
                            <input id="notify" name="notify" type="checkbox" value="1"><label for="notify">If ticked a notification will be sent to all audience members this record has been {% if id == '' %}created{% else %}updated{% endif %}.</label>
                        </fieldset>
                    </div>
                </fieldset>
            </section>

            {% if id == '' %}

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Create Duplicate Record On Other Students
                            <span class="hint has-tip tip-top" data-tooltip title="Duplicate copies of this pastoral record will be added to these students.">?</span>
                            <select id="addStudent" name="duplicate_id[]" multiple placeholder="Add Students"></select>
                        </label>
                    </div>
                </fieldset>
            </section>

            {% endif %}

            <div class="row">
                {% if id == '' %}
                    <div class="small-12 medium-6 column">
                        <input data-submit type="submit" value="Insert Pastoral Comment"/>
                    </div>
                    <div class="small-12 medium-6 column">
                        <input data-cancel type="submit" value="Cancel Changes"/>
                    </div>
                {% else %}
                    <div class="small-12 medium-4 column">
                        <input data-submit type="submit" value="Save Changes"/>
                    </div>
                    <div class="small-12 medium-4 column">
                        <input data-delete type="submit" value="Delete"/>
                    </div>
                    <div class="small-12 medium-4 column">
                        <input data-cancel type="submit" value="Cancel Changes"/>
                    </div>
                {% endif %}
            </div>
        </form>
    </div>
</div>
