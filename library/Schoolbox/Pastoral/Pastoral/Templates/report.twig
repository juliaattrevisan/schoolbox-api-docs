<script>
    $(function () {
        $('[data-print').click(function(event) {
           window.print();
        });
    });
</script>
<ul class="breadcrumb hide-on-print">
    <li><a href="/pastoral">Pastoral Care Report Builder</a></li>
    <li class="active"><a href="#">Report Results</a></li>
</ul>

<div class="row">
    <div class="small-12 island">
        <h1 class="hide-on-print">
            Pastoral Care Report
            <a data-print class="button right icon-print"></a>
        </h1>
        <section>
            {% if results | length > 0 %}
                <ul class="information-list">
                    {% for record in results %}
                        <li>
                            <div class="list-item">
                                <div class="avatar card small-12 wrap-down">
                                    <img src="/portrait.php?userId={{ record.getOwner().getExternalId() }}&amp;size=square64" width="64">
                                    <h2>{{ record.student.firstname }} {{ record.student.lastname }}</h2>
                                    <h3>{{  record.getHeading() }}</h3>
                                    <p class="spaced meta hide-on-print">
                                        Posted by {{ record.owner.firstName }} {{ record.owner.lastName }} {{  record.getPostDate().getShort() }}
                                    </p>
                                    <p class="spaced meta show-for-print">
                                        <br>Posted by {{ record.owner.firstName }} {{ record.owner.lastName }}<br>
                                        {{  record.getPostDate().getShort() }}
                                    </p>
                                    <p class="meta">
                                        Severity: {{ record.getSeverityName() }}
                                    </p>
                                    <p class="meta">
                                        Incident Type:
                                        {{ record.getTypeName() }}
                                    </p>
                                    {% if record.private %}
                                        <p class="meta">
                                            Contents Private
                                        </p>
                                    {% endif %}
                                    {% if record.attachments.count() > 0 %}
                                        <p class="meta">
                                            {% for attachment in record.attachments %}
                                                Attached: {{  attachment.getFilename() }}<br>
                                            {% endfor %}
                                        </p>
                                    {% endif %}
                                    <p class="spaced meta">
                                        Audience:
                                        {% if record.roles | length + record.users | length == 0 %}No Audience Set{% endif %}
                                        {% if record.roles | length > 0 %}
                                            {% for role in record.roles %}
                                                {{ role.getName() }}{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                        {% if record.users | length > 0 %}
                                            {% if record.roles | length > 0 %}|{% endif %}
                                            {% for user in record.users %}
                                                {{ user.firstname }} {{ user.lastname }}{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </p>

                                    {% if record.tags | length > 0 %}
                                        <p class="meta spaced show-for-print">
                                            Tags:
                                            {% for tag in record.tags %}
                                                {{ tag.name | title }}
                                                {% if not loop.last %} | {% endif %}
                                            {% endfor %}
                                        </p>
                                    {% endif %}
                                    <article class="hide-on-print">
                                        <p class="spaced">
                                            {{ record.getBodyText() }}
                                        </p>
                                    </article>
                                    <p class="spaced show-for-print">
                                        <br>
                                        {{ record.getBodyText() }}
                                        <br>
                                        {% if record.tags | length > 0 %}
                                            <p class="meta spaced show-for-print">
                                                Tags:
                                                {% for tag in record.tags %}
                                                    {{ tag.name | title }}
                                                    {% if not loop.last %} | {% endif %}
                                                {% endfor %}
                                            </p>
                                        {% endif %}
                                        <br>
                                    </p>
                                </div>
                            </div>
                        </li>
                        {% for comment in record.comments %}
                            <li>
                                <div class="list-item">
                                    <div class="small-12 avatar card wrap-down">
                                        <p class="meta hide-on-print">Comment By {{ comment.owner.firstName }} {{ comment.owner.lastName }} {{ comment.getPostDate().getShort() }}</p>
                                        <p class="show-for-print">Comment By {{ comment.owner.firstName }} {{ comment.owner.lastName }}<br>{{ comment.getPostDate().getShort() }}</p>
                                        <p class="spaced">
                                            {{ comment.body | raw }}
                                        </p>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            {% else %}

                <div class="content">
                    <p>No pastoral records matched your search criteria, please review your criteria and try again.</p>
                    <p class="no-margin"><a href="/pastoral">Click here to run another report</a></p>
                </div>

            {% endif %}
        </section>
    </div>
</div>