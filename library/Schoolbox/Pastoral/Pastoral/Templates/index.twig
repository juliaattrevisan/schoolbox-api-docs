<script type="text/javascript">

    $(function () {

        // Filter pastoral records on type

        $('#filter_type_id').change(function(event) {
            $('.record').each(function(index, record) {
                if ($('#filter_type_id').val() === '') {
                    $(record).show();
                } else {
                    if ($(record).attr('record-type') != $('#filter_type_id').val()) {
                        $(record).hide();
                    } else {
                        $(record).show();
                    }
                }
            });
        });

        // If there are no pastoral records hide filter box, and show warning that there are no records.

        if ($('[data-pastoral]').length == 0) {
            $('[data-no-records]').removeClass('hide');
            $('[data-type-selector]').addClass('hide');
        } else {
            $('[data-no-records]').addClass('hide');
            $('[data-type-selector]').removeClass('hide');
        }

        // Delete pastoral record

        $('[data-delete]').click(function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this record?',
                confirmEvent: function() {
                    $.post('/pastoral/delete', {
                        id: event.target.id
                    })
                    .done(function() {

                        // Remove from list after AJAX returns

                        $('#pastoral-' + event.target.id).remove();
                        if ($('[data-pastoral]').length == 0) {
                            $('[data-no-records]').removeClass('hide');
                            $('[data-type-selector]').addClass('hide');
                        } else {
                            $('[data-no-records]').addClass('hide');
                            $('[data-type-selector]').removeClass('hide');
                        }
                    });
                }
            });
        });
    });

</script>

<ul class="breadcrumb">
    <li><a href="/search/user/{{ student.getId }}">{{ student.formatName() }}</a></li>
    <li class="active"><a href="/pastoral/{{ student.getId }}">Pastoral Care</a></li>
</ul>

{# Hide contact/student information and add/filter controls from parents #}
{% if role != 'parent' %}

    <div class="actions-small-1 row">
        <div class="list-item">
            <div class="small-12 column">
                <h2>Student Details</h2>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="small-12 island">
            <section class="no-pad">
                <div class="content no-pad">
                    <div class="row no-margin">
                        <div class="small-12 medium-4 large-2 columns no-pad">
                            <img src="/portrait.php?userId={{ student.getExternalId() }}" class="full-width"/>
                        </div>
                        <div class="small-12 medium-8 large-10 columns">
                            <dl class="profile">
                                <dt class="no-margin small-6 medium-4">Student Name</dt>
                                <dd class="no-margin small-6 medium-8">{{ student.formatName() }}</dd>

                                <dt class="no-margin small-6 medium-4">Student Age</dt>
                                <dd class="no-margin small-6 medium-8">{{ studentAge }} Years Old</dd>

                                <dt class="no-margin small-6 medium-4 {% if student.StudentYearLevel == '' and student.FormDescription == '' %}hide{% endif %}">Student Year Level</dt>
                                <dd class="no-margin small-6 medium-8">{{ student.StudentYearLevel }} {{ student.FormDescription }}</dd>

                                {% for contact in studentContacts if not session.user.hideContacts %}
                                    <dt class="no-margin small-6 medium-4">{{ contact.StudentContactRelation }}</dt>
                                    <dd class="no-margin small-6 medium-8">
                                        {{ contact.main.getFullName() }}
                                        {% if contact.StudentContactMobilePhone %}
                                            ({{ contact.StudentContactMobilePhone }})
                                        {% endif %}
                                    </dd>
                                    {% if contact.spouse %}
                                        <dt class="no-margin small-6 medium-4">{{ contact.StudentContactSpouseRelation }}</dt>
                                        <dd class="no-margin small-6 medium-8">
                                            {{ contact.spouse.getFullName() }}
                                            {% if contact.StudentContactSpouseMobilePhone %}
                                                ({{ contact.StudentContactSpouseMobilePhone }})
                                            {% endif %}
                                        </dd>
                                    {% endif %}
                                {% endfor %}

                            </dl>
                        </div>
                    </div>
                </div>
            </section>
            <a class="button expand spaced" href="/pastoral/insert/{{ student.getId() }}">Add Pastoral Record</a>
            <a class="button expand spaced" href="/pastoral/report-builder">Pastoral Report Builder</a>
            <hr>
        </div>
    </div>

    <div data-type-selector class="row{% if records.count() == 0 %} hide{% endif %}">
        <div class="small-12">
            <section>
                <select id="filter_type_id">
                    <option value="">Show All Record Types</option>
                    {% for type in types %}
                        <option value="{{ type.id }}">{{ type.name }}</option>
                    {% endfor %}
                </select>
            </section>
        </div>
    </div>

{% endif %}

<div data-no-records class="row{% if records.count() != 0 %} hide{% endif %}">
    <div class="small-12 column{% if role != 'parent' %} hide{% endif %}">
        <h1>Pastoral Care</h1>
    </div>
    <div class="small-12 column">
        <div class="alert-box">No pastoral care records have been entered regarding {{ student.formatName }}.{% if role != 'parent' %} To add a record click on the 'Add Pastoral Comment' button above.{% endif %}</div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            <ul class="information-list">
                {% for record in records %}

                    {# Only display records the logged in user is allowed to see. Parents cannot see private records ever (even if they have been given access). #}
                    {% if not (record.private and role == 'parent') %}

                        <li record-type="{{ record.getTypeId }}" data-pastoral class="record actions-small-1" id="pastoral-{{ record.getId() }}">
                            <div class="list-item">
                                <div class="avatar card small-12 wrap-down">

                                    {# If the record is private and the person is not the owner, don't put links to view the content #}
                                    {% if not pastoralModerator and record.private and record.owner.getId() != session.user.getId() %}

                                        {# Portrait image of author #}
                                        <a href="/search/user/{{ record.owner.getId() }}">
                                            <img src="/portrait.php?userId={{ record.getOwner().getExternalId() }}&amp;size=square64" width="64">
                                        </a>
                                        {# Heading of pastoral comment#}
                                        <h3>
                                            {{  record.getHeading() }}

                                            {# Show how many comments have been made on the record #}
                                            {% if record.getCommentList.count > 0 %}
                                                ({{ record.getCommentList.count }} Comment{% if record.comments | length > 1 %}s{% endif %})
                                            {% endif %}
                                        </h3>

                                    {# Otherwise, display links to view the content #}
                                    {% else %}

                                        {# Portrait image of author #}
                                        <a href="/search/user/{{ record.owner.getId() }}">
                                            <img src="/portrait.php?userId={{ record.getOwner().getExternalId() }}&amp;size=square64" width="64">
                                        </a>

                                        {# Heading of pastoral comment#}
                                        <a href="/pastoral/{{ student.id }}/{{ record.getId() }}">
                                            <h3>
                                                {{  record.getHeading() }}

                                                {# Show how many comments have been made on the record #}
                                                {% if record.getCommentList.count > 0 %}
                                                    ({{ record.getCommentList.count }} Comment{% if record.getCommentList.count > 1 %}s{% endif %})
                                                {% endif %}
                                            </h3>

                                        </a>

                                    {% endif %}

                                    {# Display name of poster #}
                                    <p class="spaced meta">
                                        Posted by <a href="/search/user/{{ record.owner.getId() }}">{{ record.owner.firstName }} {{ record.owner.lastName }}</a> {{  record.getPostDate().getShort() }}
                                    </p>

                                    {# Display tags #}
                                    {% if record.tagsList | length > 0 %}
                                        <p class="spaced">
                                            {% for tag in record.tagsList %}
                                                <span class="neutral label">{{ tag.name }}</span>
                                            {% endfor %}
                                        </p>
                                    {% endif %}

                                    <article>
                                        {% if not pastoralModerator and record.private and (record.owner.getId() != session.user.getId()) %}
                                            {# The article is marked as private, only the author or pastoral moderators can see the content #}
                                            <p class="spaced">
                                                The contents of this pastoral event have been marked as private. Please contact {{ record.owner.firstName }} {{ record.owner.lastName }} if you require more information.
                                            </p>
                                        {% else %}
                                            {# Content of article #}
                                            <p class="spaced">
                                                {{ record.getBodyText() | cutSentence(375, true) }}
                                            </p>
                                            {% if record.getAttachmentList.count() > 0 %}
                                                <p class="spaced meta">
                                                    {% for attachment in record.getAttachmentList %}
                                                        Attached: <a target="_blank" href="/storage/fetch.php?hash={{ attachment.getHash() }}">{{ attachment.getFilename() }}</a><br>
                                                    {% endfor %}
                                                </p>
                                            {% endif %}
                                        {% endif %}
                                    </article>

                                    {# Hide meta from parents#}
                                    {% if role != 'parent' %}
                                        <p class="spaced meta">
                                            {# Pastoral event type #}
                                            {{ record.getType.getName }} |

                                            {# Pastoral event severity #}
                                            {{ record.getSeverity.getName }} |

                                            {# Indicate if record is private #}
                                            {% if record.private %}Contents Private | {% endif %}

                                            {# Indicate if not audience has been set #}
                                            {% if record.getAccessList.count == 0 %}No Audience Set{% endif %}

                                            {# Show audienced roles  #}
                                            {% if record.getAccessList.count > 0 %}
                                                {% for access in record.getAccessList %}
                                                    {% if access.getRole.getId != '' %}
                                                        {{ access.getRole.getName }}{% if not loop.last %},{% endif %}
                                                    {% elseif access.getUser.getId != '' %}
                                                        <a href="/search/user/{{ access.getUser.getId }}">{{ access.getUser.getFirstname }} {{ access.getUser.getLastname }}</a>{% if not loop.last %},{% endif %}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}

                                        </p>
                                    {% endif %}

                                </div>
                            </div>

                            {# Show edit links to the owner and pastoral moderators #}
                            {% if session.user.getRole().isStaff() and record.owner.getId() == session.user.getId() or pastoralModerator %}
                                <nav>
                                    <a class="icon-modify no-text" href="/pastoral/update/{{ record.getId() }}" title="Modify"></a>
                                    <a data-delete id="{{ record.id }}" class="icon-delete no-text" href="#" title="Delete"></a>
                                </nav>
                            {% endif %}
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </section>
    </div>
</div>