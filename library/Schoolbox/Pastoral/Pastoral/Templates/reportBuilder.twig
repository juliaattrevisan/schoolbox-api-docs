<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
<script type="text/javascript" src="/javascript/shared/select-all/attacher.select-all.js"></script>

<script type="text/javascript">

    $(function () {

        $('#tags_filter').selectize({
            delimiter: ',',
            persist: false,
            searchField: 'name',
            labelField: 'name',
            valueField: 'name',
            options: [
                {% for tag in tagsAll %}
                {name: '{{ tag.name | title | escape('js') }}'},
                {% endfor %}
            ]
        });

        var selectorStudents = $('#filterStudents').selectizeSelector({
            multiple: true,
            ajax: {
                url:      '/ajax/user.php',
                type:     'GET',
                data:     {roleTypeID: 'student'},
                dataType: 'json'
            }
        });
        var selectorAuthors = $('#filterAuthors').selectizeSelector({
            multiple: true,
            ajax: {
                url:      '/ajax/user.php',
                type:     'GET',
                data:     {roleTypeID: 'staff'},
                dataType: 'json'
            }
        });
        $('#datetime_before, #datetime_after').datepicker();

        $('[data-report]').click(function(event) {

            event.preventDefault();

            var error = false;

            $('#datetime_after_error').hide();

            if ($('#datetime_after').val() != '' && $('#datetime_before').val() != '') {

                var datetime_after = $.datepicker.parseDate('dd/mm/yy', $('#datetime_after').val());
                var datetime_before = $.datepicker.parseDate('dd/mm/yy', $('#datetime_before').val());

                if (datetime_before < datetime_after) {
                    $('#datetime_after_error').show();
                    error = true;
                }
            }

            if (!error)
            {
                // Create report page GET variables

                $('#tags').val($('#tags_filter').val());
                $('#after').val($('#datetime_after').val());
                $('#before').val($('#datetime_before').val());
                $('#severity').val($('#filterSeverity').val());

                // Selected students

                var students = '';

                if ($('#filterStudents').val() != null) {
                    var students_array = $('#filterStudents').val();

                    for (i = 0; i < students_array.length; i++) {
                        if (students != '') {
                            students += ",";
                        }
                        students += students_array[i];
                    }
                }

                $('#students').val(students);

                // Selected authors

                var authors = '';

                if ($('#filterAuthors').val() != null) {
                    var authors_array = $('#filterAuthors').val();

                    for (i=0; i<authors_array.length; i++) {
                        if (authors != '') {
                            authors += ",";
                        }
                        authors += authors_array[i];
                    }
                }

                $('#authors').val(authors);

                // Selected types

                var types = '';
                var types_array = $('[name="types[]"]');

                for (i=0; i<types_array.length; i++) {
                    if (types_array[i].checked) {
                        if (types != '') {
                            types += ",";
                        }
                        types += types_array[i].value;
                    }
                }

                $('#types').val(types);

                $('#formReport').submit();
            }
        });
    });

</script>

<ul class="breadcrumb">
    <li class="active"><a href="/pastoral/dashboard">Pastoral Care</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Pastoral Care</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-9 island">
        <h2>Pastoral Report Builder</h2>

        <form id="formReport" action="/pastoral/report" method="get">
            <input type="hidden" id="students" name="students">
            <input type="hidden" id="authors" name="authors">
            <input type="hidden" id="severity" name="severity">
            <input type="hidden" id="types" name="types">
            <input type="hidden" id="tags" name="tags">
            <input type="hidden" id="before" name="before">
            <input type="hidden" id="after" name="after">
        </form>

        <section>
            <fieldset class="content">
                <div class="small-12 columns">
                    <label>
                        Filter By Student
                        <select id="filterStudents" name="students[]" multiple placeholder="Select Students"></select>
                    </label>
                    <label>
                        Filter By Author
                        <select id="filterAuthors" name="authors[]" multiple placeholder="Select Authors"></select>
                    </label>
                    <label>
                        Severity Level
                        <select id="filterSeverity" name="severity_id">
                            <option value="">Show All Severity Levels</option>
                            {% for severity in severities %}
                                <option value="{{ severity.id }}">{{ severity.name }}</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>
                <div class="small-12 columns">
                    <label id="datetime_after_error" for="datetime_after" class="error" style="display:none;">Invalid date range specified</label>
                </div>
                <div class="small-12 large-6 columns">
                    <label for="datetime_after">
                        Published On Or After
                        <input type="text" class="required" name="after" id="datetime_after" maxlength="50"/>
                    </label>
                </div>
                <div class="small-12 large-6 columns">
                    <label for="item_datetime_published">
                        Published On Or Before
                        <input type="text" class="required" name="before" id="datetime_before" maxlength="50"/>
                    </label>
                </div>
                <div class="small-12 columns">
                    <label for="item_datetime_published">
                        Filtered By Tags
                        <input type="text" class="required" name="tags_filter" id="tags_filter" maxlength="50"/>
                    </label>
                </div>
                <div class="small-12 columns">
                    <fieldset class="checklist" data-equalizer-watch="">
                        <label>
                            Include Record Types (Leave Blank To Show All)
                        </label>
                        {% for type in types %}
                            <input id="type-{{ type.id }}" name="types[]" value="{{ type.id }}" type="checkbox"><label for="type-{{ type.id }}">{{ type.name }}</label>
                        {% endfor %}
                    </fieldset>
                </div>
            </fieldset>
        </section>

        <button data-report class="expand">Create Report</button>

    </div>
    <div class="small-3 island">
        <h2>Pastoral Moderators</h2>
        <section>
            <ul class="grid small-block-grid-1 {GRID_VIEW_CLASSES}">
                {% for moderator in moderators %}
                    <li>
                        <div class="avatar card small-12">
                            <a href="/search/user/{{ moderator.getId }}" title="View Profile">
                                <img src="/portrait.php?userId={{ moderator.getExternalId }}&size=square64" alt="View Profile" />
                                <p>{{ moderator.firstname }} {{ moderator.lastname }}</p>
                            </a>
                            <p class="meta">{{ moderator.getRole.name }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>

</div>