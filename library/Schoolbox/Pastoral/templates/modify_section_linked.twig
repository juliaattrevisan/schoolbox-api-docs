{% import '@pastoral/macros/profile.twig' as profile %}

{% if not bulkCreate %}
<h2 class="subheader">Create Related Record</h2>
{% endif %}
<section>
    <fieldset class="content">
        <div class="small-12 columns">
            <label>
                Select Students
                <span class="hint has-tip tip-top" data-tooltip title="Duplicate {{ locale.pastoral }} records will be created for students listed below.">?</span>
                <input type="text" id="duplicateIds" name="duplicateIds" multiple placeholder="Enter Student Names"></input>
            </label>

            {% if record.relatedRecords | length %}
                <label>Related Records</label>
                <ul class="action-list">
                    {% for related in record.relatedRecords %}
                        {% if related.student.id != record.student.id %}
                            <li>
                                <div class="list-item">
                                    <div class="small-12 compact card">
                                        <a title="View Record" href="{{ routeLookup('pastoral.getStudentRecord', {'studentId': related.student.id, 'recordId': related.id}) }}">{{ profile.imageSquare64(related.student) }}
                                            <p>{{ related.student.fullName }}</p>
                                        </a>
                                    </div>
                                </div>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </fieldset>
</section>
