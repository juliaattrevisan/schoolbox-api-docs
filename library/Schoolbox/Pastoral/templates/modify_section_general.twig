<input type="hidden" name="id" value="{{ record.id }}"> <input type="hidden" name="student_id" value="{{ record.student ? record.student.id : 0 }}">
<section>
    <fieldset class="content">
        <div class="small-12 columns">
            <label class="required" for="heading">Title</label>
            <input type="text" name="heading" id="heading" size="35" maxlength="100" value="{{ record.heading }}" required />
        </div>
    </fieldset>
    <fieldset class="content">
        <div class="small-12 medium-6 columns">
            <label for="typeId">Type</label>
                <select name="typeId" id="typeId">
                    {# Is this record's type deleted? #}
                    {% if record.type.deleted ?? false %}
                        <option selected value="{{ record.type.id }}">{{ record.type.name }} (deleted)</option>
                    {% endif %}
                    {% for type in types %}
                        <option {% if type.id == record.type.id ?? '' %}selected{% endif %}
                                value="{{ type.id }}" data-visibility-locked="{{ type.visibilityLocked }}">{{ type.name }}</option>
                    {% endfor %}
                </select>
        </div>
        <div class="small-12 medium-6 columns">
            <label> Sub-Type <select name="subtypeId" id="subtypeId">
                    {# Is this record's subtype deleted? #}
                    {% if record.subtype.deleted ?? false %}
                        <option data-chained="{{ record.subtype.pastoralType.id }}"
                                class="{{ record.subtype.pastoralType.id }}"
                                selected
                                value="{{ record.subtype.id }}">{{ record.subtype.name }} (deleted)</option>
                    {% endif %}
                    {% for subtype in subTypes %}
                        <option data-chained="{{ subtype.pastoralType.id }}" class="{{ subtype.pastoralType.id }}"
                                {% if subtype.id == record.subtype.id ?? '' %}selected{% endif %} value="{{ subtype.id }}"
                                data-visibility-locked="{{ subtype.visibilityLocked }}">{{ subtype.name }}</option>
                    {% endfor %}
                </select> </label>
        </div>
        <div class="small-12 medium-6 columns">
            {% if severities | length %}
                <label for="severityId">{{ locale.severity.proper }}</label>
                <select name="severityId" id="severityId">
                    {% if record.severity.deleted ?? false %}
                        <option selected value="{{ record.severity.id }}">{{ record.severity.name }} (deleted)</option>
                    {% endif %}
                    {% for severity in severities %}
                        <option {% if severity.id == record.severity.id ?? '' %}selected{% endif %} value="{{ severity.id }}">{{ severity.name }}</option>
                    {% endfor %}
                </select>
            {% endif %}
        </div>
        <div class="small-12 medium-6 columns">
            <label> Points <input type="number" name="points" size="35" maxlength="100" value="{{ record.points }}"/> </label>
        </div>
        <div class="small-{% if severities | length %}12{% else %}6{% endif %} columns">
            <label> Tags
                <span class="hint has-tip tip-top" data-tooltip title="Multiple tags can be added to aid filtering and reporting. Try to reuse existing tags by searching first. If necessary you may create new tags.">?</span>
                <input id="tags" name="tags" value="{% for tag in record.tags %}{{ tag.name }},{% endfor %}"> </label>
        </div>
        <div class="small-12 columns">
            <label for="parent-comments-allowed">Allow parents to comment <span class="hint has-tip tip-top" data-tooltip title="Turn this ON to allow parent(s) of the student to comment on this record.">?</span></label>
            <div class="switch">
                <input id="parent-comments-allowed" type="checkbox"
                       name="parent comments allowed" value="1" {% if record.parentCommentsAllowed %}checked="checked"{% endif %}>
                <label for="parent-comments-allowed">
                    <span>On</span>
                    <span>Off</span>
                </label>
            </div>
        </div>
    </fieldset>
</section>
