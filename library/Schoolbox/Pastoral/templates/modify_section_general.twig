<input type="hidden" name="id" value="{{ record.id }}"> <input type="hidden" name="student_id" value="{{ record.student ? record.student.id : 0 }}">
<section>
    <fieldset class="content">
        <div class="small-12 columns">
            <label class="required" for="heading">Title</label>
            <input type="text" name="heading" id="heading" size="35" maxlength="100" value="{{ record.id ? record.heading : '' }}" required />
        </div>
    </fieldset>
    <fieldset class="content">
        <div class="small-12 medium-12 columns">
            <label for="occurredOn">
                Occurred On
            </label>
            <input type="text" name="occurredOn" id="occurredOn" data-datepicker maxlength="50" value="{{ record.occurredOn ? record.occurredOn.localShort : null }}" />
        </div>
        <div class="small-12 medium-6 columns">
            <label for="typeId" class="required">Type</label>
                <select name="typeId" id="typeId" required>
                    {# Is this record's type deleted? #}
                    {% if isModify and record.type.deleted ?? false %}
                        <option selected value="{{ record.type.id }}">{{ record.type.name }} (deleted)</option>
                    {% endif %}
                    {% if not isModify or record.type.id is not defined %}
                        <option disabled selected>Please select a type</option>
                    {% endif %}
                    {% for type in types %}
                        <option {% if isModify and type.id == record.type.id ?? '' %}selected{% endif %}
                                value="{{ type.id }}" {% if not moderator %}data-visibility-locked="{{ type.visibilityLocked }}"{% endif %}>{{ type.name }}</option>
                    {% endfor %}
                </select>
        </div>
        <div class="small-12 medium-6 columns">
            <label> Sub-Type <select name="subtypeId" id="subtypeId">
                    {# Is this record's subtype deleted? #}
                    {% if isModify and record.subtype.deleted ?? false %}
                        <option data-chained="{{ record.subtype.pastoralType.id }}"
                                class="{{ record.subtype.pastoralType.id }}"
                                selected
                                value="{{ record.subtype.id }}">{{ record.subtype.name }} (deleted)</option>
                    {% endif %}
                    {% for subtype in subTypes %}
                        <option data-chained="{{ subtype.pastoralType.id }}" class="{{ subtype.pastoralType.id }}"
                                {% if isModify and subtype.id == record.subtype.id ?? '' %}selected{% endif %} value="{{ subtype.id }}"
                                {% if not moderator %}data-visibility-locked="{{ subtype.visibilityLocked }}"{% endif %}>{{ subtype.name }}</option>
                    {% endfor %}
                </select> </label>
        </div>
        <div class="small-12 medium-6 columns">
            {% if severities | length %}
                <label for="severityId">{{ locale.severity.proper }}</label>
                <select name="severityId" id="severityId">
                    {% if isModify and record.severity.deleted ?? false %}
                        <option selected value="{{ record.severity.id }}">{{ record.severity.name }} (deleted)</option>
                    {% endif %}
                    {% for severity in severities %}
                        <option {% if isModify and severity.id == record.severity.id ?? '' %}selected{% endif %} value="{{ severity.id }}">{{ severity.name }}</option>
                    {% endfor %}
                </select>
            {% endif %}
        </div>
        <div class="small-12 medium-6 columns">
            {# This label is intentionally unusual, there exists custom JS that PST uses occasionally which targets
             this <input> field, moving up one will break the form. See SA-18992 for more. #}
            <label> Points <input type="number" inputmode="numeric" name="points" size="35" min="-1000000" max="1000000" value="{{ record.points }}"/> </label>
        </div>
        <div class="small-12 medium-6 columns">
            <label> Tags
                <span class="hint has-tip tip-top" data-tooltip title="Tags can be added to support {{ locale.pastoral }} reports and filtering.">?</span>
                <input id="tags" name="tags" value="{% for tag in record.tags %}{{ tag.name }},{% endfor %}"> </label>
            <input id="tagNames" type="hidden" name="tagNames">
        </div>
        {% if config.pastoral_action_enable %}
        <div class="small-6 columns">
            <label for="pastoral-actions"> Actions</label>
            <select data-actions name="actions[]" id="pastoral-actions" multiple></select>
        </div>
        {% endif %}
    </fieldset>
</section>
