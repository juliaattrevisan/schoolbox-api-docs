{% import '@pastoral/macros/profile.twig' as profile %}

{% if recordType == 'public' %}
    {% set commentHeading = 'General' %}
    {% set body = record.bodyPublic %}
    {% set attachments = attachmentsPublic %}
{% elseif recordType == 'private' %}
    {% set commentHeading = 'Confidential' %}
    {% set body = record.bodyPrivate %}
    {% set attachments = attachmentsPrivate %}
{% endif %}

{% if (recordType == 'public' and access.public) or (recordType == 'private' and access.private) %}

    {% set commentInsertRoute = routeLookupIfAuthorized('pastoral.postCommentInsert', {'recordId': record.id}) %}
    {% set deleteCommentRoute = routeLookupIfAuthorized('pastoral.postCommentDelete') %}

    {# Only users that are able to make comments should see comments #}
    {% if commentInsertRoute %}

        {% if (recordType == 'public' and access.public) %}
        <div id="pastoral-record-comments-container-public">
            <pastoral-record-comments
                cdn-prefix="{{ CDN_PREFIX }}"
                comment-heading="{{ commentHeading }}"
                comment-insert-route="{{ commentInsertRoute }}"
                :initial-comments="{{ comments|json_encode }}"
                record-type="{{ recordType }}"
                site-version="{{ config.site_version }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/pastoralRecordCommentsPublic.js?v={{ config.site_version }}"></script>
        {% elseif (recordType == 'private' and access.private) %}
        <div id="pastoral-record-comments-container-private">
            <pastoral-record-comments
                cdn-prefix="{{ CDN_PREFIX }}"
                comment-heading="{{ commentHeading }}"
                comment-insert-route="{{ commentInsertRoute }}"
                :initial-comments="{{ comments|json_encode }}"
                record-type="{{ recordType }}"
                site-version="{{ config.site_version }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/pastoralRecordCommentsPrivate.js?v={{ config.site_version }}"></script>
        {% endif %}

    {% endif %}

{% endif %}
