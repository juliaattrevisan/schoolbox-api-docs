{% import '@pastoral/macros/profile.twig' as profile %}

{% if recordType == 'public' %}
    {% set commentHeading = 'General' %}
    {% set body = record.bodyPublic %}
    {% set attachments = attachmentsPublic %}
{% elseif recordType == 'private' %}
    {% set commentHeading = 'Confidential' %}
    {% set body = record.bodyPrivate %}
    {% set attachments = attachmentsPrivate %}
{% endif %}

{% if (recordType == 'public' and access.public) or (recordType == 'private' and access.private) %}

    {% set commentInsertRoute = routeLookupIfAuthorized('pastoral.postCommentInsert', {'recordId': record.id}) %}

    {# Only users that are able to make comments should see comments #}
    {% if commentInsertRoute %}

        <div id="comments">
            <div class="row">
                <div class="small-12 island">
                    <section class="content no-margin hide-for-print">
                        <h2>{{ commentHeading }} Comments ({{ comments|length }})</h2>
                        <form method="post" action="{{ commentInsertRoute }}">
                            <input type="hidden" name="pastoral_id" value="{{ record.id }}"> <input type="hidden" name="student_id" value="{{ record.student.id }}">
                            <textarea id="comment-body-{{ recordType }}" rows="3" cols="50" name="comment_body" placeholder="Add a comment"></textarea>
                            {% if recordType == 'private' %}
                                <input type="hidden" name="comment_private" value="1"/>
                            {% endif %}
                            <input disabled data-comment-insert-{{ recordType }} type="submit" value="Post comment">
                        </form>
                    </section>

                    {% if comments | length > 0 %}
                    <hr class="no-margin" />

                    <section class="discussion">
                        <ul class="information-list">
                            {% for comment in comments %}
                                <li class="actions-small-1">
                                    <div class="list-item">
                                        <div class="small-12 compact card">
                                            {% if comment.owner.isDeleted() %}
                                                {{ profile.imageSquare64(comment.owner) }}
                                                <p>
                                                    {{ comment.owner.fullName }}
                                                </p>
                                                <span class="pipe meta" title="{{ comment.createdAt.short }}">{{ comment.createdAt.relativeDay }}</span>
                                            {% else %}
                                                <a href="{{ profile.link(comment.owner) }}" title="View Profile">
                                                    {{ profile.imageSquare64(comment.owner) }}
                                                    <p>
                                                        {{ comment.owner.fullName }}
                                                    </p>
                                                    <span class="pipe meta" title="{{ comment.createdAt.short }}">{{ comment.createdAt.relativeDay }}</span>
                                                </a>
                                            {%  endif %}
                                        </div>
                                        <article>{{ comment.body | purify }}</article>
                                    </div>
                                    <nav>
                                        {% set commentDeleteRoute = routeLookupIfAuthorized('pastoral.postCommentDelete', {'recordId': record.id, 'commentId': comment.id}) %}
                                        {% if commentDeleteRoute %}
                                            <a data-delete-comment="{{ comment.id }}" class="icon-delete" href="#" title="Delete Comment"></a>
                                        {% endif %}
                                    </nav>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                    {% endif %}
                </div>
            </div>
        </div>

        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
        <script type="text/javascript">
            {# Disable the add comment button if text box is empty to prevent saving blank comments #}
            $(function () {
                $.fn.alaressEditor({
                    removePlugins: 'uploadimage,schoolboxanchor',
                    removeButtons: 'Subscript,Superscript,RemoveFormat,Table,HorizontalRule,SpecialChar,EqnEditor,Embed',
                    toolbarGroups: [
                        {name: 'basicstyles', groups: ['basicstyles', 'cleanup']},
                        {name: 'paragraph', groups: ['list', 'blocks', 'bidi']},
                        {name: 'insert', groups: ['insert']},

                        /* Custom schoolbox-specific plugin stuff can go here
                         * This is a hole into which you may put once-off abilities
                         * for the ckeditor (such as Make Blank, in Quiz/Fillgap)
                         * This is typically not used for anything else for now
                         */
                        {name: 'schoolbox', groups: ['schoolboxlink']},
                    ],
                    height: 150,
                    targetElements: $('#comment-body-{{ recordType }}'),
                    on: {
                        change: function (event) {
                            $('[data-comment-insert-{{ recordType }}]').prop('disabled', $.trim(CKEDITOR.instances['comment-body-{{ recordType }}'].getData()) === '');
                        }
                    }
                });
            });
        </script>

    {% endif %}

{% endif %}
