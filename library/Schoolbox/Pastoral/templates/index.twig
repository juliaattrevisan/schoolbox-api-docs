{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ locale.pastoralCare.proper ]
) }}

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ locale.pastoralCare.proper }}</h1>
        </div>
    </div>
    {% include '@pastoral/dropdown_actions.twig' %}
</div>

{# If the user has never viewed a pastoral record, show a welcome message #}

{% include '@pastoral/index_section_welcome.twig' %}
{% include '@pastoral/search_field.twig' %}

{% if recentDashboard is not empty or recentStudents is not empty or groups is not empty or reportsDashboard is not empty %}
    <div class="row">
        {% include '@pastoral/index_section_records.twig' %}

        <div class="small-12 medium-6 island">
            {% include '@pastoral/index_section_reports.twig' %}
            {% include '@pastoral/index_section_groups.twig' %}
        </div>

    </div>
{% endif %}


