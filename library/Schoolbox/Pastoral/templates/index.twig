{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ locale.pastoralCare.proper ]
) }}

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ locale.pastoralCare.proper }}</h1>
        </div>
    </div>
    <nav>
        {% set routeGetGroups = routeLookupIfAuthorized('pastoralManagement.getGroups') %}
        {% set routeReportBuilder = routeLookupIfAuthorized('pastoralReportBuilder.getIndex') %}
        {% set routeGetAudiences = routeLookupIfAuthorized('pastoralManagement.getAudiences') %}

        <a href="#" class="icon-more" data-dropdown="header-options" title="Actions"></a>
    </nav>
    <ul class="f-dropdown fadeInDown" data-dropdown-content="" id="header-options">
        {% if routeReportBuilder %}
            <li><a href="{{ routeReportBuilder }}" class="icon-result" title="{{ locale.pastoral.proper }} Report Builder">Report Builder</a></li>
        {% endif %}
        {% if routeGetGroups %}
            <li><a href="{{ routeGetGroups }}" class="icon-group" title="Manage {{ locale.pastoral.proper }} Groups">Manage Groups</a></li>
        {% endif %}
        {% if routeGetAudiences %}
            <li><a href="{{ routeGetAudiences }}" class="icon-settings" title="Manage {{ locale.pastoral.proper }} Audience Defaults">Manage Visibility Defaults</a></li>
        {% endif %}
    </ul>
</div>

{# If the user has never viewed a pastoral record, show a welcome message #}

{% include '@pastoral/index_section_welcome.twig' %}
{% include '@pastoral/search_field.twig' %}

{% if recentDashboard is not empty or recentStudents is not empty or groups is not empty or reportsDashboard is not empty %}
    <div class="row">
        {% include '@pastoral/index_section_records.twig' %}

        <div class="small-12 medium-6 island">
            {% include '@pastoral/index_section_reports.twig' %}
            {% include '@pastoral/index_section_groups.twig' %}
        </div>

    </div>
{% endif %}


