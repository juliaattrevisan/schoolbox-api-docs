{% import '@pastoral/macros/user_search.twig' as userSearch %}

<h2 class="subheader">Record Visibility</h2>
<section>

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# User Roles Access #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    <table class="no-margin">
        <thead>
            <tr>
                <th class="small-5">User Role Visibility</th>
                <th class="small-2">No Visibility</th>
                <th class="small-2">General</th>
                <th class="small-2">{{ locale.pastoralPrivate.proper }}</th>
            </tr>
        </thead>
        <tbody>
            {% for role in roles if not role.isStudent and not role.isGuest %}
                {% if allowParents == 1 or not role.isParent %}

                    {# Work out which radio should be checked for each row #}

                    {% set checkedNone = '' %}
                    {% set checkedPublic = '' %}
                    {% set checkedPrivate = '' %}

                    {% if record.id != '' %}
                        {% for access in record.access if access.role.id != '' %}
                            {% if access.role.id == role.id %}
                                {% if access.private == 1 %}
                                    {% set checkedPrivate = 'checked' %}
                                {% else %}
                                    {% set checkedPublic = 'checked' %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}

                    {% if checkedPublic == '' and checkedPrivate == '' %}
                        {% set checkedNone = 'checked' %}
                    {% endif %}

                    <tr>
                        <td>
                            {{ role.name }}
                            {% if role.isParent %}Of Student{% endif %}
                        </td>
                        <td>
                            <input type="radio" name="role[{{ role.id }}]" id="roleNone{{ role.id }}" value="0" {{ checkedNone }}>
                            <label class="radio-label" for="roleNone{{ role.id }}"></label>
                        </td>
                        <td>
                            <input type="radio" name="role[{{ role.id }}]" id="rolePublic{{ role.id }}" value="1" {{ checkedPublic }}>
                            <label class="radio-label" for="rolePublic{{ role.id }}"></label>
                        </td>
                        <td>
                            <input type="radio" name="role[{{ role.id }}]" id="rolePrivate{{ role.id }}" value="2" {{ checkedPrivate }}>
                            <label class="radio-label" for="rolePrivate{{ role.id }}"></label>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# Pastoral Groups Access #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    {% if groups | length > 0 %}

        <table class="no-margin">
            <thead>
                <tr>
                    <th class="small-5">{{ locale.pastoral.proper }} Group Visibility</th>
                    <th class="small-2"></th>
                    <th class="small-2"></th>
                    <th class="small-2"></th>
                </tr>
            </thead>
            <tbody>
                {% for group in groups %}
                    {# Work out which radio should be checked for each row #}

                    {% set checkedNone = '' %}
                    {% set checkedPublic = '' %}
                    {% set checkedPrivate = '' %}

                    {% if record.id != '' %}
                        {% for access in record.access if access.group.id != '' %}
                            {% if access.group.id == group.id %}
                                {% if access.private == 1 %}
                                    {% set checkedPrivate = 'checked' %}
                                {% else %}
                                    {% set checkedPublic = 'checked' %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}

                    {% if checkedPublic == '' and checkedPrivate == '' %}
                        {% set checkedNone = 'checked' %}
                    {% endif %}

                    <tr>
                        <td>
                            {{ group.name }}
                        </td>
                        <td>
                            <input type="radio" name="group[{{ group.id }}]" id="groupNone{{ group.id }}" value="0" {{ checkedNone }}>
                            <label class="radio-label" for="groupNone{{ group.id }}"></label>
                        </td>
                        <td>
                            <input type="radio" name="group[{{ group.id }}]" id="groupPublic{{ group.id }}" value="1" {{ checkedPublic }}>
                            <label class="radio-label" for="groupPublic{{ group.id }}"></label>
                        </td>
                        <td>
                            <input type="radio" name="group[{{ group.id }}]" id="groupPrivate{{ group.id }}" value="2" {{ checkedPrivate }}>
                            <label class="radio-label" for="groupPrivate{{ group.id }}"></label>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

    {% endif %}

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# Individual Users Access #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    {% if allowIndividual %}

        {# Setup user selection modal #}

        {% set guid = getGuid() %}

        {% if allowParents == 1 %}
            {% set searchScope = 'staff;parentofstudent' %}
        {% else %}
            {% set searchScope = 'staff' %}
        {% endif %}

        {{ userSearch.modal(guid, 'Add User To Record', 'Enter name', searchScope, record.student.id, 'window.modalUserAdded') }}

        <script>
            $(function () {
                window.usersAdded = [
                    {% for access in record.access if access.user.id != '' -%}
                    {{ access.user.id }},
                    {% endfor %}
                ];

                window.modalUserAdded = function (user) {
                    if ($.inArray(user.id, window.usersAdded) === -1) {
                        $('#empty-users').remove();
                        html = $('[data-user-permission-clone]').html()
                            .replace(/{NAME}/g, user.first_name + ' ' + user.last_name)
                            .replace(/{ID}/g, user.id)
                            .replace(/{ROLE}/g, user.role);
                        window.usersAdded.push(user.id);
                        var userListPermission = $('#userListPermission');
                        userListPermission.html(userListPermission.html() + html);
                    }
                };
            });
        </script>

        <table class="no-margin">
            <thead>
                <tr>
                    <th class="small-5">Individual User Visibility</th>
                    <th class="small-2"></th>
                    <th class="small-2"></th>
                    <th class="small-2"></th>
                </tr>
            </thead>
            <tbody id="userListPermission">
                {% set countUsers = 0 %}

                {% for access in record.access if access.user.id != '' %}

                    {# Work out which radio should be checked for each row#}

                    {% set checkedNone = '' %}
                    {% set checkedPublic = '' %}
                    {% set checkedPrivate = '' %}

                    {% if record.id != '' %}
                        {% for userAccess in record.access if access.user.id != '' %}
                            {% if userAccess.user.id == access.user.id %}
                                {% if userAccess.private == 1 %}
                                    {% set checkedPrivate = 'checked' %}
                                {% else %}
                                    {% set checkedPublic = 'checked' %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}

                    {% if checkedPublic == '' and checkedPrivate == '' %}
                        {% set checkedNone = 'checked' %}
                    {% endif %}

                    <tr>
                        <td>{{ access.user.firstname }} {{ access.user.lastname }} ({{ access.user.role.name }})</td>
                        <td>
                            <input type="radio" name="user[{{ access.user.id }}]" id="userNone{{ access.user.id }}" value="0" {{ checkedNone }}>
                            <label class="radio-label" for="userNone{{ access.user.id }}"></label>
                        </td>
                        <td>
                            <input type="radio" name="user[{{ access.user.id }}]" id="userPublic{{ access.user.id }}" value="1" {{ checkedPublic }}>
                            <label class="radio-label" for="userPublic{{ access.user.id }}"></label>
                        </td>
                        <td>
                            <input type="radio" name="user[{{ access.user.id }}]" id="userPrivate{{ access.user.id }}" value="2" {{ checkedPrivate }}>
                            <label class="radio-label" for="userPrivate{{ access.user.id }}"></label>
                        </td>
                    </tr>
                    {% set countUsers = countUsers + 1 %}
                {% endfor %}
            </tbody>
        </table>
        <div class="component-action">
            <section>
                <a href="#" data-button="add-row" class="button" data-user-search="{{ guid }}">Add Individual User</a>
            </section>
        </div>
    {% endif %}

</section>


{# Cloneable HTML For Individual User Permission #}

<table class="hide">
    <tbody data-user-permission-clone>
        <tr>
            <td>{NAME} ({ROLE})</td>
            <td>
                <input type="radio" name="user[{ID}]" id="userNone{ID}" value="0" checked>
                <label class="radio-label" for="userNone{ID}"></label>
            </td>
            <td>
                <input type="radio" name="user[{ID}]" id="userPublic{ID}" value="1">
                <label class="radio-label" for="userPublic{ID}"></label>
            </td>
            <td>
                <input type="radio" name="user[{ID}]" id="userPrivate{ID}" value="2">
                <label class="radio-label" for="userPrivate{ID}"></label>
            </td>
        </tr>
    </tbody>
</table>