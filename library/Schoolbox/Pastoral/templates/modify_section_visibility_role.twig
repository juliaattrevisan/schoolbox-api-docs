{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
{# Pastoral Role / Role Type Access #}
{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

{% if roles | length > 0 %}

    <tbody id="permission-roles">

        {% if record.id != '' %}
            {% for userAccess in record.accessWithPermission|filter(userAccess => userAccess.role or userAccess.roleType) %}
                {% set roleId = null %}
                {% if userAccess.roleType %}
                    {% set roleId = 'role-type-' ~ userAccess.roleType %}
                    {% set roleName = userAccess.roleType | capitalize %}
                    {% set readonly = '' %}
                    {% set alwaysReadOnly = 0 %}
                    {% set campusHidden = 1 %}
                    {% set campusChecked = '' %}
                    {% set checkedComment = userAccess.commentsAllowed ? 'checked="checked"' : '' %}
                {% elseif userAccess.role %}
                    {% set roleId = userAccess.role.id %}
                    {% set roleName = userAccess.role.name %}
                    {% set readonly = userAccess.role.type == 'staff' ? 'readonly' : '' %}
                    {% set campusHidden = userAccess.access == 0 %}
                    {% set campusChecked = userAccess.matchCampus ? 'checked="checked"' : '' %}
                    {% set alwaysReadOnly = userAccess.role.type == 'staff' ? 1 : 0 %}
                    {% set checkedComment = userAccess.role.type == 'staff' ? 'checked="checked"' : '' %}
                {% endif %}

                {% if roleId %}
                    {# Work out which radio should be checked for each row #}
                    {% set checkedDeny = '' %}
                    {% set checkedPublic = '' %}
                    {% set checkedPrivate = '' %}

                    {% if userAccess.access == 0 %}
                        {% set checkedDeny = 'checked' %}
                    {% elseif userAccess.access == 1 %}
                        {% set checkedPublic = 'checked' %}
                    {% elseif userAccess.access == 2 %}
                        {% set checkedPrivate = 'checked' %}
                    {% endif %}

                    <tr data-role-id="{{ roleId }}">
                        <td class="small-1">
                            Role
                        </td>
                        <td class="small-2">
                            {{ roleName }}
                            <input type="hidden" name="roleAccessId{{ roleId }}" id="roleAccessId{{ roleId }}" value="{{ userAccess.id }}" >
                        </td>
                        <td class="small-2">
                            <input type="radio" name="role[{{ roleId }}]" id="roleDeny{{ roleId }}"
                                   value="0" {{ checkedDeny }}>
                            <label class="radio-label" for="roleDeny{{ roleId }}"></label>
                        </td>
                        <td class="small-2">
                            <input type="radio" name="role[{{ roleId }}]" id="rolePublic{{ roleId }}"
                                   value="1" {{ checkedPublic }}>
                            <label class="radio-label" for="rolePublic{{ roleId }}"></label>
                        </td>
                        <td class="small-2">
                            <input type="radio" name="role[{{ roleId }}]" id="rolePrivate{{ roleId }}"
                                   value="2" {{ checkedPrivate }}>
                            <label class="radio-label" for="rolePrivate{{ roleId }}"></label>
                        </td>
                        <td class="small-1 checklist">
                            <input type="checkbox" name="roleCampus{{ roleId }}" id="roleCampus{{ roleId }}"
                                   value="1" {{ campusChecked }}>
                            <label class="checkbox-label {{ campusHidden == 1 ? 'hide' : ''}}" for="roleCampus{{ roleId }}"></label>
                        </td>
                        <td class="small-1 checklist">
                            <input type="checkbox" name="roleComment{{ roleId }}" id="roleComment{{ roleId }}"
                                   value="1" {{ checkedComment }} {{ readonly }} data-always-read-only="{{ alwaysReadOnly }}">
                            <label class="checkbox-label {{ userAccess.access == 0 ? 'hide' : ''}}" for="roleComment{{ roleId }}"></label>
                        </td>
                        <td class="text-right small-1">
                            <a href="#" data-delete-visibility="role" class="icon-delete"></a>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        {% endif %}

    </tbody>

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# Setup Role Selection Modal #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    <div id="modal-role" class="reveal-modal" data-reveal role="dialog">
        <h2>Add Pastoral Role</h2>
        <section>
            <ul class="information-list">
                {# Only show roles which actually have users #}
                {% for role in roles|filter(r => roleUserCounts[r.id] > 0) %}
                    <li data-role-add="{{ role.id }}" data-role-name="{{ role.name }}">
                        <a class="list-item link-row">
                            <div class="card small-12">
                                <i class="icon-group alert size-32"></i>
                                <p>{{ role.name }}</p>
                                <p class="meta">
                                    System Role

                                    {# Don't show the user count for student or parent roles #}
                                    {% if role.isStaff %}
                                        ({{ roleUserCounts[role.id] }} {% if roleUserCounts[role.id] == 1 %}User{% else %}Users{% endif %})
                                    {% endif %}

                                    {% if role.isStudent %}
                                        <br />
                                        (Only {{ record.student.firstName ?? 'the student' }} will be able to view this record.)
                                    {% endif %}

                                    {% if role.isParent %}
                                        <br />
                                        (Only {{ record.student.firstName ?? 'the student' }}'s parents will be able to view this record.)
                                    {% endif %}
                                </p>
                            </div>
                        </a>
                    </li>
                {% endfor %}

                {# Students/Parents: a role type, rather than a role #}
                {% for roleType in roleTypes %}
                    <li data-role-add="role-type-{{ roleType }}" data-role-name="{{ roleType | capitalize }}">
                        <a class="list-item link-row">
                            <div class="card small-12">
                                <i class="icon-group alert size-32"></i>
                                <p>{{ roleType | capitalize }}</p>
                                <p class="meta">
                                    System Role

                                    {% if roleType == 'student' %}
                                        <br />
                                        (Only {{ record.student.firstName ?? 'the student' }} will be able to view this record.)
                                    {% endif %}

                                    {% if roleType == 'parent' %}
                                        <br />
                                        (Only {{ record.student.firstName ?? 'the student' }}'s parents will be able to view this record.)
                                    {% endif %}
                                </p>
                            </div>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>

    <script>
        $(function () {
            {# Setup click events #}

            function updateRolePermissionsClick() {
                $('[data-delete-visibility="role"]').click(function (e) {
                    e.preventDefault();

                    let row = $(this).closest('tr');
                    let roleId = $(row).attr('data-role-id');

                    $('[data-reveal]').hide();

                    $(this).confirmDialog({
                        text: 'Are you sure you wish to remove the pastoral roles visibility record?',
                        confirmEvent: function () {
                            // Remove from window.rolesAdded
                            let index = window.rolesAdded.indexOf(roleId);
                            window.rolesAdded.splice(index, 1);

                            row.remove();
                            updateRolesModal();
                            updateVisibility();
                            window.hasChanged = true;
                        }
                    });
                });
            }

            {# Enable/Disable add pastoral role button depending on if there are any more roles available to add #}

            function updateRolesModal() {
                let tableRolesAdded = $('[data-role-id]');

                $("[data-role-add]").removeClass('hide');

                if (tableRolesAdded.length > 1) {
                    tableRolesAdded.each(function () {
                        let roleId = $(this).attr('data-role-id');

                        if (roleId !== '{ID}') {
                            if (window.rolesAdded.indexOf(roleId) !== -1) {
                                $("[data-role-add=" + roleId + "]").addClass('hide');
                            } else {
                                $("[data-role-add=" + roleId + "]").removeClass('hide');
                            }
                        }
                    });
                }

                let roleModalButtons = $("[data-reveal-id='modal-role']");

                if ($("[data-role-add]:not(.hide)").length === 0) {
                    roleModalButtons.attr('disabled', 'true');
                } else {
                    roleModalButtons.removeAttr('disabled');
                }
            }

            {# Add role to table #}

            window.addRole = function(roleId, roleName, permission, commentsAllowed, matchCampus, locked) {

                // this line will check if the argument is undefined
                // if so set it to 1, otherwise set it to its original value
                permission = (typeof permission !== 'undefined') ?  permission : 1;

                if (window.rolesAdded.indexOf(roleId) === -1) {
                    $('#empty-roles').remove();

                    let html = $('[data-role-permission-clone]').html()
                        .replace(/{TYPE_NAME}/g, 'Role')
                        .replace(/{NAME}/g, roleName)
                        .replace(/{ID}/g, roleId);
                    window.rolesAdded.push(roleId);

                    let permissionListRoles = $('#permission-roles');
                    permissionListRoles.append(html);

                    let isStaff = roleId !== 'role-type-parent' && roleId !== 'role-type-student';

                    // enable comment checkbox only for student and parent role type
                    let commentCheckbox = $('#roleComment' + roleId);
                    initCheckbox(
                            commentCheckbox,
                            isStaff,
                            commentsAllowed,
                            permission
                    );

                    initCheckbox($('#roleCampus' + roleId), false, matchCampus, isStaff ? permission : '0');

                    //Check the correct box
                    let selector = 'input[name = "role['+roleId+']"][value ="'+permission+'"]';
                    permissionListRoles.find(selector).attr("checked", "checked");
                    setRadioButtonListener('[data-role-id="' + roleId + '"]', commentCheckbox);
                    applyLock(['roles'], locked);
                }

                $(this).addClass('hide');

                updateRolePermissionsClick();
                updateRolesModal();
                updateVisibility();
            }

            $('[data-role-add]').click(function (e) {
                e.preventDefault();

                let roleId = $(this).attr('data-role-add');
                let roleName = $(this).attr('data-role-name');

                addRole(roleId, roleName);

                let remaining = 0;

                $("[data-role-add]").each(function () {
                    if (!$(this).hasClass('hide')) {
                        remaining++;
                    }
                });

                if (remaining === 0) {
                    $('#modal-role').foundation('reveal', 'close');
                }

                window.hasChanged = true;
            });

            {# Initial setup #}

            window.rolesAdded = [];

            {% for userAccess in record.accessWithPermission %}
                {% if userAccess.role %}
                    window.rolesAdded.push('{{ userAccess.role.id }}');
                {% elseif userAccess.roleType %}
                    window.rolesAdded.push('role-type-{{ userAccess.roleType }}');
                {% endif %}
            {% endfor %}

            updateRolePermissionsClick();
            updateRolesModal();
            updateVisibility();
        });
    </script>

{% endif %}
