{#
    JS specific to the add record page, currently updating the entry tip
    and expires at date based on the type / subtype selection
#}
{% autoescape('js') %}
<script type="text/javascript">
    $(function () {

        const subtypesIndexEntryTip = {{ subtypesIndexEntryTip|json_encode|raw }};
        const subtypesIndexDefaultExpiry = {{ subtypesIndexDefaultExpiry|json_encode|raw }};
        const typesIndexEntryTip = {{ typesIndexEntryTip|json_encode|raw }};
        const typesIndexDefaultExpiry = {{ typesIndexDefaultExpiry|json_encode|raw }};

        /**
         * Update the entry tip based on current type / subtype selection
         * @param entryTip
         */
        function updateEntryTip (entryTip) {
            const entryTipContainer = document.getElementById("entry-tip-container");
             if (entryTipContainer === null) {
                 return;
             }
             if (entryTip === "") { // only show the tip is one is set
                 entryTipContainer.style.display = "none";
             } else {
                entryTipContainer.style.display = "block";
             }
             const entryTipInput = document.getElementById("entry-tip-input");
             if (entryTipInput) {
                 entryTipInput.innerHTML = entryTip; // display the tip
             }
        }

        const isExistingRecord = {{ record.id != '' ? "true" : "false"  }};
        const expiresAt = '{{ record.expiresAt ? record.expiresAt.localShort : null }}';
        const calculatedExpiresAt = {{ calculatedExpiresAt|json_encode|raw }}

        /**
         * When the expires at date has manually changed, this takes precedence and
         * any further changes when type/sub-type is changed will not update the expires at date.
         * Rather conveniently, the jQuery .onChange will not trigger when the expiresAt.value is changed within
         * the updateExpiresAt method, so we don't need to worry about this being triggered when it shouldn't be.
         */
        let hasManualExpiresAtInput = false;
        $("#expiresAt").on("change", function () {
            hasManualExpiresAtInput = true;
        });

        /**
         * Check if the expires at date can be updated when the type/sub-type is changed
         * We prevent updating the expires at date if the record is existing, the expires at date is set,
         * or if there is a manual input for the expires at date
         * @returns boolean
         */
        function canUpdateExpiresAt() {
            return !isExistingRecord && expiresAt === "" && !hasManualExpiresAtInput;
        }

        /**
         * Update the expires at date based on the current type / subtype selection
         * @param defaultExpiry
         */
        function updateExpiresAt (defaultExpiry) {
            if (!canUpdateExpiresAt()) {
                return;
            }
            // ensure expiresAt actually exists before setting the value
            const expiresAtElement = document.getElementById("expiresAt");
            if (expiresAtElement === null) {
                return;
            }
            // if the new type/sub-type Default Expiry is set to 'Never', clear the previously set value and return
            if (defaultExpiry === null || defaultExpiry === "") {
                expiresAtElement.value = "";
                return;
            }
            // otherwise set the expires at date based on the Default Expiry that was set
            expiresAtElement.value = calculatedExpiresAt[defaultExpiry] ?? '';
        }

        /* Some convenient selectors
         */
        const typeDropdown = $('#typeId');
        const subtypeDropdown = $('#subtypeId');

        /* Whenever Subtype changes, see if the now-selected subtypeId is null
         * Decide which template to load
         */
        subtypeDropdown.on('change', function(event) {
            init(typeDropdown.val(), subtypeDropdown.val());
        });

        {% if record.id != '' %}
        /* Get the current entry tip when modifying the record
         */
        if (subtypeDropdown.val() === null) {
            const typeVal = String(typeDropdown.val() ?? "").trim();
            const typeEntryTip = typesIndexEntryTip[typeVal];
            const typeExpiry = typesIndexDefaultExpiry[typeVal];
            updateEntryTip(typeEntryTip != null ? String(typeEntryTip).trim() : "");
            updateExpiresAt(typeExpiry != null ? String(typeExpiry).trim() : "");
        } else {
            const subtypeVal = String(subtypeDropdown.val() ?? "").trim();
            const subtypeEntryTip = subtypesIndexEntryTip[subtypeVal];
            const subtypeExpiry = subtypesIndexDefaultExpiry[subtypeVal];
            updateEntryTip(subtypeEntryTip != null ? String(subtypeEntryTip).trim() : "");
            updateExpiresAt(subtypeExpiry != null ? String(subtypeExpiry).trim() : "");
        }
        {% endif %}

        /**
         * Update the entry tip and expires at date based on the type / subtype selection
         */
        function init(typeVal, subtypeVal) {
            if (null !== subtypeVal) {
                let subtypeEntryTip = subtypesIndexEntryTip[subtypeVal];
                let subtypeExpiry = subtypesIndexDefaultExpiry[subtypeVal];
                updateEntryTip(subtypeEntryTip != null ? String(subtypeEntryTip).trim() : "");
                updateExpiresAt(subtypeExpiry != null ? String(subtypeExpiry).trim() : "");
            } else {
                let typeEntryTip = typesIndexEntryTip[typeVal];
                let typeExpiry = typesIndexDefaultExpiry[typeVal];
                updateEntryTip(typeEntryTip != null ? String(typeEntryTip).trim() : "");
                updateExpiresAt(typeExpiry != null ? String(typeExpiry).trim() : "");
            }
        }

    });
</script>
{% endautoescape %}
