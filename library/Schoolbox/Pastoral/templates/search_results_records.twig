{% import '@pastoral/macros/profile.twig' as profile %}

<section>
    <ul class="action-list">
        {% for record in results %}
            <li class="actions-small-1">
                <div class="list-item">
                    <div class="small-12 card wrap-down">
                        <a href="{{ profile.link(record.student) }}">
                            {{ profile.imageSquare64(record.student) }}
                        </a>
                        <h4>
                            <a href="{{ routeLookup('pastoral.getStudentRecord', { studentId: record.student.id, recordId: record.id}) }}">
                                {{ record.student.fullName }} - {{ record.heading }}
                            </a>
                        </h4>
                        <p class="meta">
                            Created by <a href="{{ profile.link(record.owner) }}">{{ record.owner.fullName }}</a>
                            <span title="{{ record.createdAt.short }}">{{ record.createdAt.relativeDay }}</span>
                        </p>

                        {# Display last updated by if applicable #}
                        {% if record.createdAt.long != record.updatedAtDisplay.long %}
                            <p class="meta">
                                Last updated by <a href="{{ profile.link(record.modifiedByDisplay) }}">{{ record.modifiedByDisplay.fullName }}</a>
                                <span title="{{ record.updatedAtDisplay.short }}">{{ record.updatedAtDisplay.relativeDay }}</span>
                            </p>
                        {% endif %}
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>
</section>
