{# Macros for linking to user profile and displaying user profile picture #}

{% macro imageSquare64(user) -%}
    <img src="/portrait.php?id={{ user.id }}&size=square64"
         style="background-color:#c6c6c6;"
         alt="{{ user.fullName }}"
         title="{{ user.fullName }}">
{%- endmacro %}

{% macro imageSquare32(user) -%}
    <img src="/portrait.php?id={{ user.id }}&size=square32"
         style="background-color:#c6c6c6;"
         alt="{{ user.fullName }}"
         title="{{ user.fullName }}">
{%- endmacro %}

{% macro imagePortrait(user) -%}
    <img class="full-width" src="/portrait.php?id={{ user.id }}&size=profile"
         alt="{{ user.fullName }}"
         title="{{ user.fullName }}">
{%- endmacro %}

{% macro imageSquare200(user) -%}
    <script>
        $(document).ready(
                function () {
                    console.info('window width: ', $(window).width());
                    console.info('img width: ', $('img.full-width').width());
                    console.info('img currentSrc: ', $('img.full-width').prop('currentSrc'));
                }
        );
    </script>
    <img class="full-width"
         height="200"
         width="200"
         srcset="/portrait.php?id={{ user.id }}&amp;size=constrain200 200w, /portrait.php?id={{ user.id }}&amp;size=constrain500 500w"
         sizes="(max-width: 1300px) 200px, 500px"
         src="/portrait.php?id={{ user.id }}&amp;size=constrain200"
         alt="{{ user.fullName }}"
         title="{{ user.fullName }}"/>
{%- endmacro %}

{% macro link(user) -%}
    /search/user/{{ user.id }}
{%- endmacro %}
