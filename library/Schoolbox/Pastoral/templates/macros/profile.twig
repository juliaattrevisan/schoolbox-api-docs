{# Macros for linking to user profile and displaying user profile picture #}

{% macro imageSquare64(user) -%}
    {#
        TODO: Someone else can brutalise this

        Have hardcoded the image size, and defaulted it to the placeholder image so things
        don't appear to 'pop' in so obviously
    #}
    <img src="/portrait.php?id={{ user.id }}&size=square64"
         style="background-color:#c6c6c6;width:64px;height:64px;"
         height="64"
         width="64"
         alt="{{ user.fullName }}"
         title="{{ user.fullName }}">
{%- endmacro %}

{% macro imagePortrait(user) -%}
    <img class="full-width" src="/portrait.php?id={{ user.id }}&size=profile"
         alt="{{ user.fullName }}"
         title="{{ user.fullName }}">
{%- endmacro %}

{% macro imageSquare200(user) -%}
    <img class="full-width"
         src="/portrait.php?id={{ user.id }}&size=constrain200"
         height="200"
         width="200"
         alt="{{ user.fullName }}"
         title="{{ user.fullName }}">
{%- endmacro %}

{% macro link(user) -%}
    /search/user/{{ user.id }}
{%- endmacro %}
