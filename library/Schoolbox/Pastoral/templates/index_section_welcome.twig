{% if recentStudents is empty %}

    <div class="row">
        <div class="small-12 island">
            <section class="content">
                <h2>
                    Welcome to the {{ locale.pastoralCare.proper }} Dashboard!
                </h2>
                <i class="icon-pastoral size-64 left"></i>
                <p>
                    It looks like this is the first time you have used {{ locale.pastoralCare }}. Begin by searching for
                    a students
                    name, or the details of a {{ locale.pastoral }} record in the search box below. Once you start using
                    the system this page will
                    display your recently viewed students and any items which have been flagged by yourself and other
                    staff as important.
                </p>
            </section>
        </div>
    </div>

{% endif %}