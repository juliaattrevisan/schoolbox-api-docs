{% if config.pastoral_action_enable and (record.recordActions | length) > 0 %}
    <div class="row">
        <div class="small-12 medium-6 columns island">
            <h2 class="subheader">Actions</h2>
            <section>
                <fieldset class="checklist padding-none">
                    <ul class="pastoral-actions-list">
                        {% for recordAction in record.recordActions %}
                            <li class="pastoral-actions-list__item" data-list-item-{{ recordAction.action.id }} data-test="pastoral-record-actions-list">
                                <div class="pastoral-action-checkbox-and-label">
                                    <input id="action-{{ recordAction.action.id }}" name="actions[]" type="checkbox"
                                            {{ recordAction.completed ? 'checked="checked"' : '' }}
                                        data-pastoral-action="{{ recordAction.id }}" data-test="pastoral-record-input-action-{{ recordAction.action.id }}/>
                                    <label for="action-{{ recordAction.action.id }}"
                                            {{ recordAction.completed ? 'class="strike"' : '' }} data-test="pastoral-record-action-label-{{ recordAction.action.id }}"">{{ recordAction.action.name }}</label>
                                </div>
                                {% if recordAction.completed %}
                                <div data-action-status-{{ recordAction.action.id }} class="pastoral-action-date-and-user" data-test="pastoral-record-action-status-{{ recordAction.action.id }}>
                                    <span class="meta" title="{{ recordAction.updatedAt.long }}">
                                        Completed <time>{{ recordAction.updatedAt.getRelativeTime }}</time>
                                    </span>
                                    <a href="/search/user/{{ recordAction.updatedBy.id }}" title="{{ recordAction.updatedBy.fullname }}" class="profile-img">
                                        <img src="/portrait.php?id={{ recordAction.updatedBy.id }}&amp;size=square32" alt="Profile photo of {{ recordAction.updatedBy.fullname }}" class="portrait">
                                    </a>
                                </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </fieldset>
            </section>
        </div>
    </div>
    <div id="pastoral-toast" class="toast"></div>
    <script>

        const $toast = $('#pastoral-toast');

        /**
         * Get the properties required to update the pastoral action status
         *
         * @param {HTMLInputElement} checkbox - the checkbox linked to the pastoral action
         * @returns {FormData} - the form data to submit
         */
        function getFormData(checkbox) {
            const formData = new FormData();
            formData.append('recordActionId', checkbox.getAttribute('data-pastoral-action'));
            formData.append('checked', checkbox.checked ? 1 : 0);
            return formData;
        }

        /**
         * Retrieve the date and user linked to the completed action to display in the DOM
         *
         * @param {object} action - the returned pastoral action object, containing the action details
         * @returns {string} - the html markup as string
         */
        function getDateAndUser(action) {
            return `
            <div data-action-status-${action.id} class="pastoral-action-date-and-user">
                <span class="meta" title="${dayjs(action.updatedAt).format('DD/MM/YYYY h:ma')}">
                    Completed <time>${ dayjs(action.updatedAt).fromNow()}</time>
                </span>
                <a href="/search/user/${ action.updatedBy.id }" title="${ action.updatedBy.fullName }" class="profile-img">
                    <img src="/portrait.php?id=${ action.updatedBy.id }&amp;size=square32" alt="Profile photo of ${ action.updatedBy.fullName }" class="portrait">
                </a>
            </div>`
        }

        /**
         * Add/remove a strike through the pastoral action depending on whether its been completed
         *
         * @param {string} checkboxId - the checkbox id linked to the label to update
         * @param {object} action - the returned pastoral action object, containing the action details
         */
        function updateStrike(checkboxId, action) {
            const label = document.querySelector(`label[for="${checkboxId}"]`);
            action.completed ? label.classList.add('strike') : label.classList.remove('strike');
        }

        /**
         * Add/remove the date and user who completed the pastoral action
         *
         * @param {object} action - the returned pastoral action object, containing the action details
         */
        function updateDateAndUser(action) {
            if (action.completed) {
                const dateAndUser = getDateAndUser(action);
                const listItem = document.querySelector(`[data-list-item-${action.id}]`);
                listItem.insertAdjacentHTML('beforeend', dateAndUser);
            } else {
                const dateAndUser = document.querySelector(`[data-action-status-${action.id}]`);
                dateAndUser.remove();
            }
        }

        /**
         * Add/remove a strike through the pastoral action depending on whether its been completed
         * Also if the action is marked as complete, display who marked it and when
         *
         * @param {string} checkboxId - the checkbox id linked to the label to update
         * @param {object} action - the returned pastoral action object, containing the action details
         */
        function displayChange(checkboxId, action) {
            updateStrike(checkboxId, action);
            updateDateAndUser(action);
        }

        /**
         * To complete / uncomplete a pastoral action
         *
         * @param {HTMLInputElement} checkbox - the checkbox linked to the pastoral action
         */
        async function submitChange(checkbox) {
            try {
                checkbox.disabled = true;
                const response = await fetch('{{ routeLookupIfAuthorized('pastoral.postActionUpdate', {recordId: record.id, record: record}) }}', {
                    method: 'POST',
                    body: getFormData(checkbox),
                });
                if (response.ok) {
                    const responseJson = await response.json();
                    const checkboxId = checkbox.getAttribute('id');
                    responseJson.recordActions.forEach((action) => { // all pastoral actions are returned
                        if (checkboxId !== `action-${action.id}`) { // so we need to determine which was just changed
                            return;
                        }
                        displayChange(checkboxId, action);
                    });
                    $toast.toastTimeout({text: 'Action updated.', css: 'success'});
                } else {
                    $toast.toastTimeout({text: 'Could not update action ', css: 'alert'});
                }
            } catch (error) {
                console.warn(error);
                $toast.toastTimeout({text: 'Could not update action ', css: 'alert'});
            } finally {
                checkbox.disabled = false;
            }
        }

        /**
         * Find all the pastoral action checkboxes so we can listen for changes on each
         */
        Array.from(document.querySelectorAll('[data-pastoral-action]')).forEach((checkbox) => {
            checkbox.addEventListener('change', () => {
                submitChange(checkbox);
            });
        });

    </script>
{% endif %}
