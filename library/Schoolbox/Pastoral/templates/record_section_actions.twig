{% if config.pastoral_action_enable and (record.recordActions | length) > 0 %}
    <div class="row">
        <div class="small-12 medium-6 columns island">
            <h2 class="subheader">Actions</h2>
            <section>
                <fieldset class="checklist pastoral-actions-list">
                    <ul class="option-list">
                        {% for recordAction in record.recordActions %}
                            <li>
                                <div>
                                    <input id="action-{{ recordAction.action.id }}" name="actions[]" type="checkbox"
                                            {{ recordAction.completed ? 'checked="checked"' : '' }}
                                        data-pastoral-action="{{ recordAction.id }}"/>
                                    <label for="action-{{ recordAction.action.id }}"
                                            {{ recordAction.completed ? 'class="strike"' : '' }}>{{ recordAction.action.name }}</label>
                                </div>
                                {% if recordAction.completed %}
                                <div data-action-status-{{ recordAction.action.id }}>
                                    <span class="meta" title="{{ recordAction.updatedAt.local }}" >
                                                    Completed <time>{{ recordAction.updatedAt.getRelativeTime }}</time></span>
                                    <a href="/search/user/{{ recordAction.updatedBy.id }}" title="View user" class="profile-img">
                                        <img src="/portrait.php?id={{ recordAction.updatedBy.id }}&amp;size=square32" alt="Profile photo of {{ recordAction.updatedBy.fullname }}" title="{{ recordAction.updatedBy.fullname }}" class="portrait">
                                    </a>
                                </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </fieldset>
            </section>
        </div>
    </div>
    <div id="pastoral-toast" class="toast"></div>
    <script>

        const $toast = $('#pastoral-toast');

        /**
         * Get the properties required to update the pastoral action status
         *
         * @param {HTMLInputElement} checkbox - the checkbox linked to the pastoral action
         * @returns {FormData} - the form data to submit
         */
        function getFormData(checkbox) {
            const formData = new FormData();
            formData.append('recordActionId', checkbox.getAttribute('data-pastoral-action'));
            formData.append('checked', checkbox.checked ? 1 : 0);
            return formData;
        }

        /**
         * Add/remove a strike through the pastoral action depending on whether its been completed
         * Also if the action is marked as complete, display who marked it and when
         *
         * @param {number} actionId - the pastoral action id
         * @param {object} action - the returned pastoral action object, containing the action details
         */
        function displayActionChange(actionId, action) {
            const actionLabel = document.querySelector(`label[for="${actionId}"]`);
            const actionStatus = document.querySelector(`[data-action-status-${action.id}]`);
            if (action.completed) {
                actionLabel.classList.add('strike');
                if (actionStatus) {
                    actionStatus.style.display = 'block';
                }
            } else {
                actionLabel.classList.remove('strike');
                if (actionStatus) {
                    actionStatus.style.display = 'none';
                }
            }
        }

        /**
         * To complete / uncomplete a pastoral action
         *
         * @param {HTMLInputElement} checkbox - the checkbox linked to the pastoral action
         */
        async function submitActionChange(checkbox) {
            try {
                const response = await fetch('{{ routeLookupIfAuthorized('pastoral.postActionUpdate', {recordId: record.id, record: record}) }}', {
                    method: 'POST',
                    body: getFormData(checkbox),
                });
                if (response.ok) {
                    const responseJson = await response.json();
                    const actionId = checkbox.getAttribute('id');
                    responseJson.recordActions.forEach((action) => { // all pastoral actions are returned
                        if (actionId !== `action-${action.id}`) { // so we need to determine which was just changed
                            return;
                        }
                        displayActionChange(actionId, action);
                    });
                    $toast.toastTimeout({text: 'Action updated.', css: 'success'});
                } else {
                    $toast.toastTimeout({text: 'Could not update action ', css: 'alert'});
                }
            } catch (error) {
                console.warn(error);
                $toast.toastTimeout({text: 'Could not update action ', css: 'alert'});
            }
        }

        /**
         * Find all the pastoral action checkboxes so we can listen for changes on each
         */
        Array.from(document.querySelectorAll('[data-pastoral-action]')).forEach((checkbox) => {
            checkbox.addEventListener('change', () => {
                submitActionChange(checkbox);
            });
        });

    </script>
{% endif %}
