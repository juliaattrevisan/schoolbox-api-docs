{% import '@pastoral/macros/profile.twig' as profile %}

<div class="profile content">
    <div class="row no-margin">
        <div class="small-12 medium-2 columns no-pad">
            {{ profile.imageSquare200(record.student) }}
        </div>
        <div class="small-12 medium-10 columns">
            <dl class="profile">
                <dt class="small-12 medium-3">Author:</dt>
                <dd class="small-12 medium-9"><a href="{{ profile.link(record.owner) }}">{{ record.owner.fullName }}</a></dd>

                <dt class="small-12 medium-3">Record Created:</dt>
                <dd class="small-12 medium-9">{{ record.createdAt.long }}</dd>

                {% if user.role.isStaff %}

                    {% if record.severity.name is not empty and config.pastoral_severity %}
                        <dt class="small-12 medium-3">{{ locale.severity.proper }}:</dt>
                        <dd class="small-12 medium-9">{{ record.severity.name }}</dd>
                    {% endif %}

                    <dt class="small-12 medium-3">Record Type:</dt>
                    <dd class="small-12 medium-9">{{ record.type.name }}</dd>

                    {% if record.subtype.name is not empty %}
                        <dt class="small-12 medium-3">Record Sub-Type:</dt>
                        <dd class="small-12 medium-9">{{ record.subtype.name }}</dd>
                    {% endif %}

                    {% if record.points is not empty %}
                        <dt class="small-12 medium-3">Points:</dt>
                        <dd class="small-12 medium-9">{{ record.points }}</dd>
                    {% endif %}

                {% endif %}
            </dl>

            {# Only staff should see pastoral tags #}

            {% if record.tags | length and user.role.isStaff %}
                <div class="content">
                    {% for tag in record.tags %}
                        {% set routeTag = routeLookupIfAuthorized('pastoralReportBuilder.getReportTags', {tagId: tag.id}) %}
                        {% if routeTag %}
                            <a href="{{ routeTag }}" class="neutral label">{{ tag.name }}</a>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>