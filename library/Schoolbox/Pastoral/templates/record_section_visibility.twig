{% import '@pastoral/macros/profile.twig' as profile %}

{# Visibility and Linked Records (Other Students Involved) #}

<div class="small-12 {% if record.relatedRecords | length %}medium-6{% endif %} island">
    <h2 class="subheader">Content Visibility</h2>
    <section>
        <ul class="information-list">

            {# ---------------------------------------------------------------------------------------------------------------------------------------------------------- #}
            {# Record Owner #}
            {# ---------------------------------------------------------------------------------------------------------------------------------------------------------- #}

            <li>
                <div class="small-12 card wrap-down">
                    {% if record.owner.isDeleted() %}
                        {{ profile.imageSquare64(record.owner) }}
                        <span class="neutral label right">Author</span>
                        <p>
                            {{ record.owner.firstname }} {{ record.owner.lastname }}
                        </p>
                        <p class="meta">Author</p>
                    {% else %}
                        <a href="{{ profile.link(record.owner) }}">
                            {{ profile.imageSquare64(record.owner) }}
                            <span class="neutral label right">Author</span>
                            <p>
                                {{ record.owner.firstname }} {{ record.owner.lastname }}
                            </p>
                        </a>
                        <p class="meta">Author</p>
                    {% endif %}
                </div>
            </li>

            {# ---------------------------------------------------------------------------------------------------------------------------------------------------------- #}
            {# Access #}
            {# ---------------------------------------------------------------------------------------------------------------------------------------------------------- #}
            {% for accessLevel in [2, 1, 0] %}
                {% if accessLevel == 2 %}
                    {% set accessLevelLabel = '<span class="neutral label right">'~locale.pastoralPrivate.proper~'</span>' %}
                {% elseif accessLevel == 0 %}
                    {% set accessLevelLabel = '<span class="neutral label right">Denied Access</span>' %}
                {% else %}
                    {% set accessLevelLabel = '' %}
                {% endif %}
                {% for access in record.accessWithPermission|filter(access=>access.access == accessLevel) %}
                    {% if access.group is not empty %}

                        {# Pastoral Group Access #}

                        <li>
                            <div class="small-12 card wrap-down">
                                <div class="icon-teacher size-48" title="Pastoral Group"></div>
                                {{ accessLevelLabel | raw }}
                                {# Display link to group if the user is a pastoral moderator #}

                                {% set routeGetGroupModify = routeLookupIfAuthorized('pastoralManagement.getGroupsModify', {groupId: access.group.id}) %}
                                {% if routeGetGroupModify %}
                                    <a href="{{ routeGetGroupModify }}">
                                        <p>{{ access.group.name }}</p>
                                    </a>
                                {% else %}
                                    <p>{{ access.group.name }}</p>
                                {% endif %}

                                <p class="meta">Pastoral Group</p>

                                {# Display links to group members profiles #}

                                <p class="meta">
                                    {% for member in access.group.membersWithPermission %}
                                        {% if member.user.isDeleted() %}
                                            {{ member.user.fullName }}
                                            ({{ member.user.role.name }})<br>
                                        {% else %}
                                            <a href="{{ profile.link(member.user) }}">{{ member.user.fullName }}</a>
                                            ({{ member.user.role.name }})<br>
                                        {% endif %}
                                    {% endfor %}
                                </p>

                            </div>
                        </li>
                    {% elseif access.role is not empty %}
                        {# User Role Access #}

                        <li>
                            <div class="small-12 card wrap-down">
                                <div class="icon-group size-48" title="User Role"></div>
                                {{ accessLevelLabel | raw }}
                                {% if access.role.isParent and record.parentCommentsAllowed %}
                                    <span class="neutral label right">Comments</span>
                                {% endif %}
                                <p>{{ access.role.name }}</p>
                                {% if access.role.isParent %}
                                    {% for parent in record.student.parents %}
                                        {% if parent.isDeleted() or record.student.hideContacts %}
                                            {{ parent.fullName }}<br>
                                        {% else %}
                                            <a href="{{ profile.link(parent) }}">{{ parent.fullName }}</a><br>
                                        {% endif %}
                                    {% endfor %}
                                {% else %}
                                    <p class="meta">User Role</p>
                                {% endif %}
                            </div>
                        </li>
                    {% elseif access.roleType is not empty %}
                        {# User Role Type Access #}

                        <li>
                            <div class="small-12 card wrap-down">
                                {% if access.roleType == 'student' %}
                                    <a href="{{ profile.link(record.student) }}">
                                        {{ profile.imageSquare64(record.student) }}
                                        {% if record.studentCommentsAllowed %}
                                            <span class="neutral label right">Comments</span>
                                        {% endif %}
                                        {{ accessLevelLabel | raw }}
                                        <p>{{ record.student.fullName }}</p>
                                    </a>
                                    <p class="meta">Student</p>
                                {% elseif access.roleType == 'parent' %}
                                    <div class="icon-group size-48" title="User Role"></div>
                                    {{ accessLevelLabel | raw }}
                                    {% if record.parentCommentsAllowed %}
                                        <span class="neutral label right">Comments</span>
                                    {% endif %}
                                    <p>{{ access.roleType | capitalize }}</p>
                                    {% for parent in record.student.parents %}
                                        {% if parent.isDeleted() or record.student.hideContacts %}
                                            {{ parent.fullName }}<br>
                                        {% else %}
                                            <a href="{{ profile.link(parent) }}">{{ parent.fullName }}</a><br>
                                        {% endif %}
                                    {% endfor %}
                                {% else %}
                                    <div class="icon-group size-48" title="User Role"></div>
                                    {{ accessLevelLabel | raw }}
                                    <p>{{ access.roleType | capitalize }}</p>
                                {% endif %}
                            </div>
                        </li>
                    {% elseif access.user is not empty %}
                        {# Individual User Access #}

                        <li>
                            <div class="small-12 card wrap-down">
                                {% if access.user.isDeleted() %}
                                    {{ profile.imageSquare64(access.user) }}
                                    {{ accessLevelLabel | raw }}
                                    <p>
                                        {{ access.user.firstname }} {{ access.user.lastname }}
                                    </p>
                                    <p class="meta">
                                        {{ access.user.role.name }}
                                    </p>
                                {% else %}
                                    <a href="{{ profile.link(access.user) }}">
                                        {{ profile.imageSquare64(access.user) }}
                                        {{ accessLevelLabel | raw }}
                                        {% if access.user.role.isParent and record.parentCommentsAllowed %}
                                            <span class="neutral label right">Comments</span>
                                        {% endif %}
                                        <p>
                                            {{ access.user.firstname }} {{ access.user.lastname }}
                                        </p>
                                        <p class="meta">
                                            {{ access.user.role.name }}
                                        </p>
                                    </a>
                                {% endif %}
                            </div>
                        </li>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </ul>
    </section>
</div>
