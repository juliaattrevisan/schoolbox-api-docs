{% import '@pastoral/macros/profile.twig' as profile %}

<div class="list-item">
    <div class="small-12 island">
        <h2 class="subheader">
                {{ locale.pastoral.proper }} Profile
        </h2>
    </div>
</div>
<div class="row actions-small-2">
    {% if user.role.isStaff %}
        {% set routeRecordInsert = routeLookupIfAuthorized('pastoral.getStudentRecordInsertForm', {'studentId': student.id}) %}
        <nav>
            {% if routeRecordInsert %}<a href="{{ routeRecordInsert }}" class="icon-add" title="Add {{ locale.pastoral.proper }} Record"></a>{% endif %}
        </nav>
    {% endif %}
</div>

<div class="row">
    <div class="small-{% if countSummaryByMonth.recordCount > 0 %}6{% else %}12{% endif %} island">
        <section class="no-pad">
            <div class="profile content">
                <div class="row no-margin">
                    <div class="small-12 medium-2 columns no-pad">
                        <a href="{{ profile.link(student) }}"> {{ profile.imageSquare200(student) }}</a>
                    </div>
                    <div class="small-12 medium-10 columns no-pad">
                        <dl>
                            {# Display student name #}
                            <dt class="small-12 medium-3">Campus</dt>
                            <dd class="small-12 medium-9">{% for campus in student.campusCollection %}{{ campus.name }} {% endfor %}</dd>
                            <dt class="small-12 medium-3">Year Level</dt>
                            <dd class="small-12 medium-9">{{ student.year.name | default('Unknown') }}</dd>
                            <dt class="small-12 medium-3">House</dt>
                            <dd class="small-12 medium-9">{{ student.schoolhouse.house | default('Unknown') }}</dd>

                            {# Display links to students parents #}

                            {% if not student.hideContacts %}
                            {% for parent in student.parents %}
                                <dt class="small-12 medium-3">
                                    {% if loop.first %}
                                        Parents
                                    {% else %}
                                        &nbsp;
                                    {% endif %}
                                </dt>
                                <dd class="small-12 medium-9">
                                    <a href="{{ profile.link(parent) }}">{{ parent.fullName }}</a>
                                </dd>
                            {% endfor %}
                            {% endif %}
                        </dl>
                    </div>
                </div>
            </div>
        </section>
    </div>
    {% if countSummaryByMonth.recordCount > 0 %}
        {% include '@pastoral/student_section_summary_barchart.twig' with { countSummaryByMonth: countSummaryByMonth } %}
    {% endif %}
</div>
