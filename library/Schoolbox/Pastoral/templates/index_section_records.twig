{% import '@pastoral/macros/profile.twig' as profile %}

{% if recentDashboard | length or recentStudents | length %}

    <div class="small-12 medium-6 island">

        {# -------------------------------------------------------------------------------------------------- #}
        {# Display high priority records #}
        {# -------------------------------------------------------------------------------------------------- #}

        {% if recentDashboard is not empty %}
            <h2 class="subheader">Recently Updated Important Records</h2>
            <section>
                <ul class="information-list">
                    {% for record in recentDashboard %}
                        <li>
                            {% set recordLink = routeLookup('pastoral.getStudentRecord', {studentId: record.student.id, recordId: record.id}) %}
                            <div class="card small-12">
                                <a href="{{ profile.link(record.student) }}">
                                    {{ profile.imageSquare64(record.student) }}
                                </a>
                                <a href="{{ recordLink }}"><h3>{{ record.heading }}</h3></a>
                                <p class="meta">
                                    <a href="{{ profile.link(record.student) }}">
                                    {{ record.student.fullName }}
                                    </a>
                                </p>
                                <p class="meta">
                                    Last updated by <a href="{{ profile.link(record.modifiedByDisplay) }}">{{ record.modifiedByDisplay.fullName }}</a>
                                    <span title="{{ record.updatedAtDisplay.short }}">{{ record.updatedAtDisplay.relativeDay }}</span>
                                </p>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {# -------------------------------------------------------------------------------------------------- #}
        {# Display recently searched student records #}
        {# -------------------------------------------------------------------------------------------------- #}

        {% if recentStudents is not empty %}
            <h2 class="subheader">Recently Viewed Students</h2>
            <section>
                <ul class="information-list">
                    {% for student in recentStudents %}
                        <li>
                            <div class="card small-12">
                                <a href='{{ routeLookup('pastoral.getStudent', {studentId: student.id}) }}'
                                   title="View Profile">
                                    {{ profile.imageSquare64(student) }}
                                    <h3>{{ student.fullName }}</h3>
                                </a>
                                <p class="meta">{{ student.role.name }}</p>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </div>

{% endif %}