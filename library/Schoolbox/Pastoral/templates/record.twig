{% import '@pastoral/macros/profile.twig' as profile %}

{% if user.role.isStaff %}
    {% set routeIndex = routeLookup('pastoral.getIndex') %}
{% else %}
    {% set routeIndex = '#' %}
{% endif %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[locale.pastoralCare.proper, routeIndex],
[record.student.fullName, routeLookup('pastoral.getStudent', {studentId: record.student.id})],
[record.heading]
) }}

<div class="row">
    <div class="small-12 column">
        <h1>{{ locale.pastoral.proper }} Record</h1>
    </div>
</div>

<div class="row actions-small-2">
    <div class="list-item">
        <div class="small-12 island">
            <h2 class="subheader">{{ record.heading }}</h2>
        </div>
    </div>
    <nav>
        {% if user.role.isStaff %}

            {% set routeGetGroups = routeLookupIfAuthorized('pastoralManagement.getGroups') %}
            {% set routeRecordUpdate = routeLookupIfAuthorized('pastoral.getStudentRecordUpdateForm', {'studentId': record.student.id, 'recordId': record.id}) %}
            {% set routeRecordDelete = routeLookupIfAuthorized('pastoral.postRecordDelete', {recordId: record.id}) %}
            {% set routeReportBuilder = routeLookupIfAuthorized('pastoralReportBuilder.getIndex') %}

            {% if routeReportBuilder %}
                <a href="{{ routeReportBuilder }}" class="icon-result" title="{{ locale.pastoral.proper }} Report Builder"></a>
            {% endif %}

            {% if routeGetGroups %}
                <a href="{{ routeGetGroups }}" class="icon-group" title="Manage {{ locale.pastoral.proper }} Groups"></a>
            {% endif %}

            {% if linkedStudents | length %}
                <a href="#" class="icon-link" data-dropdown="linked-students" title="Linked Students"></a>
            {% endif %}

            {% if routeRecordDelete %}
                <a data-delete id="{{ record.id }}" class="icon-delete no-text" href="#" title="Delete"></a>
                <script>
                    $('[data-delete]').click(function (event) {
                        event.preventDefault();

                        $(this).confirmDialog({
                            text: 'Are you sure you want to delete this record?',
                            confirmEvent: function () {
                                $.post('{{ routeLookup('pastoral.postRecordDelete', {studentId: record.student.id, recordId: record.id }) }}'
                                ).done(function () {
                                    window.location.href = '{{ routeLookup('pastoral.getIndex', {studentId: record.student.id}) }}';
                                });
                            }
                        });
                    });
                </script>
            {% endif %}

            {% if routeRecordUpdate %}
                <a class="icon-modify no-text" href="{{ routeRecordUpdate }}" title="Modify"></a>
            {% endif %}
        </nav>

        {% if linkedStudents | length %}
            <ul class="f-dropdown" data-dropdown-content="" id="linked-students">
                <li class="separator">Students With Linked Records</li>
                {% for student in linkedStudents %}
                    <li>
                        <a href="{{ routeLookup('pastoral.getStudent', {studentId: student.student_id}) }}" class="icon-user">
                            {{ student.first_name }} {{ student.last_name }} ({{ student.count }})
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

    {% endif %}
</div>

{# Profile picture and misc details #}

<div class="row">
    <div class="small-12 island">
        <section class="no-pad">
            {% include '@pastoral/record_summary.twig' %}
        </section>
    </div>
</div>

{# Private body #}

{% include '@pastoral/record_body.twig' with { recordType: 'private' } %}
{% include '@pastoral/record_comments.twig' with { comments: commentsPrivate, recordType: 'private' } %}

{# Public body #}

{% include '@pastoral/record_body.twig' with { recordType: 'public' } %}
{% include '@pastoral/record_comments.twig' with { comments: commentsPublic, recordType: 'public' } %}

{# Only staff can ever see the other information things #}

{% if user.role.isStaff %}
    {% include '@pastoral/record_visibility.twig' %}
    {% include '@pastoral/record_revisions.twig' %}
    <div class="row">
        {% include '@pastoral/record_related.twig' %}
    </div>
{% endif %}
