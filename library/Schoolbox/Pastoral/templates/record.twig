{% import '@pastoral/macros/profile.twig' as profile %}

{% if user.role.isStaff %}
    {% set routeIndex = routeLookup('pastoral.getIndex') %}
{% else %}
    {% set routeIndex = '#' %}
{% endif %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[locale.pastoralCare.proper, routeIndex],
[record.student.fullName, routeLookup('pastoral.getStudent', {studentId: record.student.id})],
[record.heading]
) }}

<div class="row">
    <div class="small-12 column">
        <h1>{{ record.heading }}</h1>
    </div>
</div>

<div class="row actions-small-2">
    <div class="list-item">
        <div class="small-12 island">
            <h2 class="subheader">{{ record.student.fullName }}</h2>
        </div>
    </div>
    <nav>
        {% if user.role.isStaff %}
            {% set routeRecordUpdate = routeLookupIfAuthorized('pastoral.getStudentRecordUpdateForm', {'studentId': record.student.id, 'recordId': record.id}) %}
            {% set routeRecordDelete = routeLookupIfAuthorized('pastoral.postRecordDelete', {recordId: record.id}) %}

            {% if linkedStudents is defined and linkedStudents|length %}
                <sbx-pop-out content-id="linked-students">
                    <div slot="icon">
                        <svg
                            version="1.2"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 16 16"
                            width="16"
                            height="16"
                            aria-hidden="true"
                            focusable="false"
                            class="c-icon"
                        >
                            <path
                                d="m3 10c-0.5 0-1-0.5-1-1v-2c0-0.5 0.5-1 1-1h1 2.8c-0.4-1.2-1.5-2-2.8-2h-1c-1.6 0-3 1.3-3 3v2c0 1.6 1.4 3 3 3h1c1.3 0 2.4-0.8 2.8-2h-2.8z"
                            />
                            <path
                                d="m13 4h-1c-1.3 0-2.4 0.8-2.8 2h2.8 1c0.5 0 1 0.5 1 1v2c0 0.5-0.5 1-1 1h-1-2.8c0.4 1.2 1.5 2 2.8 2h1c1.7 0 3-1.4 3-3v-2c0-1.7-1.3-3-3-3z"
                            />
                            <path d="m12 8c0 0.6-0.4 1-1 1h-6c-0.6 0-1-0.4-1-1 0-0.6 0.4-1 1-1h6c0.6 0 1 0.4 1 1z" />
                        </svg>
                    </div>
                </sbx-pop-out>
            {% endif %}

            {% if routeRecordDelete %}
                <a data-delete id="{{ record.id }}" class="sbx-icon-only-button no-text" href="#" title="Delete" aria-label="Delete"><sbx-icon name="delete"></sbx-icon></a>
                <script>
                    $('[data-delete]').on('click', function (event) {
                        event.preventDefault();

                        $(this).confirmDialog({
                            text: 'Are you sure you want to delete this record?',
                            confirmLabel: 'Delete',
                            confirmEvent: function () {
                                $.post('{{ routeLookup('pastoral.postRecordDelete', {studentId: record.student.id, recordId: record.id }) }}'
                                ).done(function () {
                                    window.location.href = '{{ routeLookup('pastoral.getIndex', {studentId: record.student.id}) }}';
                                });
                            }
                        });
                    });
                </script>
            {% endif %}

            {% if routeRecordUpdate %}
                <a class="sbx-icon-only-button no-text" href="{{ routeRecordUpdate }}" title="Modify" aria-label="Modify"><sbx-icon name="modify"></sbx-icon></a>
            {% endif %}
        </nav>

        {% if linkedStudents is defined and linkedStudents|length %}
            <ul class="f-dropdown" data-dropdown-content="" id="linked-students">
                <li class="separator">Students With Related Records</li>
                {% for student in linkedStudents %}
                    <li>
                        <a href="{{ routeLookup('pastoral.getStudent', {studentId: student.student_id}) }}"><sbx-icon name="user"></sbx-icon>
                            {{ student.first_name }} {{ student.last_name }} ({{ student.count }})
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

    {% endif %}
</div>

{# Profile picture and misc details #}

<div class="row">
    <div class="small-12 island">
        <section class="no-pad">
            {% include '@pastoral/record_section_summary.twig' %}
        </section>
    </div>
</div>

{# Decide if you can see the Confidential area
 #}
{% set canSeeConfidential = access.private %}

<div class="row">
    <div class="small-12 island">
        <dl id="tabs" class="tabs" data-tab data-deep-link-smudge="true" data-deep-link="true">
            <dd><a id="panel-general" href="#panel-general" data-tab>General</a></dd>

            {% if canSeeConfidential %}
            <dd><a id="panel-confidential" href="#panel-confidential" data-tab>Confidential</a></dd>
            {% endif %}
        </dl>

        <script>
            $(function() {
                switch (window.location.hash) {
                    {% if canSeeConfidential %}
                    case '#panel-confidential':
                    {% endif %}
                    case '#panel-general':
                        $('[data-tab] a[href="'+window.location.hash+'"]').trigger('click');

                        break;

                    default:
                        $('[data-tab] a[href="#panel-general"]').trigger('click');
                        break;
                }
            });
        </script>

        <section class="tabs-content" data-tabs-content="tabs">
            <div class="content active" id="panel-general">
                {# General body #}
                {% include '@pastoral/record_section_body.twig' with { recordType: 'public' } %}
                {% include '@pastoral/record_section_comments.twig' with { comments: commentsPublic, recordType: 'public' } %}
            </div>

            {% if canSeeConfidential %}
            <div class="content" id="panel-confidential">
                {# Confidential body #}
                {% include '@pastoral/record_section_body.twig' with { recordType: 'private' } %}
                {% include '@pastoral/record_section_comments.twig' with { comments: commentsPrivate, recordType: 'private' } %}
            </div>
            {% endif %}
        </section>
    </div>
</div>

{# Only staff can ever see the other information things #}
{% if user.role.isStaff %}

    {# Record revision history #}
    {% include '@pastoral/record_section_revisions.twig' %}

    {# Visibility permissions#}

    {% include '@pastoral/record_section_visibility.twig' %}
    {% include '@pastoral/record_section_actions.twig' %}
    {% include '@pastoral/record_section_linked.twig' %}
{% endif %}
