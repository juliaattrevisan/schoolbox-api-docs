<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/select-all/attacher.select-all.js"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/chained/jquery.chained.min.js"></script>
{% autoescape('js') %}
<script type="text/javascript">
    $(function () {

        {# Setup ckEditor #}

        $.fn.alaressEditor();

        {# Pastoral Tag Selectize #}

        $('#tags').selectizeSelector({
            multiple: true,
            selectize: {

                {% if canCreate %}
                create: function (input) {
                    return {
                        id: input,
                        name: input
                    }
                },
                {% else %}
                create: false,
                {% endif %}
                preload: true,
                load: function(query, callback) {

                    /* This provides a preliminary list of suggestions for when selectize gets focus
                     * but there's no parameter upon which to search (initial conditions). This also
                     * happens to provide a list of filtered suggestions as you type using the optional
                     * $query var
                     */
                    $.ajax({
                        url: '/ajax/tags/pastoral',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: query }
                    }).done(function(result) {
                        callback(result)
                    }).fail(function() {
                        callback()
                    })
                }
            },
            value: [
                {% for tag in record.tags %}
                {'id': '{{ tag.name }}', 'name': '{{ tag.name }}'}{% if not loop.last %},{% endif %}
                {% endfor %}
            ]
        });

        {# Delete Button For Existing Records #}

        {% if record.id != '' %}

        $('[data-delete]').click(function (e) {
            e.preventDefault();

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this record?',
                confirmLabel: 'Delete',
                confirmEvent: function () {
                    $.post('{{ routeLookup('pastoral.postRecordDelete', {'studentId': record.student.id, 'recordId': record.id}) }}')
                        .done(function () {
                            window.location.href = '{{ routeLookup('pastoral.getIndex', {'studentId': record.student.id ? record.student.id : student.id}) }}';
                        });
                }
            });
        });

        {% endif %}

        {# Create Duplicate Record Selectize #}

        $('#duplicateIds').selectizeSelector({
            multiple: true,
            ajax: {
                url: '/ajax/user.php',
                type: 'GET',
                data: {
                    roleTypeID: 'student',
                    excludeID: '{{ record.student ? record.student.id : '' }}'
                },
                dataType: 'json'
            },
            value: {{ students | raw}}
        });

        {# Form Validation #}

        var form = $('form#pastoralForm');

        $.validator.addMethod("duplicateIdSelected", function () {
            return $('#duplicateIds').val() !== '';
        }, $.validator.format("You must select at least one student before you can proceed"));

        form.alaressValidate({
            ignore: ':disabled',
            rules: {
                'heading': {requiredNotBlank: true},
                'duplicateIds': {
                    'duplicateIdSelected': {{ record.student ? 'false' : 'true' }}
                },
            },

            messages: {
                'heading': {
                    required: 'You must enter a title before you can proceed',
                    requiredNotBlank: 'You must enter a title before you can proceed'
                }
            },

            submitHandler: function (form) {
                var button = $("[data-submit]");
                button.val('Saving, Please Wait');
                button.attr('disabled', 'true');

                {# Need to submit the form on timeout, otherwise the DOM doesn't update with new button label #}

                window.setTimeout(function() { form.submit(); }, 0);
            }
        });

        {# Chain Pastoral Type/Subtype Dropdowns #}

        $('#subtypeId').chained('#typeId');

        {# Update record permissions section #}

        updateVisibility();

        {# Display preloader #}

        $('#formPastoralPreloader').addClass('hide');
        $('#formPastoral').removeClass('hide');
        $('#formPastoralDelete').removeClass('hide');

        $("#typeId,#subtypeId").on('change', function() {
            loadAudience();
        });

        window.hasChanged = false;

        $('#table-permission').on('change', '[type=radio]', function () {
            window.hasChanged = true;
        });

        function loadAudience() {
            // Only load the audience defaults if the record does not yet have any access rules
            {% if record.access | length < 1 %}
                {% set noSubTypeVal = 0 %}
                //Only change between defaults if no other changes have been made
                if(window.hasChanged == false) {
                    //Remove all other rows
                    $("#permission-roles tr").remove();
                    $("#permission-users tr").remove();
                    $("#permission-groups tr").remove();

                    // Reset roles, users and groups to empty, they will updated below
                    window.rolesAdded = [];
                    window.usersAdded = [];
                    window.groupsAdded = [];
                    $('[data-role-add]').removeClass('hide');
                    $('[data-group-add]').removeClass('hide');
                    $("[data-reveal-id='modal-role']").removeAttr('disabled');

                    var typeId = $("#typeId").val();
                    var subtypeId = $("#subtypeId").val();
                    if(!subtypeId){
                        // Cast null (no selection) to '0' string
                        subtypeId = '{{ noSubTypeVal }}';
                    }

                    {% for audience in audiences %}
                        {% set subtype = audience.subtype %}
                        {% set type    = subtype is null ? audience.type : subtype.pastoralType %}

                        if ('{{ type.id }}' === typeId && '{{ subtype.id|default(noSubTypeVal) }}' === subtypeId) {
                            {% if audience.group %}
                            window.addGroup("{{ audience.group.id }}", "{{ audience.group.name }}", "{{ audience.access }}");
                            {% elseif audience.role %}
                            window.addRole("{{ audience.role.id }}", "{{ audience.role.name }}", "{{ audience.access}}");
                            {% elseif audience.user %}
                            window.modalUserAdded({
                                'id' : {{ audience.user.id }},
                                'first_name': "{{ audience.user.firstname }}",
                                'last_name': "{{ audience.user.lastname }}",
                                'role': "{{ audience.user.role.name }}",
                            }, "{{ audience.access}}");
                            {% endif %}
                        }
                    {% endfor %}

                    updateVisibility();
                }
            {% endif %}
        }

        loadAudience();
});
</script>
<script>
    $(function() {

        /* Sequential dependency on loadAudience()
         */
        const subtypesIndex = {{ subtypesIndex|json_encode|raw }};
        const typesIndex = {{ typesIndex|json_encode|raw }};

        /* Some convenient selectors
         */
        const typeDropdown = $('#typeId');
        const subtypeDropdown = $('#subtypeId');
        const generalTemplate = CKEDITOR.instances['body_public'];

        /* The template html that was most recently chosen
         */
        let lastTemplate = '';

        /* Whenever Subtype changes, see if the now-selected subtypeId is null
         * Decide which template to load
         */
        subtypeDropdown.on('change', function(event) {
            init(typeDropdown.val(), subtypeDropdown.val());
        });

        /* Also Initialise upon load
         */
        init(typeDropdown.val(), subtypeDropdown.val());

        /**
         * If this Type has a Subtype template, change to that
         * Otherwise see if there's a Type template
         *
         * For some reason these html chunks might have a preceding space
         */
        function init(typeVal, subtypeVal) {
            if (null !== subtypeVal) {

                /* If subtypeId != null, load its template html iff the General Template's
                 * current value is the same as the Subtype template or if the General
                 * Template's current value is empty string
                 */
                replaceTemplate($.trim(subtypesIndex[subtypeVal]));
            } else {

                /* If subtypeId == null, look at the parent typeId. load its template
                 * html iff the General Template's current value is the same as the
                 * Type template or if the General Template's current value is empty string
                 */
                replaceTemplate($.trim(typesIndex[typeVal]));
            }
        }


        /**
         * Put a Subtype template html into General
         *
         * @param template
         */
        function replaceTemplate(template) {
            /**
             * Normalizes spaces in the value: required for determining whether a
             * CKEditor's current value has meaningfully changed from its template.
             *
             * @param {String} value
             * @returns {String}
             */
            let normalizeSpace = function (value) {
                return $.trim(value.replace(/\s+/g, ' '));
            };
            let current = normalizeSpace(generalTemplate.getData());

            /* If the current data is the same as the template contents,
             * then you're safe to swap it to another template
             *
             * If the current data is empty, you can fill it with another template
             */
            if (current === '' || current === normalizeSpace(lastTemplate)) {
                generalTemplate.setData(template);
                lastTemplate = template;
            }
        }
    });
</script>
{% endautoescape %}

