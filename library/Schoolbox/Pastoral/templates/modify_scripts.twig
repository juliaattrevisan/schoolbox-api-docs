<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/select-all/attacher.select-all.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/chained/jquery.chained.min.js?v={{ config.site_version }}"></script>
{% autoescape('js') %}
<script type="text/javascript">
    $(function () {

        {# Setup ckEditor #}

        $.fn.alaressEditor($.alaressEditorConfigWithUserTokens({targetElements: $('#body_public')}));
        $.fn.alaressEditor($.alaressEditorConfigWithUserTokens({targetElements: $('#body_private')}));

        {# Pastoral Tag Selectize #}

        $('#tags').selectizeSelector({
            multiple: true,
            selectize: {

                {% if canCreate %}
                create: function (input) {
                    return {
                        id: input,
                        name: input
                    }
                },
                {% else %}
                create: false,
                {% endif %}
                preload: true,
                load: function(query, callback) {

                    /* This provides a preliminary list of suggestions for when selectize gets focus
                     * but there's no parameter upon which to search (initial conditions). This also
                     * happens to provide a list of filtered suggestions as you type using the optional
                     * $query var
                     */
                    $.ajax({
                        url: '{{ routeLookup('pastoral.searchTags') }}',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: query }
                    }).done(function(result) {
                        callback(result)
                    }).fail(function() {
                        callback()
                    })
                }
            },
            value: [
                {% for tag in record.tags %}
                {'id': '{{ tag.id }}', 'name': '{{ tag.name | escape('js') }}'},
                {% endfor %}
            ]
        });

        {# Pastoral Action Selectize #}
        {% if config.pastoral_action_enable %}

        let actionSelectize = $('#pastoral-actions').selectizeSelector({
            multiple: true,
            selectize: {
                create: false,
                placeholder: 'Search Actions',
                preload: true,
                persist: true,
                hideSelected: true,
                load: function (query, callback) {
                    $.ajax({
                        url: '{{ routeLookup('pastoral.getActions') }}',
                        type: 'GET',
                        dataType: 'json',
                        data: {
                            typeId: $("#typeId").val(),
                            subtypeId: $("#subtypeId").val()
                        },
                    }).done(function (result) {
                        callback(result)
                    }).fail(function () {
                        callback()
                    })
                }
            },
            value: [
                {% for recordAction in record.recordActions %}
                {{ recordAction.action | json_encode | raw }}{% if not loop.last %},{% endif %}
                {% endfor %}
            ]
        });

        {% endif %}

        {# Delete Button For Existing Records #}

        {% if record.id != '' %}

        $('[data-delete]').click(function (e) {
            e.preventDefault();

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this record?',
                confirmLabel: 'Delete',
                confirmEvent: function () {
                    $.post('{{ routeLookup('pastoral.postRecordDelete', {'studentId': record.student.id, 'recordId': record.id}) }}')
                        .done(function () {
                            window.location.href = '{{ routeLookup('pastoral.getIndex', {'studentId': record.student.id ? record.student.id : student.id}) }}';
                        });
                }
            });
        });

        {% endif %}

        {# Create Duplicate Record Selectize #}

        $('#duplicateIds').selectizeSelector({
            multiple: true,
            ajax: {
                url: '/ajax/user.php',
                type: 'GET',
                data: {
                    roleTypeID: 'student',
                    excludeID: '{{ record.student ? record.student.id : '' }}'
                },
                dataType: 'json'
            },
            value: {{ students | raw}}
        });

        {# Form Validation #}

        var form = $('form#pastoralForm');

        $.validator.addMethod("duplicateIdSelected", function () {
            return $('#duplicateIds').val() !== '';
        }, $.validator.format("You must select at least one student before you can proceed"));

        form.alaressValidate({
            ignore: ':disabled',
            rules: {
                'heading': {requiredNotBlank: true},
                'duplicateIds': {
                    'duplicateIdSelected': {{ record.student ? 'false' : 'true' }}
                },
            },

            messages: {
                'heading': {
                    required: 'You must enter a title before you can proceed',
                    requiredNotBlank: 'You must enter a title before you can proceed'
                }
            },

            submitHandler: function (form) {
                var button = $("[data-submit]");
                button.val('Saving, Please Wait');
                button.attr('disabled', 'true');

                {# Need to submit the form on timeout, otherwise the DOM doesn't update with new button label #}

                window.setTimeout(function() { form.submit(); }, 0);
            }
        });

        {# Chain Pastoral Type/Subtype Dropdowns #}

        $('#subtypeId').chained('#typeId');

        {# Update record permissions section #}

        updateVisibility();

        {# Display preloader #}

        $('#formPastoralPreloader').addClass('hide');
        $('#formPastoral').removeClass('hide');
        $('#formPastoralDelete').removeClass('hide');

        $("#typeId,#subtypeId").on('change', function() {
            loadAudience();
            updateActions();
        });

        window.hasChanged = false;

        $('#table-permission').on('change', '[type=radio]', function () {
            window.hasChanged = true;
        });

        function updateActions() {
            {% if config.pastoral_action_enable %}
            let typeId = $("#typeId").val();
            let subtypeId = $("#subtypeId").val();
            let currents = $('#pastoral-actions').val();

            $.ajax({
                url: '{{ routeLookup('pastoral.getActions') }}',
                type: 'GET',
                dataType: 'json',
                data: {'typeId': typeId, 'subtypeId': subtypeId}
            }).done(function (result) {
                if (actionSelectize[0] === 'undefined') {
                    return;
                }
                actionSelectize[0].selectize.clear();
                actionSelectize[0].selectize.clearOptions();
                actionSelectize[0].selectize.addOption([result]);
                let refreshOptions = false;
                currents.forEach(function (item) {
                            actionSelectize[0].selectize.addItem(item);
                            // If current selection is not in updated available actions, open new options
                            if ($('#pastoral-actions').val().indexOf(item) < 0) {
                                refreshOptions = true;
                            }
                        }
                );
                for (let i = 0; i < currents.length; i++) {
                }
                if (refreshOptions) {
                    actionSelectize[0].selectize.refreshOptions()
                }
            })
            {% endif %}
        }

        function loadAudience() {
            let prevLocked = $("#record-visibility-header").hasClass('icon-locked');
            let visibilityLocked;
            let typeId = $("#typeId").val();
            let subtypeId = $("#subtypeId").val();
            if (!subtypeId) {
                // Cast null (no selection) to '0' string
                subtypeId = '0';
                visibilityLocked = $('#typeId').find('option:selected').attr('data-visibility-locked') === '1';
            } else {
                visibilityLocked = $('#subtypeId').find('option:selected').attr('data-visibility-locked') === '1';
            }

            // changed to locked, force the new visibility
            // changed to unlocked with template, update with the template
            // changed to unlocked without template, leave the current selection, but make sure to unlock

            if (visibilityLocked) {
                $("#record-visibility-header").addClass('icon-locked');
                $("#visibility_empty_state").hide();
                $("#visibility_empty_state_locked").show();
            } else if (!prevLocked && window.hasChanged) {
                return;
            } else {
                $("#record-visibility-header").removeClass('icon-locked');
                $("#visibility_empty_state").show();
                $("#visibility_empty_state_locked").hide();
            }

            clearVisibility();
            {% for typeAudiences in audiences %}
            if ('{{ typeAudiences.typeId }}' === typeId && '{{ typeAudiences.subtypeId }}' === subtypeId) {
                {% for audience in typeAudiences.audiences %}
                {% if audience.group %}
                window.addGroup("{{ audience.group.id }}", "{{ audience.group.name }}", "{{ audience.access }}", visibilityLocked);
                {% endif %}
                {% if audience.role %}
                window.addRole("{{ audience.role.id }}", "{{ audience.role.name }}", "{{ audience.access }}", visibilityLocked);
                {% endif %}
                {% if audience.roleType %}
                window.addRole("role-type-{{ audience.roleType }}", "{{ audience.roleType | capitalize }}", "{{ audience.access }}", visibilityLocked);
                {% endif %}
                {% if audience.user %}
                window.modalUserAdded({
                    'id': {{ audience.user.id }},
                    'first_name': "{{ audience.user.firstname }}",
                    'last_name': "{{ audience.user.lastname }}",
                    'role': "{{ audience.user.role.name }}",
                }, "{{ audience.access }}", visibilityLocked);
                {% endif %}
                {% endfor %}
            }
            {% endfor %}
            // if unlocked remove locks
            if (prevLocked && !visibilityLocked) {
                applyLock(['roles', 'users', 'groups'], false);
            }
            updateVisibility();
        }

        {% if record.id > 0 %}
        window.hasChanged = true;
        {% endif %}
        loadAudience();
});
</script>
<script>
    $(function() {

        /* Sequential dependency on loadAudience()
         */
        const subtypesIndex = {{ subtypesIndex|json_encode|raw }};
        const subtypesIndexPrivate = {{ subtypesIndexPrivate|json_encode|raw }};
        const typesIndex = {{ typesIndex|json_encode|raw }};
        const typesIndexPrivate = {{ typesIndexPrivate|json_encode|raw }};

        /* Some convenient selectors
         */
        const typeDropdown = $('#typeId');
        const subtypeDropdown = $('#subtypeId');
        const generalTemplate = CKEDITOR.instances['body_public'];
        const confidentialTemplate = CKEDITOR.instances['body_private'];

        /* The template html that was most recently chosen
         */
        let lastTemplate = '';
        let lastTemplatePrivate = '';

        /* Whenever Subtype changes, see if the now-selected subtypeId is null
         * Decide which template to load
         */
        subtypeDropdown.on('change', function(event) {
            init(typeDropdown.val(), subtypeDropdown.val());
        });

        /* Also Initialise upon load
         */
        init(typeDropdown.val(), subtypeDropdown.val());

        /**
         * If this Type has a Subtype template, change to that
         * Otherwise see if there's a Type template
         *
         * For some reason these html chunks might have a preceding space
         */
        function init(typeVal, subtypeVal) {
            if (null !== subtypeVal) {

                /* If subtypeId != null, load its template html iff the General Template's
                 * current value is the same as the Subtype template or if the General
                 * Template's current value is empty string
                 * same above with the Confidential Templates
                 */
                replaceTemplate($.trim(subtypesIndex[subtypeVal]), $.trim(subtypesIndexPrivate[subtypeVal]));
            } else {

                /* If subtypeId == null, look at the parent typeId. load its template
                 * html iff the General Template's current value is the same as the
                 * Type template or if the General Template's current value is empty string
                 * same above with the Confidential Templates
                 */
                replaceTemplate($.trim(typesIndex[typeVal]), $.trim(typesIndexPrivate[typeVal]));
            }
        }


        /**
         * Put a Subtype template html into General and Confidential
         *
         * @param template
         * @param templatePrivate
         */
        function replaceTemplate(template, templatePrivate) {
            /**
             * Normalizes spaces in the value: required for determining whether a
             * CKEditor's current value has meaningfully changed from its template.
             *
             * @param {String} value
             * @returns {String}
             */
            let normalizeSpace = function (value) {
                return $.trim(value.replace(/\s+/g, ' '));
            };
            let current = normalizeSpace(generalTemplate.getData());
            let currentPrivate = normalizeSpace(confidentialTemplate.getData());

            /* If the current data is the same as the template contents,
             * then you're safe to swap it to another template
             *
             * If the current data is empty, you can fill it with another template
             */
            if (current === '' || current === normalizeSpace(lastTemplate)) {
                generalTemplate.setData(template);
                lastTemplate = template;
            }
            if (currentPrivate === '' || currentPrivate === normalizeSpace(lastTemplatePrivate)) {
                confidentialTemplate.setData(templatePrivate);
                lastTemplatePrivate = templatePrivate;
            }
        }
    });
</script>
{% endautoescape %}

