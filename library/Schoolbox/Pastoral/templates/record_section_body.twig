{% if recordType == 'public' %}
    {% set heading = "General Content" %}
    {% set body = record.bodyPublic %}
    {% set attachments = attachmentsPublic %}
{% elseif recordType == 'private' %}
    {% set heading = locale.pastoralPrivate.proper ~ " Content" %}
    {% set body = record.bodyPrivate %}
    {% set attachments = attachmentsPrivate %}
{% endif %}

{% if (recordType == 'public' and access.public) or (recordType == 'private' and access.private)  %}

    {% import '@pastoral/macros/profile.twig' as profile %}
    
    <div class="row">
        <div class="small-12 island">
            {% if access.private %}
                <h2 class="subheader">{{ heading }}</h2>
            {% endif %}

            {% if not (body is empty and attachments is empty) %}
                <section class="content">
                    {{ body | purify }}
                    {% if attachments | length %}
                        {% for attachment in attachments %}
                            {% set recordRoute = routeLookup('pastoral.getStudentRecordAttachment', { recordId: record.id, studentId: record.student.id, attachmentId: attachment.id }) %}
                            <div class="card small-12">
                                <a href="{{ recordRoute }}" target="_blank">
                                    {% if attachment.storage.mimetype.isImage %}
                                        <img src="/storage/image.php?hash={{ attachment.storage.hash }}&size=square64">
                                    {% else %}
                                        <img src="/ajax/mime/{{ attachment.storage.mime }}" alt="Attachment" class="mime {{ attachment.storage.mimetype }}"/>
                                    {% endif %}
                                    {{ attachment.storage.filename }}
                                </a>
                                <p class="meta">{{ attachment.storage.size | bytes }}</p>
                            </div>
                        {% endfor %}
                    {% endif %}
                </section>
            {% else %}
                {% set routeRecordUpdate = routeLookupIfAuthorized('pastoral.getStudentRecordUpdateForm', {'studentId': record.student.id, 'recordId': record.id}) %}
                <div class="empty-state">
                    <i class="icon-pastoral"></i>
                    <p>There is no content yet. {% if routeRecordUpdate %} <a href={{ routeRecordUpdate }}> Edit this pastoral record. </a> {% endif %}</p>
                </div>
            {% endif %}
        </div>
    </div>

{% endif %}
