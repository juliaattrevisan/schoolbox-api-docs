<h2 class="subheader">
    <i id="record-visibility-header" title="This type of record does not allow visibility to be adjusted"></i>Record Visibility
</h2>
<section id="visibility-section">

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# We need a guid for the user select modal #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    {% set guid = getGuid() %}

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# Display Current Visibility #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    <table class="no-margin" id="table-permission">
        <thead>
            <tr>
                <th class="small-2">Type</th>
                <th class="small-3">Audience</th>
                <th class="small-2">Deny</th>
                <th class="small-2">General</th>
                <th class="small-2">General + {{ locale.pastoralPrivate.proper }}</th>
                <th class="text-right small-1">Delete</th>
            </tr>
        </thead>
        {% include '@pastoral/modify_section_visibility_role.twig' %}
        {% include '@pastoral/modify_section_visibility_user.twig' %}
        {% include '@pastoral/modify_section_visibility_group.twig' %}
    </table>

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# Display Buttons #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    <div class="component-action">
        <section>
            {# Each user modal required a unique identifier, however Twig macros are incapable of returning a variable and thus #}
            {# we can't get it to just tell us what the unique identifier of the modal is. So we have to create it here and then #}
            {# pass it into the macro #}

            <a href="#" data-button="add-role" class="button" data-reveal-id="modal-role">Add Role</a>

            {% if allowIndividual %}
                <a href="#" data-button="add-user" class="button" data-user-search="{{ guid }}">Add User</a>
            {% endif %}

            {% if groups | length > 0 %}
                <a href="#" data-button="add-group" class="button" data-reveal-id="modal-group">Add Pastoral Group</a>
            {% endif %}
        </section>
    </div>

    <script>

        {# Update the visibility of permission tables #}

        function applyLock(perms, locked) {
            perms.forEach(
            function(element) {
                let permList = $('#permission-'+element);
                if (locked) {
                    $(permList).find('input[type=radio]').each(function () {
                        $(this).attr('readonly', 'readonly');
                    })
                    $(permList).find('label.radio-label').each(function () {
                        $(this).attr('for', $(this).attr('for') + '-locked');
                    })
                    $('.component-action').addClass('hide');
                    $('.icon-delete').addClass('hide');
                } else {
                    $(permList).find('input[type=radio]').each(function () {
                        $(this).removeAttr('readonly');
                    })
                    $(permList).find('label.radio-label').each(function () {
                        $(this).attr('for', $(this).attr('for').replace(/-locked/g, ''));
                    })
                    $('.component-action').removeClass('hide');
                    $('.icon-delete').removeClass('hide');
                }
            });
        }

        function clearVisibility() {
            //Remove all other rows
            $("#permission-roles tr").remove();
            $("#permission-users tr").remove();
            $("#permission-groups tr").remove();

            // Reset roles, users and groups to empty, they will updated below
            window.rolesAdded = [];
            window.usersAdded = [];
            window.groupsAdded = [];
            $('[data-role-add]').removeClass('hide');
            $('[data-group-add]').removeClass('hide');
            $("[data-reveal-id='modal-role']").removeAttr('disabled');

        }

        function updateVisibility() {

            var found = 0;

            {# Roles #}

            var tableRoles = $("#permission-roles");

            if (tableRoles.find('tr').length === 0) {
                tableRoles.addClass('hide');
            } else {
                tableRoles.removeClass('hide');
                found++;
            }

            {# Groups #}

            var tableGroups = $("#permission-groups");

            if (tableGroups.find('tr').length === 0) {
                tableGroups.addClass('hide');
            } else {
                tableGroups.removeClass('hide');
                found++;
            }

            {# Users #}

            var tableUsers = $("#permission-users");

            if (tableUsers.find('tr').length === 0) {
                tableUsers.addClass('hide');
            } else {
                tableUsers.removeClass('hide');
                found++;
            }

            {# Empty state if there are no permissions #}

            if (found === 0) {
                $('#visibility-section').addClass('hide');
                $('#visibility-empty').removeClass('hide');
            } else {
                $('#visibility-section').removeClass('hide');
                $('#visibility-empty').addClass('hide');
            }
        }

        updateVisibility();
    </script>

</section>

{% if not record.id %}
    {% set name = "you" %}
{% elseif record.owner is defined and USER.id != record.owner.id %}
    {% set name = "you" %}
{% else %}
    {% set name = record.owner.fullName ?? '' %}
{% endif %}

{# Empty state when no visibility rules #}

<div class="empty-state" id="visibility-empty">
    <i class="icon-locked"></i>
    {% include '@pastoral/modify_section_visibility_empty_state.twig' %}
</div>


{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
{# Cloneable HTML For Permission #}
{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
{% for accessType in ['user', 'group', 'role'] %}
    <table class="hide">
        <tbody data-{{ accessType }}-permission-clone>
        <tr data-{{ accessType }}-id="{ID}">
            <td class="small-2">{TYPE_NAME}</td>
            <td class="small-3">{FULL_NAME}</td>
            <td class="small-2">
                <input type="radio" name="{{ accessType }}[{ID}]" id="{{ accessType }}Deny{ID}" value="0">
                <label class="radio-label" for="{{ accessType }}Deny{ID}"></label>
            </td>
            <td class="small-2">
                <input type="radio" name="{{ accessType }}[{ID}]" id="{{ accessType }}Public{ID}" value="1">
                <label class="radio-label" for="{{ accessType }}Public{ID}"></label>
            </td>
            <td class="small-2">
                <input type="radio" name="{{ accessType }}[{ID}]" id="{{ accessType }}Private{ID}" value="2">
                <label class="radio-label" for="{{ accessType }}Private{ID}"></label>
            </td>
            <td class="text-right small-1">
                <a href="#" data-delete-visibility="{{ accessType }}" class="icon-delete"></a>
            </td>
        </tr>
        </tbody>
    </table>
{% endfor %}
