{#
    @param record
    @param allowIndividual
    @param groups
    @param allowParents
    @param roles: roles,
    @param roleTypes: roleTypes,
    @param roleUserCounts: roleUserCounts,
    @param rolesWithUsers: rolesWithUsers,
    @param moderatorIds: moderatorIds,
    @param bulkCreate: true, if creating from class page
    @param managePage
    @param reportPage
#}
<h2 class="subheader">
    {%- if reportPage -%}
        Shared Report
    {%- else -%}
    <i id="record-visibility-header" title="This type of record does not allow visibility to be adjusted"></i>Record Visibility
    {%- endif -%}
</h2>
<section id="visibility-section">

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# We need a guid for the user select modal #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    {% set guid = getGuid() %}

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# Display Current Visibility #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    <table class="no-margin" id="table-permission">
        <thead>
            <tr>
                <th class="small-1">Type</th>
                <th class="small-{{ reportPage ? 4 : 2 }}">Audience</th>
                {% if reportPage %}
                    <th class="small-3">Read</th>
                    <th class="small-3">Modify</th>
                {% else %}
                    <th class="small-2">Deny</th>
                    <th class="small-2">General</th>
                    <th class="small-2">General + {{ locale.pastoralPrivate.proper }}</th>
                    <th class="small-2">Match Campus<span class='hint has-tip tip-top' title="If checked, these users must be in the same campus as the student to access this record" data-tooltip>?</span></th>
                    <th class="small-1">Comments<span class='hint has-tip tip-top' title="If checked, these users will be able to read and post comments on this record" data-tooltip>?</span></th>
                {% endif %}
                <th class="text-right small-1">Delete</th>
            </tr>
        </thead>
        {%- if not reportPage %}
        {% include '@pastoral/modify_section_visibility_role.twig' %}
        {%- endif %}
        {% include '@pastoral/modify_section_visibility_user.twig' %}
        {% include '@pastoral/modify_section_visibility_group.twig' %}
    </table>

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# Display Buttons #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    <div class="component-action">
        <section>
            {# Each user modal required a unique identifier, however Twig macros are incapable of returning a variable and thus #}
            {# we can't get it to just tell us what the unique identifier of the modal is. So we have to create it here and then #}
            {# pass it into the macro #}

            {% if not reportPage %}
            <a href="#" data-button="add-role" class="button" data-reveal-id="modal-role">Add Role</a>
            {% endif %}

            {% if allowIndividual %}
                <a href="#" data-button="add-user" class="button" data-user-search="{{ guid }}">Add User</a>
            {% endif %}

            {% if groups | length > 0 %}
                <a href="#" data-button="add-group" class="button" data-reveal-id="modal-group">Add Pastoral Group</a>
            {% endif %}
        </section>
    </div>

    <script>

        {# Update the visibility of permission tables #}

        function applyLock(perms, locked) {
            perms.forEach(
            function(element) {
                let permList = $('#permission-'+element);
                if (locked) {
                    $(permList).find('input[type=radio]').each(function () {
                        $(this).attr('readonly', 'readonly');
                    })
                    $(permList).find('input[type=checkbox]').each(function () {
                        $(this).attr('readonly', 'readonly');
                    })
                    $(permList).find('label.radio-label').each(function () {
                        $(this).attr('for', $(this).attr('for') + '-locked');
                    })
                    $('.component-action').addClass('hide');
                    $('table#table-permission .icon-delete').addClass('hide');
                } else {
                    $(permList).find('input[type=radio]').each(function () {
                        $(this).removeAttr('readonly');
                    })
                    $(permList).find('input[type=checkbox] [data-always-read-only="1"]').each(function () {
                        $(this).removeAttr('readonly');
                    })
                    $(permList).find('label.radio-label').each(function () {
                        $(this).attr('for', $(this).attr('for').replace(/-locked/g, ''));
                    })
                    $('.component-action').removeClass('hide');
                    $('table#table-permission .icon-delete').removeClass('hide');
                }
            });
        }

        function clearVisibility() {
            //Remove all other rows
            $("#permission-roles tr").remove();
            $("#permission-users tr").remove();
            $("#permission-groups tr").remove();

            // Reset roles, users and groups to empty, they will updated below
            window.rolesAdded = [];
            window.usersAdded = [];
            window.groupsAdded = [];
            $('[data-role-add]').removeClass('hide');
            $('[data-group-add]').removeClass('hide');
            $("[data-reveal-id='modal-role']").removeAttr('disabled');

        }

        function updateVisibility() {

            let found = 0;

            {# Roles #}

            let tableRoles = $("#permission-roles");

            if (tableRoles.find('tr').length === 0) {
                tableRoles.addClass('hide');
            } else {
                tableRoles.removeClass('hide');
                found++;
            }

            {# Groups #}

            let tableGroups = $("#permission-groups");

            if (tableGroups.find('tr').length === 0) {
                tableGroups.addClass('hide');
            } else {
                tableGroups.removeClass('hide');
                found++;
            }

            {# Users #}

            let tableUsers = $("#permission-users");

            if (tableUsers.find('tr').length === 0) {
                tableUsers.addClass('hide');
            } else {
                tableUsers.removeClass('hide');
                found++;
            }

            {# Empty state if there are no permissions #}

            if (found === 0) {
                $('#visibility-section').addClass('hide');
                $('#visibility-empty').removeClass('hide');
            } else {
                $('#visibility-section').removeClass('hide');
                $('#visibility-empty').addClass('hide');
            }
        }

        /**
         * @param targetCheckbox element - Checkbox element
         * @param alwaysReadOnly bool - Whether always read only - true for staff
         * @param isChecked bool - Whether it's checked
         * @param permission int - Deny, General, General + Confidential
         */
        function initCheckbox(targetCheckbox, alwaysReadOnly, isChecked, permission)
        {
            let targetCheckboxLabel = $("label[for='" + targetCheckbox.attr('id') +"']");
            if (alwaysReadOnly) {
                targetCheckbox.attr('checked', 'checked');
                targetCheckbox.attr('readonly', 'readonly');
                targetCheckbox.attr('data-always-read-only', 1);
                if (permission === '0') {
                    targetCheckbox.hide();
                    targetCheckboxLabel.hide();
                }
            } else {
                if (isChecked) {
                    targetCheckbox.attr('checked', 'checked');
                }
                targetCheckbox.attr('data-always-read-only', 0);
                if (permission === '0') {
                    targetCheckbox.prop('checked', false);
                    targetCheckbox.hide();
                    targetCheckboxLabel.hide();
                }
            }
        }

       {# There is an annoying glitch that clicking a checkbox doesn't actually update the 'checked' markup #}
       {# and so when we add a new role to the table some Javascript somewhere goes and updates the state #}
       {# of the radio buttons to whichever value was 'checked' on page load. So, we need to update the #}
       {# check attribute in the DOM for all radio buttons in the clicked group #}
        function setRadioButtonListener (row) {
            $(row).find('.radio-label').on('click', function () {
                let clickedElement = $("#" + $(this).attr('for'));
                let elementName = clickedElement.attr('name');
                let radioGroupSelector = 'input[name*="' + elementName + '"]';
                {# Uncheck all radio buttons in the group #}
                $(radioGroupSelector).removeAttr('checked');
                {# Check the one that was clicked #}
                clickedElement.attr('checked', 'true');
                // hide checkboxes for denied permission
                clickedElement.closest('tr').find('.checkbox-label').each(
                        function () {
                            if ($(this).attr('for') === 'roleCampusrole-type-student'
                                    || $(this).attr('for') === 'roleCampusrole-type-parent') {
                                return;
                            }
                            let checkbox = $('#' + $(this).attr('for'));
                            if (clickedElement.val() === '0') {
                                $(this).hide();
                                if (checkbox.attr('data-always-read-only') === '0') {
                                    checkbox.prop('checked', false);
                                }
                            } else {
                                $(this).show();
                                if ($(this).hasClass('hide')) {
                                    $(this).removeClass('hide');
                                }
                            }
                        }
                )
            });
        }

        setRadioButtonListener('#table-permission');
        updateVisibility();
    </script>

</section>

{% if not record.id %}
    {% set name = "you" %}
{% elseif record.owner is defined and USER.id != record.owner.id %}
    {% set name = "you" %}
{% else %}
    {% set name = record.owner.fullName ?? '' %}
{% endif %}

{# Empty state when no visibility rules #}

<div class="empty-state" id="visibility-empty">
    <i class="icon-locked"></i>
    {% if reportPage %}
        {% include '@pastoral/modify_section_visibility_empty_state_report.twig' %}
    {% else %}
        {% include '@pastoral/modify_section_visibility_empty_state.twig' %}
    {% endif %}
</div>


{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
{# Cloneable HTML For Permission #}
{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
{% set colsize = reportPage ? 3 : 2 %}
{% set accessTypes = reportPage ? ['user', 'group'] : ['user', 'group', 'role'] %}
{% for accessType in accessTypes %}
    <table class="hide">
        <tbody data-{{ accessType }}-permission-clone>
        <tr data-{{ accessType }}-id="{ID}">
            <td class="small-1">{TYPE_NAME}</td>
            <td class="small-{{ reportPage ? 4 : 2 }}">{NAME}</td>
            {% if not reportPage %}
            <td class="small-{{ colsize }}">
                <input type="radio" name="{{ accessType }}[{ID}]" id="{{ accessType }}Deny{ID}" value="0">
                <label class="radio-label" for="{{ accessType }}Deny{ID}"></label>
            </td>
            {% endif %}
            <td class="small-{{ colsize }}">
                <input type="radio" name="{{ accessType }}[{ID}]" id="{{ accessType }}Public{ID}" value="1">
                <label class="radio-label" for="{{ accessType }}Public{ID}"></label>
            </td>
            <td class="small-{{ colsize }}">
                <input type="radio" name="{{ accessType }}[{ID}]" id="{{ accessType }}Private{ID}" value="2">
                <label class="radio-label" for="{{ accessType }}Private{ID}"></label>
            </td>
            {% if not reportPage %}
            <td class="small-1 checklist">
                {% if accessType == 'user' %}
                    <input type="hidden" name="{{ accessType }}Campus{ID}" id="{{ accessType }}Campus{ID}" value="0">
                {% else %}
                    <input type="checkbox" name="{{ accessType }}Campus{ID}" id="{{ accessType }}Campus{ID}" value="1">
                    <label class="checkbox-label" for="{{ accessType }}Campus{ID}"></label>
                {% endif %}
            </td>
            <td class="small-1 checklist">
                <input type="checkbox" name="{{ accessType }}Comment{ID}" id="{{ accessType }}Comment{ID}" value="1">
                <label class="checkbox-label" for="{{ accessType }}Comment{ID}"></label>
            </td>
            {% endif %}
            <td class="text-right small-1">
                <a href="#" data-delete-visibility="{{ accessType }}" class="icon-delete"></a>
            </td>
        </tr>
        </tbody>
    </table>
{% endfor %}
