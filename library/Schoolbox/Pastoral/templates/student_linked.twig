{% import '@pastoral/macros/profile.twig' as profile %}
{% import '@pastoral/macros/paginator.twig' as paginator %}

{# Breadcrumbs #}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ locale.pastoralCare.proper,              routeLookup('pastoral.getIndex') ],
[ student.fullName,      routeLookup('pastoral.getStudent', {studentId: student.id}) ],
[ 'Linked Records - ' ~ linkedStudent.fullName ]
) }}

<div class="row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ student.fullName }} - Linked Records - {{ linkedStudent.fullName }}</h1>
        </div>
    </div>
</div>
<div class="row actions-small-2">
    <div class="list-item">
        <div class="small-12 island">
            <h2 class="subheader">{{ locale.pastoral.proper }} Profile</h2>
        </div>
    </div>
    {% if user.role.isStaff %}
        <nav>
            {% set routeGetGroups = routeLookupIfAuthorized('pastoralManagement.getGroups') %}
            {% set routeRecordInsert = routeLookupIfAuthorized('pastoral.getStudentRecordInsertForm', {'studentId': record.student.id}) %}
            {% set routeReportBuilder = routeLookupIfAuthorized('pastoralReportBuilder.getIndex') %}

            {% if routeReportBuilder %}<a href="{{ routeReportBuilder }}" class="icon-result" title="{{ locale.pastoral.proper }} Report Builder"></a>{% endif %}
            {% if routeGetGroups %}<a href="{{ routeGetGroups }}" class="icon-group" title="Manage {{ locale.pastoral.proper }} Groups"></a>{% endif %}
            {% if linkedStudents | length %}<a href="#" class="icon-link" data-dropdown="linked-students" title="Linked Students"></a>{% endif %}
            {% if routeRecordInsert %}<a href="{{ routeRecordInsert }}" class="icon-add" title="Add {{ locale.pastoral.proper }} Record"></a>{% endif %}
        </nav>
        {% if linkedStudents | length %}
            <ul class="f-dropdown" data-dropdown-content="" id="linked-students">
                <li class="separator">Students With Linked Records</li>
                {% for linkedStudent in linkedStudents %}
                    <li>
                        <a href="{{ routeLookup('pastoral.getLinked', {studentId: student.id, linkedStudentId: linkedStudent.student_id }) }}"
                           class="icon-user">
                            {{ linkedStudent.first_name }} {{ linkedStudent.last_name }} ({{ linkedStudent.count }})
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}
</div>

{% include '@pastoral/student_details.twig' with { student: student } %}
{% include '@pastoral/student_filter.twig' %}

{# Empty State #}

<div id="emptyState" class="row{% if records | length %} hide{% endif %}">
    <div class="small-12 column">
        <div class="empty-state">
            <i class="icon-pastoral"></i>
            <p>There are no linked {{ locale.pastoral }} records {% if typeSelected is not empty %}of this type{% endif %} between {{ student.fullName }} and {{ linkedStudent.fullName }}.</p>
            {% set routeGetStudentRecordInsertForm = routeLookupIfAuthorized('pastoral.getStudentRecordInsertForm', {'studentId': student.id}) %}
            {% if routeGetStudentRecordInsertForm %}
                <p>
                    You can <a href="{{ routeGetStudentRecordInsertForm }}">create a new {{ locale.pastoral }} record</a> now
                    {% if typeSelected is not empty %}
                        or
                        <a href="{{ routeLookup('pastoral.getLinked', {'studentId': student.id, 'linkedStudentId': linkedStudent.id}) }}">
                            remove your {{ locale.pastoral }} type filter
                        </a>
                    {% endif %}
                </p>
            {% endif %}
        </div>
    </div>
</div>

{# Check if there were any records to display #}

{% if records | length %}

    {# Display all pastoral records #}

    <div class="row" id="pastoralRecords">
        <div class="small-12 island">

            <h2 class="subheader">
                {{ locale.pastoralCare.proper }} Records Linked With {{ linkedStudent.fullName }}
                <span class="hide-for-medium-down right">
                    {{ paginator.text(pageCurrent, recordCount) }}
                </span>
            </h2>

            <section>
                <ul class="information-list">
                    {% for record in records %}

                        <li data-record-type="{{ record.type.id }}" class="actions-small-2"
                            id="pastoral-{{ record.id }}">
                            <div class="list-item">
                                <div class="card small-12">

                                    <a href="{{ routeLookup('pastoral.getStudentRecord', {'studentId': student.id, 'recordId': record.id}) }}">
                                        {{ profile.imageSquare64(record.owner) }}
                                        <h3>{{ record.heading }}</h3>
                                    </a>

                                    {# Display name of poster #}

                                    <p class="meta">
                                        Posted by
                                        <a href="{{ _self.userProfileLink(record.owner) }}">{{ record.owner.fullName }}</a>
                                        {{ record.createdAt.short }}
                                    </p>

                                    {# Display linked students to staff #}
                                    {% if user.role.isStaff and record.relatedRecords|length %}
                                        <p class="meta">
                                            Linked Records:
                                            {% for relatedRecord in record.relatedRecords %}
                                                <a
                                                href="{{ routeLookup('pastoral.getStudentRecord', {studentId: relatedRecord.student.id, 'recordId': relatedRecord.id}) }}">{{ relatedRecord.student.fullName }}</a>{% if not loop.last %},{% endif %}
                                            {% endfor %}
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                            <nav>
                                {# Modify record #}

                                {% set routeGetStudentRecordUpdateForm = routeLookupIfAuthorized('pastoral.getStudentRecordUpdateForm', {'studentId': record.student.id, 'recordId': record.id}) %}
                                {% if routeGetStudentRecordUpdateForm %}
                                    <a class="icon-modify no-text" href="{{ routeGetStudentRecordUpdateForm }}"
                                       title="Modify"></a>
                                {% endif %}

                                {# Delete record #}

                                {% if isRouteAuthorized('pastoral.postRecordDelete', {recordId: record.id}) %}
                                    <a data-delete id="{{ record.id }}" class="icon-delete no-text" href="#"
                                       title="Delete"></a>
                                {% endif %}
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            </section>

            <div class="right">
                {{ paginator.buttons(pageCurrent, recordCount) }}
            </div>
        </div>
    </div>

    {# Delete pastoral record #}

    <script type="text/javascript">
        $(function () {
            $('[data-delete]').click(function (e) {
                e.preventDefault();
                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this record?',
                    confirmEvent: function () {
                        $('#deletePastoralId').val();
                        $('#deletePastoralForm').attr('action', '{{ routeLookup('pastoral.postRecordDelete', {recordId: '_recordId'}) }}'.replace(/_recordId/g, e.target.id));
                        $('#deletePastoralForm').submit();
                    }
                });
            });
        });
    </script>

    <form id="deletePastoralForm" method="post" class="hide"></form>

{% endif %}
