{% import '@pastoral/macros/profile.twig' as profile %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ locale.pastoralCare.proper, routeLookup('pastoral.getIndex') ],
[ 'Search Results' ]
) }}

<div class="row">
    <div class="list-item">
        <div class="small-12 island">

            <h1>Search {{ locale.pastoral.proper }} Records</h1>

            <h2 class="subheader">Search Results</h2>
            {% include '@pastoral/search_field.twig' with {'search': search} %}

            {# ------------------------------------------------------------------------------------------------------ #}
            {# Ensure Minimum Length Of Search #}
            {# ------------------------------------------------------------------------------------------------------ #}

            {% if search | length >= minimumSearchLength %}

                {# ------------------------------------------------------------------------------------------------------ #}
                {# Show Matching Pastoral Records #}
                {# ------------------------------------------------------------------------------------------------------ #}

                <h2 class="subheader">Matching {{ locale.pastoral.proper }} Records</h2>

                {% if results | length %}
                    {% include "@pastoral/search_results_records.twig" %}
                {% else %}
                    {% include "@pastoral/search_results_records_empty.twig" %}
                {% endif %}

                {# ------------------------------------------------------------------------------------------------------ #}
                {# Show Matching Students #}
                {# ------------------------------------------------------------------------------------------------------ #}

                <h2 class="subheader">Matching Students</h2>

                {% if students | length %}
                    {% include "@pastoral/search_results_students.twig" %}
                {% else %}
                    {% include "@pastoral/search_results_students_empty.twig" %}
                {% endif %}
            {% else %}
                {% include "@pastoral/search_results_error_short.twig" %}
            {% endif %}
        </div>
    </div>
</div>
