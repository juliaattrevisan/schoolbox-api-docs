{% import '@pastoral/macros/profile.twig' as profile %}
{% import '@pastoral/macros/paginator.twig' as paginator %}

{# Breadcrumbs #}

{% if user.role.isStaff %}
    {% set routeIndex = routeLookup('pastoral.getIndex') %}
{% else %}
    {% set routeIndex = '#' %}
{% endif %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ locale.pastoralCare.proper, routeIndex ],
[ student.fullName ]
) }}

<div class="row">
    <div class="button-action small-12 columns">
        <h1>{{ student.fullName }}</h1>
        {% if user.role.isStaff %}
            {% set routeRecordInsert = routeLookupIfAuthorized('pastoral.getStudentRecordInsertForm', {'studentId': student.id}) %}

            {% if routeRecordInsert %}<a href="{{ routeRecordInsert }}" class="button sbx-button--has-icon" title="Create {{ locale.pastoral.proper }} Record"><sbx-icon name="add"></sbx-icon>Create {{ locale.pastoral.proper }} Record</a>{% endif %}

        {% endif %}
    </div>
</div>

{% include '@pastoral/student_section_summary.twig' with { student: student, countSummaryByMonth: countSummaryByMonth } %}
{% include '@pastoral/student_section_filter.twig' %}
{% include '@pastoral/student_section_records.twig' with { linkedStudent: null }%}
