{% import '@pastoral/macros/profile.twig' as profile %}
{% import '@pastoral/macros/paginator.twig' as paginator %}

{% if records | length %}

    {# Display all pastoral records #}

    <div class="row" id="pastoralRecords">
        <div class="small-12 island">

            {% if user.role.isStaff %}
                <h2 class="subheader">
                    {% if linkedStudent %}
                        Related {{ locale.pastoral.proper }} Records
                    {% else %}
                        {{ locale.pastoral.proper }} Records
                    {% endif %}

                    <span class="hide-for-medium-down right">{{ paginator.text(pageCurrent, recordCount) }}</span>
                </h2>
            {% endif %}

            <section>
                <ul class="information-list">
                    {% for record in records %}
                        <li data-record-type="{{ record.type.id }}" class="actions-small-2" id="pastoral-{{ record.id }}">
                            <div class="list-item">
                                <div class="card small-12 wrap-down">
                                    <a href="{{ profile.link(record.owner) }}">
                                        {{ profile.imageSquare64(record.owner) }}
                                    </a>

                                    {% set studentId = student.id %}
                                    {% set recordId = record.id %}

                                    <a href="{{ routeLookup('pastoral.getStudentRecord', {'studentId': studentId, 'recordId': recordId}) }}">
                                        <h3>{{ record.heading }}</h3>
                                    </a>
                                    <p class="meta">

                                    {% if linkedStudent %}

                                        {% for linkedRecord in record.relatedRecords %}


                                            {% if linkedRecord.parent.id is empty %}
                                                Original Record:
                                                {% set headingCurrent = linkedRecord.heading %}
                                            {% else %}
                                                Related Record:
                                                {% set headingCurrent = record.heading %}
                                            {% endif %}

                                            <a href="{{ routeLookup('pastoral.getStudentRecord', {'studentId': linkedRecord.student.id, 'recordId': linkedRecord.id}) }}"> {{ linkedRecord.student.fullName }} - {{ headingCurrent }}</a><br>
                                        {% endfor %}

                                    {% endif %}

                                    {# Display name of poster #}
                                        Created by
                                        {% if record.owner.deletedAt.isNull %}
                                            <a href="{{ profile.link(record.owner) }}">{{ record.owner.fullName }}</a>
                                        {% else %}
                                            {{ record.owner.fullName }}
                                        {% endif %}
                                        <span title="{{ record.createdAt.short }}"> {{ record.createdAt.relativeDay }}</span>
                                    {# Display last updated by if applicable #}
                                    {% if record.createdAt.long != record.updatedAtDisplay.long %}
                                        last updated by
                                        {% if record.modifiedByDisplay.deletedAt.isNull %}
                                            <a href="{{ profile.link(record.modifiedByDisplay) }}">{{ record.modifiedByDisplay.fullName }}</a>
                                        {% else %}
                                            {{ record.modifiedByDisplay.fullName }}
                                        {% endif %}
                                        <span title="{{ record.updatedAtDisplay.short }}">{{ record.updatedAtDisplay.relativeDay }}</span><br>
                                    {% endif %}


                                    {% if not linkedStudent %}
                                        {# Display linked students to staff #}
                                        {% if user.role.isStaff and record.relatedRecords | length %}
                                            {% for relatedRecord in record.relatedRecords %}
                                                {% if relatedRecord.student.id != student.id and relatedRecord.student.id != linkedStudent.id %}
                                                    {% set getStudentRecord = routeLookupIfAuthorized('pastoral.getStudentRecord', {studentId: relatedRecord.student.id, 'recordId': relatedRecord.id}) %}
                                                    {% if getStudentRecord %}
                                                        Related Record:
                                                        <a href="{{ getStudentRecord }}">{{ relatedRecord.heading }}</a> (<a href="{{ profile.link(relatedRecord.student) }}">{{ relatedRecord.student.fullName }}</a>)
                                                        <br>
                                                    {% endif %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    {% endif %}
                                    </p>
                                </div>
                            </div>
                            {% if not linkedStudent %}
                                <nav>
                                    {# Modify record #}

                                    {% set routeRecordUpdate = routeLookupIfAuthorized('pastoral.getStudentRecordUpdateForm', {'studentId': record.student.id, 'recordId': record.id}) %}
                                    {% if routeRecordUpdate %}
                                        <a class="icon-modify no-text" href="{{ routeRecordUpdate }}" title="Modify"></a>
                                    {% endif %}

                                    {# Delete record #}

                                    {% if isRouteAuthorized('pastoral.postRecordDelete', {recordId: record.id}) %}
                                        <a data-delete id="{{ record.id }}" class="icon-delete no-text" href="#" title="Delete"></a>
                                    {% endif %}
                                </nav>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
            <div class="right">
                {{ paginator.buttons(pageCurrent, recordCount, resultsPerPage, pagesToDisplay, typeSelected) }}
            </div>
        </div>
    </div>

    {# Delete pastoral record #}

    <script type="text/javascript">
        $(function () {
            $('[data-delete]').click(function (e) {
                e.preventDefault();
                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this record?',
                    confirmLabel: 'Delete',
                    confirmEvent: function () {
                        $('#deletePastoralId').val();
                        $('#deletePastoralForm').attr('action', '{{ routeLookup('pastoral.postRecordDelete', {recordId: '_recordId'}) }}'.replace(/_recordId/g, e.target.id));
                        $('#deletePastoralForm').submit();
                    }
                });
            });
        });
    </script>
    <form id="deletePastoralForm" method="post" class="hide"></form>

{% endif %}

{# Empty State #}

<div id="emptyState" class="row{% if records | length %} hide{% endif %}">
    <div class="small-12 column">
        <div class="empty-state">
            <i class="icon-pastoral"></i>
            <p>There are no {{ locale.pastoral }} records {% if typeSelected is not empty %}of this type{% endif %} available for {{ student.fullName }}.</p>
            {% set routeRecordInsert = routeLookupIfAuthorized('pastoral.getStudentRecordInsertForm', {'studentId': student.id}) %}
            {% if routeRecordInsert %}
                <p>
                    You can <a href="{{ routeRecordInsert }}">create a new {{ locale.pastoral }} record</a> now
                    {% if typeSelected is not empty %}
                        or <a href="{{ routeLookup('pastoral.getStudent', {'studentId': student.id}) }}">remove your {{ locale.pastoral }} type filter</a>
                    {% endif %}
                </p>
            {% endif %}
        </div>
    </div>
</div>
