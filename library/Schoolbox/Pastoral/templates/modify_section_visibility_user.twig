{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
{# Individual Users Access #}
{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

{% if allowIndividual %}

    <table class="no-margin" id="table-permission-users">
        <thead>
            <tr>
                <th class="small-5">Users</th>
                <th class="small-2"></th>
                <th class="small-2"></th>
                <th class="small-2"></th>
                <th class="small-1"></th>
            </tr>
        </thead>
        <tbody id="permission-users">
            {% set countUsers = 0 %}

            {% for access in record.access if access.user.id != '' %}

                {# Work out which radio should be checked for each row#}

                {% set checkedDeny = '' %}
                {% set checkedPublic = '' %}
                {% set checkedPrivate = '' %}

                {% if record.id != '' %}
                    {% for userAccess in record.access if access.user.id != '' %}
                        {% if userAccess.user.id == access.user.id %}
                            {% if userAccess.private == 1 %}
                                {% set checkedPrivate = 'checked' %}
                            {% else %}
                                {% set checkedPublic = 'checked' %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% if checkedPublic == '' and checkedPrivate == '' %}
                    {% set checkedDeny = 'checked' %}
                {% endif %}

                <tr data-user-id="{{ access.user.id }}">
                    <td class="small-5">{{ access.user.firstname }} {{ access.user.lastname }} ({{ access.user.role.name }})</td>
                    <td class="small-2">
                        <input type="radio" name="user[{{ access.user.id }}]" id="userDeny{{ access.user.id }}" value="0" {{ checkedDeny }}>
                        <label class="radio-label" for="userDeny{{ access.user.id }}"></label>
                    </td>
                    <td class="small-2">
                        <input type="radio" name="user[{{ access.user.id }}]" id="userPublic{{ access.user.id }}" value="1" {{ checkedPublic }}>
                        <label class="radio-label" for="userPublic{{ access.user.id }}"></label>
                    </td>
                    <td class="small-2">
                        <input type="radio" name="user[{{ access.user.id }}]" id="userPrivate{{ access.user.id }}" value="2" {{ checkedPrivate }}>
                        <label class="radio-label" for="userPrivate{{ access.user.id }}"></label>
                    </td>
                    <td class="small-1">
                        <a href="#" data-delete-visibility="user" class="icon-delete"></a>
                    </td>
                </tr>
                {% set countUsers = countUsers + 1 %}
            {% endfor %}
        </tbody>
    </table>

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# Cloneable HTML For Individual User Permission #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    <table class="hide">
        <tbody data-user-permission-clone>
        <tr data-user-id="{ID}">
            <td class="small-5">{NAME} ({ROLE})</td>
            <td class="small-2">
                <input type="radio" name="user[{ID}]" id="userDeny{ID}" value="0" checked>
                <label class="radio-label" for="userDeny{ID}"></label>
            </td>
            <td class="small-2">
                <input type="radio" name="user[{ID}]" id="userPublic{ID}" value="1">
                <label class="radio-label" for="userPublic{ID}"></label>
            </td>
            <td class="small-2">
                <input type="radio" name="user[{ID}]" id="userPrivate{ID}" value="2">
                <label class="radio-label" for="userPrivate{ID}"></label>
            </td>
            <td class="small-1">
                <a href="#" data-delete-visibility="user" class="icon-delete"></a>
            </td>
        </tr>
        </tbody>
    </table>

{% endif %}
