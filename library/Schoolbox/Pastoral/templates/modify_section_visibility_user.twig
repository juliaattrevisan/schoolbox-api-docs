{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
{# Individual Users Access #}
{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

{% if allowIndividual %}

    {% import '@pastoral/macros/user_search.twig' as userSearch %}

    <tbody id="permission-users">

        {% if record.id != '' %}

            {% set countUsers = 0 %}

            {% for userAccess in record.accessWithPermission|filter(userAccess=>userAccess.user) %}

                {# Work out which radio should be checked for each row#}

                {% set checkedDeny = '' %}
                {% set checkedPublic = '' %}
                {% set checkedPrivate = '' %}

                {% if userAccess.access == 0 %}
                    {% set checkedDeny = 'checked' %}
                {% elseif userAccess.access == 1 %}
                    {% set checkedPublic = 'checked' %}
                {% elseif userAccess.access == 2 %}
                    {% set checkedPrivate = 'checked' %}
                {% endif %}

                <tr data-user-id="{{ userAccess.user.id }}">
                    <td class="small-1">User</td>
                    <td class="small-{{ reportPage ? 4 : 2 }}">{{ userAccess.user.fullName }} ({{ userAccess.user.role.name }})
                        <input type="hidden" name="userAccessId{{ userAccess.user.id }}" id="userAccessId{{ userAccess.user.id }}" value="{{ userAccess.id }}" >
                    </td>
                    {% if not reportPage %}
                    <td class="small-2">
                        <input type="radio" name="user[{{ userAccess.user.id }}]" id="userDeny{{ userAccess.user.id }}" value="0" {{ checkedDeny }}>
                        <label class="radio-label" for="userDeny{{ userAccess.user.id }}"></label>
                    </td>
                    {% endif %}
                    <td class="small-2">
                        <input type="radio" name="user[{{ userAccess.user.id }}]" id="userPublic{{ userAccess.user.id }}" value="1" {{ checkedPublic }}>
                        <label class="radio-label" for="userPublic{{ userAccess.user.id }}"></label>
                    </td>
                    <td class="small-2">
                        <input type="radio" name="user[{{ userAccess.user.id }}]" id="userPrivate{{ userAccess.user.id }}" value="2" {{ checkedPrivate }}>
                        <label class="radio-label" for="userPrivate{{ userAccess.user.id }}"></label>
                    </td>
                    {% if not reportPage %}
                    <td class="small-1">
                    </td>
                    <td class="small-1 checklist">
                        <input type="checkbox" name="userComment{{ userAccess.user.id }}" id="userComment{{ userAccess.user.id }}"
                               value="1" {{ userAccess.commentsAllowed ? 'checked' : '' }} {{ userAccess.user.role.isParent or userAccess.user.role.isStudent ? '' : 'readonly' }}
                               data-always-read-only="{{ userAccess.user.role.isParent or userAccess.user.role.isStudent ? 0 : 1 }}" >
                        <label class="checkbox-label {{ userAccess.access == 0 ? 'hide' : ''}}" for="userComment{{ userAccess.user.id }}"></label>
                    </td>
                    {% endif %}
                    <td class="text-right small-1">
                        <a href="#" data-delete-visibility="user" class="icon-delete"></a>
                    </td>
                </tr>
                {% set countUsers = countUsers + 1 %}
            {% endfor %}
        {% endif %}

    </tbody>

    <script>
        $(function () {
            window.usersAdded = [];

            {% for access in record.accessWithPermission|filter(access=>access.user) %}
                window.usersAdded[{{ access.user.id }}] = true;
            {% endfor %}

            {# Return existing users #}

            window.modalUsersExisting = function() {
                {# Need to use slice to clone the array, otherwise the modal will update the contents of this erroneously #}

                return window.usersAdded.slice(0);
            };

            {# Callback when user added from modal #}

            window.modalUserAdded = function (user, permission, commentsAllowed, locked) {

                // this line will check if the argument is undefined
                // if so set it to 1, otherwise set it to it's original value
                permission = (typeof permission !== 'undefined') ?  permission : 1;

                {# Only add if they don't already exist in the table #}

                if (window.usersAdded[user.id] !== true) {

                    {# Add the selected members ID to the array we use when saving to the database #}

                    window.usersAdded[user.id] = true;

                    {# Add them to the list of members in the HTML #}

                    //noinspection JSUnresolvedVariable
                    let html = $('[data-user-permission-clone]').html()
                        .replace(/{TYPE_NAME}/g, 'User')
                        .replace(/{NAME}/g, user.full_name)
                        .replace(/{ID}/g, user.id)
                        .replace(/{ROLE}/g, user.role);

                    let permissionListUsers = $('#permission-users');
                    permissionListUsers.append(html);

                    let commentCheckbox = $('#userComment' + user.id);
                    initCheckbox(
                            commentCheckbox,
                            user.roleType === 'staff',
                            commentsAllowed,
                            permission
                    );

                    //Check the correct box
                    let selector = 'input[name = "user['+user.id+']"][value ="'+permission+'"]';
                    $(permissionListUsers).find(selector).prop("checked", true);
                    setRadioButtonListener('[data-user-id="' + user.id + '"]');
                    applyLock(['users'], locked);
                }

                {# Update visibility table and click events #}

                updateVisibility();
                updateUserPermissionClickEvents();
            };

            function updateUserPermissionClickEvents() {
                $('[data-delete-visibility="user"]').on('click', function (e) {
                    e.preventDefault();

                    let row = $(this).closest('tr');
                    let userId = $(row).attr('data-user-id');

                    $('[data-reveal]').hide();

                    $(this).confirmDialog({
                        text: 'Are you sure you wish to remove the users visibility record?',
                        confirmEvent: function () {
                            window.usersAdded[userId] = false;
                            row.remove();
                            updateVisibility();
                            window.hasChanged = true;
                        }
                    });
                });
            }

            updateUserPermissionClickEvents();
        });
    </script>

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
    {# Setup User Selection Modal #}
    {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    {% if allowParents == 1 and not bulkCreate %}
        {% set searchScope = 'staff;parentofstudent' %}
    {% else %}
        {% set searchScope = 'staff' %}
    {% endif %}

    {{ userSearch.modal(guid, 'Add User To Record', 'Enter name', searchScope, record.student.id ?? null, 'window.modalUserAdded', 'window.modalUsersExisting', roles, roleTypes, moderatorIds) }}

{% endif %}
