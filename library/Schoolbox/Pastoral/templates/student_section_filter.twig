{# Pastoral Type Filter Box #}
{% set hasAccess = user.role.isStaff or user.role.isParent or user.role.isStudent %}
{% if types | length and hasAccess %}

    <div class="small-12 island">
        <h2 class="subheader">Filter Records</h2>
    </div>
    <div class="small-12 island">
        <section>
            <fieldset class="content">
                {% if user.role.isStaff %}
                <div class="small-12 medium-4 columns">
                    <label class="inline-block" for="typeId">Type</label>
                    <select data-type-filter name="typeId" id="typeId">
                        <option value="">Show All {{ locale.pastoral.proper }} Record Types</option>
                        {% for type in types %}
                            <option value="{{ type.id }}"
                                    {% if typeSelected == type.id %}selected{% endif %}>{{ type.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="small-12 medium-4 columns">
                    <label class="inline-block" for="subtypeId">Sub-type</label>
                    <select data-subtype-filter name="subtypeId" id="subtypeId">
                        <option value="">Show All {{ locale.pastoral.proper }} Record Sub-Types</option>
                        {% for subtype in subtypes %}
                            <option data-chained="{{ subtype.pastoralType.id }}" value="{{ subtype.id }}"
                                    {% if subtypeSelected == subtype.id %}selected{% endif %}>{{ subtype.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                <div class="small-12 medium-4 columns">
                    <label class="inline-block" for="showArchivedRecords">Show archived records</label>
                    <div class="switch f-no-margins">
                        <input data-archived-filter id="showArchivedRecords" name="showArchivedRecords" {% if showArchived == 1 %}checked="checked"{% endif %} value="1" type="checkbox">
                        <label for="showArchivedRecords" data-test="student-section-filter-show-archived-records-toggle">
                            <span>On</span>
                            <span>Off</span>
                        </label>
                    </div>
                </div>
            </fieldset>
        </section>
    </div>

    <script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/chained/jquery.chained.js?v={{ config.site_version }}"></script>
    {% if user.role.isStaff %}
    <script>
        $(function () {
            $('#subtypeId').chained('#typeId');
            $('[data-type-filter]').on('change', function () {
                window.location.href = "?type=" + $(this).val() + "&subtype=" + $('#subtypeId').val() + "&showArchived=" + ($('#showArchivedRecords').is(':checked') ? 1 : 0);
            });
            $('[data-subtype-filter]').on('change', function () {
                window.location.href = "?type=" + $('#typeId').val() + "&subtype=" + $(this).val() + "&showArchived=" + ($('#showArchivedRecords').is(':checked') ? 1 : 0);
            });
            $('[data-archived-filter]').on('change', function() {
                window.location.href = "?type=" + $('#typeId').val() + "&subtype=" + $('#subtypeId').val() + "&showArchived=" + ($(this).is(':checked') ? 1 : 0);
            })
        });
    </script>
    {% else %}
    <script>
        $(function () {
            $('[data-archived-filter]').on('change', function() {
                window.location.href = "?showArchived=" + ($(this).is(':checked') ? 1 : 0);
            })
        });
    </script>
    {% endif %}

{% endif %}
