{% import '@pastoral/macros/profile.twig' as profile %}

<div class="profile content">
    <div class="row no-margin">
        <div class="small-12 medium-2 large-1 columns no-pad">
            {{ profile.imageSquare(record.student) }}
        </div>
        <div class="small-12 medium-10 large-11 columns">
            <dl class="profile">
                <dt class="small-4 medium-3 columns">Type:</dt>
                <dd class="small-8 medium-9 columns">{{ record.type.name }}</dd>

                {% if record.subtype.name ?? '' is not empty %}
                    <dt class="small-4 medium-3 columns">Sub-Type:</dt>
                    <dd class="small-8 medium-9 columns">{{ record.subtype.name }}</dd>
                {% endif %}
                {% if record.severity and config.pastoral_severity %}
                    <dt class="small-4 medium-3 columns">{{ locale.severity.proper }}:</dt>
                    <dd class="small-8 medium-9 columns">
                        {% if severityColor %}
                            <sbx-label text="{{ record.severity.name }}" background-color="{{ record.severity.color }}" text-color="{{ severityColor }}"></sbx-label>
                        {% else %}
                            {{ record.severity.name }}
                        {% endif %}
                    </dd>
                {% endif %}
                {% if record.occurredOn is not empty %}
                    <dt class="small-4 medium-3 columns">Occurred On:</dt>
                    <dd class="small-8 medium-9 columns">{{ record.occurredOn.longDateOnly }}</dd>
                {% endif %}
                <dt class="small-4 medium-3 columns">Created By:</dt>
                <dd class="small-8 medium-9 columns">
                    {% if not record.owner.deletedAt %}
                        <a href="{{ profile.link(record.owner) }}">{{ record.owner.fullName }}</a>
                    {% else %}
                        {{ record.owner.fullName }}
                    {% endif %}
                </dd>

                <dt class="small-4 medium-3 columns">Created:</dt>
                <dd class="small-8 medium-9 columns">{{ record.createdAt.long }}</dd>

                {% if record.createdAt.long != record.updatedAtDisplay.long %}
                    <dt class="small-4 medium-3 columns">Last Updated By:</dt>
                    <dd class="small-8 medium-9 columns"><a href="{{ profile.link(record.modifiedBy) }}">{{ record.modifiedBy.fullName }}</a></dd>
                {% endif %}

                {% if record.createdAt.long != record.updatedAtDisplay.long %}
                    <dt class="small-4 medium-3 columns">Last Updated:</dt>
                    <dd class="small-8 medium-9 columns">{{ record.updatedAtDisplay.long }}</dd>
                {% endif %}

                {% if config.pastoral_point_enabled and record.points is not empty %}
                    <dt class="small-4 medium-3 columns">Points:</dt>
                    <dd class="small-8 medium-9 columns">
                        <sbx-label-pastoral-points points="{{ record.points }}"></sbx-label-pastoral-points>
                    </dd>
                {% endif %}

                {% if record.expiresAt is not empty %}
                    <dt class="small-4 medium-3 columns">Expires At:</dt>
                    <dd class="small-8 medium-9 columns">{{ record.expiresAt.longDateOnly }}</dd>
                {% endif %}
            </dl>

            {# Only staff should see pastoral tags #}

            {% if record.tags | length and user.role.isStaff %}
                <div class="content">
                    {% for tag in record.tags %}
                        {% set routeTag = routeLookupIfAuthorized('pastoralReportBuilder.getReportTags', {tagId: tag.id}) %}
                        {% if routeTag %}
                            <a href="{{ routeTag }}" class="neutral label">{{ tag.name }}</a>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
