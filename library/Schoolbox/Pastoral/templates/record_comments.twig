{% import '@pastoral/macros/profile.twig' as profile %}

{# Parents cannot ever add/view comments or related records. Only staff can view comments/related records #}

<div role="tabpanel" class="content" id="comments">

    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">Comments</h2>
            {% if comments | length > 0 %}
                <section>
                    <ul class="action-list">
                        {% for comment in comments %}
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <div class="small-12 card wrap-down">
                                        <a href="{{ profile.link(comment.owner) }}" title="View Profile">
                                            {{ profile.imageSquare64(comment.owner) }}
                                        </a>
                                        <p class="meta">
                                            Posted by <a href="{{ profile.link(comment.owner) }}">{{ comment.owner.fullName }}</a> {{ comment.createdAt.short }}
                                        </p>
                                        <p>{{ comment.body | purify | nl2br }}</p>
                                    </div>
                                </div>
                                {% if isRouteAuthorized('pastoral.postCommentDelete', {'recordId': record.id, 'commentId': comment.id}) %}
                                    <nav>
                                        <a data-delete-comment="{{ comment.id }}" class="icon-delete" href="#" title="Delete Comment"></a>
                                    </nav>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            {# Show add comment box if you're allowed to participate #}

            {% set commentRoute = routeLookupIfAuthorized('pastoral.postCommentInsert', {'recordId': record.id}) %}
            {% if commentRoute %}
                <section class="content">
                    <form method="post" action="{{ commentRoute }}">
                        <input type="hidden" name="pastoral_id" value="{{ record.id }}"> <input type="hidden" name="student_id" value="{{ record.student.id }}">
                        <textarea id="comment_body_{{ commentType }}" rows="3" cols="50" name="comment_body" placeholder="Add Comment"></textarea>
                        <div class="right">
                            {% if commentType == 'private' %}
                                <input type="hidden" name="comment_private" id="commentPrivate" value="1"/>
                            {% endif %}
                        </div>

                        <input disabled data-post-{{ commentType }} type="submit" class="expand" value="Add Comment">
                    </form>

                    <script type="text/javascript">
                        $(function () {
                            // Disable post comment button if there is no comment

                            $('#comment_body_{{ commentType }}').on('change keyup paste', function () {
                                $('[data-post-{{ commentType }}]').prop('disabled', $('#comment_body_{{ commentType }}').val().trim() === '');
                            });

                            // Delete pastoral record

                            $('[data-delete]').click(function (event) {
                                event.preventDefault();

                                $(this).confirmDialog({
                                    text: 'Are you sure you want to delete this record?',
                                    confirmEvent: function () {
                                        $.post('{{ routeLookup('pastoral.postRecordDelete', {studentId: record.student.id, recordId: record.id }) }}'
                                        ).done(function () {
                                            window.location.href = '{{ routeLookup('pastoral.getIndex', {studentId: record.student.id}) }}';
                                        });
                                    }
                                });
                            });

                            // Delete comment

                            $('[data-delete-comment]').click(function (event) {
                                event.preventDefault();

                                deleteCommentRoute = '{{ routeLookup('pastoral.postCommentDelete', {
                                    'recordId': 'recordId',
                                    'commentId': 'commentId'
                                }) }}';

                                $(this).confirmDialog({
                                    text: 'Are you sure you want to delete this comment?',
                                    confirmEvent: function () {
                                        $.post(
                                            deleteCommentRoute
                                                .replace(/recordId/g, {{ record.id }})
                                                .replace(/commentId/g, $(event.target).attr('data-delete-comment'))
                                        ).success(function () {
                                            $(event.target).closest('li').remove();
                                        });
                                    }
                                });
                            });
                        });
                    </script>
                </section>
            {% endif %}

        </div>
    </div>
</div>
