<dl class="tabs" data-tab>
    <dd class="active"><a data-tab href="#panel-general">General</a></dd>
    <dd><a data-tab href="#panel-confidential">Confidential</a></dd>
</dl>
<section class="content tabs-content">
    <div class="content active" id="panel-general">
        <p class="meta">
            You may use the following tokens that will be substituted with the
            students details on creation:
            [firstname], [givenname], [preferredname], [surname], [fullname], [year], [house]
        </p>
        <textarea id="body_public" name="body_public">{{ record.bodyPublic }}</textarea>
        {% include 'sub/attachzone.twig' with {attachzone: attachzonePublic} %}
    </div>
    <div class="content" id="panel-confidential">
        <p class="meta">
            You may use the following tokens that will be substituted with the
            students details on creation:
            [firstname], [givenname], [preferredname], [surname], [fullname], [year], [house]
        </p>
        <textarea id="body_private" name="body_private">{{ record.bodyPrivate }}</textarea>
        {% include 'sub/attachzone.twig' with {attachzone: attachzonePrivate} %}
    </div>
</section>
