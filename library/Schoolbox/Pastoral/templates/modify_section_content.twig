<h2 class="subheader">Record Content</h2>

<section>
    <dl class="accordion" data-accordion>

        {# Content #}

        <dd class="accordion-navigation active">
            <a href="#panelPublic" aria-expanded="true">General</a>
            <div id="panelPublic" class="content active">
                <section class="no-margin">
                    <fieldset class="content no-padding">
                        <div class="small-12 columns">
                            <section class="no-margin">
                                <textarea id="body_public" name="body_public">{{ record.bodyPublic }}</textarea>
                                {% include 'sub/attachzone.twig' with {attachzone: attachzonePublic} %}
                            </section>
                        </div>
                    </fieldset>
                </section>
            </div>
        </dd>

        {# Confidential Content #}

        <dd class="accordion-navigation">
            <a href="#panelPrivate">{{ locale.pastoralPrivate.proper }}</a>
            <div id="panelPrivate" class="content">
                <section class="no-margin">
                    <fieldset class="content no-padding">
                        <div class="small-12 columns">
                            <section class="no-margin">
                                <textarea id="body_private" name="body_private">{{ record.bodyPrivate }}</textarea>
                                {% include 'sub/attachzone.twig' with {attachzone: attachzonePrivate} %}
                            </section>
                        </div>
                    </fieldset>
                </section>
            </div>
        </dd>
    </dl>
</section>
