{% set links %}
    <a href="#" data-reveal-id="modal-role" title="Add Role">role</a>
    {%- if allowIndividual -%}
        {%- if groups | length == 0 %} or{% else %},{% endif %}
        <a href="#" data-user-search="{{ guid }}" title="Add User">user</a>
    {%- endif -%}
    {% if groups | length > 0 %}
        or <a href="#" data-reveal-id="modal-group" title="Add {{ locale.pastoral.proper }} Group">{{ locale.pastoral.proper }} group</a>
    {%- endif %}
{% endset %}
<span id="visibility_empty_state">
{% if name is not empty %}
    <p>There is no visibility set for this record. It will only be visible to {{ name }} and {{ locale.pastoral }} moderators.</p>
    <p>
        To grant access to other users, add a
        {{ links }}
        to this record.
    </p>
{% else %}
    <p>There are no visibility rules set on this record type.</p>
    <p>
        Select a
        {{ links }}
        to set a default visibility rule for this record type.
    </p>
{% endif %}
</span>
<span id="visibility_empty_state_locked" {% if managePage %}class="hide"{% endif %}>
    <p>Visibility has been disabled and cannot be modified</p>
</span>
