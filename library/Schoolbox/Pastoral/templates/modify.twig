{% import '@pastoral/macros/profile.twig' as profile %}
{% import 'sub/breadcrumbs.twig' as bread %}

{# Decide which save route we are using #}

{% if record.id %}
    {% set saveRoute = routeLookup('pastoral.postRecordUpdate', {recordId: record.id}) %}
    {% set pageTitle = 'Update ' ~ locale.pastoral.proper ~ ' Record' %}
{% else %}
    {% set saveRoute = routeLookup('pastoral.postRecordInsert') %}
    {% set pageTitle = 'Add ' ~ locale.pastoral.proper ~ ' Record' %}
{% endif %}

{{ bread.crumbs(
[ locale.pastoralCare.proper,   routeLookup('pastoral.getIndex') ],
[ record.student.fullName,      routeLookup('pastoral.getStudent', {studentId: record.student.id}) ],
[ record.heading,               routeLookup('pastoral.getStudentRecord', {studentId: record.student.id, recordId: record.id}) ],
[ pageTitle ]
) }}

<div class="row">
    <div>
        <div class="small-12 column">
            <h1>{{ record.student.fullName }}</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-11 columns">
                    <h2 class="subheader">{{ pageTitle }}</h2>
                </div>
            </div>
            {% if record.id is not empty and isRouteAuthorized('pastoral.postDelete', {record: record}) %}
                <nav class="hide" id="formPastoralDelete">
                    <a href="#" data-delete class="icon-delete" title="Delete {{ locale.pastoral.proper }} Record"></a>
                </nav>
            {% endif %}
        </div>
    </div>
</div>
<div class="row">
    <div class="small-12 island" id="formPastoralPreloader">
        <section class="content">
            <div class="loader"></div>
        </section>
    </div>
    <div class="small-12 island hide" id="formPastoral">
        <form class="top" id="pastoralForm" method="post" enctype="multipart/form-data" action="{{ saveRoute }}">

            {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
            {# General Stuff #}
            {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

            {% include "@pastoral/modify_section_general.twig" %}

            {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
            {# Record Content #}
            {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

            {% include "@pastoral/modify_section_content.twig" %}

            {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
            {# Record Visibility #}
            {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

            {% include "@pastoral/modify_section_visibility.twig" %}

            {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
            {# Link Record To Other Students #}
            {# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

            {% include "@pastoral/modify_section_linked.twig" %}

            <div class="row">
                <div class="small-12 column">
                    <ul class="flex-list buttons">
                        <li><input type="submit" data-submit class="submit" value="Save"></li>
                    </ul>
                </div>
            </div>
        </form>
    </div>
</div>

<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" src="/javascript/shared/select-all/attacher.select-all.js"></script>
<script type="text/javascript" src="/javascript/jquery.chained.min.js"></script>

<script type="text/javascript">
    $(function () {

        var form = $('form#pastoralForm');

        $.fn.alaressEditor();

        $('#tags').selectizeSelector({
            ajax: {
                url: '/ajax/tags/pastoral',
                type: 'GET',
                dataType: 'json'
            },
            multiple: true,
            selectize: {
                create: function (input) {
                    return {
                        id: input,
                        name: input
                    }
                }
            },
            value: [
                {% for tag in record.tags %}

                {% set tagName = tag.name | escape('js') %}
                {'id': '{{ tagName }}', 'name': '{{ tagName }}'}{% if not loop.last %},{% endif %}
                {% endfor %}
            ]
        });

        {% if record.id != '' %}

        $('[data-delete]').click(function (e) {
            e.preventDefault();

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this record?',
                confirmEvent: function () {
                    $.post('{{ routeLookup('pastoral.postRecordDelete', {'studentId': record.student.id, 'recordId': record.id}) }}')
                        .done(function () {
                            window.location.href = '{{ routeLookup('pastoral.getIndex', {'studentId': record.student.id ? record.student.id : student.id}) }}';
                        });
                }
            });
        });

        {% endif %}

        $('#addStudent').selectizeSelector({
            multiple: true,
            ajax: {
                url: '/ajax/user.php',
                type: 'GET',
                data: {
                    roleTypeID: 'student',
                    excludeID: '{{ record.student.id }}'
                },
                dataType: 'json'
            }
        });

        $('[data-submit]').click(function (event) {
            form.alaressValidate({
                ignore: ':disabled',
                rules: {
                    'heading': {required: true}
                },

                messages: {
                    'heading': {required: 'You must enter a title before you can proceed'}
                }
            });
        });

        $('#subtypeId').chained('#typeId');
    });
</script>

<script>
    {# The ckeditor popping in during editing the form is insanely annoying, hiding the form until its done its thing #}

    $(window).load(function (e) {
        $('#formPastoralPreloader').addClass('hide');
        $('#formPastoral').removeClass('hide');
        $('#formPastoralDelete').removeClass('hide');
    });
</script>