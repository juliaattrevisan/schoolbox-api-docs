{% import '@pastoral/macros/profile.twig' as profile %}

{# Decide which save route we are using #}

{% if record.id %}
    {% set saveRoute = routeLookup('pastoral.postRecordUpdate', {recordId: record.id}) %}
    {% set pageTitle = 'Update Pastoral Record' %}
{% else %}
    {% set saveRoute = routeLookup('pastoral.postRecordInsert') %}
    {% set pageTitle = 'Add Pastoral Record' %}
{% endif %}

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('pastoral.getIndex') }}">Pastoral Care</a></li>
    <li><a href="{{ routeLookup('pastoral.getStudent', {studentId: record.student.id}) }}">{{ record.student.fullName }}</a></li>
    <li class="active"><a href="#">{{ pageTitle }}</a></li>
</ul>

<div class="row">
    <div>
        <div class="small-12 column">
            <h1>{{ record.student.fullName }}</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-11 columns">
                    <h2 class="subheader">{{ pageTitle }}</h2>
                </div>
            </div>
            {% if record.id is not empty and isRouteAuthorized('pastoral.postDelete', {record: record}) %}
                <nav>
                    <a href="#" data-delete class="icon-delete" title="Delete Pastoral Record"></a>
                </nav>
            {% endif %}
        </div>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <form class="top" id="pastoralForm" method="post" enctype="multipart/form-data" action="{{ saveRoute }}">
            <input type="hidden" name="id" value="{{ record.id }}">
            <input type="hidden" id="deleteIds" name="deleteIds" value="">
            <input type="hidden" name="student_id" value="{{ student.id }}{{ record.student.id }}">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Title
                            <input type="text" class="required" name="heading" size="35" maxlength="100" value="{{ record.heading }}"/>
                        </label>
                        <p class="meta">
                            Important Note: The title of a pastoral record will remain visible on pastoral records listed as private.
                            Please do not include confidential information in the title of the record.
                        </p>
                    </div>
                </fieldset>
            </section>
            <section>
                <fieldset class="content">
                    <div class="small-12 medium-6 columns">
                        <label>
                            Type
                            <select class="required" name="typeId" id="typeId">
                                {% for type in types %}
                                    <option {% if type.id == record.type.id %}selected{% endif %} value="{{ type.id }}">{{ type.name }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>
                            Sub-Type
                            <select name="categoryId" id="categoryId">
                                {% for category in categories %}
                                    <option class="{{ category.pastoralType.id }}" {% if category.id == record.category.id %}selected{% endif %}
                                            value="{{ category.id }}">{{ category.name }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                    <div class="small-12 medium-6 columns">
                        {% if severities | length %}
                            <label>
                                Severity
                                <select class="required" name="severityId">
                                    {% for severity in severities %}
                                        <option {% if severity.id == record.severity.id %}selected{% endif %}
                                                value="{{ severity.id }}">{{ severity.name }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                        {% endif %}
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>
                            Points
                            <input type="number" name="points" size="35" maxlength="100" value="{{ record.points }}"/>
                        </label>
                    </div>
                    <div class="small-{% if severities | length %}12{% else %}6{% endif %} columns">
                        <label>
                            Tags
                            <span class="hint has-tip tip-top" data-tooltip
                                  title="Multiple tags can be added to aid filtering and reporting. Try to reuse existing tags by searching first. If necessary you may create new tags.">?</span>
                            <input id="tags" name="tags" value="{% for tag in record.tags %}{{ tag.name }},{% endfor %}">
                        </label>

                    </div>
                </fieldset>
            </section>
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <section>
                            <textarea id="body" name="body">{{ record.body }}</textarea>
                            {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                        </section>
                    </div>
                </fieldset>
            </section>

            <h2 class="subheader">Visibility</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Display Record To Users In These Roles
                            <span class="hint has-tip tip-top" data-tooltip
                                  title="Select the user roles you would like to access this record and its contents.">?</span>
                            {% for role in roles if not role.isStudent and not role.isGuest %}
                                {% if allowParents == 1 or not role.isParent %}
                                    <input type="hidden" name="role[{{ role.id }}]" value="0"/>
                                    <input {% if role.isParent %}data-role-parent{% endif %} type="checkbox" name="role[{{ role.id }}]"
                                           id="role[{{ role.id }}]" value="1"
                                            {% if record.id != '' %}
                                                {% for access in record.access if access.role.id != '' %}
                                                    {% if access.role.id == role.id %}
                                                        checked
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}
                                    />
                                    <label for="role[{{ role.id }}]"
                                           class="checkbox-label">{{ role.name }} {% if role.isParent %}of student{% endif %}</label>
                                {% endif %}
                            {% endfor %}
                        </label>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <legend>
                            <label for="private">
                                Hide Record Contents
                                <span class="hint has-tip tip-top"
                                      data-tooltip
                                      title="If this is enabled users in these roles will only be able to see the title of the pastoral record.">?</span>
                            </label>
                        </legend>
                        <div class="switch">
                            <input id="private" name="private" {% if record.getPrivate %}checked{% endif %} value="1" type="checkbox">
                            <label for="private">
                                <span>Yes</span>
                                <span>No</span>
                            </label>
                        </div>
                    </div>
                </fieldset>
            </section>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        {% if groups | length %}
                            <label>
                                Pastoral Group Access
                                <span class="hint has-tip tip-top" data-tooltip
                                      title="Select the pastoral groups you would like to have access to this record.">?</span>
                                {% for group in groups %}
                                    <input type="hidden" name="group[{{ group.id }}]" value="0"/>
                                    <input type="checkbox" name="group[{{ group.id }}]"
                                           id="group[{{ group.id }}]" value="1"
                                            {% if record.id != '' %}
                                                {% for access in record.access if access.group.id != '' %}
                                                    {% if access.group.id == group.id %}
                                                        checked
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}
                                    />
                                    <label for="group[{{ group.id }}]" class="checkbox-label">{{ group.name }}</label>
                                {% endfor %}
                            </label>
                            <p class="meta">Important Note: Users that are members of these groups can view the contents of private records.</p>
                        {% else %}
                            <label>Pastoral Group Access</label>
                            <p class="meta">
                                No pastoral groups are currently defined, please contact your pastoral administrator
                                to use the pastoral group functionality.
                            </p>
                        {% endif %}
                    </div>
                </fieldset>
            </section>

            {% if allowIndividual %}
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>
                                Individual User Access
                                <span class="hint has-tip tip-top" data-tooltip
                                      title="Add individual users who you would like to access this record and its contents. These users will be able to see content marked as hidden.">?</span>
                                <select id="addUser" name="user_id[]" multiple placeholder="Individual Users"></select>
                            </label>
                            <p class="meta">Important Note: Users granted individual access can view the contents of private records.</p>
                        </div>
                    </fieldset>
                    {% set found = 0 %}
                    {% for access in record.access if access.user.id != '' %}
                        {% set found = 1 %}
                    {% endfor %}
                    {% if found %}
                        <fieldset class="content">
                            <div class="small-12 columns">
                                <label>
                                    Existing Individual User Access
                                </label>
                                <ul class="grid information-list">
                                    {% for access in record.access if access.user.id != '' %}
                                        <li class="actions-small-1">
                                            <div class="list-item">
                                                <div class="card small-12">
                                                    <a href="/search/user/{{ access.user.id }}" title="View Profile"><img src="/portrait.php?userId={{ access.user.externalId }}&size=square64" alt="View Profile"/></a>
                                                    <p><a href="/search/user/{{ access.user.id }}" title="View Profile">{{ access.user.firstname }} {{ access.user.lastname }}</a></p>
                                                    <p class="meta">{{ access.user.role.name }}</p>
                                                </div>
                                            </div>
                                            <nav>
                                                <a data-delete-permission="{{ access.user.id }}" class="icon-delete no-text" href="#"
                                                   title="Remove User Permission"></a>
                                            </nav>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </fieldset>
                    {% endif %}
                </section>
            {% endif %}

            {# Show linked pastoral records #}

            <h2 class="subheader">Link Pastoral Record To Other Students</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Other Students
                            <span class="hint has-tip tip-top" data-tooltip title="This will create a duplicate report and add it to the pastoral care area for these students.">?</span>
                            <select id="addStudent" name="duplicate_id[]" multiple placeholder="Add Students"></select>
                        </label>
                        {% if record.relatedRecords | length %}
                            <label>
                                Currently Linked Students
                            </label>
                            <ul class="action-list">
                                {% for related in record.relatedRecords %}
                                    <li class="actions-small-1">
                                        <div class="list-item">
                                            <div class="small-12 card wrap-down">
                                                <a href="{{ profile.link(related.student) }}">{{ profile.imageSquare64(related.student) }}</a>
                                                <p>
                                                    <a title="View Record" href="{{ routeLookup('pastoral.getStudentRecord', {'studentId': related.student.id, 'recordId': related.id}) }}">
                                                        {{ related.heading }}
                                                    </a>
                                                </p>
                                                <p class="spaced meta">{{ related.student.fullName }}</p>
                                            </div>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </fieldset>
            </section>

            <div class="row">
                <div class="small-12 column">
                    <ul class="flex-list buttons">
                        <li><input type="submit" data-submit class="submit" value="Save"></li>
                        {% if record.id %}
                            <li><button data-delete>Delete Record</button></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </form>
    </div>
</div>

<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" src="/javascript/shared/select-all/attacher.select-all.js"></script>
<script type="text/javascript" src="/javascript/jquery.chained.min.js"></script>

<script type="text/javascript">
    $(function () {

        var form = $('form#pastoralForm');

        $.fn.alaressEditor();

        $('#tags').selectizeSelector({
            ajax: {
                url: '/ajax/tags/pastoral',
                type: 'GET',
                dataType: 'json'
            },
            multiple: true,
            selectize: {
                create: function (input) {
                    return {
                        id: input,
                        name: input
                    }
                }
            },
            value: [
                {% for tag in record.tags %}

                {% set tagName = tag.name | escape('js') %}
                {'id':'{{ tagName }}','name':'{{ tagName }}'}{% if not loop.last %},{% endif %}
                {% endfor %}
            ]
        });

        {% if record.id != '' %}

        var deleteIds = [];

        $('[data-delete]').click(function (e) {
            e.preventDefault();

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this record?',
                confirmEvent: function () {
                    $.post('{{ routeLookup('pastoral.postRecordDelete', {'studentId': record.student.id, 'recordId': record.id}) }}')
                        .done(function () {
                            window.location.href = '{{ routeLookup('pastoral.getIndex', {'studentId': record.student.id ? record.student.id : student.id}) }}';
                        });
                }
            });
        });

        $('[data-delete-permission]').click(function (event) {
            event.preventDefault();

            var selector = $("#deleteIds");
            var deleteIds = selector.val();
            if (deleteIds != '') {
                deleteIds += ',';
            }
            selector.val(deleteIds + $(event.target).attr('data-delete-permission'));
            $(event.target).closest('li').remove();
        });

        {% endif %}

        $('#addUser').selectizeSelector({
            multiple: true,
            ajax: {
                url: '/ajax/user.php?studentId={{ student.id }}{{ record.student.id }}',
                type: 'GET',
                data: {roleTypeID: 'staff{% if allowParents %};parentofstudent{% endif %}'},
                dataType: 'json'
            },
            value: [
                {% for access in record.access if access.user.id != '' %}
                    {% set userName = (access.user.fullName ~ ' - ' ~ access.user.role.name ~ ' (' ~ access.user.id ~ ')') | escape('js') %}
                    {'id':'{{ access.user.id }}','name':'{{ userName }}'},
                {% endfor %}
            ]
        });

        $('#addStudent').selectizeSelector({
            multiple: true,
            ajax: {
                url: '/ajax/user.php',
                type: 'GET',
                data: {roleTypeID: 'student'},
                dataType: 'json'
            }
        });

        $('#private').change(function (event) {
            $('[data-role-parent]')
                .prop('checked', false)
                .prop('disabled', $('#private').prop('checked'));
        });

        $('[data-role-parent]').prop('disabled', $('#private').prop('checked'));

        $('[data-submit]').click(function (event) {
            form.alaressValidate({
                ignore: ':disabled',
                rules: {
                    'heading': {required: true},
                    'body': {required: true}
                },

                messages: {
                    'heading': {required: 'You must enter a title enter a heading before you can proceed.'},
                    'body': {required: 'You must enter a description of the pastoral event before you can proceed.'}
                }
            });
        });

        $('#categoryId').chained('#typeId');
    });
</script>
