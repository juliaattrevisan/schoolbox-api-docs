{% set filters = 'students=' ~ students ~ '&authors=' ~  authors  ~ '&severity=' ~  severity  ~ '&types=' ~  types  ~ '&years=' ~  years  ~ '&tags=' ~  tags  ~ '&before=' ~  before  ~ '&after=' ~  after ~ '&order=' ~ order %}

<script>
    $(function () {
        function popupCenter(url, title, w, h) {
            var dualScreenLeft = window.screenLeft != undefined ? window.screenLeft : screen.left;
            var dualScreenTop = window.screenTop != undefined ? window.screenTop : screen.top;

            var width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;
            var height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;

            var left = ((width / 2) - (w / 2)) + dualScreenLeft;
            var top = ((height / 2) - (h / 2)) + dualScreenTop;
            var newWindow = window.open(url, title, 'scrollbars=yes, width=' + w + ', height=' + h + ', top=' + top + ', left=' + left);

            if (window.focus) {
                newWindow.focus();
            }
        }

        $("[data-print]").click(function() {
            popupCenter(
                    '{{ routeLookup('pastoral.getReportPrint') }}?{{ filters | raw }}',
                    'Print Pastoral Record',
                    900,
                    500);
        });
    });
</script>
<ul class="breadcrumb hide-on-print">
    <li><a href="{{ routeLookup('pastoral.getReportBuilder') }}">Pastoral Care Report Generator</a></li>
    <li class="active"><a href="#">Report Results</a></li>
</ul>

<div class="row actions-small-3">
    <div class="list-item">
        <div class="small-12 island">
            <h1>Report Results</h1>
        </div>
    </div>
    <nav>
        <a href="#" data-print class="icon-print" title="Print Report Results"></a>
    </nav>
</div>

<div class="row">
    {% if results | length > 0 %}

        <div class="small-12 island">
            <section class="content">
                <p class="no-margin left hide-on-print">
                    The following pastoral care incidents were found matching your report criteria.
                </p>
                <p class="no-margin right hide-on-print">
                    Viewing results {{ pageCurrent * resultsPerPage - resultsPerPage + 1 }} - {{ min(totalResults, pageCurrent * resultsPerPage) }} of {{ totalResults }}
                </p>
                <div class="clearfix"></div>
            </section>
        </div>
        <div class="clearfix"></div>


        <div class="small-12 island">

            {% for record in results %}
                <section>
                    <ul class="action-list">
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="small-12 card wrap-down">
                                    {# Theres no need for the all the twig access checks like the list page, if the user got to this screen they can view everything #}
                                    <a href="/search/user/{{ record.owner.getId() }}">
                                        <img class="show-on-print" src="/portrait.php?userId={{ record.getStudent().getExternalId() }}&amp;size=square64" width="64">
                                    </a>
                                    <h4>{{ record.getStudent().getFirstname }} {{ record.getStudent().getLastname }} - {{ record.getHeading() }}</h4>
                                    <p class="spaced meta">
                                        Posted by <a href="/search/user/{{ record.owner.getId() }}">{{ record.owner.firstName }} {{ record.owner.lastName }}</a> {{  record.getCreatedAt().getShort() }}
                                    </p>

                                    {# Display tags #}
                                    {% if role != 'parent' %}
                                        {% if record.points != 0 or (record.tagsList | length) > 0 %}
                                            <p class="spaced">
                                                {% if record.points != 0 %}
                                                    {% if record.points < 0 %}
                                                        {% set labelClass='alert' %}
                                                    {% endif %}
                                                    {% if record.points > 0 %}
                                                        {% set labelClass='success' %}
                                                    {% endif %}
                                                    <span class="{{ labelClass }} label hide-on-print">{{ record.points }} Point{% if record.points < -1 or record.points > 1 %}s{% endif %}</span>
                                                    <b class="show-for-print"> {{ record.points }} Point{% if record.points < -1 or record.points > 1 %}s{% endif %}</b>
                                                {% endif %}
                                                {% if record.tagsList | length > 0 %}
                                                    {% for tag in record.tagsList %}
                                                        <span class="neutral label hide-on-print">{{ tag.name }}</span>
                                                        <b class="show-for-print"> {{ tag.name }}</b>
                                                    {% endfor %}
                                                {% endif %}
                                            </p>
                                        {% endif %}
                                    {% endif %}

                                    {# Hide meta from parents#}
                                    {% if role != 'parent' %}
                                        <p class="spaced meta">
                                            {# Pastoral event type #}
                                            {{ record.getType.getName }} {% if record.getCategory.getName != '' %}({{ record.getCategory.getName }}){% endif %} |

                                            {# Pastoral event severity #}
                                            {{ record.getSeverity.getName }} |

                                            {# Indicate if record is private #}
                                            {% if record.private %}Contents Private | {% endif %}

                                            {# Indicate if not audience has been set #}
                                            {% if record.getAccessList.count == 0 %}No Audience Set{% endif %}

                                            {# Show audienced roles  #}
                                            {% if record.getAccessList.count > 0 %}
                                                {% for access in record.getAccessList %}
                                                    {% if access.getRole.getId != '' %}
                                                        {{ access.getRole.getName }}{% if not loop.last %},{% endif %}
                                                    {% elseif access.getUser.getId != '' %}
                                                        <a href="/search/user/{{ access.getUser.getId }}">{{ access.getUser.getFirstname }} {{ access.getUser.getLastname }}</a>{% if not loop.last %},{% endif %}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}

                                        </p>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="clearfix no-margin"></div>

                            {# Show article body #}
                            <div class="content">
                                {{ record.getBody() | raw }}

                                {# Show any file attachments #}
                                {% if record.getAttachmentList.count > 0 %}
                                    <p class="spaced meta">
                                        {% for attachment in record.getAttachmentList %}
                                            Attached: <a target="_blank" href="/storage/fetch.php?hash={{ attachment.getHash() }}">{{  attachment.getFilename() }}</a><br>
                                        {% endfor %}
                                    </p>
                                {% endif %}
                            </div>

                            {% if record.getCommentList.count > 0 %}
                                {# Show all comments for this record #}
                                {% for comment in record.getCommentList %}
                                    <div class="content">
                                        <div class="small-12 card wrap-down">
                                            {# Comment author photo #}
                                            <a href="/search/user/{{ comment.owner.getId() }}" title="View Profile">
                                                <img src="/portrait.php?userId={{ comment.owner.getExternalId() }}&size=square64" alt="" />
                                            </a>

                                            {# Show comment author #}
                                            <p class="meta">Comment By <a href="/search/user/{{ comment.getOwner.getId }}">{{ comment.getOwner.getFirstName }} {{ comment.getOwner.getLastName }}</a> {{ comment.getCreatedAt().getShort() }}</p>

                                            {# Show comment body #}
                                            <p class="spaced">
                                                {{ comment.body | raw }}
                                            </p>
                                        </div>
                                    </div>
                                {% endfor %}

                            {% endif %}
                        </li>
                    </ul>
                </section>
                <hr class="show-for-print">
            {% endfor %}
        </div>

    {% else %}

        <div class="small-12 island">
            <section>
                <div class="content">
                    <p class="no-margin">No pastoral records matched your search criteria, please review your criteria and try again.</p>
                </div>
            </section>
            <a class="button submit expand" href="{{ routeLookup('pastoral.getReportBuilder') }}?{{ filters}}">Change Report Criteria</a>
        </div>

    {% endif %}
</div>

{% if results | length > 0 %}

    <br>
    <div class="row">
        <div class="small-12 island">
            <a class="button submit expand" href="{{ routeLookup('pastoral.getReportBuilder') }}?{{ filters}}">Change Report Criteria</a>

            {% if results | length > 0 and totalPages > 1 %}
                <br><br>
                <ul class="pagination">
                    <li class="arrow"><a href="?pageCurrent=1{{ filters }}">«</a></li>
                    <li class="arrow {% if pageCurrent == 1 %}unavailable{% endif %}"><a href="{% if pageCurrent == 1 %}#{% else %}?pageCurrent={{ pageCurrent - 1 }}&(( filters }}{% endif %}">‹</a></li>
                    {% for i in range (max(1, pageCurrent - ( pagesToDisplay - (min(totalPages, pageCurrent +  pagesToDisplay - (pageCurrent - max(1, pageCurrent - (pagesToDisplay / 2) ))) - pageCurrent))), min(totalPages, pageCurrent + pagesToDisplay - (pageCurrent - max(1, pageCurrent - (pagesToDisplay / 2)))))  %}
                        <li {% if i == pageCurrent %} class='active' {% endif %}>
                            <a href="?pageCurrent={{ i }}&(( filters }}">{{ i }}</a>
                        </li>
                    {% endfor %}
                    <li class="arrow"><a href="{% if pageCurrent == totalPages %}#{% else %}?pageCurrent={{ pageCurrent + 1 }}&(( filters }}{% endif %}">›</a></li>
                    <li class="arrow"><a href="?pageCurrent={{ totalPages }}&(( filters }}">»</a></li>
                </ul>
            {% endif %}
        </div>
    </div>

{% endif %}