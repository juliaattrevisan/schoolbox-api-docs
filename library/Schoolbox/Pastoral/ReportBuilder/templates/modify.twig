{% if report.id is empty %}
    {% set pageTitle = 'Add New Report' %}
{% else %}
    {% set pageTitle = 'Modify Report' %}
{% endif %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ locale.pastoralCare.proper,      routeLookup('pastoral.getIndex') ],
    [ 'Reports',            routeLookup('pastoralReportBuilder.getIndex') ],
    [ pageTitle ]
) }}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/select-all/jquery.select-all.js?v={{ config.site_version }}"></script>

<div class="row">
    <div class="small-12 column">
        <h1>{{ locale.pastoralCare.proper }} Reports</h1>
        <h2 class="subheader">{{ pageTitle }}</h2>
    </div>
</div>

<div class="row">
    <div class="small-12 island">

        <form id="formReport" action="{{ routeLookup('pastoralReportBuilder.postReportModify') }}" method="post">
            <input type="hidden" id="order" name="order">
            <input type="hidden" name="id" value="{{ report.id }}">

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="name">
                            <span class="required-with-tip">Report Name</span>
                            <input id="name" type="text" name="name" value="{{ report.name }}"/>
                        </label>
                        <div class="checklist">
                            <input id="dashboard" name="dashboard" value="1" type="checkbox"
                                   {% if report.dashboard %}checked{% endif %}>
                            <label for="dashboard">
                                Show this report on my {{ locale.pastoral }} dashboard
                            </label>
                        </div>
                    </div>
                </fieldset>

            </section>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Filter By Student
                            <select id="filterStudents" name="students[]" multiple
                                    data-placeholder="Select Students"></select>
                        </label>
                        <label>
                            Filter By Author
                            <select id="filterAuthors" name="authors[]" multiple
                                    data-placeholder="Select Authors"></select>
                        </label>
                        {% if severities | length %}
                            <label>
                                Minimum {{ locale.severity.proper }} Level
                                <select id="filterSeverity" name="severity">
                                    <option value="">Show All {{ locale.severity.proper }} Levels</option>
                                    {% for severity in severities %}
                                        <option {% if severity.id == report.severity.id ?? '' %}selected{% endif %}
                                                value="{{ severity.id }}">
                                            {{ severity.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </label>
                        {% endif %}
                    </div>

                    <div class="small-12 columns">
                        <label for="filterTags">
                            Filter By Tags
                            <select id="filterTags" name="tags[]" multiple data-placeholder="Select Tags"></select>
                        </label>
                    </div>
                </fieldset>
            </section>

            <h2 class="subheader">Date Range</h2>
            <p class="meta">Include reports published within the selected time period</p>

            <section>
                <fieldset class="radiolist content">
                    <div class="small-12 large-6 columns">
                        <input type="radio" name="date-option" id="relative-dates-option" value="relative"
                               {% if report.usesRelativeDate %}checked{% endif %}/>
                        <label for="relative-dates-option">Use relative date range</label>
                    </div>
                    <div class="small-12 large-6 columns">
                        <input type="radio" name="date-option" id="absolute-dates-option" value="absolute"
                               {% if not report.usesRelativeDate %}checked{% endif %}/>
                        <label for="absolute-dates-option">Use fixed date range</label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <div id="relative-dates"
                         class="small-12 columns{% if not report.usesRelativeDate %} hide{% endif %}">
                        <label for="relative-dates-dropdown">Time period</label>
                        <select id="relative-dates-dropdown" name="relative-dates-dropdown">
                            {% for value,label in datePresets %}
                                <option value="{{ value }}"
                                        {% if selectedRelativeDate == value %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div id="absolute-dates" {% if report.usesRelativeDate %}class="hide"{% endif %}>
                        <div class="small-12 large-6 columns">
                            <label for="datetime_after">
                                From
                                <input type="text" name="after" id="datetime_after"
                                       value="{{ report.afterDate.usingFormat('d/m/Y') ?? '' }}"
                                       data-datepicker data-datesync-enddate="#datetime_before"/>
                            </label>
                        </div>
                        <div class="small-12 large-6 columns">
                            <label for="datetime_before">
                                To
                                <input type="text" name="before" id="datetime_before"
                                       value="{{ report.beforeDate.usingFormat('d/m/Y') ?? '' }}"
                                       data-datepicker data-datesync-startdate="#datetime_after"/>
                            </label>
                        </div>
                    </div>

                </fieldset>
            </section>
            <div class="row">
                <div class="small-12  {% if config.pastoral_action_enable %}medium-6{% endif %} columns">
                    <label>
                        <h2 class="subheader">
                            <span class="required-with-tip">Record Types</span>
                        </h2>
                    </label>
                    <p class="meta">Select the record types you want to appear in the report</p>
                    <section>
                        <div class="small-12 columns content">
                            <div class="checklist">
                                <ul class="option-list">
                                    <li>
                                        <input id="type-all" type="checkbox" data-check-all-type>
                                        <label for="type-all">Select All</label>
                                    </li>
                                    {% for type in types %}
                                        <li>
                                            <div class="pastoral-types">
                                                <input id="type-{{ type.id }}"
                                                       name="types[]"
                                                       value="{{ type.id }}"
                                                       type="checkbox"
                                                       {% for typeSelected in (report.types ?? []) | filter(typeSelected => typeSelected.id == type.id ) %}checked{% endfor %}
                                                       data-check-type
                                                >

                                                {% set hasSubTypes = false %}
                                                {% for subtype in subTypes %}
                                                    {% if subtype.pastoralType.id == type.id %}
                                                        {% set hasSubTypes = true %}
                                                    {% endif %}
                                                {% endfor %}

                                                {% if hasSubTypes %}
                                                    <label for="type-{{ type.id }}" title="Select to reveal sub-types">
                                                        {{ type.name }}
                                                        <i class="icon-click-view size-8"></i>
                                                    </label>
                                                {% else %}
                                                    <label for="type-{{ type.id }}">
                                                        {{ type.name }}
                                                    </label>
                                                {% endif %}

                                                <div class="checklist" data-pastoral-subtype>
                                                    <ul class="option-list">
                                                        {% for subtype in subTypes %}

                                                            {% if subtype.pastoralType.id == type.id %}
                                                                <li>
                                                                    <input id="subtype-{{ subtype.id }}"
                                                                           name="subtypes[]"
                                                                           value="{{ subtype.id }}"
                                                                           type="checkbox"
                                                                           {% for subtypeSelected in (report.subtypes ?? []) | filter(subtypeSelected => subtypeSelected.id == subtype.id ) %}checked{% endfor %}
                                                                           data-check-subtype
                                                                    >
                                                                    <label for="subtype-{{ subtype.id }}">
                                                                        {{ subtype.name }}
                                                                    </label>
                                                                </li>
                                                            {% endif %}

                                                        {% endfor %}
                                                    </ul>
                                                </div>
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </section>
                </div>
                {% if config.pastoral_action_enable %}
                    <div class="small-12 medium-6 columns">
                        <h2 class="subheader">Actions</h2>
                        <p class="meta">Filter the report based on pending actions to be completed</p>
                        <section>
                            <fieldset class="radiolist content">
                                <div class="small-12 large-6 columns">
                                    <input type="radio" name="includeUncompletedActionsOnly"
                                           id="includeCompletedActionsOnly" value="0"
                                           {% if not report.includeUncompletedActionsOnly %}checked{% endif %} />
                                    <label for="includeCompletedActionsOnly">Any State</label>
                                </div>
                                <div class="small-12 large-6 columns">
                                    <input type="radio" name="includeUncompletedActionsOnly"
                                           id="includeUncompletedActionsOnly" value="1"
                                           {% if report.includeUncompletedActionsOnly %}checked{% endif %} />
                                    <label for="includeUncompletedActionsOnly">Pending Only</label>
                                </div>
                            </fieldset>
                            <fieldset class="content">
                                <div class="small-12 columns">
                                    <div class="checklist">
                                        <ul class="option-list">
                                            <li>
                                                <input id="action-all" type="checkbox" data-check-all-action>
                                                <label for="action-all">Select All</label>
                                            </li>
                                            <li>
                                                <input id="includeRecordsWithoutAction"
                                                       name="includeRecordsWithoutAction"
                                                       value="1"
                                                       type="checkbox"
                                                       {% if report.includeRecordsWithoutAction %}checked{% endif %}
                                                       data-check-action
                                                >
                                                <label for="includeRecordsWithoutAction">(No action)</label>
                                            </li>
                                            {% for action in actions %}
                                                <li>
                                                    <input id="action-{{ action.id }}"
                                                           name="actions[]"
                                                           value="{{ action.id }}"
                                                           type="checkbox"
                                                           {% for actionSelected in (report.actions ?? []) | filter(actionSelected => actionSelected == action) %}checked{% endfor %}
                                                           data-check-action
                                                    >
                                                    <label for="action-{{ action.id }}">{{ action.name }}</label>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </fieldset>
                        </section>
                    </div>
                {% endif %}
            </div>

            {# Pastoral moderators get an additional option to only show records in which they are involved #}

            {% if moderator %}
                <h2 class="subheader">{{ locale.pastoral.proper }} Moderator Visibility</h2>
                <section>
                    <div class="small-12 columns content">
                        <div class="checklist">
                            <label>
                                {{ locale.pastoral.proper }} Moderator Filter
                            </label>
                            <p class="meta">
                                As you are logged in as a {{ locale.pastoral }} moderator you have access to view all
                                records in the system. To filter the report to show only those incidents in which you
                                are
                                involved tick the checkbox below.
                            </p>
                            <input id="involved" name="involved" value="1" type="checkbox"
                                   {% if report.involved %}checked{% endif %}>
                            <label for="involved">
                                Only show records in which you are the author or an audience member
                            </label>
                        </div>
                    </div>
                </section>
            {% else %}
                <input type="hidden" id="involved-checkbox" value="1">
            {% endif %}

            <div class="row">
                <div class="small-12 medium-6 columns">
                    <label>
                        <h2 class="subheader">
                            <span class="required-with-tip">Year Levels</span>
                        </h2>
                    </label>
                    <p class="meta">Select the year levels you want included in the report</p>

                    <section>
                        <div class="small-12 columns content">
                            <div class="checklist">
                                <ul class="option-list">
                                    <li>
                                        <input id="year-all" type="checkbox" data-check-all-year>
                                        <label for="year-all">Select All</label>
                                    </li>
                                    <li>
                                        <input id="includeStudentsWithoutYear"
                                               name="includeStudentsWithoutYear"
                                               value="1"
                                               type="checkbox"
                                               {% if report.includeStudentsWithoutYear %}checked{% endif %}
                                               data-check-year
                                        >
                                        <label for="includeStudentsWithoutYear">(No Year Level)</label>
                                    </li>
                                    {% for year in years %}
                                        <li>
                                            <input id="year-{{ year.id }}"
                                                   name="years[]"
                                                   value="{{ year.id }}"
                                                   type="checkbox"
                                                   {% for yearSelected in (report.years ?? []) |filter(yearSelected => yearSelected.id == year.id ) %}checked{% endfor %}
                                                   data-check-year
                                            >
                                            <label for="year-{{ year.id }}">{{ year.longname }}</label>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="small-12 medium-6 columns">
                    <label>
                        <h2 class="subheader">
                            <span class="required-with-tip">Houses</span>
                        </h2>
                    </label>
                    <p class="meta">Select the houses you want included in the report</p>

                    <section>
                        <div class="small-12 columns content">
                            <div class="checklist">
                                <ul class="option-list">
                                    <li>
                                        <input id="house-all" type="checkbox" data-check-all-house>
                                        <label for="house-all">Select All</label>
                                    </li>
                                    <li>
                                        <input id="includeStudentsWithoutHouse"
                                               name="includeStudentsWithoutHouse"
                                               value="1"
                                               type="checkbox"
                                               {% if report.includeStudentsWithoutHouse %}checked{% endif %}
                                               data-check-house
                                        >
                                        <label for="includeStudentsWithoutHouse">(No House)</label>
                                    </li>
                                    {% for house in houses %}
                                        <li>
                                            <input id="house-{{ house.id }}"
                                                   name="houses[]"
                                                   value="{{ house.id }}"
                                                   type="checkbox"
                                                   {% for houseSelected in (report.houses ?? []) | filter(houseSelected => houseSelected == house) %}checked{% endfor %}
                                                   data-check-house
                                            >
                                            <label for="house-{{ house.id }}">{{ house.house }}</label>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="small-12 medium-6 columns">
                    <label>
                        <h2 class="subheader">
                            <span class="required-with-tip">Campuses</span>
                        </h2>
                    </label>
                    <p class="meta">Select the campuses you want included in the report</p>

                    <section>
                        <div class="small-12 columns content">
                            <div class="checklist">
                                <ul class="option-list">
                                    <li>
                                        <input id="campus-all" type="checkbox" data-check-all-campus>
                                        <label for="campus-all">Select All</label>
                                    </li>
                                    {% for campus in campuses %}
                                        <li>
                                            <input id="campus-{{ campus.id }}"
                                                   name="campuses[]"
                                                   value="{{ campus.id }}"
                                                   type="checkbox"
                                                   {% for campusSelected in (report.campuses ?? []) | filter(campusSelected => campusSelected == campus) %}checked{% endfor %}
                                                   data-check-campus
                                            >
                                            <label for="campus-{{ campus.id }}">{{ campus.name }}</label>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <h2 class="subheader">Sort Order</h2>
            <p class="meta">Select the order in which you would like your report sorted</p>
            <section>
                <ul id="sort-order" class="information-list sortable ui-sortable" data-sortable>
                    {% for order in report.order %}

                        {# This is a hideous hack to display these in the right order #}

                        {% if order == 'student' %}
                            <li data-order="student">
                                <div>
                                    <div class="grip"></div>
                                    <div class="card small-12">
                                        <p>Student Name</p>
                                    </div>
                                </div>
                            </li>
                        {% elseif order == 'date' %}
                            <li data-order="date">
                                <div>
                                    <div class="grip"></div>
                                    <div class="card small-12">
                                        <p>Published Date</p>
                                    </div>
                                </div>
                            </li>
                        {% elseif order == 'year' %}
                            <li data-order="year">
                                <div>
                                    <div class="grip"></div>
                                    <div class="card small-12">
                                        <p>Year Level</p>
                                    </div>
                                </div>
                            </li>
                        {% elseif order == 'house' %}
                            <li data-order="house">
                                <div>
                                    <div class="grip"></div>
                                    <div class="card small-12">
                                        <p>House</p>
                                    </div>
                                </div>
                            </li>
                        {% elseif order == 'campus' %}
                            <li data-order="campus">
                                <div>
                                    <div class="grip"></div>
                                    <div class="card small-12">
                                        <p>Campus</p>
                                    </div>
                                </div>
                            </li>
                        {% elseif order == 'points' %}
                            <li data-order="points">
                                <div>
                                    <div class="grip"></div>
                                    <div class="card small-12">
                                        <p>Points</p>
                                    </div>
                                </div>
                            </li>
                        {% elseif order == 'type' %}
                            <li data-order="type">
                                <div>
                                    <div class="grip"></div>
                                    <div class="card small-12 wrap-down">
                                        <p>
                                            Record Type
                                            <span class="meta">
                                                (
                                                {%- for type in types -%}
                                                    {{ type.name }}{% if not loop.last %}, {% endif %}
                                                {%- endfor -%}
                                                )
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </li>
                        {% elseif order == 'subtype' %}
                            <li data-order="subtype">
                                <div>
                                    <div class="grip"></div>
                                    <div class="card small-12 wrap-down">
                                        <p>
                                            Record Subtype
                                            <span class="meta">
                                                (
                                                {%- for subtype in subTypes -%}
                                                    {{ subtype.name }}{% if not loop.last %}, {% endif %}
                                                {%- endfor -%}
                                                )
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </li>
                        {% elseif order == 'severity' and severities | length %}
                            <li data-order="severity">
                                <div>
                                    <div class="grip"></div>
                                    <div class="card small-12 wrap-down">
                                        <p>
                                            {{ locale.severity.proper }}
                                            <span class="meta">
                                                (
                                                {%- for severity in severities -%}
                                                    {{ severity.name }}{% if not loop.last %}, {% endif %}
                                                {%- endfor -%}
                                                )
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </li>
                        {% elseif order == 'author' %}
                            <li data-order="author">
                                <div>
                                    <div class="grip"></div>
                                    <div class="card small-12">
                                        <p>Author Name</p>
                                    </div>
                                </div>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </section>

            {% if groups | length %}
                <h2 class="subheader">Shared Report</h2>
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>
                                {{ locale.pastoral.proper }} Groups
                                <span class="hint has-tip tip-top" data-tooltip
                                      title="Select the {{ locale.pastoral }} groups you would like to share this report with.">?</span>
                            </label>
                            <ul class="option-list">
                                {% for group in groups %}
                                    <li>
                                        <input type="hidden" name="group[{{ group.id }}]" value="0"/>
                                        <input type="checkbox"
                                               name="group[{{ group.id }}]"
                                               {% for reportGroup in (report.groups ?? []) | filter(reportGroup=>reportGroup.id == group.id) %}checked{% endfor %}
                                               id="group[{{ group.id }}]"
                                               value="1"
                                        />
                                        <label for="group[{{ group.id }}]"
                                               class="checkbox-label">{{ group.name }}</label>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </fieldset>
                </section>
            {% endif %}
            <section>
                <fieldset>
                    <div class="small-12 columns">
                        <label class="inline-block" for="notificationEnabled">Enable notification on new matching record
                            <span class="hint has-tip tip-top" data-tooltip
                                  title="Send a notification to you and anyone who the report is shared with when a new
                            record appears in this report.">?</span>
                        </label>
                        <div class="switch">
                            <input name="notificationEnabled" id="notificationEnabled" type="checkbox"
                                   {% if report.notificationEnabled %}checked="checked"{% endif %} value="1"/>
                            <label for="notificationEnabled">
                                <span>On</span>
                                <span>Off</span>
                            </label>
                        </div>
                    </div>
                </fieldset>
            </section>
            <input type="submit" value="Save Report"/>
        </form>
    </div>
</div>


<!--suppress JSValidateTypes -->
<script type="text/javascript">

    $(function () {

        var parentCheckboxSelector = "#formReport input[data-check-type]";
        var childCheckboxSelector = "input[data-check-subtype]";
        var childGroupSelector = "[data-pastoral-subtype]";

        // Initial setup: if any parent types are already checked (from saved data), show their subtypes
        // otherwise hide the subtypes to save space
        $(parentCheckboxSelector).each(function (index, parentCheckbox) {
            if ($(parentCheckbox).is(':checked')) {
                // ...show the subtypes for this type
                $(parentCheckbox).siblings(childGroupSelector).show();
            } else {
                // Hide subtypes by default to reduce vertical scrolling
                $(parentCheckbox).siblings(childGroupSelector).hide();
            }
        });

        // When a parent type checkbox is changed, show or hide its subtypes
        // and check them by default when shown
        $(parentCheckboxSelector).change(function (e) {
            var parentCheckbox = e.target;
            var $subCheckboxes = $(parentCheckbox).siblings(childGroupSelector).find(childCheckboxSelector);

            if ($(parentCheckbox).is(':checked')) {
                // ...show the subtypes for this type
                $(parentCheckbox).siblings(childGroupSelector).show();

                // ...and check them by default
                $subCheckboxes.each(function (index, subCheckbox) {
                    $(subCheckbox).prop('checked', true);
                });

                $(parentCheckbox).siblings("label").find("i").removeClass("icon-click-view").addClass("icon-dropdown");
            } else {
                // ...hide the subtypes for this type
                $subCheckboxes.each(function (index, subCheckbox) {
                    $(subCheckbox).prop('checked', false);
                    $(parentCheckbox).siblings(childGroupSelector).hide();
                });

                // ...and uncheck them (causes all sorts of problems with select all otherwise)
                $subCheckboxes.each(function (index, subCheckbox) {
                    $(subCheckbox).prop('checked', false);
                });

                $(parentCheckbox).siblings("label").find("i").removeClass("icon-dropdown").addClass("icon-click-view");
            }

        });

        // When a subtype checkbox is changed, find out if any subtypes in that group are still checked
        // and if not, uncheck the parent and hide the subtypes
        $(parentCheckboxSelector).each(function (index, parentCheckbox) {
            var $subtypes = $(parentCheckbox).siblings(childGroupSelector).find(childCheckboxSelector);

            $subtypes.change(function () {
                if ($subtypes.filter(":checked").length < 1) {
                    $(parentCheckbox).prop("checked", false);
                    $subtypes.parent(childGroupSelector).hide();
                    $(parentCheckbox).siblings("label").find("i").removeClass("icon-dropdown").addClass("icon-click-view");
                } else {
                    $(parentCheckbox).prop("checked", true);
                    $subtypes.parent(childGroupSelector).show();
                    $(parentCheckbox).siblings("label").find("i").removeClass("icon-click-view").addClass("icon-dropdown");
                }
            });
        })

        // Hide/show the relevant date range picker based on the user's radio button selection
        $("input[type='radio'][name='date-option']").change(function (e) {
            if ($("#relative-dates-option").is(":checked")) {
                $("#relative-dates").removeClass("hide");
                $("#absolute-dates").addClass("hide");
            } else {
                $("#absolute-dates").removeClass("hide");
                $("#relative-dates").addClass("hide");
            }
        });


        $('#sort-order').sortable({handle: '.grip', axis: 'y'});

        {# Toggle all checkboxes when the 'Select All' box is changed #}

        var $reportForm = $("#formReport");

        $reportForm.selectAll({
            selector: "#type-all",
            checkboxes: "[data-check-type]",
            childCheckboxes: "[data-check-subtype]",
            childCheckboxGroups: "[data-pastoral-subtype]"
        });

        $reportForm.selectAll({
            selector: '#year-all',
            checkboxes: '[data-check-year]'
        });

        $reportForm.selectAll({
            selector: '#house-all',
            checkboxes: '[data-check-house]'
        });

        $reportForm.selectAll({
            selector: '#campus-all',
            checkboxes: '[data-check-campus]'
        });

        $reportForm.selectAll({
            selector: '#action-all',
            checkboxes: '[data-check-action]'
        });

        {# Setup selectize boxes #}

        $('#filterStudents').selectizeSelector({
            multiple: true,
            ajax: {
                url: '/ajax/user.php',
                type: 'GET',
                data: {roleTypeID: 'student'},
                dataType: 'json'
            },
            value: [
                {% for student in studentsSelected %}
                {'id': '{{ student.id }}', 'name': '{{ student.name | escape('js') }}'},
                {% endfor %}
            ]
        });

        $('#filterTags').selectizeSelector({
            multiple: true,
            selectize: {
                preload: true,
                load: function (query, callback) {

                    /* This provides a preliminary list of suggestions for when selectize gets focus
                     * but there's no parameter upon which to search (initial conditions). This also
                     * happens to provide a list of filtered suggestions as you type using the optional
                     * $query var
                     */
                    $.ajax({
                        url: '{{ routeLookup('pastoral.searchTags') }}',
                        type: 'GET',
                        dataType: 'json',
                        data: {query: query}
                    }).done(function (result) {
                        callback(result)
                    }).fail(function () {
                        callback()
                    })
                }
            },
            value: [
                {% for tag in tagsSelected %}
                {'id': '{{ tag.id }}', 'name': '{{ tag.name | escape('js') }}'},
                {% endfor %}
            ]
        });

        $('#filterAuthors').selectizeSelector({
            multiple: true,
            ajax: {
                url: '/ajax/user.php',
                type: 'GET',
                data: {roleTypeID: 'staff'},
                dataType: 'json'
            },
            value: [
                {% for author in authorsSelected %}
                {'id': '{{ author.id }}', 'name': '{{ author.name | escape('js') }}'},
                {% endfor %}
            ]
        });

        {# Generate the report after a little sanity checking #}

        $reportForm.alaressValidate({
            rules: {
                'name': 'required',
                'types[]': 'required',
                'years[]': {
                    required: {
                        depends: function () {
                            return $('#includeStudentsWithoutYear').prop('checked') === false;
                        }
                    }
                },
                'houses[]': {
                    required: {
                        depends: function () {
                            return $('#includeStudentsWithoutHouse').prop('checked') === false;
                        }
                    }
                },
                'campuses[]': 'required',
                'after': {
                    datepickerDate: {
                        depends: function (element) {
                            return $(element).val().length > 0;
                        }
                    }
                },
                'before': {
                    datepickerDate: {
                        depends: function (element) {
                            return $(element).val().length > 0;
                        }
                    }
                }
            },
            messages: {
                'types[]': 'You must select at least one record type to show in the report',
                'years[]': 'You must select at least one year level to show in the report',
                'houses[]': 'You must select at least one house to show in the report',
                'campuses[]': 'You must select at least one campus to show in the report'
            },
            submitHandler: function (form) {
                {# Prior to submitting the form we need to set the hidden `order` #}
                var order = $.makeArray(
                        $('#sort-order').children('li')
                                .map(function () {
                                    return $(this).data('order');
                                })
                );

                $('#order').val(order.join(','));
                form.submit();
            }
        });
    });

</script>
