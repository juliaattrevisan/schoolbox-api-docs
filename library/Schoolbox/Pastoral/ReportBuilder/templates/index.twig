
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ locale.pastoralCare.proper,    routeLookup('pastoral.getIndex') ],
[ 'Reports' ]
) }}

<script>
    $(function () {
        $('[data-report-dashboard]').on('click', function () {
            $.post('{{ routeLookup('pastoralReportBuilder.postReportDashboardModify') }}', {
                reportId: $(this).attr('data-report-dashboard'),
                display: $(this).prop('checked') === true ? 1 : 0
            })
        });
    });
</script>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ locale.pastoralCare.proper }} Reports</h1>
        </div>
    </div>
</div>

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 island">
            <h2 class="subheader">Your Reports</h2>
        </div>
    </div>
    <nav>
        <a href="{{ routeLookup('pastoralReportBuilder.getReportInsert') }}" class="icon-add"
           title="New {{ locale.pastoral.proper }} Report"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        {% if reportsMine | length %}
            <section>
                <ul id="studentsList" class="information-list">
                    {% for report in reportsMine %}
                        {% include '@pastoralReportBuilder/report_row.twig' with {report: report, canEdit: true} %}
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
        {% include '@pastoralReportBuilder/report_empty.twig' with {hidden: (reportsMine | length)} %}
        {% if reportsGroup | length %}
            <h2 class="subheader">Shared Reports<span data-tooltip
                                                      title="These reports have been shared with you"
                                                      class="hint has-tip tip-top">?</span></h2>
            <section>
                <ul id="studentsList" class="information-list">
                    {% for report in reportsGroup %}
                        {% include '@pastoralReportBuilder/report_row.twig' with {report: report, canEdit: isModerator or report.canEdit(USER)} %}
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
        {% if reportsOther | length %}
            <h2 class="subheader">Report Administration<span data-tooltip
                                                      title="These reports have been shared by other users, as a {{ locale.pastoral }} admin you may modify these reports."
                                                      class="hint has-tip tip-top">?</span></h2>
            <section>
                <ul id="studentsList" class="information-list">
                    {% for report in reportsOther %}
                        {% include '@pastoralReportBuilder/report_row.twig' with {report: report, canEdit: isModerator or report.canEdit(USER)} %}
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </div>
</div>

<script>
    $(function () {
        $('[data-delete]').on('click', function (e) {
            e.preventDefault();

            var li = $(this).closest('li');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this report?',
                confirmLabel: 'Delete',
                confirmEvent: function (element) {
                    $.post(element.attr('href'))
                        .done(function () {
                            li.remove();
                            if ($('[data-delete]').length == 0) {
                                $('.empty-state').removeClass('hide');
                            }
                        });
                }
            });
        });
    });
</script>
