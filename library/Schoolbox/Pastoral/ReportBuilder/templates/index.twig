{% import '@pastoral/macros/profile.twig' as profile %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ locale.pastoralCare.proper,    routeLookup('pastoral.getIndex') ],
[ 'Reports' ]
) }}

<script>
    $(function () {
        $('[data-report-dashboard]').click(function () {
            $.post('{{ routeLookup('pastoralReportBuilder.postReportDashboardModify') }}', {
                reportId: $(this).attr('data-report-dashboard'),
                display: $(this).prop('checked') === true ? 1 : 0
            })
        });
    });
</script>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ locale.pastoralCare.proper }} Reports</h1>
        </div>
    </div>
</div>

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 island">
            <h2 class="subheader">Your Reports</h2>
        </div>
    </div>
    <nav>
        <a href="{{ routeLookup('pastoralReportBuilder.getReportInsert') }}" class="icon-add"
           title="New {{ locale.pastoral.proper }} Report"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        {% set found = 0 %}

        {% if reportsMine | length or reportsGroup | length %}
            {% for report in reportsMine %}
                {% if loop.first %}
                    {% set found = 1 %}
                    <section>
                    <ul id="studentsList" class="information-list">
                {% endif %}
                <li class="actions-small-3">
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="{{ profile.link(user) }}">
                                {{ profile.imageSquare64(user) }}
                            </a>
                            <a href='{{ routeLookup('pastoralReportBuilder.getReportResults', {reportId: report.id, report: report}) }}'>
                                <h3>{{ report.name }}</h3>
                            </a>
                            <p class="meta">
                                {% if report.notificationEnabled %}
                                    <i title="Notification Enabled" class="icon-bell"></i>
                                {% endif %}
                                <i title="{{ locale.pastoral.proper }} Groups" class="icon-group"></i>
                                {% if report.groups | length %}
                                    {% for group in report.groups %}
                                        {{ group.name }}{% if not loop.last %},{% endif %}
                                    {% endfor %}
                                {% else %}
                                    This report has not been shared with any groups
                                {% endif %}
                            </p>
                        </div>
                    </div>
                    <nav>
                        <input id="report-dashboard-{{ report.id }}"
                               {% if report.dashboard %}checked{% endif %}
                               data-report-dashboard="{{ report.id }}"
                               type="checkbox">
                        <label for="report-dashboard-{{ report.id }}" class="input-toggle"
                               title="Show report on dashboard">
                            <span class="icon-star alert"></span>
                        </label>
                        <a class="icon-modify no-text"
                           href="{{ routeLookup('pastoralReportBuilder.getReportUpdate', {reportId: report.id, report: report}) }}"
                           title="Modify Report"></a>
                        <a class="icon-delete no-text" data-delete="{{ report.id }}" href="#" title="Delete Report"></a>
                    </nav>
                </li>
            {% endfor %}

            {% if found == 1 %}
                </ul>
                </section>
                {% include '@pastoralReportBuilder/report_empty.twig' with {hidden: 1} %}

            {% else %}
                {% include '@pastoralReportBuilder/report_empty.twig' %}
            {% endif %}

            {% set found = 0 %}

            {% for report in reportsGroup %}

                {% if loop.first %}

                    {% set found = 1 %}
                    <h2 class="subheader">Shared Reports<span data-tooltip
                                                              title="These reports have been shared with you based on your {{ locale.pastoral }} group membership"
                                                              class="hint has-tip tip-top">?</span></h2>

                    <section>
                    <ul id="studentsList" class="information-list">

                {% endif %}

                <li class="actions-small-3">
                    <div class="card small-12">
                        <a href="{{ profile.link(report.owner) }}">
                            {{ profile.imageSquare64(report.owner) }}
                        </a>
                        <a href='{{ routeLookup('pastoralReportBuilder.getReportResults', {reportId: report.id, report: report}) }}'>
                            <h3>{{ report.name }}</h3>
                        </a>
                        <p class="meta">
                            <i title="{{ locale.pastoral.proper }} Groups" class="icon-group"></i>
                            {% for group in report.groups %}
                                {{ group.name }}{% if not loop.last %},{% endif %}
                            {% endfor %}
                        </p>
                    </div>
                    <nav>
                        <input id="report-dashboard-{{ report.id }}"
                               {% if report.dashboard %}checked{% endif %}
                               data-report-dashboard="{{ report.id }}"
                               type="checkbox">
                        <label for="report-dashboard-{{ report.id }}" class="input-toggle"
                               title="Show report on dashboard">
                            <span class="icon-star alert"></span>
                        </label>
                    </nav>
                </li>
            {% endfor %}

            {% if found == 1 %}
                </ul>
                </section>
            {% endif %}

        {% else %}

            {% include '@pastoralReportBuilder/report_empty.twig' %}

        {% endif %}
    </div>
</div>

<script>
    $(function () {
        $('[data-delete]').click(function (e) {
            e.preventDefault();

            var reportId = $(this).attr('data-delete');
            var li = $(this).closest('li');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this report?',
                confirmLabel: 'Delete',
                confirmEvent: function () {
                    var route = '{{ routeLookup('pastoralReportBuilder.postReportDelete', {'reportId': '_reportId'}) }}';

                    $.post(route.replace(/_reportId/g, reportId))
                        .done(function () {
                            li.remove();

                            if ($('[data-delete]').length == 0) {
                                $('.empty-state').removeClass('hide');
                            }
                        });
                }
            });
        });
    });
</script>
