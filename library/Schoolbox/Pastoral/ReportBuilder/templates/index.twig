{% import '@pastoral/macros/profile.twig' as profile %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ 'Pastoral Care',    routeLookup('pastoral.getIndex') ],
[ 'Reports' ]
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Pastoral Care Reports</h1>
        </div>
    </div>
</div>

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 island">
            <h2 class="subheader">Your Saved Reports</h2>
        </div>
    </div>
    <nav>
        <a href="{{ routeLookup('pastoralReportBuilder.getReportInsert') }}" class="icon-add" title="New Pastoral Report"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        {% set found = 0 %}

        {% if reports | length %}
            {% for report in reports if report.owner.id == user.id %}
                {% if loop.first %}
                    {% set found = 1 %}
                    <section>
                    <ul id="studentsList" class="information-list">
                {% endif %}
                <li class="actions-small-2">
                    <div class="list-item">
                        <div class="card small-12">

                            <a href="{{ profile.link(user) }}">
                                {{ profile.imageSquare64(user) }}
                            </a>
                            <a href='{{ routeLookup('pastoralReportBuilder.getReportResults', {reportId: report.id}) }}'>
                                <h3>{{ report.name }}</h3>
                            </a>
                            <p class="meta">
                                <i title="Pastoral Groups" class="icon-group"></i>
                                {% if report.groups | length %}
                                    {% for group in report.groups %}
                                        {{ group.name }}{% if not loop.last %},{% endif %}
                                    {% endfor %}
                                {% else %}
                                    This report has not been shared with any groups
                                {% endif %}
                            </p>
                        </div>
                    </div>
                    <nav>
                        <a class="icon-modify no-text" href="{{ routeLookup('pastoralReportBuilder.getReportUpdate', {reportId: report.id}) }}" title="Modify Report"></a>
                        <a class="icon-delete no-text" href="#" title="Delete Report"></a>
                    </nav>
                </li>
            {% endfor %}

            {% if found == 1 %}
                </ul>
                </section>
            {% else %}

                <div class="empty-state">
                    <i class="icon-report"></i>
                    <p>You do not have any saved pastoral care reports.</p>
                    <p><a href="{{ routeLookup('pastoralReportBuilder.getReportInsert') }}" title="New Pastoral Report">Create your first report.</a></p>
                </div>

            {% endif %}

            {% set found = 0 %}

            {% for report in reports if report.owner.id != user.id %}

                {% if loop.first %}

                    {% set found = 1 %}
                    <h2 class="subheader">Shared Pastoral Reports</h2>
                    <p class="meta">These reports have been shared with you based on your pastoral group membership.</p>
                    <section>
                    <ul id="studentsList" class="information-list">

                {% endif %}

                <li>
                    <div class="card small-12">
                        <a href="{{ profile.link(report.owner) }}">
                            {{ profile.imageSquare64(report.owner) }}
                        </a>
                        <a href='{{ routeLookup('pastoralReportBuilder.getReportResults', {reportId: report.id}) }}'>
                            <h3>{{ report.name }}</h3>
                        </a>
                        <p class="meta">
                            <i title="Pastoral Groups" class="icon-group"></i>
                            {% for group in report.groups %}
                                {{ group.name }}{% if not loop.last %},{% endif %}
                            {% endfor %}
                        </p>
                    </div>
                </li>
            {% endfor %}

            {% if found == 1 %}
                </ul>
                </section>
            {% endif %}

        {% else %}
            <div class="empty-state">
                <i class="icon-report"></i>
                <p>You do not have any saved pastoral care reports.</p>
                <p><a href="{{ routeLookup('pastoralReportBuilder.getReportInsert') }}" title="New Pastoral Report">Create your first report.</a></p>
            </div>
        {% endif %}
    </div>
</div>
