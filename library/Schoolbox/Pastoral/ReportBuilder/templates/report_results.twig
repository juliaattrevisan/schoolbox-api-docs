{% import '@pastoral/macros/profile.twig' as profile %}

<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/core/schoolbox-ck-content.css?v={{ config.site_version }}"/>
<ul class="breadcrumb hide-on-print">
    <li><a href="{{ routeLookup('pastoral.getIndex') }}">{{ locale.pastoralCare.proper }}</a></li>
    <li><a href="{{ routeLookup('pastoralReportBuilder.getIndex') }}">Reports</a></li>
    <li class="active"><span>{{ title }}</span></li>
</ul>

<div id="pastoral-report-container" class="f-container">
    <pastoral-report
        title="{{ title }}"
        :export="{{ export ? 'true' : 'false' }}"
        :report-id="{{ report.id }}"
        :tabs="{{ tabs|json_encode }}"
        :config="{{ {
            pastoralPointEnabled: config.pastoral_point_enabled,
            pastoralActionEnable: config.pastoral_action_enable
        }|json_encode }}"
        :routes="{{ {
            getStudentRecord: routeLookup('pastoral.getStudentRecord'),
            getReportTags: routeLookup('pastoralReportBuilder.getReportTags'),
            getIndex: routeLookup('pastoralReportBuilder.getIndex'),
            getReportResultsExport: routeLookupIfAuthorized('pastoralReportBuilder.getReportResultsExport', {reportId: report.id})
        }|json_encode }}"
        locale-pastoral="{{ locale.pastoral.proper|lower }}"
        :show-severity="{{ showSeverity ? 'true' : 'false' }}"
        :severity-colors="{{ severityColors|json_encode }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/pastoralReport.js?v={{ config.site_version }}"></script>
