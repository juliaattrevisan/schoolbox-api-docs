{% import '@pastoral/macros/profile.twig' as profile %}
<li class="actions-small-3">
    <div class="list-item">
        <div class="card small-12">
            <a href="{{ profile.link(report.owner) }}">
                {{ profile.imageSquare64(report.owner) }}
            </a>
            <a href='{{ routeLookup('pastoralReportBuilder.getReportResults', {reportId: report.id, report: report}) }}'>
                <h3>{{ report.name }}</h3>
            </a>
            <p class="meta">
                {% if report.notificationEnabled %}
                    <sbx-icon name="notifications" title="Notification Enabled"></sbx-icon>
                {% endif %}
                {% set firstGroup = true %}
                {% for access in report.access %}
                    {% if access.group %}
                        {% if firstGroup %}
                            <sbx-icon name="group" title="{{ locale.pastoral.proper }} Groups"></sbx-icon>
                            {% set firstGroup = false %}
                        {% endif %}
                        {{ access.group.name }}{% if not loop.last %},{% endif %}
                    {% endif %}
                {% endfor %}
            </p>
        </div>
    </div>
    <nav>
        <input id="report-dashboard-{{ report.id }}"
               {% if report.dashboard %}checked{% endif %}
               data-report-dashboard="{{ report.id }}"
               type="checkbox">
        <label for="report-dashboard-{{ report.id }}" class="input-toggle"
               title="Show report on dashboard">
            <sbx-icon name="favourite"></sbx-icon>
        </label>
        {% if canEdit %}
                <a class="sbx-icon-only-button no-text"
               href="{{ routeLookup('pastoralReportBuilder.getReportUpdate', {reportId: report.id, report: report}) }}"
                    title="Modify Report"
                    aria-label="Modify Report"><sbx-icon name="modify"></sbx-icon></a>
                <a class="sbx-icon-only-button no-text"
               data-delete="{{ report.id }}"
               href="{{ routeLookup('pastoralReportBuilder.postReportDelete', {reportId: report.id, report: report}) }}"
               title="Delete Report"
                    aria-label="Delete Report"
                ><sbx-icon name="delete"></sbx-icon></a>
        {% endif %}
    </nav>
</li>
