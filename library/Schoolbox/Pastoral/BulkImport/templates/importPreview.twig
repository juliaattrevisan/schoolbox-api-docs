{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Administration', routeLookup('adminHome.getIndex') ],
    [ 'Pastoral Care'],
    [ 'Bulk Import', routeLookup('pastoralBulkImport.getForm') ],
    [ 'Preview' ],
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ locale.pastoral.proper }} Bulk Import Preview</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <form class="top" method="post"
              action="{{ routeLookupIfAuthorized('pastoralBulkImport.postRunImport', {id: import.id}) }}?{{ RETURN_URL.name }}={{ returnUrl }}"
        >
            <table>
                <thead>
                <tr>
                    <th>Time</th>
                    <th>File uploaded</th>
                    <th>External ID</th>
                    <th>Student</th>
                    <th>Import Result</th>
                </tr>
                </thead>
                <tbody>
                {% for file in files %}
                    <tr>
                        <td>&mdash;</td>
                        <td>{{ file.filename }}</td>
                        <td>
                            {% if file.externalId %}
                                {{ file.externalId }}
                            {% else %}
                                &mdash;
                            {% endif %}
                        </td>
                        <td>
                            {% if file.user %}
                                {{ file.user.formatName }}
                            {% elseif file.externalId %}
                                <i>No student found for external ID</i>
                            {% else %}
                                &mdash;
                            {% endif %}
                        </td>
                        <td>&mdash;</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            {% include '@pastoralBulkImport/fragments/userProfileLink.twig' with {
                typeId:    import.type.id,
                subtypeId: import.subType.id,
            } only %}

            {% import '@pastoralBulkImport/macros/outputForm.twig' as outputForm %}
            {{ outputForm.outputForm(formVars) }}

            <input type="submit" value="Import" />
        </form>
    </div>
</div>
