{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ locale.pastoralCare.proper, routeLookup('pastoral.getIndex') ],
    [ 'Bulk Import', routeLookup('pastoralBulkImport.getForm') ],
    [ 'Preview' ],
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ locale.pastoral.proper }} Bulk Import Preview</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <form class="top" method="post"
              action="{{ routeLookupIfAuthorized('pastoralBulkImport.postImport') }}?{{ RETURN_URL.name }}={{ returnUrl }}"
        >
            <table>
                <thead>
                <tr>
                    <th>Time</th>
                    <th>File uploaded</th>
                    <th>External ID</th>
                    <th>Student</th>
                    <th>Import Result</th>
                </tr>
                </thead>
                <tbody>
                {% for file in files %}
                    <tr>
                        <td>&mdash;</td>
                        <td>{{ file.filename }}</td>
                        <td>
                            {% if file.externalId %}
                                {{ file.externalId }}
                            {% else %}
                                &mdash;
                            {% endif %}
                        </td>
                        <td>
                            {% if file.user %}
                                {{ file.user.formatName }}
                            {% elseif file.externalId %}
                                <i>No student found for external ID</i>
                            {% else %}
                                &mdash;
                            {% endif %}
                        </td>
                        <td>&mdash;</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            {# Ensure the previously submitted form inputs are preserved #}
            {% macro outputForm(vars, prefix = '') %}
                {% for name, value in vars %}
                    {% if prefix %}
                        {% set inputName = prefix ~ '[' ~ name ~ ']' %}
                    {% else %}
                        {% set inputName = name %}
                    {% endif %}
                    {% if value is iterable  %}
                        {{ _self.outputForm(value, inputName) }}
                    {% else %}
                        <input type="hidden" name="{{ inputName }}" value="{{ value }}" />
                    {% endif %}
                {% endfor %}
            {% endmacro %}
            {{ _self.outputForm(formVars) }}

            <input type="submit" value="Import" />
        </form>
    </div>
</div>
