{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

{% if showAdminNavMenu%}
<div class="admin-container row">
    {{ renderAdminNavigation(routeLookup('pastoralBulkImport.getList')) }}
    <div class="admin-content">
        {# The divs opened above will be closed at the bottom of the page. #}
{% else %}
<div class='row'>
    <div class='small-12 columns'>
        <h1>{{ locale.pastoralCare.proper }} Bulk Import</h1>
    </div>
</div>
{% endif %}
<div class="small-12 island">
    <h2 class="subheader">Create {{ locale.pastoral.proper }} Bulk Import</h2>
    <form class="top" id="pastoralForm" method="post"
          action="{{ routeLookupIfAuthorized('pastoralBulkImport.postCreateImport') }}?{{ RETURN_URL.name }}={{ RETURN_URL.previous.encoded }}">
        <section>
            <fieldset class="content">
                <div class="small-12 columns">
                    <label class="required" for="heading">Title</label>
                    <input type="text" name="heading" id="heading" size="35" maxlength="100" required/>
                </div>
                <div class="small-12 columns">
                    <label class="required" for="ReportZone">ZIP File</label>
                    <p class="meta">
                        A {{ locale.pastoral }} record will be created for each unique student identifiable within the uploaded ZIP file.
                        If multiple files provided for a single student, they will be attached together in a single record.
                    </p>
                    {% include 'sub/attachzone.twig' with {attachzone: reportAttachzone} %}
                    <input type="hidden" name="report-file" id="report-file"/>
                </div>
                <div class="small-12 columns">
                    <label class="required" for="template">Filename pattern</label>
                    <p class="meta">
                        The pattern which was used to generate paths for files within the ZIP file above.

                        [externalId] must be part of this pattern: that value is used to identify the
                        student to which each file should be attributed.
                    </p>
                    <input type="text" name="template" id="template" size="35" maxlength="100" required pattern=".*\[externalId\].*" value="[externalId]/Semester Report - [firstname] [surname].pdf"/>
                </div>
            </fieldset>

            <fieldset class="content">
                <div class="small-12 medium-6 columns">
                    <label for="typeId" class="required">Type</label>
                    <select name="typeId" id="typeId" required>
                        <option disabled selected>Please select a type</option>
                        {% for type in types %}
                            <option value="{{ type.id }}"
                                    {% if not moderator %}data-visibility-locked="{{ type.visibilityLocked }}"{% endif %}
                            >{{ type.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="small-12 medium-6 columns">
                    <label for="subtypeId">Sub-Type</label>
                    <select name="subtypeId" id="subtypeId">
                        {% for subtype in subTypes %}
                            <option data-chained="{{ subtype.pastoralType.id }}"
                                    class="{{ subtype.pastoralType.id }}"
                                    value="{{ subtype.id }}"
                                    {% if not moderator %}data-visibility-locked="{{ subtype.visibilityLocked }}"{% endif %}
                            >{{ subtype.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="small-12 medium-12 columns">
                    <label for="expiresAt">
                        Expires At
                        <span
                            class="hint has-tip tip-top"
                            data-tooltip
                            title="Select when the record will expire. Expired records will move to an archived state."
                        >?</span>
                    </label>
                    <input type="text" name="expiresAt" id="expiresAt" maxlength="50" value="" {% if canModifyExpiresAt %}data-datepicker{% else %}readonly{% endif %} />
                </div>
                <div class="small-12 medium-6 columns">
                    {% if severities | length %}
                        <label for="severityId">{{ locale.severity.proper }}</label>
                        <select name="severityId" id="severityId">
                            {% for severity in severities %}
                                <option value="{{ severity.id }}">{{ severity.name }}</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </div>
                {% if config.pastoral_point_enabled %}
                    <div class="small-12 medium-6 columns">
                        {# This label is intentionally unusual, there exists custom JS that PST uses occasionally which targets
                         this <input> field, moving up one will break the form. See SA-18992 for more. #}
                        <label for="points"> Points </label><input id="points" type="text" inputmode="numeric" name="points" {% if canModifyPoints == false %}readonly {% endif %}/>
                    </div>
                {% endif %}
                <div class="small-12 columns">
                    <label for="tags">Tags</label>
                    <p class="meta">
                        Tags can be added to support {{ locale.pastoral }} reports and filtering.
                    </p>
                    <input id="tags" name="tags">
                    <input id="tagNames" type="hidden" name="tagNames">
                </div>
            </fieldset>

            <fieldset>
                <div class="small-12 columns">
                    <label for="body_public">General content</label>
                    <p class="meta">
                        Generally available content which will be added to each {{ locale.pastoral }} record
                        created by this import.

                        (Student detail tokens can be viewed when you press [.
                        Tokens will be substituted with the student&rsquo;s details on creation.)
                    </p>
                    <textarea id="body_public" name="body_public"></textarea>
                </div>
            </fieldset>
        </section>

        {% include "@pastoral/modify_section_visibility.twig" with {
            record: record,
            allowIndividual: allowIndividual,
            groups: groups,
            allowParents: allowParents,
            allowStudents: allowStudents,
            roles: roles,
            roleTypes: roleTypes,
            roleUserCounts: roleUserCounts,
            moderatorIds: moderatorIds,
            bulkCreate: false,
            managePage: true,
            reportPage: false,
        } only %}

        <input type="submit" data-submit value="Preview">
    </form>
</div>
{% include "@pastoral/modify_scripts.twig" with {
    record: record,
    canCreate: true,
    students: '[]',
    audiences: audiences,
    typesIndex: typesIndex,
    typesIndexPrivate: typesIndexPrivate,
    typesIndexDefaultPoints: typesIndexDefaultPoints,
    subtypesIndex: subtypesIndex,
    subtypesIndexPrivate: subtypesIndexPrivate,
    subtypesIndexDefaultPoints: subtypesIndexDefaultPoints,
} only %}

{% if showAdminNavMenu %}
    </div>
</div>
{% endif %}

{% autoescape('js') %}
<script type="text/javascript">
    $(function () {
        const subtypesIndexDefaultExpiry = {{ subtypesIndexDefaultExpiry|json_encode|raw }};
        const typesIndexDefaultExpiry = {{ typesIndexDefaultExpiry|json_encode|raw }};

        const isExistingRecord = {{ record.id != '' ? "true" : "false"  }};
        const expiresAt = '{{ record.expiresAt ? record.expiresAt.localShort : null }}';
        const calculatedExpiresAt = {{ calculatedExpiresAt|json_encode|raw }};

        /**
         * When the expires at date has manually changed, this takes precedence and
         * any further changes when type/sub-type is changed will not update the expires at date.
         * Rather conveniently, the jQuery .onChange will not trigger when the expiresAt.value is changed within
         * the updateExpiresAt method, so we don't need to worry about this being triggered when it shouldn't be.
         */
        let hasManualExpiresAtInput = false;

        $("#expiresAt").on("change", function () {
            hasManualExpiresAtInput = true;
        });

        /**
         * Check if the expires at date can be updated when the type/sub-type is changed
         * We prevent updating the expires at date if the record is existing, the expires at date is set,
         * or if there is a manual input for the expires at date
         * @returns boolean
         */
        function canUpdateExpiresAt() {
            return !isExistingRecord && expiresAt === "" && !hasManualExpiresAtInput;
        }
        /**
         * Update the expires at date based on the current type / subtype selection
         * @param defaultExpiry
         */
        function updateExpiresAt (defaultExpiry) {
            if (!canUpdateExpiresAt()) {
                return;
            }
            // ensure expiresAt actually exists before setting the value
            const expiresAtElement = document.getElementById("expiresAt");
            if (expiresAtElement === null) {
                return;
            }
            // if the new type/sub-type Default Expiry is set to 'Never', clear the previously set value and return
            if (defaultExpiry === null || defaultExpiry === "") {
                expiresAtElement.value = "";
                return;
            }
            // otherwise set the expires at date based on the Default Expiry that was set
            expiresAtElement.value = calculatedExpiresAt[defaultExpiry] ?? '';
        }

        /* Some convenient selectors
         */
        const typeDropdown = $('#typeId');
        const subtypeDropdown = $('#subtypeId');

        /* Whenever Subtype changes, see if the now-selected subtypeId is null
         * Decide which template to load
         */
        subtypeDropdown.on('change', function(event) {
            init(typeDropdown.val(), subtypeDropdown.val());
        });

        {% if record.id != '' %}
        /* Get the current entry tip when modifying the record
         */
        if (subtypeDropdown.val() === null) {
            let typeEntryTip = typesIndexEntryTip[typeDropdown.val()];
            updateExpiresAt(typeEntryTip != null ? typeEntryTip.trim() : null);
        } else {
            let subtypeEntryTip = subtypesIndexEntryTip[subtypeDropdown.val()];
            updateExpiresAt(subtypeEntryTip != null ? subtypeEntryTip.trim() : null);
        }
        {% endif %}
        /**
         * Update the entry tip and expires at date based on the type / subtype selection
         */
        function init(typeVal, subtypeVal) {
            if (null !== subtypeVal) {
                let subtypeExpiry = subtypesIndexDefaultExpiry[subtypeVal];
                updateExpiresAt(subtypeExpiry != null ? subtypeExpiry.trim() : null);
            } else {
                let typeExpiry = typesIndexDefaultExpiry[typeVal];
                updateExpiresAt(typeExpiry != null ? typeExpiry.trim() : null);
            }
        }
    })
</script>
{% endautoescape %}
