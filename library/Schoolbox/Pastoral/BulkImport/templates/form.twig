{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ locale.pastoralCare.proper, routeLookup('pastoral.getIndex') ],
    [ 'Bulk Upload' ]
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ locale.pastoral.proper }} Bulk Upload</h1>
        </div>
    </div>
</div>

{# Can this user access summative reports? If so, they can go there and download one. #}

{# The actual pastoral form #}
<div class="row">
    <div class="small-12 island" id="formPastoral">
        {# TODO replace with actual form input #}
        <form class="top" id="pastoralForm" method="post"
              action="?{{ RETURN_URL.name }}={{ RETURN_URL.previous.encoded }}">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label class="required" for="heading">Title</label>
                        <p class="meta">Each {{ locale.pastoral }} record created will have this title.</p>
                        <input type="text" name="heading" id="heading" size="35" maxlength="100" required />
                    </div>
                    <div class="small-12 columns">
                        <label class="required" for="ReportZone">ZIP File</label>
                        <p class="meta">The ZIP file which contains the files to upload to the created records.</p>
                        {% include 'sub/attachzone.twig' with {attachzone: reportAttachzone} %}
                    </div>
                    <div class="small-12 columns">
                        <label class="required" for="template">File path template</label>
                        <p class="meta">
                            The template which was used to generate paths for files within the ZIP file above.

                            [externalId] must be part of this template: that value is used to identify the student to
                            which each file should be attributed.
                        </p>
                        <input type="text" name="template" id="template" size="35" maxlength="100" required />
                    </div>
                </fieldset>

                <fieldset class="content">
                    <div class="small-12 medium-6 columns">
                        <label for="typeId" class="required">Type</label>
                        <select name="typeId" id="typeId" required>
                            <option disabled selected>Please select a type</option>
                            {% for type in types %}
                                <option value="{{ type.id }}">{{ type.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label for="subtypeId" class="required">Sub-Type</label>
                        <select name="subtypeId" id="subtypeId">
                            {% for subtype in subTypes %}
                                <option data-chained="{{ subtype.pastoralType.id }}"
                                        class="{{ subtype.pastoralType.id }}"
                                        value="{{ subtype.id }}"
                                >{{ subtype.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="small-12 columns">
                        <label for="tags">Tags</label>
                        <p class="meta">Tags can be added to support {{ locale.pastoral }} reports and filtering.</p>
                        <input id="tags" name="tags">
                        <input id="tagNames" type="hidden" name="tagNames">
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/chained/jquery.chained.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function () {
        $('#tags').selectizeSelector({
            multiple: true,
            selectize: {
                create: function (input) {
                    $('#tagNames').val($('#tagNames').val()+','+input);
                    return {
                        id: 'new-' + input,
                        name: input
                    }
                },
                preload: true,
                load: function(query, callback) {
                    $.ajax({
                        url: '{{ routeLookup('pastoral.searchTags') }}',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: query }
                    }).done(function(result) {
                        callback(result)
                    }).fail(function() {
                        callback()
                    })
                }
            },
            value: []
        });

        $('#subtypeId').chained('#typeId');
    });
</script>
