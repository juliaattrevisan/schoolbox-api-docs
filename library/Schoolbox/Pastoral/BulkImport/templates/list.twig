{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ locale.pastoralCare.proper, routeLookup('pastoral.getIndex') ],
    [ 'Bulk Import' ],
) }}

{% set createRoute = routeLookupIfAuthorized('pastoralBulkImport.getCreateImportForm') %}
<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ locale.pastoral.proper }} Bulk Imports</h1>
        </div>
    </div>
    <nav>
        {% if createRoute %}
            <a href="{{ createRoute }}" class="icon-add" title="Add a summative report"></a>
        {% endif %}
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        {% if imports is not empty %}
            <section>
                <ul class="information-list">
                    {% for import in imports %}
                        <li>
                            <div class="actions-small-1">
                                <div class="card small-12">
                                    {% set getRoute = routeLookupIfAuthorized('pastoralBulkImport.getImport', {id: import.id, import: import}) %}
                                    <h3>
                                        {% if getRoute %}
                                            <a href="{{ getRoute }}">{{ import.heading }}</a>
                                        {% else %}
                                            {{ import.heading }}
                                        {% endif %}
                                    </h3>

                                    {# Metadata: when it was imported, when it was undone #}
                                    <p class="meta">
                                        Created {{ import.createdAt.local }} by
                                        {% if import.owner.deleted %}
                                            {{ report.updatedBy.fullname }}
                                        {% else %}
                                            <a href="/search/user/{{ import.owner.id }}" title="{{ import.owner.fullname }}">{{ import.owner.fullname }}</a>
                                        {% endif %}
                                    </p>

                                    <p class="meta">
                                        {% if import.importedAt %}
                                            Imported {{ import.importedAt.local }}.
                                        {% else %}
                                            Not yet imported.
                                        {% endif %}
                                    </p>

                                    {# Buttons: run, undo, modify, archive?, delete?, archive? #}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-upload"></i>
                <p>No {{ locale.pastoral }} bulk imports have yet been performed.</p>
                {% if createRoute %}
                    <p><a href="{{ createRoute }}">Click here</a> to perform a bulk import.</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
