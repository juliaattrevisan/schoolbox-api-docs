{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ locale.pastoralCare.proper, routeLookup('pastoral.getIndex') ],
    [ 'Bulk Import', routeLookup('pastoralBulkImport.getList') ],
    [ 'Results' ],
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ locale.pastoral.proper }} Bulk Import Results</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <table>
            <thead>
            <tr>
                <th>Time</th>
                <th>File uploaded</th>
                <th>External ID</th>
                <th>Student</th>
                <th>Import Result</th>
            </tr>
            </thead>
            <tbody>
            {% for data in import.importLog.known %}
                {% for file in data.files %}
                    <tr>
                        <td>
                            {% if import.importedAt %}
                                {{ import.importedAt.local }}
                            {% else %}
                                &mdash;
                            {% endif %}
                        </td>
                        <td>{{ file }}</td>
                        <td>
                            {% if data.user.externalId %}
                                {{ data.user.externalId }}
                            {% else %}
                                &mdash;
                            {% endif %}
                        </td>
                        <td>
                            {{ data.user.name }}
                        </td>
                        <td>
                            {% if data.record ?? false %}
                                Created
                                (<a href="{{ routeLookup('pastoral.getStudentRecord', {studentId: data.user.id, recordId: data.record.id}) }}">#{{ data.record.id }}</a>)
                            {% else %}
                                &mdash;
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            {% endfor %}

            {% for data in import.importLog.unknown %}
                <tr>
                    <td>&mdash;</td>
                    <td>{{ data.file }}</td>
                    <td>
                        {% if data.user.externalId %}
                            {{ data.user.externalId }}
                        {% else %}
                            &mdash;
                        {% endif %}
                    </td>
                    <td>&mdash;</td>
                    <td>
                        <i>{{ data.reason }}</i>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% include '@pastoralBulkImport/fragments/userProfileLink.twig' with {
            typeId:    import.type.id,
            subtypeId: import.subType.id,
        } only %}

        <ul class="flex-list buttons">
            {% if not import.importedAt %}
                <li>
                    <form class="top" method="post"
                          action="{{ routeLookupIfAuthorized('pastoralBulkImport.postRunImport', {id: import.id}) }}?{{ RETURN_URL.name }}={{ returnUrl }}"
                    >
                        <input type="submit" value="Import" />
                    </form>
                </li>
            {% endif %}
            <li>
                <a href="{{ RETURN_URL.previous.decoded ?? routeLookup('pastoral.getIndex') }}">Return</a>
            </li>
        </ul>
    </div>
</div>
