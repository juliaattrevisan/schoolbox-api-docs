{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ locale.pastoralCare.proper, routeLookup('pastoral.getIndex') ],
    [ 'Bulk Import', routeLookup('pastoralBulkImport.getForm') ],
    [ 'Results' ],
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ locale.pastoral.proper }} Bulk Import Results</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <table>
            <thead>
            <tr>
                <th>Time</th>
                <th>File uploaded</th>
                <th>External ID</th>
                <th>Student</th>
                <th>Import Result</th>
            </tr>
            </thead>
            <tbody>
            {% for file in files %}
                <tr>
                    <td>
                        {% if file.record %}
                            {{ file.record.createdAt.timeOnly }}
                        {% else %}
                            &mdash;
                        {% endif %}
                    </td>
                    <td>{{ file.filename }}</td>
                    <td>
                        {% if file.externalId %}
                            {{ file.externalId }}
                        {% else %}
                            &mdash;
                        {% endif %}
                    </td>
                    <td>
                        {% if file.user %}
                            {{ file.user.formatName }}
                        {% elseif file.externalId %}
                            <i>No student found for external ID</i>
                        {% else %}
                            &mdash;
                        {% endif %}
                    </td>
                    <td>
                        {% if file.record %}
                            Created
                            (<a href="{{ routeLookup(
                                'pastoral.getStudentRecord',
                                {studentId: file.record.student.id, recordId: file.record.id}
                            ) }}">#{{ file.record.id }}</a>)
                        {% else %}
                            No record created
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% include '@pastoralBulkImport/fragments/userProfileLink.twig' with {
            typeId:    typeId,
            subtypeId: subtypeId,
        } only %}

        <a href="{{ RETURN_URL.previous.decoded ?? routeLookup('pastoral.getIndex') }}" class="submit">Return</a>
    </div>
</div>
