{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@pastoral/macros/profile.twig' as profile %}
{% import '@pastoral/macros/user_search.twig' as userSearch %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

{% if showAdminNavMenu%}
<div class="admin-container row">
    {{ renderAdminNavigation(routeLookup('pastoralManagement.getGroups')) }}
<div class="admin-content">
{# The divs opened above will be closed at the bottom of the page. #}
{% else %}
<div class='row'>
    <div class='small-12 columns'>
        <h1>{{ locale.pastoralCare.proper }} Groups</h1>
    </div>
</div>
{% endif %}

{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
{# We need a guid for the user select modal #}
{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

{% set guid = getGuid() %}

<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">{{ heading }}</h2>
    </div>
</div>

{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}
{# Pastoral group form #}
{# ------------------------------------------------------------------------------------------------------------------------------------------------------ #}

<div class="row">
    <div class="small-12 island">
        <form id="formGroup" method="post" action="{{ routeLookup('pastoralManagement.postGroupsModify') }}">
            <input type="hidden" name="id" value="{{ group.id }}">
            <input type="hidden" id="members" name="members" value="">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Group Name
                            <input id="groupName"
                                   type="text"
                                   placeholder="Enter group name"
                                   class="required"
                                   name="name"
                                   size="35"
                                   maxlength="100"
                                   value="{{ group.name }}"/>
                        </label>
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>

{# --------------------------------------------------------------------------------------------------------------------------------------------#}
{# The list of existing group members #}
{# --------------------------------------------------------------------------------------------------------------------------------------------#}

<div id="groupMembers" class="row">
    <div class="small-12 island">

        <div class="row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Group Members</h2>
                </div>
            </div>
        </div>

        {# --------------------------------------------------------------------------------------------------------------------------------------------#}
        {# This HTML is duplicated inside the `searchModal.twig` file for the purposes of adding new rows dynamically #}
        {# --------------------------------------------------------------------------------------------------------------------------------------------#}

        <section id="membersListContainer" {% if group.membersWithPermission | length == 0 %}class="hide"{% endif %}>
            <ul id="membersList" class="information-list">
                {% for member in group.membersWithPermission %}
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="card small-12">
                                <a href="{{ profile.link(member.user) }}" title="View Profile">
                                    {{ profile.imageSquare64(member.user) }}
                                </a>
                                <p>
                                    <a href="{{ profile.link(member.user) }}" title="View Profile">{{ member.user.fullName }}</a>
                                </p>
                                <p class="meta">{{ member.user.role.name }}</p>
                            </div>
                        </div>
                        <nav>
                            <a data-member-delete="{{ member.user.id }}" class="icon-delete no-text" href="#" title="Remove Group Member"></a>
                        </nav>
                    </li>
                {% endfor %}
            </ul>
            <div class="component-action">
                <section>
                    <a href="#" data-button="add-user" class="button" data-user-search="{{ guid }}">Add User</a>
                </section>
            </div>
        </section>

        {# --------------------------------------------------------------------------------------------------------------------------------------------#}
        {# Empty state when there are no members in the group #}
        {# --------------------------------------------------------------------------------------------------------------------------------------------#}

        <div id="membersEmpty" class="empty-state {% if group.membersWithPermission | length %}hide{% endif %}">
            <i class="icon-group"></i>
            <p>There are no users currently in this group.</p>
            <p>Do you want to <a href="#" data-user-search="{{ guid }}">add a user to this group</a>?</p>
        </div>

        {# --------------------------------------------------------------------------------------------------------------------------------------------#}
        {# Action buttons #}
        {# --------------------------------------------------------------------------------------------------------------------------------------------#}

        <ul class="flex-list buttons">
            <li><a href="#" class="submit" data-save>{{ button }}</a></li>
        </ul>

    </div>
</div>

<!--suppress JSUnusedLocalSymbols -->
<script>
    $(function () {

        {# --------------------------------------------------------------------------------------------------------------------------------------------#}
        {# Prepopulate array with existing group members #}
        {# --------------------------------------------------------------------------------------------------------------------------------------------#}

        window.usersAdded = [];

        {% for member in group.members %}
            window.usersAdded[{{ member.user.id }}] = true;
        {% endfor %}

        {# --------------------------------------------------------------------------------------------------------------------------------------------#}
        {# Callback functions #}
        {# --------------------------------------------------------------------------------------------------------------------------------------------#}

        {# Group member added #}

        window.modalUserAdded = function (user) {

            {# Only add if they don't already exist in the table #}

            if (window.usersAdded[user.id] !== true) {

                {# Add the selected members ID to the array we use when saving to the database #}

                window.usersAdded[user.id] = true;

                {# Add them to the list of members in the HTML #}

                var membersList = $('#membersList');

                //noinspection JSUnresolvedVariable
                var html = $('#cloneMember').html()
                    .replace(/{NAME}/g, user.first_name + ' ' + user.last_name)
                    .replace(/{ID}/g, user.id)
                    .replace(/{ROLE}/g, user.role)
                    .replace(/{FULL_NAME}/g, user.full_name)
                    .replace(/{EXTERNALID}/g, user.external_id);

                membersList.html(membersList.html() + html);

                {# Unhide the user list if it was previously empty #}

                $('#membersListContainer').removeClass('hide');

                {# Remove the empty state if it was visible #}

                $('#membersEmpty').addClass('hide');
            }

            {# Update delete events #}

            window.updateDeleteEvents();
        };

        {# Return existing group members #}

        window.modalUsersExisting = function() {
            {# Need to use slice to clone the array, otherwise the modal will update the contents of this erroneously #}

            return window.usersAdded.slice(0);
        };

        {# Group member deleted #}

        window.memberDelete = function (item) {
            var memberItem = item.closest('li');
            var memberId = item.attr('data-member-delete');

            $(this).confirmDialog({

                text: 'Are you sure you want to delete this person from the group?',
                confirmLabel: 'Delete',
                confirmEvent: function () {
                    window.usersAdded[memberId] = false;

                    {# Remove from HTML #}

                    memberItem.remove();

                    if ($('#membersList').children('li').length === 0) {
                        $('#membersListContainer').addClass('hide');
                        $('#membersEmpty').removeClass('hide');
                    }
                }
            });
        };

        {# Wire up delete buttons #}

        window.updateDeleteEvents = function () {
            $('[data-member-delete]').click(function (e) {
                e.preventDefault();
                window.memberDelete($(this));
            });
        };

        window.updateDeleteEvents();

        {# --------------------------------------------------------------------------------------------------------------------------------------------#}
        {# Setup form validation (for that one lonely field...) #}
        {# --------------------------------------------------------------------------------------------------------------------------------------------#}

        var form = $('#formGroup');

        form.alaressValidate({
            rules: {
                'name': {required: true}
            },
            messages: {
                'name': {required: 'You must enter a name for this group before you can proceed.'}
            }
        });

        {# --------------------------------------------------------------------------------------------------------------------------------------------#}
        {# Submit form #}
        {# --------------------------------------------------------------------------------------------------------------------------------------------#}

        $('[data-save]').click(function (e) {

            e.preventDefault();

            var groupName = $('#groupName');

            groupName.val(groupName.val().trim());

            if (form.valid()) {

                {# Squish group members ID numbers into a CSV string for submission with the form #}

                var selectedIds = [];

                $(window.usersAdded).each(function (id, selected) {
                    if (selected) {
                        selectedIds.push(id);
                    }
                });

                if (selectedIds.length === 0) {

                    {# Warn the user they are saving an empty group #}

                    $(this).confirmDialog({

                        text: 'Are you sure you want to save this group with no members?',
                        confirmEvent: function () {
                            form.submit();
                        }
                    });

                } else {

                    $('#members').val(selectedIds.join());

                    form.submit();
                }
            }

        });
    });
</script>

{# --------------------------------------------------------------------------------------------------------------------------------------------#}
{# This is the HTML that gets cloned for a group member that has been added to the group. This is displayed behind the modal. #}
{# --------------------------------------------------------------------------------------------------------------------------------------------#}

{# This is only inside a <ul> to stop storm complaining about there being an <li> floating on its own #}

<ul id="cloneMember" class="hide">
    <li class="actions-small-1">
        <div class="list-item">
            <div class="card small-12">
                <!--suppress HtmlUnknownTarget -->
                <a href="/search/user/{ID}" title="View Profile">
                    <img style="background-color:#c6c6c6;width:64px;height:64px;"
                         src="/portrait.php?id={ID}&size=square64" alt="{NAME}" title="{NAME}">
                    <p>{FULL_NAME}</p>
                </a>
                <p class="meta">{ROLE}</p>
            </div>
        </div>
        <nav>
            <a data-member-delete="{ID}" class="icon-delete no-text" href="#" title="Remove Group Member"></a>
        </nav>
    </li>
</ul>

{# --------------------------------------------------------------------------------------------------------------------------------------------#}
{# Setup modal #}
{# --------------------------------------------------------------------------------------------------------------------------------------------#}

{{ userSearch.modal(guid, 'Add User To Group', 'Enter name', 'staff', null, 'window.modalUserAdded', 'window.modalUsersExisting', roles, roleTypes, moderatorIds) }}
