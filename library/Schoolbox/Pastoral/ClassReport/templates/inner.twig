<div class="row">
    <div class="small-12 columns">
        {{ dump(pastoralIds) }}
        <ul class="action-list">
            {% for student in students %}
            <li>
                <div class="card small-12">
                    <a href="/search/user/{{ student.id }}" title="View Profile">
                        <img src="/portrait.php?id={{ student.id }}&amp;size=square64" alt="View Profile">
                        <p>{{ student.lastname }}, {{ student.firstname }}</p>
                    </a>
                </div>
            </li>
            {% endfor %}
        </ul>
    </div>
</div>
