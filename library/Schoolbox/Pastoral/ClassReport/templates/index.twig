{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [folder.nameWithCodes, '/homepage/' ~ folder.id],
    [locale.pastoralCare.proper ~ ' Report']
) }}
{% set reportContentId = 'class-pastoral-content' %}

{% autoescape 'js' %}
    <script type="text/javascript">
        $(function () {
            // Filtered content has been [re]loaded
            $('#{{ reportContentId }}').on('filterContentLoaded', function (event, selectedFilters) {
                document.dispatchEvent(new CustomEvent('class-pastoral__onFilterChange', {
                    detail: {
                        selectedFilters
                    }
                }));
            });
        });
    </script>
{% endautoescape %}

<div class="row actions-small-5">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ pageTitle }}</h1>
        </div>
    </div>
</div>

{% include '@filters/panel.twig' with {
    contentId: reportContentId,
    panel:     filterPanel,
    quickload: true,
} only %}
