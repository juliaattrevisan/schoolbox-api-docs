{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [folder.nameWithCodes, '/homepage/' ~ folder.id],
    [locale.pastoralCare.proper ~ ' Report']
) }}
{% set reportContentId = 'pastoral-class-report' %}

{% autoescape 'js' %}
    <script type="text/javascript">
        $(function () {
            // Filtered content has been [re]loaded
            $('#{{ reportContentId }}').on('filterContentLoaded', function (event, selectedFilters) {
                document.dispatchEvent(new CustomEvent('pastoral-class-report__onFilterChange', {
                    detail: {
                        selectedFilters
                    }
                }));
            });
        });
    </script>
{% endautoescape %}

<div class="row">
    <div class="small-12 island">
        <h1>{{ pageTitle }}</h1>

        <div>
            {% include '@filters/panel.twig' with {
                contentId: reportContentId,
                panel:     filterPanel,
                quickload: true
            } only %}
        </div>

        <section id="{{ reportContentId }}">
            <pastoral-class-report
                get-report-data-route="{{ routeLookupIfAuthorized('pastoralClassReportModule.getReportData', {folderId: folder.id, folder: folder}) }}"
                :severity-enabled="{{ config.pastoral_severity ? 'true' : 'false' }}"
            >
            </pastoral-class-report>
        </section>
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/pastoralClassReport.js?v={{ config.site_version }}"></script>
    </div>
</div>
