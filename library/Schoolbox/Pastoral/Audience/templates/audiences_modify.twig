{% if subtype is null %}
    {% set action = routeLookupIfAuthorized('pastoralAudience.postAudienceTypeModify', {type: type, typeId: type.id}) %}
    {% set title = type.name %}
{% else %}
    {% set action = routeLookupIfAuthorized('pastoralAudience.postAudienceSubTypeModify', {subtype: subtype, subtypeId: subtype.id}) %}
    {% set title = type.name ~ ': ' ~ subtype.name %}
{% endif %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="admin-container row">

    {# Default text is "Manage {{ locale.pastoral.proper }} Record Settings"
     # But you can set that to empty string to remove it
    #}
    {% include '@submenu/flyout.twig' with {
        nodes: flyout.nodes,
        pageCurrent: flyout.pageCurrent,
        subpageCurrent: flyout.subpageCurrent
    } %}

    <div class="admin-content">
        <div class="small-12 island" id="formPastoral">
            <form class="top" id="pastoralForm" method="post" enctype="multipart/form-data" action="{{ action }}">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="pastoralIcon">Flag</label>
                            <p class="meta">
                                If a student has one or more {{ locale.pastoral }} records of this type,
                                a flag will display on their profile page, when marking attendance,
                                and on the class list. If there is no icon or colour selected,
                                no flag will appear for this {{ locale.pastoral }} type.
                            </p>

                            {% set icon  = (subtype ? subtype.icon  : type.icon) %}
                            {% set color = (subtype ? subtype.color : type.color) %}
                            <div class="row">
                                <div class="small-12 medium-8 columns">
                                    <select id="pastoralIcon" name="icon">
                                        <option value="">-- none selected --</option>
                                        {% for icon in icons %}
                                            <option value="{{ icon.name }}"
                                                    label="{{ icon.title }}"
                                                    {% if (subtype ? subtype.icon : type.icon) == icon.name %}selected{% endif %}
                                            >{{ icon.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="small-6 medium-2 columns">
                                    <input id="pastoralColor" name="color" type="text"
                                           value="{{ flagColors.foreground }}"/>
                                </div>
                                <div class="small-6 medium-2 columns">
                        <span id="pastoralFlagPreview"
                              class="label neutral {% if icon and color %}icon-{{ icon }}{% else %}hide{% endif %}"
                              style="color: {{ flagColors.foreground }}; background-color: {{ flagColors.background }}"
                        >1</span>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="sentiment">Sentiment</label>
                            {% set currentSentiment  = (subtype ? subtype.sentiment : type.sentiment) %}
                            <div class="row">
                                <div class="small-12 columns">
                                    <select id="sentiment" name="sentiment">
                                        {% for sentiment in sentiments %}
                                            <option value="{{ sentiment }}"
                                                    label="{{ sentiment | capitalize }}"
                                                    {% if sentiment == currentSentiment %}selected{% endif %}
                                            >{{ sentiment | capitalize }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    {% if config.pastoral_action_enable %}
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="template">Available Actions</label>
                            <script type="text/javascript"
                                    src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
                            <script type="text/javascript"
                                    src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
                            <select data-actions name="actions[]" id="pastoral-actions" multiple></select>
                        </div>
                        <script type="text/javascript">
                            {% autoescape 'js' %}

                            $('#pastoral-actions').selectizeSelector({
                                multiple: true,
                                selectize: {
                                    create: false,
                                    placeholder: 'Search Actions',
                                    preload: true,
                                    persist: true,
                                    hideSelected: true,
                                    load: function (query, callback) {
                                        $.ajax({
                                    url: '{{ routeLookup('pastoral.getActions') }}',
                                    type:     'GET',
                                            dataType: 'json',
                                            data: {query: query}
                                        }).done(function (result) {
                                            callback(result)
                                        }).fail(function () {
                                            callback()
                                        })
                                    }
                                },
                                value: [
                                    {% for action in typeActions %}
                                    {'id': '{{ action.id }}', 'name': '{{ action.name | escape('js') }}'},
                                    {% endfor %}
                                ]
                            });
                            {% endautoescape %}
                        </script>
                    </fieldset>
                    {% endif %}
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="template">General Template</label>

                            <p class="meta">
                                This text will automatically populate into the general text of a {{ locale.pastoral }}
                                record when this type is selected. You may use the following tokens that will be
                                substituted with the students details on creation:
                                [firstname], [preferredname], [surname], [fullname], [year], [house]
                            </p>

                            <script type="text/javascript"
                                    src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
                            <script type="text/javascript"
                                    src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
                            <link rel="stylesheet" type="text/css"
                                  href="{{ CDN_PREFIX }}/css/vendors/spectrum/spectrum.css?v={{ config.site_version }}"/>
                            <script type="text/javascript"
                                    src="{{ CDN_PREFIX }}/js/bundle/spectrum.js?v={{ config.site_version }}"></script>
                            <script type="text/javascript">
                                {% autoescape 'js' %}
                                $(function () {
                                    $('#formPastoral').alaressEditor($.alaressEditorConfigWithUserTokens());

                                    let colorInput = document.getElementById('pastoralColor'),
                                            iconSelect = document.getElementById('pastoralIcon'),
                                            flagPreview = document.getElementById('pastoralFlagPreview');
                                    $(colorInput).spectrum({
                                        allowEmpty: false,
                                        showAlpha: false,
                                        showInput: true,
                                        preferredFormat: 'hex',
                                        clickoutFiresChange: true,
                                        showInitial: true,
                                    });

                                    $().add(colorInput).add(iconSelect).on('change', function () {
                                        let color = colorInput.value,
                                                icon = iconSelect.value;
                                        if (color.length === 0 || icon.length === 0) {
                                            flagPreview.classList.add('hide');
                                        } else {
                                            // Remove hide and all icon classes
                                            flagPreview.classList.remove('hide');
                                            flagPreview.classList.remove(
                                                    ...Array.from(flagPreview.classList.values()).filter((v) => v.startsWith('icon-'))
                                            );

                                            // Add new icon class and set color
                                            flagPreview.classList.add('icon-' + icon);
                                            flagPreview.style.color = color;

                                            // Background color:
                                            // same hue/saturation/alpha as foreground,
                                            // but contrasting luminance
                                            let colorHsl = new tinycolor(color).toHsl(),
                                                    baseBackgroundHsl = tinycolor.mostReadable(color, ['{{ flagColors.baseLight }}', '{{ flagColors.baseDark }}']).toHsl(),
                                                    actualBackground = new tinycolor({
                                                        h: colorHsl.h,
                                                        s: colorHsl.s,
                                                        l: baseBackgroundHsl.l,
                                                        a: colorHsl.a,
                                                    });
                                            flagPreview.style.backgroundColor = actualBackground.toHslString();
                                        }
                                    });
                                });
                                {% endautoescape %}
                            </script>

                            <textarea id="template"
                                      name="template">{% if subtype %}{{ subtype.template }}{% elseif type %}{{ type.template }}{% endif %}</textarea>
                        </div>
                    </fieldset>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="templatePrivate">Confidential Template</label>

                            <p class="meta">
                                This text will automatically populate into the confidential text of a {{ locale.pastoral }}
                                record when this type is selected. You may use the following tokens that will be
                                substituted with the students details on creation:
                                [firstname], [preferredname], [surname], [fullname], [year], [house]
                            </p>

                            <textarea id="templatePrivate"
                                      name="templatePrivate">{% if subtype %}{{ subtype.templatePrivate }}{% elseif type %}{{ type.templatePrivate }}{% endif %}</textarea>
                        </div>
                    </fieldset>
                    <fieldset>
                        <div class="small-12 columns">
                            <label for="visibilityLocked">Lock Visibility</label>
                            <p class="meta">When enabled, users will be unable to modify the visibility settings for this record type.</p>
                            <div class="switch">
                                {% set visibilityLocked = subtype ? subtype.visibilityLocked : type.visibilityLocked %}
                                <input name="visibilityLocked" id="visibilityLocked" type="checkbox"
                                       {% if visibilityLocked %}checked="checked"{% endif %} value="1"/>
                                <label for="visibilityLocked">
                                    <span class="icon-locked"></span>
                                    <span class="icon-unlocked"></span>
                                </label>
                            </div>
                        </div>
                    </fieldset>
                </section>

                {% include "@pastoral/modify_section_visibility.twig" with
                    {
                        record: record,
                        allowIndividual: allowIndividual,
                        groups: groups,
                        allowParents: allowParents,
                        roles: roles,
                        roleTypes: roleTypes,
                        roleUserCounts: roleUserCounts,
                        rolesWithUsers: rolesWithUsers,
                        moderatorIds: moderatorIds,
                        bulkCreate: false,
                        managePage: true,
                        reportPage: false,
                        visibilityLocked: false,
                    } only %}

                <input type="submit" value="Save">
            </form>
        </div>
    </div>
</div>
