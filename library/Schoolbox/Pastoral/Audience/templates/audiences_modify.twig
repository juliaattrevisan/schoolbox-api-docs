{% if subtype is null %}
    {% set action = routeLookupIfAuthorized('pastoralAudience.postAudienceTypeModify', {type: type, typeId: type.id}) %}
    {% set title = type.name %}
{% else %}
    {% set action = routeLookupIfAuthorized('pastoralAudience.postAudienceSubTypeModify', {subtype: subtype, subtypeId: subtype.id}) %}
    {% set title = type.name ~ ': ' ~ subtype.name %}
{% endif %}


{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ locale.pastoralCare.proper,      routeLookup('pastoral.getIndex') ],
    [ 'Visibility Defaults',      routeLookup('pastoralAudience.getAudiences') ],
    [ title ]
) }}

<div class='row'>
    <div class='small-12 columns'>
        <h1>{{ title }} Visibility Defaults</h1>
    </div>
</div>

<div class="small-12 island" id="formPastoral">
    <form class="top" id="pastoralForm" method="post" enctype="multipart/form-data"
          action="{{ action }}">
        {% include "@pastoral/modify_section_visibility.twig" with
            {
                record: record,
                allowIndividual: allowIndividual,
                groups: groups,
                allowParents: allowParents,
                roles: roles,
                roleUsers: roleUsers,
            } only
        %}
        <input type="submit" value="Save Visibility">
    </form>
</div>
