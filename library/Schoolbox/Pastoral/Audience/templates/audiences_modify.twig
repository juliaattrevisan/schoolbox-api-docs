{% if subtype is null %}
    {% set action = routeLookupIfAuthorized('pastoralAudience.postAudienceTypeModify', {type: type, typeId: type.id}) %}
    {% set title = type.name %}
{% else %}
    {% set action = routeLookupIfAuthorized('pastoralAudience.postAudienceSubTypeModify', {subtype: subtype, subtypeId: subtype.id}) %}
    {% set title = type.name ~ ': ' ~ subtype.name %}
{% endif %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="admin-container row">

    {# Default text is "Manage Type Defaults"
     # But you can set that to empty string to remove it
    #}
    {% include '@submenu/flyout.twig' with {
        nodes: flyout.nodes,
        pageCurrent: flyout.pageCurrent,
        subpageCurrent: flyout.subpageCurrent
    } %}

    <div class="admin-content">
        <div class="small-12 island" id="formPastoral">
            <form class="top" id="pastoralForm" method="post" enctype="multipart/form-data" action="{{ action }}">
                <h2 class="subheader">General Template</h2>

                <p class="meta">
                    The following tokens are available for you in the General template. [firstname], [surname], [year], [house]<br />
                    These will be replaced with the appropriate data when you save a new record.
                </p>

                <script type="text/javascript" src="{{ CDN_PREFIX }}/javascript/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
                <script type="text/javascript" src="{{ CDN_PREFIX }}/javascript/shared/editor/jquery.editor.js?v={{ config.site_version }}"></script>
                <script>
                    $(function() {
                        $('#general-template').alaressEditor();
                    });
                </script>

                <textarea id="general-template" name="template">{% if subtype %}{{ subtype.template }}{% elseif type %}{{ type.template }}{% endif %}</textarea>

                {% include "@pastoral/modify_section_visibility.twig" with
                    {
                        record: record,
                        allowIndividual: allowIndividual,
                        groups: groups,
                        allowParents: allowParents,
                        roles: roles,
                        roleUsers: roleUsers,
                        bulkCreate: false,
                    } only
                %}

                <input type="submit" value="Save">
            </form>
        </div>
    </div>
</div>
