<li data-source="{{ sources[source.id].key }}">
    <form> {# for some reason required for formatting and js targeting -_- #}
        <h4>
            <a class="exp darr" href="#">&#9660;</a>
            <span class="label">"Send a message when {{ sources[source.id].description }}."</span>
            <em data-summary>&nbsp;</em>
        </h4>
    </form>
    <form method="post" style="display:none" action="{{ routeLookup('adminMessages.saveConfig') }}">
        <ul class="action-list" data-roles data-digest-settings>
            {% for role in source.roles %}
            <li class="actions-small-7" data-role="{{ role.id }}">
                <div class="list-item">
                    <div class="small-12 info card">
                        <p data-role-title>{{ roles[role.id].name }}</p>
                    </div>
                </div>
                <nav data-custom>
                    {% include '@messages/options.twig' with { mode: 'p' } %}
                    <a href="#" class="icon-modify" title="Advanced"></a>
                </nav>
            </li>
            {% endfor %}
        </ul>
    </form>
</li>
