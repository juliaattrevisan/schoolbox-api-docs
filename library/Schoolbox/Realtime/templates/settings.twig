<script type="text/javascript" src="{{ CDN_PREFIX }}/js/notifications/jquery.msg-config.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function () {
        var iiCache = {};

        $('#msg-settings')
                .msgconfig({
                            sourceSelector: '[data-source]',
                            tableSelector:  '[data-digest-settings]',
                            roleSelector:   '[data-source]',

                            customSelector: null,
                            muteSelector:   null,
                            toggleSelector: null,

                            persist: function () {
                                sendAjax(this, 'source');
                            }
                        }
                );

        $('#follow-settings').on('change', 'input[type=checkbox]', function (e) {
            sendAjax($('#follow-settings'), 'follow');
        });

        /**
         *
         * @param {jQuery} $input
         * @param {string} dataField
         */
        function sendAjax($input, dataField) {
            var action   = $input.closest('form[method=post]').attr('action'),
                    formdata = $('<form/>').append($input.clone()).serialize(),
                    sourceId = $input.data(dataField) || dataField;

            if (iiCache[sourceId]) {
                clearTimeout(iiCache[sourceId]);
            }

            iiCache[sourceId] = setTimeout(function () {
                $.post(action, formdata);
            }, 500);
        }

    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>Message Settings</h1>
    </div>
</div>
<form method="post" action="{{ routeLookup('messages.saveConfig') }}" id="msg-settings" class="row">
    <div class="small-12 columns">
        <div class="row actions-small-1">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Setup Schoolbox web app</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="small-12 island">
        <section class="content">
            To receive push notifications and enjoy a better experience, install the Schoolbox web app on your device.

            {# Insatll PWA if not any of the following:
                                    config.digistorm_store_link* is not set
                                    config.digistorm_store_link* is set, but the current user is not in a sepcified role type in config.digistorm_role_type
            #}
            {#                            {% set installGoogle = config.digistorm_store_link_google %}#}
            {#                            {% set installApple = config.digistorm_store_link_apple %}#}
            {% set installGoogle = '#installGoogle' %}
            {% set installApple = '#installApple' %}

            {% if config.digistorm_store_role ?? [] is empty %}
                {# All users are redirected to the store link #}
                {% if installApple is not empty %}
                    <a id="installApple" class="button" href="{{ installApple }}">Install</a>
                {% endif %}
                {% if installGoogle is not empty %}
                    <a id="installGoogle" class="button" href="{{ installGoogle }}">Install</a>
                {% endif %}
            {% else %}
                {# ensure the user is in the specified role #}
                {% if user.role.type in config.digistorm_store_role %}
                    {% if installApple is not empty %}
                        <a id="installApple" class="button" href="{{ installApple }}">Install</a>
                    {% endif %}
                    {% if installGoogle is not empty %}
                        <a id="installGoogle" class="button" href="{{ installGoogle }}">Install</a>
                    {% endif %}
                {% endif %}
            {% endif %}

            <a id="installPWA" class="button" href="#">Install</a>

            <div id="notifBlocked">
                You've blocked notifications on this device. To enable notifications, you must go to your device settings and set <b>Allow notifications</b>.
            </div>
            <div id="enableNotifPrompt">
                <h4>Enable notifications on your device</h4>
                <div class="switch">
                    <input id="notifOn" type="checkbox">
                    <label for="notifOn">
                        <span>On</span>
                        <span>Off</span>
                    </label>
                </div>
            </div>

            <b>Note:</b> If you want to receive push notifications on multiple devices, you must install the Schoolbox web app on all your devices.
        </section>
    </div>
    <div class="small-12 columns">
        <div class="row actions-small-1">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Messages</h2>
                </div>
            </div>
            <nav>
                <a href="#" data-reveal-id="legend-modal" class="icon-help" title="View Help"></a>
            </nav>
        </div>
    </div>
    <div class="small-12 columns">
        <div class="alert-box no-margin">
            <p>
                Customise when and how you receive messages.
                <em>Options that are unavailable have been disabled by your system administrator.</em>
            </p>
        </div>
    </div>
    <div class="small-12 island">
        {% for namespace in msgConfig %}
            {% if ns[namespace.id] is defined %}
                <h3 class="subheader">Receive {{ locale.translateSentence(namespace.label) }} messages when&hellip;</h3>
                <section>
                    <ul class='permission-list' data-roles data-digest-settings>
                        {% for source in namespace.sources %}
                            <li>
                                <label class="content">&hellip;{{ locale.translateSentence(source.description) }}.</label>
                                <div class="actions-small-6" data-source="{{ source.id }}">
                                    <nav>
                                        {% include '@messages/options.twig' with { mode: 'p', role: source } %}
                                    </nav>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        {% endfor %}

        <input type="submit" value="Submit" />
    </div>
</form>

<div id="legend-modal" class="reveal-modal" data-reveal>
    {% include '@messages/legend.twig' with { who: 'you' } %}

    <a class="close-reveal-modal">&#215;</a>
</div>
