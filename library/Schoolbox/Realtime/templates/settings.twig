<script type="text/javascript" src="/javascript/shared/notifications/jquery.msg-config.js"></script>
<script type="text/javascript">
    $(function () {
        var iiCache = {};

        $('#msg-settings')
            .msgconfig({
                sourceSelector: '[data-source]',
                tableSelector:  '[data-digest-settings]',
    //            roleSelector:   '',

                customSelector: null,
                muteSelector:   null,
                toggleSelector: null,
                expand:         null,

                persist: function () {
                    sendAjax(this, 'source');
                }
            }
        );

        $('#follow-settings').on('change', 'input[type=checkbox]', function (e) {
            sendAjax($('#follow-settings'), 'follow');
        });

        /**
         *
         * @param {jQuery} $input
         * @param {string} dataField
         */
        function sendAjax($input, dataField) {
            var action   = $input.closest('form[method=post]').attr('action'),
                formdata = $('<form/>').append($input.clone()).serialize(),
                sourceId = $input.data(dataField) || dataField;

            if (iiCache[sourceId]) {
                clearTimeout(iiCache[sourceId]);
            }

            iiCache[sourceId] = setTimeout(function () {
                $.post(action, formdata);
            }, 500);

        }
    });
</script>GIT

<div class="row">
    <div class="small-12 island">
        <h1>Message Settings</h1>

        <form method="post" action="{{ routeLookup('messages.saveConfig') }}">
            {% if groups %}
            <h2 class="subheader">Homepages</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <p>
                            If you unfollow a homepage, you will receive <em>no</em> messages that come from it.
                        </p>
                    </div>

                    <table id="follow-settings">
                        <thead>
                            <tr>
                                <th>Homepage</th>
                                <th>Following</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for groupId, group in groups %}
                            <tr>
                                <td>
                                    <label for="follow-{{ groupId }}">{{ group.name }}</label>
                                </td>
                                <td>
                                    <input type="hidden" name="follow[{{ groupId }}]" value="{{ group.force ? 1 : 0 }}">
                                    <input id="follow-{{ groupId }}"
                                           type="checkbox"
                                           name="follow[{{ groupId }}]"
                                           value="1"
                                           {% if group.follow %}checked="checked"{% endif %}
                                           {% if group.force %}disabled="disabled"{% endif %} />
                                    <label for="follow-{{ groupId }}" class="checkbox-label"></label>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% endif %}
                </fieldset>
            </section>

            <div class="actions-small-1 row">
                <div class="list-item">
                    <div class="small-12 columns">
                        <h2 class="subheader">Messages</h2>
                    </div>
                </div>
                <nav>
                    <a href="#" data-reveal-id="legend-modal" class="icon-help" title="View Help"></a>
                </nav>
            </div>
            <div class="alert-box">
               Customise when and how you receive messages.
               <em>Options that are unavailable have been disabled by your system administrator.</em>
            </div>

            {% for namespace in config %}
            <h3 class="subheader">Receive {{ namespace.label }} messages when&hellip;</h3>
            <section>
                <fieldset class="content">
                    <ul class='information-list' id="msg-settings" data-roles data-digest-settings>
                        {% for source in namespace.sources %}
                        <li class="actions-small-7" data-source="{{ source.id }}">
                            <div class="list-item">
                                <div class="small-12 info card">&hellip;{{ source.description }}
                                </div>
                            </div>
                            <nav>
                                {% include '@messages/options.twig' with { mode: 'p', role: source } %}
                            </nav>
                        </li>
                        {% endfor %}
                    </ul>
                </fieldset>
            </section>
            {% endfor %}

            <input type="submit" value="Submit" />
        </form>
    </div>
</div>

<div id="legend-modal" class="reveal-modal" data-reveal>
    {% include '@messages/legend.twig' with { who: 'you' } %}

    <a class="close-reveal-modal">&#215;</a>
</div>