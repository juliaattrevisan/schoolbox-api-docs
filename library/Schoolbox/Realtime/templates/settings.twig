<script type="text/javascript" src="{{ CDN_PREFIX }}/js/notifications/jquery.msg-config.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function () {
        var iiCache = {};

        $('#msg-settings')
                .msgconfig({
                            sourceSelector: '[data-source]',
                            tableSelector:  '[data-digest-settings]',
                            roleSelector:   '[data-source]',

                            customSelector: null,
                            muteSelector:   null,
                            toggleSelector: null,

                            persist: function () {
                                sendAjax(this, 'source');
                            }
                        }
                );

        $('#follow-settings').on('change', 'input[type=checkbox]', function (e) {
            sendAjax($('#follow-settings'), 'follow');
        });

        /**
         *
         * @param {jQuery} $input
         * @param {string} dataField
         */
        function sendAjax($input, dataField) {
            var action   = $input.closest('form[method=post]').attr('action'),
                    formdata = $('<form/>').append($input.clone()).serialize(),
                    sourceId = $input.data(dataField) || dataField;

            if (iiCache[sourceId]) {
                clearTimeout(iiCache[sourceId]);
            }

            iiCache[sourceId] = setTimeout(function () {
                document.dispatchEvent(new CustomEvent("TOAST__ACTIVATE", {
                    detail: { text: "Saving..." }
                }));
                try {
                    $.post(action, formdata)
                        .done(() => {
                            document.dispatchEvent(new CustomEvent("TOAST__TIMEOUT", {
                                detail: { text: "Saved" }
                            }));
                        })
                        .fail(() => {
                            document.dispatchEvent(new CustomEvent("TOAST__TIMEOUT", {
                                detail: { text: "Save failed, please contact your support if the problem persists", isSuccess: false }
                            }));
                        })
                } catch (error) {
                    document.dispatchEvent(new CustomEvent("TOAST__TIMEOUT", {
                        detail: { text: "Save failed, please contact your support if the problem persists", isSuccess: false }
                    }));
                }
            }
            , 500);
        }

    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>Notification Settings</h1>
    </div>
</div>
<form method="post" action="{{ routeLookup('notifications.saveConfig') }}" id="msg-settings" class="row">
    {% if config.messaging_enabled %}
        {% set installGoogle = config.digistorm_google_play_store_link ?? '' %}
        {% set installApple = config.digistorm_apple_app_store_link ?? '' %}
        {% if config.pwa_enable or config.web_push_notifications_enabled or installGoogle is not empty or installApple is not empty %}
        <div class="small-12 columns">
            <div class="row actions-small-1">
                <div class="list-item">
                    <div class="small-12 columns">
                        <h2 class="subheader">Setup {{ config.title }} web app</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="small-12 island">
            <section class="content">
                    {% include '@notifications/pwa.twig' with { notifButton : 'notifOnSettings', pwaPage: 'settings' } %}
                    {% if config.web_push_notifications_enabled %}
                    <p class="notifNote"><strong>Note:</strong> If you want to receive push notifications on multiple devices, you must enable notifications on all your devices.</p>
                    {% endif %}
            </section>
        </div>
        {% endif %}
    {% endif %}
    <div class="small-12 columns">
        <div class="row actions-small-1">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Notifications</h2>
                </div>
            </div>
            <nav>
                <a href="#" data-reveal-id="legend-modal" class="icon-help" title="View Help"></a>
            </nav>
        </div>
    </div>
    <div class="small-12 columns">
        <div class="alert-box no-margin">
            <p class="f-no-margins">
                Customise when and how you receive notifications.
                <em>Options that are unavailable have been disabled by your system administrator.</em>
            </p>
        </div>
    </div>
    <div class="small-12 island">
        {% for namespace in msgConfig %}
            {% if ns[namespace.id] is defined %}
                <h3 class="subheader">Receive {{ locale.translateSentence(namespace.label) }} notifications when&hellip;</h3>
                <section>
                    <ul class='permission-list' data-roles data-digest-settings>
                        {% for source in namespace.sources %}
                            <li>
                                <label class="content">&hellip;{{ locale.translateSentence(source.description) }}.</label>
                                <div class="actions-small-6" data-source="{{ source.id }}">
                                    <nav>
                                        {% include '@notifications/options.twig' with { mode: 'p', role: source } %}
                                    </nav>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        {% endfor %}
    </div>
</form>

<div id="legend-modal" class="reveal-modal" data-reveal>
    {% include '@notifications/legend.twig' with { who: 'you' } %}

    <a class="close-reveal-modal">&#215;</a>
</div>
<style>
.notifNote{
    margin-top: 1rem!important;
}
</style>
