<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Notification Delivery Options</h2>
        <section>
            <ul class="information-list">
                <li>
                    <div class="list-item">
                        <div class="small-12 card">
                            <div class="l-flex-row l-gap-m l-pad-s--vert">
                                <sbx-icon name="mute" size="xl" color="var(--sbx-color-text-secondary,var(--body-foreground))"></sbx-icon>
                                <div>
                                    <p>Muted</p>
                                    <p class="meta t-white-space-normal">
                                        {{ who | capitalize }} won't receive this message.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>

                {% if digest %}
                <li>
                    <div class="list-item">
                        <div class="small-12 card">
                            <div class="l-flex-row l-gap-m l-pad-s--vert">
                                <sbx-icon name="news" size="xl" color="var(--sbx-color-text-secondary,var(--body-foreground))"></sbx-icon>
                                <div>
                                    <p>Digest</p>
                                    <p class="meta t-white-space-normal">
                                        This message will be collated and emailed to {{ who }} in a digest{% if digest | length > 1 %} <strong>{{ digest }}</strong>{% endif %}.<br/>
                                        It will not appear in {{ who }}{{ who == 'you' ? 'r' : "'" }} internal messages list.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
                {% endif %}

                <li>
                    <div class="list-item">
                        <div class="small-12 card">
                            <div class="l-flex-row l-gap-m l-pad-s--vert">
                                <sbx-icon name="notifications" size="xl" color="var(--sbx-color-text-secondary,var(--body-foreground))"></sbx-icon>
                                <div>
                                    <p>Instant</p>
                                    <p class="meta t-white-space-normal">
                                        This message will appear in {{ who }}{{ who == 'you' ? 'r' : "'" }} internal messages list.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>

                <li>
                    <div class="list-item">
                        <div class="small-12 card">
                            <div class="l-flex-row l-gap-m l-pad-s--vert">
                                <sbx-icon name="add" size="xl" color="var(--sbx-color-text-secondary,var(--body-foreground))"></sbx-icon>
                            </div>
                        </div>
                    </div>
                </li>

                {% if mobile %}
                <li>
                    <div class="list-item">
                        <div class="small-12 card">
                            <div class="l-flex-row l-gap-m l-pad-s--vert">
                                <sbx-icon name="mobile" size="xl" color="var(--sbx-color-text-secondary,var(--body-foreground))"></sbx-icon>
                                <div>
                                    <p>Device</p>
                                    <p class="meta t-white-space-normal">
                                        This message will be pushed to {{ who }}{{ who == 'you' ? 'r' : "'" }} device{% if mobile | length > 1 %}s{% endif %}. <br />
                                        * Requires Instant to be enabled.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
                {% endif %}

                <li>
                    <div class="list-item">
                        <div class="small-12 card">
                            <div class="l-flex-row l-gap-m l-pad-s--vert">
                                <sbx-icon name="email" size="xl" color="var(--sbx-color-text-secondary,var(--body-foreground))"></sbx-icon>
                                <div>
                                    <p>Email</p>
                                    <p class="meta t-white-space-normal">
                                        This message will be immediately emailed to {{ who }}.<br />
                                        * Requires Instant to be enabled.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </section>
    </div>
</div>
