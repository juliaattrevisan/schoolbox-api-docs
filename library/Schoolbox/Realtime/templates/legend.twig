<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Message Delivery Options</h2>
        <section>
            <ul class="information-list">
                <li>
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <span class="icon-mute icon-32"></span>
                            <p>
                                Muted
                            </p>
                            <p class="meta">
                                {{ who }} won't receive this message.
                            </p>
                        </div>
                    </div>
                </li>

                {% if digest %}
                <li>
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <span class="icon-news icon-32"></span>
                            <p>
                                Digest
                            </p>
                            <p class="meta">
                                This message will be collated and emailed to {{ who }} in a digest{% if digest | length > 1 %} <strong>{{ digest | raw }}</strong>{% endif %}.<br/>
                                It will not appear in {{ who }}{{ who == 'you' ? 'r' : "'" }} internal messages list.
                            </p>
                        </div>
                    </div>
                </li>
                {% endif %}

                <li>
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <span class="icon-notifications icon-32"></span>
                            <p>
                                Instant
                            </p>
                            <p class="meta">
                                This message will appear in {{ who }}{{ who == 'you' ? 'r' : "'" }} internal messages list.
                            </p>
                        </div>
                    </div>
                </li>

                <li>
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <span class="icon-add icon-32"></span>
                        </div>
                    </div>
                </li>

                {% if mobile %}
                <li>
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <span class="icon-mobile icon-32"></span>
                            <p>
                                Mobile
                            </p>
                            <p class="meta">
                                This message will be pushed to {{ who }}{{ who == 'you' ? 'r' : "'" }} mobile device{% if mobile | length > 1 %}s{% endif %}. <br />
                                * Requires Instant to be enabled.
                            </p>
                        </div>
                    </div>
                </li>
                {% endif %}

                <li>
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <span class="icon-email icon-32"></span>
                            <p>
                                Email
                            </p>
                            <p class="meta">
                                This message will be immediately emailed to {{ who }}.<br />
                                * Requires Instant to be enabled.
                            </p>
                        </div>
                    </div>
                </li>
            </ul>
        </section>
    </div>
</div>
