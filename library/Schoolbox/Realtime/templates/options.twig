{# Translate into class names #}
{%
set iconClassnames = {
    'Muted': 'mute',
    'Digest': 'news',
    'Instant': 'notifications',
    'Mobile': 'mobile',
    'Email': 'email'
}
%}
{# Overrides for display names
 # Since the keys are meaningful in the backend/database, we need to override
 # them for frontend display purposes when they change
 #}
{%
set labelDisplayNames = {
    'Muted': 'Muted',
    'Digest': 'Digest',
    'Instant': 'Instant',
    'Mobile': 'Device',
    'Email': 'Email'
}
%}

{% for level, perm in perms %}
    {% set permInputId = mode ~ '-' ~ (ns[namespace.id].slug ?: 0) ~ '-' ~ (source.id ?: 0) ~ (role ? '-' ~ role.id : '') ~ '-' ~ level %}
    {% set permKey = perm[1] | slice(0, 2) | upper %}
    {% set isChecked = permKey in role.default %}
    {% set isDisabled = permKey not in role.mask %}
    {% set inputType = level <= 1 or level > 4 ? 'radio' : 'checkbox' %}
    <span data-perm-container data-perm="{{ level }}">
        <input id="{{ permInputId }}"
               name="data[{{ ns[namespace.id].slug ?: 0 }}][{{ sources[source.id].key ?: 0 }}]{% if role %}[{{ role.id }}]{% endif %}[perm][]"
               value="{{ level }}" data-perm="{{ level }}" type="{{ level <= 1 or level > 4 ? 'radio' : 'checkbox' }}"
               {% if isChecked %}checked="checked"{% endif %}
               {% if isDisabled %}disabled="disabled"{% endif %}
        />
        <label for="{{ permInputId }}"
               title="{{ labelDisplayNames[perm[1]] }}{% if isDisabled %} (disabled){% endif %}"
               class="input-toggle">
            <sbx-icon name="{{ iconClassnames[perm[1]] }}" size="l" color="currentColor"></sbx-icon>
        </label>
    </span>
    {% if level == 1 %}
    <span>
        <sbx-icon name="add" size="s" color="currentColor" class="hide-for-small-only"></sbx-icon>
    </span>
    {% endif %}
{% endfor %}
