<script src="{{ CDN_PREFIX }}/js/bundle/mage.js?v={{ config.site_version }}"></script>
<script>
    $(function () {

        $('#app-list').on('click', '[data-open]', function (e) {
            e.preventDefault();

            var o = $(this).data('open');

            $('#' + o).slideToggle();
        });

        $('input[name=provider]').click(function() {
            $('[data-mage-next="part-2"]').trigger('click');
        });

        // init defaults
        $('input[data-mage-next]').mage();

        // inject html
        $('input[data-mage-next="part-2"]').mage({
            onXhrDone: function (data) {
                $('[data-provider-details]').html(data);
            }
        });

        // on success, reload the page
        $('input[data-mage-next="part-3"]').mage({
            onXhrDone: function () {
                window.location.reload();
            }
        })

        /* Delete confirmation now in ajax
         */
        $('a[data-delete-provider]').on('click', function(event) {
            event.preventDefault();

            var $this = $(this);
            var href = "{{ routeLookup('adminMessages.postDeleteApp') }}";

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Notification Provider?',
                confirmLabel: 'Delete',
                confirmEvent: function() {

                    // A toast
                    var $toast = $('[data-provider-toast]');
                    $toast.toastActivate({text: 'Deleting Provider...'});

                    $.post(href, {id : $this.data().id})
                            .done(function() {
                                // Kill the element
                                $this.parents('[data-provider-row]').slideUp(function() {
                                    $(this).remove();
                                    if ($('#app-list').children().length == 0) {
                                        $('#provider-empty').show().slideDown();
                                    }
                                });

                                // Toast success
                                $toast.toastTimeout({text: 'Provider deleted.', css: 'success'});
                            })
                            .fail(function() {
                                // Toast fail
                                $toast.toastTimeout({text: 'Delete failed.', css: 'alert'});
                            });
                }
            });
        })
    });


</script>

{% import 'sub/breadcrumbs.twig' as bread  %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <h2 class="subheader">Registered Apps</h2>
            <section>
                <ul class="information-list" id="app-list">
                    {% for app in apps %}
                        <li data-provider-row>
                            {% include providers[app.providerName].template with {
                                app:        app,
                                attachzone: attachzones[app.id] ?? null,
                            } only %}
                        </li>
                    {% endfor %}
                </ul>
            </section>

            <div id="provider-empty" class="empty-state" style="{% if apps | length %}display:none;{% endif %}">
                <i class="icon-mobile"></i>
                <p>No mobile apps are currently registered.</p>
            </div>


            <h2 class="subheader">Register New App</h2>
            <form id="new-app" method="post" action="{{ routeLookup('adminMessages.postModifyApp') }}" class="mage">
                <section>
                    <fieldset class="content" data-mage="part-1">
                        <legend>Provider</legend>
                        <div class="small-12 column">
                            {#<label>Select the provider of your new application to register:</label>#}
                        </div>
                        {% for provider, providerInfo in providers %}
                            <div class="column small-12 medium-4{%  if loop.last %} end{% endif %}">
                                <input type="radio" name="provider" value="{{ provider }}" id="provider-{{ provider }}" data-radio-block />
                                <label for="provider-{{ provider }}" class="block">
                                    <i class="icon-mobile"></i> {{ providerInfo.description }}
                                </label>
                            </div>
                        {% endfor %}
                        <input type="hidden" name="part-1" data-mage-next="part-2" formmethod="GET" formaction="{{ routeLookup('adminMessages.getCreateAppForm') }}">
                        <div class="column small-12 medium-12 error-placeholder"></div>
                    </fieldset>
                    <fieldset class="content" data-mage="part-2" disabled>
                        <legend>App Details</legend>
                        <div class="small-12 columns" style="display:none;" data-mage-collapsed>
                            <div data-provider-details>{# will be populated by ajax #}</div>
                        </div>
                        <div class="small-12 column">
                            <div class="alert alert-box icon-alert" data-mage-error></div>
                        </div>
                    </fieldset>
                </section>
                <div class="row" data-mage-submitrow>
                    <div class="small-12 column">
                        <input type="submit" name="part-2" value="Register" data-mage-next="part-3" data-mage-working="Registering app..." />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="toast" data-provider-toast></div>
