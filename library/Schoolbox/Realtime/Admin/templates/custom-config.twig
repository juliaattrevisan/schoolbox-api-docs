{# Translate into class names #}
{%
set iconClassnames = {
    'Muted': 'mute',
    'Digest': 'news',
    'Instant': 'notifications',
    'Mobile': 'mobile',
    'Email': 'email'
}
%}

<script type="text/javascript">
    $(function () {

        var selTable = $('#adv-selection'),
            posTable = $('#adv-possibilities');

        posTable.on('click preclick', 'input', function (e) {

            var src  = $(this),
                perm = src.val(),
                tgt  = selTable.find('input[data-perm='+perm+']');

            if (src.prop('checked')) {
                // enable corresponding input in Step 2
                tgt.removeAttr('disabled');
            } else {
                // disable correspondible input in Step 2
                tgt.prop('checked', false)         // ensure not still checked
                   .attr('disabled', 'disabled');  // disable

                if (tgt.data('perm') == 1) {
                    // deselect the other perms
                    src.closest('tr').find('input').filter(
                        function () {
                            return this.value > 1 && this.value < 8
                        }
                    ).prop('checked', false).trigger('preclick');
                }

                if (selTable.find('input:checked').length == 0) {
                    // we need *something* selected

                    $.each([1, 0, 8], function (k, i) {
                        if (posTable.find('input[value='+i+']:checked').length) {
                            selTable.find('input[data-perm='+i+']').prop('checked', 'checked');
                            return false; // "break"
                        }
                    });

                    // if there's STILL nothing
                    if (selTable.find('input[data-perm]:checked').length == 0) {
                        // *sigh* re-enable mute and set that.
                        posTable.find('input[value=0]').prop('checked', 'checked').trigger('preclick');
                        selTable.find('input[data-perm=0]').prop('checked', 'checked');
                    }
                }
            }
        });

        posTable.on('click preclick', 'input[value=2], input[value=4]', function (e) {
            if ($(this).prop('checked')) {
                // ensure instant is checked
                $(this).closest('tr').find('input[value=1]').prop('checked', true).trigger('preclick');
            }
        });

        posTable.find('input').trigger('preclick');

        // inlineify all SVGs and apply message admin constraints
        $('#adv')
            .svgInline()
            .msgconfig({
                roleSelector: '[data-role]',
                permSelector: '[data-perm-container]',
                toggleSelector: null,
                muteSelector: null,
                customSelector: null
            });

        posTable.closest('form').on('submit', function (e) {
            e.preventDefault();
            $(this).find('input[type=submit]').attr('disabled', 'disabled').val('Saving');

            $.post('/adminv2/messages/configure', $(this).serialize(), function (data) {
                console.log(data);
                customiserCallback(data);
                $('#slider-modal').dialog('close').dialog('destroy');
            });
        });

    });
</script>

<ul id="adv" class="information-list">
    <li data-source="{{ source.id }}">
        <form method="post" action="">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <h4>Send a message when {{ source.description }}.</h4>
                        <p class="meta" data-summary>Sends to {{ role.name }}</p>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <p>
                            <strong>Step 1:</strong> Select the settings that members of '{{ role.name }}' are <em>allowed to select</em> for this message when customizing their notifications.
                            If you only select a single option, users will be locked to that option.
                        </p>

                        <ul class="information-list" id="adv-possibilities" data-roles data-digest-settings>
                            <li data-role>
                                {% for level, perm in perms %}
                                    <span data-perm-container>
                                        <input id="opt-{{ source.id }}-{{ role.id }}-{{ level }}"
                                               name="data[{{ ns[namespace.id].slug ?: 0 }}][{{ source.key ?: 0 }}][{{ role.id }}][mask][]"
                                               value="{{ level }}" type="checkbox"
                                               {% if perm[1] | slice(0, 2) | upper in role.mask %}checked="checked"{% endif %}
                                        />
                                        <label for="opt-{{ source.id }}-{{ role.id }}-{{ level }}" title="{{ perm[1] }}" class="no-margin">
                                            <a class="icon-{{ iconClassnames[perm[1]] }}" title="{{ perm[1] }}"></a>
                                        </label>
                                    </span>
                                    {% if level == 1 %}
                                    <span class="icon-add"></span>
                                    {% endif %}
                                {% endfor %}
                            </li>
                        </ul>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <p>
                            <strong>Step 2:</strong> Select the default setting for members of '{{ role.name }}' for this message.
                        </p>

                        <ul class="information-list" id="adv-selection" data-roles data-digest-settings data-settings>
                            <li data-role="{{ role.id }}">
                                {% include '@messages/options.twig' with { mode: 'def' } %}
                            </li>
                        </ul>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="checkbox" id='copy-message-settings' name="copy-to" value="{{ roletype ?: 'all' }}" />
                        <label for="copy-message-settings" class="checkbox-label">
                            Copy these message settings for all {{ roletype }} roles
                        </label>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="Save" />
        </form>
    </li>
</ul>

