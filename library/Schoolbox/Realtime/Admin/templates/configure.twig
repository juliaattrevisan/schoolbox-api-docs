<style type="text/css">
    .digest-settings:hover td, .digest-settings:hover th {
        /*opacity: 1 !important;*/
    }
    .digest-settings tr {
        transition: height 200ms ease-out;
    }
    .digest-settings td {
        overflow: hidden;
        border: none;
    }
    td.perm {
        min-width: 32px;
        padding: 0 2px !important;
    }
    .digest-settings .perm label {
        display: block;
    }
    td.toggle {
        white-space: nowrap;
    }
    .digest-settings td.mutable input[type=checkbox] {
        position: static;
        opacity: 1;
        margin-left: 24px;
    }
    .digest-settings input[disabled] + label {
        opacity: 0.2;
    }
    .admin-nav.filter {
        margin-top: 2em;
    }
    .mutable.disable, .perm.disable, .custom.disable {
        /*opacity: 0;*/
    }
    .perm label span {
        font-size: 18px;
    }
    .digest-settings td.disable * {
        visibility: hidden;
    }
    .digest-settings tr.show-advanced td {
        height: 200px;
        vertical-align: top !important;
    }
    .digest-settings tr.show-advanced td.perm {
        display: none;
    }
</style>
<script type="text/javascript">

    var levelOff     = 0,
        levelDigest  = 200,
        levelInstant = 250,
        levelPush    = 300,
        levelEmail   = 400,
        desc         = {};

    desc[levelOff]      = 'off';
    desc[levelDigest]   = 'digest';
    desc[levelInstant]  = 'instant';
    desc[levelPush]     = 'push';
    desc[levelEmail]    = 'email';

    $(function () {

        var ds = $('.digest-settings');

        ds.find('.toggle').on('change', 'input', function (e) {
            var val = parseInt($(this).val()),
                chk = $(this).is(':checked'),
                tds = $(this).closest('tr').children('.mutable, .perm, .custom');

            if (chk) {
                if (val) {
                    tds.removeClass('disable');

                } else {
                    tds.addClass('disable');

                }
            }

            describe($(this).closest('li'));
        });

        ds.find('.mutable').on('change', 'input', function () {
            var chk = $(this).is(':checked'),
                non = $(this).closest('tr')
                             .children('.perm').eq(0)
                             .find('input');

            if (chk) {
                non.removeAttr('disabled');
            } else {
                non.prop('checked', false)
                   .attr('disabled', 'disabled')
                   .trigger('change');
            }

        });

        ds.find('.perm').on('change', 'input', function (e) {

            var self = $(this),
                opt  = self.data('perm'),
                chk  = self.is(':checked'),
                row  = self.closest('tr');

            if (chk) {
                // if i have been checked

                // select requisite options
                if (opt > levelInstant) {
                    row.find('[data-perm=250]').prop('checked', true);
                } else if (opt < levelInstant) {
                    row.find('[data-perm]').filter(function () {
                        var p = $(this).data('perm');
                        return p > levelInstant;
                    }).prop('checked', false);
                }

            } else {
                // if i have been unchecked

                // deselect subordinate options
                if (opt == levelInstant) {
                    row.find('[data-perm]').filter(
                        function () {
                            var e = $(this).data('perm');
                            return e > levelInstant;
                        }
                    ).prop('checked', false);
                }

                // ensure *something* is set
                if (row.find('[data-perm]:checked').length == 0) {
                    var fallback;

                    if (row.children('.mutable').children('input:checked').length == 0) {
                        fallback = row.find('[data-perm=250]');
                    } else {
                        fallback = row.find('[data-perm=0]');
                    }

                    fallback.prop('checked', true);
                }
            }

            describe($(this).closest('li'));
        });

        ds.find('.mutable input, .perm input').trigger('change');

        ds.on('click', 'td.custom a', function (e) {

            e.preventDefault();
            e.stopPropagation();

            var self = $(this),
                cell = self.closest('td'),
                row  = self.closest('tr');


            if (self.hasClass('modify')) {
                self.removeClass('modify').addClass('cross');
                row.addClass('show-advanced');
                cell.attr('colspan', '6').addClass('expanded');


            } else {
                self.removeClass('cross').addClass('modify');
                row.removeClass('show-advanced');
                cell.removeAttr('colspan').removeClass('expanded');

            }
        });

        $('#configurator').on('click', 'a.exp', function (e) {

            e.preventDefault();
            e.stopPropagation();

            var self = $(this),
                form = self.closest('form').siblings('form');

            if (self.hasClass('darr')) {
                // change to uarr, expand content
                self.removeClass('darr').addClass('uarr').html("&#9650;");
                form.show(200);
            } else {
                // change to darr, contract content
                self.removeClass('uarr').addClass('darr').html("&#9660;");
                form.hide(200);
            }
        });

        describe($('li.source'));

    });

    function describe(sources) {
        sources.each(function() {
            var source  = $(this),
                summary = source.find('h4 em.summary'),
                table   = source.find('table.roles'),
                rows    = table.find('tr.role'),
                text    = 'Sent to ',
                count   = 0;

            rows.each(function () {
                var row  = $(this),
                    ins  = row.find('input[data-perm]:checked'),
                    role = row.children('th').text();

                if (ins.length == 0 || ins.data('perm') == 0) {
                    return;
                }

                text += role + ' via ';

                ins.each(function () {
                    var i   = $(this),
                        lbl = desc[i.data('perm')];

                    if (typeof lbl === 'undefined' || lbl === 'off') {
                        return;
                    }

                    text += lbl + ' + ';
                });

                text = text.slice(0, text.length - 3);

                text += '; ';
                count++;
            });

            if(count == 0) {
                text += 'nobody';
            }
            else {
                text = text.slice(0, text.length - 2);
            }

            summary.text(text + '.');
        });
    }


</script>
<div class="admin-contents clearfix">
    <h2>Global Message Settings</h2>
    <p class="clearfix">
        <a class="btn go-back float-left" href="{{ '/adminv2/messages' }}"><span></span>Back to Messages</a>
    </p>
    <div class="level clearfix">
        <p>
            Use this page to configure the messages the system will send to users:
        </p>
        <ul style="list-style: disc;padding-left:20px;">
          <li><strong>On / Off</strong>: can users in this role receive this message at all</li>
          <li><strong>Mutable</strong>: do users in this role have the option to turn this message off</li>
          <li><strong>Default Setting</strong>: by default, how should this message be sent to users in this role (users can customise their personal settings)</li>
          <li>If you need more fine-grained control for a message, click the edit button next to the role for advanced settings</li>
        </ul>
        <ul class="filter admin-nav clearfix">
            <li>
                <span>Filter messages relevant to:</span>
            </li>
            {% for i, filter in filters.options %}
            <li>
                <a href="/adminv2/messages/configure{{ filter == 'all' ? '' : ['/', filter] | join }}" class="{% if filters.selected == i %}current{% endif %}">{{ filter | capitalize }}</a>
            </li>
            {% endfor %}
        </ul>
        <div class="clearfix pad-it"></div>
        <ul id="configurator" class="namespaces">
            {% for namespace in config %}
            <li class="namespace">
                <h3>{{ ns[namespace.id].label }}</h3>
                <ul class="sources">
                {% for source in namespace.sources %}
                    <li class="source">
                        <form>
                            <h4>
                                <a class="exp darr" href="#">&#9660;</a>
                                <span class="label">"Send a message when {{ sources[source.id].description }}."</span>
                                <em class="summary">&nbsp;</em>
                            </h4>
                        </form>
                        <form method="post" action="{{ GetTheActionBackHRef }}" style="display:none;">
                            <table class="roles digest-settings">
                                <tr class="thead">
                                    <th width="300">Role</th>
                                    <th width="150">Enabled</th>
                                    <th width="100">Mutable</th>
                                    <th colspan="6">Default Setting</th>
                                </tr>
                                {% for role in source.roles %}
                                <tr class="role">
                                    <th>{{ roles[role.id].name }}</th>
                                    <td class="toggle">
                                        {% for val, state in ['off', 'on'] %}
                                        <label>
                                            <input class="toggle" {% if role.enabled == val %}checked="checked"{% endif %} type="radio" value="{{ val }}" name="data[{{ ns[namespace.id].slug }}][{{ sources[source.id].key }}][{{ role.id }}][enabled]" />
                                            {{ state | capitalize }}
                                        </label>
                                        {% endfor %}
                                    </td>
                                    <td class="mutable {% if role.enabled == false %}disable{% endif %}">
                                        <input {% if role.mutable %}checked="checked"{% endif %} type="checkbox" name="data[{{ ns[namespace.id].slug }}][{{ sources[source.id].key }}][{{ role.id }}][muted]" />
                                    </td>
                                    {% for level, perm in perms %}
                                    <td class="perm {% if role.enabled == false %}disable{% endif %}">
                                        <input id="p-{{ ns[namespace.id].slug }}-{{ source.id }}-{{ role.id }}-{{ level }}" name="data[{{ ns[namespace.id].slug }}][{{ sources[source.id].key }}][{{ role.id }}][perm][]" data-perm="{{ level }}" type="{{ level <= 250 ? 'radio' : 'checkbox' }}" {% if perms[role.default][0] == perm[0] %}checked="checked"{% endif %} />
                                        <label for="p-{{ ns[namespace.id].slug }}-{{ source.id }}-{{ role.id }}-{{ level }}">
                                            <span>{{ perm[0] | raw }}</span>
                                        </label>
                                    </td>
                                    {% endfor %}
                                    <td class="custom {% if role.enabled == false %}disable{% endif %}">
                                        <span class="actions">
                                            <a href="#" class="btn no-text modify"><span></span></a>
                                        </span>
                                    </td>
                                {% endfor %}
                            </table>
                        </form>
                    </li>
                {% endfor %}
                </ul>
            </li>
            {% endfor %}
        </ul>
    </div>
</div>
