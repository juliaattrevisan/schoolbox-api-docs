<script type="text/javascript" src="{{ CDN_PREFIX }}/js/notifications/jquery.msg-config.js?v={{ config.site_version }}"></script>
<!--suppress NonShortCircuitBooleanExpressionJS -->
<script type="text/javascript">

    var levelOff     = 0,
        levelInstant = 1,
        levelPush    = 2,
        levelEmail   = 4,
        levelDigest  = 8,
        desc         = {};

    desc[levelOff]      = 'off';
    desc[levelDigest]   = 'digest';
    desc[levelInstant]  = 'instant';
    desc[levelPush]     = 'mobile';
    desc[levelEmail]    = 'email';

    $(function () {

        var ii, configurator;

        configurator = $('#configurator').msgconfig({
            sourceSelector: '[data-source]',
            tableSelector:  '[data-digest-settings]',
            roleSelector:   '[data-role]',
            customSelector: '[data-custom]',
            permSelector:   '[data-perm-container]',
            persist: function () {
                var form = this.closest('form[method=post]');

                // clear any previous cache-timeout
                if (ii) {
                    clearTimeout(ii);
                }

                ii = setTimeout(function () {

                    // Disable all inputs while it's saving
                    form.find('input').prop('disabled', true);

                    // Serialize the form
                    var formSerialized = form.serializeArray();

                    // Go through disabled inputs and add selected to the serialized form
                    form.find('input[disabled]').each(function() {
                        if ($(this).is(':checked')) {
                            formSerialized.push({name: $(this).attr('name'), value: $(this).val()});
                        }
                    });

                    $.post(form.attr('action'), formSerialized).done(customiserCallback);

                }, 1000);

            },
            describe: function () {

                var summary = this.find('[data-summary]'),
                    table   = this.find('[data-roles]'),
                    rows    = table.find('[data-role]'),
                    text    = 'Sent to ',
                    count   = 0;

                rows.each(function () {
                    var row  = $(this),
                        ins  = row.find('input[data-perm]:checked'),
                        role = row.find('[data-role-title]').text(),
                        sum  = 0;

                    if (!role) {
                        --count;
                        return;

                    } else if (ins.length == 0) {
                        return;

                    } else if (ins.eq(0).data('perm') == 0) {
                        row.data('sum', 0);
                        return;
                    }

                    text += role + ' via ';

                    ins.each(function () {
                        var i   = $(this),
                            lbl = desc[i.data('perm')];

                        if (typeof lbl === 'undefined' || lbl === 'off') {
                            return;
                        }

                        text += lbl + ' + ';
                        sum  += i.data('perm');
                    });

                    text = text.slice(0, text.length - 3);

                    text += '; ';
                    ++count;
                });

                if (count < 0) {
                    return;
                } else if (count == 0) {
                    text += 'nobody';
                } else {
                    text = text.slice(0, text.length - 2);
                }

                summary.text(text + '.');

            },
            advanced: function () {
                var row    = this.closest('[data-role]'),
                    dialog = $('#slider-modal'),
                    src = row.closest('[data-source]');

                var data = {
                    source: row.closest('[data-source]').data('source'),
                    slug: row.closest('[data-namespace]').data('namespace'),

                    {# twig inside js... what could possibly go wrong... #}
                    {% if filters.options[filters.selected] != 'all' %}
                    roletype: '{{ filters.options[filters.selected] }}',
                    {% endif %}

                    role: row.data('role')
                }

                /* Replace with a foundation modal
                 */
                // url with extra parameters
                dialog.foundation('reveal', 'open', {
                    url: '/adminv2/messages/configure/custom',
                    data: data
                });

                /* Bypass foundation bug
                 * https://github.com/zurb/foundation/issues/4746
                 */
                dialog.on('opened', function() {
                    var closeButton = '<a class="close-reveal-modal">&#215;</a>';

                    dialog.append(closeButton);
                });

                dialog.on('close.fndtn.reveal', function() {
                    configurator.msgconfig('describe', src);
                });
            }
        });

        $('[data-collapser]').collapsable();
    });

    function customiserCallback(data) {

        $.each(data, function (slug, sources) {

            var $ns = $('#configurator').find('[data-namespace=' + slug + ']');

            $.each(sources, function (source, roles) {

                $.each(roles, function (role, config) {

                    var $role = $ns.find('[data-role=' + role + '][data-source=' + source + ']'),
                        options,
                        inDefault = function () {
                            var p = $(this).data('perm');
                            // bitwise! single &
                            return !!(config.default & p || (config.default == 0 && p == 0));
                        },
                        inMask = function () {
                            var p = $(this).data('perm');
                            // bitwise! single &
                            return !!(config.mask[1] & p || (config.mask[0] && p == 0));
                        };

                    // reset all, switch on/off based on masks
                    options = $role.find('input[data-perm]')
                        .prop('checked', false)
                        .prop('disabled', true)
                        .attr('disabled', 'disabled');

                    options.filter(inMask).prop('disabled', false).removeAttr('disabled');
                    options.filter(inDefault).prop('checked', true);

                    options.eq(0).trigger('change.force');
                });
            });
        });
    }
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <div class="row">
                <div class="small-12 columns">
                    <h2 class="subheader">Global Notification Settings</h2>
                </div>
                <div class="small-12 island">
                    <section class="content">
                        <p>Use this page to configure the notifications the system will send to users.</p>
                        <ul>
                            <li>
                                <em>Selected options</em> are the way this notification should be received by default (remembering users can personalise their settings).
                            </li>
                            <li>
                                <em>Disabled options</em> will not be selectable by users of the given role
                            </li>
                            <li>
                                You can customise and restrict users' delivery options by using the modify button
                            </li>
                            <li>
                                To hide a notification source from members of a role, lock that source to Muted
                            </li>
                        </ul>
                    </section>

                    <div class="actions-small-1 row">
                        <div class="list-item">
                            <div class="small-12 columns">
                                <h2 class="subheader" id="filter">Configure Settings</h2>
                            </div>
                        </div>
                        <nav>
                            <a href="#" data-reveal-id="legend-modal" class="icon-help" title="View Help"></a>
                        </nav>
                    </div>

                    <ul class="sub-nav">
                        {% for i, filter in filters.options %}
                            <li class="{% if filters.selected == i %}active{% endif %}">
                                <a href="/adminv2/messages/configure{{ filter == 'all' ? '' : ('/' ~ filter) }}">{{ filter | capitalize }}</a>
                            </li>
                        {% endfor %}
                    </ul>

                    {% if config|length  %}
                    <div id="configurator">
                        {% for namespace in msgConfig %}
                            {% if ns[namespace.id] is defined %}
                            <h3 class="subheader">{{ locale.translateSentence(ns[namespace.id].label) }}</h3>
                            <section data-namespace="{{ ns[namespace.id].slug }}">
                                {% for source in namespace.sources %}
                                    {% include '@messages/source.twig' with { source: source } %}
                                {% endfor %}
                            </section>
                            {% endif %}
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="empty-state">
                        <p>No roles exist with this role type</p>
                    </div>
                    {% endif %}
                </div><!-- small-12 island -->
            </div><!-- row -->
        </div><!-- small-12 columns -->
    </div><!-- admin-content -->
</div>
<div id="slider-modal" class="reveal-modal" data-reveal></div>

<div id="legend-modal" class="reveal-modal" data-reveal>
    {% include '@messages/legend.twig' with { digest: true, mobile: 'plural', who: 'users' } %}

    <a class="close-reveal-modal">&#215;</a>
</div>
