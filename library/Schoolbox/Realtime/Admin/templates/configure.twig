<style type="text/css">
    .digest-settings:hover td, .digest-settings:hover th {
        /*opacity: 1 !important;*/
    }
    .digest-settings tr {
        transition: height 200ms ease-out;
        height: 32px;
        line-height: 32px;
    }
    .digest-settings td {
        overflow: hidden;
        border: none;
        /*line-height: 48px;*/
    }
    td.perm {
        min-width: 32px;
        padding: 0 2px !important;
    }
    .digest-settings .perm label {
        display: block;
    }
    td.toggle {
        white-space: nowrap;
    }
    .digest-settings td.mutable input[type=checkbox] {
        position: static;
        opacity: 1;
        margin-left: 24px;
    }
    .digest-settings input[disabled] + label {
        opacity: 0.2;
    }
    .admin-nav.filter {
        margin-top: 2em;
    }
    .mutable.disable, .perm.disable, .custom.disable {
        /*opacity: 0;*/
    }
    .perm label span {
        /*font-size: 18px;*/
    }
    .digest-settings td.disable * {
        visibility: hidden;
    }
    .digest-settings tr.show-advanced td {
        /*height: 200px;*/
        /*vertical-align: top !important;*/
    }
    .digest-settings tr.show-advanced td.simple {
        display: none;
    }
    .digest-settings tr.show-advanced td.custom {
        width: 345px;
    }
    .digest-settings td.custom > div {
        display: none;
    }
    .digest-settings tr.show-advanced td.custom > div {
        display: block;
    }
    td .actions {
        float: right;
        padding-top: 4px;
    }
    .digest-settings svg {
        width: 16px;
        margin-top: 5px;
    }
    .digest-settings td.perm input:checked + label svg {
        fill: #fff;
    }
    .custom-descrip {
        display: none;
    }
    .expanded .custom-descrip {
        display: inline;
    }
</style>
<script type="text/javascript" src="/javascript/jquery.msgConfig.js"></script>
<script type="text/javascript" src="/javascript/jquery.svgInline.js"></script>
<!--suppress NonShortCircuitBooleanExpressionJS -->
<script type="text/javascript">

    var levelOff     = 0,
        levelInstant = 1,
        levelPush    = 2,
        levelEmail   = 4,
        levelDigest  = 8,
        desc         = {};

    desc[levelOff]      = 'off';
    desc[levelDigest]   = 'digest';
    desc[levelInstant]  = 'instant';
    desc[levelPush]     = 'mobile';
    desc[levelEmail]    = 'email';

    $(function () {

        var ii;

        // inlineify all SVGs
        $('body').svgInline();

        $('#configurator').msgconfig({
            sourceSelector: 'li.source',
            tableSelector:  '.digest-settings',
            roleSelector:   'tr',
            toggleSelector: '.toggle',
            muteSelector:   '.mutable',
            customSelector: 'td.custom',
            permSelector:   '.perm',
            persist: function () {
                var form = this.children('form[method=post]');

                // clear any previous cache-timeout
                if (ii) {
                    clearTimeout(ii);
                }

                ii = setTimeout(function () {
                    $.post(form.attr('action'), form.serialize(), customiserCallback);
                }, 1000);

            },
            describe: function () {

                var summary = this.find('h4 em.summary'),
                    table   = this.find('table.roles'),
                    rows    = table.find('tr.role'),
                    text    = 'Sent to ',
                    count   = 0;

                rows.each(function () {
                    var row  = $(this),
                            ins  = row.find('input[data-perm]:checked'),
                            role = row.children('th').text(),
                            sum  = 0;

                    if (!role) {
                        --count;
                        return;

                    } else if (ins.length == 0) {
                        return;

                    } else if (ins.eq(0).data('perm') == 0) {
                        row.data('sum', 0);
                        return;
                    }

                    text += role + ' via ';

                    ins.each(function () {
                        var i   = $(this),
                                lbl = desc[i.data('perm')];

                        if (typeof lbl === 'undefined' || lbl === 'off') {
                            return;
                        }

                        text += lbl + ' + ';
                        sum  += i.data('perm');
                    });

                    text = text.slice(0, text.length - 3);

                    text += '; ';
                    ++count;
                });

                if (count < 0) {
                    return;
                } else if (count == 0) {
                    text += 'nobody';
                } else {
                    text = text.slice(0, text.length - 2);
                }

                summary.text(text + '.');

            },
            onShowAdvanced: function () {
                var row    = this.closest('tr'),
                    dialog = $('#slider-modal'),
                    query  = [
                        'source='+row.closest('[data-source]').data('source'),
                        'slug='+row.closest('[data-namespace]').data('namespace'),
                        {% if filters.options[filters.selected] != 'all' %}'roletype={{ filters.options[filters.selected] }}',{% endif %}{# twig inside js... what could possibly go wrong... #}
                        'role='+row.data('role')
                    ].join('&');


                hideSimpleSettings.apply(this);

                dialog.load('/adminv2/messages/configure/custom', query, function () {
                    dialog.dialog({
                        modal: true,
                        resizable: false,
                        width: 640,
                        title: 'Advanced Settings'
                    });
                });

            },
            onShowSimple: showSimpleSettings
        });
    });

    function hideSimpleSettings() {
        this.closest('tr').addClass('show-advanced');
        this.closest('td').attr('colspan', 8).addClass('expanded');
    }

    function showSimpleSettings() {
        this.closest('tr').removeClass('show-advanced');
        this.closest('td').removeAttr('colspan').removeClass('expanded');
    }

    function customiserCallback(data) {

        console.log(data);

        $.each(data, function (slug, sources) {

            var $ns = $('#configurator').find('li[data-namespace='+slug+']');

            $.each(sources, function (source, roles) {

                var $src = $ns.find('li[data-source='+source+']');

                $.each(roles, function (role, config) {

                    var $role   = $src.find('tr[data-role='+role+']'),
                        bitwise = function () {
                            // bitwise! single &
                            return !!(config.default & $(this).data('perm'));
                        },
                        descrip, $custom;

                    // turned off
                    if (config == false) {
                        showSimpleSettings.apply($role.find('a.btn.modify'));
                        // ensure off selected
                        $role.find('td.toggle input[value=0]').prop('checked', true);

                        return true; // jq:continue
                    }

                    // ensure on selected
                    $role.find('td.toggle input[value=1]').prop('checked', true);

                    // if custom settings, show custom
                    if (config.custom) {
                        hideSimpleSettings.apply($role.find('a.btn.modify'));

                        descrip = $role.find('td[data-perm]').filter(bitwise).find('label').map(function () {
                            return this.title;
                        }).toArray().join(' + ');

                        $custom = $role.find('td.custom');

                        if ($custom.find('span.custom-descrip').length == 0) {
                            $custom.prepend($('<span class="custom-descrip" />'));
                        }

                        $custom.find('span.custom-descrip').text('Custom (default '+descrip.toLowerCase()+')');

                        return true; // jq:continue
                    }

                    // turn the appropriate inputs on and off
                    showSimpleSettings.apply($role.find('a.btn.modify'));

                    // first check 'mutable'
                    $role.find('td.mutable input').prop('checked', config.mutable).trigger('change.force');

                    // then turn on only the relevant options
                    $role.find('td[data-perm]').prop('checked', false).filter(bitwise).prop('checked', true).trigger('change.force');

                });
            });
        });
    }


</script>
<div class="admin-contents clearfix">
    <h2>Global Message Settings</h2>
    <p class="clearfix">
        <a class="btn go-back float-left" href="{{ '/adminv2/messages' }}"><span></span>Back to Messages</a>
    </p>
    <div class="level clearfix">
        <p>
            Use this page to configure the messages the system will send to users:
        </p>
        <ul style="list-style: disc;padding-left:20px;">
          <li><strong>Enabled</strong>: can users in this role receive this message at all</li>
          <li><strong>Mutable</strong>: do users in this role have the option to turn this message off</li>
          <li><strong>Default Setting</strong>: by default, how should this message be sent to users in this role (users can customise their personal settings)</li>
          <li>If you need more fine-grained control for a message, click the customise button next to the role for advanced settings</li>
        </ul>
        <ul class="filter admin-nav clearfix">
            <li>
                <span>Filter messages relevant to:</span>
            </li>
            {% for i, filter in filters.options %}
            <li>
                <a href="/adminv2/messages/configure{{ filter == 'all' ? '' : ('/' ~ filter) }}" class="{% if filters.selected == i %}current{% endif %}">{{ filter | capitalize }}</a>
            </li>
            {% endfor %}
        </ul>
        <div class="clearfix pad-it"></div>
        <ul id="configurator" class="namespaces">
            {% for namespace in config %}
            <li class="namespace" data-namespace="{{ ns[namespace.id].slug }}">
                <h3>{{ ns[namespace.id].label }}</h3>
                <ul class="sources">
                {% for source in namespace.sources %}
                    {% include '@adminMessages/source.twig' with { source: source } %}
                {% endfor %}
                </ul>
            </li>
            {% endfor %}
        </ul>
    </div>
</div>
<div id="slider-modal" class="namespaces"></div>