<li class="source" data-source="{{ sources[source.id].key }}">
    <form> {# for some reason required for formatting and js targeting -_- #}
        <h4>
            <a class="exp darr" href="#">&#9660;</a>
            <span class="label">"Send a message when {{ sources[source.id].description }}."</span>
            <em class="summary">&nbsp;</em>
        </h4>
    </form>
    <form method="post" style="display:none;">
        <table class="roles digest-settings">
            <tr class="thead">
                <th width="300">Role</th>
                <th width="150">Enabled</th>
                <th width="100">Mutable</th>
                <th colspan="6">Default Setting</th>
            </tr>
            {% for role in source.roles %}
                <tr class="role" data-role="{{ role.id }}">
                    <th>
                        {{ roles[role.id].name }}
                    </th>
                    <td class="toggle">
                        {% for val, state in ['off', 'on'] %}
                            <label>
                                <input class="toggle"
                                       {% if role.enabled == val %}checked="checked"{% endif %}
                                       type="radio" value="{{ val }}"
                                       name="data[{{ ns[namespace.id].slug }}][{{ sources[source.id].key }}][{{ role.id }}][enabled]"
                                />
                                {{ state | capitalize }}
                            </label>
                        {% endfor %}
                    </td>
                    <td class="simple mutable {% if role.enabled == false %}disable{% endif %}">
                        <input {% if 'MU' in role.mask %}checked="checked"{% endif %}
                               type="checkbox"
                               name="data[{{ ns[namespace.id].slug }}][{{ sources[source.id].key }}][{{ role.id }}][mutable]"
                               value="1"
                        />
                    </td>
                    {% include '@adminMessages/options.twig' with { mode: 'p' } %}
                    <td class="custom{% if role.enabled == false %} disable{% endif %}">
                        <span class="actions">
                            <a href="#" class="btn no-text modify" title="Advanced"><span></span></a>
                        </span>
                    </td>
                </tr>
            {% endfor %}
        </table>
    </form>
</li>
