{% set appId = app.appIdentifier | replace({'.': '-'}) %}
<div class="small-12 column content">
    <dl class="inline-dl">
        <dt class="small-12 medium-4">App ID</dt>
        <dd class="small-12 medium-4"><p>{{ app.appIdentifier }}</p></dd>
        <dd class="small-12 medium-4">
            <a class="right sbx-icon-only-button" data-id="{{ app.id }}" href="#" title="Delete" aria-label="Delete" data-delete-provider>
                <sbx-icon name="delete"></sbx-icon>
            </a>
        </dd>

        <dt class="small-12 medium-4">Provider</dt>
        <dd class="small-12 medium-8"><p>Google</p></dd>

        <dt class="small-12 medium-4">Google Cloud Messaging API Key</dt>
        <dd class="small-12 medium-8">
            <p>
                <code>{{ app.key }}</code>
                (<a href="#" data-open="change-gcm-{{ appId }}">Change</a>)
            </p>
        </dd>
    </dl>
    <div class="row">
        <div class="small-12 column">
            <form style="display:none;" id="change-gcm-{{ appId }}" action="{{ routeLookup('adminNotifications.postModifyApp') }}" method="post">
                <input type="hidden" name="id" value="{{ app.id }}" />
                <input type="hidden" name="app" value="{{ app.appIdentifier }}" />
                <input type="hidden" name="provider" value="{{ app.providerName }}" />
                <div class="row">
                    <div class="small-12 column">
                        <label for="gcm-entity-key">New GCM API Key</label>
                        <input id="gcm-entity-key" type="text" name="key" value="" />
                    </div>
                    <div class="small-12 column">
                        <input type="submit" value="Install New Key">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
