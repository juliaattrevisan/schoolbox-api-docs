{% set appId = app.appIdentifier | replace({'.': '-'}) %}
<div class="small-12 column content">
    <dl class="inline-dl">
        <dt class="small-12 medium-4">App ID</dt>
        <dd class="small-12 medium-4"><p>{{ app.appIdentifier }}</p></dd>
        <dd class="small-12 medium-4">
            <a class="right sbx-icon-only-button" data-id="{{ app.id }}" href="#" title="Delete" aria-label="Delete" data-delete-provider>
                <sbx-icon name="delete"></sbx-icon>
            </a>
        </dd>

        <dt class="small-12 medium-4">Provider</dt>
        <dd class="small-12 medium-8"><p>TASS Orbit</p></dd>

        <dt class="small-12 medium-4">Configuration</dt>
        <dd class="small-12 medium-8">
            <p>
                <code>{{ app.key }}</code>
                (<a href="#" data-open="change-tassorbit-{{ appId }}">Change</a>)
            </p>
        </dd>
    </dl>
    <div class="row">
        <div class="small-12 column">
            <form style="display:none;" id="change-tassorbit-{{ appId }}" action="{{ routeLookup('adminNotifications.postModifyApp') }}" method="post">
                <input type="hidden" name="id" value="{{ app.id }}" />
                <input type="hidden" name="app" value="{{ app.appIdentifier }}" />
                <input type="hidden" name="provider" value="{{ app.providerName }}" />
                <div class="row">
                    <div class="small-12 column">
                        <label for="tass-entity-host">Endpoint</label>
                        <input id="tass-entity-host" type="text" name="host" value=""/>

                        <label for="tass-entity-app">App Code</label>
                        <input id="tass-entity-app" type="text" name="app" value="" />

                        <label for="tass-entity-key">Token</label>
                        <input id="tass-entity-key" type="text" name="key" value=""/>

                        <label for="tass-entity-companycode">Company Code</label>
                        <input id="tass-entity-companycode" type="text" name="companycode" value=""/>
                    </div>
                    <div class="small-12 column">
                        <input type="submit" value="Install New Key">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
