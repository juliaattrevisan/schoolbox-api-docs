{% set appId = app.appIdentifier | replace({'.': '-'}) %}
<div class="small-12 column content">
    <dl class="inline-dl">
        <dt class="small-12 medium-4">App ID</dt>
        <dd class="small-12 medium-4"><p>{{ app.appIdentifier }}</p></dd>
        <dd class="small-12 medium-4">
            <a class="right sbx-icon-only-button" data-id="{{ app.id }}" href="#" title="Delete" aria-label="Delete" data-delete-provider>
                <sbx-icon name="delete"></sbx-icon>
            </a>
        </dd>

        <dt class="small-12 medium-4">Provider</dt>
        <dd class="small-12 medium-8"><p>Firebase</p></dd>

        <dt class="small-12 medium-4">Public Configuration</dt>
        <dd class="small-12 medium-8">
            <p>
                <code>{{ app.publicConfiguration }}</code>
                (<a href="#" data-open="change-firebase-{{ appId }}">Change</a>)
            </p>
        </dd>

        <dt class="small-12 medium-4">Private Key</dt>
        <dd class="small-12 medium-8">
            <p>
                <em>Provided</em>
                (<a href="#" data-open="change-firebase-{{ appId }}">Change</a>)
            </p>
        </dd>

        <dt class="small-12 medium-4">Web Push Public Key</dt>
        <dd class="small-12 medium-8">
            <p>
                <code>{{ app.webPushPublicKey }}</code>
                (<a href="#" data-open="change-firebase-{{ appId }}">Change</a>)
            </p>
        </dd>
    </dl>
    <div class="row">
        <div class="small-12 column">
            <form style="display:none;" id="change-firebase-{{ appId }}" action="{{ routeLookup('adminNotifications.postModifyApp') }}" method="post">
                <input type="hidden" name="id" value="{{ app.id }}" />
                <input type="hidden" name="app" value="{{ app.appIdentifier }}" />
                <input type="hidden" name="provider" value="{{ app.providerName }}" />
                <div class="row">
                    <div class="small-12 column">
                        <label>Public Configuration
                            <p class="meta">Publicly available configuration for Firebase app for this Schoolbox instance.</p>
                            <p class="meta">
                                This is a JavaScript object which may be copied from Firebase, via:
                                &ldquo;Project Settings > General > Your apps > (your app nickname) > SDK setup and configuration > Config.&ldquo;:
                                paste in only the {, } and their contents.
                            </p>
                            <textarea name="publicConfiguration">{{ app.publicConfiguration }}</textarea>
                        </label>

                        <label>New Private Key
                            <p class="meta">New private configuration for Firebase app for this Schoolbox instance.</p>
                            <p class="meta">
                                This is a JSON object which may be downloaded from Firebase, via:
                                &ldquo;Project Settings > Service Accounts > Firebase Admin SDK > Generate new private key&ldquo;:
                                Paste its contents into this field.
                            </p>
                            <textarea name="key"></textarea>
                        </label>

                        <label>Web Push Public Key
                            <p class="meta">Public key for Firebase app for this Schoolbox instance, used for registering a device with Firebase.</p>
                            <p class="meta">
                                This is a key which may be generated within Firebase, via:
                                &ldquo;Project Settings > Cloud Messaging > Web configuration > Web push certificates > Generate key pair&rdquo;:
                                Paste its value into this field.
                            </p>
                            <input type="text" name="webPushPublicKey" value="{{ app.webPushPublicKey }}" />
                        </label>

                    </div>
                    <div class="small-12 column">
                        <input type="submit" value="Install New Key">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
