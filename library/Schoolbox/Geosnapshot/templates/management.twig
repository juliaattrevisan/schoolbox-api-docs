{# if no geo session, show login button #}
{% if not session %}
    <div class="small-12 island">
        <section class="content" data-equalizer-watch="">
            <p style="text-align:center">
            <img src="https://blog.geosnapshot.com/hubfs/Brand%20Logos/Geo%20Transparent%20Square%20Logo%2C%201200x1200.png" height="200x" width="200px">
            </p>
            <a href="{{ launchUrl }}" class="button submit">Access Photos and Media</a>
        </section>
    </div>
{% else %}
    {# session exists, show iframe of geo #}
    {% include '@core/sub/iframe.twig' with { url: libraryUrl } %}
{% endif %}
