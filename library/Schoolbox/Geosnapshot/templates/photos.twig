{##
 # photos
 #
 # Display all the photos associated with a given person $viewee
 #
 # @param array $allBreadcrumbs  A trail of crumbularity
 # @param User $viewee           The person being viewed
 # @param string $url            A url from geosnapshot
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

{# Null payload prevents this from rendering
 # Used while we're developing and testing with random base64 images
 #}
{% include '@geosnapshotApi/photosDiagnostic.twig' with {
    payload: payload ?? null
} %}

<div class="row">
    <div class="small-12 columns">
        <iframe src="{{ url }}" class="fullscreen"></iframe>
    </div>
</div>
