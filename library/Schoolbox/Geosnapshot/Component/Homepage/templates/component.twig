{##
 # Geosnapshot Homepage component
 #
 # @param string|null $url  A url from Geosnapshots, contains all the image galleries
 # @param int|null $height  The height of the component
 #}
{% if url %}
<iframe src="{{ url }}" {% if height %}style="height: {{ height }}px"{% endif %}></iframe>
{% else %}
<div class="empty-state">
    <i class="icon-geosnapshot"></i>
    <p>GeoSnapShot is misconfigured; contact your system administrator for support.</p>
</div>
{% endif %}
