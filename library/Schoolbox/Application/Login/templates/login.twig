<!DOCTYPE html>
<html>
<!--  Copyright {{ NOW.year }} Schoolbox Pty Ltd -->
<!--  Visit us at https://schoolbox.com.au/ -->
<head>
<title>{{  config.title }}</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta http-equiv="Content-Language" content="en-au" />
<meta name="author" content="Schoolbox Pty Ltd"/>
<meta name="application-name" content="{{ config.school_name }}" />
<meta name="msapplication-TileColor" content="#0066b0" />
<meta name="msapplication-square70x70logo" content="/images/logo.php?logo=skin_logo_square&size=tile70" />
<meta name="msapplication-square150x150logo" content="/images/logo.php?logo=skin_logo_square&size=tile150" />
<meta name="msapplication-wide310x150logo" content="/images/logo.php?logo=skin_logo_login&size=tile310" />
<meta name="msapplication-square310x310logo" content="/images/logo.php?logo=skin_logo_large&size=tile310" />
<meta name="viewport" content="initial-scale=1, maximum-scale=1">
<link rel="apple-touch-icon" sizes="57x57" href="/images/logo.php?logo=skin_logo_square&size=apple57">
<link rel="apple-touch-icon" sizes="60x60" href="/images/logo.php?logo=skin_logo_square&size=apple60">
<link rel="apple-touch-icon" sizes="72x72" href="/images/logo.php?logo=skin_logo_square&size=apple72">
<link rel="apple-touch-icon" sizes="76x76" href="/images/logo.php?logo=skin_logo_square&size=apple76">
<link rel="apple-touch-icon" sizes="114x114" href="/images/logo.php?logo=skin_logo_square&size=apple114">
<link rel="apple-touch-icon" sizes="120x120" href="/images/logo.php?logo=skin_logo_square&size=apple120">
<link rel="apple-touch-icon" sizes="144x144" href="/images/logo.php?logo=skin_logo_square&size=apple144">
<link rel="apple-touch-icon" sizes="152x152" href="/images/logo.php?logo=skin_logo_square&size=apple152">
<link rel="apple-touch-icon" sizes="180x180" href="/images/logo.php?logo=skin_logo_square&size=apple180">
<link rel="Shortcut Icon" href="/images/logo.php?logo=skin_logo_square&size=favicon" type="image/x-icon" />
{% include 'include/skin.twig' with { config: config } only %}

{% autoescape 'css' %}
    <style type="text/css">
        body.login {
            background-image: url("{{ random(login_backgrounds) }}");
        }
    </style>
{% endautoescape %}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/main.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/browser/browser-redirect.js?v={{ config.site_version }}"></script>
{% if config.site_usage_tracking %}
    <!-- Global Site Tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-97642429-1"></script>

    {% autoescape 'js' %}
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments)}
        gtag('js', new Date());

        // Set tracking ID and map custom dimensions
        gtag('config', 'UA-97642429-1', {
            'custom_map': {
                'dimension1': 'site_school_code',
                'dimension2': 'site_type',
                'dimension6': 'site_version'
            }
        });

        // Send custom dimension events
        gtag('event', 'site_school_code_dimension', {'site_school_code': '{{ config. site_school_code }}'});
        gtag('event', 'site_type_dimension', {'site_type': '{{ config.site_type }}'});
        gtag('event', 'site_version_dimension', {'site_version': '{{ config.site_version }}'});

    </script>
    {% endautoescape %}

{% endif %}
</head>
<body class="login side">
<div id="container">
	<div id="content">
		<form id="login" method="post" action="{{ routeLookup('login.postLogin') }}?{{ requestParams|escape }}">
            <input type="hidden" name="page" value="{{ page|escape }}" />
            <div class="row collapse">
                <div class="small-12 column">
                    <div class="logo">
                        <img src="/images/logo.php?logo=skin_logo_login&size=normal" alt="{{ config.title }}" />
                    </div>
                </div>
                <div class="small-12 column">
                    <p id="error-msg" class="alert-box alert">{{ error }}</p>
                </div>
                <div class="small-12 column">
                    <input type="text" name="username" id="username" placeholder="Username" />
                    <input type="password" name="password" id="password" placeholder="Password" />
                </div>
            </div>
            <div class="row collapse">
                {% if config.login_terms_and_conditions != '' %}
                <div class="small-12 column">
                    <input required
                           class="required"
                           id="tandc"
                           name="tandc"
                           value="1"
                           type="checkbox"
                           title="{{ config.login_terms_and_conditions_error }}" />
                    <label for="tandc" class="tandc">
                        {{ config.login_terms_and_conditions|purify }}
                    </label>
                </div>
                {% endif %}

                {% if config.forgotten_password_text and config.forgotten_password_url %}
                <div class="small-12 column">
                    <p><a href="{{ config.forgotten_password_url }}">{{ config.forgotten_password_text }}</a></p>
                </div>
                {% endif %}

                {% if config.session_remember %}
                <div class="small-12 column">
                    <input id="rememberme" type="checkbox" name="rememberme" value="1" />
                    <label for="rememberme">Remember me</label>
                </div>
                {% endif %}
                <div class="small-12 column login-links">
                    <input type="submit" name="Submit" value="Login" />

                    {% if config.login_anonymous != '' or config.saml_sso_url != '' or config.saml_idp_metadata_url != '' %}
                    <p> - OR - </p>
                    {% endif %}

                    {% if config.login_anonymous != '' %}
                    <p><a href="/account/anonymous.php?{{ requestParams|escape }}" class="guest">Login as guest</a></p>
                    {% endif %}

                    {% if config.saml_sso_url != '' or config.saml_idp_metadata_url != '' %}
                        {% block sso %}
                    <p><a href="/saml/index.php?{{ requestParams|escape }}" class="samlbutton">Login using Single Sign-On</a></p>
                        {% endblock %}
                    {% endif %}
                </div>
            </div>
        </form>
    </div>
    <div id="footer">
        <ul>
            <li>{{ NOW.year }} &copy; Copyright <a href="{{ config.school_address }}">{{ config.school_name }}</a></li>
            <li><a href="{{ routeLookup('policy.getPolicy') }}">Guidelines of Use and Privacy Policy</a></li>
            <li><a href="https://schoolbox.com.au" title="Schoolbox, Virtual Learning Environment, Learning Management System, LMS">Schoolbox</a>
                {{ config.site_version }}</li>
            {% if config.feedback_url and config.feedback_text %}
                <li><a href="{{ config.feedback_url }}">{{ config.feedback_text }}</a></li>
            {% endif %}
        </ul>
    </div>
</div>
<script type="text/javascript">

    function isTouchDevice() {
        return (('ontouchstart' in window) ||
        (navigator.maxTouchPoints > 0) ||
        (navigator.msMaxTouchPoints > 0));
    }
    if (!isTouchDevice()) {
        document.getElementById('username').focus();
    }

    var l, fy;

    $(function () {

        l = $('#login');

        fy = $('#footer').height();

        $(window).on('load resize', function () {
            l.css('top', Math.max(0, ($(window).height() - l.height() - fy) / 2));
        });

        // Validation of terms and conditions
        l.alaressValidate({
            ignoreTitle: false,
            errorPlacement: function(error, element) {
                if (element.attr("name") == "tandc") {
                    error.appendTo("#error-msg");

                } else {
                    error.appendTo(element);
                }
            }
        });
        // T&C: remove error message completely on check`
        l.find('#tandc').on('change', function () {
            if (this.checked) {
                $('#error-msg').remove();
            }
        });
    });
</script>
{{ config.site_analytics | replace({'{USER_ROLE}':''}) | raw }}
</body>
</html>
