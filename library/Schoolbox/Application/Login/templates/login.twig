<!DOCTYPE html>
<html>
<!--  Copyright {{ NOW.year }} Schoolbox Pty Ltd -->
<!--  Visit us at https://schoolbox.com.au/ -->
<head>
<title>{{  config.title }}</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta http-equiv="Content-Language" content="en-au" />
<meta name="author" content="Schoolbox Pty Ltd"/>
{% if not config.web_crawlers_enabled %}<meta name="robots" content="noindex">{% endif %}
<link rel="manifest" href="/manifest">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="{{ config.title }}">
<meta name="theme-color" content="{{ config.skin_colour_navigation_background }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="apple-mobile-web-app-title" content="{{ config.title }}">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="icon" href="/images/logo.php?logo=skin_favicon&size=favicon" />
<link rel="apple-touch-icon" sizes="57x57" href="/images/logo.php?logo=skin_favicon&size=apple57">
<link rel="apple-touch-icon" sizes="60x60" href="/images/logo.php?logo=skin_favicon&size=apple60">
<link rel="apple-touch-icon" sizes="72x72" href="/images/logo.php?logo=skin_favicon&size=apple72">
<link rel="apple-touch-icon" sizes="76x76" href="/images/logo.php?logo=skin_favicon&size=apple76">
<link rel="apple-touch-icon" sizes="114x114" href="/images/logo.php?logo=skin_favicon&size=apple114">
<link rel="apple-touch-icon" sizes="120x120" href="/images/logo.php?logo=skin_favicon&size=apple120">
<link rel="apple-touch-icon" sizes="144x144" href="/images/logo.php?logo=skin_favicon&size=apple144">
<link rel="apple-touch-icon" sizes="152x152" href="/images/logo.php?logo=skin_favicon&size=apple152">
<link rel="apple-touch-icon" sizes="180x180" href="/images/logo.php?logo=skin_favicon&size=apple180">
{% include 'include/skin.twig' with { config: config } only %}

{% autoescape 'css' %}
    <style type="text/css">
        body.login {
            background-image: url("{{ random(login_backgrounds) }}");
        }
    </style>
{% endautoescape %}

<script src="{{ CDN_PREFIX }}/js/bundle/vendors.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/main.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/browser/browser-redirect.js?v={{ config.site_version }}"></script>

{% if config.site_usage_tracking %}
    {% autoescape 'js' %}
        <!-- Google Tag Manager -->
        <script>
            window.dataLayer = window.dataLayer || [];
            dataLayer.push({
                'event': 'page_view',
                'site_school_code': '{{ config. site_school_code }}',
                'site_type': '{{ config.site_type }}',
                'site_version': '{{ config.site_version }}',
            });
        </script>
        <script>
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','GTM-N8R6VLV');
        </script>
        <!-- End Google Tag Manager -->
    {% endautoescape %}

{% endif %}
</head>
<body class="login side">
<div id="container">
	<div id="content">
		<form id="login" method="post" action="{{ routeLookup('login.postLogin') }}?{{ requestParams|escape }}">
            <input type="hidden" name="page" value="{{ page|escape }}" />
            <div class="row collapse">
                <div class="small-12 column">
                    <div class="logo">
                        <img src="/images/logo.php?logo=skin_logo_login&size=normal" alt="{{ config.title }}" />
                    </div>
                </div>
                <div class="small-12 column">
                    <p id="error-msg" class="alert-box alert">{{ error }}</p>
                </div>
                <div class="small-12 column">
                    <input type="text" name="username" id="username" placeholder="Username" />
                    <input type="password" name="password" id="password" placeholder="Password" />
                </div>
            </div>
            <div class="row collapse">
                {% if config.login_terms_and_conditions != '' %}
                <div class="small-12 column">
                    <input required
                           class="required"
                           id="tandc"
                           name="tandc"
                           value="1"
                           type="checkbox"
                           title="{{ config.login_terms_and_conditions_error }}" />
                    <label for="tandc" class="tandc">
                        {{ config.login_terms_and_conditions|purify }}
                    </label>
                </div>
                {% endif %}

                {% if config.forgotten_password_text and config.forgotten_password_url %}
                <div class="small-12 column">
                    <p><a href="{{ config.forgotten_password_url }}">{{ config.forgotten_password_text }}</a></p>
                </div>
                {% endif %}

                {% if config.session_remember %}
                <div class="small-12 column">
                    <input id="rememberme" type="checkbox" name="rememberme" value="1" />
                    <label for="rememberme">Remember me</label>
                </div>
                {% endif %}
                <div class="small-12 column login-links">
                    <input type="submit" name="Submit" value="Login" />

                    {% if config.login_anonymous != '' or config.saml_sso_url != '' or config.saml_idp_metadata_url != '' %}
                    <p> - OR - </p>
                    {% endif %}

                    {% if config.login_anonymous != '' %}
                    <p><a href="/account/anonymous.php?{{ requestParams|escape }}" class="guest">Login as guest</a></p>
                    {% endif %}

                    {% if config.saml_sso_url != '' or config.saml_idp_metadata_url != '' %}
                        {% block sso %}
                    <p><a href="/saml/index.php?{{ requestParams|escape }}" class="samlbutton">Login using Single Sign-On</a></p>
                        {% endblock %}
                    {% endif %}

                    {# Only show OIDC login if it's enabled #}
                    {% set oidcUrl = routeLookup('loginOidc.getAuthorization') %}
                    {% if oidcUrl %}
                    {% block oidc %}
                        <p><a href="{{ oidcUrl }}?{{ requestParams|escape }}" class="oidcbutton">Login using OpenID Connect</a></p>
                    {% endblock %}
                    {% endif %}

                    {% if requestFromInternalIp %}
                        {% block internalSso %}
                            <p><a href="{{ internalSsoUrl }}" class="instance-registry-button">Login using Instance Registry</a></p>
                        {% endblock %}
                    {% endif %}
                </div>
            </div>
        </form>
    </div>
    <div id="footer">
        <ul>
            <li>{{ NOW.year }} &copy; Copyright <a href="{{ config.school_address }}">{{ config.school_name }}</a></li>
            <li><a href="{{ routeLookup('policy.getPolicy') }}">Guidelines of Use and Privacy Policy</a></li>
            <li><a href="https://schoolbox.com.au" title="Schoolbox, Virtual Learning Environment, Learning Management System, LMS">Schoolbox</a>
                {{ config.site_version }}</li>
            {% if config.feedback_url and config.feedback_text %}
                <li><a href="{{ config.feedback_url }}">{{ config.feedback_text }}</a></li>
            {% endif %}
        </ul>
    </div>
</div>
<script type="text/javascript">

    function isTouchDevice() {
        return (('ontouchstart' in window) ||
        (navigator.maxTouchPoints > 0) ||
        (navigator.msMaxTouchPoints > 0));
    }
    if (!isTouchDevice()) {
        document.getElementById('username').focus();
    }

    var l, fy;

    $(function () {

        l = $('#login');

        fy = $('#footer').height();

        $(window).on('load resize', function () {
            l.css('top', Math.max(0, ($(window).height() - l.height() - fy) / 2));
        });

        // Validation of terms and conditions
        l.alaressValidate({
            ignoreTitle: false,
            errorPlacement: function(error, element) {
                if (element.attr("name") == "tandc") {
                    error.appendTo("#error-msg");

                } else {
                    error.appendTo(element);
                }
            }
        });
        // T&C: remove error message completely on check`
        l.find('#tandc').on('change', function () {
            if (this.checked) {
                $('#error-msg').remove();
            }
        });

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js')
                        .then((reg) => {
                            console.log('Service worker registered.', reg);
                        });
            });
        }
    });
</script>
{{ config.site_analytics | replace({'{USER_ROLE}':''}) | raw }}
</body>
</html>
