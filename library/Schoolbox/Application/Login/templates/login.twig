<!DOCTYPE html>
<html lang="en">
<!--  Copyright {{ NOW.year }} Schoolbox Pty Ltd -->
<!--  Visit us at https://schoolbox.com.au/ -->
<head>
<title>{{  config.title }}</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta http-equiv="Content-Language" content="en-au" />
<meta name="author" content="Schoolbox Pty Ltd"/>
{% if not config.web_crawlers_enabled %}<meta name="robots" content="noindex">{% endif %}
<link rel="manifest" href="/manifest">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="{{ config.title }}">
<meta name="theme-color" content="{{ config.skin_colour_navigation_background }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="apple-mobile-web-app-title" content="{{ config.title }}">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="icon" href="/images/logo.php?logo=skin_favicon&size=favicon" />
<link rel="apple-touch-icon" sizes="57x57" href="/images/logo.php?logo=skin_favicon&size=apple57">
<link rel="apple-touch-icon" sizes="60x60" href="/images/logo.php?logo=skin_favicon&size=apple60">
<link rel="apple-touch-icon" sizes="72x72" href="/images/logo.php?logo=skin_favicon&size=apple72">
<link rel="apple-touch-icon" sizes="76x76" href="/images/logo.php?logo=skin_favicon&size=apple76">
<link rel="apple-touch-icon" sizes="114x114" href="/images/logo.php?logo=skin_favicon&size=apple114">
<link rel="apple-touch-icon" sizes="120x120" href="/images/logo.php?logo=skin_favicon&size=apple120">
<link rel="apple-touch-icon" sizes="144x144" href="/images/logo.php?logo=skin_favicon&size=apple144">
<link rel="apple-touch-icon" sizes="152x152" href="/images/logo.php?logo=skin_favicon&size=apple152">
<link rel="apple-touch-icon" sizes="180x180" href="/images/logo.php?logo=skin_favicon&size=apple180">
{% include 'include/skin.twig' with { config: config } only %}

{% autoescape 'css' %}
    <style type="text/css">
        body.login {
            background-image: url("{{ random(login_backgrounds) }}");
        }

        {# Make these login "buttons" blocky,
         # in expectation of a colour to be chosen and applied
         #}
        .samlbutton, .oidcbutton {
            display: block;
            padding: 0;
        }

        {# If a nontransparent colour was assigned, give it some nice padding
         # for that extra duplo feel; otherwise, leave it as it is since it'll
         # simply look like a text link
         #}
        {% if not (config.saml_login_colour ends with ', 0)') %}
        .samlbutton {
            padding: 1rem;
        }
        {% endif %}

        {% if not (config.oidc_login_colour ends with ', 0)') %}
        .oidcbutton {
            padding: 1rem;
        }
        {% endif %}

        {# If an icon was chosen, reconfigure padding and background images etc. #}
        .saml-icon, .oidc-icon {
            background-position-x: left;
            background-position-y: center;
            background-repeat: no-repeat;
            background-size: 4rem;
            padding-left: 5rem;
        }

        .samlbutton {
            background-color: {{ config.saml_login_colour|raw }};
        }

        {% if config.saml_login_icon ?? null %}
        .samlbutton.saml-icon {
            background-image: url('/storage/image.php?hash={{ config.saml_login_icon }}');
        }
        {% endif %}

        .oidcbutton {
            background-color: {{ config.oidc_login_colour|raw }};
        }

        {% if config.oidc_login_icon ?? null %}
        .oidcbutton.oidc-icon {
            background-image: url('/storage/image.php?hash={{ config.oidc_login_icon }}');
        }
        {% endif %}

        {# Toggle default login form, in case you get locked out
         # This is meant to be a bit discreet, intentionally, so
         # that people don't think this is something they're
         # meant to do
         #}
        .default-login-toggle {
            opacity: 0.5;
        }

        /* Center login content vertically*/
        #content{
            align-items: center;
            display:flex;
            max-width: 360px;
            min-height: 100vh;
        }
    </style>
{% endautoescape %}

<script src="{{ CDN_PREFIX }}/js/bundle/vendors.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/main.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/browser/browser-redirect.js?v={{ config.site_version }}"></script>

{% if config.site_usage_tracking %}
    {% autoescape 'js' %}
        <!-- Google Tag Manager -->
        <script>
            window.dataLayer = window.dataLayer || [];
            dataLayer.push({
                'event': 'page_view',
                'site_school_code': '{{ config. site_school_code }}',
                'site_type': '{{ config.site_type }}',
                'site_version': '{{ config.site_version }}',
            });
        </script>
        <script>
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','GTM-N8R6VLV');
        </script>
        <!-- End Google Tag Manager -->
    {% endautoescape %}

{% endif %}
</head>
<body class="login side">
<div id="container">
	<div id="content">
		<form id="login" method="post" action="{{ routeLookup('login.postLogin') }}?{{ requestParams|escape }}">
            <input type="hidden" name="page" value="{{ page|escape }}" />
            <div class="row collapse">
                <div class="small-12 column">
                    <div class="logo">
                        <img src="/images/logo.php?logo=skin_logo_login&size=normal" alt="{{ config.title }}" />
                    </div>
                </div>
                <div class="small-12 column">
                    <p id="error-msg" data-test="login-error-msg" class="alert-box alert">{{ error }}</p>
                </div>
                {# Only show default login fields if Site settings allow it #}
                <div class="small-12 column" {% if not config.show_default_login %}style="display:none"{% endif %} data-default-login>
                    <input type="text" name="username" id="username" data-test="login-username" placeholder="Username" maxlength="225" />
                    <input type="password" name="password" id="password" data-test="login-password" placeholder="Password" />
                </div>
            </div>
            <div class="row collapse">
                {% if config.login_terms_and_conditions != '' %}
                <div class="small-12 column">
                    <input required
                           class="required"
                           id="tandc"
                           name="tandc"
                           value="1"
                           type="checkbox"
                           title="{{ config.login_terms_and_conditions_error }}" />
                    <label for="tandc" class="tandc">
                        {{ config.login_terms_and_conditions|purify }}
                    </label>
                </div>
                {% endif %}

                {# Only show default login fields if Site settings allow it #}
                {% if config.show_default_login %}
                    {% if config.forgotten_password_text and config.forgotten_password_url %}
                    <div class="small-12 column">
                        <p><a href="{{ config.forgotten_password_url }}">{{ config.forgotten_password_text }}</a></p>
                    </div>
                    {% endif %}

                    {% if config.session_remember %}
                    <div class="small-12 column">
                        <input id="rememberme" data-test="login-rememberme" type="checkbox" name="rememberme" value="1" />
                        <label for="rememberme">Remember me</label>
                    </div>
                    {% endif %}
                {% endif %}
                <div class="small-12 column login-links">
                    {# Only show default login fields if Site settings allow it #}
                    <input
                        type="submit"
                        name="Submit"
                        value="Login"
                        {% if not config.show_default_login %}style="display:none"{% endif %}
                        data-test="login-submit"
                        data-default-login
                    />

                    {% if config.show_default_login %}
                        {% if config.login_anonymous != '' or config.saml_sso_url != '' or config.saml_idp_metadata_url != '' %}
                            <p class="separator"> - OR - </p>
                        {% endif %}
                    {% endif %}

                    {% if config.login_anonymous != '' %}
                        <p><a href="/account/anonymous.php?{{ requestParams|escape }}" class="login-method guest">Login as guest</a></p>
                    {% endif %}

                    {% if config.saml_sso_url != '' or config.saml_idp_metadata_url != '' %}
                        {% block sso %}
                            {# Interpret title setting forcing a meaningful default#}
                            {% set samlTitle = config.saml_login_title ?? '' %}

                            {% if '' == samlTitle %}
                                {% set samlTitle = 'Login with Single Sign-On' %}
                            {% endif %}
                            <p><a href="/saml/index.php?{{ requestParams|escape }}" class="login-method samlbutton {% if config.saml_login_icon ?? null %}saml-icon{% endif %}">{{ samlTitle }}</a></p>
                        {% endblock %}
                    {% endif %}

                    {# Only show OIDC login if it's enabled #}
                    {% set oidcUrl = routeLookup('loginOidc.getAuthorization') %}
                    {% if oidcUrl %}
                        {% block oidc %}
                            {# Interpret title setting forcing a meaningful default#}
                            {% set oidcTitle = config.oidc_login_title ?? '' %}

                            {% if '' == oidcTitle %}
                                {% set oidcTitle = 'Login with OpenID Connect' %}
                            {% endif %}
                            <p><a href="{{ oidcUrl }}?{{ requestParams|escape }}" class="login-method oidcbutton {% if config.oidc_login_icon ?? null %}oidc-icon{% endif %}">{{ oidcTitle }}</a></p>
                        {% endblock %}
                    {% endif %}

                    {% if requestFromInternalIp %}
                        {% block internalSso %}
                            <p><a href="{{ internalSsoUrl }}" class="login-method instance-registry-button">Login using Instance Registry</a></p>
                        {% endblock %}
                    {% endif %}
                </div>
            </div>
        </form>
    </div>
    <div id="footer">
        <ul>
            <li>{{ NOW.year }} &copy; Copyright <a href="{{ config.school_address }}">{{ config.school_name }}</a></li>
            <li><a href="{{ routeLookup('policy.getPolicy') }}">Guidelines of Use and Privacy Policy</a></li>
            <li><a href="https://schoolbox.education" title="Schoolbox, Virtual Learning Environment, Learning Management System, LMS">Schoolbox</a>
                {{ config.site_version }}</li>
            {% block feedbackLink %}
                {% if config.feedback_url and config.feedback_text %}
                    <li><a href="{{ config.feedback_url }}">{{ config.feedback_text }}</a></li>
                {% endif %}
            {% endblock %}
            {% if not config.show_default_login %}
                <script>
                    $(function() {
                        $('[data-default-login-toggle]').on('click', function(event) {
                            event.preventDefault();

                           $('[data-default-login]').toggle();
                        });
                    });
                </script>
                <li class="default-login-toggle" data-default-login-toggle>Login</li>
            {% endif %}
            <li></li>
        </ul>
    </div>
</div>
<script type="text/javascript">

    function isTouchDevice() {
        return (('ontouchstart' in window) ||
        (navigator.maxTouchPoints > 0) ||
        (navigator.msMaxTouchPoints > 0));
    }
    if (!isTouchDevice()) {
        document.getElementById('username').focus();
    }

    var l, fy;

    $(function () {

        l = $('#login');

        fy = $('#footer').height();

        // Validation of terms and conditions
        l.alaressValidate({
            ignoreTitle: false,
            errorPlacement: function(error, element) {
                if (element.attr("name") == "tandc") {
                    error.appendTo("#error-msg");

                } else {
                    error.appendTo(element);
                }
            }
        });
        // T&C: remove error message completely on check`
        l.find('#tandc').on('change', function () {
            if (this.checked) {
                $('#error-msg').remove();
            }
        });

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js')
                        .then((reg) => {
                            console.log('Service worker registered.', reg);
                        });
            });
        }
    });
</script>
{{ config.site_analytics | replace({'{USER_ROLE}':''}) | raw }}
</body>
</html>
