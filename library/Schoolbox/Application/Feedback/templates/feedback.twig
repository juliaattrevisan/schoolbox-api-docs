<script>
    $(function() {
        $('#feedbackForm').alaressValidate({
            rules: {
                email: {
                    email: true
                },
                recaptcha: {
                    required: true
                }
            },
            messages: {
                name: 'Please enter your name.',
                email: 'Please enter a valid email address.',
                message: 'Please enter a message.',
                recaptcha: 'Please complete the check above so that we know you\'re not a bot.'
            }
        });
    });
</script>
<div class="row">
    <div class="small-12 columns">
        <h1>{{ config.feedback_text }}</h1>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <form id="feedbackForm" action="{{ routeLookup('mail.postFeedback') }}" method="post" class="top">
            <input type="hidden" name="template" value="feedback.html" />
            <input type="hidden" name="confirmation" value="/feedback/thank-you" />

            <h2 class="subheader">Enquiry</h2>
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="name" class="required">Your Name</label>
                        <input {{ USER is null ? '' : 'readonly' }} type="text" name="name" id="name" size="35" value="{{ USER.fullname ?? '' }}" required />

                        <label for="email" class="required">Email</label>
                        <input {{ USER.email is defined and USER.email != '' ? 'readonly' : '' }} type="email" name="email" id="email" size="35"  value="{{ USER.email ?? '' }}" required />

                        <label for="subject">Type of Enquiry</label>
                        <select name="subject" id="subject">
                            <option></option>
                            {% for type in types %}
                            <option value="{{type}}">{{type}}</option>
                            {% endfor %}
                        </select>

                        <label for="message" class="required">Enquiry</label>
                        <textarea id="message" name="message" rows="10" required></textarea>

                        {% if recaptcha is defined %}
                        <label class="required">Human Checker
                            <span class="hint has-tip tip-top" data-tooltip title="Please complete the check below so that we know you're not a bot.">?</span>
                        </label>
                        {{ recaptcha | raw }}
                        {% endif %}
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <input type="submit" value="Submit Enquiry"/>
                </div>
            </div>
        </form>
    </div>
</div>
