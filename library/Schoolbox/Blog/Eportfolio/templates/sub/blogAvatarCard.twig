<a href="{{ routeLookup('eportfolioBlog.getItem', {pageId: page.getPageId, id: blog.getId}) }}">
    {% include 'include/portrait.twig' with {user: blog.getOwner} only %}
    <h3>{{ blog.getHeading }}</h3>
</a>
<p class="meta">
    Posted by
    {% if not (blog.getOwner().isDeleted() or blog.getOwner().getId() == 0) %}
        <a href="/search/user/{{ blog.getOwner().getId() }}">{{ blog.getOwner().formatName() }}</a>
    {% else %}
        {{ blog.getOwner().formatName() }}
    {% endif %}
    {{ blog.getCreatedAt().getRelativeTime() }}
</p>
