<script type="text/javascript">
    $(function() {
        $('[data-interaction="delete"]').on('click', function(event) {
            event.preventDefault();

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this comment?',
                confirmLabel: 'Delete',
                confirmEvent: function() {
                    $.post('/eportfolio/blog/comment/delete/' + String($(event.target).data('comment-id')))
                    .done(function() {
                        // Remove from list after AJAX returns

                        $(event.target).closest('li').remove();
                    });
                }
            });
        });

        $("#commentForm").alaressValidate({
            rules: {
                'commentBody': {
                    requiredNotBlank: true
                }
            }
        });
    });
</script>

<ul class="breadcrumb">
    <li><a href="/eportfolio/{{ pageOwner.id }}">{{ pageOwner.getFullName }}'s ePortfolio</a></li>
    <li><a href="/eportfolio/{{ pageOwner.id }}/{{ page.getPageId }}">{{ page.getPageTitle }}</a></li>
    <li class="active"><span>{{ record.getHeading }}</span></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ record.getHeading }}</h1>
        </div>
    </div>
    {% if isRouteAuthorized('eportfolioBlog.getModify', {page: page, blog: record }) %}
        <nav>
            <a href="{{ routeLookup('eportfolioBlog.getModify', {pageId: page.getPageId, id: record.getId}) }}" title="Modify Blog post" class="sbx-icon-only-button"><sbx-icon name="modify"></sbx-icon></a>
        </nav>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            <div class="row">
                <div class="small-12 column">
                    <div class="card small-12">
                        {% include '@blog/sub/userAvatarCard.twig' with {user: record.getOwner()} %}
                        <p class="meta">Posted {{ record.getCreatedAt.getRelativeTime }}</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="content">
            <article>
                {{ record.getBody | purify }}

                {% if images | length > 0 %}
                    {% include '@blog/sub/imageGallery.twig' with {blogId: record.getId, images: images} %}
                {% endif %}
            </article>
        </section>

        <h2 class="subheader">Comments</h2>
        {% if comments | length > 0 %}
        <section class="discussion">
            <ul class="information-list">

                {% for comment in comments %}

                    <li class="actions-small-1">

                        <div class="list-item">
                            <div class="card compact small-12">
                                {% include '@blog/sub/userAvatarCard.twig' with {user: comment.getOwner()} %}
                            </div>
                        </div>

                        {# Only the owner of a comment can delete it #}

                        {% if isRouteAuthorized('eportfolioBlog.postCommentDelete', {comment: comment, page: page }) %}
                            <nav>
                                <a class="sbx-icon-only-button no-text"
                                   data-interaction="delete"
                                   data-comment-id="{{ comment.getId }}"
                                   title="Delete comment"
                                   aria-label="Delete comment">
                                    <sbx-icon name="delete"></sbx-icon>
                                </a>
                            </nav>
                        {% endif %}

                        <article><p>{{ comment.getBody | nl2br }}</p></article>
                    </li>

                {% endfor %}
            </ul>
        </section>
    {% endif %}
    {% if isRouteAuthorized('eportfolioBlog.postCommentInsert', {blog: record, page: page}) %}
        <form id="commentForm" action="{{ routeLookup('eportfolioBlog.postCommentInsert', {id: record.getId}) }}" method="post">
            <input type="hidden" name="returnUrl" value="{{ RETURN_URL.current }}">
            <section class="content">
                <input type="hidden" name="pageId" value="{{ page.getPageId }}">
                <label>
                    <textarea name="commentBody" class="no-margin" rows="2" cols="100" placeholder="Add a comment"></textarea>
                </label>
            </section>
            <input type="submit" class="no-margin" name="comment" value="Post comment"/>
        </form>
    {% endif %}
    </div>
</div>
