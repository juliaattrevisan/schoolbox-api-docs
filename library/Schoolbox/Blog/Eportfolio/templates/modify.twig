<script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/select-all/attacher.select-all.js?v={{ config.site_version }}"></script>

<script type="text/javascript">
    $(function() {
        $.fn.alaressEditor();

        $('#blogForm').alaressValidate();

        {% if record is defined %}
            $('[data-delete]').click(function(event) {
                event.preventDefault();

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this blog post?',
                    confirmLabel: 'Delete',
                    confirmEvent: function() {
                        $.post('/eportfolio/blog/delete/{{ record.getId }}')
                        .done(function() {
                            // Remove from list after AJAX returns

                            window.location.href = '/eportfolio/{{ pageOwner.id }}/{{ page.getPageId }}';
                        });
                    }
                });
            })
        {% endif %}
    })
</script>

<ul class="breadcrumb">
    <li><a href="/eportfolio/{{ pageOwner.id }}">{{ pageOwner.getFullName }}'s ePortfolio</a></li>
    <li><a href="/eportfolio/{{ pageOwner.id }}/{{ page.getPageId }}">{{ page.getPageTitle }}</a></li>
    <li class="active"><span>{% if record is defined %}Modify{% else %}Post{% endif %} Blog</span></li>
</ul>

<div class="row">
    <div class="column small-12">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h1>{% if record is defined %}Modify{% else %}Post{% endif %} Blog</h1>
                </div>
            </div>
            {% if record is defined %}
                <nav>
                    <a class="icon-more" title="Actions" data-dropdown="header-options" aria-expanded="false"></a>
                </nav>
                <ul id="header-options" class="f-dropdown" data-dropdown-content="" aria-hidden="true">
                    <li>
                        <a class="icon-delete" title="Delete Blog" data-delete />Delete Blog</a>
                    </li>
                </ul>
            {% endif %}
        </div>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <form method="post"
              id="blogForm"
              action="{{ record is defined ? routeLookup('eportfolioBlog.postModify', {id: record.getId}) : routeLookup('eportfolioBlog.postInsert', {pageId: page.getPageId }) }}">
            <input type="hidden" name="pageId" value="{{ page.getPageId }}" />
            <input type="hidden" name="id" value="{{ record.getId ?? '' }}" />

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="heading" class="required">Title</label>
                        <input type="text" name="heading" id="heading" maxlength="100"  value="{{ record.getHeading ?? '' }}" required />

                        <label>
                            Body
                            <textarea id="body" name="body">{{ record.getBody ?? '' }}</textarea>
                        </label>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Image Gallery
                        </label>
                        <section>
                            {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                        </section>
                    </div>
                </fieldset>
            </section>

            <input type="submit" name="submits" value="{% if record is defined %}Modify{% else %}Post{% endif %} Blog" />
        </form>
    </div>
</div>
