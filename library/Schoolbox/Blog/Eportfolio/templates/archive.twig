{% if blogs | length > 0 %}
<script type="text/javascript">
    $(function() {
        $('#blog-posts').find("form[data-blog-comment-form]").each(function() {
            $(this).alaressValidate({
                rules: {
                    'commentBody':  {
                        requiredNotBlank:true
                    }
                }
            });
        })
    });
</script>
{% endif %}

<ul class="breadcrumb">
    <li><a href="/eportfolio/{{ pageOwner.id }}">{{ pageOwner.getFullName }}'s ePortfolio</a></li>
    <li><a href="/eportfolio/{{ pageOwner.id }}/{{ page.getPageId }}">{{ page.getPageTitle }}</a></li>
    <li class="active"><span>Blog Archive</span></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Blog Archive</h1>
        </div>
    </div>
    <nav>
        {% if isRouteAuthorized('eportfolioBlog.getInsert', {page: page}) %}
        <a href="{{ routeLookup('eportfolioBlog.getInsert', {pageId: page.getPageId}) }}" class="sbx-icon-only-button" title="Post Blog"><sbx-icon name="add"></sbx-icon></a>
        {% endif %}
    </nav>
</div>

<div class="row">

    {# Year/month selection #}

    <div class="small-12 large-3 island">
        <h2 class="subheader">Archive</h2>
        <section class="content">
            <ul class="information-list">
                <li>
                    {% set previousYear = '' %}
                    {% for date in dateSelectorArray %}

                        {% if previousYear != date.getYear %}
                            {% set previousYear = date.getYear %}

                            {% if not loop.first %}
                                </ul>
                            {% endif %}

                            {{ date.getYear }}
                            <ul class="information-list">
                        {% endif %}

                        {% if isRouteAuthorized('eportfolioBlog.getArchive', {page: page, year: date.getYear, month: date.getMonth}) %}
                        <li>
                            <a href='{{ routeLookup('eportfolioBlog.getArchive', {pageId: page.getPageId, year: date.getYear, month: date.getMonth}) }}'>{{ date | date('F') }}</a><br>
                        </li>
                        {% endif %}
                    {% endfor %}
                    </ul>
                </li>
            </ul>
        </section>
    </div>

    {# Show all blog entries for the selected year/month#}

    {% if blogs | length > 0 %}

        <div class="small-12 large-9 island" id="blog-posts">
            <h2 class="subheader">{{ blogs[0].getCreatedAt | date('F Y') }} Blog Posts</h2>
            <section>
                <ul class="information-list">

                    {% for blog in blogs %}

                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="card small-12">
                                {% include '@eportfolioBlog/sub/blogAvatarCard.twig' with {blog: blog} %}
                            </div>
                        </div>
                        {% if isRouteAuthorized('eportfolioBlog.getModify', {page: page, blog: blog }) %}
                        <nav>
                            <a title="Modify" href="{{ routeLookup('eportfolioBlog.getModify', {pageId: page.getPageId, id: blog.getId }) }}" class="sbx-icon-only-button"><sbx-icon name="modify"></sbx-icon></a>
                        </nav>
                        {% endif %}

                        <a id="{{ blog.getId() }}"></a>
                        <article>
                            {{ blog.getBody | purify }}

                            {% if blogImages[blog.getId] | length > 0 %}
                                {% include '@blog/sub/imageGallery.twig' with {blogId: blog.getId, images: blogImages[blog.getId()]} %}
                            {% endif %}
                        </article>

                        <ul class="information-list reply">
                            {% for comment in blogComments[blog.getId] %}
                            <li>
                                <div class="card compact small-12">
                                    {% include '@blog/sub/userAvatarCard.twig' with {user: comment.getOwner()} %}
                                    <p class="meta">Commented {{ comment.createdAt.getLong }}</p>
                                </div>
                                <article>
                                    <p>{{ comment.getBody | nl2br }}</p>
                                </article>
                            </li>
                            {% endfor %}
                        </ul>

                        {% if isRouteAuthorized('eportfolioBlog.postCommentInsert', {blog: blog, page: page}) %}
                        <div class="editPanel socialstream-new-post">
                            <form action="{{ routeLookup('eportfolioBlog.postCommentInsert', {id: blog.getId}) }}" method="post" data-blog-comment-form>
                                <input type="hidden" name="returnUrl" value="{{ RETURN_URL.current }}">
                                <input type="hidden" name="pageId" value="{{ page.getPageId }}">
                                <textarea name="commentBody" rows="2" cols="100" placeholder="Add a comment"></textarea>
                                <input type="submit" name="comment" value="Post comment"/>
                            </form>
                        </div>
                        {% endif %}
                    </li>

                    {% endfor %}
                </ul>
            </section>
        </div>

    {% endif %}
</div>
