<div id="component{{ componentInstanceId }}" class="component-container {{ componentClass }}" data-component>
    <script type="text/javascript" src="/javascript/shared/jquery.blog-commentary.js"></script>
    <script type="text/javascript">
        $(function() {

            var comp = $('#component{{ componentInstanceId }}');

            $('[data-interaction="deletecomment"]').click(function(event) {

                event.preventDefault();
                var commentId = $(event.target).attr('data-comment-id');
                var blogId = $(event.target).attr('data-blog-id');
                var commentCount = $('#commentCount-' + blogId).attr('data-numcomments');

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this comment?',
                    confirmEvent: function() {
                        $.post('/eportfolio/blog/comment/delete/' + String(commentId))
                        .done(function() {
                            // Remove from list after AJAX returns

                            $(event.target).closest('li').remove();

                            // Update comment count

                            commentCount--;

                            // Remove button if there are no comments left, otherwise update the displayed count

                            if (commentCount <= 0)
                                $('#commentCount-' + blogId).remove();
                            else {
                                $('#commentCount-' + blogId).html('Show Comments (' + commentCount + ')');
                                $('#commentCount-' + blogId).attr('data-numcomments', commentCount);
                            }
                        });
                    }
                });
            });

            comp.blogCommentary();
        });
    </script>

    <div data-collapsable='true' class="row {CONFIG_COLLAPSED_CLASS}" data-collapse-state="{CONFIG_COLLAPSED_STATE}">
        <div class="island small-12">
            <section>
                <ul class="information-list">

                    {% for blog in blogs %}

                        <li class="actions-small-1" id="blog_{{ blog.getId }}" data-blog>

                            <div class="list-item">
                                <div class="avatar card small-12">
                                    <a href="{{ routeLookup('eportfolioBlog.getItem', {ownerId: page.getUid, pageId: page.getPageId, id: blog.getId}) }}">
                                        <img src="/portrait.php?userId={{ blog.getOwner.getExternalId }}&size=square64" />
                                        <h3>{{ blog.getHeading }}</h3>
                                    </a>
                                    <p class="meta">Posted by <a href="/search/user/{{ blog.getOwner.getId }}">{{ blog.getOwner.getFirstname }} {{ blog.getOwner.getLastname }}</a> {{ blog.getCreatedAt.getRelativeTime }}</p>
                                </div>
                            </div>

                            {% if isRouteAuthorized('eportfolioBlog.getModify', {page: page, blog: blog }) %}
                                <nav>
                                    <a class="icon-modify" href="{{ routeLookup('eportfolioBlog.getModify', {ownerId: page.getUid, pageId: page.getPageId, id: blog.getId}) }}" title="Modify Blog post"></a>
                                </nav>
                            {% endif %}

                            <article>
                                {{ blog.getBody | purify }}

                                {% if blogImages[blog.getId] | length > 0 %}
                                    {% include '@blog/sub/imageGallery.twig' with {images: blogImages[blog.getId()]} %}
                                {% endif %}

                                {% if blogComments[blog.getId] | length > 0 %}
                                    <a id="commentCount-{{ blog.getId }}" data-interaction="showcomments" class="button icon-chat" data-numcomments="{{ blogComments[blog.getId] | length }}">Show Comments ({{ blogComments[blog.getId] | length }})</a>
                                {% endif %}

                                <a data-toggle="commentform-{{ blog.getId }}" class='button icon-add' >Add Comment</a>
                            </article>

                            <ul class="information-list reply" id="blogComment_{{ blog.getId }}">

                                {% for comment in blogComments[blog.getId] %}

                                    <li class="actions-small-1" data-thread>
                                        <div class="list-item">
                                            <div class="avatar card small-12">
                                                <a href="/search/user/{{ comment.getOwner.getId }}">
                                                    <img src="/portrait.php?userId={{ comment.getOwner.getExternalId }}&size=square64" />
                                                    <p>{{ comment.getOwner.getFirstname }} {{ comment.getOwner.getLastname }}</p>
                                                </a>
                                                <p class="meta">Commented {{ comment.getCreatedAt.getRelativeTime }}</p>
                                            </div>
                                        </div>

                                        {% if isRouteAuthorized('eportfolioBlog.postCommentDelete', {comment: comment, page: page }) %}
                                            <nav>
                                                <a data-interaction="deletecomment" class="icon-delete" data-blog-id="{{ blog.getId }}" data-comment-id="{{ comment.getId }}"></a>
                                            </nav>
                                        {% endif %}

                                        <article>
                                            <p>{{ comment.getBody | purify }}</p>
                                        </article>
                                    </li>

                                {% endfor %}

                                {% if isRouteAuthorized('eportfolioBlog.postCommentInsert', {blog: blog}) %}
                                <li class="row hide" id="commentform-{{ blog.getId }}">
                                    <div class="column small-12 no-pad">
                                        <form action="{{ routeLookup('eportfolioBlog.postCommentInsert', {id: blog.getId}) }}" method="post">
                                            <input type="hidden" name="pageId" value="{{ page.getPageId }}">
                                            <input type="hidden" name="ownerId" value="{{ page.getUid }}">
                                            <div class="avatar card small-12">
                                                <img src="/portrait.php?userId={{ session.user.getExternalId }}&size=square64" />
                                                <textarea name="body" rows="2" cols="100" placeholder="Add your comment"></textarea>
                                            </div>
                                            <input type="submit" name="comment" value="Add Comment"/>
                                        </form>
                                    </div>
                                </li>
                                {% endif %}
                            </ul>
                        </li>

                    {% endfor %}

                </ul>
                <div class="content">
                    {% if isRouteAuthorized('eportfolioBlog.getArchiveCurrent', {ownerId: page.getUid, page: page}) %}
                    <a href="{{ routeLookup('eportfolioBlog.getArchiveCurrent', {ownerId: page.getUid, pageId: page.getPageId}) }}" class="button icon-archive">View Archive</a>
                    {% endif %}
                    {% if isRouteAuthorized('eportfolioBlog.getInsert', {ownerId: page.getUid, page: page, blog: blog}) %}
                    <a href="{{ routeLookup('eportfolioBlog.getInsert', {ownerId: page.getUid, pageId: page.getPageId, id: blog.getId}) }}" class="button icon-upload">Post Blog</a>
                    {% endif %}
                </div>
            </section>
        </div>
    </div>
</div>
