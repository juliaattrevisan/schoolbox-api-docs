<script type="text/javascript">
    $(function() {

        $('[data-image-gallery] li').magnificPopup({
            delegate: 'a',
            type: 'image'
        });

        $('[data-interaction="delete"]').click(function(event) {
            event.preventDefault();

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this comment?',
                confirmEvent: function() {
                    $.post('/eportfolio/blog/comment/delete/' + String($(event.target).data('comment-id')))
                    .done(function() {
                        // Remove from list after AJAX returns

                        $(event.target).closest('li').remove();
                    });
                }
            });
        })
    });
</script>

<ul class="breadcrumb">
    <li><a href="/eportfolio/{{ page.getUid }}/{{ page.getPageId }}">{{ page.getPageTitle }}</a></li>
    <li class="active"><a href="#">{{ record.getHeading }}</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ record.getHeading }}</h1>
        </div>
    </div>
    {% if isRouteAuthorized('eportfolioBlog.getModify', {page: page, blog: record }) %}
        <nav>
            <a class="icon-modify" href="{{ routeLookup('eportfolioBlog.getModify', {ownerId: page.getUid, pageId: page.getPageId, id: record.getId}) }}" title="Modify Blog post"></a>
        </nav>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            <div class="row">
                <div class="small-12 column">
                    <div class="avatar card small-12">
                        {% include '@blog/sub/userAvatarCard.twig' with {user: record.getOwner()} %}
                        <p class="meta">Posted {{ record.getCreatedAt.getRelativeTime }}</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="content">
            <article>
                {{ record.getBody | purify }}

                {% if images | length > 0 %}
                    {% include '@blog/sub/imageGallery.twig' with {images: images} %}
                {% endif %}
            </article>
        </section>

            <h2 class="subheader">Comments</h2>

            <section>
                <ul class="information-list">

                    {% for comment in comments %}

                        <li class="actions-small-1">

                            <div class="list-item">
                                <div class="avatar card small-12">
                                    {% include '@blog/sub/userAvatarCard.twig' with {user: comment.getOwner()} %}
                                    <p class="meta">{{ comment.getCreatedAt.getRelativeTime }}</p>
                                </div>
                            </div>

                            {# Only the owner of a comment can delete it #}

                            {% if isRouteAuthorized('eportfolioBlog.postCommentDelete', {comment: comment, page: page }) %}
                                <nav>
                                    <a class="icon icon-delete" data-interaction="delete" data-comment-id="{{ comment.getId }}"></a>
                                </nav>
                            {% endif %}

                            <article>{{ comment.getBody | purify }}</article>
                        </li>

                    {% endfor %}

                    {% if isRouteAuthorized('eportfolioBlog.postCommentInsert', {blog: record, page: page}) %}
                    <li>
                        <form action="{{ routeLookup('eportfolioBlog.postCommentInsert', {id: record.getId}) }}" method="post">
                            <input type="hidden" name="pageId" value="{{ page.getPageId }}">
                            <input type="hidden" name="ownerId" value="{{ page.getUid }}">
                            <label class="content">
                                <textarea name="body" class="no-margin" rows="2" cols="100" placeholder="Add your comment"></textarea>
                            </label>

                            <input type="submit" class="no-margin" name="comment" value="Add comment"/>
                        </form>
                    </li>
                    {% endif %}
                </ul>
            </section>
    </div>
</div>
