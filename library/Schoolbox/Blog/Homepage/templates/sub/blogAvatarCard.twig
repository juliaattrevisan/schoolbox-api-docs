<a href="{{ routeLookup('blog.getItem', { id: blog.getId }) }}">
    <img src="/portrait.php?userId={{ blog.getOwner.getExternalId }}&size=square64" />
    <p>{{ blog.getHeading }}</p>
</a>
<p class="meta">
    Posted by
    {% if not (blog.getOwner().isDeleted() or blog.getOwner().getId() == 0) %}
        <a href="/search/user/{{ blog.getOwner().getId() }}">{{ blog.getOwner().formatName() }}</a>
    {% else %}
        {{ blog.getOwner().formatName() }}
    {% endif %}
    {{ blog.getCreatedAt().getRelativeTime() }}
</p>
