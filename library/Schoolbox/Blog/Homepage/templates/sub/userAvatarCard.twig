{% if not (user.isDeleted() or user.getId() == 0) %}
    <a href="/search/user/{{ user.getId }}" title="View Profile">
        <img src="/portrait.php?userId={{ user.getExternalId }}&size=square64" alt="View Profile" />
        <p>
            {{ user.formatName() }}
            <span class="meta">Commented {{ comment.getCreatedAt.getRelativeTime }}</span>
        </p>
    </a>
{% else %}
    <img src="/portrait.php?userId={{ user.getExternalId }}&size=square64" alt="View Profile" />
    <p>
        {{ user.formatName() }}
        <span class="meta">Commented {{ comment.getCreatedAt.getRelativeTime }}</span>
    </p>
{% endif %}
