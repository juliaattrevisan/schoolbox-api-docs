{% if not (user.isDeleted() or user.getId() == 0) %}
    <a href="/search/user/{{ user.getId }}" title="View Profile">
        <img src="/portrait.php?userId={{ user.getExternalId }}&size=square64" alt="View Profile" />
        <p>
            {{ user.formatName() }}
            {% if comment is defined %}
            <span class="pipe meta" title="{{ comment.getCreatedAt.getShort }}">Commented {{ comment.getCreatedAt.getRelativeTime }}</span>
            {% endif %}
        </p>
    </a>
{% else %}
    <img src="/portrait.php?userId={{ user.getExternalId }}&size=square64" alt="View Profile" />
    <p>
        {{ user.formatName() }}
        {% if comment is defined %}
        <span class="pipe meta" title="{{ comment.getCreatedAt.getShort }}">Commented {{ comment.getCreatedAt.getRelativeTime }}</span>
        {% endif %}
    </p>
{% endif %}
