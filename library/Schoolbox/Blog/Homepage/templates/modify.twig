<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/select-all/attacher.select-all.js?v={{ config.site_version }}"></script>

<script type="text/javascript">
    $(function() {
        /**
         * Initialise the editor
         */
        document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
            detail: {
                maxCharCount: window.sbProps.MAX_BYTES_MYSQL_MEDIUMTEXT,
                targetElements: ['#body'],
                fileBrowserCategoryId: {{ record.folder.id ?? folder.id ?? 0 }}
            }
        }));

        $('#blogForm').alaressValidate();

        {% if record is defined %}
            $('[data-delete]').on('click', function(event) {
                event.preventDefault();

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this blog post?',
                    confirmLabel: 'Delete',
                    confirmEvent: function() {
                        $.post('/blog/delete/{{ record.getId }}')
                        .done(function() {
                            // Remove from list after AJAX returns

                            window.location.href = '/homepage/{{ record.getFolder.getId }}';
                        });
                    }
                });
            })
        {% endif %}
    })
</script>

<ul class="breadcrumb">
    <li><a href="/homepage/{% if record is defined %}{{ record.getFolder.getId }}{% else %}{{ folder.getId }}{% endif %}">{% if record is defined %}{{ record.getFolder.getName }}{% else %}{{ folder.getName }}{% endif %}</a></li>
    <li class="active"><span>{% if record is defined %}Modify{% else %}Post{% endif %} Blog</span></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{% if record is defined %}Modify{% else %}Post{% endif %} Blog</h1>
        </div>
    </div>
    {% if record is defined %}
        <nav>
            <sbx-pop-out content-id="header-options"></sbx-pop-out>
        </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content="" aria-hidden="true">
        <li>
                <a class="sbx-button--has-icon"
               title="Delete Blog"
               data-delete
               aria-label="Delete Blog">
                <sbx-icon name="delete"></sbx-icon>
                Delete Blog
            </a>
        </li>
    </ul>
    {% endif %}
</div>
<div class="row">
    <div class="small-12 island">
        <form method="post"
              id="blogForm"
              action="{{ record is defined ? routeLookup('blog.postModify', {id: record.getId}) : routeLookup('blog.postInsert', {folderId: folder.getId}) }}">
            <input type="hidden" name="categoryId" value="{% if record is defined %}{{ record.getFolder.getId }}{% else %}{{ folder.getId }}{% endif %}" />

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="heading" class="required">Title </label>
                        <input type="text" name="heading" id="heading" maxlength="100" value="{{ record.getHeading ?? '' }}" required />

                        <label for="body">Body</label>
                        <textarea id="body" name="body">{{ record.getBody ?? '' }}</textarea>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="image_gallery">
                            Image Gallery
                        </label>
                        <section id="image_gallery">
                            {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                        </section>
                    </div>
                </fieldset>
            </section>

            <input type="submit" name="submits" value="{% if record is defined %}Modify{% else %}Post{% endif %} Blog" />
        </form>
    </div>
</div>
