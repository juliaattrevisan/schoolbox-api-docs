<script type="text/javascript" src="{{ CDN_PREFIX }}/js/form/jquery.blog-commentary.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {

        var comp = $('#component{{ componentInstanceId }}');

        $('[data-interaction="deletecomment"]').click(function(event) {

            event.preventDefault();
            var commentId = $(event.target).attr('data-comment-id');
            var blogId = $(event.target).attr('data-blog-id');
            var commentCount = $('#component{{ componentInstanceId }}-commentCount-' + blogId).attr('data-numcomments');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this comment?',
                confirmLabel: 'Delete',
                confirmEvent: function() {
                    $.post('/blog/comment/delete/'+String(commentId))
                    .done(function() {
                        // Remove from list after AJAX returns

                        $(event.target).closest('li').remove();

                        // Update comment count

                        commentCount--;

                        // Remove button if there are no comments left, otherwise update the displayed count

                        if (commentCount <= 0)
                            $('#component{{ componentInstanceId }}-commentCount-' + blogId).remove();
                        else {
                            $('#component{{ componentInstanceId }}-commentCount-' + blogId).html('Show Comments (' + commentCount + ')');
                            $('#component{{ componentInstanceId }}-commentCount-' + blogId).attr('data-numcomments', commentCount);
                        }
                    });
                }
            });
        });

        comp.blogCommentary();

        comp.find("form[data-blog-comment-form]").each(function() {
            $(this).alaressValidate({
                rules: {
                    'commentBody':  {
                        requiredNotBlank:true
                    }
                }
            });
        })

    });
</script>

{% if blogs is empty %}

    <div class="empty-state">
        <i class="icon-blog"></i>
        <p><a href="{{ routeLookup('blog.getInsert', { folderId: folder.getId }) }}">Add a blog post</a> to share content with others and allow them to comment.</p>
    </div>

{% else %}

    <ul class="information-list">

        {% for blog in blogs %}

            <li class="actions-small-1" id="component{{ componentInstanceId }}-blog_{{ blog.getId }}" data-blog>

                <div class="list-item">
                    <div class="card small-12">
                        {% include '@blog/sub/blogAvatarCard.twig' with {blog: blog} %}
                    </div>
                </div>

                {% if isRouteAuthorized('blog.getModify', { blog: blog, folder: folder }) %}
                    <nav>
                        <a class="icon-modify" href="{{ routeLookup('blog.getModify', { id: blog.getId }) }}" title="Modify Blog post"></a>
                    </nav>
                {% endif %}

                <article>
                    {{ blog.getBody | purify }}
                    {% if blogImages[blog.getId] | length > 0 %}
                        {% include '@blog/sub/imageGallery.twig' with {blogId: blog.getId, images: blogImages[blog.getId()]} %}
                    {% endif %}
                    <div>
                        {% if blogComments[blog.getId] | length > 0 %}
                        <a id="component{{ componentInstanceId }}-commentCount-{{ blog.getId }}" data-interaction="showcomments" class="article-read-more" data-numcomments="{{ blogComments[blog.getId] | length }}">
                            Show Comments ({{ blogComments[blog.getId] | length }})
                            <span> | </span>
                        </a>
                        {% endif %}

                        {% if isRouteAuthorized('blog.postCommentInsert', { blog: blog }) %}
                        <a data-toggle="component{{ componentInstanceId }}-commentform-{{ blog.getId }}" class="article-read-more">Add comment</a>
                        {% endif %}
                    </div>
                </article>
                <div class="discussion">
                    <ul class="information-list" id="component{{ componentInstanceId }}-blogComment_{{ blog.getId }}">
                        {% for comment in blogComments[blog.getId] %}
                            <li class="actions-small-1" data-thread>
                                <div class="list-item">
                                    <div class="card compact small-12">
                                        {% include '@blog/sub/userAvatarCard.twig' with {user: comment.getOwner()} %}
                                    </div>
                                </div>

                                {% if isRouteAuthorized('blog.postCommentDelete', { comment: comment, folder: folder }) %}
                                <nav>
                                    <a data-interaction="deletecomment" class="icon-delete" data-blog-id="{{ blog.getId }}" data-comment-id="{{ comment.getId }}"></a>
                                </nav>
                                {% endif %}

                                <article>
                                    <p>{{ comment.getBody | nl2br }}</p>
                                </article>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </li>
            {% if isRouteAuthorized('blog.postCommentInsert', { blog: blog }) %}
                <li class="row hide" id="component{{ componentInstanceId }}-commentform-{{ blog.getId }}">
                    <div class="editPanel socialstream-new-post">
                        <form action="{{ routeLookup('blog.postCommentInsert', { id: blog.getId }) }}" method="post" data-blog-comment-form>
                            <input type="hidden" name="returnUrl" value="{{ RETURN_URL.current }}">
                            <input type="hidden" name="component" value="1">
                            <textarea name="commentBody" rows="2" cols="100" maxlength="{{ blogCommentMaxLength }}" placeholder="Add a comment"></textarea>
                            <input type="submit" name="comment" value="Post comment"/>
                        </form>
                    </div>
                </li>
            {% endif %}
        {% endfor %}
    </ul>
    <div class="component-action">
        <section>
            <a href="{{ routeLookup('blog.getArchiveCurrent', { folderId: folder.getId }) }}" class="button">View Archive</a>
            {% if not readonly %}
                <a href="{{ routeLookup('blog.getInsert', { folderId: folder.getId }) }}" class="button">Post Blog</a>
            {% endif %}
        </section>
    </div>

{% endif %}
