{% extends 'include/styledIframe.twig' %}

{% block title %}Share your identity with $relyingParty?{% endblock title %}

{% block customHead %}
    <style>
        body {
            background-color: white;
        }
    </style>
{% endblock customHead %}

{% block content %}
    <h1>Share your identity with $relyingParty?</h1>
    <p>
        $relyingParty will have access to your:
    </p>
    <ul>
        <li>Name</li>
        <li>Email address</li>
        <li>URL: {{ authorizationUrl }}</li>
    </ul>

    <form method="post" action="{{ authorizationUrl }}">
        <ul class="flex-list buttons">
            <li><button type="submit" name="permission" value="1">Allow</button></li>
            <li><button type="submit" name="permission" value="0">Deny</button></li>
        </ul>
    </form>
{% endblock content %}
