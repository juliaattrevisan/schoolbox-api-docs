@startuml
'https://plantuml.com/sequence-diagram

actor UserAgent

UserAgent -> Schoolbox : visits dashboard or homepage
Schoolbox -> UserAgent : renders iframe to Paperly
UserAgent -> Paperly : sends request to render content
Paperly -> Schoolbox : sends request for authorization code
Schoolbox -> UserAgent : requests approval to authorize and share data with Paperly

alt request approved
    UserAgent -> Schoolbox : approves Paperly
    Schoolbox -> Paperly : sends authorization code
    Paperly -> Schoolbox : sends request for access token
    Schoolbox -> Paperly : sends access token
    Paperly -> Paperly : creates session for user identified by access token
    activate Paperly
    Paperly -> UserAgent : sends originally requested response + cookie for session
    activate UserAgent

    UserAgent -> Paperly : sends a request to another page in Paperly
    Paperly -> UserAgent : sends response

    deactivate UserAgent
    deactivate Paperly
else request denied
    UserAgent -> Schoolbox : denies Paperly
    Schoolbox -> UserAgent : renders a request denied message\n(with try again call to action?)
end

@enduml
