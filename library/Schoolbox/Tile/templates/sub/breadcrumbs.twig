<ul class="breadcrumb">
    {% if layout.dashboardRole %}
        <li><a href="/adminv2/home">Admin</a></li>
        <li><a href="/adminv2/dashboard#{{ layout.dashboardRole.id }}">Dashboard</a></li>
    {% elseif layout.homepageTemplate %}
        <li><a href="/adminv2/home">Admin</a></li>
        <li><a href="/adminv2/homepage#{{ layout.homepageTemplate.id }}">Homepages</a></li>
    {% elseif layout.folder %}
        {# We may have come from an alt-sourced component, so use that component's URL #}
        <li><a href="{{ RETURN_URL.previous.decoded ?? ('/homepage/' ~ layout.folder.id) }}">{{ layout.folder.name }}</a></li>
    {% endif %}

    {% if tile is not empty %}
        <li><a href="{{ routeLookup('tile.layout', {layoutId: layout.id}) }}">{{layout.heading}}</a></li>
        <li class="active"><a href="#">{% if tile.id %}Modify Tile{% else %}Add Tile{% endif %}</a></li>
    {% else %}
        <li class="active"><a href="#">Tiles</a></li>
    {% endif %}
</ul>
