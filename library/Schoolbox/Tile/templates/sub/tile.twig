{% set baseStyle = "#"~componentId~"-tile-"~tile.id %}
<style type="text/css">
.tile#{{ componentId }}-tile-{{ tile.id|e('css') }} {
    {% if tile.backgroundColor %}
    background-color: rgba(
        {{ tile.backgroundColor.red|e('css') }},
        {{ tile.backgroundColor.green|e('css') }},
        {{ tile.backgroundColor.blue|e('css') }},
        {{ tile.backgroundColor.alpha|e('css') }}
    );
    {% endif %}
    {% if tile.backgroundImage %}
    background-image: url("/storage/image.php?size=maxsize&hash={{ tile.backgroundImage.hash|e('css') }}");
    {% endif %}
}

{% if tile.hoverColor %}
.tile#{{ componentId }}-tile-{{ tile.id|e('css') }} .tile-link:hover,
.tile#{{ componentId }}-tile-{{ tile.id|e('css') }} .edit:hover {
    background-color: rgba(
        {{ tile.hoverColor.red|e('css') }},
        {{ tile.hoverColor.green|e('css') }},
        {{ tile.hoverColor.blue|e('css') }},
        {{ tile.hoverColor.alpha|e('css') }}
    );
}
{% endif %}

.tile#{{ componentId }}-tile-{{ tile.id|e('css') }} .edit a.sbx-icon-only-button {
    border: none;
}

.tile#{{ componentId }}-tile-{{ tile.id|e('css') }} .title {
    color: rgba(
        {{ tile.titleColor.red|e('css') }},
        {{ tile.titleColor.green|e('css') }},
        {{ tile.titleColor.blue|e('css') }},
        {{ tile.titleColor.alpha|e('css') }}
    );
    background-color: rgba(
        {{ tile.titleBackgroundColor.red|e('css') }},
        {{ tile.titleBackgroundColor.green|e('css') }},
        {{ tile.titleBackgroundColor.blue|e('css') }},
        {{ tile.titleBackgroundColor.alpha|e('css') }}
    );
}

</style>

<script type="text/javascript">
$(function () {
    // listen for any dimension changes to the tile to trigger fixTileHeightAndFontSize
    const tile = document.querySelector("#{{ componentId }}-tile-{{ tile.id }}");
    const resizeObserver = new ResizeObserver((entries) => {
        $(tile).fixTileHeightAndFontSize();
    });
    resizeObserver.observe(tile);
});
</script>

<li data-tile
    class="tile {{ tile.getBackgroundPositionStyle() }} {% if tile.backgroundImageContained %}contained{% endif %}"
    id="{{ componentId }}-tile-{{ tile.id|e('html_attr') }}"
    data-min-font-size="{{ tile.getTitleTextMinSize()/100 }}"
    data-max-font-size="{{ tile.getTitleTextMaxSize()/100 }}">
    <span class="title {{ tile.getTitlePositionStyle() }}">{{ tile.titleText }}</span>

    {% if tile.link %}
    <a href="{{ tile.href|e('html_attr') }}" target="{{ tile.getLinkTarget()|e('html_attr') }}" class="tile-link"></a>
    {% else %}
    <span class="tile-link"></span>
    {% endif %}

    {% if editable and tile.id %}
    <div class="edit">
        <span class="button left icon-grip" data-tile-grip></span>
        {# Hidden form input for this tile - used in sorting #}
        <input type="hidden" name="tile[]" value="{{ tile.id|e('html_attr') }}" />
          <a href="{{ routeLookup('tile.delete:post', {id: tile.id}) }}?{{ RETURN_URL.name }}={{ RETURN_URL.previous.encoded }}"
              class="button right sbx-icon-only-button"
              data-role="delete"
              title="Delete"
              aria-label="Delete"><sbx-icon name="delete"></sbx-icon></a>
        <a href="{{ routeLookup('tile.edit', {id: tile.id}) }}?{{ RETURN_URL.name }}={{ RETURN_URL.previous.encoded }}"
              class="button right sbx-icon-only-button"
              title="Modify"><sbx-icon name="modify"></sbx-icon></a>
    </div>
    {% endif %}
</li>
