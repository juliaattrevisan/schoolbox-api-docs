<li class="tile"
    style="
        {% if tile.backgroundColor %}
            background-color: rgba(
                {{ tile.backgroundColor.red|e('css') }},
                {{ tile.backgroundColor.green|e('css') }},
                {{ tile.backgroundColor.blue|e('css') }},
                {{ tile.backgroundColor.alpha|e('css') }}
            );
        {% endif %}
        {% if tile.backgroundImage.id %}
            background-image: url({{ "/storage/image.php?size=maxsize&hash=" ~ tile.backgroundImage.hash|e('css') }});
        {% endif %}
    ">
    <span class="title"
        style="
            color: rgba(
                {{ tile.titleColor.red|e('css') }},
                {{ tile.titleColor.green|e('css') }},
                {{ tile.titleColor.blue|e('css') }},
                {{ tile.titleColor.alpha|e('css') }}
            );
            background-color: rgba(
                {{ tile.titleBackgroundColor.red|e('css') }},
                {{ tile.titleBackgroundColor.green|e('css') }},
                {{ tile.titleBackgroundColor.blue|e('css') }},
                {{ tile.titleBackgroundColor.alpha|e('css') }}
            );
            position: absolute;
            {% if tile.isTitlePositionTop() %}top: 0;
            {% elseif tile.isTitlePositionBottom() %}bottom: 0;
            {% endif %}
    ">
        {% if tile.link %}
        <a href="{{ tile.link|e('html_attr') }}">{{ tile.titleText }}</a>
        {% else %}
        {{ tile.titleText }}
        {% endif %}
    </span>

    {% if editable and tile.id %}
    <div class="edit">
        {# Hidden form input for this tile - used in sorting #}
        <input type="hidden" name="tile[]" value="{{ tile.id|e('html_attr') }}" />
        <input type="checkbox" name="deleteTile[]" value="{{ tile.id|e('html_attr') }}" />
        {#
        <a href="#">Copy</a>
        <a href="#">Delete</a>
        #}
        <a href="{{ routeLookup('tile.edit', {id: tile.id}) }}">Edit</a>
    </div>
    {% endif %}
</li>
