<div class="tile"
    style="
        {% if tile.backgroundColor %}
            background-color: {{ tile.backgroundColor|e('css') }};
        {% endif %}
        {% if tile.backgroundImage.id %}
            background-image: url({{ "/storage/image.php?size=constrain200&hash=" ~ tile.backgroundImage.hash|e('css') }});
        {% endif %}
        background-repeat: none;
        background-size: contain;
    ">
    <span class="title"
        style="
            color: {{ tile.titleColor|e('css') }};
            background-color: {{ tile.titleBackgroundColor|e('css') }};
            position: absolute;
            {% if tile.isTitlePositionBottom() %}top: 0;
            {% elseif tile.isTitlePositionBottom() %}bottom: 0;
            {% endif %}
    ">
        {% if tile.link %}
        <a href="{{ tile.link|e('html_attr') }}">{{ tile.titleText }}</a>
        {% else %}
        {{ tile.titleText }}
        {% endif %}
    </span>
    {% if editable %}
        <a href="{{ routeLookup('tile.edit', {id: tile.id}) }}">Edit</a>
    {% endif %}
</div>
