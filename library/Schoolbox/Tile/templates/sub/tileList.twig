{##
 # Organising the tile list:
 # Grid: layout is x pixels wide
 # Columns: responsive layout? Width
 #}
<style type="text/css">
    /*
    .tileList.column {
        width: auto;
    }
    */

    .tileList {
        word-spacing: 0;
        line-height: 0;
    }
    .tileList.column li {
        position: relative;
        display: inline-block;
        height: auto;
    }
    .tileList.column.ui-sortable li {
        background-image: none;
        border: none;
        padding: 0;
    }
    .tileList.column .tile {
        background-repeat: no-repeat;
        background-size: 100%;
    }
    .tileList.column .tile .title {
        width: 100%;
        word-spacing: normal;
        line-height: normal;
    }
    .tileList .tile a.edit {
        position: absolute;
        top:0;
        bottom: 0;
        width: 100%;
        transition: background-color 0.1s;
    }
    .tileList .tile a.edit:hover {
        background-color: rgba(0, 102, 176, 0.8);
    }
    .tileList .tile.add {
        background-color: rgba(0,0,0,0.1);
    }
    .tileList .tile.add .title {
        position: absolute;
        bottom: 50%;
        width: 100%;
        text-align: center;
        vertical-align: middle;
    }
    #tileList-{{ layout.id }}.tileList.column li {
        {#
         # Width: 100/column_count
         # Padding-bottom (height): 100/column_count*aspectRatioY/aspectRatioX
         #}
        {% if layout.columnCount > 0 and layout.aspectRatioY > 0 and layout.aspectRatioX > 0 %}
        width: {{ 100 / layout.columnCount }}%;
        padding-bottom: {{ 100 / layout.columnCount * (layout.aspectRatioY/layout.aspectRatioX) }}%;
        {% endif %}
    }
    #tileList-{{ layout.id }}.tileList.grid {
        width: {{ layout.gridWidth|e('css') }}px;
    }
</style>
{# spaceless because spaces between inline-block elements split the element. WTF #}
{% spaceless %}
<ul id="tileList-{{ layout.id }}"
    class="clearfix tileList {{ layout.isGridLayoutType() ? 'grid' : 'column' }}"
>
    {% for tile in tileList %}
        {% include '@tile/sub/tile.twig' with {layout: layout, tile: tile, editable: editable} %}
    {% endfor %}

    {% if editable %}
    {# This button should transparently save layout before adding tile #}
    <li class="tile add">
        <span class="title">+ Add Tile</span>
        <a class="edit"
           href="{{ routeLookup('tile.add', {componentId: component.id}) }}"
           title="Add a new tile"
        ></a>
    </li>
    {% endif %}
</ul>
{% endspaceless %}
