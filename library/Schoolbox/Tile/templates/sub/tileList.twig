{##
 # Grid Layout:
 # Tile width: gridWidth px
 # Padding-bottom (height): gridWidth*aspectRatioY/aspectRatioX
 #
 # Column Layout:
 # Tile width: 100/column_count
 # Padding-bottom (height): 100/column_count*aspectRatioY/aspectRatioX
 #}
{% if layout.aspectRatioY > 0 and layout.aspectRatioX > 0 %}
    {% set aspectRatio = (layout.aspectRatioY/layout.aspectRatioX) %}
{% else %}
    {% set aspectRatio = 1 %}
{% endif %}
<style>
#tileList-{{ layout.id }}.tileList .tile {
    {# Guard against these variables not being set correctly in the database #}
    {% set gridWidth = layout.gridWidth > 0 ? layout.gridWidth : 100 %} {# 100 is the default value in Tile\Layout\Model #}
    {% set columnCount = layout.columnCount > 0 ? layout.columnCount : 1 %} {# 1 is the default value in Tile\Layout\Model #}

    {% if layout.isGridLayoutType %}
        width: {{ gridWidth|e('css') }}px;
        margin: {{ layout.getGridPadding|e('css') }}px;
        {% set paddingBottom = gridWidth * aspectRatio ~ "px" %}
    {% else %}
        {% set baseColumnWidth   = (100 / columnCount) %}
        {% set paddingPercentage = (layout.columnPadding / 100) %}
        {% set tilePadding       = baseColumnWidth * paddingPercentage %}
        {% set tileWidth         = baseColumnWidth - tilePadding %}
        width: {{ tileWidth }}%;
        margin: {{ (tilePadding / 2) }}%;
        {% set paddingBottom = tileWidth * aspectRatio ~ "%" %}
    {% endif %}

    padding-bottom: {{ paddingBottom }};
}
</style>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/tiles/jquery.tile-resize.js?v={{ config.site_version }}"></script>

{# spaceless because spaces between inline-block elements split the element. WTF #}
{% apply spaceless %}
{% if (tileList|length > 0) or editable %}
{# Store aspect-ration on each <ul> for access within www/static/js/tiles/jquery.tile-resize.js #}
<ul id="tileList-{{ layout.id }}" class="tileList" data-tile-list data-aspect-ratio="{{ aspectRatio }}">
    {% for tile in tileList %}
        {% include '@tile/sub/tile.twig' with {
            componentId: 'component' ~ componentId,
            layout: layout,
            tile: tile,
            editable: editable
        } %}
    {% endfor %}

    {% if editable %}
    {# This button should transparently save layout before adding tile #}
    {# It now also saves the form data (heading, etc.) - check library/Schoolbox/Tile/templates/layout.twig #}
    <li class="tile add" data-tile>
        <span class="title position-middle">+ Add Tile</span>
        <a class="edit"
            data-add-tile
            href="{{ routeLookup('tile.add', {layoutId: layout.id}) }}?{{ RETURN_URL.name }}={{ RETURN_URL.previous.encoded }}"
            title="Add a new tile"
        ></a>
    </li>
    {% endif %}
</ul>
{% endif %}
{% endapply %}
