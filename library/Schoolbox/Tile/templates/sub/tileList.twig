{##
 # Grid Layout:
 # Tile width: gridWidth px
 # Padding-bottom (height): gridWidth*aspectRatioY/aspectRatioX
 # Column Layout:
 # Tile width: 100/column_count
 # Padding-bottom (height): 100/column_count*aspectRatioY/aspectRatioX
 #}
{% if layout.aspectRatioY > 0 and layout.aspectRatioX > 0 %}
<style type="text/css">
#tileList-{{ layout.id }}.tileList .tile {
    {% if layout.isGridLayoutType and layout.gridWidth > 0 %}
    width: {{ layout.gridWidth|e('css') }}px;
    margin: {{ layout.getGridPadding|e('css') }}px;
    padding-bottom: {{ layout.gridWidth * (layout.aspectRatioY/layout.aspectRatioX) }}px;
    {% endif %}

    {% if layout.isColumnLayoutType and layout.columnCount > 0 %}
    {% set baseColumnWidth   = (100 / layout.columnCount) %}
    {% set paddingProportion = (layout.columnPadding / 100) %}
    {% set tilePadding       = baseColumnWidth * paddingProportion %}
    {% set tileWidth         = baseColumnWidth - tilePadding %}
    width: {{ tileWidth }}%;
    margin: {{ tilePadding / 2 }}%;
    padding-bottom: {{ tileWidth * (layout.aspectRatioY/layout.aspectRatioX) }}%;
    {% endif %}
}
</style>
    <script type="text/javascript" src="/javascript/shared/tiles/jquery.tile-resize.js"></script>
<script type="text/javascript">
    (function($) {
        // Cheat's responsive text size:
        // Constrain font size based on width of tile
        $(function() {
            var resizeTitles = function() {
                $('#tileList-{{ layout.id }}').find('.tile').tileResize();
            };
            resizeTitles();
            $(window).resize(resizeTitles);
        });
    })(jQuery);
</script>
{% endif %}

{# spaceless because spaces between inline-block elements split the element. WTF #}
{% spaceless %}
{% if (tileList|length > 0) or editable %}
<ul id="tileList-{{ layout.id }}" class="tileList" data-tile-list>
    {% for tile in tileList %}
        {% include '@tile/sub/tile.twig' with {layout: layout, tile: tile, editable: editable} %}
    {% endfor %}

    {% if editable %}
    {# This button should transparently save layout before adding tile #}
    <li class="tile add" data-tile>
        <span class="title position-middle">+ Add Tile</span>
        <a class="edit"
           href="{{ routeLookup('tile.add', {componentId: component.id}) }}"
           title="Add a new tile"
        ></a>
    </li>
    {% endif %}
</ul>
{% endif %}
{% endspaceless %}
