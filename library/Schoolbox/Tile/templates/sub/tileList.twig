{##
 # Organising the tile list:
 # Grid: layout is x pixels wide
 # Columns: responsive layout? Width
 #}
<style type="text/css">
    .tileList.column {
        width: auto;
        display: inline-block;
    }
    .tileList.column .tile {
        display: inline-block;
        width: 30%;
        height: auto;
    }
</style>
<ul class="clearfix tileList {{ layout.isGridLayoutType() ? 'grid' : 'column' }}"
    style="
    {% if layout.isGridLayoutType() %}
        width: {{ layout.gridWidth|e('css') }}px;
    {% else %}

    {% endif %}
    "
>
    {% for tile in tileList %}
        <li>{% include '@tile/sub/tile.twig' with {layout: layout, tile: tile, editable: editable} %}</li>
    {% endfor %}
</ul>