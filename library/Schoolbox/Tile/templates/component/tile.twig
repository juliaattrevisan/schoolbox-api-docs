
{% set routeParams = {
    layoutId:    component.layout.id,
    layout:      component.layout,
    component:   component.instance,
    componentId: component.instance.id,
    homepage:    component.context,
} %}

{% if component.layout.tileList is empty %}

    <div class="empty-state">
        <i class="icon-tiles"></i>

        {% set addTileUrl = routeLookupIfAuthorized("tile.addToComponent", routeParams) %}
        {% if writeAccess and addTileUrl %}
            <p><a href="{{ addTileUrl }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Add a tile</a> to create buttons or banners that link to other pages.</p>
        {% else %}
            <p>There are no tiles available at this time.</p>
        {% endif %}

    </div>

{% else %}

    {% include '@tile/sub/tileList.twig'
        with {
            layout:   component.layout,
            tileList: component.layout.tileList,
            editable: false
        }
    %}

    {% if writeAccess %}
        {% set addTileUrl = routeLookupIfAuthorized("tile.add", routeParams) %}
        {% set modifyUrl = routeLookupIfAuthorized("tile.layout", routeParams) %}
        {% if addTileUrl or modifyUrl %}
        <div class="component-action">
            <section>
                {% if addTileUrl %}<a href="{{ addTileUrl }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="button">Add Tile</a>{% endif %}
                {% if modifyUrl %}<a href="{{ modifyUrl }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="button">Modify</a>{% endif %}
            </section>
        </div>
        {% endif %}
    {% endif %}

{% endif %}
