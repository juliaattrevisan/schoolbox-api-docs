{% include '@tile/sub/tileList.twig'
    with {
        layout:   component.layout,
        tileList: component.layout.tileList,
        editable: false
    }
%}
{% if showButtons %}

<div class="component-action">
    <section>
        <a href="/tile/add/{{ tile_component_instance_id }}" class="button">Add Tile</a>
        <a href="/tile/layout/{{ tile_component_instance_id }}" class="button">Modify Layout</a>
    </section>
</div>
{% endif %}
