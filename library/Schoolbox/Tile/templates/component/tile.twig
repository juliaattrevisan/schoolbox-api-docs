{% if component.layout.tileList is empty %}

    <div class="empty-state">
        <i class="icon-tiles"></i>

        {% if writeAccess %}
            <p><a href="/tile/add/{{ tile_component_instance_id }}">Add a tile</a> to create buttons or banners that link to other pages.</p>
        {% else %}
            <p>There are no tiles available at this time.</p>
        {% endif %}

    </div>

{% else %}

    {% include '@tile/sub/tileList.twig'
        with {
            layout:   component.layout,
            tileList: component.layout.tileList,
            editable: false
        }
    %}

    {% if writeAccess %}
        <div class="component-action">
            <section>
                <a href="/tile/add/{{ tile_component_instance_id }}" class="button">Add Tile</a>
                <a href="/tile/layout/{{ tile_component_instance_id }}" class="button">Modify</a>
            </section>
        </div>
    {% endif %}

{% endif %}