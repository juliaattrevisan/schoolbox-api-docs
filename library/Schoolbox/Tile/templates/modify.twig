<link rel="stylesheet" type="text/css" href="/javascript/components/spectrum/spectrum.css" />
<script type="text/javascript" src="/javascript/components/spectrum/spectrum.js"></script>
<script type="text/javascript" src="/javascript/jquery.prettyFileInput.js"></script>
<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
<script type="text/javascript">
(function($) {
    $(function() {
        var form = $('form#tile-modify-form');
        form.find('input[type="file"].prettify').prettyFileInput({
            additionalButtonClasses: 'up-arrow no-marg float-right',
            buttonActiveClass: 'tick',
            defaultText: '<span></span>Upload Image',
            defaultFileSelectedText: '<span></span>File selected'
        });

        // Init colorpickers
        $('input[data-colorpicker]').spectrum({
            showPalette: false,
            showSelectionPalette: false,
            showButtons: false,
            showAlpha: true,
            showInitial: true,
            showInput: true,
            preferredFormat: "rgb",
            allowEmpty: true
        }).each(function() {
            // when I select a color on a transparent element,
            // what I really mean is I want to select an opaque color.
            // Setting the color to an opaque equivalent, then clearing it,
            // preserves the alpha channel for when I next select a color.
            var element = $(this);
            var color   = element.spectrum('get');
            if (color.getAlpha() == 0) {
                color.setAlpha(1);
                element.spectrum('set', color);
                element.spectrum('set', null);
            }
        });

        // Yes, this is a global variable, it's needed for the
        // social stream browser to work
        socialstreamSession = {categoryId: 0};
        var socialstream_browser = form.find('.resource_browser');
        if (socialstream_browser.length && $.fn.socialstreamBrowser) {
            form.find('a[data-function="browse"]')
                .click(
                    function(event) {
                        event.preventDefault();
                        socialstream_browser.socialstreamBrowser({
                            submitCallback: function(url) {
                                form.find('input[name="link"]').val(url);
                            }
                        });
                    });
        }
    })
})(jQuery);
</script>

<h1>{% if item.id %}Modify Tile{% else %}Add Tile{% endif %}</h1>

<form id="tile-modify-form"
      action="{% if item.id %}{{ routeLookup('tile.update:post', {id: item.id}) }}{% else %}{{ routeLookup('tile.create', {componentId: component.id}) }}{% endif %}"
      method="post"
      name="form"
      class="clearfix"
      enctype="multipart/form-data"
>
    <input type="hidden" name="id" value="{{ item.id|e('html_attr') }}"/>
    <table class="standardForm table">
        <tr>
            <td class="formLabelWidth">
                <h4>Title</h4>
                <em>
                    Add an optional title to appear above the tile background.
                </em>
            </td>
            <td>
                <dl>
                    <dt>Text</dt>
                    <dd class="title-text">
                        <input name="title_text"
                               value="{{ item.titleText|e('html_attr') }}"
                               class="fullwidth"
                               placeholder="enter text..." />
                    </dd>
                    <dt>Colour</dt>
                    <dd class="title-color">
                        <input type="text"
                               id="title_color"
                               name="title_color"
                               data-colorpicker
                               value="{{ item.titleColor|e('html_attr') }}" />
                        <label for="title_color">Text</label>
                    </dd>
                    <dd class="title-color">
                        <input type="text"
                               id="title_background_color"
                               name="title_background_color"
                               data-colorpicker
                               value="{{ item.titleBackgroundColor|e('html_attr') }}" />
                        <label for="title_background_color">Background</label>
                    </dd>
                    <dt>Position</dt>
                    <dd class="title-position">
                        <input type="radio"
                               id="title_position_topleft"
                               name="title_position"
                               value="{{ constant('POSITION_TOPLEFT', item) }}"
                               {% if item.isTitlePositionTopLeft() %}checked{% endif %} />
                        <label for="title_position_topleft">Top Left</label>
                        <input type="radio"
                               id="title_position_top"
                               name="title_position"
                               value="{{ constant('POSITION_TOP', item) }}"
                               {% if item.isTitlePositionTop() %}checked{% endif %} />
                        <label for="title_position_top">Top</label>
                        <input type="radio"
                               id="title_position_topright"
                               name="title_position"
                               value="{{ constant('POSITION_TOPRIGHT', item) }}"
                               {% if item.isTitlePositionTopRight() %}checked{% endif %} />
                        <label for="title_position_topright">Top Right</label>
                        <br />
                        <input type="radio"
                               id="title_position_left"
                               name="title_position"
                               value="{{ constant('POSITION_LEFT', item) }}"
                               {% if item.isTitlePositionLeft() %}checked{% endif %} />
                        <label for="title_position_left">Left</label>
                        <input type="radio"
                               id="title_position_center"
                               name="title_position"
                               value="{{ constant('POSITION_CENTER', item) }}"
                               {% if item.isTitlePositionCenter() %}checked{% endif %} />
                        <label for="title_position_center">Centre</label>
                        <input type="radio"
                               id="title_position_right"
                               name="title_position"
                               value="{{ constant('POSITION_RIGHT', item) }}"
                               {% if item.isTitlePositionRight() %}checked{% endif %} />
                        <label for="title_position_right">Right</label>
                        <br />
                        <input type="radio"
                               id="title_position_bottomleft"
                               name="title_position"
                               value="{{ constant('POSITION_BOTTOMLEFT', item) }}"
                               {% if item.isTitlePositionBottomLeft() %}checked{% endif %} />
                        <label for="title_position_bottomleft">Bottom Left</label>
                        <input type="radio"
                               id="title_position_bottom"
                               name="title_position"
                               value="{{ constant('POSITION_BOTTOM', item) }}"
                               {% if item.isTitlePositionBottom() %}checked{% endif %} />
                        <label for="title_position_bottom">Bottom</label>
                        <input type="radio"
                               id="title_position_bottomright"
                               name="title_position"
                               value="{{ constant('POSITION_BOTTOMRIGHT', item) }}"
                               {% if item.isTitlePositionBottomRight() %}checked{% endif %} />
                        <label for="title_position_bottomright">Bottom Right</label>
                    </dd>
                </dl>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Link</h4>
                <em>Add an optional link to this tile, linking it to either an external page or existing resource.</em>
            </td>
            <td>
                <input name="link"
                       value="{{ item.link|e('html_attr') }}"
                       class="fullwidth"
                       placeholder="http://" />
                <a href="#" data-function="browse" class="btn folder float-left"><span></span>Browse Resources</a>
            </td>
        </tr>
        <tr>
            <td class="formLabelWidth">
                <h4>Background</h4>
            </td>
            <td>
                <dl>
                    <dt>Colour</dt>
                    <dd class="background-color">
                        <input type="text"
                               id="background_color"
                               name="background_color"
                               data-colorpicker
                               value="{{ item.backgroundColor|e('html_attr') }}" />
                        <label for="background_color">Background</label>
                    </dd>
                    <dd class="background-color">
                        <input type="text"
                               id="hover_color"
                               name="hover_color"
                               data-colorpicker
                               value="{{ item.hoverColor|e('html_attr') }}" />
                        <label for="hover_color">Hover</label>
                    </dd>
                    <dt>Image</dt>
                    <dd class="background-upload">
                        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                    </dd>
                    <dt>Image Size</dt>
                    <dd class="title-position">
                        <input type="radio"
                               id="background_image_contained_0"
                               name="background_image_contained"
                               value="0"
                               {% if not item.backgroundImageContained %}checked{% endif %} />
                        <label for="background_image_contained_0">Stretch to cover entire tile</label>
                        <input type="radio"
                               id="background_image_contained_1"
                               name="background_image_contained"
                               value="1"
                               {% if item.backgroundImageContained %}checked{% endif %} />
                        <label for="background_image_contained_1">Shrink to fit within tile</label>
                    </dd>
                </dl>
            </td>
        </tr>
    </table>

    <input id="resource-save"
           type="submit"
           value="Save"
           class="submit-btn-plain"
    />
    {# Link depends on identifier #}
    <a href="{{ routeLookup('tile.layout', {componentId: component.id}) }}" class="btn no-icon float-left"><span></span>Cancel</a>

    {# Dialog for resource browser #}
    <div class="resource_browser hide">
    </div>
</form>
