<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/core/spectrum/spectrum.css" />
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/spectrum.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/attacher/attacher.hide-watch.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
(function($) {
    $(function() {
        var form = $('form#tile-modify-form');

        form.alaressValidate();

        // Init colorpickers
        $('input[data-colorpicker]').spectrum({
            showPalette: false,
            showSelectionPalette: false,
            showButtons: false,
            showAlpha: true,
            showInitial: true,
            showInput: true,
            preferredFormat: "rgb",
            allowEmpty: true
        }).each(function() {
            // when I select a color on a transparent element,
            // what I really mean is I want to select an opaque color.
            // Setting the color to an opaque equivalent, then clearing it,
            // preserves the alpha channel for when I next select a color.
            var element = $(this);
            var color   = element.spectrum('get');
            if (color.getAlpha() == 0) {
                color.setAlpha(1);
                element.spectrum('set', color);
                element.spectrum('set', null);
            }
        });
    })
})(jQuery);
</script>

{% include '@tile/sub/breadcrumbs.twig' with {layout: layout, tile: item} only %}

<div class="row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{% if item.id %}Modify Tile{% else %}Add Tile{% endif %}</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <form id="tile-modify-form"
              name='form'
              action="{{ item.id
                  ? routeLookup('tile.update:post', {id: item.id})
                  : routeLookup('tile.create', {layoutId: layout.id})
              }}?{{ RETURN_URL.name }}={{ RETURN_URL.previous.encoded }}"
              method="post">
            <input type="hidden" name="id" value="{{ item.id|e('html_attr') }}"/>

            <h2 class="subheader">Title</h2>
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label class="text">
                            Text
                            <span class='hint has-tip tip-top' data-tooltip title="Add an optional title to appear above the tile background.">?</span>
                            <input type="text" name="title_text" maxlength="250"  value="{{ item.titleText|e('html_attr') }}" placeholder="enter text..." />
                        </label>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <legend>Size<span class='hint has-tip tip-top' data-tooltip title="The font will scale between these percentages depending on the screen size">?</span></legend>
                    <div class="small-5 columns">
                        <label for="title_text_min_size" class="required">From</label>
                        <input type="number"
                               id="title_text_min_size"
                               name="title_text_min_size"
                               value="{{ item.getTitleTextMinSize()|e('html_attr') }}"
                               required
                        />
                    </div>
                    <div class="small-1 columns">
                        <label for="title_text_min_size">&nbsp;</label> %
                    </div>
                    <div class="small-5 columns">
                        <label for="title_text_max_size" class="required">To</label>
                        <input type="number"
                               id="title_text_max_size"
                               name="title_text_max_size"
                               value="{{ item.getTitleTextMaxSize()|e('html_attr') }}"
                               required
                        />
                    </div>
                    <div class="small-1 columns">
                        <label for="title_text_max_size">&nbsp;</label> %
                    </div>
                </fieldset>
                <fieldset class="content">
                    <legend>
                        Colour
                    </legend>
                    <div class="small-6 columns">
                        <label for="title_color">
                            Text
                        </label>
                        <input type="text"
                               id="title_color"
                               name="title_color"
                               data-colorpicker
                               value="{{ item.titleColor|e('html_attr') }}" />
                    </div>
                    <div class="small-6 columns">
                        <label for="title_background_color">
                            Background
                        </label>
                        <input type="text"
                               id="title_background_color"
                               name="title_background_color"
                               data-colorpicker
                               value="{{ item.titleBackgroundColor|e('html_attr') }}" />
                    </div>
                </fieldset>
                <fieldset class="content">
                    <legend>
                        Position
                    </legend>
                    <div class="small-12 columns no-pad">
                        <table>
                            <thead>
                            <tr>
                                <th>&nbsp;</th>
                                <th>Left</th>
                                <th>Center</th>
                                <th>Right</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <th>Top</th>
                                <td>
                                    <input type="radio"
                                           id="title_position_topleft"
                                           name="title_position"
                                           value="{{ constant('POSITION_TOPLEFT', item) }}"
                                           {% if item.isTitlePosition(constant('POSITION_TOPLEFT', item)) %}checked{% endif %} />
                                    <label for="title_position_topleft" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="title_position_top"
                                           name="title_position"
                                           value="{{ constant('POSITION_TOP', item) }}"
                                           {% if item.isTitlePosition(constant('POSITION_TOP', item)) %}checked{% endif %} />
                                    <label for="title_position_top" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="title_position_topright"
                                           name="title_position"
                                           value="{{ constant('POSITION_TOPRIGHT', item) }}"
                                           {% if item.isTitlePosition(constant('POSITION_TOPRIGHT', item)) %}checked{% endif %} />
                                    <label for="title_position_topright" class="radio-label"></label>
                                </td>
                            </tr>
                            <tr>
                                <th>Middle</th>
                                <td>
                                    <input type="radio"
                                           id="title_position_left"
                                           name="title_position"
                                           value="{{ constant('POSITION_LEFT', item) }}"
                                           {% if item.isTitlePosition(constant('POSITION_LEFT', item)) %}checked{% endif %} />
                                    <label for="title_position_left" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="title_position_center"
                                           name="title_position"
                                           value="{{ constant('POSITION_CENTER', item) }}"
                                           {% if item.isTitlePosition(constant('POSITION_CENTER', item)) %}checked{% endif %} />
                                    <label for="title_position_center" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="title_position_right"
                                           name="title_position"
                                           value="{{ constant('POSITION_RIGHT', item) }}"
                                           {% if item.isTitlePosition(constant('POSITION_RIGHT', item)) %}checked{% endif %} />
                                    <label for="title_position_right" class="radio-label"></label>
                                </td>
                            </tr>
                            <tr>
                                <th>Bottom</th>
                                <td>
                                    <input type="radio"
                                           id="title_position_bottomleft"
                                           name="title_position"
                                           value="{{ constant('POSITION_BOTTOMLEFT', item) }}"
                                           {% if item.isTitlePosition(constant('POSITION_BOTTOMLEFT', item)) %}checked{% endif %} />
                                    <label for="title_position_bottomleft" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="title_position_bottom"
                                           name="title_position"
                                           value="{{ constant('POSITION_BOTTOM', item) }}"
                                           {% if item.isTitlePosition(constant('POSITION_BOTTOM', item)) %}checked{% endif %} />
                                    <label for="title_position_bottom" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="title_position_bottomright"
                                           name="title_position"
                                           value="{{ constant('POSITION_BOTTOMRIGHT', item) }}"
                                           {% if item.isTitlePosition(constant('POSITION_BOTTOMRIGHT', item)) %}checked{% endif %} />
                                    <label for="title_position_bottomright" class="radio-label"></label>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </fieldset>
            </section>

            <h2 class="subheader">Link</h2>
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="link">
                            URL
                            <span class='hint has-tip tip-top' data-tooltip title="Add an optional link to this tile, linking it to either an external page or existing resource.">?</span>
                        </label>
                        <script>
                            $(function() {
                                $('#modalLinkButton').schoolboxLink({
                                    onSelect: function(url, name, mime, dialog) {
                                        $('#link').val(url);
                                    }
                                });
                            });
                        </script>
                        <div class="input-group">
                            <input name="link" id="link" type="text" value="{{ item.link|e('html_attr') }}" placeholder="https://" />
                            <a id="modalLinkButton" class="button icon-link">Browse</a>
                        </div>
                    </div>
                    <div class="small-12 columns">
                        <label>
                            Opens In
                            <select name="link_target">
                                <option value="_self" {% if item.getLinkTarget() == '_self' %}selected{% endif %}>Same tab/window</option>
                                <option value="_blank" {% if item.getLinkTarget() == '_blank' %}selected{% endif %}>New tab/window</option>
                            </select>
                        </label>
                    </div>
                </fieldset>
            </section>

            <h2 class="subheader">Background</h2>
            <section>
                <fieldset class="content">
                    <legend>Colour</legend>
                    <div class="small-6 columns">
                        <label for="background_color">
                            Background
                        </label>
                        <input type="text"
                               id="background_color"
                               name="background_color"
                               data-colorpicker
                               value="{{ item.backgroundColor|e('html_attr') }}" />
                    </div>
                    <div class="small-6 columns">
                        <label for="hover_color">
                            Hover
                        </label>
                        <input type="text"
                               id="hover_color"
                               name="hover_color"
                               data-colorpicker
                               value="{{ item.hoverColor|e('html_attr') }}" />
                    </div>
                </fieldset>
                <fieldset class="content">
                    <legend>
                        Image
                    </legend>
                    <div class="small-12 columns">
                        <label>
                            Image
                        </label>
                        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}

                        <label>
                            Image Size
                        </label>
                        <ul class="option-list">
                            <li>
                                <input type="radio"
                                    id="background_image_contained_0"
                                    name="background_image_contained"
                                    value="0"
                                    {% if not item.backgroundImageContained %}checked{% endif %} />
                                <label for="background_image_contained_0" class="radio-label">
                                    Stretch to cover entire tile
                                </label>
                            </li>
                            <li>
                                <input type="radio"
                                    id="background_image_contained_1"
                                    name="background_image_contained"
                                    value="1"
                                    {% if item.backgroundImageContained %}checked{% endif %} />
                                <label for="background_image_contained_1" class="radio-label">
                                    Resize to fit within tile
                                </label>
                            </li>
                        </ul>
                    </div>
                </fieldset>
                <fieldset class="content {% if not item.backgroundImageContained %}hide{% endif %}" data-hide-watch="[name='background_image_contained']" data-hide-watch-value="1">
                    <legend>
                        Position
                    </legend>
                    <div class="small-12 columns no-pad">
                        <table class="position-selector">
                            <thead>
                            <tr>
                                <th>&nbsp;</th>
                                <th>Left</th>
                                <th>Center</th>
                                <th>Right</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <th>Top</th>
                                <td>
                                    <input type="radio"
                                           id="background_position_topleft"
                                           name="background_position"
                                           value="{{ constant('POSITION_TOPLEFT', item) }}"
                                           {% if item.isBackgroundPosition(constant('POSITION_TOPLEFT', item)) %}checked{% endif %} />
                                    <label for="background_position_topleft" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="background_position_top"
                                           name="background_position"
                                           value="{{ constant('POSITION_TOP', item) }}"
                                           {% if item.isBackgroundPosition(constant('POSITION_TOP', item)) %}checked{% endif %} />
                                    <label for="background_position_top" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="background_position_topright"
                                           name="background_position"
                                           value="{{ constant('POSITION_TOPRIGHT', item) }}"
                                           {% if item.isBackgroundPosition(constant('POSITION_TOPRIGHT', item)) %}checked{% endif %} />
                                    <label for="background_position_topright" class="radio-label"></label>
                                </td>
                            </tr>
                            <tr>
                                <th>Middle</th>
                                <td>
                                    <input type="radio"
                                           id="background_position_left"
                                           name="background_position"
                                           value="{{ constant('POSITION_LEFT', item) }}"
                                           {% if item.isBackgroundPosition(constant('POSITION_LEFT', item)) %}checked{% endif %} />
                                    <label for="background_position_left" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="background_position_center"
                                           name="background_position"
                                           value="{{ constant('POSITION_CENTER', item) }}"
                                           {% if item.isBackgroundPosition(constant('POSITION_CENTER', item)) %}checked{% endif %} />
                                    <label for="background_position_center" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="background_position_right"
                                           name="background_position"
                                           value="{{ constant('POSITION_RIGHT', item) }}"
                                           {% if item.isBackgroundPosition(constant('POSITION_RIGHT', item)) %}checked{% endif %} />
                                    <label for="background_position_right" class="radio-label"></label>
                                </td>
                            </tr>
                            <tr>
                                <th>Bottom</th>
                                <td>
                                    <input type="radio"
                                           id="background_position_bottomleft"
                                           name="background_position"
                                           value="{{ constant('POSITION_BOTTOMLEFT', item) }}"
                                           {% if item.isBackgroundPosition(constant('POSITION_BOTTOMLEFT', item)) %}checked{% endif %} />
                                    <label for="background_position_bottomleft" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="background_position_bottom"
                                           name="background_position"
                                           value="{{ constant('POSITION_BOTTOM', item) }}"
                                           {% if item.isBackgroundPosition(constant('POSITION_BOTTOM', item)) %}checked{% endif %} />
                                    <label for="background_position_bottom" class="radio-label"></label>
                                </td>
                                <td>
                                    <input type="radio"
                                           id="background_position_bottomright"
                                           name="background_position"
                                           value="{{ constant('POSITION_BOTTOMRIGHT', item) }}"
                                           {% if item.isBackgroundPosition(constant('POSITION_BOTTOMRIGHT', item)) %}checked{% endif %} />
                                    <label for="background_position_bottomright" class="radio-label"></label>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <input id="resource-save" type="submit" value="Save" />
                </div>
            </div>
        </form>
    </div>
</div>

