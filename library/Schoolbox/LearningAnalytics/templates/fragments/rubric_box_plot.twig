{#
    Renders a rubric box plot for the learning analytics page

#}
{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        /**
         *  Boxplots for Rubrics
         */
        $.fn.boxPlotRender({
            element: '[data-graph=rubrics]',

            // Title of the graph
            title: '',

            // Orientation of the box plots
            orientation: 'horizontal',

            /* A list of all the criteria that are being graphed
             * These correspond to a series of data and their respective
             * five-point summaries
             */
            allAssessments: [
                {% for capabilityId, capabilityData in dataset %}
                    {% for indicatorId, indicatorData in capabilityData.indicators %}
                        "{{ indicatorData.name }}",
                    {% endfor %}
                {% endfor %}
            ],

            // All the raw data
            allData: {
                allGraphData: [
                    {% for capabilityId, capabilityData in dataset %}
                        {% for indicatorId, indicatorData in capabilityData.indicators %}
                            {% if indicatorData.published.vals|length %}
                                [
                                    {{ indicatorData.published.statistics.min }},
                                    {{ indicatorData.published.statistics.quartile1 }},
                                    {{ indicatorData.published.statistics.quartile2 }},
                                    {{ indicatorData.published.statistics.quartile3 }},
                                    {{ indicatorData.published.statistics.max }}
                                ],
                            {% else %}
                                {# Seems to be the same as [null,null,null,null,null] #}
                                [],
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                ],
                allOutliers: []
            }
            {#allData: $.fn.boxPlotCalculateAllSeriesData([#}
            {#    {% for criterionName, studentMarks in studentMarksPerCriterion %}#}
            {#        [#}
            {#            #}{# Highcharts won't render without at least one data point #}
            {#            {% if 0 == studentMarks | length %}#}
            {#            {#}
            {#                info: null,#}
            {#                externalId: null,#}
            {#                uid: null,#}
            {#                value: -100#}
            {#            }{% if false %},{% endif %} #}{# Just a hack to placate storm #}
            {#            {% endif %}#}

            {#            {% for studentId, studentMark in studentMarks %}#}
            {#            {#}
            {#                uid: Number("{{ studentId }}"),#}
            {#                externalId: "{{ students[studentId].externalId }}",#}
            {#                info: "{{ students[studentId].fullName }}",#}
            {#                value: Number("{{ studentMark }}")#}

            {#            }{% if not loop.last %},{% endif %}#}
            {#            {% endfor %}#}

            {#        ]{% if not loop.last %},{% endif %}#}
            {#    {% endfor %}#}
            {#])#}
        });
    });
</script>
{% endautoescape %}


<div data-graph="rubrics" style="height:{{ ((dataset | length) * 40) + 75 }}px"></div>
