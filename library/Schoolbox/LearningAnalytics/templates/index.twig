<h1>Stuff</h1>

<h2>Overall Progress</h2>

<div data-graph='overall' class='learning-analytics overall'></div>

<div class="learning-analytics hall">
    <h3>Top Students</h3>
    <ul>
        {% for currentStudent in overallProgress.topStudents %}
        <li>
            <a href='/search/user/{{ currentStudent.user.getId() }}'>{{ currentStudent.user.getFullName() }}</a>
            ({{ currentStudent.tasks|length }}/{{ overallProgress.totalTasks }})
        </li>
        {% endfor %}
    </ul>
</div>

<div class="learning-analytics hall">
    <h3>Bottom Students</h3>
    <ul>
        {% for currentStudent in overallProgress.bottomStudents %}
        <li>
            <a href='/search/user/{{ currentStudent.user.getId() }}'>{{ currentStudent.user.getFullName() }}</a>
            ({{ currentStudent.tasks|length }}/{{ overallProgress.totalTasks }})
        </li>
        {%  endfor %}
    </ul>
</div>

