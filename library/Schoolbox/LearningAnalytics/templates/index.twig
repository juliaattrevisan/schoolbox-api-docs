                    value: 14.5
                },
                {
                    info: 'Jerome',
                    value: 14.5
                },
                {
                    info: 'Frederic',
                    value: 14.6
                },
                {
                    info: 'Samuel',
                    value: 14.7
                },
                {
                    info: 'Grace',
                    value: 14.7
                },
                {
                    info: 'Naomi',
                    value: 14.7
                },
                {
                    info: 'Randall',
                    value: 14.9
                },
                {
