<h1>Stuff</h1>

<h2>Overall Progress</h2>

<style type="text/css">

    /* Overall Progress
     */
    .learning-analytics.overall {
        width: 100%;
        height: 150px;
    }

    /* Top/Bottom students
     */
    .learning-analytics.hall {
        width: 15%;
        float: left;
    }
</style>

<script type="text/javascript">
    $(function() {
        $('[data-graph=overall]').highcharts({

            /* lol use an inverted column chart instead of bar
             * chart to simulate an overlaid bar chart.
             */
            chart: {
                type: 'column',
                inverted: true
            },
            title: {
                text: 'Overall Progress'
            },
            xAxis: {
                labels: {
                    enabled: false
                },
                categories: ['Individual Completion', 'Entire Class'],

                /* Hide useless ticketty-boo lines (you need all
                 * of these values, seemingly)
                 */
                lineWidth: 0,
                minorGridLineWidth: 0,
                lineColor: 'transparent',
                minorTickLength: 0,
                tickLength: 0
            },
            yAxis: {
                min: 0,
                max: 100,
                title: {
                    text: 'Percentage Complete %'
                }
            },

            /* This is used to ensure that Entire Class bar always
             * appears over Most Advanced Student bar when the
             * Most Advanced Student has an equal value to the
             * Entire Class value
             */
            legend: {
                reversed: true
            },
            plotOptions: {
                column: {
                    grouping: false
                }
            },
            series: [
                {
                    name: 'Most Advanced Student',
                    data: [{{ mostAdvancedStudent }}],
                    color: '#ffcc00'
                },
                {
                    name: 'Entire Class',
                    data: [{{ classCompletions }}],
                    color: '#00ccff'
                }
            ],
            tooltip: {
                formatter: function() {
                    return this.series.name + ': ' + this.y + '%';
                }
            }
        });
    });
</script>

<div data-graph='overall' class='learning-analytics overall'></div>

<div class="learning-analytics hall">
    <h3>Top Students</h3>
    <ul>
        {% for currentStudent in topStudents %}
            <li>
                <a href='/search/user/{{ currentStudent.user.getId() }}'>{{ currentStudent.user.getFullName() }}</a>
                ({{ currentStudent.tasks|length }})
            </li>
        {% endfor %}
    </ul>
</div>

<div class="learning-analytics hall">
    <h3>Bottom Students</h3>
    <ul>
        {% for currentStudent in bottomStudents %}
            <li>
                <a href='/search/user/{{ currentStudent.user.getId() }}'>{{ currentStudent.user.getFullName() }}</a>
                ({{ currentStudent.tasks|length }})
            </li>
        {%  endfor %}
    </ul>
</div>

