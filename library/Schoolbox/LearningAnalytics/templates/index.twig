                    value: 24
                },
                {
                    info: 'Naomi',
                    value: 29
                },
                {
                    info: 'Solomon',
                    value: 25
                }
            ]
        ];

        var allGraphData = [];
        var allOutliers = [];

        for (var i = 0; i < input.length; i++) {
            var currentSeriesData = $.fn.calculateSeriesData({
                input: input[i]
            });

            /* Outliers and boxplots rendered separately
             */
            allGraphData.push(currentSeriesData.fivePointSummary.array);

            for (var j = 0; j < currentSeriesData.outliers.length; j++) {
                allOutliers.push([i, currentSeriesData.outliers[j].value]);
            }
        }

        $('#learning-analytics-container').highcharts({
            chart: {
                type: 'boxplot'
            },

            title: {
                text: 'Highcharts Box Plot Example'
            },

            legend: {
                enabled: false
            },

            xAxis: {
                categories: ['Gronzy'],
                title: {
                    text: 'Experiment No.'
                }
            },

            yAxis: {
                title: {
                    text: 'Observations'
                },
                plotLines: [{
                    value: 67,
                    color: 'red',
                    width: 2,
                    label: {
                        text: 'Theoretical mean: 932',
                        align: 'center',
                        style: {
                            color: 'gray'
                        }
                    }
                }]
            },

            series: [{
                name: 'Observations',
                data: allGraphData,
                tooltip: {
                    headerFormat: '<em>Experiment No {point.key}</em><br/>'
                }
            },
            {
                name: 'Outlier',
                color: Highcharts.getOptions().colors[0],
                type: 'scatter',
                data: allOutliers,
                marker: {
                    fillColor: 'white',
                    lineWidth: 1,
                    lineColor: Highcharts.getOptions().colors[0]
                },
                tooltip: {

                    /**
                     * Sigh, find all the values in the series which match the
                     * outlier value and concat it all into one giant tooltip
                     *
                     * so goofy
                     *
                     * @returns {string}
                     */
                    pointFormatter: function() {
                        var tooltipContent = '';

                        for (var i = 0; i < input[this.x].length; i++) {
                            if (input[this.x][i].value == this.y) {
                                tooltipContent += '<strong>' + input[this.x][i].info + ':</strong> ' + this.y;
                                tooltipContent += '<br />';
                            }
                        }

                        return tooltipContent;
                    }
                }
            }]
        });
    });
</script>

