<script type="text/javascript">
    $(function() {
        $('select[data-taskfilter=true]').change(function(event) {
            event.preventDefault();

            window.location.href = $(this).val();
        });
    });
</script>
<h2>
    Results
    {% if results.tasks.types.selected.getId() > 0 %}
        ({{ results.tasks.types.selected.getName() }})
    {% endif %}

    <select class="learning-analytics task-filter" data-taskfilter="true">
        {% if metadata.route == 'course' %}
            <option value="/learningAnalytics/course/{{ metadata.folder.course.getId() }}">All</option>
            {% for currentTaskType in results.tasks.types.all %}
            {% set selected = '' %}

            {% if results.tasks.types.selected.getId() == currentTaskType.getId() %}
            {% set selected = 'selected="selected"' %}
            {% endif %}

            <option value="/learningAnalytics/course/{{ metadata.folder.course.getId() }}/task/{{ currentTaskType.getId() }}" {{ selected }}>{{ currentTaskType.getName() }}</option>
            {% endfor %}
        {% elseif metadata.route == 'folder' %}
            <option value="/learningAnalytics/course/{{ metadata.folder.course.getId() }}/folder/{{ metadata.folder.selected.getId() }}">All</option>
            {% for currentTaskType in results.tasks.types.all %}
            {% set selected = '' %}

            {% if results.tasks.types.selected.getId() == currentTaskType.getId() %}
            {% set selected = 'selected="selected"' %}
            {% endif %}

            <option value="/learningAnalytics/course/{{ metadata.folder.course.getId() }}/folder/{{ metadata.folder.selected.getId() }}/task/{{ currentTaskType.getId() }}" {{ selected }}>{{ currentTaskType.getName() }}</option>
            {% endfor %}
        {% endif %}
    </select>
</h2>

<div data-graph="boxplots" class='learning-analytics boxplots'></div>

<div class="clearfix"></div>

<h2>Unit Progress</h2>
<div data-graph='unit-progress' class='learning-analytics unit-progress' style="height:{{ ((progress.allUnits|length)*50)+75 }}px"></div>

{% if rubrics.allRubrics|length > 0 %}
<div class="clearfix"></div>

<h2>Rubrics</h2>
<div data-graph="rubrics" class='learning-analytics boxplots' style="height:{{ ((rubrics.allRubrics|length)*150)+75 }}px"></div>

{% endif %}

<div class="clearfix"></div>

<h2>Effort</h2>
<div data-graph="effort" class='learning-analytics effort'></div>