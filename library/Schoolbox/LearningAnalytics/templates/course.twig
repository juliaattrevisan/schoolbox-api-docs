<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts-more.js"></script>
<script type="text/javascript" src="/learninganalytics/js/progress/overall.js"></script>
<script type="text/javascript" src="/learninganalytics/js/boxPlot.js"></script>
<script type="text/javascript" src="/learninganalytics/js/progress/unit.js"></script>
<script type="text/javascript" src="/learninganalytics/js/effort/scatter.js"></script>
<script type="text/javascript" src="/learninganalytics/js/schoolboxTheme.js"></script>

{% set selectedFolder = metadata.selectedClassFolder %}
{% set courseSpec     = metadata.courseSpecification %}
{% set routeUsed      = metadata.routeUsed %}
{% set route          = metadata.route %}
{% set taskTypeId     = metadata.selectedTaskIdFilter %}
{% set term           = metadata.term %}
{% set folders        = metadata.unitImplementationFolders %}
{% set routeArgs      = { courseSpecId: courseSpec.id, folderId: selectedFolder.id, taskTypeId: taskTypeId, termCode: metadata.term.code } %}

<script type="text/javascript">
    $(function () {

        /**
         * How much of the course has been completed by all students
         * compared to the person who has completed the most
         */
        $.fn.overallProgressRender({
            element: '[data-graph=overall]',
            title: '',
            mostAdvancedStudent: {{ overallProgress.mostAdvancedStudent }},
            classCompletions: {{ overallProgress.classCompletions }},
            clusterName: '{{ selectedFolder ? 'Class' : 'Cohort' }}'
        });

        /**
         *  Boxplots for each Task in the Unit
         */
        $.fn.boxPlotRender({
            element: '[data-graph=boxplots]',

            /* Title of the graph
             */
            title: '',

            /* Orientation of the box plots
             */
            orientation: 'vertical',

            /* A list of all the assessment names that are being graphed
             * These correspond to a series of data and their respective
             * five-point summaries
             */
            allAssessments: {{ results.activities.all | column('title') | json_encode | raw }},

            /* All the raw data
             */
            allData: $.fn.boxPlotCalculateAllSeriesData([
                {% for activity in results.activities.all -%}
                [
                    {% for feedback in results.all[activity.id] -%}
                    {
                        info: "{{ feedback.reviewee.fullName }}",
                        uid: '{{ feedback.reviewee.id }}',
                        value: {{ feedback.normalisedMark ?: 'null' }}
                    }{% if not loop.last %}, {% endif -%}
                    {% else %}{# Highcharts won't render without at least one data point -#}
                    {
                        info: null,
                        uid: null,
                        value: -100
                    }
                {% endfor -%}
                ]{% if not loop.last %},
                {% endif -%}
            {% endfor %}
            ])
        });

        /**
         *  Progress for each Unit in the Course
         */
        $.fn.unitProgressRender({
            element: '[data-graph=unit-progress]',
            title: '',
            clusterName: '{{ selectedFolder ? 'Class' : 'Cohort' }}',
            units: [
                {% for currentUnit in progress.allUnits %}"{{ currentUnit.unit.title }}"{% if not loop.last %},{% endif %}{% endfor %}

            ],
            mostAdvancedStudents: [
                {% for currentUnit in progress.allUnits %}{{ currentUnit.mostAdvancedStudent }}{% if not loop.last %},{% endif %}{% endfor %}

            ],
            classCompletions: [
                {% for currentUnit in progress.allUnits %}{{ currentUnit.classCompletions }}{% if not loop.last %},{% endif %}{% endfor %}

            ]
        });

{% if rubrics.allRubrics | length > 0 %}
        /**
         *  Boxplots for Rubrics
         */
        $.fn.boxPlotRender({
            element: '[data-graph=rubrics]',

            /* Title of the graph
             */
            title: '',

            /* Orientation of the box plots
             */
            orientation: 'horizontal',

            /* A list of all the assessment names that are being graphed
             * These correspond to a series of data and their respective
             * five-point summaries
             */
            allAssessments: [
{% for group, currentCriterion in rubrics.allRubrics %}
{% for criterionId,criterionData in currentCriterion %}
"{{ group }}: {{ criterionData.name }}"{% if not loop.last %},
{% endif %}
{% endfor %}{% if not loop.last %},
{% endif %}
{% endfor %}

            ],

            /* All the raw data
             */
            allData: $.fn.boxPlotCalculateAllSeriesData([
{% for group, allCriteria in rubrics.allRubrics %}
{% for currentCriterion in allCriteria %}
[
{# Highcharts won't render without at least one data point #}
{% if currentCriterion.allValues | length == 0 %}
    {
        info: null,
        uid: null,
        value: -100
    }
{% endif %}
{% for currentValue in currentCriterion.allValues %}
    {
        info: "{{ currentValue.user }}",
        uid: '{{ currentValue.user }}',
        value: {% if currentValue.value %}{{ currentValue.value }}{% else %}null{% endif %}

    }{% if not loop.last %},
{% endif %}
{% endfor %}

]{% if not loop.last %},
{% endif %}

{% endfor %}{% if not loop.last %},
{% endif %}
{% endfor %}
            ])
        });
{% endif %}


        /**
         *  Scatter for Effort
         */
        $.fn.scatterRender({
            element: '[data-graph=effort]',

            /* Title of the graph
             */
            title: '',

            allData: [
{% for userId, currentTally in effort.allEffort %}
{
    info: "{{ currentTally.user.fullname }}",
    uid: '{{ currentTally.user.externalId }}',
    value: [{{ currentTally.hits }},{{ currentTally.average }}]{% if not loop.last %},
{% endif %}
}{% if not loop.last %},
{% endif %}
{% endfor %}
            ]
        });
    });
</script>

{% set trail = [
    [ 'Learning' ],
    [ 'Courses', routeLookup('course.courseList') ],
    [ courseSpec.title, '/homepage/' ~ courseSpec.folder.id ],
    [ 'Analytics', routeLookup('learningAnalytics.' ~ routeUsed | replace({'folder': 'course'}), routeArgs) ],
] %}

{% if selectedFolder %}
    {% set trail = trail | merge([ [ selectedFolder.nameWithCodes ] ]) %}
{% endif %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(trail) }}


<div class="row">
    <div class="small-12 columns">
        <h1>Learning Analytics</h1>
        {% if folders | length %}
        <dl class="sub-nav">
            <dd{% if not selectedFolder %} class="active"{% endif %}>
                <a href="{{ routeLookup('learningAnalytics.' ~ routeUsed | replace({'folder': 'course'}), routeArgs) }}" class="button">All classes</a>
            </dd>
            {% for folder in folders %}
                {% set active = (folder.id == selectedFolder.id) and (route == 'folder') %}
                {% set href   = routeLookup('learningAnalytics.' ~ routeUsed | replace({'course': 'folder'}), routeArgs | merge({ folderId: folder.id })) %}

                <dd class="{% if active %}active{% endif %}">
                    <a href="{{ href }}" class="button">{{ folder.nameWithCodes }}</a>
                </dd>
            {% endfor %}
        </dl>
        {% endif %}

        <ul class="meta">
            <li class="icon-course-builder" title="Course"><a href="/homepage/{{ courseSpec.folder.id }}" title="Course Page">{{ courseSpec.title }}</a></li>

            {% if selectedFolder %}
            <li class="icon-home" title="Class"><a href="/homepage/{{ selectedFolder.id }}" title="Class Page">{{ selectedFolder.nameWithCodes }}</a></li>
            {% endif %}
            <li class="icon-staff-students" title="Students">{{ effort.allEffort | length }} students</li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="small-12 large-6 island">
        <div class="context-switch clearfix">
        {% include 'sub/semesterSelector.twig' with {
            currentTerm: term,
            terms:       terms,
            route:       'learningAnalytics.' ~ routeUsed,
            routeArgs:   routeArgs
        } only %}
        </div>
    </div>
</div>


<div class="row">
    <div class="small-12 large-6 island">
        <h2 class="subheader">Overall Progress</h2>

        <section class="content">
            <div data-graph='overall'></div>
        </section>
    </div>
    <div class="small-12 large-3 island">
        <h3 class="subheader">Top Students</h3>

        <section>
            {% if results.ranking.top | length > 0 %}
            <ul class="information-list">
                {% for currentStudent in results.ranking.top | slice(0,3) %}
                <li>
                    <div class="card small-12">
                        <a href="/search/user/{{ currentStudent.user.id }}" title="View Profile">
                            <img src="/portrait.php?userId={{ currentStudent.user.externalId }}&size=square64" alt="View Profile" />
                            <p>{{ currentStudent.user.fullName }}</p>
                        </a>
                        <p class="meta">{{ currentStudent.average | number_format(1) }}%</p>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <div class="content">
                <p>
                    Nobody has attempted these tasks yet.
                </p>
            </div>
            {% endif %}
        </section>
    </div>
    <div class="small-12 large-3 island">
        <h3 class="subheader">Bottom Students</h3>

        <section>
            {% if results.ranking.bottom | length > 0 %}
            <ul class="information-list">
                {% for currentStudent in results.ranking.bottom | slice(0,3) %}
                <li>
                    <div class="card small-12">
                        <a href="/search/user/{{ currentStudent.user.id }}" title="View Profile">
                            <img src="/portrait.php?userId={{ currentStudent.user.externalId }}&size=square64" alt="View Profile" />
                            <p>{{ currentStudent.user.fullName }}</p>
                        </a>
                        <p class="meta">{{ currentStudent.average | number_format(1) }}%</p>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <div class="content">
                <p>
                    Nobody has attempted these tasks yet.
                </p>
            </div>
            {% endif %}
        </section>
    </div>
</div>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h2 class="subheader">Results</h2>

            {% if results.tasks.types.selected.id > 0 %}
            <ul class="meta">
                <li class="icon-due-work">{{ results.tasks.types.selected.name }}</li>
            </ul>
            {% endif %}
        </div>
    </div>
    <nav>
        <a class="icon-more" title="Filter Options" data-dropdown="result-filter-options"></a>
    </nav>
    <ul id="result-filter-options" class="f-dropdown" data-dropdown-content>

        {% if route == 'course' %}
            <li><a href="{{ routeLookup('learningAnalytics.course', routeArgs) }}" class="icon-due-work" title="All">All</a></li>
            {% for currentTaskType in results.tasks.types.all %}
            <li><a href="{{ routeLookup('learningAnalytics.courseWithTask', routeArgs) }}/task/{{ currentTaskType.id }}" class="icon-due-work" title="{{ currentTaskType.name }}">{{ currentTaskType.name }}</a></li>
            {% endfor %}
        {% elseif route == 'folder' %}
            <li><a href="{{ routeLookup('learningAnalytics.folder', routeArgs) }}" class="icon-due-work" title="All">All</a></li>
            {% for currentTaskType in results.tasks.types.all %}
            <li><a href="{{ routeLookup('learningAnalytics.folderWithTask', routeArgs) }}/task/{{ currentTaskType.id }}" class='icon-due-work' title="{{ currentTaskType.name }}">{{ currentTaskType.name }}</a></li>
            {% endfor %}
        {% endif %}
    </ul>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div data-graph="boxplots"></div>
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Unit Progress</h2>
        <section class="content">
            <div data-graph='unit-progress' style="height:{{ ((progress.allUnits | length)*50)+100 }}px"></div>
        </section>
    </div>
</div>

{% if rubrics.allRubrics | length > 0 %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Rubrics</h2>
        <section class="content">
            <div data-graph="rubrics" style="height:{{ ((rubrics.allRubrics | length)*150)+75 }}px"></div>
        </section>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">
            Effort
            <span class='hint has-tip tip-top' title="The Effort Graph aggregates data across all terms/semesters" data-tooltip>?</span>
        </h2>

        <section class="content">
            <div data-graph="effort"></div>
        </section>
    </div>
</div>
