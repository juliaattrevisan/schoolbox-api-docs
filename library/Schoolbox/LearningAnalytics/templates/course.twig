<script type="text/javascript" src="/javascript/components/highcharts/highcharts.js"></script>
<script type="text/javascript" src="/javascript/components/highcharts/highcharts-more.js"></script>
<script type="text/javascript" src="/learninganalytics/js/progress/overall.js"></script>
<script type="text/javascript" src="/learninganalytics/js/boxPlot.js"></script>
<script type="text/javascript" src="/learninganalytics/js/progress/unit.js"></script>
<script type="text/javascript" src="/learninganalytics/js/effort/scatter.js"></script>
<script type="text/javascript" src="/learninganalytics/js/schoolboxTheme.js"></script>
<script type="text/javascript">
    $(function () {

        /* Un-foundate
           $('#container').addClass('foundation').foundation();
         */

        /* Mr Squiggle
         */

        /**
         * How much of the course has been completed by all students
         * compared to the person who has completed the most
         */
        $.fn.overallProgressRender({
            element: '[data-graph=overall]',
            title: '',
            mostAdvancedStudent: {{ overallProgress.mostAdvancedStudent }},
            classCompletions: {{ overallProgress.classCompletions }}
        });

        /**
         *  Boxplots for each Task in the Unit
         */
        $.fn.boxPlotRender({
            element: '[data-graph=boxplots]',

            /* Title of the graph
             */
            title: '',

            /* Orientation of the box plots
             */
            orientation: 'vertical',

            /* A list of all the assessment names that are being graphed
             * These correspond to a series of data and their respective
             * five-point summaries
             */
            allAssessments: [
{% for currentTask in results.tasks.all %}
"{{ currentTask.getTitle() }}"{% if not loop.last %},
{% endif %}
{% endfor %}

            ],

            /* All the raw data
             */
            allData: $.fn.boxPlotCalculateAllSeriesData([
{% for currentTask in results.tasks.all %}
[
    {# Highcharts won't render without at least one data point #}
    {% if results.all[currentTask.getTask().getId()]|length == 0 %}
    {
        info: null,
        uid: null,
        value: -100
    }
    {% endif %}
    {% for currentValue in results.all[currentTask.getTask().getId()] %}
    {
        info: "{{ currentValue.user.getFullName() }}",
        uid: '{{ currentValue.user.getId() }}',
        value: {% if currentValue.value %}{{ currentValue.value }}{% else %}null{% endif %}
    }{% if not loop.last %},
    {% endif %}
    {% endfor %}
]{% if not loop.last %},
{% endif %}
{% endfor %}
])
        });

        /**
         *  Progress for each Unit in the Course
         */
        $.fn.unitProgressRender({
            element: '[data-graph=unit-progress]',
            title: '',
            units: [
                {% for currentUnit in progress.allUnits %}"{{ currentUnit.unit.getTitle() }}"{% if not loop.last %},{% endif %}{% endfor %}

            ],
            mostAdvancedStudents: [
                {% for currentUnit in progress.allUnits %}{{ currentUnit.mostAdvancedStudent }}{% if not loop.last %},{% endif %}{% endfor %}

            ],
            classCompletions: [
                {% for currentUnit in progress.allUnits %}{{ currentUnit.classCompletions }}{% if not loop.last %},{% endif %}{% endfor %}

            ]
        });

{% if rubrics.allRubrics|length > 0 %}
        /**
         *  Boxplots for Rubrics
         */
        $.fn.boxPlotRender({
            element: '[data-graph=rubrics]',

            /* Title of the graph
             */
            title: '',

            /* Orientation of the box plots
             */
            orientation: 'horizontal',

            /* A list of all the assessment names that are being graphed
             * These correspond to a series of data and their respective
             * five-point summaries
             */
            allAssessments: [
{% for group, currentCriterion in rubrics.allRubrics %}
{% for criterionId,criterionData in currentCriterion %}
"{{ group }}: {{ criterionData.name }}"{% if not loop.last %},
{% endif %}
{% endfor %}{% if not loop.last %},
{% endif %}
{% endfor %}

            ],

            /* All the raw data
             */
            allData: $.fn.boxPlotCalculateAllSeriesData([
{% for group, allCriteria in rubrics.allRubrics %}
{% for currentCriterion in allCriteria %}
[
{# Highcharts won't render without at least one data point #}
{% if currentCriterion.allValues|length == 0 %}
    {
        info: null,
        uid: null,
        value: -100
    }
{% endif %}
{% for currentValue in currentCriterion.allValues %}
    {
        info: "{{ currentValue.user }}",
        uid: '{{ currentValue.user }}',
        value: {% if currentValue.value %}{{ currentValue.value }}{% else %}null{% endif %}

    }{% if not loop.last %},
{% endif %}
{% endfor %}

]{% if not loop.last %},
{% endif %}

{% endfor %}{% if not loop.last %},
{% endif %}
{% endfor %}
            ])
        });
{% endif %}


        /**
         *  Scatter for Effort
         */
        $.fn.scatterRender({
            element: '[data-graph=effort]',

            /* Title of the graph
             */
            title: '',

            allData: [
{% for userId, currentTally in effort.allEffort %}
{
    info: "{{ currentTally.user.getFullname() }}",
    uid: '{{ currentTally.user.getExternalId() }}',
    value: [{{ currentTally.hits }},{{ currentTally.average }}]{% if not loop.last %},
{% endif %}
}{% if not loop.last %},
{% endif %}
{% endfor %}
            ]
        });
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <dl class="sub-nav">
            <dd class="{% if metadata.route == 'course' %}active{% endif %}">
                <a href='/learningAnalytics/course/{{ metadata.folder.course.getId() }}' class="button">
                    Course
                </a>
            </dd>
            {% for folder in metadata.folder.all %}
            <dd class="{% if (folder.getId() == metadata.folder.selected.getId()) and (metadata.route == 'folder') %}active{% endif %}">
                <a href='/learningAnalytics/course/{{ metadata.folder.course.getId() }}/folder/{{ folder.getId() }}' class="button">
                    {{ folder.getName() }} {% if folder.getCodeString() %}({{ folder.getCodeString() }}){% endif %}
                </a>
            </dd>
            {% endfor %}
        </dl>
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <h1>Learning Analytics</h1>
        <ul class="meta">
            <li class="icon-course-builder">{{ metadata.pageTitle }}</li>

            {% if metadata.route == 'folder' %}
            <li class="icon-home">{{ metadata.folder.selected.getName() }} {% if metadata.folder.selected.getCodeString() %}({{ metadata.folder.selected.getCodeString() }}){% endif %}</li>
            {% endif %}
        </ul>
    </div>
</div>

<div class="row">
    <div class="small-12 large-6 island">
        <h2 class="subheader">Overall Progress</h2>

        <section class="content">
            <div data-graph='overall'></div>
        </section>
    </div>
    <div class="small-12 large-3 island">
        <h3 class="subheader">Top Students</h3>

        <section>
            {% if results.ranking.top|length > 0 %}
            <ul class="information-list">
                {% for currentStudent in results.ranking.top|slice(0,3) %}
                <li>
                    <div class="avatar card">
                        <a href="/search/user/{{ currentStudent.user.getId() }}" title="View Profile">
                            <img src="/portrait.php?userId={{ currentStudent.user.getExternalId() }}&size=square64" alt="View Profile" />
                            <p>{{ currentStudent.user.getFullName() }}</p>
                        </a>
                        <p class="meta">{{ currentStudent.average|number_format(1) }}%</p>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p>
                Nobody has attempted these tasks yet.
            </p>
            {% endif %}
        </section>
    </div>
    <div class="small-12 large-3 island">
        <h3 class="subheader">Bottom Students</h3>

        <section>
            {% if results.ranking.bottom|length > 0 %}
            <ul class="information-list">
                {% for currentStudent in results.ranking.bottom|slice(0,3) %}
                <li>
                    <div class="avatar card">
                        <a href="/search/user/{{ currentStudent.user.getId() }}" title="View Profile">
                            <img src="/portrait.php?userId={{ currentStudent.user.getExternalId() }}&size=square64" alt="View Profile" />
                            <p>{{ currentStudent.user.getFullName() }}</p>
                        </a>
                        <p class="meta">{{ currentStudent.average|number_format(1) }}%</p>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p>
                Nobody has attempted these tasks yet.
            </p>
            {% endif %}
        </section>
    </div>
</div>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h2 class="subheader">Results</h2>

            {% if results.tasks.types.selected.getId() > 0 %}
            <ul class="meta">
                <li class="icon-due-work">{{ results.tasks.types.selected.getName() }}</li>
            </ul>
            {% endif %}
        </div>
    </div>
    <nav>
        <a class="icon-more" title="Filter Options" data-dropdown="result-filter-options"></a>
    </nav>
    <ul id="result-filter-options" class="f-dropdown" data-dropdown-content>

        {% if metadata.route == 'course' %}
            <li><a href="/learningAnalytics/course/{{ metadata.folder.course.getId() }}" class="icon-due-work" title="All">All</a></li>
            {% for currentTaskType in results.tasks.types.all %}
            <li><a href="/learningAnalytics/course/{{ metadata.folder.course.getId() }}/task/{{ currentTaskType.getId() }}" class="icon-due-work" title="{{ currentTaskType.getName() }}">{{ currentTaskType.getName() }}</a></li>
            {% endfor %}
        {% elseif metadata.route == 'folder' %}
            <li><a href="/learningAnalytics/course/{{ metadata.folder.course.getId() }}/folder/{{ metadata.folder.selected.getId() }}" class="icon-due-work" title="All">All</a></li>
            {% for currentTaskType in results.tasks.types.all %}
            <li><a href="/learningAnalytics/course/{{ metadata.folder.course.getId() }}/folder/{{ metadata.folder.selected.getId() }}/task/{{ currentTaskType.getId() }}" class='icon-due-work' title="{{ currentTaskType.getName() }}">{{ currentTaskType.getName() }}</a></li>
            {% endfor %}
        {% endif %}
    </ul>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div data-graph="boxplots"></div>
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Unit Progress</h2>
        <section class="content">
            <div data-graph='unit-progress' style="height:{{ ((progress.allUnits|length)*50)+75 }}px"></div>
        </section>
    </div>
</div>

{% if rubrics.allRubrics|length > 0 %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Rubrics</h2>
        <section class="content">
            <div data-graph="rubrics" style="height:{{ ((rubrics.allRubrics|length)*150)+75 }}px"></div>
        </section>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Effort</h2>
        <section class="content">
            <div data-graph="effort"></div>
        </section>
    </div>
</div>