<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/highchartsMore.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/learninganalytics/progress/overall.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/learninganalytics/boxPlot.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/learninganalytics/progress/unit.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/learninganalytics/effort/scatter.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/learninganalytics/schoolboxTheme.js?v={{ config.site_version }}"></script>

{% set routeArgs = {
    courseSpecId:     courseSpec.id,
    folderId:         classFolder.id ?? null,
    submissionTypeId: submissionType.Id ?? null,
    termCode:         term.code
} %}

<script type="text/javascript">
    $(function () {

        /**
         * How much of the course has been completed by all students
         * compared to the person who has completed the most
         */
        $.fn.overallProgressRender({
            element: '[data-graph=overall]',
            title: '',
            mostAdvancedStudent: {{ overallProgress.mostAdvancedStudent }},
            classCompletions: {{ overallProgress.classCompletions }},
            clusterName: '{{ classFolder ? 'Class' : 'Cohort' }}'
        });

        /**
         *  Boxplots for each Assessment in the Unit
         */
        $.fn.boxPlotRender({
            element: '[data-graph=boxplots]',

            /* Title of the graph
             */
            title: '',

            /* Orientation of the box plots
             */
            orientation: 'vertical',

            /* A list of all the assessment names that are being graphed
             * These correspond to a series of data and their respective
             * five-point summaries
             */
            allAssessments: {{ results.assessments | column('title') | json_encode | raw }},

            /* All the raw data
             */
            allData: $.fn.boxPlotCalculateAllSeriesData([
                {% for grades in results.grades -%}
                [
                    {% for userGrade in grades -%}
                    {
                        info: "{{ userGrade.user.fullName }}",
                        uid: '{{ userGrade.user.id }}',
                        value: {{ userGrade.grade }}
                    }{% if not loop.last %}, {% endif -%}
                    {% else %}{# Highcharts won't render without at least one data point -#}
                    {
                        info: null,
                        uid: null,
                        value: -100
                    }
                {% endfor -%}
                ]{% if not loop.last %},
                {% endif -%}
            {% endfor %}
            ])
        });

        /**
         *  Progress for each Unit in the Course
         */
        $.fn.unitProgressRender({
            element: '[data-graph=unit-progress]',
            title: '',
            clusterName: '{{ classFolder ? 'Class' : 'Cohort' }}',
            units: [
                {% for currentUnit in progress.allUnits %}"{{ currentUnit.unit.title }}"{% if not loop.last %},{% endif %}{% endfor %}

            ],
            mostAdvancedStudents: [
                {% for currentUnit in progress.allUnits %}{{ currentUnit.mostAdvancedStudent }}{% if not loop.last %},{% endif %}{% endfor %}

            ],
            classCompletions: [
                {% for currentUnit in progress.allUnits %}{{ currentUnit.classCompletions }}{% if not loop.last %},{% endif %}{% endfor %}

            ]
        });

        /**
         *  Scatter for Effort
         */
        $.fn.scatterRender({
            element: '[data-graph=effort]',

            /* Title of the graph
             */
            title: '',

            allData: [
{% for userId, currentTally in effort.allEffort %}
{
    info: "{{ currentTally.user.fullname }}",
    uid: '{{ currentTally.user.id }}',
    value: [{{ currentTally.hits }},{{ currentTally.average }}]{% if not loop.last %},
{% endif %}
}{% if not loop.last %},
{% endif %}
{% endfor %}
            ]
        });
    });
</script>

{% set trail = [
    [ 'Learning' ],
    [ 'Courses', routeLookup('course.courseList') ],
    [ courseSpec.title, '/homepage/' ~ courseSpec.folder.id ],
    [ 'Analytics', routeLookup(currentRoute | replace({'folder': 'course'}), routeArgs) ],
] %}

{% if classFolder %}
    {% set trail = trail | merge([ [ classFolder.nameWithCodes ] ]) %}
{% endif %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(trail) }}

<div class="row">
    <div class="small-12 columns">
        <h1>Learning Analytics</h1>

        <ul class="meta">
            <li class="icon-course-builder" title="Course"><a href="/homepage/{{ courseSpec.folder.id }}" title="Course Page">{{ courseSpec.title }}</a></li>

            {% if classFolder %}
            <li class="icon-home" title="Class"><a href="/homepage/{{ classFolder.id }}" title="Class Page">{{ classFolder.nameWithCodes }}</a></li>
            {% endif %}
            <li class="icon-staff-students" title="Students">{{ students | length }} students</li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="small-12 large-6 island">
        <div class="context-switch clearfix">
        {% include 'sub/semesterSelector.twig' with {
            currentTerm:        term,
            terms:              terms,
            termsWithResults:   termsWithResults,
            route:              currentRoute,
            routeArgs:          routeArgs
        } only %}
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        {% if classFolders | length %}

            {% if route == 'folder' %}
                <h2 class="subheader">
                    {% set courseRoute = routeLookup(currentRoute | replace({'folder': 'course'}), routeArgs) %}

                    <a href="{{ courseRoute }}">{{ courseSpec.title }}</a> ›

                    {{ classFolder.nameWithCodes }}
                </h2>
            {% else %}
                <dl class="sub-nav">
                    {% for folder in classFolders %}
                        {% set active = classFolder and (folder.id == classFolder.id) and (route == 'folder') %}
                        {% set href   = routeLookup(currentRoute | replace({'course': 'folder'}), routeArgs | merge({ folderId: folder.id })) %}

                        <dd class="{% if active %}active{% endif %}">
                            <a href="{{ href }}" class="button">{{ folder.nameWithCodes }}</a>
                        </dd>
                    {% endfor %}
                </dl>
            {% endif %}
        {% endif %}

    </div>
</div>

{% if 0 == (dueAssessments | length) %}
<div class="row">
    <div class="small-12">
        <div class="empty-state">
            <i class="icon-due-work"></i>
            <p>There are no activities due in this {{ locale.term }}, maybe try selecting a different {{ locale.term }}.</p>
        </div>
    </div>
</div>
{% else %}


<div class="row">
    <div class="small-12 large-6 island">
        <h3 class="subheader">Overall Progress</h3>

        <section class="content">
            <div data-graph='overall'></div>
        </section>
    </div>
    <div class="small-12 large-3 island">
        <h4 class="subheader">Above Standard</h4>
        <section>
            {% include '@learningAnalytics/fragments/ranking.twig' with {
                weightedAssessments: weightedAssessments,
                classFolder: classFolder,
                ranking: ranking.top
            } only %}
        </section>
    </div>
    <div class="small-12 large-3 island">
        <h4 class="subheader">Well Below</h4>
        <section>
            {% include '@learningAnalytics/fragments/ranking.twig' with {
                weightedAssessments: weightedAssessments,
                classFolder: classFolder,
                ranking: ranking.bottom
            } only %}
        </section>
    </div>
</div>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h3 class="subheader">Results</h3>

            {% if submissionType %}
            <ul class="meta">
                <li class="icon-due-work">{{ submissionType.name }}</li>
            </ul>
            {% endif %}
        </div>
    </div>
    <nav>
        <sbx-pop-out content-id="result-filter-options">
            <div slot="icon">
                <svg
                    version="1.2"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 16 16"
                    width="16"
                    height="16"
                    aria-hidden="true"
                    focusable="false"
                    class="c-icon"
                >
                    <path
                        fill-rule="evenodd"
                        d="m16 4c0 1.3-1.3 2.5-3.2 3.2l-2.8 3.9v4.9h-4v-4.9l-2.8-3.9c-1.9-0.7-3.2-1.9-3.2-3.2 0-2.2 3.6-4 8-4 4.4 0 8 1.8 8 4zm-2 0c0-0.5-2.1-2-6-2-3.9 0-6 1.5-6 2 0 0.5 2.1 2 6 2 3.9 0 6-1.5 6-2z"
                    />
                </svg>
            </div>
        </sbx-pop-out>
    </nav>
    <ul id="result-filter-options" class="f-dropdown" data-dropdown-content>
        <li><a href="{{ routeLookup('learningAnalytics.'~route~'WithTerm', routeArgs) }}" title="All">All</a></li>
        {% for submissionType in submissionTypes %}
        <li><a href="{{ routeLookup('learningAnalytics.'~route~'WithSubmissionTypeAndTerm', routeArgs|merge({submissionTypeId: submissionType.id})) }}" title="{{ submissionType.name }}">{{ submissionType.name }}</a></li>
        {% endfor %}
    </ul>
</div>

<div class="row">
    <div class="small-12 island">
        {% if results.assessments | length %}
        <section class="content">
            <div data-graph="boxplots"></div>
        </section>
        {% elseif 0 == (gradableAssessments | length) %}
        <div class="empty-state">
            <i class="icon-due-work"></i>
            <p>There are no gradable activities due in this {{ locale.term }}, maybe try selecting a different {{ locale.term }}.</p>
            <p>If you expected to see activities here, ensure they are not a Task, have a MarkType of 'None' or a weight of 0.</p>
        </div>
        {% else %}
        <div class="empty-state">
            <i class="icon-due-work"></i>
            <p>There are no activity results that match current submission type filter.</p>
            <p><a href="{{ routeLookup('learningAnalytics.'~route~'WithTerm', routeArgs) }}">Remove filter</a></p>
        </div>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ locale.unit.proper }} Progress</h2>
        <section class="content">
            <div data-graph='unit-progress' style="height:{{ ((progress.allUnits | length)*50)+100 }}px"></div>
        </section>
    </div>
</div>

{% if rubrics | length > 0 %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ locale.translate('rubricCriterion', true) }}</h2>
        <section class="content">
            {% include '@learningAnalytics/fragments/rubric_box_plot.twig' with {studentMarksPerCriterion: rubrics, students: students} only %}
        </section>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">
            Effort
            <span class='hint has-tip tip-top' title="The Effort Graph aggregates data across all terms/semesters" data-tooltip>?</span>
        </h2>

        {% if (results.assessments | length) and (weightedAssessments | length) %}
        <section class="content">
            <div data-graph="effort"></div>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-due-work"></i>
            <p>There are no gradable activities due in this {{ locale.term }}, maybe try selecting a different {{ locale.term }}.</p>
            <p>If you expected to see activities here, ensure they are not a Task, have a MarkType of 'None' or a weight of 0.</p>
        </div>
        {% endif %}
    </div>
</div>
{% endif %}
