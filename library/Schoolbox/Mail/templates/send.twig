{% if folder %}
    {% import 'sub/breadcrumbs.twig' as bread %}
    {{ bread.crumbs(
        [ folder.nameWithCodes, '/homepage/' ~ folder.id ],
        [ 'Compose Email', '#' ],
    ) }}
{% elseif student %}
    {% import 'sub/breadcrumbs.twig' as bread %}
    {{ bread.crumbs(
        [ student.fullname ~ ' - ' ~ title, '/search/user/' ~ student.id ],
        [ 'Compose Email', '#' ],
    ) }}
{% endif %}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/clipboard.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/clipboard/jquery.clipboard-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {

        // Disable iFrame embed on mail content
        $.fn.alaressEditor({
            targetElements: $('#body'),
            removePlugins: 'autoembed,uploadimage,schoolboxresource,schoolboxiframe',
            baseHref: "{{ baseHref }}"
        });

        var options = {
            ajax: {
                url:      '/ajax/user.php',
                type:     'GET',
                data:     {groupID: 0, email: 1},
                dataType: 'json'
            },
            multiple: true,
            selectize: {
                plugins: ['remove_button', 'restore_on_backspace'],
                create: function(input) {
                    // Disallow creation of invalid emails
                    if (!validateEmail(input)) {
                        return false;
                    }
                    var freeEntry = {};
                    freeEntry[this.settings.valueField]  = input;
                    freeEntry[this.settings.searchField] = input;
                    return freeEntry;
                },
                render: {
                    item: function (data, escape) {
                        // Render invalid emails with error styling, if they somehow make it past create()
                        var value = data[this.settings.valueField];
                        if (!validateEmail(value)) {
                            return '<div class="item error">' + escape(value) + ' - Invalid email format</div>';
                        }
                        return '<div class="item">' + escape(value) + '</div>';
                    },
                    option_create: function (data, escape) {
                        // Is what I'm trying to enter invalid?
                        // Don't show the create option, so that temptation to enter invalid emails is removed
                        // (You can still select matching users though)
                        if (!validateEmail(data.input)) {
                            return '';
                        }
                        return '<div class="create">Add <strong>' + escape(data.input) + '</strong>&hellip;</div>';
                    }
                }
            }
        }

        function validateEmail(email) {
            // Source: https://www.w3.org/TR/2012/WD-html-markup-20120329/input.email.html
            // Replaced ’ character with ' as ’ is not even a valid email character for input type email.
            // Seems like it's a typo from the source.
            var validEmailFilter = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$/;
            var emailIsInBetweenRegex = /\<([^)]+)\>/; // Is email string in between <>? E.g <alaress@alaress.com.au>

            if (emailIsInBetweenRegex.test(email)) {
                var matches = emailIsInBetweenRegex.exec(email);
                email = matches[1];
            }

            if (validEmailFilter.test(email)) {
                return true;
            }

            return false;
        }

        $('#to').selectizeSelector($.extend({}, options, {value: {{ replyTo | raw }}}))
        $('#cc').selectizeSelector($.extend({}, options, {value: {{ cc | raw }}}))
        $('#bcc').selectizeSelector($.extend({}, options, {value: {{ bcc | raw }}}))

        // dialogs for copying email fields
        $('[data-role="copy-emails"]').each(function(index, element) {
            $.fn.clipboardSelector({
                exportActivator: $(element),
                onReady: function() {

                    // get html-escaped version of text, really annoying
                    var target    = $('#'+$(element).attr('data-copy-emails-for')),
                            text      = $('<div />').text(target.val()).html(),
                            dialog    = $('#email-modal'),
                            dialogUrl = $('#copy-email-text');

                    dialogUrl.html(text);
                    dialog.foundation('reveal', 'open');
                }
            });
        });

        $.validator.addMethod('mailHasRecipient', function(value, element) {
            if ($("#to").val() || $("#cc").val() || $("#bcc").val()) {
                return true;
            }
            return false;
        }, 'A valid recipient must be provided')

        $('#mailForm').alaressValidate({
            ignore: ':hidden:not([class~=selectized]),:hidden > .selectized, .selectize-control .selectize-input input',
            rules: {
                to: {
                    mailHasRecipient: true
                }
            },
            submitHandler: function(mailForm) {
                if (!CKEDITOR.instances['body'].getData().length) {
                    $(this).confirmDialog({
                        text: 'Message body is empty. Are you sure you want to send this message?',
                        confirmEvent: function() {
                            submitForm(mailForm);
                        }
                    });
                } else {
                    submitForm(mailForm);
                }

                /**
                 * Submit the form, disabling the submit button while it's working
                 * @param form
                 */
                function submitForm(form) {
                    var $submitButton = $('#mailSubmit');
                    $submitButton.prop('disabled', true).val($submitButton.attr('data-working'));
                    form.submit();
                }
            }
        });

        $('input[type=radio][name=separator]').change(function() {

            var text = $('#copy-email-text').text();
            var replaceText = '';

            if (this.value == 'comma') {
                replaceText = text.replace(/\;/g, ',');
            }
            else if (this.value == 'colon') {
                replaceText = text.replace(/\,/g, ';');
            }

            $('#copy-email-text').text(replaceText);

        });

    });
</script>
<!-- END custom_head -->

<div class="row">
    <div class="small-12 island">
        <h1>Compose Email</h1>
        {% if invalidEmails is not empty %}
        <div data-alert class="alert-box alert">
            <p>The following email addresses are invalid and could not be added.</p>
            <a href="#" class="close">&times;</a>
            <ul>
                <li>
                    {% for invalidEmail in invalidEmails %}
                        {{ invalidEmail }}
                    {% endfor %}
                </li>
            </ul>
        </div>
        {% endif %}
        <form action="{{ routeLookupIfAuthorized('mail.send') }}" method="post" enctype="multipart/form-data" id="mailForm">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="to" class="required">To</label>
                        <div class="input-group">
                            <input name="to" id="to"/>
                            <a data-role="copy-emails" data-copy-emails-for="to" class="button icon-copy" title="Show addresses to copy">Copy</a>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="cc">CC</label>
                        <div class="input-group">
                            <input name="cc" id="cc" />
                            <a data-role="copy-emails" data-copy-emails-for="cc" class="button icon-copy" title="Show addresses to copy">Copy</a>
                        </div>
                    </div>
                    <div class="small-12 columns">
                        <label for="bcc">BCC</label>
                        <div class="input-group">
                            <input name="bcc" id="bcc" />
                            <a data-role="copy-emails" data-copy-emails-for="bcc" class="button icon-copy" title="Show addresses to copy">Copy</a>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="subject" class="required">Subject</label>
                        <input type="text" name="subject" id="subject" value="{{ subject }}" required />
                        <label>
                            <textarea name="message" id="body">{{ body }}</textarea>
                        </label>
                        <label>
                            Attachments
                        </label>
                        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                    </div>
                </fieldset>
            </section>
            <input type="submit" id="mailSubmit" value="Send" data-working="Sending..." />
        </form>
    </div>
</div>

<div id="email-modal" class="reveal-modal" data-reveal aria-labelledby="modalTitle" aria-hidden="true" role="dialog">
    <p>Use this to copy the addresses to your clipboard for use in other email programs.</p>
    <textarea readonly id="copy-email-text" rows="6"></textarea>
    <fieldset class="radiolist">
        <ul class="option-list">
            <li><input type="radio" name="separator" value="comma" id="commaSep" checked><label for="commaSep" >Comma Separated</label></li>
            <li><input type="radio" name="separator" value="colon" id="colonSep"><label for="colonSep" >Semi-Colon Separated</label></li>
        </ul>
    </fieldset>
    <div class="component-action">
        <section>
            <button id="copy-button" data-clipboard-target="#copy-email-text">Copy to Clipboard</button>
        </section>
    </div>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

