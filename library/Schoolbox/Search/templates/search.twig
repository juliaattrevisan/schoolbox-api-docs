{#
Expected data items:
 - filterTypes: An array of filter types, including sub types if available
 - filterDateRange: An object containing the Start and End dates
 #}

<div id="search-page-container">
    <search-page
        endpoint="/api/search"
        :filter-types="{{ filterTypes|json_encode }}"
        :filter-date-range="{{ filterDateRange }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/searchPage.js?v={{ config.site_version }}"></script>
<script>
// to use the new spacing styles
document.getElementById("container").classList.add("c-container");
</script>
