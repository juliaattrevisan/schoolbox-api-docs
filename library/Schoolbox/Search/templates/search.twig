{#
Expected data items:
 - filterTypes: List of filter types (used for building the empty form).
 - keywordValue: For populating the form.
 - filterDateRangeValues: An object containing 'startDate' and 'endDate' for populating the form.
 - filterCreatorValue: An object containing 'id' and 'name' for populating the form.
 - filterTypesValues: An array of filter type strings for populating the form.
 - resultPageSize: The maximum number of search results per page.
 #}

resultPageSize: {{ resultPageSize }}
<div id="search-page-container" class="f-container">
    <search-page
        endpoint="/api/search"
        :filter-types-available="{{ filterTypes|json_encode }}"
        :filter-types-selected="{{ filterTypesValues|json_encode }}"
        :filter-date-range="{{ filterDateRangeValues|json_encode }}"
        :filter-creator="{{ filterCreatorValue|json_encode }}"
        :result-page-size="{{ resultPageSize }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/searchPage.js?v={{ config.site_version }}"></script>
