{# Profile Editor: Buttons
 # Note that these are configured in the Profile Buttons part of admin, separate to the Profile Editor
 #}
<ul class='flex-list flex-wrap buttons'>
    {# Special constraints that further reduce the payload I built
     # It uses the exact same philosophy as additionalConstraints for
     # rendering profile fields.
     #}
    {% set additionalConstraints = {
        'student': {
            '_default': true,
            'duework': config.lms_enabled,
            'eportfolio': eportfolioAuth,
            'grades': config.lms_enabled,
            'timetable': config.lms_enabled and user.isShowTimetable,
        },
        'parent': {
            '_default': true,
            'duework': config.lms_enabled,
            'eportfolio': eportfolioAuth,
            'grades': config.lms_enabled,
            'timetable': config.lms_enabled and user.isShowTimetable,
        },
        'staff': {
            '_default': USER.role.viewStudentProfile,
            'duework': USER.role.viewStudentProfile and config.lms_enabled,
            'eportfolio': USER.role.viewStudentProfile and eportfolioAuth,
            'grades': config.lms_enabled,
            'pastoral': USER.role.viewStudentProfile and pastoralUrl,
            'timetable': USER.role.viewStudentProfile and config.lms_enabled and user.isShowTimetable,
            'documentmanagement': USER.role.viewStudentProfile and config.external_document_report_enabled,
            'geosnapshot': USER.role.viewStudentProfile and isGeosnapshotAvailable,
            'emailstaff': USER.role.viewStudentProfile and config.mail_enable and session.user.email,
            'emailparents': USER.role.viewStudentProfile and config.mail_enable and session.user.email and user.isShowContacts
        }
    } %}

    {% for button in buttons %}
        {% if additionalConstraints[USER.role.type][button.type] ?? additionalConstraints[USER.role.type]['_default']  %}
            {% set text = button.text %}

            {# Special cases: Email Teachers and Email Parents
             # These submit a hidden form lol
             #}
            {% if button.type in ['emailstaff'] %}
                <li>
                    <a class="icon-email" id="email-all-staff" title="Includes all teachers, year coordinator, head of house, tutor and coach.">{{ text }}</a>
                    <form id="email-all-form" action="{{ routeLookupIfAuthorized('mail.postCreateMail') }}" class="hide" method="post">
                        <input name="userIds" value="{{ allTeacherIds }}" type="hidden">
                        <input name="target" value="cc" type="hidden">
                        <input name="title" value="Email All Teachers" type="hidden">
                        <input name="studentId" value="{{ user.id }}" type="hidden">
                    </form>
                </li>
            {% elseif button.type in ['emailparents'] %}
                <li>
                    <a class="icon-email" id="email-all-parents" title="Emails the parents that have email addresses and can be contacted">{{ text }}</a>
                    <form action="{{ routeLookupIfAuthorized('mail.postCreateMail') }}" method="post" class="no-margin" id="email-contacts-form">
                        <input type="hidden" name="studentExternalIds" value="{{ user.externalId }}"/>
                        <input type="hidden" name="selectedGroups" value="parents_of"/>
                        <input name="studentId" value="{{ user.id }}" type="hidden">
                        <input name="title" value="Email Parents" type="hidden">
                    </form>
                </li>
            {% else  %}
                {# A standard button whose urls need to be dynamically determined #}
                {% set route = button.url %}

                {# Unique derivations #}
                {% if button.type in ['duework'] %}
                    {% set route = routeLookupIfAuthorized('learningUpcoming.getUpcomingForStudent', {student: user, studentId: user.id}) %}
                {% elseif button.type in ['grades'] %}
                    {% set route = routeLookupIfAuthorized('learningGrades.getGrades', {viewee: user, userId: user.id}) %}
                {% elseif button.type in ['pastoral'] %}
                    {% set route = pastoralUrl %}
                {% elseif button.type in ['calendar'] %}
                    {% set route = routeLookupIfAuthorized('calendar.getCalendar', {selectedDate: now.urlDate, userId: user.id, user: user}) %}
                {% elseif button.type in ['documentmanagement'] %}
                    {% set route = routeLookupIfAuthorized('profileDocumentManagement.getIndex', {studentId: user.id}) %}
                {% elseif button.type in ['geosnapshot'] %}
                    {% set route = routeLookupIfAuthorized('geosnapshotApi.getStudentPhotos', {id: user.id}) %}
                {% endif %}

                {% if route %}
                    <li>
                        <a href="{{ route }}" title="{{ button.title }}" class="icon-{{ button.icon }} {{ button.css }}" target="{{ button.target }}">{{ text }}</a>
                    </li>
                {% endif %}
            {% endif %}
        {% endif %}
    {% endfor %}

    {% block buttons_miscellaneous %}
    {% endblock buttons_miscellaneous %}
</ul>
