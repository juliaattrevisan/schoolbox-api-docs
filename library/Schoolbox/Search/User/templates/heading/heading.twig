{##
 # Displays the heading for a user's profile page,
 # Showing the users's name and further button controls depending on the user's permissions
 #
 # @param \Schoobox\User user   The user being viewed
 # @param bool isSuperuser      Whether the current user is a super user
 # @param bool canImpersonate   Whether the current user can impersonate the user being viewed
 # @param string nameFormat       The format to display the user's name in
 #}

{% macro myProfileHeading(user, nameFormat) %}
    {% block profileHeading %}
        <h1 data-test="user-profile-name">{{ user.formatName(nameFormat) }}</h1>
    {% endblock %}
{% endmacro %}

{% if linksInfo|length > 1 %}
    <div class="actions-small-1 row">
        <div class="list-item">
            <div class="small-12 column">
                {{ _self.myProfileHeading(user, nameFormat) }}
            </div>
        </div>
        <nav>
            <sbx-pop-out content-id="header-options"></sbx-pop-out>
        </nav>
        <ul class="f-dropdown" id="header-options" data-test="profile-header-options" data-dropdown-content>
            {% for linkInfo in linksInfo %}
                {% set iconName = linkInfo.iconClass|replace({'icon-': ''}) %}
                <li>
                    {% if linkInfo.disabled %}
                        <a
                            class="sbx-button--has-icon menu_disabled"
                            title="{{ linkInfo.mouseoverText }}"
                            data-test="user-profile-impersonate-disabled"
                        ><sbx-icon name="{{ iconName }}"></sbx-icon>{{ linkInfo.title }}</a>
                    {% else %}
                        <a
                            href="{{ linkInfo.url }}"
                            class="sbx-button--has-icon"
                            title="{{ linkInfo.mouseoverText }}"
                            data-test="{{ linkInfo.dataTest }}"
                        ><sbx-icon name="{{ iconName }}"></sbx-icon>{{ linkInfo.title }}</a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
{% elseif linksInfo|length == 1 %}
    <div class="row">
        <div class="button-action small-12 columns">
            {{ _self.myProfileHeading(user, nameFormat) }}
            {% set linkInfo = linksInfo|first %}
            {% set iconName = linkInfo.iconClass|replace({'icon-': ''}) %}
            {% if linkInfo.disabled %}
                <a
                    class="sbx-button--has-icon button menu_disabled"
                    title="Account disabled"
                ><sbx-icon name="{{ iconName }}"></sbx-icon>{{ linkInfo.title }}</a>
            {% else %}
                <a
                    href="{{ linkInfo.url }}"
                    class="sbx-button--has-icon button"
                    title="{{ linkInfo.mouseoverText }}"
                ><sbx-icon name="{{ iconName }}"></sbx-icon>{{ linkInfo.title }}</a>
            {% endif %}
        </div>
    </div>
{% else %}
    <div class="row">
        <div class="column small-12">
            {{ _self.myProfileHeading(user, nameFormat) }}
        </div>
    </div>
{% endif %}
