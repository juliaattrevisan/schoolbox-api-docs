{##
 # Use localisation variant from Terminology, if it exists;
 # otherwise use default Display As that I provided by default
 #
 # @param array $selectedField  A (displayAs, terminology) tuple
 #}
{% macro fieldName(selectedField) %}
{% apply spaceless %}
    {% set fieldName = selectedField.displayAs %}

    {% if selectedField.terminology %}
        {% set fieldName = locale.translate(selectedField.terminology, false, true) %}
    {% endif %}

    {{ fieldName }}
{% endapply %}
{% endmacro %}


{##
 # Renders a mailto: hyperlink
 #
 # @param array $session  A $_SESSION superglobal, sadly
 # @param string $email  An email address
 #}
{% macro email(session, email) %}
{% apply spaceless %}
<a href="{{ session.mailhandle }}{{ email }}">{{ email }}</a>
{% endapply %}
{% endmacro %}
