{##
 # Use localisation variant from Terminology, if it exists;
 # otherwise use default Display As that I provided by default
 #
 # @param array $selectedField  A (displayAs, terminology) tuple
 #}
{% macro fieldName(selectedField) %}
{% apply spaceless %}
    {% set fieldName = selectedField.displayAs %}

    {% if selectedField.terminology %}
        {% set fieldName = locale.translate(selectedField.terminology, false, true) %}
    {% endif %}

    {{ fieldName }}
{% endapply %}
{% endmacro %}


{##
 # Renders a mailto: hyperlink
 #
 # @param array $session  A $_SESSION superglobal, sadly
 # @param string $email  An email address
 #}
{% macro email(session, email, text) %}
{% apply spaceless %}
<a href="{{ session.mailhandle }}{{ email }}">{{ text }}</a>
{% endapply %}
{% endmacro %}


{##
 # Renders a portrait or grey man, based on your availability + visibility combination
 # If the portrait was made available and visible to you, it would normally appear
 # as element 0 in this selected list, but you have to check anyway to be sure
 #}
{% macro portrait(user, externalUser, additionalConstraints) %}
    {% set foundPortrait = false %}

    {% for selectedField in externalUser.data.roleTypes.fields.selected|filter(selectedField => selectedField.field == 'portrait') %}
        {# If this field doesn't have a special boolean associated with it that might make it visible,
         # use the prescribed default bool
         #}
        {% if (additionalConstraints[USER.role.type][selectedField.field] ?? additionalConstraints[USER.role.type]['_default']) %}
            {% set foundPortrait = true %}

            {# Portrait was available and visible to you,
             # and you pass the additionalConstraints listed above
             # Ask php to give you an image (it might not...)
             #}
            {% include 'include/portrait.twig' with {
                user: user,
                render: 'profile',
                class: 'full-width',
                description: ''
            } only %}
        {% endif %}
    {% endfor %}

    {# No image? Grey man
     # We can kind of force this with a null user...wow
     #}
    {% if not foundPortrait %}
        {% include 'include/portrait.twig' with {
            user: null,
            render: 'profile',
            class: 'full-width',
            description: ''
        } only %}
    {% endif %}
{% endmacro %}
