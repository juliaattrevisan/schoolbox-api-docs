{##
 # Renders the differentiation profile field for a student on the profile page
 #
 # @param array selectedField - The selected field data
 # @param array differentiationProfile - The differentiation profile data containing the student and route to the students DP
 #}

<div id="view-differentiation-profile-container">
    <view-differentiation-profile
        :student="{{ differentiationProfile.student|json_encode }}"
        :dp-route="{{ differentiationProfile._routes.viewDp|json_encode }}"
        :customisations-route="{{ differentiationProfile._routes.viewCustomisations|json_encode }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/viewDifferentiationProfile.js?v={{ config.site_version }}"></script>
