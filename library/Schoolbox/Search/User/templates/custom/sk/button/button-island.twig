{% extends '@searchUser:core/button/button-island.twig' %}
{% block custom_buttons %}
    <li>
        <a href="{{ routeLookup('customStkOleReport.reportList', {studentId: user.id}) }}" class="sbx-button--has-icon"><sbx-icon name="document"></sbx-icon>Reports</a>
    </li>

    {# Obey access rules for non-ib students #}
    {% set nceaRoute = routeLookupIfAuthorized('nceaReport.getReport', {userId: user.id, year: 'now'|date('Y'), user: user}) %}

    {% if nceaRoute %}
        <li>
            <a href="{{ nceaRoute }}" class="sbx-button--has-icon"><sbx-icon name="progress"></sbx-icon>NCEA Progress</a>
        </li>
    {% endif %}
{% endblock custom_buttons %}
