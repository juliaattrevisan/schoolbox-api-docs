<p>Pick and choose which units and content you wish to import.</p>

<ul class="information-list card-selectable threaded expandable-card" id="unit-list">
    {% for unit in curriculum.units %}
        {% set assessmentCount = unit.assessments|length %}
        {% set attachmentCount = unit.attachments|length %}
        {% set hasContent      = assessmentCount > 0 or attachmentCount > 0 %}
        <li>
            <div>
                {% if hasContent %}
                    <div class="expander icon-down-arrow" data-collapser="unit-{{ unit.id }}"></div>
                {% else %}
                    <div class="expander disabled"></div>
                {% endif %}
                <div class="selector">
                    <input id="unit-{{ unit.id }}"
                           name="unit[{{ unit.id }}]"
                           value="1"
                           type="checkbox"
                           {% if hasContent %}checked{% endif %}
                    >
                    <label for="unit-{{ unit.id }}" class="checkbox-label"></label>
                </div>
                <div class="small-12 card">
                    <a href="#">
                        <h3>{{ unit.title }}</h3>
                        <p class="meta">{{ unit.timeFrame }}</p>
                        {% if assessmentCount > 0 %}
                        <p class="meta">
                            {{ assessmentCount }} {% if assessmentCount == 1 %}assessment{% else %}assessments{% endif %},
                            <span data-checkbox-group-count="unit-{{ unit.id }}-assessments"
                                  data-show-count="{{ assessmentCount }}"> selected</span>
                        </p>
                        {% endif %}
                        {% if attachmentCount > 0 %}
                        <p class="meta">
                            {{ attachmentCount }} {% if attachmentCount == 1 %}attachment{% else %}attachments{% endif %},
                            <span data-checkbox-group-count="unit-{{ unit.id }}-attachments"
                                  data-show-count="{{ attachmentCount }}"> selected</span>
                        </p>
                        {% endif %}
                    </a>
                </div>
            </div>
        </li>
        {% if assessmentCount %}
            <li class="child hide" data-collapse-state="collapsed" data-collapsable="unit-{{ unit.id }}">
                <div class="small-12 card">
                    <h3>Assessments</h3>
                </div>
                <ul class="information-list card-selectable">
                    {% for assessment in unit.assessments %}
                        <li>
                            <div>
                                <div class="selector">
                                    <input id="assessment-{{ assessment.id }}"
                                           name="assessment[{{ assessment.id }}]"
                                           value="1"
                                           type="checkbox"
                                           checked
                                           data-checkbox-group="unit-{{ unit.id }}-assessments"
                                    >
                                    <label for="assessment-{{ assessment.id }}" class="checkbox-label"></label>
                                </div>
                                <div class="small-12 card">
                                    <a href="#">
                                        <h3>{{ assessment.title }}</h3>
                                        {% if assessment.type %}<p class="meta">Type: {{ assessment.type }}</p>{% endif %}
                                        {% if assessment.method %}<p class="meta">Method: {{ assessment.method }}</p>{% endif %}
                                    </a>
                                    {% if assessment.standards|length %}
                                        <article>
                                            <h4>Standards</h4>
                                            <dl>
                                                {% for standard in assessment.standards %}
                                                    {% if standard.code %}<dt>({{ standard.code }})</dt>{% endif %}
                                                    <dd>{{ standard.title }}</dd>
                                                {% endfor %}
                                            </dl>
                                        </article>
                                    {% endif %}
                                    {% if assessment.content %}
                                        <article>{{ assessment.content | purify }}</article>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </li>
        {% endif %}

        {% if attachmentCount %}
            <li class="child hide" data-collapsable="unit-{{ unit.id }}">
                <div class="small-12 card">
                    <h3>Attachments</h3>
                </div>
                <ul class="information-list card-selectable">
                    {% for attachment in unit.attachments %}
                        <li>
                            <div>
                                <div class="selector">
                                    <input id="attachment-{{ attachment.id }}"
                                           name="attachment[{{ attachment.id }}]"
                                           value="1"
                                           type="checkbox"
                                           checked
                                           data-checkbox-group="unit-{{ unit.id }}-attachments"
                                    >
                                    <label for="attachment-{{ attachment.id }}" class="checkbox-label"></label>
                                </div>
                                <div class="small-12 card">
                                    <a href="#">
                                        <h3>{{ attachment.title }}</h3>
                                    </a>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </li>
        {% endif %}
    {% endfor %}
</ul>
