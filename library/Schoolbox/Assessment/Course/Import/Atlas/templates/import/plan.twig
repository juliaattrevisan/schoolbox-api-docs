<p>Pick and choose which units and content you wish to import.</p>

<ul class="information-list card-selectable" id="assessment-list">
    {% for unit in curriculum.units %}
        <li>
            <div>
                <div class="selector">
                    <input id="unit-{{ unit.id }}" name="unit[{{ unit.id }}]" value="1" type="checkbox">
                    <label for="unit-{{ unit.id }}" class="checkbox-label"></label>
                </div>
                <div class="small-12 card">
                    <a href="#">
                        <h3>{{ unit.title }}</h3>
                        <p class="meta">{{ unit.time_frame }}</p>
                    </a>
                </div>
            </div>
        </li>
    {% endfor %}
</ul>
