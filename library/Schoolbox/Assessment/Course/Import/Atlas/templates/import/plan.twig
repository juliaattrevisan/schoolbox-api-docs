<p>Pick and choose which units and content you wish to import.</p>

{{ generateHiddenInputs(previousPost) }}

<ul class="information-list card-selectable threaded expandable-card" id="unit-list">
    {% for unit in curriculum.units %}
        {% set assessmentCount = unit.assessments|length %}
        {% set attachmentCount = enableAttachmentImport ? unit.attachments|length : 0 %}
        {% set hasContent      = assessmentCount > 0 or attachmentCount > 0 %}
        <li class="actions-small-1">
            <div class="list-item no-pad {% if not hasContent %}unit-empty{% endif %}">
                <div class="expander" data-collapser="unit-{{ unit.id }}"></div>

                <div class="small-6 card">
                    <div class="selector">
                        <input id="unit-{{ unit.id }}"
                               name="unit[{{ unit.id }}][selected]"
                               value="1"
                               type="checkbox"
                               {% if hasContent %}checked{% endif %}
                               data-unit="{{ unit.id }}"
                        >
                        <label for="unit-{{ unit.id }}" class="checkbox-label">
                            <span class="title">{{ unit.title }}</span>
                        </label>
                    </div>
                </div>
                {# [data-show-count] gets its value from a css :before in www/static/css/core/ui/_content.scss #}
                <div class="small-6 card meta">
                    <p class="meta">{{ unit.timeFrame }}</p>
                    {% if assessmentCount > 0 %}
                        <p class="meta" data-unit-meta="{{ unit.id }}">
                            {{ assessmentCount }} {% if assessmentCount == 1 %}assessment{% else %}assessments{% endif %}
                            <span data-checkbox-group-count="unit-{{ unit.id }}-assessments"
                                  data-show-count="- {{ assessmentCount }}"> selected</span>
                        </p>
                    {% endif %}
                    {% if attachmentCount > 0 %}
                        <p class="meta" data-unit-meta="{{ unit.id }}">
                            {{ attachmentCount }} {% if attachmentCount == 1 %}attachment{% else %}attachments{% endif %}
                            <span data-checkbox-group-count="unit-{{ unit.id }}-attachments"
                                  data-show-count="- {{ attachmentCount }}"> selected</span>
                        </p>
                    {% endif %}
                    {% if not hasContent %}
                        <p class="meta" data-unit-meta="{{ unit.id }}">
                            {% if enableAttachmentImport %}
                                No assessments or attachments
                            {% else %}
                                No assessments
                            {% endif %}
                        </p>
                    {% endif %}
                </div>
            </div>

            {# TODO: add a link to this unit in Atlas #}
        </li>

        {% if not hasContent %}
            <li class="child hide" data-collapse-state="collapsed" data-collapsable="unit-{{ unit.id }}">
                <div class="empty-state">
                    <p>
                        {% if enableAttachmentImport %}
                            This unit has no assessments or attachments.
                        {% else %}
                            This unit has no assessments.
                        {% endif %}
                    </p>
                </div>
            </li>
        {% endif %}

        {% if assessmentCount %}
            <li class="child hide assessments" data-collapse-state="collapsed" data-collapsable="unit-{{ unit.id }}">
                <div class="small-12 card">
                    <i class="icon-due-work"></i><h3>Assessments</h3>
                </div>
                <ul class="information-list card-selectable">
                    {% for assessment in unit.assessments %}
                        <li class="actions-small-1">
                            <div class="list-item no-pad">

                                <div class="small-6 card">
                                    <div class="selector">
                                        <input id="assessment-{{ assessment.id }}"
                                               name="unit[{{ unit.id }}][assessment][{{ assessment.id }}][selected]"
                                               value="1"
                                               type="checkbox"
                                               checked
                                               data-checkbox-group="unit-{{ unit.id }}-assessments"
                                               data-enables="assessment-{{ assessment.id }}-title"
                                        >
                                        <label for="assessment-{{ assessment.id }}" class="checkbox-label"></label>
                                        <input id="assessment-{{ assessment.id }}-title"
                                               type="text"
                                               name="unit[{{ unit.id }}][assessment][{{ assessment.id }}][title]"
                                               value="{{ assessment.title }}"
                                               placeholder="Assessment Title"
                                               class="assessment-title-input"
                                               maxlength="255"
                                               required
                                               data-msg="An assessment must have a title if it is selected"
                                        />
                                    </div>
                                </div>

                                <div class="small-6 card meta">
                                    {% if assessment.type %}<p class="meta">Type: {{ assessment.type }}</p>{% endif %}
                                    {% if assessment.method %}<p class="meta">Method: {{ assessment.method }}</p>{% endif %}
                                    {% if assessment.content %}
                                        <article>{{ assessment.content | purify }}</article>
                                    {% endif %}
                                </div>

                            </div>

                            {# TODO: add a link to this assessment in Atlas #}
                        </li>
                    {% endfor %}
                </ul>
            </li>
        {% endif %}

        {% if attachmentCount %}
            <li class="child hide attachments" data-collapse-state="collapsed" data-collapsable="unit-{{ unit.id }}">
                <div class="small-12 card">
                    <i class="icon-attach"></i><h3>Attachments</h3>
                </div>
                <ul class="information-list card-selectable">
                    {% for attachment in unit.attachments %}
                        {% set enabled = attachmentDefaults[attachment.id].enabled %}
                        {% set private = attachmentDefaults[attachment.id].private %}
                        <li class="actions-small-1">
                            <div class="list-item no-pad">

                                <div class="small-6 card">
                                    <div class="selector">
                                        <input id="attachment-{{ attachment.id }}"
                                               name="unit[{{ unit.id }}][attachment][{{ attachment.id }}][selected]"
                                               value="1"
                                               type="checkbox"
                                               {% if enabled is null %}disabled{% endif %}
                                               {% if enabled %}checked{% endif %}
                                               data-checkbox-group="unit-{{ unit.id }}-attachments"
                                               data-enables="attachment-{{ attachment.id }}-title"
                                        >
                                        <label for="attachment-{{ attachment.id }}" class="checkbox-label"></label>
                                        <input id="attachment-{{ attachment.id }}-title"
                                               type="text"
                                               name="unit[{{ unit.id }}][attachment][{{ attachment.id }}][title]"
                                               value="{{ attachment.title }}"
                                               placeholder="Attachment Title"
                                               class="attachment-title-input"
                                               maxlength="255"
                                               required
                                               data-msg="An attachment must have a title if it is selected"
                                        />
                                    </div>

                                </div>

                                <div class="small-6 card meta">
                                    {% if enabled is null %}
                                        This content is not able to be imported.
                                    {% elseif private is not null %}
                                        <div class="switch">
                                            <input id="attachment-{{ attachment.id }}-visible-to-students"
                                                   name="unit[{{ unit.id }}][attachment][{{ attachment.id }}][visibleToStudents]"
                                                   type="checkbox"
                                                   data-checkbox-group="unit-{{ unit.id }}-attachments"
                                                   {% if not private %}checked{% endif %}
                                                   class="round-switch"
                                            >
                                            <label for="attachment-{{ attachment.id }}-visible-to-students">
                                                <span class="icon-approve"></span>
                                                <span class="icon-cancel"></span>
                                            </label>
                                        </div>
                                        <label for="attachment-{{ attachment.id }}-visible-to-students" class="checkbox-label">
                                            Visible to students?
                                        </label>
                                    {% else %}
                                        This content will always be visible to students if imported.
                                    {% endif %}
                                </div>

                            </div>
                            <nav>
                                <a href="{{ attachment.url }}"
                                   class="icon-download no-text"
                                   target="_blank"
                                   title="Preview"></a>
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            </li>
        {% endif %}
    {% endfor %}
</ul>
