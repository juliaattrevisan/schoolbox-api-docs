{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Courses', routeLookup('course.courseList') ],
    [ 'Import From Atlas', '#']
) }}

<div class="row">
    <div class="small-12 island">
        <h1>Import From Atlas</h1>
    </div>
    <div class="small-12 island">
        <ul class="train-line">
            <li data-mage-trainstop="part-1" class="current-stop">
                <a>
                    <span class="icon-curriculum"></span>Select a Curriculum Plan
                </a>
            </li>
            <li data-mage-trainstop="part-2">
                <a>
                    <span class="icon-unit"></span>Select Units and Content
                </a>
            </li>
        </ul>

        <form action="{{ routeLookup('courseImportAtlas.postImport') }}?{{ returnUrl.key|e('url') }}={{ returnUrl.value.encoded|e('url') }}" method="post" class="mage" data-mage-preventsubmit="true">
            <section>
                <fieldset data-mage="part-1" class="content">
                    <legend>Select a Curriculum Plan</legend>
                    <div data-mage-collapsefinal>
                        <div class="small-12 medium-6 column atlas-labels">
                            <label>School
                                <select id="curriculum-school">
                                    <option value="">(all schools)</option>
                                </select>
                            </label>
                            <label>Grade
                                <select id="curriculum-grade">
                                    <option value="">(all grades)</option>
                                </select>
                            </label>
                            <label>Subject
                                <select id="curriculum-subject">
                                    <option value="">(all subjects)</option>
                                </select>
                            </label>
                            {% include '@course/sub/sourceSelector.twig' with {
                                courseSpec: null,
                            } only %}

                            {% if not isValidFacultyRoot %}
                                <div class="small-12 column">
                                    {% include '@course/sub/invalidFacultyRoot.twig' %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="small-12 medium-6 column">
                            <label>Curriculum Plans</label>
                            <div class="loader"></div>
                            <ul class="information-list card-selectable" id="curriculum-plan-list">
                                <li id="curriculum-plan-template" class="hide" data-template="curriculum-plan">
                                    <div class="small-12 card">
                                        <div class="selector no-pad">
                                            <input data-template="curriculum-plan-input" id="curriculum-plan" name="curriculum-plan" type="radio">
                                            <label data-template="curriculum-plan-label" for="curriculum-plan" class="radio-label">
                                                <span class="title"></span>
                                            </label>

                                            {# Clicking this shows curriculum information? #}
                                            <p class="meta">
                                                <span data-template="curriculum-plan-school"></span>;
                                                <span data-template="curriculum-plan-grade"></span>,
                                                <span data-template="curriculum-plan-subject"></span>
                                            </p>
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </div>

                    </div>
                    <div data-mage-submitrow>
                        <div class="small-12 medium-8 column">
                            <p class="alert alert-box icon-alert" data-mage-error></p>
                        </div>
                        <div class="small-12 medium-4 column">
                            <input type="submit" name="part-1" value="Use this plan" data-mage-next="part-2" data-mage-working="Loading Units and Content..." />
                        </div>
                    </div>
                </fieldset>
                <fieldset data-mage="part-2" class="content" disabled="disabled">
                    <legend>Select Units and Content</legend>
                    <div class="small-12 column hide" data-mage-collapsed>
                        <div data-mage-collapsefinal id="curriculum-plan-units">
                        </div>
                        <div class="row" data-mage-submitrow>
                            <div class="small-12 medium-8 column">
                                <p class="alert alert-box icon-alert" data-mage-error></p>
                            </div>
                            <div class="small-12 medium-4 column">
                                <input type="submit" name="part-2" value="Import these units" data-mage-next="none" data-mage-working="Importing...." />
                            </div>
                        </div>
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>

<script type="text/javascript" src="/javascript/shared/jquery.mage.js"></script>
{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        // the mage plugin is applied to the submit buttons: setup a basic mage on all the buttons
        $('input[data-mage-next]').mage({
            confirmRevert: function (e, revert) {
                // verify that we aren't trying to go FORWARD
                if (this.nextAll('.current-stop').length > 0) {
                    $('fieldset[data-mage]').find('[data-mage-collapsefinal]').slideDown();
                    revert();
                }
            },
            onXhrDone: function (data) {
                var units = $('#curriculum-plan-units').html(data);

                // Apply collapser
                units.find('[data-collapser]').collapsable();

                units.find('[data-checkbox-group]').on('change', function () {
                    var $this    = $(this),
                        group    = $this.data('checkboxGroup'),
                        $selected = units.find('[data-checkbox-group="'+group+'"]:checked:not(:disabled)'),
                        $counter  = units.find('[data-checkbox-group-count="'+group+'"]');

                    // Update selected counts when an assess/attach is selected/unselected
                    $counter.attr('data-show-count', "- " + ($selected.length === 0 ? "none" : $selected.length));

                    // Disable the visibility toggle when its associated attachment is unchecked
                    if ($this.is(':not(.round-switch)')) {
                        var $toggle = $this.parents(".small-6.card").siblings(".meta").find(".switch input");

                        if ($this.is(":checked")) {
                            $toggle.removeAttr("disabled");
                        } else {
                            $toggle.prop("disabled", true);
                        }
                    }
                });

                // Unit:
                // * check:   enable assess/attach
                // * uncheck: disable assess/attach
                // * change:  update counts
                units.find('[data-unit]').on('change', function () {
                    var $this        = $(this),
                        unit         = $this.data('unit'),
                        disable      = !$this.prop('checked'),
                        $assessments = units.find('[data-checkbox-group="unit-'+unit+'-assessments"]'),
                        $attachments = units.find('[data-checkbox-group="unit-'+unit+'-attachments"]'),
                        $metaSelected  = units.find('[data-unit-meta="'+unit+'"] [data-checkbox-group-count]');
                    $assessments.prop('disabled', disable);
                    $attachments.prop('disabled', disable);

                    // Select/deselect all
                    $assessments.prop('checked', !disable);
                    $attachments.prop('checked', !disable);

                    if (disable) {
                        $metaSelected.hide();
                    } else {
                        $metaSelected.show();
                    }
                });
            }
        });

        // Last step: redirect whence I came
        $('input[data-mage-next="none"]').mage({
            onXhrDone: function () {
                location.href = "{{ returnUrl.value.raw }}" || "{{ routeLookup('course.courseList') }}";
            }
        });

        // Step 1: load curricula from Atlas
        var $toast                = $('#toast'),
            $schoolSelect         = $('#curriculum-school'),
            $gradeSelect          = $('#curriculum-grade'),
            $subjectSelect        = $('#curriculum-subject'),
            $curriculumPlanList   = $('#curriculum-plan-list'),
            $curriculumPlanTpl    = $('#curriculum-plan-template'),
            schools               = {},
            grades                = {},
            subjects              = {},
            collator              = new Intl.Collator(undefined, {numeric: true}),
            populateSelector      = function($selector, object) {
                Object.keys(object).sort(collator.compare).forEach(function(item) {
                    $selector.append($('<option />').text(item).attr('value', item));
                });
            };

        $toast.toastActivate({text: 'Loading curriculum plans...'});

        $.ajax("{{ routeLookup('courseImportAtlas.getCurriculumList') }}", {dataType: 'json'})
            .done(function(response) {
                $toast.toastTimeout({text: 'Loaded', css: 'success'});
                $(".loader").hide();

                // Load list of schools, grades, subjects
                response.forEach(function(item) {
                    schools[item.school]   = true;
                    grades[item.grade]     = true;
                    subjects[item.subject] = true;
                });

                // Populate them
                populateSelector($schoolSelect, schools);
                populateSelector($gradeSelect, grades);
                populateSelector($subjectSelect, subjects);

                // Sort plans
                response = response.sort(function (a, b) {
                    return collator.compare(a.title, b.title);
                });

                // Load plans into a list
                response.forEach(function(item) {
                    var planItem = $curriculumPlanTpl.clone()
                        .removeAttr('id')
                        .removeClass('hide')
                        .data({
                            id:      item.id,
                            school:  item.school,
                            grade:   item.grade,
                            subject: item.subject
                        });
                    planItem.find('[data-template="curriculum-plan-input"]')
                        .attr('id', 'curriculum-plan-' + String(item.id))
                        .attr('value', item.id);
                    planItem.find('[data-template="curriculum-plan-label"]').attr('for', 'curriculum-plan-' + String(item.id));
                    planItem.find('[data-template="curriculum-plan-label"] span').text(item.title);
                    planItem.find('[data-template="curriculum-plan-school"]').text(item.school);
                    planItem.find('[data-template="curriculum-plan-grade"]').text(item.grade);
                    planItem.find('[data-template="curriculum-plan-subject"]').text(item.subject);
                    $curriculumPlanList.append(planItem);
                });

                // Remove loading
                $curriculumPlanList.find('[data-loading]').addClass('hide');
            })
            .fail(function() {
                $toast.toastTimeout({text: 'Failed!', css: 'alert'});
            });

        // On select of school/grade/subject:
        // filter out ones that don't match
        $().add($schoolSelect).add($gradeSelect).add($subjectSelect).on('change', function() {
            var selections = {};
            if ($schoolSelect.val()) {
                selections.school = $schoolSelect.val();
            }
            if ($gradeSelect.val()) {
                selections.grade = $gradeSelect.val();
            }
            if ($subjectSelect.val()) {
                selections.subject = $subjectSelect.val();
            }

            $curriculumPlanList.find('[data-template="curriculum-plan"]').each(function(i, item) {
                var $item   = $(item),
                    display = true;
                ['school', 'grade', 'subject'].forEach(function(key) {
                    if (key in selections && $item.data(key) !== selections[key]) {
                        display = false;
                    }
                });
                if (display) {
                    $item.slideDown('fast');
                } else {
                    $item.slideUp('fast');
                    // Unselect it if it was selected
                    $item.find(':radio').prop('checked', false);
                }
            });
        });


        // Step 2: load the curriculum I chose
    });
</script>
{% endautoescape %}

<div id="toast" class="toast"></div>
