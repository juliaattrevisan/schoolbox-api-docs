{#
Usage:
    $data = [
        assessment:       IAssessable,
        encodedReturnUrl: string,
        USER: User
    ]
#}
{% import '@learningAssessment/project/macro/icon.twig' as icon %}

{% if assessment is quiz %}
    {% set textLinkRoute = 'learningQuiz.getQuizSummary' %}
{% else %}
    {% set textLinkRoute = 'learningAssessment.getSummary' %}
{% endif %}

<li data-assessment="{{ assessment.id }}">
    <div class="actions-small-1">
        <div class="grip"></div>
        <div class="list-item">
            <div class="compact card small-11 wrap-down">
                {% if textLinkRoute %}
                <a href="{{ routeLookup(textLinkRoute, {assessmentId: assessment.id, studentId: USER.id}) }}?returnUrl={{ encodedReturnUrl }}">
                    {% endif %}
                    <span class="{{ icon.renderClass(assessment) }}"></span>
                    <p>{{ assessment.title }}</p>
                    {% if textLinkRoute %}
                </a>
                {% endif %}
            </div>
        </div>
        <nav>
            <span class="show-for-large-up">
                <a href="{{ routeLookup('learningAssessmentExporter.getExportFormForAssessment', {assessmentId: assessment.id}) }}?returnUrl={{ encodedReturnUrl }}" class="icon-export" title="Copy this activity into classes"></a>
                {% if assessment is quiz %}
                    <a href="{{ routeLookup('learningQuiz.getQuizSummary', {assessmentId: assessment.id}) }}?returnUrl={{ encodedReturnUrl }}" class="icon-modify" title="Modify"></a>
                {% else %}
                    <a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id}) }}?returnUrl={{ encodedReturnUrl }}" class="icon-modify" title="Modify"></a>
                {% endif %}
                <a href="{{ routeLookup('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id}) }}" data-action="delete-assessment" class="icon-delete" title="Delete"></a>
            </span>
            <span class="hide-for-large-up">
                <sbx-pop-out content-id="dropdown-{{ assessment.id }}"></sbx-pop-out>
            </span>
        </nav>
        <ul class="f-dropdown" data-dropdown-content id="dropdown-{{ assessment.id }}">
            <li><a href="{{ routeLookup('learningAssessmentExporter.getExportFormForAssessment', {assessmentId: assessment.id}) }}?returnUrl={{ encodedReturnUrl }}" class="icon-export" title="Copy this activity into classes">Export</a></li>
            <li><a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id}) }}" class="icon-modify">Modify</a></li>
            <li><a href="{{ routeLookup('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id}) }}" data-action="delete-assessment" class="icon-delete">Delete</a></li>
        </ul>
    </div>
</li>
