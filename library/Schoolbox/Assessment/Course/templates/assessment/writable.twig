{#
Usage:
    $data = [
        assessment:       IAssessable,
        encodedReturnUrl: string,
        USER: User
    ]
#}
{% import '@learningAssessment/project/macro/icon.twig' as icon %}

{% if assessment is quiz %}
    {% set textLinkRoute = 'learningQuiz.getQuizSummary' %}
{% elseif assessment is project %}
    {% set textLinkRoute = 'learningAssessment.getStatus' %}
{% else %}
    {% set textLinkRoute = 'learningAssessment.getSummary' %}
{% endif %}

<li data-assessment="{{ assessment.id }}">
    <div class="actions-small-1">
        <div class="grip"></div>
        <div class="list-item">
            <div class="compact card small-11 wrap-down">
                {% if textLinkRoute %}
                <a href="{{ routeLookup(textLinkRoute, {assessmentId: assessment.id, studentId: USER.id}) }}?returnUrl={{ encodedReturnUrl }}">
                    {% endif %}
                    <span class="{{ icon.renderClass(assessment) }}"></span>
                    <p>{{ assessment.title }}</p>
                    {% if textLinkRoute %}
                </a>
                {% endif %}
            </div>
        </div>
        <nav>
            <span class="show-for-large-up">
                <a href="{{ routeLookup('learningAssessmentExporter.getExportFormForAssessment', {assessmentId: assessment.id}) }}?returnUrl={{ encodedReturnUrl }}" class="sbx-icon-only-button no-text" title="Copy this activity into classes" aria-label="Copy this activity into classes"><sbx-icon name="export"></sbx-icon></a>
                {% if assessment is quiz %}
                    <a href="{{ routeLookup('learningQuiz.getQuizSummary', {assessmentId: assessment.id}) }}?returnUrl={{ encodedReturnUrl }}" class="sbx-icon-only-button no-text" title="Modify" aria-label="Modify"><sbx-icon name="modify"></sbx-icon></a>
                {% else %}
                    <a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id}) }}?returnUrl={{ encodedReturnUrl }}" class="sbx-icon-only-button no-text" title="Modify" aria-label="Modify"><sbx-icon name="modify"></sbx-icon></a>
                {% endif %}
                <a href="{{ routeLookup('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id}) }}" data-action="delete-assessment" class="sbx-icon-only-button no-text" title="Delete" aria-label="Delete"><sbx-icon name="delete"></sbx-icon></a>
            </span>
            <span class="hide-for-large-up">
                <sbx-pop-out content-id="dropdown-{{ assessment.id }}"></sbx-pop-out>
            </span>
        </nav>
        <ul class="f-dropdown" data-dropdown-content id="dropdown-{{ assessment.id }}">
            <li><a href="{{ routeLookup('learningAssessmentExporter.getExportFormForAssessment', {assessmentId: assessment.id}) }}?returnUrl={{ encodedReturnUrl }}" class="sbx-button--has-icon" title="Copy this activity into classes"><sbx-icon name="export"></sbx-icon>Export</a></li>
            <li><a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id}) }}" class="sbx-button--has-icon"><sbx-icon name="modify"></sbx-icon>Modify</a></li>
            <li><a href="{{ routeLookup('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id}) }}" data-action="delete-assessment" class="sbx-button--has-icon"><sbx-icon name="delete"></sbx-icon>Delete</a></li>
        </ul>
    </div>
</li>
