<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript">
    $(function() {
        $('#import-course').selectizeSelector({
            ajax: {
                url:      '/course/import/courses',
                type:     'GET',
                dataType: 'json'
            },
            multiple: false,
            value: {{ sources|json_encode|raw }}
        });

        $('#import-folders').selectizeSelector({
            ajax: {
                url:      '/course/import/classes',
                type:     'GET',
                dataType: 'json'
            },
            multiple: true,
            value: {{ destinations|json_encode|raw }}
        });
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>Import Course Into Class</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div class="row">
                <div class="small-3 columns">
                    <input id="import-course" type="text" name="importCourse" />
                </div>
                <div class="small-1 columns text-center">
                    &rarr;
                </div>
                <div class="small-8 columns">
                    <input id="import-folders" type="text" name="importFolders" />
                </div>
            </div>
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Units and Tasks</h2>
        <section class="content">
            <ul class="information-list">
                {% for unit in units %}
                {% include '@course/unitList.twig' %}
                {% endfor %}
            </ul>
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Coursework?</h2>
        <section class="content">
            <p>
                What is?
            </p>
        </section>
    </div>
</div>
