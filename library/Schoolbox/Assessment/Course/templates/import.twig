{#
Display a 4-stage mage form to either
    * import a CourseSpec to 1 or more classes, or
    * modify a CourseImpl (implies a single class)

Importing a CourseSpec to mulitple classes generates multiple CourseImpls.

Usages:
    action:                 string {'import' | 'modify'}
    initialStage:           int {1,2,3}
    courseSpec:             CourseSpecification | null
    courseImpl:             CourseImplementation | null - null if an 'import'
    destinations:           array
    destinations[]['id']:   int
    destinations[]['name']: string
#}

<script type="text/javascript" src="/javascript/shared/jquery.mage.js"></script>
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript">
    $(function() {

        var confirmRevert = function (e, revert) {
            if (this.nextAll('.current-stop').length > 0) {
                $(this).confirmDialog({
                    text: 'Are you sure you want to revert to this step? If you do, all data from subsequent steps will be lost.',
                    confirmEvent: revert
                });
            }
        };

        {# Global mage init #}
        $('input[data-mage-next]').mage({
            // all use the same reversion test
            confirmRevert: confirmRevert
        });


        {# Attach Course Selector Modal listeners #}
        $.fn.courseSelectorModal({

            {# Callbacks #}
            onCourseSelect: function() {
                $('body').on('click', '#course-selector-results [data-course-id]', function(event)
                {
                    event.preventDefault();
                    {# Have to manually call the change event as it doesn't trigger on scripted value updates #}
                    $('#courseSpecId').val($(this).attr('data-course-id')).change();
                    $('[data-course-selector]').html($(this).attr('data-course-name'));
                    $('#course-selector-modal').foundation('reveal', 'close');
                });
            }
        });

        {# Setup class selectize #}
        $('#import-folders').selectizeSelector({
            ajax: {
                url:      '/course/import/classes',
                type:     'GET',
                dataType: 'json'
            },
            multiple: true,
            value: {{ destinations|json_encode|raw }}
        });


        {# Init stage 1 mage #}
        var stageOne = $('input[data-mage-next="part-ownership"]');
        stageOne.bind('validate', function()
        {
            {# Stage 1 validation #}
            if ($('#courseSpecId').val())
            {
                if ($('#import-folders').val())
                {
                    {# Everything okay #}
                    return {'result': true};
                }
                else
                {
                    {# Class was missing #}
                    return {
                        'result': false,
                        'message': 'You must specify at least one class before you can proceed.'
                    };
                }
            }
            else
            {
                {# Course was missing #}
                return {
                    'result': false,
                    'message': 'You must select a course to import before you can proceed.'
                };
            }
        });

        stageOne.mage({onXhrDone: function (data) {
            $('#ownershipAssignment').html(data);
        }});

        var stageTwo = $('input[data-mage-next="part-unit-select"]');

        stageTwo.mage({onXhrDone: function (data) {
            $('#importUnits').html(data);

            {# Init stage 3 mage #}

            var stageThree = $('input[data-mage-next="part-tasks-select"]');

            stageThree.mage({
                confirmRevert: confirmRevert,
                onRevert: function () {
                    $('#importUnits').find(':checkbox').closest('li').slideDown();
                },
                onXhrDone: function (data) {
                {# Slide away the things we're not using #}

                $('#importUnits').find('input[type=checkbox]').filter(':not(:checked)').closest('li').slideUp();

                {# Set content #}

                $('#importTasks').html(data);

                {# Init stage 4 mage #}

                var stageFour = $('input[data-mage-next="part-results-select"]');

                stageFour.mage({
                    onXhrDone: function(data) {

                        try {
                            if (typeof data == 'object' && 'redirect' in data && data.redirect) {
                                {# Go back to wherever you came from (hopefully) -#}
                                window.location.href = data.redirect;
                            } else {
                                window.history.back();
                            }
                        } catch (e) {
                            window.history.back();
                        }

                    }
                }).bind('validate', function() {

                    {# Stage 4 validation #}

                    if ($('#importUnits').find('input[type=checkbox]').filter(':checked').length > 0) {

                        {# Make sure every date has been entered #}

                        var dateFields = $('input[data-mage-next="part-results-select"]')
                                .closest('fieldset')
                                .find('input[type=text]');

                        var blankFound = false;

                        $.each(dateFields, function (index, field) {
                            if (!$(field).val()) {

                                {# Date field was blank #}

                                blankFound = true;
                                $('label[for="'+$(field).attr('id')+'"].error').removeClass('hide');
                                $(field).addClass('error');
                            } else {
                                $(field).removeClass('error');
                                $('label[for="'+$(field).attr('id')+'"].error').addClass('hide');
                            }
                        });

                        if (blankFound) {
                            return {
                                'result': false,
                                'message': 'You must supply dates for each unit of work in this unit before you can proceed.'
                            };
                        }

                        {# Everything okay #}

                        return { 'result': true };
                    }
                });
            }}).bind('validate', function() {

                {# Stage 3 validation #}

                if ($('#importUnits').find('input[type=checkbox]').filter(':checked').length > 0)
                {
                    {# Check both dates are entered for each checked unit #}

                    var dateFields = $('#importUnits')
                            .find('input[type=checkbox]')
                            .filter(':checked')
                            .closest('li')
                            .find('input[type=text]');

                    var blankFound = false;

                    $.each(dateFields, function(index, field) {
                        if (!$(field).val()) {

                            {# Date field was blank #}

                            blankFound = true;
                            $('label[for="'+$(field).attr('id')+'"].error').removeClass('hide');
                            $(field).addClass('error');
                        } else {
                            $(field).removeClass('error');
                            $('label[for="'+$(field).attr('id')+'"].error').addClass('hide');
                        }
                    });

                    if (blankFound) {
                        return {
                            'result': false,
                            'message': 'You must specify a valid open and close date for each unit you are importing.'
                        };
                    }

                    {# All dates were specified #}

                    return {
                        'result': true
                    };

                }
                else
                {
                    {# No units were ticked #}

                    return {
                        'result': false,
                        'message': 'You must select at least one unit before you can proceed.'
                    };
                }

            });
{% if not _part3 %}
        }});
{% endif %}
    });
</script>
<div class="row">
    <div class="small-12 island">

        {% if 'modify' == action %}
            <h1>Modify Course</h1>
        {% else %}
            <h1>Import Course into Class</h1>
        {% endif %}

        <div class="row">
            <div class="small-12 column">
                <ul class="train-line">
                    <li data-mage-trainstop="part-course-select"{% if 1 == initialStage %} class="current-stop"{% endif %}><a><span class="icon-course-builder"></span>Course</a></li>
                    <li data-mage-trainstop="part-ownership"{% if 2 == initialStage %} class="current-stop"{% endif %}><a><span class="icon-teacher"></span>Ownership</a></li>
                    <li data-mage-trainstop="part-unit-select"><a><span class="icon-unit"></span>Units</a></li>
                    <li data-mage-trainstop="part-tasks-select"><a><span class="icon-curriculum"></span>Coursework</a></li>
                </ul>
            </div>
        </div>

        <form method="post">
            <section>
                <fieldset class="content" data-mage="part-course-select" {% if 1 != initialStage %}disabled="disabled"{% endif %}>
                    <legend>1. Course</legend>
                    <input type="hidden" name="componentId" value="{{ componentId }}">
                    {% if 1 == initialStage %}
                    <div class="meta small-12 column" data-mage-helptext>
                        <p>Select the course that is to be imported, and one or more classes as the target destination.</p>
                    </div>
                    {% endif %}
                    <div class="small-5 medium-5 large-3 columns">
                        {% include 'sub/selectorShard.twig' with {
                                'formLabel': 'Course',
                                'formInputName': 'courseSpecId',
                                'formInputValue': courseSpec.id,
                                'formInputLabel': courseSpec.folder.name,
                                'folder': folder,
                                'activator': 'data-course-selector',
                                'title': 'Select Course to import'
                            }
                        %}
                    </div>
                    <div class="small-2 medium-2 large-1 columns text-center">
                        <p class="course-import icon-next"></p>
                    </div>
                    <div class="small-5 medium-5 large-8 columns">
                        <label>Class(es)
                            <input id="import-folders" type="text" name="importFolders" />
                        </label>
                    </div>
                    {% if 1 == initialStage %}
                        <div class="small-12 column">
                            <div class="row" data-mage-submitrow>
                                <div class="small-12 medium-8 column">
                                    <p class="alert alert-box icon-alert" data-mage-error></p>
                                </div>
                                <div class="small-12 medium-4 column">
                                    <input type="submit" name="part-course-select" value="Next" data-mage-next="part-ownership" data-mage-working="Working..." formaction="{{ routeLookup('courseImport.postClasses') }}" />
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </fieldset>
                <fieldset class="content" data-mage="part-ownership" {% if _part3 %}disabled{% endif %}>
                    <legend>2. Ownership</legend>
                    <div class="small-12 column {% if initialStage < 2 %}hide{% endif %}" data-mage-collapsed>
                        {% if 2 == initialStage %}
                            <div id="ownershipAssignment">
                                {% include '@course/import/ownership.twig' with {
                                    courseSpec:                    courseSpec,
                                    component:                     component,
                                    targetFolders:                 [ folder ],
                                    ownershipCandidates:           ownershipCandidates,
                                    _disabled:                     false
                                } only %}
                            </div>
                        {% else %}
                            <div id="ownershipAssignment">{# will be populated by ajax #}</div>
                        {% endif %}
                        <div class="row" data-mage-submitrow>
                            <div class="small-12 medium-8 column">
                                <p class="alert alert-box icon-alert" data-mage-error></p>
                            </div>
                            <div class="small-12 medium-4 column">
                                <input type="submit" name="part-ownership" value="Next" data-mage-next="part-unit-select" data-mage-working="Working..." formaction="{{ routeLookup('courseImport.postOwnership') }}" />
                            </div>
                        </div>
                    </div>
                </fieldset>
                <fieldset class='content' data-mage="part-unit-select">
                    <legend>3. Units</legend>
                    <div class="small-12 column{% if 3 != initialStage %} hide" data-mage-collapsed{% else %}"{% endif %} >
                        <div id="importUnits">
                            {% if 3 == initialStage %}
                                {% include '@course/unitImportForm.twig' with {
                                    action:       action,
                                    courseSpecId: courseSpecId,
                                    courseImplId: componentId,
                                    unitsImpls:   unitsImpls,
                                    componentId:  componentId,
                                    ownerships:   ownerships
                                } only %}
                            {% endif %}
                        </div>
                    </div>
                </fieldset>
                <fieldset class='content' data-mage="part-tasks-select">
                    <legend>4. Coursework</legend>
                    <div class="small-12 column hide" data-mage-collapsed>
                        <div id="importAssessments">{# will be populated by ajax #}</div>
                        <!-- Notable absence: no [data-mage-submitrow] since this is the final section -->
                        <input type="hidden" data-mage-next="none" name="part-tasks-select" value="1" />
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>

<div id="course-selector-modal" class="reveal-modal" data-reveal></div>


