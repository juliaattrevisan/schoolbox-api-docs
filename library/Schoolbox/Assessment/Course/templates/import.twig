{#
Display a 4-stage mage form to either
    * import a CourseSpec to 1 or more classes, or
    * modify a CourseImpl (implies a single class)

Importing a CourseSpec to mulitple classes generates multiple CourseImpls.

Usages:
    action:                 string {'import' | 'modify'}
    initialStage:           int {1,2}
    courseSpec:             CourseSpecification | null
    courseImpl:             CourseImplementation | null  - null if an 'import'
    destinations:           array
    destinations[]['id']:   int
    destinations[]['name']: string
    returnUrlName:          string                       - (optional) GET key
    encodedReturnUrl:       string                       - (optional) GET value

 # @param string $importedAlreadyRedirect  Redirect here if you cancel the import
 # @param bool $importedAlready            Whether your course spec exists in at least one Course Outline in at least
 #                                         one of your target folders (nominally cast as a bool, but is actullay a
 #                                         list of folder ids)
 #}

<script src="{{ CDN_PREFIX }}/js/bundle/mage.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {

        var confirmRevert = function (e, revert) {
            if (this.nextAll('.current-stop').length > 0) {
                $(this).confirmDialog({
                    text: 'Are you sure you want to revert to this step? If you do, all data from subsequent steps will be lost.',
                    confirmEvent: revert
                });
            }
        };

        {# Global mage init #}
        $('input[data-mage-next]').mage({
            // all use the same reversion test. Subsequent mage attachment will merge options.
            confirmRevert: confirmRevert
        });


        {# Attach Course Selector Modal listeners #}
        $.fn.courseSelectorModal({

            {# Callbacks #}
            onCourseSelect: function() {
                $('body').on('click', '#course-selector-results [data-course-id]', function(event)
                {
                    event.preventDefault();
                    {# Have to manually call the change event as it doesn't trigger on scripted value updates #}
                    $('#course_spec_id').val($(this).attr('data-course-id')).change();
                    $('[data-course-selector]').html($(this).attr('data-course-name'));
                    $('#course-selector-modal').foundation('reveal', 'close');
                });
            }
        });

        var initStage1 = function() {
            {# Init stage 1 mage #}
            $('input[data-mage-next="part-2"]').mage({
                validateOptions: {
                    rules: {
                        course_spec_id: {required: true},
                        import_folders: {required: true}
                    }
                },
                onXhrDone: function (data) {
                    $('#import_units').html(data);
                    initStage2();
                }
            });
        };


        {# Init stage 2 mage #}
        var initStage2 = function() {
            $('[data-datepicker]').each(attachAlaressDatePicker);

            var $magePart2 = $('input[data-mage-next="part-3"]');
            $magePart2.mage({
                validateOptions: {
                    ignore: ':disabled'
                },
                beforeAttemptingSubmit: function() {
                    // make sure at least one unit is selected
                    $('input[data-checkbox-group="unit"]').rules('add', {
                        oneCheckbox: 'unit'
                    });
                    // check any visible open date fields
                    $('input[data-role="open_date"]:visible').each(function() {
                        $(this).rules('add', {
                            datepickerDate: true,
                            required: true
                        });
                    });
                    // check any due date fields
                    $('input[data-role="due_date"]:visible').each(function() {
                        var index = $(this).data('index');
                        var openDate = $('input[data-role="open_date"][data-index="' + index + '"]');
                        $(this).rules('add', {
                            required: true,
                            datepickerDateNotBefore: openDate
                        });
                    });
                },
                onRevert: function () {
                    $('#import_units').find(':checkbox').closest('li').slideDown();
                },
                onXhrDone: function (data) {
                    {# Slide away the things we're not using #}

                    $('#import_units').find('input[type=checkbox]').filter(':not(:checked)').closest('li').slideUp();

                    {# Set content #}

                    $('#import_assessments').html(data);
                    initStage3();
                }
            });
            $magePart2.mage('open');
        };

        var initStage3 = function(){
            {# Init stage 3 mage #}
            $('[data-datepicker]').each(attachAlaressDatePicker);

            var $magePart3 = $('input[data-mage-next="none"]');
            $magePart3.mage({
                validateOptions: {
                    invalidHandler: function (event, validator) {
                        // Ensure any units with invalid inputs are expanded
                        var mageForm = $('[data-mage="part-3"]');

                        // Find collapsers and expand them
                        Object.keys(validator.invalid).forEach(function(invalidInputName) {
                            var $inputElement    = mageForm.find('[name="' + invalidInputName + '"]'),
                                $collapsable     = $inputElement.closest('[data-collapsable]'),
                                collapsableId    = $collapsable.attr('data-collapsable'),
                                $collapserButton = mageForm.find('[data-collapser="' + collapsableId + '"]');

                            if ($collapsable.attr("data-collapse-state") === "collapsed") {
                                $.fn.executeCollapsable($collapsable, $collapserButton);
                            }
                        });
                    }
                },
                beforeAttemptingSubmit: function() {
                    // check every enabled publish date field
                    $('input[data-role="publish_date"]:enabled').each(function() {
                        $(this).rules('add', {
                            required: true,
                            datepickerDate: true
                        });
                    });
                    // check every enabled open date field
                    $('input[data-role="open_date"]:enabled').each(function() {
                        var lessonId = $(this).data('assessment-id');
                        var publishDate = $('input[data-role="publish_date"][data-assessment-id="' + lessonId + '"]');
                        $(this).rules('add', {
                            required: true,
                            datepickerDateNotBefore: publishDate
                        });
                    });
                    // check every enabled due date field
                    $('input[data-role="due_date"]:enabled').each(function() {
                        var lessonId = $(this).data('assessment-id'),
                            dateRole;
                        // if an open date exists then it needs to be before then, otherwise before publish date
                        if ($('input[data-role="open_date"][data-assessment-id="' + lessonId + '"]').length > 0) {
                            dateRole = 'open_date';
                        } else {
                            dateRole = 'publish_date';
                        }
                        var otherDate = $('input[data-role="' + dateRole + '"][data-assessment-id="' + lessonId + '"]');
                        $(this).rules('add', {
                            required: true,
                            datepickerDateNotBefore: otherDate
                        });
                    });
                    // check every enabled close date field
                    $('input[data-role="close_date"]:enabled').each(function() {
                        var lessonId = $(this).data('assessment-id');
                        var dueDate = $('input[data-role="due_date"][data-assessment-id="' + lessonId + '"]');
                        $(this).rules('add', {
                            required: true,
                            datepickerDateNotBefore: dueDate
                        });
                    });
                },
                onXhrDone: function(data) {

                    if (typeof data === 'object' && 'redirect' in data && data.redirect) {
                        {# Go back to wherever you came from (hopefully) -#}
                        /** @var {string} data.redirect*/
                        window.location.href = data.redirect;
                    }
                    // If something goes wrong, DO NOT redirect. Stay here to enable debugging.
                }
            });
            $magePart3.mage('open');
        };

        // Initialise JS at correct stage
        {% if 1 == initialStage %}
            initStage1();
        {% elseif 2 == initialStage %}
            initStage2();
        {% else %}
            throw new Error('Unrecognised initial mage step: ' + {{ initialStage }});
        {% endif %}
    });
</script>
<div class="row">
    <div class="small-12 island">

        {% if 'modify' == action %}
            <h1>Modify Course</h1>
        {% else %}
            <h1>Import Course into Class</h1>
        {% endif %}

        <div class="row">
            <div class="small-12 column">
                <ul class="train-line">
                    <li data-mage-trainstop="part-1"{% if 1 == initialStage %} class="current-stop"{% endif %}>
                        <a><span class="icon-course-builder"></span>Course</a>
                    </li>
                    <li data-mage-trainstop="part-2"{% if 2 == initialStage %} class="current-stop"{% endif %}>
                        <a><span class="icon-unit"></span>{{ locale.unit.properPlural }}</a>
                    </li>
                    <li data-mage-trainstop="part-3"><a><span class="icon-curriculum"></span>Coursework</a></li>
                </ul>
            </div>
        </div>

        <form method="post" class="mage">
            <section>
                <fieldset class="content" data-mage="part-1" {% if 1 != initialStage %}disabled="disabled"{% endif %}>
                    <legend>1. Course</legend>
                    {% if 1 == initialStage %}
                    <div class="meta small-12 column" data-mage-helptext>
                        <p>Select the course that is to be imported, and one or more classes as the target destination.</p>
                    </div>
                    {% endif %}
                    <div class="small-5 medium-5 large-3 columns">
                        {% include 'sub/selectorShard.twig' with {
                                'formLabel':     'Course',
                                'formInputName': 'course_spec_id',
                                'formInputValue': courseSpec.id,
                                'formInputLabel': courseSpec.folder.name,
                                'activator':      'data-course-selector',
                                'title':          'Select Course to import'
                            } only
                        %}
                    </div>
                    <div class="small-2 medium-2 large-1 columns text-center">
                        <p class="course-import icon-next"></p>
                    </div>
                    <div class="small-5 medium-5 large-8 columns">
                        <div id="class-selector-container">
                            <class-selector 
                                endpoint="{{ routeLookup('courseImport.searchClasses') }}"
                                :previously-selected-class="{{ destinations|json_encode }}"
                            />
                        </div>
                        <script src="{{CDN_PREFIX}}/js/bundle/classSelector.js?v={{ config.site_version }}"></script>
                    </div>
                    {% if 1 == initialStage %}
                        <div class="small-12 column">
                            <div class="row" data-mage-submitrow>
                                <div class="small-12 column">
                                    <div class="alert alert-box icon-alert" data-mage-error></div>
                                </div>
                                <div class="small-12 column">
                                    <input
                                        type="submit"
                                        name="part-1"
                                        value="Next"
                                        data-mage-next="part-2"
                                        data-mage-working="Working..."
                                        formaction="{{ routeLookup('courseImport.postClasses') }}"
                                    />
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    <input type="hidden" name="component_id" value="{{ componentId is defined ? componentId : '' }}">
                </fieldset>
                <fieldset class='content' data-mage="part-2">
                    <legend>2. {{ locale.unit.properPlural }}</legend>
                    {% if encodedReturnUrl %}
                        <input type="hidden" name="{{ returnUrlName }}" value="{{ encodedReturnUrl }}" />
                    {% endif %}
                    <div class="small-12 column{% if 2 != initialStage %} hide{% endif %}" data-mage-collapsed >
                        <div id="import_units">
                            {% if 2 == initialStage %}
                                {% include '@course/unitImportForm.twig' with {
                                    action:           action,
                                    courseSpecId:     courseSpecId,
                                    folderIds:        folderIds,
                                    courseImplId:     courseImpl is defined ? courseImpl.id : null,
                                    componentId:      componentId is defined ? componentId : null,
                                    unitsImpls:       unitsImpls,
                                    canReadUnitSpecs: canReadUnitSpecs,
                                    importedAlreadyRedirect: importedAlreadyRedirect,
                                    importedAlready: importedAlready
                                } only %}
                            {% endif %}
                        </div>
                        <div class="small-12 column">
                            <div class="row" data-mage-submitrow>
                                <div class="small-12 column">
                                    <div class="alert alert-box icon-alert" data-mage-error></div>
                                </div>
                                <input
                                    type="submit"
                                    name="part-2"
                                    value="Next"
                                    data-mage-next="part-3"
                                    data-mage-working="Working..."
                                    formaction="{{ routeLookup('courseImport.postUnits') }}"
                                />
                            </div>
                        </div>
                    </div>
                </fieldset>
                <fieldset class='content' data-mage="part-3">
                    <legend>3. Coursework</legend>
                    <div class="small-12 column hide" data-mage-collapsed>
                        <div id="import_assessments">{# will be populated by ajax #}</div>
                        <!-- Notable absence: no [data-mage-submitrow] since this is the final section -->
                        <div class="small-12 column">
                            <div class="row" data-mage-submitrow>
                                <div class="small-12 column">
                                    <div class="alert alert-box icon-alert" data-mage-error></div>
                                </div>
                                {% set urlSuffix = (encodedReturnUrl | length)
                                    ? ('?' ~ returnUrlName ~ '=' ~ encodedReturnUrl)
                                    : ''
                                %}
                                <input
                                    name="part-3"
                                    type="submit"
                                    value="{% if 'import' == action %}Import{% else %}Modify{% endif %}"
                                    data-mage-next="none"
                                    data-mage-working="Working..."
                                    formaction="{{ routeLookup('courseImport.postAssessments') }}{{ urlSuffix }}"
                                />
                            </div>
                        </div>
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>

<div id="course-selector-modal" class="reveal-modal" data-reveal></div>


