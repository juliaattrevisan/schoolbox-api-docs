{# Usage:
    {% include '@course/courseListResults.twig' with {
         folderAccess      array                   - Access perm indexed by course.folder.id
         suggestions:      CourseSpecification[],
         courses:          CourseSpecification[],
         folder.id:        int | null
         linkToUnits:      bool - should Course title link to modify-course or import-course page?
         component.id:     int | null,
         lineage:          Folder[courseSpec.id][]
         hasTot:           bool,
         search:           string | null
         returnUrlKey:     string
         encodedReturnUrl: string
    } only %}
#}

<div class="small-12 island">

    {% if suggestions is defined and suggestions|length %}
        <section>
            <h3>Suggested Courses</h3>
            <ul class="information-list">

                {% for course in suggestions %}
                    {% include '@course/courseListResult.twig' with {
                        folderAccess:      folderAccess,
                        courseSpec:        course,
                        folder:            folder is defined ? folder : null,
                        linkToUnits:       linkToUnits,
                        component:         component is defined ? component : null,
                        cparents:          lineage[course.id],
                        hasTot:            hasTot,
                        linkTitleToModify: linkTitleToModify ?? null,
                        returnUrlKey:      returnUrlKey,
                        collapsePrefix:    'suggest',
                        encodedReturnUrl:  encodedReturnUrl
                    } only %}
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if courses is defined %}
        <section>
            {% if suggestions is defined and suggestions|length %}
                <h3>All Courses</h3>
            {% endif %}
            <ul class="information-list">
                {% for course in courses %}
                    {% include '@course/courseListResult.twig' with {
                        folderAccess:      folderAccess,
                        courseSpec:        course,
                        folder:            folder is defined ? folder : null,
                        linkToUnits:       linkToUnits,
                        component:         component is defined ? component : null,
                        cparents:          lineage[course.id],
                        hasTot:            hasTot,
                        linkTitleToModify: linkTitleToModify ?? null,
                        returnUrlKey:      returnUrlKey,
                        collapsePrefix:    null,
                        encodedReturnUrl:  encodedReturnUrl
                    } only %}
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <div class="row">
            <div class="small-12 columns">
                <div class="empty-state">
                    <i class="icon-course"></i>
                    {% if search is defined and search is not empty %}
                        <p>Your search for '{{ search }}' did not return any matches.<br>Please try your search again or <a href="{{ routeLookup('course.newCourse', {name: (search | url_encode)}) }}">create a new course called '{{ search }}'</a>.</p>
                    {% else %}
                        <p><a href="{{ routeLookup('course.newCourse') }}">Create your first course</a>, a template of activities and assessments for importing to your class.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
</div>

<div class="toast" data-course-toast></div>

{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        $('[data-collapser]').collapsable();

        $(document).foundation('dropdown', 'reflow');

        $('a[data-action="course-delete"]').on('click', function(event) {
            event.preventDefault();

            var $this = $(this);
            var href = this.href;

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this course? This will delete ALL {{ locale.unit.plural }} within this course, as well as any other content that has been added!',
                confirmLabel: 'Delete',
                confirmEvent: function() {

                    // A toast
                    var $toast = $('[data-course-toast]');
                    $toast.toastActivate({text: 'Deleting course...'});

                    $.post(href, {})
                        .done(function() {
                            // Kill the element
                            $this.parents('[data-course-row]').slideUp(function() {
                                $(this).remove();
                            });

                            // Toast success
                            $toast.toastTimeout({text: 'Course deleted.', css: 'success'});
                        })
                        .fail(function() {
                            // Toast fail
                            $toast.toastTimeout({text: 'Delete failed.', css: 'alert'});
                        });
                }
            });
        })
    });
</script>
{% endautoescape %}
