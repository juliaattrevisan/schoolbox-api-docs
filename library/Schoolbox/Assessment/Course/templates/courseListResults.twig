<div class="small-12 island">

    {% if courses|length %}
        <section>
            <ul class="information-list">
                {% for course in courses %}
                    {% include '@course/courseListResult.twig' %}
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <p>No results found.</p>

        <a class='button submit expand' href="/course/new/{{ query | url_encode }}">Create a Course called {{ query }}</a>
    {% endif %}
</div>
<script type="text/javascript">
    $(function () {
        $('[data-collapser]').collapsable();

        $(document).foundation('dropdown', 'reflow');

        $('a[data-action="course-delete"]').on('click', function(event) {
            event.preventDefault();

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this course? This will delete ALL units within this course, as well as any other content that has been added!',
                confirmEvent: function() {
                    $.post('/resource/folder/delete', {id: $(event.target).attr('data-course-delete-id') }).done(function () {
                        location.reload();
                    });
                }
            });
        })
    });
</script>


