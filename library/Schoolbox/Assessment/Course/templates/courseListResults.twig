{# Usage:
    {% include '@course/courseListResults.twig' with {
         suggestions:      CourseSpecification[],
         courses:          CourseSpecification[],
         folder.id:        int | null
         linkToUnits:      bool - should Course title link to modify-course or import-course page?
         component.id:     int | null,
         lineage:          Folder[courseSpec.id][]
         hasTot:           bool,
         currentUser:      User,
         search:           string | null
         returnUrlKey:     string
         encodedReturnUrl: string
    } only %}
#}

<div class="small-12 island">

    {% if suggestions|length %}
        <section>
            <h3>Suggested Courses</h3>
            <ul class="information-list">

                {% for course in suggestions %}
                    {% include '@course/courseListResult.twig' with {
                        courseSpec:     course,
                        folder:         folder,
                        linkToUnits:    linkToUnits,
                        component:      component,
                        cparents:       lineage[course.id],
                        hasTot:         hasTot,
                        currentUser:    currentUser,
                        collapsePrefix: 'suggest'
                    } only %}
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if courses|length %}
        <section>
            {% if suggestions|length %}
                <h3>All Courses</h3>
            {% endif %}
            <ul class="information-list">
                {% for course in courses %}
                    {% include '@course/courseListResult.twig' with {
                        courseSpec:        course,
                        folder:            folder,
                        linkToUnits:       linkToUnits,
                        component:         component,
                        cparents:          lineage[course.id],
                        hasTot:            hasTot,
                        currentUser:       currentUser,
                        linkTitleToModify: linkTitleToModify,
                        returnUrlKey:      returnUrlKey,
                        encodedReturnUrl:  encodedReturnUrl
                    } only %}
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <section>
            <p class="content">No results found.</p>
        </section>

        {% set label = search ? "Create a Course called "~search : "Create a new Course" %}
        <a class='button submit expand' href="/course/new/{{ search | url_encode }}">{{ label }}</a>
    {% endif %}
</div>
<script type="text/javascript">
    $(function () {
        $('[data-collapser]').collapsable();

        $(document).foundation('dropdown', 'reflow');

        $('a[data-action="course-delete"]').on('click', function(event) {
            event.preventDefault();

            var href = this.href;
            $(this).confirmDialog({
                text: 'Are you sure you want to delete this course? This will delete ALL units within this course, as well as any other content that has been added!',
                confirmEvent: function() {
                    $.post(href, {}).done(function () {
                        location.reload();
                    });
                }
            });
        })
    });
</script>


