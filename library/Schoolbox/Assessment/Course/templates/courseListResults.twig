<div class="small-12 island">

    {% if suggestions|length %}
        <section>
            <h3>Suggested Courses</h3>
            <ul class="information-list">
                {% for course in suggestions %}
                    {% include '@course/courseListResult.twig' with { collapsePrefix: 'suggest' } %}
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if courses|length %}
        <section>
            {% if suggestions|length %}
                <h3>All Courses</h3>
            {% endif %}
            <ul class="information-list">
                {% for course in courses %}
                    {% include '@course/courseListResult.twig' %}
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <section>
            <p class="content">No results found.</p>
        </section>

        <a class='button submit expand' href="/course/new/{{ query | url_encode }}">Create a Course called {{ query }}</a>
    {% endif %}
</div>
<script type="text/javascript">
    $(function () {
        $('[data-collapser]').collapsable();

        $(document).foundation('dropdown', 'reflow');

        $('a[data-action="course-delete"]').on('click', function(event) {
            event.preventDefault();

            var href = this.href;
            $(this).confirmDialog({
                text: 'Are you sure you want to delete this course? This will delete ALL units within this course, as well as any other content that has been added!',
                confirmEvent: function() {
                    $.post(href, {}).done(function () {
                        location.reload();
                    });
                }
            });
        })
    });
</script>


