<h2>Select Location</h2>
<input type="text" value="" data-filter-input="location-list" placeholder="Search" />
<div>
    <ul data-hover-source="location-list" data-filter-list="location-list">
        {% include '@course/treebranch.twig' %}
    </ul>
</div>
<p><em data-hover-result="location-list">&nbsp;</em></p>
<a class="close-reveal-modal" aria-label="Close">&#215;</a>

<script type="text/javascript">
    $(function () {

        $('[data-hover-source]').each(function () {

            var target = $(this).data('hover-source');

            var $result = $('[data-hover-result="' + target + '"]');

            $(this).on('mouseenter', '[data-selection]', function () {

                var current = $(this), stack = [current.text()];

                while ((current = aAbove(current)).length) {
                    stack.push(current.text());

                }

                stack.reverse();

                $result.text('Use ' + stack.join(' > '));

            }).on('mouseleave', '[data-selection]', function () {
                $result.html('&nbsp;');
            });

        });

        function aAbove(elem) {
            return $(elem).parent().parent().siblings('a');
        }

        $('[data-filter-input]').on('change keyup keydown paste', function () {

            var $input = $(this),
                target = $input.data('filter-input'),
                filter = $input.val().toLowerCase(),
                $list  = $('[data-filter-list="' + target + '"]');

            $list.find('a').closest('li').addClass('hide');

            // hide everything, then we'll turn back on what we need
            var $valid = $list.find('a').filter(function () {
                return $(this).text().toLowerCase().match(filter) != null;
            });

            $valid.each(function () {
                var current = $(this);

                current.closest('li').removeClass('hide');

                // make revisible all the thing in the immediate hierarchy
                while ((current = aAbove(current)).length) {
                    current.closest('li').removeClass('hide');
                }
            });

        });

    });
</script>
