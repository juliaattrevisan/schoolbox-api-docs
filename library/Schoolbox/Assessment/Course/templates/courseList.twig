<script type="text/javascript" src="/javascript/shared/jquery.collapsable.js"></script>
{% if hasBreadcrumb %}
<ul class="breadcrumb">
    <li><a href="/sandbox">Sandbox</a></li>
    <li class="active"><a href="/sandbox/path/to/{{ tpl }}">{{ tpl | title }}</a></li>
</ul>
{% endif %}

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Course List</h1>
        </div>
    </div>
    {% if hasAdd %}
    <nav>
        <a href="/course/new" class="icon-add"></a>
    </nav>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 column">
        <input type="text" value="" placeholder="Search for a course" data-course-selector-filter style="background-repeat:no-repeat;background-position: 99% 50%" />
    </div>
</div>
<div class="row" id="results">
    {# This is the default results when modal opens, this will get replaced by 'courseListResults.twig' after an AJAX #}
    {% include '@course/courseListResults.twig' %}
</div>

{% if hasClose %}
<a class="close-reveal-modal">&#215;</a>
{% endif %}
