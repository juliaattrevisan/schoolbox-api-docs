{% if hasBreadcrumb %}
<ul class="breadcrumb">
    <li><a href="/sandbox">Sandbox</a></li>
    <li class="active"><a href="/sandbox/path/to/{{ tpl }}">{{ tpl | title }}</a></li>
</ul>
{% endif %}

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Course List</h1>
        </div>
    </div>
    {% if hasAdd %}
    <nav>
        <a href="/course/new" class="icon-add"></a>
    </nav>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 column">
        <input type="text" value="" placeholder="Search for a course" data-course-selector-filter />
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <section>
            <ul class="information-list">
            {% for course in courses %}
                {% set cparents = lineage[course.id] %}

                {% if hasTot %}
                <li class="actions-small-2">
                {% else %}
                <li class="actions-small-1">
                {% endif %}

                    <div class="list-item">
                        <div class="compact avatar card small-12">
                            <a href="/course/modify/{{ course.id }}">
                                <div class="icon-course icon-16"></div>
                                <h3>{{ course.name }}</h3>
                            </a>
                            <p class="meta">
                                {{ cparents[0].name }}
                                {% for cparent in cparents | slice(1) %}
                                    &gt; {{ cparent.name }}
                                {% endfor %}
                            </p>
                        </div>
                        <div class="small-12 column hide" data-collapse-state="collapsed" data-collapsable="course-{{ course.id }}">
                            <ul class="unit-list">
                                {% for unit in units[course.id] %}
                                    <li>
                                    {% if unit.hasHomepage %}
                                        <a title="Visit {{ unit.name }} homepage" href="/homepage/{{ unit.id }}">{{ unit.name }}</a>
                                    {% else %}
                                        {{ unit.name }}
                                    {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                    <nav>
                        <a href="#" class="icon-down-arrow" data-collapser="course-{{ course.id }}"></a>

                        {% if hasTot %}
                        <a href="#" class="icon-overflow"></a>
                        {% endif %}
                    </nav>
                </li>
            {% endfor %}
            </ul>
        </section>
    </div>
</div>
<script type="text/javascript" src="/javascript/shared/jquery.collapsable.js"></script>
<script type="text/javascript">
    $(function () {
        $('[data-collapser]').collapsable();
    });
</script>
