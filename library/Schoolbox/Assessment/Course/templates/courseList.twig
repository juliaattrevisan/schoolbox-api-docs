{#
Usage:
    $data = [
        hasClose:         bool     - whether to render the close icon
        hasAdd:           bool     - whether to render icon to add new CourseSpec
        hasTot:           bool     - whether each CourseSpec item should have action overflow menu
        linkToUnits:      bool     - should CourseSpec title link to modify-course or import-to-class page
        hasBreadcrumb:    bool     - whether to render folder lineage breadcrumbs
        courses:          CourseSpecification[]
        folder.id:        int      - (optional) whether to link import-to-class to specific class
        returnUrlKey:     string   - GET key name
        encodedReturnUrl: string   - GET value
        component.id:     int      - (optional) whether to link import-to-class to specific component
        lineage:          Folder[] - (optional) ancestor folders

#}

<script type="text/javascript">
    $(function() {

        /* Attach Course Selector
         */
        $.fn.courseSelector({

            courseSelector: {
                query: {
                    {% if folder.id %}
                        folder:           "{{ folder.id | escape('js') }}",
                    {% endif -%}
                    {% if component.id %}
                        component:        "{{ component.id | escape('js') }}",
                    {% endif -%}
                    hasAdd:           {% if hasAdd %}true{% else %}false{% endif %},
                    hasTot:           {% if hasTot %}true{% else %}false{% endif %},
                    linkToUnits:      {% if linkToUnits %}true{% else %}false{% endif %},
                    encodedReturnUrl: "{{ encodedReturnUrl | escape('js') }}"
                }
            }

        });
    });
</script>

{% if hasBreadcrumb %}
    <ul class="breadcrumb">
        <li class="active"><a href="{{ routeLookup('course.courseList') }}">Courses</a></li>
    </ul>
{% endif %}

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Course List</h1>
        </div>
    </div>
    {% if hasAdd %}
        <nav>
            <a href="/course/new" class="icon-add"></a>
        </nav>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 column">
        <input type="text" class='course-selector-loader' value="" placeholder="Search for a course" data-course-selector-filter />
    </div>
</div>
<div class="row" id="course-selector-results">
    {# This is the default results when modal opens, this will get replaced by 'courseListResults.twig' after an AJAX #}
    {% include '@course/courseListResults.twig' %}
</div>

{% if hasClose %}
    <a class="close-reveal-modal">&#215;</a>
{% endif %}
