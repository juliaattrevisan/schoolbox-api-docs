{# Load JS for treeview #}
{% import '@resourceBrowser/macro/nodeIcon.twig' as nodeIcon %}

<link rel="stylesheet" href="{{ CDN_PREFIX }}/js/vendors/jstree/dist/themes/default/style.css"/>
<script>
    
    /**
     * As this file is loaded dynamically within a modal, we need to ensure 
     * its script files are fully loaded on the CDN before we call any methods contained within
     * the files. This is because these script files will not be loaded with render blocking, 
     * so tree.resourceTree() could be called before jquery.resourceTree.js is loaded
     */

    //check if one of the scripts is already loaded so we don't load it again
    if (Boolean(document.querySelector(`script[src="{{ CDN_PREFIX }}/js/resource/jquery.resourceTree.js"]`))) {
        initResourceTree();
    } else {
        loadScripts();
    }

    function loadScripts () {

        let scriptsLoaded = 0;
        const jsFiles = [
            '{{ CDN_PREFIX }}/js/vendors/jstree/dist/jstree.min.js',
            '{{ CDN_PREFIX }}/js/resource/jquery.resourceTree.js',
            '{{ CDN_PREFIX }}/js/vendors/scrollTo/jquery.scrollTo.min.js',
            '{{ CDN_PREFIX }}/js/resource/jquery.fileDrop.js'
        ]
        
        function loadScript () {
            const scriptElement = document.createElement('script');
            scriptElement.addEventListener('load', onScriptLoaded);
            scriptElement.src = jsFiles[scriptsLoaded];
            document.head.appendChild(scriptElement);
        }

        //keep loading scripts sequentially until all are loaded
        function onScriptLoaded () {
            if (scriptsLoaded === (jsFiles.length-1)) {
                initResourceTree();
            } else {
                scriptsLoaded++;
                loadScript();
            }
        }

        loadScript();

    }
    
    function initResourceTree () {

        var tree = $('#tree');

        tree.resourceTree({{ nodeIcon.jsIconMap() }}, {
            data: {
                {# raw HTML reluctantly sanctioned - this should be passed to template as raw, then json_encode|raw #}
                cache: {{ treedata | raw }},
                ajaxParams: {
                    url: '{{ routeLookup('course.listNodes') }}?mime=none',
                    token: '{folderId}'
                }
            }
        });

        var jstree = tree.jstree(true);

        tree.on('select_node.jstree', function (event, jstree) {

            {# Store the folder node ID and name for returning to the modals parent when closed #}

            jstree.instance.open_node(jstree.node.id);
            var nodeId = jstree.node.li_attr['data-id'];

            $('[data-label]')
                    .data('selection', nodeId)
                    .data('label', jstree.node.text);

            $('[data-select],[data-selection]')
                    .attr('disabled', jstree.node.parent == '#');
        });

        var $resources = $('#resources');

        {# On the initial open of the tree and all its open by default parts scroll to it #}

        tree.on('after_open.jstree.initial', function (event, jstree) {
            var nodeId = jstree.node.id;

            // If this node is the parent of the selected: scroll to the selected now
            var initialNode = jstree.instance.get_children_dom(nodeId).filter('#' +{{ folderId }});
            if (initialNode.length) {
                $resources.scrollTo(initialNode);
                tree.off('.jstree.initial');
            } else if (tree.focused !== undefined) {
                $('[data-select],[data-selection]').attr('disabled', tree.focused().parent == '#');
            }
        });

        $resources.height(400);

    }

</script>

<div class="row">
    <div class="small-12 island">
        <h1>Select Folder</h1>
        <p>Click on the {{ locale.faculty }} folder in which you want to put the course below.</p>
    </div>
</div>
<div class="resource-browser row">
    <div class="small-12 island">
        <section>
            <div class="scroller" id="resources">
                <div id="tree" class="resource-tree"></div>
            </div>
        </section>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <a data-selection data-label="">
            <button disabled class="button submit" data-select>Use this folder</button>
        </a>
    </div>
</div>
