{#
Usage:
    $data = [
        unitSpec:         UnitSpecification,
        _expanded:        bool               - whether to initially display expanded or collapsed,
        encodedReturnUrl: string             - URL to return to to focus on this UnitSpec in current CourseSpec
    ]
#}
<li class="actions-small-1 content">
    <h3>{{ unitSpec.folder.name }}</h3>
    {% if unitSpec.assessables | length %}
        <ul class="information-list no-pad">
            {% for assessment in unitSpec.assessables %}
                {% include '@course/assessment/readonly.twig' with {
                    assessment: assessment,
                    _writable:  false
                } only %}
            {% endfor %}
        </ul>
    {% else %}
        <div class="empty-state">
            <sbx-icon name="course" size="2.5rem"></sbx-icon>
            <p>No activities in this {{ locale.unit }}.</p>
        </div>
    {% endif %}
</li>
