<li class="actions-small-1 content" data-unit>
    <div class="list-item">
        <div class="small-1 column">
            <a data-collapser="unit-{{ unit.id }}" class="icon-{{ _expanded ? 'up' : 'down' }}-arrow"></a>
        </div>
        <div class="small-11 column">
            <label>
                <input type="text" value="{{ unit.name }}" placeholder="Unit Name" />
            </label>
        </div>
    </div>
    <nav>
        <a class="icon-overflow" title="" data-dropdown="unit-{{ unit.id }}-modify"></a>
    </nav>
    <ul id="unit-{{ unit.id }}-modify" class="f-dropdown" data-dropdown-content>
        <li><a href="/course/unit/{{ unit.id }}/delete" class="icon-delete" data-delete="unit">Delete Unit</a></li>
    </ul>
    <div class="small-12 column {% if not _expanded %}hide{% endif %}" data-collapsable="unit-{{ unit.id }}" {% if not _expanded %}data-collapse-state="collapsed"{% endif %}>
        <ul class="information-list sortable" data-sortable>
            {% for task in tasks[unit.id] %}
                {% include '@course/task.twig' with { '_writable': true } %}
            {% endfor %}
        </ul>
        <ul class="flex-list buttons">
            <li><a href="/task/create/{{ unit.id }}"                                                              title="Create a new Task"     class="button icon-task"    >New Task</a></li>
            <li><a href="/submission/createSubmission/new/{{ unit.id }}/task?return_url={{ returnUrl[unit.id] }}" title="Create a new Due Work" class="button icon-due-work">New Due Work</a></li>
            <li><a href="/assess/create/{{ unit.id }}/task?return_url={{ returnUrl[unit.id] }}"                   title="Create a new Quiz"     class="button icon-quiz"    >New Quiz</a></li>
        </ul>
    </div>
</li>
