{#
Usage:
    $data = [
        unitSpec:         UnitSpecification,
        _expanded:        bool               - whether to initially display expanded or collapsed,
        encodedReturnUrl: string             - URL to return to to focus on this UnitSpec in current CourseSpec
        toastSelector:    string             - jQuery selector for the toast HTML element
    ]
#}

<script type="text/javascript">
    $(function () {
        $('[data-unit-spec={{ unitSpec.id }}]').setupCourseBuilder({toastSelector: '{{ toastSelector | raw }}'});
    });
</script>

<li class="actions-small-1 content" data-unit-spec="{{ unitSpec.id }}">
    <div class="list-item">
        <div class="small-1 column">
            <a data-collapser="unit-{{ unitSpec.id }}" class="icon-{{ _expanded ? 'up' : 'down' }}-arrow"></a>
        </div>
        <div class="small-11 column">
            <label>
                <input type="text" value="{{ unitSpec.folder.name }}" placeholder="Unit Name" name="unit[{{ unitSpec.id }}][name]" data-unit-name maxlength="255"/>
            </label>
        </div>
    </div>
    <nav>
        <sbx-actions-dropdown content-id="unit-{{ unitSpec.id }}-modify"></sbx-actions-dropdown>
    </nav>
    <ul id="unit-{{ unitSpec.id }}-modify" class="f-dropdown" data-dropdown-content>
        {% if unitSpec.folder.hasHomepage %}
            <li><a href="/homepage/{{ unitSpec.folder.id }}" class="icon-home">View Homepage</a></li>
        {% else %}
            <li><a href="/resources/{{ unitSpec.folder.id }}" class="icon-folder">Browse Resources</a></li>
        {% endif %}
        <li><a href="{{ routeLookup('learningAssessmentExporter.getExportFormForUnit', {unitSpecId: unitSpec.id}) }}?returnUrl={{ encodedReturnUrl }}" class="icon-import" data-action="import-unit">Import to Classes</a></li>
        <li><a href="{{ routeLookup('course.deleteUnitSpecification', {id: unitSpec.id}) }}" class="icon-delete" data-action="delete-unit">Delete Unit</a></li>
        {% set courseMarkbookRoute = routeLookupIfAuthorized('courseMarkbook.getRedirect', {courseSpec: unitSpec.course, courseSpecId: unitSpec.course.id, unitSpecId: unitSpec.id, folderId: 0}) %}
        {% if courseMarkbookRoute %}<li><a href="{{ courseMarkbookRoute }}" class="icon-curriculum">Course Markbook</a></li>{% endif %}
    </ul>
    <div class="small-12 column {% if not _expanded %}hide{% endif %}" data-collapsable="unit-{{ unitSpec.id }}" {% if not _expanded %}data-collapse-state="collapsed"{% endif %}>
        <div class="empty-state{% if unitSpec.assessables|length %} hide{% endif %}" data-empty-state>
            <i class="icon-course"></i>
            <p>No activities in this {{ locale.unit }} yet.</p>
        </div>
        <ul class="information-list sortable"
            data-sortable
            data-assessment-list
            data-action="{{ routeLookup('learningAssessment.postReorderAssessments', {contextType: 'unitspecs', contextId: unitSpec.id, context: unitSpec}) }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">
            {% for assessment in unitSpec.assessables %}
                {% include '@course/assessment.twig' with {
                    assessment:       assessment,
                    encodedReturnUrl: encodedReturnUrl,
                    _writable:        true,
                    USER:             USER
                } only %}
            {% endfor %}
        </ul>
        <ul class="flex-list buttons">
            <li>
                <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'unitspecs', contextId: unitSpec.id, context: unitSpec}) }}?type=project&returnUrl={{ encodedReturnUrl }}"
                   title="Create a new {{ locale.project }}"
                   class="button icon-project"
                >New {{ locale.project.proper }}</a></li>
            <li>
                <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'unitspecs', contextId: unitSpec.id, context: unitSpec}) }}?type=task&returnUrl={{ encodedReturnUrl }}"
                   title="Create a new task"
                   class="button icon-task"
                >New Task</a></li>
            <li>
                <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'unitspecs', contextId: unitSpec.id, context: unitSpec}) }}?type=dueWork&returnUrl={{ encodedReturnUrl }}"
                   title="Create a new {{ locale.dueWork }}"
                   class="button icon-due-work"
                >New {{ locale.dueWork.proper }}</a></li>
            <li>
                <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'unitspecs', contextId: unitSpec.id, context: unitSpec}) }}?type=quiz&returnUrl={{ encodedReturnUrl }}"
                   title="Create a new quiz"
                   class="button icon-quiz"
                >New Quiz</a></li>
            {% if config.lti_assessments_enable %}
            <li>
                <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'unitspecs', contextId: unitSpec.id, context: unitSpec}) }}?type=lti&returnUrl={{ encodedReturnUrl }}"
                   title="Create a new assessment with a 3rd party tool"
                   class="button icon-lti"
                >New 3rd Party Assessment</a></li>
            {% endif %}
            <li>
                <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'unitspecs', contextId: unitSpec.id, context: unitSpec}) }}?type=lessonPlan&returnUrl={{ encodedReturnUrl }}"
                   title="Create a new lesson plan"
                   class="button icon-lesson-plan"
                >New Lesson Plan</a></li>
        </ul>
    </div>
</li>
