<li class="actions-small-1 content" data-unit="{{ unit.id }}" id="{{ reveals[unit.id].id }}">
    <div class="list-item">
        <div class="small-1 column">
            <a data-collapser="unit-{{ unit.id }}" class="icon-{{ _expanded ? 'up' : 'down' }}-arrow"></a>
        </div>
        <div class="small-11 column">
            <label>
                <input type="text" value="{{ unit.name }}" placeholder="Unit Name" name="unitname[{{ unit.id }}]" />
            </label>
        </div>
    </div>
    <nav>
        <a class="icon-overflow" title="" data-dropdown="unit-{{ unit.id }}-modify"></a>
    </nav>
    <ul id="unit-{{ unit.id }}-modify" class="f-dropdown" data-dropdown-content>
        {% if unit.hasHomepage %}
            <li><a href="/homepage/{{ unit.id }}" class="icon-home">View Homepage</a></li>
        {% else %}
            <li><a href="/resources/{{ unit.id }}" class="icon-folder">Browse Resources</a></li>
        {% endif %}
        <li><a href="/course/unit/{{ unit.id }}/delete" class="icon-delete" data-delete="{{ unit.id }}">Delete Unit</a></li>
    </ul>
    <div class="small-12 column {% if not _expanded %}hide{% endif %}" data-collapsable="unit-{{ unit.id }}" {% if not _expanded %}data-collapse-state="collapsed"{% endif %}>
        <ul class="information-list sortable" data-sortable data-task_list>
            {% for task in tasks[unit.id] %}
                {% include '@course/task.twig' with { '_writable': true } %}
            {% else %}
                <li class="empty-state">
                    <i class="icon-course"></i>
                    <p>No coursework in this unit yet.</p>
                </li>
            {% endfor %}
        </ul>
        <ul class="flex-list buttons">
            <li><a href="/task/create/{{ unit.id }}"        data-reveal-id="createTask-{{ reveals[unit.id].id }}" title="Create a new Task"     class="button icon-task"    >New Task</a></li>
            <li><a href="/submission/createSubmission/new/{{ unit.id }}/task?return_url={{ returnUrl[unit.id] }}" title="Create a new Due Work" class="button icon-due-work">New Due Work</a></li>
            <li><a href="/assess/create/{{ unit.id }}/task?return_url={{ returnUrl[unit.id] }}"                   title="Create a new Quiz"     class="button icon-quiz"    >New Quiz</a></li>
        </ul>
    </div>
    <form action="/task/saveForm.php" method="post" data-interaction="reorder-tasks">
        <input type="hidden" name="action"    value="reorder"/>
        <input type="hidden" name="category"   value="{{ unit.id }}"/>
        <input type="hidden" name="component"  value="{{ reveals[unit.id].component.id }}"/>
        <input type="hidden" name="return_url" value="{{ returnUrl[unit.id] }}"/>
    </form>
    {% include '@course/task/reveal-modal.twig' with { reveal: reveals[unit.id] } %}
    <script type="text/javascript">
        $(function () {
            $('#{{ reveals[unit.id].id }}').setupCourseBuilder();
        });
    </script>
</li>
