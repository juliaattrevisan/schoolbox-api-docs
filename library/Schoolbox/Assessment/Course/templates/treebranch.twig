{# expects { branch: <data> } #}
<li>
    <a data-selection="{{ branch.id }}" href="/resources/{{ branch.id }}">{{ branch.text }}</a>
    {% if branch.children %}
    <ul>
        {% for node in branch.children %}
            {% include '@course/treebranch.twig' with { branch: node } %}
        {% endfor %}
    </ul>
    {% endif %}
</li>
