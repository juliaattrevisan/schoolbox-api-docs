{% set icons = ['task', 'due work', 'quiz'] %}

{# TODO sassify this #}
<style type="text/css">

    .small-1 span {
        display: block;
        margin-top: 0.5rem;
    }

    fieldset {
        transition: opacity 360ms cubic-bezier(0.2,1,0,1);
    }

    fieldset[disabled] {
        opacity: 0.9;
    }

    input[type="submit"][readonly] {
        background-color: rgba(0,102,176,0.4);
        background-image: url('/images/resources/ajax.gif');
        background-repeat: no-repeat;
        background-size: 1rem;
        background-position: 0.75rem 50%;
    }

    .selectize-control.multi .selectize-input.has-items {
        padding: 0 0 1px 0;
    }

    .selectize-control .selectize-input > div a.remove {
        padding: 1px 5px 2px 4px !important;
        width: 1rem !important;
        margin: 0 4px 0 5px !important;
    }

    .selectize-control .selectize-input > div {
        margin: 1px 0 0 1px !important;
    }

    .selectize-control .selectize-input > div a.remove:hover {
        text-decoration: none;
        background: #0066b0;
        border-radius: 16px;
        color: white;
    }
    .selectize-input > input[type=text] {
        margin-left: 8px !important;
    }

    .selectize-input {
        margin-bottom: 0;
    }
    .selectize-input.dropdown-active:before {
        display: none;
    }

</style>

<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/curriculum/javascript/jquery.curriculumSelector.js"></script>

<ul class="breadcrumb">
    <li><a href="/course/list">Courses</a></li>
    <li class="active">
        {% if folder.id %}
            <a href="/course/modify{{ folder.id }}">Modify Course</a>
        {% else %}
            <a href="/course/new">New Course</a>
        {% endif %}
    </li>
</ul>
<div class="row">
    <div class="small-12 island">
        <h1>{{ folder.id ? 'Modify' : 'New' }} Course</h1>
        <form>
            <section>
                <fieldset class="content">
                    <legend>Course Information</legend>
                    <div class="small-12 column">
                        <label>Name
                            <input type="text" name="name" value="{{ folder.name }}" placeholder="What's this course called?" />
                        </label>
                    </div>
                    <div class="small-12 column">
                        <label>Faculty / Class
                            <input type="hidden" name="parent" value="{{ folder.parent.id }}" />
                            <a data-source="parent" href="#" class="source-select {{ folder.parent.id ? 'icon-folder' : '' }}" title="Click to change the faculty / class this course belongs to">{{ folder.parent.id ? folder.parent.name : '(Click to select)' }}</a>
                        </label>
                    </div>
                    <div class="small-12 column">
                        <label>Curriculum Codes
                            {% include 'sub/curriculumCodeSelector.twig' with { renderButton: false, codeList: folder.curriculumNodes } %}
                        </label>
                    </div>
                    <div {% if folder.id %}class="hide"{% endif %}>
                        <div class="small-12 medium-8 column">
                            <p data-errorreason style="display:none;" class="alert alert-box icon-alert"></p>
                        </div>
                        <div class="small-12 medium-4 column">
                            <input type="submit" class="button" value="Next" data-formpartial-expose="units" />
                        </div>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <legend>Units</legend>
                    <div class="small-12 column no-pad">
                        <ul class="information-list" {% if not folder.id %}style="display:none;"{% endif %} data-formpartial="units">
                        {% for unit in units %}
                            {% include '@course/unit.twig' with { i: loop.index, '_writable': true } %}
                        {% endfor %}
                            <li class="actions-small-1" data-unit>
                                <div class="list-item content">
                                    <div class="small-1 column">
                                        <span class="icon-add"></span>
                                    </div>
                                    <div class="small-11 column">
                                        <label>
                                            <input type="text" value="" placeholder="New Unit" id="noonit-name" />
                                        </label>
                                    </div>
                                </div>
                                <div class="small-12 medium-8 column">
                                    <p data-errorreason style="display:none;" class="alert alert-box icon-alert"></p>
                                </div>
                                <div class="small-12 medium-4 column">
                                    <ul class="flex-list buttons">
                                        <li><a href="#" class="button" id="noonit">Create Unit</a></li>
                                    </ul>
                                </div>
                            </li>
                        </ul>
                    </div>
                </fieldset>
            </section>
            <div class="row" data-formpartial="units" {% if not folder.id %}style="display: none;"{% endif %}>
                <div class="small-12 column">
                    <input type="submit" name="submit" value="Save Course" />
                </div>
            </div>
        </form>
    </div>
</div>
<div id="parent-select" data-reveal class="reveal-modal"></div>
<script type="text/javascript" src="/javascript/shared/jquery.collapsable.js"></script>
<script type="text/javascript">
    $(function () {
        $('[data-collapser]').collapsable();

        $('[data-source]').on('click', function (e) {
            e.preventDefault();

            var $selector = $(this),
                target = $selector.data('source'),
                $input = $('[name="' + target + '"]');

            var modal = $('#parent-select');

            modal.foundation('reveal', 'open', '{{ routeLookup('course.parentList') }}').one('click', '[data-selection]', function (e) {
                e.preventDefault();

                var $selection = $(this);

                // selector takes the name, input takes the ID
                $selector.addClass('icon-folder').text($selection.text());
                $input.val($selection.data('selection'));

                modal.foundation('reveal', 'close');
            });

        });

        $('[data-formpartial-expose]').on('click', function (e) {
            e.preventDefault();

            // intercept the form submit, ajax the partial, upon success expose the next section and hide self
            var $button    = $(this),
                target     = $button.data('formpartial-expose'),
                $expose    = $('[data-formpartial="' + target + '"]'),
                realForm   = $button.closest('form'),
                $fieldset  = $button.closest('fieldset'),
                $errMsg    = $fieldset.find('[data-errorreason]'),
                formData   = $fieldset.clone(),
                slideSpeed = 800,
                ajaxForm   = $('<form/>').attr('method', realForm.attr('method')).attr('action', realForm.attr('action')).append(formData);

            $fieldset.attr('disabled','disabled');
            $errMsg.slideUp(100);


            // cache this for if we need to restore it
            var buttonText = $button.val();

            $button.attr('readonly', 'readonly').val('Working...');

            var success = function () {
                $button.closest('div').slideUp(slideSpeed, always);
                $expose.slideDown(slideSpeed);
            };

            var failure = function (data) {
                $button.val(buttonText);

                var nm  = formData.find('input[type=text]').eq(0).val() || 'this unnamed course';
                var msg = 'Unable to save ' + nm + ', because ' + data + '.';

                $errMsg.text(msg).slideDown(slideSpeed);
            };

            var always = function () {
                $fieldset.removeAttr('disabled');
                $button.removeAttr('readonly');
            };


            // TODO ajax, and handle success / failure
            setTimeout(function () {

                if ($errMsg.text().length) {
                    success();
                } else {
                    failure('of reasons that I feel disinclined to share with you. But it\'s mostly just that I don\'t like you');
                }

                always();
            }, 1200);

        });

        $('#noonit').on('click', function (e) {
            e.preventDefault();


            var $before = $(this).closest('li[data-unit]');

            var noonitName = $('#noonit-name');

            $.post('/sandbox/course/unit/new', { name: noonitName.val() }).done(function (data) {
                $before.before(data);
                $('[data-collapser]').collapsable();
                noonitName.val('');
            }).fail(function () {

            }).always(function () {

            });
        });

    });
</script>

