{#
Usage:
    $data = [
        courseSpec:        CourseSpecification  -
        curriculumEnabled: bool                 - disable curriculum tagging ?
        folderAccess:      int[]                - indexed by folder.id
        encodedReturnUrls: string[]             - indexed by UnitSpec.id
        isValidFacultyRoot: bool                - is configured faculty root valid
    ]
#}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/course/jquery.course-builder.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/mage.js?v={{ config.site_version }}"></script>
{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {

        $('[data-collapser]').collapsable();

        // Mage Buttons
        var $mageNextButton = $('[data-mage-next="unit-info"]');
        var $mageCreateUnitButton = $('[data-mage-next="spawn-unit"]');
        var $mageSaveCourseButton = $('[data-mage-next="main-course"]');


        /**
         * Apply the javascript validator
         *
         * @param modifyValidation
         */
        function initValidator(modifyValidation) {
            $("#update-course-form").alaressValidate(modifyValidation);

            $('[data-unit-name]').each(function() {
                $(this).rules('add', {
                    requiredNotBlank: true,
                    messages: {
                        required: "Please enter a name for this {{ locale.unit }}."
                    }
                });
            });

            {# This validation was triggering even though it was okay to be empty
             # That condition exists when you want to save the course without
             # creating a new unit; as usual, solve the problem by deleting the problem
             #}
            if ($('[data-unit-spec]').length) {
                $mageSaveCourseButton.on('click', function () {
                    $('[data-new-unit]').remove();
                });
            }
        }


        /**
         *  Toggle button availability
         *
         *  @return void
         */
        function toggleSaveCourse() {
            let invalidUnits = 0;
            let hasUnits = $('[data-unit-spec]').length;

            /* No units? No submit
             */
            if (!hasUnits) {
                $mageSaveCourseButton.attr('disabled', true);
                return;
            }

            /* Every unit must have a name
             */
            $.each($('[data-unit-name]'), function(index, element) {
                if ($.trim($(element).val()) === '') {
                    invalidUnits++;
                }
            });

            if (invalidUnits) {
                $mageSaveCourseButton.attr('disabled', true);
            } else {
                $mageSaveCourseButton.attr('disabled', false);
            }
        }


        /* Disable save course button while editing is occurring
         * Check that all the units have names
         * This is built excessively because of various input methods like copy-paste
         * and tabindexing
         */
        toggleSaveCourse();

        $(document).on('keyup', '[data-unit-name]', function() {
            toggleSaveCourse();
        });


        /**
         * Validation for the final save course form
         * (the other validation is done in each mage step below)
         */
        var modifyValidation = {
            rules: {
                name: "required",
                parent: "required",
                newUnitName: {
                    requiredNotBlank: true
                }
            },
            messages: {
                name: "Please enter a name for this course.",
                parent: "Please select a {{ locale.faculty }} or {{ locale.class }} for this course.",
                newUnitName: 'Please create at least one {{ locale.unit }} for this course.'
            },
            onfocusout: false,
            onkeyup: false
        };

        /* Apply initially; this gets reset during async mage calls, it seems, so we
         * will end up re-initialising elsewhere
         */
        initValidator(modifyValidation);


        /**
         * Deletion of Units
         */
        $(document).on('click', '[data-action="delete-unit"]', function (e) {
            e.preventDefault();
            var $button = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you wish to delete this {{ locale.unit }}? This will also delete all {{ locale.activity.plural }} in the {{ locale.unit }}.',
                confirmEvent: function () {
                    $.post($button.attr('href'))
                        .done(function () {
                            var $listItem = $button.closest('[data-unit-spec]');

                            $listItem.slideUp(400, function () {
                                $listItem.detach();

                                /* Toggle button availability
                                 */
                                toggleSaveCourse();
                            });
                        });
                }
            });
        });

        var newUnitName = $('#new-unit-name');

        // 'Next' Button
        $mageNextButton.mage({
            reenablePrevious: true,
            onXhrDone: function (data) {
                if (data.id) {
                    // Update the Browser URL
                    history.pushState(data, '', data['urlModifyCourse']);

                    // Update the DOM
                    $mageCreateUnitButton.attr('formaction', data['urlNewUnit']);
                    $mageSaveCourseButton.parents('form').attr('action', data['urlModifyCourse']);
                }
                // Remove the submit row
                $mageNextButton.closest('[data-mage-submitrow]').slideUp(400, function () {
                    $(this).detach();
                });
                $mageNextButton.mage('enable');

                // Show the 'New Unit' section
                $mageCreateUnitButton.closest('[data-mage-collapsed]').slideDown();

                // Display the 'Save Course' section
                $mageSaveCourseButton.closest('[data-mage-collapsed]').slideDown();
            },

            // Reset validation always
            onXhrAlways: function() {
                initValidator(modifyValidation);

                /* Toggle button availability
                 */
                toggleSaveCourse();
            },

            validateOptions: {
                rules: {
                    name: "required",
                    parent: "required"
                },
                messages: {
                    name: "Please enter a name for this course",
                    parent: "Please select a {{ locale.faculty }} or {{ locale.subject }} for this course"
                }
            }
        });

        // 'Create Unit' Button
        $mageCreateUnitButton.mage({
            reenablePrevious: true,
            submittable: '[data-unit-spec]',

            setFormData: function (formData) {
                formData.push({name: 'name', value: newUnitName.val()});
            },

            onXhrDone: function (data) {
                var newDOM = $(data).hide();
                $('[data-unit-list]').append(newDOM);
                /* 400ms is the default value
                 */
                newDOM.slideDown(400, function() {
                    /* Toggle button availability after the animation finishes
                     *
                     * If you do it too soon, toggleSaveCourse can't recognise the
                     * injection of the new html (hasUnits returns 0 too quickly)
                     */
                    toggleSaveCourse();

                    {# This validation was triggering even though it was okay to be empty
                     # That condition exists when you want to save the course without
                     # creating a new unit; as usual, solve the problem by deleting the problem
                     #}
                    if ($('[data-unit-spec]').length) {
                        $mageSaveCourseButton.on('click', function () {
                            $('[data-new-unit]').remove();
                        });
                    }
                });
                newDOM.find('[data-collapser]').collapsable();
                //I'm not sure what's going on in here, but a new version of jQuery has added a
                //display:block to this script tag, which will render out the tag code contents
                //into the browser, so it needs to be removed. Perhaps $().before() adds it in.
                if (newDOM[0].tagName === "SCRIPT") { //just make sure it only applies to <script> tags, as I don't know if this is accessed in other ways
                    newDOM[0].style.display = 'none';
                }
                newUnitName.val('');
                $(this).val($(this).data('mage-reset')).removeAttr('disabled').removeData('mage-submitted');
                $(document).foundation();
            },

            // Reset validation always
            onXhrAlways: function() {
                initValidator(modifyValidation);

                /* Toggle button availability
                 */
                toggleSaveCourse();
            },

            validateOptions: {
                rules: {
                    newUnitName: {
                        requiredNotBlank: true
                    }
                },
                messages: {
                    newUnitName: "Please enter a name for your new {{ locale.unit }}"
                }
            }
        });

        {# only alert on changing templates if we have changed the template #}
        {% if courseSpec %}
        // Template input: show a warning if changing the selected option
        var templateInput = $('[data-template]');

        templateInput.change(function() {
            $("[data-template-warning]").toggleClass("hide", Number({{ courseSpec.template.id ?? null }}) === Number(templateInput.val()));
        });
        {% endif %}


        // Automatically expand the Unit specified in the URL hash
        if (window.location.hash) {
            var unitSpecId = window.location.hash.slice(1);
            $('[data-collapser=unit-' + unitSpecId + ']').trigger('click');
        }

        // To track if we need to re-expand the unit after dragging
        let currentDraggedUnitWasExpanded = false;
        // If the units can be sorted, set up the drag/drop functionality
        $('[data-unit-list][data-sortable]').sortable({
            placeholder: 'sortable-placeholder',
            items: '> [data-unit-spec]',
            forcePlaceholderSize: true,
            handle: '[data-grip-unit]',
            axis: 'y',
            start: function (event, ui) {
                const unitId = ui.item.data('unit-spec');

                // Set the height of the placeholder to match the INITIAL height of the item, so we can transition it if needed
                ui.placeholder.height(ui.item.outerHeight());

                // Collapse the unit when dragging
                // (cannot use JQuery to read data attributes as it does not update the value...)
                currentDraggedUnitWasExpanded = document.querySelector(`[data-collapsable="unit-${unitId}"]`).dataset.collapseState === 'uncollapsed';
                if (currentDraggedUnitWasExpanded) {
                    ui.item.find(`[data-collapser="unit-${unitId}"]`).trigger('click');

                    // We need to use the padding of the item and the inner item height as the new placeholder height
                    // as the placeholder already has a fixed height set and we need to wait for the collapse animation
                    // to finish before it will be correct.
                    const itemPadding = parseInt(window.getComputedStyle(ui.item[0]).paddingTop, 10) * 2;
                    const actionsItemHeight = ui.item.find('[data-unit-actions]').outerHeight();
                    const actualItemHeight = actionsItemHeight + itemPadding;

                    // 400 is the default collapse animation time from $(...).slideUp()
                    const collapseTime = 400;

                    // Instead of immediately changing the height, animate it to the new height so that the height change
                    // matches with the height change as a result of the collapse animation.
                    ui.helper.animate({height: actualItemHeight}, collapseTime, 'linear');
                    ui.placeholder.animate({height: actualItemHeight}, collapseTime, 'linear');

                    // Ensure sortable is aware of the new height of the placeholder
                    setTimeout(() => {
                        $('[data-unit-list][data-sortable]').sortable('refreshPositions');
                    }, collapseTime);
                }
            },
            update: async function (event, ui) {
                const sequence = Array.from(document.querySelectorAll('[data-unit-spec]')).map((unit) => parseInt(unit.dataset.folderId, 10));

                var $toastFeedback = $('[data-relation="ajax-response"]');
                $toastFeedback.toastActivate({ text: "Saving..." });
                try {
                    const currentSequence = sequence;
                    const response = await fetch($(this).data('action'), {
                        method: "POST",
                        body: JSON.stringify({
                            sequence: currentSequence,
                        }),
                        headers: {
                            Accept: "application/json",
                            "Content-Type": "application/json",
                        },
                    });

                    if (!response.ok) {
                        throw new Error(response);
                    }

                    $toastFeedback.toastTimeout({ text: "Save successful", css: "success" });
                } catch (error) {
                    $toastFeedback.toastTimeout({ text: "Save failed!", css: "alert" });
                }
            },
            stop: function (event, ui) {
                // Re-expand the unit if it was expanded before dragging
                if (currentDraggedUnitWasExpanded) {
                    const unitId = ui.item.data('unit-spec');
                    ui.item.find(`[data-collapser="unit-${unitId}"]`).trigger('click');
                }

                // Unset any temporary height set on the placeholder
                ui.placeholder.css('height', '');
            }
        });

        // Re apply course framework
        $('a[data-action="reapply-framework"]').on('click', function (event) {
            event.preventDefault();

            var element = $(this);

            element.confirmDialog({
                header: "Are you sure you wish to re-apply the framework?",
                text: '<span class="alert-box warning icon-alert">Re-applying the course framework will merge content and affect how it displays on your homepages. New content may appear as a result of re-applying the framework.</span>',
                format: "html",
                confirmLabel: "Yes, Re-apply",
                cancelLabel: "No",
                confirmEvent: function (element) {
                    var toaster = $('[data-relation="ajax-response"]');
                    toaster.toastActivate({ text: "Syncing framework..." });

                    /* The list element containing this row
                     */
                    $.ajax(element.attr("href"), {
                        dataType: "json",
                        type: "POST",
                    })
                        .done(function () {
                            // Delete this unit from the list
                            element.closest("[data-unit]").remove();

                            toaster.toastTimeout({
                                text: "Framework successfully re-applied.",
                                css: "pop success",
                            });
                        })
                        .fail(function () {
                            toaster.toastTimeout({
                                text: "Framework could not be re-applied.",
                                css: "pop alert",
                            });
                        });
                },
            });
        });
    });
</script>
{% endautoescape %}

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('course.courseList') }}">Courses</a></li>
    <li class="active">
        {% if courseSpec %}
            <span>Modify Course</span>
        {% else %}
            <span>New Course</span>
        {% endif %}
    </li>
</ul>
<div class="row actions-small-1">
    <div class="small-12 columns">
        <div class="list-item">
            <h1>{{ courseSpec ? 'Modify' : 'New' }} Course</h1>
        </div>
    </div>
    {% if courseSpec %}
    <nav>
        <sbx-pop-out content-id="courseDropdown-{{ courseSpec.id }}"></sbx-pop-out>
    </nav>
    <ul class="f-dropdown" data-dropdown-content id="courseDropdown-{{ courseSpec.id }}">
        {% if courseSpec.folder.hasHomepage %}
            <li><a class="icon-home" href="/homepage/{{ courseSpec.folder.id }}">View Homepage</a></li>
        {% else %}
            <li><a class="icon-folder" href="/resources/{{ courseSpec.folder.id }}">View Resources</a></li>
        {% endif %}

        {% set courseMarkbookRoute = routeLookupIfAuthorized('courseMarkbook.getMarkbook', {courseSpec: courseSpec, courseSpecId: courseSpec.id}) %}
        {% if courseMarkbookRoute %}<li><a href="{{ courseMarkbookRoute }}" class="icon-curriculum">Course Markbook</a></li>{% endif %}

        {% set assessmentCalendarUrl = routeLookupIfAuthorized('learningAssessmentCalendar.getReport') %}
        {% if assessmentCalendarUrl %}
            <li>
                <a href="{{ assessmentCalendarUrl~'?course='~courseSpec.id }}" class="icon-calendar">{{ locale.assessment|capitalize }} Calendar</a>
            </li>
        {% endif %}
        <li><a href="{{ routeLookup('coursePlan.getPlan', {id: courseSpec.id}) }}" class="icon-project">Unit Planner</a></li>
        <li><a href="{{ routeLookup('course.reApplyFramework', {id: courseSpec.id, courseSpec: courseSpec}) }}" class="icon-refresh" data-action="reapply-framework">Re-apply Framework</a></li>
    </ul>
    {% endif %}
</div>
<div class="row">
    <div class="small-12 island" id="main-course">
        <form method="post" action="{{ routeLookup('course.updateCourse', {id: courseSpec ? courseSpec.id : 0}) }}" id="update-course-form" class="mage">
            <input type="hidden" name="returnUrl" value="{{ RETURN_URL.previous.encoded }}">
            <section>
                <fieldset class="content" data-mage="course-info">
                    <legend>Course Information</legend>
                    <div class="small-12 column">
                        <label class="required" for="name">Name</label>
                            <input type="text"
                                   name="name"
                                   id="name"
                                   value="{{ courseSpec ? courseSpec.folder.name : courseName }}"
                                   placeholder="What's this course called?"
                                   required
                                   maxlength="255"
                            />
                    </div>

                    <div class="small-4 column">
                        {% include '@course/sub/sourceSelector.twig' with {
                            courseSpec: courseSpec,
                        } only %}
                    </div>

                    {% if not isValidFacultyRoot %}
                        <div class="small-12 column">
                            {% include '@course/sub/invalidFacultyRoot.twig' %}
                        </div>
                    {% endif %}

                    <div class="small-4 column">
                        <label class="required" for="template">
                            Course Framework
                        </label>
                        <select data-template name="template" required>
                            {# if the course template is not set (doesn't exist)
                             # either canvas is not saying which template it is using with its import
                             # or possibly a failed migration.
                             #
                             # we should show a default of `please select`, and force the user to fix it
                            #}
                            {% if courseSpec and courseSpec.template.id is not defined %}
                                <option disabled selected="selected" value="">Please Select</option>
                            {% endif %}
                            {% if templates.count > 1 or (courseSpec and courseSpec.template.id is not defined) %}
                                {% for template in templates %}
                                    {# only render the template if it is not deleted or if it is deleted and being used by the spec #}
                                    {% if not template.isDeleted or courseSpec and courseSpec.template.id ?? null == template.id %}
                                        <option value="{{ template.id }}" {% if courseSpec and courseSpec.template.id ?? null == template.id %}selected{% endif %}>{{ template.name }}{% if template.isDeleted %} (Deleted){% endif %}</option>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <option value="{{ templates.first.id }}" selected>{{ templates.first.name }}</option>
                            {% endif %}
                        </select>
                        <div class="alert-box warning hide icon-alert" data-template-warning>
                            Changing the course framework will merge content and affect how it displays on your homepages. New content may appear as a result of framework selection.
                        </div>
                    </div>

                    <div class="small-4 column">
                        <label for="subjectCode">
                            {{ locale.subject.proper }} Code
                            <input id="subjectCode" type="text" name="subjectCode" size="40" value="{{ courseSpec.subjectCode ?? '' }}" maxlength="20" />
                        </label>
                    </div>

                    {% if curriculumEnabled %}
                        <div class="small-12 column l-mar-m--bottom">
                            <label>Curriculum Codes</label>
                                {% include 'sub/curriculumCodeSelector.twig' with {
                                    renderButton: false,
                                    codeList:     curriculumCodes ?? []
                                } only %}
                        </div>
                    {% endif %}

                    {% if not courseSpec %}
                        <div data-mage-submitrow>
                            <div class="small-12 column">
                                {# Don't delete the inline style, it's needed -#}
                                <div data-mage-error style="display:none;" class="alert alert-box icon-alert"></div>
                            </div>
                            <div class="small-12 column">
                                <input name="part1" type="submit" class="button" value="Next" data-mage-next="unit-info"
                                       data-mage-working="Working..."
                                       formaction="{{ courseSpec ? routeLookup('course.updateCourse') : routeLookup('course.createCourse') }}"/>
                            </div>
                        </div>
                    {% endif %}
                </fieldset>
                <fieldset id="unit-info" class="content" data-mage="unit-info" {% if not courseSpec %} disabled="disabled"{% endif %}>
                    <legend>{{ locale.unit.properPlural }}</legend>
                    {# Don't delete the inline style, it's needed -#}
                    <div class="small-12 column no-pad"{% if not courseSpec %} style="display:none;"{% endif %} data-mage-collapsed>

                        <ul
                            {% if courseSpec %}
                                class="information-list unit-list sortable-card ui-sortable"
                                data-sortable
                                data-unit-list
                                data-action="{{ routeLookup('folder.postFolderSequence', {id: courseSpec.folder.id, folder: courseSpec.folder}) }}"
                            {% else %}
                                data-unit-list
                                class="information-list unit-list"
                            {% endif %}
                        >
                            {% if courseSpec %}
                            {% for unitSpec in courseSpec.units|sort((a,b) => b.folder.sequence <=> a.folder.sequence) %}
                                {% if folderAccess[unitSpec.folder.id] > 0 %}
                                    {% include '@course/unit.twig' with {
                                        unitSpec:         unitSpec,
                                        encodedReturnUrl: encodedReturnUrls[unitSpec.id],
                                        '_expanded':      false,
                                        '_writable':      folderAccess[unitSpec.folder.id] > 1,
                                        toastSelector:    '[data-relation="ajax-response"]'
                                    } only %}
                                {% endif %}
                            {% endfor %}
                            {% endif %}
                        </ul>
                        {# Enable UnitSpec creation if creating new Course, or write access to Course Folder #}
                        {% if not courseSpec or folderAccess[courseSpec.folder.id] > 1 %}
                            <div data-new-unit>
                                <div class="list-item">
                                    <div class="new-unit">
                                        <label for="newUnitName">{{ locale.unit.proper }} name</label>
                                        <div class="input-group">
                                            <input type="text" value="" placeholder="New {{ locale.unit }} name" id="new-unit-name" data-test="course-new-unit-name" name="newUnitName" maxlength="255" />
                                            <button name="spawn-unit"
                                                    class="button icon-add"
                                                    data-test="course-new-unit-add"
                                                    data-mage-next="spawn-unit"
                                                    data-mage-working="Working..."
                                                    formaction="{{ routeLookup('course.newUnit', { id: courseSpec ? courseSpec.Id : 0 }) }}"
                                            >Create {{ locale.unit.proper }}</button>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <div class="small-12 column">
                                        {# Don't delete the inline style, it's needed -#}
                                        <div data-mage-error style="display:none;" class="alert alert-box icon-alert"></div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        <!-- Notable absence: no [data-mage-submitrow] since this is the final section -->
                    </div>
                </fieldset>
            </section>

            {% if not courseSpec or folderAccess[courseSpec.folder.id] > 1 %}
                <div class="row" data-mage="unit-info">
                    {# Don't delete the inline style, it's needed -#}
                    <div class="small-12 column" {% if not courseSpec %}data-mage-collapsed style="display: none;"{% endif %}>
                        <input type="submit" value="Save Course" data-mage-working="Saving..." data-mage-next="main-course"/>
                    </div>
                </div>
            {% endif %}
        </form>
    </div>
</div>

<div class="toast" data-alert data-relation="ajax-response"></div>
