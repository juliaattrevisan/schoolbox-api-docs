{#
Usage:
    $data = [
        courseSpec:        CourseSpecification  -
        curriculumEnabled: bool                 - disable curriculum tagging ?
        folderAccess:      int[]                - indexed by folder.id
        encodedReturnUrls: string[]             - indexed by UnitSpec.id
        isValidFacultyRoot: bool                - is configured faculty root valid
    ]
#}

<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/shared/course/jquery.course-builder.js"></script>
<script type="text/javascript" src="/curriculum/javascript/jquery.curriculumSelector.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.mage.js"></script>
{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {

        $('[data-collapser]').collapsable();

        /**
         * Validation for the final save course form
         * (the other validation is done in each mage step below)
         */
        var modifyValidation = {
            rules: {
                name: "required",
                parent: "required",
                newUnitName: "oneUnit"
            },
            messages: {
                name: "Please enter a name for this course.",
                parent: "Please select a {{ locale.faculty }} or {{ locale.subject }} for this course."
            },
            onfocusout: false,
            onkeyup: false
        };

        $("#update-course-form").alaressValidate(modifyValidation);

        $('[data-unit-name]').each(function() {
            $(this).rules('add', {
                required: true,
                messages: {
                    required: "Please enter a name for this {{ locale.unit }}."
                }
            });
        });

        $.validator.addMethod('oneUnit', function() {
            return $('input[data-unit-name]').length;
        }, 'Please create at least one {{ locale.unit }} for this course.');


        // Mage Buttons
        var $mageNextButton = $('[data-mage-next="unit-info"]');
        var $mageCreateUnitButton = $('[data-mage-next="spawn-unit"]');
        var $mageSaveCourseButton = $('[data-mage-next="main-course"]');

        /**
         * Deletion of Units
         */
        $(document).on('click', '[data-action="delete-unit"]', function (e) {
            e.preventDefault();
            var $button = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you wish to delete this {{ locale.unit }}? This will also delete all Activities in the {{ locale.unit }}.',
                confirmEvent: function () {
                    $.post($button.attr('href'))
                        .done(function () {
                            var $listItem = $button.closest('[data-unit-spec]');
                            $listItem.slideUp(400, function () {
                                $listItem.detach();
                            });
                        });
                }
            });
        });

        /**
         * Course Parent selector popup
         */
        $('[data-course-parent-selector]').on('click', function (e) {
            e.preventDefault();

            $.magnificPopup.open({
                showCloseBtn: false,
                items: {
                    src: "<div class='preview loader'></div>",
                    type: 'inline'
                }
            });

            var $selector = $(this),
                target = $selector.data('source'),
                $input = $('[name="' + target + '"]');

            var modal = $('#parent-select');

            modal.foundation('reveal', 'open', '{{ routeLookup('course.parentList') }}/' + $("#parent").val()).one('click', '[data-selection]', function (e) {
                e.preventDefault();

                var $selection = $(this);

                // selector takes the name, input takes the ID
                $selector.addClass('icon-folder').text($selection.data('label'));
                $input.val($selection.data('selection'));

                modal.foundation('reveal', 'close');
            });
            $(document).on('opened.fndtn.reveal', '[data-reveal]', function () {
                $.magnificPopup.close();
            });
        });

        var noonitName = $('#noonit-name');

        // 'Next' Button
        $mageNextButton.mage({
            reenablePrevious: true,
            onXhrDone: function (data) {
                if (data.id) {
                    // Update the Browser URL
                    history.pushState(data, '', data['urlModifyCourse']);

                    // Update the DOM
                    $mageCreateUnitButton.attr('formaction', data['urlNewUnit']);
                    $mageSaveCourseButton.parents('form').attr('action', data['urlModifyCourse']);
                }
                // Remove the submit row
                $mageNextButton.closest('[data-mage-submitrow]').slideUp(400, function () {
                    $(this).detach();
                });
                $mageNextButton.mage('enable');

                // Show the 'New Unit' section
                $mageCreateUnitButton.closest('[data-mage-collapsed]').slideDown();

                // Display the 'Save Course' section
                $mageSaveCourseButton.closest('[data-mage-collapsed]').slideDown();

                // Reset validation
                $('#update-course-form').removeData('validator').alaressValidate(modifyValidation);
            },
            validateOptions: {
                rules: {
                    name: "required",
                    parent: "required"
                },
                messages: {
                    name: "Please enter a name for this course",
                    parent: "Please select a {{ locale.faculty }} or {{ locale.subject }} for this course"
                }
            }
        });

        // 'Create Unit' Button
        $mageCreateUnitButton.mage({
            reenablePrevious: true,
            submittable: '[data-unit-spec]',

            setFormData: function (formData) {
                formData.push({name: 'name', value: noonitName.val()});
            },

            onXhrDone: function (data) {
                var newDOM = $(data).hide();
                $(this).closest('[data-new-unit]').before(newDOM);
                newDOM.slideDown();
                newDOM.find('[data-collapser]').collapsable();
                noonitName.val('');
                $(this).val($(this).data('mage-reset')).removeAttr('readonly').removeData('mage-submitted');
                $(document).foundation();

                // Reset validation
                $('#update-course-form').removeData('validator').alaressValidate(modifyValidation);
            },

            validateOptions: {
                rules: {
                    newUnitName: "required"
                },
                messages: {
                    newUnitName: "Please enter a name for your new {{ locale.unit }}"
                }
            }
        });

        // Automatically expand the Unit specified in the URL hash
        if (window.location.hash) {
            var unitSpecId = window.location.hash.slice(1);
            $('[data-collapser=unit-' + unitSpecId + ']').trigger('click');
        }

    });
</script>
{% endautoescape %}

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('course.courseList') }}">Courses</a></li>
    <li class="active">
        {% if courseSpec.id %}
            <a href="{{ routeLookup('course.modifyCourse', { id: courseSpec.id }) }}">Modify Course</a>
        {% else %}
            <a href="{{ routeLookup('course.newCourse') }}">New Course</a>
        {% endif %}
    </li>
</ul>
<div class="row">
    <div class="small-12 actions-small-1 island">
        <div class="list-item">
            <h1>{{ courseSpec.id ? 'Modify' : 'New' }} Course</h1>
        </div>
        {% if courseSpec.id %}
            <nav>
                {% if courseSpec.folder.hasHomepage %}
                    <a class="icon-home" href="/homepage/{{ courseSpec.folder.id }}" title="View Homepage"></a>
                {% else %}
                    <a class="icon-folder" href="/resources/{{ courseSpec.folder.id }}" title="View Resources"></a>
                {% endif %}
            </nav>
        {% endif %}
    </div>
</div>
<div class="row">
    <div class="small-12 island" id="main-course">
        <form method="post" action="{{ routeLookup('course.updateCourse', {id: courseSpec.id}) }}" id="update-course-form">
            <section>
                <fieldset class="content" data-mage="course-info">
                    <legend>Course Information</legend>
                    <div class="small-12 column">
                        <label>Name
                            <input type="text"
                                   name="name"
                                   value="{{ courseSpec.folder.name }}"
                                   placeholder="What's this course called?"
                                   required
                                   maxlength="255"
                            />
                        </label>
                    </div>
                    <div class="small-12 column">
                        <label>
                            {{ locale.faculty.proper }} / {{ locale.subject.proper }}

                            <a data-course-parent-selector data-source="parent"
                               title="Click to change the {{ locale.faculty }} / {{ locale.subject }} this course belongs to"
                               class="source-select icon-folder"
                               href="#" >
                                {{ courseSpec.id ? courseSpec.folder.parent.name : '(Click to select)' }}
                            </a>
                            <input type="hidden" name="parent" id="parent" value="{{ courseSpec.folder.parent.id }}" />
                        </label>
                    </div>

                    {% if not isValidFacultyRoot %}
                    <div class="small-12 column">
                        <div data-alert="" class="alert-box warning">
                            <p>
                            <strong>Warning</strong>: The configured faculty folder is invalid and the system has fallen back to the top-level folder.<br>
                            <br>Please
                            {% if USER.isSuperuser %}
                                <a href="/adminv2/setting/LMS+Policy#course_homepage">configure a valid faculty root</a> in the Administration system.
                            {% else %}
                                ask your System Administrator to configure a valid faculty root
                            {% endif %}
                            </p>
                        </div>
                    </div>
                    {% endif %}

                    {% if curriculumEnabled %}
                        <div class="small-12 column">
                            <label>Curriculum Codes
                                {% include 'sub/curriculumCodeSelector.twig' with {
                                    renderButton: false,
                                    codeList:     courseSpec.folder.curriculumNodes
                                } only %}
                            </label>
                        </div>
                    {% endif %}

                    {% if not courseSpec.id %}
                        <div data-mage-submitrow>
                            <div class="small-12 medium-8 column">
                                {# Don't delete the inline style, it's needed -#}
                                <p data-mage-error style="display:none;" class="alert alert-box icon-alert"></p>
                            </div>
                            <div class="small-12 medium-4 column">
                                <input name="part1" type="submit" class="button" value="Next" data-mage-next="unit-info"
                                       data-mage-working="Working..."
                                       formaction="{{ courseSpec.id ? routeLookup('course.updateCourse') : routeLookup('course.createCourse') }}"/>
                            </div>
                        </div>
                    {% endif %}
                </fieldset>
                <fieldset id="unit-info" class="content" data-mage="unit-info" {% if not courseSpec.id %} disabled="disabled"{% endif %}>
                    <legend>{{ locale.unit.properPlural }}</legend>
                    {# Don't delete the inline style, it's needed -#}
                    <div class="small-12 column no-pad"{% if not courseSpec.id %} style="display:none;"{% endif %} data-mage-collapsed>
                        <ul class="information-list">
                            {% for unitSpec in courseSpec.units %}
                                {% if folderAccess[unitSpec.folder.id] > 0 %}
                                    {% include '@course/unit.twig' with {
                                        unitSpec:         unitSpec,
                                        encodedReturnUrl: encodedReturnUrls[unitSpec.id],
                                        '_expanded':      false,
                                        '_writable':      folderAccess[unitSpec.folder.id] > 1,
                                        toastSelector:    '[data-relation="ajax-response"]'
                                    } only %}
                                {% endif %}
                            {% endfor %}

                            {# Enable UnitSpec creation if creating new Course, or write access to Course Folder #}
                            {% if not courseSpec.id or folderAccess[courseSpec.folder.id] > 1 %}
                                <li class="actions-small-1" data-new-unit>
                                    <div class="list-item content">
                                        <div class="small-1 column">
                                            <span class="icon-add course-new-unit-icon"></span>
                                        </div>
                                        <div class="small-11 column">
                                            <label>
                                                <input type="text" value="" placeholder="New Unit" id="noonit-name" name="newUnitName" maxlength="255"/>
                                            </label>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="small-12 medium-8 column">
                                            {# Don't delete the inline style, it's needed -#}
                                            <p data-mage-error style="display:none;" class="alert alert-box icon-alert"></p>
                                        </div>
                                        <div class="small-12 medium-4 column">
                                            <input name="spawn-unit" type="submit" class="button" value="Create {{ locale.unit.proper }}"
                                                   data-mage-next="spawn-unit" data-mage-working="Working..."
                                                   formaction="{{ routeLookup('course.newUnit', { id: courseSpec.Id }) }}"/>
                                        </div>
                                    </div>
                                </li>
                            {% endif %}
                        </ul>
                        <!-- Notable absence: no [data-mage-submitrow] since this is the final section -->
                    </div>
                </fieldset>
            </section>
            {% if not courseSpec.id or folderAccess[courseSpec.folder.id] > 1 %}
                <div class="row" data-mage="unit-info">
                    {# Don't delete the inline style, it's needed -#}
                    <div class="small-12 column" {% if not courseSpec.id %}data-mage-collapsed style="display: none;"{% endif %}>
                        <input type="submit" name="submit" value="Save Course" data-mage-working="Saving..." data-mage-next="main-course"/>
                    </div>
                </div>
            {% endif %}
        </form>
    </div>
</div>
<div id="parent-select" data-reveal class="reveal-modal"></div>

<div class="toast" data-alert data-relation="ajax-response"></div>

