<li class="actions-small-1 actions-large-2">
    <div class="list-item">
        <div class="grip"></div>
        <div class="small avatar card small-11 wrap-down">
            <a href="#">
                <div class="icon-{{ icon | replace(' ', '-') }} icon-16"></div>
                <h3>What did you learn from today's reading?</h3>
                <p class="meta">{{ icon | title }}</p>
            </a>
        </div>
    </div>
    <nav>
        <span class="show-for-large-up">
            <a href="#" class="icon-modify" title="Modify"></a>
            <a href="#" class="icon-delete" title="Delete"></a>
        </span>
        <span class="hide-for-large-up">
            <a href="#" class="icon-overflow"></a>
        </span>
    </nav>
</li>
