<li class="actions-small-1 actions-large-2">
    <div class="list-item">
        <div class="grip"></div>
        <div class="small avatar card small-11 wrap-down">
            <div class="{{ task.iconClass }} icon-16"></div>
            <p>{{ task.title }}</p>
            <p class="meta">{{ task.label }}</p>
        </div>
    </div>
    <nav>
        <span class="show-for-large-up">
            <a href="/task/modify/{{ task.id }}" class="icon-modify" title="Modify"></a>
            <a href="/task/delete/{{ task.id }}" class="icon-delete" title="Delete"></a>
        </span>
        <span class="hide-for-large-up">
            <a href="#" class="icon-overflow"></a>
        </span>
    </nav>
</li>
