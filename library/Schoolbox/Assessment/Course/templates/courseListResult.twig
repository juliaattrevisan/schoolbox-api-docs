{#
This template is used in two different scenarios.
1. CourseSpec List page
2. CourseSpec Modal Selector

In the first case, clicking the name of a CourseSpec should take you to the CourseSpec Modify page
In the latter case, it should take the user to the Course Import page

Usage:
    {% include '@course/courseListResult.twig' with {
         folderAccess       array                - Access perm indexed by course.folder.id
         courseSpec:        CourseSpecification
         folder.id:         int | null           - optional folder to insert in import links
         linkToUnits:       bool                 - does title link to CourseSpec modify or Import Course page
         component.id:      int | null
         cparents:          Folder[]
         hasTot:            bool
         collapsePrefix:    string | null
         returnUrlKey:      returnUrlKey
         encodedReturnUrl:  encodedReturnUrl
    } only %}
#}
{% set collapsePrefix = collapsePrefix ?: 'course' %}

{% set importUrl = routeLookupIfAuthorized('courseImport.getImport', {
    courseSpecId: courseSpec.id ?: 0,
    folderId:     folder.id ?? 0,
    componentId:  component.id ?? 0
}) %}

{% if encodedReturnUrl | length %}
    {% if importUrl %}
        {% set importUrl = importUrl ~ '?' ~ returnUrlKey ~ '=' ~ encodedReturnUrl %}
    {% endif %}
{% endif %}

{% set unitPlannerUrl = routeLookupIfAuthorized('coursePlan.getPlan', {id: courseSpec.id, course: courseSpec }) %}

{# Where should CourseSpec title link point ? #}
{% set titleUrl = linkToUnits
        ? unitPlannerUrl
        : importUrl
%}


{% if hasTot %}
<li class="actions-small-2" data-course-row>
{% else %}
<li class="actions-small-1">
{% endif %}
    <div class="list-item">
        <div class="card small-12">
            {% if titleUrl %}
                {# Importing a course (no Tot) or You have READ permission in the Unit Planner page
                 #}
                <a href="{{ titleUrl }}" data-course-link data-course-id="{{ courseSpec.id }}" data-course-name="{{ courseSpec.folder.name }}" data-component-id="{{ component ? component.id : 0 }}">
                    <div class="icon-course"></div>
                    <h3 data-test="course-list-{{ courseSpec.folder.name }}">{{ courseSpec.folder.name }}</h3>
                </a>
            {% else %}
                {# You don't have permission to the unit planner or import course page
                 # Just show a readonly representation of the course so you know it exists
                 # and hide the tot menu option
                 #}
                <sbx-icon name="course"></sbx-icon>
                <h3>{{ courseSpec.folder.name }}</h3>
            {% endif %}

            <p class="meta">
                {% if cparents|length %}
                {{ cparents[0].name }}
                    {% for cparent in cparents | slice(1) %}
                &gt; {{ cparent.name }}
                    {% endfor %}
                {% endif %}
            </p>
        </div>
        <div class="small-12 column hide" data-collapse-state="collapsed" data-collapsable="{{ collapsePrefix }}-{{ courseSpec.id }}">
            <ul class="unit-list">
                    {% for unit in courseSpec.units|sort((a,b) => b.folder.sequence <=> a.folder.sequence) %}
                <li>
                    <div class="tiny card small-12">
                        {% if linkToUnits %}
                    <a title="Visit {{ unit.folder.name }} homepage" href="/homepage/{{ unit.folder.id }}" class="sbx-button--has-icon course-unit-link--meta"><sbx-icon name="unit"></sbx-icon>{{ unit.folder.name }}</a>
                        {% else %}
                            <sbx-icon name="unit"></sbx-icon> {{ unit.folder.name }}
                        {% endif %}
                    </div>
                </li>
                    {% endfor %}
            </ul>
        </div>
    </div>
    <nav>
        <a href="#" class="sbx-icon-only-button" data-collapser="{{ collapsePrefix }}-{{ courseSpec.id }}" data-test="course-list-arrow-{{ courseSpec.folder.name }}">
            <sbx-icon name="down-arrow"></sbx-icon>
        </a>
        {% if hasTot %}
        <sbx-pop-out content-id="courseDropdown-{{ courseSpec.id }}" data-test="sbx-pop-out-courseDropdown-{{ courseSpec.id }}"></sbx-pop-out>
        {% endif %}
    </nav>

    {% if hasTot %}
    <ul class="f-dropdown" data-dropdown-content id="courseDropdown-{{ courseSpec.id }}">
        {% if importUrl %}
            <li>
                <a href="{{ importUrl }}" class="sbx-button--has-icon" data-test="course-list-import-{{ courseSpec.folder.name }}"><sbx-icon name="download"></sbx-icon>Import into {{ locale.class.properPlural }}</a>
            </li>
        {% endif %}
        <li>
        {% if courseSpec.folder.hasHomepage %}
            <a href="/homepage/{{ courseSpec.folder.id }}/" class="sbx-button--has-icon" data-test="course-list-homepage-{{ courseSpec.folder.name }}"><sbx-icon name="home"></sbx-icon>Course Homepage</a>
        {% else %}
            <a href="/resources/{{ courseSpec.folder.id }}/" class="sbx-button--has-icon"><sbx-icon name="folder"></sbx-icon>Course Resources</a>
        {% endif %}
        </li>
        <li><a href="{{ routeLookup('rubricManager.getForm', { folderId: courseSpec.folder.id }) }}" class="sbx-button--has-icon" data-test="course-list-rubric-{{ courseSpec.folder.name }}"><sbx-icon name="criteria"></sbx-icon>Manage Rubric {{ locale.rubricGroup.properPlural }}</a></li>

        {% set courseMarkbookRoute = routeLookupIfAuthorized('courseMarkbook.getMarkbook', {courseSpec: courseSpec, courseSpecId: courseSpec.id}) %}
        {% if courseMarkbookRoute %}<li><a href="{{ courseMarkbookRoute }}" class="sbx-button--has-icon" data-test="course-list-markbook-{{ courseSpec.folder.name }}"><sbx-icon name="curriculum"></sbx-icon>Course Markbook</a></li>{% endif %}
        <li><a href="{{ routeLookup('learningAnalytics.course', {courseSpecId: courseSpec.id}) }}" class="sbx-button--has-icon" data-test="course-list-analytics-{{ courseSpec.folder.name }}"><sbx-icon name="poll"></sbx-icon>Learning Analytics</a></li>

        {% set assessmentCalendarUrl = routeLookupIfAuthorized('learningAssessmentCalendar.getReport') %}
        {% if assessmentCalendarUrl %}
            <li>
                <a href="{{ assessmentCalendarUrl~'?course='~courseSpec.id }}" class="sbx-button--has-icon" data-test="course-list-calendar-{{ courseSpec.folder.name }}"><sbx-icon name="calendar"></sbx-icon>{{ locale.assessment|capitalize }} Calendar</a>
            </li>
        {% endif %}

        {% if unitPlannerUrl %}
            <li><a href="{{ unitPlannerUrl }}" class="sbx-button--has-icon" data-test="course-list-planner-{{ courseSpec.folder.name }}"><sbx-icon name="project"></sbx-icon>Unit Planner</a></li>
        {% endif %}
        {% set curriculumCoverageUrl = routeLookupIfAuthorized('curriculumreports.getCoverage') %}
        {% if curriculumCoverageUrl %}
        <li>
            <a href="/curriculum/reports/coverage?courseId={{ courseSpec.id }}" class="sbx-button--has-icon" data-test="course-list-report-{{ courseSpec.folder.name }}"><sbx-icon name="report"></sbx-icon>Curriculum Coverage</a>
        </li>
        {% endif %}
        {% if folderAccess[courseSpec.folder.id] ?? false %}
            {% set modifyCourseUrl = routeLookupIfAuthorized('course.modifyCourse', {id: courseSpec.id, course: courseSpec }) %}
            {% if modifyCourseUrl %}
                <li><a href="{{ modifyCourseUrl }}" class="sbx-button--has-icon" data-test="course-list-modify-{{ courseSpec.folder.name }}"><sbx-icon name="modify"></sbx-icon>Modify</a></li>
            {% endif %}
        {% endif %}

        {# Course delete: standard folder delete -#}
        {% if USER.isSuperuser() %}
        <li><a href="{{ routeLookup('course.deleteCourseSpecification', {id: courseSpec.id}) }}" class="sbx-button--has-icon" data-course-delete-id="{{ courseSpec.id }}" data-action="course-delete" data-test="course-list-delete-{{ courseSpec.folder.name }}"><sbx-icon name="delete"></sbx-icon>Delete</a></li>
        {% endif %}
    </ul>
    {% endif %}
</li>
