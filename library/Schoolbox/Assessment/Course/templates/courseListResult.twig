{#
This template is used in two different scenarios.
1. CourseSpec List page
2. CourseSpec Modal Selector

In the first case, clicking the name of a CourseSpec should take you to the CourseSpec Modify page
In the latter case, it should take the user to the Course Import page

Usage:
    {% include '@course/courseListResult.twig' with {
         folderAccess       array                - Access perm indexed by course.folder.id
         courseSpec:        CourseSpecification
         folder.id:         int | null           - optional folder to insert in import links
         linkToUnits:       bool                 - does title link to CourseSpec modify or Import Course page
         component.id:      int | null
         cparents:          Folder[]
         hasTot:            bool
         collapsePrefix:    string | null
         returnUrlKey:      returnUrlKey
         encodedReturnUrl:  encodedReturnUrl
    } only %}
#}
{% set collapsePrefix = collapsePrefix ?: 'course' %}

{% set importUrl = routeLookup('courseImport.getImport', {
    courseSpecId: courseSpec.id ?: 0,
    folderId:     folder.id ?? 0,
    componentId:  component.id ?? 0
}) %}

{% if encodedReturnUrl | length %}
    {% set importUrl = importUrl ~ '?' ~ returnUrlKey ~ '=' ~ encodedReturnUrl %}
{% endif %}

{# Where should CourseSpec title link point ? #}
{% set titleUrl = linkToUnits
        ? routeLookup('course.modifyCourse', { id: courseSpec.id })
        : importUrl
%}


{% if hasTot %}
<li class="actions-small-2" data-course-row>
{% else %}
<li class="actions-small-1">
{% endif %}
    <div class="list-item">
        <div class="card small-12">
            {% if folderAccess[courseSpec.folder.id] ?? false %}
                {# You have WRITE permission in the Course Folder homepage
                 # Course title links to modify scren; you have a tot option to do the same
                 #}
                <a href="{{ titleUrl }}" data-course-id="{{ courseSpec.id }}" data-course-name="{{ courseSpec.folder.name }}" data-component-id="{{ component ? component.id : 0 }}">
                    <div class="icon-course"></div>
                    <h3>{{ courseSpec.folder.name }}</h3>
                </a>
            {% else %}
                {# You don't have WRITE permission in the Course Folder homepage
                 # Just show a readonly representation of the course so you know it exists
                 # and hide the tot menu option
                 #}
                <div class="icon-course"></div>
                <h3>{{ courseSpec.folder.name }}</h3>
            {% endif %}

            <p class="meta">
                {% if cparents|length %}
                {{ cparents[0].name }}
                    {% for cparent in cparents | slice(1) %}
                &gt; {{ cparent.name }}
                    {% endfor %}
                {% endif %}
            </p>
        </div>
        <div class="small-12 column hide" data-collapse-state="collapsed" data-collapsable="{{ collapsePrefix }}-{{ courseSpec.id }}">
            <ul class="unit-list">
                    {% for unit in courseSpec.units %}
                <li>
                    <div class="tiny card small-12">
                        {% if linkToUnits %}
                    <a title="Visit {{ unit.folder.name }} homepage" href="/homepage/{{ unit.folder.id }}"><div class="icon-unit"></div>{{ unit.folder.name }}</a>
                        {% else %}
                            <div class="icon-unit"></div>{{ unit.folder.name }}
                        {% endif %}
                    </div>
                </li>
                    {% endfor %}
            </ul>
        </div>
    </div>
    <nav>
        <a href="#" class="icon-down-arrow" data-collapser="{{ collapsePrefix }}-{{ courseSpec.id }}"></a>
            {% if hasTot %}
        <a href="#" class="icon-overflow" data-options="align:top" data-dropdown="courseDropdown-{{ courseSpec.id }}" aria-expanded="false" title="Actions"></a>
            {% endif %}
    </nav>

    {% if hasTot %}
    <ul class="f-dropdown" data-dropdown-content id="courseDropdown-{{ courseSpec.id }}">
        <li>
            <a href="{{ importUrl }}" class="icon-download">Import into classes</a>
        </li>
        <li>
        {% if courseSpec.folder.hasHomepage %}
            <a href="/homepage/{{ courseSpec.folder.id }}/" class="icon-home">Course Homepage</a>
        {% else %}
            <a href="/resources/{{ courseSpec.folder.id }}/" class="icon-folder">Course Resources</a>
        {% endif %}
        </li>
        <li><a href="{{ routeLookup('rubricManager.getForm', { folderId: courseSpec.folder.id }) }}" class="icon-criteria">Manage Rubric {{ locale.rubricGroup.properPlural }}</a></li>

        {% set courseMarkbookRoute = routeLookupIfAuthorized('courseMarkbook.getMarkbook', {courseSpec: courseSpec, courseSpecId: courseSpec.id}) %}
        {% if courseMarkbookRoute %}<li><a href="{{ courseMarkbookRoute }}" class="icon-curriculum">Course Markbook</a></li>{% endif %}
        <li><a href="{{ routeLookup('learningAnalytics.course', {courseSpecId: courseSpec.id}) }}" class="icon-poll">Learning Analytics</a></li>

        {% set assessmentCalendarUrl = routeLookupIfAuthorized('learningAssessmentCalendar.getReport') %}
        {% if assessmentCalendarUrl %}
            <li>
                <a href="{{ assessmentCalendarUrl~'?course='~courseSpec.id }}" class="icon-calendar">{{ locale.assessment|capitalize }} Calendar</a>
            </li>
        {% endif %}

        {# Check if you have WRITE access into the Course Folder's homepage
         # If you do, provide a Modify link so you can edit its contents
         # Otherwise, omit the link entirely
         #}
        {% if folderAccess[courseSpec.folder.id] ?? false %}
        <li><a href="{{ routeLookup('course.modifyCourse', {id: courseSpec.id}) }}" class="icon-modify">Modify</a></li>
        {% endif %}

        {# Course delete: standard folder delete -#}
        {% if USER.isSuperuser() %}
        <li><a href="{{ routeLookup('course.deleteCourseSpecification', {id: courseSpec.id}) }}" class="icon-delete" data-course-delete-id="{{ courseSpec.id }}" data-action="course-delete">Delete</a></li>
        {% endif %}
    </ul>
    {% endif %}
</li>
