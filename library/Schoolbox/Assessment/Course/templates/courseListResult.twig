{% set cparents = lineage[course.id] %}
{% set collapsePrefix = collapsePrefix ?: 'course' %}
{% set linkhref =
    folder.id
        ? routeLookup('course.import', { courseId: course.id, classCode: folder.id, componentId: component.id })
        : routeLookup('course.modifyCourse', { id: course.id })
%}

    {% if hasTot %}
<li class="actions-small-2">
    {% else %}
<li class="actions-small-1">
    {% endif %}

    <div class="list-item">
        <div class="compact card small-12">
            <a href="{{ linkhref }}" data-course-id="{{ course.id }}" data-course-name="{{ course.folder.name }}" data-component-id="{{ component.id }}">
                <div class="icon-course icon-16"></div>
                <h3>{{ course.folder.name }}</h3>
            </a>
            <p class="meta">
                {{ cparents[0].name }}
                    {% for cparent in cparents | slice(1) %}
                &gt; {{ cparent.name }}
                    {% endfor %}
            </p>
        </div>
        <div class="small-12 column hide" data-collapse-state="collapsed" data-collapsable="{{ collapsePrefix }}-{{ course.id }}">
            <ul class="unit-list">
                    {% for unit in course.units %}
                <li>
                    <div class="tiny card small-12">
                        {% if linkToUnits %}
                    <a title="Visit {{ unit.folder.name }} homepage" href="/homepage/{{ unit.folder.id }}"><div class="icon-unit"></div>{{ unit.folder.name }}</a>
                        {% else %}
                            <div class="icon-unit"></div>{{ unit.folder.name }}
                        {% endif %}
                    </div>
                </li>
                    {% endfor %}
            </ul>
        </div>
    </div>
    <nav>
        <a href="#" class="icon-down-arrow" data-collapser="{{ collapsePrefix }}-{{ course.id }}"></a>
            {% if hasTot %}
        <a href="#" class="icon-overflow" data-dropdown="courseDropdown-{{ course.id }}" aria-expanded="false" title="Actions"></a>
            {% endif %}
    </nav>

        {% if hasTot %}
    <ul class="f-dropdown" data-dropdown-content id="courseDropdown-{{ course.id }}">
        <li>
            {% if course.folder.hasHomepage %}
                <a href="/homepage/{{ course.folder.id }}/" class="icon-home">Course Homepage</a>
            {% else %}
                <a href="/resources/{{ course.folder.id }}/" class="icon-folder">Course Resources</a>
            {% endif %}
        </li>
        <li><a href="{{ routeLookup('course.modifyCourse', {id: course.id}) }}" class="icon-modify">Modify</a></li>

            {# Course delete: standard folder delete -#}
            {% if currentUser.isSuperuser() %}
        <li><a href="{{ routeLookup('course.deleteCourseSpecification', {id: course.id}) }}" class="icon-delete" data-course-delete-id="{{ course.id }}" data-action="course-delete">Delete</a></li>
            {% endif %}

    </ul>
        {% endif %}
</li>
