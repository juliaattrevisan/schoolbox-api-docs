<script type="text/javascript" src="/javascript/shared/course/jquery.course-selector.js"></script>
<script type="text/javascript">
    $(function() {

        /* Attach Course Selector Modal listeners
         */
        $.fn.courseSelectorModal({
            courseSelector: {
                query: {
                    folder: {{ folder.id }}
                }
            }
        });

        $('#courseList').find('[data-delete]').click(function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Course?',
                confirmLabel: 'Yes, permanently delete',
                cancelLabel: 'No, keep it',
                confirmEvent: function() {
                    $.post('/course/delete', {courseId: element.attr('data-delete')}, function(responseText) {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="/homepage/{{ folder.id }}">{{ folder.name }}</a></li>
    <li class="active">
        <a href="{{ routeLookup('course.management', { folderId: folder.id }) }}">Modify Course</a>
    </li>
</ul>
<div class="row">
    <div class="small-12 island">
        <h1>Course Management</h1>
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Courses for {{ folder.name }}</h2>
                </div>
            </div>
            <nav>
                <a href="{{ routeLookup('course.import', { courseId: 0, classCode: folder.id }) }}" class="icon-add" title="Link to Course" data-course-selector></a>
            </nav>
        </div>

        {% if allCourses|length %}
        <section>
            <ul class="action-list" id="courseList">
                {% for currentCourse in allCourses %}
                {% set courseComponentId = allCourseComponentIds[currentCourse.id].componentId %}
                {% set courseParents = lineage[currentCourse.id] %}

                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 info card">
                            <h3>{{ currentCourse.name }}</h3>
                            <p class="meta">
                                {{ courseParents[0].name }}
                                {% for courseParent in courseParents | slice(1) %}
                                    &gt; {{ courseParent.name }}
                                {% endfor %}
                            </p>

                        </div>
                    </div>
                    <nav>
                        {% if allCourseComponentIds[currentCourse.id].restorable %}
                            <a href="{{ routeLookup('course.restoreCourse', { folderId: folder.id, componentId: courseComponentId }) }}" class="icon-upload" title="Restore Course"></a>
                        {% endif %}
                        <a href="{{ routeLookup('course.importModify', { componentId: courseComponentId }) }}" class="icon-modify" title="Modify Course"></a>
                        <a href="" class="icon-delete" title="Delete Course" data-delete="{{ currentCourse.id }}"></a>
                    </nav>
                </li>
                {% endfor %}
            </ul>
        </section>

        {% else %}

        <section>
            <div class="content">
                <p>There are no Courses associated with this homepage.</p>
            </div>
        </section>

        <a href="{{ routeLookup('course.import', { courseId: 0, classCode: folder.id }) }}" class="button submit expand">Import a Course</a>
        {% endif %}
    </div>
</div>

<div id="course-selector-modal" class="reveal-modal" data-reveal></div>
