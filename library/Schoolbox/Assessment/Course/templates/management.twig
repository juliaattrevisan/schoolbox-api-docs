<div class="row">
    <div class="small-12 columns">
        <h1>Course Management</h1>
        <ul class="meta">
            <li class="icon-home"><a href="/homepage/{{ folder.id }}">{{ folder.name }}</a></li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="small-12 island">

        {% if allCourses|length %}
        <section>
            <ul class="action-list">
                {% for currentCourse in allCourses %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 info card">
                            <a href="#" title="">
                                <h3>{{ currentCourse.name }}</h3>
                            </a>
                        </div>
                    </div>
                    <nav>
                        <a href="" class="icon-modify" title="Modify Course"></a>
                        <a href="" class="icon-upload" title="Restore Course"></a>
                        <a href="" class="icon-delete" title="Delete Course"></a>
                    </nav>
                </li>
                {% endfor %}
            </ul>
        </section>

        {% else %}

        <section>
            <div class="content">
                <p>There are no Courses associated with this homepage.</p>
            </div>
        </section>

        <a href="/course/import/0/class/{{ folder.id }}" class="button submit expand">Import a Course</a>
        {% endif %}
    </div>
</div>
