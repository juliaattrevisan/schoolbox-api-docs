{#
Usage:
    $data = [
        folder:           Folder                               - The class page we are managing
        courseImpls:      CourseImplementation[]|Collection    - All Course's imported to this class
        componentNames:   string[][]                           - CourseOutline component names, grouped by CourseImpl.ID
        folderAncestry:   Folder[][]                           - Grouped by CourseImpl.ID
        returnUrlName:    string                               - (optional) GET name
        encodedReturnUrl: string                               - (optional) GET value
    ]
#}


{% autoescape 'js' %}
<script type="text/javascript" xmlns="http://www.w3.org/1999/html">
    $(function() {
        /* Attach Course Selector Modal listeners
         */
        $.fn.courseSelectorModal({
            courseSelector: {
                query: {
                    folder:           Number('{{ folder.id }}'),
                    hasAdd:           false,
                    hasTot:           false,
                    linkToUnits:      false,
                    encodedReturnUrl: "{{ encodedReturnUrl | escape('js') }}"
                }
            }
        });

        var $courseList = $('#course_list');
        var $emptyState = $('[data-empty-state]');

        // CourseImpl Deletion
        $courseList.on('click','[data-delete]', function(event) {
            event.preventDefault();

            var $element = $(this);
            var $courseImpl = $element.closest('[data-course-impl]');
            var name = $courseImpl.find('[data-course-impl-name]').html();

            $element.confirmDialog({
                header: 'Confirm Import Deletion of ' + name,
                format: 'html',
                text: 'Are you sure you want to delete your import of ' + name + '? All tasks, {{ locale.dueWork }} and quizzes ' +
                'you have imported via this course, <em>as well as any you have created on it since</em>, will be ' +
                'permanently deleted from this class. The original course will be unaffected.'
                + '<br/><br/><strong><em>This is an irreversible operation.</em></strong>',
                confirmLabel: 'Yes, permanently delete',
                cancelLabel: 'No, keep it',
                confirmEvent: function() {

                    // A toast
                    var $toast = $('[data-alert]');
                    $toast.toastActivate({text: 'Deleting course...'});

                    var url = $element[0].href;
                    var settings = {
                        headers: {
                            'X-HTTP-Method-Override': 'DELETE'
                        },
                        type: 'POST',
                        success: function(resp) {
                            if(resp.data){
                                // Toast success
                                $toast.toastTimeout({text: 'Course deleted.', css: 'success'});
                                $courseImpl.slideUp({
                                    done: function(){
                                        $courseImpl.remove();
                                        if(!$courseList.find('[data-course-impl]').length){
                                            $emptyState.removeClass('hide');
                                        }
                                    }
                                });
                            }
                        },
                        error: function(resp) {
                            $toast.toastTimeout({text: 'Delete failed.', css: 'alert'});
                        }
                    };
                    $.ajax(url, settings);
                }
            });
        });




        // CourseImpl's CourseOutlineComponent Restoration
        $courseList.on('click', '[data-restore-course]', function(event) {
            event.preventDefault();
            var $restoreButton = $(this);
            var $courseImpl = $restoreButton.closest('[data-course-impl]');
            var $componentList = $courseImpl.find('[data-component-names]');
            var $icon = $courseImpl.find('[data-course-impl-icon]');
            var $name = $courseImpl.find('[data-course-impl-name]');
            var $restoreFeedback = $('[data-relation="save-label"]');

            $restoreFeedback.toastActivate({text: 'Restoring Component...'});

            $.post($restoreButton[0].href, function(data) {
                if ('success' == data.result) {
                    $restoreFeedback.toastTimeout({text: 'Component Restored!', css: 'success'});
                    $restoreButton.remove();
                    $icon.removeClass('icon-archive').addClass('icon-course');
                    $name.removeClass('del');

                    $componentList.removeClass('hide');
                    /** @var string data.componentName */
                    $componentList.html($componentList.html() + data.componentName);
                }
                else {
                    $restoreFeedback.toastTimeout({text: 'Restoration Failed!', css: 'alert'});
                }
            });
        });
    });
</script>
{% endautoescape %}


<ul class="breadcrumb">
    <li><a href="/learning/classes">Learning</a></li>
    <li><a href="/homepage/{{ folder.id }}">{{ folder.title }}</a></li>
    <li class="active">
        <a href="{{ routeLookup('courseImport.getManagement', { folderId: folder.id }) }}">Modify Course</a>
    </li>
</ul>
<div class="row">
    <div class="small-12 island">
        <h1>Course Management</h1>
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Courses Imported to {{ folder.title }}</h2>
                </div>
            </div>
            <nav>
                <a href="{{ routeLookup('courseImport.getImport', { courseSpecId: 0, folderId: folder.id }) }}" class="icon-add" title="Import Course" data-course-selector></a>
            </nav>
        </div>

        {% if courseImpls | length %}
        <section>
            <ul class="action-list" id="course_list">
                {% for currentCourse in courseImpls %}
                <li class="actions-small-1" data-course-impl="{{ currentCourse.id }}">
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="/homepage/{{ currentCourse.specification.folder.id }}">
                                <h3>
                                    {% if not componentNames[currentCourse.id] | length %}
                                        <span class="icon-archive" data-course-impl-icon></span> <span class="del" data-course-impl-name>{{ currentCourse.specification.folder.name }}</span>
                                    {% else %}
                                        <span class="icon-course" data-course-impl-icon></span> <span data-course-impl-name>{{ currentCourse.specification.folder.name }}</span>
                                    {% endif %}
                                </h3>
                            </a>
                            <p class="meta">
                                {% for folderCrumb in folderAncestry[currentCourse.id] %}
                                    {{ folderCrumb.name }}{% if not loop.last and not loop.first %} &raquo;{% endif %}
                                {% endfor %}
                            </p>
                            <p class="meta">Imported on {{ currentCourse.createdAt.long }}</p>
                            <p class="meta{% if not componentNames[currentCourse.id] | length %} hide{% endif %}" data-component-names>Displayed in
                                {% for componentName in componentNames[currentCourse.id] %}
                                    {{ componentName }}{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </p>
                        </div>
                    </div>
                    <nav>
                        <a href="#" class="icon-overflow" data-dropdown="courseDropdown-{{ currentCourse.id }}" aria-expanded="false" title="Actions"></a>
                    </nav>
                    <ul class="f-dropdown" data-dropdown-content="" id="courseDropdown-{{ currentCourse.id }}">
                        {% if not componentNames[currentCourse.id] %}
                            <li>
                                <a href="{{ routeLookup('courseImport.restoreCourse', { courseImplId: currentCourse.id }) }}" class="icon-undo" title="Restore Component" data-restore-course="{{ currentCourse.name }}" data-restore-folder="{{ folder.id }}" data-restore-component="{{ courseComponentId }}">Restore Component</a>
                            </li>
                        {% endif %}
                        <li>
                            <a
                                href="{{ routeLookup('courseImport.getModify', {courseImplId: currentCourse.id}) }}?{{ returnUrlName }}={{ encodedReturnUrl }}"
                                class="icon-modify"
                                title="Modify Import"
                            >Modify</a>
                        </li>
                        <li>
                            <a href="{{ routeLookup('courseImport.importDelete', { courseImplId: currentCourse.id }) }}" class="icon-delete" title="Permanently Delete Import" data-delete>Delete</a>
                        </li>
                    </ul>

                </li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}


        <div class="empty-state{% if courseImpls|length %} hide{% endif %}" data-empty-state>
            <i class="icon-course"></i>
            <p>
                There are no courses associated with this homepage, but you can
                <a
                    href="{{ routeLookup('courseImport.getImport', { courseSpecId: 0, folderId: folder.id }) }}"
                    data-course-selector
                >import one</a>.
            </p>
        </div>

    </div>
</div>

<div class="toast" data-alert data-relation="save-label"></div>

<div id="course-selector-modal" class="reveal-modal" data-reveal></div>
