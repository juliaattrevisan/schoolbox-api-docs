<script type="text/javascript" xmlns="http://www.w3.org/1999/html">
    $(function() {

        /* Attach Course Selector Modal listeners
         */
        $.fn.courseSelectorModal({
            courseSelector: {
                query: {
                    folder: {{ folder.id }}
                }
            }
        });

        var $courseList = $('#course_list');
        var $emptyState = $('[data-empty-state]');

        // CourseImpl Deletion
        $courseList.on('click','[data-delete]', function(event) {
            event.preventDefault();

            var $element = $(this);
            var $courseImpl = $element.closest('[data-course-impl]');
            var name = $courseImpl.attr('data-course-name');

            $element.confirmDialog({
                header: 'Confirm Import Deletion of ' + name,
                format: 'html',
                text: 'Are you sure you want to delete your import of ' + name + '? All tasks, due work and quizzes ' +
                'you have imported via this course, <em>as well as any you have created on it since</em>, will be ' +
                'permanently deleted from this class. The original course will be unaffected.'
                + '<br/><br/><strong><em>This is an irreversible operation.</em></strong>',
                confirmLabel: 'Yes, permanently delete',
                cancelLabel: 'No, keep it',
                confirmEvent: function() {

                    var url = $element[0].href;
                    var settings = {
                        headers: {
                            'X-HTTP-Method-Override': 'DELETE'
                        },
                        type: 'POST',
                        success: function(resp) {
                            if(resp.data){
                                $courseImpl.fadeOut({
                                    done: function(){
                                        $courseImpl.remove();
                                        if(!$courseList.find('[data-course-impl]').length){
                                            $emptyState.removeClass('hide');
                                        }
                                    }
                                });
                            }
                        }
                    };
                    $.ajax(url, settings);
                }
            });
        });




        // CourseImpl's CourseOutlineComponent Restoration
        $courseList.on('click', '[data-restore-course]', function(event) {
            event.preventDefault();

            var self = $(this);

            $.post($(this).attr('href'), {
                folderId: $(this).attr('data-restore-folder'),
                componentId: $(this).attr('data-restore-component')
            }, function(responseText) {
                if (responseText.result == 'success') {
                    window.location.href = window.location.href;
                }
                else {
                    $('#restoreCourseName').html(self.attr('data-restore-course'));

                    $('#restore_course_modal').foundation('reveal', 'open');
                }
            });
        });
    });
</script>

<div id="restore_course_modal" class="reveal-modal" data-reveal>
    <h2>Error restoring course</h2>
    <p>Could not restore <span id="restore_course_name"></span>.</p>
    <a class="close-reveal-modal">&#215;</a>
</div>

<ul class="breadcrumb">
    <li><a href="/homepage/{{ folder.id }}">{{ folder.name }}</a></li>
    <li class="active">
        <a href="{{ routeLookup('courseImport.getManagement', { folderId: folder.id }) }}">Modify Course</a>
    </li>
</ul>
<div class="row">
    <div class="small-12 island">
        <h1>Course Management</h1>
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Courses Imported to {{ folder.name }}</h2>
                </div>
            </div>
            <nav>
                <a href="{{ routeLookup('courseImport.getImportToClassForm', { courseSpecId: 0, classCode: folder.id }) }}" class="icon-add" title="Import Course" data-course-selector></a>
            </nav>
        </div>

        {% if courseImpls|length %}
        <section>
            <ul class="action-list" id="course_list">
                {% for currentCourse in courseImpls %}
                <li class="actions-small-2" data-course-impl="{{ currentCourse.id }}" data-course-name="{{ currentCourse.specification.folder.name }}">
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="/homepage/{{ currentCourse.specification.folder.id }}">
                                <h3>
                                    <span class="icon-course"></span>{{ currentCourse.specification.folder.name }}
                                </h3>
                            </a>
                        </div>
                    </div>
                    <nav>
                        {% if noCourseOutlineComponentsForThisCourseImpl %}
                            <a href="{{ routeLookup('courseImport.restoreCourse') }}" class="icon-undo" title="Restore Course" data-restore-course="{{ currentCourse.name }}" data-restore-folder="{{ folder.id }}" data-restore-component="{{ courseComponentId }}"></a>
                        {% endif %}

                        <a href="{{ routeLookup('courseImport.importModify', { courseImplId: currentCourse.id }) }}" class="icon-modify" title="Modify Import"></a>
                        <a href="{{ routeLookup('courseImport.importDelete', { courseImplId: currentCourse.id }) }}" class="icon-delete" title="Permanently Delete Import" data-delete></a>
                    </nav>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}


        <div class="empty-state{% if courseImpls|length %} hide{% endif %}" data-empty-state>
            <i class="icon-course"></i>
            <p>
                There are no courses associated with this homepage, but you can
                <a href="{{ routeLookup('courseImport.getImportToClassForm', { courseSpecId: 0, classCode: folder.id }) }}">import one</a>.
            </p>
        </div>

    </div>
</div>

<div id="course-selector-modal" class="reveal-modal" data-reveal></div>
