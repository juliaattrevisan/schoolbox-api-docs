<script type="text/javascript" src="/javascript/shared/course/jquery.course-selector.js"></script>
<script type="text/javascript">
    $(function() {

        /* Attach Course Selector Modal listeners
         */
        $.fn.courseSelectorModal({
            courseSelector: {
                query: {
                    folder: {{ folder.id }}
                }
            }
        });

        $('#courseList').find('[data-delete]').click(function(event) {
            event.preventDefault();

            var element = $(this);

            var name = element.data('coursename');

            $(this).confirmDialog({
                header: 'Confirm Import Deletion of ' + name,
                format: 'html',
                text: 'Are you sure you want to delete your import of '
                + name
                + '? All tasks, due work and quizzes you have imported via this course, <em>as well as any you have created on it since</em>, will be permanently deleted from this class. The original course will be unaffected.'
                + '<br/><br/><strong><em>This is an irreversible operation.</em></strong>',
                confirmLabel: 'Yes, permanently delete',
                cancelLabel: 'No, keep it',
                confirmEvent: function() {
                    $.post('{{ routeLookup('course.importDelete') }}', { componentId: element.attr('data-delete') }, function(responseText) {
                        window.location.href = window.location.href;
                    });
                }
            });
        });

        /* Restore courses
         */
        $('#courseList').on('click', '[data-restore-course]', function(event) {
            event.preventDefault();

            var self = $(this);

            $.post($(this).attr('href'), {
                folderId: $(this).attr('data-restore-folder'),
                componentId: $(this).attr('data-restore-component')
            }, function(responseText) {
                if (responseText.result == 'success') {
                    window.location.href = window.location.href;
                }
                else {
                    $('#restoreCourseName').html(self.attr('data-restore-course'));

                    $('#restoreCourseModal').foundation('reveal', 'open');
                }
            });
        });
    });
</script>

<div id="restoreCourseModal" class="reveal-modal" data-reveal>
    <h2>Error restoring course</h2>

    <p>Could not restore <span id="restoreCourseName"></span>.</p>

    <a class="close-reveal-modal">&#215;</a>
</div>

<ul class="breadcrumb">
    <li><a href="/homepage/{{ folder.id }}">{{ folder.name }}</a></li>
    <li class="active">
        <a href="{{ routeLookup('course.management', { folderId: folder.id }) }}">Modify Course</a>
    </li>
</ul>
<div class="row">
    <div class="small-12 island">
        <h1>Course Management</h1>
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Courses for {{ folder.name }}</h2>
                </div>
            </div>
            <nav>
                <a href="{{ routeLookup('course.import', { courseId: 0, classCode: folder.id }) }}" class="icon-add" title="Import Course" data-course-selector></a>
            </nav>
        </div>

        {% if allCourses|length %}
        <section>
            <ul class="action-list" id="courseList">
                {% for currentCourse in allCourses %}
                {% set courseComponentId = allCourseComponentIds[currentCourse.id].componentId %}
                {% set courseComponentRemoved = allCourseComponentIds[currentCourse.id].restorable %}
                {% set courseParents = lineage[currentCourse.id] %}

                <li class="actions-small-{{ courseComponentRemoved ? 3 : 2 }}">
                    <div class="list-item">
                        <div
                            {% if courseComponentRemoved %}
                                class="small-12 info card removed"
                                title="The associated Course Outline component has been removed"
                            {% else %}
                                class="small-12 info card"
                            {% endif %}
                        >
                            <h3>{{ currentCourse.name }}</h3>
                            <p class="meta">
                                {{ courseParents[0].name }}
                                {% for courseParent in courseParents | slice(1) %}
                                    &gt; {{ courseParent.name }}
                                {% endfor %}
                            </p>

                        </div>
                    </div>
                    <nav>
                        {% if courseComponentRemoved %}
                            <a href="{{ routeLookup('course.restoreCourse') }}" class="icon-upload" title="Restore Course" data-restore-course="{{ currentCourse.name }}" data-restore-folder="{{ folder.id }}" data-restore-component="{{ courseComponentId }}"></a>
                        {% endif %}
                        <a href="{{ routeLookup('course.importModify', { componentId: courseComponentId }) }}" class="icon-modify" title="Modify Import"></a>
                        <a href="" class="icon-delete" title="Delete Course" data-delete="{{ courseComponentId }}" data-coursename="{{ currentCourse.name }}"></a>
                    </nav>
                </li>
                {% endfor %}
            </ul>
        </section>

        {% else %}

        <section>
            <div class="content">
                <p>There are no Courses associated with this homepage.</p>
            </div>
        </section>

        <a href="{{ routeLookup('course.import', { courseId: 0, classCode: folder.id }) }}" class="button submit expand">Import a Course</a>
        {% endif %}
    </div>
</div>

<div id="course-selector-modal" class="reveal-modal" data-reveal></div>
