<script type="text/javascript" src="/javascript/shared/course/jquery.course-selector.js"></script>
<script type="text/javascript">
    $(function() {

        /* Attach Course Selector Modal listeners
         */
        $.fn.courseSelectorModal({
            courseSelector: {
                query: {
                    folder: {{ folder.id }}
                }
            }
        });

        $('#courseList').find('[data-delete]').click(function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Course?',
                confirmEvent: function() {
                    $.post('/course/delete', {courseId: element.attr('data-delete')}, function(responseText) {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>Course Management</h1>
        <ul class="meta">
            <li class="icon-home"><a href="/homepage/{{ folder.id }}">{{ folder.name }}</a></li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Courses for {{ folder.name }}</h2>
                </div>
            </div>
            <nav>
                <a href="/course/import/{{ folder.id }}" class="icon-add" title="Link to Course" data-course-selector></a>
            </nav>
        </div>

        {% if allCourses|length %}
        <section>
            <ul class="action-list" id="courseList">
                {% for currentCourse in allCourses %}
                {% set courseComponentId = allCourseComponentIds[currentCourse.getId()].getId() %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 info card">
                            <a href="#" title="">
                                <h3>{{ currentCourse.name }}</h3>
                            </a>
                            <p class="meta">{{ currentCourse.id }}</p>
                        </div>
                    </div>
                    <nav>
                        {# TODO #}
                        <a href="/course/import/modify/{{ folder.getId() }}/{{ courseComponentId }}" class="icon-modify" title="Modify Course"></a>

                        {% if currentCourse.getId() in allRestorableCourses|keys %}
                        <a href="/course/restore/{{ folder.getId() }}/{{ courseComponentId }}" class="icon-upload" title="Restore Course"></a>
                        {% endif %}

                        <a href="" class="icon-delete" title="Delete Course" data-delete="{{ currentCourse.getId() }}"></a>
                    </nav>
                </li>
                {% endfor %}
            </ul>
        </section>

        {% else %}

        <section>
            <div class="content">
                <p>There are no Courses associated with this homepage.</p>
            </div>
        </section>

        <a href="/course/import/0/class/{{ folder.id }}" class="button submit expand">Import a Course</a>
        {% endif %}
    </div>
</div>

<div id="course-selector-modal" class="reveal-modal" data-reveal></div>