<script type="text/javascript" src="/javascript/shared/course/jquery.course-import.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/jquery.sync-dates.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker-sync.js"></script>
<script type="text/javascript" src="/javascript/shared/attacher.hide-watch.js"></script>

<script>
    $(function() {
        $('[data-collapser]').click(function(e) {
            e.preventDefault();
            var unit = $('#' + $(e.target).attr('data-collapser'));
            if (unit.hasClass('hide')) {
                unit.removeClass('hide');
                $(e.target).removeClass('icon-up-arrow');
                $(e.target).addClass('icon-down-arrow');
            } else {
                unit.addClass('hide');
                $(e.target).removeClass('icon-down-arrow');
                $(e.target).addClass('icon-up-arrow');
            }
        });

        $('[data-default-work]').click(function(e) {
            e.preventDefault();
            var publish_date = "#work_publish_date-" + $(e.target).attr('data-default-work');
            var open_date = "#work_open_date-" + $(e.target).attr('data-default-work');
            var due_date = "#work_due_date-" + $(e.target).attr('data-default-work');
            var late_date = "#work_late_date-" + $(e.target).attr('data-default-work');

            $(publish_date).val($(e.target).attr('data-open'));
            $(open_date).val($(e.target).attr('data-open'));
            $(due_date).val($(e.target).attr('data-close'));
            $(late_date).val($(e.target).attr('data-close'));
        });

        $('[data-default-quiz]').click(function(e) {
            e.preventDefault();
            var start_date = "#quiz_start_date-" + $(e.target).attr('data-default-quiz');
            var finish_date = "#quiz_finish_date-" + $(e.target).attr('data-default-quiz');

            $(start_date).val($(e.target).attr('data-open'));
            $(finish_date).val($(e.target).attr('data-close'));
        });
    });
</script>

{# Persist data from previous stages #}

<input type="hidden" name="homepage"        value="{{ homepage }}" />
<input type="hidden" name="course_homepage" value="{{ courseHomepage }}" />
<input type="hidden" name="component_id"    value="{{ componentId }}" />

{% for unit in unitDates %}
<input type="hidden" name="unit[{{ loop.index }}][unit_id]" value="{{ unit.unit_id }}">
<input type="hidden" name="unit[{{ loop.index }}][import]" value="{{ unit.import }}">
<input type="hidden" name="unit[{{ loop.index }}][open_date]" value="{{ unit.open_date }}">
<input type="hidden" name="unit[{{ loop.index }}][due_date]" value="{{ unit.due_date }}">
{% endfor %}

{# Iterate through each unit being imported #}

{% for unit in units %}
<div class="row">
    <div class="small-12 columns">
        <section>
            <ul class="action-list">
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 info card">
                            <h3>{{ unit.name }}</h3>
                        </div>
                    </div>
                    <nav>
                        <a data-collapser="unit-{{ unit.id }}" href="#" class="icon-{% if loop.first %}down{% else %}up{% endif %}-arrow collapse" title="Collapse Content"></a>
                    </nav>
                </li>
            </ul>
            <div id="unit-{{ unit.id }}" {% if not loop.first %}class="hide"{% endif %}>
                <div class="row">
                    <div class="small-12 island">
                        <section>
                            <ul class="information-list">
                                {# All work items in the current unit #}

                                {% for work in unit.items %}
                                    <li class="actions-small-1">
                                        <div class="list-item" data-type="unit_row">
                                            <input type="hidden" name="submissions" value="{% if work.item.getAcceptOnline %}1{% else %}0{% endif %}">

                                            {% if work.class == 'SubmissionBox' %}
                                                {% include '@course/import/submissionBox.twig' %}
                                            {% elseif work.class == 'Task' %}
                                                {% include '@course/import/task.twig' %}
                                            {% elseif work.class == 'OnlineAssessment' %}
                                                {% include '@course/import/quiz.twig' %}
                                            {% endif %}

                                        </div>
                                        <nav>
                                            {% if work.class == 'SubmissionBox' %}
                                                <a data-default-work="{{ work.item.id }}" data-open="{{ unit.open_date }}" data-close="{{ unit.due_date }}" class="icon-calendar no-text" href="#" title="Default To Unit Dates"></a>
                                            {% elseif work.class == 'Task' %}
                                            {% elseif work.class == 'OnlineAssessment' %}
                                                <a data-default-quiz="{{ work.item.id }}" data-open="{{ unit.open_date }}" data-close="{{ unit.due_date }}" class="icon-calendar no-text" href="#" title="Default To Unit Dates"></a>
                                            {% endif %}
                                        </nav>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
{% endfor %}

<div class="small-12 column">
    <div class="row" data-mage-submitrow>
        <div class="small-12 medium-8 column">
            <p class="alert alert-box icon-alert" data-mage-error></p>
        </div>
        <div class="small-12 medium-4 column">
            <input type="submit" name="part-results-select" value="{% if componentId %}Modify{% else %}Import{% endif %}" data-mage-next="part-results-select" data-mage-working="Working..." formaction="/course/importSave" />
        </div>
    </div>
</div>
