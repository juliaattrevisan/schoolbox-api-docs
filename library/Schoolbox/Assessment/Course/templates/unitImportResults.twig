{# Usage:
    {% include '@course/unitImportResullts.twig' with {
        action:       string {'import'|'modify'},
        courseSpecId: int,
        folderIds:        null|int[]                                       - null if a 'modify''. List of folder IDs if 'import'
        courseImplId: int|null,
        units:        array,
        units[unitSpecId]['unitSpec']: UnitSpecification,
        units[unitSpecId]['unitImpl']: UnitImplementation | null,
        units[unitSpecId]['assessments']: array,
        units[unitSpecId]['assessments'][]['spec']: IAssessable | null,
        units[unitSpecId]['assessments'][]['impl']: IAssessable | null,
        componentId:  int|null,
        canReadCourseSpec: bool
        canReadUnitSpec[unitSpecId]: bool
    } only %}
#}

<script type="text/javascript" src="/javascript/shared/attacher.hide-watch.js"></script>

<script>
    $(function() {
        $('[data-collapser]').click(function(e) {
            e.preventDefault();
            var unit = $('#' + $(e.target).attr('data-collapser'));
            if (unit.hasClass('hide')) {
                unit.removeClass('hide');
                $(e.target).removeClass('icon-down-arrow');
                $(e.target).addClass('icon-up-arrow');
            } else {
                unit.addClass('hide');
                $(e.target).removeClass('icon-up-arrow');
                $(e.target).addClass('icon-down-arrow');
            }
        });

        // User toggles the checkbox to the left of an assessment
        $(document).on('change', 'input[data-assessment-import]', function () {
            var $input              = $(this),
                assessmentId        = $input.data('assessment-import'),
                $assessmentRow      = $input.closest('[data-assessment=' + assessmentId + ']'),
                $dates              = $assessmentRow.find('[data-assessment-dates=' + assessmentId + ']'),
                $unit               = $input.closest('[data-unit]'),
                $subAssessmentList  = $assessmentRow.find('[data-project=' + assessmentId + ']'),
                $projectAssessments = $subAssessmentList.find('[data-parent-project=' + assessmentId + ']'),
                $countSelectedElem  = $unit.find('[data-show-count]');

            // Show/Hide assessment's dates
            if ($input.prop('checked')) {
                $dates.show();
                $dates.find('input').prop('disabled', false);
            } else {
                $dates.hide();
                $dates.find('input').prop('disabled', true);
            }

            // Show/Hide sub-assessment in Project
            if ($input.prop('checked')) {

                // Only enable dates for sub-assessments that are selected
                $projectAssessments.each(function(idx, elem){
                    var $subRow         = $(elem);
                    var subAssessmentId = $subRow.data('assessment');
                    var $checkbox       = $subRow.find('[data-assessment-import=' + subAssessmentId + ']');

                    // Enable all directly-nested checkboxes
                    $checkbox.prop('disabled', false);
                    if($checkbox.prop('checked')){
                        var $dates = $subRow.find('[data-assessment-dates=' + subAssessmentId + ']');
                        $dates.find('input').prop('disabled', false);
                    }
                });
                $subAssessmentList.show();
            } else {
                $subAssessmentList.hide();
                // Disable all dates on project's sub-assessments so these are not validated or posted to server
                $subAssessmentList.find('[data-assessment-dates]').prop('disabled', true);
            }

            // Update display of how many assessments are currently selected in this unit
            // Includes sub-assessments inside projects if project is selected
            $countSelectedElem.attr('data-show-count', $unit.find(':checked:not(:disabled)').length);
        });
    });
</script>



{# Persist data from previous stages #}

<input type="hidden" name="action" value="{{ action }}" />
<input type="hidden" name="course_spec_id" value="{{ courseSpecId }}" />
<input type="hidden" name="import_folders" value="{{ folderIds|join(',') }}" />
<input type="hidden" name="course_impl_id" value="{{ courseImplId }}" />
<input type="hidden" name="component_id"   value="{{ componentId }}" />

{# Iterate through each unit being imported #}

<div class="row">
    <div class="small-12 column">
        <p class="meta" data-mage-helptext>The list of coursework to be imported is below. You can deselect {{ locale.assessment.plural }} and change dates before completing the import.</p>
    </div>
</div>
{% for unitImpl in dto.unitImplementations %}

    {% include '@course/import/unitImportRow.twig' with {
        unitImpl:        unitImpl,
        dto:             dto,
        canReadUnitSpec: canReadUnitSpecs[unitImpl.specification.id] ?? false,
    } only %}

{% endfor %}
