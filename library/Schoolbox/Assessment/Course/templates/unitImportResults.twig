<!-- BEGIN custom_head -->

<script type="text/javascript" src="/javascript/shared/course/jquery.course-import.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/jquery.sync-dates.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker-sync.js"></script>
<script type="text/javascript" src="/javascript/shared/attacher.hide-watch.js"></script>

<!-- END custom_head -->

{# Iterate through each unit being imported#}

{% for unit in units %}

    <h1>{{ unit.name }}</h1>

    {% if unit.tasks | length > 0 %}

        {# Tasks for the current unit #}

        <h2>Tasks</h2>
        <ul class="information-list">
            {% for task in unit.tasks %}
                <li>{{ task.getTitle }}</li>
            {% endfor %}
        </ul>

    {% endif %}

    {% if unit.dueWork | length > 0 %}

        {# Due work for the current unit #}

        <h2>Due Work</h2>

        <ul class="information-list no-pad">

            {% for work in unit.dueWork %}

                <li>
                    <div class="list-item" data-type="unit_row">

                        {# Due work name #}

                        <div class="avatar card small-4">
                            {{ work.getName }}
                        </div>

                        {# Publish Date #}

                        <div class="medium-2 columns" data-hide-watch="#import-{{ loop.index }}">
                            {% if work.getPublishDate != '' %}
                                <label for="work_publish_date-{{ work.getId }}">Publish Date</label>
                                <input id="work_publish_date-{{ work.getId }}"
                                       name="unit[{{ work.getId }}][publish_date]"
                                       type="text"
                                       value="{{ work.getPublishDate }}"
                                       data-role="publish_date"
                                       data-datepicker
                                       data-datepicker-sync
                                       data-datepicker-sync-enddate="#work_publish_date-{{ work.getId }}" />
                            {% endif %}
                        </div>

                        {# Open Date #}

                        <div class="medium-2 columns" data-hide-watch="#import-work-{{ work.getId }}">
                            {% if work.getOpenDate != '' %}
                                <label for="work_open_date-{{ work.getId }}">Open Date</label>
                                <input id="work_open_date-{{ work.getId }}"
                                       name="unit[{{ work.getId }}][open_date]"
                                       type="text"
                                       value="{{ work.getOpenDate }}"
                                       data-role="open_date"
                                       data-datepicker
                                       data-datepicker-sync
                                       data-datepicker-sync-enddate="#work_open_date-{{ work.getId }}" />
                            {% endif %}

                        </div>

                        {# Due Date #}

                        <div class="medium-2 columns" data-hide-watch="#import-{{ loop.index }}">
                            {% if work.getDueDate != '' %}
                                <label for="work_due_date-{{ work.getId }}">Due Date</label>
                                <input id="work_due_date-{{ work.getId }}"
                                       name="unit[{{ work.getId }}][due_date]"
                                       type="text"
                                       value="{{ work.getDueDate }}"
                                       data-role="due_date"
                                       data-datepicker
                                       data-datepicker-sync
                                       data-datepicker-sync-enddate="#work_due_date-{{ work.getId }}" />
                            {% endif %}
                        </div>

                        {# Late Date #}

                        <div class="medium-2 columns" data-hide-watch="#import-{{ loop.index }}">
                            {% if work.getLateDate != '' %}
                                <label for="work_late_date-{{ work.getId }}">Late Date</label>
                                <input id="work_late_date-{{ work.getId }}"
                                       name="unit[{{ work.getId }}][late_date]"
                                       type="text"
                                       value="{{ work.getLateDate }}"
                                       data-role="late_date"
                                       data-datepicker
                                       data-datepicker-sync
                                       data-datepicker-sync-enddate="#work_late_date-{{ work.getId }}" />
                            {% endif %}
                        </div>

                    </div>
                </li>

            {% endfor %}

        </ul>

    {% endif %}

    {% if unit.quizzes | length > 0 %}

        {# Tasks for the current unit #}

        <h2>Quizzes</h2>

        <ul class="information-list no-pad">

            {% for quiz in unit.quizzes %}

                <li>
                    <div class="list-item" data-type="unit_row">

                        {# Task name #}

                        <div class="avatar card small-8">
                            {{ quiz.getTitle }}
                        </div>

                        {# Open Date #}

                        <div class="medium-2 columns">
                            <label for="quiz_open_date-{{ quiz.getId }}">Open Date</label>
                            <input id="quiz_open_date-{{ quiz.getId }}"
                                   name="unit[{{ quiz.getId }}][open_date]"
                                   type="text"
                                   value="{{ quiz.getOpenDate }}"
                                   data-role="open_date"
                                   data-datepicker
                                   data-datepicker-sync
                                   data-datepicker-sync-enddate="#quiz_open_date-{{ quiz.getId }}" />
                        </div>

                        {# Close Date #}

                        <div class="medium-2 columns" data-hide-watch="#import-{{ loop.index }}">
                            <label for="quiz_close_date-{{ quiz.getId }}">Close Date</label>
                            <input id="quiz_close_date-{{ quiz.getId }}"
                                   name="unit[{{ quiz.getId }}][close_date]"
                                   type="text"
                                   value="{{ quiz.getCloseDate }}"
                                   data-role="close_date"
                                   data-datepicker
                                   data-datepicker-sync
                                   data-datepicker-sync-enddate="#quiz_close_date-{{ quiz.getId }}" />
                        </div>
                    </div>
                </li>

            {% endfor %}

        </ul>

    {% endif %}

{% endfor %}
