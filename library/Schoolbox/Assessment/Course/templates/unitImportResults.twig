<!-- BEGIN custom_head -->

<script type="text/javascript" src="/javascript/shared/course/jquery.course-import.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/jquery.sync-dates.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker-sync.js"></script>
<script type="text/javascript" src="/javascript/shared/attacher.hide-watch.js"></script>

<!-- END custom_head -->

{# Persist data from previous stages #}

<input type="hidden" name="homepage"        value="{{ homepage }}" />
<input type="hidden" name="course_homepage" value="{{ courseHomepage }}" />

{% for unit in unitDates %}
<input type="hidden" name="unit[{{ loop.index }}][unit_id]" value="{{ unit.unit_id }}">
<input type="hidden" name="unit[{{ loop.index }}][import]" value="{{ unit.import }}">
<input type="hidden" name="unit[{{ loop.index }}][open_date]" value="{{ unit.open_date }}">
<input type="hidden" name="unit[{{ loop.index }}][due_date]" value="{{ unit.due_date }}">
{% endfor %}

{# Iterate through each unit being imported #}

{% for unit in units %}
<div class="row">
    <div class="small-12 columns">
        <section>
            <h3>{{ unit.name }}</h3>

            <ul class="information-list no-pad">

            {# All work items in the current unit #}

            {% for work in unit.items %}
                <li>
                    <div class="list-item" data-type="unit_row">
                        <input type="hidden" name="submissions" value="{% if work.item.getAcceptOnline %}1{% else %}0{% endif %}">

                        {# Name #}
                        <div class="compact avatar card small-12 medium-4">
                        {% if work.class == 'SubmissionBox' %}
                            <div class="icon-due-work"></div>
                            {{ work.item.getName }}

                        {% elseif work.class == 'Task' %}
                            <div class="icon-task"></div>
                            {{ work.item.getTitle }}

                        {% elseif work.class == 'OnlineAssessment' %}
                            <div class="icon-quiz"></div>
                            {{ work.item.getTitle }}
                        {% endif %}
                        </div>

                        {# Publish Date - when people can see this work exists #}

                        {% if work.class == 'SubmissionBox' %}
                        <div class="small-12 medium-2 columns">
                            {# Due Work: Publish Date #}
                            <label for="work_publish_date-{{ work.item.getId }}">Publish Date</label>
                            <input id="work_publish_date-{{ work.item.getId }}"
                                   name="work[{{ work.item.getId }}][publish_date]"
                                   type="text"
                                   value="{{ unit.open_date }}"
                                   data-role="publish_date"
                                   data-datepicker
                                   data-datepicker-sync
                                   data-datepicker-sync-enddate="#work_publish_date-{{ work.item.getId }}" />
                        </div>
                        {% elseif work.class == 'Task' %}
                        <div class="small-12 medium-2 columns hide-for-small">
                            &nbsp;
                        </div>
                        {% elseif work.class == 'OnlineAssessment' %}
                        <div class="small-12 medium-2 columns hide-for-small">
                            &nbsp;
                        </div>
                        {% endif %}

                        {# Open Date - when people can start the work #}

                        {% if work.class == 'SubmissionBox' %}
                        <div class="small-12 medium-2 columns">
                            {# Due Work: Open Date #}
                            <label for="work_open_date-{{ work.item.getId }}">Open Date</label>
                            <input id="work_open_date-{{ work.item.getId }}"
                                   name="work[{{ work.item.getId }}][open_date]"
                                   type="text"
                                   value="{{ unit.open_date }}"
                                   data-role="open_date"
                                   data-datepicker
                                   data-datepicker-sync
                                   data-datepicker-sync-enddate="#work_open_date-{{ work.item.getId }}" />
                        </div>
                        {% elseif work.class == 'Task' %}
                        <div class="small-12 medium-2 columns hide-for-small">
                            &nbsp;
                        </div>
                        {% elseif work.class == 'OnlineAssessment' %}
                        <div class="small-12 medium-2 columns">
                            {# Quiz: Start Date #}
                            <label for="quiz_start_date-{{ work.item.getId }}">Start Date</label>
                            <input id="quiz_start_date-{{ work.item.getId }}"
                                   name="quiz[{{ work.item.getId }}][start_date]"
                                   type="text"
                                   value="{{ unit.open_date }}"
                                   data-role="start_date"
                                   data-datepicker
                                   data-datepicker-sync
                                   data-datepicker-sync-enddate="#quiz_start_date-{{ work.item.getId }}" />
                        </div>
                        {% endif %}

                        {# Due Date - when this work needs to be finished #}

                        {% if work.class == 'SubmissionBox' %}
                        <div class="small-12 medium-2 columns">
                            {# Due Work: Due Date #}
                            <label for="work_due_date-{{ work.item.getId }}">Due Date</label>
                            <input id="work_due_date-{{ work.item.getId }}"
                                   name="work[{{ work.item.getId }}][due_date]"
                                   type="text"
                                   value="{{ unit.due_date }}"
                                   data-role="due_date"
                                   data-datepicker
                                   data-datepicker-sync
                                   data-datepicker-sync-enddate="#work_due_date-{{ work.item.getId }}" />
                        </div>
                        {% elseif work.class == 'Task' %}
                        <div class="small-12 medium-2 columns hide-for-small">
                            &nbsp;
                        </div>
                        {% elseif work.class == 'OnlineAssessment' %}
                        <div class="small-12 medium-2 columns">
                            {# Quiz: Finish Date #}
                            <label for="quiz_finish_date-{{ work.item.getId }}">Finish Date</label>
                            <input id="quiz_finish_date-{{ work.item.getId }}"
                                   name="quiz[{{ work.item.getId }}][finish_date]"
                                   type="text"
                                   value="{{ unit.due_date }}"
                                   data-role="finish_date"
                                   data-datepicker
                                   data-datepicker-sync
                                   data-datepicker-sync-enddate="#quiz_finish_date-{{ quiz.getId }}" />
                        </div>
                        {% endif %}

                        {# Late Date - when submissions are considered overdue (late) #}

                        {% if work.class == 'SubmissionBox' %}
                        <div class="small-12 medium-2 columns">
                            <label for="work_late_date-{{ work.getId }}">Late Date</label>
                            <input id="work_late_date-{{ work.getId }}"
                                   name="work[{{ work.getId }}][late_date]"
                                   type="text"
                                   value="{{ unit.due_date }}"
                                   data-role="late_date"
                                   data-datepicker
                                   data-datepicker-sync
                                   data-datepicker-sync-enddate="#work_late_date-{{ work.getId }}" />
                        </div>
                        {% elseif work.class == 'Task' %}
                        <div class="small-12 medium-2 columns hide-for-small">
                            &nbsp;
                        </div>
                        {% elseif work.class == 'OnlineAssessment' %}
                        <div class="small-12 medium-2 columns hide-for-small">
                            &nbsp;
                        </div>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
            </ul>
        </section>
    </div>
</div>
{% endfor %}

<div class="small-12 column">
    <div class="row" data-mage-submitrow>
        <div class="small-12 medium-8 column">
            <p class="alert alert-box icon-alert" data-mage-error></p>
        </div>
        <div class="small-12 medium-4 column">
            <input type="submit" name="part-results-select" value="Import" data-mage-next="part-results-select" data-mage-working="Working..." formaction="/course/importSave" />
        </div>
    </div>
</div>
