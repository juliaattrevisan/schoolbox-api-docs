{# Usage:
    {% include '@course/unitImportForm.twig' with {
        action:           string                       - {'import'|'modify'}
        courseSpecId:     int
        folderIds:        null|int[]                   - null if a 'modify''. List of folder IDs if 'import'
        courseImplId:     int|null                     - null if an 'import', int if 'modify'
        unitsImpls:       UnitImplementation[]         - with null IDs if an 'import'.
        componentId:      int|null                     - (optional)
    } only %}
#}

<!-- BEGIN custom_head -->

<script type="text/javascript" src="/javascript/shared/attacher.hide-watch.js"></script>

<script>
    $(function() {
        $('[data-warn-removal]').click(function(e) {
            if (!$(e.target).prop('checked')) {
                event.preventDefault();
                $(this).confirmDialog({
                    text: 'Are you sure you want to remove this unit? ' +
                            'Doing so will delete all associated activities and marks from the markbook.',
                    confirmEvent: function() {
                        // Uncheck
                        $(e.target).prop("checked", false).trigger('change');
                    }
                });
            }
        });
    });
</script>

<!-- END custom_head -->

{% if units.length > 0 %}

    {# There were no units in the selected course #}

    <div class="small-12 columns">
        <div class="alert-box">
            The course you have selected contains no {{ locale.unit.plural }}. Please select a course that has the "course" icon.
        </div>
    </div>

{% else %}

    {# There were units in the selected course, create import form #}

    <input type="hidden" name="action" value="{{ action|e }}"/>
    <input type="hidden" name="course_spec_id" value="{{ courseSpecId }}"/>
    <input type="hidden" name="import_folders" value="{{ folderIds|join(',') }}" />
    <input type="hidden" name="course_impl_id" value="{{ courseImplId }}"/>
    <input type="hidden" name="component_id" value="{{ componentId }}"/>

        <p data-mage-helptext class="meta">Select the {{ locale.unit.plural }} to be imported, and their open and close dates.</p>
        <ul class="information-list">

            {# Iterate each unit and create checkbox and dates #}

            {% for unitImpl in unitsImpls %}
                <li>
                    <input name="unit[{{ loop.index }}][unit_spec_id]" type="hidden" value="{{ unitImpl.specification.id }}" />
                    <input name="unit[{{ loop.index }}][unit_impl_id]" type="hidden" value="{{ unitImpl.id }}" />

                    <div class="list-item" data-type="unit_row">

                        {# Checkbox & Unit Name #}

                        <div class="card small-12 large-4">
                            <input id="import-{{ loop.index }}"
                                   name="unit[{{ loop.index }}][import]"
                                   {% if unitImpl.id %}checked="checked" data-warn-removal {% endif %}
                                   type="checkbox"
                                   data-interaction="enable"
                                   data-checkbox-group="unit" />
                            <label for="import-{{ loop.index }}" class="checkbox-label">
                                {{ unitImpl.title }}<span class="icon-unit"></span>
                            </label>
                        </div>

                        {# Open Date #}

                        <div class="small-12 medium-6 large-4 columns" data-hide-watch="#import-{{ loop.index }}">
                            <label for="open_date-{{ loop.index }}">Open</label>
                            <input id="open_date-{{ loop.index }}"
                                   name="unit[{{ loop.index }}][open_date]"
                                   type="text"
                                   value="{{ unitImpl.openDate.localShort }}"
                                   data-role="open_date"
                                   data-index="{{ loop.index }}"
                                   data-datepicker
                                   data-datepicker-buttontext=""
                                   data-datesync-enddate="#due_date-{{ loop.index }}" />
                        </div>

                        {# Close Date #}

                        <div class="small-12 medium-6 large-4 columns" data-hide-watch="#import-{{ loop.index }}">
                            <label for="due_date-{{ loop.index }}">Close</label>
                            <input id="due_date-{{ loop.index }}"
                                   name="unit[{{ loop.index }}][close_date]"
                                   type="text"
                                   value="{{ unitImpl.dueDate.localShort }}"
                                   data-role="due_date"
                                   data-index="{{ loop.index }}"
                                   data-datepicker
                                   data-datesync-startdate="#open_date-{{ loop.index }}"
                                   data-datepicker-buttontext="" />
                        </div>
                    </div>
                </li>

            {% endfor %}

        </ul>
{% endif %}


