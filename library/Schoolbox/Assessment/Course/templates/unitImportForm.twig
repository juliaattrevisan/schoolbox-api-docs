{# Usage:
    {% include '@course/unitImportForm.twig' with {
        action:       string {'import'|'modify'},
        courseSpecId: int,
        courseImplId: int|null,
        unitsImpls:   UnitImplementation[],
        componentId:  int|null,
        ownerships:   string
    } only %}
#}

<!-- BEGIN custom_head -->

<script type="text/javascript" src="/javascript/shared/course/jquery.course-import.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/jquery.sync-dates.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker-sync.js"></script>
<script type="text/javascript" src="/javascript/shared/attacher.hide-watch.js"></script>

<script>
    $(function() {
        $('[data-warn-removal]').change(function(e) {
            if (!$(e.target).attr('checked')) {
                $('#unit-warn-removal').removeClass('hide');
            } else {
                $('#unit-warn-removal').addClass('hide');
            }
        });
    });
</script>

<!-- END custom_head -->

{% if units.length > 0 %}

    {# There were no units in the selected course #}

    <div class="small-12 columns">
        <div class="alert-box">
            The course you have selected contains no units. Please select a course that has the "course" icon.
        </div>
    </div>

{% else %}

    {# There were units in the selected course, create import form #}

    <input type="hidden" name="courseSpecId" value="{{ courseSpecId }}"/>
    <input type="hidden" name="courseImplId" value="{{ courseImplId }}"/>
    <input type="hidden" name="componentId" value="{{ componentId }}"/>
    <input type="hidden" name="ownerships" value="{{ ownerships }}" />

        <p data-mage-helptext class="meta">Select the units to be imported, and their open and close dates.</p>
        <ul class="information-list">

            {# Iterate each unit and create checkbox and dates #}

            {% for unitImpl in unitsImpls %}
                <li>
                    <input name="unit[{{ loop.index }}][unitSpecId]" type="hidden" value="{{ unitImpl.specification.id }}" />
                    <input name="unit[{{ loop.index }}][unitImplId]" type="hidden" value="{{ unitImpl.id }}" />

                    <div class="list-item" data-type="unit_row">

                        {# Checkbox & Unit Name #}

                        <div class="card small-12 medium-6">
                            <input name="unit[{{ loop.index }}][import]" type="hidden" value="0" />
                            <input id="import-{{ loop.index }}"
                                   name="unit[{{ loop.index }}][import]"
                                   {% if unitImpl.id %}checked="checked" data-warn-removal {% endif %}
                                   type="checkbox"
                                   value="1"
                                   data-interaction="enable" />
                            <label for="import-{{ loop.index }}" class="checkbox-label">
                                {{ unitImpl.title }}<span class="icon-unit"></span>
                            </label>
                        </div>

                        {# Open Date #}

                        <div class="small-12 medium-3 columns" data-hide-watch="#import-{{ loop.index }}">
                            <label for="open_date-{{ loop.index }}">Open</label>
                            <input id="open_date-{{ loop.index }}"
                                   name="unit[{{ loop.index }}][open_date]"
                                   type="text"
                                   value="{{ unitImpl.openDate.localShort }}"
                                   data-role="open_date"
                                   data-datepicker
                                   data-datepicker-sync
                                   data-datepicker-sync-enddate="#due_date-{{ loop.index }}" />
                            <label for="open_date-{{ loop.index }}" class="hide error">This field is required.</label>

                        </div>

                        {# Close Date #}

                        <div class="small-12 medium-3 columns" data-hide-watch="#import-{{ loop.index }}">
                            <label for="due_date-{{ loop.index }}">Close</label>
                            <input id="due_date-{{ loop.index }}"
                                   name="unit[{{ loop.index }}][due_date]"
                                   type="text"
                                   value="{{ unitImpl.dueDate.localShort }}"
                                   data-role="due_date"
                                   data-datepicker />
                            <label for="due_date-{{ loop.index }}" class="hide error">This field is required.</label>
                        </div>
                    </div>
                </li>

            {% endfor %}

        </ul>

    <div class="small-12 column">
        <div class="row" data-mage-submitrow>
            <div class="small-12 medium-8 column">
                <p class="alert alert-box icon-alert" data-mage-error></p>
                <p class="warning alert-box icon-alert hide" id="unit-warn-removal">Warning! Removal of existing units will also remove all associated tasks.</p>
            </div>
            <div class="small-12 medium-4 column">
                <input type="submit" name="part-unit-select" value="Next" data-mage-next="part-tasks-select" data-mage-working="Working..." formaction="{{ routeLookup('courseImport.postUnits') }}" />
            </div>
        </div>
    </div>

{% endif %}


