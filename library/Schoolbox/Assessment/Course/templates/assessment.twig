{#
Usage:
    $data = [
        assessment:       IAssessable,
        encodedReturnUrl: string        - only required if '_writable' is true ,
        _writable:        bool
    ]
#}
{% if _writable %}
    {% include '@course/assessment/writable.twig' with {
        assessment: assessment,
        encodedReturnUrl: encodedReturnUrl
    } only %}
{% else %}
    {% include '@course/assessment/readonly.twig' with {
        assessment: assessment
    } only %}
{% endif %}
