<div class="compact avatar card small-12 medium-4">
    <div class="icon-due-work"></div>
    {{ work.item.title }} {{ work.item.id }}
</div>
<div class="small-12 medium-2 columns">
    {# Due Work: Publish Date #}
    <label for="work_publish_date-{{ work.item.id }}">Publish Date</label>
    <input id="work_publish_date-{{ work.item.id }}"
           name="work[{{ work.item.id }}][publish_date]"
           type="text"
           value="{{ unitDates[work.item.category.id].open_date }}"
           data-role="publish_date"
           data-datepicker
           data-datepicker-sync
           data-datepicker-sync-enddate="#work_publish_date-{{ work.item.id }}" />
</div>
<div class="small-12 medium-2 columns">
    {# Due Work: Open Date #}
    <label for="work_open_date-{{ work.item.id }}">Open Date</label>
    <input id="work_open_date-{{ work.item.id }}"
           name="work[{{ work.item.id }}][open_date]"
           type="text"
           value="{{ unitDates[work.item.category.id].open_date }}"
           data-role="open_date"
           data-datepicker
           data-datepicker-sync
           data-datepicker-sync-enddate="#work_open_date-{{ work.item.id }}" />
</div>
<div class="small-12 medium-2 columns">
    {# Due Work: Due Date #}
    <label for="work_due_date-{{ work.item.id }}">Due Date</label>
    <input id="work_due_date-{{ work.item.id }}"
           name="work[{{ work.item.id }}][due_date]"
           type="text"
           value="{{ unitDates[work.item.category.id].due_date }}"
           data-role="due_date"
           data-datepicker
           data-datepicker-sync
           data-datepicker-sync-enddate="#work_due_date-{{ work.item.id }}" />
</div>
<div class="small-12 medium-2 columns">
    <label for="work_late_date-{{ work.item.id }}">Late Date</label>
    <input id="work_late_date-{{ work.item.id }}"
           name="work[{{ work.item.id }}][late_date]"
           type="text"
           value="{{ unitDates[work.item.category.id].due_date }}"
           data-role="late_date"
           data-datepicker
           data-datepicker-sync
           data-datepicker-sync-enddate="#work_late_date-{{ work.item.id }}" />
</div>
