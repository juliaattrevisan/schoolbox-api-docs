<div class="compact avatar card small-12 medium-4">
    <div class="icon-due-work"></div>
    {{ work.item.title }}
</div>
<div class="small-12 medium-2 columns">
    {# Due Work: Publish Date #}
    <label for="work_publish_date-{{ work.item.id }}">Publish Date</label>
    <input id="work_publish_date-{{ work.item.id }}"
           name="work[{{ work.item.id }}][publish_date]"
           type="text"
           value="{% if work.isAbstract %}{{ unit.open_date }}{% else %}{{ work.detail.getPublishDate.localShort }}{% endif %}"
           data-role="publish_date"
           data-datepicker
           data-datepicker-sync
           data-datepicker-sync-enddate="#work_publish_date-{{ work.item.id }}" />
    <label for="work_publish_date-{{ work.item.id }}" class="hide error">This field is required.</label>
</div>
