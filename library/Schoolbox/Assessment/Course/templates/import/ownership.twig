{# Usage:
    {% include '@course/import/ownership.twig' with {
        courseSpec:                    CourseSpecification,
        component:                     CourseOutlineComponentInstance,
        targetFolders:                 Folder[],
        ownershipCandidates:           object,
        ownershipCandidates[folderId]: User[]
        _disabled:                     bool
    } only %}
#}
<input type="hidden" name="courseSpecId"  value="{{ courseSpec.id }}"  />
<input type="hidden" name="componentId"  value="{{ component.id }}"  />
{% if not _disabled %}
<div class="meta" data-mage-helptext>
    <p>Select the nominated owner of the imported coursework{% if targetFolders|length > 1 %} for each class{% endif %}.</p>
</div>
{% endif %}
<ul class="information-list no-pad">
    {% for folder in targetFolders %}
    <li>
        <div class="small-12 medium-6 column"><h4>{{ folder.name }}</h4></div>
        <div class="small-12 medium-6 column">
            {% if not _disabled %}
            <label for="ownership-{{ folder.id }}" data-mage-helptext>Coursework Ownership</label>
            {% endif %}
            <select id="ownership-{{ folder.id }}" name="ownership[{{ folder.id }}]">
                {% for candidate in ownershipCandidates[folder.id] %}
                <option value="{{ candidate.id }}">{{ _disabled ? 'Assigned' : 'Transfer' }} to {{ candidate.formatName }}</option>
                {% endfor %}
            </select>
        </div>
    </li>
    {% endfor %}
</ul>
