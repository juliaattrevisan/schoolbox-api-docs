{# A list of Units and their Tasks for the selected Course
 # This fragment is ajaxed into a section in Mage
 #}

<div class="small-12 island">
    <ul class="unit-list">
        {% for unit in units %}
            {% include '@course/unit.twig' with { '_writable': false } %}
        {% endfor %}
    </ul>
</div>
