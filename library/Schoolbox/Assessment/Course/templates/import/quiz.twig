<div class="compact avatar card small-12 large-4">
    <div class="icon-quiz"></div>
    {{ work.item.title }}
</div>
<div class="small-12 medium-3 large-2 columns hide-for-small">
    &nbsp;
</div>
<div class="small-12 medium-3 large-2 columns">
    {# Quiz: Start Date #}
    <label for="quiz_start_date-{{ work.item.id }}">Start Date</label>
    <input id="quiz_start_date-{{ work.item.id }}"
           name="quiz[{{ work.item.id }}][start_date]"
           type="text"
           value="{% if work.isAbstract %}{{ unit.open_date }}{% else %}{{ work.detail.getStart.localShort }}{% endif %}"
           data-role="start_date"
           data-datepicker
           data-datepicker-sync
           data-datepicker-sync-enddate="#quiz_start_date-{{ work.item.id }}" />
    <label for="quiz_start_date-{{ work.item.id }}" class="hide error">This field is required.</label>
</div>
<div class="small-12 medium-3 large-2 columns">
    {# Quiz: Finish Date #}
    <label for="quiz_finish_date-{{ work.item.id }}">Finish Date</label>
    <input id="quiz_finish_date-{{ work.item.id }}"
           name="quiz[{{ work.item.id }}][finish_date]"
           type="text"
           value="{% if work.isAbstract %}{{ unit.due_date }}{% else %}{{ work.detail.getFinish.localShort }}{% endif %}"
           data-role="finish_date"
           data-datepicker
           data-datepicker-sync
           data-datepicker-sync-enddate="#quiz_finish_date-{{ quiz.id }}" />
    <label for="quiz_finish_date-{{ work.item.id }}" class="hide error">This field is required.</label>
</div>
<div class="small-12 medium-3 large-2 columns hide-for-small">
    &nbsp;
</div>
