{#
    inputPrefix:      string - (optional) a prefix to include on each input
    assessmentId:     int    - the ID of the assessment in question
    assessmentDate:   ADF    - (optional) assessment date object to work with
    unitDate:         ADF    - unit date object to fall back to. Required if 'assessmentDate' not set
    endOfDay:         bool   - should the datepicker-endofday data attribute be applied (default: false)
    dateProperty:     string - the name of the property on the object, eg 'publish'
    dateLabel:        string - (optional) the human-readable label to use
    dateSyncProperty: string - the end-date to sync to
    disabled:         bool   - whether the input should be disabled
#}

{% if not inputPrefix %}{% set inputPrefix = 'a['~assessmentId~']' %}{% endif %}
{% if not dateLabel %}{% set dateLabel = dateProperty | capitalize %}{% endif %}

{# Replace array syntax for jQuery. eg 'unit[5][a][367]' => 'unit-5-a-367' #}
{% set id = inputPrefix | replace({'][': '-'}) | replace({'[': '-', ']': ''}) %}

<div class="small-12 medium-3 large-2 columns">
    <label for="{{ inputPrefix }}_{{ dateProperty }}_date">{{ dateLabel }} Date</label>
    <input id="{{ id }}_{{ dateProperty }}_date"
           name="{{ inputPrefix }}[dates][{{ dateProperty }}]"
           type="text"
           value="{% if assessmentDate.valid and not assessmentDate.isNull %}{{ endOfDay ? assessmentDate.endOfDay.local : assessmentDate.local }}{% else %}{{ unitDate.local }}{% endif %}"
           data-role="{{ dateProperty }}_date"
           data-datepicker
           data-datepicker-time
           data-datepicker-buttontext=""
           data-assessment-id="{{ assessmentId }}"
           {% if dateSyncProperty %}
           data-datepicker-sync
           data-datepicker-sync-enddate="#{{ id }}_{{ dateSyncProperty }}_date"
           {% endif %}
           {% if endOfDay %}
           data-datepicker-endofday
           {% endif %}
           {% if disabled %}disabled{% endif %}
    />
    {% if not unitDate.isNull %}
        <span class="course-use-unit-date" data-course-unit-date="{{ unitDate.local }}">Use Unit Date</span>
    {% endif %}
</div>
