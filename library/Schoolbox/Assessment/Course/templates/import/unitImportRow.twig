{#
    A single UnitImplementation. Displayed in the final stage of the Course import/modify screen.

    Data:
        unitImpl:        UnitImplementation,
        dto:             DataTransferObject,
        canReadUnitSpec: bool,
#}

{% set unitSpec                    = unitImpl.specification %}
{% set assessmentPairs             = dto.assessmentPairs[unitSpec.id] ?? [] %}
{% set unitAssessmentCount         = dto.availableAssessmentCounts[unitSpec.id] ?? [] %}
{% set unitAssessmentCountSelected = dto.selectedAssessmentCounts[unitSpec.id] ?? [] %}
{% set unitAction                  = unitImpl.id ? 'modify' : 'import' %}

<input type="hidden" name="unit[{{ unitSpec.id }}][unit_spec_id]" value="{{ unitSpec.id }}" />
<input type="hidden" name="unit[{{ unitSpec.id }}][unit_impl_id]" value="{{ unitImpl.id }}" />
<input type="hidden" name="unit[{{ unitSpec.id }}][open_date]"    value="{{ unitImpl.openDate.localShort }}" />
<input type="hidden" name="unit[{{ unitSpec.id }}][close_date]"   value="{{ unitImpl.dueDate.localShort }}" />
<div class="row" data-unit="{{ unitSpec.id }}">
    <div class="small-12 columns">
        <section>
            <ul class="action-list">
                <li class="actions-small-1">
                    <div class="list-item">

                        {# Unit title and select-all checkbox for unit asesssments #}
                        <fieldset class="checklist">
                            <input id="select-all-unit-assessments-{{ unitSpec.id }}"
                                   type="checkbox"
                                   checked=""
                                   data-select-all-unit-assessments="unit-spec-{{ unitSpec.id }}"
                                   >
                                <label for="select-all-unit-assessments-{{ unitSpec.id }}">
                                    <span class="icon-unit"></span>{{ unitSpec.folder.name }}
                                </label>
                        </fieldset>
                        {% set countSelected = 'import' == unitAction ? unitAssessmentCount : unitAssessmentCountSelected %}

                        {##
                         # No read perm on unit spec? don't show the full assessment count, just what was selected.
                         # This is so that users don't see a count that's greater than what they can actually affect.
                         #}
                        {% if not canReadUnitSpec %}
                            {% set unitAssessmentCount = countSelected %}
                        {% endif %}
                        <p class="meta">{{ unitAssessmentCount ?: "No" }} assessments{% if unitAssessmentCount %}, <span data-show-count="{{ countSelected }}"> selected</span>{% endif %}</p>

                        {# Unit assessments #}
                        <div class="row">
                            <section>
                                {% if unitAssessmentCount %}
                                    {% include '@course/import/assessmentRows.twig' with {
                                        assessmentPairs: assessmentPairs,
                                        inputPrefix:     'unit[' ~ unitSpec.id ~ '][a]',
                                        depth:           0,
                                        unitAction:      unitAction,
                                        project:         null,
                                        hideRows:        false,
                                        unitSpec:        unitSpec,
                                        unitImpl:        unitImpl,
                                        defaultDueDate:  unitDefaultDueDates[unitSpec.id],
                                        canReadUnitSpec: canReadUnitSpec,
                                    } only %}
                                {% else %}
                                    <p class="content">This {{ locale.unit }} contains no coursework.</p>
                                {% endif %}
                            </section>
                        </div>

                    </div>
                </li>
            </ul>
            <div id="unit-{{ unitSpec.id }}"
                 data-start_date="{{ unitImpl.openDate.localShort }}"
                 data-finish_date="{{ unitImpl.dueDate.localShort }}"
            >
            </div>
        </section>
    </div>
</div>

<script>
    // Select all checkbox for unit assessments
    $(function() {
        $('[data-select-all-unit-assessments]').click(function(e) {
            // Find all the checkboxes associated with this unit
            const checkboxGroupSelector = '[data-checkbox-group="' + $(e.target).data('select-all-unit-assessments') + '"]';

            if ($(e.target).prop('checked')) {
                $(checkboxGroupSelector).each(function(index,checkbox) {
                    // Select all the assessments in this unit
                    $(checkbox).prop("checked", true);
                });
            } else {
                $(checkboxGroupSelector).each(function(index,checkbox) {
                    // Deselect all the assessments in this unit
                    $(checkbox).prop("checked", false);
                });
            }
        });
    });
</script>
