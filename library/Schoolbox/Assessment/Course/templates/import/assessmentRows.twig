{#
    Recursive template to render assessment rows in the final stage of the Course import/modify screen.
    Recursive so we can render assessments inside projects.

    Data:
        assessmentPairs: AssessmentPair[]    - The assessments to render
        inputPrefix:     string              - Recursively build form data
        depth:           int                 - Level of recursion
        unitAction:      ['import'|'modify'] - Whether we are importing from UnitSpec, or modifying existing UnitImpl
        startDate:       ADF
        endDate:         ADF
        maximumDate:     ADF
        project:         Project|null        - If called recusively, the parent Project of the AssessmentPairs
        hideRows:        bool                - If true, hide the list of Assessments. (eg Project is un-checked)
        unitSpec:        UnitSpecification   - The unitSpec we are currently in
        canReadUnitSpec: bool                - Can the current user read the unit's spec?
#}

<script type="text/javascript">

    /* Use Unit Date for @course/import/date.twig
     */
    $(function () {

        // Reveal 'use unit date' if input value differs form the unit date value
        $('#import_assessments').find('[data-datepicker]').change(function() {
            var $useUnitDate = $(this).parent().next('[data-course-unit-date]');
            if ($(this).val() !== $useUnitDate.attr('data-course-unit-date')) {
                $useUnitDate.removeClass('hide');
            }
            else {
               $useUnitDate.addClass('hide');
            }
        });

        // Copy unit date into the field
        $('[data-course-unit-date]').click(function() {
            var date = $(this).attr('data-course-unit-date');
            var $input = $(this).prevAll('.input-group').find('input');

            //The unit date is already validated, so hide error message if there is one
            var error = $(this).prev('.error');

            error.remove();

            $input.val(date).trigger('change');

            // Sync dates as required
            adtp.syncDatesOnElement($input, adtp.getOptions($input), '');
        });

    });

</script>

<script>
    $(function() {
        $('[data-warn-removal]').click(function(e) {
            if (!$(e.target).prop('checked')) {
                e.preventDefault();
                $(this).confirmDialog({
                    text: 'Are you sure you want to remove this assessment? ' +
                    'Doing so will delete all associated marks from the markbook.',
                    confirmEvent: function() {
                        // Uncheck
                        $(e.target).prop("checked", false);
                        $(e.target).trigger('change')
                    }
                });
            }
        });
    });
</script>

{% import "@learningAssessment/project/macro/icon.twig" as icon %}

<ul class="information-list threaded" {% if project %}data-project="{{ project.id }}"{% endif %} style="{% if hideRows %}display: none;{% endif %}">
    {% for assessmentPair in assessmentPairs %}

        {# decide some things about this assessment #}
        {% set assessmentSpec       = assessmentPair.specification %}
        {% set assessmentImpl       = assessmentPair.implementation %}
        {% set isSpecOnly           = not assessmentImpl and assessmentSpec %}
        {% set isImplOnly           = assessmentImpl and not assessmentSpec %}
        {% set isFullPair           = not isSpecOnly and not isImplOnly %}
        {% set assessment           = assessmentImpl ?: assessmentSpec %}

        {# Note: Contradictory logic
         #
         # Contrarily, Lesson Plans do *not* accept submissions nor have feedbacks.
         # They however must have their dates synced, to avoid an andyland enforcement
         # that an open date must exist. Having acceptingResponses evaluate to (bool)true
         # allows date syncs to execute. There are alternative, but equally bad, syntaxes.
         #
         # Note: unused var in backend
         #
         # There's an array key 'acceptingResponses' that isn't used in this Course Import
         # workflow so don't change that expecting it to affect behaviours here.
         # $acceptingResponses is passed quietly and implicitly into fragments/dates.twig
         # (not mentioned in this twig file) where it's used to decide which natpickers to show
         #}
        {% set acceptingResponses   = assessment is quiz or (assessment is dueWork and not assessment.acceptNone) or assessment is lti %}
        {% set publishDateSync      = (acceptingResponses) ? 'open' : 'due' %}
        {% set dueSyncStart         = (acceptingResponses) ? 'open' : 'publish' %}
        {% set dueSyncEnd           = (acceptingResponses) ? 'close' : '' %}

        {# Default dates
         # lti, lesson plan, task, project etc. all default to needing just two dates.
         # null elements here cause an empty table cell to be rendered so it's somehat indicative of the ui
         #}
        {% set dates = ['publish', null, 'due', null] %}

        {% if assessment is dueWork %}
            {% if not assessment.acceptNone %}
                {# Due Work uniquely offers offline submissions; online submissions require all four dates #}
                {% set dates = ['publish', 'open', 'due', 'close'] %}
            {% endif %}
        {% elseif assessment is quiz %}
            {% set dates = ['publish', 'open', 'due', 'close'] %}
        {% elseif assessment is dialogAgent %}
            {# Dialog Agents are unique in that they only use three dates (due is renamed to Close in the ui) #}
            {% set dates = ['publish', 'open', null, 'due'] %}
        {% endif %}

        {# Render the assessment only if:
         # * I can read the unit spec, or:
         # * The assessment has already been imported (it has an implementation)
         #}
        {% if canReadUnitSpec or assessmentImpl %}
            {# Check the checkbox if any of following is true:
             # * Assessment already imported
             # * New import of this unit
             # * depth >= 1 && parent not not imported (ie inside a non-imported project)
             #}
            {% set isChecked = (assessmentImpl) or ('import' == unitAction) or (depth > 0 and not assessmentPair.parentPair.implementation) %}

            <li data-assessment="{{ assessment.id }}" {% if project %}data-parent-project="{{ project.id }}"{% endif %} {% if depth %}class="child"{% endif %}>
                <input type="hidden" name="{{ inputPrefix }}[{{ assessment.id }}][spec_id]" value="{{ assessmentSpec ? assessmentSpec.id : '' }}" />
                <input type="hidden" name="{{ inputPrefix }}[{{ assessment.id }}][impl_id]" value="{{ assessmentImpl ? assessmentImpl.id : '' }}" />

                <div class="small-12 columns">
                    <input type="checkbox"
                           id="a_import-{{ assessment.id}}"
                            {% if isChecked %} checked="checked" {% endif %}
                            {% if assessmentImpl %} data-warn-removal {% endif %}
                           data-assessment-import="{{ assessment.id }}"
                           data-checkbox-group="unit-spec-{{ unitSpec.id }}"
                           name="{{ inputPrefix }}[{{ assessment.id }}][checked]"
                           value="1"
                            {% if isImplOnly %}disabled data-mage-disabled{% endif %}
                    />
                    <label for="a_import-{{ assessment.id}}" class="checkbox-label" {% if isImplOnly %}title="Created in class. Not imported from Course"{% endif %}>
                        <span class="{{ icon.renderClass(assessment) }}" title="{{ assessment.defaultTypeName }}"></span>
                        <span>{{ assessment.title }} {% if assessment.workType.name %}<span class="pipe meta">{{ assessment.workType.name }}</span>{% endif %}</span>
                        {% if assessmentImpl and assessmentSpec and assessmentImpl.title != assessmentSpec.title %}
                            <br><span class="meta">Imported from '{{ assessmentSpec.title }}'</span>
                        {% endif %}
                    </label>

                    {% if isImplOnly %}<input type="hidden" name="{{ inputPrefix }}[{{ assessment.id }}][checked]" value="1" />{% endif %}
                </div>
                <div data-assessment-dates="{{ assessment.id }}"{% if not isChecked %} style="display: none;"{% endif %}>

                    {# Process each assessment's date scheme algorithmically #}
                    {% for date in dates %}
                        {% set next = dates[loop.index0 + 1] ?? null %}
                        {% set prev = dates[loop.index0 - 1] ?? null %}

                        {% if 'publish' == date %}
                            {% set label = 'Publish' %}

                            {% include '@course/import/date.twig' with {
                                assessmentDate: assessment.publishAt,
                                unitDate: unitImpl.openDate,
                                inputPrefix: inputPrefix ~ '[' ~ assessment.id ~ ']',
                                dateProperty: date,
                                dateSyncEnd: next,
                                dateLabel: label,
                                assessmentId: isImplOnly ? assessmentImpl.id : assessmentSpec.id
                            } only %}
                        {% elseif 'open' == date %}
                            {% set label = 'Open' %}

                            {% include '@course/import/date.twig' with {
                                assessmentDate: assessment.openAt,
                                unitDate: unitImpl.openDate,
                                inputPrefix: inputPrefix ~ '[' ~ assessment.id ~ ']',
                                dateProperty: date,
                                dateSyncStart: prev,
                                dateSyncEnd: next,
                                dateLabel: label,
                                assessmentId: isImplOnly ? assessmentImpl.id : assessmentSpec.id
                            } only %}
                        {% elseif 'due' == date %}
                            {# There are special treatments here.
                             #     - For lesson lans, this label sould be Lesson Plan Date
                             #     - For dialog agents, this label should be Close Date (yes, that's right)
                             #}
                            {% set label = 'Due' %}

                            {% if assessment is lessonPlan %}
                                {% set label = locale.translate('lessonPlan', false, true) %}
                            {% endif %}

                            {# Yes, I know this is confusingly named, due to the existence of an actual Close Date #}
                            {% if assessment is dialogAgent %}
                                {% set label = 'Close' %}
                            {% endif %}

                            {% include '@course/import/date.twig' with {
                                assessmentDate: assessment.dueAt,
                                unitDate: defaultDueDate,
                                endOfDay: true,
                                inputPrefix: inputPrefix ~ '[' ~ assessment.id ~ ']',
                                dateLabel: label,
                                dateProperty: date,
                                dateSyncStart: prev,
                                dateSyncEnd: next,
                                assessmentId: isImplOnly ? assessmentImpl.id : assessmentSpec.id
                            } only %}
                        {% elseif 'close' == date %}
                            {% set label = 'Late' %}

                            {% include '@course/import/date.twig' with {
                                assessmentDate: assessment.closeAt,
                                unitDate: unitImpl.dueDate.endOfDay,
                                endOfDay: true,
                                inputPrefix: inputPrefix ~ '[' ~ assessment.id ~ ']',
                                dateProperty: date,
                                dateSyncStart: prev,
                                dateLabel: label,
                                assessmentId: isImplOnly ? assessmentImpl.id : assessmentSpec.id
                            } only %}
                        {% elseif date is null %}
                            {# an empty placeholder cell for grid niceness #}
                            <div class="small-12 medium-6 large-3 columns hide-for-medium-down"><p>&nbsp;</p></div>
                        {% endif %}
                    {% endfor %}

