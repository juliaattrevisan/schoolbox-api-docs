{#
    Template to render assessment rows in the final stage of the Course import/modify screen.
    This template may be called recursively by `assessmentRow.twig` to render assessments
    within projects.

    Data:
        assessmentPairs: AssessmentPair[]    - The assessments to render
        inputPrefix:     string              - Recursively build form data
        depth:           int                 - Level of recursion
        unitAction:      ['import'|'modify'] - Whether we are importing from UnitSpec, or modifying existing UnitImpl
        startDate:       ADF
        endDate:         ADF
        maximumDate:     ADF
        project:         Project|null        - If called recusively, the parent Project of the AssessmentPairs
        hideRows:        bool                - If true, hide the list of Assessments. (eg Project is un-checked)
        unitSpec:        UnitSpecification   - The unitSpec we are currently in
        canReadUnitSpec: bool                - Can the current user read the unit's spec?
#}

<script type="text/javascript">

    /* Use Unit Date for @course/import/date.twig
     */
    $(function () {

        // Reveal 'use unit date' if input value differs form the unit date value
        $('#import_assessments').find('[data-datepicker]').change(function() {
            var $useUnitDate = $(this).parent().next('[data-course-unit-date]');
            if ($(this).val() !== $useUnitDate.attr('data-course-unit-date')) {
                $useUnitDate.removeClass('hide');
            }
            else {
               $useUnitDate.addClass('hide');
            }
        });

        // Copy unit date into the field
        $('[data-course-unit-date]').click(function() {
            var date = $(this).attr('data-course-unit-date');
            var $input = $(this).prevAll('.input-group').find('input');

            //The unit date is already validated, so hide error message if there is one
            var error = $(this).prev('.error');
            
            error.remove();

            $input.val(date).trigger('change');

            // Sync dates as required
            syncDatesOnElement($input, adtp.getOptions($input), '');
        });

    });

</script>

<script>
    $(function() {
        $('[data-warn-removal]').click(function(e) {
            if (!$(e.target).prop('checked')) {
                e.preventDefault();
                $(this).confirmDialog({
                    text: 'Are you sure you want to remove this assessment? ' +
                    'Doing so will delete all associated marks from the markbook.',
                    confirmEvent: function() {
                        // Uncheck
                        $(e.target).prop("checked", false);
                        $(e.target).trigger('change')
                    }
                });
            }
        });
    });
</script>

{% import "@learningAssessment/project/macro/icon.twig" as icon %}

<ul class="information-list threaded" {% if project %}data-project="{{ project.id }}"{% endif %} style="{% if hideRows %}display: none;{% endif %}">
    {% for assessmentPair in assessmentPairs %}

        {# decide some things about this assessment #}
        {% set assessmentSpec       = assessmentPair.specification %}
        {% set assessmentImpl       = assessmentPair.implementation %}
        {% set isSpecOnly           = not assessmentImpl and assessmentSpec %}
        {% set isImplOnly           = assessmentImpl and not assessmentSpec %}
        {% set isFullPair           = not isSpecOnly and not isImplOnly %}
        {% set assessment           = assessmentImpl ?: assessmentSpec %}
        {% set acceptingResponses   = assessment is quiz or (assessment is dueWork and not assessment.acceptNone) %}
        {% set publishDateSync      = (acceptingResponses) ? 'open' : 'due' %}
        {% set dueSyncStart         = (acceptingResponses) ? 'open' : 'publish' %}
        {% set dueSyncEnd           = (acceptingResponses) ? 'close' : '' %}

        {# Render the assessment only if:
           * I can read the unit spec, or:
           * The assessment has already been imported (it has an implementation)
         #}
        {% if canReadUnitSpec or assessmentImpl %}
            {% include '@course/import/assessmentRow.twig' with {
                assessmentPair:  assessmentPair,
                inputPrefix:     inputPrefix,
                depth:           depth,
                unitAction:      unitAction,
                startDate:       startDate,
                endDate:         endDate,
                maximumDate:     maximumDate,
                hideRows:        not isChecked,
                canReadUnitSpec: canReadUnitSpec,
            } only %}
        {% endif %}

    {% endfor %}
</ul>
