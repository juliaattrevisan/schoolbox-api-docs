{#                        {% endif %}#}
{#                    {% endif %}#}
                </div>

                {#Recurse #}
                {% if assessmentPair.subPairs|length %}
                    {% include '@course/import/assessmentRows.twig' with {
                        assessmentPairs: assessmentPair.subPairs,
                        inputPrefix:     inputPrefix ~ '[' ~ assessment.id ~ '][a]',
                        depth:           depth + 1,
                        unitAction:      unitAction,
                        startDate:       startDate is defined ? startDate : null,
                        endDate:         endDate is defined ? endDate : null,
                        maximumDate:     maximumDate is defined ? maximumDate : null,
                        project:         assessment,
                        hideRows:        not isChecked,
                        unitSpec:        unitSpec,
                        unitImpl:        unitImpl,
                        canReadUnitSpec: canReadUnitSpec,
                        defaultDueDate:  defaultDueDate
                    } only %}
                {% endif %}
            </li>
        {% endif %}

    {% endfor %}
</ul>
