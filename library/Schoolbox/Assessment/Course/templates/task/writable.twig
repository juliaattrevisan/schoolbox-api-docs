<li class="actions-small-1 actions-large-3" data-task_id="{{ task.id }}">
    <div class="list-item">
        <div class="grip"></div>
        <div class="compact avatar card small-11 wrap-down">
            {% if task.link -%}
            <a data-plugin="preview" href="{{ task.link }}">
            {% endif -%}
                <span class="{{ task.iconClass }} icon-16"></span>
                <p>{{ task.title }}</p>
            {% if task.link -%}
            </a>
            {% endif -%}
            <p class="meta">{{ task.label }}</p>
        </div>
    </div>
    <nav>
        <span class="show-for-large-up">
            {% if task.type == 1 %}
            <a href="/task/export/{{ task.id }}?return_url={{ returnUrl[unit.id] }}" class="icon-export" title="Copy this task into classes"></a>
            {% endif %}
            <a href="/task/modify/{{ task.id }}?return_url={{ returnUrl[unit.id] }}" data-reveal-id="modifyTask-{{ task.id }}" class="icon-modify" title="Modify"></a>
            <a href="/task/delete/{{ task.id }}?return_url={{ returnUrl[unit.id] }}" data-interaction="open_delete_task_form"  class="icon-delete" title="Delete"></a>
        </span>
        <span class="hide-for-large-up">
            <a href="#" class="icon-overflow" data-dropdown="dropdown-{{ task.id }}"></a>
        </span>
    </nav>
    <ul class="f-dropdown" data-dropdown-content id="dropdown-{{ task.id }}">
        <li><a href="/task/export/{{ task.id }}?return_url={{ returnUrl[unit.id] }}" class="icon-export" title="Copy this task into classes">Export to Classes</a></li>
        <li><a href="/task/modify/{{ task.id }}?return_url={{ returnUrl[unit.id] }}" data-reveal-id="modifyTask-{{ task.id }}" class="icon-modify">Modify Task</a></li>
        <li><a href="/task/delete/{{ task.id }}?return_url={{ returnUrl[unit.id] }}" data-interaction="open_delete_task_form"  class="icon-delete">Delete Task</a></li>
    </ul>
    {% include '@course/task/reveal-modal.twig' with { reveal: taskReveals[task.id] } %}
    <form action="/task/saveForm.php" method="post" data-form_type="delete_task" class="hide">
        <input type="hidden" name="action"     value="delete" />
        <input type="hidden" name="id"         value="{{ task.id }}" />
        <input type="hidden" name="category"   value="{{ unit.id }}"/>
        <input type="hidden" name="component"  value="{{ reveals[unit.id].component.id }}"/>
        <input type="hidden" name="return_url" value="{{ returnUrl[unit.id] }}"/>
    </form>
</li>
