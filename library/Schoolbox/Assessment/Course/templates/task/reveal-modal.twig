{# usage: {% include '@course/task/reveal-modal.twig' with {reveal: $data}  %} where

$data = {
    id: (string),
    method: (string),
    selfAssessed: (bool),
    component: {
        id: (int; component instance ID),
        module: (string; should be "homepage"),
        identifier: (int; homepage ID)
    },
    returnUrl: (string),
    attachzone: (object; attachzone context data)
}

#}
{% if _standalone %}
    <script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
{% endif %}

<script type="text/javascript">
    {# Addition of an AJAX form submission - need to add here because the session name and ID have to be passed. -#}
    $(function () {

        var modal  = $('#{{ reveal.method }}Task-{{ reveal.id }}'),
            form   = modal.children('form'),
            submit = form.find(':submit');

        {# Task editor - prevent empty inputs -#}
        modal.on('change, keyup', 'input[name="title"]', function () {
            var title = this.value.replace(/^\s+|\s+$/g, '');
            submit.prop('disabled', title.length === 0);
        });

        {# Url attachment options -#}
        modal.on('click', '[data-attachment] a[data-value]', function() {
            var anchor = $(this),
                type   = anchor.attr('data-value');

            form.find('input[name=type]').val(type);

            {# show only the one we want -#}
            var attachers = form.find('[data-attachment]');
            attachers.hide().filter('[data-attachment="'+type+'"]').show();

            form.find('input[name=url]').val('').prop('readonly', type == 'attach');

            if (type == 'url') {
                {#
                    tell the attacher to clear any attachments by simulating clicking of all the (one...) delete buttons
                    not jQuery.detach() - it can't trigger dropzone's event listener
                -#}
                form.find('[data-attachment="attach"]').find('[data-dz-remove]').each(function() {
                    var event = new CustomEvent('click');
                    this.dispatchEvent(event);
                });
            }

        });

        {# Did I submit an attachment? Remove it from the modal to enable reuse
           Ensure that the form is cleared AFTER you get asked if you want to add task to classes -#}
        form.on('submitCopy.courseTaskList, submitNoCopy.courseTaskList',function(){
            form.find('[data-attachment="attach"]').find('[data-dz-remove]').each(function() {
                var event = new CustomEvent('click');
                this.dispatchEvent(event);
            });
        });

        {# Did I remove an attachment? Remove the URL too -#}
        modal.on('click', 'a[data-dz-remove]', function() {
            form.find('input[name=url]').val('').prop('readonly', false);
        });
    });
</script>

<div id="{{ reveal.method }}Task-{{ reveal.id }}"
     {% if not _standalone %}
     class="reveal-modal"
     data-reveal
     aria-hidden="true"
     aria-labelledby="{{ reveal.method }}Task-{{ reveal.id }}-label"
     role="dialog"
     {% endif %}
>
    <h2 id="{{ reveal.method }}Task-{{ reveal.id }}-label">{{ reveal.method | capitalize }} Task</h2>
    <form action="/task/saveForm.php"
          method="post"
          data-form_type="task"
          data-component="component{{ reveal.component.id }}">
        <input type="hidden" name="id"        value="{{ reveal.method == 'modify' ? reveal.id : '' }}"/>
        <input type="hidden" name="category"  value="{{ reveal.component.identifier }}"/>
        <input type="hidden" name="component" value="{{ reveal.component.id }}"/>
        <input type="hidden" name="return_url" value="{{ reveal.returnUrl }}"/>

        <label for="title-new_task-{{ reveal.id }}">Title</label>
        <input id="title-new_task-{{ reveal.id }}" name="title" type="text" value="{{ reveal.title }}" />

        <div class="row" data-attachment="attach" {% if reveal.url %}style="display:none"{% endif %}> {# display:none, not .hide #}
            <div class="small-12 medium-9 columns no-pad">
                <label>Attachment</label>
                {% include 'sub/attachzone.twig' with { attachzone: reveal.attachzone.twigContext } %}
            </div>
            <div class="small-12 medium-3 columns no-pad">
                <label>&nbsp;</label>
                <a class='button icon-link sstream-attachment' data-value='url'>Link</a>
            </div>
        </div>
        <div class="row" data-attachment="url" {% if not reveal.url %}style="display:none"{% endif %}> {# display:none, not .hide #}
            <div class="small-12 medium-9 columns no-pad">
                <label>
                    Link
                    <input type='text' class='url' name='url' maxlength='1024' placeholder="http://" value="{{ reveal.url }}" />
                </label>
            </div>
            <div class="small-12 medium-3 columns no-pad">
                <label>&nbsp;</label>
                <a class='button icon-attach sstream-attachment' data-value='attach'>Attach</a>
            </div>
        </div>

        <label for="self_assess-{{ reveal.id }}">Allow self-assessment?</label>
        <div class="switch">
            <input name="self_assess" value="0" type="hidden" />
            <input name="self_assess" value="1" type="checkbox" id="self_assess-{{ reveal.id }}" {% if reveal.selfAssessed %}checked="checked"{% endif %} />
            <label for="self_assess-{{ reveal.id }}">
                <span>Yes</span>
                <span>No</span>
            </label>
        </div>
        <input type="submit" value="{{ reveal.method | capitalize }}" {% if not reveal.title %}disabled="disabled"{% endif %} />
        <span class="label full-width hide" data-create-task-indicator></span>
    </form>
    {% if not _standalone %}
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    {% endif %}
</div>
