<div id="unit-planner-container" data-test="unit-planner-container">
    {% set routeFolderSequence = routeLookupIfAuthorized('folder.postFolderSequence', {id: course.folder.id, folder: course.folder}) %}
    {% set routeImportIntoClasses = routeLookupIfAuthorized('courseImport.getImport', { courseSpecId: course.id ?? 0, folderId: 0, componentId: 0 }) %}
    {% set routeCurriculumReport = routeLookupIfAuthorized('curriculumreports.getCoverage') %}
    {% set routeModifyCourse = routeLookupIfAuthorized('course.modifyCourse', { courseSpec: course, id: course.id}) %}
    {% set routeCourseMarkbook = routeLookupIfAuthorized('courseMarkbook.getMarkbook', { courseSpec: course, courseSpecId: course.id}) %}
    {% set routeLearningAnalytics = routeLookupIfAuthorized('learningAnalytics.course', { courseSpec: course, courseSpecId: course.id}) %}
    <unit-planner
        :course-id="{{ course.id }}"
        :course-subject-code="{{ course.subjectCode ? course.subjectCode|json_encode : 'null' }}"
        :folder-id="{{ course.folder.id }}"
        course-title="{{ course.title }}"
        :units="{{ units |json_encode }}"
        :template="{{ template |json_encode }}"
        {% if editorTemplates is defined %}
        :editor-templates="{{ editorTemplates |json_encode }}"
        {% endif %}
        :routes="{{ {
            folderSequence: routeFolderSequence,
            importIntoClasses: routeImportIntoClasses,
            curriculumCoverage: routeCurriculumReport,
            newUnits: routeNewUnits,
            modifyCourse: routeModifyCourse,
            courseMarkbook: routeCourseMarkbook,
            learningAnalytics: routeLearningAnalytics
        }|json_encode }}"
    ></unit-planner>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/unitPlanner.js?v={{ config.site_version }}"></script>
