<div id="unit-planner-container" data-test="unit-planner-container">
    <unit-planner
        :course-id="{{ course.id }}"
        :folder-id="{{ course.folder.id }}"
        course-title="{{ course.title }}"
        {% set routeFolderSequence = routeLookupIfAuthorized('folder.postFolderSequence', {id: course.folder.id, folder: course.folder}) %}
        :route-folder-sequence="{{ routeFolderSequence ? (routeFolderSequence |json_encode) : 'null' }}"
        :units="{{ units |json_encode }}"
        :lti-assessments-enabled="{{ config.lti_assessments_enable ? 'true' : 'false' }}"
        :template="{{ template |json_encode }}"
        {% set routeCurriculumReport = routeLookupIfAuthorized('curriculumreports.getCoverage') %}
        :route-curriculum-coverage="{{ routeCurriculumReport ? (routeCurriculumReport|json_encode) : 'null' }}"
    ></unit-planner>
</div>
<script>
    {# Add required locales for the unit planner #}
    window.sbProps.l10n.addTerm({{ locale.project.toArray |json_encode |raw }});
    window.sbProps.l10n.addTerm({{ locale.dueWork.toArray |json_encode |raw }});
    window.sbProps.l10n.addTerm({{ locale.rubricGroup.toArray |json_encode |raw }});
    window.sbProps.l10n.addTerm({{ locale.lessonPlan.toArray |json_encode |raw }});
</script>
<script src="{{ CDN_PREFIX }}/js/bundle/unitPlanner.js?v={{ config.site_version }}"></script>
