{#
    collapsedAssessments     IAssessable[]       Column headers. Will be specs if imported from spec, impl if created in class's unit-import
    unitSpecs                UnitSpec/Model[]    The unit-specs to display as column header groups
    courseImpls              CourseImpl/Model[]  The vertical sections of the table.
    courseImportAssessments  IAssessable[][]     Indexed by courseImpl.id, then assessmentImpl.spec.id if imported from spec, or assessmentImpl.id otherwise
    courseImportStudents     User[][]            Indexed by courseImpl.id, then user.id
    assessmentImplMarks      float[][]           Average mark for an assessment impl. Indexed by [assessment spec id]['any'|'published']
    assessmentSpecMarks      float[][]           Average mark for an assessment impl. Indexed by [assessment spec id]['any'|'published']
    studentMarks             float[][][][][]     Indexed by [courseImplId][assessmentId][userId]['published'|'draft']['norm'|'hr']
    studentAverageMarks      float[][][][]       Indexed by [courseImport.id][student.id]['any'|'published']['norm'|'hr']
    studentComments          string[][][]        Indexed by [courseImplId][assessmentId][userId]
    taskProgress             int[][][]           Indexed by [courseImplId][assessmentId][userId]
    taskProgressPending      int                 Student has claimed completion
    taskProgressComplete     int                 Teacher has verified completion
#}
{% import '@learning/macro/urgency.twig' as urgency %}

{# TODO move all this into scss file #}
<style>
    .course-row{
        background: #bcd;
        color: #333;
    }
    .class-row {
        background: #a0d3e8;
        color: #333;
    }
    .class-row-heading {
        font-weight: 700;
    }
    .course-headers th {
        background: #0066b0;
        color: #eee;
        text-transform: uppercase;
        font-size: 12px;
        text-align: center;
        padding-top: 5px;
        padding-bottom: 5px;
        border-right: 1px solid #eee;
    }
    .course-headers th.transparent {
        background: #ededed;
    }
    .course-headers th.white {
        background: #fff;
    }
    .row-header, .island table.dataTable thead th {
        border-bottom: none;
    }
    .marksheet td {
        position: relative;
    }
    td a.meta {
        border-bottom: 0;
    }
    td.student-average a,
    td.student-average a.meta {
        color: #fff;
    }
    td.gradient-off-bg a {
        color: #0066b0;
    }
    .na {
        background-color: #F6F6F6;
    }
    .has-tip.meta {
        color: #9a9a9a;
        font-weight: normal;
    }
    .indicator {
        position: absolute;
        top: 0;
        right: 0;
        width: 0;
        height: 0;
    }
    .indicator.indicator-none {
        border-top: .75rem solid #CCCCCC;
        border-left: .75rem solid transparent;
    }
    .indicator.indicator-pending {
        border-top: .75rem solid #ff7d00;
        border-left: .75rem solid transparent;
    }
    .indicator.indicator-published {
        border-top: .75rem solid #4fa74f;
        border-left: .75rem solid transparent;
    }
    .legend .indicator {
        position: relative;
        top: 14px;
        right: 8px;
    }
    .legend p {
        display: inline-block;
        margin-right: 28px;
    }
</style>

<div class="row">
    <div class="small-12 island" style="overflow-x: scroll;">

        <div class="checklist" style="float:right;">
            <input type="checkbox" id="show-drafts">
            <label for="show-drafts">
                Show Drafts
            </label>
        </div>

        <div class="legend" style="float:right;">
            <p class="meta"><span class="indicator indicator-published"></span>Published mark</p>
            <p class="meta"><span class="indicator indicator-pending"></span>Pending draft mark</p>
            <p class="meta"><span class="indicator indicator-none"></span>No marks</p>
        </div>

        <table class="square-grid marksheet" data-mark-sheet>
            <thead>
            <tr class="rotate-headers">
                <th></th>
                <th><div><span>Student Weighted Average</span></div></th>
                {% for assessment in collapsedAssessments %}
                        <th><div><span>
                            {% if assessment.isSpecification %}
                                {% set participationRoute = routeLookup('learningAssessment.getSummary', {assessmentId: assessment.id, studentId: USER.id}) %}
                                {% if participationRoute %}
                                    <a href="{{ participationRoute }}">{{ assessment.title }}</a>
                                {% else %}
                                    <span>{{ assessment.title }}</span>
                                {% endif %}
                            {% else %}
                                <span>{{ assessment.title }}</span>
                            {% endif %}
                                    <br>
                        <span class="meta">{{ assessment.typeName }}</span>
                    </span></div></th>
                {% endfor %}
            </tr>
            <tr class="course-headers">
                <th class="transparent"></th>
                <th class="white"></th>
                {# Ensure single-source-of-truth regarding column ordering #}
                {% set currentUnitSpec = null %}
                {% set countUnitAssessments = 0 %}
                {% for assessment in collapsedAssessments %}
                    {% if assessment.isSpecification %}
                        {% set unitSpec = assessment.baseContext %}
                    {% else %}
                        {% set unitSpec = assessment.baseContext.specification %}
                    {% endif %}

                    {% if currentUnitSpec is null %}
                        {# first column #}
                        {% set currentUnitSpec = unitSpec %}
                        {% set countUnitAssessments = countUnitAssessments + 1 %}
                    {% elseif currentUnitSpec.id == unitSpec.id %}
                        {# next column of current unit #}
                        {% set countUnitAssessments = countUnitAssessments + 1 %}
                    {% else %}
                        {# first column of next unit #}
                        <th colspan="{{ countUnitAssessments }}">{{ currentUnitSpec.title }}</th>
                        {% set currentUnitSpec = unitSpec %}
                        {% set countUnitAssessments = 1 %}
                    {% endif %}
                {% endfor %}
                <th colspan="{{ countUnitAssessments }}">{{ currentUnitSpec.title }}</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td colspan="2" class="course-row class-row-heading">Course Unweighted Average <span data-tooltip class="hint has-tip tip-top" title="Average student cohort mark">?</span></td>
                {% for assessment in collapsedAssessments %}
                    {% if assessment.isSpecification %}
                        <td class="course-row">
                            {% if assessment is task %}
                                <span>–</span>
                            {% else %}
                                {% set marks         = assessmentSpecMarks[assessment.id] %}
                                {% set publishedMark = marks.published %}
                                {% set draftMark     = marks.any %}
                                <span {% if marks.any is defined %}data-actual-mark{% endif %}>{% if publishedMark is null %}–{% else %}{{ publishedMark | round(2) }} %{% endif %}</span>
                                {% if marks.any is defined %}
                                    <span data-draft-mark class="meta" style="display: none;">{% if draftMark is null %}–{% else %}{{ draftMark | round(2) }}%{% endif %}</span>
                                {% endif %}
                            {% endif %}
                        </td>
                    {% else %}
                        <td class="course-row na"></td>
                    {% endif %}
                {% endfor %}
            </tr>
            {% for courseImpl in courseImpls %}
                {% set courseImplAssessements = courseAssessments[courseImpl.id] %}
                <tr>
                    <td colspan="2" class="class-row class-row-heading">{{ courseImpl.folder.title }}</td>
                    {% for assessment in collapsedAssessments %}
                        {% set assessmentImpl = courseImportAssessments[courseImpl.id][assessment.id] %}
                        {% if assessmentImpl %}
                            {% set statusRoute = routeLookup('learningAssessment.getStatus', {assessmentId: assessmentImpl.id}) %}
                            <td class="class-row">
                                {% if assessment is task %}
                                    <a href="{{ statusRoute }}">–</a>
                                {% else %}
                                    {% set marks         = assessmentImplMarks[assessmentImpl.id] %}
                                    {% set publishedMark = marks.published %}
                                    {% set draftMark     = marks.any %}
                                    <a href="{{ statusRoute }}" {% if marks.any is defined %}data-actual-mark{% endif %}>{% if publishedMark is null %}–{% else %}{{ publishedMark | round(2) }} %{% endif %}</a>
                                    {% if marks.any is defined %}
                                        <a href="{{ statusRoute }}" class="meta" style="display: none;" data-draft-mark>{% if draftMark is null %}–{% else %}{{ draftMark | round(2) }}%{% endif %}</a>
                                    {% endif %}
                                {% endif %}
                            </td>
                        {% else %}
                            <td class="class-row na"></td>
                        {% endif %}
                    {% endfor %}
                </tr>
                {% for student in courseImportStudents[courseImpl.id] %}
                    <tr>
                        <th class="no-pad">
                            <div class="compact card no-pad small-12">
                                <a href="/search/user/{{ student.id }}" title="View Profile">
                                    <img src="/portrait.php?userId={{ student.externalId }}&amp;size=square32" alt="View Profile">
                                    <p>{{ student.fullName }}</p>
                                </a>
                            </div>
                        </th>

                        {#studentAverageMarks      float[][][]         Indexed by [courseImport.id][student.id]['any'|'published']#}
                        {% set marks             = studentAverageMarks[courseImpl.id][student.id] %}
                        {% set publishedNormMark = marks.published.norm %}
                        {% set draftNormMark     = marks.any.norm %}
                        {% set publishedHrMark   = marks.published.hr %}
                        {% set draftHrMark       = marks.any.hr %}

                        {% set draftsOffClass = publishedNormMark is null ? 'gradient-off-bg' : urgency.marks(publishedNormMark) ~ '-bg' %}
                        {% set draftsOnClass = draftNormMark is null ? 'gradient-off-bg' : urgency.marks(draftNormMark) ~ '-bg' %}

                        <td class="student-average {{ draftsOffClass }}" {% if marks.any is defined %}data-student-average{% endif %} data-off-class="{{ draftsOffClass }}" data-on-class="{{ draftsOnClass }}">
                            {% set gradesRoute = routeLookup('learningGrades.getGrades', {viewee: student, userId: student.id, termCode: ''}) %}
                            <a href="{{ gradesRoute }}" {% if marks.any is defined %}data-actual-mark{% endif %} title="View students {{ locale.grades.plural }}">{% if publishedNormMark is null %}–{% else %}{{ publishedHrMark }}{% endif %}</a>
                            {% if marks.any is defined %}
                                  <a href="{{ gradesRoute }}" data-draft-mark style="display: none" data-tooltip="right" class="meta has-tip tip-right" data-width="105" title="Draft Mark">{% if draftNormMark is null %}–{% else %}{{ draftHrMark }}{% endif %}</a>
                            {% endif %}
                        </td>

                        {% for assessment in collapsedAssessments %}
                            {% set aImpl = courseImportAssessments[courseImpl.id][assessment.id] %}
                            {% set participant = aImpl.participantIfExtant(student) %}
                            {% if participant and not participant.isExcluded %}
                                <td>
                                {% if assessment is task %}
                                    {% set progressStatus = taskProgress[courseImpl.id][assessment.id][student.id] %}

                                    {# Tasks do not have drafts #}
                                    {% set style = 'style="margin-bottom:0; position:absolute; top:0px;"' %}
                                    {% if taskProgressComplete == progressStatus %}
                                        {% set indicator = 'published' %}
                                        {% set progressClass = 'reviewed' %}
                                    {% elseif taskProgressPending == progressStatus %}
                                        {% set indicator = 'pending' %}
                                        {% set progressClass = 'pending' %}
                                    {% else %}
                                        {% set indicator = 'none' %}
                                        {% set progressClass = 'readonly' %}
                                    {% endif %}

                                    <div
                                        {{ style | raw  }}
                                        class="no-text progress-tick {{ progressClass }}"
                                        title="Incomplete"
                                        data-progress-tick-status="incomplete"></div>

                                {% else %}
                                    {% set participationRoute = routeLookup('learningAssessment.getSummary', {assessmentId: aImpl.id, studentId: student.id}) %}
                                    {% set comment            = studentComments[courseImpl.id][assessment.id][student.id] %}
                                    {% set marks              = studentMarks[courseImpl.id][assessment.id][student.id] %}
                                    {% set publishedMark      = marks.published %}
                                    {% set draftMark          = marks.draft %}
                                    {% set indicator = (marks.draft is defined) ? 'pending' : ((marks.published is defined) ? 'published' : 'none') %}

                                    {% if publishedMark %}
                                        {% set publishedMarkHr = publishedMark['hr'] is null ? '–' : publishedMark['hr'] %}
                                        <a href="{{ participationRoute }}" {% if marks.draft is defined %}data-actual-mark{% endif %} title="{{ comment }}" >{{ publishedMarkHr }}</a>
                                    {% else %}
                                        <a href="{{ participationRoute }}" {% if marks.draft is defined %}data-actual-mark{% endif %} title="Pending" >–</a>
                                    {% endif %}

                                    {% if marks.draft is defined %}
                                        {% set draftMarkHr = draftMark['hr'] is null ? '–' : draftMark['hr'] %}
                                        <a href="#" data-draft-mark style="display: none" data-tooltip="right" class="has-tip tip-right meta" data-width="105" title="Draft Mark">{{ draftMarkHr }}</a>
                                    {% endif %}
                                {% endif %}
                                    <span class="indicator indicator-{{ indicator }}"></span>
                                </td>
                            {% else %}
                                <td class="na"></td>
                            {% endif %}
                        {% endfor %}
                    </tr>
                {% endfor %}
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
