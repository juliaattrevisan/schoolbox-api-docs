{#
    courseSpec               CourseSpec\Model
    assessments              IAssessable[]       Column headers. Will be specs if imported from spec, impl if created in class's unit-import
    unitSpecs                UnitSpec/Model[]    The unit-specs to display as column header groups
    classImpls               CourseImpl/Model[]  The vertical sections of the table.
    courseImportAssessments  IAssessable[][]     Indexed by assessmentImpl.spec.id if imported from spec, or assessmentImpl.id otherwise
    courseImportStudents     User[][]            Indexed by user.id
    assessmentImplMarks      float[][]           Average mark for an assessment impl. Indexed by [assessment spec id]['any'|'published']
    assessmentSpecMarks      float[][]           Average mark for an assessment impl. Indexed by [assessment spec id]['any'|'published']
    studentMarks             float[][][][][]     Indexed by [classImplId][assessmentId][userId]['published'|'draft']['norm'|'hr']
    studentAverageMarks      float[][][][]       Indexed by [courseImport.id][student.id]['any'|'published']['norm'|'hr']
    studentComments          string[][][]        Indexed by [classImplId][assessmentId][userId]
    taskProgress             int[][][]           Indexed by [classImplId][assessmentId][userId]
    taskProgressPending      int                 Student has claimed completion
    taskProgressComplete     int                 Teacher has verified completion
    queryArgs                string              The filters used to generate this report, so we can export the exact same report
#}
{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learning/macro/markDecorator.twig' as decorator %}

    <div class="actions-small-1">
        {% if not classImpls | length %}
        <div class="empty-state">
            <i class="icon-curriculum"></i>
            <p>
                This course has not yet been imported to any classes or groups. <a href="{{ courseSpec._routes['courseImport.getImport'] }}">Import this course</a>.
            </p>
        </div>
        {% elseif not assessments | length %}
        <div class="empty-state">
            <i class="icon-curriculum"></i>
            <p>
                There are no activities that match the selected filters. Try altering the filters to broaden your search.
            </p>
        </div>
        {% else %}
        <div class="legend">
            <div class="indicators">
                <p class="meta"><span class="legend-indicator indicator-none"></span>Unmarked</p>
                <p class="meta"><span class="legend-indicator indicator-pending"></span>Unpublished draft</p>
                <p class="meta"><span class="legend-indicator indicator-resubmit"></span>Resubmit</p>
                <p class="meta"><span class="legend-indicator indicator-published"></span>Mark Published</p>
            </div>
        </div>
        <div class="checklist">
            <input type="checkbox" id="show-display-marks">
            <label for="show-display-marks" data-test="markbook-show-display-marks">
                Show Display Marks
                <span class="hint has-tip tip-top" data-tooltip title="Shows marks in the same format that students see">?</span>
            </label>
        </div>
        <div class="checklist">
            <input type="checkbox" id="show-drafts">
            <label for="show-drafts">
                Show Drafts
            </label>
        </div>
        <nav>
            <sbx-pop-out content-id="header-options"></sbx-pop-out>
        </nav>
        <ul id="header-options" class="f-dropdown" data-dropdown-content="">
            <li class="separator">Report</li>
            <li><a href='{{ _routes.exportReport }}'
                   data-download-spreadsheet
                   class='icon-download'>Download Spreadsheet</a></li>
        </ul>
    </div>
    <div class="diagonal-headings-table-container small-12 columns" data-diagonal-headings-table-container>
        <table class="diagonal-headings-table marksheet" data-mark-sheet>
            <thead>
            <tr class="rotate-headers">
                <th class="fixed-left"><div></div></th>
                <th class="fixed-left"><div><span>Student Weighted Average</span></div></th>
                {% if rank %}
                    <th>
                        <div>
                            <span>Course Ranking</span>
                        </div>
                    </th>
                {% endif %}
                {% for assessment in assessments %}
                        <th data-test="markbook-assessment" data-assessment="{{ assessment.id }}"><div><span>
                            {% if assessment._links.summary %}
                                <a href="{{ assessment._links.summary }}">{{ assessment.title }}</a>
                            {% else %}
                                <span>{{ assessment.title }}</span>
                            {% endif %}
                                    <br>
                        <span class="meta">{{ assessment.typeName }}</span>
                    </span></div></th>
                {% endfor %}
            </tr>
            <tr class="course-headers">
                <th class="fixed-left transparent"></th>
                <th class="fixed-left white"></th>
                {% if rank %}
                <th class="white"></th>
                {% endif %}
                {# Ensure single-source-of-truth regarding column ordering #}
                {% set currentUnitSpec = null %}
                {% set countUnitAssessments = 0 %}
                {% for assessment in assessments %}
                    {% if currentUnitSpec is null %}
                        {# first column #}
                        {% set currentUnitSpec = assessment.unitSpec %}
                        {% set countUnitAssessments = countUnitAssessments + 1 %}
                    {% elseif currentUnitSpec.id == assessment.unitSpec.id %}
                        {# next column of current unit #}
                        {% set countUnitAssessments = countUnitAssessments + 1 %}
                    {% else %}
                        {# first column of next unit #}
                        <th class="unit-title" colspan="{{ countUnitAssessments }}">{{ currentUnitSpec.title }}</th>
                        {% set currentUnitSpec = assessment.unitSpec %}
                        {% set countUnitAssessments = 1 %}
                    {% endif %}
                {% endfor %}
                <th class="unit-title" colspan="{{ countUnitAssessments }}">{{ currentUnitSpec.title }}</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <th class="course-row class-row-heading fixed-left">Course Average <span data-tooltip class="hint has-tip tip-top" title="Average student cohort mark">?</span></th>
                <th class="course-row fixed-left"></th>
                {% if rank %}
                    <th></th>
                {% endif %}
                {% for assessment in assessments %}
                    {% if assessment.stats %}
                        <td class="course-row">
                            <span {% if assessment.stats.draftMean is not null %} data-actual-mark {% endif %}>
                                {{ assessment.stats.mean | default('-') }}
                            </span>
                            {% if assessment.stats.draftMean is not null %}
                                <span data-draft-mark class="meta" style="display:none;">
                                    {{ assessment.stats.draftMean | default('-') }}
                                </span>
                            {% endif %}
                        </td>
                    {% else %}
                        <td class="course-row na"></td>
                    {% endif %}
                {% endfor %}
            </tr>
            {% for classImpl in classImpls %}
                <tr>
                    <th class="class-row class-row-heading fixed-left"><a href="/homepage/{{ classImpl.folder.id }}">{{ classImpl.folder.title }}</a></th>
                    <th class="class-row fixed-left"></th>
                    {% if rank %}
                        <th></th>
                    {% endif %}
                    {% for assessment in assessments %}
                        {% if classImpl.assessments[assessment.id] is defined %}
                            {% set assessmentImpl = classImpl.assessments[assessment.id] %}
                            <td class="class-row">
                                <a href="{{ assessmentImpl._routes['learningAssessment.getStatus'] }}">
                                    <span {% if assessment.stats.draftMean is not null %} data-actual-mark {% endif %}>
                                        {{ assessmentImpl.stats.mean | default('-') }}
                                    </span>
                                    {% if assessmentImpl.stats.draftMean is not null %}
                                        <span data-draft-mark class="meta" style="display:none;">
                                            {{ assessmentImpl.stats.draftMean | default('-') }}
                                        </span>
                                    {% endif %}
                                </a>
                            </td>
                        {% else %}
                            <td class="class-row na"></td>
                        {% endif %}
                    {% endfor %}
                </tr>
                {% for student in classImpl.students %}
                    <tr>
                        <th class="profile-cell fixed-left white">
                            <div class="c-card">
                                <div class="l-flex-row l-gap-m l-pad-s">
                                    {% include "include/portrait.twig" with {user: student, render: "tiny", roundedCorners: true} only %}
                                    <div class="l-flex-col l-flex--justify-center f-no-margins">
                                        <a href="/search/user/{{ student.id }}" title="View Profile">{{ student.fullName }}</a>
                                    </div>
                                </div>
                            </div>
                        </th>

                        {% set marks             = student.averageMarks ?? null %}
                        {% set publishedNormMark = marks.published.norm ?? null %}
                        {% set draftNormMark     = marks.any.norm ?? null %}
                        {% set publishedHrMark   = marks.published.hr ?? '–' %}
                        {% set draftHrMark       = marks.any.hr ?? '–' %}

                        {% set draftsOffClass = marks.published is defined and marks.published.hr ? urgency.marks(publishedNormMark) ~ '-bg' : 'gradient-off-bg' %}
                        {% set draftsOnClass = marks.any is defined and marks.any.hr ? urgency.marks(draftNormMark) ~ '-bg' : 'gradient-off-bg' %}

                        <th class="fixed-left student-average {{ draftsOffClass }}" {% if marks.any is defined %}data-student-average{% endif %} data-off-class="{{ draftsOffClass }}" data-on-class="{{ draftsOnClass }}">
                            <a class="{{ draftsOffClass }}" href="{{ student._routes['learningGrades.getGrades'] }}" {% if marks.any is defined %}data-actual-mark{% endif %} title="View students {{ locale.grades.plural }}">{{ publishedHrMark }}</a>
                            {% if marks.any is defined %}
                                  <a class="{{ draftsOnClass }}" href="{{ student._routes['learningGrades.getGrades'] }}" data-draft-mark style="display: none" data-tooltip="right" class="meta has-tip tip-right" data-width="105" title="Draft Mark">{{ draftHrMark }}</a>
                            {% endif %}
                        </th>
                        {% if rank %}
                            <td class="course-ranking">
                                {% if rank[student.id] is defined and publishedNormMark %}
                                    {# check if the rank object exits, and there is / was a mean score #}
                                    {{ rank[student.id] }}
                                {% else %}
                                    <span>-</span>
                                {% endif %}
                            </td>
                        {% endif %}

                        {% for assessment in assessments %}
                            {% set aImpl = classImpl.assessments[assessment.id] ?? null %}
                            {% if aImpl %}
                            {% set participant = aImpl.participants[student.id] %}
                            <td
                                class="column-{{ assessment.id }} {% if not participant or participant.isExcluded %} excluded {% endif %} student-grade-cell"
                                data-test="markbook-cell-{{ assessment.id }}-{{ student.id }}"
                                data-assessment="{{ assessment.id }}"
                                {% if canAccessPopOut and (assessment.assessmentType == 'dueWork' or assessment.assessmentType == 'quiz' or assessment.assessmentType == 'lti' ) %}
                                data-pop-out-menu
                                {% endif %}
                                data-assessment-type="{{ assessment.assessmentType }}"
                                data-is-participant="{% if participant %}true{% else %}false{% endif %}"
                                data-is-excluded="{% if participant and not participant.isExcluded %}false{% else %}true{% endif %}"
                                data-endpoint="{{ aImpl._routes.student[student.id]['learningAssessmentTimeline.getFullTimeline'] }}"
                                data-update-route="{{ aImpl._routes.student[student.id]['learningDueWorkResponse.getParticularResponse'] }}"
                                data-review-route="{{ aImpl._routes.student[student.id]['learningDueWorkResponse.getParticularResponse'] }}"
                                data-publish-route="{{ aImpl._routes.student[student.id]['learningDueWorkFeedback.postPublishFeedback'] }}"
                                data-exclude-route="{{ aImpl._routes.student[student.id]['learningAssessment.postExclude'] }}"
                                data-include-route="{{ aImpl._routes.student[student.id]['learningAssessment.postInclude'] }}"
                                data-history-route="{{ aImpl._routes.student[student.id]['learningAssessment.getSummary'] }}"
                            >
                            {% if participant and not participant.isExcluded %}
                                {% if assessment.assessmentType == 'task' %}
                                    <div
                                        style="margin-bottom:0; position:absolute; top:0px;"
                                        class="no-text progress-tick {{ participant.progressTick.progressClass }}"
                                        {# always incomplete...? nope, that's wrong #}
                                        title="Incomplete"
                                        data-progress-tick-status="incomplete"
                                    ></div>
                                {% else %}
                                    {% set marks              = participant.marks %}
                                    {% set publishedMark      = marks.published ?? null %}
                                    {% set draftMark          = marks.draft ?? null %}

                                    <span
                                        class="{{ urgency.marks(publishedMark.norm ?? null) }}"
                                        {% if marks.draft %}data-actual-mark{% endif %}
                                        title="{{ publishedMark.comment ?? '' }}"
                                    >
                                        <span data-instructor-mark>{{ decorator.label(participant, true, true) }}</span>
                                        <span data-learner-mark style="display: none">{{ decorator.label(participant, true, false) }}</span>
                                    </span>
                                    {% if marks.draft %}
                                        <span
                                            data-draft-mark
                                            style="display: none"
                                            data-tooltip="right"
                                            class="has-tip tip-right meta"
                                            data-width="105"
                                            title="Draft Mark"
                                        >
                                            <span data-instructor-mark>{{ decorator.label(participant, false, true) }}</span>
                                            <span data-learner-mark style="display: none">{{ decorator.label(participant, false, false) }}</span>
                                        </span>
                                    {% endif %}
                                    {% if participant.hasSubmittedResponse or participant.resubmissionRequired or participant.hasPublishedFeedback or draftMark %}
                                        <span class="legend-indicator indicator-{{ decorator.indicator(participant, draftMark) }}" title="{{ decorator.notchTitle(participant, draftMark) }}"></span>
                                    {% endif %}
                                {% endif %}
                            {% endif %}
                            </td>
                            {% else %}
                            <td class="na"></td>
                            {% endif %}
                        {% endfor %}
                    </tr>
                {% endfor %}
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>
