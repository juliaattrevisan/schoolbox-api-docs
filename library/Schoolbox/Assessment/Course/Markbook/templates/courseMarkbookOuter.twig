{#
    Course Markbook report wrapper

    Usage:
        courseSpec:  CourseSpec
        filterPanel: FilterPanel - a filter panel that can filter and AJAX in the report
#}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    ['Courses', routeLookupIfAuthorized('course.courseList') ],
    ['Course Markbook'])
}}

<div class="row">
    <div class="small-12 columns">
        <h1>Course Markbook: {{ courseSpec.title }}</h1>
    </div>
</div>

{% set filterEventKey = 'MARKBOOK' %}

{% include '@filters/panel.twig' with {
    contentId: null,
    eventKey:  filterEventKey,
    panel:     filterPanel,
    quickload: false,
} only %}

<div id="markbook-outer-container" class="marksheet-wrapper row">
    <markbook-outer type='course' filter-event-key="{{ filterEventKey }}" />
</div>
<script src="{{ CDN_PREFIX }}/js/submissions/jquery.combobox.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/markbookOuter.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
