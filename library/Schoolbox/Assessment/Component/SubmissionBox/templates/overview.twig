<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Overview</h1>
            <ul class="meta">
                <li class="icon-due-work"><a href="/submission/viewSubmission/{{ box.id }}">{{ box.name }}</a></li>
                <li class="icon-due-work">{{ box.workType.name }}</li>
            </ul>
        </div>
    </div>
    <nav>
        <a href="/submission/overview/{{ box.id }}/csv" class="icon-download" title="Download CSV"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 columns">
        <div class="scrollable">
            <table>
                <tbody>
                    <tr>
                        {% if box.markType.slug == 'rubric' %}
                        <th rowspan="2"></th>
                        {% for group, criteria in headers %}
                            <th colspan="{{ criteria | length }}">{{ group }}</th>
                        {% endfor %}
                    </tr>
                    <tr>
                        {% for criteria in headers %}
                            {% for criterion in criteria %}
                                <th>{{ criterion }}</th>
                            {% endfor %}
                        {% endfor %}
                        {% else %}
                            <th></th>
                            <th>Marks</th>
                        {% endif %}
                    </tr>
                    {% for student in students %}
                    <tr>
                        <td class="no-pad">
                            <div class="avatar card">
                                <a href="/search/user/{{ student.id }}" title="View Profile">
                                    <img src="/portrait?userId={{ student.externalId }}&size=square64" alt="View Profile" />
                                    <p>{{ student.formatName('{lastname}, {firstname}') }}</p>
                                </a>
                            </div>
                        </td>
                        {% if box.markType.slug == 'rubric' %}
                            {% for criteria in headers %}
                                {% for id, criterion in criteria %}
                                    <td>{{ marks[student.id][id] }}</td>
                                {% endfor %}
                            {% endfor %}
                        {% else %}
                            <td>{{ box.marks[student.id].displayValue }}</td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

        </div>
    </div>
</div>
