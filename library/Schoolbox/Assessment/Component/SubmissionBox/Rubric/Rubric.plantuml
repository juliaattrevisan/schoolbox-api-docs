@startuml
class RubricRowset {
    groups : RubricGroup[]
    folder : Folder
}
class RubricGroup {
    criteria : RubricCriterion[]
    name : string
}
class RubricCriterion {
    name : string
}

RubricRowset -u- Folder
RubricRowset *-d- RubricGroup
RubricGroup *-d- RubricCriterion

class RubricGrid {
    assessment : IAssessable
    rowset : RubricRowset
    levels : RubricLevel[]
    groups : RubricGroupUsage[]
    descriptors : RubricDescriptor[]
    getRow(RubricCriterion) : RubricDescriptor[]
    getColumn(RubricLevel) : RubricDescriptor[]
    getDescriptor(RubricCriterion, RubricLevel) : RubricDescriptor
}

class RubricGroupUsage {
    group : RubricGroup
    criteria : RubricCriterionUsage[]
    maxValue : float
}

class RubricCriterionUsage {
    criterion : RubricCriterion
}

class RubricLevel {
    name : string
}

interface IAssessable

RubricGrid *-l- RubricRowset
RubricGrid *-u- IAssessable
RubricGrid *-d- RubricDescriptor
RubricGrid *-d- RubricGroupUsage
RubricGroupUsage *-l- RubricGroup
RubricGroupUsage *-d- RubricCriterionUsage
RubricCriterionUsage *-l- RubricCriterion
RubricGrid *-d- RubricLevel

class RubricMarkedGrid {
    grid : RubricGrid
    feedback : IFeedback
    marks : RubricMark[]
    getTotalMark() : float
}

class RubricMark {
    descriptor : RubricDescriptor
    value : float
}

class RubricDescriptor {
    description : string
    value : float
}

interface IFeedback

RubricMarkedGrid *-l- RubricGrid
RubricMarkedGrid *-u- IFeedback
RubricMarkedGrid *-d- RubricMark
RubricMark *-l- RubricDescriptor
@enduml
