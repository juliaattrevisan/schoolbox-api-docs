@startuml

interface IAssessable

Folder *-- RubricGroup
RubricGroup *-- RubricCriterion

Folder *-- IAssessable
IAssessable <|-- DueWork

DueWork *-- RubricGroupUsage
RubricGroup *-- RubricGroupUsage
' Duework has a RubricGroup through RubricGroupUsage
'(DueWork, RubricGroup) .. RubricGroupUsage
RubricGroupUsage *-- RubricCriterionUsage
RubricCriterionUsage *-- RubricCriterion

' DueWork has rubric descriptors through level*critusage
DueWork *-- RubricLevel
RubricCriterionUsage -- RubricLevel
(RubricCriterionUsage, RubricLevel) .. RubricDescriptor
@enduml



@startuml
class RubricRowset {
    groups : RubricGroup[]
    folder : Folder
}
class RubricGroup {
    criteria : RubricCriterion[]
    name : string
}
class RubricCriterion {
    name : string
}

RubricRowset -- Folder

RubricRowset *-- RubricGroup

RubricGroup *-- RubricCriterion
@enduml


@startuml
class RubricGrid {
    assessment : IAssessable
    rowset : RubricRowset
    levels : RubricLevel[]
    groups : RubricGroupUsage[]
    descriptors : RubricDescriptor[]
    getRow(RubricCriterion) : RubricDescriptor[]
    getColumn(RubricLevel) : RubricDescriptor[]
    getDescriptor(RubricCriterion, RubricLevel) : RubricDescriptor
}

class RubricGroupUsage {
    group : RubricGroup
    criteria : RubricCriterionUsage[]
    maxValue : float
}

class RubricCriterionUsage {
    criterion : RubricCriterion
}

class RubricLevel {
    name : string
}

interface IAssessable

RubricGrid *-- RubricRowset
RubricGrid *-- IAssessable
RubricGrid *-- RubricDescriptor
RubricGrid *-- RubricGroupUsage
RubricGroupUsage *-- RubricCriterionUsage
RubricGrid *-- RubricLevel
@enduml


@startuml
class RubricMarkedGrid {
    grid : RubricGrid
    feedback : IFeedback
    marks : RubricMark[]
    getTotalMark() : float
}

class RubricMark {
    descriptor : RubricDescriptor
    value : float
}

interface IFeedback

RubricMarkedGrid *-- IFeedback
RubricMarkedGrid *-- RubricMark
RubricMark *-- RubricDescriptor
@enduml
