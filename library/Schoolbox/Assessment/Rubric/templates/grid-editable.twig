{% set formField = formField ?? 'rb' %}
{# Doesn't exist? #}
{#{% set inputType = rubric.multiSelect ? 'checkbox' : 'radio' %}#}
{# Use assessment ID I suppose #}
{% set rubricId  = 'rb-' ~ rubricGrid.id %}
{% set levelLimit = levelLimit ?? config.rubric_max_levels %}

    <input type="hidden" name="formField" value="{{ formField }}" />
    <h3 class="subheader show-for-medium-down">Levels</h3>
    <div class="scrollable">
    <table data-rubric="{{ rubricGrid.id }}" data-rb-grid class="rb stack-for-medium-down" id="{{ rubricId }}">
        <thead>
        <tr>
            <th class="rb-no-cell">{{ locale.translate('rubricGroup', true, true) }}</th>
            <th class="rb-no-cell">{{ locale.translate('rubricCriterion', true, true) }}</th>
            {% for level in rubricGrid.levels -%}
                {%- include '@rubric/level-editable.twig' with {
                    levelIndex: loop.index0
                } -%}
            {%- endfor %}
            <th><a href="#" data-spawn="level">&plus; {{ locale.translate('rubricLevel', false, true) }}</a></th>
        </tr>
        </thead>
        <tbody>
        {% for groupIndex, group in rubricGrid.iterateCapabilities -%}
            {%- include '@rubric/group-editable.twig' with { rowspan: rowspan ?? (group.indicators|length + 2) } -%}
        {%- endfor %}
        <tr class="rb-group-header rb-new-group">
            <th colspan="{{ rubricGrid.levels|length + 3 }}">
                <textarea data-group-grid-text data-spawn="group" placeholder="+ Type to add new {{ locale.translate('rubricGroup') }}"></textarea>
            </th>
        </tr>
        </tbody>
    </table>
    </div>
{# js specific to the rubric we just injected to...wherever we injected it #}
<script type="text/javascript">
    $(function () {
        /**
         * only add maxlength to fields that actually change.
         * to then only validate those fields characters count
         */
        {# maxCapabilityLength/maxIndicatorLength is 900, due to the way browsers look at maxlength as character lenght, but mysql table looks at char byte lenght
        so if there are bullet points in the textbox they count as 3 characters, and will cause issues, so lets work on 900 as the limit, and we shouldn't hit the db max...#}
        let maxCapabilityLength = 900, maxIndicatorLength = 900;
        $('[data-group-row-text]').on('change', (event) => {
            event.target.setAttribute('maxlength', maxCapabilityLength);
        });
        $('[data-group-edit-text]').on('change', (event) => {
            event.target.setAttribute('maxlength', maxCapabilityLength);
        });
        $('[data-group-grid-text]').on('change', (event) => {
            event.target.setAttribute('maxlength', maxCapabilityLength);
        });
        $('[data-criterion-text]').on('change', (event) => {
            event.target.setAttribute('maxlength', maxIndicatorLength);
        });
    });
</script>
