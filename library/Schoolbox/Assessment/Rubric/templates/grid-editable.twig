{% set formField = formField ?? 'rb' %}
{# Doesn't exist? #}
{#{% set inputType = rubric.multiSelect ? 'checkbox' : 'radio' %}#}
{# Use assessment ID I suppose #}
{% set rubricId  = 'rb-' ~ rubricGrid.id %}
{% set levelLimit = levelLimit ?? config.rubric_max_levels %}

    <input type="hidden" name="formField" value="{{ formField }}" />
    <h3 class="subheader show-for-medium-down">Levels</h3>
    <div class="scrollable">
    <table data-rubric="{{ rubricGrid.id }}" data-rb-grid class="rb stack-for-medium-down" id="{{ rubricId }}">
        <thead>
        <tr>
            <th class="rb-no-cell">{{ locale.translate('rubricGroup', true, true) }}</th>
            <th class="rb-no-cell">{{ locale.translate('rubricCriterion', true, true) }}</th>
            {% for level in rubricGrid.levels -%}
                {%- include '@rubric/level-editable.twig' with {
                    levelIndex: loop.index0
                } -%}
            {%- endfor %}
            <th><a href="#" data-spawn="level">&plus; {{ locale.translate('rubricLevel', false, true) }}</a></th>
        </tr>
        </thead>
        <tbody>
        {% for groupIndex, group in rubricGrid.iterateCapabilities -%}
            {%- include '@rubric/group-editable.twig' with { rowspan: rowspan ?? (group.indicators|length + 2) } -%}
        {%- endfor %}
        <tr class="rb-group-header rb-new-group">
            <th colspan="{{ rubricGrid.levels|length + 3 }}">
                <textarea data-group-grid-text data-spawn="group" placeholder="+ Type to add new {{ locale.translate('rubricGroup') }}"></textarea>
            </th>
        </tr>
        </tbody>
    </table>
    </div>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/scrollTo/jquery.scrollTo.min.js"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/jquery.rubric-editable.js"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/assessment/jquery.sequencer.js"></script>
{# js specific to the rubric we just injected to...wherever we injected it #}
<script type="text/javascript">

    $(function () {

        $('#{{ rubricId }}').rubricEditable({
            url: '{{ routeLookup("rubric.create") }}',
            rubricId: '{{ rubricGrid.id }}',
            formField: '{{ formField }}',
            levelLimit: {{ levelLimit }},
            localisedGroupName: '{{ locale.translate('rubricGroup', false, true) }}',
            localisedCriterionName: '{{ locale.translate('rubricCriterion', false, true) }}',
            swap: aniswap
        });

        function aniswap(move, first, second) {

/*
            // put these together for ease of code (apparently not as simple as it sounds...?)
            var both = $.merge($(), first);
            $.merge(both, second);

            // cache the top and left positions of each element we're going to be moving around
            both.each(function () {
                var e = $(this),
                        o = e.offset();

                e.data('otop', o.top);
                e.data('oleft', o.left);
            });
*/

            // What kind of swap is this?
            // * Descriptor or level:     swap names of input elements within first and second
            // * Capability or indicator: don't swap
            var sequencerGroup = first.attr('data-sequencer-group');
            if (sequencerGroup === 'levels' || typeof sequencerGroup === 'undefined') {
                var commonInputs = [
                    '[data-id]',
                    '[data-level]',
                    '[data-descriptor-text]',
                    '[data-descriptor-value]'
                ];
                commonInputs.forEach(function(input) {
                    var firstInput  = first.find(input),
                        secondInput = second.find(input);
                    if (firstInput.length && secondInput.length) {
                        var firstName  = firstInput.attr('name'),
                            secondName = secondInput.attr('name');
                        firstInput.attr('name', secondName);
                        secondInput.attr('name', firstName);
                    }
                });
            }

            // apply the DOM manipulation
            first[move](second);

/*
            // set the transform to visually "undo" the DOM respositioning
            both.each(function () {
                var e = $(this),
                        o = e.offset(),
                        t = {
                            x: e.data('oleft') - o.left,
                            y: e.data('otop') - o.top
                        };

                e.css({
                    transform: [ 'translateX(', t.x, 'px) translateY(', t.y, 'px)' ].join('')
                });
            });

            // set the animation class
            both.addClass('animating');

            setTimeout(function () {
                // remove the transforms and let the animation glide them into their natural positions
                both.css({ transform: '' });

                // wait for the duration of the animation, then clear the animation class
                setTimeout(function () {
                    both.removeClass('animating');
                }, 1000);

            }, 10);
*/

        }
        /**
         * only add maxlength to fields that actually change.
         * to then only validate those fields characters count
         */
        document.querySelector('[data-group-row-text]').addEventListener('change', (event) => {
            event.target.setAttribute('maxlength', 900);
        });
        document.querySelector('[data-group-edit-text]').addEventListener('change', (event) => {
            event.target.setAttribute('maxlength', 900);
        });
        document.querySelector('[data-group-grid-text]').addEventListener('change', (event) => {
            event.target.setAttribute('maxlength', 900);
        });
        document.querySelector('[data-criterion-text]').addEventListener('change', (event) => {
            event.target.setAttribute('maxlength', 900);
        });
    });
</script>
