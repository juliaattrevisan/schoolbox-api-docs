{% set formField = formField ?: 'rb' %}
{% set inputType = rubric.multiSelect ? 'checkbox' : 'radio' %}
{% set rubricId  = 'rb-' ~ rubric.id %}
{% set levelLimit = levelLimit ?: config.rubric_max_levels %}

    <input type="hidden" name="formField" value="{{ formField }}" />
    <h3 class="subheader show-for-medium-down">Levels</h3>
    <div class="scrollable">
    <table data-rubric="{{ rubric.id }}" class="rb stack-for-medium-down" id="{{ rubricId }}">
        <thead>
        <tr>
            <th class="rb-no-cell">{{ locale.translate('rubricGroup', true, true) }}</th>
            <th class="rb-no-cell">{{ locale.translate('rubricCriterion', true, true) }}</th>
            {% for levelSequence, level in rubric.levels -%}
            <th class="rb-level" data-sequencer-group="levels">
                <input data-level placeholder="{{ locale.translate('rubricLevel', false, true) }} name" type="text" value="{{ level.name }}" name="{{ formField }}[{{ rubric.id }}][level][{{ levelSequence }}][name]" />
                <span class="sequencer" data-sequencer-h="levels">
                    <a class="icon-previous" data-sequencer-left title="Move left"></a>
                    <a class="icon-next" data-sequencer-right title="Move right"></a>
                </span>
            </th>
            {%- endfor %}
            {% if rubric.levels|length < levelLimit %}
            <th><a href="#" data-spawn="level">&plus; {{ locale.translate('rubricLevel', false, true) }}</a></th>
            {% endif %}
        </tr>
        </thead>
        <tbody>
        {% for groupIndex, group in rubric.groups -%}
            {%- include '@rubric/group-editable.twig' with { rowspan: rowspan ?: group.criteria|length + 2 } -%}
        {%- endfor %}
        <tr class="rb-group-header rb-new-group">
            <th colspan="{{ rubric.levels|length + 3 }}">
                <input data-spawn="group" type="text" value="" placeholder="+ Type to add new {{ locale.translate('rubricGroup') }}" />
            </th>
        </tr>
        </tbody>
    </table>
    </div>

<script type="text/javascript" src="/javascript/shared/submissions/jquery.rubric-editable.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.sequencer.js"></script>
{# js specific to the rubric we just injected to...wherever we injected it #}
