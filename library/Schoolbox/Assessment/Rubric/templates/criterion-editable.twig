{%- set critInput    = formField ~ '[' ~ rubric.id ~ '][criterion]['  ~ crit.id ~ ']' -%}
{%- set descInput    = formField ~ '[' ~ rubric.id ~ '][descriptor][' ~ crit.id ~ ']' -%}
{%- set checkChecked = crit.descriptors|length > 0 -%}
{%- set cellClass    = checkChecked ? '' : 'hide-v' -%}
{%- set levelLimit   = levelLimit ?: config.rubric_max_levels -%}

<th>
    <span class="sequencer" data-sequencer-v="{{ groupId }}">
        <a class="icon-up-arrow" data-sequencer-up title="Move up"></a>
        <a class="icon-down-arrow" data-sequencer-down title="Move down"></a>
    </span>

    <input type="hidden" name="{{ critInput }}[groupId]" value="{{ group.id }}" />
    <input  id="{{ critInput }}[on]" data-criterion-name="{{ crit.name }}" name="{{ critInput }}[on]" type="checkbox" value="1" {% if checkChecked %}checked="checked"{% endif %} />

    {%- if crit.used -%}

    <label for="{{ critInput }}[on]" class="checkbox-label rb-criterion rb-readonly">
        {# raw HTML unable to be sanctioned or rejected - I don't know whether this could be HTML or not. Maybe use |nl2br filter? #}
        {{- crit.name | raw -}}
        <span data-tooltip class="hint has-tip tip-right" data-width="200" title="This {{ locale.translate('rubricCriterion') }} cannot be modified because it is in use elsewhere">?</span>
        <input type="hidden" value="{{ crit.name }}" name="{{ critInput }}[name]" />
    </label>

    {%- else -%}

    <label for="{{ critInput }}[on]" class="checkbox-label rb-criterion rb-editable">
        <textarea name="{{ critInput }}[name]">{{ crit.name }}</textarea>
    </label>

    {%- endif -%}

</th>

{% for levelIndex, level in rubric.levels -%}
    {%- set descriptor = rubric.descriptors[crit.id][levelIndex] -%}

    <td data-descriptor class="{{ cellClass }}">
        <textarea {% if not checkChecked %} disabled="disabled"{% endif %}
                data-descriptor-text
                placeholder="Descriptor"
                rows="2"
                name="{{ descInput }}[{{ levelIndex }}][text]">{{ descriptor.text }}</textarea>
        <input {% if not checkChecked %} disabled="disabled"{% endif %}
                data-descriptor-value
                data-descriptor-value-original="{{ descriptor.value }}"
                data-descriptor-criterion="{{ crit.id }}"
                data-descriptor-level-index="{{ levelIndex }}"
                {% if checkChecked %}data-descriptor-original{% endif %}
                class="rb-value"
                type="text"
                placeholder="Points"
                value="{{ descriptor.value }}"
                name="{{ descInput }}[{{ levelIndex }}][points]" />
    </td>

{%- endfor %}
<td class="{{ cellClass }}">&nbsp;</td>
