<th class="rb-level" data-sequencer-group="levels">
    <input data-id
           type="hidden"
           value="{{ level.id }}"
           name="{{ formField }}[{{ rubricGrid.id }}][level][{{ levelIndex }}][id]" />
    <input data-level
           placeholder="{{ locale.translate('rubricLevel', false, true) }} name"
           type="text"
           value="{{ level.name }}"
           name="{{ formField }}[{{ rubricGrid.id }}][level][{{ levelIndex }}][name]"
           maxlength="128" />
    <span class="sequencer" data-sequencer-h="levels">
        <a class="sbx-icon-only-button no-text" data-sequencer-left title="Move left" aria-label="Move left"><sbx-icon name="previous"></sbx-icon></a>
        <a class="sbx-icon-only-button no-text" data-sequencer-right title="Move right" aria-label="Move right"><sbx-icon name="next"></sbx-icon></a>
    </span>
</th>
