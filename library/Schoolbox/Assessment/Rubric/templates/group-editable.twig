{# ensure these are set #}
{%- set rubricId  = rubricId ?? ('rb-' ~ rubricGrid.id) -%}
{%- set groupId   = rubricId ~ '-' ~ groupIndex -%}
{%- set groupName = group.name ?? ('(no ' ~ locale.translate('rubricGroup') ~ ')') -%}
{%- set levelLimit = levelLimit ?? config.rubric_max_levels -%}
{%- set groupInput = groupInput ?? (formField ~ '[' ~ rubricGrid.id ~ '][group]['  ~ groupIndex ~ ']') -%}

{# Don't show the max value if there are no selected criteria in the group #}
{% set hasSelectedDescriptor = false %}

{%- for crit in rubricGrid.iterateIndicators(group) -%}
    {% set criterionUsage = rubricGrid.retrieveIndicatorUsage(crit) %}
    {% include '@rubric/group-row-editable.twig' %}
    {# this may seem bizarre, but we only ever want this applied the first time through an interation #}
    {% set rowspan = null %}

    {# Descriptors now come from the rubric grid's copy of this criterion, not the row set #}
    {% if criterionUsage %}
        {% set hasSelectedDescriptor = true %}
    {% endif %}

{% else %}
    {# TODO undupe this, this is the same template as @rubric/group-row-editable.twig #}
    <tr data-group="{{ groupId }}" data-sequencer-group="{{ rubricId }}-groups" data-groupname="{{ groupName }}" class="rb-group-header">
        {# no criteria specified, meaning this was an empty group (and the above iteration didn't run) #}
        <th rowspan="2">
            <span class="sequencer hide" data-sequencer-v="{{ rubricId }}-groups">
                <a class="icon-up-arrow" data-sequencer-up title="Move up"></a>
                <a class="icon-down-arrow" data-sequencer-down title="Move down"></a>
            </span>
            <input type="hidden" name="{{ groupInput }}[id]" value="{{ group.id }}" data-group-id />
            {% if group.name %}
                <label>
                    {%- if group.inUseExcluding(rubricGrid.assessment) -%}
                        {{ groupName | nl2br }}
                        <span data-tooltip class="hint has-tip tip-right" data-width="200" title="This {{ locale.translate('rubricGroup') }} cannot be modified because it contains one or more {{ locale.translate('rubricCriterion', false, true) }} that are in use elsewhere">?</span>
                        <input type="hidden" value="{{ groupName }}" name="{{ groupInput }}[name]" />
                    {% else %}
                        <textarea data-group-edit-text name="{{ groupInput }}[name]">{{ groupName }}</textarea>
                    {% endif %}
                </label>
            {% else %}
                <label class="meta">{{ groupName | nl2br }}</label>
            {% endif %}
        </th>
    </tr>
{%- endfor -%}

<tr data-group="{{ groupId }}" class="rb-new-criterion">
    <th colspan="{{ rubricGrid.levels|length + 2 }}">
        <textarea data-spawn="criterion" placeholder="+ Type to add new {{ locale.translate('rubricCriterion') }} {{ group.name ? ('to ' ~ group.name) : ('with no ' ~ locale.translate('rubricGroup')) }}" maxlength="900"></textarea>
    </th>
</tr>

{# Input for max value #}
{% set showGroupMaxValue = (usingMarkPerCapability ?? false) and hasSelectedDescriptor %}
<tr data-group="{{ groupId }}" data-group-max-value-row {% if not showGroupMaxValue %}class="hide"{% endif %}>
    <th class="rb-group-summary" data-group-max-value-cell colspan="{{ rubricGrid.levels|length + 3 }}">
        <label for="{{ groupInput }}[maxValue]">Maximum points for {{ locale.translate('rubricGroup') }}</label>
        {# This is a tel input rather than number because in Firefox and Chrome, scrolling while the number field is focused changes the value.
           We found this to be a significant UX issue, and disabling it is kinda gross: https://stackoverflow.com/questions/9712295/disable-scrolling-on-input-type-number
           Number inputs also do not consistently restrict entry to numeric values across browsers: https://bugzilla.mozilla.org/show_bug.cgi?id=1398528
           #}
        <input type="tel"
               value="{{ rubricGrid.retrieveCapabilityUsage(group).maxValue ?? '' }}"
               name="{{ groupInput }}[maxValue]"
               data-group-max-value
               {% if not showGroupMaxValue %}disabled class="hide"{% endif %}
        />
        <a data-use-criterion-values class="fieldAssign">Assign <span data-rubric-sum></span> from {{ locale.translate('rubricCriterion',true) }}</a>
    </th>
</tr>
