{##
 # This template must support both an empty and a marked grid.
 #
 # Parameters:
 # * rubricGrid:              the base rubric grid object
 # * rubricMarkedGrid:        the marked rubric grid, shouldst there be one
 # * learnerRubricMarkedGrid: the self-assessed marked grid, shouldst there be one
 # * markVisibility:          ? Should be inferred from grid's assessment (assessment.isVisibleTo(USER))
 # * useMarkRange:            ? Should be inferred from grid's assessment (assessment.markRange)
 # * showGroupTotal:          ? Should be inferred from grid's assessment (assessment.markPerCapability)
 #}


<div class="scrollable">
<table class="rb stack-for-medium-down">
    {% set hasLevels = '' %}
    {% for level in rubricGrid.levels %}
        {% set hasLevels = hasLevels ~ level.name %}
    {% endfor %}
    {% if hasLevels | length %}
    <thead>
    <tr>
        <th colspan="2" class="rb-no-cell">&nbsp;</th>
        {% for level in rubricGrid.levels %}
        <th>{{ level.name }}</th>
        {% endfor %}
    </tr>
    </thead>
    {% endif %}
    <tbody>

    {% for groupIndex, groupUsage in rubricGrid.capabilityUsages %}

        {% set rowspan        = groupUsage.indicatorUsages|length + (rubricGrid.assessment.markPerCapability ? 1 : 0) %}
        {% set capabilityMark = rubricMarkedGrid ? rubricMarkedGrid.retrieveCapabilityMark(groupUsage) : null %}

        {% for critIndex, critUsage in groupUsage.indicatorUsages %}
            <tr>
                {# yay html tables... -_-; #}
                {% if rowspan %}
                    <th rowspan="{{ rowspan }}">{{ groupUsage.capability.name }}</th>
                    {% set rowspan = 0 %}
                {% endif %}

                <th>{{ critUsage.indicator.name }}</th>

                {% set indicatorMark           = rubricMarkedGrid ? rubricMarkedGrid.retrieveIndicatorMark(critUsage) : null %}
                {% set indicatorMarkDescriptor = indicatorMark    ? indicatorMark.descriptor                          : null %}

                {% for levelIndex, level in rubricGrid.levels %}

                    {% set descriptor = critUsage.retrieveDescriptor(levelIndex) %}

                    {% if descriptor %}

                        {# Self-Assessment #}
                        {#{% set learnerSelected      = learnerRubric.descriptors[crit.id][levelIndex].selected %}#}

                        {% set isDescriptorSelected = indicatorMarkDescriptor == descriptor %}
                        {% set isMarkDisplayed      = isDescriptorSelected and rubricGrid.assessment.isFeedbackVisibleToUser(USER) %}

                        <td {% if isMarkDisplayed %}class="rb-selected"{% endif %}>
                            <div>
                                <p>
                                    {{- descriptor.description|nl2br -}}
                                </p>
                                {% if descriptor.hasValue and config.rubric_show_points %}
                                    <aside>
                                        {% if rubricGrid.assessment.useMarkRange and descriptor.hasRange %}
                                            {% if isMarkDisplayed %}
                                                <span class="range-selection-value">{{ indicatorMark.value }}</span>
                                            {% endif %}
                                            <span class="range {% if isMarkDisplayed %}selected{% endif %}">{{descriptor.minValue}}–{{descriptor.maxValue}}</span>
                                        {% else %}
                                            {{ descriptor.maxValue }}
                                        {% endif %}
                                    </aside>
                                {% endif %}

                            {# Self-Assessment #}
                            {#{% if learnerSelected %}#}
                                {#<img class="rb-self-reflection-choice"#}
                                     {#src="/portrait.php?userId={{ learner.externalId }}&amp;size=square32"#}
                                     {#title="{% if latestSelfReflectedFeedback.normalisedMark != null %}{{ locale.selfAssessment.proper }}{% else %}{{ locale.selfReflection.proper }}{% endif %} choice" />#}
                            {#{% endif %}#}
                            </div>
                        </td>

                    {% else %}
                        <td class="rb-blank">&nbsp;</td>
                    {% endif %}

                {% endfor %}
            </tr>
        {% endfor %}

        {# Capability mark: needs to be rendered in human-readable form, use the assessment's mark scheme to do so #}
        {% if rubricGrid.assessment.markPerCapability and capabilityMark %}
            <tr>
                <th class="rb-group-summary" colspan="{{ rubricGrid.levels|length + 2 }}">
                    {{ capabilityMark.retrieveHumanReadableMark }}

                    {# Self-Assessment #}
                    {#{% if learnerRubric %}#}
                        {#({{ learnerRubric.groups[groupIndex].humanReadableMark }} given in {{ locale.selfAssessment.singularForm }})#}
                    {#{% endif %}#}
                </th>
            </tr>
        {% endif %}

    {% endfor %}

    {# Overall mark #}
    {% if showRubricTotal and rubricMarkedGrid %}
        <tr>
            <th class="rb-final-summary" colspan="{{ rubricGrid.levels|length + 2 }}">
                {{ rubricMarkedGrid.retrieveHumanReadableMark }}

                {# Self-Assessment #}
                {#{% if learnerRubric %}#}
                    {#({{ learnerRubric.humanReadableMark }} given in {{ locale.selfAssessment.singularForm }})#}
                {#{% endif %}#}
            </th>
        </tr>
    {% endif %}
    </tbody>

</table>
</div>
