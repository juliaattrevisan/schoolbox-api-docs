{##
 # This template must support both an empty and a marked grid.
 #
 # Parameters:
 # * rubricGrid:              the base rubric grid object
 # * rubricMarkedGrid:        the marked rubric grid, shouldst there be one
 # * selfAssessmentFeedback:  the self-assessed feedback, shouldst there be one
 # * markVisibility:          ? Should be inferred from grid's assessment (assessment.isVisibleTo(USER))
 # * showRubricTotal:         ? Whether to show the totals at the bottom of overall rubric
 #                              This is false for student views, but true for staff views
 # * showGroupTotal:          ? Whether to show group totals at the bottom of each capability, can be inferred from
                                    (assessment.markPerCapability)
 # * showDescriptorValue:     ? Whether points should be shown alongside descriptors, note there is also a config setting
                                that also controls this, false for self-reflections
 #}

<div data-vue-app="rubric-grid">
    <rubric-grid
        :rubric="{{ rubricGrid|json_encode }}"
        :rubric-marked-grid="{{ (rubricMarkedGrid ?? null)|json_encode }}"
        :self-assessment-feedback="{{ (selfAssessmentFeedback.rubricMarkedGrid ?? null)|json_encode }}"
        :assessment-mark-scheme="{
            template: {{ rubricGrid.assessment.markScheme.template|json_encode }},
            context: {{ rubricGrid.assessment.markScheme.generateContext|json_encode }}
        }"
        {# TODO: these are signs of likely permission issues #}
        {% if showRubricTotal ?? false %}show-rubric-total{% endif %}
        {% if showGroupTotal ?? false %}show-group-total{% endif %}
        {% if showDescriptorValue ?? false %}show-descriptor-value{% endif %}
    />
</div>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/rubricGrid.js?v={{ config.site_version }}"></script>

{# TODO: nothing to see here... temporary while there are two rubrics here #}
<div style="background: var(--sbx-config-color-body-background, var(--body-background))"><br></div>


{% set showSummaryCapability = showGroupTotal and rubricMarkedGrid and rubricGrid.assessment.isMarkPerCapability %}
<div class="scrollable">
    <table class="rb markable">
    <tbody>

    {% for groupIndex, groupUsage in rubricGrid.capabilityUsages %}
        {% for critIndex, critUsage in groupUsage.indicatorUsages %}
            <tr>
                <th class="rb-criterion-name markdown">{{ critUsage.indicator.name | markdown }}</th>

                {% set indicatorMark = rubricMarkedGrid
                    ? rubricMarkedGrid.retrieveIndicatorMark(critUsage)
                    : null %}
                {% set indicatorMarkDescriptor = indicatorMark
                    ? indicatorMark.descriptor
                    : null %}
                {% set selfAssessmentIndicatorMark = selfAssessmentFeedback is defined and selfAssessmentFeedback
                    ? selfAssessmentFeedback.rubricMarkedGrid.retrieveIndicatorMark(critUsage)
                    : null %}

                {% for levelIndex, level in rubricGrid.levels %}

                    {% set descriptor = critUsage.retrieveDescriptor(levelIndex) %}

                    {% if descriptor %}

                        {# Self-Assessment #}
                        {% set isDescriptorSelected = indicatorMarkDescriptor == descriptor %}
                        {% set isMarkDisplayed      = isDescriptorSelected and rubricGrid.assessment.isFeedbackVisibleToUser(USER) %}

                        <td data-header="{{ level.name }}" {% if isMarkDisplayed %}class="rb-selected"{% endif %}>
                            <div>
                                {# This container displays rubric levels for the mobile view. #}
                                <div class="hide-for-large-up l-pad-m hide-on-print"></p><b>{{ level.name | markdown }}</b></p></div>
                                <span class="rb-description markdown">
                                    {# Self-Assessment #}
                                    {% if selfAssessmentIndicatorMark and selfAssessmentIndicatorMark.descriptor.id == descriptor.id %}
                                        <img class="rb-self-reflection-choice"
                                             src="/portrait.php?id={{ learner.id }}&amp;size=square32"
                                             title="{% if selfAssessmentFeedback.isSelfGrading %}({{ selfAssessmentIndicatorMark.value }}) {{ locale.selfAssessment.proper }}{% else %}{{ locale.selfReflection.proper }}{% endif %} choice" />
                                    {% endif %}
                                    {{- descriptor.description | markdown -}}
                                </span>
                                {% if descriptor.hasValue and config.rubric_show_points and rubricGrid.showDescriptorValue and showDescriptorValue %}
                                    <span class="rb-value used" >
                                        {% if rubricGrid.useMarkRange and descriptor.hasRange %}
                                            {% if isMarkDisplayed %}
                                                <span class="range-selection-value">{{ indicatorMark.value }}</span>
                                            {% endif %}
                                            <span class="range {% if isMarkDisplayed %}selected{% endif %}">
                                                {{ descriptor.retrieveLeftValue }}–{{ descriptor.retrieveRightValue }}
                                            </span>
                                        {% else %}
                                            {{ descriptor.maxValue }}
                                        {% endif %}
                                    </span>
                                {% endif %}
                            </div>
                        </td>

                    {% else %}
                        <td class="rb-blank hide-for-medium-down">&nbsp;</td>
                    {% endif %}

                {% endfor %}
            </tr>
        {% endfor %}
    {% endfor %}
    </tbody>

</table>
</div>
