{##
 # This template must support both an empty and a marked grid.
 #}


<div class="scrollable">
<table class="rb stack-for-medium-down">
    {% set hasLevels = '' %}
    {% for level in rubric.levels %}
        {% set hasLevels = hasLevels ~ level.name %}
    {% endfor %}
    {% if hasLevels | length %}
    <thead>
    <tr>
        <th colspan="2" class="rb-no-cell">&nbsp;</th>
        {% for level in rubric.levels %}
        <th>{{ level.name }}</th>
        {% endfor %}
    </tr>
    </thead>
    {% endif %}
    <tbody>

    {% for groupIndex, group in rubric.groups %}

        {% set rowspan = group.criteria|length + (showGroupTotal ? 1 : 0) %}

        {% for critIndex, crit in group.criteria %}
            <tr>
                {# yay html tables... -_-; #}
                {% if rowspan %}
                    <th rowspan="{{ rowspan }}">{{ group.name }}</th>
                    {% set rowspan = 0 %}
                {% endif %}

                <th>{{ crit.name }}</th>

                {% for levelIndex, level in rubric.levels %}

                    {% set descriptor = rubric.descriptors[crit.id][levelIndex] %}

                    {% if descriptor %}

                        {# Self-Assessment #}
                        {% set learnerSelected = learnerRubric.descriptors[crit.id][levelIndex].selected %}

                        <td {% if descriptor.selected and markVisibility %}class="rb-selected"{% endif %}>
                            <div>
                                <p>
                                    {{- descriptor.text|nl2br -}}
                                </p>
                                {% if descriptor.value is not null and config.rubric_show_points %}
                                    <aside>
                                        {% set direction = rubric.descriptorMetadata[crit.id].direction %}
                                        {% set descriptorMin = rubric.descriptorMetadata[crit.id][levelIndex].min %}
                                        {% set descriptorMax = rubric.descriptorMetadata[crit.id][levelIndex].max %}

                                        {% if useMarkRange and descriptorMin != descriptorMax %}
                                            {% if descriptor.selected and markVisibility %}
                                                <span class="range-selection-value">{{ descriptor.selectedValue }}</span>
                                            {% endif %}
                                            <span class="range {% if descriptor.selected and markVisibility %}selected{% endif %}">
                                                {%- if direction == 'asc' -%}
                                                    {{descriptorMin}}–{{descriptorMax}}
                                                {%- else -%}
                                                    {{descriptorMax}}–{{descriptorMin}}
                                                {%- endif -%}
                                            </span>
                                        {% else %}
                                            {{ descriptor.value }}
                                        {% endif %}
                                    </aside>
                                {% endif %}

                            {# Self-Assessment #}
                            {% if learnerSelected %}
                                <img class="rb-self-reflection-choice"
                                     src="/portrait.php?userId={{ learner.externalId }}&amp;size=square32"
                                     title="{% if latestSelfReflectedFeedback.normalisedMark != null %}{{ locale.selfAssessment.proper }}{% else %}{{ locale.selfReflection.proper }}{% endif %} choice" />
                            {% endif %}
                            </div>
                        </td>

                    {% else %}
                        <td class="rb-blank">&nbsp;</td>
                    {% endif %}

                {% endfor %}
            </tr>
        {% endfor %}

        {% if showGroupTotal and group.humanReadableMark %}
            <tr>
                <th class="rb-group-summary" colspan="{{ rubric.levels|length + 1 }}">
                    {{ group.humanReadableMark }}

                    {# Self-Assessment #}
                    {% if learnerRubric %}
                        ({{ learnerRubric.groups[groupIndex].humanReadableMark }} given in {{ locale.selfAssessment.singularForm }})
                    {% endif %}
                </th>
            </tr>
        {% endif %}

    {% endfor %}

    {% if showRubricTotal and rubric.humanReadableMark %}
        <tr>
            <th class="rb-final-summary" colspan="{{ rubric.levels|length + 2 }}" >
                {{ rubric.humanReadableMark }}

                {# Self-Assessment #}
                {% if learnerRubric %}
                    ({{ learnerRubric.humanReadableMark }} given in {{ locale.selfAssessment.singularForm }})
                {% endif %}
            </th>
        </tr>
    {% endif %}
    </tbody>

</table>
</div>
