{##
 # This template must support both an empty and a marked grid.
 #
 # Parameters:
 # * rubricGrid:              the base rubric grid object
 # * rubricMarkedGrid:        the marked rubric grid, shouldst there be one
 # * selfAssessmentFeedback:  the self-assessed feedback, shouldst there be one
 # * markVisibility:          ? Should be inferred from grid's assessment (assessment.isVisibleTo(USER))
 # * showGroupTotal:          ? Should be inferred from grid's assessment (assessment.markPerCapability)
 # * blindMode:                 whether you're reviewing in Blind Mode
 #                              Also depends if this is a self-reflection
 #}

{% set showPoints = true %}
{% set selfAssessmentMarkedGrid = selfAssessmentFeedback ? selfAssessmentFeedback.rubricMarkedGrid : null %}
{% set markScheme = selfAssess or studentView ? rubricGrid.assessment.markScheme : rubricGrid.assessment.instructorMarkScheme %}

<div data-vue-app="rubric-markable">
    {# TODO: multiple rubrics, <rubric-markable> #}
    <rubric-markable-grid
        :rubric="{{ rubricGrid.toArray(showPoints)|json_encode }}"
        :rubric-marked-grid="{{ (rubricMarkedGrid ? rubricMarkedGrid.toArray(USER, showPoints) : null)|json_encode }}"
        :self-assessment-feedback="{{ (selfAssessmentMarkedGrid ? selfAssessmentMarkedGrid.toArray(USER, showPoints) : null)|json_encode }}"
        :assessment-mark-scheme="{
            template: {{ markScheme.template|json_encode }},
            context: {{ markScheme.generateContext|json_encode }}
        }"
        :participant-id="{{ not blindMode and learner.id ? learner.id : 'null' }}"
        {# TODO: these are signs of likely permission issues #}
        {% if showRubricTotal ?? false %}show-rubric-total{% endif %}
        {% if showGroupTotal ?? false %}show-group-total{% endif %}
    />
</div>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/rubricMarkable.js?v={{ config.site_version }}"></script>

{% autoescape 'js' %}
{% if false %}
<script type="text/javascript">
    $(function () {
        const markType  = "{{ markScheme.generateContext.mode }}";

        $("[data-feedback-form]").validate(
            {
                errorPlacement: function (error, element) {
                    var $nextEl = element.next("[data-use-descriptor-values]");
                    error.insertAfter($nextEl);
                }
            }
        );

        // Add validation rules for per-capability marks
        $("[data-group-mark]").each(function() {

            // Can't validate letter grade dropdown as its values are preset on the frontend
            if (markType !== 'letter') {
                // Percentage and total mark types must be numeric
                $(this).rules('add', {
                    number: true
                });

                // If percentage mark type, range is between 0 and 100
                if (markType === 'percent') {
                    $(this).rules('add', {
                        range: [0, 100]
                    });
                } else if (markType === "raw" || markType === 'none') {
                    // Otherwise, range is between 0 and capability max
                    var capMax = $(this).closest("[data-group-summary]").attr("data-max");

                    $(this).rules('add', {
                        range: [0, parseFloat(capMax)]
                    });
                }
            }
        });

        function revalidateCapMarks() {
            $("[data-group-mark]").each(function() {
                $(this).valid();
            });
        }

        // Overwrite any custom mark in the capability mark field with the scaled mark calculated from descriptor values
        $("[data-use-descriptor-values]").on('click', function(e) {
            revalidateCapMarks();
        });
    });
</script>
{% endif %}
{% endautoescape %}
