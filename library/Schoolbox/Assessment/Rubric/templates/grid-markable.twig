{% import '@learningMarkScheme/macro/limitDecimal.twig' as limit_decimal %}

{% set formField = 'rubric' %}
{% set rubricId = 'rb-' ~ rubric.id %}
{% set markType = markType ?: { mode: 'raw' } %}
{% set showDescriptorValue = showDescriptorValue ? true : false %}
{% set showGroupTotal = showGroupTotal ? true : false %}
{% set showRubricTotal = showRubricTotal ? true : false %}

<div class="scrollable">
    <table class="rb markable stack-for-medium-down" id="{{ rubricId }}">

        {# Suppress level headings if none have names #}
        {% set hasLevels = false %}
        {% for level in rubric.levels if level.name | trim | length %}
            {% set hasLevels = true %}
        {% endfor %}
        {% if hasLevels  %}
        <thead>
            <tr>
                <th colspan="2">&nbsp;</th>
                {% for level in rubric.levels %}
                <th>{{ level.name }}</th>
                {% endfor %}
            </tr>
        </thead>
        {% endif %}
        <tbody>
            {% for groupIndex, group in rubric.groups %}
                {# Use rowspans when group total is visible, otherwise don't need it
                 # This is only off when self-reflecting with a grid that doesn't show descriptor points
                 # and groups - here, it never shows the group subtotal, and rowspan calcs are off
                 #}
                {% set rowspan = group.criteria|length %}

                {% if self != 'selfReflection' and showGroupTotal %}
                    {% set rowspan = group.criteria|length + (group.max ? 1 : 0) %}
                {% endif %}

                {% for critIndex, crit in group.criteria %}
                <tr data-group="{{ rubricId }}-{{ group.id }}">
                    {# yay html tables... -_-; #}
                    {% if rowspan %}
                        <th class="rb-group-name" rowspan="{{ rowspan }}"><span>{{ group.name }}</span></th>
                        {% set rowspan = 0 %}
                    {% endif %}

                    <th class="rb-criterion-name">{{ crit.name }}</th>

                    {# Required so that this form is recognised as containing a rubric, even if nothing is submitted #}
                    <input name="saveEmpty" value="true" type="hidden"/>

                    {% for levelIndex, level in rubric.levels %}
                        {% set descriptor = rubric.descriptors[crit.id][levelIndex] %}

                        {% if descriptor %}

                            {% set inputId %}{{ formField }}[{{ crit.id }}][{{ level.id }}]{% endset %}

                            {# Self-Assessment #}
                            {% set learnerSelected = learnerRubric.descriptors[crit.id][levelIndex].selected %}
                            <td>
                                <input id="{{ inputId }}"
                                       name="{{ formField }}[descriptors][{{ descriptor.id }}][selected]"
                                       value="1"
                                       type="checkbox"
                                       data-value="{{ descriptor.value }}"
                                       data-rubric="{{ rubric.id }}"
                                       data-rubric-group="{{ group.id }}"
                                       data-rubric-descriptor="{{ descriptor.id }}"
                                       {% if descriptor.selected %}checked="checked"{% endif %}
                                />

                                <label for="{{ inputId }}">
                                    <span class="rb-description">
                                        {{- descriptor.text|nl2br -}}
                                    </span>

                                    {% set direction = rubric.descriptorMetadata[crit.id].direction %}
                                    {% set descriptorMin = rubric.descriptorMetadata[crit.id][levelIndex].min %}
                                    {% set descriptorMax = rubric.descriptorMetadata[crit.id][levelIndex].max %}
                                    {% set hidePoints = not config.rubric_show_points or (studentView and selfReflect) %}

                                    {# Just show a text value if the descriptor is not selected #}
                                    {% if descriptor.value is not null and showDescriptorValue and not hidePoints %}
                                        <span class="rb-value {% if descriptorMin == descriptorMax or not useMarkRange %}used {% elseif descriptor.selected %}hide{% endif %}">
                                            {% if useMarkRange and descriptorMin != descriptorMax %}
                                                {% if direction == 'asc' %}
                                                    {{- descriptorMin -}} - {{- descriptorMax -}}
                                                {% else %}
                                                    {{- descriptorMax -}} - {{- descriptorMin -}}
                                                {% endif %}
                                            {% else %}
                                                {{ descriptor.value }}
                                            {% endif %}
                                        </span>
                                    {% endif %}
                                </label>
                                {# Render a dropdown to select a value from the range #}
                                {# TODO this select needs a label; technically it should be the one above but that's already in use for the descriptor checkbox #}
                                <select id="rangeDropdown-{{ descriptor.id }}"
                                        name="{{ formField }}[descriptors][{{ descriptor.id }}][value]"
                                        class="{% if not descriptor.selected or descriptorMin == descriptorMax or not useMarkRange %} hide{% endif %}
                                        {% if useMarkRange and descriptorMin != descriptorMax and not hidePoints %}used{% endif %}"
                                        data-rubric="{{ rubric.id }}"
                                        data-rubric-group="{{ group.id }}"
                                        data-rubric-descriptor="{{ descriptor.id }}"
                                >
                                    {% set rangeStart = direction == 'asc' ? descriptorMin : descriptorMax %}
                                    {% set rangeEnd = direction == 'asc' ? descriptorMax : descriptorMin %}

                                    {# Selected value: if not provided, use max #}
                                    {% set selectedValue = descriptor.selectedValue ?? descriptorMax %}

                                    {% for i in rangeStart..rangeEnd %}
                                        <option value={{ i }}
                                                {% if i == selectedValue %}selected{% endif %}
                                        >{{ i }}
                                        </option>
                                    {% endfor %}
                                </select>

                                {% if learnerSelected %}
                                    <img class="rb-self-reflection-choice"
                                         src="/portrait.php?userId={{ learner.externalId }}&amp;size=square32"
                                         title="{% if latestSelfReflectedFeedback.normalisedMark != null %}{{ locale.selfAssessment.proper }}{% else %}{{ locale.selfReflection.proper }}{% endif %} choice" />
                                {% endif %}
                            </td>

                        {% else %}
                            <td class="rb-blank">&nbsp;</td>
                        {% endif %}

                    {% endfor %}
                </tr>
            {% endfor %}

        {% if group.max and showGroupTotal and markSchemeName != "None" and (config.rubric_show_points or not studentView) %}
            <tr>
                <th class="rb-group-summary" colspan="{{ rubric.levels|length + 1 }}">
                    <span data-group-summary="{{ rubricId }}-{{ group.id }}"
                          data-mark="{{ limit_decimal.limit(group.mark, 2) }}"
                          data-scaled-mark="{{ limit_decimal.limit(group.scaledMark, 2) }}"
                          data-max="{{ limit_decimal.limit(group.max, 2) }}"
                          data-row-max-sum="{{ limit_decimal.limit(group.rowMaxSum, 2) }}">

                        {% if markSchemeName == 'TotalMarkFractional' %}
                            {{ limit_decimal.limit(group.scaledMark, 2) }} / {{ limit_decimal.limit(group.max, 2) }}
                        {% else %}
                            {{ group.humanReadableMark }}
                        {% endif %}
                    </span>

                    {# Self-Assessment #}
                    {% if learnerRubric %}
                        {% if latestSelfReflectedFeedback.isSelfGrading %}
                            {% set selfReflectionName = locale.selfAssessment.proper %}
                        {% else %}
                            {% set selfReflectionName = locale.selfReflection.proper %}
                        {% endif %}

                        ({{ learnerRubric.groups[groupIndex].humanReadableMark }} given in {{ selfReflectionName }})
                    {% endif %}
                </th>
            </tr>
        {% endif %}

    {% endfor %}

    {% if rubric.max and showRubricTotal and (config.rubric_show_points or not studentView) %}
        <tr>
            <th class="rb-final-summary" colspan="{{ rubric.levels|length + 2 }}">
                <span data-final-summary="{{ rubricId }}"
                      data-scaled-mark="{{ limit_decimal.limit(rubric.scaledMark, 2) }}"
                      data-max="{{ limit_decimal.limit(rubric.max, 2) }}">

                    {% if markSchemeName == 'TotalMarkFractional' %}
                       {{ limit_decimal.limit(rubric.scaledMark, 2) }} / {{ limit_decimal.limit(rubric.max, 2) }}
                    {% else %}
                       {{ rubric.humanReadableMark }}
                    {% endif %}
                </span>

                {# Self-Assessment #}
                {% if learnerRubric %}
                    {% if latestSelfReflectedFeedback.isSelfGrading %}
                        {% set selfReflectionName = locale.selfAssessment.proper %}
                    {% else %}
                        {% set selfReflectionName = locale.selfReflection.proper %}
                    {% endif %}

                    ({{ learnerRubric.humanReadableMark }} given in {{ selfReflectionName }})
                {% endif %}
            </th>
        </tr>
    {% endif %}

        </tbody>
    </table>
</div>
{# js specific to the rubric we just injected to...wherever we injected it #}
<script type="text/javascript" src="/javascript/shared/submissions/jquery.dynagrade.js"></script>
<script type="text/javascript">
    $(function () {

        var $rb = $('#{{ rubricId }}');

        // initialise dynamic mark display
        $rb.dynagrade({{ markType | json_encode | raw }});

        $rb.on('change change.preload', '[data-rubric], [data-rubric-group]', function (e) {

            var $changed = $(this);

            var groupId  = $changed.data('rubric-group');
            var rubricId = $changed.data('rubric');

            var rowSelector = '[data-group="rb-' + rubricId + '-' + groupId + '"]';

            var $groupRows = $(rowSelector);

            var rubricTotalMark = 0;

            if ($groupRows.length) {

                var groupSummarySelector = '[data-group-summary="rb-' + rubricId + '-' + groupId + '"]';
                var groupSummary = $rb.find(groupSummarySelector);

                var scaledGroupMark = getScaledGroupMark($groupRows.find('input'), groupSummary);

                if (groupSummary.length) {
                    groupSummary.attr('data-scaled-mark', scaledGroupMark);

                    parseFraction(groupSummary, null);
                }

                rubricTotalMark = getTotalMark(rubricId);
            }

            var rubricSummarySelector = '[data-final-summary="rb-' + rubricId + '"]';

            var rubricSummary = $rb.find(rubricSummarySelector);

            rubricSummary.attr('data-scaled-mark', rubricTotalMark);

            parseFraction(rubricSummary, e.namespace);

            // This seems to be unused
            // $('[data-role=rubric-scaled-mark]').text(rubricSummary.text());

            // What cell was actually changed?
            if ($changed.is(':checkbox')) {
                showHideRangeInput($changed);
            } else {
                showHideRangeInput($changed.siblings(':checkbox'));
            }
        });

        function showHideRangeInput($changedCell) {
            var $allCellsInRow = $changedCell.parents("tr").find("[data-rubric], [data-rubric-group]");

            // Hide dropdowns on all cells in the same row
            $allCellsInRow.siblings("select").addClass("hide");

            // Disable all dropdowns so they don't get POSTed
            $allCellsInRow.siblings("select").prop("disabled", true);

            // Show text labels on all cells in the same row
            $allCellsInRow.siblings("label").find(".rb-value").removeClass("hide");

            if ($changedCell.prop('checked')) {
                // Hide the text label on the selected cell
                $changedCell.siblings("label").find(".rb-value").addClass("hide");

                // This will only un-hide an element if that element is the one we need to use on that cell:
                // - Dropdowns are only used on cells with a range
                // - Cells with a single value just get a text label

                $changedCell.siblings("select.used").removeClass("hide");
                $changedCell.siblings("select.used").prop("disabled", false); // Re-enable so we can use it and it gets POSTed
                $changedCell.siblings("label").find(".rb-value.used").removeClass("hide");
            }
        }

        function getScaledGroupMark($descriptorCheckboxes, groupSummary)
        {
            var groupMax = groupSummary.attr('data-max');
            var groupRowMaxSum = groupSummary.attr('data-row-max-sum');

            var groupSum = 0;

            // in lieu of a reduce() function
            $descriptorCheckboxes.map(function () {
                var $descriptorCheckbox = $(this);

                if ($descriptorCheckbox.prop('checked')) {
                    // Is there a select box for this? If so use its value instead
                    var descriptorId = $descriptorCheckbox.data('rubricDescriptor'),
                        $select = $rb.find('#rangeDropdown-'+String(descriptorId)),
                        descriptorValue;
                    if ($select.length) {
                        descriptorValue = parseFloat($select.val());
                    } else {
                        descriptorValue = parseFloat($descriptorCheckbox.data('value'));
                    }
                    if (!isNaN(descriptorValue)) {
                        groupSum += descriptorValue;
                    }
                }
            });

            var scaledGroupSum = groupSum * (groupMax / groupRowMaxSum);

            if(scaledGroupSum % 1 != 0){
                scaledGroupSum = scaledGroupSum.toFixed(2);
            }

            return scaledGroupSum;
        }


        function getTotalMark()
        {
            var groupSummary = $rb.find('[data-group-summary]');
            var totalMark = 0;

            groupSummary.each(function() {
                var groupScaledMark = parseFloat($(this).attr('data-scaled-mark'));
                if (!isNaN(groupScaledMark)) {
                    totalMark += groupScaledMark;
                }
            });

            // If sum isn't a whole number: round to 2dp
            if(totalMark % 1 != 0){
                totalMark = totalMark.toFixed(2);
            }

            return totalMark;
        }

        // If not multi-select, simulate radio behaviour per row (simpler to do this than intercept radio checked event!)
        {% if not rubric.multiSelect %}
        // Can't delegate this, as auto-mark will run before it can un-check siblings
        $('[data-rubric-descriptor]').on('change', function(event){

            var $descriptorInput = $(this);
            var $checkboxGroup   = $descriptorInput.closest('[data-group]');
            var $descriptors     = $checkboxGroup.find('[data-rubric-descriptor]');

            $descriptors.each(function(idx, elem){
                var $otherDescriptor = $(elem);
                if($otherDescriptor.data('rubric-descriptor') != $descriptorInput.data('rubric-descriptor')){
                    $otherDescriptor.prop('checked', false);
                }
            });
        });
        {% endif %}

        /**
         *
         * @param {jQuery} $elem
         * @param {string|null} namespace
         */
        function parseFraction($elem, namespace)
        {
            var ev = 'dynagrade';
            if (namespace) {
                ev = ev + '.' + namespace;
            }

            $elem.each(function () {
                if (this.hasAttribute('data-scaled-mark') && this.hasAttribute('data-max')) {
                    $(this).trigger(ev);
                }
            });

        }

    });
</script>