{##
 # This template must support both an empty and a marked grid.
 #
 # Parameters:
 # * rubricGrid:              the base rubric grid object
 # * rubricMarkedGrid:        the marked rubric grid, shouldst there be one
 # * selfAssessmentFeedback:  the self-assessed feedback, shouldst there be one
 # * markVisibility:          ? Should be inferred from grid's assessment (assessment.isVisibleTo(USER))
 # * useMarkRange:            ? Should be inferred from grid's assessment (assessment.markRange)
 # * showGroupTotal:          ? Should be inferred from grid's assessment (assessment.markPerCapability)
 # * blindMode:                 whether you're reviewing in Blind Mode
 #                              Also depends if this is a self-reflection
 #}


{% import '@learningMarkScheme/macro/limitDecimal.twig' as limit_decimal %}

{% set formField = 'rubric' %}
{% set rubricId = 'rb-' ~ rubricGrid.assessment.id %}
{% set markType = rubricGrid.assessment.markScheme.generateContext %}
{% set showDescriptorValue = showDescriptorValue ? true : false %}
{% set showGroupTotal = showGroupTotal ? true : false %}
{% set showRubricTotal = showRubricTotal ? true : false %}

<div class="scrollable">
    <table class="rb markable" id="{{ rubricId }}">

        {# Suppress level headings if none have names #}
        {% set hasLevels = false %}
        {% for level in rubricGrid.levels | filter(level => level.name | trim | length )  %}
            {% set hasLevels = true %}
        {% endfor %}
        {% if hasLevels  %}
        <thead>
            <tr>
                <th colspan="2">&nbsp;</th>
                {% for level in rubricGrid.levels %}
                <th class="markdown">{{ level.name | markdown }}</th>
                {% endfor %}
            </tr>
        </thead>
        {% endif %}
        <tbody>
            {% for groupIndex, groupUsage in rubricGrid.capabilityUsages %}
                {# Use rowspans when group total is visible, otherwise don't need it
                 # This is only off when self-reflecting with a grid that doesn't show descriptor points
                 # and groups - here, it never shows the group subtotal, and rowspan calcs are off
                 #}
                {% set capabilityMark = rubricMarkedGrid ? rubricMarkedGrid.retrieveCapabilityMark(groupUsage) : null %}

                {% set rowspan = groupUsage.indicatorUsages|length + (showGroupTotal and rubricGrid.isCapabilityMarkShown(groupUsage.capability) ? 1 : 0) %}

                {% for critIndex, critUsage in groupUsage.indicatorUsages %}
                    {% set indicatorId   = critUsage.indicator.id %}
                <tr
                    data-group="{{ rubricId }}-{{ groupUsage.capability.id }}"
                    data-capability-id="{{ groupUsage.capability.id }}"
                    data-indicator-id="{{ indicatorId }}"
                >
                    {# yay html tables... -_-; #}
                    {% if rowspan %}
                        <th class="rb-group-name markdown" rowspan="{{ rowspan }}"><span>{{ groupUsage.capability.name | markdown }}</span></th>
                        {% set rowspan = 0 %}
                    {% endif %}

                    <th class="rb-criterion-name markdown">{{ critUsage.indicator.name | markdown }}</th>

                    {% set indicatorMark = rubricMarkedGrid
                        ? rubricMarkedGrid.retrieveIndicatorMark(critUsage)
                        : null %}
                    {% set indicatorMarkDescriptor = indicatorMark
                        ? indicatorMark.descriptor
                        : null %}
                    {% set selfAssessmentIndicatorMark = selfAssessmentFeedback
                        ? selfAssessmentFeedback.rubricMarkedGrid.retrieveIndicatorMark(critUsage)
                        : null %}

                    {% for levelIndex, level in rubricGrid.levels %}

                        {% set descriptor = critUsage.retrieveDescriptor(levelIndex) %}

                        {% if descriptor %}

                            {% set inputId %}{{ formField }}[{{ indicatorId }}][{{ level.id }}]{% endset %}
                            {% set isDescriptorSelected = indicatorMarkDescriptor == descriptor %}
                            {% set isMarkDisplayed      = isDescriptorSelected and rubricGrid.assessment.isFeedbackVisibleToUser(USER) %}
                            {% set blindMode            = blindMode %}

                            <td>
                            {# This container displays rubric levels for the mobile view. #}
                                <div class="rubric-levels-mobile l-pad-m"><p><b>{{ level.name | markdown }}</b><p></div>
                                {% include '@rubric/descriptor-markable.twig' %}
                            </td>

                        {% else %}
                            <td class="rb-blank">&nbsp;</td>
                        {% endif %}

                    {% endfor %}
                </tr>
            {% endfor %}

            {% include '@rubric/group-row-markable.twig' %}

    {% endfor %}

    {% if showRubricTotal and markType.mode != "none"  %}

        {% set rubricScaledMark = rubricMarkedGrid.calculateScaledMark ?? null %}
        {% set rubricMax        = rubricGrid.calculateMaxValueFromCapabilities %}

        <tr>
            <th class="rb-final-summary" colspan="{{ rubricGrid.levels|length + 2 }}">
                <span data-final-summary="{{ rubricId }}"
                      data-scaled-mark="{{ rubricScaledMark }}"
                      data-max="{{ rubricMax }}"
                      data-mark-type="{{ markType.mode }}">

                    {{ rubricMarkedGrid.retrieveHumanReadableMark ?? null }}
                </span>

                {# Self-Assessment: only show the mark if it's self graded, as if it's self-reflect only they never marked themselves #}
                {% if selfAssessmentFeedback is not null and selfAssessmentFeedback.isSelfGrading %}
                    ({{ selfAssessmentFeedback.humanReadableMark }} given in {{ locale.selfAssessment.proper }})
                {% endif %}
            </th>
        </tr>
    {% endif %}

        </tbody>
    </table>
</div>
{# js specific to the rubric we just injected to...wherever we injected it #}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/jquery.dynagrade.js?v={{ config.site_version }}"></script>

{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        var $rb       = $('#{{ rubricId }}'),
            markType  = $rb.find("[data-mark-type]").attr("data-mark-type"),
            dynagrade = {{ markType | json_encode | raw }};

        $("[data-feedback-form]").validate(
            {
                errorPlacement: function (error, element) {
                    var $nextEl = element.next("[data-use-descriptor-values]");
                    error.insertAfter($nextEl);
                }
            }
        );


        // Add validation rules for per-capability marks
        $("[data-group-mark]").each(function() {

            // Can't validate letter grade dropdown as its values are preset on the frontend
            if (markType !== 'letter') {
                // Percentage and total mark types must be numeric
                $(this).rules('add', {
                    number: true
                });

                // If percentage mark type, range is between 0 and 100
                if (markType === 'percent') {
                    $(this).rules('add', {
                        range: [0, 100]
                    });
                } else if (markType === "raw" || markType === 'none') {
                    // Otherwise, range is between 0 and capability max
                    var capMax = $(this).closest("[data-group-summary]").attr("data-max");

                    $(this).rules('add', {
                        range: [0, parseFloat(capMax)]
                    });
                }
            }
        });

        function revalidateCapMarks() {
            $("[data-group-mark]").each(function() {
                $(this).valid();
            });
        }

        {#
        /**
         * Various types for future reference
         * @typedef {string} CapabilityId
         * @typedef {string} IndicatorId
         * @typedef {string} DescriptorId
         */

        /**
        * An object representing the state of a descriptor
        * @typedef {Object} DescriptorState
        * @property {number|null} value - the value of the descriptor
        * @property {boolean} checked - whether the descriptor is checked
        * @property {HTMLInputElement} el - the descriptor checkbox element
        */

        /**
        * An object with all information about a descriptor, useful when using descriptors as a list
        * @typedef {Object} DescriptorInfo
        * @property {DescriptorState} state - the state of the descriptor
        * @property {DescriptorId} descriptorId - the ID of the descriptor
        * @property {IndicatorId} indicatorId - the ID of the indicator the descriptor belongs to
        */
        #}

        /**
         * A way to track the current configuration of the entire rubric
         * This exists rather than using the DOM directly so that we have a far more manageable object to work with
         * Ideally, we'd just rewrite everything into Vue and things could be a lot simpler...
         * @var {Object.<CapabilityId, Object.<IndicatorId, Object.<DescriptorId, DescriptorState>>>}
         */
        let currentRubricConfiguration = {};

        /**
         * Initialise the currentRubricConfiguration object with the current state of the rubric
         */
        function initialiseCurrentRubricConfiguration() {
            currentRubricConfiguration = {};
            $rb[0].querySelectorAll("tr[data-indicator-id]").forEach(indicatorRow => {
                const capabilityId = indicatorRow.getAttribute("data-capability-id");
                if (!currentRubricConfiguration[capabilityId]) {
                    currentRubricConfiguration[capabilityId] = {};
                }

                const indicatorId = indicatorRow.getAttribute("data-indicator-id");
                if (!currentRubricConfiguration[capabilityId][indicatorId]) {
                    currentRubricConfiguration[capabilityId][indicatorId] = {};
                }

                indicatorRow.querySelectorAll("input[data-rubric-descriptor]").forEach(descriptorCheckbox => {
                    const descriptorId = descriptorCheckbox.getAttribute("data-rubric-descriptor");

                    let descriptorValue = parseFloat(descriptorCheckbox.getAttribute("data-value"));
                    if (isNaN(descriptorValue)) {
                        // parseFloat will return NaN if the attribute doesn't exist or is not a number
                        // in this case, the descriptor is valueless so we set null here.
                        descriptorValue = null;
                    }

                    currentRubricConfiguration[capabilityId][indicatorId][descriptorId] = {
                        value: descriptorValue,
                        checked: descriptorCheckbox.checked,
                        el: descriptorCheckbox,
                    };
                });
            });
        }

        initialiseCurrentRubricConfiguration();

        /**
         * Maps all descriptors in a capability to a flat array of descriptor infos for easier processing
         * @param {CapabilityId} capability
         * @returns {DescriptorInfo[]} - an array of descriptor infos for all descriptors in the capability
         */
        function findAllDescriptorsInCapability(capability) {
            const capabilityConfiguration = currentRubricConfiguration[capability];
            if (!capabilityConfiguration) {
                console.warn("No configuration found for capability", capability);
                return [];
            }

            return Object.entries(capabilityConfiguration)
                .flatMap(([indicatorId, descriptors]) => {
                    return Object.entries(descriptors)
                        .map(([descriptorId, descriptor]) => ({
                            state: descriptor,
                            descriptorId: descriptorId,
                            indicatorId: indicatorId, // Keep the indicator ID attached in case we need it later
                        }));
                });
        }

        /**
         * Finds all selected descriptors in a capability based on currentRubricConfiguration
         * @param {CapabilityId} capabilityId - the capability to find descriptors for
         * @returns {DescriptorInfo[]} - an array of descriptor infos for all selected descriptors in the capability
         */
        function findAllSelectedDescriptorsInCapability(capabilityId) {
            const allDescriptors = findAllDescriptorsInCapability(capabilityId);
            return allDescriptors.filter(descriptor => descriptor.state.checked);
        }

        /**
         * Finds the currently selected descriptor for an indicator
         * @param {CapabilityId} capabilityId - the capability to find the descriptor for
         * @param {IndicatorId} indicatorId - the indicator to find the descriptor for
         * @returns {DescriptorInfo|null} - the dselected descriptor information, or null if no selection
         */
        function findSelectedDescriptorInIndicator(capabilityId, indicatorId) {
            const capabilityConfiguration = currentRubricConfiguration[capabilityId];
            if (!capabilityConfiguration) {
                console.warn("No configuration found for capability", capabilityId);
                return null;
            }

            const indicatorConfiguration = capabilityConfiguration[indicatorId];
            if (!indicatorConfiguration) {
                console.warn("No configuration found for indicator", indicatorId);
                return null;
            }

            /** @type {DescriptorInfo[]} - All selected descriptors in the indicator, although there should only be one */
            const selectedDescriptor = Object.entries(indicatorConfiguration)
                .filter(([descriptorId, descriptor]) => descriptor.checked)
                .map(([descriptorId, descriptor]) => ({
                    state: descriptor,
                    descriptorId: descriptorId,
                    indicatorId: indicatorId,
                }));

            if (!selectedDescriptor) {
                return null;
            }

            if (selectedDescriptor.length > 1) {
                console.warn("Multiple descriptors selected for indicator", indicatorId);
            }

            return selectedDescriptor[0] || null;
        }

        // Disable Assign From Descriptors if value hasn't changed
        function disableEnableAssignFromDescs() {
            var $groups = $rb.find("[data-group-summary]");
            $groups.each(function() {
                var markIsDifferent = false;

                var $this         = $(this),
                    displayedMark = $this.find("[data-group-descriptor-sum]").text().replace(/%/, '').trim(),
                    customMark    = $this.find("[data-group-mark]").val();

                const hasSelectedDescriptor = findAllSelectedDescriptorsInCapability($this.attr('data-group-id')).length > 0;
                const hasSelectedOnlyValuelessDescriptors = findAllSelectedDescriptorsInCapability($this.attr('data-group-id'))
                    .filter(descriptor => descriptor.state.value !== null).length === 0;
                const capabilityHasValuedDescriptors = findAllDescriptorsInCapability($this.attr('data-group-id'))
                    .filter(descriptor => descriptor.state.value !== null).length > 0;


                if (markType === 'letter') {
                    // Compare letter grades by their string value (easier since we're dealing with brackets)

                    var grades = getLetterGrades($this);
                    customMark = getLetterGradeFromNumeric($this.find("[data-group-mark] :selected").attr('data-raw-grade'), grades);
                    if (displayedMark !== customMark) {
                        markIsDifferent = true;
                    }
                } else {
                    // Compare percentage and total marks by their numeric value

                    var diff = Math.abs(parseFloat(displayedMark) - parseFloat(customMark));
                    // Allow for precision errors when diffing
                    if (diff >= 0.01 || (isNaN(diff) && hasSelectedDescriptor && capabilityHasValuedDescriptors)) {
                        markIsDifferent = true;
                    }
                }

                // Determine if we should show the "Assign XXX from indicators" message
                // Start by assuming we should show it if the mark is different
                let showAssignFromButton = markIsDifferent;

                // If no descriptors are selected, and the customMark is not empty, show the button (as it must be customised)
                if (!hasSelectedDescriptor && customMark !== "") {
                    showAssignFromButton = true;
                }

                // Otherwise, if only valueless descriptors are selected, and the customMark is already empty, never show the button (as it'll say null)
                if (hasSelectedDescriptor && hasSelectedOnlyValuelessDescriptors && customMark === "") {
                    showAssignFromButton = false;
                }

                // If we have selected any descriptor, then show the "assign XXX from descriptors" text
                if (showAssignFromButton) {
                    // Check if the customMark is not "", as we don't want to show "assign null..."
                    if (hasSelectedDescriptor && !hasSelectedOnlyValuelessDescriptors && capabilityHasValuedDescriptors) {
                        $this.find("[data-descriptor-assign='has-selected-descriptor']").show();
                        $this.find("[data-descriptor-assign='no-selected-descriptor']").hide();
                    }
                    // Otherwise, show the "remove grade based on descriptors" text
                    else {
                        $this.find("[data-descriptor-assign='has-selected-descriptor']").hide();
                        $this.find("[data-descriptor-assign='no-selected-descriptor']").show();
                    }

                    $this.find("[data-use-descriptor-values]").show();
                    $this.attr('data-customised', true);
                }
                // Otherwise, hide the "assign XXX from indicators" text
                else {
                    $this.find("[data-use-descriptor-values]").hide();

                    const capabilityHasValuedDescriptors = findAllDescriptorsInCapability($this.attr('data-group-id'))
                        .filter(descriptor => descriptor.state.value !== null).length > 0;

                    // Only remove data-customised if at least one descriptor has a value AND data-scaled-mark is not empty
                    // We do this as when all descriptors are valueless, the only way a scaled mark can be set is manually
                    // But we don't want to show the descriptor values button in this case as it'd never have a useful value
                    if (capabilityHasValuedDescriptors && $this.attr('data-scaled-mark') !== '') {
                        $this.removeAttr('data-customised');
                    }

                    // Or, if the capability mark input is actually empty, then we should remove the data-customised attribute
                    if (customMark === "") {
                        $this.removeAttr('data-customised');
                    }
                }
            });
        }

        // initialise dynamic mark display
        $rb.dynagrade(dynagrade);

        /* Initially set scaled marks for everything
         */
        $('[data-group-summary]').each(function(index, element) {
            let groupIdentifier = $(element).attr('data-group-summary');
            let groupRows = $('[data-group="' + groupIdentifier + '"]');

            if (groupRows.length) {
                let descriptorCheckboxes = groupRows.find('input');
                let scaledGroupMark = scale($(element), summateDescriptors(descriptorCheckboxes));

                // Set the data-group-descriptor-sum so that the initial enableAssignFromDescs can run correctly

                // Update button text with mark calculated from descriptors
                switch (markType) {
                    case 'letter':
                        var grades = getLetterGrades($(element).find("[data-group-mark]"));
                        $(element).find("[data-group-descriptor-sum]").text(getLetterGradeFromNumeric(getPercentage($(element), scaledGroupMark), grades));
                        break;

                    case 'percent':
                        $(element).find("[data-group-descriptor-sum]").text(getPercentage($(element), scaledGroupMark) + "%");
                        break;

                    case 'raw':
                    case 'none':
                    default:
                        $(element).find("[data-group-descriptor-sum]").text(scaledGroupMark);
                        break;
                }

                // The raw mark value that should correlate to the initial human-readable value in the <input>
                // If this doesn't match scaledGroupMark (the descriptors), then treat it as customised
                let initialConfiguredMark = scale($(element), parseFloat($(element).attr('data-initial-configured-mark')));
                if (isNaN(initialConfiguredMark)) { initialConfiguredMark = null; }

                if (initialConfiguredMark !== scaledGroupMark) {
                    $(element).attr('data-customised', true);
                    $(element).attr('data-scaled-mark', initialConfiguredMark);
                } else {
                    $(element).attr('data-scaled-mark', scaledGroupMark);
                }
            }
        });

        disableEnableAssignFromDescs();

        // Update the per-capability and overall marks when descriptor selection is changed
        $rb.on('change change.preload', '[data-rubric], [data-rubric-group]', function (e) {
            var $changed        = $(this),
                rubricId        = $changed.attr('data-rubric'),
                groupId         = $changed.attr('data-rubric-group'),
                indicatorId     = $changed.attr('data-rubric-indicator'),
                descriptorId    = $changed.attr('data-rubric-descriptor'),
                rowSelector     = '[data-group="rb-' + rubricId + '-' + groupId + '"]',
                $groupRows      = $(rowSelector),
                rubricTotalMark = null;

            // Keep track of the previous state of the descriptors
            const previouslySelectedGroupDescriptors = findAllSelectedDescriptorsInCapability(groupId);
            const previouslySelectedIndicatorDescriptor = findSelectedDescriptorInIndicator(groupId, indicatorId);

            // Make the change to the rubric configuration (check the current descriptor and uncheck the previous one)
            if (previouslySelectedIndicatorDescriptor) {
                currentRubricConfiguration[groupId][indicatorId][previouslySelectedIndicatorDescriptor.descriptorId].checked = false;
            }

            // As $changed can refer to either a checkbox or a select element (e.g. if ranged marks are being used for the descriptor)
            // We must find the value of the descriptor by finding the checkbox element to ensure we can read :checked
            const descriptorCheckbox = $rb[0].querySelector(`input[data-rubric-indicator="${indicatorId}"][data-rubric-descriptor="${descriptorId}"]`);
            currentRubricConfiguration[groupId][indicatorId][descriptorId].checked = descriptorCheckbox.checked;

            // Find the new state of the descriptors so we can compare
            const currentlySelectedGroupDescriptors = findAllSelectedDescriptorsInCapability(groupId);
            const currentlySelectedIndicatorDescriptor = findSelectedDescriptorInIndicator(groupId, indicatorId);

            if ($groupRows.length) {
                var groupSummarySelector  = '[data-group-summary="rb-' + rubricId + '-' + groupId + '"]',
                    $groupSummary         = $rb.find(groupSummarySelector),
                    $descriptorCheckboxes = $groupRows.find('input'),
                    scaledGroupMark       = scale($groupSummary, summateDescriptors($descriptorCheckboxes));

                // We can only update the scaled mark based on descriptors if the capability has valued descriptors
                // Otherwise, we'll always remove the data-scaled-mark attribute as valueless descriptors require manual input to set a mark
                const capabilityHasValuedDescriptors = findAllDescriptorsInCapability(groupId)
                    .filter(descriptor => descriptor.state.value !== null).length > 0;

                if (capabilityHasValuedDescriptors) {
                    $groupSummary.attr('data-scaled-mark', scaledGroupMark, summateDescriptors($descriptorCheckboxes));
                }

                // Update button text with mark calculated from descriptors
                switch (markType) {
                    case 'letter':
                        var grades = getLetterGrades($groupSummary.find("[data-group-mark]"));
                        $groupSummary.find("[data-group-descriptor-sum]").text(getLetterGradeFromNumeric(getPercentage($groupSummary, scaledGroupMark), grades));
                        break;

                    case 'percent':
                        $groupSummary.find("[data-group-descriptor-sum]").text(getPercentage($groupSummary, scaledGroupMark) + "%");
                        break;

                    case 'raw':
                    case 'none':
                    default:
                        $groupSummary.find("[data-group-descriptor-sum]").text(scaledGroupMark);
                        break;
                }

                if ($groupSummary.length) {

                    // Figure out if the capability mark should be classified as "customised". It's customised if:
                    // - The groupSummary has a data-customised attribute (we add this based on some other conditions)
                    // - OR all previously selected descriptors in this capability were valueless (the only way to get a mark is to manually set it in this case)
                    const capabilityMarkIsCustomised =
                        $groupSummary.attr('data-customised')
                        || previouslySelectedGroupDescriptors.filter(descriptor => descriptor.state.value !== null).length === 0

                    // Figure out if we should update the capability mark, based on the logic in SA-17198
                    let shouldUpdateCapabilityMark = true;

                    // If there are no descriptors selected in the capability,
                    //   then the capability mark should be cleared.
                    if (currentlySelectedGroupDescriptors.length === 0) {
                        $groupSummary.attr('data-scaled-mark', null);
                        shouldUpdateCapabilityMark = true;
                    }

                    // Or, if the capability mark is NOT customised or if the mark is currently empty,
                    else if (!capabilityMarkIsCustomised || $groupSummary.find("[data-group-mark]").val() === '') {
                        // If I have deselected any descriptor for this indicator,
                        //   then we should update the capability mark (it would've been cleared by the first condition if all descriptors were deselected)
                        if (!currentlySelectedIndicatorDescriptor) {
                            shouldUpdateCapabilityMark = true;
                        }

                        // Or, if I select a different valueless descriptor in the same capability, and no other selected descriptor in this capability has a value,
                        //   then the capability mark should adjust to the relevant value, which is nothing, so it should be cleared.
                        else if (
                            currentlySelectedIndicatorDescriptor.state.value === null
                            && currentlySelectedGroupDescriptors.filter(descriptor => descriptor.state.value !== null).length === 0
                        ) {
                            $groupSummary.attr('data-scaled-mark', null);
                            shouldUpdateCapabilityMark = true;
                        }

                        // Otherwise if I select a different valued descriptor in the same capability,
                        //   then the capability mark should adjust to the relevant value of that descriptor.
                        else {
                            shouldUpdateCapabilityMark = true;
                        }
                    }

                    // Otherwise, if the capability mark is customised
                    else {
                        // Then we never want to override it, we'll show an "Assign XXX from indicators" button instead
                        // I've left the equivalent logic for each case below, just in case we change this.
                        shouldUpdateCapabilityMark = false;

                        //// If no descriptor was previously selected
                        //if (previouslySelectedGroupDescriptors.length === 0) {
                        //    // ...and no descriptor is currently selected,
                        //    //   then the capability mark should NOT change,
                        //    if (currentlySelectedGroupDescriptors.length === 0) {
                        //        // There shouldn't be a way to get here, but i've added the check to ensure the
                        //        // next condition won't throw an error if in the odd case we do get here.
                        //        console.warn("No descriptors previously or currently selected after a change?");
                        //        shouldUpdateCapabilityMark = false;
                        //    }

                        //    // ...and I select a valued descriptor,
                        //    //   then the capability mark should be overridden
                        //    else if (currentlySelectedIndicatorDescriptor.state.value !== null) {
                        //        shouldUpdateCapabilityMark = false;
                        //    }

                        //    // ...and I select a valueless descriptor,
                        //    //   then the capability mark should NOT change
                        //    else {
                        //        shouldUpdateCapabilityMark = false;
                        //    }
                        //}

                        //// Otherwise, if a descriptor was previously selected
                        ////   then the capability mark should NOT change, as it is customised
                        //else {
                        //    shouldUpdateCapabilityMark = false;
                        //}
                    }

                    // If we've decided to update the capability mark, then do so
                    if (shouldUpdateCapabilityMark) {
                        switch (markType) {
                            case 'letter':
                                assignLetterGrade(getPercentage($groupSummary, $groupSummary.attr('data-scaled-mark')), $groupSummary.find("[data-group-mark]").val(scaledGroupMark));
                                break;

                            case 'percent':
                                $groupSummary.find("[data-group-mark]").val(getPercentage($groupSummary, $groupSummary.attr('data-scaled-mark')));
                                break;

                            case 'raw':
                            case 'none':
                            default:
                                $groupSummary.find("[data-group-mark]").val(scaledGroupMark);
                                break;
                        }

                    }
                }

                rubricTotalMark = getTotalMark();
            }
            var rubricSummarySelector = '[data-final-summary="rb-' + rubricId + '"]';
            var rubricSummary = $rb.find(rubricSummarySelector);
            rubricSummary.attr('data-scaled-mark', rubricTotalMark);

            // Only update the overall mark if we haven't customised the cap mark
            if (! $groupSummary.attr('data-customised')) {
                parseFraction(rubricSummary, e.namespace);
            }

            // What cell was actually changed?
            if ($changed.is(':checkbox')) {
                showHideRangeInput($changed);
            } else {
                showHideRangeInput($changed.siblings(':checkbox'));
            }

            disableEnableAssignFromDescs();
        });


        // Update the overall rubric mark when the user changes the custom capabilty mark
        $rb.on('change change.preload', '[data-group-mark]', function (e) {
            var $changed = $(this);
            var rubricId = $changed.closest('[data-group-summary]').attr('data-rubric-id');
            var groupId = $changed.closest('[data-group-summary]').attr('data-group-id');

            var rowSelector = '[data-group="rb-' + rubricId + '-' + groupId + '"]';
            var $groupRows = $(rowSelector);
            var groupSummarySelector = '[data-group-summary="rb-' + rubricId + '-' + groupId + '"]';
            var $groupSummary = $rb.find(groupSummarySelector);

            // The custom mark is on the raw-grade data attribute now
            var customMark = markType === 'letter'
                ? $changed.find(':selected').attr('data-raw-grade')
                : $changed.val();

            if ($groupSummary.length) {
                var normalisedMark = getNormalisedCustomMark($groupRows, customMark, $groupSummary.attr('data-row-max-sum'), $groupSummary.attr('data-max'));
                $groupSummary.attr('data-scaled-mark', normalisedMark);
                $groupSummary.attr('data-customised', true);
            }

            var rubricTotalMark = getTotalMark();

            var rubricSummarySelector = '[data-final-summary="rb-' + rubricId + '"]';
            var rubricSummary = $rb.find(rubricSummarySelector);

            rubricSummary.attr('data-scaled-mark', rubricTotalMark);

            parseFraction(rubricSummary, e.namespace);
            disableEnableAssignFromDescs();
        });

        // Custom marks reach us as either a scaled numeric mark or a percentage. Turn them into an unscaled raw mark for data-mark
        function getNormalisedCustomMark($groupRows, customMark, rowMaxSum, capMax) {
            // The custom mark may be empty. This is null, not zero
            if (customMark === '') {
                return null;
            }

            var normalised = 0;

            if ($groupRows.length) {
                // var rowCount = $groupRows.length;
                switch (markType) {
                    case 'letter':
                    case 'percent':
                        // What is x percent of the total possible (unscaled) marks?
                        normalised = customMark * (capMax / 100);
                        break;

                    case 'raw':
                    case 'none':
                    default:
                        normalised = customMark;
                        break;
                }
            }

            return normalised;
        }

        // Overwrite any custom mark in the capability mark field with the scaled mark calculated from descriptor values
        $("[data-use-descriptor-values]").click(function(e) {
            var $button               = $(this),
                $gradeInput           = $button.siblings('[data-group-mark]'),
                rubricId              = $button.closest('[data-group-summary]').attr('data-rubric-id'),
                groupId               = $button.closest('[data-group-summary]').attr('data-group-id'),
                rowSelector           = '[data-group="rb-' + rubricId + '-' + groupId + '"]',
                $groupRows            = $(rowSelector),
                groupSummarySelector  = '[data-group-summary="rb-' + rubricId + '-' + groupId + '"]',
                $groupSummary         = $rb.find(groupSummarySelector),
                $descriptorCheckboxes = $groupRows.find('input'),
                scaledGroupMark       = scale($groupSummary, summateDescriptors($descriptorCheckboxes));

            $groupSummary.attr('data-scaled-mark', scaledGroupMark);

            switch (markType) {
                case 'letter':
                    assignLetterGrade(getPercentage($groupSummary, scaledGroupMark), $gradeInput.val(scaledGroupMark));
                    break;

                case 'percent':
                    $gradeInput.val(getPercentage($groupSummary, scaledGroupMark));
                    break;

                case 'raw':
                case 'none':
                default:
                    $gradeInput.val(scaledGroupMark);
                    break;
            }

            // The grade input has changed: trigger save draft
            $gradeInput.trigger('change');

            // Up for discussion, but I'd imagine the user would like the marks to update automatically
            // with descriptor changes once they've clicked this button
            $groupSummary.removeAttr('data-customised');

            var rubricTotalMark       = getTotalMark(),
                rubricSummarySelector = '[data-final-summary="rb-' + rubricId + '"]',
                rubricSummary         = $rb.find(rubricSummarySelector);

            rubricSummary.attr('data-scaled-mark', rubricTotalMark);

            parseFraction(rubricSummary, e.namespace);
            disableEnableAssignFromDescs();
            revalidateCapMarks();
        });


        // Get an array of letter grade {value : letter} pairs
        function getLetterGrades($dropdown) {
            var grades = [];
            $dropdown.find("option[data-letter]").each(function(index, option) {
                let $option = $(option);
                grades.push({
                    value:      $option.prop("value"),
                    lowerBound: $option.attr('data-lower-bound'),
                    letter:     $option.attr('data-letter'),
                });
            });

            return grades;
        }


        // Given a percentage mark, set a capability dropdown to its corresponding letter grade
        function assignLetterGrade(numericMark, $dropdown) {
            // Numeric mark is null? select the first option (empty grade)
            var optionIndex = 0;
            if (numericMark !== null) {
                var grades     = getLetterGrades($dropdown),
                    numberMark = Number(numericMark);
                for (var i = 0; i < grades.length; i++) {
                    // TODO assumes values are always descending which might not be the case?
                    if (numberMark >= Number(grades[i].lowerBound)) {
                        // Offset the selected option by +1, to take into account empty grade
                        optionIndex = i + 1;
                        break;
                    }
                }
            }

            $dropdown.find('option').prop('selected', function(i) {
                return i === optionIndex;
            });
        }

        // Given a percentage mark, find the letter grade that corresponds to its bracket in the marking scheme
        // TODO this function seems to not be calculating brackets the same way twig is; who is wrong?
        function getLetterGradeFromNumeric(numericMark, grades) {
            if (numericMark === null || numericMark === undefined || numericMark === '') {
                return '(no grade)';
            }
            var gradesLength = grades.length,
                numberMark   = Number(numericMark);
            for (var i = 0; i < gradesLength; i++) {
                // TODO assumes values are always descending which might not be the case?
                if (numberMark >= Number(grades[i].lowerBound)) {
                    return grades[i].letter;
                }
            }

            // Did I fall through to here? Use the last grade
            return gradesLength > 0 ? grades[gradesLength-1].letter : '';
        }

        // Turn a specified value into a percentage of the max marks for a group
        function getPercentage($groupSummary, value) {
            var floatValue = parseFloat(value).toFixed(2),
                percentage;
            if (!isNaN(floatValue)) {
                percentage = $groupSummary.attr('data-max') > 0 ? floatValue * (100 / $groupSummary.attr('data-max')) : 0;
            } else {
                return null;
            }

            // Known bug: due to javascript rounding errors, with some values the percentage will wrongly be identified as not divisible by 1
            if (percentage % 1 !== 0) {
                percentage = percentage.toFixed(2);
            }
            return percentage;
        }


        // Hide or display the descriptor range input depending on whether it's needed or not
        function showHideRangeInput($changedCell) {
            var $allCellsInRow = $changedCell.parents("tr").find("[data-rubric], [data-rubric-group]");

            // Hide dropdowns on all cells in the same row
            $allCellsInRow.siblings("select").addClass("hide");

            // Disable all dropdowns so they don't get POSTed
            $allCellsInRow.siblings("select").prop("disabled", true);

            // Show text labels on all cells in the same row
            $allCellsInRow.siblings("label").find(".rb-value").removeClass("hide");

            if ($changedCell.prop('checked')) {
                // Hide the text label on the selected cell
                $changedCell.siblings("label").find(".rb-value").addClass("hide");

                // This will only un-hide an element if that element is the one we need to use on that cell:
                // - Dropdowns are only used on cells with a range
                // - Cells with a single value just get a text label

                $changedCell.siblings("select.used").removeClass("hide");
                $changedCell.siblings("select.used").prop("disabled", false); // Re-enable so we can use it and it gets POSTed
                $changedCell.siblings("label").find(".rb-value.used").removeClass("hide");
            }
        }

        // Scale an unscaled mark based on a group's max mark
        function scale($groupSummary, value) {
            if (value === null) {
                return null;
            }

            var groupMax = $groupSummary.attr('data-max'),
                groupRowMaxSum = $groupSummary.attr('data-row-max-sum'),
                scaledGroupSum;

            if (groupRowMaxSum > 0) {
                scaledGroupSum = value * (groupMax / groupRowMaxSum);
            } else {
                scaledGroupSum = value;
            }

            if (scaledGroupSum % 1 !== 0) {
                scaledGroupSum = scaledGroupSum.toFixed(2);
            }

            return parseFloat(scaledGroupSum); // Ensure we get a float back
        }

        /**
         * Get the value of a specified descriptor
         * @param {jQuery} $descriptorCheckbox - the descriptor checkbox to get the value of
         * @returns {number|null} - the value of the descriptor, or null if it has no value
         */
        function getDescriptorValue($descriptorCheckbox) {
            const descriptorId = $descriptorCheckbox.attr('data-rubric-descriptor');
            const $select = $rb.find('#rangeDropdown-'+String(descriptorId));
            let descriptorValue;

            if ($select.length) {
                descriptorValue = parseFloat($select.val());
            } else {
                descriptorValue = parseFloat($descriptorCheckbox.attr('data-value'));
            }

            if (isNaN(descriptorValue)) {
                return null;
            }

            return descriptorValue;
        }

        // Get the raw unscaled sum of selected descriptor values from the collection of descriptors passed in
        function summateDescriptors($descriptorCheckboxes) {
            var descriptorSummation = null;

            $descriptorCheckboxes.each(function () {
                var $descriptorCheckbox = $(this);

                if ($descriptorCheckbox.prop('checked')) {
                    const descriptorValue = getDescriptorValue($descriptorCheckbox);

                    if (descriptorValue !== null) {
                        descriptorSummation = (descriptorSummation || 0) + descriptorValue;
                    }
                }
            });

            return descriptorSummation;
        }

        // Calculate the overall rubric mark from the scaled group marks
        function getTotalMark()
        {
            var totalMark = null;
            var rubricOverallMax = 0;

            var $groupSummary = $rb.find('[data-group-summary]');

            if ($groupSummary.length) {
                $groupSummary.each(function() {
                    var groupScaledMark = $(this).attr('data-scaled-mark');

                    if (!isNaN(groupScaledMark)) {
                        totalMark = (totalMark || 0) + parseFloat(groupScaledMark);
                    }

                    rubricOverallMax += parseFloat($(this).attr('data-max'));
                });
            } else {
                var $descriptorCheckboxes = $("[data-rubric-descriptor]");
                totalMark = summateDescriptors($descriptorCheckboxes);
            }

            // If sum isn't a whole number: round to 2dp
            if (totalMark !== null && totalMark % 1 !== 0){
                totalMark = totalMark.toFixed(2);
            }


            return totalMark;
        }

        // If not multi-select, simulate radio behaviour per row (simpler to do this than intercept radio checked event!)
        {# TODO I have no idea what multiSelect is, and AFAICT it's always false #}
        {#{% if not rubric.multiSelect %}#}
        // Can't delegate this, as auto-mark will run before it can un-check siblings
        $('[data-rubric-descriptor]').on('change', function(event){

            var $descriptorInput = $(this);
            var $checkboxGroup   = $descriptorInput.closest('[data-group]');
            var $descriptors     = $checkboxGroup.find('[data-rubric-descriptor]');

            $descriptors.each(function(idx, elem){
                var $otherDescriptor = $(elem);
                if($otherDescriptor.attr('data-rubric-descriptor') != $descriptorInput.attr('data-rubric-descriptor')){
                    $otherDescriptor.prop('checked', false);
                }
            });
        });
        {#{% endif %}#}

        /**
         *
         * @param {jQuery} $elem
         * @param {string|null} namespace
         */
        function parseFraction($elem, namespace)
        {
            var ev = 'dynagrade';
            if (namespace) {
                ev = ev + '.' + namespace;
            }

            $elem.trigger(ev);
        }

    });
</script>
{% endautoescape %}
