{##
 # This template must support both an empty and a marked grid.
 #
 # Parameters:
 # * rubricGrid:              the base rubric grid object
 # * rubricMarkedGrid:        the marked rubric grid, shouldst there be one
 # * selfAssessmentFeedback:  the self-assessed feedback, shouldst there be one
 # * markVisibility:          ? Should be inferred from grid's assessment (assessment.isVisibleTo(USER))
 # * useMarkRange:            ? Should be inferred from grid's assessment (assessment.markRange)
 # * showGroupTotal:          ? Should be inferred from grid's assessment (assessment.markPerCapability)
 #                              Also depends if this is a self-reflection
 #}


{% import '@learningMarkScheme/macro/limitDecimal.twig' as limit_decimal %}

{% set formField = 'rubric' %}
{% set rubricId = 'rb-' ~ rubricGrid.assessment.id %}
{% set markType = rubricGrid.assessment.markScheme.generateContext %}
{% set showDescriptorValue = showDescriptorValue ? true : false %}
{% set showGroupTotal = showGroupTotal ? true : false %}
{% set showRubricTotal = showRubricTotal ? true : false %}

{% set hidePoints = not config.rubric_show_points or (studentView and selfReflect) %}

<div class="scrollable">
    <table class="rb markable stack-for-medium-down" id="{{ rubricId }}">

        {# Suppress level headings if none have names #}
        {% set hasLevels = false %}
        {% for level in rubricGrid.levels if level.name | trim | length %}
            {% set hasLevels = true %}
        {% endfor %}
        {% if hasLevels  %}
        <thead>
            <tr>
                <th colspan="2">&nbsp;</th>
                {% for level in rubricGrid.levels %}
                <th>{{ level.name }}</th>
                {% endfor %}
            </tr>
        </thead>
        {% endif %}
        <tbody>
            {% for groupIndex, groupUsage in rubricGrid.capabilityUsages %}
                {# Use rowspans when group total is visible, otherwise don't need it
                 # This is only off when self-reflecting with a grid that doesn't show descriptor points
                 # and groups - here, it never shows the group subtotal, and rowspan calcs are off
                 #}
                {% set capabilityMark = rubricMarkedGrid ? rubricMarkedGrid.retrieveCapabilityMark(groupUsage) : null %}

                {% set rowspan = groupUsage.indicatorUsages|length + (showGroupTotal and rubricGrid.isCapabilityMarkShown(groupUsage.capability) ? 1 : 0) %}

                {% for critIndex, critUsage in groupUsage.indicatorUsages %}
                <tr data-group="{{ rubricId }}-{{ groupUsage.capability.id }}">
                    {# yay html tables... -_-; #}
                    {% if rowspan %}
                        <th class="rb-group-name" rowspan="{{ rowspan }}"><span>{{ groupUsage.capability.name | nl2br }}</span></th>
                        {% set rowspan = 0 %}
                    {% endif %}

                    <th class="rb-criterion-name">{{ critUsage.indicator.name | nl2br }}</th>

                    {% set indicatorId   = critUsage.indicator.id %}
                    {% set indicatorMark = rubricMarkedGrid
                        ? rubricMarkedGrid.retrieveIndicatorMark(critUsage)
                        : null %}
                    {% set indicatorMarkDescriptor = indicatorMark
                        ? indicatorMark.descriptor
                        : null %}
                    {% set selfAssessmentIndicatorMark = selfAssessmentFeedback
                        ? selfAssessmentFeedback.rubricMarkedGrid.retrieveIndicatorMark(critUsage)
                        : null %}

                    {% for levelIndex, level in rubricGrid.levels %}

                        {% set descriptor = critUsage.retrieveDescriptor(levelIndex) %}

                        {% if descriptor %}

                            {% set inputId %}{{ formField }}[{{ indicatorId }}][{{ level.id }}]{% endset %}
                            {% set isDescriptorSelected = indicatorMarkDescriptor == descriptor %}
                            {% set isMarkDisplayed      = isDescriptorSelected and rubricGrid.assessment.isFeedbackVisibleToUser(USER) %}

                            <td>
                                {% include '@rubric/descriptor-markable.twig' %}
                            </td>

                        {% else %}
                            <td class="rb-blank">&nbsp;</td>
                        {% endif %}

                    {% endfor %}
                </tr>
            {% endfor %}

            {% include '@rubric/group-row-markable.twig' %}

    {% endfor %}

    {% if showRubricTotal and markType.mode != "none"  %}

        {% set rubricScaledMark = rubricMarkedGrid.calculateScaledMark %}
        {% set rubricMax        = rubricGrid.calculateMaxValueFromCapabilities %}

        <tr>
            <th class="rb-final-summary" colspan="{{ rubricGrid.levels|length + 2 }}">
                <span data-final-summary="{{ rubricId }}"
                      data-scaled-mark="{{ rubricScaledMark }}"
                      data-max="{{ rubricMax }}"
                      data-mark-type="{{ markType.mode }}">

                    {{ rubricMarkedGrid.retrieveHumanReadableMark }}
                </span>

                {# Self-Assessment: only show the mark if it's self graded, as if it's self-reflect only they never marked themselves #}
                {% if selfAssessmentFeedback is not null and selfAssessmentFeedback.isSelfGrading %}
                    ({{ selfAssessmentFeedback.humanReadableMark }} given in {{ locale.selfAssessment.proper }})
                {% endif %}
            </th>
        </tr>
    {% endif %}

        </tbody>
    </table>
</div>
{# js specific to the rubric we just injected to...wherever we injected it #}
<script type="text/javascript" src="/javascript/shared/submissions/jquery.dynagrade.js"></script>

{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        var $rb       = $('#{{ rubricId }}'),
            markType  = $rb.find("[data-mark-type]").attr("data-mark-type"),
            dynagrade = {{ markType | json_encode | raw }};

        $("[data-feedback-form]").validate(
            {
                errorPlacement: function (error, element) {
                    var $nextEl = element.next("[data-use-descriptor-values]");
                    error.insertAfter($nextEl);
                }
            }
        );


        // Add validation rules for per-capability marks
        $("[data-group-mark]").each(function() {

            // Can't validate letter grade dropdown as its values are preset on the frontend
            if (markType !== 'letter') {
                // Percentage and total mark types must be numeric
                $(this).rules('add', {
                    number: true
                });

                // If percentage mark type, range is between 0 and 100
                if (markType === 'percent') {
                    $(this).rules('add', {
                        range: [0, 100]
                    });
                } else if (markType === "raw" || markType === 'none') {
                    // Otherwise, range is between 0 and capability max
                    var capMax = $(this).closest("[data-group-summary]").attr("data-max");

                    $(this).rules('add', {
                        range: [0, parseFloat(capMax)]
                    });
                }

            }
        });

        function revalidateCapMarks() {
            $("[data-group-mark]").each(function() {
                $(this).valid();
            });
        }


        // Disable Assign From Descriptors if value hasn't changed
        function disableEnableAssignFromDescs() {
            var $groups = $rb.find("[data-group-summary]");
            $groups.each(function() {
                var markIsDifferent = false;

                var $this         = $(this),
                    displayedMark = $this.find("[data-group-descriptor-sum]").text().replace(/%/, '').trim(),
                    customMark    = $this.find("[data-group-mark]").val();

                if (markType === 'letter') {
                    // Compare letter grades by their string value (easier since we're dealing with brackets)

                    var grades = getLetterGrades($this);
                    customMark = getLetterGradeFromNumeric($this.find("[data-group-mark]").val(), grades);
                    if (displayedMark !== customMark) {
                        markIsDifferent = true;
                    }
                } else {
                    // Compare percentage and total marks by their numeric value

                    var diff = Math.abs(parseFloat(displayedMark) - parseFloat(customMark));
                    // Allow for precision errors when diffing
                    if (diff >= 0.01) {
                        markIsDifferent = true;
                    }
                }

                // $this.attr('data-mark') is '', if capability mark is not provided yet ('0' if provided)
                if (($this.attr('data-mark') !== '') && markIsDifferent) {
                    $this.find("[data-use-descriptor-values]").show();
                    $this.attr('data-customised', true);
                } else {
                    $this.find("[data-use-descriptor-values]").hide();
                    $this.removeAttr('data-customised');
                }
            });
        }

        disableEnableAssignFromDescs();

        // initialise dynamic mark display
        $rb.dynagrade(dynagrade);

        // Update the per-capability and overall marks when descriptor selection is changed
        $rb.on('change change.preload', '[data-rubric], [data-rubric-group]', function (e) {
            var $changed        = $(this),
                groupId         = $changed.attr('data-rubric-group'),
                rubricId        = $changed.attr('data-rubric'),
                rowSelector     = '[data-group="rb-' + rubricId + '-' + groupId + '"]',
                $groupRows      = $(rowSelector),
                rubricTotalMark = 0;

            if ($groupRows.length) {
                var groupSummarySelector = '[data-group-summary="rb-' + rubricId + '-' + groupId + '"]';
                var $groupSummary = $rb.find(groupSummarySelector);
                var $descriptorCheckboxes = $groupRows.find('input');

                var scaledGroupMark = 0;
                var indicatorMark = summateDescriptors($descriptorCheckboxes);
                if (indicatorMark > 0) {
                    scaledGroupMark = scale($groupSummary, indicatorMark);
                }
                $groupSummary.attr('data-scaled-mark', scaledGroupMark);
                $groupSummary.attr('data-mark', scaledGroupMark);

                // Update button text with mark calculated from descriptors
                switch (markType) {
                    case 'letter':
                        var grades = getLetterGrades($groupSummary.find("[data-group-mark]"));
                        $groupSummary.find("[data-group-descriptor-sum]").text(getLetterGradeFromNumeric(getPercentage($groupSummary, $groupSummary.attr('data-mark')), grades));
                        break;

                    case 'percent':
                        $groupSummary.find("[data-group-descriptor-sum]").text(getPercentage($groupSummary, $groupSummary.attr('data-mark')) + "%");
                        break;

                    case 'raw':
                    case 'none':
                    default:
                        $groupSummary.find("[data-group-descriptor-sum]").text(scaledGroupMark);
                        break;
                }

                if ($groupSummary.length) {
                    if (! $groupSummary.attr('data-customised')) {
                        // Only update dropdown/input field if the mark has not been customised
                        $groupSummary.find('[data-db-mark]').val(scaledGroupMark);
                        switch (markType) {
                            case 'letter':
                                assignLetterGrade(getPercentage($groupSummary, $groupSummary.attr('data-mark')), $groupSummary.find("[data-group-mark]").val(scaledGroupMark));
                                break;

                            case 'percent':
                                $groupSummary.find("[data-group-mark]").val(getPercentage($groupSummary, $groupSummary.attr('data-mark')));
                                break;

                            case 'raw':
                            case 'none':
                            default:
                                $groupSummary.find("[data-group-mark]").val(scaledGroupMark);
                                break;
                        }

                    }
                }

                rubricTotalMark = getTotalMark();
            }
            var rubricSummarySelector = '[data-final-summary="rb-' + rubricId + '"]';
            var rubricSummary = $rb.find(rubricSummarySelector);
            rubricSummary.attr('data-scaled-mark', rubricTotalMark);

            // Only update the overall mark if we haven't customised the cap mark
            if (! $groupSummary.attr('data-customised')) {
                parseFraction(rubricSummary, e.namespace);
            }

            // What cell was actually changed?
            if ($changed.is(':checkbox')) {
                showHideRangeInput($changed);
            } else {
                showHideRangeInput($changed.siblings(':checkbox'));
            }

            disableEnableAssignFromDescs();
        });


        // Update the overall rubric mark when the user changes the custom capabilty mark
        $rb.on('change change.preload', '[data-group-mark]', function (e) {
            var $changed = $(this);
            var rubricId = $changed.closest('[data-group-summary]').attr('data-rubric-id');
            var groupId = $changed.closest('[data-group-summary]').attr('data-group-id');

            var rowSelector = '[data-group="rb-' + rubricId + '-' + groupId + '"]';
            var $groupRows = $(rowSelector);
            var groupSummarySelector = '[data-group-summary="rb-' + rubricId + '-' + groupId + '"]';
            var $groupSummary = $rb.find(groupSummarySelector);

            var customMark = $changed.val();

            if ($groupSummary.length) {
                var normalisedMark = getNormalisedCustomMark($groupRows, customMark, $groupSummary.attr('data-row-max-sum'), $groupSummary.attr('data-max'));
                $groupSummary.attr('data-scaled-mark', normalisedMark);
                $groupSummary.attr('data-mark', normalisedMark);
                $groupSummary.find('[data-db-mark]').val(normalisedMark);
                $groupSummary.attr('data-customised', true);
            }

            var rubricTotalMark = getTotalMark();

            var rubricSummarySelector = '[data-final-summary="rb-' + rubricId + '"]';
            var rubricSummary = $rb.find(rubricSummarySelector);

            rubricSummary.attr('data-scaled-mark', rubricTotalMark);

            parseFraction(rubricSummary, e.namespace);
            disableEnableAssignFromDescs();
        });

        // Custom marks reach us as either a scaled numeric mark or a percentage. Turn them into an unscaled raw mark for data-mark
        function getNormalisedCustomMark($groupRows, customMark, rowMaxSum, capMax) {
            // The custom mark may be empty. This is null, not zero
            if (customMark === '') {
                return null;
            }

            var normalised = 0;

            if ($groupRows.length) {
                // var rowCount = $groupRows.length;
                switch (markType) {
                    case 'letter':
                    case 'percent':
                        // What is x percent of the total possible (unscaled) marks?
                        normalised = customMark * (capMax / 100);
                        break;

                    case 'raw':
                    case 'none':
                    default:
                        normalised = customMark;
                        break;
                }
            }

            return normalised;
        }

        // Overwrite any custom mark in the capability mark field with the scaled mark calculated from descriptor values
        $("[data-use-descriptor-values]").click(function(e) {
            var $button = $(this);
            var $gradeInput = $button.siblings('[data-group-mark]');
            var rubricId = $button.closest('[data-group-summary]').attr('data-rubric-id');
            var groupId = $button.closest('[data-group-summary]').attr('data-group-id');

            var rowSelector = '[data-group="rb-' + rubricId + '-' + groupId + '"]';
            var $groupRows = $(rowSelector);
            var groupSummarySelector = '[data-group-summary="rb-' + rubricId + '-' + groupId + '"]';
            var $groupSummary = $rb.find(groupSummarySelector);

            var $descriptorCheckboxes = $groupRows.find('input');
            var scaledGroupMark = scale($groupSummary, summateDescriptors($descriptorCheckboxes));

            $groupSummary.attr('data-scaled-mark', scaledGroupMark);
            $groupSummary.attr('data-mark', scaledGroupMark);
            $groupSummary.find('[data-db-mark]').val(scaledGroupMark);

            switch(markType) {
                case 'letter':
                    assignLetterGrade(getPercentage($groupSummary, $groupSummary.attr('data-mark')), $gradeInput.val(scaledGroupMark));
                    break;

                case 'percent':
                    $gradeInput.val(getPercentage($groupSummary, $groupSummary.attr('data-mark')));
                    break;

                case 'raw':
                case 'none':
                default:
                    $gradeInput.val(scaledGroupMark);
                    break;
            }

            // The grade input has changed: trigger save draft
            $gradeInput.trigger('change');

            // Up for discussion, but I'd imagine the user would like the marks to update automatically
            // with descriptor changes once they've clicked this button
            $groupSummary.removeAttr('data-customised');

            var rubricTotalMark = getTotalMark();

            var rubricSummarySelector = '[data-final-summary="rb-' + rubricId + '"]';
            var rubricSummary = $rb.find(rubricSummarySelector);

            rubricSummary.attr('data-scaled-mark', rubricTotalMark);

            parseFraction(rubricSummary, e.namespace);
            disableEnableAssignFromDescs();
            revalidateCapMarks();
        });


        // Get an array of letter grade {value : letter} pairs
        function getLetterGrades($dropdown) {
            var grades = [];
            $dropdown.find("option").each(function(index, option) {
                grades.push(
                    {'value' : $(option).prop("value"), 'letter' : $(option).attr('data-letter')}
                );
            });

            return grades;
        }


        // Given a percentage mark, set a capability dropdown to its corresponding letter grade
        function assignLetterGrade(numericMark, $dropdown) {
            var grades = getLetterGrades($dropdown);

            // Default option index if no other selected: the last one
            var optionIndex = grades.length - 1,
                numberMark  = Number(numericMark);
            for (var i = 0; i < grades.length; i++) {
                // TODO assumes values are always descending which might not be the case?
                if (numberMark >= Number(grades[i].value)) {
                    optionIndex = i;
                    break;
                }
            }
            $dropdown.prop("selectedIndex", optionIndex);
        }

        // Given a percentage mark, find the letter grade that corresponds to its bracket in the marking scheme
        // TODO this function seems to not be calculating brackets the same way twig is; who is wrong?
        function getLetterGradeFromNumeric(numericMark, grades) {
            var gradesLength = grades.length,
                numberMark   = Number(numericMark);
            for (var i = 0; i < gradesLength; i++) {
                // TODO assumes values are always descending which might not be the case?
                if (numberMark >= Number(grades[i].value)) {
                    return grades[i].letter;
                }
            }

            // Did I fall through to here? Use the last grade
            return gradesLength > 0 ? grades[gradesLength-1].letter : '';
        }

        // Turn a specified value into a percentage of the max marks for a group
        function getPercentage($groupSummary, value) {
                var floatValue = parseFloat(value).toFixed(2);
            if (!isNaN(floatValue)) {
                var percentage = $groupSummary.attr('data-max') > 0 ? floatValue * (100 / $groupSummary.attr('data-max')) : 0;
            }
            else {
                var percentage = 0;
            }

            // Known bug: due to javascript rounding errors, with some values the percentage will wrongly be identified as not divisible by 1
            if (percentage % 1 !== 0) {
                percentage = percentage.toFixed(2);
            }
            return percentage;
        }


        // Hide or display the descriptor range input depending on whether it's needed or not
        function showHideRangeInput($changedCell) {
            var $allCellsInRow = $changedCell.parents("tr").find("[data-rubric], [data-rubric-group]");

            // Hide dropdowns on all cells in the same row
            $allCellsInRow.siblings("select").addClass("hide");

            // Disable all dropdowns so they don't get POSTed
            $allCellsInRow.siblings("select").prop("disabled", true);

            // Show text labels on all cells in the same row
            $allCellsInRow.siblings("label").find(".rb-value").removeClass("hide");

            if ($changedCell.prop('checked')) {
                // Hide the text label on the selected cell
                $changedCell.siblings("label").find(".rb-value").addClass("hide");

                // This will only un-hide an element if that element is the one we need to use on that cell:
                // - Dropdowns are only used on cells with a range
                // - Cells with a single value just get a text label

                $changedCell.siblings("select.used").removeClass("hide");
                $changedCell.siblings("select.used").prop("disabled", false); // Re-enable so we can use it and it gets POSTed
                $changedCell.siblings("label").find(".rb-value.used").removeClass("hide");
            }
        }

        // Scale an unscaled mark based on a group's max mark
        function scale($groupSummary, value) {
            var groupMax = $groupSummary.attr('data-max');
            var groupRowMaxSum = $groupSummary.attr('data-row-max-sum');

            if (groupRowMaxSum > 0) {
                var scaledGroupSum = value * (groupMax / groupRowMaxSum);
            }
            else {
                var scaledGroupSum = value;
            }

            if(scaledGroupSum % 1 != 0){
                scaledGroupSum = scaledGroupSum.toFixed(2);
            }

            return scaledGroupSum;
        }

        // Get the raw unscaled sum of selected descriptor values from the collection of descriptors passed in
        function summateDescriptors($descriptorCheckboxes) {
            var descriptorSummation = 0;

            $descriptorCheckboxes.each(function () {
                var $descriptorCheckbox = $(this);

                if ($descriptorCheckbox.prop('checked')) {
                    // Is there a select box for this? If so use its value instead
                    var descriptorId = $descriptorCheckbox.attr('data-rubric-descriptor'),
                        $select = $rb.find('#rangeDropdown-'+String(descriptorId)),
                        descriptorValue;
                    if ($select.length) {
                        descriptorValue = parseFloat($select.val());
                    } else {
                        descriptorValue = parseFloat($descriptorCheckbox.attr('data-value'));
                    }
                    if (!isNaN(descriptorValue)) {
                        descriptorSummation += descriptorValue;
                    }
                }
            });

            return descriptorSummation;
        }


        // Calculate the overall rubric mark from the scaled group marks
        function getTotalMark()
        {
            var totalMark = 0;
            var rubricOverallMax = 0;

            var $groupSummary = $rb.find('[data-group-summary]');

            if ($groupSummary.length) {
                $groupSummary.each(function() {
                    var groupScaledMark = parseFloat($(this).attr('data-scaled-mark'));

                    if (!isNaN(groupScaledMark)) {
                        totalMark += groupScaledMark;
                    }

                    rubricOverallMax += $(this).attr('data-max');
                });
            } else {
                var $descriptorCheckboxes = $("[data-rubric-descriptor]");
                totalMark = summateDescriptors($descriptorCheckboxes);
            }

            // If sum isn't a whole number: round to 2dp
            if(totalMark % 1 != 0){
                totalMark = totalMark.toFixed(2);
            }


            return totalMark;
        }

        // If not multi-select, simulate radio behaviour per row (simpler to do this than intercept radio checked event!)
        {# TODO I have no idea what multiSelect is, and AFAICT it's always false #}
        {#{% if not rubric.multiSelect %}#}
        // Can't delegate this, as auto-mark will run before it can un-check siblings
        $('[data-rubric-descriptor]').on('change', function(event){

            var $descriptorInput = $(this);
            var $checkboxGroup   = $descriptorInput.closest('[data-group]');
            var $descriptors     = $checkboxGroup.find('[data-rubric-descriptor]');

            $descriptors.each(function(idx, elem){
                var $otherDescriptor = $(elem);
                if($otherDescriptor.attr('data-rubric-descriptor') != $descriptorInput.attr('data-rubric-descriptor')){
                    $otherDescriptor.prop('checked', false);
                }
            });
        });
        {#{% endif %}#}

        /**
         *
         * @param {jQuery} $elem
         * @param {string|null} namespace
         */
        function parseFraction($elem, namespace)
        {
            var ev = 'dynagrade';
            if (namespace) {
                ev = ev + '.' + namespace;
            }

            $elem.each(function () {
                if (this.hasAttribute('data-scaled-mark') && this.hasAttribute('data-max')) {
                    $(this).trigger(ev);
                }
            });

        }

    });
</script>
{% endautoescape %}
