{##
 # Grid (markable variant)
 #
 # This displays multiple data points on a single grid where you can choose descriptors as part of giving feedback.
 # It is shown to learners when they are self-grading, but predominantly used by instructors.
 #
 # 1. It displays the grid structure - capabilities, indicators, levels.
 # 2. It can display the marked grid, as determined by instructors; these show the instructor-selected descriptors as
 #    shaded cells.
 # 3. It can display the self-graded grid, as determined by learners; these show the learner-selected descriptors with a
 #    little profile picture of the learner.
 #
 # ----
 #
 # $showGroupTotal, $showRubricTotal: these are legacy-named vars that specifically (and unilaterally) decode when
 # capability marks and the rubric's overall total value (sum of its caps/descriptor selections) are rendered on-screen.
 # While there's potential for deriving them from the assessment and rubric grid's settings, there are occasions where
 # you literally don't care about that computation and want to arbitrarily decide an outcome.
 #
 # showGroupTotal and showRubricTotal are vars that unilaterally decide whether the Capability Mark
 # value and Rubric Total value shows on the grid, regardless of the feedbacks or assessment setting
 # that you could potentially use to derive this outcome. It's so that you can arbitrarily decide
 # when and where each of these can be seen by a user. For example, in summative reports, you
 # always want to show the capability mark but never show the rubric total - even if the assessment
 # settings suggest you could.
 #
 # @param IAssessable $assessment                A learning activity instance
 # @param Rubric\Instance\Model $rubricInstance  The container containing rubric settings for this particular grid, and the grid itself.
 # @param bool $showGroupTotal                   An arbitrary decision about whether Capability Marks could display here, if extant.
 # @param bool $showRubricTotal                  An arbitrary decision about whether Rubric Grid Totals could display here, if extant
 # @param bool $markVisibility                   Whether this feedback is visible to the current user.
 # @param bool $blindMode                        Hides identifying information from instructors so they don't readily know who they're grading.
 # @param bool $studentView                      This decides which mark scheme to show: the learner's mark scheme (for self-grading) or the instructor's mark scheme
 #                                               (It would be used when learners view the marked grid which might show different mark scheme than instructors.)
 # @param bool $selfAssess                       A bool corresponding to whether Self Assessment was enabled in the Due Work settings and can occur for this response instance
 # @param bool $selfReflect                      Whether self-reflection can occur on this response instance
 # @param User $learner                          The person who submitted the response instance
 # @param $selfAssessmentFeedback                "the self-assessed feedback, shouldst there be one"
 # @param string rubricGridPayloads              A json-encoded representation of the rubric grid structure, marked grid, self graded grid
 #}

{% set showPoints = true %}
{% set markScheme = selfAssess or studentView ? assessment.markScheme : assessment.instructorMarkScheme %}

<div data-vue-app="rubric-markable">
    <rubric-markable
        :rubric-marked-grids-payload="{{ rubricGridPayloads }}"
        :assessment-mark-scheme="{{ markScheme.generateContext|json_encode }}"
        :participant-id="{{ not blindMode and learner.id ? learner.id : 'null' }}"
        {# TODO: these are signs of likely permission issues #}
        {% if showRubricTotal ?? false %}show-rubric-total{% endif %}
        {% if showGroupTotal ?? false %}show-group-total{% endif %}
        {% if showDescriptorValue ?? true %}show-descriptor-value{% endif %}
        {% if selfAssessmentFeedback and selfAssessmentFeedback.isSelfGrading %}is-self-grading{% endif %}
        {% if selfAssess ?? false %}is-self-assess{% endif %}
        {% if studentView ?? false %}is-student-view{% endif %}
    />
</div>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/rubricMarkable.js?v={{ config.site_version }}"></script>
