<input id="{{ inputId }}"
       name="{{ formField }}[descriptors][{{ descriptor.id }}][selected]"
       value="1"
       type="checkbox"
       data-value="{{ descriptor.maxValue }}"
       data-rubric="{{ rubricGrid.assessment.id }}"
       data-rubric-group="{{ groupUsage.capability.id }}"
       data-rubric-descriptor="{{ descriptor.id }}"
       {% if isDescriptorSelected %}checked="checked"{% endif %}
/>

<label for="{{ inputId }}">
    <span class="rb-description">
        {{- descriptor.description|nl2br -}}
    </span>

    {% set descriptorHasMarkRange = rubricGrid.assessment.useMarkRange and descriptor.hasRange %}

    {# Just show a text value if the descriptor is not selected #}
    {% if descriptor.hasValue and showDescriptorValue %}
        <span class="rb-value {% if not descriptorHasMarkRange %}used {% elseif isDescriptorSelected %}hide{% endif %}">
            {% if descriptorHasMarkRange %}
                {{ descriptor.retrieveLeftValue }}–{{ descriptor.retrieveRightValue }}
            {% else %}
                {{ descriptor.maxValue }}
            {% endif %}
        </span>
    {% endif %}
</label>

{# TODO this select needs a label; technically it should be the one above but that's already in use for the descriptor checkbox #}
{% if descriptorHasMarkRange and not studentView %}
    {# Render a dropdown to select a value from the range #}

    <select id="rangeDropdown-{{ descriptor.id }}"
            name="{{ formField }}[descriptors][{{ descriptor.id }}][value]"
            class="{% if not isDescriptorSelected or not descriptorHasMarkRange %} hide{% endif %}
            {% if descriptorHasMarkRange  %}used{% endif %}"
            data-rubric="{{ rubricGrid.id }}"
            data-rubric-group="{{ groupUsage.capability.id }}"
            data-rubric-descriptor="{{ descriptor.id }}"
    >
        {# Selected value: if not provided, use max #}
        {% set selectedValue = isDescriptorSelected ? indicatorMark.value : descriptor.maxValue %}

        {% for i in descriptor.minValue..descriptor.maxValue %}
            <option value="{{ i }}" {% if i == selectedValue %}selected{% endif %}>{{ i }}</option>
        {% endfor %}
    </select>
{% endif %}

{# Self-assessment #}
{% if selfAssessmentIndicatorMark and selfAssessmentIndicatorMark.descriptor.id == descriptor.id %}
    <img class="rb-self-reflection-choice"
         src="/portrait.php?userId={{ learner.externalId }}&amp;size=square32"
         title="{% if selfAssessmentFeedback.isSelfGrading %}({{ selfAssessmentIndicatorMark.value }}) {{ locale.selfAssessment.proper }}{% else %}{{ locale.selfReflection.proper }}{% endif %} choice" />
{% endif %}
