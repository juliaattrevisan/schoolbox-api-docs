{# Take down this elephant one leg at a time #}
{% set capabilityId         = groupUsage.capability.id %}
{% set capabilityScaledMark = capabilityMark.calculateScaledMark ?? 0 %}

{# What could the difference between these two things possibly be? #}
{% set capabilityMaxValue = groupUsage.maxValue %}
{% set capabilityMaxFromIndicators   = groupUsage.calculateMaxValueFromIndicators %}
{% set capabilityNormMark = capabilityMark is not null ? capabilityMark.retrieveNormalizedMark : null %}

{% set markScheme = rubricGrid.capabilityMarkScheme ?? rubricGrid.assessment.markScheme %}
{% set markType   = markScheme.generateContext %}
{% if showGroupTotal %}
    {% set letterGradeBracket = null %}

    {# TODO assumes values are always descending which might not be the case? #}
    {% if markScheme.gradeGroup is defined %}
        {% for gradeLevel in markScheme.gradeGroup.gradeLevels %}
            {# If cap mark has been given, find the bracket that matches the given mark #}
            {% if capabilityMark is not null and capabilityMark.value is not null %}
                {# Is this below the last? If so use the last one #}
                {% if not letterGradeBracket and (capabilityNormMark >= gradeLevel.lowerBound or loop.last) %}
                    {% set letterGradeBracket = gradeLevel.lowerBound %}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}

    {% if rubricGrid.isCapabilityMarkShown(groupUsage.capability) %}
        <tr>
            <th class="rb-group-summary" colspan="{{ rubricGrid.levels|length + 1 }}">
                <span data-group-summary="{{ rubricId }}-{{ capabilityId }}"
                      data-mark="{{ capabilityMark ? capabilityMark.value : null }}"
                      data-scaled-mark="{{ capabilityScaledMark }}"
                      data-max="{{ capabilityMaxValue }}"
                      data-row-max-sum="{{ capabilityMaxFromIndicators }}"
                      data-group-id="{{ capabilityId }}"
                      data-rubric-id="{{ rubricGrid.id }}"
                      data-mark-type="{{ markType.mode }}">

                    <label for="group-{{ capabilityId }}-mark">{{ locale.rubricGroup.proper }} mark</label>

                    {% if markType.mode == 'raw' or markType.mode == 'none' %}
                        <input data-group-mark
                               class="groupMark"
                               id="group-{{ capabilityId }}-mark"
                               type="tel"
                               name="{{ formField }}[groups][{{ capabilityId }}][customMark]"
                               value="{{ capabilityMark ? capabilityMark.humanReadableValue : null }}" /> / {{ capabilityMaxValue }}

                    {% elseif markType.mode == 'letter' %}
                        <select data-group-mark
                                class="groupMark"
                                name="{{ formField }}[groups][{{ capabilityId }}][customMark]"
                                id="group-{{ capabilityId }}-mark">

                            {% if markScheme.gradeGroup.gradeLevels|length == 0 %}
                                <optgroup label="Original Grades Deleted">
                                    <option value="" selected disabled>empty</option>
                                </optgroup>
                            {% endif %}

                            {# Output letter grade select options #}
                            {% set selectedLetterGrade = capabilityMark ? capabilityMark.humanReadableValue : null %}
                            {% set found = false %}
                            <option value=""
                                    {% if selectedLetterGrade is null %}{% set found = true %}selected{% endif %}>(no grade)</option>

                            <optgroup label="{{ locale.grades.properPlural }}">
                                {% for gradeLevel in markScheme.gradeGroup.gradeLevels %}
                                    <option value="{{ gradeLevel.caption }}"
                                            data-lower-bound="{{ gradeLevel.lowerBound }}"
                                            data-raw-grade="{{ gradeLevel.rawGrade }}"
                                            {% if selectedLetterGrade == gradeLevel.caption %}{% set found = true %}selected{% endif %}
                                            data-letter="{{ gradeLevel.caption }}">
                                        {{ gradeLevel.caption }}
                                    </option>
                                {% endfor %}
                            </optgroup>

                            {% if not found %}
                                <optgroup label="Original Deleted Grade">
                                    <option selected value="-1" disabled>
                                        {{ selectedLetterGrade }}
                                    </option>
                                </optgroup>
                            {% endif %}
                        </select>

                    {% elseif markType.mode == 'percent' %}
                        <input data-group-mark
                               class="groupMark"
                               id="group-{{ capabilityId }}-mark"
                               type="tel"
                               name="{{ formField }}[groups][{{ capabilityId }}][customMark]"
                               value="{{ capabilityMark and capabilityMark.humanReadableValue is not null
                                ? (capabilityMark.humanReadableValue | round(2))
                                : null }}"/> %
                    {% endif %}

                    {% if groupUsage.containsDescriptorsWithValue %}
                        <a data-use-descriptor-values class="fieldAssign">Assign <span class="descriptor-sum" data-group-descriptor-sum>
                                {{ capabilityMark ? capabilityMark.indicatorMarkSumScaled : null }}
                            </span> from descriptors</a>
                    {% endif %}
                    {% if markType.mode == 'letter' or markType.mode == 'percent' %}
                        <!-- <p class="meta">This {{ locale.rubricGroup }} contributes {{ (capabilityMaxValue / rubricGrid.calculateMaxValueFromCapabilities * 100) | round(2) }}% to the total mark</p> -->
                    {% endif %}
                </span>

                {# Self-Assessment #}
                {% if selfAssessmentFeedback is not null and selfAssessmentFeedback.isSelfGrading %}
                    {% set selfAssessmentCapabilityMark = selfAssessmentFeedback.rubricMarkedGrid.retrieveCapabilityMark(groupUsage) %}
                    <p class="meta">{{ selfAssessmentCapabilityMark ? selfAssessmentCapabilityMark.humanReadableValue~' given in '~locale.selfAssessment }}</p>
                {% endif %}
            </th>
        </tr>
    {% else %}
    <!-- <p class="meta">Descriptors in this {{ locale.rubricGroup }} do not contribute to the total mark, because the {{ locale.rubricGroup }}'s maximum points are 0.</p> -->
{% endif %}
{% endif %}
