{# Take down this elephant one leg at a time #}
{% set capabilityId         = groupUsage.capability.id %}

{# What could the difference between these two things possibly be? #}
{% set capabilityMaxValue = groupUsage.maxValue %}

{% set capabilityMarkScheme = rubricGrid.capabilityMarkScheme ?? markScheme %}
{% set capabilityMarkType   = capabilityMarkScheme.generateContext %}
{% if showGroupTotal %}
    {% if rubricGrid.isCapabilityMarkShown(groupUsage.capability) %}
        <tr>
            <th class="rb-group-summary" colspan="{{ rubricGrid.levels|length + 1 }}">
                <span>
                    {% set formInputValue = capabilityMark ? capabilityMark.retrieveHumanReadableValueAsFormInput : null %}
                    {% if capabilityMarkType.mode == 'raw' or capabilityMarkType.mode == 'none' %}
                        <input data-group-mark
                               class="groupMark"
                               id="group-{{ capabilityId }}-mark"
                               type="tel"
                               name="{{ formField }}[groups][{{ capabilityId }}][customMark]"
                               value="{{ formInputValue }}" /> / {{ capabilityMaxValue }}

                    {% elseif capabilityMarkType.mode == 'letter' %}
                        <select data-group-mark
                                class="groupMark"
                                name="{{ formField }}[groups][{{ capabilityId }}][customMark]"
                                id="group-{{ capabilityId }}-mark">

                            {% if capabilityMarkScheme.gradeGroup.gradeLevels|length == 0 %}
                                <optgroup label="Original Grades Deleted">
                                    <option value="" selected disabled>empty</option>
                                </optgroup>
                            {% endif %}

                            {# Output letter grade select options #}
                            {% set found = false %}
                            <option value=""
                                    {% if formInputValue is null %}{% set found = true %}selected{% endif %}>(no grade)</option>

                            <optgroup label="{{ locale.grades.properPlural }}">
                                {% for gradeLevel in capabilityMarkScheme.gradeGroup.gradeLevels %}
                                    <option value="{{ gradeLevel.caption }}"
                                            data-lower-bound="{{ gradeLevel.lowerBound }}"
                                            data-raw-grade="{{ gradeLevel.rawGrade }}"
                                            {% if formInputValue == gradeLevel.caption %}{% set found = true %}selected{% endif %}
                                            data-letter="{{ gradeLevel.caption }}">
                                        {{ gradeLevel.caption }}
                                    </option>
                                {% endfor %}
                            </optgroup>

                            {% if not found %}
                                <optgroup label="Original Deleted Grade">
                                    <option selected value="-1" disabled>
                                        {{ formInputValue }}
                                    </option>
                                </optgroup>
                            {% endif %}
                        </select>

                    {% elseif capabilityMarkType.mode == 'percent' %}
                        <input data-group-mark
                               class="groupMark"
                               id="group-{{ capabilityId }}-mark"
                               type="tel"
                               name="{{ formField }}[groups][{{ capabilityId }}][customMark]"
                               value="{{ formInputValue }}"/> %
                    {% endif %}
                </span>
            </th>
        </tr>
{% endif %}
{% endif %}
