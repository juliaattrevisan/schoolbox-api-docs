@startuml

hide empty fields
hide empty methods

namespace Assessment {

    interface AssessmentContext {
        getFolder() : Folder
        getBaseContext() : AssessmentContext
    }

    interface IAssessable {
        getContext() : AssessmentContext
    }

    interface IFeedback {
        getAssessable() : IAssessable
        getReviewee() : User
    }

    ' internal relations
    AssessmentContext *-r- IAssessable
    IAssessable *-r- IFeedback
}


namespace RubricRowset {

    class RubricRowset {
        groups : RubricGroup[]
        context : AssessmentContext
    }

    class RubricGroup {
        criteria : RubricCriterion[]
        name : string
        isInUse() : bool
        isInUseExcluding(IAssessable) : bool
    }

    class RubricCriterion {
        name : string
        usage : IAssessable[]
        isInUse() : bool
        isInUseExcluding(IAssessable) : bool
    }

    ' internal relations
    RubricRowset *-d- RubricGroup
    RubricGroup *-d- RubricCriterion

    ' relation to Assessment
    Assessment.AssessmentContext *-d- RubricRowset
}


namespace RubricGrid {

    class RubricGrid {
        assessment : IAssessable
        rowset : RubricRowset
        levels : RubricLevel[]
        groups : RubricGroupUsage[]
        calculateMaxValueFromGroups() : float
        iterateGroups() : RubricGroup[]
        retrieveGroupUsage(RubricGroup) : ?RubricGroupUsage
        retrieveCriterionUsage(RubricCriterion) : ?RubricCriterionUsage
    }

    class RubricGroupUsage {
        group : RubricGroup
        criteria : RubricCriterionUsage[]
        maxValue : float
        calculateMaxValueFromCriteria() : float
        iterateCriteria() : RubricCriterion[]
        retrieveCriterionUsage(RubricCriterion) : ?RubricCriterionUsage
    }

    class RubricCriterionUsage {
        criterion : RubricCriterion
        descriptors : RubricDescriptor[]
        calculateMaxValueFromDescriptors() : float
        applyDescriptorMinValues() : void
    }

    class RubricLevel {
        name : string
    }

    class RubricDescriptor {
        description : string
        minValue : float
        maxValue : float
    }

    ' internal relations
    RubricGrid *-d- RubricGroupUsage
    RubricGroupUsage *-d- RubricCriterionUsage
    RubricCriterionUsage *-d- RubricDescriptor
    RubricGrid *-d- RubricLevel
    RubricLevel *-[hidden]r- RubricGroupUsage

    ' relation to Assessment
    Assessment.IAssessable *-d- RubricGrid

    ' relation to RubricRowset
    RubricGrid -l-* RubricRowset.RubricRowset
    RubricGroupUsage -l-* RubricRowset.RubricGroup
    RubricCriterionUsage -l-* RubricRowset.RubricCriterion
}


namespace RubricMarkedGrid {

    class RubricMarkedGrid {
        grid : RubricGrid
        feedback : IFeedback
        groups : RubricGroupMark[]
        calculateMarkFromGroups() : float
    }

    class RubricGroupMark {
        group : RubricGroupUsage
        criteria: RubricCriterionMark[]
        value : float
        calculateMarkFromCriteria() : float
    }

    class RubricCriterionMark {
        criterion : RubricCriterionUsage
        selectedDescriptor: RubricDescriptor
        value : float
    }

    ' internal relations
    RubricMarkedGrid *-d- RubricGroupMark
    RubricGroupMark *-d- RubricCriterionMark

    ' relation to Assessment
    Assessment.IFeedback *-d- RubricMarkedGrid

    ' relation to RubricGrid
    RubricMarkedGrid -l-* RubricGrid.RubricGrid
    RubricGroupMark -l-* RubricGrid.RubricGroupUsage
    RubricCriterionMark -l-* RubricGrid.RubricCriterionUsage
    RubricCriterionMark -l-* RubricGrid.RubricDescriptor
}

@enduml
