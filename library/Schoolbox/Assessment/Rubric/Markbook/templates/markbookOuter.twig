{#
    folder       Folder\Model
    filterPanel  Filter\Panel
#}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(['Learning', '/learning/classes'], [folder.name, '/homepage/' ~ folder.id], ['Rubric Markbook']) }}

{% set reportContentId = 'rubric-markbook-content' %}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/jquery.marksheet.js?v={{ config.site_version }}"></script>
<script>
    $(function() {
        $('#{{ reportContentId }}').on('filterContentLoaded', function() {
            // Hide/show a drop shadow when scrolling the markbook horizontally
            // The shadow only appears when you have scrolled past a certain threshold
            $(".scrollable-table-wrap").on('scroll', function(e) {
                const scrollAmount = e.target.scrollLeft;
                const scrollPixelThreshold = 10;
                const $leftColumns = $(".left-columns-wrap");
                if (scrollAmount > scrollPixelThreshold && !$leftColumns.hasClass(".drop-shadow")) {
                    $leftColumns.addClass("drop-shadow");
                } else {
                    $leftColumns.removeClass("drop-shadow");
                }
            });
        });
    });
</script>



<div class="row">
    <div class="small-12">
        <h1>Rubric Markbook for {{ folder.name }}</h1>
    </div>
</div>


{% include '@filters/panel.twig' with {
    contentId: reportContentId,
    panel:     filterPanel,
    quickload: true
} only %}

{# TODO move to filter SASS #}
<style>
    @media only print, screen and (max-width: 64em) and (min-width: 40.0625em) {
        .filtered-report .row > .small-12  {
            padding: 0 1.5rem;
        }
    }
</style>



<div id="{{ reportContentId }}" class="filtered-report">
    <div class="row">
        <div class="small-12 island" data-placeholder>
            <section class="content">
                <img src="{{ CDN_PREFIX }}/images/foundation/preloader.gif" alt="preloader.gif" style="text-align:center; margin:auto; display:block;">
            </section>
        </div>
    </div>
</div>

{% autoescape 'js' %}
    <script type="text/javascript">
        $(function() {
            $('#{{ reportContentId }}').on('filterContentLoaded', function() {
                $.marksheetToggleDrafts('#show-drafts');

                // Note that we cannot use window.resize here because we must respond to the pinning of the left nav
                // menu or right notifications window.  Also we cannot listen for resize events on the container,
                // because resize events only occur on the window.  This is a task for the ResizeObserver.
                // @see https://developer.mozilla.org/en-US/docs/Web/API/Window/resize_event
                // @see similar code in courseMarkbookOuter.twig and Learning/.../markbookOuter.twig.
                const container = document.querySelector("[data-diagonal-headings-table-container]");
                if (container !== null) {
                    const resizeObserver = new ResizeObserver(() => {
                        container.style.maxHeight = 'calc(100vh - ' + Math.round(container.getBoundingClientRect().top) + 'px)';
                    });
                    resizeObserver.observe(container);
                }
            });
        });
    </script>
{% endautoescape %}
