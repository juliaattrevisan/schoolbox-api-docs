<h1>Rubric Markbook for {{ folder.name }}</h1>

{% import '@learning/macro/urgency.twig' as urgency %}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(['Learning', '/learning/classes'], ['Rubric Markbook']) }}

<script>
    $(function() {
        // The only purpose of using this plugin now is to ensure that the last student in the list doesn't get
        // cut off when the window shrinks.
        var $windowWidthRems = $(window).width() / parseFloat($('html').css('font-size'));
        if ($windowWidthRems >= 40) {
            $('[data-mark-sheet]').DataTable({
                scrollCollapse: true,
                paging: false,
                bFilter: false,
                bInfo: false,
                ordering: false
            });
        }

        // Hide/show a drop shadow when scrolling the markbook horizontally
        // The shadow only appears when you have scrolled past a certain threshold
        $("#rubric-marksheet-wrapper").scroll(function(e) {
            const scrollAmount = e.target.scrollLeft;
            const scrollPixelThreshold = 10;
            const $leftColumns = $("#left-columns");
            if (scrollAmount > scrollPixelThreshold && !$leftColumns.hasClass(".drop-shadow")) {
                $leftColumns.addClass("drop-shadow");
            } else {
                $leftColumns.removeClass("drop-shadow");
            }
        });
    });
</script>

<style>
    #table-container {
        display: flex;
    }
    #left-columns, #rubric-marksheet {
        /* Ensures rows in each table stay in line with each other */
        white-space: nowrap;
    }
    #left-columns tr, #rubric-marksheet tr {
        /* Enforce a fixed height to ensure rows always match up */
        height: 39px;
    }
    #rubric-marksheet-wrapper {
        /* Allow the user to scroll the mark table horizontally (has to be applied to wrapper div, not table) */
        overflow-x: auto;
    }

    /**** Styles to force the width of the 2 left columns ****/
    #left-columns {
        margin-top: 10.04rem; /* This is the height of the student headings on the marksheet, plus a tiny tweak (ugh) */
        table-layout: fixed; /* Required in order for a fixed width to be set */
        width: 350px;
        flex: 0 0; /* Fixes an IE bug */
        border-collapse: separate; /* Fixes an IE bug, see https://stackoverflow.com/questions/9949396/css-box-shadow-not-working-in-ie */
    }
    #left-columns.drop-shadow {
        /* Drop shadow to make it easier to understand what's going on when scrolling the other table */
        -webkit-box-shadow: 15px 0px 32px -18px rgba(0,0,0,0.1);
        -moz-box-shadow: 15px 0px 32px -18px rgba(0,0,0,0.1);
        box-shadow: 15px 0px 32px -18px rgba(0,0,0,0.1);

        /* Make sure we can see the drop shadow.
        For some reason, this only works if applied to #left-columns.drop-shadow;
        otherwise something overrides it */
        z-index: 1;
    }
    .column-1, .column-2 {
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .column-1 {
        width: 150px;
    }
    .column-2 {
        width: 200px;
    }

    /**** Remove weird default tooltip styling ****/
    #left-columns .has-tip, #rubric-marksheet .has-tip {
        border-bottom: 1px solid #ededed;
    }
    #rubric-marksheet .has-tip {
        font-weight: normal;
    }
    #left-columns .has-tip:hover, #rubric-marksheet .has-tip:hover {
        color: black;
    }

    /**** Style the assessment/cap/indicator headings ****/
    #left-columns .placeholder,
    #left-columns .assessment,
    #left-columns .capability,
    #left-columns .indicator {
        border-right: 1px solid #ededed;
    }
    #left-columns .placeholder, #left-columns .assessment {
        border-bottom: none;
    }
    #left-columns .assessment {
        font-weight: normal;
        border-top: 1px solid #ededed;
    }
    #left-columns tr:first-child .assessment {
        /* Removes top border on first assessment that makes table look wonky */
        border-top: none;
    }
    #left-columns .indicator {
        padding-left: 2rem;
        font-weight: normal;
    }

    /**** Style the marksheet ****/
    #rubric-marksheet a.no-mark {
        padding: 0.5rem 1.25rem 0.5rem 1.25rem; /* Makes it easier to click on the dashes */
        color: black; /* Without this, the dashes would be blue by default since they're links */
    }
</style>

{% if studentMarks|length %}
<div id="table-container">

    <table id="left-columns">
        <thead>
        {% for assessmentId, assessment in assessments %}
            {% for capabilityId, capability in assessment.capabilities %}

                <tr>
                    {% if loop.index == 1 %}
                        <th class="column-1 assessment has-tip" data-tooltip aria-haspopup="true" title="{{ assessment.name }}">
                            {# On touchscreens we can't tap to view the tooltip without being sent to the link.
                            In this case it's more important to see the tooltip than to follow the link, so I got rid of it #}
                            {#<a href="{{ assessment.statusLink }}">{{ assessment.name }}</a>#}
                            {{ assessment.name }}
                        </th>
                    {% else %}
                        <th class="column-1 placeholder">&nbsp;</th>
                    {% endif %}

                    <th class="column-2 capability has-tip" data-tooltip aria-haspopup="true" title="{{ capability.name }}">{{ capability.name }}</th>
                </tr>

                {% for indicatorId, indicator in capability.indicators %}
                    <tr>
                        <th class="column-1 placeholder">&nbsp;</th>
                        <th class="column-2 indicator has-tip" data-tooltip aria-haspopup="true" title="{{ indicator.name }}">{{ indicator.name }}</th>
                    </tr>
                {% endfor %}

            {% endfor %}
        {% endfor %}
        </thead>
    </table>

    <div id="rubric-marksheet-wrapper">
        {# Marksheet class IS being used; do not delete it #}
        <table id="rubric-marksheet" class="marksheet" data-mark-sheet>
            <thead>
                <tr class="rotate-headers" data-headers>
                    {% for studentId, student in studentMarks %}
                        <th>
                            <div>
                                <span>
                                    <a href="{{ student.profileLink }}">
                                        {{ student.lastname ~ ', ' ~ student.firstname}}
                                    </a>
                                </span>
                            </div>
                        </th>
                    {% endfor %}
                </tr>
            </thead>

            <tbody>
                {% for assessmentId, assessment in assessments %}

                    {% for capabilityId, capability in assessment.capabilities %}
                        <tr class="capability">
                            {% for studentId, student in studentMarks %}
                                {% set capabilityMark = student.assessments[assessmentId].capabilities[capabilityId].humanReadableMark %}
                                {% set normalisedCapabilityMark = student.assessments[assessmentId].capabilities[capabilityId].normalisedMark %}
                                {% set summaryLink = student.assessments[assessmentId].summaryLink %}

                                {% set gradientClass = urgency.marks(normalisedCapabilityMark) %}
                                {% if capabilityMark is null %}
                                    {% set gradientClass = "" %}
                                {% endif %}

                                <td>
                                    <a href="{{ summaryLink }}" class="{{ gradientClass }} {{ capabilityMark ? : 'no-mark' }}">{{ capabilityMark|default('-') }}</a>
                                </td>
                            {% endfor %}
                        </tr>

                        {% for indicatorId, indicator in capability.indicators %}
                            <tr class="indicator">
                                {% for studentId, student in studentMarks %}
                                    {% set indicatorMark = student.assessments[assessmentId].capabilities[capabilityId].indicators[indicatorId].humanReadableMark %}
                                    {% set normalisedIndicatorMark = student.assessments[assessmentId].capabilities[capabilityId].indicators[indicatorId].normalisedMark %}
                                    {% set descriptorText = student.assessments[assessmentId].capabilities[capabilityId].indicators[indicatorId].selectedDescriptorText %}
                                    {% set summaryLink = student.assessments[assessmentId].summaryLink %}

                                    {% set gradientClass = urgency.marks(normalisedIndicatorMark) %}
                                    {% if normalisedIndicatorMark is null %}
                                        {% set gradientClass = "" %}
                                    {% endif %}

                                    {# Although it is possible to apply the tooltip to an anchor tag, doing so conflicts with
                                    the grade-ient CSS in a major way.
                                    We have to disable the tooltip for touchscreens, otherwise it will show briefly,
                                     then confusingly redirect the user to the link #}
                                    <td class="has-tip" data-tooltip data-options="disable_for_touch:true" aria-haspopup="true" title="{{ descriptorText|default('-No descriptor text-') }}">
                                        <a href="{{ summaryLink }}" class="{{ gradientClass }} {{ indicatorMark ? : 'no-mark' }}">{{ indicatorMark|default('-') }}</a>
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    {% endfor %}

                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% else %}
    <div class="empty-state">
        <i class="icon-progress"></i>
        <p>There are no rubric marks for this folder.</p>
    </div>
{% endif %}