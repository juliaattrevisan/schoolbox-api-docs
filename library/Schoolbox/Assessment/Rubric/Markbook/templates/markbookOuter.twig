<h1>Rubric Markbook for {{ folder.name }}</h1>

{% import '@learning/macro/urgency.twig' as urgency %}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(['Learning', '/learning/classes'], ['Rubric Markbook']) }}

<script>
    // The only purpose of using this plugin now is to ensure that the last student in the list doesn't get
    // cut off when the window shrinks.
    $(function() {
        var $windowWidthRems = $(window).width() / parseFloat($('html').css('font-size'));
        if ($windowWidthRems >= 40) {
            $('[data-mark-sheet]').DataTable({
                scrollCollapse: true,
                paging: false,
                bFilter: false,
                bInfo: false,
                ordering: false
            });
        }
    });
</script>

<style>
    #table-container {
        display: flex;
    }
    #left-columns, #rubric-marksheet {
        /* Ensures rows in each table stay in line with each other */
        white-space: nowrap;
    }
    #left-columns tr, #rubric-marksheet tr {
        /* Enforce a fixed height to ensure rows always match up */
        height: 39px;
    }
    #rubric-marksheet-wrapper {
        /* Allow the user to scroll the mark table horizontally (has to be applied to wrapper div, not table) */
        overflow-x: auto;
    }

    /**** Styles to force the width of the 2 left columns ****/
    #left-columns {
        margin-top: 10rem; /* This is the height of the student headings on the marksheet */

        table-layout: fixed; /* Required in order for a fixed width to be set */
        width: 350px;
    }
    .column-1, .column-2 {
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .column-1 {
        width: 150px;
    }
    .column-2 {
        width: 200px;
    }

    /**** Style the assessment/cap/indicator headings ****/
    #left-columns .placeholder,
    #left-columns .assessment,
    #left-columns .capability,
    #left-columns .indicator {
        border-right: 1px solid #ededed;
    }
    #left-columns .placeholder, #left-columns .assessment {
        border-bottom: none;
    }
    #left-columns .assessment {
        font-weight: normal;
        border-top: 1px solid #ededed;
    }
    #left-columns .indicator {
        padding-left: 2rem;
        font-weight: normal;
    }

    /**** Style the marksheet ****/
    #rubric-marksheet a.no-mark {
        padding: 0.5rem 1.25rem 0.5rem 1.25rem; /* Makes it easier to click on the dashes */
        color: black; /* Without this, the dashes would be blue by default since they're links */
    }
</style>

{% if studentMarks|length %}
<div id="table-container">

    <table id="left-columns">
        <thead>
        {% for assessmentId, assessment in assessments %}
            {% for capabilityId, capability in assessment.capabilities %}

                <tr>
                    {% if loop.index == 1 %}
                        <th class="column-1 assessment" title="{{ assessment.name }}">
                            <a href="{{ assessment.statusLink }}">{{ assessment.name }}</a>
                        </th>
                    {% else %}
                        <th class="column-1 placeholder">&nbsp;</th>
                    {% endif %}

                    <th class="column-2 capability" title="{{ capability.name }}">{{ capability.name }}</th>
                </tr>

                {% for indicatorId, indicator in capability.indicators %}
                    <tr>
                        <th class="column-1 placeholder">&nbsp;</th>
                        <th class="column-2 indicator" title="{{ indicator.name }}">{{ indicator.name }}</th>
                    </tr>
                {% endfor %}

            {% endfor %}
        {% endfor %}
        </thead>
    </table>

    <div id="rubric-marksheet-wrapper">
        {# Marksheet class IS being used; do not delete it #}
        <table id="rubric-marksheet" class="marksheet" data-mark-sheet>
            <thead>
                <tr class="rotate-headers" data-headers>
                    {% for studentId, student in studentMarks %}
                        <th>
                            <div>
                                <span>
                                    <a href="{{ student.profileLink }}">
                                        {{ student.lastname ~ ', ' ~ student.firstname}}
                                    </a>
                                </span>
                            </div>
                        </th>
                    {% endfor %}
                </tr>
            </thead>

            <tbody>
                {% for assessmentId, assessment in assessments %}

                    {% for capabilityId, capability in assessment.capabilities %}
                        <tr class="capability">
                            {% for studentId, student in studentMarks %}
                                {% set capabilityMark = student.assessments[assessmentId].capabilities[capabilityId].humanReadableMark %}
                                {% set normalisedCapabilityMark = student.assessments[assessmentId].capabilities[capabilityId].normalisedMark %}
                                {% set summaryLink = student.assessments[assessmentId].summaryLink %}

                                {% set gradientClass = urgency.marks(normalisedCapabilityMark) %}
                                {% if capabilityMark is null %}
                                    {% set gradientClass = "" %}
                                {% endif %}

                                <td>
                                    <a href="{{ summaryLink }}" class="{{ gradientClass }} {{ capabilityMark ? : 'no-mark' }}">{{ capabilityMark|default('-') }}</a>
                                </td>
                            {% endfor %}
                        </tr>

                        {% for indicatorId, indicator in capability.indicators %}
                            <tr class="indicator">
                                {% for studentId, student in studentMarks %}
                                    {% set indicatorMark = student.assessments[assessmentId].capabilities[capabilityId].indicators[indicatorId].humanReadableMark %}
                                    {% set normalisedIndicatorMark = student.assessments[assessmentId].capabilities[capabilityId].indicators[indicatorId].normalisedMark %}
                                    {% set descriptorText = student.assessments[assessmentId].capabilities[capabilityId].indicators[indicatorId].selectedDescriptorText %}
                                    {% set summaryLink = student.assessments[assessmentId].summaryLink %}

                                    {% set gradientClass = urgency.marks(normalisedIndicatorMark) %}
                                    {% if normalisedIndicatorMark is null %}
                                        {% set gradientClass = "" %}
                                    {% endif %}

                                    <td title="{{ descriptorText|default('-No descriptor text-') }}">
                                        <a href="{{ summaryLink }}" class="{{ gradientClass }} {{ indicatorMark ? : 'no-mark' }}">{{ indicatorMark|default('-') }}</a>
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    {% endfor %}

                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% else %}
    <div class="empty-state">
        <i class="icon-progress"></i>
        <p>There are no rubric marks for this folder.</p>
    </div>
{% endif %}