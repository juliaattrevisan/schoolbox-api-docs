<h1>Rubric Markbook for {{ folder.name }}</h1>
<script type="text/javascript" src="/javascript/shared/submissions/jquery.marksheet.js"></script>
<script type="text/javascript" src="/javascript/shared/submissions/task/jquery.progressTickForm.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.ajax-form.js"></script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(['Learning', '/learning/classes'], ['Rubric Markbook']) }}

<div class="row">
    <div class="small-12 island">
        <table class="rubric-marksheet marksheet" data-mark-sheet>
            <thead>
                <tr class="rotate-headers" data-headers>
                    <th>&nbsp;</th>
                    <th>&nbsp;</th>
                    {% for student in students %}
                        <th>
                            <div>
                                <span>
                                    <span>{{ student.name }}</span>
                                </span>
                            </div>
                        </th>
                    {% endfor %}
                </tr>

                {% for assessmentId, assessment in assessments %}
                    {# Set up the rowspan for the assessment #}
                    {% set capCount = assessment.capabilities|length %}
                    {% set rowspan = capCount %}

                    {% for capability in assessment.capabilities %}
                        {% set indCount = capability.indicators|length %}
                        {% set rowspan = rowspan + indCount %}
                    {% endfor %}

                    {# Render assessments #}
                    <tr class="assessment">
                        <th rowspan="{{ rowspan+1 }}" style="min-width: 200px;width: 200px;">
                            {{ assessment.name }}
                        </th>
                    </tr>

                    {# Render capabilities #}
                    {% for capabilityId, capability in assessment.capabilities %}
                        <tr class="capability">
                            <th style="min-width: 200px;width: 200px;">
                                {{ capability.name }}
                            </th>

                            {% for student in students %}
                                {% set capability = student[assessmentId].capabilities[capabilityId] %}
                                {% set capabilityMark = '-' %}
                                {% if capability.maxMark and capability.normalisedMark %}
                                    {% set capabilityMark = capability.normalisedMark ~ '/' ~ capability.maxMark %}
                                {% endif %}
                                <td>
                                    {{ capabilityMark }}
                                </td>
                            {% endfor %}
                        </tr>

                        {# Render indicators #}
                        {% for indicatorId, indicator in capability.indicators %}
                            <tr class="indicator">
                                <td style="min-width: 200px;width: 200px;">
                                    {{ indicator.name }}
                                </td>

                                {% for student in students %}
                                    {% set indicator = student[assessmentId].capabilities[capabilityId].indicators[indicatorId] %}
                                    {% set indicatorMark = '-' %}
                                    {% if indicator.maxMark and indicator.normalisedMark %}
                                        {% set indicatorMark = indicator.normalisedMark ~ '/' ~ indicator.maxMark %}
                                    {% endif %}
                                    <td title="{{ indicator.selectedDescriptorText }}">
                                        {{ indicatorMark }}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    {% endfor %}

                {% endfor %}
            </thead>
        </table>

    </div>
</div>
