<div data-role="ajax-error" class="reveal-modal" data-reveal>
    <div class="alert-box alert">
        <h5>Something went wrong while saving</h5>
        <p>You may try pressing the "Save Changes" button. If this persists, please contact your IT support.</p>
    </div>
</div>

<!-- Hidden text for remove criterion -->
<div class="hide" id="criterion-remove-text">
    <p>
        Are you sure you wish to remove the {{ locale.rubricCriterion }}
        &ldquo;<span data-rubric-criterion-name></span>&rdquo;?
    </p>
    {%- set classTerm -%}
        {%- if folder.hasCourseSpecification -%}
            course
        {%- elseif folder.hasUnitSpecification -%}
            {{ locale.unit }} (and its course)
        {%- elseif folder.isClass -%}
            class page
        {%- else -%}
            folder
        {%- endif -%}
    {%- endset -%}
    {% if allowModifyUsed %}
        <p>
            If you remove it, it will be removed from all
            {{ locale.dueWork.plural }} in this {{ classTerm }}
            and will be unavailable for use in future
            {{ locale.dueWork.plural }}.
        </p>
        <p>
            Please note, it will not be removed from
            {{ locale.dueWork.plural }} on class pages that currently have
            the {{ locale.rubricCriterion }} imported and in use.
        </p>
    {% else %}
        <p>
            If you remove it, it will no longer be available to use in
            {{ locale.dueWork.plural }} on this {{ classTerm -}}.
        </p>
    {% endif %}
    <p>
        (Make sure you click save at the end of this form to save changes you have made.)
    </p>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/curriculumSelector.js?v={{ config.site_version }}"></script>
