<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
{% autoescape 'js' %}
<script type="text/javascript">
$(function() {

    var form           = $('form[data-role="rubric-criteria-form"]');
    var groupMaxId     = Number('{{ maxGroupId }}');
    var criterionMaxId = Number('{{ maxCritId }}');

    // If there are no dropdowns at all on initial load; they must be reapplied
    // If there are any; they must not be reapplied. Go figure
    var hasDropdowns = form.find('[data-dropdown]').length > 0;

    // logic for adding new inputs
    var onCriterionUpdate = function() {
        if (this.value.length > 0) {
            var input        = $(this),
                idInput      = null,
                deleteButton = null,
                container    = [],
                groupId      = 0,
                criterionId  = 0,
                addGroup     = false,
                addCriterion = false;

            if (input.data('rubric-criterion-new')) {
                // New criterion?
                // Set the criterion ID of this row
                container    = input.closest('[data-rubric-criterion-row]');
                groupId      = input.closest('[data-rubric-group-row]').data('rubric-group-row');
                criterionId  = criterionMaxId++;
                addCriterion = true;
                idInput      = container.find('[data-template="rubric-criterion-id"]');
                deleteButton = container.find('[data-template="rubric-criterion-delete"]');

            } else if (input.data('rubric-group-new')) {
                // New group?
                // Set the group ID of this row
                container   = input.closest('[data-rubric-group-row]');
                groupId     = groupMaxId++;
                criterionId = criterionMaxId++;
                addGroup    = true;
                idInput     = container.find('[data-template="rubric-group-id"]');
            }

            if (container.length) {
                var newContainer = container.clone(true, true);
                newContainer.find('textarea').val('');
                newContainer.find('[data-rubric-criterion]').attr('data-rubric-criterion-new', true);
                input.attr('placeholder', 'Add {{ locale.rubricCriterion.proper }}...');

                newContainer.appendTo(container.parent());
                // Update the new form input - make it no longer new
                if (addCriterion) {
                    // This is no longer a new row
                    container
                        .removeAttr('data-rubric-criterion-new-row')
                        .attr('data-rubric-criterion-row', criterionId)
                        .data('rubric-criterion-row', criterionId);

                    input
                        .attr('name', 'crits['+groupId+'][items]['+criterionId+'][name]')
                        .removeAttr('data-rubric-criterion-new')
                        .removeData('rubric-criterion-new');

                    idInput.attr('name', 'crits['+groupId+'][items]['+criterionId+'][id]');

                    container.find('div.list-item').append("<div data-cs-container> <curriculum-selector :is-read-only=false :selected-nodes=[] data-endpoint='{{ routeLookup('curriculumApi.searchNode') }}' form-value-name='crits["+groupId+"][items]["+criterionId+"][curriculumCode][]' :include-children='true' /> </div>");

                    deleteButton.removeClass('hide');
                }

                if (addGroup) {
                    container.data('rubric-group-row', groupId);

                    // Clear all non-empty rows
                    newContainer.find('[data-rubric-criterion-row]').not('[data-rubric-criterion-new-row]').remove();

                    input
                        .attr('name', 'crits['+groupId+'][name]')
                        .removeAttr('data-rubric-group-new')
                        .removeData('rubric-group-new');

                    idInput.attr('name', 'crits['+groupId+'][id]');

                    {% if config.curriculum_tagging_enabled %}
                    container.find('div.list-item').first().append("<div data-cs-container> <curriculum-selector :is-read-only=false :selected-nodes=[] data-endpoint='{{ routeLookup('curriculumApi.searchNode') }}' form-value-name='crits["+groupId+"][curriculumCode][]' :include-children='true' /> </div>");
                    {% endif %}
                }
                {% if config.curriculum_tagging_enabled %}
                $('body').append("<script src=\"{{ CDN_PREFIX }}/js/bundle/curriculumSelector.js?v={{ config.site_version }}\"> <\/script>");
                {% endif %}
            }
        }
    };
    // Apply to both keyup and paste
    form.on('keyup', 'textarea', onCriterionUpdate);
    form.on('paste', 'textarea', onCriterionUpdate);

    // last-minute post-processing
    form.on('submit', function (e) {
        var $button = $("#manage-caps-submit");

        e.preventDefault();
        // reapply all indices to the indicator name attributes
        $('form[data-role=rubric-criteria-form]').find('fieldset').each(function () {
            var $capabilityFieldset = $(this);
            var $capabilityNameInput = $capabilityFieldset.find('textarea[name*="name"]');
            var capabilityFieldName = $capabilityNameInput.attr('name');

            // if this is a blank capability row, push it off the bottom of the list
            var capabilityId = -1;

            if (capabilityFieldName) {
                capabilityId = $capabilityNameInput.attr('name').split(/[\[\]]/)[1];
            }

            $capabilityFieldset.find('textarea[name*="items"]').each(function () {
                var $indicatorNameInput = $(this);

                $indicatorNameInput.attr('name',
                    $indicatorNameInput.attr('name').replace(/crits\[\d+]/, 'crits[' + capabilityId + ']')
                );
            });
        });


        // Set loading text on submit button
        var originalButtonText = $button.val();
        $button.attr("disabled", true);
        $button.val('Working...');

        // If we are re-submitting after having got an error the first time, hide the error message on submit
        // so it doesn't hang around after the user fixes the data
        $("#manage-caps-error").slideUp();

        $.post($(this).attr('action'), $(this).serialize(), null, 'json').done(function(response) {
            // If we have a ?returnUrl $_GET param, use it
            const urlParams = new URLSearchParams(window.location.search);
            const returnUrl = urlParams.get('returnUrl');
            if (returnUrl !== null) {
                window.location.href = atob(returnUrl);
            } else {
                // Otherwise, redirect to the homepage we came from
                window.location.href = response.redirect;
            }
        }).fail(function(response) {
            $button.val(originalButtonText);
            $button.removeAttr("disabled");
            $("#manage-caps-error").slideDown().html(response.responseJSON.detail);
        });

    });

    // logic for removing inputs
    form.find('[data-role="remove-criterion"]').click(function(e) {
        e.preventDefault();
        let self          = $(this),
            container     = self.closest('[data-rubric-criterion-row]'),
            name          = self.attr('data-rubric-criterion-name'),
            dialogContent = $('#criterion-remove-text');
        dialogContent.find('[data-rubric-criterion-name]').text(name);

        // Is this new? if so no dialog
        if (container.is('[data-rubric-unsaved]')) {
            container.remove();
        } else {
            self.confirmDialog({
                text: dialogContent.html(),
                format: 'html',
                confirmEvent: function() {
                    container.remove();
                }
            });
        }
    });

    $('[data-interaction="show-example-criteria"]').click(function(e) {
        e.preventDefault();
        $('[data-role="example-criteria"]').foundation('reveal', 'open');
    });
});
</script>
{% endautoescape %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ folder.name, '/homepage/' ~ folder.id ],
    [ 'Manage ' ~ locale.rubricGroup.properPlural ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>Manage Rubric {{ locale.rubricGroup.properPlural }} for {{ folder.name }}</h1>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <div class="alert-box">
            <p>
                {{ locale.rubricCriterion.properPlural }} are used as rows in a rubric.
                These may be added while creating your rubric or initially setup via this screen.
                {% if not allowModifyUsed %}
                If you want to delete any {{ locale.rubricCriterion }} that has already been used on {{ locale.dueWork.indefiniteArticle }} {{ locale.dueWork }},
                you need to first remove it from the {{ locale.dueWork }}, then you can delete it.
                {% endif %}
                If you remove all the {{ locale.rubricCriterion.plural}} from any {{ locale.rubricGroup }},
                the {{ locale.rubricGroup }} will automatically be deleted.
                <a href="#" data-interaction="show-example-criteria">See example {{ locale.rubricCriterion.plural }}</a>
            </p>
        </div>
    </div>
</div>

{% if curriculumTaggingEnabled %}
    {% set groupColumn = 'small-12 medium-6' %}
    {% set criterionColumn = 'small-12 medium-6' %}
{% else %}
    {% set groupColumn = 'small-12 medium-6' %}
    {% set criterionColumn = 'small-12 medium-6' %}
{% endif %}

<div class="row">
    <div class="small-12 island">
        <form action="{{ routeLookup('rubricManager.postForm', {folderId: folder.id}) }}" method="POST" class='top' data-role="rubric-criteria-form">
            <section>
                {#
                <!-- Cascade isn't supported, but if it is: -->
                <fieldset class='content'>
                    <div class="small-12 columns">
                        <input type="hidden" name="cascade" value="0" />
                        <input id="cascade" type="checkbox" name="cascade" value="1" />
                        <label for="cascade" class="checkbox-label">
                            Copy to subfolders?
                            <span class="hint has-tip"
                                  data-tooltip
                                  title="Should these {{ locale.rubricCriterion.plural }} be copied to this folder's subfolders?">?</span>
                        </label>
                    </div>
                </fieldset>
                #}

                {% for group in rowSet.capabilities %}
                    <fieldset class='content' data-rubric-group-row="{{ group.id }}">
                        <div class="{{ groupColumn }} columns">
                            <h3>
                                {{ locale.rubricGroup.proper }}
                                {% if group.courseLevel %}(Course-level){% endif %}
                            </h3>
                            <ul class="information-list">
                                {% include '@rubricManager/sub/group.twig' with {
                                    group:                    group,
                                    allowModifyUsed:          allowModifyUsed,
                                    curriculumTaggingEnabled: curriculumTaggingEnabled,
                                } only %}
                            </ul>
                        </div>

                        <div class="{{ criterionColumn }} columns">
                            <h3>{{ locale.rubricCriterion.properPlural }}</h3>
                            <ul class="information-list">

                                {% for criterion in group.indicators %}
                                    {% include '@rubricManager/sub/criterion.twig' with {
                                        group:                    group,
                                        criterion:                criterion,
                                        allowModifyUsed:          allowModifyUsed,
                                        curriculumTaggingEnabled: curriculumTaggingEnabled,
                                    } only %}
                                {% endfor %}

                                {# New criterion within group #}
                                {% include '@rubricManager/sub/criterion.twig' with {
                                    group:                    group,
                                    criterion:                null,
                                    allowModifyUsed:          allowModifyUsed,
                                    curriculumTaggingEnabled: curriculumTaggingEnabled,
                                } only %}
                            </ul>
                        </div>
                    </fieldset>
                {% endfor %}

                {# New group #}
                <fieldset class='content' data-rubric-group-row="{{ maxGroupId }}">
                    <div class="{{ groupColumn }} columns">
                        <h3>{{ locale.rubricGroup.proper }}</h3>
                        <ul class="information-list">
                            {% include '@rubricManager/sub/group.twig' with {
                                group:                    null,
                                allowModifyUsed:          allowModifyUsed,
                                curriculumTaggingEnabled: curriculumTaggingEnabled,
                            } only %}
                        </ul>
                    </div>
                    <div class="{{ criterionColumn }} columns">
                        <h3>{{ locale.rubricCriterion.properPlural }}</h3>
                        <ul class="information-list">
                            {# New criterion within new group #}
                            {% include '@rubricManager/sub/criterion.twig' with {
                                group:                    null,
                                criterion:                null,
                                allowModifyUsed:          allowModifyUsed,
                                curriculumTaggingEnabled: curriculumTaggingEnabled,
                            } only %}
                        </ul>
                    </div>
                </fieldset>
            </section>

            <div id="manage-caps-error" style="display: none" data-alert="" class="alert-box alert">
            </div>

            <div class="row">
                <div class="small-12 columns">
                    <input id="manage-caps-submit" type="submit" value="Save Changes" />
                </div>
            </div>
        </form>
    </div>
</div>

