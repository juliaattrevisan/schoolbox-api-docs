{##
 # Params:
 # * group:                    If null, this is an input for a new group
 # * allowModifyUsed:          If true, the group name is never readonly even if it's in use.
 # * curriculumTaggingEnabled: Are curriculum code inputs shown?
 #}

{% set readonly  = not allowModifyUsed and group is not null and group.usage|length > 0 %}
{% set new       = group is null %}
{% set groupId   = new ? 0 : group.id %}
{% set maxCapabilityLength = 900 %}
{# maxCapabilityLength is 900, due to the way browsers look at maxlength as character lenght, but mysql table looks at char byte lenght
so if there are bullet points in the textbox they count as 3 characters, and will cause issues, so lets work on 900 as the limit, and we shouldn't hit the db max...#}
<li class="actions-small-0">
    <div class="list-item">
        {# Hidden input for group ID #}
        <input type="hidden"
               data-template="rubric-group-id"
               {% if group %}name="crits[{{ groupId }}][id]"{% endif %}
               value="{{ groupId }}"
               {% if readonly %}readonly{% endif %}
        />

        {# Input for group name #}
        <textarea rows="3"
               {% if new %}data-rubric-group-new="1"{% endif %}
               data-rubric-group
               data-template="rubric-group-name"
               {% if group %}name="crits[{{ group.id }}][name]"{% endif %}
               {% if readonly > 0 %}readonly{% endif %}
               maxlength="{{ maxCapabilityLength }}"
        />{{ group.name ?? '' }}</textarea>

        {# Input for group curriculum codes #}
        {% if curriculumTaggingEnabled %}
            {% if courseManagedReadonly is not defined %}
                {% set courseManagedReadonly = false %}
            {% endif %}
            {% set codeList = [] %}
            {% if group is not null %}
                {% set codeList = group.curriculumNodes %}
            {% endif %}
            <div data-cs-container>
                <curriculum-selector
                        :is-read-only="{{ courseManagedReadonly ? 'true' : 'false' }}"
                        :selected-codes="{{ codeList|json_encode }}"
                        data-endpoint="{{ routeLookup('curriculumApi.getTree') }}"
                        {% if group %}form-value-name="crits[{{ group.id }}][curriculumCode][]"{% endif %}
                />

            </div>
        {% endif %}
    </div>

    <nav></nav>
</li>
