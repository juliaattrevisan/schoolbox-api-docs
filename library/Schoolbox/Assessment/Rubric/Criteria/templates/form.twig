{% autoescape 'js' %}
<script type="text/javascript">
$(function() {

    var form           = $('form[data-role="rubric-criteria-form"]');
    var groupMaxId     = Number('{{ maxGroupId }}');
    var criterionMaxId = Number('{{ maxCritId }}');

    // If there are no dropdowns at all on initial load; they must be reapplied
    // If there are any; they must not be reapplied. Go figure
    var hasDropdowns = form.find('[data-dropdown]').length > 0;

    // logic for adding new inputs
    var onCriterionUpdate = function() {
        if (this.value.length > 0) {
            var input        = $(this);
            var container    = [];
            var groupId      = 0;
            var criterionId  = 0;
            var addGroup     = false;
            var addCriterion = false;
            if (input.data('rubric-criterion-new')) {
                // New criterion?
                // Set the criterion ID of this row
                container    = input.closest('[data-rubric-criterion-row]');
                groupId      = input.closest('[data-rubric-group-row]').data('rubric-group-row');
                criterionId  = criterionMaxId++;
                addCriterion = true;
            } else if (input.data('rubric-group-new')) {
                // New group?
                // Set the group ID of this row
                container   = input.closest('[data-rubric-group-row]');
                groupId     = groupMaxId++;
                criterionId = criterionMaxId++;
                addGroup    = true;
            }
            if (container.length) {
                var newContainer = container.clone(true, true);
                newContainer.find('input').val('');
                newContainer.find('[data-rubric-criterion]').attr('data-rubric-criterion-new', true);
                input.attr('placeholder', 'Add {{ locale.rubricCriterion.proper }}...');

                newContainer.appendTo(container.parent());

                // Update the new form input - make it no longer new
                if (addCriterion) {
                    // This is no longer a new row
                    container.removeAttr('data-rubric-criterion-new-row');
                    container
                        .attr('data-rubric-criterion-row', criterionId)
                        .data('rubric-criterion-row', criterionId)
                    ;

                    // Show and setup dropdown
                    var newDropdownId = 'dropdown-i' + String(criterionId);
                    container.find('[data-dropdown-dormant]')
                        .removeAttr('data-dropdown-dormant')
                        .removeClass('hide disabled')
                        .removeAttr('aria-disabled')
                        .attr('data-dropdown', newDropdownId);
                    container.find('[data-dropdown-content-dormant]')
                        .removeAttr('data-dropdown-content-dormant')
                        .attr('data-dropdown-content', '')
                        .attr('id', newDropdownId);

                    // and reapply if required
                    if (!hasDropdowns) {
                        container.foundation('dropdown', 'reflow');
                    }

                    input
                        .attr('name', 'crits['+groupId+'][items][i'+criterionId+']')
                        .removeAttr('data-rubric-criterion-new')
                        .removeData('rubric-criterion-new')
                    ;
                }
                if (addGroup) {
                    container.data('rubric-group-row', groupId);
                    // Clear all non-empty rows
                    newContainer.find('[data-rubric-criterion-row]').not('[data-rubric-criterion-new-row]').remove();
                    input
                        .attr('name', 'crits['+groupId+'][name]')
                        .removeAttr('data-rubric-group-new')
                        .removeData('rubric-group-new')
                    ;
                }
            }
        }
    };
    // Apply to both keyup and paste
    form.on('keyup', 'input', onCriterionUpdate);
    form.on('paste', 'input', onCriterionUpdate);

    // last-minute post-processing
    form.on('submit', function (e) {

        // reapply all indices to the indicator name attributes
        $('form[data-role=rubric-criteria-form]').find('fieldset').each(function () {

            var $capabilityFieldset = $(this);
            var $capabilityNameInput = $capabilityFieldset.find('input[name*="name"]');

            var capabilityFieldName = $capabilityNameInput.attr('name');

            // if this is a blank capability row, push it off the bottom of the list
            var capabilityId = -1;
            if (capabilityFieldName) {
                capabilityId = $capabilityNameInput.attr('name').split(/[\[\]]/)[1];
            }

            $capabilityFieldset.find('input[name*="items"]').each(function () {

                var $indicatorNameInput = $(this);

                $indicatorNameInput.attr('name',
                    $indicatorNameInput.attr('name').replace(/crits\[\d+]/, 'crits[' + capabilityId + ']')
                );
            });
        });
    });

    // logic for removing inputs
    form.find('[data-role="remove-criterion"]').click(function(e) {
        e.preventDefault();
        var self      = $(this);
        var container = self.closest('[data-rubric-criterion-row]');

        // Is this new? if so no dialog
        if (container.is('[data-rubric-unsaved]')) {
            container.remove();
        } else {
            self.confirmDialog({
                text: $('#criterion-remove-text').text(),
                confirmEvent: function() {
                    container.remove();
                }
            });
        }
    });

    $('[data-interaction="show-example-criteria"]').click(function(e) {
        e.preventDefault();
        $('[data-role="example-criteria"]').foundation('reveal', 'open');
    });
});
</script>
{% endautoescape %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ folder.name, '/homepage/' ~ folder.id ],
    [ 'Manage ' ~ locale.rubricGroup.properPlural ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>Manage Rubric {{ locale.rubricGroup.properPlural }} for {{ folder.name }}</h1>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <div class="alert-box">
            <p>
                {{ locale.rubricCriterion.properPlural }} are used as rows in a rubric.
                These may be added while creating your rubric or initially setup via this screen.
                If you want to delete any {{ locale.rubricCriterion }} that has already been used on an {{ locale.assessment }},
                you need to first remove it from the {{ locale.assessment }}, then you can delete it.
                If you remove all the {{ locale.rubricCriterion.plural}} from any {{ locale.rubricGroup }},
                the {{ locale.rubricGroup }} will automatically be deleted.
                <a href="#" data-interaction="show-example-criteria">See example {{ locale.rubricCriterion.plural }}</a>
            </p>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <form action="{{ routeLookup('rubricCriteria.postForm', {folderId: folder.id}) }}" method="POST" class='top' data-role="rubric-criteria-form">
            <section>
                {#
                <!-- Cascade isn't supported, but if it is: -->
                <fieldset class='content'>
                    <div class="small-12 columns">
                        <input type="hidden" name="cascade" value="0" />
                        <input id="cascade" type="checkbox" name="cascade" value="1" />
                        <label for="cascade" class="checkbox-label">
                            Copy to subfolders?
                            <span class="hint has-tip"
                                  data-tooltip
                                  title="Should these {{ locale.rubricCriterion.plural }} be copied to this folder's subfolders?">?</span>
                        </label>
                    </div>
                </fieldset>
                #}

                {% for group in groups %}
                    {% set groupCount = loop.index0 %}
                    <fieldset class='content' data-rubric-group-row="{{ groupCount }}">
                        <div class="small-12 medium-6 columns">
                            <h3>{{ locale.rubricGroup.proper }}</h3>
                            <ul class="information-list">
                                <li class="actions-small-0">
                                    <div class="list-item">
                                        <input type="hidden"
                                               name="crits[{{ groupCount }}][id]"
                                               value="{{ group.group.id }}"
                                               {% if group.usageTotal > 0 %}readonly{% endif %} />
                                        <input type="text"
                                               name="crits[{{ groupCount }}][name]"
                                               value="{{ group.group.name }}"
                                               {% if group.usageTotal > 0 %}readonly{% endif %}
                                               data-rubric-group />
                                    </div>
                                    <nav></nav>
                                </li>
                            </ul>
                        </div>

                        <div class="small-12 medium-6 columns">
                            <h3>{{ locale.rubricCriterion.properPlural }}</h3>
                            <ul class="information-list">

                                {% for criterion in group.criteria %}
                                    {% set criterionInUse = criterion.usage|length > 0 %}
                                    <li class="actions-small-1" data-rubric-criterion-row="{{ groupCount }}">
                                        <div class="list-item">
                                            <input type="text"
                                                   name="crits[{{ groupCount }}][items][i{{ criterion.criterion.id }}]"
                                                   value="{{ criterion.criterion.name }}"
                                                   id="i{{ criterion.criterion.id }}"
                                                   {% if criterionInUse %}readonly{% endif %}
                                                   data-rubric-criterion />
                                        </div>
                                        <nav>
                                            {% if criterionInUse %}
                                                <a class="icon-info"
                                                   data-reveal-id="criterion-{{ criterion.criterion.id }}"
                                                   href="#"
                                                   title="Show {{ locale.assessment.plural }} using {{ locale.rubricCriterion }}"></a>
                                            {% else %}
                                                <a class="icon-more"
                                                   data-dropdown="dropdown-i{{ criterion.criterion.id }}"
                                                   href="#"
                                                   title="Actions"></a>
                                            {% endif %}
                                        </nav>

                                        {% if criterionInUse %}
                                            {% set criterionUsageCount = criterion.usage|length %}
                                            <div data-reveal id="criterion-{{ criterion.criterion.id }}" class="reveal-modal">
                                                <article>
                                                    <h2>{{ criterion.criterion.name }}</h2>
                                                    <p>{{ locale.rubricCriterion.proper }} is in use on {{ criterionUsageCount}}
                                                        {{ criterionUsageCount > 1 ? locale.assessment.plural : locale.assessment }};
                                                    </p>
                                                    <ul>
                                                        {% for assessment in criterion.usage %}
                                                        <li><a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id}) }}">{{ assessment.title }}</a></li>
                                                        {% endfor %}
                                                    </ul>
                                                </article>
                                                <a class="close-reveal-modal" aria-label="Close">&#215;</a>
                                            </div>
                                        {% else %}
                                            <ul id="dropdown-i{{ criterion.criterion.id }}" class="f-dropdown" data-dropdown-content="">
                                                <li>
                                                    <a class="icon-delete"
                                                       data-role="remove-criterion"
                                                       href="#">Delete {{ locale.rubricCriterion.proper }}</a>
                                                </li>
                                            </ul>
                                        {% endif %}

                                    </li>
                                {% endfor %}

                                {# New criterion within group #}
                                <li class="actions-small-1" data-rubric-unsaved data-rubric-criterion-new-row data-rubric-criterion-row="{{ groupCount }}">
                                    <div class="list-item">
                                        <input type="text"
                                               value=""
                                               data-rubric-criterion
                                               data-rubric-criterion-new="1"
                                               placeholder="Add {{ locale.rubricCriterion.proper }} to {{ group.group.name }}..." />
                                    </div>
                                    <nav>
                                        <a href="#" class="icon-more hide" data-dropdown-dormant title="Actions"></a>
                                    </nav>
                                    <ul class="f-dropdown" data-dropdown-content-dormant>
                                        <li>
                                            <a class="icon-delete"
                                               data-role="remove-criterion"
                                               href="#">Delete {{ locale.rubricCriterion.proper }}</a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </fieldset>
                {% endfor %}

                {# New group #}
                <fieldset class='content' data-rubric-group-row="{{ maxGroupId }}">
                    <div class="small-12 medium-6 columns">
                        <h3>{{ locale.rubricGroup.proper }}</h3>
                        <ul class="information-list">
                            <li class="actions-small-0">
                                <div class="list-item">
                                    <input type="text"
                                           value=""
                                           data-rubric-group
                                           data-rubric-group-new="1"
                                           placeholder="Add {{ locale.rubricGroup.proper }}..." />
                                </div>
                                <nav></nav>
                            </li>
                        </ul>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <h3>{{ locale.rubricCriterion.properPlural }}</h3>
                        <ul class="information-list">
                            <li class="actions-small-1" data-rubric-unsaved data-rubric-criterion-new-row data-rubric-criterion-row="{{ groupCount }}">
                                <div class="list-item">
                                    <input type="text"
                                           value=""
                                           data-rubric-criterion
                                           data-rubric-criterion-new="1"
                                           placeholder="Add {{ locale.rubricCriterion.proper }}..." />
                                </div>
                                <nav>
                                    <a href="#" class="icon-more hide" data-dropdown-dormant title="Actions"></a>
                                </nav>
                                <ul class="f-dropdown" data-dropdown-content-dormant>
                                    <li>
                                        <a class="icon-delete"
                                           data-role="remove-criterion"
                                           href="#">Delete {{ locale.rubricCriterion.proper }}</a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </fieldset>
            </section>

            <div class="row">
                <div class="small-12 columns">
                    <input type="submit" value="Save Changes" />
                </div>
            </div>
        </form>
    </div>
</div>

<div data-role="example-criteria" class="reveal-modal" data-reveal>
    <p>
        Each {{ locale.rubricCriterion }} should be a word or short sentence that describes what is being assessed,
        organised into logical groupings.
    </p>

    <div class="row">
        <div class="small-12 island">
            <section>
                <fieldset class="content">
                    <div class="small-12 medium-6 columns">
                        <h3>{{ locale.rubricGroup.proper }}</h3>
                        <ul class="information-list">
                            <li class="actions-small-0">
                                <div class="list-item">
                                    <input readonly type="text" value="Algebra" />
                                </div>
                                <nav></nav>
                            </li>
                        </ul>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <h3>{{ locale.rubricCriterion.properPlural }}</h3>
                        <ul class="information-list">
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <input readonly type="text" value="Factorisation" />
                                </div>
                                <nav>
                                    <a class="icon-info"
                                       href="#"
                                       title="Show {{ locale.assessment.plural }} using {{ locale.rubricCriterion }}"></a>
                                </nav>
                            </li>
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <input readonly type="text" value="Algebraic simplification using index laws" />
                                </div>
                                <nav>
                                    <a class="icon-info"
                                       href="#"
                                       title="Show {{ locale.assessment.plural }} using {{ locale.rubricCriterion }}"></a>
                                </nav>
                            </li>
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <input readonly type="text" value="Fraction operations" />
                                </div>
                                <nav>
                                    <a class="icon-info"
                                       href="#"
                                       title="Show {{ locale.assessment.plural }} using {{ locale.rubricCriterion }}"></a>
                                </nav>
                            </li>
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <input readonly type="text" value="Determining an unknown by substitution" />
                                </div>
                                <nav>
                                    <a class="icon-info"
                                       href="#"
                                       title="Show {{ locale.assessment.plural }} using {{ locale.rubricCriterion }}"></a>
                                </nav>
                            </li>
                        </ul>
                    </div>
                </fieldset>

                <fieldset>
                    <div class="small-12 medium-6 columns">
                        <h3>{{ locale.rubricGroup.proper }}</h3>
                        <ul class="information-list">
                            <li class="action-small-0">
                                <div class="list-item">
                                    <input readonly type="text" value="Linear and non-linear relations" />
                                </div>
                                <nav></nav>
                            </li>
                        </ul>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <h3>{{ locale.rubricCriterion.properPlural }}</h3>

                        <ul class="information-list">
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <input readonly type="text" value="Solving linear equations" />
                                </div>
                                <nav>
                                    <a class="icon-info"
                                       href="#"
                                       title="Show {{ locale.assessment.plural }} using {{ locale.rubricCriterion }}"></a>
                                </nav>
                            </li>
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <input readonly type="text" value="Solving simultaneous equations" />
                                </div>
                                <nav>
                                    <a class="icon-info"
                                       href="#"
                                       title="Show {{ locale.assessment.plural }} using {{ locale.rubricCriterion }}"></a>
                                </nav>
                            </li>
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <input readonly type="text" value="Solving simple quadratic equations" />
                                </div>
                                <nav>
                                    <a class="icon-info"
                                       href="#"
                                       title="Show {{ locale.assessment.plural }} using {{ locale.rubricCriterion }}"></a>
                                </nav>
                            </li>
                        </ul>
                    </div>
                </fieldset>
            </section>
        </div>
    </div>

    <a href="#" class="close-reveal-modal">&#215;</a>
</div>

<div data-role="ajax-error" class="reveal-modal" data-reveal>
    <div class="alert-box alert">
        <h5>Something went wrong while saving</h5>
        <p>You may try pressing the "Save Changes" button. If this persists, please contact your IT support.</p>
    </div>
</div>

<!-- Hidden text for remove criterion -->
<div class="hide" id="criterion-remove-text">
    If you remove this {{ locale.rubricCriterion }}, it will not be available to add to future {{ locale.assessment.plural }}.
    Are you sure you want to do this?
    (Make sure you click save at the end of this form to save all changes you have made.)
</div>
