{##
 # Params:
 # * group:      If null, this is an input for a new group
 # * usage:      Assessments that use the group
 # * groupCount: The number of the group, used only for array keys.
 #               If null, no name is output.
 #}

{% set showNames = groupCount is not null %}
{% set readonly  = group is not null and usage|length > 0 %}
{% set new       = group is null %}
<li class="actions-small-0">
    <div class="list-item">
        {# Hidden input for group ID #}
        <input type="hidden"
               data-template="rubric-group-id"
               {% if showNames %}name="crits[{{ groupCount }}][id]"{% endif %}
               value="{{ group.id }}"
               {% if readonly %}readonly{% endif %}
        />

        {# Input for group name #}
        <input type="text"
               {% if new %}data-rubric-group-new="1"{% endif %}
               data-rubric-group
               data-template="rubric-group-name"
               {% if showNames %}name="crits[{{ groupCount }}][name]"{% endif %}
               value="{{ group.name }}"
               {% if readonly > 0 %}readonly{% endif %}
        />

        {# Input for group curriculum codes #}
        <select data-curriculum-code-selector
                data-template="rubric-group-curriculum-codes"
                {% if showNames %}name="crits[{{ groupCount }}][curriculumCode][]"{% endif %}
                multiple
                {% if new %}class="hide"{% endif %}
        >
            {% for code in group.curriculumNodes %}
                <option label="{{ code.code }}"
                        value="{{ code.id }}"
                        title="{{ code.description }}"
                        data-value-object="{{ code|json_encode }}"
                        selected
                >{{ code.code }}</option>
            {% endfor %}
        </select>
    </div>

    <nav></nav>
</li>
