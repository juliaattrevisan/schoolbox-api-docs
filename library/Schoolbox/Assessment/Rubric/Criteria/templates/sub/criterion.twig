{##
 # Params:
 # * criterion: if null this is an input for a new criterion
 # * usage:     assessments used
 #}

{% set criterionInUse = criterion.usage|length > 0 %}
<li class="actions-small-1" data-rubric-criterion-row="{{ groupCount }}">
    <div class="list-item">
        <input type="hidden"
               name="crits[{{ groupCount }}][items][{{ criterion.id }}][id]"
               value="i{{ criterion.id }}"
               {% if criterionInUse %}readonly{% endif %} />
        <input type="text"
               name="crits[{{ groupCount }}][items][{{ criterion.id }}][name]"
               value="{{ criterion.name }}"
               id="i{{ criterion.id }}"
               {% if criterionInUse %}readonly{% endif %}
               data-rubric-criterion />

        {# Input for curriculum code #}
        <select data-curriculum-code-selector
                name="crits[{{ groupCount }}][items][{{ criterion.id }}][curriculumCode][]"
                multiple>
            {% for code in criterion.curriculumNodes %}
                <option label="{{ code.code }}"
                        value="{{ code.id }}"
                        title="{{ code.description }}"
                        data-value-object="{{ code|json_encode }}"
                        selected
                >{{ code.code }}</option>
            {% endfor %}
        </select>
    </div>
    <nav>
        {% if criterionInUse %}
            <a class="icon-info"
               data-reveal-id="criterion-{{ criterion.id }}"
               href="#"
               title="Show {{ locale.assessment.plural }} using {{ locale.rubricCriterion }}"></a>
        {% else %}
            <a class="icon-more"
               data-dropdown="dropdown-i{{ criterion.id }}"
               href="#"
               title="Actions"></a>
        {% endif %}
    </nav>

    {% if criterionInUse %}
        {% set criterionUsageCount = criterion.usage|length %}
        <div data-reveal id="criterion-{{ criterion.id }}" class="reveal-modal">
            <article>
                <h2>{{ criterion.name }}</h2>
                <p>{{ locale.rubricCriterion.proper }} is in use on {{ criterionUsageCount}}
                    {{ criterionUsageCount > 1 ? locale.assessment.plural : locale.assessment }};
                </p>
                <ul>
                    {% for assessment in criterion.usage %}
                        <li><a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id}) }}">{{ assessment.title }}</a></li>
                    {% endfor %}
                </ul>
            </article>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </div>
    {% else %}
        <ul id="dropdown-i{{ criterion.id }}" class="f-dropdown" data-dropdown-content="">
            <li>
                <a class="icon-delete"
                   data-role="remove-criterion"
                   href="#">Delete {{ locale.rubricCriterion.proper }}</a>
            </li>
        </ul>
    {% endif %}
</li>
