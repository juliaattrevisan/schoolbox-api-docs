{##
 # Configure a Dialog Agent's settings
 #
 # @param Assessment\DialogAgent\Model                 An assessment instance
 # @param \Schoolbox\Admin\DialogAgent\Scenario\Model  A Scenario instance with its corresponding fields
 # @param array $helpfulness                           A list of key-value pairs for Helpfulness options
 # @param array $language                              A list of key-value pairs for Langauge options
 #}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row">
    <div class="small-12 columns">
        <h1>Configure {{ assessment.title }}</h1>
    </div>
</div>

<div class="row">
     <div class="small-12 large-6 island">
         <h2 class="subheader">Settings</h2>
         {% set updateRoute = routeLookupIfAuthorized('learningDialogAgent.postUpdate', {assessmentId: assessment.id, assessment: assessment}) %}

         <form method="post" action="{{ updateRoute }}">
             <section>
                 <fieldset class="content">
                     <div class="small-12 columns">
                         <h3>{{ scenario.title }}</h3>

                         <article>
                             {{ scenario.description }}
                         </article>
                     </div>
                 </fieldset>
                 <fieldset class="content">
                     <div class="small-12 large-6 columns">
                         <label for="helpfulness">
                             <span class="required-with-tip">Helpfulness</span>
                             <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Helpfulness setting.">?</span>
                         </label>
                         <select id="helpfulness" name="helpfulness">
                             {% for value, name in helpfulness %}
                                 {% set selected = '' %}

                                 {% if value == assessment.helpfulness %}
                                     {% set selected = 'selected' %}
                                 {% endif %}

                                 <option value="{{ value }}" {{ selected }}>{{ name }}</option>
                             {% endfor %}
                         </select>
                     </div>

                     <div class="small-12 large-6 columns">
                         <label for="language">
                             <span class="required-with-tip">Language</span>
                             <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Langauge setting.">?</span>
                         </label>

                         <select id="language" name="language">
                             {% for value, name in language %}
                                 {% set selected = '' %}

                                 {% if value == assessment.language %}
                                    {% set selected = 'selected' %}
                                 {% endif %}

                                 <option value="{{ value }}" {{ selected }}>{{ name }}</option>
                             {% endfor %}
                         </select>
                     </div>

                     <div class="small-12 columns">
                         <label for="differentiation-profile">
                             Use learner's differentiation profile to provide agent context? <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Enable this to use learner's differentiation profile to provide agent context.">?</span>
                         </label>
                         <div class="switch">
                             {% set checked = '' %}

                             {% if assessment.useDifferentiationProfile %}
                                {% set checked="checked" %}
                             {% endif %}

                             <input id="differentiation-profile" name="useDifferentiationProfile" type="checkbox" {{ checked }}>
                             <label for="differentiation-profile">
                                 <span class="icon-approve"></span>
                                 <span class="icon-cancel"></span>
                             </label>
                         </div>
                     </div>

                     <div class="small-12 columns">
                         <label for="opening-message" class="required">Opening Message</label>
                         <textarea id="opening-message" name="openingMessage" style="width:100%;height:100px;" class="required">{{ assessment.openingMessage }}</textarea>
                     </div>

                     <div class="small-12 columns">
                         <label for="rules" class="required">Rules</label>
                         <textarea id="rules" name="rules" style="width:100%;height:100px;" class="required">{{ assessment.rules }}</textarea>
                     </div>
                 </fieldset>
                 <fieldset class="content">
                     {% for fieldContext in fieldContexts %}
                     <div class="small-12 columns">
                         <label for="field-{{ fieldContext.scenarioField.id }}" class="required">{{ fieldContext.scenarioField.title }}</label>
                         <textarea id="fieldcontext-{{ fieldContext.id }}" name="fieldContexts[{{ fieldContext.id }}]" style="width:100%;height:100px;" class="required">{{ fieldContext.body }}</textarea>
                     </div>
                     {% endfor %}
                 </fieldset>
             </section>

             <input type="submit" value="Save" />
         </form>
    </div>
    <div class="small-12 large-6 island">
        <h2 class="subheader">Sandbox</h2>
        <section class="content">
            chat log thingo goes here
        </section>
    </div>
</div>
