{% import 'sub/breadcrumbs.twig' as bread %}

{% set assessments = markbook.assessments %}

{% set classFeedbackRequired = 'notmarked' %}
{% set classFailed           = 'fail' %}
{% set classMastered         = 'mastered' %}

<script type="text/javascript" src="/javascript/shared/submissions/jquery.marksheet.js"></script>
<script type="text/javascript" src="/javascript/shared/submissions/task/jquery.progressTickForm.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.ajax-form.js"></script>

{# Crumbz: Class > Mastery#}
{{ bread.crumbs(
[class.title, '/homepage/'~class.id],
['Mastery Report', '#']) }}

<div class="row">
    <div class="small-12 column">
        <h1>{{ class.title }} Mastery Report</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="context-switch">
            {% include '@learningMastery/fragments/markbookSelector.twig' with {
                class:        class,
                terms:        terms,
                currentTerm:  currentTerm,
                previousTerm: previousTerm,
                nextTerm:     nextTerm
            } %}
        </div>
    </div>
</div>

<style>
    .{{ classFailed }} {
        background-color: rgb(247, 206, 204);
    }
    .{{ classMastered }} {
        background-color: rgb(213, 231, 212);
    }
    .{{ classFeedbackRequired }} {
        background-color: rgb(255, 242, 205);
    }
</style>


<div class="row">
    <div class="small-12 island">
        {% if assessments | length %}
            <div class="scrollable">
                <table>
                    <thead>
                    <tr class="rotate-headers">
                        <th></th>
                        {% for assessment in assessments %}
                            <th>
                                <div>
                                <span>
                                    <a href="{{ routeLookup('learningAssessment.getAssessment', {assessmentId: assessment.id}) }}">{{ assessment.title }}</a><br>
                                    <span class="meta">{{ assessment.typeName }}</span>
                                </span>
                                </div>
                            </th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td></td>
                        {% for assessment in assessments %}
                            <td class="text-center">
                                {% if assessment.dueAt.isPast %}
                                    <i class="icon-clock" title="Past Due Date {{ assessment.dueAt.localShort }}"></i>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                    {% for student in markbook.students %}
                        <tr data-id="{{ student.id }}">
                            <th class="no-pad">
                                <div class="compact card no-pad small-12">
                                    <a href="/search/user/{{ student.id }}" title="View Profile">
                                        <img src="/portrait.php?userId={{ student.externalId }}&size=square32" alt="View Profile"/>
                                        <p>{{ student.lastname }}, {{ student.firstname }}</p>
                                    </a>
                                </div>
                            </th>

                            {# For each student, treat the first assessment found which requires a response as the 'upcoming' assessment #}
                            {% set nextUpcomingFound = false %}

                            {% for assessment in assessments %}

                                {# Is this assessment the first assessment encountered for this student that requires a response ? #}
                                {% set isNextUpcoming = false %}

                                {# is student a participant ? #}
                                {% if assessment.isParticipant(student) %}

                                    {% set participant      = assessment.getParticipant(student) %}
                                    {% set humanMark        = assessment.getHumanReadableMark(student, true) %}
                                    {% set normalisedMark   = assessment.getNormalisedMark(student, true) %}

                                    {% set responseRequired = participant.responseRequired %}
                                    {% set feedbackRequired = participant.feedbackRequired %}
                                    {% set reviewComplete   = participant.reviewComplete %}

                                    {# Have we not encountered an assessment that requires a response yet, and this assessment requires a resposne ? #}
                                    {% if not nextUpcomingFound and responseRequired and not assessment.dueAt.isPast %}
                                        {% if not (assessment is task and participant.hasMark) %}
                                            {% set isNextUpcoming = true %}
                                        {% endif %}
                                        {% set nextUpcomingFound = true %}
                                    {% endif %}

                                    {# Determine background color #}
                                    {% if feedbackRequired %}
                                        {% set colorClass = classFeedbackRequired %}
                                    {% else %}
                                        {% if assessment is task %}
                                            {% set mostRecentResponse = participant.findMostRecentResponse %}
                                            {% if mostRecentResponse and not mostRecentResponse.isSelfAssessed %}
                                                {% set colorClass = mostRecentResponse.markedComplete ? classMastered : classFailed %}
                                            {% else %}
                                                {% set colorClass = '' %}
                                            {% endif %}
                                        {% else %}
                                            {% if not normalisedMark is null %}
                                                {% set colorClass = normalisedMark >= 70 ? classMastered : classFailed %}
                                            {% else %}
                                                {% set colorClass = '' %}
                                            {% endif %}
                                        {% endif %}
                                    {% endif %}

                                    {# Determine title #}
                                    {% if responseRequired and not assessment is task %}
                                        {% set title = 'Response Required.' %}
                                        {% if assessment.dueAt.isPast %}
                                            {% set title = title ~ ' Past Due Date.' %}
                                        {% endif %}
                                    {% elseif feedbackRequired %}
                                        {% set title = 'Awaiting Teacher Assessment' %}
                                    {% elseif isNextUpcoming %}
                                        {% set title = 'Next Assessment' %}
                                    {% else %}
                                        {% if assessment is task %}
                                            {% set title = participant.publishedHumanReadableMark %}
                                        {% else %}
                                            {% set title = normalisedMark | round ~ ' %' %}
                                        {% endif %}
                                    {% endif %}

                                    {# Determine text #}
                                    {% if participant.hasMark and not humanMark is null %}
                                        {% if assessment is task %}
                                            {% set text = participant.findMostRecentResponse.markedComplete ? 'Complete' : 'Incomplete' %}
                                        {% else %}
                                            {% set text = humanMark %}
                                        {% endif %}
                                    {% elseif feedbackRequired %}
                                        {% set text = '<i class="icon-pause">' %}
                                    {% elseif isNextUpcoming %}
                                        {% set text = '<i class="icon-eye">' %}
                                    {% elseif assessment.dueAt.isPast %}
                                        {% set text = '<i class="icon-close">' %}
                                    {% else %}
                                        {% set text = '-' %}
                                    {% endif %}

                                    {# Determine URL #}
                                    {% if feedbackRequired or isNextUpcoming %}
                                        {% if isNextUpcoming or not assessment is dueWork %}
                                            {% set url = routeLookupIfAuthorized('learningAssessment.getSummary', {
                                                assessmentId: assessment.id,
                                                assessment: assessment,
                                                studentId: student.id,
                                                student: student
                                            }) %}
                                        {% else  %}
                                            {% set url = routeLookupIfAuthorized('learningResponse.getParticularResponse', {
                                                assessmentId: assessment.id,
                                                assessment: assessment,
                                                studentId: student.id,
                                                student: student
                                            }) %}
                                        {% endif %}
                                    {% else %}
                                        {% set url = '' %}
                                    {% endif %}

                                {% else %}

                                    {% set colorClass     = '' %}
                                    {% set humanMark      = null %}
                                    {% set normalisedMark = null %}
                                    {% set title          = student.fullName ~ ' is not a participant of ' ~ assessment.title %}
                                    {% set text           = '–' %}
                                    {% set url            = '' %}

                                {% endif %}

                                <td class="text-center {{ colorClass }}" title="{{ title }}">
                                    {% if url %}<a href="{{ url }}">{% endif %}
                                        {{ text | purify }}
                                    {% if url %}</a>{% endif %}
                                </td>

                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

        {% else %}

            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>No results available this semester.</p>
            </div>

        {% endif %}
    </div>
</div>
