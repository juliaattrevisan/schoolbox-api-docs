{% import 'sub/breadcrumbs.twig' as bread %}

{% set classFeedbackRequired = 'notmarked' %}
{% set classFailed           = 'fail' %}
{% set classMastered         = 'mastered' %}

<script type="text/javascript" src="/javascript/shared/submissions/jquery.marksheet.js"></script>
<script type="text/javascript" src="/javascript/shared/submissions/task/jquery.progressTickForm.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.ajax-form.js"></script>

{# Crumbz: Class > Mastery#}
{{ bread.crumbs(
[class.title, '/homepage/'~class.id],
['Mastery Report', '#']) }}

<div class="row">
    <div class="small-12 column">
        <h1>{{ class.title }} Mastery Report</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="context-switch">
            {% include '@learningMastery/fragments/markbookSelector.twig' with {
                class:        class,
                terms:        terms,
                currentTerm:  currentTerm,
                previousTerm: previousTerm,
                nextTerm:     nextTerm
            } %}
        </div>
    </div>
</div>

<style>
    .{{ classFailed }} {
        background-color: rgb(247, 206, 204);
    }
    .{{ classMastered }} {
        background-color: rgb(213, 231, 212);
    }
    .{{ classFeedbackRequired }} {
        background-color: rgb(255, 242, 205);
    }
</style>


<div class="row">
    <div class="small-12 island">
        {% if assessments | length %}
            <div class="scrollable">
                <table>
                    <thead>
                    <tr class="rotate-headers">
                        <th></th>
                        {% for assessment in assessments %}
                            <th>
                                <div>
                                <span>
                                    <a href="{{ routeLookup('learningAssessment.getAssessment', {assessmentId: assessment.id}) }}">{{ assessment.title }}</a><br>
                                    <span class="meta">{{ assessment.typeName }}</span>
                                </span>
                                </div>
                            </th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td></td>
                        {% for assessment in assessments %}
                            <td class="text-center">
                                {% if assessment.dueAt.isPast %}
                                    <i class="icon-clock" title="Past Due Date {{ assessment.dueAt.localShort }}"></i>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                    {% for student in markbook.students %}
                        <tr data-id="{{ student.id }}">
                            <th class="no-pad">
                                <div class="compact card no-pad small-12">
                                    <a href="/search/user/{{ student.id }}" title="View Profile">
                                        <img src="/portrait.php?userId={{ student.externalId }}&size=square32" alt="View Profile"/>
                                        <p>{{ student.lastname }}, {{ student.firstname }}</p>
                                    </a>
                                </div>
                            </th>

                            {# For each student, treat the first assessment found which requires a response as the 'upcoming' assessment #}
                            {% set nextUpcomingFound = false %}

                            {% for assessment in assessments %}

                                {% set className = '' %}
                                {% set url = '#' %}

                                {% if assessment.isParticipant(student) %}

                                    {% set humanMark = assessment.getHumanReadableMark(student, true) %}
                                    {% set normalisedMark = assessment.getNormalisedMark(student, true) %}
                                    {% set value = humanMark | default('–') %}
                                    {% set participant = assessment.getParticipant(student) %}

                                    {% if participant.hasSubmittedResponse %}
                                        {% set url = routeLookup('learningAssessment.getSummary', {studentId: student.id, assessmentId: assessment.id}) %}
                                    {% endif %}

                                {% else %}

                                    {% set humanMark = null %}
                                    {% set value = '–' %}

                                {% endif %}

                                {% set isAttempted = normalisedMark is not null %}
                                {% if assessment is task %}
                                    {% set mostRecentResponse = participant.findMostRecentResponse %}
                                    {% set isAwaiting = mostRecentResponse.markedComplete and mostRecentResponse.isSelfAssessed %}
                                    {% set isMastered = mostRecentResponse.markedComplete and not mostRecentResponse.isSelfAssessed %}
                                {% else %}
                                    {% set mostRecentResponse = null %}
                                    {% set isAwaiting = participant.isFeedbackRequired %}
                                    {% set isMastered = normalisedMark >= 70 %}
                                {% endif %}

                                {% if not isAttempted %}

                                    {# No mark available. Maybe they've done it but not been marked yet? #}

                                    {% if not nextUpcomingFound %}

                                        {# Check if there is one pending #}

                                        {% if participant is not empty %}
                                            {% if not isAwaiting %}
                                                {% if assessment.dueAt.isPast %}
                                                    {# The assessment is past its due date and is not awaiting #}

                                                    {% set value = '<i class="icon-close" title="Past Due Date. No Response">' %}
                                                {% else %}
                                                    {# Assume the first assessment with that requires a resposne is the 'upcoming' assessment and insert an eye-icon #}
                                                    {% set nextUpcomingFound = true %}
                                                    {% set value = '<i class="icon-eye" title="Next Assessment">' %}
                                                    {% set url = routeLookupIfAuthorized('learningAssessment.getSummary', { assessmentId: participant.assessable.id, studentId: participant.user.id, assessment: participant.assessable }) %}
                                                {% endif %}
                                            {% endif %}
                                        {% endif %}

                                    {% else %}

                                        {# Otherwise just leave the cell blank and unstyled #}

                                        {% set className = '' %}
                                        {% set value = '' %}

                                    {% endif %}

                                {% elseif isMastered %}
                                    {% set className = classMastered %}
                                {% else %}
                                    {% set className = classFailed %}
                                {% endif %}

                                {# If student has submitted work but has not received a mark, style the cell appropriately #}

                                {% if participant is not empty %}
                                    {% if isAwaiting %}
                                        {% set value='<i class="icon-pause" title="Awaiting Teacher Assessment">' %}
                                        {% set className = classFeedbackRequired %}
                                    {% endif %}
                                {% endif %}

                                <td class="text-center {{ className }}">
                                    <a href="{{ url }}" title="{{ normalisedMark | round }}%">{{ value | purify }}</a>
                                </td>

                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

        {% else %}

            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>No results available this semester.</p>
            </div>

        {% endif %}
    </div>
</div>
