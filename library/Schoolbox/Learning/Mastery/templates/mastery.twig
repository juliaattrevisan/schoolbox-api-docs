{% import '@learning/macro/urgency.twig' as urgency %}
{% import 'sub/breadcrumbs.twig' as bread %}

<script type="text/javascript" src="/javascript/shared/submissions/jquery.marksheet.js"></script>
<script type="text/javascript" src="/javascript/shared/submissions/task/jquery.progressTickForm.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.ajax-form.js"></script>

{# Crumbz: Class > Mastery#}
{{ bread.crumbs(
[class.title, '/homepage/'~class.id],
['Mastery Report', '#']) }}

<div class="row">
    <div class="small-12 column">
        <h1>{{ class.title }} Mastery Report</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="context-switch">
            {% include '@learningMastery/fragments/markbookSelector.twig'
            with {
            class: class,
            terms: terms,
            currentTerm: currentTerm,
            previousTerm: previousTerm,
            nextTerm: nextTerm,
            courses: courses
            } %}
        </div>
    </div>
</div>

<style>
    .fail {
        background-color: rgb(247, 206, 204);
    }
    .mastered {
        background-color: rgb(213, 231, 212);
    }
    .upcoming {
        background-color: rgb(255, 242, 205);
    }
    .notsubmitted {
        background: repeating-linear-gradient(
                45deg,
                #fff,
                #fff 10px,
                #eee 10px,
                #eee 20px
        )
    }
</style>

<div class="row">
    <div class="small-12 island">
        {% if markbook.assessments.count %}
            <div class="scrollable">
                <table>
                    <thead>
                    <tr class="rotate-headers">
                        <th></th>
                        {% for assessment in markbook.assessments.sortBy('dueAt', 'asc') %}
                            <th>
                                <div>
                                    <span>
                                        <a href="#">{{ assessment.title }}</a><br>
                                        <span class="meta">
                                            {% if assessment is project %}
                                                Project
                                            {% elseif assessment is task %}
                                                Task
                                            {% elseif assessment is quiz %}
                                                Quiz
                                            {% elseif assessment is dueWork %}
                                                Due Work
                                            {% endif %}
                                        </span>
                                    </span>
                                </div>
                            </th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for student in markbook.students %}
                        <tr data-id="{{ student.id }}">
                            <th class="no-pad">
                                <div class="compact card no-pad small-12">
                                    <a href="/search/user/{{ student.id }}" title="View Profile">
                                        <img src="/portrait.php?userId={{ student.externalId }}&size=square32" alt="View Profile"/>
                                        <p>{{ student.lastname }}, {{ student.firstname }}</p>
                                    </a>
                                </div>
                            </th>
                            {% set upcoming = 0 %}

                            {% for assessment in markbook.assessments.sortBy('dueAt', 'asc') %}

                                {% set humanMark = assessment.getHumanReadableMark(student, true) %}

                                {% set className = '' %}
                                {% set value = assessment.getHumanReadableMark(student, true) | default('–') %}

                                {% if assessment is task %}
                                    {% if humanMark == 'Teacher-Assessed' or humanMark == 'Student-Assessed' %}
                                        {% set className = 'mastered' %}
                                    {% else %}
                                        {% if upcoming == 0 %}
                                            {% set upcoming = 1 %}
                                            {% set className = 'upcoming' %}
                                        {% else %}
                                            {% set className = '' %}
                                        {% endif %}
                                        {% set value = '–' %}
                                    {% endif %}
                                {% else %}
                                    {% if humanMark is empty %}
                                        {% if upcoming == 0 %}
                                            {% set upcoming = 1 %}
                                            {% set className = 'upcoming' %}
                                        {% else %}
                                            {% set className = '' %}
                                        {% endif %}
                                    {% elseif humanMark >= 70 %}
                                        {% set className = 'mastered' %}
                                    {% else %}
                                        {% set className = 'fail' %}
                                    {% endif %}
                                {% endif %}

                                <td class="text-center {{ className }}">
                                    {{ value }}
                                </td>

                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}

            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>No results available this semester.</p>
            </div>

        {% endif %}
    </div>
</div>