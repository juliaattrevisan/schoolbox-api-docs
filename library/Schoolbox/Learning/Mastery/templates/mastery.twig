{% import 'sub/breadcrumbs.twig' as bread %}

{% set assessments = markbook.assessments %}

{# These control the cell background colours #}
{% set classFeedbackRequired = 'mastery-notmarked' %}
{% set classFailed           = 'mastery-fail' %}
{% set classMastered         = 'mastery-mastered' %}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/jquery.marksheet.js"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/task/jquery.progressTickForm.js"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/form/jquery.ajax-form.js"></script>

{# Crumbz: Class > Mastery#}
{{ bread.crumbs(
[class.title, '/homepage/'~class.id],
['Mastery Report', '#']) }}

<div class="row">
    <div class="small-12 column">
        <h1>{{ class.title }} Mastery Report</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="context-switch">
            {% include '@learningMastery/fragments/markbookSelector.twig' with {
                class:        class,
                terms:        terms,
                currentTerm:  currentTerm,
                previousTerm: previousTerm,
                nextTerm:     nextTerm
            } %}
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if assessments | length %}
            <div class="scrollable">
                <table>
                    <thead>
                    <tr class="rotate-headers">
                        <th></th>
                        {% for assessment in assessments %}
                            <th>
                                <div>
                                <span>
                                    <a href="{{ routeLookupIfAuthorized('learningAssessment.getStatus', {assessment: assessment, assessmentId: assessment.id}) }}">{{ assessment.title }}</a><br>
                                    <span class="meta">{{ assessment.typeName }}</span>
                                </span>
                                </div>
                            </th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td></td>
                        {% for assessment in assessments %}
                            <td class="text-center">
                                {% if assessment.dueAt.isPast %}
                                    <i class="icon-clock" title="Past Due Date {{ assessment.dueAt.localShort }}"></i>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                    {% for student in markbook.students %}
                        <tr data-id="{{ student.id }}">
                            <th class="profile-cell">
                                <div class="compact card no-pad small-12">
                                    <a href="/search/user/{{ student.id }}" title="View Profile">
                                        <img src="/portrait.php?userId={{ student.externalId }}&size=square64" alt="View Profile"/>
                                        <p>{{ student.lastname }}, {{ student.firstname }}</p>
                                    </a>
                                </div>
                            </th>

                            {# For each student, treat the first assessment found which requires a response as the 'upcoming' assessment #}
                            {% set nextUpcomingFound = false %}

                            {% for assessment in assessments %}

                                {% set participant    = assessment.getParticipantIfExtant(student) %}

                                {# is student a participant ? #}
                                {% if not participant %}

                                    {% set colorClass     = '' %}
                                    {% set title          = student.fullName ~ ' is not a participant of ' ~ assessment.title %}

                                    {# &ndash; cf. the hyphen shown when a pariticant is responseRequired #}
                                    {% set text           = '–' %}
                                    {% set url            = '' %}

                                {% else %}

                                    {# Is this assessment the first assessment encountered for this student that requires a response ? #}
                                    {% set isNextUpcoming   = false %}

                                    {% set humanMark        = participant.humanReadableMark(true) %}
                                    {% set normalisedMark   = participant.normalisedMark(true) %}

                                    {% set mostRecentResponse = participant.findMostRecentResponse %}

                                    {% set responseRequired = participant.responseRequired %}
                                    {% set feedbackRequired = participant.feedbackRequired %}
                                    {% set reviewComplete   = participant.reviewComplete %}

                                    {# Have we not encountered an assessment that requires a response yet, and this assessment requires a resposne ? #}
                                    {% if not nextUpcomingFound and responseRequired and assessment.dueAt.isFuture %}
                                        {% set isNextUpcoming    = true %}
                                        {% set nextUpcomingFound = true %}
                                    {% endif %}

                                    {# Determine background color #}
                                    {% if feedbackRequired %}
                                        {% set colorClass = classFeedbackRequired %}
                                    {% else %}
                                        {% if assessment is task %}
                                            {% if mostRecentResponse and not mostRecentResponse.selfAssessed %}
                                                {% set colorClass = mostRecentResponse.markedComplete ? classMastered : classFailed %}
                                            {% else %}
                                                {% set colorClass = '' %}
                                            {% endif %}
                                        {% else %}
                                            {% if not normalisedMark is null %}
                                                {% set colorClass = normalisedMark >= config.pbl_mastery_threshold ? classMastered : classFailed %}
                                            {% else %}
                                                {% set colorClass = '' %}
                                            {% endif %}
                                        {% endif %}
                                    {% endif %}

                                    {# Determine title #}
                                    {% if feedbackRequired %}
                                        {% set title = 'Awaiting Teacher ' ~ (assessment is task ? 'Confirmation' : 'Assessment') %}
                                    {% elseif isNextUpcoming %}
                                        {% set title = 'Next Assessment' %}
                                    {# Response required, and not a task marked by the teacher (as incomplete) ? #}
                                    {% elseif responseRequired and not (assessment is task and mostRecentResponse and not mostRecentResponse.selfAssessed ) %}
                                        {% set title = 'Response Required.' %}
                                        {% if assessment.dueAt.isPast %}
                                            {% set title = title ~ ' Past Due Date.' %}
                                        {% endif %}
                                    {% else %}
                                        {% if assessment is task %}
                                            {% set title = participant.humanReadableMark(true) %}
                                        {% else %}
                                            {% set title = normalisedMark is null ? 'null' : normalisedMark | round ~ ' %' %}
                                        {% endif %}
                                    {% endif %}

                                    {# Determine text #}
                                    {% if isNextUpcoming %}
                                        {# Cannot have a mark if is 'nextUpcoming' #}
                                        {% set text = '<i class="icon-eye">' %}
                                    {% elseif reviewComplete %}
                                        {% set text = assessment is task ? 'Mastered' : humanMark %}
                                    {% elseif participant.hasMark and not assessment is task %}
                                        {% set text = humanMark %}
                                    {% elseif feedbackRequired %}
                                        {% set text = '<i class="icon-pause">' %}
                                    {% elseif assessment.dueAt.isPast %}
                                        {% set text = '<i class="icon-close">' %}
                                    {% else %}
                                        {% set text = '-' %}
                                    {% endif %}

                                    {# Determine URL #}
                                    {% if feedbackRequired or isNextUpcoming %}
                                        {% if isNextUpcoming or not assessment is dueWork %}
                                            {% set url = routeLookupIfAuthorized('learningAssessment.getSummary', {
                                                assessmentId: assessment.id,
                                                assessment: assessment,
                                                studentId: student.id,
                                                student: student
                                            }) %}
                                        {% else  %}
                                            {% set url = routeLookupIfAuthorized('learningDueWorkResponse.getParticularResponse', {
                                                assessmentId: assessment.id,
                                                assessment: assessment,
                                                studentId: student.id,
                                                student: student,
                                                participant: participant
                                            }) %}
                                        {% endif %}
                                    {% else %}
                                        {% set url = '' %}
                                    {% endif %}


                                {% endif %}

                                <td class="text-center {{ colorClass }}" title="{{ title }}">
                                    {% if url %}<a href="{{ url }}">{% endif %}
                                        {{ text | purify }}
                                    {% if url %}</a>{% endif %}
                                </td>

                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

        {% else %}

            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>No results available this semester.</p>
            </div>

        {% endif %}
    </div>
</div>
