{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    ['Badges', routeLookupIfAuthorized('learningBadge.getBadgeListPage') ],
) }}

{% set reportContentId = 'badge-list-container' %}

{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        // Filtered content has been [re]loaded
        // (Shouldn't this trigger contain the filters that are selected?)
        $('#{{ reportContentId }}').on('filterContentLoaded', function (event, selectedFilters) {
            // Pass the list of filters into the badge-list.vue
            document.dispatchEvent(new CustomEvent('badge-list__onFilterChange', {
                detail: {
                    selectedFilters
                }
            }));
        });
    });
</script>
{% endautoescape %}

<div class="row">
    <div class="button-action small-12 columns">
        <h1>Badges</h1>
        {% if routeLookupIfAuthorized('learningBadge.getCreateForm') %}
        <a href="{{ routeLookup('learningBadge.getCreateForm') }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-add button" title="Create Badge">Create Badge</a>
        {% endif %}
    </div>
</div>

{% include '@filters/panel.twig' with {
    contentId: reportContentId,
    panel:     filterPanel,
    quickload: false,
} only %}

{% set createFormRoute = routeLookupIfAuthorized('learningBadge.getCreateForm') ? routeLookupIfAuthorized('learningBadge.getCreateForm')~'?'~RETURN_URL.name~'='~RETURN_URL.current : null %}
<div class="row">
    <div class="small-12 island">
        <div id="{{ reportContentId }}">
            <badge-list get-badges-route="{{ routeLookup('learningBadge.getBadgeJsonList') }}"
                        get-badge-create-form-route="{{ createFormRoute }}"
                        expiry-date-format="{{ config.date_long | dayjsFormat }}"
                        :show-badge-menus={{ createFormRoute is null ? 'false' : 'true' }}>
            </badge-list>
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/badgeList.js?v={{ config.site_version }}"></script>
    </div>
</div>
<div data-toast class="toast"></div>
