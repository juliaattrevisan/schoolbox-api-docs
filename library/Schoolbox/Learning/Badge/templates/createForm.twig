{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    ['Badges', routeLookup('learningBadge.getBadges') ],
    ['Add new', routeLookup('learningBadge.getCreateForm')]
) }}

<div class="row">
    <div class="small-12 column">
        <h1>Add new badge</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <form method="post" action="{{ routeLookup('learningBadge.postBadge') }}">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="badge-name" class="required">Achievement Name</label>
                        <input type="text" id="badge-name" required />

                        <label for="badge-body" class="required">
                            Description
                        </label>
                        <textarea name="body" id="badge-body" required></textarea>

                        <label>Select badge from existing set</label>
                        <button class="full-width">Browse badges</button>

                        <label for="badge-image">
                            Upload badge from your device
                        </label>
                        {% include 'sub/attachzone.twig' with { attachzone: attachzone } %}

                        <label for="badge-category" class="required">
                            Category
                        </label>
                        <input type="text" id="badge-category" required />

                        <label for="badge-tags">
                            Tags
                        </label>
                        <input type="text" id="badge-tags" />
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="Add new badge" />
        </form>
    </div>
</div>

<script src="/javascript/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script src="/javascript/shared/editor/jquery.editor.js?v={{ config.site_version }}"></script>
{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        $.fn.alaressEditor({
            targetElements: $('#badge-body')
        });
    });
</script>
{% endautoescape %}
