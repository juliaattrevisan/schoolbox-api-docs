{##
 # Icon Modal
 #
 # Set up registry of folders, category names, quantity of icons
 #
 # Foreach category,
 #     put its name in the left column
 #
 # in the right column show that category's icons
 # show e.g. 40 at a time
 # since you know $num, you know how many pages there are
 #
 # as you paginate, you can array_splice(0,$pageLength) and use the filename assumption
 # so you don't actually need any backend work, you just load new images by changing its src
 # attribute via js numerically. we know they're always svg and not user-modifiable, so
 # this is a reasonable assumption we can make.
 #
 # @param array $registry  A set of $path => (name, num) tuples
 # @param int $pageLength  Number of icons to display per page
 #}
<a href="#" data-reveal-id="icon-modal" class="button full-width"><sbx-icon name="search"></sbx-icon>Browse icon library</a>

<div id="icon-modal" class="reveal-modal icon-picker file-picker" data-reveal>
    <div class="attachment-browser-container">
        <div class="attachment-browser-filesystems icon-category-list-container">
            <ul class="tabs vertical">
                {% for path, node in registry %}
                <li class="tab-title" data-icon-path="{{ path }}">
                    <a>{{ node.name }} ({{ node.files|length }})</a>
                </li>
                {% endfor %}
            </ul>
        </div>
        <div class="attachment-browser-panel-container tabs-content" data-icon-container>
            <div class="content active">

                {# Set up placeholder elements once; javascript will give them src values
                 # As we paginate, we replace these src values without having to respawn
                 # dom elements all day
                 #}
                {% for n in 1..pageLength %}
                    <img src="" class="hide" data-icon width="64" height="64" />
                {% endfor %}

                <ul class="flex-list buttons">
                    <li><a class="button" data-previous>Previous</a></li>
                    <li><a class="button" data-next>Next</a></li>
                </ul>
            </div>
        </div>
    </div>

    <a class="close-reveal-modal">&#215;</a>
</div>
