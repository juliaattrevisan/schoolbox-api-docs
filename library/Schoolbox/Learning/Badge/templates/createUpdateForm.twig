{##
 # Create/Update Form
 #
 # @param Model|null $badge               An instance of Badge\Model
 # @param array $attachzone               A dropzone instance containing hashes of files, if any
 # @param array $categories               A list of Badge Categories to choose
 # @param bool $curriculumTaggingEnabled  A bool for whether curric nodes selection should be enabled
 # @param array $iconRegistry             A tuple containing icon paths and page length const
 #}
{% import 'sub/breadcrumbs.twig' as bread %}

{% if badge %}
    {{ bread.crumbs(
        ['Badges', routeLookupIfAuthorized('learningBadge.getBadgeListPage') ],
        [badge.name],
        ['Modify']
    ) }}
{% else %}
    {{ bread.crumbs(
        ['Badges', routeLookupIfAuthorized('learningBadge.getBadgeListPage') ],
        ['Create', routeLookupIfAuthorized('learningBadge.getCreateForm')]
    ) }}
{% endif %}

{##
 # Labels for goal and achievement expiries.
 #
 # Note the disconnect between "never" and "forever". This is because the expiry
 # question is asked slightly differently in the API and in the UI:
 # * API: "when does the badge expire?"
 # * UI:  "how long should the badge last?"
 #}
{% set expiryLabels = {
    never:       'Forever',
    day:         '1 day',
    week:        '1 week',
    fortnight:   '2 weeks',
    month:       '1 month',
    quarterYear: '3 months',
    halfYear:    '6 months',
    year:        '1 year',
} %}

<div class="row">
    <div class="small-12 column">
        {% if badge %}
            <h1>Modify Badge</h1>
        {% else %}
            <h1>Create Badge</h1>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if badge %}
            {% set route = routeLookup('learningBadge.postUpdate', {badgeId: badge.id}) %}
        {% else %}
            {% set route = routeLookup('learningBadge.postBadge') %}
        {% endif %}

        <form method="post" action="{{ route }}" id="badge-form">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="badge-name" class="required">Name</label>
                        <input name="name" type="text" id="badge-name" required value="{{ badge and badge.name ? badge.name : '' }}"/>

                        <label for="badge-body">
                            Description
                        </label>
                        <textarea name="body" id="badge-body" required>{{ badge and badge.body ? badge.body|purify : '' }}</textarea>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label class="required" for="chooseBadge">Choose badge image</label>
                        <p class="meta">Choose a badge image from our existing set or upload your own.</p>
                        <div class="row">
                            <div class="small-12 medium-6 columns">

                                <fieldset class="radiolist" id="chooseBadge" data-badge-avatar-options>
                                    <ul class="option-list">
                                        <li>
                                            <input id="badge-icon" type="radio" name="badge-avatar-selector" value="icon" data-icon-selector checked />
                                            <label for="badge-icon">Choose an existing icon</label>
                                        </li>
                                        <li>
                                            <input id="badge-image" type="radio" name="badge-avatar-selector" value="image" data-image-selector/>
                                            <label for="badge-image">Upload from your device</label>
                                        </li>
                                    </ul>
                                </fieldset>

                                <script src="{{ CDN_PREFIX }}/js/badges/jquery.icon-modal.js?v={{ config.site_version }}"></script>
                                <script>
                                    $(function() {

                                        /* Shank twig data into js; I could probably skip this
                                         * by providing the registry from backend instead
                                         */
                                        let cdnPrefix = "{{ CDN_PREFIX }}";
                                        $('#icon-modal').iconModal({
                                            registry: $.parseJSON('{{ iconRegistry.registry|json_encode|escape('js') }}'),
                                            pageLength: {{ iconRegistry.pageLength }},

                                            root: cdnPrefix + "/images/badges",

                                            /* Inflict it upon the form
                                             */
                                            onSelect: function(element) {
                                                let badgeImageSource = $(element).attr('src');
                                                $('[data-icon-selection] img').attr('src', badgeImageSource).show();
                                                $('#badge-icon-file-error').remove();

                                                // Strip away the CDN prefix from the input value:
                                                // this is so that the badge is portable between the CDN and static
                                                $('input[name=icon]').val(badgeImageSource.replace(cdnPrefix, ''));

                                                $('#icon-modal').foundation('reveal', 'close');
                                            }
                                        });

                                        /* Mutex div switch
                                         */
                                        $('[data-icon-selector]').on('click', function(event) {
                                            $('[data-image-container]').hide();
                                            $('[data-icon-container]').show();
                                        });

                                        $('[data-image-selector]').on('click', function(event) {
                                            $('[data-image-container]').show();
                                            $('[data-icon-container]').hide();
                                        });

                                        {# Preselect "upload from your device" if there's a custom image
                                         # given to this badge; otherwise it'll have "choose existing icon"
                                         # selected instead and noop
                                         #}
                                        {% if badge and badge.image %}
                                        $('[data-image-selector]').trigger('click');
                                        {% endif %}
                                        $('#{{ attachzone.id }}-zone').on('success.attachzone', function(event, file) {
                                            $('#badge-icon-file-error').remove();
                                        });
                                        $('#yearLevels').selectizeSelector({
                                            multiple: true,
                                            value: {{ badge.yearLevels is defined ? (badge.yearLevels.propertyValues('id')|json_encode|raw) : 'null' }},
                                            selectize: {
                                                options: {{ yearLevels|json_encode|raw }},
                                                hideSelected: true
                                            }
                                        });
                                    });
                                </script>
                            </div>
                            <div class="small-12 medium-6 columns" data-icon-container>
                                <div data-icon-selection>
                                    <img src="{{ badge and badge.icon ? (CDN_PREFIX ~ badge.icon) : '' }}" width="128" height="128" />
                                    <input id="badge-icon-file" name="icon" type="hidden" value="{{ badge and badge.icon ? badge.icon : '' }}" />
                                </div>
                                <div>
                                    {% include '@learningBadge/icon-modal.twig' with {
                                        registry: iconRegistry.registry,
                                        pageLength: iconRegistry.pageLength
                                    }%}
                                </div>
                            </div>
                            <div class="small-12 medium-6 columns" style="display:none;" data-image-container>
                                <p class="meta">Badge images are recommended to be SVG or a minimum of 250x250</p>
                                {% include 'sub/attachzone.twig' with { attachzone: attachzone } %}
                            </div>
                        </div>
                    </div>
                    <div class="small-12 columns">
                        {% set animate = not badge or badge.animate %}
                        <label for="badge-animate" class="inline-block">Animate Badge on Achievement</label>
                        <div class="switch">
                            <input id="badge-animate" type="checkbox" name="animate" {% if animate %}checked="checked"{% endif %}>
                            <label for="badge-animate">
                                <span>On</span>
                                <span>Off</span>
                            </label>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="content">
                    {% set allowAsGoal = not badge or badge.allowAsGoal %}
                    <div class="small-6 columns">
                        <label for="badge-allow-as-goal" class="inline-block">Allow Use as Goal</label>
                        <div class="switch">
                            <input id="badge-allow-as-goal" type="checkbox" name="allow-as-goal" {% if allowAsGoal %}checked="checked"{% endif %}>
                            <label for="badge-allow-as-goal">
                                <span>On</span>
                                <span>Off</span>
                            </label>
                        </div>
                    </div>
                    <div class="small-6 columns">
                        <label for="badge-goal-expiry">
                            Goal Duration
                            <span data-tooltip class="hint has-tip tip-top" data-width="200"
                                  title="Set the period of time, from being set, that this goal will be available for users to achieve. Expired goals will not be visible on the ‘Goals’ area of the student profile.">?</span>
                        </label>
                        <select name="goalExpiry" id="badge-goal-expiry" {% if not allowAsGoal %}disabled{% endif %}>
                            {% for key, value in expiries %}
                                <option value="{{ value }}"
                                        label="{{ expiryLabels[key] }}"
                                        {% if (badge.goalExpiry ?? null) is same as value %}selected{% endif %}>
                                    {{ expiryLabels[key] }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="small-12 columns">
                        <label for="badge-achievement-expiry">
                            Achievement Duration
                            <span data-tooltip class="hint has-tip tip-top" data-width="200"
                                  title="Set the period of time that this achievement will be visible in the ‘Achievements’ area of the student profile page.">?</span>
                        </label>
                        <select name="achievementExpiry" id="badge-achievement-expiry">
                            {% for key, value in expiries %}
                                <option value="{{ value }}"
                                        label="{{ expiryLabels[key] }}"
                                        {% if (badge.achievementExpiry ?? null) is same as value %}selected{% endif %}>
                                    {{ expiryLabels[key] }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="badge-category" class="required">
                            Category
                        </label>
                        <select name="category" id="badge-category" required>
                            <option disabled selected>-- Select a category --</option>
                            {% for category in categories %}
                                {% set selected = '' %}

                                {% if badge and badge.category.id == category.id %}
                                    {% set selected = 'selected="selected"' %}
                                {% endif %}
                                <option value="{{ category.id }}" label="{{ category.name }}" {{ selected }}>{{ category.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="small-12 columns">
                        {% set toolTipTitle = 'Select the year levels to associate with this badge to allow filtering.' %}
                        <label>
                            Year Levels
                            <span data-tooltip class="hint has-tip tip-top" data-width="200" title="{{ toolTipTitle }}">?</span>
                        </label>
                        <input title="Year Levels" id="yearLevels" name="yearLevelIds" placeholder="Select year Levels"
                               tabindex="-1" class="selectized" type="text">
                    </div>
                    {% if curriculumTaggingEnabled %}
                        <div class="small-12 columns">
                            <label for="curriculum-code-select">
                                Curriculum Codes
                                {% include 'sub/curriculumCodeSelector.twig' with {
                                    codeList: curriculumCodes,
                                    renderButton: true
                                } %}
                            </label>
                        </div>
                    {% endif %}
                </fieldset>
            </section>

            {% if badge %}
            <input type="submit" value="Modify Badge" id="badge-submit" />
            {% else %}
            <input type="submit" value="Create Badge" id="badge-submit" />
            {% endif %}
        </form>
    </div>
</div>

<script src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
{% autoescape 'js' %}
<script type="text/javascript">
    let curriculumTaggingEnabled = Boolean('{{ curriculumTaggingEnabled }}');
    $(function () {
        // Set up editor
        let editorId = 'badge-body';
        $.fn.alaressEditor({
            targetElements: $('#' + editorId)
        });


        // Update the editor's form input on change
        // (required so that validation triggers)
        CKEDITOR.instances[editorId].on('change', CKEDITOR.instances[editorId].updateElement);


        // Disable goal expiry input if this badge isn't a goal
        let $badgeGoalExpiryInput = $('#badge-goal-expiry');
        $('#badge-allow-as-goal').on('change', function () {
            $badgeGoalExpiryInput.prop('disabled', !this.checked);
        });


        // Set up validation and save
        let $form = $('#badge-form');
        $.validator.addMethod(
                "hasImage",
                function (value, element) {
                    let selectedOption = $('input[name=badge-avatar-selector]:checked').val();

                    /* At least one element must be chosen
                     */
                    if (selectedOption === undefined) {
                        return false;
                    }

                    /* Depending on the radio element you chose,
                     * require a specific input element's value
                     */
                    if ('icon' === selectedOption) {
                        return $form.find('input[name="icon"]').val().length > 0;
                    }

                    /* Attachzones don't have any particular input field upon which you can
                     * statically check like other form fields. The presence of one or more
                     * <input data-az-attachment> elements, which spawn when you add files
                     * etc., help you conclude whether at least one file was supplied.
                     * These spawn in data-dz-previews
                     */
                    if ('image' === selectedOption) {
                        return $form.find('input[name="image"]').length > 0;
                    }
                    return false;
                }, 'Please choose a badge image.');
        $form.alaressValidate({
            rules: {
                name: {
                    requiredNotBlank: true,
                },
                category: {
                    required: true,
                },

                /* Selecting an image to represent a badge fills this input field
                 * Attachzones spawn an input element
                 */
                icon: {
                    hasImage: true,
                }
            },
            errorPlacement: function(error, element) {

                /* The icon and image messages appear in a special place
                 * Otherwise use the default placement
                 */
                if (['icon', 'image'].indexOf($(element).attr('name')) > -1) {

                    /* Only insert one
                     */
                    $('#badge-icon-error').remove();

                    error.insertBefore($('[data-badge-avatar-options]'));
                } else {
                    $.alaressValidate.defaultErrorPlacement(error, element);
                }
            },
            submitHandler(form, event) {
                event.preventDefault();

                // Build a request to post the form
                let formData = new FormData(form),
                    payload  = {
                        'name': formData.get('name'),
                        'body': formData.get('body'),
                        'icon': formData.get('icon'),
                        'image': formData.get('image'),
                        'allow-as-goal': !!formData.get('allow-as-goal'),
                        'animate': !!formData.get('animate'),
                        'category': null,
                        'tags': [],
                        'badge-avatar-selector': formData.get('badge-avatar-selector')
                    },
                    categoryId        = formData.get('category'),
                    achievementExpiry = formData.get('achievementExpiry'),
                    goalExpiry        = formData.get('goalExpiry'),
                    tags              = formData.get('tags'),
                    toast             = $('#toast'),
                    submit            = $('#badge-submit');


                if (categoryId) {
                    payload.category = {
                        id: categoryId
                    }
                }

                payload.achievementExpiry = achievementExpiry
                    ? Number(achievementExpiry)
                    : null;

                payload.goalExpiry = goalExpiry
                    ? Number(goalExpiry)
                    : null;

                let yearLevels = form.querySelector('#yearLevels').selectize.items;
                payload.yearLevelIds = yearLevels.map(
                        (v) => {
                            return {id: Number(v)}
                        }
                );

                // Only save curriculum nodes if they are enabled
                if (curriculumTaggingEnabled) {
                    payload.curriculumNodes = [form.querySelector('input[name="curriculumCodes[]"]').value];
                }

                // Toast then post
                toast.toastActivate('Saving...')
                submit.prop('disabled', true);

                fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(payload)
                })
                .then(() => {
                    toast.toastTimeout({text: 'Saved'});
                    window.location.href = '{{ RETURN_URL.previous.decoded ?? routeLookup('learningBadge.getBadgeListPage') }}';
                })
                .catch(() => {
                    toast.toastTimeout({text: 'Save failed', css: 'alert'});
                    submit.prop('disabled', false);
                });
            }
        })
    });
</script>
{% endautoescape %}

<div id="toast" class="toast"></div>
