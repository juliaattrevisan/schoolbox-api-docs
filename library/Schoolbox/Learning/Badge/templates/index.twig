{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    ['Badges', routeLookup('learningBadge.getBadges') ],
) }}


<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Badge List</h1>
        </div>
    </div>
    <nav>
        {% if routeLookupIfAuthorized('learningBadge.getCreateForm') %}
            <a href="{{ routeLookup('learningBadge.getCreateForm') }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-add" title="Create Badge"></a>
        {% endif %}
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        <div id="badge-list-container" >
            <badge-list get-badges-route="{{ routeLookup('learningBadge.getBadges') }}">
            </badge-list>
        </div>
        <script src="/javascript/components/badgeList.bundle.js"></script>
    </div>
</div>
