{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    ['Badges', routeLookupIfAuthorized('learningBadge.getBadgeListPage') ],
    [messages.pageHeader]
) }}

{% set reportContentId = 'badge-list-form-container' %}

{% autoescape 'js' %}
    <script type="text/javascript">
        $(function () {
            // Filtered content has been [re]loaded
            // (Shouldn't this trigger contain the filters that are selected?)
            $('#{{ reportContentId }}').on('filterContentLoaded', function (event, selectedFilters) {
                // Pass the list of filters into the badge-list-form.vue
                document.dispatchEvent(new CustomEvent('badge-list-form__onFilterChange', {
                    detail: {
                        selectedFilters
                    }
                }));
            });
        });
    </script>
{% endautoescape %}

<div class="row">
    <div class="button-action small-12 columns">
        <h1>{{ messages.pageHeader }}</h1>
           {% if routeLookupIfAuthorized('learningBadge.getCreateForm') %}
                <a href="{{ routeLookup('learningBadge.getCreateForm') }}?{{ RETURN_URL.name }}={{ returnUrl }}" class="icon-add button" title="Create Badge">Create Badge</a>
            {% endif %}
    </div>
    <div class="small-12 columns">
        {% if otherUsers is not empty %}
            <ul class="meta">
                <li>
                    {% include 'sub/userListMetadata.twig'
                        with {
                            users:   otherUsers,
                            message: messages.userListMetadataPrefix,
                        } only
                    %}
                </li>
            </ul>
        {% endif %}
    </div>
</div>

{% include '@filters/panel.twig' with {
    contentId: reportContentId,
    panel:     filterPanel,
    quickload: false,
} only %}

<div class="row">
    <div class="small-12 island">
        <div id="{{ reportContentId }}">
            <badge-list-form get-badges-route="{{ routeLookup('learningBadge.getBadgeJsonList') ~ (allowAsGoalOnly ? '?sag=1' : '') }}"
                             get-badge-create-form-route="{{ routeLookupIfAuthorized('learningBadge.getCreateForm')
                             ? routeLookupIfAuthorized('learningBadge.getCreateForm')~'?'~RETURN_URL.name~'='~RETURN_URL.current : null }}"
                             :users="{{ users | json_encode }}"
                             expiry-date-format="{{ config.date_long | dayjsFormat }}"
                             expiry-field="{{ expiryField }}"
                             :award-to-self-only="Boolean('{{ awardToSelfOnly }}')"
                             post-award-route-lookup="{{ postAwardRouteLookup }}"
                             toast-activate-message-singular="{{ messages.toastActivate.singular }}"
                             toast-success-message-singular="{{ messages.toastSuccess.singular }}"
                             toast-failure-message-singular="{{ messages.toastFailure.singular }}"
                             confirm-button-text-singular="{{ messages.confirmButtonText.singular }}"
                             confirm-modal-header-singular="{{ messages.confirmModalHeader.singular }}"
                             confirm-modal-badge-list-meta-singular="{{ messages.confirmModalMeta.singular }}"
                             toast-activate-message-plural="{{ messages.toastActivate.plural }}"
                             toast-success-message-plural="{{ messages.toastSuccess.plural }}"
                             toast-failure-message-plural="{{ messages.toastFailure.plural }}"
                             confirm-button-text-plural="{{ messages.confirmButtonText.plural }}"
                             confirm-modal-header-plural="{{ messages.confirmModalHeader.plural }}"
                             confirm-modal-badge-list-meta-plural="{{ messages.confirmModalMeta.plural }}"
                             return-url="{{ RETURN_URL.previous.decoded }}">
            </badge-list-form>
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/badgeListForm.js?v={{ config.site_version }}"></script>
    </div>
</div>
<div data-toast class="toast"></div>
