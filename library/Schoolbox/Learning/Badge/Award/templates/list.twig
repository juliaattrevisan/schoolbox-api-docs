{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ folder.title, '/homepage/' ~ folder.id ],
    ['Badge Report']
) }}
{% autoescape 'js' %}
    <script type="text/javascript">
        $(function () {
            $('#badge-report-container').on('filterContentLoaded', function (event, selectedFilters) {
                document.dispatchEvent(new CustomEvent('badge-report__onFilterChange', {
                    detail: {
                        selectedFilters
                    }
                })); 
            });
        });
    </script>
{% endautoescape %}
{% include '@filters/panel.twig' with {
    contentId: "badge-report-container",
    panel:     filterPanel,
    quickload: false,
} only %}
<div class="row" id="badge-report-container">
    <badge-report
        subject-title="{{ folder.title }}"
        get-student-lists-endpoint="{{ routeLookup('learningBadgeAward.getListByFolderId', {folderId: folder.getId, folder: folder}) }}"
    >
    </badge-report>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/badgeReport.js"></script>
<div id="toaster" class="toast" data-toast></div>
