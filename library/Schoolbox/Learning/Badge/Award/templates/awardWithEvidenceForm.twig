<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
{% set awardType = isGoal ? 'goal' : 'achievement' %}
{% set title = 'Award ' ~ (awardType | capitalize) ~ ((badges | length > 1) ? 's' : '') %}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    ['Badges', routeLookupIfAuthorized('learningBadge.getBadgeListPage') ],
    [ title ]
) }}
<div class="row">
    <div class="small-12 columns">
        <h1>{{ title }}</h1>
        {% if targetUsers is not empty %}
            <ul class="meta">
                <li>
                    {% include 'sub/userListMetadata.twig'
                        with {
                        users:   targetUsers,
                        message: 'Awarding to',
                    } only %}
                </li>
            </ul>
        {% endif %}
    </div>
</div>
{% include '@learningBadgeAward/awardBadgeList.twig'
    with {badges: badges, isGoal: isGoal} only %}
{% include '@learningBadgeAward/reasonForm.twig'
    with {
    postRoute: routeLookupIfAuthorized('learningBadgeAward.postAwardWithEvidence') ~ '?returnUrl=' ~ returnUrl,
    isGoal : isGoal,
    reason : '',
    submitLabel: 'Award',
    targetUserIds: targetUserIds,
    badgeIds: badgeIds,
    cancelUrl: cancelUrl,
    editorTemplates: editorTemplates
} only %}
