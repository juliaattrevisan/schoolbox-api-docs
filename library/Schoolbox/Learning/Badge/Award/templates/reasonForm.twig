{##
    editorTemplates       array           Retrieve any pre-existing editor templates to insert into the 'Body' rich text editor
 #}
<div class="row">
    <div class="small-12 island">
        <div class="actions-small-2 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Evidence</h2>
                </div>
            </div>
        </div>
        <form action="{{ postRoute }}" method="post" id="evidence-form">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="hidden" name="targetUserIds" value="{{ targetUserIds }}">
                        <input type="hidden" name="badgeIds" value="{{ badgeIds }}">
                        <p class="meta">Provide evidence or narrative on how the
                            {{ isGoal ? 'goal is progressing.' : 'achievement was earned.' }}
                            {% if USER.role.staff %}
                                Student detail tokens can be viewed when you press [. Tokens will be substituted with the students details on creation.
                            {% endif %}
                        </p>
                        <textarea id="reason" name="reason">{{ reason }}</textarea>
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <ul class="flex-list buttons">
                        <li><a href="{{ cancelUrl }}" class="button">Cancel</a></li>
                        <li><input type="submit" value="{{ submitLabel }}" /></li>
                    </ul>
                </div>
            </div>
        </form>
    </div>
</div>
<script>

    $(function () {
        /**
         * Initialise the editor, enabling tokens if the user is staff
         */
        document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
            detail: {
                targetElements: ['#reason'],
                {% if USER.role.staff %}hasTokens: true,{% endif %}
                {% if editorTemplates %}
                    templates: {{ editorTemplates|json_encode|raw }},
                {% endif %}
            }
        }));
    });
    $('#evidence-form').alaressValidate();

</script>
