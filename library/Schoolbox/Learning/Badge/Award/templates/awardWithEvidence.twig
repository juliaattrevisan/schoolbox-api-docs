{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ award.recipient.fullname, routeLookupIfAuthorized('searchUser.getProfile', {userId: award.recipient.id}) ],
    ['Achievement Evidence']
) }}
{% set awardedByRoute = routeLookupIfAuthorized('searchUser.getProfile', {userId: award.awardedBy.id}) %}
{% set modifyRoute = routeLookupIfAuthorized('learningBadgeAward.getAwardUpdate', {awardId: award.id}) %}
<div class="row">
    <div class="small-12 columns">
        <h1>Achievement Evidence</h1>
        <p class="meta">Achievement awarded by
            {% if awardedByRoute %}
                <a href="{{ awardedByRoute }}">{{ award.awardedBy.fullname }}</a>
            {% else %}
                {{ award.awardedBy.fullname }}
            {% endif %}
        </p>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div class="badge-img-container content">
                {% if award.badge.icon %}
                    <img src=" {{ CDN_PREFIX }}{{ award.badge.icon }}" class="badge-image" alt="{{ award.badge.name }}"
                         title="{{ award.badge.name }}"/>
                {% elseif award.badge.image.hash %}
                    <img src="/storage/image.php?hash={{ award.badge.image.hash }}" class="badge-image"
                         alt="{{ award.badge.name }}"
                         title="{{ award.badge.name }}"/>
                {% endif %}
            </div>
            <article>{{ award.badge.body|purify }}</article>
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="actions-small-2 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Evidence</h2>
                </div>
            </div>
            {% if modifyRoute or deleteRoute %}
            <nav>
                {% if modifyRoute %}<a href="{{ modifyRoute }}" class="icon-modify" title="Modify"></a>{% endif %}
                <a href="" class="icon-delete" title="Delete"></a>
            </nav>
            {% endif %}
        </div>
        <section>
            <fieldset>
                <div>{{ award.reason|purify }}
                </div>
            </fieldset>
        </section>
    </div>
</div>
