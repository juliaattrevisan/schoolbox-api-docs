{% import 'sub/breadcrumbs.twig' as bread %}
{%  set profile = routeLookupIfAuthorized('searchUser.getProfile', {userId: award.recipient.id, user: award.recipient}) %}
{{ bread.crumbs(
    [ award.recipient.fullname, profile ],
    [ award.status | capitalize ~ 's', profile ~ '#' ~ award.status ~'s' ],
    [ award.badge.name ]
) }}
{% set modifyRoute = routeLookupIfAuthorized('learningBadgeAward.getAwardUpdate', {awardId: award.id, award: award}) %}
{% set postRoute = routeLookupIfAuthorized('learningBadgeAward.postAwardUpdate', {awardId: award.id, award: award}) %}
{% set awardRoute = routeLookupIfAuthorized('learningBadgeAward.postAwardAchieve', {awardId: award.id, award: award}) %}
<script>
    $(function () {
        $('[data-delete-evidence]').on('click', function (e) {
            e.preventDefault();
            $(this).confirmDialog({
                text: 'Are you sure you want to delete the evidence from this {{ award.status }}?',
                confirmEvent: function () {
                    $.post('{{ postRoute }}', {
                        reason: ''
                    }).done(function () {
                        window.location.reload();
                    });
                }
            });
        });
        $('[data-award-goal]').on('click', function (e) {
            e.preventDefault();
            $.post('{{ awardRoute }}', {}).done(function (response) {
                if (response.viewUrl !== 'undefined') {
                    window.location.href = response.viewUrl;
                }
            });
        });
    });
</script>
{%  include '@learningBadgeAward/awardMeta.twig' with {award: award, profile: profile} only %}
{% include '@learningBadgeAward/awardBadgeList.twig'
    with {badges: badges, isGoal: award.isGoal} only %}
<div class="row">
    <div class="small-12 island">
        <div class="actions-small-2 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Evidence</h2>
                </div>
            </div>
            {% if modifyRoute or postRoute %}
            <nav>
                {% if modifyRoute %}<a href="{{ modifyRoute ~ '?returnUrl=' ~ returnUrl }}" title="Modify" class="sbx-icon-only-button"><sbx-icon name="modify"></sbx-icon></a>{% endif %}
                {% if postRoute and award.reason is not empty %}<a title="Delete" data-delete-evidence class="sbx-icon-only-button"><sbx-icon name="delete"></sbx-icon></a>{% endif %}
            </nav>
            {% endif %}
        </div>
        {% if award.reason is empty %}
        <div class="empty-state">
            <i class="icon-modify"></i>
            <p>There's no evidence added to this award yet.</p>
            {% if modifyRoute %}<p><a href="{{ modifyRoute ~ '?returnUrl=' ~ returnUrl }}" title="Add some evidence">Add evidence.</a></p>{% endif %}
        </div>
        {% else %}
        <section>
            <fieldset class="content">
                <div class="small-12 columns">
                    {{ award.reason|purify }}
                </div>
            </fieldset>
        </section>
        {% endif %}
        <div class="row">
            <div class="small-12 columns">
                <ul class="flex-list buttons">
                    <li><a href="{{ cancelUrl }}" class="button">Return to previous page</a></li>
                    {% if award.isGoal and award.award is empty and awardRoute %}<li><a data-award-goal class="button submit">Award</a></li>{% endif %}
                </ul>
            </div>
        </div>
    </div>
</div>
