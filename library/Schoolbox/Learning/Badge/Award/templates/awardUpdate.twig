<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
{%  set profile = routeLookupIfAuthorized('searchUser.getProfile', {userId: award.recipient.id, uesr: award.recipient}) %}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ award.recipient.fullname, profile ],
    [ award.status | capitalize ~ 's', profile ~ '#goals' ],
    [ award.badge.name ]
) }}
{%
    set awardedByRoute = (
        (award.awardedBy.isDeleted)
        ? ''
        : routeLookupIfAuthorized('searchUser.getProfile', {userId: award.awardedBy.id, user: award.awardedBy})
    )
%}
{%  include '@learningBadgeAward/awardMeta.twig' with {award: award, awardedByRoute: awardedByRoute, profile: profile} only %}
{% include '@learningBadgeAward/awardBadgeList.twig'
    with {badges: badges, isGoal: award.isGoal} only %}
{% include '@learningBadgeAward/reasonForm.twig'
    with {
    postRoute: routeLookupIfAuthorized('learningBadgeAward.postAwardUpdate', {awardId: award.id, award: award})~ '?returnUrl=' ~ returnUrl,
    isGoal : award.isGoal,
    reason : award.reason,
    submitLabel: 'Save',
    targetUserIds: null,
    badgeIds: null,
    cancelUrl: cancelUrl,
} only %}
