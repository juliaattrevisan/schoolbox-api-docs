<script src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script>
    $(function() {
        $.fn.alaressEditor({
            targetElements: $('#reason'),
            removePlugins: 'uploadimage,link,schoolboxanchor,elementspath,wordcount,autolink,autoembed,schoolboxiframe',
            /* Why does EqnEditor stop my images loading?
             */
            removeButtons: 'Subscript,Superscript,RemoveFormat,Table,HorizontalRule,SpecialChar,Embed',
            toolbarGroups: [
                { name: 'basicstyles', groups: ['basicstyles', 'cleanup'] },
                { name: 'paragraph', groups: ['list', 'blocks', 'bidi'] },
                { name: 'insert', groups: ['insert'] },
                { name: 'schoolbox', groups: ['schoolboxlink'] },
            ],
            resize_enabled: true,
            toolbarCanCollapse: false
        });
    });
</script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ award.recipient.fullname, routeLookupIfAuthorized('searchUser.getProfile', {userId: award.recipient.id}) ],
    ['Achievement Evidence']
) }}
{% set awardedByRoute = routeLookupIfAuthorized('searchUser.getProfile', {userId: award.awardedBy.id}) %}
<div class="row">
    <div class="small-12 columns">
        <h1>Achievement Evidence</h1>
        <ul class="meta">
            <li class="icon-achievement">Awarded
                <time title="{{ award.awardedAt.local }}">{{ award.awardedAt.relativeTime }}</time> by
                {% if awardedByRoute %}
                    <a href="{{ awardedByRoute }}">{{ award.awardedBy.fullname }}</a>
                {% else %}
                    {{ award.awardedBy.fullname }}
                {% endif %}
            </li>
        </ul>
    </div>
</div>
{% include '@learningBadgeAward/awardBadgeList.twig' %}
<div class="row">
    <div class="small-12 island">
        <div class="actions-small-2 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Evidence</h2>
                </div>
            </div>
        </div>
        {% set postRoute = routeLookupIfAuthorized('learningBadgeAward.postAwardUpdate', {awardId: award.id}) %}
        <form action="{{ postRoute }}" method="post">
            <section>
                <fieldset>
                    <textarea id="reason" name="reason">{{ award.reason }}</textarea>
                </fieldset>
            </section>
            <input type="submit" value="Save" />
        </form>
    </div>
</div>
