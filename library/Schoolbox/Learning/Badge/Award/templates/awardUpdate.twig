<script src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ award.recipient.fullname, routeLookupIfAuthorized('searchUser.getProfile', {userId: award.recipient.id, user: award.recipient}) ],
    [ (award.status | capitalize) ~ ' Evidence']
) }}
{% set awardedByRoute = routeLookupIfAuthorized('searchUser.getProfile', {userId: award.awardedBy.id, user: award.awardedBy}) %}
<div class="row">
    <div class="small-12 columns">
        <h1>{{ award.status | capitalize }} Evidence</h1>
        <ul class="meta">
            <li class="icon-{{ award.status }}">{{ award.isGoal ? 'Goal set' : 'Awarded' }}
                <time title="{{ award.awardedAt.local }}">{{ award.awardedAt.relativeTime }}</time>
                by
                {% if awardedByRoute %}
                    <a href="{{ awardedByRoute }}">{{ award.awardedBy.fullname }}</a>
                {% else %}
                    {{ award.awardedBy.fullname }}
                {% endif %}
            </li>
            {% if award.status == 'goal' and award.award %}
                <li class="icon-achievement">Goal has been achieved
                    <time title="{{ award.award.awardedAt.local }}">{{ award.awardedAt.relativeTime }}</time>
                </li>
            {% endif %}
        </ul>
    </div>
</div>
{% include '@learningBadgeAward/awardBadgeList.twig'
    with {badges: badges, isGoal: award.isGoal} only %}
{% include '@learningBadgeAward/reasonForm.twig'
    with {
    postRoute: routeLookupIfAuthorized('learningBadgeAward.postAwardUpdate', {awardId: award.id, award: award})~ '?returnUrl=' ~ returnUrl,
    isGoal : award.isGoal,
    reason : award.reason,
    submitLabel: 'Save',
    targetUserIds: null,
    badgeIds: null,
    cancelUrl: cancelUrl,
} only %}
