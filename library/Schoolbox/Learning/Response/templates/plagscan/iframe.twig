{% import 'sub/breadcrumbs.twig' as bread %}

{# Conditional bread?? -_-
 #}
{% if assessment.context is project %}
    {% set nodes = [
    ['Learning', routeLookup('learning.getClasses')],
    [assessment.context.folder.name, routeLookup('learningMarkbook.getMarkbook', {classId: assessment.context.folder.id})],
    [assessment.context.title, routeLookup('learningAssessment.getSummary', {assessmentId: assessment.context.id, studentId: response.submittedOnBehalfOf.id}) ],
    [assessment.title, routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id})],
    ['Inline Grader', routeLookup('learningResponse.getParticularResponse', {assessmentId: assessment.id, studentId: response.submittedOnBehalfOf.id, responseId: response.id})],
    ['Plagscan Report', null]
    ] %}
{% else %}
    {% set nodes = [
    ['Learning', routeLookup('learning.getClasses')],
    [assessment.context.folder.name, routeLookup('learningMarkbook.getMarkbook', {classId: assessment.context.folder.id})],
    [assessment.title, routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id})],
    ['Inline Grader', routeLookup('learningResponse.getParticularResponse', {assessmentId: assessment.id, studentId: response.submittedOnBehalfOf.id, responseId: response.id})],
    ['Plagscan Report', null]
    ] %}
{% endif %}

{{ bread.crumbsArray(nodes)}}

<div class="row">
    <div class="small-12 columns">
        <iframe class="fullscreen scroll-wrapper" src="{{ routeLookupIfAuthorized('learningResponse.getPlagscanReportContents', {plagscanId: plagscan.plagscanId}) }}" frameborder="0"></iframe>
    </div>
</div>
