{% import 'sub/breadcrumbs.twig' as bread %}

<script src="/javascript/shared/jquery.responsive-iframe.js"></script>
<script type="text/javascript">
    $(function() {

        /**
         * Resize iframe dynamically ("responsively")
         */
        $.fn.responsiveIframe({
            onLoad: function() {
                $('#plagscan-report').height($(window).height() * 0.75);
            },
            onResize: function() {
                $('#plagscan-report').height($(window).height() * 0.75);
            }
        });
    });
</script>

{# Conditional bread?? -_-
 #}
{% if assessment.context is project %}
    {% set nodes = [
    ['Learning', routeLookup('learning.getClasses')],
    ['Markbook', routeLookup('learningMarkbook.getMarkbook', {classId: assessment.context.folder.id})],
    [assessment.context.title, routeLookup('learningAssessment.getSummary', {assessmentId: assessment.context.id, studentId: response.submittedOnBehalfOf.id}) ],
    [assessment.title, routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id})],
    ['Inline Grader', routeLookup('learningResponse.getParticularResponse', {assessmentId: assessment.id, studentId: participant.user.id, responseId: response.id})],
    ['Plagscan Report', null]
    ] %}
{% else %}
    {% set nodes = [
    ['Learning', routeLookup('learning.getClasses')],
    ['Markbook', routeLookup('learningMarkbook.getMarkbook', {classId: assessment.context.id})],
    [assessment.title, routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id})],
    ['Inline Grader', routeLookup('learningResponse.getParticularResponse', {assessmentId: assessment.id, studentId: participant.user.id, responseId: response.id})],
    ['Plagscan Report', null]
    ] %}
{% endif %}

{{ bread.crumbsArray(nodes)}}

<div class="row">
    <div class="small-12 columns">
        <iframe id='plagscan-report' src="{{ routeLookupIfAuthorized('learningResponse.getPlagscanReportContents', {plagscanId: plagscan.plagscanId}) }}" class="no-margin no-padding" frameborder="0"></iframe>
    </div>
</div>

