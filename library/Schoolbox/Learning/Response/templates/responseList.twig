<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Grading for {{ student.fullname }}</h1>
        </div>
    </div>
    <nav>
        <a href="" class="icon-add" title="Add Feedback for {{ student.fullname }} in {{ assessment.title }}"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Submission History</h2>

        <section>
            <ul id='history' class="information-list threaded">
                {% for currentInteraction in timeline %}
                    {% if currentInteraction is response %}
                        {% include '@learningResponse/inlineGrading/interaction/response.twig' %}
                    {% endif %}
                {% endfor %}
            </ul>
        </section>
    </div>
</div>