{% if file.crocodocId and feedback.id %}
    {% set crocodocRoute = routeLookupIfAuthorized('learningResponse.getCrocodocDownload', {assessment: assessment, assessmentId: assessment.id, feedbackId: feedback.id, crocodocId: file.crocodocId, participant: participant}) %}

    {% if crocodocRoute %}
        <a href="{{ crocodocRoute }}" class="icon-download" title="Download annotated document">{{ linkText }}</a>
    {% endif %}
{% endif %}