{# Inline Grader for a particular Response
 #
 # This lets you create Associated Feedback along with grade, comment and
 # assorted feedback files etc.
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learning/macro/urgency.twig' as urgency %}

{{ bread.crumbs(
    ['Learning', routeLookup('learning.getClasses')],
    ['Markbook', routeLookup('learningMarkbook.getMarkbook', {classId: assessment.context.id})],
    [assessment.title, routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id})],
    ['Timeline', routeLookup('learningResponse.getResponseList', {assessmentId: assessment.id, studentId: response.submittedOnBehalfOf.id})],
    ['Inline Grader', null]
) }}

<script type="text/javascript">
    $(function() {

        {# Special behaviour of the Publish button on this screen
         # Publishing on this screen should be synonymous with the
         # old "Save And Continue" behaviour
         #}
        $('#assessment-status').on('click', '[data-draft="publish"]', function(event) {

        });
    });
</script>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Grading {{ assessment.title }}</h1>
            <ul class="meta">
                <li class="icon-calendar">Due <span class="{{ urgency.datetime(assessment, response.submittedOnBehalfOf) }}">{{ assessment.dueAt.short }}</span></li>
                <li class="icon-due-work"><a href="/homepage/{{ assessment.context.id }}">{{ assessment.context.title }}</a> {{ assessment.typeName }}</li>
            </ul>
        </div>
    </div>
</div>

{% include '@learningResponse/inlineGrading/participantCarousel.twig' %}

{% include '@learningResponse/inlineGrading/strategy/' ~ subfragment.strategy with {data: subfragment.data} %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Files</h2>
        <section>
            {% if response.allFiles %}
                <ul class="inline-grader-filelist grid small-block-grid-1 medium-block-grid-2 large-block-grid-3">
                    {% for currentFile in response.allFiles %}
                        {% set selected = '' %}
                        {% set defaultSelectedFile = selectedFileHash|length == 0 and loop.index0 == 0 %}
                        {% set hasSelectedFile = selectedFileHash|length and currentFile.hash == selectedFileHash %}

                        {% if hasSelectedFile or defaultSelectedFile %}
                            {% set selected = 'selected' %}
                        {% endif %}

                        <li class="actions-small-1 {{ selected }}">
                            <div class="list-item">
                                <div class="card small-12 compact">
                                    <a href="{{ routeLookup('learningResponse.getParticularResponse', {assessmentId: response.assessable.id, responseId: response.id}) }}?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}">
                                        <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" class="mime" />
                                        <p>{{ currentFile.filename }}</p>

                                        {% include '@learning/dueWork/plagscan.twig' %}
                                    </a>
                                </div>
                            </div>
                            <nav>
                                {% include '@learning/dueWork/plagscanLink.twig' %}
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
</div>

{% if assessment.useRubric %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Marking Guide</h2>

        {% include '@rubric/grid-markable.twig' with {rubric: rubricContext.rubric, markType: rubricContext.markType} only %}
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Feedback</h2>
    </div>
</div>
<div class="row" id="assessment-status">
    <div class="small-12 island">
        <section>
            <ul class="information-list">
                <li>
                    <div class="small-12 columns">
                        {% include '@learningMarkScheme/'~markScheme~'.twig' with {
                            markScheme: assessment.markScheme,
                            fbUrl: routeLookup('learningFeedback.postResponseFeedback', {
                                assessmentId: assessment.id,
                                studentId: response.submittedOnBehalfOf.id,
                                responseId: response.id
                            })
                        } %}
                    </div>
                </li>
            </ul>
        </section>
    </div>
</div>
<div class="row">
    <div class="small-12 columns">
        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
    </div>
</div>

<script src="/javascript/shared/submissions/jquery.combobox.js" type="text/javascript"></script>
<div class="toast" data-alert data-save-draft></div>

{% include '@learningFeedback/dynamicFeedback.twig' %}