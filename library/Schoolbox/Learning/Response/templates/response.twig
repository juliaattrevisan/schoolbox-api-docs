{# Inline Grader for a particular Response

This lets you create Associated Feedback along with grade, comment and assorted feedback files etc.

TODO - This is DW-only. Should be in the DueWork Response namespace, or named more appropriately.

Usage:
    assessment        DueWork\Model                  The DueWork being assessed
    breadcrumbs       Collection|string[][]          An array of label + URL pairs
    response          null|DueWork\Submission
    latestFeedback    null|DueWork\Feedback
    attachzone        array
    selectedFileHash  string
    markScheme        string
    carousel          StudentCarousel
    submissionStates  Collection|DueWork_Error[]
    responseList      Collection|DueWork\Submission
    file              null|File\Model
    subfragment       null|string[]
    errors            string[]
    participant       Participant
    plagscanEnabled   bool
    rubricContext     null|array
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learning/macro/dueDate.twig' as dueDate %}

{{ bread.crumbsArray(breadcrumbs) }}

{% include '@learningResponse/inlineGrading/participantCarousel.twig' with {
    carousel:    carousel,
    participant: participant
} only %}

{% set deleteRoute = routeLookupIfAuthorized('learningResponse.deleteParticularResponse', { assessmentId: assessment.id, responseId: response.id, response: response }) %}

<script type="text/javascript" src='/javascript/shared/submissions/jquery.dynamic-feedback.js'></script>
<script type="text/javascript">
    $(function() {
        var nextUrl = findNext(tgt);

        $.fn.dynamicFeedback({
            errors: {{ errors | json_encode | raw }},

            onPublishCallback: function() {
                {# Go to next available person in the carousel
                 # If there is nobody, just visit Status screen
                 #}
                window.location.href = nextUrl.data('value') !== undefined
                    ? nextUrl.data('value')
                    : '{{ routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id}) }}';
            }
        });

        {# When a different response is selected from dropdown, navigate to its URL #}
        $('#response-selector').change(function(event) {
            event.preventDefault();
            window.location.href = $(this).find('option:selected').attr('data-url');
        });

        {% if deleteRoute %}
        $('#header-options').find('[data-delete]').on('click', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                header: 'Delete Submission',
                format: 'html',
                text: 'Are you sure you want to delete this submission? Anything attached to it will also be deleted.',
                confirmLabel: 'Delete',
                cancelLabel: 'Cancel',
                confirmEvent: function() {

                    // A toast
                    var $toast = $('#toaster');
                    $toast.toastActivate({text: 'Deleting submission...'});

                    $.ajax(element.data('delete'), {
                        headers: {
                            'X-HTTP-Method-Override': 'DELETE'
                        },
                        dataType: 'json',
                        type: 'POST'
                    })
                    .done(function () {

                        {# If there are no submissions remaining, go to next person
                         # Otherwise just refresh screen
                         #}
                        var destination;
                        if ($('#response-selector').find('option').length < 2) {
                            if (nextUrl.data('value') !== undefined) {
                                destination = nextUrl.data('value');
                            }
                            else {
                                destination = '{{ routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id}) }}'
                            }
                        }
                        else {
                            {# Reload summary screen to find what is now the most
                             # recent submission
                             #}
                            destination = '{{ routeLookup('learningResponse.getParticularResponse', {assessmentId: assessment.id, studentId: participant.user.id}) }}'
                        }

                        {# Go to next available person in the carousel
                         # If there is nobody, just visit Status screen
                         #}
                        window.location.href = destination;
                    })
                    .fail(function () {
                        $toast.toastTimeout({
                            text: 'Could not delete this submission',
                            css: 'pop alert'
                        });
                    })
                }
            });
        });
        {% endif %}
    });
</script>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ locale.grading.proper }} {{ assessment.title }}</h1>
            <ul class="meta">
                <li class="icon-calendar">{{ dueDate.dueDate(assessment, participant.user) }}</li>
                <li class="icon-due-work"><a href="/homepage/{{ assessment.context.id }}">{{ assessment.context.title }}</a> {{ assessment.typeName }}</li>
                {% if responseList|length == 1 %}
                <li class="icon-calendar">Submitted {{ response.submittedAt.short }}</li>
                {% endif %}
            </ul>
        </div>
    </div>
    {% if response and deleteRoute %}
    <nav>
        <a class="icon-more" title="" data-dropdown="header-options"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        <li><a class="icon-delete" data-delete="{{ deleteRoute }}">Delete Submission</a></li>
    </ul>
    {% endif %}
</div>



{% if responseList|length > 1 %}
<div class="row">
    <div class="small-12 columns">
        <select id="response-selector" title="Select a Submission">
            {% for currentResponse in responseList %}
                {% set viewRoute = routeLookupIfAuthorized('learningResponse.getParticularResponse', {assessmentId: assessment.id, studentId: participant.user.id, responseId: currentResponse.id, response: currentResponse}) %}

                {% if viewRoute %}
                <option value="{{ currentResponse.id }}" {% if currentResponse.id == response.id %}selected="selected"{% endif %} data-url="{{ viewRoute }}">#{{ loop.revindex }}. Submission at {{ currentResponse.submittedAt.local }}</option>
                {% endif %}
            {% endfor %}
        </select>
    </div>
</div>
{% endif %}

{% if response and file %}
    {% include '@learningResponse/inlineGrading/strategy/' ~ subfragment.strategy with {data: subfragment.data} %}
{% endif %}

{% if response and response.allFiles.count %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Files</h2>
        <ul class="inline-grader-filelist grid small-block-grid-1 medium-block-grid-2">
            {% for currentFile in response.allFiles %}
                {% set selected = '' %}
                {% set defaultSelectedFile = selectedFileHash|length == 0 and loop.index0 == 0 %}
                {% set hasSelectedFile = selectedFileHash|length and currentFile.hash == selectedFileHash %}

                {% if hasSelectedFile or defaultSelectedFile %}
                    {% set selected = 'selected' %}
                {% endif %}

                <li class="actions-small-2 {{ selected }} inline-grader-file">
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="{{ routeLookup('learningResponse.getParticularResponse', {assessmentId: response.assessable.id, studentId: response.submittedOnBehalfOf.id, responseId: response.id, response: response}) }}?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}">
                                <img src="/ajax/mime/{{ currentFile.mime }}" alt="Download" class="mime" />
                                <p>{{ currentFile.filename }}</p>
                                {% include '@learning/dueWork/plagscan/status.twig' %}
                            </a>
                        </div>
                    </div>
                    <nav>
                        {% include '@learning/dueWork/plagscan/link.twig' with {assessment: assessment, response: response, plagscan: currentFile.plagscan} only %}
                        <a class="icon-download" title="" data-dropdown="download-options-{{ currentFile.id }}"></a>
                    </nav>
                    <ul id="download-options-{{ currentFile.id }}" class="f-dropdown" data-dropdown-content>
                        <li>
                            {% include '@learningResponse/crocodocLink.twig' with {assessment: assessment, feedback: latestFeedback, file: currentFile, participant: participant, linkText: 'Download annotated document'} only %}
                        </li>
                        <li>
                            <a href="/storage/fetch.php?hash={{ currentFile.hash }}" class='icon-download' title="Download original">Download original</a>
                        </li>
                    </ul>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Feedback</h2>
    </div>
</div>
<div class="row mark-scheme" id="assessment-status" data-participant>
    <div class="small-12 island">
        <section class="content">

            <form method="post" data-feedback-form action="{{ routeLookup('learningFeedback.postResponseFeedback', {assessmentId: assessment.id, studentId: participant.user.id, responseId: response.id, participant: participant}) }}">
                <input type="hidden" name="responseId" value="{{ response.id }}" />

                <div class="row">

                    {% if assessment.useRubric and rubricContext %}
                        <div class="small-12 island">
                            {% include '@rubric/grid-markable.twig' with {
                                rubric:   rubricContext.rubric,
                                markType: rubricContext.markType
                            } only %}
                        </div>

                        <script type="text/javascript">
                            $(function () {

                                // cache this stuff, it doesn't change
                                var $status                 = $('#assessment-status'),
                                    $markInput              = $status.find('[data-mark-input]'),
                                    $assignFromRubricButton = $('#use-rubric-value'),
                                    $rb                     = $('#rb-{{ rubricContext.rubric.id }}'),
                                    $finalSummary           = $rb.find('[data-final-summary]');


                                function refreshAssignFromRubricButton() {
                                    var currentRubricValue = $.trim($finalSummary.text());
                                    var currentMarkInput   = $markInput.val();

                                    $assignFromRubricButton.prop('disabled', currentRubricValue === currentMarkInput);
                                }


                                {##
                                 # Use the rubric value in the mark input field
                                 #
                                 # Disabled upon load, since values are the same
                                 # at this point in time. Also disables when copying
                                 # the rubric mark value in.
                                 #}
                                $assignFromRubricButton.on('click', function(e) {

                                    e.preventDefault();
                                    $(this).prop('disabled', true);

                                    $status
                                        .find('[data-mark-input]')
                                        .val($.trim($finalSummary.text()))
                                        .change();
                                });

                                // listen for this
                                $rb.on('change', '[data-rubric], [data-rubric-group]', refreshAssignFromRubricButton);
                                $markInput.on('change', refreshAssignFromRubricButton);

                                // do it on pageload anyway
                                refreshAssignFromRubricButton();
                            });
                        </script>
                    {% endif %}

                    {% if 'none' != assessment.markType.slug %}
                        <div class="small-12 medium-3 column">
                            <label>{{ locale.grades.proper }}
                                {% include '@learningMarkScheme/'~markScheme~'.twig' with {
                                    participant: participant,
                                    markScheme:  assessment.markScheme,
                                    tabIndex:    1
                                } only %}
                            </label>

                            {% if assessment.useRubric and rubricContext %}
                                <p><button id="use-rubric-value" class="full-width">Assign {{ locale.grades.proper }} from Rubric</button></p>
                            {% endif %}
                        </div>
                    {% endif %}

                    <div class="small-12{% if 'none' != assessment.markType.slug %} medium-9{% endif %} column">
                        {% include '@learningMarkScheme/fragments/comment.twig' with {
                            participant: participant,
                            tabIndex:    2
                        } only %}
                    </div>

                    {# Maybe files may be uploaded here? #}
                    {% if attachzone %}
                        <div class="small-12 columns">
                            {% include 'sub/attachzone.twig' with {attachzone: attachzone} only %}
                        </div>
                    {% endif %}

                    <div class="small-12 column no-pad">
                        <div class="component-action" data-action-bar="{{ participant.user.id }}" {% if latestFeedback.published %}data-published="true"{% endif %} style="{{ actionStyle }}">
                            <section>
                                {% if participant.allFeedbacks | length and not participant.findMostRecentFeedback.published %}
                                    {% set savedStatusText = 'Saved as Draft' %}
                                {% endif %}

                                <div>
                                    {%- spaceless %}
                                        <span class="button disabled" data-draft="drafted" title="You can discard this draft from the Grading Overview screen">{{ savedStatusText }}</span>
                                        <a class="button" data-draft="publish">Publish and Continue</a>
                                    {% endspaceless -%}
                                </div>
                            </section>
                        </div>
                    </div>
                </div>
            </form>
        </section>
    </div>
</div>

<script src="/javascript/shared/submissions/jquery.combobox.js" type="text/javascript"></script>
<div id='toaster' class="toast" data-alert data-save-draft></div>


