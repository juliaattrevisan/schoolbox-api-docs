<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.js"></script>
<script type="text/javascript">
    $(function() {
        var navNext = $('a[rel="next"]');
        var navPrev = $('a[rel="prev"]');
        var markInput = $('[name^="mark"]').not('[type=hidden]').eq(0);

        var tgt = $('select[name=student-select]'),
                ize,
                skipUnsubmitted = $('#skipUnsubmitted'),
                students = [{
                    "text": "Admin, Alaress",
                    "value": "\/submission\/inlineGrading\/view\/4\/19",
                    "html": "<div class=\"row\">    <div class=\"avatar card small-10\">        <img src=\"\/portrait.php?userId=485&size=square64\" alt=\"View Profile\" \/>        <p>Admin, Alaress<\/p>        <span class=\"label status unsubmitted\">Not Submitted<\/span>    <\/div><\/div>",
                    "unsubmitted": true
                }, {
                    "text": "Albert, Julia",
                    "value": "\/submission\/inlineGrading\/view\/4\/10",
                    "html": "<div class=\"row\">    <div class=\"avatar card small-10\">        <img src=\"\/portrait.php?userId=313&size=square64\" alt=\"View Profile\" \/>        <p>Albert, Julia<\/p>        <span class=\"label status submitted\">Submitted on Time<\/span>    <\/div>    <div class=\"small-2 columns\">        <span class=\"progress-tick no-text complete\" title=\"Marked 31\/07\/2012 9:50am\"><\/span>    <\/div><\/div>",
                    "unsubmitted": false
                }, {
                    "text": "Berryhill, Scott",
                    "value": "\/submission\/inlineGrading\/view\/4\/15",
                    "html": "<div class=\"row\">    <div class=\"avatar card small-10\">        <img src=\"\/portrait.php?userId=280&size=square64\" alt=\"View Profile\" \/>        <p>Berryhill, Scott<\/p>        <span class=\"label status unsubmitted\">Not Submitted<\/span>    <\/div><\/div>",
                    "unsubmitted": true
                }, {
                    "text": "Salem, Bobby",
                    "value": "\/submission\/inlineGrading\/view\/4\/31",
                    "html": "<div class=\"row\">    <div class=\"avatar card small-10\">        <img src=\"\/portrait.php?userId=169&size=square64\" alt=\"View Profile\" \/>        <p>Salem, Bobby<\/p>        <span class=\"label status unsubmitted\">Not Submitted<\/span>    <\/div><\/div>",
                    "unsubmitted": true
                }],
                selectizeOptions = {
                    preload: true,
                    closeAfterSelect: false,
                    options: students,
                    render: {
                        option: function (item) {
                            item.disabled = skipUnsubmitted.is(':checked') && item.unsubmitted;
                            return $('<div/>').html(item.html).html();
                        },
                        item: function (item) {
                            return $('<div/>').html(item.html).html();
                        }
                    }
                };

        ize = tgt.selectize(selectizeOptions);

        // hack, option not available
        $('.selectize-input input').prop('disabled', true).hide();

        // manually set the value, because selectize
        ize[0].selectize.setValue("/submission/inlineGrading/view/4/19", true);

        // add the listener AFTER we've set the value
        ize.on('change', function (e) {
            window.location.href = e.target.value;
        });

        function refreshNav(nav, source) {
            if (source.length) {
                nav.attr('href', source.data('value'))
                    .attr('title', source.children('img').attr('alt'))
                    .removeAttr('disabled');
            } else {
                nav.removeAttr('href')
                    .removeAttr('title')
                    .attr('disabled', 'disabled');
            }
        }
    });
</script>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Grading {{ assessment.title }}</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-8 columns">
        <div class="avatar-switch">
            <nav>
                <a rel="prev" href="" title=""></a>
            </nav>
            <div class="student">
                <select name="student-select"></select>
            </div>
            <nav>
                <a rel="next" href="" title=""></a>
            </nav>
        </div>
    </div>
    <div class="small-12 medium-4 columns">
        <form action="/submission/inlineGrading/configForm.php" method="post">
            <input type="hidden" name='boxId' value="{BOX_ID}" />
            <input type="hidden" name="userId" value="{INLINE_GRADING_STUDENT_ID}" />
            <input type="hidden" name="skipUnsubmitted" value="0" />
            <input type="checkbox" name="skipUnsubmitted" id="skipUnsubmitted" {SKIP_UNSUBMITTED_CHECKED} value='1' />
            <label for="skipUnsubmitted" class="checkbox-label">Skip not submitted</label>
        </form>
    </div>
</div>

{% include '@learningResponse/inlineGrading/strategy/' ~ subfragment.strategy with {data: subfragment.data} %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Files</h2>
        <section>
            {% if response.allFiles %}
                <ul class="inline-grader-filelist grid small-block-grid-1 medium-block-grid-2 large-block-grid-3">
                    {% for currentFile in response.allFiles %}
                        <li class="actions-small-1 {% if currentFile.id == selectedFileId %}selected{% endif %}">
                            <div class="list-item">
                                <div class="card small-12 compact">
                                    <a href="{{ routeLookup('learningResponse.getParticularResponse', {responseId: response.id}) }}?fileId={{ currentFile.id }}" title="{{ currentFile.filename }}">
                                        <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" class="mime" />
                                        <p>{{ currentFile.filename }}</p>

                                        {% include '@learning/dueWork/plagscan.twig' %}
                                    </a>
                                </div>
                            </div>
                            <nav>
                                {% include '@learning/dueWork/plagscanLink.twig' %}
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Feedback</h2>
    </div>
</div>
<div class="row">
    <div class="small-12 columns">
        [grading options and dropdowns etc]
        <textarea cols="100" rows="5">Comments and stuff</textarea>
    </div>
    <div class="small-12 columns">
        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
    </div>
</div>
