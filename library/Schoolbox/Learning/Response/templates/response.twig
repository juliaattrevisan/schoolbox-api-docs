{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learning/macro/urgency.twig' as urgency %}

{{ bread.crumbs(
    ['Learning', routeLookup('learning.getClasses')],
    ['Markbook', routeLookup('learningMarkbook.getMarkbook', {classId: assessment.context.id})],
    [assessment.title, routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id})],
    ['Timeline', routeLookup('learningResponse.getResponseList', {assessmentId: assessment.id, studentId: response.submittedOnBehalfOf.id})],
    ['Inline Grader', null]
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Grading {{ assessment.title }}</h1>
            <ul class="meta">
                <li class="icon-calendar">Due <span class="{{ urgency.datetime(assessment, response.submittedOnBehalfOf) }}">{{ assessment.dueAt.short }}</span></li>
                <li class="icon-due-work"><a href="/homepage/{{ assessment.context.id }}">{{ assessment.context.title }}</a> {{ assessment.typeName }}</li>
            </ul>
        </div>
    </div>
</div>

{% include '@learningResponse/inlineGrading/participantCarousel.twig' %}

{% include '@learningResponse/inlineGrading/strategy/' ~ subfragment.strategy with {data: subfragment.data} %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Files</h2>
        <section>
            {% if response.allFiles %}
                <ul class="inline-grader-filelist grid small-block-grid-1 medium-block-grid-2 large-block-grid-3">
                    {% for currentFile in response.allFiles %}
                        {% set selected = '' %}
                        {% set defaultSelectedFile = selectedFileHash|length == 0 and loop.index0 == 0 %}
                        {% set hasSelectedFile = selectedFileHash|length and currentFile.hash == selectedFileHash %}

                        {% if hasSelectedFile or defaultSelectedFile %}
                            {% set selected = 'selected' %}
                        {% endif %}

                        <li class="actions-small-1 {{ selected }}">
                            <div class="list-item">
                                <div class="card small-12 compact">
                                    <a href="{{ routeLookup('learningResponse.getParticularResponse', {assessmentId: response.assessable.id, responseId: response.id}) }}?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}">
                                        <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" class="mime" />
                                        <p>{{ currentFile.filename }}</p>

                                        {% include '@learning/dueWork/plagscan.twig' %}
                                    </a>
                                </div>
                            </div>
                            <nav>
                                {% include '@learning/dueWork/plagscanLink.twig' %}
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
</div>

{% if assessment.useRubric %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Marking Guide</h2>

        {% include '@rubric/grid-markable.twig' with {rubric: rubricContext.rubric, markType: rubricContext.markType} only %}
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Feedback</h2>
    </div>
</div>
<div class="row" id="assessment-status">
    <div class="small-12 island">
        <section>
            <ul class="information-list">
                <li>
                    <div class="small-12 columns">
                        {% include '@learningMarkScheme/'~markScheme~'.twig' with {markScheme: assessment.markScheme} %}
                    </div>
                </li>
            </ul>
        </section>
    </div>
</div>
<div class="row">
    <div class="small-12 columns">
        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
    </div>
</div>

<script src="/javascript/shared/submissions/jquery.combobox.js" type="text/javascript"></script>
<div class="toast" data-alert data-save-draft></div>
<script type="text/javascript">
    $(function () {

        var formSaveLabel  = $('[data-save-draft]');
        var assessmentList = $('#assessment-status');
        var filters        = $('#filters');
        var tt;

        // setup pre-values
        assessmentList.find(':input').each(function () {
            // stash the current state, so we can compare on blur and prevent unnecessary firing
            $(this).data('preval', $(this).val());
        });

        $('[data-combobox]').combobox({{ errors | json_encode | raw }});

        assessmentList
                .on('keydown paste keypress', 'textarea', timeoutUpdate)
                .on('change', ':input', timeoutUpdate)
                .on('blur', ':input', doASaveActionNao);


        function doASaveActionNao() {
            // do a preval comparison to find out if we can skip AJAX
            if ($(this).val() == $(this).data('preval')) {
                return;
            }

            // update the pre-value
            $(this).data('preval', $(this).val());

            var $form = $(this).closest('form');

            var data = {
                type: $form.attr('method'),
                dataType: 'json',
                data: $form.serializeArray()
            };

            $form.find('[data-draft]').attr('disabled', 'disabled');
            $form.find('[data-draft="drafted"]').text('Saving...');

            formSaveLabel.toastActivate({
                text: 'Autosaving'
            });

            $.ajax($form.attr('action'), data)
                    .done(function () {
                        toast.apply($form);

                        var $li = $form.closest('[data-status]');

                        $li.attr('data-status', '{{ statusComplete }}');

                        $li.find('[data-status]')
                                .removeClass('{{ statusIncomplete }} {{ statusPending }}')
                                .addClass('{{ statusComplete }}');

                        filters.find('[data-status="complete"]').prop('checked', true);
                        $form.find('[data-draft="drafted"]').text('Saved as Draft');
                    })
                    .fail(function (xhr) { toast.call($form, xhr.responseText, false); })
                    .always(function () {
                        $form.find('[data-draft=publish]').removeAttr("disabled");
                    });
        }

        function timeoutUpdate() {
            var input = this;
            window.clearTimeout(tt);

            tt = window.setTimeout(function () {
                doASaveActionNao.apply(input);
            }, 600);

            if ($(this).val() == $(this).data('preval')) {
                return;
            }

            var $form = $(this).closest('form');
            $form.find('[data-interaction-draft]').slideDown();
        }

        function toast(text, success) {

            formSaveLabel.toastTimeout({
                text: text || 'Draft Saved',
                css: (success == false) ? 'alert' : 'success'
            });

            this.find('[data-interaction-draft]').slideDown();
        }

        assessmentList.on('click', '[data-draft="publish"]', function (e) {
            e.preventDefault();

            var $form      = $(this).closest('form'),
                    $actionBar = $form.find('[data-interaction-draft]');

            var $btnDrafted = $actionBar.find('[data-draft=drafted]'),
                    $btnPublish = $actionBar.find('[data-draft=publish]');

            $btnPublish.attr('disabled', 'disabled').text('Publishing...');

            $.ajax($form.attr('action'), {
                dataType: 'json',
                data:  { publish: 1 },
                type: 'post'
            }).done(function () {
                $form.find('[data-interaction-draft]').slideUp(function () {
                    $btnPublish.text('Publish');
                    $btnDrafted.text('');
                });

            }).fail(function (xhr) {
                toast.call($form, xhr.responseText, false);
                $btnPublish.removeAttr('disabled').text('Publish');

            }).always(function () {

            });
        })

    });
</script>
