{# Inline Grader for a particular Response
 #
 # This lets you create Associated Feedback along with grade, comment and
 # assorted feedback files etc.
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learning/macro/urgency.twig' as urgency %}

{# Conditional bread?? -_-
 #}
{% if assessment.context is project %}
    {% set nodes = [
        ['Learning', routeLookup('learning.getClasses')],
        ['Markbook', routeLookup('learningMarkbook.getMarkbook', {classId: assessment.context.folder.id})],
        [assessment.context.title, routeLookup('learningAssessment.getSummary', {assessmentId: assessment.context.id, studentId: response.submittedOnBehalfOf.id}) ],
        [assessment.title, routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id})],
        ['Inline Grader']
    ] %}
{% else %}
    {% set nodes = [
        ['Learning', routeLookup('learning.getClasses')],
        ['Markbook', routeLookup('learningMarkbook.getMarkbook', {classId: assessment.context.id})],
        [assessment.title, routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id})],
        ['Inline Grader'],
    ] %}
{% endif %}

{{ bread.crumbsArray(nodes)}}

{% include '@learningResponse/inlineGrading/participantCarousel.twig' %}

<script type="text/javascript" src='/javascript/shared/submissions/jquery.dynamic-feedback.js'></script>
<script type="text/javascript">
    $(function() {
        var nextUrl = findNext(tgt);

        $.fn.dynamicFeedback({
            errors: {{ errors | json_encode | raw }},
            statusIncomplete: '{{ statusIncomplete }}',
            statusPending: '{{ statusPending }}',
            statusComplete: '{{ statusComplete }}',

            {# Special behaviour of the Publish button on this screen
             # Publishing on this screen should be synonymous with the
             # old "Save And Continue" behaviour
             #}
            publishText: 'Publish And Continue',

            onPublishCallback: function() {
                var destination = '';

                if (nextUrl.data('value') != undefined) {
                    destination = nextUrl.data('value');
                }
                else {
                    destination = '{{ routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id}) }}'
                }

                {# Go to next available person in the carousel
                 # If there is nobody, just visit Status screen
                 #}
                window.location.href = destination;
            }
        });

        {# Go to the happy place
         #}
        $('#response-selector').change(function(event) {
            event.preventDefault();

            window.location.href = $(this).find('option:selected').attr('data-url');
        });
    });
</script>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Grading {{ assessment.title }}</h1>
            <ul class="meta">
                <li class="icon-calendar">Due <span class="{{ urgency.datetime(assessment, participant.user) }}">{{ assessment.dueAt.short }}</span></li>
                <li class="icon-due-work"><a href="/homepage/{{ assessment.context.id }}">{{ assessment.context.title }}</a> {{ assessment.typeName }}</li>
            </ul>
        </div>
    </div>
</div>

{% if responseList|length > 1 %}
<div class="row">
    <div class="small-12 columns">
        <select id="response-selector">
            {% for currentResponse in responseList %}
                {% set viewRoute = routeLookupIfAuthorized('learningResponse.getParticularResponse', {assessmentId: assessment.id, studentId: participant.user.id, responseId: currentResponse.id}) %}

                {% if viewRoute %}
                <option value="{{ currentResponse.id }}" {% if currentResponse.id == response.id %}selected="selected"{% endif %} data-url="{{ viewRoute }}">#{{ loop.revindex }}. Submission at {{ currentResponse.submittedAt.local }}</option>
                {% endif %}
            {% endfor %}
        </select>
    </div>
</div>
{% endif %}

{% if response and file %}
    {% include '@learningResponse/inlineGrading/strategy/' ~ subfragment.strategy with {data: subfragment.data} %}
{% endif %}

{% if response and response.allFiles.count %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Files</h2>
            <ul class="inline-grader-filelist grid small-block-grid-1 medium-block-grid-2 large-block-grid-3">
                {% for currentFile in response.allFiles %}
                    {% set selected = '' %}
                    {% set defaultSelectedFile = selectedFileHash|length == 0 and loop.index0 == 0 %}
                    {% set hasSelectedFile = selectedFileHash|length and currentFile.hash == selectedFileHash %}

                    {% if hasSelectedFile or defaultSelectedFile %}
                        {% set selected = 'selected' %}
                    {% endif %}

                    <li class="actions-small-1 {{ selected }}">
                        <div class="list-item">
                            <div class="card small-12 compact">
                                <a href="{{ routeLookup('learningResponse.getParticularResponse', {assessmentId: response.assessable.id, responseId: response.id}) }}?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}">
                                    <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" class="mime" />
                                    <p>{{ currentFile.filename }}</p>

                                    {% include '@learning/dueWork/plagscan/status.twig' %}
                                </a>
                            </div>
                        </div>
                        <nav>
                            {% include '@learning/dueWork/plagscan/link.twig' with {assessment: assessment, response: response, plagscan: currentFile.plagscan} only %}
                        </nav>
                    </li>
                {% endfor %}
            </ul>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Feedback</h2>
    </div>
</div>
<div class="row" id="assessment-status">
    <div class="small-12 island">
        <section class="content">
            {% include '@learningMarkScheme/'~markScheme~'.twig' with {
                markScheme: assessment.markScheme,
                fbUrl: routeLookup('learningFeedback.postResponseFeedback', {
                    assessmentId: assessment.id,
                    studentId: participant.user.id,
                    responseId: response.id
                }),
                feedbackAttachzone: attachzone
            } %}
        </section>
    </div>
</div>

<script src="/javascript/shared/submissions/jquery.combobox.js" type="text/javascript"></script>
<div class="toast" data-alert data-save-draft></div>

