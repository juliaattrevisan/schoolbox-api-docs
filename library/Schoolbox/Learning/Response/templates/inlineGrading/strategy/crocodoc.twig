<script src="/javascript/shared/jquery.responsive-iframe.js"></script>
<script type="text/javascript">
    $(function() {

        /**
         * Resize iframe dynamically ("responsively")
         */
        $.fn.responsiveIframe({
            onLoad: function() {
                $('#inline-grader-viewport').height($(window).height() * 0.40);
            },
            onResize: function() {
                $('#inline-grader-viewport').height($(window).height() * 0.40);
            }
        });
    });
</script>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h2 class="subheader">Document Preview</h2><h1></h1>
        </div>
    </div>
    <nav>
        <a href="{{ routeLookup('learningResponse.getCrocodocDownload', {responseId: response.id, fileId: file.id}) }}" class="icon-download" title="Download Annotated Document"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 columns">
        <iframe id="inline-grader-viewport" src="{{ data.url }}" frameborder="0"></iframe>
    </div>
</div>
