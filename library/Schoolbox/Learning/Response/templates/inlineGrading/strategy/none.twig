<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Download File</h2>
        <section>
            <div class="content">
                <p class="no-margin">
                    Sorry, we are unable to preview this file. Download it below:
                </p>
            </div>
            <ul class="action-list">
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 card">
                            <a href="/storage/fetch.php?hash={{ file.storage.hash }}" data-plugin="preview" title="">
                                <img src="/images/mime/60x60/{{ file.storage.mimetype.iconFile }}" class="mime" alt="" />
                                <p>{{ file.storage.filename }}</p>
                            </a>
                            <p class="meta">{{ file.storage.humanReadableSize }}</p>

                            <a href="{SITE_ROOT}/modules/remote/{MOST_RECENT_SUBMISSION_FILE_PLAG_HREF}">
                                {% include '@learning/dueWork/plagscan.twig' with {currentFile: file} %}
                            </a>
                        </div>
                    </div>
                    <nav>
                        <a href="/submission/send.php?id={MOST_RECENT_SUBMISSION_FILE_ID}&save=1" class="icon-download" title="Download"></a>
                    </nav>
                </li>
            </ul>
        </section>
    </div>
</div>