<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Video</h2>
        <section>
            {% if data.video.isComplete %}
                <script type="text/javascript">
                    $(function() {
                        $("#video").mediaelementplayer().data('mediaelementplayer');
                    });
                </script>
                <video id="video"
                       controls
                       preload="none"
                       poster="/cms/videoThumb.php?type=submission&id={{ data.video.hash }}&size=poster"
                       height="400"
                       width="100%">
                    <source src="/cms/sendVideo.php?type=submission&id={{ data.video.hash }}" type='video/mp4'>
                </video>
            {% else %}
                <div class="content">
                    <div class="row">
                        <div class="card small-12">
                            <img src="{INJECTABLE_AUDIO_STATUS_SRC}" alt="Video Processing" />
                            <p>{INJECTABLE_AUDIO_STATUS_MSG}</p>
                        </div>
                    </div>
                </div>
            {% endif %}
        </section>
    </div>
</div>
