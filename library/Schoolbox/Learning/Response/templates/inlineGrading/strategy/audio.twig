<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Audio</h2>

        {% if data.audio.isComplete %}
            <section>
                <script type="text/javascript">
                    $(function() {
                        $("#audio").mediaelementplayer().data('mediaelementplayer');
                    });
                </script>
                <audio id="audio" controls preload="none" width="100%">
                    <source src="/cms/sendVideo.php?type=submission&id={{ data.audio.hash }}" type='audio/mp3'>
                </audio>
            </section>
        {% elseif data.audio.isPending or data.audio.isProcessing %}
            <div class="empty-state">
                <div class="loader"></div>
                <p>We are currently processing this audio.</p>
                <p>It will be ready to play later.</p>
            </div>
        {% else %}
            <section>
                <ul class="action-list">
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="small-12 card">
                                <p>Sorry, we are unable to process this audio. Please download the audio to watch.</p>
                            </div>
                        </div>
                        <nav>
                            <a href="/storage/fetch.php?hash={{ data.hash }}" class="icon-download" title="Download"></a>
                        </nav>
                    </li>
                </ul>
            </section>
        {% endif %}
    </div>
</div>