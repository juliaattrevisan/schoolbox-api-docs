{##
 # Student Selector Carousel
 #
 # Cycle through students participating in an $assessment
 #
 # @param array allPeople - an array of people who populate the selector
 # @param string currentPerson - the responseList url for the current response's submittedOnBehalfOf
 # @param DueWork assessment - the assessment to which this Submission belongs
 #}
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.js"></script>
<script type="text/javascript">
    $(function() {
        var navNext = $('a[rel="next"]');
        var navPrev = $('a[rel="prev"]');
        var markInput = $('[name^="mark"]').not('[type=hidden]').eq(0);

        var tgt = $('select[name=student-select]'),
                ize,
                skipUnsubmitted = $('#skipUnsubmitted'),
                students = {{ carousel.allPeople|json_encode|raw }},
                selectizeOptions = {
                    preload: true,
                    closeAfterSelect: false,
                    options: students,
                    render: {
                        option: function (item) {
                            item.disabled = skipUnsubmitted.is(':checked') && item.unsubmitted;
                            return $('<div/>').html(item.html).html();
                        },
                        item: function (item) {
                            return $('<div/>').html(item.html).html();
                        }
                    }
                };

        ize = tgt.selectize(selectizeOptions);

        // hack, option not available
        $('.selectize-input input').prop('disabled', true).hide();

        // manually set the value, because selectize
        ize[0].selectize.setValue("{{ carousel.currentPerson }}", true);

        // add the listener AFTER we've set the value
        ize.on('change', function (e) {
            window.location.href = e.target.value;
        });

        function refreshNav(nav, source) {
            if (source.length) {
                nav.attr('href', source.data('value'))
                        .attr('title', source.children('img').attr('alt'))
                        .removeAttr('disabled');
            } else {
                nav.removeAttr('href')
                        .removeAttr('title')
                        .attr('disabled', 'disabled');
            }
        }

        skipUnsubmitted.change(function (event) {
            var ize = tgt[0].selectize,
                    skip = $(this).is(':checked') ? 1 : 0,
                    form = $(this).closest('form');

            // clear the selectize render cache
            ize.renderCache.option = {};

            ize.refreshOptions(false);

//            // fire an ajax to persist the "skip_unsubmitted" state for this box...because reasons...
//            var boxId = form.find('input[name=boxId]').val();
//
//            $.post(form.attr('action'), { boxId: boxId, skipUnsubmitted: skip });

            var val = ize.getOption(ize.getValue());

            var nextUrl = ize.getAdjacentOption(val, 1);
            var prevUrl = ize.getAdjacentOption(val, -1);

            refreshNav(navNext, nextUrl);
            refreshNav(navPrev, prevUrl);

//            // Form redirect points to next option, or home if no option selected
//            if (nextUrl.length > 0) {
//                nextUrl = nextUrl.data('value');
//            } else {
//                nextUrl = '/submission/viewSubmission/' + String(boxId);
//            }
//
//            returnWorkForm.find('input[name="redirect"]').val(nextUrl)

        }).trigger('change');
    });
</script>
<div class="row">
    <div class="small-12 medium-8 columns">
        <div class="avatar-switch">
            <nav>
                <a rel="prev" href="" title=""></a>
            </nav>
            <div class="student">
                <select name="student-select"></select>
            </div>
            <nav>
                <a rel="next" href="" title=""></a>
            </nav>
        </div>
    </div>
    <div class="small-12 medium-4 columns">
        <form action="/submission/inlineGrading/configForm.php" method="post">
            <input type="hidden" name='assessmentId' value="{{ assessment.id }}" />
            <input type="hidden" name="skipUnsubmitted" value="0" />
            <input type="checkbox" name="skipUnsubmitted" id="skipUnsubmitted" {% if assessment.submittedOnly %}checked="checked"{% endif %} value='1' />
            <label for="skipUnsubmitted" class="checkbox-label">Skip not submitted</label>
        </form>
    </div>
</div>