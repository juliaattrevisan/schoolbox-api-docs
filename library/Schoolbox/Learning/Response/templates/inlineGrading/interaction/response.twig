<li class="actions-small-1">
    {% include '@learning/dueWork/interaction/response/creator.twig' %}

    {% if response.allFiles %}
        <ul class="information-list">
            {% for currentFile in response.allFiles %}
                <li class="actions-small-1">
                    {% include '@learning/dueWork/interaction/response/files.twig' %}
                    <nav>
                        <a href="{{ routeLookup('learningResponse.getParticularResponse', {assessmentId: assessment.id, responseId: response.id}) }}?hash={{ currentFile.hash }}" class="icon-next" title="View in Inline Grader"></a>
                    </nav>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</li>
