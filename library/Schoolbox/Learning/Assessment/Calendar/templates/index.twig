{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(['Learning'], [locale.assessment.proper ~ ' Calendar']) }}
{% set reportContentId = 'calendarDataTODO' %}


{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        // Filtered content has been [re]loaded
        // (Shouldn't this trigger contain the filters that are selected?)
        $('#{{ reportContentId }}').on('filterContentLoaded', function (event, selectedFilters) {
            // Somehow pass the list of filters into the Vue calendar.
            // I guess put it in a global var, and then trigger some change
            // somewhere?
            console.log(selectedFilters);
        });
    });


    window.fullCalendarConfig = {
        // taskTypeId:         Number('{TASK_TYPE_ID}'),
        // sources:            {SOURCES_JSON},
        // eventTypes:         {EVENT_TYPES_JSON},
        // groups:             {GROUPS_JSON},
        // campuses:           {CAMPUSES_JSON},
        // selectedFilters:    {SELECTED_FILTERS_JSON},
        // defaultDate:        '{SELECTED_DATE}',
        // eventLimit:         Boolean('{CALENDAR_COLLAPSE_EVENTS}'),
        // firstDay:           Number('{CALENDAR_START_DAY}'),
        // defaultView:        anchorView || '{CALENDAR_VIEW}',
        dateDisplayFormats: dateDisplayFormats,
        // TODO This must be moved to Twig so these can be guaranteed to be escaped
        translations:       {
            eotc: {
                proper: '{TPL_LOCAL_EOTC_PC}'
            },
            dueWork: {
                proper: '{TPL_LOCAL_DUEWORK_PC}'
            }
        }
    };
</script>
{% endautoescape %}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ locale.assessment.proper }} Calendar</h1>
        <section class="content">
            {% include '@filters/panel.twig' with {
                contentId: reportContentId,
                panel:     filterPanel,
                quickload: true
            } only %}
        </section>

        <div id="{{ reportContentId }}">
            <div id="calendar"></div>
            <script type="text/javascript" src="/javascript/components/assessmentCalendar.bundle.js?v={SITE_VERSION}"></script>
        </div>
    </div>
</div>
