{#
Usage:
    filterPanel: FilterPanel - a filter panel that can filter and AJAX in calendar data
#}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(['Learning'], [locale.assessment.proper ~ ' Calendar']) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ locale.assessment.proper }} Calendar</h1>
        <section class="content">
            {% set reportContentId = 'calendarDataTODO' %}

            {% include '@filters/panel.twig' with {
                contentId: reportContentId,
                panel:     filterPanel,
                quickload: true
            } only %}
        </section>

        <div id="{{ reportContentId }}"></div>
    </div>
</div>
