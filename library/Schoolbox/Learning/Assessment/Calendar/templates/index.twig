{#
Usage:
    filterPanel: FilterPanel - a filter panel that can filter and AJAX in calendar data
#}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(['Learning'], [locale.assessment.proper ~ ' Calendar']) }}
{% set reportContentId = 'calendarDataTODO' %}


{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        // Filtered content has been [re]loaded
        // (Shouldn't this trigger contain the filters that are selected?)
        $('#{{ reportContentId }}').on('filterContentLoaded', function (event, selectedFilters) {
            // Somehow pass the list of filters into the Vue calendar
            window.assessmentCalendar.$children[0].onFilterChange(selectedFilters);
        });
    });

    window.fullCalendarConfig = {
        userId:              Number('{{ user.id }}'),
        eventLimit:          Boolean('{{ config.calendar_collapse_events }}'),
        firstDay:            Number('{{ config.calendar_start_day }}'),
        dateDisplayFormats:  dateDisplayFormats,
        schedulerLicenseKey: {{ config.fullcalendar_scheduler_license_key|json_encode|raw }},
        termDates:           {{ termDates|json_encode|raw }},
        eventTypes:          {{ eventTypes|json_encode|raw }}
    };
</script>
{% endautoescape %}

<div class="row">
    <div class="small-12 island">
        <h1>{{ locale.assessment.proper }} Calendar</h1>
        <div>
            {% include '@filters/panel.twig' with {
                contentId: reportContentId,
                panel:     filterPanel,
                quickload: true
            } only %}
        </div>

        <section id="{{ reportContentId }}">
            <div id="calendar"></div>
            <script type="text/javascript" src="/javascript/components/assessmentCalendar.bundle.js?v={{ config.site_version }}"></script>
        </section>
    </div>
</div>
