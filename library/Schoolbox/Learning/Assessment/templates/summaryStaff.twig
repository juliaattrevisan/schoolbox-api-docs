{# TODO: Replace with real breadcrumbs #}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ 'Learning',    '#' ],
[ 'Classname',   '#' ],
[ assessment.title,   routeLookup('learningAssessment.getSummaryParticipants', {assessmentId: assessment.id}) ],
[ student.getFullName,   '#' ]
) }}

<div class="row">
    <div class="small-12 island">
        <h1>{{ assessment.title }} - {{ student.getFullName }}</h1>

        {% include '@learningAssessment/fragments/project/timeline.twig' with {assessment: assessment, type: 'staff'} %}
        {% include '@learningAssessment/fragments/project/progress.twig' with {counts: counts} %}

        <h2 class="subheader">Assessables</h2>

        {% if assessment.assessables | length %}

            <section>
                <ul class="information-list">
                    {% for assessable in assessment.assessables %}
                        {% include '@learningAssessment/fragments/' ~ (assessable.typeName | lower) ~ '/card.twig' with {assessment: assessment, student: student, assessable: assessable, type: 'staff'} %}
                    {% endfor %}
                </ul>
            </section>

        {% else %}

            {# Nothing in the project, allow staff member to create #}

            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>Your project is empty.</p>
                <p>Add a
                    <a href="{{ routeLookup('learningAssessment.getCreateAssessmentWithinProject', {assessmentId: assessment.id, assessmentType: 'dueWork'}) }}" title="Create a new Due Work">Due Work</a>,
                    <a href="{{ routeLookup('learningAssessment.getCreateAssessmentWithinProject', {assessmentId: assessment.id, assessmentType: 'task'}) }}" title="Create a new Task">Task</a>, or
                    <a href="{{ routeLookup('learningAssessment.getCreateAssessmentWithinProject', {assessmentId: assessment.id, assessmentType: 'quiz'}) }}" title="Create a new Quiz">Quiz</a>
                </p>
            </div>
        {% endif %}
    </div>
</div>
