{# TODO: Replace with real breadcrumbs #}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ 'Learning',    '#' ],
[ 'Classname',   '#' ],
[ assessment.title,   '#' ]
) }}

<div class="row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        {% include '@learningAssessment/fragments/project/description.twig' with {assessment: assessment, type: 'staff'} %}

        <h2 class="subheader">Participants</h2>

        {% if assessment.allParticipants | length %}
        <section>
            <ul class="information-list">
                {% for participant in assessment.allParticipants %}
                    <li>
                        <div class="list-item">
                            <div class="card small-12">
                                <a href="{{ routeLookup('learningAssessment.getSummaryStaff', { assessmentId: assessment.id, studentId: participant.id}) }}">
                                    <img src="/portrait.php?userId={{ participant.externalId }}&size=square64" width="48">
                                    <h3>
                                        {{ participant.fullName }}
                                    </h3>
                                </a>
                                <p class="meta">
                                    {% if participant.year and participant.role.isStudent %}
                                        Year {{ participant.year }}
                                    {% endif %}
                                    {{ participant.role.name }}
                                </p>
                            </div>
                            <div class="progress">
                                <span class="meter" style="width:{{ counts[participant.id].totalCompleted / counts[participant.id].total * 100 }}%"></span>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}
    </div>
</div>
