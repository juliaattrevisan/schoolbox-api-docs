{#
    Renders an input where teachers can check whether the learner must resubmit.

    Usage: [
        participant:        Participant
        feedback:           IFeedback
        tabIndex:           int
        prefix:             string
    ]
#}

{% set prefix = prefix is defined ? prefix ~ '-' : '' %}
{% set inputId = 'resubmissionRequired-' ~ prefix ~ participant.user.id %}

<input type="checkbox"
       value="1"
       tabindex="{{ tabIndex }}"
       id="{{ inputId }}"
       name="resubmissionRequired"
       {% if readonly %}readonly{% endif %}
       {% if feedback.resubmissionRequired ?? false %}checked{% endif %}
/>
<label for="{{ inputId }}" class="checkbox-label">Resubmission required</label>
