{#
    Renders an input where teachers can insert feedback comment

    Usage: [
        participant:  Participant
        feedback:     IFeedback      If not set, participant.findMostRecentFeedback
        tabindex:     int
        readonly:     bool           Should textarea be rendered as readonly?
    ]
#}
{% if feedback is null %}
    {% set feedback = participant.findMostRecentFeedback %}
{% endif %}

<label>Comment
    <textarea
            tabindex="{{ tabIndex }}"
            name="comment"
            placeholder="{% if readonly %}(no comment given){% else %}Feedback for {{ participant.user.firstName }}{% endif %}"
            rows="3"
            {% if readonly %}readonly{% endif %}
    >{{ feedback.comment }}</textarea>
</label>
