{#
    Renders an input where teachers can insert feedback comment

    Usage: [
        participant:        Participant
        feedback:           IFeedback
        tabindex:           int
        readonly:           bool            Should textarea be rendered as readonly?
        selfAssessment:     bool            Is this being viewed in a self assessment context?
        selfReflection:     bool            Is this being viewed in a self reflection context?
        blindMode:          bool            If you're in Blind Mode, hide any identifying features
    ]
#}

{% if selfAssessment %}
    {% set placeholder = 'Your ' ~ locale.selfAssessment %}
{% elseif selfReflection %}
    {% set placeholder = 'Your ' ~ locale.selfReflection %}
{% elseif readonly %}
    {% set placeholder = '(no comment given)' %}
{% elseif blindMode %}
    {% set placeholder = 'Feedback' %}
{% else %}
    {% set placeholder = 'Feedback for ' ~ participant.user.givenName %}
{% endif %}

<label>Comment
    <textarea
            tabindex="{{ tabIndex }}"
            id="comment-{{ participant.user.id }}" name="comment"
            placeholder="{{ placeholder }}"
            rows="3"
            {% if readonly %}readonly{% endif %}
    >{{ feedback is not null ? feedback.comment : ''}}</textarea>
</label>
