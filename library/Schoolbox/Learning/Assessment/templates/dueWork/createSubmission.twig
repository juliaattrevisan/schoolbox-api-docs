{#
Data:
    breadcrumbs:    Collection|string[][]
    assessment:     DueWork/Model
    student:        User
    participant:    null|Participant/Model       NULL if student does not yet have a participation record
    attachzone:     mixed[]
    response:       null|DueWork\Response\Model  NULL if not a draft
    editorContents: string                       WYSIWYG content
    policy:         string                       If non-empty, display an additional confirm dialog with school policy
    errorMessage:   null|string                  If re-loading this page because user attempted to upload bad MIME types
#}
<!-- BEGIN custom_head -->
<script type="text/javascript" src="{{ CDN_PREFIX }}/javascript/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/javascript/shared/editor/jquery.editor.js?v={{ config.site_version }}"></script>

<script type="text/javascript">
    $(function () {

        var form          = $('#editor-form'),
            formSaveLabel = form.find('[data-save-draft]');

        if (Number('{{ errorMessage|length }}') > 0) {
            // Just show error message in perma-toast
            formSaveLabel.toastActivate({
                text: 'Error: {{ errorMessage|e('js') }}',
                css: 'alert'
            });
            formSaveLabel.toastTimeout({
                text: 'Error: {{ errorMessage|e('js') }}',
                css: 'alert',
                duration: 5000
            });
        }

        // Autosave on type to ensure that change gets saved

        var autosaveTimeout = null;
        var textBoxContent = '';

        // Method for setting up autosave - clears existing event, and creates new one.

        var initAutosave = function () {
            clearTimeout(autosaveTimeout);

            autosaveTimeout = setTimeout(function () {
                autosavePresubmit();
            }, 5 * 1000);
        };

        var suspendAutosave = function () {
            clearTimeout(autosaveTimeout);
        };

        // The autosave pre-submit method - called by the autosave method. Calls the actual submit method if the textbox has changed.

        var autosavePresubmit = function () {

            // Has the text box changed? If not check again later (re-init the autosave counter)
            var currentContent = CKEDITOR.instances['editor-body'].getData();

            if (currentContent === textBoxContent) {
                initAutosave();
            }
            else {
                textBoxContent = currentContent;
                autosaveAjaxSubmit();
            }
        };

        var submitButtons = $("[data-action-save], [data-action-self-reflect]");

        // The autosave submit method

        var autosaveAjaxSubmit = function () {

            /* Disable actual submit button
             */
            submitButtons.prop('disabled', true);

            // Submit form via AJAX
            var formContents = form.serializeArray();
            formContents.push({name: 'saveDraft', value: '1'});
            formContents.push({name: 'body', value: CKEDITOR.instances['editor-body'].getData()});

            formSaveLabel.toastActivate({
                text: 'Autosaving'
            });

            $.ajax({
                type: "POST",
                url: '{{ routeLookup('learningAssessment.postCreateResponse', { assessmentId: assessment.id, studentId: student.id}) }}',
                data: formContents,
                complete: function () {
                    // Re-init the autosave
                    initAutosave();

                    /* Re-enable submit
                     */
                    submitButtons.prop('disabled', false);
                },
                success: function (responseText) {

                    /* Recycle the id ><
                     */
                    form.find('input[name=responseId]').val(responseText.id);
                    formSaveLabel.toastTimeout({
                        text: 'Draft Saved',
                        css: 'success'
                    });
                },
                error: function (response) {
                    var temp = $.parseJSON(response.responseText);

                    formSaveLabel.toastTimeout({
                        text: 'Error: ' + temp.message,
                        css: 'alert'
                    });
                },
                dataType: 'json'
            });
        };

        /**
         * Can this form be submitted?
         *
         * At least one of below must be true:
         * * There's content in the inline editor
         * * There's at least one file uploaded
         * * The "Submitted in person" checkbox is checked
         *
         * @return Boolean
         */
        var allowSubmit = function() {
            var inlineLen = CKEDITOR.instances['editor-body'].getData().length,
                filesLen = $('#files-zone').data('plugin_resourceAttach').dropzone.getAcceptedFiles().length,
                submittedInPersonCheckbox = form.find('#editor-submittedInPerson');
            return (Boolean)(inlineLen || filesLen || submittedInPersonCheckbox.prop('checked'));
        };

        /* Spawn editors
         */
        $.fn.alaressEditor({
            targetElements: $('textarea[name=body]'),
            start: function (element) {
                initAutosave(element);
                autosavePresubmit(element);
            }
        });

        // Empty submission dialog
        var emptyDialog = $('#empty-dialog');
        emptyDialog.on('click', '[data-interaction="close"]', function (e) {
            e.preventDefault();
            emptyDialog.foundation('reveal', 'close');
        });

        // Confirm dialog (if it exists)
        var $confirmDialog  = $('#confirm-dialog'),
            $acceptButton   = $confirmDialog.find('[data-accept]'),
            $rejectButton   = $confirmDialog.find('[data-reject]'),
            $buttons        = $().add($acceptButton).add($rejectButton),
            enableButtons  = function () { $buttons.removeClass('disabled'); },
            disableButtons = function () { $buttons.addClass('disabled'); },
            $submitButton   = form.find(':submit'),
            submittingText = 'Submitting... please wait',
            submitForm     = function () {
                // Disable the submit button and add 'working' text
                $submitButton
                    .prop('disabled', true)
                    .val(submittingText);

                // Make the form's inputs readonly (NOT disabled)
                form.find('input, select, textarea').prop('readonly', true);
                CKEDITOR.instances['editor-body'].setReadOnly(true);

                // Disable draft autosaving
                suspendAutosave();

                // Submit the form
                form.submit();
            };

        // Confirm dialog accept/reject
        $acceptButton.click(function (event) {
            disableButtons();
            $acceptButton.text(submittingText);
            event.preventDefault();
            submitForm();
        });

        $rejectButton.click(function (event) {
            event.preventDefault();
            $confirmDialog.foundation('reveal', 'close');
        });

        // Submit form
        submitButtons.click(function (e) {
            if (!allowSubmit()) {
                // prevent submission without SOMETHING to submit
                e.preventDefault();
                emptyDialog.foundation('reveal', 'open');
            }
            else if ($confirmDialog.length) {
                // wait! display confirm modal
                e.preventDefault();
                enableButtons();
                $confirmDialog.foundation('reveal').foundation('reveal', 'open');
            }
            else {
                // checks pass: go for broke
                submitForm();
            }
        });

        //Disable rest of form if 'submitted in person' checked
        $('#editor-submittedInPerson').click(function(element){
            if(this.checked){
                $('#submission-upload').hide('slow');
                $('[name="{{ attachzone.fileVar }}"]').attr('disabled', true);
                $('#editor-body').attr('disabled', true);
                if(CKEDITOR.instances['editor-body'].getData().length || $('[name="{{ attachzone.fileVar }}"]').val()) {
                    $('#submit-warning').show('slow');
                } else {
                    $('#submit-warning').hide('slow');
                }
            } else {
                $('#submit-warning').hide('slow');
                $('#submission-upload').show('slow');
                $('[name="{{ attachzone.fileVar }}"]').attr('disabled', false);
                $('#editor-body').attr('disabled', false);
            }
        });
    });
</script>
<!-- END custom_head -->

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

{% set isSubmitOnBehalfOf = USER.id != student.id %}
{% set requiresReflection = not isSubmitOnBehalfOf and assessment.selfAssessable %}

<div class="row">
    <div class="small-12 island">

        {% if errorMessage %}
        <noscript>
            <div class="alert-box alert">{{ errorMessage }}</div>
        </noscript>
        {% endif %}

        <h1>{{ assessment.title }}</h1>
        <ul class="meta">
            {% include '@learning/fragments/meta/dueDate.twig' %}
            {% include '@learning/fragments/meta/workType.twig' %}
        </ul>

        {% if requiresReflection %}
        <ul class="train-line">
            <li class="current-stop">
                <a><span class="icon-due-work"></span>Submission</a>
            </li>
            <li>
                <a>
                    <span class="icon-blog"></span>
                    {{ assessment.selfGradable ? locale.selfAssessment.proper : locale.selfReflection.proper }}
                </a>
            </li>
        </ul>
        {% endif %}

        {% set description = participant ? participant.description : assessment.description %}
        {% if description | length %}
        <section class="content">
            {{ description | purify }}
        </section>
        {% endif %}
        <h2 class="subheader">Submit Response</h2>

        <div class="row">
            <div class="small-12 columns">
                <div class="alert-box">
                    {% if requiresReflection %}
                        To submit your work you may upload files or optionally use the editor to type directly.
                        Content you create will automatically save to draft, but will <strong>not be submitted</strong>
                        until you finish your reflection on your work.
                    {% else %}
                        To submit your work you may upload files or optionally use the editor to type directly.
                        Content you create will automatically save to draft, but will <strong>not be submitted</strong>
                        until you press the Submit For Assessment button.
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="row">
            <div class="small-12 island">
                <form id="editor-form" method="post" action="{{ routeLookup('learningAssessment.postCreateResponse', {assessmentId: assessment.id, studentId: student.id }) }}" enctype="multipart/form-data">
                    <input type="hidden" name="responseId" value="{{ response.id ?? '' }}"/>
                    <section>
                        <div class="content">
                            {# Submitted my own work checkbox #}
                            <input id="editor-submittedInPerson" name="submitted_in_person" type="checkbox" />
                            <label for="editor-submittedInPerson" class="checkbox-label">
                                {% if isSubmitOnBehalfOf %}
                                    {{ student.firstName }} has submitted their work in person
                                {% else %}
                                    I have submitted my work in person, and don't need to upload or use the editor
                                {% endif %}
                            </label>
                            <p id="submit-warning" style="display:none" class="alert alert-box icon-alert">Any previously entered data or uploaded files will not be submitted.</p>
                            <div id="submission-upload">
                                <textarea id="editor-body" name="body" rows="20">{{ editorContents }}</textarea>
                                {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                            </div>
                        </div>
                    </section>

                    {%- if requiresReflection -%}
                        <input type="submit" value="Next" data-action-self-reflect />
                    {%- else -%}
                        <input type="submit"
                               value="{% if isSubmitOnBehalfOf %}Submit on behalf of {{ student.formatName }}{% else %}Submit for assessment{% endif %}"
                               data-action-save />
                    {%- endif -%}

                    <div class="toast" data-alert data-save-draft></div>
                </form>
            </div>
        </div>

        <div id="empty-dialog" class="reveal-modal" data-reveal role="dialog">
            <h2 id="empty-dialog-title">Nothing To Submit</h2>
            <p>You haven't supplied any content for your submission. Provide files and/or edit online and try again.</p>
            <a class="button full-width" data-interaction="close">OK</a>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </div>

        {% if policy|length %}
        <div id="confirm-dialog" class="reveal-modal" data-reveal role="dialog" title="Submit Work Terms">
            <p>{{ policy | purify }}</p>
            <ul class="flex-list buttons">
                <li><a href="#" class="button submit" data-accept>Yes, I agree</a></li>
                <li><a href="#"class="button" data-reject>Cancel</a></li>
            </ul>
        </div>
        {% endif %}
    </div>
</div>
