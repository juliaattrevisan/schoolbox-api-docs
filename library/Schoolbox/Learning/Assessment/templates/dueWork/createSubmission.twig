{#
Data:
    breadcrumbs:    Collection|string[][]
    assessment:     DueWork/Model
    student:        User
    participant:    null|Participant/Model       NULL if student does not yet have a participation record
    attachzone:     mixed[]
    response:       null|DueWork\Response\Model  NULL if not a draft
    editorContents: string                       WYSIWYG content
    policy:         string                       If non-empty, display an additional confirm dialog with school policy
    errorMessage:   null|string                  If re-loading this page because user attempted to upload bad MIME types
#}
<!-- BEGIN custom_head -->
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>

{% set isSubmitOnBehalfOf = USER.id != student.id %}

{##
 # self-reflection is only available for:
 # * actual participants (i.e. no teacher testing the submission)
 # ** this has the side effect of allowing self-assess for teachers after
 #    they've particpated
 # * the participant themselves (i.e. no submit on behalf of)
 # * due works which accept self-assessment
#}
{% set requiresReflection = participant and (not isSubmitOnBehalfOf) and assessment.selfAssessable %}

{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        let $form              = $('#editor-form'),
            $formSaveLabel     = $form.find('[data-save-draft]'),
            acceptsOnline      = {{ acceptsOnline ? 'true' : 'false' }},
            hasKamiFile        = {{ kamiFileId ? 'true' : 'false' }},
            hasPolicy          = {{ (policy | length) > 0 ? 'true' : 'false' }},
            requiresReflection = {{ requiresReflection ? 'true' : 'false' }},
            submitOnBehalfOf   = {{ isSubmitOnBehalfOf ? 'true' : 'false' }};
        if (Number('{{ errorMessage|length }}') > 0) {
            // Just show error message in perma-toast
            $formSaveLabel.toastActivate({
                text: 'Error: {{ errorMessage }}',
                css: 'alert'
            });
            $formSaveLabel.toastTimeout({
                text: 'Error: {{ errorMessage }}',
                css: 'alert',
                duration: 5000
            });
        }

        // Autosave on type to ensure that change gets saved
        let autosaveTimeout = null;
        let savedSubmissionContent = ''; //the most recent content saved to draft
        let currentSubmissionContent = ''; //to compare to the most recent saved, to check if we need to save again

        // Method for setting up autosave - clears existing event, and creates new one.
        let initAutosave = function () {
            clearTimeout(autosaveTimeout);
            autosaveTimeout = setTimeout(function () {
                autosavePresubmit();
            }, 5 * 1000);
        };

        // Method for suspending autosave: clear the old event
        let suspendAutosave = function () {
            clearTimeout(autosaveTimeout);
        };

        // The autosave pre-submit method - called by the autosave method. Calls the actual submit method if the textbox has changed.
        let autosavePresubmit = function () {

            // Has anything changed? If not check again later (re-init the autosave counter)
            currentSubmissionContent = window.sbProps.editors['editor-body']?.getData(); //start with grabbing the ckeditor content
            const formData = new FormData(document.getElementById('editor-form')); //then retrieve any dropzone, rubric and self-assessment changes
            formData.forEach((value) => currentSubmissionContent += value); //loop through and grab all the form values, creating a single string

            if (savedSubmissionContent === currentSubmissionContent) {
                initAutosave(); //nothing's changed, so keep looping through to check
            }
            else { //othewise let's save the draft
                savedSubmissionContent = currentSubmissionContent;
                autosaveAjaxSubmit();
            }
        };
        let $submitButton = $("[data-action-save]");

       $('#saveDraftButton').click(function (e) {
            // Trigger autosave when the button is clicked
            autosaveAjaxSubmit();

            // Redirect the user after the draft has been saved
            setTimeout(function () {
                window.location.href = '{{ returnUrl }}';
            }, 1000);  // Wait for 1 seconds to allow the AJAX call to complete before redirecting
        });
        // The autosave submit method
        let autosaveAjaxSubmit = function () {
            /* Disable actual submit button
             */
            $submitButton.prop('disabled', true);
            // Submit form via AJAX
            let formContents = $form.serializeArray();
            formContents.push({name: 'saveDraft', value: '1'});
            {% if assessment.getEnableText %}
                if (acceptsOnline) {
                    formContents.push({name: 'body', value: window.sbProps.editors['editor-body'].getData()});
                }
            {% endif %}
            $formSaveLabel.toastActivate({
                text: 'Autosaving'
            });
            $.ajax({
                type: "POST",
                url: '{{ routeLookup('learningAssessment.postCreateResponse', { assessmentId: assessment.id, studentId: student.id}) }}',
                data: formContents,
                complete: function () {
                    // Re-init the autosave
                    initAutosave();
                    /* Re-enable submit
                     */
                    $submitButton.prop('disabled', false);
                },
                success: function (responseText) {
                    /* Recycle the id ><
                     */
                    $form.find('input[name=responseId]').val(responseText.id);
                    $formSaveLabel.toastTimeout({
                        text: 'Draft Saved',
                        css: 'success'
                    });
                },
                error: function (response) {
                    let temp = $.parseJSON(response.responseText);
                    $formSaveLabel.toastTimeout({
                        text: 'Saving failed',
                        css: 'alert'
                    });
                },
                dataType: 'json'
            });
        };

        /**
         * Can this form be submitted?
         *
         * At least one of below must be true:
         * * The due work doesn't accept online submit, but does support
         *   self-assessment
         * * There's content in the inline editor
         * * There's at least one file uploaded
         * * The "Submitted in person" checkbox is checked
         * * There's a Kami document (which we assume the user has edited)
         *
         * @return Boolean
         */
        let allowSubmit = function() {
            if (hasKamiFile) {
                return true;
            }
            if (!acceptsOnline) {
                return true;
            }
            let inlineLen = window.sbProps.editors['editor-body']?.getData().length,
                filesLen  = $('#files-zone').data('plugin_resourceAttach')?.dropzone.getAcceptedFiles().length;
            return (Boolean)(inlineLen || filesLen || $form.find('#editor-submittedInPerson')?.prop('checked'));
        };

        /**
         * Can this form be submitted after confirmation?
         *
         * Submit on behalf of never requires a confirmation: otherwise, these
         * states require confirmation:
         * * there's a policy
         * * this is a self-assessment, and the comment is empty
         *
         * @returns {Boolean}
         */
        let questionSubmit = function () {
            if (submitOnBehalfOf) {
                return false;
            }
            if (hasPolicy) {
                return true;
            }
            return isSelfAssessmentCommentEmpty();
        }

        /**
         * Is this submission a self-assessment, and is the comment empty?
         *
         * @returns {Boolean}
         */
        let isSelfAssessmentCommentEmpty = function () {
            if (!requiresReflection) {
                return false;
            }
            let $commentInput = $form.find('[name="comment"]');
            if ($commentInput.length === 0) {
                return true;
            }
            return $commentInput.val().length === 0;
        };

        /* Spawn editors
         */
        document.getElementById("editor-body")?.addEventListener("EDITOR__CREATED", onDefaultEditorCreated);
        function onDefaultEditorCreated(event) {
            initAutosave(event.detail.sourceElement);
            autosavePresubmit(event.detail.sourceElement);
        }

        document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
            detail: {
                targetElements: ['#editor-body'],
                showWordCount: true,
                maxCharCount: -1, // no limit to entry
            }
        }));


        // Empty submission dialog
        let $emptyDialog = $('#empty-dialog');
        $emptyDialog.on('click', '[data-interaction="close"]', function (e) {
            e.preventDefault();
            $emptyDialog.foundation('reveal', 'close');
        });

        // Confirm dialog (if it exists)
        let $confirmDialog = $('#confirm-dialog'),
            $acceptButton  = $confirmDialog.find('[data-accept]'),
            $rejectButton  = $confirmDialog.find('[data-reject]'),
            $buttons       = $().add($acceptButton).add($rejectButton),
            enableButtons  = function () { $buttons.removeClass('disabled'); },
            disableButtons = function () { $buttons.addClass('disabled'); },
            submittingText = 'Submitting... please wait',
            submitForm     = function () {
                // Disable the submit button and add 'working' text
                $submitButton
                    .prop('disabled', true)
                    .val(submittingText);
                // Make the form's inputs readonly (NOT disabled)
                $form.find('input, select, textarea').prop('readonly', true);
                {% if assessment.getEnableText %}
                    // check the editor content if we accept online submissions and the "submitted in person" checkbox is not checked
                    if (acceptsOnline && !$form.find('#editor-submittedInPerson').prop('checked')) {
                        /**
                         * In order to submit, we need to ensure there's some textContent:
                         * https://developer.mozilla.org/en-US/docs/Web/API/Node/textContent
                         * For example if we just submit a single image, they'll be no textContent
                         * and the submission will fail.
                         * So we just add a new line: <p>&nbsp;</p> at the end of the editor's content
                         */
                        const editor = window.sbProps.editors['editor-body'];
                        const document = new DOMParser().parseFromString(editor.getData(), "text/html");
                        const textContent = document.body.textContent.trim();
                        if (textContent.length === 0) {
                            const selectionRange = editor.model.document.selection.getFirstRange();
                            const selectedElement = selectionRange.start.nodeAfter || selectionRange.end.nodeBefore;
                            if (selectedElement) {
                                editor.execute("insertParagraph", {
                                    position: editor.model.createPositionAfter(selectedElement),
                                });
                            }
                        }
                        // prevent any further editing while submitting
                        editor.enableReadOnlyMode('editor-body');
                    }
                {% endif %}
                // Disable draft autosaving
                suspendAutosave();
                // Submit the form
                $form.submit();
            };

        // Confirm dialog accept/reject
        $acceptButton.click(function (event) {
            disableButtons();
            $acceptButton.text(submittingText);
            event.preventDefault();
            submitForm();
        });
        $rejectButton.click(function (event) {
            event.preventDefault();
            $confirmDialog.foundation('reveal', 'close');
        });

        // Submit form
        $submitButton.click(function (e) {
            e.preventDefault();
            if (!allowSubmit()) {
                // prevent submission without SOMETHING to submit
                $emptyDialog.foundation('reveal', 'open');
            } else if (questionSubmit()) {
                // wait! display confirm modal
                enableButtons();

                // Possibly show the confirm dialog's self-assess comment empty?
                $confirmDialog
                    .find('#confirm-empty-self-assessment-comment')
                    .toggleClass('hide', !isSelfAssessmentCommentEmpty());

                $confirmDialog.foundation('reveal', 'open');
            } else {
                // checks pass: go for broke
                submitForm();
            }
        });

        // Disable ckeditor and attachzone if 'submitted in person' checked
        $('#editor-submittedInPerson').click(function (element) {
            if(this.checked){
                $('#submission-upload').hide('slow');
                $('[name="{{ attachzone.fileVar }}"]').attr('disabled', true);
                $('#editor-body').attr('disabled', true);
                if (window.sbProps.editors['editor-body']?.getData().length || $('[name="{{ attachzone.fileVar }}"]').val()) {
                    $('#submit-warning').show('slow');
                } else {
                    $('#submit-warning').hide('slow');
                }
            } else {
                $('#submit-warning').hide('slow');
                $('#submission-upload').show('slow');
                $('[name="{{ attachzone.fileVar }}"]').attr('disabled', false);
                $('#editor-body').attr('disabled', false);
            }
        });

        /* If there is a kami file, start with an autosave
         */
        // Listen to Kami events here
        let kamiViewport = document.querySelector("#kami-viewport");
        window.addEventListener("message", function (event) {
            if (
                kamiViewport &&
                event.source === kamiViewport.contentWindow &&
                event.data.type === "kamiembedding" &&
                (event.data.event_name === "createdAnnotation" || event.data.event_name === "deletedAnnotation")
            ) {
                autosaveAjaxSubmit();
            }
        });
    });
</script>
{% endautoescape %}

<!-- END custom_head -->

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row" id="assessment-status">
    <div class="small-12 island">

        {% if errorMessage %}
        <noscript>
            <div class="alert-box alert">{{ errorMessage }}</div>
        </noscript>
        {% endif %}

        <h1>{{ assessment.title }}</h1>
        <ul class="meta">
            {% include '@learning/fragments/meta/dueDate.twig' %}
            {% include '@learning/fragments/meta/workType.twig' %}
            {% include '@learning/fragments/meta/curriculumCodes.twig' %}
        </ul>

        <form id="editor-form"
              data-feedback-form="{{ student.id }}"
              method="post"
              action="{{ routeLookup('learningAssessment.postCreateResponse', {assessmentId: assessment.id, studentId: student.id }) }}"
              enctype="multipart/form-data">
            {% set description = participant ? participant.description : assessment.description %}
            {% if description | length %}
                <section class="content">
                    {{ description | purify }}
                </section>
            {% endif %}

            {# If a due work doesn't accept online submissions at all,
             # students may still be able to self-reflect, but we don't want
             # them seeing the submission field.
             #
             # The "responseId" hidden input is required even if the due work
             # doesn't accept submissions, because the input needs to be
             # populated when the student publishes their self-assessment.
             #}
            <input type="hidden" name="responseId" value="{{ response ? response.id : '' }}"/>
            <input type="hidden" name="returnUrl" value="{{ returnUrl }}"/>
            <input type="hidden" name="kamiFileId" value="{{ kamiFileId }}"/>
            {% if acceptsOnline or isSubmitOnBehalfOf %}
                <h2 class="subheader">Submit Work</h2>

                {% if not isSubmitOnBehalfOf %}
                    <div class="row">
                        <div class="small-12 columns">
                            <div class="alert-box">
                                You can use one of the available options to create your content as a draft. To submit your work, you must select <strong>Submit for assessment</strong>.

                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="row">
                    {# Kami Interactive Worksheet
                     #   * Kami module must be enabled
                     #   * Kami Interactive Worksheet feature flag must be enabled (this should always be the case now)
                     #   * The Due Work must have Interactive Worksheet ticked
                     #   * A worksheet file must have been provided
                     #}
                    {# kami worksheet if exists, and enabled #}
                    {% if config.kami_worksheets_enabled and assessment.getEnableWorksheet and assessment.getKamiWorksheetTemplate.getKamiDocumentId is defined %}
                    <div class="small-12 island">
                        {% if kamiSession %}
                            {% include 'sub/iframeResponsive.twig' with {
                                id: 'kami-viewport',
                                src: kamiSession.viewerUrl,
                                allow: 'microphone *; camera *; midi *; encrypted-media *; autoplay *; clipboard-write *; clipboard-read *; display-capture *; fullscreen *',
                                dataAttributes: {}
                            } only %}
                        {% else %}
                            {# if kami is enabled, and we have a worksheet, but no kami iframe, we should show some help text... #}
                            <div class="empty-state">
                                <i class="icon-submissions"></i>
                                <p>Worksheet is still uploading...</p>
                                <p>Please try again soon.</p>
                            </div>
                        {% endif %}
                    </div>
                    {% endif %}
                    {% if assessment.getEnableOffline or assessment.getEnableText or assessment.getEnableFiles %}
                    <div class="small-12 island">
                        <section>
                            <div class="content">
                                {# Submitted my own work checkbox #}
                                {% if assessment.getEnableOffline %}
                                <input id="editor-submittedInPerson" name="submitted_in_person" type="checkbox" />
                                <label for="editor-submittedInPerson" class="checkbox-label" data-test="assessment-submission-create-submittedInPerson">
                                    {% if isSubmitOnBehalfOf %}
                                        {{ student.givenName }} has submitted their work in person
                                    {% else %}
                                        I have submitted my work in person
                                    {% endif %}
                                </label>
                                {% endif %}
                                {% if assessment.getEnableText or assessment.getEnableFiles %}
                                <p id="submit-warning" style="display:none" class="alert alert-box icon-alert">Any previously entered data or uploaded files will not be submitted.</p>
                                <div id="submission-upload">
                                    {% if assessment.getEnableText %}
                                    <textarea id="editor-body" name="body" rows="20" data-test="assessment-submission-input-body">{{ editorContents }}</textarea>
                                    {% endif %}
                                    {% if assessment.getEnableFiles %}
                                        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                                    {% endif %}
                                </div>
                                {% endif %}
                            </div>
                        </section>
                    </div>
                    {% endif %}
                </div>

                <div id="empty-dialog" class="reveal-modal" data-reveal role="dialog">
                    <h2 id="empty-dialog-title">Nothing To Submit</h2>
                    <p>You haven't supplied any content for your submission. Provide files and/or edit online and try again.</p>
                    <a class="button full-width" data-interaction="close">OK</a>
                    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
                </div>
            {% endif %}

            {##
             # The dialog which a student must accept before submitting:
             # a policy, and/or an acknowledgement the reflection is empty
             #}
            {% if requiresReflection or policy | length %}
                <div id="confirm-dialog" class="reveal-modal" data-reveal role="dialog">
                    {% if assessment.getEnablePolicy and policy | length %}
                        <p>{{ policy | purify }}</p>
                        {% if requiresReflection %}
                            <p id="confirm-empty-self-assessment-comment" class="hide">
                                (You should also provide a
                                {{ assessment.selfGradable ? locale.selfAssessment.singularForm : locale.selfReflection.singularForm }}
                                comment.)
                            </p>
                        {% endif %}
                        <ul class="flex-list buttons">
                            <li><a class="button submit" data-accept>Yes, I agree</a></li>
                            <li><a class="button" data-reject>Cancel</a></li>
                        </ul>
                    {% else %}
                        {% if requiresReflection %}
                            <div id="confirm-empty-self-assessment-comment" class="hide">
                                <h2>
                                    Are you sure you wish to submit an incomplete
                                    {{ assessment.selfGradable ? locale.selfAssessment.singularForm : locale.selfReflection.singularForm }}?
                                </h2>

                                <p>
                                    It is preferable to provide a
                                    {{ assessment.selfGradable ? locale.selfAssessment.singularForm : locale.selfReflection.singularForm }}
                                    comment. Please confirm that you wish to provide no comment.
                                </p>
                            </div>
                        {% endif %}
                        <ul class="flex-list buttons">
                            <li><a class="button submit" data-accept>Yes</a></li>
                            <li><a class="button" data-reject>No</a></li>
                        </ul>
                    {% endif %}
                </div>
            {% endif %}

            {# If this is a self-reflectable assessment, and is being submitted by the student, include the section for self-reflecting #}
            {% if requiresReflection %}
                {% include '@learningDueWorkResponse/inlineGrading/selfAssessment.twig' %}
            {% endif %}
             <input type="button"
                id="saveDraftButton"
                value="Save as Draft"
                class="button expand"
                data-test="assessment-submission-save-draft" />

            <input type="submit"
                   value="{% if isSubmitOnBehalfOf %}Submit on behalf of {{ student.formatName }}{% else %}Submit for assessment{% endif %}"
                   data-action-save
                   data-test="assessment-submission-create-submit" />

            <div class="toast" data-alert data-save-draft></div>

        </form>

    </div>
</div>
