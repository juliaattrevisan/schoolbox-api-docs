{##
 # Similarity Report
 #
 # @param array $breadcrumbs       A list of breadcrumb nodes
 # @param IAssessable $assessment  The assessment
 # @param string $payloadUrl       The url to load this assessment's similarity report payload
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row">
  <div class="small-12 columns">
    <h1>Similarity Report for {{ assessment.title }}</h1>
  </div>
</div>

<div id="similarity-report-container">
  <similarity-report
    :assessment-id="{{ assessment.id }}"
    payload-url="{{ payloadUrl }}"
  />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/similarityReport.js?v={{ config.site_version }}"></script>