    [data-draft-mark] {
        display: none;
    }
    .rubric-profile {
        max-width: 64px;
    }
</style>
{% autoescape 'js' %}
    <script type="text/javascript">
        $(function() {
            $.marksheetToggleDrafts('#show-drafts');
        });
    </script>
{% endautoescape %}
