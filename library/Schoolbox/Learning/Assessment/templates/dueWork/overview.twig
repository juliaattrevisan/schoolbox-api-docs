{% import '@learningAssessment/project/macro/icon.twig' as icon %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="actions-small-1 row">
    <div>
        <div class="small-12 columns">
            <h1>Rubric Report for {{ dueWork.title }}</h1>
            <div class="l-flex l-flex--justify-space">
                <ul class="meta">
                    <li class="{{ icon.renderClass(dueWork) }}">{{ dueWork.typeName }}</li>
                    <li class="icon-calendar">Due {{ dueWork.dueAt.getRelativeTime }} on {{ dueWork.dueAt.localShort }}</li>
                </ul>
                <div class="l-flex l-flex--align-center l-flex--justify-end l-gap-m l-pad-m--horiz">
                    <div class="checklist">
                        <input type="checkbox" id="show-drafts">
                        <label for="show-drafts">
                            Show Drafts
                        </label>
                    </div>
                    <nav class="c-nav-actions l-flex-row">
                        <a href="{{ routeLookup('learningAssessment.downloadOverview', { assessmentId: dueWork.id }) }}?format=csv" class="icon-download" title="Download CSV"></a>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <div class="scrollable">
            <table class="rb rb-report">
                <tbody>
                    <tr>
                        <th rowspan="2" class="rb-group-name markdown">&nbsp;</th>

                        {% for group, criteria in headers %}
                            {% set colspan = criteria|length %}

                            {# If Capability Mark Type is something other than None,
                             # prepare an additional column
                             #}
                            {% if dueWork.isMarkPerCapability %}
                                {% set colspan = colspan+1 %}
                            {% endif %}

                            <th colspan="{{ colspan }}" class="markdown">{{ group | markdown }}</th>
                        {% endfor %}
                    </tr>
                    <tr>
                        {% for criteria in headers %}
                            {% for criterion in criteria %}
                                <th class="rb-criterion-name markdown">{{ criterion | markdown }}</th>
                            {% endfor %}

                            {# If Capability Mark Type is something other than None,
                             # prepare an additional column
                             #}
                            {% if dueWork.isMarkPerCapability %}
                                <th class="rb-criterion-name markdown">Overall</th>
                            {% endif %}
                        {% endfor %}
                    </tr>
                    {% for participant in participants %}
                    <tr>
                        <td>
                            <div class="wrap-down small-12 ">
                                <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: dueWork.id, studentId: participant.id}) }}" title="View Profile" class="l-flex l-flex-col l-flex--center">
                                    <div class="c-img c-img--m c-img--round">
                                        <div class="c-img__wrapper">
                                            {% include 'include/portrait.twig' with {user: participant, description: participant.fullName, class: "rubric-profile"} only %}
                                        </div>
                                    </div>
                                    <p>{{ participant.fullname}}</p>
                                </a>
                            </div>
                        </td>
                            {% for criteria in headers %}
                                {% for id, criterion in criteria %}
                                    {% set markLatest = marks[participant.id][id]['latest'] ?? null %}
                                    {% set mark = marks[participant.id][id]['published'] ?? null %}
                                    <pre>
                                </pre>
                                    <td class="markdown">
                                        <div {% if markLatest %}data-actual-mark{%endif %}>
                                        {{ (mark.descriptor.description ?? '') | markdown }}
                                            <p>{{ mark.value ?? '' }}</p>
                                        </div>
                                        {% if markLatest %}
                                        <div data-draft-mark class="meta">
                                        {{ (markLatest.descriptor.description ?? '') | markdown }}
                                            <p>{{ markLatest.value ?? '' }}</p>
                                        </div>
                                        {% endif %}
                                    </td>
                                {% endfor %}

                                {# If Capability Mark Type is something other than None,
                                 # prepare an additional column
                                 #}
                                {% if dueWork.isMarkPerCapability %}
                                    <td class="markdown">TODO 100%</td>
                                {% endif %}
                            {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

        </div>
    </div>
</div>
<style>
    [data-draft-mark] {
        display: none;
    }
    .rubric-profile {
        max-width: 64px;
    }
</style>
{% autoescape 'js' %}
    <script type="text/javascript">
        $(function() {
            $("#show-drafts").click(function () {
                if ($(this).is(":checked")) {
                    $("[data-draft-mark]").show();
                    $("[data-actual-mark]").hide();
                } else {
                    $("[data-draft-mark]").hide();
                    $("[data-actual-mark]").show();
                }
            });
        });
    </script>
{% endautoescape %}
