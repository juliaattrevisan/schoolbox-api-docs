{% import '@learningAssessment/project/macro/icon.twig' as icon %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Rubric Report for {{ dueWork.title }}</h1>
            <ul class="meta">
                <li class="{{ icon.renderClass(dueWork) }}">{{ dueWork.typeName }}</li>
                <li class="icon-calendar">Due {{ dueWork.dueAt.relative }} on {{ dueWork.dueAt.localShort }}</li>
            </ul>
        </div>
    </div>
    <nav>
        <a href="{{ routeLookup('learningAssessment.downloadOverview', { assessmentId: dueWork.id }) }}?format=csv" class="icon-download" title="Download CSV"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 columns">
        <div class="scrollable">
            <table>
                <tbody>
                    <tr>
                    {% if dueWork.useRubric %}
                        <th rowspan="2"></th>
                        {% for group, criteria in headers %}
                            <th colspan="{{ criteria | length }}">{{ group | nl2br }}</th>
                        {% endfor %}
                    </tr>
                    <tr>
                        {% for criteria in headers %}
                            {% for criterion in criteria %}
                                <th>{{ criterion | nl2br }}</th>
                            {% endfor %}
                        {% endfor %}
                    {% else %}
                        <th></th>
                        <th>Marks</th>
                    {% endif %}
                    </tr>
                    {% for participant in participants %}
                    <tr>
                        <td>
                            <div class="card wrap-down small-12 ">
                                <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: dueWork.id, studentId: participant.id}) }}" title="View Profile">
                                    <img src="/portrait.php?userId={{ participant.externalId }}&amp;size=square64" alt="{{ participant.fullname }}">
                                    <p>{{ participant.fullname}}</p>
                                </a>
                            </div>
                        </td>
                        {% if dueWork.useRubric %}
                            {% for criteria in headers %}
                                {% for id, criterion in criteria %}
                                    {% set mark = marks[participant.id][id] %}
                                    <td>
                                        <p>{{ mark.descriptor.description | nl2br }}</p>
                                        <p>{{ mark.value }}</p>
                                    </td>
                                {% endfor %}
                            {% endfor %}
                        {% else %}
                            <td>{{ participant.humanReadableMark(true) }}</td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

        </div>
    </div>
</div>
