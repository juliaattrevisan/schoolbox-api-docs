<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/jquery.marksheet.js?v={{ config.site_version }}"></script>

{% import '@learningAssessment/project/macro/icon.twig' as icon %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="actions-small-1 row">
    <div>
        <div class="small-12 columns">
            <h1>Rubric Report for {{ dueWork.title }}</h1>
            <div class="l-flex l-flex--justify-space">
                <ul class="meta">
                    <li class="sbx-meta-item--with-icon"><sbx-icon name="{{ icon.renderName(dueWork)|trim }}"></sbx-icon> {{ dueWork.typeName }}</li>
                    <li class="sbx-meta-item--with-icon"><sbx-icon name="calendar"></sbx-icon> Due {{ dueWork.dueAt.getRelativeTime }} on {{ dueWork.dueAt.localShort }}</li>
                </ul>
                <div class="l-flex l-flex--align-center l-flex--justify-end l-gap-m l-pad-m--horiz no-pad">
                    <div class="checklist">
                        <input type="checkbox" id="show-drafts">
                        <label for="show-drafts">
                            Show Drafts
                        </label>
                    </div>
                    <nav class="c-nav-actions l-flex-row">
                        <a href="{{ routeLookup('learningAssessment.downloadOverview', { assessmentId: dueWork.id }) }}?format=csv" title="Download CSV" data-download-spreadsheet class="sbx-icon-only-button"><sbx-icon name="download"></sbx-icon></a>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <div class="scrollable">
            <table class="rb rb-report">
                <tbody>
                    <tr>
                        <th rowspan="2" class="rb-group-name markdown">&nbsp;</th>

                        {% for capabilityId, capabilityData in headers.capabilities %}
                            {% set colspan = capabilityData.indicators|length %}

                            {# If Capability Mark Type is something other than None,
                             # prepare an additional column
                             #}
                            {% if dueWork.isMarkPerCapability %}
                                {% set colspan = colspan+1 %}
                            {% endif %}

                            <th colspan="{{ colspan }}" class="markdown">{{ capabilityData.name | markdown }}</th>
                        {% endfor %}
                    </tr>
                    <tr>
                        {% for capabilityId, capabilityData in headers.capabilities %}
                            {% for indicatorId, indicator in capabilityData.indicators %}
                                <th class="rb-criterion-name markdown">{{ indicator | markdown }}</th>
                            {% endfor %}

                            {# If Capability Mark Type is something other than None,
                             # prepare an additional column
                             #}
                            {% if dueWork.isMarkPerCapability %}
                                <th class="rb-criterion-name markdown">Overall</th>
                            {% endif %}
                        {% endfor %}
                    </tr>
                    {% for participant in participants %}
                    <tr>
                        <td>
                            <div class="wrap-down small-12 ">
                                <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: dueWork.id, studentId: participant.id}) }}" title="View Profile" class="l-flex l-flex-col l-flex--center">
                                    <div class="c-img c-img--m c-img--round">
                                        <div class="c-img__wrapper">
                                            {% include 'include/portrait.twig' with {user: participant, description: participant.fullName, class: "rubric-profile"} only %}
                                        </div>
                                    </div>
                                    <p>{{ participant.fullname}}</p>
                                </a>
                            </div>
                        </td>
                            {% for capabilityId, capabilityData in headers.capabilities %}
                                {% for indicatorId, indicator in capabilityData.indicators %}
                                    {% set markLatest = marks[participant.id][indicatorId]['latest'] ?? null %}
                                    {% set mark = marks[participant.id][indicatorId]['published'] ?? null %}
                                    <td class="markdown">
                                        <div {% if markLatest %}data-actual-mark{%endif %}>
                                        {{ (mark.descriptor.description ?? '') | markdown }}
                                            <p>{{ mark.value ?? '' }}</p>
                                        </div>
                                        {% if markLatest %}
                                        <div data-draft-mark class="meta">
                                        {{ (markLatest.descriptor.description ?? '') | markdown }}
                                            <p>{{ markLatest.value ?? '' }}</p>
                                        </div>
                                        {% endif %}
                                    </td>
                                {% endfor %}

                                {# If Capability Mark Type is something other than None,
                                 # prepare an additional column
                                 #}
                                {% if dueWork.isMarkPerCapability %}
                                    {% set capabilityMarkLatest = marks[participant.id]['capabilityMark'][capabilityId]['latest'] ?? null %}
                                    {% set capabilityMark = marks[participant.id]['capabilityMark'][capabilityId]['published'] ?? null %}

                                    <td class="markdown">
                                        {# "latest" typically means "draft marks" #}
                                        <div {% if capabilityMarkLatest %}data-actual-mark{%endif %}>
                                            <p>{{ capabilityMark }}</p>
                                        </div>
                                        {% if capabilityMarkLatest %}
                                            <div data-draft-mark class="meta">
                                                <p>{{ capabilityMarkLatest }}</p>
                                            </div>
                                        {% endif %}
                                    </td>
                                {% endif %}
                            {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

        </div>
    </div>
</div>
<style>
    [data-draft-mark] {
        display: none;
    }
    .rubric-profile {
        max-width: 64px;
    }
</style>
{% autoescape 'js' %}
    <script type="text/javascript">
        $(function() {
            $.marksheetToggleDrafts('#show-drafts');
        });
    </script>
{% endautoescape %}
