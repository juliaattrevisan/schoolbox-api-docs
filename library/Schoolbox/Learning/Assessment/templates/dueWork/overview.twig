{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Rubric Report for {{ dueWork.title }}</h1>
        </div>
    </div>
    <nav>
        <a href="{{ routeLookup('learningAssessment.downloadOverview', { assessmentId: dueWork.id }) }}?format=csv" class="icon-download" title="Download CSV"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 columns">
        <div class="scrollable">
            <table>
                <tbody>
                    <tr>
                    {% if dueWork.useRubric %}
                        <th rowspan="2"></th>
                        {% for group, criteria in headers %}
                            <th colspan="{{ criteria | length }}">{{ group }}</th>
                        {% endfor %}
                    </tr>
                    <tr>
                        {% for criteria in headers %}
                            {% for criterion in criteria %}
                                <th>{{ criterion }}</th>
                            {% endfor %}
                        {% endfor %}
                    {% else %}
                        <th></th>
                        <th>Marks</th>
                    {% endif %}
                    </tr>
                    {% for participant in dueWork.allParticipants %}
                    <tr>
                        <td>
                            <div class="card small-12">
                                <a href="/search/user/{{ participant.user.id }}" title="View Profile">
                                    <h3>{{ participant.user.formatName('{lastname}, {firstname}') }}</h3>
                                </a>
                            </div>
                        </td>
                        {% if dueWork.useRubric %}
                            {% for criteria in headers %}
                                {% for id, criterion in criteria %}
                                    {% set mark = marks[participant.user.id][id] %}
                                    <td>
                                        <p>{{ mark.text }}</p>
                                        <p>{{ mark.value }}</p>
                                    </td>
                                {% endfor %}
                            {% endfor %}
                        {% else %}
                            <td>{{ participant.publishedHumanReadableMark }}</td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

        </div>
    </div>
</div>
