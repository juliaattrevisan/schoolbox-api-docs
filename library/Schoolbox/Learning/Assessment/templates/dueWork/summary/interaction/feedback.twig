{% import '@learning/macro/urgency.twig' as urgency %}
{#
 # Self-reflection/assessment:
 # Go to self-assess screen to resume
 #
 # Associated Feedback
 # Go to Inline Grader to resume
 #
 # Floating Feedback
 # Go to Quickmark to resume
Data:
    currentFeedback  DueWork\Feedback\Model
    responseId
    participant
    feedbackRubricContexts
 #}
{% set url     = null %}
{% set tooltip = null %}
{% if not currentFeedback.isPublished %}
    {% if currentFeedback.response.id %}
        {% if currentFeedback.isSelfGrading %}
            {% set url = routeLookupIfAuthorized('learningDueWorkResponse.getParticularResponseForSelfReflection', {
                assessmentId: currentFeedback.assessable.id,
                studentId: currentFeedback.response.submittedOnBehalfOf.id,
                responseId: responseId,
                response: currentFeedback.response,
                assessment: assessment,
                student: currentFeedback.response.submittedOnBehalfOf,
            }) %}
            {% set tooltip = 'Resume ' ~ locale.selfAssessment.proper %}
        {% elseif currentFeedback.isSelfReflectionOnly %}
            {% set url = routeLookupIfAuthorized('learningDueWorkResponse.getParticularResponseForSelfReflection', {
                assessmentId: currentFeedback.assessable.id,
                studentId: currentFeedback.response.submittedOnBehalfOf.id,
                responseId: responseId,
                response: currentFeedback.response,
                assessment: assessment,
                student: currentFeedback.response.submittedOnBehalfOf,
            }) %}
            {% set tooltip = 'Resume ' ~ locale.selfReflection.proper %}
        {% else %}
            {% set url = routeLookupIfAuthorized('learningDueWorkResponse.getParticularResponse', {
                assessmentId: currentFeedback.assessable.id,
                studentId: currentFeedback.response.submittedOnBehalfOf.id,
                responseId: responseId,
                response: currentFeedback.response,
                assessment: assessment,
                student: currentFeedback.response.submittedOnBehalfOf,
            }) %}
            {% set tooltip = 'Resume Inline ' ~ locale.grading.proper %}
        {% endif %}
    {% else %}
        {% set url = routeLookupIfAuthorized('learningAssessment.getStatus', {
            assessmentId: currentFeedback.assessable.id,
            assessment: currentFeedback.assessable
        }) %}
        {% set tooltip = 'Resume Quickmark' %}
    {% endif %}
{% endif %}

{% if not url %}
    {# Just link to reviewer's profile #}
    {% set url = '/search/user/' ~ currentFeedback.reviewer.id %}
    {% set tooltip = 'View Profile' %}
{% endif %}

<ul class="information-list reply">
    <li class="actions-small-2">
        <div class="list-item flex-grade">
            <div class="card small-12">
                {% if url %}
                <a href="{{ url }}" title="{{ tooltip }}">
                {% endif %}
                    <img src="/portrait.php?userId={{ currentFeedback.reviewer.externalId }}&amp;size=square64" alt="">
                    <p>
                        {% if not currentFeedback.published %}
                            Draft
                        {% endif %}
                        {% if currentFeedback.isSelfGrading %}
                            {{ locale.selfAssessment.proper }}
                        {% elseif currentFeedback.isSelfReflectionOnly %}
                            {{ locale.selfReflection.proper }}
                        {% else %}
                            Feedback by {{ currentFeedback.reviewer.fullname }}
                        {% endif %}
                        {% if currentFeedback.response.id %}
                        <span class="pipe meta">
                            {{ currentFeedback.published ? currentFeedback.publishedAt.short : currentFeedback.updatedAt.short }}
                        </span>
                        {% endif %}
                    </p>
                    {% if not currentFeedback.response.id %}
                    <p class="meta">
                        {{ currentFeedback.published ? currentFeedback.publishedAt.short : currentFeedback.updatedAt.short }}
                    </p>
                    {% endif %}
                {% if url %}
                </a>
                {% endif %}
            </div>
            <div class="grade">
                <span class="{{ urgency.marks(currentFeedback.normalisedMark) }}">{{ currentFeedback.humanReadableMark }}</span>
            </div>
        </div>
        {% set deleteRoute = routeLookupIfAuthorized(
            'learningDueWorkFeedback.deleteAssessmentFeedback',
            {
                assessmentId: participant.assessable.id,
                assessment: participant.assessable,
                feedbackId: currentFeedback.id,
                feedback: currentFeedback,
            }
        ) %}
        <nav>
            {% if hasCollapser %}
                <a href="#" class="icon-down-arrow" data-collapser="feedback-{{ responseId }}-{{ currentFeedback.id }}"></a>
            {% endif %}
            {% if deleteRoute and deleteIcon %}
                <a class="icon-delete" data-delete="{{ deleteRoute }}"></a>
            {% endif %}
        </nav>

        {% if currentFeedback.comment|length %}
            <article class="{{ collapsed? 'hide' : '' }}"
                     {% if hasCollapser %}
                     data-collapse-state="{{ collapsed? 'collapsed' : 'expanded' }}"
                     data-collapsable="feedback-{{ responseId }}-{{ currentFeedback.id }}"
                     {% endif %}>
                {{ currentFeedback.comment|nl2br }}
            </article>
        {% endif %}

        {# Rubric goes here #}
        {% if feedbackRubricContexts[currentFeedback.id] %}
            <div class="{{ collapsed? 'hide' : '' }}"
                 {% if hasCollapser %}
                 data-collapse-state="{{ collapsed? 'collapsed' : 'expanded' }}"
                 data-collapsable="feedback-{{ responseId }}-{{ currentFeedback.id }}"
                 {% endif %}>
                {% include '@rubric/grid.twig' with {
                    rubric:         feedbackRubricContexts[currentFeedback.id].rubric,
                    markVisibility: currentFeedback.isSelfAssessment
                                    or participant.assessable.isFeedbackVisibleToUser(USER),
                } only %}
            </div>
        {% endif %}

        {% if currentFeedback.allFiles | length %}
            <ul class="information-list {{ collapsed? 'hide' : '' }}"
                data-collapse-state="{{ collapsed? 'collapsed' : 'expanded' }}"
                data-collapsable="feedback-{{ responseId }}-{{ currentFeedback.id }}">
                {% for currentFile in currentFeedback.allFiles %}
                {# Only show published feedback and therefore also
                 # only list files that are involved with a Published Feedback
                 #}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="card attachment small-12">
                            {% set kamiViewRoute = currentFile.kami
                                ? routeLookupIfAuthorized('learningDueWorkResponse.getKamiView', {
                                    kamiId:       currentFile.kami.id,
                                    assessment:   assessment,
                                    participant:  participant,
                                    feedback:     currentFeedback,
                                })
                                : null
                            %}
                            {% if currentFile.kami and kamiViewRoute %}
                                <a href="{{ kamiViewRoute }}" title="{{ currentFile.filename }}">
                                    <img src="/ajax/mime/{{ currentFile.mime }}" alt="View Annotated Document" />
                                    <p>{{ currentFile.filename }} </p>
                                </a>
                            {% else %}
                                <a href="/storage/fetch.php?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}" data-plugin="preview">
                                    <img src="/ajax/mime/{{ currentFile.mime }}" alt="Download" />
                                    <p>{{ currentFile.filename }} </p>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                    <nav>
                        {% set kamiExportRoute = currentFile.kami
                            ? routeLookupIfAuthorized('learningDueWorkResponse.getKamiExport', {
                                kamiId:       currentFile.kami.id,
                                assessment:   assessment,
                                participant:  participant,
                                feedback:     currentFeedback,
                            })
                            : null
                        %}
                        {% if kamiExportRoute %}
                            <a href="{{ kamiExportRoute }}" data-kami-export class="icon-download" title="Download annotated document"></a>
                        {% else %}
                            <a href="/storage/fetch.php?hash={{ currentFile.hash }}&save=1" class="icon-download" title="Download"></a>
                        {% endif %}
                    </nav>
                </li>
                {% endfor %}
            </ul>
        {% endif %}
    </li>
</ul>
