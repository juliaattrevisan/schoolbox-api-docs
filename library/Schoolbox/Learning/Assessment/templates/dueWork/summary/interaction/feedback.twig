{% import '@learning/macro/urgency.twig' as urgency %}
{#
 # Self-reflection/assessment:
 # Go to self-assess screen to resume
 #
 # Associated Feedback
 # Go to Inline Grader to resume
 #
 # Floating Feedback
 # Go to Quickmark to resume
Data:
    currentFeedback  DueWork\Feedback\Model
    responseId
    participant
 #}
{% set url                     = null %}
{% set tooltip                 = null %}
{% set currentFeedbackResponse = currentFeedback.response and not currentFeedback.response.deleted ? currentFeedback.response : null %}
{% set responseId              = responseId ?? (currentFeedback.response.id ?? null) %}
{% set instructorReviewRoute   = null %}
{% set studentSelfReviewRoute  = null %}

{% if not currentFeedback.isPublished %}
    {% if currentFeedbackResponse %}
        {% if currentFeedback.isSelfGrading %}
            {% set tooltip = 'Resume ' ~ locale.selfAssessment.proper %}
        {% elseif currentFeedback.isSelfReflectionOnly %}
            {% set tooltip = 'Resume ' ~ locale.selfReflection.proper %}
        {% else %}
            {% set tooltip = 'Resume Inline ' ~ locale.grading.proper %}
        {% endif %}
        {% set url = routeLookupIfAuthorized(
            'learningDueWorkResponse.getParticularResponse',
            {
                assessmentId: currentFeedback.assessable.id,
                studentId: currentFeedbackResponse.submittedOnBehalfOf.id,
                responseId: responseId,
                response: currentFeedbackResponse,
                assessment: assessment,
                student: currentFeedbackResponse.submittedOnBehalfOf,
            }
        ) %}
    {% endif %}
{% endif %}

{% set selfReflectText = assessment.selfGradable ? locale.selfAssessment.proper : locale.selfReflection.proper %}

{% if currentFeedbackResponse %}
    {% set instructorReviewRoute = routeLookupIfAuthorized(
        'learningDueWorkResponse.getParticularResponse',
        {
            assessmentId: currentFeedback.assessable.id,
            studentId: currentFeedbackResponse.submittedOnBehalfOf.id,
            responseId: responseId,
            response: currentFeedbackResponse,
            assessment: assessment,
            student: currentFeedbackResponse.submittedOnBehalfOf,
        }
    ) %}
    {% set studentSelfReviewRoute = routeLookupIfAuthorized(
        'learningAssessment.getCreateResponseForm',
        {
            assessmentId: currentFeedback.assessable.id,
            assessment: currentFeedback.assessable,
            studentId: currentFeedbackResponse.submittedOnBehalfOf.id,
            student: currentFeedbackResponse.submittedOnBehalfOf
        }
    ) %}
{% endif %}

{% set instructorFloatingReviewRoute = routeLookupIfAuthorized(
    'learningAssessment.getStatus',
    {
        assessmentId: currentFeedback.assessable.id,
        assessment: currentFeedback.assessable
    }
) %}

{# if the feedback is a draft... #}
{% if not currentFeedback.isPublished %}
    {# and it's not a floating feedback (aka the feedback has been created for a particular submission) #}
    {% if currentFeedbackResponse %}
        {# if the current user is the student who submitted the feedback, give them a link to resume working on it #}
        {# otherwise, if it's an instructor, take them to the inline grader for the particular draft #}
        {% set url = instructorReviewRoute ?: studentSelfReviewRoute %}
        {% set tooltip = instructorReviewRoute ? 'Resume Inline ' ~ locale.grading.proper : 'Resume ' ~ selfReflectText %}
    {% else %}
        {# floating draft feedback? take the instructor to the quickmark screen to resume working on it.
           There is no workflow I know of where a student can create a floating draft #}
        {% set url = instructorFloatingReviewRoute %}
        {% set tooltip = instructorFloatingReviewRoute ? 'Resume Quickmark' : 'Resume ' ~ selfReflectText %}
    {% endif %}
{% endif %}

{% if not url %}
    {# Just link to reviewer's profile #}
    {% set url = '/search/user/' ~ currentFeedback.reviewer.id %}
    {% set tooltip = 'View Profile' %}
{% endif %}

{% set deleteRoute = routeLookupIfAuthorized(
    'learningDueWorkFeedback.deleteAssessmentFeedback',
    {
        assessmentId: participant.assessable.id,
        assessment: participant.assessable,
        feedbackId: currentFeedback.id,
        feedback: currentFeedback,
    }
) %}

{% if hasCollapser and deleteRoute and deleteIcon %}
    {% set actionClass = 'actions-small-2' %}
{% elseif hasCollapser or (deleteRoute and deleteIcon) %}
    {% set actionClass = 'actions-small-1' %}
{% else %}
    {% set actionClass = '' %}
{% endif %}

{% set prefix = '' %}
{% if not currentFeedback.published %}
    {% set prefix = 'Draft' %}
{% endif %}

{% if currentFeedback.isSelfGrading %}
    {% set prefix = prefix ~ ' '~ locale.selfAssessment.proper %}
    {% set isSelf = true %}
{% elseif currentFeedback.isSelfReflectionOnly %}
    {% set prefix = prefix ~ ' '~ locale.selfReflection.proper %}
    {% set isSelf = true %}
{% elseif currentFeedback.resubmissionRequired %}
    {% set prefix = prefix ~ ' Resubmission required by ' ~ currentFeedback.reviewer.fullname  %}
    {% set isSelf = false %}
{% else %}
    {% set prefix = prefix ~ ' Feedback by ' ~  currentFeedback.reviewer.fullname  %}
    {% set isSelf = false %}
{% endif %}

{% set feedbackPublishDate = currentFeedback.published ? currentFeedback.publishedAt.short : currentFeedback.updatedAt.short %}

<ul class="information-list reply">
    <li class="{{ actionClass }}">
        <div class="list-item flex-grade">
            {% block card %}
            <div class="compact card small-12 sibling">
                {% set cardContent %}
                    <img src="/portrait.php?id={{ currentFeedback.reviewer.id }}&amp;size=square64" alt="">
                    <p>
                        {{ prefix }}
                        <span class="pipe meta">
                            {{ feedbackPublishDate }}
                        </span>
                    </p>
                {% endset %}
                {% if url %}
                    <a href="{{ url }}" title="{{ tooltip }}">{{ cardContent | raw }}</a>
                {% else %}
                    {{ cardContent | raw }}
                {% endif %}
            </div>
            {% endblock card %}
            {% if currentFeedback.humanReadableMark %}
                <div class="grade {{ urgency.marks(currentFeedback.normalisedMark) }}-bg">
                    <span>{{ currentFeedback.humanReadableMark }}</span>
                </div>
            {% endif %}
        </div>
        <nav>
            {% if hasCollapser %}
                <a href="#" class="icon-{{ collapsed ? 'up' : 'down' }}-arrow" data-collapser="feedback-{{ responseId }}-{{ currentFeedback.id }}"></a>
            {% endif %}
            {% if deleteRoute and deleteIcon %}
                <a class="icon-delete" data-delete="{{ deleteRoute }}"></a>
            {% endif %}
        </nav>

        {% if currentFeedback.comment|length %}
            <blockquote class="{{ collapsed ? 'hide' : '' }}"
                    {% if hasCollapser %}
                data-collapse-state="{{ collapsed ? 'collapsed' : 'expanded' }}"
                data-collapsable="feedback-{{ responseId }}-{{ currentFeedback.id }}"
                    {% endif %}>
                {{ currentFeedback.comment|linkify|nl2br }}
            </blockquote>
        {% else %}
            <article>
                <span class="meta">Comment not provided</span>
            </article>
        {% endif %}

        {% if currentFeedback.allFiles | length %}
            <ul class="information-list {{ collapsed?  'hide' : '' }}"
                {% if hasCollapser %}
                data-collapse-state="{{ collapsed ? 'collapsed' : 'expanded' }}"
                data-collapsable="feedback-{{ responseId }}-{{ currentFeedback.id }}"
                {% endif %}>
                {% for currentFile in currentFeedback.allFiles %}
                    {# Only show published feedback and therefore also
                     # only list files that are involved with a Published Feedback
                     #}
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="card attachment small-12">
                                {% set kamiViewRoute = currentFile.kami is defined
                                    ? routeLookupIfAuthorized('learningDueWorkResponse.getKamiView', {
                                        kamiId:       currentFile.kami.id,
                                        assessment:   assessment,
                                        student:      participant.user,
                                        feedback:     currentFeedback,
                                    })
                                    : null
                                %}
                                {% if kamiViewRoute and not isSelf %}
                                    <a href="{{ kamiViewRoute }}" title="{{ currentFile.filename }}">
                                        <img src="/ajax/mime/{{ currentFile.mime }}" alt="View Annotated Document" />
                                        <p>Annotated Feedback</p>
                                        <p class="meta">{{ currentFile.filename }}</p>
                                    </a>
                                {% else %}
                                    <a href="/storage/fetch.php?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}" data-plugin="preview">
                                        <img src="/ajax/mime/{{ currentFile.mime }}" alt="Download" />
                                        <p>{{ currentFile.filename }} </p>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                        <nav>
                            {% set kamiExportRoute = currentFile.kami is defined
                                ? routeLookupIfAuthorized('learningDueWorkResponse.getKamiExport', {
                                    kamiId:       currentFile.kami.id,
                                    assessment:   assessment,
                                    student:      participant.user,
                                    feedback:     currentFeedback,
                                })
                                : null
                            %}
                            {% if kamiExportRoute %}
                                <a href="{{ kamiExportRoute }}" data-kami-export class="icon-download" title="Download annotated document"></a>
                            {% else %}
                                <a href="/storage/fetch.php?hash={{ currentFile.hash }}&save=1" class="icon-download" title="Download"></a>
                            {% endif %}
                        </nav>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {# Rubric goes here #}
        {% if currentFeedback.rubricMarkedGrid %}
            <div class="rubric-wrap {{ collapsed? 'hide' : '' }}"
                 {% if hasCollapser %}
                 data-collapse-state="{{ collapsed? 'collapsed' : 'expanded' }}"
                 data-collapsable="feedback-{{ responseId }}-{{ currentFeedback.id }}"
                 {% endif %}>
                {% include '@rubric/grid.twig' with {
                    rubricGrid:       currentFeedback.rubricMarkedGrid.grid,
                    rubricMarkedGrid: currentFeedback.rubricMarkedGrid,
                    learner: participant.user,
                    markVisibility: currentFeedback.isSelfAssessment
                    or participant.assessable.isFeedbackVisibleToUser(USER),
                    showDescriptorValue: showDescriptorValue,
                    showGroupTotal: showGroupTotal,
                    showRubricTotal: showRubricTotal,
                    self: false,
                    studentView: true,
                    selfAssess: selfAssess ?? false,
                    selfReflect: selfReflect ?? false,
                    selfAssessmentFeedback: selfAssessmentFeedback ?? null
                } only %}
            </div>
        {% endif %}
    </li>
</ul>
