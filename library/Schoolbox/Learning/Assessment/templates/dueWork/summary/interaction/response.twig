{# if submitted, try going to inline grader #}
{% set url     = null %}
{% set tooltip = null %}
{% if currentInteraction.isSubmitted %}
    {% set url = routeLookupIfAuthorized('learningDueWorkResponse.getParticularResponse', {
        assessmentId: currentInteraction.assessable.id,
        studentId:    participant.user.id,
        responseId:   currentInteraction.id,
        response:     currentInteraction,
        participant:  participant
    }) %}
    {% if url %}
        {% set tooltip = 'View in Inline Grader' %}
    {% endif %}
{# else this is a draft #}
{% else %}
    {# does it belong to current user? #}
    {% if currentInteraction.submittedOnBehalfOf.id == USER.id %}
        {# try to resume at 'submit response' page #}
        {% set url = routeLookupIfAuthorized('learningAssessment.getCreateResponseForm', {
            assessmentId: currentInteraction.assessable.id,
            studentId:    participant.user.id,
            assessment:   currentInteraction.assessable,
            participant:  participant
        }) %}
        {% if url %}
            {% set tooltip = 'Resume Submission' %}
        {% endif %}
    {% endif %}
{% endif %}

{% if not url %}
    {# Just link to participant's profile #}
    {% set url = '/search/user/' ~ participant.user.id %}
    {% set tooltip = 'View Profile' %}
{% endif %}

{% set deleteRoute = routeLookupIfAuthorized('learningDueWorkResponse.deleteParticularResponse', {assessment: currentInteraction.assessable, assessmentId: currentInteraction.assessable.id, participant: participant, studentId: participant.user.id, responseId: currentInteraction.id, response: currentInteraction}) %}
<ul class="information-list threaded">
    <li class="actions-small-1">
        <ul class="action-list">
            <li class="actions-small-1">
                <div class="list-item">
                    <div class="card small-12">
                        {% if url %}
                        <a href="{{ url }}" title="{{ tooltip }}">
                        {% endif %}
                            <img src="/portrait.php?userId={{ participant.user.externalId }}&amp;size=square64" alt="{{ participant.user.fullname }}">
                            <p>
                                {% if currentInteraction.isSubmitted %}
                                    Submission
                                {% else %}
                                    Draft Submission
                                {% endif %}
                                by {{ participant.user.fullname }}
                            {% if currentInteraction.isSubmitted %}
                                <p class="meta">{{ currentInteraction.submittedAt.short }}</p>
                            {% else %}
                                <p class="meta">{{ currentInteraction.updatedAt.short }}</p>
                            {% endif %}
                            </p>

                        {% if url %}
                        </a>
                        {%  endif %}
                    </div>
                </div>
                {% if deleteRoute %}
                <nav>
                    <a class="icon-more" title="" data-dropdown="response-options-{{ currentInteraction.id }}"></a>
                </nav>
                <ul id="response-options-{{ currentInteraction.id }}" class="f-dropdown" data-dropdown-content>
                    <li><a href="{{ viewRoute }}" class="icon-delete" title="Delete Submission" data-delete="{{ deleteRoute }}">Delete</a></li>
                </ul>
                {% endif %}
            </li>
        </ul>
        {% if currentInteraction.allFiles %}
        <ul class="information-list">
        {% for currentFile in currentInteraction.allFiles %}
                {% include '@learning/dueWork/interaction/response/files.twig' with {
                    assessment: currentInteraction.assessable,
                    assessmentId: currentInteraction.assessable.id,
                    response: currentInteraction,
                    plagscanId: currentFile.plagscan.plagscanId
                } %}
            {% endfor %}
        </ul>
        {% endif %}

        {% if currentInteraction.allFeedback|length %}

                {% for currentFeedback in currentInteraction.allFeedback %}

                    {# We pass the responseId as well, so that people can download annotated kami docs
                     #}
                    {# TODO restore only to include, as rubricContext shouldn't be passed in #}
                    {% include '@learningAssessment/dueWork/summary/interaction/feedback.twig' with {
                        currentFeedback: currentFeedback,
                        assessment: currentInteraction.assessable,
                        assessmentId: currentInteraction.assessable.id,
                        responseId: currentInteraction.id,
                        participant: participant,
                        hasCollapser: true,
                        collapsed: true,
                        feedbackRubricContexts: feedbackRubricContexts,
                        deleteIcon: true,
                    }
                    only %}
                {% endfor %}

        {% endif %}
    </li>
</ul>
