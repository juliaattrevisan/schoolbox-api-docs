{##
 # Marking guide for submission history page.
 #
 # Currently only displays a rubric grid.
 #
 # @param IAssessable $assessment            A fully hydrated learning activity instance
 # @param bool $markVisibility               Whether this feedback is visible to the current user.
 # @param Participant $participant           A participating learner (if extant)
 # @param IFeedback $selfAssessmentFeedback  A self-graded feedback instance, if extant
 # @param string $rubricMarkedGridPayloads   A json-encoded representation of the rubric grid structure, marked grid, self graded grid
 # @param bool $showGroupTotal               An arbitrary decision about whether Capability Marks could display here, if extant.
 # @param bool $showRubricTotal              An arbitrary decision about whether Rubric Grid Totals could display here, if extant
 #}
{% if assessment.rubricInstances.count or (participant and participant.assessable.rubricInstances.count) %}
    {% include '@learningAssessment/dueWork/summary/rubric.twig' with {
        assessment: assessment,
        markVisibility: selfAssessmentFeedback ? true : false,
        participant: participant,
        selfAssessmentFeedback: selfAssessmentFeedback,
        rubricMarkedGridPayloads: null,
        showGroupTotal: false,
        showRubricTotal: false
    } %}
{% endif %}
