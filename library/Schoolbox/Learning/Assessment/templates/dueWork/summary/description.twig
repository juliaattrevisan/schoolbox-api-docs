{#
Renders an assessment's description and any attached files.
Overrides with participant-specific description if one is supplied.

Data:
    assessment  IAssessable
    participant ?Participant - optional. If supplied override real assessment values
#}
<section>
    {% set description = (participant and not participant.isExcluded) ? participant.description : assessment.description  %}
    {% if description|length %}
        {% if routeLookupIfAuthorized('immersiveReader.getTokenAndSubdomain') %}
            <script src="{{ CDN_PREFIX }}/js/immersive-reader/jquery.immersive-reader.js?v={{ config.site_version }}" type="text/javascript"></script>
            <script type="text/javascript">
                $(function () {
                    $('[data-immersive-reader]').immersiveReader({title: '{{ assessment.title | escape('js') }}'});
                });
            </script>
            <div class='immersive-reader-button' id="ir-button" data-immersive-reader="button"></div>
        {% endif %}
        <article class="content" id="ir-content" >
            {{ description | purify }}
        </article>
    {% endif %}

    {# Attached files #}
    {% if assessment.attachedFiles|length %}
        <script>
            $(function() {
                $('[data-plugin="preview"]').preview();
            });
        </script>
        <ul class="grid small-block-grid-1 medium-block-grid-2">
            {% for currentFile in assessment.attachedFiles %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="card attachment small-12">
                            <a data-plugin="preview" href="/storage/fetch.php?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}">
                                {% if currentFile.mimetype.image %}
                                    <img src="/storage/image.php?hash={{ currentFile.hash }}&size=square64" alt="Download" />
                                {% else %}
                                    <img src="/ajax/mime/{{ currentFile.mime }}" alt="Download" />
                                {% endif %}

                                <p>{{ currentFile.filename }}</p>
                                <p class="meta">{{ currentFile.size|bytes }}</p>
                            </a>
                        </div>
                    </div>
                    <nav>
                        <a href="/storage/fetch.php?hash={{ currentFile.hash }}&save=1" title="Download" class="icon-download"></a>
                    </nav>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
