{#
Data:
    submissionsBlocked     false|string  A string message if blocked, false if not blocked
    acknowledgementBlocked false|string  A string message if blocked, false if not blocked
    selfAcknowledgeRoute   string
    assessment             DueWork\Model
    student                User
    returnUrl              string
#}
<div class="row">
    <div class="small-12 columns">
        {% if not submissionsBlocked %}
            {% set submitRoute = routeLookupIfAuthorized('learningAssessment.getCreateResponseForm', {
                assessmentId: assessment.id,
                assessment: assessment,
                studentId: student.id,
                student: student
            }) %}
            {% if submitRoute %}
                {% set submitText %}{% apply spaceless %}
                    Create submission
                    {% if USER.id != student.id %}
                        on behalf of {{ student.fullname }}
                    {% endif %}
                {% endapply %}{% endset %}
                <a class="submit button" href="{{ submitRoute }}">{{ submitText }}</a>
            {% endif %}
        {% elseif not acknowledgementBlocked %}
            {% if selfAcknowledgeRoute %}
                {% if USER.id == student.id %}
                    {% set requiresReflection = assessment.isSelfAssessable %}
                    <button class="submit"
                            data-action-self-reflect
                            data-confirm-dialog-header="Have you submitted your work?"
                            data-confirm-dialog-text="
                                This action will inform your teacher that you have submitted your work.
                                {% if requiresReflection %}
                                    Next, you will be asked to reflect upon what you have submitted.
                                {% endif %}
                            "
                            data-confirm-dialog-confirm-label="Proceed"
                            data-confirm-dialog-cancel-label="Cancel"
                    >
                        I have submitted my work in person
                    </button>
                {% endif %}
            {% endif %}
        {% else %}
           <a href="{{ returnUrl }}" class="submit button full-width">Return</a>
        {% endif %}
        <div class="toast" data-toast></div>
    </div>
</div>
