{#
Data:
    assessment            DueWork\Model
    student               User
    participant           null|Participant\Model
    breadcrumbs
    submissionsBlocked    false|string  A string message if blocked, false if not blocked
    acknowlegementBlocked false|string  A string message if blocked, false if not blocked
    authoritativeFeedback null|DueWork\Feedback\Model
    emptyRubricContext
    timeline
#}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

{% set selfAcknowledgeRoute = routeLookupIfAuthorized('learningAssessment.postSelfAcknowledge', {
    assessmentId: assessment.id,
    assessment: assessment,
    studentId: student.id,
    student: student
}) %}

{% set showGroupTotal = assessment.markPerCapability %}
{% set showDescriptorValue = true %}
{% set showRubricTotal = false %}

{% autoescape 'js' %}
<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();

        var route = '{{ selfAcknowledgeRoute }}';
        if (route) {
            var toast = $('[data-toast]');
            $('[data-action-self-reflect]').click(function(e) {
                e.preventDefault();
                var $this = $(this);
                $this.confirmDialog({
                    confirmEvent: function() {
                        toast.toastActivate({ text: 'Acknowledging...' });
                        $.post(route, {}, null, 'json')
                            .done(function(data) {
                                // Raise success toast, and redir to wherever the response tells me
                                toast.toastTimeout({
                                    text: 'Acknowledged!',
                                    css: 'success'
                                });
                                if (data.location) {
                                    window.location.href = data.location;
                                } else {
                                    window.location.reload();
                                }
                            })
                            .fail(function() {
                                // Raise fail toast
                                toast.toastTimeout({
                                    text: 'Acknowledgement failed!',
                                    css: 'alert'
                                });
                            });
                    }
                });
            });
        }
    });
</script>
{% endautoescape %}

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/meta.twig' with {
            assessment: assessment,
            submissionsBlocked: submissionsBlocked,
            student: student,
            icon: 'icon-due-work'
        } only %}
    </div>
    {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
    {% include '@learningAssessment/fragments/modifyTot.twig' %}
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/dueWork/summary/description.twig' with {assessment: assessment, participant: participant} only %}
    </div>
</div>

{# show authoritative feedback if it's there #}
{% if authoritativeFeedback %}
    {% include '@learningAssessment/dueWork/summary/mark.twig' with {
        feedback: authoritativeFeedback,
        selfAssessmentFeedback: selfAssessmentFeedback,
        participant: participant,
        selfAssess: selfAssess,
    } %}
{% else %}
    {% include '@learningAssessment/dueWork/summary/markingGuide.twig' with {
        participant: participant,
        selfAssessmentFeedback: selfAssessmentFeedback,
    } %}
{% endif %}
{% if (currentFeedback.isSelfAssessment or participant.assessable.isFeedbackVisibleToUser(USER)) and selfAssessmentFeedback.comment|length %}
    <div class="row">
        <div class="small-12 island">
            <legend class="subheader">
                {% spaceless %}
                    {% if selfAssessmentFeedback.isSelfGrading %}
                        {{ locale.selfAssessment.proper }}
                    {% else %}
                        {{ locale.selfReflection.proper }}
                    {% endif %}
                {% endspaceless %}
            </legend>
            <div class="flex-grade">
                <ul class="information-list threaded sibling">
                    <li>
                        <blockquote>{{ selfAssessmentFeedback.comment|nl2br }}</blockquote>
                    </li>
                </ul>
            </div>
        </div>
    </div>
{% endif %}

{# Students must have ePortfolio enabled, otherwise they can't do this
 #}
{% if student.eportfolioEnable %}
    <a class="icon-showcase" data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" title="Publish to ePortfolio">Publish to ePortfolio</a>

    <form class="hide" action="/eportfolio/showcase/modifyForm.php" method="post" data-publish-to-eportfolio-form="{{ assessment.id }}">
        <input type="hidden" name="action" value="publish">
        <input type="hidden" name="userId" value="{{ student.id }}">
        <input type="hidden" name="assessmentId" value="{{ assessment.id }}">
    </form>
    <script type="text/javascript">
        $(function () {
            $('[data-publish-to-eportfolio]').click(function (event) {
                event.preventDefault();

                var assessmentId = $(this).data('publishToEportfolio');

                $(this).confirmDialog({
                    header: "Publish to ePortfolio Showcase",
                    text: 'Are you sure you want to publish this work to your ePortfolio showcase? This will make the work visible to everyone.',
                    confirmEvent: function () {
                        $('[data-publish-to-eportfolio-form="' + assessmentId + '"]').eportfolio_publish({
                            activator: '[data-publish-to-eportfolio="' + assessmentId + '"]'
                        });
                    }
                });
            });
        });
    </script>
{% endif %}

{# Submit button: goes underneath history if it's empty, above history if not #}
{% if timeline is not empty %}
    {% include '@learningAssessment/dueWork/summary/submitButton.twig' with {
        submissionsBlocked: submissionsBlocked,
        acknowlegementBlocked: acknowlegementBlocked,
        selfAcknowledgeRoute: selfAcknowledgeRoute,
        assessment: assessment,
        student: student
    } only%}
{% endif %}

{% include '@learningAssessment/dueWork/history.twig' %}

{% if timeline is empty %}
    {% include '@learningAssessment/dueWork/summary/submitButton.twig' with {
        submissionsBlocked: submissionsBlocked,
        acknowlegementBlocked: acknowlegementBlocked,
        selfAcknowledgeRoute: selfAcknowledgeRoute,
        assessment: assessment,
        student: student
    } only %}
{% endif %}
