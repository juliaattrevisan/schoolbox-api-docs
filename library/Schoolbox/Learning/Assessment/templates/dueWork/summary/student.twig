{##
# @param DueWork\Model                assessment
# @param User                         student
# @param null|Participant\Model       participant
# @param Collection                   breadcrumbs
# @param false|string                 submissionsBlocked      A string message if blocked, false if not blocked
# @param false|string                 acknowledgementBlocked  A string message if blocked, false if not blocked
# @param null|DueWork\Feedback\Model  authoritativeFeedback
# @param null|FullTimeline            timeline
# @param bool                         canShowcase
#}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

{% set selfAcknowledgeRoute = routeLookupIfAuthorized('learningAssessment.postSelfAcknowledge', {
    assessmentId: assessment.id,
    assessment: assessment,
    studentId: student.id,
    student: student
}) %}

{% set showGroupTotal = assessment.isMarkPerCapability %}
{% set showDescriptorValue = true %}
{% set showRubricTotal = false %}

{% autoescape 'js' %}
<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();

        var route = '{{ selfAcknowledgeRoute }}';
        if (route) {
            var toast = $('[data-toast]');
            $('[data-action-self-reflect]').click(function(e) {
                e.preventDefault();
                var $this = $(this);
                $this.confirmDialog({
                    confirmEvent: function() {
                        toast.toastActivate({ text: 'Acknowledging...' });
                        $.post(route, {}, null, 'json')
                            .done(function(data) {
                                // Raise success toast, and redir to wherever the response tells me
                                toast.toastTimeout({
                                    text: 'Acknowledged!',
                                    css: 'success'
                                });
                                if (data.location) {
                                    window.location.href = data.location;
                                } else {
                                    window.location.reload();
                                }
                            })
                            .fail(function() {
                                // Raise fail toast
                                toast.toastTimeout({
                                    text: 'Acknowledgement failed!',
                                    css: 'alert'
                                });
                            });
                    }
                });
            });
        }
    });
</script>
{% endautoescape %}

<div class="row actions-small-2">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/meta.twig' with {
            assessment: assessment,
            submissionsBlocked: submissionsBlocked,
            student: student,
            icon: 'icon-due-work',
            canShowcase: canShowcase,
            isShowcased: isShowcased,
            participant: participant,
            lastViews: lastViews
        } only %}
    </div>
    {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
    {% set similarityReportRoute = routeLookupIfAuthorized('learningAssessment.getSimilarityReport', {assessmentId: assessment.id, assessment: assessment}) %}
    {% include '@learningAssessment/fragments/modifyTot.twig' with {
        viewRoute: viewRoute,
        modifyRoute: modifyRoute,
        canShowcase: canShowcase,
        isShowcased: isShowcased,
        similarityReportRoute: similarityReportRoute,
        externalRedirectUrl: externalRedirectUrl
    } %}
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/dueWork/summary/description.twig' with {assessment: assessment, participant: participant} only %}
    </div>
</div>

{# show authoritative feedback if it's there #}
{% if authoritativeFeedback %}
    {% include '@learningAssessment/dueWork/summary/mark.twig' with {
        feedback: authoritativeFeedback,
        selfAssessmentFeedback: selfAssessmentFeedback,
        participant: participant,
        selfAssess: selfAssess,
        assessment: assessment,
        student: student,
        canShowcase: canShowcase
    } %}
{% else %}
    {% include '@learningAssessment/dueWork/summary/markingGuide.twig' with {
        participant: participant,
        selfAssessmentFeedback: selfAssessmentFeedback,
    } %}
{% endif %}

{% if ((currentFeedback.isSelfAssessment ?? false) or (participant and participant.assessable.isFeedbackVisibleToUser(USER))) and (selfAssessmentFeedback.comment ?? '')|length %}
    <div class="row">
        <div class="small-12 island">
            <legend class="subheader">
                {% apply spaceless %}
                    {% if selfAssessmentFeedback.isSelfGrading %}
                        {{ locale.selfAssessment.proper }}
                    {% else %}
                        {{ locale.selfReflection.proper }}
                    {% endif %}
                {% endapply %}
            </legend>
            <div class="flex-grade">
                <ul class="information-list threaded sibling">
                    <li>
                        <blockquote>{{ selfAssessmentFeedback.comment|nl2br }}</blockquote>
                    </li>
                </ul>
            </div>
        </div>
    </div>
{% endif %}

<div class="toast" data-alert="" id="publish-to-eportfolio-label"></div>

{# Submit button: goes underneath history if it's empty, above history if not #}
{% if timeline is not empty %}
    {% include '@learningAssessment/dueWork/summary/submitButton.twig' with {
        submissionsBlocked: submissionsBlocked,
        acknowledgementBlocked: acknowledgementBlocked,
        selfAcknowledgeRoute: selfAcknowledgeRoute,
        assessment: assessment,
        student: student,
        returnUrl: returnUrl
    } only%}
{% endif %}

{% include '@learningAssessment/dueWork/history.twig' %}

{% if timeline is empty %}
    {% include '@learningAssessment/dueWork/summary/submitButton.twig' with {
        submissionsBlocked: submissionsBlocked,
        acknowledgementBlocked: acknowledgementBlocked,
        selfAcknowledgeRoute: selfAcknowledgeRoute,
        assessment: assessment,
        student: student,
        returnUrl: returnUrl
    } only %}
{% endif %}
