{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

{% set selfAcknowledgeRoute = routeLookupIfAuthorized(
    'learningAssessment.postAcknowledgeDraft',
    { assessmentId: participant.assessable.id, studentId: participant.user.id, assessment: participant.assessable, participant: participant }
) %}

{% autoescape 'js' %}
<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();

        var route = '{{ selfAcknowledgeRoute }}';
        if (route) {
            var toast = $('[data-toast]');
            $('[data-action-self-reflect]').click(function(e) {
                e.preventDefault();
                var $this = $(this);
                $this.confirmDialog({
                    text: $this.data('confirmDialogText'),
                    confirmEvent: function() {
                        toast.toastActivate({ text: 'Acknowledging...' });
                        $.post(route, {}, null, 'json')
                            .done(function(data) {
                                // Raise success toast, and redir to wherever the response tells me
                                toast.toastTimeout({
                                    text: 'Acknowledged!',
                                    css: 'success'
                                });
                                if (data.location) {
                                    window.location.href = data.location;
                                } else {
                                    window.location.reload();
                                }
                            })
                            .fail(function() {
                                // Raise fail toast
                                toast.toastTimeout({
                                    text: 'Acknowledgement failed!',
                                    css: 'alert'
                                });
                            });
                    }
                });
            });
        }
    });
</script>
{% endautoescape %}

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ participant.assessable.title }}</h1>
        {% include '@learningAssessment/meta.twig' with {assessment: participant.assessable, submissionsBlocked: submissionsBlocked, student: participant.user, user: USER, icon: 'icon-due-work'} %}
    </div>
    {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: participant.assessable.id, assessment: participant.assessable}) %}
    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: participant.assessable.id, assessment: participant.assessable}) %}
    {% if viewRoute or modifyRoute %}
    <nav>
        <a href="#" class="icon-more" data-dropdown="header-options" title="Actions"></a>
    </nav>
    <ul data-dropdown-content id="header-options" class="f-dropdown">
        {% if viewRoute %}
            <li><a class="icon-progress" href="{{ viewRoute }}">View Status</a></li>
        {% endif %}
        {% if modifyRoute %}
            <li><a href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-modify">Modify</a></li>
        {% endif %}
    </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/dueWork/summary/description.twig' with {assessment: participant.assessable, participant: participant} only %}
    </div>
</div>

{# show authoritative feedback if it's there #}
{% if authoritativeFeedback %}
    {% include '@learningAssessment/dueWork/summary/mark.twig' with {
        feedback: authoritativeFeedback,
        participant: participant,
    } %}
{% else %}
    {% include '@learningAssessment/dueWork/summary/markingGuide.twig' with {
        rubricContext: emptyRubricContext,
        participant: participant,
    } %}
{% endif %}

{% include '@learningAssessment/dueWork/history.twig' %}

<div class="row">
    <div class="small-12 columns">
        {% if not submissionsBlocked %}
            {% set submitRoute = routeLookupIfAuthorized('learningAssessment.getCreateResponseForm', { assessmentId: participant.assessable.id, studentId: participant.user.id, assessment: participant.assessable, participant: participant }) %}
            {% if submitRoute %}
                {% set submitText %}{% spaceless %}
                    Create submission
                    {% if USER.id != participant.user.id %}
                        on behalf of {{ participant.user.fullname }}
                    {% endif %}
                {% endspaceless %}{% endset %}
                <a class="submit button expand" href="{{ submitRoute }}">{{ submitText }}</a>
            {% endif %}
        {% elseif not acknowlegementBlocked %}
            {% if selfAcknowledgeRoute %}
                {% set requiresReflection = participant.assessable.isSelfAssessable or participant.assessable.isSelfReflectable %}
                <button class="submit expand"
                        data-action-self-reflect
                        data-confirm-dialog-header="Have you submitted your work?"
                        data-confirm-dialog-text="
                            This action will inform your teacher that you have submitted your work.
                            {% if requiresReflection %}
                                Next, you will then be asked to reflect upon what you have submitted.
                            {% endif %}
                        "
                        data-confirm-dialog-confirm-label="Proceed"
                        data-confirm-dialog-cancel-label="Cancel"
                >
                    {% if requiresReflection %}
                        I have submitted my work, and wish to reflect on it
                    {% else %}
                        I have submitted my work
                    {% endif %}
                </button>
            {% endif %}
        {% endif %}
        <div class="toast" data-toast></div>
    </div>
</div>
