{##
 # Participant's mark for submission history page.
 #
 # Currently displays the authoritative feedback.
 #
 # @param DueWork\Feedback\Model feedback
 # @param Participant            participant
 # @param bool                   selfAssess
 # @param bool                   canShowcase
 #}
<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">{{ locale.grading.proper }}</h2>
    </div>
</div>

<div class="row" data-test="assessment-feedback-summary">
    <div class="small-12 island">
        <section>
            {% include '@learningAssessment/dueWork/summary/interaction/card.twig' with {
                currentFeedback: feedback,
                selfAssessmentFeedback: selfAssessmentFeedback,
                selfAssess: selfAssess,
                selfReflect: false,
                participant: participant,
                hasCollapser: false,
                collapsed: false,
                deleteIcon: false,
            } %}
        </section>
    </div>
</div>
