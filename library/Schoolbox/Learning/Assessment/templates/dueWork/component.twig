{% import '@learningAssessment/fragments/macro/urgency.twig' as urgency %}
<section>
    <ul class="action-list">
        {% for assessable in assessables %}
            <li class="actions-small-1">
                <div class="list-item">
                    <div class="card small-12">
                        {% if assessable.dueDate.isFuture or user.role.isStaff %}
                            <a href="/submission/viewSubmission/{{ assessable.dueWork.id }}">
                        {% endif %}
                        <h3>{{ assessable.title }}</h3>
                        {% if assessable.dueDate.isFuture or user.role.isStaff %}
                            </a>
                        {% endif %}
                        <p class="meta">
                            <span class="gradient-{{ urgency.gradientIndex(assessment) }}">
                                Due {{ assessable.dueDate.relativeTime }} on {{ assessable.dueDate.dateOnly }}
                            </span>
                        </p>
                    </div>
                </div>
                <nav>

                    {% if isRouteAuthorized('learningAssessment.postUpdateAssessment', {assessmentId: assessable.id}) %}
                        <a class="icon-modify" href="{{ routeLookup('learningAssessment.getUpdateAssessment', {assessmentId: assessable.id}) }}" title="Modify"></a>
                    {% endif %}

                    {% if assessment is quiz %}

                        {# TODO: Replace hrefs with routeLookup #}
                        {% if isRouteAuthorized('learningAssessment.postDeleteAssessment') %}
                            <a class="icon-delete" href="/assess/delete/{{ assessable.quiz.id }}" data-action="delete" title="Delete Quiz"></a>
                        {% endif %}
                        <a class="icon-poll" href="/assess/results/{{ assessable.quiz.id }}" title="View Results"></a>

                        {# TODO: Find way to work out if there are any attempts #}
                        {% if true %}
                            <a class="icon-list" href="/assess/attempts/{{ assessable.quiz.id }}/{{ user.id }}" title="See previous attempts"></a>
                        {% endif %}

                    {% endif %}

                </nav>
                <article {% if compact %}class="hide"{% endif %}>
                    {{ assessable.dueWork.description | purify }}
                </article>
            </li>
        {% endfor %}
    </ul>
    <div class="content">
        {# TODO: Replace hrefs with routeLookup #}
        {% if user.role.isStudent %}
            <a href="/submission/allWork/{{ user.id }}/{{ termCode }}/{{ folder.id }}" title="View grades" class="button icon-approve">View Grades</a>
        {% endif %}
        {% if isRouteAuthorized('learningAssessment.postCreateAssessment') %}
            <a href="{{ routeLookup('learningAssessment.getSelectAssessmentInFolder', {folderId: folder.id, assessmentTypeTitle: 'dueWork'}) }}" class="button icon-due-work">Post Due Work</a>
        {% endif %}
    </div>
</section>