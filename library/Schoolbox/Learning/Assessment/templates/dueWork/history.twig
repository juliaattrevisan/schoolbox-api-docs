{% import '@learning/macro/urgency.twig' as urgency %}

<script type="application/javascript" src="{{ CDN_PREFIX }}/js/submissions/jquery.kami-export.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {

        var $history = $('[data-submission-history]');

        $history.find('[data-collapser]').collapsable();

        $history.on('click', '[data-delete]', function (e) {
            e.preventDefault();
            var $a = $(this);

            $a.confirmDialog({
                header: 'Delete Interaction',
                format: 'html',
                text: 'Are you sure you want to delete this interaction? Anything attached to it will also be deleted.',
                confirmLabel: 'Delete',
                confirmEvent: function () {

                    {# A toast #}
                    var $toast = $history.find('[data-alert]');
                    $toast.toastActivate({text: 'Deleting interaction...'});

                    $.ajax($a.data('delete'), {
                        headers: {
                            'X-HTTP-Method-Override': 'DELETE'
                        },
                        dataType: 'json',
                        type: 'POST'
                    })
                    .done(function () {
                        {# successful: reload the page to show the changed content -#}
                        window.location.reload();
                    })
                    .fail(function () {
                        {# i'll drink to that! -#}
                        $toast.toastTimeout({
                            text: 'Could not delete this interaction',
                            css: 'pop alert'
                        });
                    });
                }
            });
        });

        // Activate export of Kami Documents
        $('[data-kami-export]').kamiExport({
            toast: $history.find('[data-alert]')
        });
    });
</script>

{% if timeline|length %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ locale.submissionHistory.proper }}</h2>
            {% for currentInteraction in timeline %}
                <section class="submission-history" data-submission-history>
                {% if currentInteraction is response %}
                    {% include '@learningAssessment/dueWork/summary/interaction/response.twig' with {
                        currentInteraction: currentInteraction,
                        participant: participant,
                    } %}
                {% elseif currentInteraction is feedback %}
                    {% set hasCollapser = currentInteraction.allFiles.count or currentInteraction.comment | length > 0 or currentInteraction.rubricMarkedGrid %}
                    {% include '@learningAssessment/dueWork/summary/interaction/feedback.twig' with {
                        currentFeedback: currentInteraction,
                        participant: participant,
                        hasCollapser: hasCollapser,
                        collapsed: true,
                        deleteIcon: true,
                    } %}
                {% endif %}
                </section>
            {% endfor %}
        <div class="toast" data-alert></div>
    </div>
</div>
{% else %}
<div class="row">
    <div class="small-12 columns">
        <div class="empty-state">
            <i class="icon-due-work"></i>
            <p>There has not been any activity on this {{ locale.assessment }} yet.</p>
        </div>
    </div>
</div>
{% endif %}
