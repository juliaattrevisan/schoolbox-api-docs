{% import '@learning/macro/urgency.twig' as urgency %}
<script type="application/javascript" src="/javascript/shared/submissions/jquery.kami-export.js"></script>
<script type="text/javascript">
    $(function() {

        var $history = $('#history');

        $('#view-history').on('click', function(event) {
            event.preventDefault();

            $(this).remove();

            $history
                .find('[data-history-row]:hidden')
                .css({opacity:0})
                .show()
                .animate({opacity:1}, 2000);
        });

        $history.on('click', '[data-delete]', function (e) {
            e.preventDefault();
            var $a = $(this);

            $a.confirmDialog({
                header: 'Delete Interaction',
                format: 'html',
                text: 'Are you sure you want to delete this interaction? Anything attached to it will also be deleted.',
                confirmLabel: 'Delete',
                cancelLabel: 'Cancel',
                confirmEvent: function () {

                    {# A toast #}
                    var $toast = $history.find('[data-alert]');
                    $toast.toastActivate({text: 'Deleting interaction...'});

                    $.ajax($a.data('delete'), {
                        headers: {
                            'X-HTTP-Method-Override': 'DELETE'
                        },
                        dataType: 'json',
                        type: 'POST'
                    })
                    .done(function () {
                        {# successful: reload the page to show the changed content -#}
                        window.location.reload();
                    })
                    .fail(function () {
                        {# i'll drink to that! -#}
                        $toast.toastTimeout({
                            text: 'Could not delete this interaction',
                            css: 'pop alert'
                        });
                    });
                }
            });
        });

        // Activate export of Kami Documents
        $('[data-kami-export]').kamiExport({
            toast: $history.find('[data-alert]')
        });
    });
</script>

{% if timeline|length %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ locale.submissionHistory.proper }}</h2>

        <section id='history'>
            {% set firstSubmissionIndex = 0 %}
            {% set isOlderInteraction = false %}

            {# Lookahead to see if there was at least one submission
             #}
            {% for currentInteraction in timeline %}
                {% if currentInteraction is response and not firstSubmissionIndex %}
                    {% set firstSubmissionIndex = loop.index %}
                {% endif %}
            {% endfor %}

            {% for currentInteraction in timeline %}
                {# There is a submission somewhere in this history
                 # Everything that comes after it should be Older Interactions
                 #}
                {% if firstSubmissionIndex and loop.index > firstSubmissionIndex %}
                    {% set isOlderInteraction = true %}
                {% elseif not firstSubmissionIndex and loop.index > 1 %}
                    {% set isOlderInteraction = true %}
                {% endif %}

                {% if currentInteraction is response %}
                    {% include '@learningAssessment/fragments/dueWork/summary/interaction/response.twig' with {currentInteraction: currentInteraction, participant: participant} %}
                {% elseif currentInteraction is feedback %}
                    {% include '@learningAssessment/fragments/dueWork/summary/interaction/feedback.twig' with {currentFeedback: currentInteraction, participant: participant} %}
                {% endif %}
            {% endfor %}

            <div class="toast" data-alert></div>
        </section>

        {% if timeline|length > 1 %}
            {% if firstSubmissionIndex %}
                {% set olderInteractions = timeline|length - firstSubmissionIndex %}
            {% else %}
                {% set olderInteractions = timeline|length - 1 %}
            {% endif %}

            {% if olderInteractions %}
            <a id="view-history" class="button full-width icon-down-arrow">View {{ olderInteractions }} older interaction{% if olderInteractions > 1 %}s{% endif %}</a>
            {% endif %}
        {% endif %}
    </div>
</div>
{% else %}
<div class="row">
    <div class="small-12 columns">
        <div class="empty-state">
            <i class="icon-due-work"></i>
            <p>There has not been any activity on this {{ locale.assessment }} yet.</p>
        </div>
    </div>
</div>
{% endif %}
