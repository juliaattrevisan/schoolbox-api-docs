{##
 # Create/Update form
 #
 # Used to create a new assessment or update an existing one
 # Used in multiple ocntexts: creating due work in a homepage or in a course
 #
 # @param CourseManagedFields courseManaged
 #     Decide whether certain fields are readonly due to being Course Managed
 #     Some users can change the values; some can't. Note also this template
 #     is shared among multiple workflows and use cases - see the class docblock
 #     for more details on how these facts play out
#}

{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

{# ----------------------------------------------------------- #}
{# Basic Details #}
{# ----------------------------------------------------------- #}
<fieldset>
    <label class="required" for="title">Title</label>
    {% if customisedFor is defined %}
        <p class="meta">The title cannot be the same as the original activity.</p>
    {% endif %}
    <input type="text" name="title" id="title" data-test="assessment-form-input-title" value="{{ assessment.title }}" required maxlength="255" {% if courseManaged.isReadonly %}readonly{% endif %} />

    <div class="row">

        {# This Course Managed option shouldn't exist in a Folder context at all,
         # since that has nothing to do with an overarching course dominating its settings
         #}
        {% if courseManaged.isVisible %}
            {% set columnCss = 'medium-6' %}
        {% else %}
            {% set columnCss = '' %}
        {% endif %}

        <div class="small-12 {{ columnCss }} columns">
            {# ----------------------------------------------------------- #}
            {# Work Type #}
            {# ----------------------------------------------------------- #}
            {% include '@learningAssessment/fragments/workTypeSelectorWithLabel.twig'
                with {
                    allWorkTypes: allWorkTypes,
                    assessment: assessment,
                    courseManaged: courseManaged
                } only
            %}
        </div>

        {% if courseManaged.isVisible %}
        <div class="small-12 {{ columnCss }} columns">

            {# For when the checkbox itself is disabled, since that won't submit to backend
             # under those circumstances, inadvertently unlocking this setting
             #
             # If it's been disabled, preserve whatever setting it currently has
             #}
            <input type="hidden" name="courseManaged" value="{% if not courseManaged.isMutable %}{{ assessment.courseManaged }}{% else %}0{% endif %}" />

            <label for="courseManaged" class="checkbox-label inline-block">Common Assessment <span class="hint has-tip tip-top"  title="To ensure consistency, you can't edit these fields when you import {{ locale.dueWork.proper }} to a class: Title, Work Type, Submission Types, Weight, Mark Type, and Rubric." data-tooltip="">?</span></label>

            <div class="switch">
                <input name="courseManaged" id="courseManaged" type="checkbox" {% if assessment.courseManaged %}checked="checked"{% endif %} {% if not courseManaged.isMutable %}disabled{% endif %}/>
                <label for="courseManaged">
                    <span class="icon-approve"></span>
                    <span class="icon-cancel"></span>
                </label>
            </div>
        </div>
        {% endif %}
    </div>

    {# ----------------------------------------------------------- #}
    {# Curriculum #}
    {# ----------------------------------------------------------- #}
    {% include '@learningAssessment/fragments/curriculumCodes.twig' with {
        entityType: locale.dueWork.proper,
        courseManagedReadonly: courseManaged.isReadonly,
        excludeLegend: true,
        hasTabs: true,
        parentFolderId: parentFolderId ?? null,
    } %}

    {% include '@learningAssessment/fragments/viewSuggestedCustomisation.twig'
        with {
        participants: participants ?? [],
        differentiationEnabled: differentiationEnabled,
        assessment: assessment,
        assessmentId: customisedFor ?? 0,
        editorId: 'assessment-description',
    } only
    %}
    <textarea name="description" id="assessment-description" data-test="assessment-form-input-description">{{ assessment.description }}</textarea>

    {% include 'sub/attachzone.twig' with {attachzone: attachzone} only %}

    {# ----------------------------------------------------------- #}
    {# Assessment Location #}
    {# ----------------------------------------------------------- #}
    {% if canRelocate %}
        {% include '@learningAssessment/fragments/assessmentLocation.twig' %}
    {% endif %}
</fieldset>

{# ----------------------------------------------------------- #}
{# Submissions #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>Submissions</legend>
    <div class="row">
        <div class="medium-6 columns">
            <label for="acceptOnline">Accepts Online Submissions?</label>
            <select name="acceptOnline" id="acceptOnline" data-test="assessment-form-select-acceptOnline" {% if courseManaged.isReadonly %}readonly{% endif %}>
                {% set options = {
                    0: 'None',
                    1: 'Single',
                    2: 'Multiple'
                } %}
                {% for index, title in options %}
                    <option value="{{ index }}"
                        {% if assessment.acceptOnline == index %}
                            selected="selected"
                        {% elseif courseManaged.isReadonly %}
                            disabled
                        {% endif %}
                    >{{ title }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="medium-6 columns" id="similarityRow"{% if not assessment.acceptOnline %} style="display: none"{% endif %}>
            <input type="hidden" name="similarityCheckEnabled" value="{% if assessment.courseManaged %}{{ assessment.similarityCheckEnabled }}{% else %}0{% endif %}" />

            <label for="similarityCheckEnabled" class="inline-block">Similarity Check <span class="hint has-tip tip-top" title="Turn this on to enable similarity checking on students' submissions." data-tooltip>?</span></label>
            <div class="switch">
                <input id="similarityCheckEnabled"
                       name="similarityCheckEnabled"
                       type="checkbox"
                        {{ assessment.similarityCheckEnabled ? 'checked' : '' }}
                        {% if courseManaged.isReadonly %}
                            disabled
                        {% endif %}
                >
                <label for="similarityCheckEnabled">
                    <span>On</span>
                    <span>Off</span>
                </label>
            </div>
        </div>
    </div>
    <div class="row" id="submissionType" style="display:none" data-test="assessment-form-submission-type-container">
        <div class="small-12 columns">
            <label class="required">Select the type of submission allowed:</label>
            <ul class="option-list">
                {% if kami_enabled %}
                <li {% if not config.kami_worksheets_enabled %}style="display:none"{% endif %}>
                    <input id="worksheet" {% if courseManaged.isReadonly %} readonly {% endif %} type="checkbox" {{ assessment.getEnableWorksheet ? 'checked' : '' }} name="submissionOptions[]" value="enableWorksheet" data-type-group>
                    <label for="worksheet" class="checkbox-label" data-test="assessment-form-submission-type-interactive_worksheet">Interactive Worksheet </label>
                    <span class="hint has-tip tip-top" data-tooltip title="This provides students with one interactive worksheet per {{ locale.dueWork.proper }} that they can interact with online. As a teacher, you can monitor and provide in-line feedback as the student progresses. ">?</span>
                    <div id="worksheetDropzone" {{ assessment.getEnableWorksheet ? '' : 'style="display:none"' }}>
                        <p class="meta">You can't edit or replace the template after the {{ locale.dueWork.proper }} has been created and the template has been added.  Please upload only when it's final.</p>
                        {% include 'sub/attachzone.twig' with {attachzone: attachzoneWorksheet} only %}
                    </div>
                    <input type="hidden" name="worksheet-file" id="worksheet-file" />

                    {# Forcibly untick this checkbox to fool the validator
                     # Only applies if you have kami worksheets disabled.
                     #}
                    {% if not config.kami_worksheets_enabled %}
                    <script>
                        $(function() {
                            $('#worksheet').prop('checked', false);
                        })
                    </script>
                    {% endif %}
                </li>
                {% endif %}
                <li>
                    <input id="allow-offline" {% if courseManaged.isReadonly %} readonly {% endif %} type="checkbox" {{ assessment.getEnableOffline ? 'checked' : '' }} name="submissionOptions[]" value="enableOffline" data-type-group>
                    <label for="allow-offline" class="checkbox-label" data-test="assessment-form-submission-type-allow-offline">Submit in person</label>
                    <span class="hint has-tip tip-top" data-tooltip title="This will allow students who submit their {{ locale.dueWork.proper }} in person to acknowledge that it has been completed.">?</span>
                </li>
                <li>
                    <input id="text-editor" {% if courseManaged.isReadonly %} readonly {% endif %} type="checkbox" {{ assessment.getEnableText ? 'checked' : '' }} name="submissionOptions[]" value="enableText" data-type-group>
                    <label for="text-editor" class="checkbox-label" data-test="assessment-form-submission-type-text-editor">Text Editor</label>
                    <span class="hint has-tip tip-top" data-tooltip title="This will allow students to type or paste text directly into the text editor for their submission. An HTML file gets created, which you can download and also check for similarity across submissions.">?</span>
                </li>
                <li>
                    <input id="files" {% if courseManaged.isReadonly %} readonly {% endif %} type="checkbox" {{ assessment.getEnableFiles ? 'checked' : '' }} name="submissionOptions[]" value="enableFiles" data-type-group>
                    <label for="files" class="checkbox-label" data-test="assessment-form-submission-type-files">File Upload</label>
                    <span class="hint has-tip tip-top" data-tooltip title="This will allow students to upload files as part of their {{ locale.dueWork.proper }} submission.">?</span>
                </li>
            </ul>
            {% if lmsStudentPolicy | length %}
                <input type="hidden" name="enablePolicy" value="{% if courseManaged.isReadonly and assessment.getEnablePolicy %}on{% else %}0{% endif %}" />
                <label for="declaration" class="inline-block">Student Authenticity Declaration Terms</label>
                <span class="hint has-tip tip-top" data-tooltip title="This will require students to agree to the terms of the student authenticity declaration when they submit {{ locale.dueWork.proper }}.">?</span>
                </br><aside class="meta"><a class="link" data-reveal-id="policyDialog">View Authenticity Declaration Terms</a></aside>
                <div class="switch">
                    <input name="enablePolicy" id="declaration" type="checkbox" {% if assessment.getEnablePolicy %}checked="checked"{% endif %} {% if courseManaged.isReadonly %}disabled{% endif %} />
                    <label for="declaration">
                        <span class="icon-approve"></span>
                        <span class="icon-cancel"></span>
                    </label>
                </div>
                <div data-reveal="" role="dialog" id="policyDialog" class="reveal-modal" aria-hidden="true" style="display: none; top: 100px; opacity: 1; visibility: hidden;">
                    <h2>Authenticity Declaration Terms</h2>
                    <p>{{ lmsStudentPolicy | purify }}</p>
                    <a class="close-reveal-modal" data-close aria-label="Close">×</a>
                </div>
            {% endif %}
        </div>
    </div>
    {% include '@learningAssessment/fragments/default_open_span.twig' with {assessment: assessment} only %}
    {% if context.baseContext is not unitSpecification %}
        {% include '@learningAssessment/fragments/dates.twig' with {
            assessment: assessment
        } %}
    {% endif %}

    {# Enforce Safe Exam Browser #}
    {% include '@learningAssessment/fragments/sebSwitch.twig' with {assessment: assessment, courseManagedReadonly: courseManaged.isReadonly} only %}
</fieldset>

{# ----------------------------------------------------------- #}
{# Grading #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>{{ locale.grading.proper }}</legend>

    {% include '@learningAssessment/fragments/weight.twig' with {
        assessment: assessment,
        courseManagedReadonly: courseManaged.isReadonly
    } %}

    {% if selfAssessmentEnabled %}
        <label>{{ locale.selfReflection.proper }} <span data-tooltip class="hint has-tip tip-top"  title="Enabling '{{ locale.selfReflection.proper }}' allows students to reflect on their work with a comment, and rubric if provided. Also enabling '{{ locale.selfAssessment.proper }}' gives students the ability to provide themselves a grade.">?</span>
            <select name="self_reviewable" {% if courseManaged.isReadonly %}readonly{% endif %} data-test="assessment-form-select-selfReflection">
                {% for selfReviewType in selfReviewTypes %}
                    <option value="{{ selfReviewType.value }}"
                        {% if assessment.selfReviewability == selfReviewType.value %}
                            selected
                        {% elseif courseManaged.isReadonly %}
                            disabled
                        {% endif %}
                    >{{ selfReviewType.label }}</option>
                {% endfor %}
            </select>
        </label>
    {% endif %}

    {% import 'sub/visibility.twig' as visibility %}
    {{ visibility.dropdown(markVisibility, availableVisibilities) }}

    <input type="hidden" name="assessmentType" value="{{ assessmentType }}" />

    {# Letter Grade enables Grading Scheme
     # Total Mark enables Maximum Available Marks
     #}
    {% set markTypeLetterGrade = 2 %}
    {% set markTypeTotalMark = 3 %}
    {% set markTypeNone = 6 %}

    {% include '@learningAssessment/fragments/dualMarkTypes.twig' with {
        assessment: assessment,
        allMarkTypes: allMarkTypes,
        allGradeSchemes: allGradeSchemes,
        selectedMaxMark: assessment.instructorMaxMark ?? null,
        selectedMarkType: assessment.instructorMarkType.id ?? null,
        selectedGradeGroup: assessment.instructorGradeGroup.id ?? null,
        defaultGradeGroup: defaultGradeGroup,
        courseManagedReadonly: courseManaged.isReadonly
    } %}

    {% include '@learningAssessment/fragments/rubric.twig' with {
        rubricGrid: rubricGrid,
        rubricGridPayload: rubricGridPayload,
        rubricAttachZone: rubricAttachZone,
        resultSets: rubricResultSets,
        rubricHasMarks: rubricHasMarks,
        assessment: assessment,
        markTypeTotalMark: markTypeTotalMark,
        capabilityMarkTypes: capabilityMarkTypes,
        capabilityGradingSchemes: capabilityGradingSchemes,
        defaultGradeGroup: defaultGradeGroup,
        markTypeNone: markTypeNone,
        courseManagedReadonly: courseManaged.isReadonly
    } only %}
</fieldset>

{# ----------------------------------------------------------- #}
{# Participation #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification and custom_assessment_participation %}
    {% include '@learningAssessment/fragments/participation.twig' %}
{% endif %}

{# ----------------------------------------------------------- #}
{# Submit #}
{# ----------------------------------------------------------- #}
{{ mage.submitRow(actionLabel ?? 'Create', 'part-2', 'end') }}

{# ----------------------------------------------------------- #}
{# General Scripts #}
{# ----------------------------------------------------------- #}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
<script>
    $(function () {

        // 'Description' TextArea only
        document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
            detail: {
                maxCharCount: window.sbProps.MAX_BYTES_MYSQL_MEDIUMTEXT,
                targetElements: ['#assessment-description'],
                fileBrowserCategoryId: {{ context.baseContext.folder.id ?? 0 }},
                 {% if editorTemplates is defined %}
                    templates: {{ editorTemplates|json_encode|raw }},
                {% endif %}
            }
        }));

        /**
         * Decide which fields to show, depending on
         * Accept Online Submissions value
         *
         * @param element
         */
        function toggleDates(element) {
            if ($(element).val() < 1) {
                $('#open').hide();
                $('#close').hide();
                $('#submissionType').hide();
            }
            else {
                $('#open').show();
                $('#close').show();
                $('#submissionType').show();
            }
        }

        var $acceptOnlineToggle = $('#acceptOnline'),
            $similarityRow      = $('#similarityRow');

        /* Initial state
         */
        toggleDates($acceptOnlineToggle);

        $acceptOnlineToggle.on('change', function() {

            /* Update upon change
             */
            toggleDates($(this));

            /* Show the similarity checkbox if single or multi submit options selected
             * Disable it for the "None" option
             */
            if ($acceptOnlineToggle.val() !== '0') {
                $similarityRow.show();
            } else {
                $('#similarityCheckEnabled').prop('checked', false);
                $similarityRow.hide();
            }
        });
    });

    {% if kami_enabled %}
    /*
    * To show the dropzone when checkbox is checked
    */
    function onWorksheetChange(event) {
        worksheetDropdzone.style.display = worksheet.checked ? "block" : "none";
    }
    const worksheetCheckbox = document.getElementById("worksheet");
    const worksheetDropdzone = document.getElementById("worksheetDropzone");
    worksheetCheckbox.addEventListener("change", onWorksheetChange);

    // Remove the error message when a worksheet file is uploaded
    $('#worksheetDropzone').on('success.attachzone', () => {
        $('#worksheet-file-error').remove();
    });

    {% endif %}
</script>

{# ----------------------------------------------------------- #}
{# Rubric Scripts #}
{# ----------------------------------------------------------- #}

{# This only needs to exist when someone can edit the grid;
 # if the rubric is Course Managed, then staff get a readonly view
 #
 # But, if you're in the readonly view, this javascript was running anyway
 # and arbitrarily mutating fields that would otherwise have been readonly
 # in the ui...I guess it wasn't finding any fields in the readonly version
 # and inadvertently setting things to zero, because this javascript
 # presumes you are using the grid-editable all the time
 #}
{% if not courseManaged.isReadonly %}
<script>
    $(function () {
        /**
         * Initializes the rubric grid.
         */
        function initRubricGrid() {
            var $maxMarkInput = $('#maxMark'); // The display (learner) max mark
            var $maxMarkInputInstructor = $('#instructor-maxMark'); // The input (instructor) max mark
            var $useRubricSwitch = $('#useRubric');

            /**
             * Disable the field, but allow us to show its value
             * which will be programmatically generated
             */
            function disableMaxMark() {
                $maxMarkInput.prop('readonly', true);
                $maxMarkInputInstructor.prop('readonly', true);
            }

            /**
             * Enable the field for humans to change its value
             */
            function enableMaxMark() {
                $maxMarkInput.prop('readonly', false);
                $maxMarkInputInstructor.prop('readonly', false);
            }

            /**
             * Callback when the 'Has Rubric' switch is clicked
             */
            function processUseRubricClick($element)
            {
                if ($element.is(':checked')) {
                    disableMaxMark();
                    calculateGridTotal(); // todo: just needs to update both max mark inputs when you do this
                } else {
                    enableMaxMark();

                    // Need to validate the max mark
                    $maxMarkInput.valid();
                    $maxMarkInputInstructor.valid();
                }
            }

            /* Rubrics switcher
             */
            $useRubricSwitch.on('click', function () {
                processUseRubricClick($(this));
            });

            // configure callbacks into the grid
            let $rubric = $('table[data-rubric]');
            $rubric.rubricEditable({
                url: '{{ routeLookup("rubric.create") }}',
                rubricId: '{{ rubricGrid.id }}',
                formField: '{{ formField ?? 'rb' }}',
                levelLimit: {{ levelLimit ?? config.rubric_max_levels }},
                localisedGroupName: '{{ locale.translate('rubricGroup', false, true) }}',
                localisedCriterionName: '{{ locale.translate('rubricCriterion', false, true) }}',
            });

            // Initiate
            processUseRubricClick($useRubricSwitch);
        }

        // Init the entire grid on document.ready
        initRubricGrid();
    });
</script>
{% endif %}
