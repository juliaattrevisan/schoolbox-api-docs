{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}


{# ----------------------------------------------------------- #}
{# Basic Details #}
{# ----------------------------------------------------------- #}
<fieldset>
    <label>
        Title
        <input type="text" name="title" value="{{ assessment.title }}" required maxlength="255"/>
    </label>

    <label>
        Work Type
        <select name="workType">
            <option value="" selected>None</option>
            {% for workType in allWorkTypes %}
                <option value="{{ workType.id }}" {% if assessment.workType.id == workType.id %}selected="selected"{% endif %}>{{ workType.name }}</option>
            {% endfor %}
        </select>
    </label>

    <label>
        Description
        <textarea name="description" id="assessment-description">{{ assessment.description }}</textarea>
    </label>

    {% include 'sub/attachzone.twig' %}

</fieldset>


{# ----------------------------------------------------------- #}
{# Submissions #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>Submissions</legend>
    <div class="row">
        <div class="small-12 columns">
            <label for="acceptOnline">Accepts Online Submissions?</label>
            <select name="acceptOnline" id="acceptOnline">
                {% set options = {
                0: 'None',
                1: 'Single',
                2: 'Multiple'
                } %}
                {% for index, title in options %}
                    <option value="{{ index }}"{% if assessment.acceptOnline == index %} selected="selected"{% endif %}>{{ title }}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    {% include '@learningAssessment/fragments/default_open_span.twig' with {assessment: assessment} only %}

    {% if context.baseContext is not unitSpecification %}
        {% include '@learningAssessment/fragments/dates.twig' %}
    {% endif %}
</fieldset>


{# ----------------------------------------------------------- #}
{# Grading #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>{{ locale.grading.proper }}</legend>

    {% include '@learningAssessment/fragments/weight.twig' %}

    {% if selfAssessmentEnabled %}
        <label>Self-Reflection <span data-tooltip class="hint has-tip tip-top"  title="Enabling this will allow students to self-reflect with a comment and a rubric if provided. The self-assess option will also provide the ability for students to grade themselves.">?</span>
            <select name="self_reviewable">
                <option value="{{ selfReviewTypes.none }}" {% if assessment.selfReviewability == selfReviewTypes.none %}selected{% endif %}>None</option>
                <option value="{{ selfReviewTypes.reflect }}" {% if assessment.selfReviewability == selfReviewTypes.reflect %}selected{% endif %}>Self-Reflect</option>
                <option value="{{ selfReviewTypes.full }}" {% if assessment.selfReviewability == selfReviewTypes.full %}selected{% endif %}>Self-Reflect + Self-Assess</option>
            </select>
        </label>
    {% endif %}

    {% import 'sub/visibility.twig' as visibility %}
    {{ visibility.dropdown(markVisibility, availableVisibilities) }}

    <input type="hidden" name="assessmentType" value="{{ assessmentType }}" />

    {# Letter Grade enables Grading Scheme
     # Total Mark enables Maximum Available Marks
     #}
    {% set markTypeLetterGrade = 2 %}
    {% set markTypeTotalMark = 3 %}

    {% include '@learningAssessment/fragments/markType.twig' %}
    {% include '@learningAssessment/fragments/rubric.twig' with {
        rubric: rubric,
        rubricAttachZone: rubricAttachZone,
        resultSets: rubricResultSets,
        rubricHasMarks: rubricHasMarks,
        assessment: assessment,
        markTypeTotalMark: markTypeTotalMark
    } only %}
</fieldset>


{# ----------------------------------------------------------- #}
{# Participation #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification and custom_assessment_participation %}
    {% include '@learningAssessment/fragments/participation.twig' %}
{% endif %}

{# ----------------------------------------------------------- #}
{# Curriculum #}
{# ----------------------------------------------------------- #}
{% include '@learningAssessment/fragments/curriculumCodes.twig' with {entityType: locale.dueWork.proper} %}


{# ----------------------------------------------------------- #}
{# Submit #}
{# ----------------------------------------------------------- #}
{{ mage.submitRow(actionLabel ?: 'Create', 'part-2', 'end') }}


{# ----------------------------------------------------------- #}
{# General Scripts #}
{# ----------------------------------------------------------- #}
<script src="/javascript/ckeditor/ckeditor.js"></script>
<script src="/javascript/shared/editor/jquery.editor.js"></script>
<script>
    $(function () {

        // 'Description' TextArea only
        $.fn.alaressEditor({
            targetElements: $('#assessment-description')
        });

        /**
         * Decide which date fields to show, depending on
         * Accept Online Submissions value
         *
         * @param element
         */
        function toggleDates(element) {
            if ($(element).val() < 1) {
                $('#open').hide();
                $('#close').hide();
            }
            else {
                $('#open').show();
                $('#close').show();
            }
        }

        var $acceptOnlineToggle = $('#acceptOnline');

        /* Initial state
         */
        toggleDates($acceptOnlineToggle);

        /* Update upon change
         */
        $acceptOnlineToggle.change(function() {
            toggleDates($(this));
        });
    });
</script>


{# ----------------------------------------------------------- #}
{# Rubric Scripts #}
{# ----------------------------------------------------------- #}
<script>
    $(function () {

        var $maxMarkInput = $('#maxMark');
        var $useRubricSwitch = $('#useRubric');
        var $grid = $('[data-rb-grid]');

        /**
         * Disable the field, but allow us to show its value
         * which will be programmatically generated
         */
        function disableMaxMark() {
            $maxMarkInput.prop('readonly', true);
        }

        /**
         * Enable the field for humans to change its value
         */
        function enableMaxMark() {
            $maxMarkInput.prop('readonly', false);
        }

        /**
         * Callback when the 'Has Rubric' switch is clicked
         */
        function processUseRubricClick($element)
        {
            if ($element.is(':checked')) {
                disableMaxMark();
                calculateGridTotal();
            } else {
                enableMaxMark();
            }
        }

        /* Rubrics switcher
         */
        $useRubricSwitch.on('click', function () {
            processUseRubricClick($(this));
        });

        // configure callbacks into the grid
        $grid.rubricEditable({
            afterApplyResultSet: calculateGridTotal
        });

        // Initiate
        processUseRubricClick($useRubricSwitch);
    });


    /**
     * Update max available mark on descriptor point value changes
     * Purposefully placed outside of the document.ready in order to work for a rubric grid that is imported via csv
     */
    $(document).on('change', '[data-rb-grid] [data-descriptor-value], [data-rb-grid] [data-criterion-name]', calculateGridTotal);


    /**
     * Catch a custom event that's fired on rubric csv import
     * Use it to update the max available mark field
     */
    $('#rubric-attachable').on('rubric-grid-imported', function () {
        calculateGridTotal();
    });


    /**
     * Searches the rubric grid to find the highest sum of points in a capability
     */
    function calculateGridTotal() {
        var max = 0;

        // iterate the grid, and sum the max of each row
        $('[data-rb-grid]').find('tr[data-sequencer-group]').each(function () {
            var $row = $(this),
                rowMax = 0;

            if ($row.find('[data-criterion-name]:checked').length == 0) {
                return true; // jq.continue
            }

            $row.find('[data-descriptor-value]').each(function () {
                var i = parseFloat($(this).val());

                if (!isNaN(i)) {
                    rowMax = Math.max(rowMax, i);
                }

            });

            max += rowMax;
        });

        max = parseInt(max);

        $('#maxMark').val(max);
    }

</script>
