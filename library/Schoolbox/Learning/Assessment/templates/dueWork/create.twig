{##
 # Create/Update form
 #
 # Used to create a new assessment or update an existing one
 # Used in multiple ocntexts: creating due work in a homepage or in a course
 #
 # @param CourseManagedFields courseManaged
 #     Decide whether certain fields are readonly due to being Course Managed
 #     Some users can change the values; some can't. Note also this template
 #     is shared among multiple workflows and use cases - see the class docblock
 #     for more details on how these facts play out
#}

{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

{# ----------------------------------------------------------- #}
{# Basic Details #}
{# ----------------------------------------------------------- #}
<fieldset>
    <label class="required" for="title">Title</label>
    <input type="text" name="title" id="title" value="{{ assessment.title }}" required maxlength="255" {% if courseManaged.isReadonly %}readonly{% endif %} />

    <div class="row">

        {# This Course Managed option shouldn't exist in a Folder context at all,
         # since that has nothing to do with an overarching course dominating its settings
         #}
        {% if courseManaged.isVisible %}
            {% set columnCss = 'medium-6' %}
        {% else %}
            {% set columnCss = '' %}
        {% endif %}

        <div class="small-12 {{ columnCss }} columns">
            <label>
                Work Type
                <select name="workType" {% if courseManaged.isReadonly %}readonly{% endif %}>
                    <option value="" selected
                        {% if courseManaged.isReadonly %}
                            disabled
                        {% endif %}
                    >None
                    </option>
                    {% for workType in allWorkTypes %}
                        <option value="{{ workType.id }}"
                            {% if assessment.workType.id ?? '' == workType.id %}
                                selected="selected"
                            {% elseif courseManaged.isReadonly %}
                                disabled
                            {% endif %}
                        >{{ workType.name }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>

        {% if courseManaged.isVisible %}
        <div class="small-12 {{ columnCss }} columns">

            {# For when the checkbox itself is disabled, since that won't submit to backend
             # under those circumstances, inadvertently unlocking this setting
             #
             # If it's been disabled, preserve whatever setting it currently has
             #}
            <input type="hidden" name="courseManaged" value="{% if not courseManaged.isMutable %}{{ assessment.courseManaged }}{% else %}0{% endif %}" />

            <label for="courseManaged" class="checkbox-label">Common Assessment <span class="hint has-tip tip-top"  title="To ensure consistency across the cohort, when {{ locale.dueWork.proper }} is imported to a class, the following fields will not be editable; Title, Type, Weight, Mark Type and Rubric." data-tooltip="">?</span></label>

            <div class="switch">
                <input name="courseManaged" id="courseManaged" type="checkbox" {% if assessment.courseManaged %}checked="checked"{% endif %} {% if not courseManaged.isMutable %}disabled{% endif %}/>
                <label for="courseManaged">
                    <span class="icon-approve"></span>
                    <span class="icon-cancel"></span>
                </label>
            </div>
        </div>
        {% endif %}
    </div>

    <label>
        Description
        <textarea name="description" id="assessment-description">{{ assessment.description }}</textarea>
    </label>

    {% include 'sub/attachzone.twig' %}

    {# ----------------------------------------------------------- #}
    {# Assessment Location #}
    {# ----------------------------------------------------------- #}
    {% if canRelocate %}
        {% include '@learningAssessment/fragments/assessmentLocation.twig' %}
    {% endif %}
</fieldset>

{# ----------------------------------------------------------- #}
{# Submissions #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>Submissions</legend>
    <div class="row">
        <div class="medium-6 columns">
            <label for="acceptOnline">Accepts Online Submissions?</label>
            <select name="acceptOnline" id="acceptOnline" {% if courseManaged.isReadonly %}readonly{% endif %}>
                {% set options = {
                    0: 'None',
                    1: 'Single',
                    2: 'Multiple'
                } %}
                {% for index, title in options %}
                    <option value="{{ index }}"
                        {% if assessment.acceptOnline == index %}
                            selected="selected"
                        {% elseif courseManaged.isReadonly %}
                            disabled
                        {% endif %}
                    >{{ title }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="medium-6 columns" id="similarityRow"{% if not assessment.acceptOnline %} style="display: none"{% endif %}>
            <input type="hidden" name="similarityCheckEnabled" value="{% if assessment.courseManaged %}{{ assessment.similarityCheckEnabled }}{% else %}0{% endif %}" />

            <label for="similarityCheckEnabled">Similarity Check <span class="hint has-tip tip-top" title="Turn this on to enable similarity checking on students' submissions." data-tooltip>?</span></label>
            <div class="switch">
                <input id="similarityCheckEnabled"
                       name="similarityCheckEnabled"
                       type="checkbox"
                        {{ assessment.similarityCheckEnabled ? 'checked' : '' }}
                        {% if courseManaged.isReadonly %}
                            disabled
                        {% endif %}
                >
                <label for="similarityCheckEnabled">
                    <span>On</span>
                    <span>Off</span>
                </label>
            </div>
        </div>
    </div>
    {% include '@learningAssessment/fragments/default_open_span.twig' with {assessment: assessment} only %}
    {% if context.baseContext is not unitSpecification %}
        {% include '@learningAssessment/fragments/dates.twig' %}
    {% endif %}

    {# Enforce Safe Exam Browser #}
    {% include '@learningAssessment/fragments/sebSwitch.twig' with {assessment: assessment, courseManagedReadonly: courseManaged.isReadonly} only %}
</fieldset>

{# ----------------------------------------------------------- #}
{# Grading #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>{{ locale.grading.proper }}</legend>

    {% include '@learningAssessment/fragments/weight.twig' with {
        assessment: assessment,
        courseManagedReadonly: courseManaged.isReadonly
    } %}

    {% if selfAssessmentEnabled %}
        <label>{{ locale.selfReflection.proper }} <span data-tooltip class="hint has-tip tip-top"  title="Enabling '{{ locale.selfReflection.proper }}' allows students to reflect on their work with a comment, and rubric if provided. Also enabling '{{ locale.selfAssessment.proper }}' gives students the ability to provide themselves a grade.">?</span>
            <select name="self_reviewable" {% if courseManaged.isReadonly %}readonly{% endif %}>
                {% for selfReviewType in selfReviewTypes %}
                    <option value="{{ selfReviewType.value }}"
                        {% if assessment.selfReviewability == selfReviewType.value %}
                            selected
                        {% elseif courseManaged.isReadonly %}
                            disabled
                        {% endif %}
                    >{{ selfReviewType.label }}</option>
                {% endfor %}
            </select>
        </label>
    {% endif %}

    {% import 'sub/visibility.twig' as visibility %}
    {{ visibility.dropdown(markVisibility, availableVisibilities) }}

    <input type="hidden" name="assessmentType" value="{{ assessmentType }}" />

    {# Letter Grade enables Grading Scheme
     # Total Mark enables Maximum Available Marks
     #}
    {% set markTypeLetterGrade = 2 %}
    {% set markTypeTotalMark = 3 %}
    {% set markTypeNone = 6 %}

    {% include '@learningAssessment/fragments/markType.twig' with {
        context: '',
        assessment: assessment,
        allMarkTypes: allMarkTypes,
        allGradeSchemes: allGradeSchemes,
        selectedMarkType: assessment.markType.id ?? null,
        selectedGradeGroup: assessment.gradeGroup.id ?? null,
        defaultGradeGroup: defaultGradeGroup,
        renderMaxMark: true,
        markTypeLabel: 'Mark Type',
        courseManagedReadonly: courseManaged.isReadonly
    } %}

    {% include '@learningAssessment/fragments/rubric.twig' with {
        rubricGrid: rubricGrid,
        rubricAttachZone: rubricAttachZone,
        resultSets: rubricResultSets,
        rubricHasMarks: rubricHasMarks,
        assessment: assessment,
        markTypeTotalMark: markTypeTotalMark,
        capabilityMarkTypes: capabilityMarkTypes,
        capabilityGradingSchemes: capabilityGradingSchemes,
        defaultGradeGroup: defaultGradeGroup,
        markTypeNone: markTypeNone,
        courseManagedReadonly: courseManaged.isReadonly
    } only %}
</fieldset>


{# ----------------------------------------------------------- #}
{# Participation #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification and custom_assessment_participation %}
    {% include '@learningAssessment/fragments/participation.twig' %}
{% endif %}

{# ----------------------------------------------------------- #}
{# Curriculum #}
{# ----------------------------------------------------------- #}
{% include '@learningAssessment/fragments/curriculumCodes.twig' with {
    entityType: locale.dueWork.proper,
    courseManagedReadonly: courseManaged.isReadonly
} %}


{# ----------------------------------------------------------- #}
{# Submit #}
{# ----------------------------------------------------------- #}
{{ mage.submitRow(actionLabel ?? 'Create', 'part-2', 'end') }}


{# ----------------------------------------------------------- #}
{# General Scripts #}
{# ----------------------------------------------------------- #}
<script src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script>
    $(function () {

        // 'Description' TextArea only
        $.fn.alaressEditor({
            targetElements: $('#assessment-description')
        });

        /**
         * Decide which date fields to show, depending on
         * Accept Online Submissions value
         *
         * @param element
         */
        function toggleDates(element) {
            if ($(element).val() < 1) {
                $('#open').hide();
                $('#close').hide();
            }
            else {
                $('#open').show();
                $('#close').show();
            }
        }

        var $acceptOnlineToggle = $('#acceptOnline'),
            $similarityRow      = $('#similarityRow');

        /* Initial state
         */
        toggleDates($acceptOnlineToggle);

        $acceptOnlineToggle.on('change', function() {

            /* Update upon change
             */
            toggleDates($(this));

            /* Show the similarity checkbox if single or multi submit options selected
             * Disable it for the "None" option
             */
            if ($acceptOnlineToggle.val() !== '0') {
                $similarityRow.show();
            } else {
                $('#similarityCheckEnabled').prop('checked', false);
                $similarityRow.hide();
            }
        });
    });
</script>


{# ----------------------------------------------------------- #}
{# Rubric Scripts #}
{# ----------------------------------------------------------- #}

{# This only needs to exist when someone can edit the grid;
 # if the rubric is Course Managed, then staff get a readonly view
 #
 # But, if you're in the readonly view, this javascript was running anyway
 # and arbitrarily mutating fields that would otherwise have been readonly
 # in the ui...I guess it wasn't finding any fields in the readonly version
 # and inadvertently setting things to zero, because this javascript
 # presumes you're using the grid-editable all the time
 #}
{% if not courseManaged.isReadonly %}
<script>
    $(function () {
        /**
         * Initializes the rubric grid.
         */
        function initRubricGrid() {
            var $maxMarkInput = $('#maxMark');
            var $useRubricSwitch = $('#useRubric');

            /**
             * Disable the field, but allow us to show its value
             * which will be programmatically generated
             */
            function disableMaxMark() {
                $maxMarkInput.prop('readonly', true);
            }

            /**
             * Enable the field for humans to change its value
             */
            function enableMaxMark() {
                $maxMarkInput.prop('readonly', false);
            }

            /**
             * Callback when the 'Has Rubric' switch is clicked
             */
            function processUseRubricClick($element)
            {
                if ($element.is(':checked')) {
                    disableMaxMark();
                    calculateGridTotal();
                } else {
                    enableMaxMark();

                    // Need to validate the max mark
                    $maxMarkInput.valid();
                }
            }

            /* Rubrics switcher
             */
            $useRubricSwitch.on('click', function () {
                processUseRubricClick($(this));
            });

            // configure callbacks into the grid
            $rubric.rubricEditable({
                url: '{{ routeLookup("rubric.create") }}',
                rubricId: '{{ rubricGrid.id }}',
                formField: '{{ formField ?? 'rb' }}',
                levelLimit: {{ levelLimit ?? config.rubric_max_levels }},
                localisedGroupName: '{{ locale.translate('rubricGroup', false, true) }}',
                localisedCriterionName: '{{ locale.translate('rubricCriterion', false, true) }}',
                swap: aniswap,
                // Recalculate total for all groups, then recalculate grid total
                afterApplyResultSet: calculateAllGroupTotals
            });

            // Initiate
            processUseRubricClick($useRubricSwitch);

            // Dynamically calculate button text on page load
            $rubric.find("[data-group]").each(function() {
                setRubricMarkButtonText($(this).attr('data-group'));
            })

            /**
             * Update max available mark on descriptor point value changes
             * Purposefully placed outside of the document.ready in order to work for a rubric grid that is imported via csv
             * (Yet it appears to work within document.ready regardless?)
             */
            $rubric.on('change', '[data-group-max-value]', calculateGridTotal);


            // Change a descriptor value: update the group's total
            // (cascades to grid total, too)
            $rubric.on(
                'change',
                '[data-descriptor-value], [data-criterion-name]',
                function () {

                    // Calculate total for this descriptor's group
                    var $groupIdentifier = $(this).closest('[data-group]').attr('data-group');
                    assignGroupTotal($groupIdentifier);

                    // Then calculate the entire grid total
                    calculateGridTotal();
                }
            );


            /**
             * Catch a custom event that's fired on rubric csv import
             * Use it to re-init the entire rubric grid
             */
            $('#rubric-attachable').on('rubric-grid-imported', initRubricGrid);


            /**
             * Calculates max available marks for all groups, and then the overall
             * grid total.
             */
            function calculateAllGroupTotals() {
                // List of all groups, no duplicates
                var groupIdentifiers = new Set(
                    $rubric.find('[data-group]')
                        .map(function() { return $(this).attr('data-group'); })
                        .toArray()
                );
                groupIdentifiers.forEach(function (groupIdentifier) {
                    assignGroupTotal(groupIdentifier)
                });
                calculateGridTotal();
            }

            function aniswap(move, first, second) {

                /*
                            // put these together for ease of code (apparently not as simple as it sounds...?)
                            var both = $.merge($(), first);
                            $.merge(both, second);

                            // cache the top and left positions of each element we're going to be moving around
                            both.each(function () {
                                var e = $(this),
                                        o = e.offset();

                                e.data('otop', o.top);
                                e.data('oleft', o.left);
                            });
                */

                // What kind of swap is this?
                // * Descriptor or level:     swap names of input elements within first and second
                // * Capability or indicator: don't swap
                var sequencerGroup = first.attr('data-sequencer-group');
                if (sequencerGroup === 'levels' || typeof sequencerGroup === 'undefined') {
                    var commonInputs = [
                        '[data-id]',
                        '[data-level]',
                        '[data-descriptor-text]',
                        '[data-descriptor-value]'
                    ];
                    commonInputs.forEach(function(input) {
                        var firstInput  = first.find(input),
                                secondInput = second.find(input);
                        if (firstInput.length && secondInput.length) {
                            var firstName  = firstInput.attr('name'),
                                    secondName = secondInput.attr('name');
                            firstInput.attr('name', secondName);
                            secondInput.attr('name', firstName);
                        }
                    });
                }

                // apply the DOM manipulation
                first[move](second);

                /*
                            // set the transform to visually "undo" the DOM respositioning
                            both.each(function () {
                                var e = $(this),
                                        o = e.offset(),
                                        t = {
                                            x: e.data('oleft') - o.left,
                                            y: e.data('otop') - o.top
                                        };

                                e.css({
                                    transform: [ 'translateX(', t.x, 'px) translateY(', t.y, 'px)' ].join('')
                                });
                            });

                            // set the animation class
                            both.addClass('animating');

                            setTimeout(function () {
                                // remove the transforms and let the animation glide them into their natural positions
                                both.css({ transform: '' });

                                // wait for the duration of the animation, then clear the animation class
                                setTimeout(function () {
                                    both.removeClass('animating');
                                }, 1000);

                            }, 10);
                */

            }

            /**
             * Calculates a group's max available marks, and fills that group's max
             * value input with that value.
             *
             * @param groupIdentifier The value of this row's data-group attribute
             */
            function assignGroupTotal(groupIdentifier) {
                var $inputEl = $("[data-group-max-value-row][data-group='" + groupIdentifier + "']").find("input");
                var groupTotal = calculateGroupTotal(groupIdentifier);
                // Don't automatically update if customised
                if (! $inputEl.attr("data-customised")) {
                    $inputEl.val(groupTotal);
                }
                setRubricMarkButtonText(groupIdentifier);
            }

            function setRubricMarkButtonText(groupIdentifier) {
                var $closestInput = $("[data-group-max-value-row][data-group='" + groupIdentifier + "']").find("input");
                $closestInput.next("a").find("[data-rubric-sum]").text(calculateGroupTotal(groupIdentifier));
            }

            /**
             * Calculates the assessment's max available marks from the rubric grid,
             * and fills the max mark input with that value.
             *
             * Now uses the defined max value for each group, instead of the max
             * descriptor value for each criterion.
             */
            function calculateGridTotal() {
                var max = 0;

                // iterate the grid, and sum the max of each row
                $rubric.find('[data-group-max-value]').each(function () {
                    var i = parseFloat($(this).val());
                    if (!isNaN(i)) {
                        max += i;
                    }
                });

                max = parseFloat(max.toFixed(2));

                // Set and validate the max mark
                $('#maxMark').val(max).valid();
            }


            function calculateGroupTotal(groupIdentifier) {
                var $thisMaxValueInput = $(),
                    groupMax = 0;

                $rubric.find('[data-group="'+groupIdentifier+'"]').each(function () {
                    var $criterionRow = $(this),
                        rowMax = 0;

                    // Does this criterion row have a max value input?
                    // Update it later
                    var $groupMaxValueInput = $criterionRow.find('[data-group-max-value]');
                    if ($groupMaxValueInput.length > 0) {
                        $thisMaxValueInput = $groupMaxValueInput;
                    }

                    // Not checked? Don't count this criterion toward total
                    if ($criterionRow.find('[data-criterion-name]:checked').length === 0) {
                        return true; // jq.continue
                    }

                    // Find all this criterion's descriptors;
                    // figure out what the highest value is
                    $criterionRow.find('[data-descriptor-value]').each(function () {
                        var i = parseFloat($(this).val());

                        if (!isNaN(i)) {
                            rowMax = Math.max(rowMax, i);
                        }
                    });

                    groupMax += rowMax;
                });

                return groupMax;
            }

            $("[data-group-max-value]").change(function() {
                var groupIdentifier = $(this).closest("[data-group]").attr("data-group");
                var $closestAssignButton = $(this).next("[data-use-criterion-values]");
                if (! ($(this).val() == calculateGroupTotal(groupIdentifier)) ) {
                    $closestAssignButton.show();
                } else {
                    $closestAssignButton.hide();
                }
                $(this).attr("data-customised", true);
            });

            // Determine disabled-ness of assign from rubric buttons on page load
            $("[data-use-criterion-values]").each(function() {
                var $closestMaxMarkInput = $(this).prev("[data-group-max-value]");
                var groupIdentifier = $(this).closest("[data-group]").attr("data-group");
                var groupTotal = calculateGroupTotal(groupIdentifier);

                // Only disable if mark is the same (which it always should be in this case, but...be safe)
                if (groupTotal == $closestMaxMarkInput.val()) {
                    $(this).hide();
                } else {
                    $(this).show();
                }
            });

            $("[data-use-criterion-values]").click(function($e) {
                $e.preventDefault();
                var $closestMaxMarkInput = $(this).prev("[data-group-max-value]");
                var groupIdentifier = $(this).closest("[data-group]").attr("data-group");
                var groupTotal = calculateGroupTotal(groupIdentifier);

                $(this).prev("[data-group-max-value]").val(groupTotal);

                // Only disable if mark is the same (which it always should be in this case, but...be safe)
                if (groupTotal == $closestMaxMarkInput.val()) {
                    $(this).hide();
                } else {
                    $(this).show();
                }

                $closestMaxMarkInput.removeAttr("data-customised");
                calculateGridTotal();
            });
        }

        // Init the entire grid on document.ready
        initRubricGrid();
    });
</script>
{% endif %}
