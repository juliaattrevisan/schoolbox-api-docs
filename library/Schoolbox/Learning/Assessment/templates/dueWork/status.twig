{#  usage: per-participation, configure the following vars for the parent template to use
    available variables:
     - routeArgs:        an array that represents a participant, to be pushed into a routeLookup
     - assessment:       the assessment we're looking at
     - participant:      the current participant of the iteration
     - statusIncomplete: a string representing the 'incomplete' state
     - statusPending:    a string representing the 'pending'    state
     - statusReviewed:   a string representing the 'reviewed'   state
     - errors:           string[]  Admin-configured submission states, eg 'Absent', 'Pending', 'Not Submitted' etc
     - markSchemeName:   string    filename of markScheme template fragment
     - rubricMarks:       bool[]  Whether the student's instructor-given feedback exists and has rubric marks, indexed by user.id
     - interactionLocked: bool Is the assessment locked for interactions because it is due in an archived term?
     - selfAssess:        bool            Is this being viewed in a self assessment context?
     - selfReflect:       bool            Is this being viewed in a self reflection context?
     - blindReviewUrl:   string
#}

{% extends '@learningAssessment/status.twig' %}

{% set labelIncomplete = 'Submission required' %}
{% set labelFailed     = 'Resubmission required' %}
{% set labelPending    = 'Marking required' %}
{% set labelReviewed   = 'Reviewed' %}
{% set statusFailed    = 'failed' %}

{% set readonly = interactionLocked and not USER.superUser %}

{% block headerOptions %}
    <li>
        <a id="import-feedback" data-reveal-id="importFeedbackModal" class="icon-upload">Import Feedback</a>
    </li>

    {% if blindReviewUrl %}
    <li>
        <a href="{{ blindReviewUrl }}" class="icon-task">Blind Review</a>
    </li>
    {% endif %}

    {% if download %}
        <li>
            <a class="icon-download"
               id="download-submissions"
               href="{{ routeLookup('learningAssessment.downloadSubmissions', {
                   assessmentId: assessment.id,
                   assessment: assessment
               }) }}">Download All</a>
        </li>
    {% endif %}

    {% set similarityReportRoute = routeLookupIfAuthorized('learningAssessment.getSimilarityReport', {assessmentId: assessment.id, assessment: assessment}) %}
    {% if similarityReportRoute %}
        <li><a href="{{ similarityReportRoute }}" class="icon-due-work">Similarity Report</a></li>
    {% endif %}

    {% if assessment.useRubric %}
        <li>
            <a href="{{ routeLookup('learningAssessment.getOverview', { assessmentId: assessment.id }) }}"
               class="icon-criteria">Rubric Report</a>
        </li>
    {% endif %}
    {% if not readonly %}
        <li class="separator">Bulk Actions</li>
        <li><a class="icon-approve" data-mass="publish" data-reveal-id="mass-publish">Publish drafts&hellip;</a></li>
        <li><a class="icon-approve" data-mass="submit" data-reveal-id="mass-submit">Mark as Submitted&hellip;</a></li>
    {% endif %}
{% endblock %}


{##
 # Participant
 #
 # Each person in the list is rendered here
 # Each type of assessment renders their participants uniquely
 #}
{% block participant %}
    {% set latestFeedback    = participant.findMostRecentInstructorGivenFeedback %}
    {% set latestResponse    = participant.findMostRecentSubmittedResponse %}
    {% set multipleResponses = participant.allResponses | length > 1 %}

    {% set isPublished       = latestFeedback.published ?? false %}
    {% set canPublish        = latestFeedback and not isPublished %}

    {# Tot actions are derived from access to the Attempt History route
     # By default this empty, hiding the tot
     #}
    {% set pActionSummary = routeLookupIfAuthorized('learningAssessment.getSummary', routeArgs) %}
    {% set pActionResponses = routeLookupIfAuthorized('learningDueWorkResponse.getParticularResponse', routeArgs) %}
    {% set pActionCount = (pActionResponses ? 1 : 0) + (pActionSummary ? 1 : 0) %}

    {# A route to see the list of responses for this participation #}
    {% set fbUrl             = routeLookupIfAuthorized('learningDueWorkFeedback.postParticipantFeedback', routeArgs) %}
    {% set pActionSobo       = routeLookupIfAuthorized('learningAssessment.getCreateResponseForm', routeArgs) %}
    {% set pAckReceipt       = routeLookupIfAuthorized('learningAssessment.postStatusAcknowledge', routeArgs) %}

    {# Progress icon
     # One of [ '', 'pending', 'complete' ] to denote the action status of this participation
     # The green dot/grey square/oj diamond
     #}
    {% set pStatusClass %}
        {%- apply spaceless %}
            {% if participant.responseRequired %}
                {{ statusIncomplete }}
            {% elseif participant.resubmissionRequired %}
                {{ statusFailed }}
            {% elseif participant.feedbackRequired %}
                {{ statusPending }}
            {% else %}
                {{ statusReviewed }}
            {% endif %}
        {% endapply -%}
    {% endset %}

    {% set inputNo = 1 %}
    {% if 'none' == markSchemeName | lower %}
        {% set inputsPerFeedback = 2 %}
    {% else %}
        {% set inputsPerFeedback = 3 %}
    {% endif %}

    <li data-status="{{ pStatusClass }}" data-participant-external-id="{{ participant.user.externalId }}" data-participant="{{ participant.user.id }}" data-participant-name="{{ participant.user.fullName }}">
        <div class="small-12 column">
            <div class="row actions-small-{{ pActionCount }}">
                <div class="list-item">
                    {% include '@learningAssessment/fragments/participantStatus.twig' with {
                        participant: participant,
                        latestResponse: latestResponse,
                        pActionResponses: pActionResponses
                    } only %}
                </div>
                {% if pActionCount %}
                    <nav>
                        <a class="icon-more" title="" data-dropdown="feedback-options-{{ participant.user.id }}"></a>
                    </nav>
                    <ul id="feedback-options-{{ participant.user.id }}" class="f-dropdown" data-dropdown-content>
                        {%- apply spaceless %}
                            {% if pActionResponses %}
                                <li><a class="icon-task" href="{{ pActionResponses }}" title="View submission for {{ participant.user.firstName }}" data-inline-grader>View {% if fbUrl %}and {{ locale.grades }} {% endif %}submission</a></li>
                            {% endif %}
                            {% if pActionSummary %}
                                <li><a class="icon-history" href="{{ pActionSummary }}" title="View {{ participant.user.firstName }}'s history">{{ responseHistory }}</a></li>
                            {% endif %}
                            {% if pActionSobo %}
                                <li><a class="icon-due-work" href="{{ pActionSobo }}" title="Submit on behalf of {{ participant.user.firstName }}">Submit on behalf of {{ participant.user.firstName }}</a></li>
                            {% endif %}
                        {% endapply -%}
                    </ul>
                {% endif %}
            </div>
        </div>

        <div class="small-12 column">

            {% if fbUrl %}
            <form data-feedback-form="{{ participant.user.id }}" method="post" action="{{ fbUrl }}">
            {% endif %}

                <input type="hidden" name="responseId" value="{{ response.id ?? '' }}"/>

                <div class="row">
                    {% if 'none' != markSchemeName | lower %}
                        <div class="small-12 medium-3 column">
                            <label>{{ locale.grades.proper }}
                                {% include '@learningMarkScheme/'~markSchemeName~'.twig' with {
                                    participant: participant,
                                    feedback:    participant.findMostRecentInstructorGivenFeedback,
                                    markScheme:  assessment.markScheme,
                                    tabIndex:    (loop.index0 * inputsPerFeedback) + inputNo,
                                    errors:      errors,
                                    readonly:    readonly
                                } only %}
                                {% set inputNo = inputNo + 1 %}
                            </label>
                            {% include '@learningAssessment/dueWork/resubmissionRequired.twig' with {
                                feedback:    participant.findMostRecentInstructorGivenFeedback,
                                participant: participant,
                                tabIndex:    (loop.index0 * inputsPerFeedback) + inputNo,
                                readonly:    readonly
                            } only %}
                            {% set inputNo = inputNo + 1 %}
                        </div>

                    {% endif %}
                    <div class="small-12{% if 'none' != markSchemeName | lower %} medium-9{% endif %} column">
                        {% include '@learningAssessment/dueWork/comment.twig' with {
                            feedback:       participant.findMostRecentInstructorGivenFeedback,
                            participant:    participant,
                            tabIndex:       (loop.index0 * inputsPerFeedback) + inputNo,
                            readonly:       readonly,
                            selfAssessment: selfAssess,
                            selfReflection: selfReflect,
                            blindMode:      false
                        } only %}
                        {% set inputNo = inputNo + 1 %}
                        {% if 'none' == markSchemeName | lower %}
                            {% include '@learningAssessment/dueWork/resubmissionRequired.twig' with {
                                feedback:    participant.findMostRecentInstructorGivenFeedback,
                                participant: participant,
                                tabIndex:    (loop.index0 * inputsPerFeedback) + inputNo,
                                readonly:    readonly
                            } only %}
                            {% set inputNo = inputNo + 1 %}
                        {% endif %}
                    </div>
                </div>
            {% if fbUrl %}
            </form>
            {% endif %}
        </div>

        {#
        If there's any files, rubric marks, or kami docs
        attached to the feedback - tell the user that this feedback also includes those.
        #}
        {% set hasKami = latestFeedback and latestFeedback.hasResponseWithKamiDocs %}
        {% set fileCount = latestFeedback ? latestFeedback.allFiles.count : 0 %}
        {% set showRubricLink = assessment.useRubric and (rubricMarks[participant.user.id]|default(false)) %}

        {% if hasKami or fileCount or showRubricLink %}
            {% set meta = [] %}

            {# Kami #}
            {% if hasKami %}
                {% set meta = meta|merge(['annotated document']) %}
            {% endif %}

            {# Rubric #}
            {% if showRubricLink %}
                {% set meta = meta|merge(['rubric']) %}
            {% endif %}

            {# Files #}
            {% if fileCount %}
                {% set meta = meta|merge(['file' ~ (fileCount > 1 ? 's' : '') ]) %}
            {% endif %}

            {% set attachedMsg = 'Feedback also includes <a href="' ~ pActionResponses ~ '">' %}
            {% for mataLabel in meta %}
                {% set attachedMsg = attachedMsg ~ mataLabel %}
                {% if loop.revindex0 > 1 %}
                    {% set attachedMsg = attachedMsg ~ ', ' %}
                {% elseif loop.revindex0 == 1 %}
                    {% set attachedMsg = attachedMsg ~ ' and ' %}
                {% endif %}
            {% endfor %}
            {% set attachedMsg = attachedMsg ~ '</a>.' %}
        {% endif %}


        {##
         # Action Bar at the bottom of each participant's row
         #}
        {% set isDraftFeedback     = latestFeedback and not latestFeedback.published %}
        {% set isPublishedFeedback = latestFeedback and latestFeedback.published %}
        {% set actionStyle         = isDraftFeedback or (attachedMsg is defined) or pAckReceipt ? '' : 'display: none;' %}

        {# Action Bar data attrs #}
        {% set massActions = isDraftFeedback ? 'data-mass-publish' : '' %}
        {% set massActions = massActions ~ (pAckReceipt ? ' data-mass-submit' : '') %}
        {% set dataAttrs   = isPublishedFeedback ? 'data-published' : '' %}

        {% set buttons %}
            {%- apply spaceless %}
                {% if pAckReceipt %}
                    {% set soboTitle = 'Acknowledge receipt of student submission' %}
                    <button data-sobo title="{{ soboTitle }}" href="{{ pAckReceipt }}">Mark as Submitted</button>
                {% endif %}
                {% set draftSaveTitle = 'You can discard this draft from the Grading Overview screen' %}
                {% set draftSaveHtml = isDraftFeedback ? 'Saved as Draft' : '' %}
                <button class="button disabled" data-draft="drafted" title="{{ draftSaveTitle }}">{{ draftSaveHtml }}</button>
                {% if not readonly %}
                    <a  class="button"
                        data-draft="publish"
                        {% if not latestFeedback or latestFeedback.published %}style="display:none;"{% endif %}
                            {% if isDraftFeedback %}data-draft-id="{{ latestFeedback.id }}"{% endif %}
                    >Publish</a>
                {% endif %}
            {% endapply -%}
        {% endset %}

    {% include '@learningAssessment/fragments/actionBar.twig' with {
        actionStyle:  actionStyle,
        attachedMsg:  attachedMsg ?? '',
        massActions:  massActions,
        dataAttrs:    dataAttrs,
        buttons:      buttons,
        participant:  participant
    } only %}

    </li>
{% endblock %}


{##
 # Massive javascript hulk
 #}
{% block scripts %}
    {% autoescape 'js' %}
    <script type="text/javascript">
        $(function () {
            $('#download-submissions').click(function (event) {
                event.preventDefault();
                $(this).confirmDialog({
                    header: 'Download all feedback and submissions?',
                    text: 'Please be aware that your download will take some time to begin as we compile the students feedback and submissions into a ZIP file.',
                });
            })
        });
    </script>
    {% endautoescape %}

    {% if not readonly %}
        <script type="application/javascript" src="{{ CDN_PREFIX }}/js/submissions/jquery.bulky.js?v={{ config.site_version }}"></script>
        <div id="mass-publish" class="reveal-modal" data-reveal data-list-id="mass-publish-list" aria-hidden="true"
             role="dialog">
            <h2>Publish Drafts</h2>
            <p data-mass-unavailable>There aren't any valid and unpublished drafts for this activity.</p>
            <p data-mass-available>The following drafts can be published:</p>
            <section class="checklist" id="mass-publish-list">
                <div data-template>{# this will get detached from the DOM on pageload #}
                    <input type="checkbox" data-selected checked/>
                    <label class="checkbox-label" data-participant-name>{# populated by JS #}</label>
                </div>
            </section>
            <div class="component-action">
                <section>
                    {%- apply spaceless -%}
                        <a class="button">Cancel</a>
                        <a class="button" data-submit>Publish All</a>
                    {%- endapply -%}
                </section>
            </div>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </div>

        <div id="mass-submit" class="reveal-modal" data-reveal data-list-id="mass-submit-list" aria-hidden="true"
             role="dialog">
            <h2>Acknowledge Receipt of Submission</h2>
            <p id="checkbox-switch-container">
                The due date for this work has passed.<br/>
                Did all students below submit their work on time?
                <span class="switch">
                    <input id="onTimeCheckboxSwitch" type="checkbox" checked="">
                    <label for="onTimeCheckboxSwitch">
                        <span>Yes</span>
                        <span>No</span>
                    </label>
                </span>
            </p>
            <p data-mass-unavailable>You have no students requiring submission.</p>
            <p data-mass-available>Acknowledge receipt of submission for:</p>
            <section class="checklist" id="mass-submit-list">
                <div data-template>{# this will get detached from the DOM on pageload #}
                    <input type="checkbox" data-selected checked/>
                    <label class="checkbox-label" data-participant-name>{# populated by JS #}</label>
                </div>
            </section>
            <div class="component-action">
                <section>
                    {%- apply spaceless -%}
                        <a class="button">Cancel</a>
                        <a class="button" data-submit>All Received</a>
                    {%- endapply -%}
                </section>
            </div>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </div>

        <div class="toast" data-alert data-save-draft></div>

        {# Dynamic Feedback
         #
         # This is the javascript which powers the Quickmark and Inline Grader
         # Feedback forms, giving them the async save/publish capabilities
         #
         # Originated in Quickmark, reused in Inline Grader

            available variables:
             - routeArgs:   an array that represents a participant, to be pushed into a routeLookup
             - assessment:  the assessment we're looking at
             - participant: the current participant of the iteration
             - statusIncomplete: a string representing the 'incomplete' state
             - statusFailed: a string representing the 'failed' state
             - statusPending: a string representing the 'pending' state
             - statusReviewed: a string representing the 'reviewed' state
         #}
        <script type="text/javascript" src='{{ CDN_PREFIX }}/js/submissions/jquery.dynamic-feedback.js'></script>
        {% autoescape 'js' %}
            <script type="text/javascript">
                $(function () {
                    $.fn.dynamicFeedback({
                        statusIncomplete: '{{ statusIncomplete }}',
                        statusFailed: '{{ statusFailed }}',
                        statusPending: '{{ statusPending }}',
                        statusReviewed: '{{ statusReviewed }}',
                        reviewedText: '{{ labelReviewed }}',
                        onPreDraftCallback: function(){
                        },
                        onDraftCallback: function (userId, isSuccess, message, feedbackId) {
                            let $actionBar = $('[data-participant=' + userId + '] [data-action-bar]'),
                                $publishButton = $actionBar.find('[data-draft=publish]');
                            $publishButton.attr('data-draft-id', feedbackId);
                            $actionBar.attr('data-mass-publish', '');
                            $actionBar.removeAttr('data-mass-submit');
                        },
                        onPrePublishCallback: function(){
                        },
                        onPublishCallback: function (userId) {
                            let $actionBar = $('[data-participant=' + userId + '] [data-action-bar]'),
                                $ackButton = $actionBar.find('[data-sobo]'),
                                $publishButton = $actionBar.find('[data-draft=publish]');
                            $publishButton.removeAttr('data-draft-id');
                            $actionBar.removeAttr('data-mass-publish');
                            $actionBar.removeAttr('data-mass-submit');
                            $ackButton.fadeOut({
                                done: function () {
                                    $ackButton.remove();
                                }
                            });
                        }
                    });

                    let $userList = $('#assessment-status');

                    {# Mass publish draft feedbacks #}
                    $('#mass-publish').bulky({
                        submitText: function (len, all) {
                            if (!len) {
                                return 'None Selected';
                            }

                            if (len === all) {
                                return 'Publish All';
                            }

                            return 'Publish ' + len + ' Selected';
                        },

                        userSelector: '[data-mass-publish]',
                        userList: $userList,

                        {# The people you want to publish must have currently-valid data
                         # Otherwise you'll end up potentially publishing invalid data
                         #}
                        checkboxConditionality: function(id) {
                            return $('[data-feedback-form="' + id + '"]').valid();
                        },

                        {# When you hit Publish All, it attempts to saves each draft feedback in the list
                         # It gets those feedbacks' ids and publishes them in the back end
                         #
                         # This should take an intersect of the checkbox list that you saw in the modal
                         # and the available drafts in the quickmark screen
                         #}
                        onSubmit: function (toPublish) {
                            let draftFeedbackIds = [],
                                $actionBars      = [],
                                $toast = $('[data-save-draft]');

                            $toast.toastActivate({text: 'Publishing drafts...'});

                            {# Iterate through each publish button #}
                            toPublish.each(function () {
                                let $actionBar      = $(this),
                                    $publishButton  = $actionBar.find('[data-draft=publish]'),
                                    draftFeedbackId = $publishButton.attr('data-draft-id');

                                $publishButton.html('Publishing...');
                                $publishButton.attr('disabled', 'disabled');
                                draftFeedbackIds.push(draftFeedbackId);
                                $actionBars[draftFeedbackId] = $actionBar;
                            });

                            $.post('{{ routeLookup('learningDueWorkFeedback.postParticipantFeedbacks', {assessmentId: assessment.id}) }}', {
                                'drafts': draftFeedbackIds
                            }).done(function (response) {
                                let feedbackErrors = false;

                                for (let feedbackId in response) {
                                    if (response.hasOwnProperty(feedbackId)) {
                                        let result           = response[feedbackId],
                                            isPublishSuccess = result['publishSuccess'],
                                            $actionBar       = $actionBars[feedbackId],
                                            $publishButton   = $actionBar.find('[data-draft=publish]');

                                        feedbackErrors = feedbackErrors || !isPublishSuccess;

                                        $publishButton.html('Publish');
                                        $publishButton.removeAttr('disabled');

                                        if (isPublishSuccess) {
                                            draftPublishSuccess($actionBar, $publishButton);
                                        }
                                    }
                                }

                                {# Update the toast depending on error/success #}
                                if (feedbackErrors) {
                                    $toast.toastTimeout({text: 'Unable to publish all drafts', css: 'alert'});
                                } else {
                                    $toast.toastTimeout({text: 'Published all drafts', css: 'success'});
                                }
                            }).fail(function () {
                                {# Something went wrong, display an error toast #}
                                $toast.toastTimeout({text: 'Unable to publish draft feedbacks.', css: 'alert'});
                            });
                        }
                    });

                    {# These variables allow the confirm-dialog to be disabled in the case of bulk acknowledgements, #}
                    {# and set whether bulk acknowledgements should confirm submissions as having been on-time.      #}
                    let confirmDialogDisabled            = false;
                    let confirmDialogDisabledOnTimeValue = false;

                    {# Mass acknowledge receipt of submissions #}
                    $('#mass-submit').bulky({
                        submitText: function (len, all) {
                            if ((Date.now() / 1000) > Number('{{ assessment.dueAt.unixTimestamp }}')) {
                                $('#checkbox-switch-container').show();
                            } else {
                                $('#checkbox-switch-container').hide();
                            }

                            if (!len) {
                                return 'None Selected';
                            }
                            if (len === all) {
                                return 'All Received';
                            }
                            return 'Received ' + len + ' selected';
                        },
                        userSelector: '[data-mass-submit]',
                        userList: $userList,
                        onSubmit: function (toSubmit) {
                            confirmDialogDisabled            = true;
                            confirmDialogDisabledOnTimeValue = $('#onTimeCheckboxSwitch').prop('checked');
                            toSubmit.each(function () {
                                $(this).find('[data-sobo]').trigger('click');
                            });
                        }
                    });

                    {# Handle clicks on 'Submission Received' buttons #}
                    $('[data-sobo]').on('click', function () {
                        $buttonClicked = $(this);

                        if (!confirmDialogDisabled) {
                            if ((Date.now() / 1000) > Number('{{ assessment.dueAt.unixTimestamp }}')) {
                                $('#confirm-dialog').foundation('reveal', 'open'); {# Reveal confirm popup to ask the user whether submission was on-time. #}

                                {# Handle clicks on confirm popup buttons. #}
                                {# We bind click handlers here so we can pass $buttonClicked to postSobo() directly. #}
                                {# Because we bind here, we must first unbind to avoid binding the same function again each time the 'No' or 'Yes' button is clickec. #}
                                $('#confirm-dialog [data-yes]').unbind('click').click(function () {postSobo($buttonClicked, true );});
                                $('#confirm-dialog [data-no]' ).unbind('click').click(function () {postSobo($buttonClicked, false);});
                            } else {
                                postSobo($buttonClicked, false); {# Submission was not confirmed to be on-time. #}
                            }
                        } else {
                            postSobo($buttonClicked, confirmDialogDisabledOnTimeValue); {# Use default value for whether submission was confirmed to be on-time. #}
                        }
                    });

                    /**
                     * Send a post request to the server, notifying that:
                     *  * the student (identified by the button clicked)
                     *  * has submitted the assessment task (identified by the button href).
                     *
                     * @param {boolean} submissionWasOnTime - true if the submission was received on time.
                     */
                    function postSobo($button, submissionWasOnTime) {
                        let buttonText   = $button.html(),
                            $actionBar   = $button.closest('[data-action-bar]'),
                            $participant = $actionBar.closest('[data-participant]'),
                            $statusIcon  = $participant.find('[data-status]'),
                            $statusLabel = $participant.find('[data-status-label]'),
                            $toast       = $('[data-save-draft]');

                        $toast.toastActivate({text: 'Marking submission as received...'});
                        $button.html('Working...');
                        $button.attr('disabled', '');

                        $.post($button.attr('href'), {'submissionWasOnTime': submissionWasOnTime})
                        .done(function(response) {
                            /** @var {bool} response.success */
                            if (true !== Boolean(response.success)) {
                                soboFailure($button, buttonText, $toast);
                                return;
                            }

                            /** @var {bool} response.submittedLate */
                            soboSuccess(
                                $participant,
                                $button,
                                $actionBar,
                                $statusIcon,
                                $statusLabel,
                                response.submittedLate,
                                $toast
                            )
                        })
                        .fail(function () {
                            $('#confirm-dialog').hide();
                            soboFailure($button, buttonText, $toast);
                        });

                        $('#confirm-dialog').foundation('reveal', 'close');
                    }

                    /**
                     * Handle a submission receipt success
                     *
                     * @param {jQuery} $participant
                     * @param {jQuery} $button
                     * @param {jQuery} $actionBar
                     * @param {jQuery} $statusIcon
                     * @param {jQuery} $statusLabel
                     * @param {bool}   submittedLate
                     * @param {jQuery} $toast
                     */
                    function soboSuccess($participant,
                                         $button,
                                         $actionBar,
                                         $statusIcon,
                                         $statusLabel,
                                         submittedLate,
                                         $toast) {
                        $toast.toastTimeout({text: 'Submission marked as received', css: 'success'});
                        $button.fadeOut({
                            done: function () {
                                if (!$actionBar.is('[data-mass-publish]')) {
                                    $actionBar.slideUp();
                                }
                                $button.remove();
                            }
                        });
                        $participant.attr('data-status', 'pending');
                        $actionBar.removeAttr('data-mass-submit');
                        $statusIcon.addClass('{{ statusPending }}');
                        $statusLabel.html('Submitted in person ' + (submittedLate ? 'late' : 'on time'));
                        $statusIcon.attr('title', '{{ labelPending }}');
                        $statusIcon.attr('data-assessment-status-light', 'pending');
                        $('#filters').find('[data-status="pending"]').prop('checked', true);
                    }

                    /**
                     * Handle a submission receipt failure
                     *
                     * @param {jQuery} $button
                     * @param {string} buttonText
                     * @param {jQuery} $toast
                     */
                    function soboFailure($button, buttonText, $toast) {
                        $button.html(buttonText);
                        $button.removeAttr('disabled');
                        $toast.toastTimeout({text: 'Unable to mark submission as received', css: 'alert'});
                    }

                    /**
                     * Handle a draft submission success
                     *
                     * @param {jQuery} $actionBar
                     * @param {jQuery} $publishButton
                     */
                    function draftPublishSuccess($actionBar, $publishButton) {
                        let $soboButton      = $actionBar.find('[data-sobo]'),
                            $draftedSpan     = $actionBar.find('[data-draft=drafted]'),
                            $extraMeta       = $actionBar.find('[data-feedback-attach-info]'),
                            $feedbackButtons = $draftedSpan.add($publishButton);

                        $actionBar.removeAttr('data-mass-publish');
                        $actionBar.removeAttr('data-mass-submit');

                        // Cannot sobo an acknowledgment once published feedback exists
                        $soboButton.fadeOut({
                            done: function () {
                                $soboButton.remove();
                            }
                        });

                        // Hide the feedback buttons
                        $feedbackButtons.fadeOut();

                        // Slide up if no meta to display
                        if(!$extraMeta.length){
                            $actionBar.slideUp();
                        }
                    }
                });
            </script>
        {% endautoescape %}

        {# Import Feedback
         #
         # Copy directly from a spreadsheet into this textarea. The plugin busts its contents
         # into the quickmark (status) screen's input fields accordingly.
         #}
