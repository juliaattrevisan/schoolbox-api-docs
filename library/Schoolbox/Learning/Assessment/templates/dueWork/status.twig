{#  usage: per-participation, configure the following vars for the parent template to use
     - pActionResponses: a route to see the list of responses for this participation
     - pStatusText:      the description to output under the user's name
     - pStatusClass:     one of [ '', 'pending', 'reviewed' ] to denote the action status of this participation
     - pTooltip:         a tooltip explaining the status marker

    available variables:
     - routeArgs:        an array that represents a participant, to be pushed into a routeLookup
     - assessment:       the assessment we're looking at
     - participant:      the current participant of the iteration
     - statusIncomplete: a string representing the 'incomplete' state
     - statusPending:    a string representing the 'pending'    state
     - statusReviewed:   a string representing the 'reviewed'   state
     - errors:           string[]  Admin-configured submission states, eg 'Absent', 'Pending', 'Not Submitted' etc
     - markSchemeName:   string    filename of markScheme template fragment
     - interactionLocked: bool Is the assessment locked for interactions because it is due in an archived term?

#}
{% extends '@learningAssessment/status.twig' %}

{% set labelIncomplete = 'Submission required' %}
{% set labelPending    = 'Marking required' %}
{% set labelReviewed   = 'Reviewed' %}

{% set readonly = interactionLocked and not USER.superUser %}

{% block headerOptions %}
    {% if download %}
    <li>
        <a class="icon-download" href="{{ routeLookup('learningAssessment.downloadSubmissions', {assessmentId: assessment.id, assessment: assessment}) }}">Download All Submissions</a>
    </li>
    {% endif %}
    {% if assessment.useRubric %}
    <li>
        <a href="{{ routeLookup('learningAssessment.getOverview', { assessmentId: assessment.id }) }}" class="icon-progress">Rubric Report</a>
    </li>
    {% endif %}
    {% if not readonly %}
    <li class="separator">Bulk Actions</li>
    <li>
        <a class="icon-approve" data-mass="publish" data-reveal-id="mass-publish">Publish drafts&hellip;</a>
    </li>
    {% endif %}
{% endblock %}


{% block config %}

    {% set latestFeedback    = participant.findMostRecentFeedback %}
    {% set latestResponse    = participant.findMostRecentSubmittedResponse %}
    {% set multipleResponses = participant.allResponses | length > 1 %}

    {% set isPublished  = latestFeedback.published %}
    {% set canPublish   = latestFeedback and not isPublished %}

    {% set pActionResponses  = routeLookupIfAuthorized('learningResponse.getParticularResponse', routeArgs) %}
    {% set fbUrl             = routeLookupIfAuthorized('learningFeedback.postParticipantFeedback', { assessmentId: participant.assessable.id, studentId: participant.user.id, participant: participant }) %}

    {% set pStatusClass = participant.responseRequired ? statusIncomplete : (participant.feedbackRequired ? statusPending : statusReviewed ) %}
    {% set pTooltip     = participant.responseRequired ? labelIncomplete  : (participant.feedbackRequired ? labelPending  : labelReviewed ) %}
    {% set pSobo        = assessment.acceptOnline %}

    {% set pStatusText %}
        {%- spaceless %}
            {% if not latestResponse %}
                {% if participant.reviewComplete %}
                    {{ labelReviewed }}
                {% else %}
                    Not submitted
                {% endif %}
            {% else %}
                {% if multipleResponses %}
                    Resubmitted
                {% else %}
                    Submitted
                {% endif %}
                {% if latestResponse.submittedOnTime %}
                    on time
                {% else %}
                    late
                {% endif %}
            {% endif %}
        {% endspaceless -%}
    {% endset %}

    {{ parent() }}
{% endblock %}


{% block grading %}
    <div class="small-12 column">

        {% if fbUrl %}
        <form data-feedback-form method="post" action="{{ fbUrl }}">
        {% endif %}

            <input type="hidden" name="responseId" value="{{ response.id }}" />

            <div class="row">
                {% if 'none' != markSchemeName | lower %}
                <div class="small-12 medium-3 column">
                    <label>{{ locale.grades.proper }}
                    {% include '@learningMarkScheme/'~markSchemeName~'.twig' with {
                        participant: participant,
                        markScheme:  assessment.markScheme,
                        tabIndex:    (loop.index0 * 2) + 1,
                        errors:      errors,
                        readonly:    readonly
                    } only %}
                    </label>
                </div>
                {% endif %}

                <div class="small-12{% if 'none' != markSchemeName | lower %} medium-9{% endif %} column">
                    {% include '@learningAssessment/fragments/dueWork/comment.twig' with {
                        participant: participant,
                        tabIndex:   (loop.index0 * 2) + 2,
                        readonly:    readonly
                    } only %}
                </div>
            </div>
        {% if fbUrl %}
        </form>
        {% endif %}
    </div>
{% endblock %}

{% block action_bar %}

    {#
    If there's any files, rubric marks, or crocoodoc annotated doc
    attached to the feedback - tell the user that this feedback also includes those.
    #}
    {% if (latestFeedback.allFiles.count > 0) or (rubricMarks[participant.user.id] and latestFeedback) %}

        {% set attachedMsg = 'Feedback also includes <a href="' ~ pActionResponses ~ '">' %}

        {# Check if this feedback has a crocodoc annotation attached to it #}
        {% set hasCrocodoc = false %}
        {% if (latestFeedback and latestFeedback.response.allFiles.count > 0) or (not latestFeedback and participant.findMostRecentResponse().allFiles.count > 0) %}
            {% if latestFeedback %}
                {% set allFiles = latestFeedback.response.allFiles %}
            {% else %}
                {% set allFiles = participant.findMostRecentResponse().allFiles %}
            {% endif %}

            {% for currentFile in allFiles %}
                {% if currentFile.crocodocId %}
                    {% set hasCrocodoc = true %}
                {% endif %}
            {% endfor %}
        {% endif %}

        {# Annotated document/Crocodoc #}
        {% if hasCrocodoc %}
            {% set attachedMsg = attachedMsg ~ 'annotated document' %}
        {% endif %}

        {# Rubric #}
        {% if rubricMarks[participant.user.id] %}
            {% if hasCrocodoc and latestFeedback.allFiles.count > 0 %}
                {% set attachedMsg = attachedMsg ~ ', ' %}
            {% elseif hasCrocodoc and latestFeedback.allFiles.count == 0 %}
                {% set attachedMsg = attachedMsg ~ ' and ' %}
            {% endif %}
            {% set attachedMsg = attachedMsg ~ 'rubric' %}
        {% endif %}

        {# Files #}
        {% if latestFeedback.allFiles.count > 0 %}

            {% if hasCrocodoc or rubricMarks[participant.user.id] %}
                {% set attachedMsg = attachedMsg ~ ' and ' %}
            {% endif %}

            {% set attachedMsg = attachedMsg ~ latestFeedback.allFiles.count ~ ' file' %}

            {% if latestFeedback.allFiles.count > 1 %}
                {% set attachedMsg = attachedMsg ~ 's' %}
            {% endif %}

        {% endif %}

        {% set attachedMsg = attachedMsg ~ '</a>.' %}

    {% endif %}


    {# Action Bar #}
    {% set feedback            = participant.findMostRecentFeedback %}
    {% set isDraftFeedback     = feedback and not feedback.published %}
    {% set isPublishedFeedback = feedback and feedback.published %}
    {% set actionStyle         = isDraftFeedback or attachedMsg ? '' : 'display: none;' %}

    {# Action Bar data attrs #}
    {% set massActions = isDraftFeedback ? 'data-mass-publish' : '' %}
    {% set dataAttrs   = isPublishedFeedback ? 'data-published' : '' %}


    {% spaceless %}
        {% set buttons %}
            <span class="button disabled" data-draft="drafted" title="You can discard this draft from the Grading Overview screen">{% if isDraftFeedback %}Saved as Draft{% endif %}</span>
            {% if not readonly %}<a class="button" data-draft="publish" {% if feedback.published %}style="display:none;"{% endif %}>Publish</a>{% endif %}
        {% endset %}
    {% endspaceless %}

    {% include '@learningAssessment/fragments/actionBar.twig' with {
        actionStyle:  actionStyle,
        attachedMsg:  attachedMsg,
        massActions:  massActions,
        dataAttrs:    dataAttrs,
        buttons:      buttons
    } only %}

{% endblock %}

{% block scripts %}
{% if not readonly %}
<script type="application/javascript" src="/javascript/shared/submissions/jquery.bulky.js"></script>
<div id="mass-publish" class="reveal-modal" data-reveal data-list-id="mass-publish-list" aria-hidden="true" role="dialog">
    <h2>Publish Drafts</h2>
    <p data-mass-unavailable>You have no unpublished drafts for this activity currently visible.</p>
    <p data-mass-available>The following drafts can be published:</p>
    <section class="checklist" id="mass-publish-list">
        <div data-template>{# this will get detached from the DOM on pageload #}
            <input type="checkbox" data-selected checked />
            <label class="checkbox-label" data-participant-name>{# populated by JS #}</label>
        </div>
    </section>
    <div class="component-action">
        <section>
        {%- spaceless -%}
            <a class="button">Cancel</a>
            <a class="button" data-submit>Publish All</a>
        {%- endspaceless -%}
        </section>
    </div>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div class="toast" data-alert data-save-draft></div>

    {# Dynamic Feedback
     #
     # This is the javascript which powers the Quickmark and Inline Grader
     # Feedback forms, giving them the async save/publish capabilities
     #
     # Originated in Quickmark, reused in Inline Grader

        available variables:
         - routeArgs:   an array that represents a participant, to be pushed into a routeLookup
         - assessment:  the assessment we're looking at
         - participant: the current participant of the iteration
         - statusIncomplete: a string representing the 'incomplete' state
         - statusPending: a string representing the 'pending' state
         - statusReviewed: a string representing the 'reviewed' state
     #}
    <script type="text/javascript" src='/javascript/shared/submissions/jquery.dynamic-feedback.js'></script>
    <script type="text/javascript">
        $(function() {
            $.fn.dynamicFeedback({
                statusIncomplete: '{{ statusIncomplete }}',
                statusPending: '{{ statusPending }}',
                statusReviewed: '{{ statusReviewed }}',
                onDraftCallback: function(userId) {
                    $('[data-participant='+userId+'] [data-action-bar]').attr('data-mass-publish', '');
                },
                onPublishCallback: function(userId) {
                    $('[data-participant='+userId+'] [data-action-bar]').removeAttr('data-mass-publish');
                }
            });

            $('#mass-publish').bulky({
                submitText: function (len, all) {
                    if (!len) {
                        return 'None Selected';
                    }
                    if (len == all) {
                        return 'Publish All';
                    }
                    return 'Publish ' + len + ' Selected';
                },
                userSelector: '[data-mass-publish]',
                userList: $('#assessment-status'),
                onSubmit: function (toPublish) {
                    toPublish.each(function () {
                        $(this).find('[data-draft="publish"]').trigger('click');
                    });
                }
            });
        });
    </script>
{% endif %}
{% endblock %}
