{#  usage: per-participation, configure the following vars for the parent template to use
     - pActionResponses: a route to see the list of responses for this participation
     - pStatusText:      the description to output under the user's name
     - pStatusClass:     one of [ '', 'pending', 'complete' ] to denote the action status of this participation
     - pTooltip:         a tooltip explaining the status marker

    available varaibles:
     - routeArgs:   an array that represents a participant, to be pushed into a routeLookup
     - assessment:  the assessment we're looking at
     - participant: the current participant of the iteration
     - statusIncomplete: a string representing the 'incomplete' state
     - statusPending: a string representing the 'pending' state
     - statusComplete: a string representing the 'complete' state

#}
{% extends '@learningAssessment/status.twig' %}

{% block config %}

    {# TODO uncomment once this route is merged to core #}
    {#{% set pActionResponses = routeLookupIfAuthorized('learningResponse.getResponseList', routeArgs) %}#}

    {% set latestFeedback    = participant.findMostRecentFeedback %}
    {% set latestResponse    = participant.findMostRecentResponse %}
    {% set multipleResponses = participant.allResponses | length > 1 %}

    {% set isPublished  = latestFeedback.published %}
    {% set canPublish   = latestFeedback and not isPublished %}

    {% if assessment.acceptsNone %}
        {% set pStatusClass = '' %}
        {% set pTooltip     = '' %}
    {% else %}
        {% set pStatusClass = participant.markingRequired ? statusPending : (latestResponse or latestFeedback ? statusComplete : statusIncomplete) %}
        {% set pTooltip     = participant.markingRequired ? 'Mark required' : (latestResponse or latestFeedback ? 'Marked' : 'No submission') %}

        {% set pStatusText %}
            {%- spaceless %}
                {% if not latestResponse %}
                    Not submitted
                {% else %}
                    {% if multipleResponses %}
                        Resubmitted
                    {% else %}
                        Submitted
                    {% endif %}
                    {% if latestResponse.submittedAt < assessment.dueAt %}
                        on time
                    {% else %}
                        late
                    {% endif %}
                {% endif %}
            {% endspaceless -%}
        {% endset %}
    {% endif %}

    {{ parent() }}
{% endblock %}


{% block grading %}
    {% include '@learningMarkScheme/'~markScheme~'.twig' with { markScheme: assessment.markScheme } %}
{% endblock %}

{% block scripts %}
<div class="toast" data-alert data-save-draft></div>
<script type="text/javascript">
    $(function () {

        var formSaveLabel  = $('[data-save-draft]');
        var assessmentList = $('#assessment-status');
        var filters        = $('#filters');

        $('[data-combobox]').combobox({{ errors | json_encode | raw }});

        assessmentList
            .on('change keydown paste keypress', 'textarea', function () {
                if ($(this).val() == $(this).data('preval')) {
                    return;
                }

                var $form = $(this).closest('form');
                $form.find('[data-interaction-draft]').slideDown();

            })
            .on('focus', ':input', function () {
                // stash the current state, so we can compare on blur and prevent unnecessary firing
                $(this).data('preval', $(this).val());

            })
            .on('blur', ':input', function () {

                // do a preval comparison to find out if we can skip AJAX
                if ($(this).val() == $(this).data('preval')) {
                    return;
                }

                // clear the pre-val
                $(this).data('preval', null);

                var $form = $(this).closest('form');

                var data = {
                    type: $form.attr('method'),
                    dataType: 'json',
                    data: $form.serializeArray()
                };

                formSaveLabel.toastActivate({
                    text: 'Autosaving'
                });

                $.ajax($form.attr('action'), data)
                    .done(function () {
                        toast.apply($form, arguments);

                        var $li = $form.closest('[data-status]');

                        $li.attr('data-status', '{{ statusComplete }}');

                        $li.find('.progress-tick')
                            .removeClass('{{ statusIncomplete }} {{ statusPending }}')
                            .addClass('{{ statusComplete }}');

                        filters.find('[data-status="complete"]').prop('checked', true);

                        console.log(this);
                    })
                    .fail(function () { toast.apply($form, arguments); })
                    .always(function () { toast.apply($form, arguments); });
            });

        function toast(arguments) {
//            console.log(arguments);

            formSaveLabel.toastTimeout({
                text: 'Draft Saved',
                css: 'success'
            });

            this.find('[data-interaction-draft]').slideDown();
        }

    });
</script>
{% endblock %}
