{#  usage: per-participation, configure the following vars for the parent template to use
     - pActionResponses: a route to see the list of responses for this participation
     - pStatusText:      the description to output under the user's name
     - pStatusClass:     one of [ '', 'pending', 'complete' ] to denote the action status of this participation
     - pTooltip:         a tooltip explaining the status marker

    available variables:
     - routeArgs:   an array that represents a participant, to be pushed into a routeLookup
     - assessment:  the assessment we're looking at
     - participant: the current participant of the iteration
     - statusIncomplete: a string representing the 'incomplete' state
     - statusPending: a string representing the 'pending' state
     - statusComplete: a string representing the 'complete' state

#}
{% extends '@learningAssessment/status.twig' %}

{% block headerOptions %}
    <li class="separator">Bulk Actions</li>
    <li>
        <a class="icon-approve" data-mass="publish" data-reveal-id="mass-publish">Publish drafts&hellip;</a>
    </li>
{% endblock %}


{% block config %}

    {% set latestFeedback    = participant.findMostRecentFeedback %}
    {% set latestResponse    = participant.findMostRecentSubmittedResponse %}
    {% set multipleResponses = participant.allResponses | length > 1 %}

    {% set isPublished  = latestFeedback.published %}
    {% set canPublish   = latestFeedback and not isPublished %}

    {% set pActionResponses  = routeLookupIfAuthorized('learningResponse.getParticularResponse', routeArgs) %}

    {% if assessment.acceptsNone %}
        {% set pStatusClass = '' %}
        {% set pTooltip     = '' %}
    {% else %}
        {% set pStatusClass = participant.markingRequired ? statusPending : (latestResponse or latestFeedback ? statusComplete : statusIncomplete) %}
        {% set pTooltip     = participant.markingRequired ? 'Mark required' : (latestResponse or latestFeedback ? 'Marked' : 'No submission') %}

        {% set pStatusText %}
            {%- spaceless %}
                {% if not latestResponse %}
                    Not submitted
                {% else %}
                    {% if multipleResponses %}
                        Resubmitted
                    {% else %}
                        Submitted
                    {% endif %}
                    {% if latestResponse.submittedOnTime %}
                        on time
                    {% else %}
                        late
                    {% endif %}
                {% endif %}
            {% endspaceless -%}
        {% endset %}
    {% endif %}

    {{ parent() }}
{% endblock %}


{% block grading %}
    {% include '@learningMarkScheme/'~markScheme~'.twig' with {
        markScheme: assessment.markScheme,
        fbUrl: routeLookup('learningFeedback.postParticipantFeedback', { assessmentId: participant.assessable.id, studentId: participant.user.id })
    } %}
{% endblock %}

{% block scripts %}

<div id="mass-publish" class="reveal-modal" data-reveal aria-hidden="true" role="dialog">
    <h2>Publish Drafts</h2>
    <p>The following drafts can be published:</p>
    <section class="checklist" id="mass-publish-list">
        <div data-template>{# this will get detached from the DOM on pageload #}
            <input type="checkbox" data-participant-selected checked />
            <label class="checkbox-label" data-participant-name>{# populated by JS #}</label>
        </div>
    </section>
    <div class="component-action">
        <section>
        {%- spaceless -%}
            <a class="button">Cancel</a>
            <a class="button" data-mass-publish>Publish All</a>
        {%- endspaceless -%}
        </section>
    </div>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div class="toast" data-alert data-save-draft></div>

    {# Dynamic Feedback
     #
     # This is the javascript which powers the Quickmark and Inline Grader
     # Feedback forms, giving them the async save/publish capabilities
     #
     # Originated in Quickmark, reused in Inline Grader

        available variables:
         - routeArgs:   an array that represents a participant, to be pushed into a routeLookup
         - assessment:  the assessment we're looking at
         - participant: the current participant of the iteration
         - statusIncomplete: a string representing the 'incomplete' state
         - statusPending: a string representing the 'pending' state
         - statusComplete: a string representing the 'complete' state
         - errors: An array of "Submission States" such as absent, et al.
     #}
    <script type="text/javascript" src='/javascript/shared/submissions/jquery.dynamic-feedback.js'></script>
    <script type="text/javascript">
        $(function() {
            $.fn.dynamicFeedback({
                errors: {{ errors | json_encode | raw }},
                statusIncomplete: '{{ statusIncomplete }}',
                statusPending: '{{ statusPending }}',
                statusComplete: '{{ statusComplete }}'
            });

            var $massItemTpl = $('#mass-publish-list').find('[data-template]').removeAttr('data-template').detach();

            var $participantList   = $('#assessment-status'),
                $massPublishReveal = $('#mass-publish'),
                $massPublishSubmit = $massPublishReveal.find('[data-mass-publish]');

            $massPublishReveal.on('change', '[data-participant-selected]', function () {

                var $checks = $massPublishReveal.find('[data-participant-selected]');

                // see if the list has anything selected
                var all = $checks.length;
                var len = $checks.filter(':checked').length;

                if (len == all) {
                    $massPublishSubmit.removeAttr('disabled').text('Publish All');

                } else if (len) {
                    $massPublishSubmit.removeAttr('disabled').text('Publish ' + len + ' Selected');

                } else {
                    $massPublishSubmit.attr('disabled', 'disabled').text('None Selected');
                }
            });

            $massPublishReveal.on('open.fndtn.reveal', function () {

                $massPublishSubmit.removeAttr('disabled').text('Publish All');

                $('#mass-publish-list').html(

                        $participantList.find('[data-interaction-draft]:visible').closest('[data-participant-name]').map(function () {

                            var $item = $massItemTpl.clone(),
                                tag   = $item.prop("tagName").toLowerCase(),
                                $lbl  = $item.find('[data-participant-name]'),
                                $chk  = $item.find('[data-participant-selected]'),
                                id    = $(this).find('[data-interaction-draft]').data('interactionDraft');

                            $chk.attr('id', id);
                            $lbl.attr('for', id);

                            // apply the name
                            $lbl.text($(this).data('participantName'));

                            // because outerHtml doesn't exist as a thing
                            return ['<', tag, '>', $item.html(), '</', tag, '>' ].join('');

                        }).get().join('')

                );

            });

            $massPublishSubmit.on('click', function (e) {
                e.preventDefault();

                $massPublishReveal.find(':checked').each(function () {
                    $participantList.find('[data-interaction-draft='+this.id+']').find('[data-draft="publish"]').trigger('click');
                });

            });

            $massPublishReveal.on('click', '.button', function () {
                $massPublishReveal.foundation('reveal', 'close');
            });

        });
    </script>
{% endblock %}
