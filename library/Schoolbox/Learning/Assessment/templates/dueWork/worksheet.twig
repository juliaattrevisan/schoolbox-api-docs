{#
     Displays a Kami Document for viewing.

     Data:
         kami        Kami\Model
         session     Kami\Session              Optional. Null if document not finished processing.
         response    DueWork\Submission\Model
 #}
{% import 'sub/breadcrumbs.twig' as bread %}

{# Build breadcrumbs #}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Worksheet for {{ assessment.title }}</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if session %}
            {% include 'sub/iframeResponsive.twig' with {
                id: 'kami-viewport',
                src: session.viewerUrl,
                allow: 'microphone *; camera *; midi *; encrypted-media *; autoplay *; clipboard-write *; clipboard-read *; display-capture *; fullscreen *',
                dataAttributes: {}
            } only %}
        {% else %}
            <div class="empty-state">
                <sbx-icon name="surveys" size="2.5rem"></sbx-icon>
                <p>This worksheet hasn't been viewed by any students yet.</p>
                <p>Please try again soon...</p>
            </div>
        {% endif %}
    </div>
</div>
