{##
 # Create Response screen for Dialog Agents
 #
 # This is where students get to interact with the dialog agent's chosen scenario, using all of that scenario
 # context fields that the staff entered to evaluate the conversation
 #
 # @param Collection $breadcrumbs         A set of key-value tuples for breadcrumb rendering
 # @param DialogAgent\Model $assessment   A Dialog Agent assessment instance (synonymous with Discussion)
 # @param array $feed                     The agent chat feed data current response
 # @param \Schoolbox\User $student        A user instance for the student
 # @param array $studentStruct            Array of author info about the student who owns the response
 # @param array $responseData             Array translation of the response to pass to Vue
 # @param int|null $duration              The time limit / duration (in seconds)
 # @param string $returnUrl               A redirect destination
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="actions-small-1 row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        {% include '@learningAssessment/dialogAgent/meta.twig' with {
            assessment: assessment,
            student: student,
            icon: 'icon-dialog-agent',
            participant: null,
            lastViews: null
        } only %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {# Apparently we _really_ want this to be a centered snowflake #}
        <section class="content c-max-width--medium l-mar--auto-horiz">
            <div id="dialog-agent-response-container" data-test="dialog-agent-response-container">
                <dialog-agent-response-chat
                    :feed="{{ feed |json_encode }}"
                    :response="{{ responseData |json_encode }}"
                    :student="{{ studentStruct |json_encode }}"
                    :duration="{{ duration ?? 'null' }}"
                    close-at="{{ assessment.closeAt.toRfc3339String }}"
                    return-url="{{ returnUrl }}"
                />
            </div>
            <script src="{{ CDN_PREFIX }}/js/bundle/dialogAgentResponse.js?v={{ config.site_version }}"></script>
        </section>
    </div>
</div>
