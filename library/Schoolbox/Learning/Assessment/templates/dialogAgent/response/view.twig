{##
 # View Response screen for Dialog Agents
 #
 # This is where instructors can view a learner's response, or learners can view their own submitted response
 #
 # @param Collection $breadcrumbs         A set of key-value tuples for breadcrumb rendering
 # @param DialogAgent\Model $assessment   A Dialog Agent assessment instance (synonymous with Discussion)
 # @param array $feed                     The agent chat feed data current response
 # @param User $student                   The student who owns the response
 # @param array $studentData              Array translation of author info about the student who owns the response
 # @param DialogAgent\Response $response  The response that we are viewing
 # @param array|null $responseData        Array translation of the response to pass to Vue
 # @param bool $interactionLocked         Is the assessment due in an archived term?
 # @param string|null $returnUrl          An optional redirect destination, otherwise actions reload the page
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

{% if participantCarousel is defined and participantCarousel|length > 1 %}
    {% include '@learningAssessment/dialogAgent/fragments/participantCarousel.twig' with {
        students: participantCarousel,
        selectedStudentId: student.id
    } only %}
{% endif %}

<div class="actions-small-1 row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        {% import '@learning/macro/dueDate.twig' as dueDate %}
        {% import '@learningAssessment/fragments/macro/duration.twig' as duration %}
        <ul class="meta">
            {% if not response %}
                {# noop; empty state below #}
            {% elseif response.isSubmitted %}
                <li class="icon-calendar">
                    Submitted <time title="{{ response.submittedAt.local }}">{{ response.submittedAt.relativeDayWithoutMidnight }}</time>
                </li>

                <li class="icon-time-value">
                    Time taken: {{ duration.secondsToHoursAndMinutes(response.timeTaken) }}
                </li>
            {% elseif response.startedAt %}
                <li class="icon-calendar">
                    <em>Response in progress - started <time title="{{ response.startedAt.local }}">{{ response.startedAt.relativeDayWithoutMidnight }}</time></em>
                </li>
            {% endif %}

            {% if interactionLocked %}
                <li class="icon-archive"> {{ locale.term.proper }} has been archived </li>
            {% endif %}
        </ul>
    </div>

    <nav>
        <sbx-pop-out content-id="header-options"></sbx-pop-out>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        {# Populated by the Teleport in <dialog-agent-chat> #}
    </ul>
</div>

<div class="row">
    <div class="small-12 island">
        <div id="dialog-agent-response-container" data-test="dialog-agent-view-response-container">
            {% set summaryRoute = routeLookup('learningAssessment.getSummary', {
                assessmentId: assessment.id,
                assessment: assessment,
                studentId: student.id,
                student: student
            }) %}
            {% set viewAuthoritativeResponseRoute = routeLookupIfAuthorized('learningDialogAgent.getParticularResponse', {
                assessmentId: assessment.id,
                assessment: assessment,
                studentId: student.id,
                student: student,
            }) %}
            <dialog-agent-response-view
                :feed="{{ feed |json_encode }}"
                :response="{{ responseData |json_encode }}"
                :student="{{ studentData |json_encode }}"
                summary-route="{{ summaryRoute }}"
                view-authoritative-response-route="{{ viewAuthoritativeResponseRoute }}"
                return-url="{{ returnUrl }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/dialogAgentResponse.js?v={{ config.site_version }}"></script>
    </div>
</div>
