{##
 # Create Response screen for Dialog Agents
 #
 # This is where students get to interact with the dialog agent's chosen scenario, using all of that scenario
 # context fields that the staff entered to evaluate the conversation
 #
 # @param Collection $breadcrumbs         A set of key-value tuples for breadcrumb rendering
 # @param DialogAgent\Model $assessment   A Dialog Agent assessment instance (synonymous with Discussion)
 # @param array $feed                     The agent chat feed data current response
 # @param array $student                  Array of author info about the student creating the response
 # @param DialogAgent\Response $response  The response that we are creating/resuming
 # @param array $responseData             Array about the response that we are creating/resuming
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="actions-small-1 row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        {% if readonly or interactionLocked %}
            {% import '@learning/macro/dueDate.twig' as dueDate %}
            {% import '@learningAssessment/fragments/macro/duration.twig' as duration %}
            <ul class="meta">
                {% if response.isSubmitted %}
                    <li class="icon-calendar">
                        Submitted <time title="{{ response.submittedAt.database }}">{{ response.submittedAt.relativeDayWithoutMidnight }}</time>
                    </li>

                    <li class="icon-time-value">
                        {% set startedAt = response.startedAt ?? response.createdAt %}
                        {% set endedAt = response.submittedAt ?? NOW %}
                        Time taken: {{ duration.secondsToHoursAndMinutes(startedAt.diffInSeconds(endedAt, true)) }}
                    </li>
                {% elseif response.startedAt %}
                    <li class="icon-calendar">
                        <em>Response in progress - started <time title="{{ response.startedAt.database }}">{{ response.startedAt.relativeDayWithoutMidnight }}</time></em>
                    </li>
                {% endif %}

                {% if interactionLocked %}
                    <li class="icon-archive"> {{ locale.term.proper }} has been archived </li>
                {% endif %}
            </ul>
        {% endif %}
    </div>

    {% if readonly or interactionLocked %}
        <nav>
            <sbx-pop-out content-id="header-options"></sbx-pop-out>
        </nav>
        <ul id="header-options" class="f-dropdown" data-dropdown-content>
            {# Populated by the Teleport in <dialog-agent-chat> #}
        </ul>
    {% endif %}
</div>

{# Apparently we _really_ want this to be a centered snowflake #}
<div class="row l-flex l-flex--center">
    <div class="small-12 island" style="max-width: 64em"> {# $medium-breakpoint: 64em #}
        <section class="content">
            <div id="dialog-agent-response-container" data-test="dialog-agent-response-container">
                {% set summaryRoute = routeLookup('learningAssessment.getSummary', {
                    assessmentId: assessment.id,
                    assessment: assessment,
                    studentId: student.id
                }) %}
                <dialog-agent-response-view
                    :feed="{{ feed |json_encode }}"
                    :response="{{ responseData |json_encode }}"
                    :student="{{ student |json_encode }}"
                    summary-route="{{ summaryRoute }}"
                />
            </div>
            <script src="{{ CDN_PREFIX }}/js/bundle/dialogAgentResponse.js?v={{ config.site_version }}"></script>
        </section>
    </div>
</div>
