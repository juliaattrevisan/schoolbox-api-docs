{##
 # @param IAssessable             assessment          an IAssesssable instance
 # @param User                    student             the student currently being viewed
 # @param string                  icon                a css class representing the assessable
 # @param null|Participant\Model  participant         an instance if the student is excluded from the assessment or deleted
 #}
{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learningAssessment/fragments/macro/duration.twig' as duration %}

{% apply spaceless %}
<ul class="meta">
    {% include '@learning/fragments/meta/dueDate.twig' %}
    {% include '@learning/fragments/meta/workType.twig' %}

    {# joining student name with lastView data #}
    {% if student.id != USER.id %}
        <li title="{% if lastViews.student.date is defined and lastViews.student.date is not null %}{{ lastViews.student.date }}{% endif %}"><sbx-icon name="staff-students"></sbx-icon>
            <a href="/search/user/{{ student.id }}">{{ student.fullname }}</a>
            {% if lastViews is not empty %}
                {{ lastViews.student.status }}
                {% if 'assessment' is same as(lastViews.student.object) %} this {{ locale.activity }}{% else %} the feedback {% endif %}
            {% endif %}
        </li>
    {% endif %}

    {% if assessment.allParticipants[student.id].isExcluded ?? false %}
        {#
         # now using the same code as the assessment update page:
         # library/Schoolbox/Learning/Assessment/templates/fragments/participation.twig:105
         #
         # needed isNull is same as(false) to test if getExcludedAt() has valid data.
         # I was not able to just test as getExcluedAt() is null, or find a better way
         #}
        <li><sbx-icon name="close"></sbx-icon> Excluded from {{ locale.activity }}</li>
    {% endif %}

    {% if lastViews is not empty %}
        {% for parent in lastViews.parents %}
            {% if parent.date is not null %}
            <li title="{{ parent.date }}"><sbx-icon name="staff"></sbx-icon>
                <a href="/search/user/{{ parent.id }}">{{ parent.name }}</a>
                {{ parent.status }} {% if 'assessment' is same as(parent.object) %} this {{ locale.activity }}{% else %} the feedback {% endif %}
            </li>
            {% endif %}
        {% endfor %}
    {% endif %}

    {# (optional) Duration
     # If a specific amount of allowed time was configured, tell people how long they have to cmopose their response.
     # Unlimited durations don't say anything; there's nothing you needed to know.
     #}
    {% if not assessment.isDurationUnlimited %}
        <li title="Allowed Time"><sbx-icon name="time-value"></sbx-icon> {% apply spaceless %}
            Allowed time: <time>{{ duration.secondsToHoursAndMinutes(assessment.duration) }}</time>
        {% endapply %}</li>
    {% endif %}

    {% include '@learning/fragments/meta/curriculumCodes.twig' %}
</ul>
{% endapply %}
