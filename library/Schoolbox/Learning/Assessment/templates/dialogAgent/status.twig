{##
 # Status screen for Dialog Agents
 #
 # Here you can see a strategic overview of people doing their responses and whether they needed help.
 # Async endpoints fulfil mutations and this polls periodically to get the latest status on responses.
 #
 # Note that this deviates from inheriting from assessment/status/status.twig because you'd have to trun off
 # all the duework-specific stuff.
 #
 # @param DialogAgent\Model $assessment         A Dialog Agent assessment instance (synonymous with Discussion)
 # @param Collection $breadcrumbs               A set of key-value tuples for breadcrumb rendering
 # @param array $criteria                       The criteria for the current scenario
 # @param array $assessments                    Assessment implementations with associated participants
 #}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 columns">
            <h1 data-test="assessment-status-meta-title">Status of {{ assessment.title }}</h1>
        </div>
    </div>
    <nav>
        <sbx-pop-out content-id="header-options" data-test="sbx-pop-out-header-options"></sbx-pop-out>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content data-assessment="{{ assessment.id }}">
        {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}

        {% if modifyRoute %}
            {% include '@learningAssessment/fragments/modifyLinks.twig' with {
                assessment: assessment,
                modifyRoute: modifyRoute,
                returnUrlName: RETURN_URL.name,
                returnUrl: RETURN_URL.current,
            } only %}
        {% endif %}

        {% set viewCustomParticipationRoute = routeLookupIfAuthorized('learningAssessment.getAssessmentParticipationForm', {
            assessmentId: assessment.id,
            assessment: assessment
        }) %}

        {% if viewCustomParticipationRoute %}
            <li><a href="{{ viewCustomParticipationRoute }}" class="sbx-button--has-icon"><sbx-icon name="group"></sbx-icon>Student Participation</a></li>
        {% endif %}
    </ul>
</div>

<div id="dialog-agent-status-container">
    <dialog-agent-status
        :criteria="{{ criteria|json_encode }}"
        :assessments="{{ assessments|json_encode }}"
        export-route="{{ routeLookupIfAuthorized('learningDialogAgent.getExport', {
            assessmentId: assessment.id,
            assessment: assessment
        }) }}"
        {% if assessment.isSpecification %}is-specification{% endif %}
    >
        <template #meta>
            <ul class="meta">
                {% include '@learning/fragments/meta/dueDate.twig' %}
                {% include '@learning/fragments/meta/workType.twig' %}
                {% if assessment.isImplementation %}
                    {% if readonly ?? false %}
                        <li><sbx-icon name="archive" color="var(--sbx-color-text-secondary)"></sbx-icon> {{ locale.term.proper }} has been archived</li>
                    {% endif %}
                {% endif %}
            </ul>
        </template>
    </dialog-agent-status>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/dialogAgentStatus.js?v={{ config.site_version }}"></script>
