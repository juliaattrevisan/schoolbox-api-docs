{# if submitted, try going to inline grader #}
{% set url     = null %}
{% set tooltip = null %}

{% set createSubmissionRoute = routeLookupIfAuthorized('learningAssessment.getCreateResponseForm', {
    assessmentId: currentInteraction.assessable.id,
    assessment: currentInteraction.assessable,
    studentId: participant.user.id,
    student: participant.user
}) %}

{% set responseRouteData = {
    assessmentId: currentInteraction.assessable.id,
    assessment:   currentInteraction.assessable,
    studentId:    participant.user.id,
    student:      participant.user,
    responseId:   currentInteraction.id,
    response:     currentInteraction
} %}

{% set viewSubmissionRoute = routeLookupIfAuthorized('learningDialogAgent.getParticularResponse', responseRouteData) %}

{% if createSubmissionRoute and currentInteraction.authoritative %}
    {# You only have access to the create route if this is the current auth response and it's a draft #}
    {% set icon = 'dialogAgent' %}
    {% set url = createSubmissionRoute %}
    {% set tooltip = 'Resume ' ~ locale.dialogAgent.proper %}
{% elseif viewSubmissionRoute %}
    {# If it's published, provide a link for teachers to view the submission in the inline grader #}
    {% set icon = 'eye' %}
    {% set url = viewSubmissionRoute %}
    {% set tooltip = 'View ' ~ locale.dialogAgent.proper %}
{% else %}
    {# Just link to participant's profile #}
    {% set icon = 'eye' %}
    {% set url = '/search/user/' ~ participant.user.id %}
    {% set tooltip = 'View Profile' %}
{% endif %}

{% set setAuthoritativeRoute = routeLookupIfAuthorized('learningDialogAgent.postSetAuthoritative', responseRouteData) %}

{# TODO: implement deleting a particular response #}
{% set deleteRoute = routeLookupIfAuthorized('learningDialogAgentResponse.deleteParticularResponse', responseRouteData) %}
<ul class="information-list threaded" data-test="assessment-submission-history-interaction-{{ currentInteraction.id }}">
    <li class="actions-small-1">
        <ul class="action-list">
            <li class="actions-small-1">
                <div class="list-item">
                    {# anything that isn't the authoritative response should also be styled as a draft to avoid confusion #}
                    <div class="card small-12 {% if not currentInteraction.isSubmitted or not currentInteraction.authoritative %}draftSubmission{% endif %}">
                        {% if url %}
                        <a href="{{ url }}" title="{{ tooltip }}">
                        {% endif %}
                            {% include 'include/portrait.twig' with {user: participant.user, description: participant.user.fullName} only %}
                            <p>
                                {% if currentInteraction.isSubmitted %}
                                    Response
                                {% else %}
                                    {% if currentInteraction.authoritative %}Current{% endif %}
                                    Draft Response
                                {% endif %}
                                by {{ participant.user.fullname }}
                            </p>
                            {% if currentInteraction.isSubmitted %}
                                <p class="meta">{{ currentInteraction.submittedAt.short }}</p>
                            {% else %}
                                <p class="meta">{{ currentInteraction.updatedAt.short }}</p>
                            {% endif %}
                        {% if url %}
                        </a>
                        {%  endif %}
                    </div>
                </div>

                {% if setAuthoritativeRoute or deleteRoute %}
                    <nav>
                        <sbx-pop-out content-id="response-options-{{ currentInteraction.id }}"></sbx-pop-out>
                    </nav>
                    <ul id="response-options-{{ currentInteraction.id }}" class="f-dropdown" data-dropdown-content>
                        {% if url %}
                            <li><a href="{{ url }}" class="icon-{{ icon }}" title="{{ tooltip }}">{{ tooltip }}</a></li>
                        {% endif %}

                        {% if setAuthoritativeRoute %}
                            <li>
                                <a
                                    href="{{ setAuthoritativeRoute }}"
                                    data-set-authoritative="{{ setAuthoritativeRoute}}"
                                    class="sbx-button--has-icon"
                                ><sbx-icon name="match"></sbx-icon>Set as Authoritative Response</a>
                            </li>
                        {% endif %}

                        {% if deleteRoute %}
                            <li><a href="{{ viewRoute }}"
                                class="sbx-button--has-icon"
                                   title="Delete response"
                                   data-delete="{{ deleteRoute }}"
                                   aria-label="Delete response">
                                <sbx-icon name="delete"></sbx-icon>
                                Delete
                            </a></li>
                        {% endif %}
                    </ul>
                {% endif %}
            </li>
        </ul>
    </li>
</ul>
