{##
 # Summary screen for Dialog Agent (Discussion) learning activities
 #
 # @param DialogAgent\Model $assessment   A Dialog Agent assessment instance (synonymous with Discussion)
 # @param \Schoolbox\User $student        The student who will be creating the response
 # @param Participant $participant        A participant instance for $student, if extant
 # @param Collection $breadcrumbs         A set of key-value tuples for breadcrumb rendering
 # @param array $lastViews                A struct that tells you when people last viewed this screen
 # @param string $returnUrl               A redirect destination
 # @param string $returnUrlEncoded        An encoded redirect destination so you can go back there
 # @param array $courseAssessments        A struct containing a set of assessments grouped by their units
 # @param bool $isInstructor              Whether the currently logged in guy is an instructor
 # @param IResponse $existingResponse     A response that can be resumed
 # @param array $button                   An array struct representing a call to action
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-2">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>

        {% include '@learningAssessment/meta.twig' with {
            assessment: assessment,
            submissionsBlocked: false,
            student: student,
            icon: 'icon-dialog-agent',
            canShowcase: false,
            isShowcased: false,
            participant: null,
            lastViews: lastViews
        } only %}
    </div>

    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}

    {% include '@learningAssessment/fragments/modifyTot.twig' with {
         assessment: assessment,
         gradeRoute: null,
         viewRoute: null,
         modifyRoute: modifyRoute,
         canShowcase: false,
         isShowcased: false,
         externalRedirectUrl: null
    } %}
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/dialogAgent/summary/description.twig' with {assessment: assessment, participant: participant} only %}
    </div>
</div>

{# Call To Action #}
<div class="row">
    <div class="small-12 columns">
        {# Calculate redirect querystring params, if extant #}
        {% set redirect = '' %}

        {% if returnUrlEncoded %}
            {% set redirect = '?' ~ RETURN_URL.name ~ '=' ~ returnUrlEncoded|escape('url')%}
        {% endif %}

        {# Only students and staffs get to see this button; parents and guests don't #}
        {% if assessment.isImplementation and (USER.role.isStudent or USER.role.isStaff) %}
            {% if button.url %}
                <a class="submit button"
                   href="{{ button.url }}{{ redirect }}"
                   data-test="assessment-summary-create-button"
                >{{ button.label }} {{ locale.dialogAgent }}</a>
            {% else %}
                <a class="submit button disabled"
                   href="#"
                   aria-disabled="true"
                   data-test="assessment-summary-create-button"
                >{{ button.label }} {{ locale.dialogAgent }}</a>
            {% endif %}
        {% endif %}
    </div>
</div>

{# Discussion History
 # This also includes the ability to declare an authoritative response
 #}
{% include '@learningAssessment/dialogAgent/history.twig' with {
    timeline: timeline ?? null
} %}