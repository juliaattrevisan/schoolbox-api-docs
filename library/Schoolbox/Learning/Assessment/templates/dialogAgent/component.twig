{% extends '@learningAssessment/component.twig' %}

{% set assessmentType = 'dialogAgent' %}
{% set icon = 'icon-dialog-agent' %}

{% block studentMessage %}
    There are no {{ locale.dialogAgent.plural }} to complete at this time.
{% endblock studentMessage %}

{% block teacherMessage %}
    {% if dialogAgentEnabled %}
        <a href="{{ createRouteType }}" data-test="component-dialogAgent-empty-create-button">
            Create {{ locale.dialogAgent.indefiniteArticle }} {{ locale.dialogAgent }}
        </a>
        that is not a part of your course to assess your students.
    {% else %}
        The {{ locale.dialogAgent.proper }} feature is currently disabled, please contact your admin to enable this feature.
    {% endif %}
{% endblock teacherMessage %}

{% block createButton %}
    {% if dialogAgentEnabled %}
        <a href="{{ createRouteType }}" class="button" data-test="component-dialogAgent-create-button">
            Create {{ locale.dialogAgent.proper }}
        </a>
    {% endif %}
{% endblock createButton %}
