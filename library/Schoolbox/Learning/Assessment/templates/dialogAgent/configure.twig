{##
 # Configure a Dialog Agent's settings
 #
 # @param Assessment\DialogAgent\Model  An assessment instance
 # @param array $scenario               Relevant info about the scenario
 # @param array $assessmentConfigInfo   Current configuration info for the assessment
 # @param array $helpfulnessOptions     A list of helpfulness options (value and label)
 # @param array $languageOptions        A list of language options
 #}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

{% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {
    assessmentId: assessment.id,
    assessment: assessment
}) %}

{% set updateRoute = routeLookupIfAuthorized(
    'learningDialogAgent.postUpdate',
    { assessmentId: assessment.id, assessment: assessment }
) %}

{% set generateFieldsRoute = routeLookupIfAuthorized(
    'learningDialogAgent.getGenerateConfigurationFields',
    { assessmentId: assessment.id, assessment: assessment }
) %}

<div id="dialog-agent-configure-container" data-test="dialog-agent-configure-container">
    <dialog-agent-configure
        :assessment-title="{{ assessment.title |json_encode }}"
        :scenario="{{ scenario |json_encode }}"
        :assessment-config="{{ assessmentConfig |json_encode }}"
        :helpfulness-options="{{ helpfulnessOptions |json_encode }}"
        :language-options="{{ languageOptions |json_encode }}"
        {% if config.differentiation_profiles_enabled ?? false %}differentiation-profiles-enabled{% endif %}
        {% if modifyRoute %}
            modify-route="{{ modifyRoute }}{% if RETURN_URL.previous.encoded %}?{{ RETURN_URL.name }}={{ RETURN_URL.previous.encoded }}{% endif %}"
        {% else %}
            :modify-route="null"
        {% endif %}
        post-update="{{ updateRoute }}"
        get-generate-fields="{{ generateFieldsRoute }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/dialogAgentConfigure.js?v={{ config.site_version }}"></script>
