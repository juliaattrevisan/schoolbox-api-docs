{# Renders a project status page for staff.
Data:
    'breadcrumbs'       string[][]
    'baseContext'       AssessmentContext
    'assessment'        IAssessable
    'assessmentStats'   Assessment\Statistics[] Indexed by assessment.id
    'aImpls'            [
        'assessment'       IAssessable
        'participantStats' ParticipantStatistics[] Indexed by user.id
    ][]
    'returnUrl'         string
#}

<script type="text/javascript">
    $(function() {
        // Setup sortable
        var assessmentList = $('#assessment-list');
        assessmentList.sortable({
            handle: '.grip',
            axis:   'y'
        })
                .on('sortstop', function() {
                    var sequence = [];
                    assessmentList.find('[data-assessment]').each(function(idx, elem){
                        sequence.push($(elem).attr('data-assessment'));
                    });
                    var data = {
                        id: sequence
                    };
                    $.post(assessmentList.attr('data-action'), data);
                });

        $('[data-delete]').click(function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                header: 'Are you sure you wish to delete this {{ locale.activity }}?',

                {# When you're managing activities in a Course Specification context
                 # there is nothing to delete like responses/feedback/marks, so just don't
                 # really show anything in particular in that case
                 #}
                {% if baseContext is not unitSpecification %}
                text: '<span class=\"alert alert-box\"><b>Warning:</b> All customisations, student responses, feedback and marks will also be deleted.</span>',
                {% else %}
                text: '',
                {% endif %}
                format: 'html',
                confirmLabel: 'Yes, permanently delete',
                cancelLabel: 'No, keep it',
                confirmEvent: function() {
                    var listItem = $(element).parents('[data-assessment]');

                    var assessmentId = $(element).attr('data-delete');
                    var assessmentList = $('#assessment-list');
                    var assessmentName = assessmentList
                            .find('[data-assessment='+assessmentId+']')
                            .attr('data-assessment-title');

                    {# Toast success and remove row from template #}

                    var toast = $('#assessment-toast');
                    toast.toastActivate({text: 'Deleting ' + assessmentName + '...'});

                    $.post($(element).attr('href'), {assessmentId: assessmentId})
                            .done(function() {
                                toast.toastTimeout({text: assessmentName + ' deleted.', css: 'success'});
                                listItem.fadeOut({
                                    done: function() {
                                        listItem.remove();

                                        {# Hide component actions and respawn empty state #}
                                        if (!assessmentList.find('li').length) {
                                            $('#assessment-actions').remove();
                                            $('#assessment-list-empty-state').removeClass('hide');
                                        }
                                    }
                                });
                            })
                            .fail(function() {
                                {# Toast alert #}
                                toast.toastTimeout({text: 'Could not delete ' + assessmentName, css: 'alert'});
                            });
                }
            });
        });
    });
</script>

{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learning/macro/urgency.twig' as urgency %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="list-item small-12 columns">
        <h1>{{ assessment.title }}</h1>
    </div>
    <nav>
        <a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id}) }}" class="icon-modify" title="Modify"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/project/summary/meta.twig' with {assessment: assessment} only %}
        {% include '@learningAssessment/project/summary/description.twig' with {assessment: assessment} only %}
    </div>
</div>

<div class="row">
    <div class="small-12 {% if aImpls | length %}large-6 {% endif %}island">
        <h2 class="subheader">{{ locale.activity.properPlural }}</h2>

        {% if assessment.assessables | length %}
            <section>
                <ul id='assessment-list' class="information-list sortable-card"
                    data-sortable
                    data-assessment-list
                    data-action="{{ routeLookup('learningAssessment.postReorderAssessments', {contextType: 'projects', contextId: assessment.id, context: assessment}) }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">
                    {% for assessable in assessment.assessables %}
                        {% set stats = assessmentStats[assessable.id] %}
                        {% if stats.countParticipants %}
                            {% set completionGradient = ( (stats.countParticipants - stats.countResponseRequired) / stats.countParticipants ) * 100 %}
                        {% endif %}

                        {% import '@learningAssessment/project/macro/icon.twig' as icon %}
                        {% set exportRoute = routeLookupIfAuthorized('learningAssessmentExporter.getExportFormForAssessment', {assessmentId: assessable.id, assessment: assessable}) %}
                        {% set statusRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessable.id, assessment: assessable}) %}
                        {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessable.id, assessment: assessable}) %}
                        {% if assessable is quiz %}
                            {% set viewRoute = (assessment.baseContext is unitSpecification) ? modifyRoute : routeLookupIfAuthorized('learningAssessment.getSummary', {assessmentId: assessable.id, assessment: assessable, studentId: USER.id, student: USER}) %}
                        {% else %}
                            {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {assessmentId: assessable.id, assessment: assessable, studentId: USER.id, student: USER}) %}
                        {% endif %}
                        {% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id, assessment: assessable}) %}
                        {% set hasActions = statusRoute or modifyRoute or deleteRoute %}
                        {% set similarityReportRoute = routeLookupIfAuthorized('learningAssessment.getSimilarityReport', {assessmentId: assessable.id, assessment: assessable}) %}
                        {% set worksheetClassView = routeLookupIfAuthorized('learningAssessment.getWorksheet', {assessmentId: assessable.id, assessment: assessable}) %}
                        {% set horizontalMarkingRoute = routeLookupIfAuthorized('learnosity.getHorizontalMarking', {assessment: assessable, assessmentId: assessable.id}) %}

                        <li data-assessment="{{ assessable.id }}" data-assessment-title="{{ assessable.title }}">
                            <div{% if hasActions %} class="actions-small-1"{% endif %}>
                                <div class="grip"></div>
                                <div class="list-item">
                                    <div class="compact card small-12 wrap-down">
                                        {% if viewRoute %}
                                        <a href="{{ viewRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">
                                        {% endif %}
                                        <span class="{{ icon.renderClass(assessable) }}" title="{{ assessable.getTypeName }}"></span>
                                        <p>{{ assessable.title }}</p>
                                        {% if viewRoute %}</a>{% endif %}

                                        {% if assessable.getDueAt %}
                                        <p class="meta">
                                            {{ dueDate.forAssessment(assessable) }}
                                            {% if assessable is not lessonPlan %}
                                                <span class="pipe meta"><span class="{{ urgency.marks(completionGradient ?? '') }}">{{ stats.countParticipants - stats.countResponseRequired }}/{{ stats.countParticipants }} students completed</span></span>
                                            {% endif %}
                                        </p>
                                        {% endif %}
                                    </div>
                                </div>
                                {% if hasActions %}
                                    <nav>
                                        <sbx-pop-out content-id="project-options{{ assessable.id }}"></sbx-pop-out>
                                    </nav>
                                    <ul data-dropdown-content class="f-dropdown" id="project-options{{ assessable.id }}">
                                        {% if statusRoute and assessable.isImplementation %}<li><a href="{{ statusRoute }}" class="icon-progress">View Status</a></li>{% endif %}
                                        {% if assessable is dueWork %}
                                            {% set viewGradeRoute = routeLookupIfAuthorized('learningDueWorkResponse.getFirstParticipantResponse', {
                                                assessmentId: assessable.id,
                                                assessment: assessable,
                                            }) %}
                                            {% if viewGradeRoute and assessable.isImplementation %}
                                                <li><a class="icon-task" href="{{ viewGradeRoute }}" >View and {{ locale.grades }} submissions</a></li>
                                            {% endif %}
                                        {% endif %}
                                        {% if assessable is dialogAgent %}
                                            {% set viewResponseRoute = routeLookupIfAuthorized('learningDialogAgent.getFirstParticipantResponse', {
                                                assessmentId: assessable.id,
                                                assessment: assessable,
                                            }) %}
                                            {% if viewResponseRoute %}
                                                <li><a class="icon-task" href="{{ viewResponseRoute }}">View Responses</a></li>
                                            {% endif %}
                                        {% endif %}
                                        {% set viewCustomParticipationRoute = routeLookupIfAuthorized('learningAssessment.getAssessmentParticipationForm', {
                                            assessmentId: assessable.id,
                                            assessment: assessable
                                        }) %}
                                        {% if viewCustomParticipationRoute %}
                                            <li><a class="icon-group" href="{{ viewCustomParticipationRoute }}">Student Participation</a></li>
                                        {% endif %}
                                        {% if assessable is dueWork and assessable.enableWorksheet and assessable.kamiWorksheetTemplate and worksheetClassView %}
                                            <li>
                                                <a id="kamiWorksheet" class="icon-surveys" href="{{ worksheetClassView }}">Class View</a>
                                            </li>
                                        {% endif %}
                                        {% if similarityReportRoute %}<li><a class="icon-due-work" href="{{ similarityReportRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Similarity Report</a></li>{% endif %}
                                        {% if exportRoute %}<li><a href="{{ exportRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-export">Export to Classes</a></li>{% endif %}

                                        {% if assessable is quiz %}
                                             {% if horizontalMarkingRoute %}
                                                <li><a class="icon-class-list" href="{{ horizontalMarkingRoute }}">Review horizontally</a></li>
                                            {% endif %}
                                        {% endif %}

                                        {% include '@learningAssessment/fragments/modifyLinks.twig' with {
                                            assessment: assessable,
                                            modifyRoute: modifyRoute,
                                            returnUrlName: RETURN_URL.name,
                                            returnUrl: RETURN_URL.current,
                                        } only %}

                                        {% if deleteRoute %}<li><a href="{{ deleteRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-delete" data-delete="{{ assessable.id }}" title="Delete this {{ locale.activity }}">Delete</a></li>{% endif %}
                                    </ul>
                                {% endif %}
                            </div>
                        </li>

                    {% endfor %}
                </ul>

                <div id="assessment-toast" class="toast"></div>

                <div id="assessment-actions" class="component-action">
                    <section>
                        <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'projects', contextId: assessment.id, context: assessment }) }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="button" title="Create a new {{ locale.activity }}">Create {{ locale.activity.proper }}</a>
                    </section>
                </div>
            </section>
        {% endif %}

        <div id='assessment-list-empty-state' class="empty-state {% if assessment.assessables|length %}hide{% endif %}">
            {% set createRoute = routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'projects', contextId: assessment.id, context: assessment }) %}
            <i class="icon-project"></i>
            <p>This {{ locale.project }} currently has no {{ locale.activity.plural }}.<br />To start assessing students you should <a data-test="project-create-activity-link" href="{{ createRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">create an {{ locale.activity }}</a> next.</p>
        </div>
    </div>
    {% if aImpls | length %}
    <div class="small-12 large-6 island">
        <h2 class="subheader">Students</h2>
        {% set showGroups = assessment.baseContext is unitSpecification %}

        {% for aImpl in aImpls %}
            {% if showGroups %}
            <div class="component-container">
                <div class="row">
                    <div class="small-12 columns">
                        <div class="component-titlebar">
                            <div class="actions-small-1">
                                <div class="list-item">
                                    <h2>
                                        <a href="/homepage/{{ aImpl.assessment.getBaseContext.getFolder.id }}">
                                            {{ aImpl.assessment.getBaseContext.getFolder.getTitle }}
                                        </a>
                                    </h2>
                                </div>
                                <nav>
                                    <a
                                        {% if showGroups %}
                                            data-data-loaded="false"
                                            data-click-load="{{ aImpl.assessment.id }}"
                                            data-class-status-href="{{ routeLookup('learningAssessment.getClassStatus', {assessmentId: assessment.id, assessment: assessment, courseAss: assessment, classAss: aImpl.assessment, classAssId: aImpl.assessment.id })}}"
                                        {% endif %}
                                        data-collapser="collap-{{ aImpl.assessment.id }}"
                                        href="#"
                                        class="icon-up-arrow collapse"
                                        title="Expand/collapse content"
                                    ></a>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}


            {% if showGroups %}
                <div id="class-{{ aImpl.assessment.id  }}">
                </div>
                </div>
            {% else %}
                {% include '@learningAssessment/project/status/class.twig' %}
            {% endif %}
        {% endfor %}

        {% if showGroups %}
            <script type="text/javascript">
                // when a user clicks the text in data-click-load
                // we should async fetch the participants and add it to the div
                $('[data-click-load]').click(function (event) {
                    // if data has been loaded, exit
                    if (event.target.dataset.dataLoaded === 'true') {
                        return;
                    }

                    // fetch the class status data
                    fetch(event.target.dataset.classStatusHref, { credentials: 'same-origin' })
                        .then(function(response) { return response.text(); })
                        .then(function(data) {
                            var el = document.getElementById('class-' + event.target.dataset.clickLoad);
                            if (el) { el.innerHTML = data; }
                        })
                        .catch(function() {
                        // failed to load class content
                    });

                    // update data attribute
                    event.target.dataset.dataLoaded = 'true';

                    // enable full collapsable on this class now
                    $(event.target).collapsable();
                });
            </script>
        {% endif %}
    </div>
    {% endif %}
</div>
<div class="row">
    <div class="small-12 column">
        {% if returnUrl %}
            <a href={{ returnUrl }} class="button submit">Return</a>
        {% elseif baseContext is unitSpecification %}
            <a href="{{ routeLookup('course.modifyCourse', {id: baseContext.course.id })}}#{{ baseContext.id }}" class="button submit">Return to course</a>
        {% else %}
            <a href="/homepage/{{ baseContext.folder.id }}" class="button submit">Return to homepage</a>
        {% endif %}
    </div>
</div>
