{#
    Displays a list of project meta.

    data:
        assessment  Project
        student     null|User   An optional project participant
        lastViews   null|array  An optional array of students and their parents last views for the assignment

#}
{% import '@learning/macro/dueDate.twig' as dueDate %}
<ul class="meta">
    {% include '@learning/fragments/meta/workType.twig' %}
    {% if assessment.baseContext is not unitSpecification %}
        <li><sbx-icon name="calendar"></sbx-icon> {{ dueDate.dueDate(assessment, student ?? USER) }}</li>
    {% endif %}
    {% if USER.role.isStaff %}
        <li><sbx-icon name="progress"></sbx-icon> Mark calculated as {{ assessment.summator.title }}</li>
    {% endif %}
    {% include '@learning/fragments/meta/curriculumCodes.twig' %}
    {# joining student name with lastView data #}
    {% if student is defined and student.id != USER.id %}
        <li title="{% if lastViews.student.date is defined and lastViews.student.date is not null %}{{ lastViews.student.date }}{% endif %}"><sbx-icon name="staff-students"></sbx-icon> <a href="/search/user/{{ student.id }}">{{ student.fullname }}</a>
            {% if lastViews is not empty %}
                {{ lastViews.student.status }}
                {% if 'assessment' is same as(lastViews.student.object) %} this {{ locale.activity }}{% else %} the feedback {% endif %}
            {% endif %}
        </li>
    {% endif %}

    {% if lastViews is defined and lastViews is not empty %}
        {% for parent in lastViews.parents %}
            {% if parent.date is not null %}
                <li title="{{ parent.date }}"><sbx-icon name="staff"></sbx-icon>
                    <a href="/search/user/{{ parent.id }}">{{ parent.name }}</a>
                    {{ parent.status }} {% if 'assessment' is same as(parent.object) %} this {{ locale.activity }}{% else %} the feedback {% endif %}
                </li>
            {% endif %}
        {% endfor %}
    {% endif %}
</ul>
