{#
    Displays a list of project meta.

    data:
        assessment  Project
        student     null|User   An optional project participant
        lastViews   null|array  An optional array of students and their parents last views for the assignment

#}
{% import '@learning/macro/dueDate.twig' as dueDate %}
<ul class="meta">
    {% if assessment.baseContext is not unitSpecification %}
        <li class="icon-calendar">{{ dueDate.dueDate(assessment, student ?? USER) }}</li>
    {% endif %}
    {% if USER.role.isStaff %}
        <li class="icon-progress">Mark calculated as {{ assessment.summator.title }}</li>

        {% if student is defined %}
            <li class="icon-staff-students">{{ student.fullname }}</li>
        {% endif %}
    {% endif %}
    {% if lastViews is defined and lastViews is not empty %}
        <li class="icon-staff-students" title="{% if lastViews.student.date is not null %}{{ lastViews.student.date }}{% endif %}">
            {{ lastViews.student.name }} {{ lastViews.student.status }}
            {% if 'assessment' is same as(lastViews.student.object) %} this {{ locale.assessment }}{% else %} the feedback {% endif %}
        </li>
        {% for parent in lastViews.parents %}
            {% if parent.date is not null %}
                <li class="icon-staff">
                    <span title="{{ parent.date }}">{{ parent.name }}</span>
                    {{ parent.status }} {% if 'assessment' is same as(parent.object) %} this {{ locale.assessment }}{% else %} the feedback {% endif %}
                </li>
            {% endif %}
        {% endfor %}
    {% endif %}
</ul>
