{#
    Displays a student's project participation.

    Usage:
            'breadcrumbs'   Collection|string[][]
            'student'       User
            'assessment'    Project
#}
{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learning/macro/urgency.twig' as urgency %}

{{ bread.crumbsArray(breadcrumbs) }}

{% set labelIncomplete = 'Incomplete' %}
{% set labelPending    = 'Self-Assessed' %}
{% set labelReviewed   = 'Teacher-Assessed' %}

{% set participant = assessment.participantIfExtant(student) %}

<script type="text/javascript" src="/javascript/shared/submissions/task/jquery.progressTickForm.js"></script>

{% autoescape 'js' %}
<script type="text/javascript">
    // Add previews
    $(function() {
        $('[data-plugin="preview"]').preview();

        // Save form for task completion
        $('form[data-progress-tick-form]').progressTickForm({
            disabledSelector: 'form:not([data-progress-tick-form="selfAssessed"])',
            label: $('[data-save-progress-state]'),
            transitions: {
                incomplete:      'selfAssessed',
                selfAssessed:    'incomplete',
                teacherAssessed: 'incomplete'
            },
            onChange: function(newTaskStatus) {
                // Update the light and the row's status
                var $row       = $(this).closest('[data-assessment]'),
                    $light     = $row.find('[data-assessment-status-light]'),
                    $text      = $row.find('[data-assessment-status-text]'),
                    newLabel   = '',
                    newClass   = '';

                switch (newTaskStatus) {
                    case 'incomplete':
                        newLabel = '{{ labelIncomplete }}';
                        newClass = '';
                        break;
                    case 'selfAssessed':
                        newLabel = '{{ labelPending }}';
                        newClass = 'pending';
                        break;
                    case 'teacherAssessed':
                        newLabel = '{{ labelReviewed }}';
                        newClass = 'reviewed';
                        break;
                }

                $light.removeClass('pending reviewed').addClass(newClass);
                $text.text(newLabel);
            }
        });
    });
</script>
{% endautoescape %}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-6 island">
        {% include '@learningAssessment/project/summary/meta.twig' with {assessment: assessment, student: student} only %}
    </div>
    <div class="small-6 island">

        {% if assessment.isFeedbackVisibleToUser(USER) and participant and assessment.humanReadableMark(participant, true) is not null %}
            <h2 class="subheader">{{ locale.project }} {{ locale.grades }}</h2>
            <section>
                <div class="grade content">
                    <span class="{{ urgency.marks(assessment.normalisedMark(participant, true)) }}">
                        {{ assessment.humanReadableMark(participant, true) }}
                    </span>
                </div>
            </section>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/project/summary/description.twig' with {assessment: assessment} only %}

        {% if assessment.assessables|length %}
            <h2 class="subheader">Activities</h2>
            <section>
                <ul class="information-list">
                    {% for assessable in assessment.assessables %}
                        {% include '@learningAssessment/fragments/card.twig' with {assessment: assessment, student: student, assessable: assessable, type: 'student'} %}
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-project"></i>
                <p>There are no {{ locale.assessment.plural }} in this {{ locale.project }} at the moment.</p>
            </div>
        {% endif %}
    </div>
</div>

<div class="toast" data-alert data-save-progress-state></div>
