{#
    Displays a student's project participation.

    Usage:
            'breadcrumbs'   Collection|string[][]
            'student'       User
            'assessment'    Project
#}
{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learning/macro/urgency.twig' as urgency %}

{{ bread.crumbsArray(breadcrumbs) }}

{% set labelIncomplete = 'Incomplete' %}
{% set labelPending    = 'Self-Assessed' %}
{% set labelReviewed   = 'Teacher-Assessed' %}

{% set participant = assessment.participantIfExtant(student) %}

{% set statusRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
{% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
{% set hasActions = statusRoute or modifyRoute %}


<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/task/jquery.progressTickForm.js?v={{ config.site_version }}"></script>

{% autoescape 'js' %}
<script type="text/javascript">
    // Add previews
    $(function() {
        $('[data-plugin="preview"]').preview();

        // Save form for task completion
        $('form[data-progress-tick-form]').progressTickForm({
            label: $('[data-save-progress-state]'),
            transitions: {
                incomplete:      '{{ transitions['incomplete'] }}',
                selfAssessed:    '{{ transitions['selfAssessed'] }}',
                teacherAssessed: '{{ transitions['teacherAssessed'] }}'
            },
            onChange: function(newTaskStatus) {
                // Update the light and the row's status
                var $row       = $(this).closest('[data-assessment]'),
                    $light     = $row.find('[data-assessment-status-light]'),
                    $text      = $row.find('[data-assessment-status-text]'),
                    newLabel   = '',
                    newClass   = '';

                switch (newTaskStatus) {
                    case 'incomplete':
                        newLabel = '{{ labelIncomplete }}';
                        newClass = '';
                        break;
                    case 'selfAssessed':
                        newLabel = '{{ labelPending }}';
                        newClass = 'pending';
                        break;
                    case 'teacherAssessed':
                        newLabel = '{{ labelReviewed }}';
                        newClass = 'reviewed';
                        break;
                }

                $light.removeClass('pending reviewed').addClass(newClass);
                $text.text(newLabel);
            }
        });
    });
</script>
{% endautoescape %}

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
    </div>
    {% if hasActions %}
        <nav>
            <nav><a href="#" class="icon-more" data-dropdown="project-options{{ assessment.id }}" aria-expanded="false" title="Actions"></a></nav>
        </nav>
        <ul data-dropdown-content class="f-dropdown" id="project-options{{ assessment.id }}">
            {% if statusRoute %}<li><a href="{{ statusRoute }}" class="icon-progress">View Status</a></li>{% endif %}
            {% if modifyRoute %}<li><a href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-modify">Modify</a></li>{% endif %}
        </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 medium-6 island">
        {% include '@learningAssessment/project/summary/meta.twig' with {assessment: assessment, student: student, lastViews: lastViews} only %}
    </div>
    <div class="small-12 medium-3 xlarge-2 right">

        {% if assessment.isFeedbackVisibleToUser(USER) and participant and assessment.humanReadableMark(participant, true) is not null %}
            <h2 class="subheader">{{ locale.project }} {{ locale.grades }}</h2>
            <section>
                <div class="grade {{ urgency.marks(assessment.normalisedMark(participant, true)) }}-bg text-center">
                    <span>{{ assessment.humanReadableMark(participant, true) }}</span>
                </div>
            </section>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/project/summary/description.twig' with {assessment: assessment} only %}

        {% if assessment.assessables|length %}
            <h2 class="subheader">Activities</h2>
            <section>
                <ul class="activity-list">
                    {% for assessable in assessment.assessables %}
                    <li>
                        {% include '@learningGrades/fragments/assessmentGrade.twig' with {
                            assessment:  assessable,
                            student:     student,
                        } only %}
                    </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-project"></i>
                <p>There are no {{ locale.assessment.plural }} in this {{ locale.project }} at the moment.</p>
            </div>
        {% endif %}
    </div>
</div>

<div class="toast" data-alert data-save-progress-state></div>
