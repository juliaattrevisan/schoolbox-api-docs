{#
    Displays a project's description if it is non-empty.

    data:
        'assessment'   Project
#}

{% if assessment.description | length %}
<section class="content">
    {% if routeLookupIfAuthorized('immersiveReader.getTokenAndSubdomain') %}
        <script src="{{ CDN_PREFIX }}/js/jquery.immersive-reader.js" type="text/javascript"></script>
        <script type="text/javascript">
            $(function () {
                $('[data-immersive-reader]').immersiveReader({title: '{{ assessment.title | escape('js') }}'});
            });
        </script>
        <div class='immersive-reader-button' id="ir-button" data-immersive-reader="button"></div>
    {% endif %}
    <article>
        {{ assessment.description | purify }}
    </article>
</section>
{% endif %}
