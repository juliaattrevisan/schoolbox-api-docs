{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function () {

        /* Description
         */
        document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
            detail: {
                maxCharCount: window.sbProps.MAX_BYTES_MYSQL_MEDIUMTEXT,
                targetElements: ['textarea[name="description"]'],
                fileBrowserCategoryId: {{ context.baseContext.folder.id ?? 0 }},
                {% if editorTemplates is defined %}
                    templates: {{ editorTemplates|json_encode|raw }},
                {% endif %}
            }
        }));
    });
</script>

<label for="title" class="required">Title</label>
<input type="text" name="title" id="title" data-test="assessment-form-input-title" value="{{ assessment.title }}" required maxlength="255"/>

{# ----------------------------------------------------------- #}
{# Work Type #}
{# ----------------------------------------------------------- #}
{% include '@learningAssessment/fragments/workTypeSelectorWithLabel.twig'
    with {
        allWorkTypes: allWorkTypes,
        assessment: assessment,
        courseManaged: courseManaged
    } only
%}

{% include '@learningAssessment/fragments/curriculumCodes.twig' with {
    entityType: locale.project.proper,
    excludeLegend: true,
    hasTabs: true,
    parentFolderId: parentFolderId ?? null,
} %}

<label for="description">Description</label>
<textarea id="description" name="description">{{ assessment.description }}</textarea>

{# ----------------------------------------------------------- #}
{# Assessment Location #}
{# ----------------------------------------------------------- #}
{% if canRelocate %}
    {% include '@learningAssessment/fragments/assessmentLocation.twig' %}
{% endif %}

{# ----------------------------------------------------------- #}
{# Grading #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>{{ locale.grading.proper }}</legend>

    {% include '@learningAssessment/fragments/weight.twig' %}

    {% import 'sub/visibility.twig' as visibility %}
    {{ visibility.dropdown(markVisibility, availableVisibilities) }}
</fieldset>

{% if context.baseContext is not unitSpecification %}
    {% include '@learningAssessment/fragments/dates.twig' %}
{% endif %}

<input type="hidden" name="assessmentType" value="{{ assessmentType }}" />

<div class="row">
    <div class="small-12 medium-6 columns">
        <label for="summatorSelect">Mark Summation Method</label>
        <div class="input-group">
            <select id="summatorSelect" name="summator">
                {% for index, title in allSummators.map %}
                    <option value="{{ index }}" {% if index == selectedSummator %}selected{% endif %}>{{ title }}</option>
                {% endfor %}
            </select>
            <a href="#" class="adtp-btn" data-reveal-id="reveal-summators-description">Describe Methods...</a>
        </div>
    </div>
    <div class="small-12 medium-6 columns">
        <label for="requireAllActivities">
            Require All {{ locale.activity.properPlural }}
            <span class="hint has-tip tip-top" title="If ON, the project will count unmarked {{ locale.activity.plural }} as having a score of zero. This is useful where a participant must complete all {{ locale.activity.plural }} within the project." data-tooltip>?</span>
        </label>
        <div class="switch">
            <input id="requireAllActivities"
                   name="requireAllActivities"
                   type="checkbox"
                    {{ (assessment.requireAllActivities ?? false) ? 'checked' : '' }}
                    {% if courseManaged.isReadonly %}
                        disabled
                    {% endif %}
            >
            <label for="requireAllActivities">
                <span>On</span>
                <span>Off</span>
            </label>
        </div>
    </div>
</div>

<div class="reveal-modal" data-reveal id="reveal-summators-description">
    <h2>Mark Summation</h2>
    <p>
        The project’s mark summation method determines how a student’s total mark is calculated.
    </p>
    <dl>
        <dt>{{ allSummators.map.weighted }}</dt>
        <dd>
            The grade given for the project will be based upon the weighting assigned to the learning {{ locale.activity.plural }} within the project.
        </dd>
        <dt>{{ allSummators.map.avg }}</dt>
        <dd>
            All graded learning {{ locale.activity.plural }} (weighted and unweighted) will contribute equally to the grade given for the project.
        </dd>
        <dt>{{ allSummators.map.max }}</dt>
        <dd>
            The highest grade given to a learning {{ locale.activity }} will be the grade given for the project.
        </dd>
        <dt>{{ allSummators.map.min }}</dt>
        <dd>
            The lowest grade given to a learning {{ locale.activity }} will be the grade given for the project.
        </dd>
    </dl>
    <h3>Require All {{ locale.activity.properPlural }}</h3>
    <p>
        This option changes how an unmarked {{ locale.activity }} for a participant contributes toward their total mark calculation:
    </p>
    <ul>
        <li>
            <strong>ON</strong>: Learning {{ locale.activity.plural }} (due work, quiz, tasks) that haven’t been submitted or graded will have a mark of zero.
            This is useful where a student must finish all {{ locale.activity.plural }} to complete the project.
            Custom participation and submission states can still be utilised to exclude students from parts of the project.
        </li>
        <li><strong>OFF</strong>: Learning {{ locale.activity.plural }} that haven’t been undertaken do not yet contribute to the project mark.</li>
    </ul>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

{% include '@learningAssessment/fragments/markType.twig' with {
    context: '',
    assessment: assessment,
    allMarkTypes: allMarkTypes,
    allGradeSchemes: allGradeSchemes,
    selectedMaxMark: assessment.maxMark ?? '',
    selectedMarkType: assessment.markType.id ?? '',
    selectedGradeGroup: assessment.gradeGroup.id ?? '',
    defaultGradeGroup: defaultGradeGroup,
    renderMaxMark: true,
    markTypeLabel: 'Mark Type',
} %}

{{ mage.submitRow(actionLabel ?? 'Create', 'part-2', 'end') }}
