{% macro renderClassForType(assessmentType) %}
    {# these are equivalent to assessment.getFamilyName() but you can't call that from twig #}
    {% if assessmentType == 'project' %}
        icon-project
    {% elseif assessmentType == 'task' %}
        icon-task
    {% elseif assessmentType == 'quiz' %}
        icon-quiz
    {% elseif assessmentType == 'dueWork' %}
        icon-due-work
    {% elseif assessmentType == 'lti' %}
        icon-lti
    {% elseif assessmentType == 'lessonPlan' %}
        icon-lesson-plan
    {% elseif assessmentType == 'dialogAgent' %}
        icon-dialog-agent
    {% elseif assessmentType == 'reporting' %}
        icon-reporting
    {% endif %}
{% endmacro %}

{# Render an icon corresponding to $assessment.
 #
 # Note that assessment.familiyName isn't always defined:
 # there's an arbitarily-constructed assessment in pendingAsssessmentsContext.twig which is used as a template
 # so it won't have a familyName (or many other presumed methods) making it totally alien to what you'd presume
 # to be a standard IAssessable instance.
#}
{% macro renderClass(assessment) %}
    {% apply spaceless %}
        {% if assessment and assessment.familyName is defined %}
            {{ _self.renderClassForType(assessment.familyName) }}
        {% endif %}
    {% endapply %}
{% endmacro %}
