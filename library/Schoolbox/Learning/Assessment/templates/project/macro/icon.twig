{% macro renderClass(assessment) %}
{% apply spaceless %}
    {% if assessment is project %}
        icon-project
    {% elseif assessment is task %}
        icon-task
    {% elseif assessment is quiz %}
        icon-quiz
    {% elseif assessment is dueWork %}
        icon-due-work
    {% elseif assessment is lti %}
        icon-lti
    {% elseif assessment is lessonPlan %}
        icon-lesson-plan
    {% endif %}
{% endapply %}
{% endmacro %}
