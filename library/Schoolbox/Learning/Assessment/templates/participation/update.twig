{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbsArray(breadcrumbs) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Student Participation - {{ assessment.title }}</h1>
        </div>
    </div>
</div>
<div id="custom-participation-container">
    {# getCreateAssessmentForm is shared among all learning activities, but for Reporting activities, there's special
     # treatment: despite the user having access to this form, they shouldn't be visiting getCreateAssessmentForm from
     # this particular means (Student Participation screen) which is annoyingly nuanced.
     #}
    {% set getAssessmentParticipationNewActivityRoute = null %}
    {% set postExistingCustomisationIncludeRoute = null %}

    {% if assessment is not reporting %}
        {% set getAssessmentParticipationNewActivityRoute = routeLookupIfAuthorized('learningAssessment.getCreateAssessmentForm', {
            contextType: contextType,
            contextId: assessment.context.id,
            context: assessment.context
        }) %}

        {% set postExistingCustomisationIncludeRoute = routeLookupIfAuthorized('learningAssessment.postExistingCustomisationInclude', {
            assessmentId: assessment.id,
            assessment: assessment,
            })
        %}
    {% endif %}

    <custom-participation
    :all-participants="{{ (allParticipants ?? []) | json_encode }}"
    :pastoral-enabled="Boolean({{ pastoralEnabled }})"
    :differentiation-enabled="Boolean({{ differentiationEnabled }})"
    :routes="{{ {
        getStudentsPastoralCountsUrl: routeLookup('pastoral.getStudentsCount'),
        getLearningPlanNewUrl: learningPlanNew,
        getAssessmentParticipationNewActivity: getAssessmentParticipationNewActivityRoute,
        getAssessmentParticipationCopyActivity: routeLookupIfAuthorized('learningAssessment.getCloneAssessmentForm', {
            assessmentId: assessment.id,
            assessment: assessment,
        }),
        includeInExistingCustomisation: postExistingCustomisationIncludeRoute,
        genAI: routeLookupIfAuthorized('openai.postLearningActivityCustomisation'),
    } | json_encode }}"
    :assessment-id="{{ assessment.id }}"
    assessment-type="{{ assessment.familyName }}"
    :customisations="{{ (customisations ?? []) | json_encode }}"
    :pastoral-config="{{ {
        pastoralPointEnabled: config.pastoral_point_enabled,
        pastoralActionEnable: config.pastoral_action_enable,
        pastoralSeverity: config.pastoral_severity,
    }|json_encode }}"
    :pastoral-routes="{{ {
        getStudentRecord: routeLookup('pastoral.getStudentRecord'),
        getReportTags: routeLookup('pastoralReportBuilder.getReportTags'),
    }|json_encode }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/customParticipation.js?v={{ config.site_version }}"></script>
