{% import "@learningAssessment/fragments/macro/date.twig" as dateForm %}
<script src="{{ CDN_PREFIX }}/js/bundle/mage.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/assessment/validationRules.js?v={{ config.site_version }}" data-locale-grading-proper="{{ locale.grading.proper }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/jquery-validation/dist/additional-methods.min.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
{#<script src="{{ CDN_PREFIX }}/js/assessment/participation.js?v={{ config.site_version }}"></script>#}

{#
# Modal for creating/modifying a custom learning plan on an assessment.
# This is split out into a separate file in order to include this outside of the main form (this contains a form).
#
# @param bool      $acceptingResponses     a boolean is this assessment something students will attempt
#}
<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>Modify Activity</h1>
    </div>
    <div class="row">
        <div class="small-12 columns island">
            <form method="post" id="participation-plan-form" class="mage">
                <section>
                    <fieldset class="content" data-mage>
                        <div class="small-12 columns">
                            <fieldset>
                                <label>
                                    Plan Name
                                    <input type="text" name="plan-name" id="plan-name" data-test="participation-plan-customise-modal-input-name" maxlength="256">
                                </label>
                            </fieldset>
                            <fieldset>
                                <legend>Custom Activity Details</legend>
                                <div class="row">
                                    <div class="columns small-12">
                                        <label>
                                            Description
                                            <textarea name="plan-desc" id="plan-desc"></textarea>
                                        </label>
                                    </div>
                                    <div class="columns small-12">
                                        {% set dummyDate = {local: ''} %}
                                        {% if acceptingResponses is defined and acceptingResponses %}
                                            {{ dateForm.dateField('Publish', 'planPublish', dummyDate, ''                , '#planOpenDate' ) }}
                                            {{ dateForm.dateField('Open'   , 'planOpen'   , dummyDate, '#planPublishDate', '#planDueDate'  ) }}
                                            {{ dateForm.dateField('Due'    , 'planDue'    , dummyDate, '#planOpenDate'   , '#planCloseDate') }}
                                            {{ dateForm.dateField('Late'   , 'planClose'  , dummyDate, '#planDueDate'    , ''              ) }}
                                        {% else %}
                                            {{ dateForm.dateField('Publish', 'planPublish', dummyDate, ''                , '#planDueDate'  ) }}
                                            {{ dateForm.dateField('Due'    , 'planDue'    , dummyDate, '#planPublishDate', ''              ) }}
                                        {% endif %}
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset>
                                <legend>Plan Participants</legend>
                                <label>
                                    <input type="text" name="plan-participants" id="plan-participants" placeholder="Search Students" data-selectizeuser>
                                </label>
                            </fieldset>
                            <input type="hidden" name="plan-id" id="plan-id">
                            <input type="submit" value="Update" data-test="participation-plan-form-button-save">
                        </div>

                    </fieldset>

                </section>
            </form>
        </div>
    </div>
</div>

<script>
    (function ($, window, document, undefined) {
        const $planParticipants = $("#plan-participants");
        $planParticipants.selectize({
            delimiter: ",",
            options: {{ participant | json_encode | raw }},
            dropdownParent: "body",
            plugins: ["remove_button"],
            create: false,
            hideSelected: true,
            createOnBlur: true,
            persist: false,
            searchField: "name",
            labelField: "name",
            valueField: "id",
        });
    })(jQuery, window, document)
</script>
