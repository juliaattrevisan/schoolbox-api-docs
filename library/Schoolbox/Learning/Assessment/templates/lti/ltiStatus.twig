{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbsArray(breadcrumbs) }}

<div class="row">
    <div class="small-12 island no-pad">
        {# Dynamically adjust iframe height based on the amount of height available: minimum 500px #}
        {% set iframeSrc = routeLookupIfAuthorized(
            'learningAssessment.getLaunchAssessmentAsInstructor',
            {
                assessment:   assessment,
                assessmentId: assessment.id,
            }
        ) %}
        {% if iframeSrc %}
            {% autoescape 'js' %}
            <script type="text/javascript">
                $(function () {
                    // How much space is left for the iframe?
                    let iframe        = document.getElementById('lti-iframe'),
                        iframeRect    = iframe.getBoundingClientRect(),
                        container     = document.getElementById('container'),
                        containerRect = container.getBoundingClientRect(),
                        iframeHeight  = containerRect.height - (iframeRect.top - containerRect.top);
                    iframe.style.height = String(iframeHeight) + 'px';
                    iframe.src          = '{{ iframeSrc }}?height=' + String(iframeHeight);
                });
            </script>
            {% endautoescape %}

            <iframe id="lti-iframe"  allow="autoplay; encrypted-media; fullscreen; camera *; microphone *; geolocation *; midi *; clipboard-write *; display-capture *; local-network-access *"></iframe>
        {% endif %}
    </div>
</div>
