{#  usage: per-participation, configure the following vars for the parent template to use
     - pActionResponses: a route to see the list of responses for this participation
     - pStatusText:      the description to output under the user's name
     - pStatusClass:     one of [ '', 'pending', 'complete' ] to denote the action status of this participation
     - pTooltip:         a tooltip explaining the status marker

    available varaibles:
     - routeArgs:        an array that represents a participant, to be pushed into a routeLookup
     - assessment:       the assessment we're looking at
     - participant:      the current participant of the iteration
     - statusIncomplete: a string representing the 'incomplete' state
     - statusPending:    a string representing the 'pending/attempted' state
     - statusReviewed:   a string representing the 'reviewed' state
     - writable:         bool   Whether current user has WRITE+ perm to the assessment's folder

#}
{% import '@learning/macro/urgency.twig' as urgency %}

{% extends '@learningAssessment/status.twig' %}

{% set labelIncomplete = 'Incomplete' %}
{% set labelPending    = 'Self-Assessed' %}
{% set labelReviewed   = 'Teacher-Assessed' %}

{% block headerOptions %}
    <li>
        {# Launch link depends on whether the tool opens in an iframe or not #}
        <a class="icon-lti"
           {% if assessment.ltiTool.isTargetWindow %}target="_blank"{% endif %}
           href="{{ routeLookupIfAuthorized(
               'learningAssessment.getLtiStatusLaunch',
               {
                   assessment:   assessment,
                   assessmentId: assessment.id,
               }
           ) }}">View in LTI Tool</a>
    </li>
{% endblock %}

{% block participant %}
    {% set latestFeedback    = participant.findMostRecentInstructorGivenFeedback %}
    {% set latestResponse    = participant.findMostRecentSubmittedResponse %}
    {% set multipleResponses = participant.allResponses | length > 1 %}

    {% set isPublished  = latestFeedback and latestFeedback.published %}
    {% set canPublish   = latestFeedback and not isPublished %}

    {% set pStatusClass   = participant.responseRequired ? statusIncomplete : (participant.feedbackRequired ? statusPending : statusReviewed) %}
    {% set pTooltip       = participant.responseRequired ? labelIncomplete : (participant.feedbackRequired ? labelPending : labelReviewed) %}
    {% set pStatusText    = pTooltip %}
    {% set pActionSummary = routeLookupIfAuthorized('learningAssessment.getSummary', routeArgs) %}

    <li data-status="{{ pStatusClass }}" data-participant-name="{{ participant.user.fullName }}">
        <div class="small-12 columns">
            <div class="row actions-small-1">
                <div class="flex-grade list-item">
                    {% include '@learningAssessment/fragments/lti/participantStatus.twig' with {
                        participant: participant,
                        statusClass: pStatusClass,
                        statusText:  pStatusText,
                        statusTip:   pTooltip,
                        routeArgs:   routeArgs,
                    } only %}

                    {% if (latestFeedback.humanReadableMark ?? null) is not null %}
                        {% set urgencyClass = latestFeedback ? urgency.marks(latestFeedback.normalisedMark) : '' %}
                        <div class="grade {{ urgencyClass }}-bg">
                            <span>{{ latestFeedback.humanReadableMark ?? ''}}</span>
                        </div>
                    {% endif %}
                </div>

                {% set createAttemptIdBase = "createAttempt-" ~ participant.user.id %}
                <nav>
                    <a class="icon-more" title="" data-dropdown="feedbackOptions-{{ participant.user.id }}"></a>
                </nav>

                <ul id="feedbackOptions-{{ participant.user.id }}" class="f-dropdown" data-dropdown-content>
                    {%- apply spaceless %}
                        {% if pActionSummary %}
                            <li><a class="icon-history" href="{{ pActionSummary }}" title="View {{ participant.user.firstName }}'s attempt history">View Attempt History</a></li>
                        {% endif %}
                        <li><a href="#" data-reveal-id="{{ createAttemptIdBase }}" class="icon-due-work" title="Create score for {{ participant.user.firstName }}">Create Score...</a></li>
                    {% endapply -%}
                </ul>
            </div>
        </div>

        <div id="{{ createAttemptIdBase }}" class="reveal-modal" data-reveal aria-hidden="true" role="dialog">
            <h2>Create score for {{ participant.user.fullname }}</h2>
            <div data-alert="" class="alert-box highlight">
                This form is for testing only: this may not exist in the final product.
            </div>
            <form action="{{ routeLookup(
                'learningAssessment.postCreateResponse',
                {assessmentId: participant.assessable.id, studentId: participant.user.id })
            }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" method="post">
                <div class="row">
                    <div class="small-12 columns">
                        <label for="{{ createAttemptIdBase }}-markingUser">
                            Marking User
                            <span data-tooltip
                                  class="has-tip tip-top hint"
                                  title="Which user marked the participant with this score? (3rd party assessments may not be able to determine who marked a student, thus the Anonymous option.)">?</span>
                        </label>
                        <select id="{{ createAttemptIdBase }}-markingUser" name="markingUser">
                            <option value="">Anonymous</option>
                            <option value="{{ participant.user.id }}">Participant ({{ participant.user.fullname }})</option>
                            <option value="{{ USER.id }}">Current User ({{ USER.fullname }})</option>
                        </select>
                    </div>
                    <div class="small-6 columns">
                        <label class="checkbox-label" for="{{ createAttemptIdBase }}-isResponse">
                            Response
                            <span data-tooltip
                                  class="has-tip tip-top hint"
                                  title="If checked, this score will be created as a response by the participant.">?</span>
                        </label>
                        <div class="switch">
                            <input id="{{ createAttemptIdBase }}-isResponse" name="isResponse" type="checkbox" value="1">
                            <label for="{{ createAttemptIdBase }}-isResponse">
                                <span class="icon-approve"></span>
                                <span class="icon-cancel"></span>
                            </label>
                        </div>
                    </div>
                    <div class="small-6 columns">
                        <label class="checkbox-label" for="{{ createAttemptIdBase }}-isFeedback">
                            Feedback
                            <span data-tooltip
                                  class="has-tip tip-top hint"
                                  title="If checked, this score will be created as a feedback for the participant.">?</span>
                        </label>
                        <div class="switch">
                            <input id="{{ createAttemptIdBase }}-isFeedback" name="isFeedback" type="checkbox" value="1">
                            <label for="{{ createAttemptIdBase }}-isFeedback">
                                <span class="icon-approve"></span>
                                <span class="icon-cancel"></span>
                            </label>
                        </div>
                    </div>
                    <div class="small-6 columns">
                        <label for="{{ createAttemptIdBase }}-scoreGiven">Score Given</label>
                        <input id="{{ createAttemptIdBase }}-scoreGiven" name="scoreGiven" type="text" inputmode="numeric"/>
                    </div>
                    <div class="small-6 columns">
                        <label for="{{ createAttemptIdBase }}-scoreMaximum">Score Maximum</label>
                        <input id="{{ createAttemptIdBase }}-scoreMaximum" name="scoreMaximum" type="text" inputmode="numeric" value="{{ participant.assessable.scoreMaximum ?? '' }}" />
                    </div>
                    <div class="small-12 columns">
                        <label for="{{ createAttemptIdBase }}-comment">Comment</label>
                        <textarea id="{{ createAttemptIdBase }}-comment" name="comment" rows="5"></textarea>
                    </div>
                </div>

                <input type="submit" value="Create Score" />
            </form>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </div>
    </li>
{% endblock %}
