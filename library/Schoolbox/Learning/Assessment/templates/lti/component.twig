{% extends '@learningAssessment/component.twig' %}

{% set assessmentType = 'lti' %}
{% set icon = 'icon-lti' %}

{% block studentMessage %}
    There are no LTI assessments to complete at this time.
{% endblock studentMessage %}

{% block teacherMessage %}
    {% if config.lti_assessments_enable %}
        <a href="{{ createRouteType }}">Create an LTI
            assessment</a> that is not a part of your course to assess your students.
    {% else %}
        There are no LTI assessments.
    {% endif %}
{% endblock teacherMessage %}

{% block createButton %}
    {% if config.lti_assessments_enable %}
        <a href="{{ createRouteType }}" class="button">Create LTI assessment</a>
    {% endif %}
{% endblock createButton %}
