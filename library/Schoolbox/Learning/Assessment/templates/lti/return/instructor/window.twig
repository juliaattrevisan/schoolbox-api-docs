{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbsArray(breadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>{{ assessment.title }} &ndash; Marking Complete</h1>
        {% if errorMessage %}
            <div data-alert="" class="alert-box alert">
                {{ errorMessage }}
                <a href="#" class="close">×</a>
            </div>
        {% elseif message %}
            <div data-alert="" class="alert-box success">
                {{ message }}
                <a href="#" class="close">×</a>
            </div>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <p>You may now either return to the status page, or close this tab.</p>
        </section>
        <ul class="flex-list buttons">
            <li><a class="submit" href="{{ returnUrl }}">Return</a></li>
            <li><a data-action="close" href="#">Close</a></li>
        </ul>
    </div>
</div>

<script type="text/javascript">
    document.addEventListener(
        'DOMContentLoaded',
        function () {
            document.querySelectorAll('a[data-action=close]').forEach(
                (link) => link.addEventListener('click', (event) => {
                    event.preventDefault();
                    window.close();
                })
            )
        }
    )
</script>
