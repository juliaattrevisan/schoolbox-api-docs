{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbsArray(breadcrumbs) }}

<div class="row">
    <div class="small-12">
        <h1>{{ assessment.title }} &ndash; Marking Complete</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <p>You will soon automatically return to the status page.</p>
            <p>If you are not automatically returned, <a target="_parent" href="{{ returnUrl }}">click here</a>.</p>
        </section>
    </div>
</div>

{% autoescape 'js' %}
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', () => window.parent.location.href = '{{ returnUrl }}')
    </script>
{% endautoescape %}
