{% extends 'include/styledIframe.twig' %}

{% block title %}
    {{ assessment.title }} &ndash; Marking Complete
{% endblock title %}

{% block content %}
    <div class="row">
        <div class="small-12 island">
            <section class="content">
                <p>You may now return to the status page.</p>
            </section>
            <ul class="flex-list buttons">
                <li><a class="submit" target="_parent" href="{{ returnUrl }}">Return</a></li>
            </ul>
        </div>
    </div>

    {% autoescape 'js' %}
        <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', () => window.parent.location.href = '{{ returnUrl }}')
        </script>
    {% endautoescape %}
{% endblock content %}
