{% extends 'include/styledIframe.twig' %}

{% block title %}
    {{ assessment.title }} &ndash; Attempt Complete
{% endblock title %}

{% block content %}
    <div class="row">
        <div class="small-12 island">
            <h1>{{ assessment.title }} &ndash; Attempt Complete</h1>
            {% if errorMessage %}
                <div data-alert="" class="alert-box alert">
                    {{ errorMessage }}
                </div>
            {% elseif message %}
                <div data-alert="" class="alert-box success">
                    {{ message }}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="row">
        <div class="small-12 island">
            <section class="content">
                <p>You may now return to the class page.</p>
            </section>
            <ul class="flex-list buttons">
                <li><a class="submit" target="_parent" href="{{ returnUrl }}">Return</a></li>
            </ul>
        </div>
    </div>
{% endblock content %}
