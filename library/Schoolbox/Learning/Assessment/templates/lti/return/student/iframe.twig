        <div class="small-12 island">
            <section class="content">
                <p>To return to the activity page, <a target="_parent" href="{{ returnUrl }}">click here</a>.</p>
            </section>
        </div>
    </div>

    {% include '@learningAssessment/lti/return/fragments/redirect.twig' with {returnUrl: returnUrl} only %}
{% endblock content %}
