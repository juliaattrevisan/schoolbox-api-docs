{% extends 'include/styledIframe.twig' %}

{% block title %}
    {{ assessment.title }} &ndash; Attempt Complete
{% endblock title %}

{% block content %}
    <div class="row">
        <div class="small-12 island">
            <section class="content">
                <p>You will soon automatically return to the activity page.</p>
                <p>If you are not automatically returned, <a target="_parent" href="{{ returnUrl }}">click here</a>.</p>
            </section>
        </div>
    </div>

    {% autoescape 'js' %}
        <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', () => window.parent.location.href = '{{ returnUrl }}')
        </script>
    {% endautoescape %}
{% endblock content %}
