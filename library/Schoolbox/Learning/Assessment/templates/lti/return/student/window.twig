{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbsArray(breadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <p>You may now either return to the class page, or close this tab.</p>
        </section>
        <ul class="flex-list buttons">
            <li><a class="submit" target="_parent" href="{{ returnUrl }}">Return</a></li>
        </ul>
    </div>
</div>

{% autoescape 'js' %}
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', () => window.parent.location.href = '{{ returnUrl }}')
    </script>
{% endautoescape %}
