{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbsArray(breadcrumbs) }}

<div class="row">
    <div class="small-12">
        <h1>{{ assessment.title }} &ndash; Attempt Complete</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="small-12 island">
            <section class="content">
                <p>You will soon automatically return to the activity page.</p>
                <p id="redirect-prompt" class="hide">If you are not automatically returned, <a target="_parent" href="{{ returnUrl }}">click here</a>.</p>
            </section>
        </div>
    </div>
</div>

{% include '@learningAssessment/lti/return/fragments/redirect.twig' with {returnUrl: returnUrl} only %}
