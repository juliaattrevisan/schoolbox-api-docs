{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

<input type="hidden" name="assessmentType" value="{{ assessmentType }}" />

<fieldset>
    {# ----------------------------------------------------------- #}
    {# Title #}
    {# ----------------------------------------------------------- #}
    <label class="required" for="title">Title</label>
    <input type="text" name="title" id="title" value="{{ assessment.title }}" required maxlength="255"/>



    {# ----------------------------------------------------------- #}
    {# Work Type #}
    {# ----------------------------------------------------------- #}
    <label>
        Work Type
        <select name="workType">
            <option value="" selected>None</option>
            {% for workType in allWorkTypes %}
                <option value="{{ workType.id }}" {% if (assessment.workType.id ?? '') == workType.id %}selected="selected"{% endif %}>{{ workType.name }}</option>
            {% endfor %}
        </select>
    </label>


    {# ----------------------------------------------------------- #}
    {# Description #}
    {# ----------------------------------------------------------- #}
    <label>
        Description
        <textarea name="description" id="assessment-description">{{ assessment.description }}</textarea>
    </label>


    {# ----------------------------------------------------------- #}
    {# Assessment URL #}
    {# ----------------------------------------------------------- #}
    <label for="lti-assessment-url" class="required">
        Assessment URL
    </label>

    {% if not assessment.ltiAssessmentUrl %}
        <div class="empty-state">
            <i class="icon-lti"></i>
            {% if ltiTools is empty %}
                <p>No providers which support selection of assessments have been configured. Please contact your system administrator.</p>
            {% else %}
                <p>Select a third party embedded learning tool to select an assessment from.</p>
                <p>
                    {% for tool in ltiTools %}
                        <button data-tool="{{ tool.id }}"
                                data-tool-selector-url="{{ routeLookup('ltiPlatform.getGenerateDeepLinkingRequest', {toolId: tool.id}) }}"
                        >{{ tool.name }}</button>
                    {% endfor %}
                </p>

                <div id="toolModal" class="reveal-modal" data-reveal aria-hidden="true" role="dialog">
                    <iframe id="toolModalIframe" height="1000"></iframe>
                    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
                </div>

                {% autoescape 'js' %}
                    <script type="text/javascript">
                        $(function () {
                            let $toolModal        = $('#toolModal'),
                                $toolModalIframe  = $toolModal.find('#toolModalIframe'),
                                $ltiAssessmentUrl = $('#lti-assessment-url');
                            $('[data-tool]').click(function (event) {
                                event.preventDefault();
                                let $this          = $(this),
                                    messageHandler = (event) => {
                                        // Fill in the form with values from the message data
                                        let data = JSON.parse(event.data);
                                        $ltiAssessmentUrl.val(data.url);
                                        $toolModal.foundation('reveal', 'close');
                                    }

                                // On open of this modal:
                                // * point the iframe to the place which sends messages
                                // * listen for messages
                                // On close:
                                // * point the iframe nowhere
                                // * stop listening (so that message listeners for other things work)
                                $toolModal.on('open.fndtn.reveal', function () {
                                    $toolModalIframe.attr('src', $this.attr('data-tool-selector-url'));
                                    window.addEventListener('message', messageHandler);
                                });
                                $toolModal.on('close.fndtn.reveal', function () {
                                    $toolModalIframe.removeAttr('src');
                                    window.removeEventListener('message', messageHandler);
                                });

                                // And open the modal
                                $toolModal.foundation('reveal', 'open');
                            })
                        });
                    </script>
                {% endautoescape %}
            {% endif %}
        </div>
    {% endif %}
    <input readonly
           required
           id="lti-assessment-url"
           name="ltiAssessmentUrl"
           type="text"
           maxlength="2048"
           value="{{ assessment.ltiAssessmentUrl }}">


    {# ----------------------------------------------------------- #}
    {# Assessment Location #}
    {# ----------------------------------------------------------- #}
    {% if canRelocate %}
        {% include '@learningAssessment/fragments/assessmentLocation.twig' %}
    {% endif %}

    {# Enforce Safe Exam Browser #}
    {% include '@learningAssessment/fragments/sebSwitch.twig' with {assessment: assessment} only %}
</fieldset>


{# ----------------------------------------------------------- #}
{# Dates #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification %}
    {% include '@learningAssessment/fragments/dates.twig' %}
{% endif %}


{# ----------------------------------------------------------- #}
{# Default Activity Duration #}
{# ----------------------------------------------------------- #}
{% include '@learningAssessment/fragments/default_open_span.twig' with {assessment: assessment} only %}


{# ----------------------------------------------------------- #}
{# Grading #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>{{ locale.grading.proper }}</legend>

    {% include '@learningAssessment/fragments/weight.twig' with {
        assessment: assessment,
    } only %}
</fieldset>


{# ----------------------------------------------------------- #}
{# Participation #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification and custom_assessment_participation %}
    {% include '@learningAssessment/fragments/participation.twig' %}
{% endif %}


{# ----------------------------------------------------------- #}
{# Curriculum #}
{# ----------------------------------------------------------- #}
{% include '@learningAssessment/fragments/curriculumCodes.twig' with {
    entityType: locale.dueWork.proper,
    courseManagedReadonly: courseManaged.isReadonly
} %}


{# ----------------------------------------------------------- #}
{# Submit #}
{# ----------------------------------------------------------- #}
{{ mage.submitRow(actionLabel ?? 'Create', 'part-2', 'end') }}


{# ----------------------------------------------------------- #}
{# Scripts #}
{# ----------------------------------------------------------- #}
<script src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script>
    $(function () {
        // Init CKEditor
        $.fn.alaressEditor();
    });
</script>
