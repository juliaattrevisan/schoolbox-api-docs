{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

<input type="hidden" name="assessmentType" value="{{ assessmentType }}" />

<fieldset>
    {# ----------------------------------------------------------- #}
    {# Title #}
    {# ----------------------------------------------------------- #}
    <label class="required" for="title">Title</label>
    <input type="text" name="title" id="title" value="{{ assessment.title }}" required maxlength="255"/>



    {# ----------------------------------------------------------- #}
    {# Work Type #}
    {# ----------------------------------------------------------- #}
    <label>
        Work Type
        <select name="workType">
            <option value="" selected>None</option>
            {% for workType in allWorkTypes %}
                <option value="{{ workType.id }}" {% if (assessment.workType.id ?? '') == workType.id %}selected="selected"{% endif %}>{{ workType.name }}</option>
            {% endfor %}
        </select>
    </label>


    {# ----------------------------------------------------------- #}
    {# Description #}
    {# ----------------------------------------------------------- #}
    <label>
        Description
        <textarea name="description" id="assessment-description">{{ assessment.description }}</textarea>
    </label>


    {# ----------------------------------------------------------- #}
    {# Learning Tool #}
    {# ----------------------------------------------------------- #}
    <label for="lti-tool-id" class="required">
        Learning Tool
    </label>

    {# LTI tool picker: if no assessment has been selected #}
    <div id="ltiToolPicker" class="{{ assessment.ltiAssessmentUrl is not empty ? 'hide' : '' }}">
        {% if ltiTools is empty %}
            <input type="hidden" id="lti-tool-id" name="ltiToolId" value="{{ assessment.ltiTool.id ?? '' }}" />
            <div class="empty-state">
                <i class="icon-lti"></i>
                <p>No providers which support selection of assessments have been configured. Please contact your system administrator.</p>
            </div>
        {% else %}
            <select id="lti-tool-id" name="ltiToolId">
                <option value="">-- Select a Learning Tool Provider</option>
                {% for tool in ltiTools %}
                    <option value="{{ tool.id }}"
                            label="{{ tool.name }}"
                            data-tool-selector-url="{{ routeLookup('ltiPlatform.getGenerateDeepLinkingRequest', {toolId: tool.id}) }}">{{ tool.name }}</option>
                {% endfor %}
            </select>
            <a href="#" data-action="selectTool" class="button">Launch Picker</a>
        {% endif %}
    </div>

    {# LTI assessment URL, if it has been selected #}
    <div id="ltiAssessment" class="{{ assessment.ltiAssessmentUrl is empty ? 'hide' : '' }}">
        <h3 id="ltiAssessmentTitleDisplay">{{ assessment.ltiAssessmentTitle ?? '' }}</h3>
        <div id="ltiAssessmentTextDisplay">{{ (assessment.ltiAssessmentText ?? '') | nl2br }}</div>
    </div>

    <div id="toolModal" class="reveal-modal" data-reveal aria-hidden="true" role="dialog">
        <iframe id="toolModalIframe" height="1000"></iframe>
        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>

    <div id="resourceLinkMissingUrlModal" class="reveal-modal" data-reveal aria-hidden="true" role="dialog">
        <h2>The selected resource does not have a URL</h2>
        <p>This means that it cannot be used in an LTI assessment.</p>
        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>

    <div id="resourceLinkMissingLineItemModal" class="reveal-modal" data-reveal aria-hidden="true" role="dialog">
        <h2>The selected resource does not seem to be an assessment</h2>
        <p>It can still be used in an LTI assessment, but grades will not be synced into Schoolbox.</p>
        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>

    {% autoescape 'js' %}
        <script type="text/javascript">
            $(function () {
                let $toolModal       = $('#toolModal'),
                    $toolIdSelector  = $('#lti-tool-id'),
                    $toolModalIframe = $toolModal.find('#toolModalIframe');
                $('[data-action="selectTool"]').click(function (event) {
                    event.preventDefault();
                    let $this          = $(this),
                        messageHandler = (event) => {
                            // Fill in the form with values from the message data
                            let data         = JSON.parse(event.data),
                                tool         = data?.tool,
                                resourceLink = data?.resourceLinks?.[0];

                            // // Set the tool which was used to select the item
                            // // TODO figure out if optional chaining is supported in all targeted browsers
                            // $('#lti-tool-id').val(tool?.id);

                            // Look at the first resource link, set values based on that
                            if (resourceLink) {
                                let url = resourceLink?.url;
                                if (url) {
                                    $('#lti-assessment-url').val(resourceLink?.url);
                                    $('#custom-fields').val(JSON.stringify(resourceLink?.custom ?? {}));
                                    let lineItem = resourceLink?.lineItem;
                                    if (lineItem?.resourceId) {
                                        // This resource link has a line item, and a resource ID?
                                        // Close the modal
                                        $('#line-item-score-maximum').val(lineItem?.scoreMaximum);
                                        $('#line-item-resource-id').val(lineItem?.resourceId);
                                        $toolModal.foundation('reveal', 'close');
                                    } else {
                                        // Raise some warning that this isn't an assessment, and thus can't be graded.
                                        // I guess still let it be used though.
                                        $('#resourceLinkMissingLineItemModal').foundation('reveal', 'open');
                                    }
                                } else {
                                    // Raise some warning about what was selected not having a URL.
                                    // This should never happen, because the resource link must have a URL.
                                    $('#resourceLinkMissingUrlModal').foundation('reveal', 'open');
                                }
                            } else {
                                // Nothing was selected: just close the modal
                                $toolModal.foundation('reveal', 'close');
                            }
                        }

                    // On open of this modal:
                    // * point the iframe to the place which sends messages
                    // * listen for messages
                    // On close:
                    // * point the iframe nowhere
                    // * stop listening (so that message listeners for other things work)
                    $toolModal.on('open.fndtn.reveal', function () {
                        $toolModalIframe.attr('src', $toolIdSelector.find(':selected').attr('data-tool-selector-url'));
                        window.addEventListener('message', messageHandler);
                    });
                    $toolModal.on('close.fndtn.reveal', function () {
                        $toolModalIframe.removeAttr('src');
                        window.removeEventListener('message', messageHandler);
                    });

                    // And open the modal
                    $toolModal.foundation('reveal', 'open');
                })
            });
        </script>
    {% endautoescape %}

    {# LTI assessment URL + required hidden fields #}
    <input readonly
           required
           id="lti-assessment-url"
           name="ltiAssessmentUrl"
           type="text"
           maxlength="2048"
           value="{{ assessment.ltiAssessmentUrl }}">
    <input type="hidden" id="lti-assessment-title" name="ltiAssessmentTitle" value="{{ assessment.ltiAssessmentTitle ?? '' }}" />
    <input type="hidden" id="lti-assessment-text" name="ltiAssessmentText" value="{{ assessment.ltiAssessmentText ?? '' }}" />
{#    <input type="hidden" id="lti-tool-id" name="ltiToolId" value="{{ assessment.ltiTool.id ?? '' }}" />#}
    <input type="hidden" id="custom-fields" name="customFields" value="{{ (assessment.customFields ?? {}) | json_encode }}" />
    <input type="hidden" id="line-item-score-maximum" name="lineItemScoreMaximum" value="{{ assessment.lineItemScoreMaximum ?? '' }}" />
    <input type="hidden" id="line-item-resource-id" name="lineItemResourceId" value="{{ assessment.lineItemResourceId ?? '' }}" />


    {# ----------------------------------------------------------- #}
    {# Assessment Location #}
    {# ----------------------------------------------------------- #}
    {% if canRelocate %}
        {% include '@learningAssessment/fragments/assessmentLocation.twig' %}
    {% endif %}

    {# Enforce Safe Exam Browser #}
    {% include '@learningAssessment/fragments/sebSwitch.twig' with {assessment: assessment} only %}
</fieldset>


{# ----------------------------------------------------------- #}
{# Dates #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification %}
    {% include '@learningAssessment/fragments/dates.twig' %}
{% endif %}


{# ----------------------------------------------------------- #}
{# Default Activity Duration #}
{# ----------------------------------------------------------- #}
{% include '@learningAssessment/fragments/default_open_span.twig' with {assessment: assessment} only %}


{# ----------------------------------------------------------- #}
{# Grading #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>{{ locale.grading.proper }}</legend>

    {% include '@learningAssessment/fragments/weight.twig' with {
        assessment: assessment,
    } only %}
</fieldset>


{# ----------------------------------------------------------- #}
{# Participation #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification and custom_assessment_participation %}
    {% include '@learningAssessment/fragments/participation.twig' %}
{% endif %}


{# ----------------------------------------------------------- #}
{# Curriculum #}
{# ----------------------------------------------------------- #}
{% include '@learningAssessment/fragments/curriculumCodes.twig' with {
    entityType: locale.dueWork.proper,
    courseManagedReadonly: courseManaged.isReadonly
} %}


{# ----------------------------------------------------------- #}
{# Submit #}
{# ----------------------------------------------------------- #}
{{ mage.submitRow(actionLabel ?? 'Create', 'part-2', 'end') }}


{# ----------------------------------------------------------- #}
{# Scripts #}
{# ----------------------------------------------------------- #}
<script src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script>
    $(function () {
        // Init CKEditor
        $.fn.alaressEditor();
    });
</script>
