{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/submitRow.twig' as mage %}

{{ bread.crumbs(
    [ folder.name, '/homepage/' ~ folder.id ],
    [ 'Create Assessment', routeLookup('learningAssessment.getSelectAssessment') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>Create Assessment in {{ project.title }}</h1>
        {{ debugReturnUrl }}
    </div>
</div>

<div class="row">
    <div class="small-12 columns island">
        <form action="{{ routeLookup('learningAssessment.postCreateAssessmentWithinProject', {assessmentId: project.id}) }}" method="post">
            <input type="hidden" name="projectId" value="{{ project.id }}" />
            <input type="hidden" name="type" value="{{ assessmentType }}" />
            <input type="hidden" name="returnUrl" value="{{ returnUrl }}" />

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        {% if assessmentType == 'dueWork' %}
                            {% include '@learningAssessment/fragments/dueWork/create.twig' %}
                        {% elseif assessmentType == 'task' %}
                            {% include '@learningAssessment/fragments/task/create.twig' %}
                        {% elseif assessmentType == 'quiz' %}
                            {% include '@learningAssessment/fragments/quiz/create.twig' %}
                        {% endif %}
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>