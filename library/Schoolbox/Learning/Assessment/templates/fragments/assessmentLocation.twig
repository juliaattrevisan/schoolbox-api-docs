{% autoescape 'js' %}
    <script type="text/javascript">
        $(function () {
            let $locationReveal = $('#reveal-location');
            $('#change-location').on('click', function (e) {
                e.preventDefault();
                $.post('{{ routeLookup('learningAssessment.getLocationForm', {assessment: assessment, assessmentId: assessment.id}) }}')
                        .done(function (response) {
                            $('#target-list').html(response);
                            $locationReveal.foundation('reveal', 'open');
                        })
            })
            $locationReveal.on('click', '[data-submit]', function (e) {
                e.preventDefault();
                $(this).text('Working...');
                $(this).attr('readonly', 'readonly')
                let jstree = $('#location-tree').jstree();
                let selected = jstree.get_selected(true);
                if (selected.length !== 1 || selected[0]['id'] === 'undefined') {
                    return;
                }
                $('#locationTitle').val(selected[0]['data']['title']);
                $('#locationId').val(selected[0]['id']);
                $locationReveal.foundation('reveal', 'close');
            });
            $locationReveal.on('click', '[data-cancel]', function (e) {
                e.preventDefault();
                $(this).foundation('reveal', 'close');
            });
        });
    </script>
{% endautoescape %}
<div class="row">
    <div class="small-12 columns">
        <label>{{ locale.assessment.proper }} Location</label>
        <div class="input-group">
            <input type="hidden" id="locationId" name="locationId" value="{{ assessment.context.locationId }}">
            <input id="locationTitle" name="locationTitle" type="text" value="{{ assessment.context.locationTitle }}"
                   class="valid"
                   aria-invalid="false" readonly="readonly">
            <a class="adtp-btn" data-adtp-btn="" id="change-location">Change Location</a>
        </div>
    </div>
</div>

<div class="reveal-modal" data-reveal id="reveal-location">
    <h2>Change Location</h2>
    <div id="target-list"></div>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    <div data-overlay class="wait-overlay hide">
        <p>
            Working...
            <span class="loader"></span>
        </p>
    </div>
</div>
