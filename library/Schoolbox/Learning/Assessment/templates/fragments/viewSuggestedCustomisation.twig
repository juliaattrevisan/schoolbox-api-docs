{#
  To display a button to generate/view suggested customisation for an assessment customisation when there is only one participant.
  Otherwise we just show the 'Description' label as usual

  Usage:
    participants            array        the participants for whom the customisation is being created/modified
    differentiationEnabled  boolean      whether differentiation is enabled
    assessment              object       (optional) the original assessment object
    assessmentId            integer      the original assessment id (0 if none)
    editorId                string       the id of the description editor to link to
    isQuiz                  boolean      (optional) whether the assessment is a quiz (default: false)
    isRequired              boolean      (optional) whether the description is required (default: false)
#}

{% set isValidAssessmentType = assessment is defined and assessment.familyName is defined and (assessment.familyName == 'dueWork' or assessment.familyName == 'task') %}
{# Only show generate/view suggested customisation button if there is one participant when creating/modifying a customisation #}
{% set showSuggestedCustomisation = assessmentId != 0 and participants ?? [] is not empty and participants|length == 1 and isValidAssessmentType %}
<div class="u-flex-row u-flex--justify-space u-flex--align-end {% if showSuggestedCustomisation %}u-mar-xs--bottom{% endif %}">
    <label for="{{ editorId }}" class="{% if isRequired is defined and isRequired %}required{% endif %}">
        Description
         {% if isQuiz is defined %}<span class="hint has-tip tip-top" data-tooltip title="This content will be shown to users before they begin to attempt the quiz.">?</span>{% endif %}
    </label>
    {% if showSuggestedCustomisation %}
    <div id="view-suggested-customisation-container">
        <view-suggested-customisation
            :differentiation-enabled="Boolean({{ differentiationEnabled }})"
            :participant="{{ participants[0] | json_encode }}"
            :routes="{{ {
                genAI: routeLookupIfAuthorized('openai.postLearningActivityCustomisation'),
            } | json_encode }}"
            :assessment-id="{{ assessmentId }}"
            editor-id="{{ editorId }}"
        />
    </div>
    <script src="{{ CDN_PREFIX }}/js/bundle/viewSuggestedCustomisation.js?v={{ config.site_version }}"></script>
    {% endif %}
</div>
