{% if assessable.isParticipant(student) %}
    {% set participant       = assessable.getParticipant(student) %}
    {% set latestFeedback    = participant.findMostRecentFeedback %}
    {% set latestResponse    = participant.findMostRecentSubmittedResponse %}
    {% set multipleResponses = participant.allResponses | length > 1 %}

    {% set isPublished  = latestFeedback.published %}
    {% set canPublish   = latestFeedback and not isPublished %}

        {% if assessment.acceptsNone %}
            {% set pStatusClass = '' %}
            {% set pTooltip     = '' %}
        {% else %}

            {% set pStatusClass = participant.isResponseRequired ? 'incomplete' : (participant.isFeedbackRequired ? 'pending' : 'reviewed') %}
            {% set pTooltip     = participant.isResponseRequired ? 'Submission Required' : (participant.isFeedbackRequired ? 'Mark required' : 'Reviewed') %}

        {% set pStatusText %}
            {%- spaceless %}
                {% if not latestResponse %}
                    Not submitted
                {% else %}

                    {% if assessable is task %}
                        {% if not latestResponse.isMarkedComplete %}
                            Incomplete
                        {% elseif latestResponse.isSelfAssessed %}
                            Self-Assessed
                        {% else %}
                            Teacher-Assessed
                        {% endif %}
                    {% else %}
                        {% if multipleResponses %}
                            Resubmitted
                        {% else %}
                            Submitted
                        {% endif %}
                        {% if latestResponse.submittedOnTime %}
                            on time
                        {% else %}
                            late
                        {% endif %}
                    {% endif %}
                {% endif %}
            {% endspaceless -%}
        {% endset %}
    {%  endif %}

    <span class="progress-tick no-text tiny {{ pStatusClass }}" title="{{ pTooltip }}"></span> {{ pStatusText }}

{% endif %}
