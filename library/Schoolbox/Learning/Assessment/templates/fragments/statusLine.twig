{% set participant = assessable.getParticipantIfExtant(student) %}
{% if participant %}
<div class="assess-status">
    {% set pStatusText %}
        {%- spaceless %}
            {% if participant.responseRequired %}
                {% set pStatusClass = 'incomplete' %}
                {% set pTooltip = 'Submission Required' %}
                {% if assessable is task %}
                    Incomplete
                {% elseif assessable is quiz %}
                    Not attempted
                {% else %}
                    Not submitted
                {% endif %}
            {% elseif participant.feedbackRequired %}
                {% set pStatusClass = 'pending' %}
                {% set pTooltip = 'Mark required' %}
                {% set latestResponse    = participant.findMostRecentSubmittedResponse %}
                {% set multipleResponses = participant.allResponses | length > 1 %}
                {% if assessable is task %}
                    Self-Assessed
                {% elseif assessable is quiz %}
                    {% if multipleResponses %}
                        Reattempted
                    {% else %}
                        Attempted
                    {% endif %}
                {% else %}
                    {% if multipleResponses %}
                        Resubmitted
                    {% else %}
                        Submitted
                    {% endif %}
                {% endif %}
                {% if assessable is not project %}
                    {% if latestResponse.submittedOnTime %}
                        on time
                    {% else %}
                        late
                    {% endif %}
                {% endif %}
            {% elseif participant.resubmissionRequired %}
                {% set pStatusClass = 'failed' %}
                {% set pTooltip = 'Resubmission Required' %}
                Resubmission Required
            {% else %}
                {# implicitly 'ReviewComplete' state if not 'ResponseRequired' or 'FeedbackRequired' #}
                {% set pStatusClass = 'reviewed' %}
                {% set pTooltip = 'Reviewed' %}
                {% if assessable is task %}
                    Teacher-Assessed
                {% else %}
                    Reviewed
                {% endif %}
            {% endif %}
        {% endspaceless -%}
    {% endset %}

    <span data-status
          data-assessment-status-light
          class="progress-tick no-text tiny {{ pStatusClass }}" title="{{ pTooltip }}"></span>
    <span data-status-label
          data-assessment-status-text>{{ pStatusText }}</span>
</div>
{% endif %}
