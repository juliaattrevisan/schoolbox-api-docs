<div id='location-tree' class="content">
    {% for unit in units %}
        <ul>
            <li id='{{ unit.locationId }}' data-title='{{ unit.locationTitle }}' class='' data-jstree='{"type":"unit"}'>
                {{ unit.title }}
                <ul>
                    {% for project in unitProjects[unit.id] %}
                        <li id="{{ project.locationId }}" data-title='{{ project.locationTitle }}' class=""
                            data-jstree='{"type":"project"}'>
                            {{ project.title }}
                        </li>
                    {% endfor %}
                </ul>
            </li>
        </ul>
    {% endfor %}
</div>
<div class="ctrl component-action">
    <section>
        <a role="button" data-submit class="button" href="#">Change Location</a>
        <a role="button" data-cancel class="button cancel" href="#" aria-label="Close">Cancel</a>
    </section>
</div>
<link rel="stylesheet" href="{{ CDN_PREFIX }}/js/vendors/jstree/dist/themes/default/style.css"/>
<script>
    const script = document.createElement('script');
    script.onload = () => {
        $("#location-tree")
            .on('ready.jstree', function (event, jstree) {
                $(this).jstree('open_all');
                $(this).jstree('select_node', '{{ current }}');
            })
            .jstree({
                core: {
                    animation: 0,
                    force_text: true,
                    check_callback: true,
                    multiple: false,
                    "themes": {
                        "variant": "schoolbox",
                        "dots": false,
                        "icons": true
                    }
                },
                plugins: ['types', 'wholerow'],
                types: {
                    unit: {
                        icon: 'icon-unit'
                    },
                    project: {
                        icon: 'icon-project'
                    }
                }
            });
    }
    script.src = '{{ CDN_PREFIX }}/js/vendors/jstree/dist/jstree.min.js';
    document.head.appendChild(script);
</script>
