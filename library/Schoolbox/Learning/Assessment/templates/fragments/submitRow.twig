{% macro submitRow(inputValue, inputName, mageNext, mageWorking) %}
{% spaceless %}
<div class="column small-12">
    <div class="row" data-mage-submitrow>
        <div class="small-12 medium-8 column">
            <p class="alert alert-box icon-alert" data-mage-error></p>
        </div>
        <div class="small-12 medium-4 column">
            <input type="submit"
                    {% if inputName != '' %}name="{{ inputName }}"{% endif %}
                    {% if mageNext != '' %}data-mage-next="{{ mageNext }}"{% endif %}
                    {% if mageWorking != '' %}data-mage-working="{{ mageWorking }}"{% endif %}
                   value="{{ inputValue }}" />
        </div>
    </div>
</div>
{% endspaceless %}
{% endmacro %}