{##
 # Curriculum Code Selectize
 #
 # @param bool $courseManagedReadonly
 #}
{% set entityType = entityType ?: 'Folder' %}
{% if config.curriculum_tagging_enabled %}
    <fieldset>
        <legend>Curriculum</legend>
        <div class="row">
            <div class="small-12 columns">
                <div class="c-form-element">
                    <label class="c-label">Curriculum Codes</label>
                    <div class="c-hint">Link this {{ entityType }} with a corresponding curriculum code, you can link multiple curriculum codes to this {{ entityType }}</div>
                        {% include 'sub/curriculumCodeSelector.twig' with {
                            'codeList': curriculumNodes,
                            'renderButton': true,
                            courseManagedReadonly: courseManagedReadonly ?? false
                        } %}
                </div>
            </div>
        </div>
    </fieldset>
{% endif %}
