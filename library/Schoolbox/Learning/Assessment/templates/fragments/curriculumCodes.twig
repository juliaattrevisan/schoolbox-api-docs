{##
 # Curriculum Code Selectize
 #
 # @param bool $courseManagedReadonly
 # @param ?bool $excludeLegend - Whether the legend should be excluded (defaults to false)
 # @param ?bool $vueSlot - Whether this is being rendered as a vue slot, (defaults to false)
 #                         if so, the relevant createApp() must have CurriculumSelector included as an available component
 #                         Otherwise, this will render it as an independent vue app
 # @param bool $hasTabs - Whether the curriculum code selector should have tabs
 # @param int|null $parentFolderId - The folder ID to use for the current curriculum selector tab to display nodes linked to the relevant course/unit folder
 #}
{% set entityType = entityType ?: 'Folder' %}
{% set excludeLegend = excludeLegend ?? false %}
{% set vueSlot = vueSlot ?? false %}

{% if config.curriculum_tagging_enabled %}
    {% if not excludeLegend ?? false %}
        <fieldset>
            <legend>Curriculum</legend>
    {% endif %}
        <div class="row">
            <div class="small-12 columns">
                <label>Curriculum Codes
                    <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Link this {{ entityType }} with a corresponding curriculum code, you can link multiple curriculum codes to this {{ entityType }}">?</span>
                </label>
                    {% include 'sub/curriculumCodeSelector.twig' with {
                        'codeList': curriculumNodes,
                        'renderButton': true,
                        'vueSlot': vueSlot,
                        courseManagedReadonly: courseManagedReadonly ?? false,
                        hasTabs: hasTabs ?? false,
                        parentFolderId: parentFolderId ?? null,
                    } %}
            </div>
        </div>
    {% if not excludeLegend ?? false %}
        </fieldset>
    {% endif %}
{% endif %}
