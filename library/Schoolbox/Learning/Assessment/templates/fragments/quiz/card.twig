{% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}

<li class="actions-small-1">
    <div class="list-item">
        <div class="card wrap-down small-12">
            <div class="{{ icon.renderClass(assessable) }} size-64" title="{{ assessable.getTypeName }}"></div>
            <a href="{{ routeLookup('learningAssessment.getAssessment', {assessmentId: assessable.id}) }}">
                <h3 data-assessment-title>
                    {{ assessable.title }}
                </h3>
            </a>
            <p class="meta" title="{{ assessable.getDueAt.getLocal }}">
                Due {{ assessable.getDueAt.getRelativeTime }}
            </p>
            <p class="meta"><a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: assessable.id, studentId: student.id})}}" class="meta">{% include '@learningAssessment/fragments/statusLine.twig' with {assessable: assessable} %}</a></p>
        </div>
    </div>

</li>

