{% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}
{% import '@learning/macro/dueDate.twig' as dueDate %}

<li class="actions-small-1">
    <div class="list-item">
        <div class="card wrap-down small-12">
            <div class="{{ icon.renderClass(assessable) }}" title="{{ assessable.getTypeName }}"></div>
            {% if student %}
                {% set route = routeLookupIfAuthorized('learningAssessment.getSummary',{assessmentId: assessable.id, studentId: student.id, student: student, assessment: assessable}) %}
            {% else %}
                {% set route = routeLookupIfAuthorized('learningAssessment.getPreview',{assessmentId: assessable.id, assessment: assessable}) %}
            {% endif %}

            {% if route %}
                <a href="{{ route }}">
                    <h3 data-assessment-title>{{ assessable.title }}</h3>
                </a>
            {% else %}
                <h3 data-assessment-title>{{ assessable.title }}</h3>
            {% endif %}

            {% if student %}
                <p class="meta"><a href="{% if route %}{{ route }}{% else %}#{% endif %}">{% include '@learningAssessment/fragments/statusLine.twig' with {assessable: assessable} %}</a></p>
            {% endif %}
        </div>
    </div>
</li>

