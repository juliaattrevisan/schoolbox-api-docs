{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/jquery.sync-dates.js"></script>
<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker-sync.js"></script>
<script type="text/javascript">
    $(function () {

        /* Description
         */
        $.fn.alaressEditor();
    });
</script>

<label>
    Title
    <input type="text" name="title" value="{{ assessment.title }}" required />
</label>

<label>
    Description
    <textarea name="description">{{ assessment.description }}</textarea>
</label>

<label>
    Weight
    <input type="number" name="weight" value="{{ assessment.weight }}">
</label>

{% import 'sub/visibility.twig' as visibility %}
{{ visibility.dropdown(assessment.markVisibility) }}

{% include '@learningAssessment/fragments/curriculumCodes.twig' %}
{% if context.baseContext is not unitSpecification %}
    {% include '@learningAssessment/fragments/dates.twig' %}
{% endif %}
<input type="hidden" name="assessmentType" value="{{ assessmentType }}" />

<label>
    Max Attempts
    {% set maxAttempts = 10 %}

    <select name="maxAttempts">

        {% for i in 0..maxAttempts %}
        {% if i == assessment.maxAttempts %}
            {% set selected = 'selected' %}
        {% else %}
            {% set selected = '' %}
        {% endif %}

        {% if i == 0 %}
            <option value="{{ i }}" {{ selected }}>Unlimited</option>
        {% else %}
            <option value="{{ i }}" {{ selected }}>{{ i }}</option>
        {% endif %}
        {% endfor %}

    </select>
</label>

<script type="text/javascript">
    $(function() {
        var $durationPanel = $('#durationPanel');
        var $durationInputs = $durationPanel.find('input[type=text]');

        $('#hasDuration').on('click', function(event) {
            var $checkbox = $(this);
            if ($checkbox.is(':checked')) {
                $('#durationPanel').stop().hide().removeClass('hide').slideDown(600);
                $durationInputs.prop('disabled', false);
            }
            else {
                /* Hide panel + disable inputs
                 */
                $durationPanel.stop().slideUp(600);
                $durationInputs.prop('disabled', true);
            }
        });
    });
</script>

{% if context.baseContext is unitSpecification %}
    <label>
        Activity Duration
        <span class="hint has-tip tip-top" data-tooltip title="Enter the number of days you expect the activity to take. This will be used to automatically populate due dates when importing this course.">?</span>
        <input type="number" name="default_open_span" value="{{ assessment.defaultOpenSpan }}">
    </label>
{% endif %}

<div class="row">
    <div class="small-12 columns">
        <label for="hasDuration">Duration <span class="hint has-tip tip-top" data-tooltip title="After starting a quiz, students will have this much time to complete it. Switch off for no limit.">?</span></label>
        <div class="switch round">
            <input name="hasDuration" id="hasDuration" type="checkbox" {% if assessment.duration != -1 %}checked="checked"{% endif %} />
            <label for="hasDuration">
                <span class="icon-approve"></span>
                <span class="icon-cancel"></span>
            </label>
        </div>
    </div>
</div>

<div class="row {% if assessment.duration == -1 %}hide{% endif %}" id="durationPanel">
    <div class="small-12 columns no-pad">
        <div class="small-12 medium-6 columns">
            <label>Hours
                <input name='durationHours' type="text" value="{% if assessment.duration != -1 %}{{ assessment.durationComponents.hours }}{% endif %}" />
            </label>
        </div>
        <div class="small-12 medium-6 columns">
            <label>Minutes
                <input name='durationMinutes' type="text" value="{% if assessment.duration != -1 %}{{ assessment.durationComponents.minutes }}{% endif %}" />
            </label>
        </div>
    </div>
</div>

{{ mage.submitRow(actionLabel ?: 'Create', 'part-2', 'end') }}
