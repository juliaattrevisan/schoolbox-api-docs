<div class="small-12 columns">
    <label>Max Attempts
        {% set maxAttempts = 10 %}
        <select name="max-attempts" id="max-attempts">

            {% for i in 0..maxAttempts %}
            {% if i == 0 %}
                <option value="{{ i }}">Unlimited</option>
            {% else %}
                <option value="{{ i }}">{{ i }}</option>
            {% endif %}
            {% endfor %}

        </select>
    </label>
</div>
<div class="small-4 columns">
    <label for="duration">Duration</label>
    <div class="switch round">
        <input id="duration" type="checkbox" checked data-checkbox-group="duration" />
        <label for="duration">
            <span class="icon-approve"></span>
            <span class="icon-cancel"></span>
        </label>
    </div>
</div>
<div class="small-4 columns">
    <label>Hours
        <input type="text" placeholder="Duration Hours">
    </label>
</div>
<div class="small-4 columns">
    <label>Minutes
        <input type="text" placeholder="Duration Minutes">
    </label>
</div>
