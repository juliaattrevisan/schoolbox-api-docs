{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript">
    $(function () {

        /* Description
         */
        $.fn.alaressEditor();
    });
</script>

<label>
    Title
    <input type="text" name="title" value="{{ assessment.title }}" required />
</label>

<label>
    Description
    <textarea name="description">{{ assessment.description }}</textarea>
</label>

<label>
    Weight
    <input type="number" name="weight" value="{{ assessment.weight }}">
</label>

{% import 'sub/visibility.twig' as visibility %}
{{ visibility.dropdown(assessment.visibility) }}

{% include '@learningAssessment/fragments/curriculumCodes.twig' %}
{% include '@learningAssessment/fragments/dates.twig' %}

<input type="hidden" name="assessmentType" value="{{ assessmentType }}" />

<label>
    Max Attempts
    {% set maxAttempts = 10 %}

    <select name="maxAttempts">

        {% for i in 0..maxAttempts %}
        {% if i == assessment.maxAttempts %}
            {% set selected = 'selected' %}
        {% else %}
            {% set selected = '' %}
        {% endif %}

        {% if i == 0 %}
            <option value="{{ i }}" {{ selected }}>Unlimited</option>
        {% else %}
            <option value="{{ i }}" {{ selected }}>{{ i }}</option>
        {% endif %}
        {% endfor %}

    </select>
</label>

<script type="text/javascript">
    $(function() {
        $('#hasDuration').on('click', function(event) {
            if ($(this).is(':checked')) {
                $('#durationPanel').stop().hide().removeClass('hide').slideDown(600);
            }
            else {

                /* Empty values and hide
                 */
                $('#durationPanel').stop().slideUp(600, function() {
                    $(this).find('input[name=durationHours]').val('');
                    $(this).find('input[name=durationMinutes]').val('');
                    $(this).addClass('hide');
                });
            }
        });
    });
</script>
<div class="row">
    <div class="small-12 columns">
        <label for="hasDuration">Duration</label>
        <div class="switch round">
            <input name="hasDuration" id="hasDuration" type="checkbox" {% if assessment.durationComponents.hours or assessment.durationComponents.minutes %}checked="checked"{% endif %} />
            <label for="hasDuration">
                <span class="icon-approve"></span>
                <span class="icon-cancel"></span>
            </label>
        </div>
    </div>
</div>

<div class="row {% if not assessment.durationComponents.hours and not assessment.durationComponents.minutes %}hide{% endif %}" id="durationPanel">
    <div class="small-12 columns no-pad">
        <div class="small-12 medium-6 columns">
            <label>Hours
                <input name='durationHours' type="text" value="{{ assessment.durationComponents.hours }}" />
            </label>
        </div>
        <div class="small-12 medium-6 columns">
            <label>Minutes
                <input name='durationMinutes' type="text" value="{{ assessment.durationComponents.minutes }}" />
            </label>
        </div>
    </div>
</div>

{{ mage.submitRow('Next', 'part-2', 'end', 'Working...') }}