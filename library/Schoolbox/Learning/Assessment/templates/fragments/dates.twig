{% if acceptingResponses %}
    {% set publishEndSelector = 'input[name="openDate"]' %}
    {% set dueEndSelector = 'input[name="closeDate"]' %}
{% else %}
    {% set publishEndSelector = 'input[name="dueDate"]' %}
    {% set dueEndSelector = '' %}
{% endif %}

{{ dateForm.dateField('Publish', 'publish', assessment.publishAt, publishEndSelector) }}

{% if acceptingResponses %}
{{ dateForm.dateField('Open', 'open', assessment.openAt, 'input[name="dueDate"]') }}
{% endif %}

{{ dateForm.dateField('Due', 'due', assessment.dueAt, dueEndSelector) }}

{% if acceptingResponses %}
{{ dateForm.dateField('Late', 'close', assessment.closeAt) }}
{% endif %}