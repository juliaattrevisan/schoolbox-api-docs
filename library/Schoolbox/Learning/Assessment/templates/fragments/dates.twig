{% import "@learningAssessment/fragments/macro/date.twig" as dateForm %}

{% if acceptingResponses %}
    {{ dateForm.dateField('Publish', 'publish', assessment.publishAt, '',             '#openDate') }}
    {{ dateForm.dateField('Open',    'open',    assessment.openAt,    '#publishDate', '#dueDate') }}
    {{ dateForm.dateField('Due',     'due',     assessment.dueAt,     '#openDate',    '#closeDate') }}
    {{ dateForm.dateField('Late',    'close',   assessment.closeAt,   '#dueDate',     '') }}
{% else %}
    {{ dateForm.dateField('Publish', 'publish', assessment.publishAt, '',             '#dueDate') }}
    {{ dateForm.dateField('Due',     'due',     assessment.dueAt,     '#publishDate', '') }}
{% endif %}
