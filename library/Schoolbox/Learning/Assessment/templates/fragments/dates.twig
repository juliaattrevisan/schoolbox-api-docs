{% import "@learningAssessment/fragments/macro/date.twig" as dateForm %}
<script type="text/javascript" charset="utf-8" src="/javascript/components/jquery-timepicker-jt/jquery.timepicker.min.js"></script>
<script type="text/javascript">
    $(function () {

        /* Datepickers
         */
        $('[data-datepicker]').datepicker();
        $('[data-timepicker]').timepicker({
            appendTo: function ($input) {
                return $input.closest('.timepick');
            }
        });
    });
</script>

{% if acceptingResponses %}
    {% set publishEndSelector = 'input[name="openDate"]' %}
    {% set dueEndSelector = 'input[name="closeDate"]' %}
{% else %}
    {% set publishEndSelector = 'input[name="dueDate"]' %}
    {% set dueEndSelector = '' %}
{% endif %}

{{ dateForm.dateField('publish', assessment.publishAt, publishEndSelector) }}

{% if acceptingResponses %}
{{ dateForm.dateField('open', assessment.openAt, 'input[name="dueDate"]') }}
{% endif %}

{{ dateForm.dateField('due', assessment.dueAt, dueEndSelector) }}

{% if acceptingResponses %}
{{ dateForm.dateField('close', assessment.closeAt) }}
{% endif %}