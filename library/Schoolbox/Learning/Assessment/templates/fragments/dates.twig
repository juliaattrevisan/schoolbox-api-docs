<script type="text/javascript" charset="utf-8" src="/javascript/components/jquery-timepicker-jt/jquery.timepicker.min.js"></script>
<script type="text/javascript">
    $(function () {

        /* Datepickers
         */
        $('[data-datepicker]').datepicker();
        $('[data-timepicker]').timepicker({
            appendTo: function ($input) {
                return $input.closest('.timepick');
            }
        });
    });
</script>

<div class="row">
    <div class="column small-12 medium-6">
        <label>
            Publish Date
            <input name="publishDate" type="text" value="{{ assessment.publishAt.localShort ?: project.publishAt.localShort }}" data-datepicker />
        </label>
    </div>

    <div class="column small-12 medium-6">
        <div class="timepick">
            <label>
                Publish Time
                <input name="publishTime" type="text" value="{{ assessment.publishAt.timeOnly ?: project.publishAt.timeOnly }}" data-timepicker />
            </label>
        </div>
    </div>
</div>

