{##
 # Rubric
 #
 # This is the assessment creational/updational section concerning the rubric grid.
 # It appears on the assessment modify screen at the bottom.
 #
 # @param array $rubricGridsPayload         An array struct specifically for rubric-builder component
 # @param string $rubricMarkedGridPayloads  A json-encoded representation of the rubric grid structure, marked grid, self graded grid
 # @param array $rubricAttachZone           An attachzone, for uploading rubric csvs
 # @param array $resultSets                 A Result Set chosen on the assessment modify screen to prepopulate rubric grid levels
 # @param IAssessable $assessment           An assessment instance
 # @param array $capabilityMarkTypes        Mark Types available for rubric capabilities, matches /library/Schoolbox/Assessment/Types/MarkType.ts::MarkType
 # @param array $capabilityGradingSchemes   Grading Schemes available for rubric capabilities, matches /library/Schoolbox/Learning/Assessment/templates/fragments/vue/mark-type.vue::GradeScheme
 # @param int defaultGradeGroup             Set in admin via default_grade_group config var
 # @param bool $courseManagedReadonly       A bool to decide if this is readonly or not
 #}

{% if courseManagedReadonly %}
    <div class="row">
        <div class="small-12 columns{% if not assessment.rubricInstances.count %} hide{% endif %}">
            <div class="small-12 columns no-pad">

                {% include '@rubric/grid.twig' with {
                    assessment: assessment,
                    folderId: assessment.context.folder.id,
                    rubricMarkedGridPayloads: rubricMarkedGridPayloads,
                    showRubricTotal: true,
                    showGroupTotal: true,
                } only %}
            </div>
        </div>
    </div>
{% else %}
    <div class="row">
        <div class="small-12 columns">
            <div class="small-12 columns no-pad">
                {% set assessmentId = assessment.id ? assessment.id : null %}
                <div
                    id="rubric-builder-container"
                    data-had-rubrics="{{ assessment.rubricInstances.count > 0 ? 'true' : 'false' }}"
                >
                    <rubric-builder
                        :rubric-grids-payload="{{ rubricGridsPayload|json_encode }}"
                        :rubric-blank-grid="{{ rubricBlankGrid|json_encode }}"
                        :result-sets="{{ resultSets|json_encode }}"
                        :capability-mark-types="{{ capabilityMarkTypes|json_encode }}"
                        :capability-grading-schemes="{{ capabilityGradingSchemes|json_encode }}"
                        :default-grade-group="{{ defaultGradeGroup }}"
                        :max-levels="{{ config.rubric_max_levels }}"
                        :folder-id="{{ assessment.context.folder.id }}"
                        route-rubric-create="{{ routeLookup("rubric.postCreate") }}"
                        route-rubric-import="{{ routeLookup("rubric.postImport") }}"
                        :assessment-id="{{ assessmentId ? assessmentId : 'null' }}"
                        {% if assessmentId %}
                            route-rubric-download="{{ routeLookup('rubric.postDownload') }}"
                        {% endif %}
                    />
                </div>
                <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/rubricBuilder.js?v={{ config.site_version }}"></script>

                {# TODO: bring this into Vue land one day, attachzone can't do that yet so just hide it here and click from within Vue instead #}
                <div id="rubric-builder-import-attachzone" class="hide">
                    {% include 'sub/attachzone.twig' with { attachzone: rubricAttachZone } %}
                </div>
            </div>
        </div>
    </div>
{% endif %}
