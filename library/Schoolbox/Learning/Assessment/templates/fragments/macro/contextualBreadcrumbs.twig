{##
 # Show different breadcrumbs based on assessment context.
 #}
{% macro crumbs(context) %}
    {% import 'sub/breadcrumbs.twig' as bread %}

    {# Folder name - always first crumb #}
    {% set args = [[ context.folder.name, '/homepage/' ~ folder.id ]] %}

    {# If a project - output the project name, and output subsequent crumbs in the context of the project #}

    {# If a unit spec - say so #}
    {# /course/modify/ ~ context.unit.id #}

    {# If a unit impl - say so #}
    {# /course/import/modify/ ~ context.unit.id #}

    {# Other varargs #}
    {% set args = args|merge(varargs) %}

    {{ bread.crumbsArray(args) }}
{% endmacro %}
