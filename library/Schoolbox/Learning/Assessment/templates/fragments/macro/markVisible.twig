{##
 # To show, or not to show? That is the question.
 # Parameters:
 # * assessment: the assesment whos visibility we are querying
 # * string: the string that will be printed, given the access level is right
 # * default: what to show if the user does not have access
 #}
{% macro showIfVisible(assessment, string, default) %}
    {% apply spaceless %}
        {% if assessment.isFeedbackVisibleToUser(USER) %}
            {{ string }}
        {% else %}
            {{ default }}
        {% endif %}
    {% endapply %}
{% endmacro %}
