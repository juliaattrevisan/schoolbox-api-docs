{##
 # To show, or not to show? That is the question.
 # Parameters:
 # * userRoleType: role type of the user veiwing ('student', 'parent', 'staff')
 # * visibility: visibility of the mark (0,1,2)
 #}
{% macro show(visibility, mark) %}
    {% spaceless %}
        {% if USER.role.type == 'parent' %}
            {% set access = 2  %}
        {% elseif USER.role.type == 'student' %}
            {% set access = 1  %}
        {% elseif USER.role.type == 'staff' %}
            {% set access = 0  %}
        {% else  %}
            {% set access = 2  %}
        {% endif %}

        {# This seems whack, but the grades visibility is:
            Staff Only: 0
            Staff and Students: 1
            Staff, Students and Parents: 2
            #}
        {% if access <= visibility %}
            {{ mark }}
        {% else %}
            —
        {% endif %}
    {% endspaceless %}
{% endmacro %}
