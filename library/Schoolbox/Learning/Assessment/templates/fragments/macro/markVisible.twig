{##
 # To show, or not to show? That is the question.
 # Parameters:
 # * assessment: the assesment whos visibility we are querying
 # * mark: the string that will be printed, given the access level is right
 # * replacement: what to show if the access does not have access
 #}
{% macro show(assessment, mark, replacement) %}
    {% spaceless %}
        {% if assessment.isFeedbackVisibleToUser(USER) %}
            {{ mark }}
        {% else %}
            {{ replacement }}
        {% endif %}
    {% endspaceless %}
{% endmacro %}
