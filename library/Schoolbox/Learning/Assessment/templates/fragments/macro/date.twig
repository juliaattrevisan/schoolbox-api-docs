{%  macro dateField(dateTitle, dateProperty, dateValue, syncEndDate) %}
<div class="row" id="{{ dateProperty }}">

    <div class="column small-12 medium-6">
        <label>
            {{ dateTitle }} Date
            <input name="{{ dateProperty }}Date" type="text" value="{{ dateValue.local }}" data-datepicker {% if syncEndDate is not empty %}data-datepicker-sync data-datepicker-sync-enddate="{{ syncEndDate }}"{% endif %} />
        </label>
    </div>

    {#<div class="column small-12 medium-6">#}
        {#<div class="timepick">#}
            {#<label>#}
                {#{{ dateTitle }} Time#}
                {#<input name="{{ dateProperty }}Time" type="text" value="{{ dateValue.timeOnly }}" data-timepicker />#}
            {#</label>#}
        {#</div>#}
    {#</div>#}

</div>
{% endmacro %}
