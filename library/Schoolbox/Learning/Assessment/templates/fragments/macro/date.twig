{##
 # Date fragment
 #
 # This macro allows you to render each of the date fields for a learning activity such as the publish date, open date,
 # etc. with optional date-buddy definitions that works with the Nat Picker js.
 #
 # If specified, $divisor will let you pick a medium-up column definition, e.g. medium-6, so that you can have the dates
 # displaying side by side instead of one giant stack. Whether this is good or bad for user experience I can't really
 # tell, but it was...desirable, to do this.
 #}

{% macro dateField(dateTitle, dateProperty, hide, dateValue, syncStartDateProperty, syncEndDateProperty, divisor) %}
    {% set viewports = '' %}

    {% if divisor is defined and divisor is not null %}
        {% set viewports = 'medium-' ~ divisor %}
    {% endif %}

    <div class="column small-12 {{ viewports }}" id="{{ dateProperty }}" {% if hide %}style="display:none;"{% endif %}>
        <label>
            {{ dateTitle }} Date
            <input
                id="{{ dateProperty }}Date"
                name="{{ dateProperty }}Date"
                type="text"
                value="{{ dateValue.local }}"
                data-test="assessment-form-input-date-{{ dateProperty }}"
                data-datepicker
                data-datepicker-time
                data-datepicker-format="datetime"
                data-datepicker-alldayswitch
                {% if USER.getRole.isStaff and dateProperty == 'due' and config.assessment_picker_enabled %}data-datepicker-call="duework"{% endif %}
                {% if dateProperty in ['due','late','close','planDue','planClose'] %}data-datepicker-endofday data-datepicker-endofperiod{% endif %}
                {% if syncStartDateProperty is not empty %}data-datesync-startdate='#{{ syncStartDateProperty }}Date'{% endif %}
                {% if syncEndDateProperty is not empty %}data-datesync-enddate='#{{ syncEndDateProperty }}Date'{% endif %}
                required
            />
        </label>
    </div>
{% endmacro %}
