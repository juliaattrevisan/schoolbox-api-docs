{%  macro dateField(dateTitle, dateProperty, dateValue, syncEndDate) %}
<div class="row" id="{{ dateProperty }}">

    <div class="column small-12">
        <label>
            {{ dateTitle }} Date
            <input id="{{ dateProperty }}Date" name="{{ dateProperty }}Date" type="text" value="{{ dateValue.local }}" data-datepicker data-datepicker-time data-datepicker-format="datetime" data-datepicker-allday {% if USER.getRole.isStaff %} data-datepicker-call="duework" {% endif %} {% if dateProperty in ['due','late','close'] %} data-datepicker-endofday data-datepicker-endofperiod {% endif %} {% if syncEndDate is not empty %}data-datepicker-sync data-datepicker-sync-enddate='{{ syncEndDate }}'{% endif %} />
        </label>
    </div>

</div>
{% endmacro %}
