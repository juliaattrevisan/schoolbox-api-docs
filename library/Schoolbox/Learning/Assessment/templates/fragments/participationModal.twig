{#
 # Modal for creating/modifying a custom learning plan on an assessment.
 # This is split out into a separate file in order to include this outside of the main form (this contains a form).
 #}
<div data-reveal id="participant-customise-modal" class="reveal-modal">
    <h2 data-plan-header>{# Filled with JS on modal open #}</h2>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>

    <form method="post" id="participation-plan-form" class="has-columns">
        <section>

            <div class="columns small-12">
                <label>
                    Plan Name
                    <input type="text" name="plan-name" id="plan-name" maxlength="256">
                </label>
            </div>

            <fieldset>
                <legend>Custom Assessment Details</legend>
                <div class="columns medium-12 large-7">
                    <label>
                        Description
                        <textarea name="plan-desc" id="plan-desc"></textarea>
                    </label>
                </div>
                <div class="columns medium-12 large-5">
                    <div data-plan-date-container>
                        <label>
                            Publish Date
                            <input
                                type="text"
                                name="plan-publish-date"
                                id="plan-publish-date"
                                data-datepicker data-datepicker-time
                                data-datepicker-format="datetime"
                                data-datepicker-alldayswitch
                                data-datepicker-call="duework"
                                data-datesync-enddate="#plan-open-date"
                            >
                        </label>
                    </div>

                    <div data-plan-date-container>
                        <label>
                            Open Date
                            <input
                                type="text"
                                name="plan-open-date"
                                id="plan-open-date"
                                data-datepicker
                                data-datepicker-time
                                data-datepicker-format="datetime"
                                data-datepicker-alldayswitch
                                data-datepicker-call="duework"
                                data-datesync-startdate="#plan-publish-date"
                                data-datesync-enddate="#plan-due-date"
                            >
                        </label>
                    </div>

                    <div data-plan-date-container>
                        <label>
                            Due Date
                            <input
                                type="text"
                                name="plan-due-date"
                                id="plan-due-date"
                                data-datepicker
                                data-datepicker-time
                                data-datepicker-format="datetime"
                                data-datepicker-alldayswitch
                                data-datepicker-call="duework"
                                data-datepicker-endofday
                                data-datepicker-endofperiod
                                data-datesync-startdate="#plan-open-date"
                                data-datesync-enddate="#plan-close-date"
                            >
                        </label>
                    </div>

                    <div data-plan-date-container>
                        <label>
                            Close Date
                            <input
                                type="text"
                                name="plan-close-date"
                                id="plan-close-date"
                                data-datepicker
                                data-datepicker-time
                                data-datepicker-format="datetime"
                                data-datepicker-alldayswitch
                                data-datepicker-call="duework"
                                data-datepicker-endofday
                                data-datepicker-endofperiod
                                data-datesync-startdate="#plan-due-date"
                            >
                        </label>
                    </div>
                </div>
            </fieldset>

            <div class="columns small-12">
                <label>
                    Plan Participants
                    <input type="text" name="plan-participants" id="plan-participants" placeholder="Search Students" data-selectizeuser>
                </label>
            </div>

            <input type="hidden" name="plan-id" id="plan-id">

            <div class="columns small-12">
                <input type="submit" value="Save">
            </div>

        </section>
    </form>
</div>