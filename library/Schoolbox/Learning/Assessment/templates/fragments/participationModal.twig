{% import "@learningAssessment/fragments/macro/date.twig" as dateForm %}

{#
 # Modal for creating/modifying a custom learning plan on an assessment.
 # This is split out into a separate file in order to include this outside of the main form (this contains a form).
 #}
<div data-reveal id="participant-customise-modal" class="reveal-modal">
    <h2 data-plan-header>{# Filled with JS on modal open #}</h2>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>

    <form method="post" id="participation-plan-form" class="has-columns">
        <section>

            <div class="columns small-12">
                <label>
                    Plan Name
                    <input type="text" name="plan-name" id="plan-name" data-test="participation-plan-customise-modal-input-name" maxlength="256">
                </label>


                <fieldset>
                    <legend>Custom Activity Details</legend>
                    <div class="columns medium-12 large-7">
                        <label>
                            Description
                            <textarea name="plan-desc" id="plan-desc"></textarea>
                        </label>
                    </div>
                    <div class="columns medium-12 large-5">
                        {% set dummyDate = {local: ''} %}
                        {% if acceptingResponses is defined and acceptingResponses %}
                            {{ dateForm.dateField('Publish', 'planPublish', dummyDate, ''                , '#planOpenDate' ) }}
                            {{ dateForm.dateField('Open'   , 'planOpen'   , dummyDate, '#planPublishDate', '#planDueDate'  ) }}
                            {{ dateForm.dateField('Due'    , 'planDue'    , dummyDate, '#planOpenDate'   , '#planCloseDate') }}
                            {{ dateForm.dateField('Late'   , 'planClose'  , dummyDate, '#planDueDate'    , ''              ) }}
                        {% else %}
                            {{ dateForm.dateField('Publish', 'planPublish', dummyDate, ''                , '#planDueDate'  ) }}
                            {{ dateForm.dateField('Due'    , 'planDue'    , dummyDate, '#planPublishDate', ''              ) }}
                        {% endif %}
                    </div>
                </fieldset>

                <label>
                    Plan Participants
                    <input type="text" name="plan-participants" id="plan-participants" placeholder="Search Students" data-selectizeuser>
                </label>

                <input type="hidden" name="plan-id" id="plan-id">

                <input type="submit" value="Save" data-test="participation-plan-form-button-save">
            </div>
        </section>
    </form>
</div>
