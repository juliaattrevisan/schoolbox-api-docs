<script type="text/javascript">
    $(function() {
        $('#content').find('ul[data-sortable]').sortable({
            handle:      '.grip',
            axis:        'y'
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="list-item small-12 columns">
        <h1>{{ assessment.title }}</h1>
    </div>
    <nav>
        <a href="{{ routeLookup('learningAssessment.getUpdateAssessment', {assessmentId: assessment.id}) }}" class="icon-modify" title="Modify"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island">

        {% include '@learningAssessment/fragments/project/description.twig' with {assessment: assessment, user: currentUser} %}

        <div class="row">

            <div class="small-12 medium-6 island">
                <h2 class="subheader">Assessables</h2>

                {% if assessment.assessables | length %}
                <section>
                    <ul class="information-list sortable-card ui-sortable" data-sortable>
                        {% for assessable in assessment.assessables %}
                            {% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}

                            <li class="actions-small-1">
                                <div class="grip"></div>
                                <div class="list-item">
                                    <div class="card wrap-down small-12">
                                        <div class="{{ icon.renderClass(assessable) }} icon-32" title="{{ assessable.getTypeName }}"></div>

                                        <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: assessable.id}) }}">
                                            <h3>
                                                {{ assessable.title }}
                                            </h3>
                                        </a>
                                        <p class="meta" title="{{ assessable.getDueAt.getLocal }}">
                                            Due {{ assessable.getDueAt.getRelativeTime }}
                                        </p>
                                    </div>
                                </div>
                                <nav>
                                    <a href="{{ routeLookup('learningAssessment.getUpdateAssessment', {assessmentId: assessable.id}) }}{{ returnUrlSuffix }}"
                                       class="icon-modify no-text" title="Modify"></a>
                                </nav>
                            </li>

                        {% endfor %}
                    </ul>
                    <div class="content">
                        <ul id="projectButtons" class="flex-list buttons">
                            {% for returnUrl in allReturnUrls %}
                                <li><a href="{{ returnUrl.url }}" title="Create a new {{ returnUrl.label }}" class="button icon-{{ returnUrl.icon }}">New {{ returnUrl.label }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                </section>
                <a href="{{ routeLookup('learningAssessment.getSelectAssessmentInProject', {projectId: assessment.id}) }}{{ returnUrlSuffix }}" class="button icon-project full-width" title="Create a new Assessment">Create new Assessment</a>
                {% else %}
                <div class="empty-state">
                    <i class="icon-project"></i>
                    <p>Your project is empty.</p>
                    <p>Add a
                        {% for projectAssessment in projectAssessments %}
                            {%- set url -%}
                                {{ routeLookup('learningAssessment.getSelectAssessmentInProject', {projectId: assessment.id, assessmentTypeTitle: types.objectToString(projectAssessment)}) }}
                            {%- endset -%}
                            <a href="{{ url }}{{ returnUrlSuffix }}" title="Create a new {{ projectAssessment.typeName }}">{{ projectAssessment.typeName }}</a>
                            {%- if not loop.last %},{% endif %}{% if loop.revindex == 2 %} or{% endif %}
                        {% endfor %}
                    </p>
                </div>
                {% endif %}
            </div>

            <div class="small-12 medium-6 island">
                <h2 class="subheader">Participants</h2>

                {% if assessment.allParticipants | length %}
                    <section>
                        <ul class="information-list">
                            {% for participant in assessment.allParticipants %}
                                <li>
                                    <div class="list-item">
                                        <div class="card small-12">
                                            <a href="{{ routeLookup('learningAssessment.getStudentAssessment', { assessmentId: assessment.id, studentId: participant.user.id}) }}">
                                                <img src="/portrait.php?userId={{ participant.user.externalId }}&size=square64" width="48">
                                                <h3>
                                                    {{ participant.user.fullName }}
                                                </h3>
                                            </a>
                                            <p class="meta">
                                                {% if participant.user.user.year and participant.user.role.isStudent %}
                                                    Year {{ participant.user.year }}
                                                {% endif %}
                                                {{ participant.user.role.name }}
                                            </p>
                                        </div>
                                        <div class="progress">
                                            <span class="meter"
                                                  style="width:{{ counts[participant.user.id].totalCompleted / counts[participant.user.id].total * 100 }}%"></span>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}
            </div>

        </div>
    </div>
</div>
