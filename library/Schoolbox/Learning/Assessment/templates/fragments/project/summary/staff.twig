<script type="text/javascript">
    $(function() {
        $('#content').find('ul[data-sortable]').sortable({
            handle:      '.grip',
            axis:        'y'
        });

        $('[data-delete]').click(function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this item?',
                confirmEvent: function() {
                    $.post($(element).attr('href'), {assessmentId: $(element).attr('data-delete')}, function(responseText) {
                        window.location.href = responseText.return_url;
                    });
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="list-item small-12 columns">
        <h1>{{ assessment.title }}</h1>
    </div>
    <nav>
        <a href="{{ routeLookup('learningAssessment.getUpdateAssessment', {assessmentId: assessment.id}) }}" class="icon-modify" title="Modify"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island">

        {% include '@learningAssessment/fragments/project/summary/description.twig' with {assessment: assessment, user: currentUser} %}

        <div class="row">
            <div class="small-12 medium-6 island">
                <h2 class="subheader">Activities</h2>

                {% if assessment.assessables | length %}
                <section>
                    <ul class="information-list sortable-card ui-sortable" data-sortable>
                        {% for assessable in assessment.assessables %}
                            {% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}

                            <li class="actions-small-2">
                                <div class="grip"></div>
                                <div class="list-item">
                                    <div class="card wrap-down small-12">
                                        <div class="{{ icon.renderClass(assessable) }} icon-32" title="{{ assessable.getTypeName }}"></div>

                                        <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: assessable.id}) }}">
                                            <h3>
                                                {{ assessable.title }}
                                            </h3>
                                        </a>
                                        <p class="meta" title="{{ assessable.getDueAt.getLocal }}">
                                            {{ assessableCounts[assessable.id].total }} / {{ assessment.allParticipants | length }} Students,
                                            Due {{ assessable.getDueAt.getRelativeTime }}
                                        </p>
                                    </div>
                                </div>
                                <nav>
                                    {% if isRouteAuthorized('learningAssessment.postUpdateAssessment', {assessmentId: assessable.id}) %}
                                    <a href="{{ routeLookup('learningAssessment.getUpdateAssessment', {assessmentId: assessable.id}) }}{{ returnUrlSuffix }}" class="icon-modify no-text" title="Modify"></a>
                                    {% endif %}

                                    {% if isRouteAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id}) %}
                                    <a href="{{ routeLookup('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id}) }}{{ returnUrlSuffix }}" class="icon-delete no-text" title="Delete" data-delete="{{ assessable.id }}"></a>
                                    {% endif %}
                                </nav>
                            </li>

                        {% endfor %}
                    </ul>
                    <div class="component-action">
                        <section>
                            {% for returnUrl in allReturnUrls %}
                                <a href="{{ returnUrl.url }}" title="Create a new {{ returnUrl.label }}" class="button icon-{{ returnUrl.icon }}">New {{ returnUrl.label }}</a>
                            {% endfor %}
                            <a href="{{ routeLookup('learningAssessment.getSelectAssessmentInProject', {projectId: assessment.id}) }}{{ returnUrlSuffix }}" class="button icon-project full-width" title="Create a new Assessment">Create Assessment</a>
                        </section>
                    </div>
                </section>

                {% else %}
                <div class="empty-state">
                    <i class="icon-project"></i>
                    <p>Your project is empty.</p>
                    <p>Add a
                        {% for projectAssessment in projectAssessments %}
                            {%- set url -%}
                                {{ routeLookup('learningAssessment.getSelectAssessmentInProject', {projectId: assessment.id, assessmentTypeTitle: types.objectToString(projectAssessment)}) }}
                            {%- endset -%}
                            <a href="{{ url }}{{ returnUrlSuffix }}" title="Create a new {{ projectAssessment.typeName }}">{{ projectAssessment.typeName }}</a>
                            {%- if not loop.last %},{% endif %}{% if loop.revindex == 2 %} or{% endif %}
                        {% endfor %}
                    </p>
                </div>
                {% endif %}
            </div>

            <div class="small-12 medium-6 island">
                <h2 class="subheader">Students</h2>

                {% if assessment.allParticipants | length %}
                    <section>
                        <ul class="information-list">
                            {% for participant in assessment.allParticipants %}
                                <li>
                                    <div class="list-item">
                                        <div class="card small-12">
                                            {% if participant.mark.published.humanReadable %}
                                            <span class="neutral label right">
                                                {{ participant.mark.published.humanReadable }}
                                            </span>
                                            {% endif %}
                                            <a href="{{ routeLookup('learningAssessment.getStudentAssessment', { assessmentId: assessment.id, studentId: participant.user.id}) }}">
                                                <img src="/portrait.php?userId={{ participant.user.externalId }}&size=square64" width="48">
                                                <h3>
                                                    {{ participant.user.formatName }}
                                                </h3>
                                            </a>
                                            <p class="meta">
                                                {% if participant.user.year and participant.user.role.isStudent %}
                                                    Year {{ participant.user.year }}
                                                {% endif %}
                                            </p>
                                            <p class="meta">
                                                {{ counts[participant.user.id].totalCompleted }} / {{ counts[participant.user.id].total }} Completed
                                            </p>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% else %}
                    <div class="empty-state">
                        <i class="icon-group"></i>
                        <p>There are no students currently undertaking this project.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
