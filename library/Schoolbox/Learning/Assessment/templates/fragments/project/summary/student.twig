{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type="text/javascript" src="/javascript/shared/submissions/task/jquery.progressTickForm.js"></script>
<script type="text/javascript">
    // Add previews
    $(function() {
        $('[data-plugin="preview"]').preview();

        // Save form for task completion
        $('form[data-progress-tick-form="selfAssessed"]').progressTickForm({
            transitions: {
                notAttempted: 'selfAssessed',
                selfAssessed: 'notAttempted',
                complete:     'notAttempted'
            }
        });
    });
</script>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ assessment.title }}</h1>
        </div>
    </div>
    {% set viewRoute = routeLookupIfAuthorized('learningMarkbook.getMarkbook', {class: assessment.context, classId: assessment.context.id}) %}
    {% if viewRoute %}
    <nav>
        <a class="icon-more" title="" data-dropdown="header-options"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        <li class="separator">Grading</li>
        <li><a class="icon-approve" href="{{ viewRoute }}">Markbook</a></li>
    </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/fragments/project/summary/description.twig' with {assessment: assessment, currentUser: currentUser} %}

        {% if assessment.assessables|length %}
        <h2 class="subheader">Activities</h2>
        <section>
            <ul class="information-list">
                {% for assessable in assessment.assessables %}
                    {% include '@learningAssessment/fragments/' ~ (assessable.familyName ) ~ '/card.twig' with {assessment: assessment, student: student, assessable: assessable, type: 'student'} %}
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-project"></i>
            <p>There are no assessments in this project at the moment.</p>
        </div>
        {% endif %}
    </div>
</div>
