{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type='text/javascript' src='/javascript/preview/preview.js'></script>
<script type="text/javascript">
    // Add previews
    $(function() {
        $('[data-plugin="preview"]').preview();
    });
</script>

<div class="row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        {% include '@learningAssessment/fragments/project/timeline.twig' with {assessment: assessment, currentUser: currentUser, type: 'student'} %}
        {% include '@learningAssessment/fragments/project/summary/description.twig' with {assessment: assessment, currentUser: currentUser} %}

        {% if assessment.assessables|length %}
        <h2 class="subheader">Activities</h2>
        <section>
            <ul class="information-list">
                {% for assessable in assessment.assessables %}
                    {% include '@learningAssessment/fragments/' ~ (assessable.familyName ) ~ '/card.twig' with {assessment: assessment, student: student, assessable: assessable, type: 'student'} %}
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-project"></i>
            <p>There are no assessments in this project at the moment.</p>
        </div>
        {% endif %}
    </div>
</div>
