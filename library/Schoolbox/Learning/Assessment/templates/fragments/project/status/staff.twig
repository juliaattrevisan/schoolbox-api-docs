<script type="text/javascript">
    $(function() {
        // Setup sortable
        var assessmentList = $('#assessment-list');
        assessmentList.sortable({
            handle: '.grip',
            axis:   'y'
        })
        .on('sortstop', function() {
            var sequence = [];
            assessmentList.find('[data-assessment]').each(function(idx, elem){
                sequence.push($(elem).attr('data-assessment'));
            });
            var data = {
                id: sequence
            };
            $.post(assessmentList.attr('data-action'), data);
        });

        $('[data-delete]').click(function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this item?',
                confirmEvent: function() {
                    var listItem = $(element).parents('[data-assessment]');

                    var assessmentId = $(element).attr('data-delete');
                    var assessmentList = $('#assessment-list');
                    var assessmentName = assessmentList
                            .find('[data-assessment='+assessmentId+']')
                            .attr('data-assessment-title');

                    {# Toast success and remove row from template #}

                    var toast = $('#assessment-toast');
                    toast.toastActivate({text: 'Deleting ' + assessmentName + '...'});

                    $.post($(element).attr('href'), {assessmentId: assessmentId})
                    .success(function() {
                        toast.toastTimeout({text: assessmentName + ' deleted.', css: 'success'});
                        listItem.fadeOut({
                            done: function() {
                                listItem.remove();

                                {# Hide component actions and respawn empty state #}
                                if (!assessmentList.find('li').length) {
                                    $('#assessment-actions').remove();
                                    $('#assessment-list-empty-state').removeClass('hide');
                                }
                            }
                        });
                    })
                    .error(function() {
                        {# Toast alert #}
                        toast.toastTimeout({text: 'Could not delete ' + assessmentName, css: 'alert'});
                    });
                }
            });
        });
    });
</script>

{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="list-item small-12 columns">
        <h1>{{ assessment.title }}</h1>
    </div>
    <nav>
        <a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id}) }}" class="icon-modify" title="Modify"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island">

        {% include '@learningAssessment/fragments/project/summary/description.twig' with {assessment: assessment, user: USER} %}

        <div class="row">
            {% if assessment.baseContext is unitSpecification %}
            <div class="small-12 island">
            {% else %}
            <div class="small-12 medium-6 island">
            {% endif %}
                <h2 class="subheader">Activities</h2>

                {% if assessment.assessables | length %}
                <section>
                    <ul id='assessment-list' class="information-list sortable-card"
                        data-sortable
                        data-assessment-list
                        data-action="{{ routeLookup('learningAssessment.postReorderAssessments', {contextType: 'projects', contextId: assessment.id, context: context}) }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">
                        {% for assessable in assessment.assessables %}
                            {% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}

                            <li class="actions-small-2" data-assessment="{{ assessable.id }}" data-assessment-title="{{ assessable.title }}">
                                <div class="grip"></div>
                                <div class="list-item">
                                    <div class="card small-12">
                                        <div class="{{ icon.renderClass(assessable) }}" title="{{ assessable.getTypeName }}"></div>
                                        <a href="{{ routeLookup('learningAssessment.getStatus', {assessmentId: assessable.id}) }}">
                                            <h3>
                                                {{ assessable.title }}
                                            </h3>
                                        </a>

                                        {% if assessable.getDueAt.isNull == false %}
                                            <p class="meta">{{ dueDate.dueDate(assessable, USER) }}</p>
                                        {% endif %}

                                        {% if assessable.weight %}
                                            <p class="meta">
                                                Weight: {{ assessable.weight }}
                                            </p>
                                        {% endif %}

                                        {% if assessable.getDueAt.isNull == false %}
                                            <p class="meta">
                                                {{ assessmentCounts.completed[assessable.id] }}/{{ assessmentCounts.totalParticipants }} students completed
                                            </p>
                                        {% endif %}
                                    </div>
                                </div>
                                <nav>
                                    {% if assessable is quiz %}
                                        {% if isRouteAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessable.id, assessment: assessable}) %}
                                            <a href="{{ routeLookup('learningQuiz.getQuizSummary', {assessmentId: assessable.id}) }}{{ returnUrlSuffix }}" class="icon-modify no-text" title="Modify"></a>
                                        {% endif %}
                                    {% else %}
                                        {% if isRouteAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessable.id, assessment: assessable}) %}
                                            <a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessable.id}) }}{{ returnUrlSuffix }}" class="icon-modify no-text" title="Modify"></a>
                                        {% endif %}
                                    {% endif %}

                                    {% if isRouteAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id, assessment: assessable}) %}
                                    <a href="{{ routeLookup('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id}) }}{{ returnUrlSuffix }}" class="icon-delete no-text" title="Delete" data-delete="{{ assessable.id }}"></a>
                                    {% endif %}
                                </nav>
                            </li>

                        {% endfor %}
                    </ul>

                    <div id="assessment-toast" class="toast"></div>

                    <div id="assessment-actions" class="component-action">
                        <section>
                            <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'projects', contextId: assessment.id, context: assessment }) }}{{ returnUrlSuffix }}" class="button" title="Create a new activity">Create Activity</a>
                        </section>
                    </div>
                </section>
                {% endif %}

                <div id='assessment-list-empty-state' class="empty-state {% if assessment.assessables|length %}hide{% endif %}">
                    <i class="icon-project"></i>
                    <p>You project currently has no activities.<br />To start assessing students you should <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'projects', contextId: assessment.id, context: assessment }) }}{{ returnUrlSuffix }}">create an activity</a> next.</p>
                </div>
            </div>

            {% if assessment.baseContext is not unitSpecification %}
            <div class="small-12 medium-6 island">
                <h2 class="subheader">Students</h2>

                {% if assessment.allParticipants | length %}
                    <section>
                        <ul class="information-list">
                            {% for participant in assessment.allParticipants %}
                                <li>
                                    <div class="list-item">
                                        <div class="card small-12">
                                            {% if participant.mark.published.humanReadable %}
                                            <span class="neutral label right">
                                                {{ participant.mark.published.humanReadable }}
                                            </span>
                                            {% endif %}
                                            <a href="{{ routeLookup('learningAssessment.getSummary', { assessmentId: assessment.id, studentId: participant.user.id}) }}">
                                                <img src="/portrait.php?userId={{ participant.user.externalId }}&size=square64" width="48">
                                                <h3>
                                                    {{ participant.user.formatName }}
                                                </h3>
                                            </a>
                                            <p class="meta">
                                                {{ participantCounts.completed[participant.user.id] }}/{{ participantCounts.totalAssessments }} activities completed
                                            </p>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% else %}
                    <div class="empty-state">
                        <i class="icon-group"></i>
                        <p>There are no students currently undertaking this project.</p>
                    </div>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 column">
        {% if baseContext is unitSpecification %}
        <a href="{{ routeLookup('course.modifyCourse', {id: baseContext.course.id })}}#{{ baseContext.id }}" class="button submit">Return to course</a>
        {% else %}
        <a href="/homepage/{{ baseContext.folder.id }}" class="button submit">Return to homepage</a>
        {% endif %}
    </div>
</div>
