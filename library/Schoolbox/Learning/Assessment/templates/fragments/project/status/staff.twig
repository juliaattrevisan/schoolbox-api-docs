<script type="text/javascript">
    $(function() {
        $('#content').find('ul[data-sortable]').sortable({
            handle:      '.grip',
            axis:        'y'
        });

        $('[data-delete]').click(function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this item?',
                confirmEvent: function() {
                    $.post($(element).attr('href'), {assessmentId: $(element).attr('data-delete')}, function(responseText) {
                        window.location.href = responseText.returnUrl;
                    });
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="list-item small-12 columns">
        <h1>{{ assessment.title }}</h1>
    </div>
    <nav>
        <a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id}) }}" class="icon-modify" title="Modify"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island">

        {% include '@learningAssessment/fragments/project/summary/description.twig' with {assessment: assessment, user: currentUser} %}

        <div class="row">
            {% if assessment.baseContext is unitSpecification %}
            <div class="small-12 island">
            {% else %}
            <div class="small-12 medium-6 island">
            {% endif %}
                <h2 class="subheader">Activities</h2>

                {% if assessment.assessables | length %}
                <section>
                    <ul class="information-list sortable-card ui-sortable" data-sortable>
                        {% for assessable in assessment.assessables %}
                            {% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}

                            <li class="actions-small-2">
                                <div class="grip"></div>
                                <div class="list-item">
                                    <div class="compact card wrap-down small-12">
                                        <div class="{{ icon.renderClass(assessable) }}" title="{{ assessable.getTypeName }}"></div>
                                        <a href="{{ routeLookup('learningAssessment.getStatus', {assessmentId: assessable.id}) }}">
                                            <h3>
                                                {{ assessable.title }}
                                            </h3>
                                        </a>
                                        {% if assessable.getDueAt.isNull == false %}
                                        <p class="meta" title="{{ assessable.getDueAt.getLocal }}">
                                            {{ assessableCounts[assessable.id].total }} / {{ assessment.allParticipants | length }} Students,
                                            Due {{ assessable.getDueAt.getRelativeTime }}
                                        </p>
                                        {% endif %}
                                    </div>
                                </div>
                                <nav>
                                    {% if assessable is quiz %}
                                        {% if isRouteAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessable.id}) %}
                                            <a href="{{ routeLookup('learningQuiz.getQuizSummary', {assessmentId: assessable.id}) }}{{ returnUrlSuffix }}" class="icon-modify no-text" title="Modify"></a>
                                        {% endif %}
                                    {% else %}
                                        {% if isRouteAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessable.id}) %}
                                            <a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessable.id}) }}{{ returnUrlSuffix }}" class="icon-modify no-text" title="Modify"></a>
                                        {% endif %}
                                    {% endif %}

                                    {% if isRouteAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id}) %}
                                    <a href="{{ routeLookup('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id}) }}{{ returnUrlSuffix }}" class="icon-delete no-text" title="Delete" data-delete="{{ assessable.id }}"></a>
                                    {% endif %}
                                </nav>
                            </li>

                        {% endfor %}
                    </ul>
                    <div class="component-action">
                        <section>
                            <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'projects', contextId: assessment.id }) }}{{ returnUrlSuffix }}" class="button" title="Create a new activity">Create Activity</a>
                        </section>
                    </div>
                </section>

                {% else %}
                <div class="empty-state">
                    <i class="icon-project"></i>
                    <p>You project currently has no activities.<br />To start assessing students you should <a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'projects', contextId: assessment.id }) }}{{ returnUrlSuffix }}">create an activity</a> next.</p>
                </div>
                {% endif %}
            </div>

            {% if assessment.baseContext is not unitSpecification %}
            <div class="small-12 medium-6 island">
                <h2 class="subheader">Students</h2>

                {% if assessment.allParticipants | length %}
                    <section>
                        <ul class="information-list">
                            {% for participant in assessment.allParticipants %}
                                <li>
                                    <div class="list-item">
                                        <div class="card small-12">
                                            {% if participant.mark.published.humanReadable %}
                                            <span class="neutral label right">
                                                {{ participant.mark.published.humanReadable }}
                                            </span>
                                            {% endif %}
                                            <a href="{{ routeLookup('learningAssessment.getSummary', { assessmentId: assessment.id, studentId: participant.user.id}) }}">
                                                <img src="/portrait.php?userId={{ participant.user.externalId }}&size=square64" width="48">
                                                <h3>
                                                    {{ participant.user.formatName }}
                                                </h3>
                                            </a>
                                            <p class="meta">
                                                {% if participant.user.year and participant.user.role.isStudent %}
                                                    Year {{ participant.user.year }}
                                                {% endif %}
                                            </p>
                                            <p class="meta">
                                                {{ counts[participant.user.id].totalCompleted }} / {{ counts[participant.user.id].total }} Completed
                                            </p>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% else %}
                    <div class="empty-state">
                        <i class="icon-group"></i>
                        <p>There are no students currently undertaking this project.</p>
                    </div>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 column">
        {% if baseContext is unitSpecification %}
        <a href="{{ routeLookup('course.modifyCourse', {id: baseContext.course.id })}}#{{ baseContext.id }}" class="button submit full-width">Return to course</a>
        {% else %}
        <a href="/homepage/{{ baseContext.folder.id }}" class="button submit full-width">Return to homepage</a>
        {% endif %}
    </div>
</div>

