{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type='text/javascript' src='/javascript/preview/preview.js'></script>
<script type="text/javascript">
    // Add previews
    $(function() {
        $('[data-plugin="preview"]').preview();
    });
</script>

<div class="row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        {% include '@learningAssessment/fragments/project/description.twig' with {assessment: assessment, currentUser: currentUser} %}
        {% include '@learningAssessment/fragments/project/timeline.twig' with {assessment: assessment, currentUser: currentUser} %}
        {% include '@learningAssessment/fragments/project/progress.twig' with {counts: counts} %}

        <h2 class="subheader">Assessables</h2>

        <section>
            <ul class="information-list">
                {% for assessable in assessment.assessables %}
                    {% include '@learningAssessment/fragments/' ~ (assessable.familyName ) ~ '/card.twig' with {assessment: assessment, student: student, assessable: assessable, type: 'student'} %}
                {% endfor %}
            </ul>
        </section>
    </div>
</div>
