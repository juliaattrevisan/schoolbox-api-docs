{##
 # modifyTot
 #
 # A shared tot menu that became available when an instructor could either view the assessment's Status screen
 # or modify the assessment details itself. It's since expanded to also become available for students when they
 # can showcase assessments to their eportfolio.
 #
 # @param string        $gradeRoute             the route to the Grade/Feedback screen, for instructors
 # @param string        $viewRoute              the route to the Status screen, for instructors
 # @param string        $modifyRoute            the route to the Modify Assessment screen, for instructors
 # @param bool          $canShowcase            a boolean for students' ability to Showcase to their eportfolio
 # @param bool          $isShowcased            whether this assessment is already showcased on a user's eportfolio
 # @param array         $externalRedirectUrl    A third party redirect url/application name tuple (url, name)
 # @param bool          $hasStudentView         For Lesson Plan specifically, where a toggle shows student/staff views of a Lesson Plan
 #}
{% if gradeRoute or viewRoute or modifyRoute or (canShowcase is defined and canShowcase and assessment.getCountInteractions) or (externalRedirectUrl is defined and externalRedirectUrl) or (hasStudentView is defined and hasStudentView) %}
    <nav>
        {% if externalRedirectUrl is defined and externalRedirectUrl %}
            <a href="{{ externalRedirectUrl.url }}" class="alert" title="{{ externalRedirectUrl.name }}"><sbx-icon name="view"></sbx-icon></a>
        {% endif %}
        <sbx-pop-out content-id="header-options" data-test="sbx-pop-out-header-options"></sbx-pop-out>
    </nav>
    <ul data-dropdown-content id="header-options" class="f-dropdown">
        {% if gradeRoute %}
        <li><a href="{{ gradeRoute }}" class="sbx-button--has-icon"><sbx-icon name="task"></sbx-icon>View and {{ locale.grades }} submission</a></li>
        {% endif %}

        {# if we are on course level, we should hide the status page
         #}
        {% if assessment.isImplementation and  viewRoute %}
            <li><a href="{{ viewRoute }}" class="sbx-button--has-icon"><sbx-icon name="progress"></sbx-icon>View Status</a></li>
        {% endif %}

        {# Students must have ePortfolio enabled, otherwise they can't do this
         #}
        {% if canShowcase %}
            <li>
                {# Allow unpublish even if the assessment has no responses or feedback
                 # This is so that the user can tell whether the assessment is in a 'publish automatically if any
                 # response is received' state, and remove it from this state by unpublishing.
                 #}
                {% if isShowcased %}
                    {% if USER.id == student.id %}
                        <a data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" data-publish-state='0' title="Remove from ePortfolio" class="sbx-button--has-icon"><sbx-icon name="showcase"></sbx-icon>Remove from ePortfolio</a>
                    {% else %}
                        <a data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" data-publish-state='0' title="Remove from {{ student.givenName }}'s ePortfolio" class="sbx-button--has-icon"><sbx-icon name="showcase"></sbx-icon>Remove from {{ student.givenName }}'s ePortfolio</a>
                    {% endif %}
                {# Allow publish only if the assessment has responses or feedback
                 #}
                {% elseif assessment.getCountInteractions %}
                    {# Decide if you're publishing to your own eportfolio
                     # or if you're publishing on behalf of a student to *their* eportfolio
                     #}
                    {% if USER.id == student.id %}
                        <a data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" data-publish-state='1' title="Publish to ePortfolio" class="sbx-button--has-icon"><sbx-icon name="showcase"></sbx-icon>Publish to ePortfolio</a>
                    {% else %}
                        <a data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" data-publish-state='1' title="Publish to {{ student.givenName }}'s ePortfolio" class="sbx-button--has-icon"><sbx-icon name="showcase"></sbx-icon>Publish to {{ student.givenName }}'s ePortfolio</a>
                    {% endif %}
                {% endif %}
            </li>

            <script src="{{ CDN_PREFIX }}/js/eportfolio/jquery.eportfolio.js?v={{ config.site_version }}"></script>
            <script type="text/javascript">
                $(function () {
                    $('[data-publish-to-eportfolio]').eportfolioPublish({
                        userId: '{{ student.id }}',

                        {# Managing profile data on behalf of somene else's eportfolio
                         # means you supply a different dialog string
                         #}
                        {% if USER.id != student.id %}
                            publish: {
                                text: "Are you sure you want to publish this work to {{ student.givenName }}'s ePortfolio showcase? This will make the work visible to everyone.",
                                action: 'publish'
                            },
                            unpublish: {
                                text: "Are you sure you want to remove this work from {{ student.givenName }}'s ePortfolio showcase?",
                                action: 'unpublish'
                            }
                        {% endif %}
                    });
                });
            </script>
        {% endif %}

        {% set viewCustomParticipationRoute = routeLookupIfAuthorized('learningAssessment.getAssessmentParticipationForm', {
            assessmentId: assessment.id,
            assessment: assessment
        }) %}
        {% if viewCustomParticipationRoute %}
            <li><a href="{{ viewCustomParticipationRoute }}" class="sbx-button--has-icon"><sbx-icon name="group"></sbx-icon>Student Participation</a></li>
        {% endif %}

        {% include '@learningAssessment/fragments/modifyLinks.twig' with {
            assessment: assessment,
            modifyRoute: modifyRoute,
            returnUrlName: RETURN_URL.name,
            returnUrl: RETURN_URL.current,
        } only %}

        {# Lesson Plan lets you swap divs
         # This lets you see student-visible versions of an LPT
         # TODO Arguably Lesson Plan's modifyTot should be a subclass of this modifyTot?
         #}
        {% if assessment is lessonPlan and hasStudentView is defined and hasStudentView %}
            {% if assessment.visibility == 'student' %}
                <li class="separator" data-has-student-view-separator>You are in Teacher View</li>
                <li><a data-has-student-view="staff" class="sbx-button--has-icon"><sbx-icon data-has-student-view-icon name="staff-students"></sbx-icon><span data-has-student-view-label>Switch to Student View</span></a></li>

                <script>
                    $(function() {
                        /**
                         * Enable student view of a Lesson Plan
                         */
                        function lessonPlanStudentView(elem) {
                            const $elem = $(elem);

                            $('[data-has-student-view-separator]').text('You are in Student View');
                            $('[data-has-student-view-meta]').text('Student view')
                                .removeClass()
                                .addClass('icon-staff-students');

                            $elem.find('[data-has-student-view-label]').text('Switch to Teacher View');
                            $elem.find('[data-has-student-view-icon]').attr('name', 'teacher');
                            $elem.attr('data-has-student-view', 'student');

                            $('#lessonPlan-staff').hide();
                            $('#lessonPlan-student').show();
                            document.dispatchEvent(new CustomEvent("LESSON-PLAN__TO_STUDENT_VIEW"));
                        }


                        /**
                         * Enable staff view of a Lesson Plan
                         */
                        function lessonPlanStaffView(elem) {
                            const $elem = $(elem);

                            $('[data-has-student-view-separator]').text('You are in Teacher View');
                            $('[data-has-student-view-meta]').text('Teacher view')
                                .removeClass()
                                .addClass('icon-teacher');

                            $elem.find('[data-has-student-view-label]').text('Switch to Student View');
                            $elem.find('[data-has-student-view-icon]').attr('name', 'staff-students');
                            $elem.attr('data-has-student-view', 'staff');

                            $('#lessonPlan-staff').show();
                            $('#lessonPlan-student').hide();
                            document.dispatchEvent(new CustomEvent("LESSON-PLAN__TO_STAFF_VIEW"));
                        }

                        /* Update the meta only when you're toggling views,
                         * so students see an authentic representation
                         */
                        lessonPlanStaffView($(this));

                        $('[data-has-student-view]').on('click', function() {
                            if ($(this).attr('data-has-student-view') == 'staff') {
                                lessonPlanStudentView($(this));
                            } else {
                                lessonPlanStaffView($(this));
                            }

                            window.dispatchEvent(new Event('resize'));
                        });
                    });
                </script>
            {% endif %}
        {% endif %}
    </ul>
{% endif %}
