{##
 # modifyTot
 #
 # A shared tot menu that became available when an instructor could either view the assessment's Status screen
 # or modify the assessment details itself. It's since expanded to also become available for students when they
 # can showcase assessments to their eportfolio.
 #
 # @param string        $viewRoute              the route to the Status screen, for instructors
 # @param string        $modifyRoute            the route to the Modify Assessment screen, for instructors
 # @param string|null   $similarityReportRoute  (optional) the route to the Similarity Report for this Due Work
 # @param bool          $canShowcase            a boolean for students' ability to Showcase to their eportfolio
 # @param bool          $isShowcased            whether this assessment is already showcased on a user's eportfolio
 # @param array         $externalRedirectUrl    A third party redirect url/application name tuple (url, name)
 #}
{% if viewRoute or modifyRoute or (similarityReportRoute is defined and similarityReportRoute) or (canShowcase is defined and canShowcase) or (externalRedirectUrl is defined and externalRedirectUrl) %}
    <nav>
        {% if externalRedirectUrl is defined and externalRedirectUrl %}
            <a href="{{ externalRedirectUrl.url }}" class="icon-view alert" title="{{ externalRedirectUrl.name }}"></a>
        {% endif %}
        <a href="#" class="icon-more" data-dropdown="header-options" title="Actions"></a>
    </nav>
    <ul data-dropdown-content id="header-options" class="f-dropdown">
        {% if viewRoute %}
            <li><a class="icon-progress" href="{{ viewRoute }}">View Status</a></li>
        {% endif %}

        {# Students must have ePortfolio enabled, otherwise they can't do this
         #}
        {% if canShowcase %}
            <li>
                {% if isShowcased %}
                    {% if USER.id == student.id %}
                        <a class="icon-showcase" data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" data-publish-state='0' title="Remove from ePortfolio">Remove from ePortfolio</a>
                    {% else %}
                        <a class="icon-showcase" data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" data-publish-state='0' title="Remove from {{ student.firstname }}'s ePortfolio">Remove from {{ student.firstname }}'s ePortfolio</a>
                    {% endif %}
                {% else %}
                    {# Decide if you're publishing to your own eportfolio
                     # or if you're publishing on behalf of a student to *their* eportfolio
                     #}
                    {% if USER.id == student.id %}
                        <a class="icon-showcase" data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" data-publish-state='1' title="Publish to ePortfolio">Publish to ePortfolio</a>
                    {% else %}
                        <a class="icon-showcase" data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" data-publish-state='1' title="Publish to {{ student.firstname }}'s ePortfolio">Publish to {{ student.firstname }}'s ePortfolio</a>
                    {% endif %}
                {% endif %}
            </li>

            <script src="{{ CDN_PREFIX }}/js/eportfolio/jquery.eportfolio.js"></script>
            <script type="text/javascript">
                $(function () {
                    $('[data-publish-to-eportfolio]').eportfolioPublish({
                        userId: '{{ student.id }}',

                        {# Managing profile data on behalf of somene else's eportfolio
                         # means you supply a different dialog string
                         #}
                        {% if USER.id != student.id %}
                            publish: {
                                text: "Are you sure you want to publish this work to {{ student.firstname }}'s ePortfolio showcase? This will make the work visible to everyone.",
                                action: 'publish'
                            },
                            unpublish: {
                                text: "Are you sure you want to remove this work from {{ student.firstname }}'s ePortfolio showcase?",
                                action: 'unpublish'
                            }
                        {% endif %}
                    });
                });
            </script>
        {% endif %}
        {% if modifyRoute %}
            <li><a href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-modify">Modify</a></li>
        {% endif %}
        {% if similarityReportRoute is defined and similarityReportRoute %}
            <li><a href="{{ similarityReportRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-due-work">Similarity Report</a></li>
        {% endif %}
    </ul>
{% endif %}
