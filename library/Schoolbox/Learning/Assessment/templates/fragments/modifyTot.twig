{##
 # modifyTot
 #
 # A shared tot menu that became available when an instructor could either view the assessment's Status screen
 # or modify the assessment details itself. It's since expanded to also become available for students when they
 # can showcase assessments to their eportfolio.
 #
 # @param string viewRoute    the route to the Status screen, for instructors
 # @param string modifyRoute  the route to the Modify Assessment screen, for instructors
 # @param bool   canShowcase  a boolean for students' ability to Showcase to their eportfolio
 # @param bool   isShowcased  whether this assessment is already showcased on a user's eportfolio
 #}
{% if viewRoute or modifyRoute or (canShowcase is defined and canShowcase) %}
    <nav>
        <a href="#" class="icon-more" data-dropdown="header-options" title="Actions"></a>
    </nav>
    <ul data-dropdown-content id="header-options" class="f-dropdown">
        {% if viewRoute %}
            <li><a class="icon-progress" href="{{ viewRoute }}">View Status</a></li>
        {% endif %}

        {# Students must have ePortfolio enabled, otherwise they can't do this
         #}
        {% if canShowcase %}
            <li>
                {% if isShowcased %}
                    <a class="icon-showcase" data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" data-publish-state='0' title="Remove from ePortfolio">Remove from ePortfolio</a>
                {% else %}
                    <a class="icon-showcase" data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0" data-publish-state='1' title="Publish to ePortfolio">Publish to ePortfolio</a>
                {% endif %}
            </li>

            <script src="{{ CDN_PREFIX }}/javascript/shared/eportfolio/jquery.eportfolio.js"></script>
            <script type="text/javascript">
                $(function () {
                    $('[data-publish-to-eportfolio]').eportfolioPublish({
                        userId: '{{ student.id }}'
                    });
                });
            </script>
        {% endif %}
        {% if modifyRoute %}
            <li><a href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-modify">Modify</a></li>
        {% endif %}
    </ul>
{% endif %}
