{# usage:
    - user:        (User)   object, typically derived from Participant
    - statusClass: (string) one of [ incomplete, pending, complete ]
    - statusText:  (string) caption to display next to status indicator
    - statusTip:   (string) tooltip for status indicator
    - cardSize:    (string) sizing for foundation
 #}
<div class="{{ cardSize ?: 'small-12' }} card">
    <a href="/search/user/{{ participant.user.id }}" title="View Profile">
        <img src="/portrait.php?userId={{ participant.user.externalId }}&amp;size=square64" />
    </a>
    {% if not participant.user.deleted %}
        <h3>
            <a href="/search/user/{{ participant.user.id }}" title="View Profile">{{ participant.user.fullName }}</a>
            {% if not participant.plan.isDynamic %}
                <span class="individualisation has-tip tip-top" data-tooltip title="{{ participant.plan.name}} ({{ participant.plan.duedate.short}})">i</span>
            {% endif %}
        </h3>
    {% else %}
        <h3>{{ participant.user.fullName }}</h3>
    {% endif %}
    <p class="meta">
        <span title="{{ statusTip }}" data-status class="progress-tick tiny {{ statusClass }}"></span>
        <span data-status-label>{{ statusText }}</span>
    </p>
</div>

