{# usage:
    - user:        (User)   object, typically derived from Participant
    - statusClass: (string) one of [ incomplete, pending, complete ]
    - statusText:  (string) caption to display next to status indicator
    - statusTip:   (string) tooltip for status indicator
    - cardSize:    (string) sizing for foundation
 #}
<div class="{{ cardSize ?: 'small-12' }} card">
    <a href="/search/user/{{ user.id }}" title="View Profile">
        <img src="/portrait.php?userId={{ user.externalId }}&amp;size=square64" />
    </a>
    <h3><a href="/search/user/{{ user.id }}" title="View Profile">{{ user.fullName }}</a></h3>
    <p class="meta">
        <span title="{{ statusTip }}" data-status class="progress-tick tiny {{ statusClass }}"></span>
        <span>{{ statusText }}</span>
    </p>
</div>

