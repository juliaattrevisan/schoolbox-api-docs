{##
 # weight
 #
 # An input field corresponding to a mathematical weighting associated with this assessment
 # Also takes an arg to decide if it is readonly
 #
 # @param IAssessable $assessment
 # @param bool $courseManagedReadonly
 #}
<label>
    Weight <span data-tooltip class="hint has-tip tip-top"  title="This value indicates how much this assessment's outcome contributes to the final overall grade - a value of 0 indicates this assessment has no impact on the overall grade. Generally, this is a number between 0 and 100.">?</span>
    <input type="number" inputmode="numeric" name="weight" value="{{ assessment.weight }}" {% if courseManagedReadonly ?? false %}readonly{% endif %}>
</label>
