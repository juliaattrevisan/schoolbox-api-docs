{##
 # Required variables:
 #    allWorkTypes
 #    assessment
 #    courseManaged
 ##}
<label for="workTypeSelector" class="required">Work Type</label>
{#
 # Note Mozilla documentation (as of 2024-03-21) says the 'readonly' attribute does not apply to the select element, but it does in fact apply.
 #  * For readonly selectors, the user cannot change the selected option, but can click on the selector to see the other options.
 #  * For disabled selectors, the user cannot change the selected option, and cannot click on the selector to see the other options.
 # https://developer.mozilla.org/en-US/docs/Web/HTML/Attributes/readonly
 #}
<select id="workTypeSelector" name="workType" {% if assessment.familyName == 'dueWork' and courseManaged.isReadonly %}readonly{% else %}required{% endif %}>
    {% for workType in allWorkTypes %}
        {#
         # Display the option if:
         #  * it is not the 'None' option OR
         #  * we are creating a new assessment (in which case use the text 'Please select a work type' instead of 'None') OR
         #  * the current work type is 'None' (assessments used to be allowed to have no work type)
         #}
        {% if not workType.isNone or not assessment.workType or assessment.workType.isNone %}
            <option value="{{ workType.id }}"
                {% if assessment.workType.id ?? '' == workType.id or (workType.isNone and not assessment.workType) %}
                    selected="selected"
                {% else %}
                    {% if workType.isNone or courseManaged.isReadonly %}disabled{% endif %}
                {% endif %}
            >{% if workType.isNone and not assessment.workType %}Please select a work type{% else %}{{ workType.name }}{% endif %}</option>
        {% endif %}
    {% endfor %}
</select>
