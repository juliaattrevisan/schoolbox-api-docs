{##
 # Required variables:
 #    allWorkTypes
 #    assessment
 #    courseManaged
 ##}
{% set selectIsDisabled = assessment.familyName == 'dueWork' and courseManaged.isReadonly %}
<label for="workTypeSelector" {% if not selectIsDisabled %}class="required"{% endif %}>Work Type</label>
<select id="workTypeSelector" name="workType" data-test="assessment-form-select-workType" {% if selectIsDisabled %}disabled{% else %}required{% endif %}>
    <option value="" disabled{% if not assessment.workType %} selected="selected"{% endif %}>Select work type</option>
    {% for workType in allWorkTypes %}
        <option value="{{ workType.id }}"
            data-visible-to-learners="{{ workType.isVisibleToLearners ? '1' : '0' }}"
            data-visible-to-parents="{{ workType.isVisibleToParents ? '1' : '0' }}"
            {% if assessment.workType.id ?? '' == workType.id %}selected="selected"{% endif %}
            {% if courseManaged.isReadonly %}disabled{% endif %}
        >{{ workType.name }}</option>
    {% endfor %}
</select>
<div class="alert-box" data-work-type-visibility-alert style="display:none"></div>
<script>
    (function() {
        const script = document.currentScript;

        $(function() {
            const selector = document.getElementById("workTypeSelector");
            const alert = script ? script.previousElementSibling : document.querySelector("[data-work-type-visibility-alert]");
            const messages = {
                "1:1": {{ ("This work type sets the " ~ locale.activity.proper ~ " Audience to staff, students, and parents (they can access this " ~ locale.activity ~ "). Feedback Visibility is configured separately.")|json_encode|raw }},
                "1:0": {{ ("This work type sets the " ~ locale.activity.proper ~ " Audience to staff and students. Parents cannot access this " ~ locale.activity ~ " or view any feedback. Feedback Visibility is configured separately and options including parents will have no effect.")|json_encode|raw }},
                "0:1": {{ ("This work type sets the " ~ locale.activity.proper ~ " Audience to staff and parents. Students cannot access this " ~ locale.activity ~ " or view any feedback. Feedback Visibility is configured separately and options including students will have no effect.")|json_encode|raw }},
                "0:0": {{ ("This work type sets the " ~ locale.activity.proper ~ " Audience to staff only. Students and parents cannot access this " ~ locale.activity ~ " or view any feedback. Feedback Visibility is configured separately and options including students or parents will have no effect.")|json_encode|raw }},
            };

            function updateWorkTypeVisibilityAlert() {
                const option = selector.options[selector.selectedIndex];
                const message = option
                    ? messages[option.dataset.visibleToLearners + ":" + option.dataset.visibleToParents]
                    : "";

                alert.textContent = message || "";
                alert.style.display = message ? "" : "none";
            }

            if (!selector || !alert) {
                return;
            }

            selector.addEventListener("change", updateWorkTypeVisibilityAlert);
            updateWorkTypeVisibilityAlert();
        });
    }());
</script>
{% if selectIsDisabled %}

{# The workType selector is a required field, so if the select is disabled it must be replaced by a hidden input.
 # (Disabled fields are not included in form submissions.)
 #}
<input type="hidden" name="workType" value="{{ assessment.workType.id ?? '' }}"/>
{% endif %}
