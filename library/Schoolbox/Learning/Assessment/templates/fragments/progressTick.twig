{##
 # @learningAssessment/fragments/progressTick.twig
 #
 # Params:
 # * assessment:  IAssessable  - The assessment object
 # * participant: Participant  - The participant object
 # * writable:    bool        -  Whether the viewee can change the assessment's marking state
 #                               For teacher, it should be false if teacher lacks write+ perm to class folder
 #                               since this fragment is also used in the Markbook
 #}

{# Hide the grey square where you can't do anything #}
{% set canInteract = false %}

{# Assessments that are open might require interaction from students #}
{% if assessment is task and (assessment.isOpen and assessment.isSelfAssessable) or writable %}
    {# Task that are self-assessed require interaction from students #}
    {% set canInteract = true %}
{% endif %}

{# If you can see the button, decide what it can do
 # and how it displays - it might be displayed in a
 # read-only (non-interactive) manner on the Markbook
 #}

{# Tasks have inline interaction #}
{% if writable %}
    {% set postRoute = routeLookup('learningAssessment.postCreateResponse', {assessmentId: assessment.id, participant: participant, studentId: participant.user.id}) %}
{% elseif canInteract %}
    {% set postRoute = routeLookupIfAuthorized('learningAssessment.postCreateResponse', {assessmentId: assessment.id, participant: participant, studentId: participant.user.id}) %}
{% endif %}

{% if canInteract and postRoute %}
    <form action="{{ postRoute }}"
          method="POST"
          class="progress-tick-form"
          data-progress-tick-form="{{ assessment.isSelfAssessable ? 'selfAssessed' : 'teacherAssessed' }}">
        {% if participant.isResponseRequired %}
            <a href="#"
               disabled
               class="no-text progress-tick"
               title="Incomplete"
               data-progress-tick-status="incomplete"></a>
        {% elseif participant.isFeedbackRequired %}
            <a href="#"
               disabled
               class="no-text progress-tick pending"
               title="Self-assessed"
               data-progress-tick-status="selfAssessed"></a>
        {% elseif participant.isReviewComplete %}
            <a href="#"
               disabled
               class="no-text progress-tick reviewed"
               title="Completed"
               data-progress-tick-status="teacherAssessed"></a>
        {% endif %}
    </form>
{% else %}
    {% if participant.isResponseRequired %}
        <!-- deliberately empty  -->
    {% elseif participant.isFeedbackRequired %}
        <span class="no-text progress-tick pending" title="Awaiting Feedback"></span>
    {% elseif participant.isReviewComplete %}
        <span class="no-text progress-tick reviewed" title="Complete"></span>
    {% endif %}
{% endif %}



