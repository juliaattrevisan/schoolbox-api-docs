{##
 # @learningAssessment/fragments/progressTick.twig
 #
 # Params:
 # * assessment:  IAssessable  - The assessment object
 # * student:     User         - The relevant student
 #}

{# Only set this var if the assessment is a task so participants can create a
 # response asychronously without reloading the page. This only applies to Tasks.
 # Due Work and Quiz require more indepth workflows to submit a Response.
 #}
{% set postRoute = null %}

{% if assessment is task and assessment.isImplementation %}
    {% set postRoute = routeLookupIfAuthorized('learningAssessment.postCreateResponse', {
        assessment:   assessment,
        assessmentId: assessment.id,
        student:      student,
        studentId:    student.id
    }) %}
{% endif %}

{# Find the user's participation record
 #
 # This is used to find out a user's current progress in an assessment,
 # such as whether they need to create a Response or what their latest
 # Feedback status happens to be
 #}
{% set participant = assessment.participantIfExtant(student) %}
{% set isOpenForStudent = postRoute and (student.id == USER.id) and assessment.isOpen(USER) %}
{# Tasks only #}
{% if postRoute is not null and postRoute != '' %}
    <form action="{{ postRoute }}"
          method="POST"
          class="progress-tick-form"
          data-progress-tick-form="{{ assessment.isSelfAssessable ?? false ? 'selfAssessed' : 'teacherAssessed' }}">
        {% if participant and participant.isResponseRequired and (USER.role.isStaff or (isOpenForStudent and assessment.isSelfAssessable)) %}
            <a class="no-text progress-tick"
               title="Incomplete"
               data-progress-tick-status="incomplete"></a>
        {% elseif participant and participant.isFeedbackRequired %}
            <a class="no-text progress-tick pending"
               title="Self-assessed"
               data-progress-tick-status="selfAssessed"></a>
        {% elseif participant and participant.isReviewComplete %}
            <a class="no-text progress-tick reviewed"
               title="Completed"
               data-progress-tick-status="teacherAssessed"></a>
        {% endif %}
    </form>
{% else %}
    {# Other assessment types just get an icon that does nothing when clicked. #}
    {% if not participant or participant.isExcluded %}
        <!-- deliberately empty  -->
    {% else %}
        {% if participant.isResponseRequired and isOpenForStudent %}
            <span class="no-text progress-tick" title="Incomplete"></span>
        {% elseif participant.isFeedbackRequired %}
            <span class="no-text progress-tick pending" title="Awaiting Feedback"></span>
        {% elseif participant.isResubmissionRequired %}
            <span class="no-text progress-tick failed" title="Resubmission Required"></span>
        {% elseif participant.isReviewComplete %}
            <span class="no-text progress-tick reviewed" title="Completed"></span>
        {% endif %}
    {% endif %}
{% endif %}



