{##
 # @learningAssessment/fragments/progressTick.twig
 #
 # Params:
 # * assessment:  IAssessable  - The assessment object
 # * participant: Participant  - The participant object
 # * disabled:    bool         - Whether the viewee can change the assessment's marking state
 #                               For teacher, it should be disabled if teacher lacks write+ perm to class folder
 #                               since this fragment is also used in the Markbook
 #
 #}

{# Hide the grey square where you can't do anything #}
{% set canSeeButton = false %}

{# Project status is always made visible as it has no open states
 # and its status is determined by the activities contained within
 #}
{% if assessment is project %}
    {% set canSeeButton = true %}
{% else %}

    {# Assessments that are open might require interaction from students #}
    {% if assessment.isOpen %}

        {# Task that are self-assessed require interaction from students #}
        {# Due Work and Quiz can always see the button #}
        {% if assessment is task %}
            {% if assessment.isSelfAssessable %}
                {% set canSeeButton = true %}
            {% endif %}
        {% else %}
            {% set canSeeButton = true %}
        {% endif %}
    {% endif %}
{% endif %}

{% if canSeeButton %}

    {# Tasks have inline interaction #}
    {% if assessment is task %}
        {% set postRoute = routeLookupIfAuthorized('learningAssessment.postCreateResponse', {assessmentId: assessment.id, studentId: participant.user.id}) %}

        {% if postRoute %}
            <form action="{{ postRoute }}"
                  method="POST"
                  class="progress-tick-form"
                  data-progress-tick-form="{{ assessment.isSelfAssessable ? 'selfAssessed' : 'teacherAssessed' }}">
                {% if participant.isResponseRequired %}
                    <a href="#"
                       disabled
                       class="no-text progress-tick {% if disabled %}disabled{% endif %}"
                       title="Incomplete"
                       data-progress-tick-status="incomplete"></a>
                {% elseif participant.isFeedbackRequired %}
                    <a href="#"
                       disabled
                       class="no-text progress-tick pending {% if disabled %}disabled{% endif %}"
                       title="Self-assessed"
                       data-progress-tick-status="selfAssessed"></a>
                {% elseif participant.isReviewComplete %}
                    <a href="#"
                       disabled
                       class="no-text progress-tick reviewed {% if disabled %}disabled{% endif %}"
                       title="Completed"
                       data-progress-tick-status="teacherAssessed"></a>
                {% endif %}
            </form>
        {% endif %}
    {% else %}
        {% if participant.isResponseRequired %}
            <span class="no-text progress-tick" title="Response Required"></span>
        {% elseif participant.isFeedbackRequired %}
            <span class="no-text progress-tick pending" title="Awaiting Feedback"></span>
        {% elseif participant.isReviewComplete %}
            <span class="no-text progress-tick reviewed" title="Complete"></span>
        {% endif %}
    {% endif %}
{% endif %}



