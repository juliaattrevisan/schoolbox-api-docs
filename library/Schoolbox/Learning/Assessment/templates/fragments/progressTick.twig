{##
 # @learningAssessment/fragments/progressTick.twig
 #
 # Params:
 # * assessment:  IAssessable      - The assessment object
 # * student:     User             - The relevant student
 # * viewer:      User  (optional) - The user whose visibility rules apply. Defaults to the
 #                                   logged-in USER. Pass the effective viewer here so staff
 #                                   impersonating a student/parent see that role's affordances.
 # * readonly:    bool  (optional) - Whether to render static status only, even if the logged-in
 #                                   user is authorized to update the task.
 #}

{% set viewer = viewer is defined ? viewer : USER %}
{% set readonly = readonly is defined ? readonly : false %}

{# Find the user's participation record
 #
 # This is used to find out a user's current progress in an assessment,
 # such as whether they need to create a Response or what their latest
 # Feedback status happens to be.
 #}
{% set participant = assessment.participantIfExtant(student) %}

{% if participant and not participant.isExcluded %}

    {# The purpose of the postRoute is so participants can create a response asychronously without reloading the page. #}
    {# This only applies to Tasks.  Due-work and quiz require more in-depth workflows to submit a response. #}
    {% set postRoute = null %}
    {% if assessment is task and assessment.isImplementation %}
        {% set postRoute = routeLookupIfAuthorized('learningAssessment.postCreateResponse', {
            assessment:   assessment,
            assessmentId: assessment.id,
            student:      student,
            studentId:    student.id
        }) %}
    {% endif %}

    {# The 'incomplete' status should only be shown to students for self-assessable tasks.  Always show to staff however. #}
    {% set loggedInUserShouldSeeIncompleteStatus = (
        participant.isResponseRequired and (
            viewer.role.isStaff or (
            viewer.id == student.id and
                assessment is task and
                assessment.isOpen(viewer) and
                assessment.isSelfAssessable
            )
        )
    ) %}

    {% if postRoute and not readonly %} {# Note routeLookupIfAuthorized() can return '', so postRoute can be either '' or null. #}
        {# The progress tick is a button for tasks for which the logged-in user is authorized to change the status. #}

        <form action="{{ postRoute }}"
         method="POST"
         class="progress-tick-form"
         data-progress-tick-form="{{ assessment.isSelfAssessable ?? false ? 'selfAssessed' : 'teacherAssessed' }}">
            {% if loggedInUserShouldSeeIncompleteStatus %}
                <a class="no-text progress-tick incomplete" title="Incomplete" data-progress-tick-status="incomplete" data-test='tick-{{assessment.title}}'></a>
            {% elseif participant.isFeedbackRequired %}
                <a class="no-text progress-tick pending" title="Self-assessed" data-progress-tick-status="selfAssessed" data-test='tick-{{assessment.title}}'></a>
            {% elseif participant.isReviewComplete %}
                <a class="no-text progress-tick reviewed" title="Completed" data-progress-tick-status="teacherAssessed" data-test='tick-{{assessment.title}}'></a>
            {% endif %}
        </form>
    {% else %}
        {# The progress tick for non-tasks is just an icon.  Clicking on the icon does nothing. #}

        {# Note the detailRoute is used here for permission purposes only. #}
        {# If the user has access to the detailRoute, they get to see the progress tick. #}
        {% set detailRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {
            assessment:   assessment,
            assessmentId: assessment.id,
            student:      student,
            studentId:    student.id
        }) %}
        {% if detailRoute is not null and detailRoute != '' %}
            {% set currentStatus = null %}
            {% if assessment is dialogAgent %}
                {# dialog agent has a helpful method to grab the status, just use that #}
                {% set authResponse = assessment.getAuthoritativeResponse(participant, false) %}
                {% if authResponse %}
                    {% set currentStatus = authResponse.currentStatus %}
                {% endif %}
            {% endif %}

            {% if loggedInUserShouldSeeIncompleteStatus %}
                <span class="no-text progress-tick incomplete" title="Incomplete"></span>
            {% elseif currentStatus %}
                <span class="no-text progress-tick {{ currentStatus.progressTickClass }}" title="{{ currentStatus.translate }}"></span>
            {% elseif participant.isFeedbackRequired %}
                <span class="no-text progress-tick pending" title="Awaiting Feedback"></span>
            {% elseif participant.isResubmissionRequired %}
                <span class="no-text progress-tick failed" title="Resubmission Required"></span>
            {% elseif participant.isReviewComplete %}
                <span class="no-text progress-tick reviewed" title="Completed"></span>
            {% endif %}
        {% endif %}
    {% endif %}
{% endif %}
