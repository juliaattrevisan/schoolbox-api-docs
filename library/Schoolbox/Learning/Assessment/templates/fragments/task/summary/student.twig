{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/meta.twig' with {assessment: assessment, user: USER, icon: 'icon-task'} %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/fragments/task/summary/description.twig' with {assessment: assessment, user: USER, preview: preview} %}
    </div>
</div>


{# student submit form #}
{% set participant         = assessment.getParticipant(student) %}
{% set mostRecentFeedback  = participant.findMostRecentPublishedFeedback %}
{% set isViewingOwnSummary = participant.user.id == USER.id %}
{% set reviewer            = mostRecentFeedback.submittedBy %}
{% set reviewerName        = reviewer.id == student.id and student.id == USER.id ? 'You' : reviewer.fullName %}

<div class="row">
    <div class="small-12 island">
        <section>
            <ul class="information-list">
                <li>
                    {# Student's completion of this task #}
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="/search/user/{{ participant.user.id }}" title="View Profile">
                                <img src="/portrait.php?userId={{ participant.user.externalId }}&amp;size=square64"
                                     alt="{{ participant.user.formatName }}"
                                     class="hide-for-small-only">
                                <p>{{ participant.user.formatName }}</p>

                                <p class="meta">
                                    {# No marks yet ? #}
                                    {% if not participant.allResponses | length %}
                                        {# Is this task self-assessable ? #}
                                        {% if assessment.isSelfAssessed %}
                                            {% if isViewingOwnSummary %}
                                                You {% if assessment.isClosed %}did not complete{% else %}have not completed{% endif %} this task.
                                            {% else %}
                                                has not completed this task.
                                            {% endif %}
                                        {% else %}
                                            {% if isViewingOwnSummary %}
                                                Your teacher has not verified that you have completed this task.
                                            {% else %}
                                                has not been verified as having completed this task.
                                            {% endif %}
                                        {% endif %}
                                    {# Is it marked as incomplete ? #}
                                    {% elseif mostRecentFeedback.isMarkedAsIncomplete %}
                                        {{ reviewerName }} marked this task as incomplete on {{ mostRecentFeedback.publishedAt.short }}.
                                        {# Marked as self-assessed or teacher-assessed #}
                                    {% else %}
                                        {{ reviewerName }} marked this task as complete on {{ mostRecentFeedback.publishedAt.short }}.
                                    {% endif %}
                                </p>
                            </a>
                        </div>
                    </div>

                    {# Has teacher confirmed this is complete? #}
                    {% if mostRecentFeedback.isMarkedAsTeacherAssessed %}
                        <ul class="information-list reply">
                            <li class="list-item">
                                <div class="card small-12">
                                    <a href="/search/user/{{ mostRecentFeedback.reviewer.id }}" title="View Profile">
                                        <img src="/portrait.php?userId={{ mostRecentFeedback.reviewer.externalId }}&amp;size=square64"
                                             alt="{{ mostRecentFeedback.reviewer.formatName }}"
                                             class="hide-for-small-only">
                                        <p>{{ mostRecentFeedback.reviewer.formatName }}</p>

                                        <p class="meta">
                                            {% if isViewingOwnSummary %}
                                                verified that you have completed this task.
                                            {% else %}
                                                verified this task is complete.
                                            {% endif %}
                                        </p>
                                    </a>
                                </div>
                            </li>
                        </ul>
                    {% endif %}
                </li>
            </ul>
        </section>

        {% set createResponseRoute = routeLookupIfAuthorized('learningAssessment.postCreateResponse', {
            assessmentId: participant.assessable.id,
            studentId:    participant.user.id,
            participant:  participant
        }) %}
        {# If already marked as teacher-assessed, require WRITE+ perm to change. If student, ensure not closed #}
        {% if createResponseRoute and (hasWritePerm or not mostRecentFeedback.isMarkedAsTeacherAssessed) and (hasWritePerm or not participant.assessable.isClosed) %}
            <form action="{{ createResponseRoute }}" method="POST">
                {% if mostRecentFeedback.isMarkedAsIncomplete %}
                    <input type="hidden" name="status" value="{% if USER.id == student.id %}2{% else %}3{% endif %}" />
                    <input type="submit" class="full-width" value="Complete task" />
                {% else %}
                    <input type="hidden" name="status" value="1" />
                    <input type="submit" class="full-width" value="Undo task completion" />
                {% endif %}
            </form>
        {% endif %}
    </div>
</div>
