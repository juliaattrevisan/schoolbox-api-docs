{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/meta.twig' with {assessment: assessment, user: currentUser, icon: 'icon-task'} %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/fragments/task/summary/description.twig' with {assessment: assessment, user: currentUser, preview: preview} %}
    </div>
</div>

{% if assessment.isSelfAssessed %}

    {# student submit form #}
    {% set participant        = assessment.getParticipant(currentUser) %}
    {% set mostRecentFeedback = participant.findMostRecentPublishedFeedback %}

    <form action="{{ routeLookup('learningAssessment.postCreateResponse', {assessmentId: participant.assessable.id, studentId: participant.user.id}) }}"
          method="POST">

        <div class="row">

            <section>
                <div class="card small-12">
                    {% if mostRecentFeedback.isMarkedAsCompleted %}
                        You have completed this task, and teacher has confirmed it
                    {% elseif mostRecentFeedback.isMarkedAsSelfAssessed  %}
                        You have completed this task.
                    {% else %}
                        You have not yet completed this task.
                    {% endif %}
                </div>
            </section>

            <div class="small-12 island">
                {% if mostRecentFeedback.isMarkedAsCompleted or mostRecentFeedback.isMarkedAsSelfAssessed %}
                    <input type="hidden" name="status" value="1" />
                    <input type="submit" class="full-width" value="Mark Task as Not Attempted" />
                {% else %}
                    <input type="hidden" name="status" value="2" />
                    <input type="submit" class="full-width" value="Complete Task" />
                {% endif %}
            </div>
        </div>
    </form>

{% endif %}