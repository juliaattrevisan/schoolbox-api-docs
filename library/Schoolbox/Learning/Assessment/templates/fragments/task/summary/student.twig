{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();
        console.log('mog');
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/fragments/dueWork/summary/meta.twig' with {assessment: assessment, user: currentUser, icon: 'icon-task'} %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/fragments/dueWork/summary/description.twig' with {assessment: assessment, user: currentUser} %}
    </div>
</div>

<div class="row">
    {% if preview.fragment|length %}
    <div class="small-12 island">

        {% if preview.type == 'image' %}
        <a href="{{ preview.fragment }}" data-plugin="preview">
            <img src="{{ preview.fragment }}" data-plugin="preview">
        </a>
        {% elseif preview.type == 'file' %}
        <section>
            <div class="card small-12 compact">
                <a href="/storage/fetch.php?hash={{ preview.file.hash }}">
                    <img src="/ajax/mime/{{ preview.file.mime }}" alt="Preview" class="mime {{ preview.file.mimetype }}" />
                    <p>{{ preview.file.filename }}</p>
                </a>
                <p class="meta">{{ preview.file.size|bytes}}</p>
            </div>
        </section>
        {% elseif preview.type == 'redirect' %}
        <section>
            <div class="card small-12">
                <a href="{{ assessment.url }}">
                    <div class="icon-link"></div>
                    <h3>{{ assessment.title }}</h3>
                    <p class="meta">{{preview.fragment}}</p>
                </a>
            </div>
        </section>
    {% else %}
        {# This usage of raw is because the embedded code is raw html for embedding external content etc using oEmbed or multimedia videos #}
        {{ preview.fragment | raw}}
    {% endif %}
    </div>
{% endif %}
</div>
{% if assessment.isSelfAssessed %}
<div class="row">
    <div class="small-12 island">
        <button class="full-width submit">Task Completed</button>
    </div>
</div>
{% endif %}