{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();
        console.log('mog');
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/fragments/dueWork/summary/meta.twig' with {assessment: assessment, user: currentUser, icon: 'icon-task'} %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/fragments/task/summary/description.twig' with {assessment: assessment, user: currentUser, preview: preview} %}
    </div>
</div>

{% if assessment.isSelfAssessed %}
<div class="row">
    <div class="small-12 island">
        <button class="full-width submit">Task Completed</button>
    </div>
</div>
{% endif %}