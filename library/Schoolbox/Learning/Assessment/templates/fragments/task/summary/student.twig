{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/meta.twig' with {assessment: assessment, user: USER, icon: 'icon-task'} %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/fragments/task/summary/description.twig' with {assessment: assessment, user: USER, preview: preview} %}
    </div>
</div>


{# student submit form #}
{% set mostRecentResponse  = participant.findMostRecentSubmittedResponse %}
{% set isViewingOwnSummary = participant.user.id == USER.id %}
{% set reviewer            = mostRecentResponse.submittedBy %}
{% set reviewerName        = reviewer.id == USER.id ? 'You' : reviewer.fullName %}
{% set COMPLETION_STATUS_INCOMPLETE              = 1 %}
{% set COMPLETION_STATUS_SELF_MARKED_COMPLETE    = 2 %}
{% set COMPLETION_STATUS_TEACHER_MARKED_COMPLETE = 3 %}

<div class="row">
    <div class="small-12 island">
        <section>
            <ul class="information-list">
                <li>
                    {# Student's completion of this task #}
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="/search/user/{{ participant.user.id }}" title="View Profile">
                                <img src="/portrait.php?userId={{ participant.user.externalId }}&amp;size=square64"
                                     alt="{{ participant.user.formatName }}"
                                     class="hide-for-small-only">
                                <p>{{ participant.user.formatName }}</p>

                                <p class="meta">
                                    {# Are there no responses for this participant ? #}
                                    {% if not mostRecentResponse %}

                                        {# Is this task self-assessable ? #}
                                        {% if assessment.isSelfAssessable %}
                                            {% if isViewingOwnSummary %}
                                                You {% if assessment.isPastClose %}did not complete{% else %}have not completed{% endif %} this task.
                                            {% else %}
                                                {% if assessment.isPastClose %}did not complete{% else %}has not completed{% endif %} this task.
                                            {% endif %}
                                        {% else %}
                                            {% if isViewingOwnSummary %}
                                                Your teacher {% if assessment.isPastClose %}did not verify{% else %}has not verified{% endif %} that you have completed this task.
                                            {% else %}
                                                {% if assessment.isPastClose %}was not{% else %}has not been{% endif %} verified as having completed this task.
                                            {% endif %}
                                        {% endif %}
                                    {% else %}
                                    {% if isViewingOwnSummary %}You were{% else %}was{% endif %} marked as
                                    {% if mostRecentResponse.isMarkedComplete %}complete{% else %}incomplete{% endif %} on {{ mostRecentResponse.submittedAt.short }}.
                                    {% endif %}
                                </p>
                            </a>
                        </div>
                    </div>

                    {# Was the task non self assessed ? #}
                    {% if mostRecentResponse and not mostRecentResponse.selfAssessed %}
                        <ul class="information-list reply">
                            <li class="list-item">
                                <div class="card small-12">
                                    <a href="/search/user/{{ mostRecentResponse.submittedBy.id }}" title="View Profile">
                                        <img src="/portrait.php?userId={{ mostRecentResponse.submittedBy.externalId }}&amp;size=square64"
                                             alt="{{ mostRecentResponse.submittedBy.formatName }}"
                                             class="hide-for-small-only">
                                        <p>{{ mostRecentResponse.submittedBy.formatName }}</p>
                                        <p class="meta">
                                            marked {% if isViewingOwnSummary %}you{% else %}this task{% endif %} as
                                            {% if mostRecentResponse.isMarkedComplete %}complete{% else %}incomplete{% endif %}.
                                        </p>
                                    </a>
                                </div>
                            </li>
                        </ul>
                    {% endif %}

                </li>
            </ul>
        </section>

        {% set createResponseRoute = routeLookupIfAuthorized('learningAssessment.postCreateResponse', {
            assessmentId: participant.assessable.id,
            studentId:    participant.user.id,
            participant:  participant
        }) %}
        {# If already marked as teacher-assessed, require WRITE+ perm to change. If student, ensure not closed #}
        {% set isMarkedByTeacherAsComplete = mostRecentResponse.teacherAssessed and mostRecentResponse.markedComplete %}

        {# TODO - this test should be inside the route auth rule #}
        {% if createResponseRoute and (hasWritePerm or (not isMarkedByTeacherAsComplete and participant.assessable.isOpen and assessment.isSelfAssessable)) %}
            <form action="{{ createResponseRoute }}" method="POST">
                {% if mostRecentResponse.markedComplete %}
                    <input type="hidden" name="status" value="{{ COMPLETION_STATUS_INCOMPLETE }}" />
                    <input type="submit" class="full-width" value="Mark as Incomplete" />
                {% else %}
                    {% set completedValue = USER.id == participant.user.id ? COMPLETION_STATUS_SELF_MARKED_COMPLETE : COMPLETION_STATUS_TEACHER_MARKED_COMPLETE %}
                    <input type="hidden" name="status" value="{{ completedValue }}" />
                    <input type="submit" class="full-width" value="Mark as Complete" />
                {% endif %}
            </form>
        {% endif %}
    </div>
</div>
