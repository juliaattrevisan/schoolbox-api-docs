{% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}

<li class="actions-small-1">
    <div class="list-item">
        <div class="card wrap-down small-12">
            <div class="{{ icon.renderClass(assessable.getTypeName) }} icon-32" title="{{ assessable.getTypeName }}"></div>
            <a href="{{ assessable.link }}">
                <h3>
                    {{ assessable.title }}
                </h3>
            </a>
            <p class="meta" title="{{ assessable.getDueAt.getLocal }}">
                Due {{ assessable.getDueAt.getRelativeTime }}
            </p>
        </div>
    </div>
    <nav>
        {% if assessable.isParticipant(student) and (assessable.getParticipant(student).getAllResponses | length) %}
            <a disabled href="#" class="icon-tick no-text" title="Completed"></a>
        {% endif %}
    </nav>
</li>

