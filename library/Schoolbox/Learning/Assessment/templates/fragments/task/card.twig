{% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}

<li class="actions-small-1">
    <div class="list-item">
        <div class="card wrap-down small-12">
            <div class="{{ icon.renderClass(assessable) }} size-32" title="{{ assessable.getTypeName }}"></div>

            <a href="{{ routeLookup('learningAssessment.getAssessment', {assessmentId: assessable.id}) }}">
                <h3 data-assessment-title>{{ assessable.title }}</h3>
            </a>

            <p class="meta" title="{{ assessable.getDueAt.getLocal }}">
                Due {{ assessable.getDueAt.getRelativeTime }}
            </p>
        </div>
    </div>
    <nav>
        {% if assessable.isParticipant(student) %}
            {% include '@learningAssessment/task/progressTickForm.twig' with {participant: assessable.getParticipant(student)} %}
        {% endif %}
    </nav>
</li>

