{##
 # markType
 #
 # Renders two dropdowns corresponding to a set of Mark Type instances
 # and a set of Grade Group instances. The latter conditionally shows,
 # depending on the setting of the former.
 #
 # @param $context            string       A string prefix for namespacing, so you can reuse this fragment in the same template
 # @param $assessment         IAssessable  An assessment instance
 # @param $allMarkTypes       array        tuples for (id, name) of mark types
 # @param $allGradeSchemes    array        tuples for (id, name) of grading schemes
 # @param $selectedMarkType   int|null     The mark type currently selected
 # @param $selectedGradeGroup int|null     The grade group currently selected
 # @param $defaultGradeGroup  int          Set in admin via default_grade_group config var
 # @param $renderMaxMark      bool         True allows the maxMark input field to exist
 # @param $markTypeLabel      string       The label text for the mark type selector
 #}

{# Letter Grade enables Grading Scheme
 # Total Mark enables Maximum Available Marks
 # None turns off mark-per-capability
 #}
{% set markTypeLetterGrade = 2 %}
{% set markTypeTotalMark = 3 %}
{% set markTypeNone = 6 %}

{# Suffix the context with a hyphen, if context was specified
 # This makes ids more bearable to read
 #}
{% if context|length %}
    {% set context = context ~ '-' %}
{% endif %}

<script type="text/javascript" src="{{ CDN_PREFIX }}/javascript/shared/assessment/jquery.markType-gradingScheme.js"></script>
<script>
    $(function() {
        $.fn.markTypeGradingScheme({
            context: '{{ context }}',
            markTypeTotalMark: '{{ markTypeTotalMark }}',
            markTypeLetterGrade: '{{ markTypeLetterGrade }}',
        });
    });
</script>

<div class="row">
    <div class="small-12 medium-6 columns">
        <label>
            {{ markTypeLabel | default('Mark Type') }}
            <select id="{{ context }}markType" name="{{ context }}markType">
                {% for index, title in allMarkTypes %}
                    <option value="{{ index }}"{% if index == (selectedMarkType ?? markTypeNone) %} selected{% endif %}>{{ title }}</option>
                {% endfor %}
            </select>
        </label>
    </div>

    {% if renderMaxMark %}
    <div class="small-12 medium-6 columns" style="display:none;" data-max-mark="{{ context }}">
        <label for="{{ context }}maxMark">
            Maximum Available Marks
            <input id="{{ context }}maxMark" type="text" name="{{ context }}maxMark" value="{{ assessment.maxMark ?? '' }}" />
        </label>
    </div>
    {% endif %}

    <div class="small-12 medium-6 columns" style="display:none;" data-grading-scheme="{{ context }}">
        <label for="{{ context }}gradingScheme">{{ locale.grading.proper }} Scheme</label>
        <div class="input-group">
            {% include 'sub/select.twig' with {
                selectData: {
                    id: context ~ 'gradingScheme'
                },
                name: context ~ 'gradingScheme',
                options: allGradeSchemes,
                preselected: selectedGradeGroup ?: defaultGradeGroup,
                pairs: {
                    value: 'id',
                    label: 'name'
                }
            } %}
            <button type="button" class="button" data-reveal-id="{{ context }}gradeScale">Show {{ locale.grades.proper }} Scale</button>
        </div>
    </div>
</div>

{# 'Show grade scale' modal #}
<div data-reveal class="reveal-modal" id="{{ context }}gradeScale" role="dialog" aria-hidden="true" aria-labelledby="gradeScaleTitle" aria-describedby="gradeScaleDesc">
    <h2 id="{{ context }}gradeScaleTitle">{# placeholder for scheme name via js #}</h2>
    <div id="{{ context }}gradeScaleDesc">{# placeholder for grade scale via js #}</div>
    <a class="close-reveal-modal" aria-label="Close">
        <span aria-hidden="true">&#215;</span>
    </a>
</div>

{# Store a template for each grade scheme, with a table of its grade levels.
 # These will be used to populate the modal above.
 #}
{% for scheme in allGradeSchemes %}
    <script type="text/template" data-grading-scale="{{ context }}{{ scheme.id }}">
        <div class="scrollable">
            <table>
                <tbody>
                    {% for gradeLevel in scheme.gradeLevels %}

                        <tr>
                            <td>
                                {{ gradeLevel.lowerBound }}{% apply spaceless %}
                                {% if loop.index0 == 0 and gradeLevel.lowerBound != 100 %}
                                    +
                                {% elseif scheme.gradeLevels[loop.index0 - 1] is defined and scheme.gradeLevels[loop.index0 - 1].lowerBound - 0.01 > gradeLevel.lowerBound %}
                                    -{{ scheme.gradeLevels[loop.index0 - 1].lowerBound - 0.01 }}
                                {% endif %}
                            {% endapply %}</td>
                            <td>{{ gradeLevel.caption }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </script>
{% endfor %}
