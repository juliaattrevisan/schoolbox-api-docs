{# Letter Grade enables Grading Scheme
 # Total Mark enables Maximum Available Marks
 #}
{% set markTypeLetterGrade = 2 %}
{% set markTypeTotalMark = 3 %}

<script type="text/javascript">
    $(function() {
        var $markTypeDropdown = $('#markType');
        var $maxMarkDiv = $('[data-max-mark]');
        var $gradeSchemeDiv = $('[data-grading-scheme]');

        /**
         * Show max mark
         */
        function showMaxMark() {
            $maxMarkDiv.show();
        }

        /**
         * Hide max mark
         */
        function hideMaxMark() {
            $maxMarkDiv.hide();
        }

        /**
         * Show grading scheme
         */
        function showGradingScheme() {
            $gradeSchemeDiv.show();

            // Populate the grade scale modal with the default scheme selected
            populateScaleModal();
        }

        /**
         * Hide grading scheme
         */
        function hideGradingScheme() {
            $gradeSchemeDiv.hide();
        }


        /* Mark Type switcher
         */
        $markTypeDropdown.on('change', function () {

            if ($(this).val() == {{ markTypeTotalMark }}) {
                showMaxMark();
            } else {
                hideMaxMark();
            }

            if ($(this).val() == {{ markTypeLetterGrade }}) {
                showGradingScheme();
            } else {
                hideGradingScheme();
            }
        });

        // Initiate
        $markTypeDropdown.trigger('change');

        // Populate the grade scale modal on scheme change
        $('#gradingScheme').change(populateScaleModal);

        /**
         * Put a title and grade scale into a modal based on the currently selected scheme
         */
        function populateScaleModal() {
            var $schemeSelect = $('#gradingScheme'),
                schemeName = $schemeSelect.find(':selected').text(),
                schemeId = $schemeSelect.val(),
                schemeTemplate = $('[data-grading-scale=' + schemeId +']').html();

            // Populate the modal title with scheme name
            $('#gradeScaleTitle').text(schemeName);

            // Populate the modal body with the scheme table
            $('#gradeScaleDesc').html(schemeTemplate);
        }
    });
</script>

<div class="row">
    <div class="small-12 medium-6 columns">
        <label>
            Mark Type
            <select id="markType" name="markType">
                {% for index, title in allMarkTypes %}
                    <option value="{{ index }}"{% if index == assessment.markType.id %} selected{% endif %}>{{ title }}</option>
                {% endfor %}
            </select>
        </label>
    </div>


    <div class="small-12 medium-6 columns" style="display:none;" data-max-mark>
        <label for="maxMark">
            Maximum Available Marks
            <input id="maxMark" type="text" name="maxMark" value="{{ assessment.maxMark | number_format(2) }}"/>
        </label>
    </div>

    <div class="small-12 medium-6 columns" style="display:none;" data-grading-scheme>
        <label for="gradingScheme">{{ locale.grading.proper }} Scheme</label>
        <div class="input-group">
            <select name="gradingScheme" id="gradingScheme">
                {% for scheme in allGradeSchemes %}
                    <option value="{{ scheme.id }}"{% if scheme.id == assessment.gradeGroup.id %} selected{% endif %}>{{ scheme.name }}</option>
                {% endfor %}
            </select>
            <button type="button" class="button" data-reveal-id="gradeScale">Show {{ locale.grades.proper }} Scale</button>
        </div>
    </div>
</div>

{# 'Show grade scale' modal #}
<div data-reveal class="reveal-modal" id="gradeScale" role="dialog" aria-hidden="true" aria-labelledby="gradeScaleTitle" aria-describedby="gradeScaleDesc">
    <h2 id="gradeScaleTitle">{# placeholder for scheme name via js #}</h2>
    <div id="gradeScaleDesc">{# placeholder for grade scale via js #}</div>
    <a class="close-reveal-modal" aria-label="Close">
        <span aria-hidden="true">&#215;</span>
    </a>
</div>

{# Store a template for each grade scheme, with a table of its grade levels.
 # These will be used to populate the modal above.
 #}
{% for scheme in allGradeSchemes %}
    {% set gradeLevelsReversed = scheme.gradeLevels|reverse %}
    <script type="text/template" data-grading-scale="{{ scheme.id }}">
        <div class="scrollable">
            <table>
                <tbody>
                    {% for gradeLevel in gradeLevelsReversed %}
                        <tr>
                            <td>
                                {{ gradeLevel.lowerBound }}{% spaceless %}
                                {% if loop.index0 == 0 and gradeLevel.lowerBound != 100 %}
                                    +
                                {% elseif gradeLevelsReversed[loop.index0 - 1].lowerBound - 1 > gradeLevel.lowerBound %}
                                    -{{ gradeLevelsReversed[loop.index0 - 1].lowerBound - 1 }}
                                {% endif %}
                            {% endspaceless %}</td>
                            <td>{{ gradeLevel.caption }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </script>
{% endfor %}
