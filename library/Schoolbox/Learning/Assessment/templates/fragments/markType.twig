{# Letter Grade enables Grading Scheme
 # Total Mark enables Maximum Available Marks
 #}
{% set markTypeLetterGrade = 2 %}
{% set markTypeTotalMark = 3 %}

<script type="text/javascript">
    $(function() {
        var $markTypeDropdown = $('#markType');
        var $maxMarkDiv = $('[data-max-mark]');
        var $gradeSchemeDiv = $('[data-grading-scheme]');

        /**
         * Show max mark
         */
        function showMaxMark() {
            $maxMarkDiv.show();
        }

        /**
         * Hide max mark
         */
        function hideMaxMark() {
            $maxMarkDiv.hide();
        }

        /**
         * Show grading scheme
         */
        function showGradingScheme() {
            $gradeSchemeDiv.show();
        }

        /**
         * Hide grading scheme
         */
        function hideGradingScheme() {
            $gradeSchemeDiv.hide();
        }


        /* Mark Type switcher
         */
        $markTypeDropdown.on('change', function () {

            if ($(this).val() == {{ markTypeTotalMark }}) {
                showMaxMark();
            } else {
                hideMaxMark();
            }

            if ($(this).val() == {{ markTypeLetterGrade }}) {
                showGradingScheme();
            } else {
                hideGradingScheme();
            }
        });

        // Initiate
        $markTypeDropdown.trigger('change');
    });
</script>

<div class="row">
    <div class="small-12 medium-6 columns">
        <label>
            Mark Type
            <select id="markType" name="markType">
                {% for index, title in allMarkTypes %}
                    <option value="{{ index }}"{% if index == assessment.markType.id %} selected{% endif %}>{{ title }}</option>
                {% endfor %}
            </select>
        </label>
    </div>


    <div class="small-12 medium-6 columns" style="display:none;" data-max-mark>
        <label for="maxMark">
            Maximum Available Marks
            <input id="maxMark" type="text" name="maxMark" value="{{ assessment.maxMark }}"/>
        </label>
    </div>

    <div class="small-12 medium-6 columns" style="display:none;" data-grading-scheme>
        <label>
            Grading Scheme
            <select name="gradingScheme">
                {% for scheme in allGradeSchemes %}
                    <option value="{{ scheme.id }}"{% if scheme.id == assessment.gradeGroup.id %} selected{% endif %}>{{ scheme.name }}</option>
                {% endfor %}
            </select>
        </label>
    </div>
</div>
