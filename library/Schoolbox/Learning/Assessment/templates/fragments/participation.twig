{#
    Interface for customising participation and learning plans for an assessment

    Related files:
        JS: www/javascript/shared/assessment/participation.js
        SASS: www/css/foundation/components/assessment/_participation.scss
        Modal: library/Schoolbox/Learning/Assessment/templates/fragments/participationModal.twig
#}
<fieldset id="participation-container">

    <legend>Participation and Learning Plans</legend>

    <label for="participation-enable">
        Customise participation and learning plans?
        <span data-tooltip class="has-tip hint" title="Use this feature to add and remove students from participating in this assessment, or create modified versions for select students.">?</span>
    </label>
    <div class="switch round">
        <input id="participation-enable" type="checkbox">
        <label for="participation-enable">
            <span class="icon-approve"></span>
            <span class="icon-cancel"></span>
        </label>
    </div>

    <div id="participation-settings" class="hide">
        <div class="row">
            <div class="small-12 medium-3 medium-offset-9 column" id="mass-buttons">
                <button class="button expand dropdown" id="customise-dropdown" data-dropdown="customise-options" aria-controls="customise-options" aria-expanded="false" disabled>Actions</button>
                <ul class="f-dropdown" id="customise-options" data-dropdown-content aria-hidden="true">
                    <li class="separator">Student Participation</li>
                    <li><a href="#" data-participant-change="include">Include in assessment</a></li>
                    <li><a href="#" data-participant-change="exclude">Exclude from assessment</a></li>

                    <li class="separator">Learning Plans</li>
                    {% for plan in assessment.plans if not plan.isDynamic %}
                        <li><a href="#" data-plan-use="{{ loop.index }}" data-plan-name="{{ plan.name }}">{{ plan.name }}</a></li>
                    {% endfor %}
                    <li><a href="#" id="participant-customise">Create new plan</a></li>
                </ul>
            </div>
        </div>

        <ul class="information-list card-selectable" id="participants">
            {% for participant in assessment.allParticipants %}
                {% set user = participant.user %}
                {% set userInclude = (not participant.excludedAt) or participant.excludedAt.null %}
                {% set userPlanName = userInclude ? (participant.plan.name ?: '(no customisations)') : '(excluded)' %}

                <li data-participant="{{ user.id }}">
                    <input type="hidden" name="participant-include[{{ user.id }}]" id="participant-include-{{ user.id }}" value="{{ userInclude ? 1 : 0 }}">
                    <input type="hidden" name="participant-plan[{{ user.id }}]" id="participant-plan-{{ user.id }}" value="{{ planIds[participant.plan.id] ?: 0 }}">
                    <div data-participant-row>
                        <div class="selector" data-participant-selector>
                            <input id="participant-{{ user.id }}" type="checkbox" value="1" name="participant[{{ user.id }}]" data-participant-select data-user-id="{{ user.id }}" data-user-name="{{ user.fullName }}">
                            <label for="participant-{{ user.id }}" class="checkbox-label"></label>
                        </div>
                        <div class="small-12 column">
                            <div class="row">
                                <label for="participant-{{ user.id }}" class="checkbox-label">
                                    <div class="small-12 medium-6 columns compact card{{ userInclude ? '' : ' unselected' }}">
                                        <img src="/portrait.php?userId={{ user.externalId }}&amp;size=square32">
                                        <p>{{ user.fullName }}</p>
                                    </div>
                                    <div class="small-12 medium-6 columns meta" data-participant-status>{{ userPlanName }}</div>
                                </label>
                            </div>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>

    </div>
    <div id="plan-data">
    {# load in the existing plans #}
    {% for plan in assessment.plans if not plan.isDynamic %}
        {# this relies on the known twig issue where the loop index increments even if the if condition is not met #}
        <input type="hidden" name="plans[{{ loop.index }}][id]" value="{{ plan.id }}" />
        <input type="hidden" name="plans[{{ loop.index }}][name]" value="{{ plan.name }}" data-saved-plan />
        <input type="hidden" name="plans[{{ loop.index }}][description]" value="{{ plan.description }}" />
        <input type="hidden" name="plans[{{ loop.index }}][publish_date]" value="{{ plan.publishDate.local }}" />
        <input type="hidden" name="plans[{{ loop.index }}][open_date]" value="{{ plan.openDate.local }}" />
        <input type="hidden" name="plans[{{ loop.index }}][due_date]" value="{{ plan.dueDate.local }}" />
        <input type="hidden" name="plans[{{ loop.index }}][close_date]" value="{{ plan.closeDate.local }}" />
    {% endfor %}
    </div>
</fieldset>