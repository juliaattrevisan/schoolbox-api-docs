<fieldset id="participation-container">

    <legend>Participation and Learning Plans</legend>

    <label for="participation-enable">
        Customise participation and learning plans?
        <span data-tooltip class="has-tip hint" title="Use this feature to add and remove students from participating in this assessment, or create modified versions for select students.">?</span>
    </label>
    <div class="switch round">
        <input id="participation-enable" type="checkbox">
        <label for="participation-enable">
            <span class="icon-approve"></span>
            <span class="icon-cancel"></span>
        </label>
    </div>

</fieldset>