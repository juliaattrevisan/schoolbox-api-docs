{#
    Renders out the 'Default Activity Duration' (aka 'Default Open Span') row on an Assessment Create/Update page

    Usage:
        assessment: IAssessable
        context:    AssessmentContext  - (optional) defaults to assessment.context
#}
{% set context = context ?? assessment.context %}

{% if context.baseContext is unitSpecification %}
    <label>
        Activity Duration
        <span class="hint has-tip tip-top" data-tooltip title="Enter the number of days you expect the activity to take. This will be used to automatically populate due dates when importing this course.">?</span>
        <input type="number" inputmode="numeric" min="0" name="default_open_span" value="{{ assessment.defaultOpenSpan }}">
    </label>
{% endif %}
