{#
    Renders out the 'Default Activity Duration' (aka 'Default Open Span') row on an Assessment Create/Update page

    Usage:
        assessment: IAssessable
        context:    AssessmentContext  - (optional) defaults to assessment.context
#}
{% set context = context ?? assessment.context %}

{% if context.baseContext is unitSpecification %}
    <label>
        Activity Duration
        <span class="hint has-tip tip-top" data-tooltip title="Enter the number of minutes you expect the activity to take. This will be used to automatically populate due dates when importing this course.">?</span>
        <input
            type="text"
            value="{{ assessment.defaultOpenSpan }}"
            data-default-open-span-input="{{ assessment.id }}"
            class="activity-duration"
        />
        <input
            type="number"
            inputmode="numeric"
            name="default_open_span"
            data-default-open-span-value="{{ assessment.id }}"
            value="{{ assessment.defaultOpenSpan }}"
            {# This is a hidden field that the below script keeps in sync with the value the user entered above, but as a number in minutes #}
            class="hide"
        >
    </label>

    <script>
    (() => {
        // this comes from alaress-datetime-picker.js
        // todo: put it in a shared location instead
        function denaturalize(text) {
            // normalise any whitespace
            // remove "^in " and " from now$"
            // replace all word-numbers with number-numbers
            // known limitation: 23:00am fails to parse
            // replace / with - so that strtotime recognises D/M/Y instead of heretical M/D/Y format
            return text
                .trim()
                .toLowerCase()
                .replace(/\s+/g, " ")
                .replace(/^in\s+/g, "")
                .replace(/\s+from\s+now$/g, "")
                .replace(/\s+at\s+/g, "")
                .replace(/\s+on\s+/g, "")
                .replace(/,\s/g, "")
                .replace(/zero/g, "0")
                .replace(/one/g, "1")
                .replace(/two/g, "2")
                .replace(/three/g, "3")
                .replace(/four/g, "4")
                .replace(/five/g, "5")
                .replace(/six/g, "6")
                .replace(/seven/g, "7")
                .replace(/eight/g, "8")
                .replace(/nine/g, "9")
                .replace(/ten/g, "10")
                .replace(/eleven/g, "11")
                .replace(/twelve/g, "12")
                .replace(/\//g, "-")
                .replace(/\s+/g, " ");
        }

        /**
         * Converts an arbitrary time span to a duration in minutes relative to the current time
         * Similar to how datepickers are able to parse "in 5 days", "tomorrow", "1 month", etc via alaress-datetime-picker.js
         * @param {string} userInput - The user input to parse (representing an arbitrary time span or date)
         * @returns {number|null} - The duration in minutes, or null if the input is invalid
         */
        function normaliseDurationToMinutes(userInput) {
            // If the user input is just a number, assume it's in minutes
            if (/^-?\d+$/.test(userInput)) {
                return Math.abs(parseFloat(userInput, 10));
            }

            // other replacements i've found - perhaps combine with denaturalize?
            const newUserInput = userInput
                .replace(/\ban\b/g, "1") // replace "an" with "1"
                .replace(/\ba\b/g, "1") // replace "a" with "1"
                .replace(/\band\b/g, ","); // replace "and" with ","

            const normalisedTimestamp = $.fn.strtotime(denaturalize(newUserInput)); // the user's input as a timestamp relative to now
            if (isNaN(normalisedTimestamp) || normalisedTimestamp === false) {
                return null; // invalid input
            }

            const now = dayjs();
            let future = dayjs.unix(normalisedTimestamp);

            // If it switches daylight savings, the diff will be off by an hour - so we need to offset that otherwise it'll keep increasing
            const offsetDiff = future.utcOffset() - now.utcOffset();
            future = future.add(offsetDiff, "minute");

            // Get the difference in minutes between the normalised timestamp and now
            // need to round to the nearest minute because it may be off by a fraction of a second
            // If for some reason someone enters "5 minutes ago" or a date in the past, this will also normalise it to be positive
            return Math.abs(Math.round(future.diff(now, "minute", true)));
        }

        /**
         * Convert a quantity of minutes back into a human-readable time span (e.g. "1 hour 30 minutes")
         * @param {number} minutes - The number of minutes to convert to a human-readable time span
         * @returns {string} - A human-readable time span
         */
        function humanReadableDuration(minutes) {
            const timeUnits = [
                { unit: "week", value: 60 * 24 * 7 },
                { unit: "day", value: 60 * 24 },
                { unit: "hour", value: 60 },
                { unit: "minute", value: 1 },
            ];

            let readable = [];
            let diff = minutes;
            for (const { unit, value } of timeUnits) {
                if (diff >= value) {
                    const count = Math.floor(diff / value);
                    readable.push(`${count} ${unit}${count !== 1 ? "s" : ""}`);
                    diff %= value;
                }
            }

            return readable.join(" ");
        }

        const durationUserInput = document.querySelector("[data-default-open-span-input='{{ assessment.id }}']");
        const durationValueInput = document.querySelector("[data-default-open-span-value='{{ assessment.id }}']");

        /**
         * When the user changes the duration input, update the hidden input with the normalised value and ensure it's >= 0
         */
        function onDurationChanged() {
            if (durationUserInput.value === "") {
                durationValueInput.value = "";
                return;
            }

            // normalise the user input to a duration in minutes, or null if invalid
            const normalisedDuration = normaliseDurationToMinutes(durationUserInput.value);

            if (normalisedDuration === null) {
                // alaress validate will handle this
                durationValueInput.value = -1;
            } else {
                // update the hidden input with the normalised value
                durationValueInput.value = normalisedDuration;
                durationUserInput.value = humanReadableDuration(normalisedDuration);
            }

            $(durationValueInput).valid(); // make alaressValidate notice the change

        }

        durationUserInput.addEventListener("blur", onDurationChanged);
        onDurationChanged(); // set the initial value
    })();
    </script>
{% endif %}
