<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>

<fieldset class="content">
    <legend>
        File Attachments
        <span data-tooltip class="hint has-tip tip-top" title="">?</span>
    </legend>
    <div class="column small-12">
        {% include 'sub/attachzone.twig' %}
    </div>
</fieldset>
<fieldset>
    <div class="small-6 columns">
        <label>
            Mark Type
            <select name="dueWorkMarkType">
                {% for currentMarkType in allMarkTypes %}
                <option value="{{ currentMarkType.id }}">{{ currentMarkType.name }}</option>
                {% endfor %}
            </select>
        </label>
    </div>
    <div class="small-6 columns">
        <label>Grading Scheme
            <select>
                <option>Standard</option>
                <option>Non Standard</option>
            </select>
        </label>
    </div>
    <div class="small-6 columns">
        <label for="dueWorkUseRubric">Use Rubric?</label>
        <div class="switch round">
            <input name="dueWorkUseRubric" id="dueWorkUseRubric" type="checkbox"  />
            <label for="dueWorkUseRubric">
                <span class="icon-approve"></span>
                <span class="icon-cancel"></span>
            </label>
        </div>
    </div>
    <div class="small-6 columns">
        <label for="dueWorkMarkPerCapability">Mark Per-Capability</label>
        <div class="switch round">
            <input name="dueWorkMarkPerCapability" id="dueWorkMarkPerCapability" type="checkbox" />
            <label for="dueWorkMarkPerCapability">
                <span class="icon-approve"></span>
                <span class="icon-cancel"></span>
            </label>
        </div>
    </div>
</fieldset>

<fieldset>
    <div class="rubrics">
        <!--Rubric Here-->
    </div>
</fieldset>
