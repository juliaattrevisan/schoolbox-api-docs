{% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}
{% import '@learning/macro/dueDate.twig' as dueDate %}

<li class="actions-small-1">
    <div class="list-item">
        <div class="card wrap-down small-12">
            <div class="{{ icon.renderClass(assessable) }} size-64" title="{{ assessable.getTypeName }}"></div>
            {% if student %}
                {% set route = routeLookupIfAuthorized('learningAssessment.getSummary',{assessmentId: assessable.id, studentId: student.id, student: student, assessment: assessable}) %}
            {% else %}
                {% set route = routeLookup('learningAssessment.getPreview',{assessmentId: assessable.id}) %}
            {% endif %}
            {% if route %}
            <a href="{{ route }}">
                <h3>{{ assessable.title }}</h3>
            </a>
            {% else %}
                <h3>{{ assessable.title }}</h3>
            {% endif %}
            <p class="meta">
                {{ dueDate.dueDate(assessable, student ?: USER) }}
            </p>
            {% if student %}
                <p><a href="{% if route %}{{ route }}{% else %}#{% endif %}" class="meta">{% include '@learningAssessment/fragments/statusLine.twig' with {assessable: assessable} %}</a></p>
            {% endif %}
        </div>
    </div>
</li>
