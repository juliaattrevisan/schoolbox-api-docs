{% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}
{% import '@learning/macro/urgency.twig' as urgency %}

<li class="actions-small-1">
    <div class="list-item">
        <div class="card wrap-down small-12">
            <div class="{{ icon.renderClass(assessable) }} icon-32" title="{{ assessable.getTypeName }}"></div>

            <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: assessable.id, studentId: student.id})}}">
                <h3>{{ assessable.title }}</h3>
            </a>
            <p class="meta" title="{{ assessable.dueAt.short }}">
                Due <span class="{{ urgency.datetime(assessable, student) }}">{{ assessable.dueAt.relativeTime }}</span>
            </p>
        </div>
    </div>
    <nav>
        {% if assessable.isParticipant(student) %}
            {% if (assessable.getParticipant(student).getAllResponses) | length %}
                {# There has been no response, show blank icon that will allow submission of response #}
                <a href="{{ routeLookup('learningAssessment.getSubmitForm', {assessmentId: assessable.id, studentId: currentUser.id}) }}"
                   class="progress-tick no-text" title="Submit Response{% if type == 'staff' %} On Behalf Of Student{% endif %}"></a>
            {% else %}
                {% if (assessable.getParticipant(student).getAllFeedbacks) | length %}
                    {# No feedback provided, is pending #}
                    <a class="progress-tick no-text pending"></a>
                {% else %}
                    {# No feedback provided, is complete #}
                    <a class="progress-tick no-text complete"></a>
                {% endif %}
            {% endif %}
        {% endif %}
    </nav>
</li>