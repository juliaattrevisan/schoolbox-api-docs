{% import '@learningAssessment/fragments/macro/urgency.twig' as urgency %}

<script type="text/javascript">
    $(function() {
        $('#view-history').on('click', function(event) {
            event.preventDefault();

            $('#history').find('[data-history]').show();

            $(this).remove();
        });
    });
</script>
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Submission History</h2>

        <section>
             <ul id='history' class="information-list threaded">
                 {% for currentInteraction in timeline %}
                     {% if currentInteraction is response %}
                         {% include '@learningAssessment/fragments/dueWork/summary/interaction/response.twig' %}
                     {% elseif currentInteraction is feedback %}
                         {% include '@learningAssessment/fragments/dueWork/summary/interaction/feedback.twig' %}
                     {% endif %}
                 {% endfor %}
            </ul>
        </section>

        {% if assessment.responses|length > 1 %}
        <a id="view-history" class="button icon-add">View {{ assessment.responses|length -1 }} More Submissions</a>
        {% endif %}
    </div>
</div>
