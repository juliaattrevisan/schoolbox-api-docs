{% import '@learning/macro/urgency.twig' as urgency %}

<ul class="meta">
    <li class="icon-calendar">Due <span class="{{ urgency.datetime(assessment, currentUser) }}">{{ assessment.dueAt.short }}</span></li>
    <li class="icon-due-work">{{ assessment.typeName }}</li>

    {% if currentUser.role.isStaff %}
    <li class="icon-staff-students">{{ student.fullname }}</li>
    {% endif %}
</ul>

{% if assessment.description|length %}
<section>
    <article class="content">
        {{ assessment.description | purify }}
    </article>

    {# Attached files
     #}
    {% if assessment.attachedFiles|length %}
        <ul class="information-list">
            {% for currentFile in assessment.attachedFiles %}
                <li>
                    <div class="list-item">
                        <div class="compact card small-12">
                            <a href="/storage/fetch.php?hash={{ currentFile.hash }}">
                                <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" class="mime" />
                                <h3>{{ currentFile.filename }}</h3>
                            </a>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
{% endif %}
