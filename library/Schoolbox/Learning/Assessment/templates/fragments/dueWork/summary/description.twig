<section>
    {% if assessment.description|length %}
        <article class="content">
            {{ assessment.description | purify }}
        </article>
    {% endif %}

    {# Attached files
     #}
    {% if assessment.attachedFiles|length %}
        <ul class="information-list">
            {% for currentFile in assessment.attachedFiles %}
                <li>
                    <div class="card attachment small-12">
                        <a href="/storage/fetch.php?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}">
                            <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" />
                            <p>{{ currentFile.filename }} | <span class="meta">Download</span></p>
                        </a>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
