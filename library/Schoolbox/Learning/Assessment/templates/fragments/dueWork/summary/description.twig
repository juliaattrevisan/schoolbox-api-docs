<section>
    {% if assessment.description|length %}
        <article class="content">
            {{ assessment.description | purify }}
        </article>
    {% endif %}

    {# Attached files
     #}
    {% if assessment.attachedFiles|length %}
        <ul class="information-list">
            {% for currentFile in assessment.attachedFiles %}
                <li>
                    <div class="list-item">
                        <div class="card attachment small-12">
                            <a href="/storage/fetch.php?hash={{ currentFile.hash }}" data-plugin="preview">
                                <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" />
                                <p>{{ currentFile.filename }}</p>
                            </a>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
