<section>
    {% if assessment.description|length %}
        <article class="content">
            {{ assessment.description | purify }}
        </article>
    {% endif %}

    {# Attached files
     #}
    {% if assessment.attachedFiles|length %}
        <ul class="information-list">
            {% for currentFile in assessment.attachedFiles %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="card attachment small-12">
                            <a href="/storage/fetch.php?hash={{ currentFile.hash }}&save=1" title="{{ currentFile.filename }}">
                                <img src="/ajax/mime/{{ currentFile.mime }}" alt="Donwload" />
                                <p>{{ currentFile.filename }}</p>
                            </a>
                        </div>
                    </div>
                    <nav>
                    <nav>
                        <a href="/storage/fetch.php?hash={{ currentFile.hash }}&save=1" title="Download" class="icon-download"></a>
                    </nav>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
