{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        {% include '@learningAssessment/fragments/dueWork/summary/description.twig' with {assessment: assessment, user: currentUser} %}
    </div>
</div>

{% if assessment.hasRubric %}
{% include '@learningAssessment/fragments/dueWork/summary/rubrics.twig' %}
{% endif %}

<div class="row">
    <div class="small-12 columns">
        {% if currentUser.role.isStaff %}
        <a class='submit' href="{{ routeLookup('learningAssessment.getCreateSubmission', { assessmentId: assessment.id, studentId: student.id}) }}">Create Submission on behalf of {{ student.fullname }}</a>
        {% elseif currentUser.role.isStudent %}
        <a class='submit' href="{{ routeLookup('learningAssessment.getCreateSubmission', { assessmentId: assessment.id, studentId: student.id}) }}">Create Submission</a>
        {% endif %}
    </div>
</div>
