{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();
    });
</script>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ participant.assessable.title }}</h1>
            {% include '@learningAssessment/meta.twig' with {assessment: participant.assessable, student: participant.user, user: currentUser, icon: 'icon-due-work'} %}

        </div>
    </div>
    {% set viewRoute = routeLookupIfAuthorized('learningMarkbook.getMarkbook', {class: participant.assessable.context, classId: participant.assessable.context.id}) %}
    {% if viewRoute %}
    <nav>
        <a class="icon-more" title="" data-dropdown="header-options"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        <li class="separator">Grading</li>
        <li><a class="icon-approve" href="{{ viewRoute }}">Markbook</a></li>
    </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/fragments/dueWork/summary/description.twig' with {assessment: participant.assessable, user: currentUser} %}
    </div>
</div>

{% if participant.assessable.useRubric %}
{% include '@learningAssessment/fragments/dueWork/summary/rubric.twig' %}
{% endif %}

{% include '@learningAssessment/fragments/dueWork/history.twig' %}

<div class="row">
    <div class="small-12 columns">
    {% if submissionsBlocked %}
        <div class="empty-state">
            <i class="icon-due-work"></i>
            <p>{{ submissionsBlocked }}</p>
        </div>
    {% else %}
        {% set submitRoute = routeLookupIfAuthorized('learningAssessment.getCreateResponseForm', { assessmentId: participant.assessable.id, studentId: participant.user.id}) %}
        {% if submitRoute %}
            {% set submitText %}{% spaceless %}
                Create submission
                {% if currentUser.role.isStaff %}
                    on behalf of {{ participant.user.fullname }}
                {% endif %}
            {% endspaceless %}{% endset %}
            <a class="submit button expand" href="{{ submitRoute }}">{{ submitText }}</a>
        {% endif %}
    {% endif %}
    </div>
</div>
