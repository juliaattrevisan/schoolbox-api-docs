{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();
    });
</script>

<div class="row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        {% include '@learningAssessment/fragments/dueWork/summary/description.twig' with {assessment: assessment, user: currentUser} %}
    </div>
</div>

{% if assessment.useRubric %}
{% include '@learningAssessment/fragments/dueWork/summary/rubrics.twig' %}
{% endif %}

{% if assessment.responses|length %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Submission History</h2>
        {% for currentResponse in assessment.responses %}

        <h3 class="subheader">{{ currentResponse.submittedAt.short }}</h3>
        <section>
            <ul class="information-list">
                <li>
                    {% if currentResponse.allFiles %}
                    <ul class="information-list">
                        {% for currentFile in currentResponse.allFiles %}
                        <li>
                            <div class="card small-12">
                                <a href="/send.php?id=39" title="{{ currentFile.filename }}" rel="external" data-plugin="preview">
                                    <img src="/images/mime/60x60/{{ currentFile.storage.mimeType.iconFile }}" alt="View Profile" class="mime" />
                                    <p>{{ currentFile.filename }}</p>
                                </a>
                                <p class="meta">{{ currentFile.humanReadableSize }}</p>
                            </div>
                            {% if currentFile.plagscan %}
                                <article class="grade">
                                    <span class="gradient-1">{{ currentFile.plagscan.score|purify }}</span>
                                    <p class="meta">Plagiarism Check</p>
                                </article>
                            {% endif %}
                        </li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </li>
            </ul>
        </section>
        {% endfor %}
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 columns">
    {% if submissionsBlocked %}
        <div class="empty-state">
            <i class="icon-due-work"></i>
            <p>{{ submissionsBlocked }}</p>
        </div>
    {% else %}
        {% set submitRoute = routeLookupIfAuthorized('learningAssessment.getCreateResponseForm', { assessmentId: assessment.id, studentId: student.id}) %}
        {% if submitRoute %}
            {% set submitText %}{% spaceless %}
                Create submission
                {% if currentUser.role.isStaff %}
                    on behalf of {{ student.fullname }}
                {% endif %}
            {% endspaceless %}{% endset %}
            <a class="submit" href="{{ submitRoute }}">{{ submitText }}</a>
        {% endif %}
    {% endif %}
    </div>
</div>
