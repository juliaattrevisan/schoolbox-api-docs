{% if currentInteraction.isPublished %}
<li {% if loop.index > 1 %}style="display:none"{% endif %} data-history-row>
    <div class="list-item">
        <div class="card small-12 medium-8">
            <a href="/search/user/{{ currentInteraction.reviewer.id}}" title="View Profile">
                <img src="/portrait.php?userId={{ currentInteraction.reviewer.externalId }}&amp;size=square64" alt="" class="hide-for-small-only">
                <p>{{ currentInteraction.reviewer.fullname }}</p>
                <p class="meta">Published {{ currentInteraction.publishedAt.short }}</p>
            </a>
        </div>
        <div class="small-12 medium-4 columns text-right">
            <div class="grade content">
                <span class="{{ urgency.marks(currentInteraction.normalisedMark) }}">{{ currentInteraction.humanReadableMark }}</span>
            </div>
        </div>
    </div>

    {% if currentInteraction.comment|length %}
        <article>
            {{ currentInteraction.comment|purify }}
        </article>
    {% endif %}

    {% if currentInteraction.allFiles %}
        <ul class="information-list">
            {% for currentFile in currentInteraction.allFiles %}

                {# Only show published feedback and therefore also
                 # only list files that are involved with a Published Feedback
                 #}
                <li>
                    <div class="card small-12 compact">

                        {# Crocodoc annotations have their own special url.
                         # responseId comes from the twig that includes this fragment
                         #}
                        {% if currentFile.crocodocId|length %}
                            <a href="{{ routeLookup('learningResponse.getCrocodocDownload', {responseId: responseId, feedbackId: currentInteraction.id, fileId: currentFile.id}) }}" rel="external" data-plugin="preview">
                                <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" class="mime" />
                                <p>{{ currentFile.filename }}</p>
                            </a>
                        {% else %}
                            <a href="/storage/fetch.php?hash={{ currentFile.hash }}" rel="external" data-plugin="preview">
                                <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" class="mime" />
                                <p>{{ currentFile.filename }}</p>
                            </a>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</li>
{% endif %}