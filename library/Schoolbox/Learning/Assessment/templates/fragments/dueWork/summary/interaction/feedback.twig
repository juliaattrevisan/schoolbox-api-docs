{% import '@learning/macro/urgency.twig' as urgency %}

{# Associated Feedback
 # Go to Inline Grader to resume
 #
 # Floating Feedback
 # Go to Quickmark to resume
 #}
{% if currentFeedback.response.id %}
    {% if not currentFeedback.isPublished %}
        {% set url = routeLookupIfAuthorized('learningResponse.getParticularResponse', {
            assessmentId: currentFeedback.assessable.id,
            studentId: currentFeedback.response.submittedOnBehalfOf.id,
            responseId: responseId,
            response: currentFeedback.response
        }) %}
        {% set tooltip = 'Resume Inline Grading' %}
    {% endif %}
{% else %}
    {% if not currentFeedback.isPublished %}
        {% set url = routeLookupIfAuthorized('learningAssessment.getStatus', {
            assessmentId: currentFeedback.assessable.id,
            assessment: currentFeedback.assessable
        }) %}
        {% set tooltip = 'Resume Quickmark' %}
    {% endif %}
{% endif %}

<li {% if isOlderInteraction %}style="display:none"{% endif %} data-history-row class="actions-small-1">
    <div class="list-item">
        <div class="card small-12 medium-8">
            {% if url %}
            <a href="{{ url }}" title="{{ tooltip }}">
            {% endif %}
                <img src="/portrait.php?userId={{ currentFeedback.reviewer.externalId }}&amp;size=square64" alt="" class="hide-for-small-only">
                <h3>
                    {% if currentFeedback.published %}
                        Feedback
                    {% else %}
                        Draft Feedback
                    {% endif %}
                </h3>

                <p class="meta">
                    {{ currentFeedback.reviewer.fullname }}

                    {% if currentFeedback.published %}
                        on {{ currentFeedback.publishedAt.short }}
                    {% else %}
                        on {{ currentFeedback.updatedAt.short }}
                    {% endif %}
                </p>
            {% if url %}
            </a>
            {% endif %}
        </div>
        <div class="small-12 medium-4 columns text-right">
            <div class="grade content">
                <span class="{{ urgency.marks(currentFeedback.normalisedMark) }}">{{ currentFeedback.humanReadableMark }}</span>
            </div>
        </div>
    </div>
    {% set deleteRoute = routeLookupIfAuthorized(
        'learningFeedback.deleteAssessmentFeedback',
        {
            assessmentId: participant.assessable.id,
            assessment: participant.assessable,
            feedbackId: currentFeedback.id,
            feedback: currentFeedback,
        }
    ) %}
    {% if deleteRoute %}
    <nav>
        <a class="icon-delete" data-delete="{{ deleteRoute }}"></a>
    </nav>
    {% endif %}

    {% if currentFeedback.comment|length %}
        <article>
            {{ currentFeedback.comment|nl2br }}
        </article>
    {% endif %}

    {% if currentFeedback.allFiles | length %}
        <ul class="information-list">
            {% for currentFile in currentFeedback.allFiles %}

            {# Only show published feedback and therefore also
             # only list files that are involved with a Published Feedback
             #}
            <li class="actions-small-1">
                <div class="list-item">
                    <div class="small-12 card compact">
                        {# Crocodoc annotations have their own special url.
                         # responseId comes from the twig that includes this fragment
                         #}
                        {% if currentFile.crocodocId|length %}
                            {% set crocodocRoute = routeLookupIfAuthorized('learningResponse.getCrocodocView', {assessmentId: currentFeedback.assessable.id, assessment: assessment, responseId: responseId, feedbackId: currentFeedback.id, crocodocId: currentFile.crocodocId, participant: participant}) %}

                            {% if crocodocRoute %}
                                <a href="{{ crocodocRoute }}">
                                    <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" class="mime" />
                                    <p>{{ currentFile.filename }}</p>
                                </a>
                            {% endif %}
                        {% else %}
                            <a href="/storage/fetch.php?hash={{ currentFile.hash }}" rel="external" data-plugin="preview">
                                <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" class="mime" />
                                <p>{{ currentFile.filename }}</p>
                            </a>
                        {% endif %}
                    </div>
                </div>
                {% if currentFile.crocodocId|length %}
                <nav>
                    {% include '@learningResponse/crocodocLink.twig' with {assessment: assessment, feedback: currentFeedback, file: currentFile, participant: participant} only %}
                </nav>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
    {% endif %}
</li>
