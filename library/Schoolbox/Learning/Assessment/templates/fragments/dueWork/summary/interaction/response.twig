{# If staff, try going to Inline Grader #}
{% if currentUser.role.isStaff %}
    {% set url = routeLookupIfAuthorized('learningResponse.getParticularResponse', {assessmentId: currentInteraction.assessable.id, studentId: participant.user.id, responseId: currentInteraction.id, response: currentInteraction}) %}
    {% set tooltip = 'View in Inline Grader' %}
{% elseif currentUser.role.isStudent and not currentInteraction.isSubmitted%}
    {% set url = routeLookupIfAuthorized('learningAssessment.getCreateResponseForm', {assessmentId: currentInteraction.assessable.id, studentId: participant.user.id, assessment: currentInteraction.assessable, participant: participant}) %}
    {% set tooltip = 'Resume Submission' %}
{% endif %}

{% set deleteRoute = routeLookupIfAuthorized('learningResponse.deleteParticularResponse', {assessment: currentInteraction.assessable, assessmentId: currentInteraction.assessable.id, participant: participant, studentId: participant.user.id, responseId: currentInteraction.id, response: currentInteraction}) %}

<li class="actions-small-1" {% if isOlderInteraction %}style="display:none"{% endif %} data-history-row>
    <ul class="action-list">
        <li class="actions-small-1">
            <div class="list-item">
                <div class="card small-12">
                    {% if url %}
                    <a href="{{ url }}" title="{{ tooltip }}">
                    {% endif %}
                        <img src="/portrait.php?userId={{ participant.user.externalId }}&amp;size=square64" alt="{{ participant.user.fullname }}" class="hide-for-small-only">
                        <h3>
                            {% if currentInteraction.isSubmitted %}
                                Submission
                            {% else %}
                                Draft Submission
                            {% endif %}
                        </h3>

                        {% if currentInteraction.isSubmitted %}
                            <p class="meta">{{ participant.user.fullname }} on {{ currentInteraction.submittedAt.short }}</p>
                        {% else %}
                            <p class="meta">Draft last updated {{ currentInteraction.updatedAt.short }}</p>
                        {% endif %}

                    {% if url %}
                    </a>
                    {%  endif %}
                </div>
            </div>
            {% if deleteRoute %}
            <nav>
                <a class="icon-more" title="" data-dropdown="response-options-{{ currentInteraction.id }}"></a>
            </nav>
            <ul id="response-options-{{ currentInteraction.id }}" class="f-dropdown" data-dropdown-content>
                <li><a href="{{ viewRoute }}" class="icon-delete" title="Delete Submission" data-delete="{{ deleteRoute }}">Delete</a></li>
            </ul>
            {% endif %}
        </li>
    </ul>

    {% if currentInteraction.allFiles %}
    <ul class="information-list">
        {% for currentFile in currentInteraction.allFiles %}
        <li class="actions-small-1">
            {% include '@learning/dueWork/interaction/response/files.twig' with {
                assessment: currentInteraction.assessable,
                assessmentId: currentInteraction.assessable.id,
                response: currentInteraction,
                plagscanId: currentFile.plagscan.plagscanId
            } %}
        </li>
        {% endfor %}
    </ul>
    {% endif %}

    {% if currentInteraction.allFeedback|length %}
        <ul class="information-list reply">
            {% for currentFeedback in currentInteraction.allFeedback %}

                {# We pass the responseId as well, so that people can download annotated crocodocs
                 #}
                {% include '@learningAssessment/fragments/dueWork/summary/interaction/feedback.twig' with {
                    currentFeedback: currentFeedback,
                    assessment: currentInteraction.assessable,
                    assessmentId: currentInteraction.assessable.id,
                    responseId: currentInteraction.id,
                    participant: participant
                } only %}
            {% endfor %}
        </ul>
    {% endif %}
</li>

