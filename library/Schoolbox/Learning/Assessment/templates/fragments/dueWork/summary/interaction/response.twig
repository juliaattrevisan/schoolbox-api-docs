<li class="actions-small-1" {% if isOlderInteraction %}style="display:none"{% endif %} data-history-row>
    <ul class="action-list">
        <li class="actions-small-1">
            <div class="list-item">
                <div class="card small-12">
                    <a href="/search/user/{{ student.id }}" title="View Profile">
                        <img src="/portrait.php?userId={{ student.externalId }}&amp;size=square64" alt="{{ student.fullname }}" class="hide-for-small-only">
                        <p>{{ student.fullname }}</p>

                        {% if currentInteraction.isSubmitted %}
                            <p class="meta">Submitted {{ currentInteraction.submittedAt.short }}</p>
                        {% else %}
                            <p class="meta">Draft last updated {{ currentInteraction.updatedAt.short }}</p>
                        {% endif %}
                    </a>
                </div>
            </div>
            <nav>
                {% if isRouteAuthorized('learningResponse.getParticularResponse', {assessmentId: currentInteraction.assessable.id, responseId: currentInteraction.id}) %}
                <a href="{{ routeLookup('learningResponse.getParticularResponse', {assessmentId: currentInteraction.assessable.id, responseId: currentInteraction.id}) }}" class="icon-next" title="View in Inline Grader"></a>
                {% endif %}
            </nav>
        </li>
    </ul>

    {% if currentInteraction.allFiles %}
    <ul class="information-list">
        {% for currentFile in currentInteraction.allFiles %}
        <li>
            {% include '@learning/dueWork/interaction/response/files.twig' %}
        </li>
        {% endfor %}
    </ul>
    {% endif %}

    {% if currentInteraction.allFeedback|length %}
        <ul class="information-list reply">
            {% for currentFeedback in currentInteraction.allFeedback %}

                {# We pass the responseId as well, so that people can download annotated crocodocs
                 #}
                {% include '@learningAssessment/fragments/dueWork/summary/interaction/feedback.twig' with {currentFeedback: currentFeedback, responseId: currentInteraction.id} only %}
            {% endfor %}
        </ul>
    {% endif %}
</li>

