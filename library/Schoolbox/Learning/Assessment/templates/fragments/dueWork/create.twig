{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

{% include '@learningAssessment/fragments/common.twig' %}
{% include '@learningAssessment/fragments/curriculumCodes.twig' %}
{% include '@learningAssessment/fragments/dates.twig' %}

<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>

<input type="hidden" name="assessmentType" value="{{ types.fromTitle('dueWork') }}" />

<div class="row">
    <div class="small-12 columns">
        <label>Attach Files</label>

        <script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
        {% include 'sub/attachzone.twig' %}
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <label for="acceptsSubmissions">Accepts Submissions?</label>
        <select name="acceptsSubmissions">
            {% set options = {
                0: 'None',
                1: 'Single',
                2: 'Multiple'
            }
            %}
            {% for index, title in options %}
            <option value="{{ index }}">{{ title }}</option>
            {% endfor %}
        </select>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-6 columns">
        <label>
            Mark Type
            <select name="markType">
                {% for index, title in allMarkTypes %}
                <option value="{{ index }}">{{ title }}</option>
                {% endfor %}
            </select>
        </label>
    </div>
    <div class="small-12 medium-6 columns">
        <label>
            Grading Scheme
            <select>
                <option>Standard</option>
                <option>Non Standard</option>
            </select>
        </label>
    </div>
</div>
<div class="row">
    <div class="small-12 medium-6 columns">
        <script type="text/javascript">
            $(function() {
                $('#useRubric').click(function(event) {
                    if ($(this).is(':checked')) {
                        $('#markPerCapabilityPanel').removeClass('hide');
                    }
                    else {
                        $('#markPerCapabilityPanel').addClass('hide');
                    }
                });
            });
        </script>
        <label for="useRubric">Use Rubric?</label>
        <div class="switch round">
            <input name="useRubric" id="useRubric" type="checkbox"  />
            <label for="useRubric">
                <span class="icon-approve"></span>
                <span class="icon-cancel"></span>
            </label>
        </div>
    </div>
    <div class="small-12 medium-6 columns">
        <div id="markPerCapabilityPanel" class="hide">
            <label for="markPerCapability">Mark Per-Capability</label>
            <div class="switch round">
                <input name="markPerCapability" id="markPerCapability" type="checkbox" />
                <label for="markPerCapability">
                    <span class="icon-approve"></span>
                    <span class="icon-cancel"></span>
                </label>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <div class="rubrics">
            <!--Rubric Here-->
        </div>
    </div>
</div>

{{ mage.submitRow('Next', 'part-2', 'end', 'Working...') }}