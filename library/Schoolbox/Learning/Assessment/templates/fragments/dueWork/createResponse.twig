            {#{% endfor %}#}
        {#{% endif %}#}

        <h2 class="subheader">Submit Response</h2>

        <div class="row">
            <div class="small-12 columns">
                <div class="alert-box">
                    You can attach files and/or edit online for your submission.
                    Content you edit online will automatically save drafts, but your work will <strong>not be submitted</strong> until you Submit for
                    Assessment.
                </div>
            </div>
        </div>
        <div class="row">
            <div class="small-12 island">
                <form id="editor-form" method="post" action="{{ routeLookup('learningAssessment.postCreateResponse', { assessmentId: assessment.id, studentId: participant.id}) }}" enctype="multipart/form-data">
                    <input type="hidden" name="creatorId" value="{{ currentUser.id }}"/>
                    <input type="hidden" name="assessmentId" value="{{ assessment.id }}"/>
                    <input type="hidden" name="responseId" value="{{ response.id }}"/>
                    <section class="content">
                        <textarea id="editor-body" name="body" rows="20">{{ editorContents }}</textarea>

                        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                    </section>
                    <input type="submit" value="Submit for Assessment {% if currentUser.role.isStaff %}On Behalf Of Student{% endif %}" data-action-save />
                    <div class="toast" data-alert data-save-draft></div>
                </form>
            </div>
        </div>

        <div id="empty-dialog" class="reveal-modal" data-reveal role="dialog">
            <h2 id="empty-dialog-title">Nothing To Submit</h2>
            <p>You haven't supplied any content for your submission. Provide files and/or edit online and try again.</p>
            <a class="button full-width" data-interaction="close">OK</a>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </div>
    </div>
</div>