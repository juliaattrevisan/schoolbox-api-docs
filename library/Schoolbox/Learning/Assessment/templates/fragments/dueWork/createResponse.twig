<!-- BEGIN custom_head -->
<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.toast-timeout.js"></script>

<script type="text/javascript">
    $(function () {

        // Autosave on type to ensure that change gets saved

        var autosaveTimeout = null;
        var textBoxContent = '';

        // Method for setting up autosave - clears existing event, and creates new one.

        var initAutosave = function () {
            clearTimeout(autosaveTimeout);

            autosaveTimeout = setTimeout(function () {
                autosavePresubmit();
            }, 5 * 1000);
        };

        // The autosave pre-submit method - called by the autosave method. Calls the actual submit method if the textbox has changed.

        var autosavePresubmit = function () {

            // Has the text box changed? If not check again later (re-init the autosave counter)
            var currentContent = CKEDITOR.instances['editor-body'].getData();

            if (currentContent === textBoxContent) {
                initAutosave();
            }
            else {
                textBoxContent = currentContent;
                autosaveAjaxSubmit();
            }
        };

        // The autosave submit method

        var autosaveAjaxSubmit = function () {
            var form = $('#editor-form');

            // Change button's text, but keep its width the same.
            // Change it back once done.
            var formSaveLabel = form.find('[data-save-draft]');

            // Submit form via AJAX
            var formContents = form.serializeArray();
            formContents.push({name: 'save_draft', value: '1'});
            formContents.push({name: 'body', value: CKEDITOR.instances['editor-body'].getData()});

            formSaveLabel.toastActivate({
                text: 'Autosaving'
            });

            $.ajax({
                type: "POST",
                url: '/submission/submitOnlineForm.php',
                data: formContents,
                complete: function () {
                    // Re-init the autosave
                    initAutosave();

                },
                success: function () {
                    formSaveLabel.toastTimeout({
                        text: 'Draft Saved',
                        css: 'success'
                    });
                },
                error: function () {
                    formSaveLabel.toastTimeout({
                        text: 'Error!',
                        css: 'alert'
                    });
                },
                dataType: 'json'
            });
        };

        /* Spawn editors
         */
        $.fn.alaressEditor({
            targetElements: $('textarea[name=body]'),
            start: function (element) {
                initAutosave(element);
                autosavePresubmit(element);
            }
        });

        var emptyDialog = $('#empty-dialog');
        emptyDialog.on('click', '[data-interaction="close"]', function (e) {
            e.preventDefault();
            emptyDialog.foundation('reveal', 'close');
        });

        var confirmDialog = $('#confirm-dialog');

        $("[data-action-save]").click(function (e) {
            var form = $(this).closest('form'),
                    dialog = confirmDialog,
                    submit = form.find(':submit'),
                    inlineLen = CKEDITOR.instances['editor-body'].getData().length,
                    filesLen = $('#attachment-zone').data('plugin_resourceAttach').dropzone.getAcceptedFiles().length;

            if (!inlineLen && !filesLen) {
                // prevent submission without SOMETHING to submit
                e.preventDefault();
                emptyDialog.foundation('reveal', 'open');
            }
            else if (dialog.length) {
                // wait! display confirm modal
                e.preventDefault();

                dialog.find('[data-accept]').click(function (event) {
                    event.preventDefault();

                    submit.prop('disabled', true);
                    form.submit();
                });

                dialog.find('[data-reject]').click(function (event) {
                    event.preventDefault();

                    dialog.foundation('reveal', 'close');
                });

                confirmDialog.foundation('reveal').foundation('reveal', 'open');
            }
            else {
                // checks pass: go for broke
                submit.prop('disabled', true);
                form.submit();
            }
        });
    });
</script>
<!-- END custom_head -->

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

