                                {#<li class="dz-success actions-small-1">#}
                                    {#<div class="list-item">#}
                                        {#<div class="card small-12">#}
                                            {#<img class="mime" src="/images/mime/60x60/{{ file.mimeType.getIconFile }}">#}
                                            {#<p class="filename" data-dz-name="">#}
                                                {#<a href="/storage/fetch.php?save=1&hash={{ file.hash }}">{{ file.filename }}</a>#}
                                            {#</p>#}
                                            {#<p class="meta">#}
                                                {#{{ file.mimeType.description }}<br>#}
                                                {#Submitted {{ file.createdAt.getRelativeTime }}#}
                                            {#</p>#}
                                        {#</div>#}
                                    {#</div>#}
