{% import '@learningAssessment/project/macro/icon.twig' as icon %}
{% import '@learning/macro/dueDate.twig' as dueDate %}

<li class="actions-small-1" data-assessment>
    <div class="list-item">
        <div class="card wrap-down small-12">
            <div class="{{ icon.renderClass(assessable) }}" title="{{ assessable.getTypeName }}"></div>

            {% set route = routeLookupIfAuthorized('learningAssessment.getSummary',{assessmentId: assessable.id, studentId: student.id, student: student, assessment: assessable})  %}

            {% block link %}
                {% if route %}
                    <a href="{{ route }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">
                        <h3 data-assessment-title>{{ assessable.title }}</h3>
                    </a>
                {% else %}
                    <h3 data-assessment-title>{{ assessable.title }}</h3>
                {% endif %}
            {% endblock link %}

            {% block meta %}
            <p class="meta">
                {{ dueDate.dueDate(assessable, student ?: USER) }}
                {% if student %}
                    <br>
                    <a href="{% if route %}{{ route }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}{% else %}#{% endif %}" class="meta">{% include '@learningAssessment/fragments/statusLine.twig' with {assessable: assessable} %}</a>
                {% endif %}
            </p>
            {% endblock meta %}

        </div>
    </div>

    {% block nav %}
    <nav>
        {% set participant = assessable.getParticipantIfExtant(student) %}
        {% if participant %}
            {% include '@learningAssessment/fragments/progressTick.twig' with {
                assessment: assessable,
                participant: participant
            } only %}
        {% endif %}
    </nav>
    {% endblock nav %}
</li>

