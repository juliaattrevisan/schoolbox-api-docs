{# Attached files
 #
 # Render a set of attached files and supply it with a javascript-based previweer
 #
 # @param Collection $attachments  An Collection of IStorage instances, typically from an IAssessable instance
 #}
{% if attachments|length %}
    <script>
        $(function() {
            $('[data-plugin="preview"]').preview();
        });
    </script>
    <ul class="grid small-block-grid-1 medium-block-grid-2">
        {% for currentFile in attachments %}
            <li class="actions-small-1">
                <div class="list-item">
                    <div class="card attachment small-12">
                        <a data-plugin="preview" href="/storage/fetch.php?hash={{ currentFile.hash }}&name={{ currentFile.basename|url_encode }}" title="{{ currentFile.filename }}">
                            {% if currentFile.mimetype.image %}
                                <img src="/storage/image.php?hash={{ currentFile.hash }}&size=square64" alt="Download" />
                            {% else %}
                                <img src="/ajax/mime/{{ currentFile.mime }}" alt="Download" />
                            {% endif %}

                            <p>{{ currentFile.filename }}</p>
                            <p class="meta">{{ currentFile.size|bytes }}</p>
                        </a>
                    </div>
                </div>
                <nav>
                    <a href="/storage/fetch.php?hash={{ currentFile.hash }}&name={{ currentFile.basename|url_encode }}&save=1" title="Download"><sbx-icon name="download"></sbx-icon></a>
                </nav>
            </li>
        {% endfor %}
    </ul>
{% endif %}
