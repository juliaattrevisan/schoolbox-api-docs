<script type="text/javascript">
    (async () => {
        /**
         * Callback for when SEB's security information has been updated
         */
        function onSEBLoaded() {
            const pageConfigKey = SafeExamBrowser.security.configKey;
            // const pageBrowserExamKey = SafeExamBrowser.security.browserExamKey;
            // const sebClientVersion = SafeExamBrowser.version;
            window.location.href = `{{ url }}${pageConfigKey}`;
        }

        /**
         * @returns {boolean} Whether SEB is available or not
         */
        function isSEBAvailable() {
            return typeof SafeExamBrowser !== 'undefined';
        }

        /**
         * SEB doesn't always immediately load on some devices (only seen on Windows so far)
         * but it may become available after a short delay, so wait a bit before giving up
         * @param {number} maxWait - Maximum time to wait for SEB to load
         * @param {number} interval - Interval to check for SEB availability
         * @returns {Promise<boolean>} whether SEB was found or not
         */
        async function waitForSEB(maxWait, interval) {
            if (isSEBAvailable()) {
                return true;
            }

            let remainingTime = maxWait;
            return new Promise((resolve) => {
                const checkInterval = setInterval(() => {
                    if (!isSEBAvailable() && remainingTime > 0) {
                        remainingTime -= interval;
                        return;
                    }

                    clearInterval(checkInterval);
                    resolve(isSEBAvailable());
                }, interval);
            });
        }

        const hasSEB = await waitForSEB(2000, 10);
        if (hasSEB) {
            SafeExamBrowser.security.updateKeys(onSEBLoaded);
        } else {
            window.location.href = "{{ url }}";
        }
    })();
</script>
