{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/submitRow.twig' as mage %}

{{ bread.crumbs(
[ folder.name, '/homepage/' ~ folder.id ],
[ 'Update Assessment', routeLookup('learningAssessment.getUpdateAssessment') ]
) }}

<div class="row">
    <div class="small-12 columns"><h1>Update Assessment</h1></div>
</div>

<div class="row">
    <div class="small-12 columns island">
        <form action="{{ routeLookup('learningAssessment.postUpdateAssessment') }}" id="assessmentForm" method="post">
            <section>
                <fieldset class="content">
                    {% include '@learningAssessment/fragments/common.twig' %}
                </fieldset>
                <fieldset class="content">
                    <legend>Dates</legend>

                    {% include '@learningAssessment/fragments/dates.twig' %}
                </fieldset>
                <fieldset class="content">
                    {% include '@learningAssessment/fragments/curriculumCodes.twig' %}
                </fieldset>

                <fieldset class="content">
                    <legend>Assessments</legend>
                    {% if assessmentType == 'project' %}
                        <input type="hidden" name="assessmentType" value="project" />
                        <div class="small-12 columns">
                            {% include '@learningAssessment/fragments/project/assessmentList.twig' %}
                            {% include '@learningAssessment/fragments/project/create.twig' %}
                        </div>
                    {% elseif assessmentType == 'dueWork' %}
                        <input type="hidden" name="assessmentType" value="dueWork" />
                        <div class="small-12 columns">
                            {% include '@learningAssessment/fragments/duework/create.twig' %}
                        </div>
                    {% elseif assessmentType == 'task' %}
                        <input type="hidden" name="assessmentType" value="task" />
                        <div class="small-12 columns">
                            {% include '@learningAssessment/fragments/task/create.twig' %}
                        </div>
                    {% elseif assessmentType == 'quiz' %}
                        <input type="hidden" name="assessmentType" value="quiz" />
                        <div class="small-12 columns">
                            {% include '@learningAssessment/fragments/quiz/create.twig' %}
                        </div>
                    {% endif %}

                    {{ mage.submitRow('Save', '', '', '') }}
                </fieldset>
            </section>
        </form>
    </div>
</div>