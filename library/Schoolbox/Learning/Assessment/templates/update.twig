{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

<script src="{{ CDN_PREFIX }}/js/bundle/mage.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/assessment/validationRules.js?v={{ config.site_version }}" data-locale-grading-proper="{{ locale.grading.proper }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/jquery-validation/dist/additional-methods.min.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/assessment/participation.js?v={{ config.site_version }}"></script>

{% autoescape 'js' %}
<script>
    $(function () {

        // Participation
        $('#participation-container').participationSettings({
            getAvailableDateFields: function () {

                var dateArray = [];

                if($('#publishDate').length != 0 && $('#publishDate').is(":visible")) {
                    dateArray.push('publish');
                }
                if($('#openDate').length != 0 && $('#openDate').is(":visible")) {
                    dateArray.push('open');
                }
                if($('#dueDate').length != 0 && $('#dueDate').is(":visible")) {
                    dateArray.push('due');
                }
                if($('#closeDate').length != 0 && $('#closeDate').is(":visible")) {
                    dateArray.push('close');
                }

                return dateArray;
            }
        });

        // the mage plugin is applied to the submit buttons: setup a basic mage on all the buttons
        $('input[data-mage-next]').mage({
            initValidation: initDynamicValidationTriggers,
            validateOptions: validateOptions,
            beforeAttemptingSubmit: beforeAttemptingSubmit,
            formWillSubmit: formWillSubmit,
            onXhrDone: function (data) {
                if('string' == typeof data.returnUrl){
                    window.location.href = data.returnUrl;
                }
            }
        });

        /**
         * Promise to submit the form (or not), based on user's response to the mark invalidation confirmation dialog.
         * Only exists on the update page because a new (not yet created) due work will never have existing rubric marks.
         */
        function formWillSubmit() {
            var formData = this;
            var rubricObjects = formData.filter(function(item) {
                var name = item.name;
                var regex = /rb([.*])*/;
                return name.match(regex);
            });

            // If no rubric objects are in the serialized form data, we're probably not on a due work page
            if (rubricObjects.length > 0) {

                return new Promise(function(resolve, reject) {

                    // Test whether marks need to be invalidated
                    $.post('/rubric/determineMarkInvalidation', formData).done(function(response) {
                        // Show dialog only if invalidation is required
                        var numberAffected = Object.keys(response['affectedUsers']).length;

                        if (response['compatible'] === false && numberAffected > 0) {
                            var dialogHtml = '<p>You have made changes to this rubric, but ' + numberAffected;

                            if (numberAffected !== 1) {
                                dialogHtml += ' students have already been marked:</p>';
                            } else {
                                dialogHtml += ' student has already been marked:</p>';
                            }

                            dialogHtml += '<ul class="information-list scrollable-list">';

                            var affectedUsers = response['affectedUsers'];

                            $(Object.keys(response['affectedUsers'])).each(function(index, userId) {
                                var noInstructorFeedback = affectedUsers[userId]['selfAssess'] && !affectedUsers[userId]['instructorGiven'];

                                var userName = affectedUsers[userId]['user']['fullName'];
                                dialogHtml += '<li>' +
                                    '      <div class="row">' +
                                    '          <div class="small-12 list-item compact card">' +
                                    '              <img src="/portrait.php?id=' + userId + '&amp;size=square64">' +
                                    '              <p>' + userName;

                                if (noInstructorFeedback) {
                                    dialogHtml += '<span class="meta inline"> (self-reflection)<span>';
                                }

                                dialogHtml += '</p></div></div></li>';
                            });

                            dialogHtml += '</ul>' +
                                '<br/>' +
                                '<p>If you choose to save changes, these rubric marks will be deleted.</p>' +
                                '<p>Are you sure you want to continue?</p>';

                            $(this).confirmDialog({
                                header: 'Confirm mark deletion',
                                text: dialogHtml,
                                confirmLabel: 'Continue',
                                cancelLabel: 'Cancel',
                                format: 'html',
                                confirmEvent: function() {
                                    // Yes, invalidate rubric marks - I promise to submit the form!
                                    resolve();
                                },
                                cancelEvent: function() {
                                    // No, cancel - prevent form submit
                                    reject();
                                }
                            });
                        } else {
                            // No confirmation dialog required - I promise to submit the form!
                            resolve();
                        }
                    });

                });
            } else {
                return new Promise(function(resolve, reject) {
                    resolve();
                });
            }
        }

        $('[data-delete]').click(function(event) {
            event.preventDefault();

            $(this).confirmDialog({
                header: 'Are you sure you wish to delete this activity?',
                text: {{ assessment.isSpecification ? '\'\'' : '\'<span class=\"alert alert-box\"><b>WARNING</b> All student responses, feedback and marks will also be deleted.</span>\'' }},
                format: 'html',
                confirmLabel: 'Yes, permanently delete',
                cancelLabel: 'No, keep it',
                confirmEvent: function() {
                    $.post('{{ routeLookup('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id, assessment: assessment}) }}')
                        .done(function(result) {
                            // Remove from list after AJAX returns
                            window.location.href = result.returnUrl;
                        });
                }
            });
        });


    });
</script>
{% endautoescape %}

{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>Update {{ assessment.title }}</h1>
    </div>
    {% if routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id, assessment: assessment}) %}
        <nav>
            <a href="#" class="icon-more" data-dropdown="header-options" title="Actions"></a>
        </nav>
        <ul id="header-options" class="f-dropdown" data-dropdown-content="" aria-hidden="true">
            <li>
                    <a class="icon-delete" title="Delete Activity" data-delete>Delete Activity</a>
            </li>
        </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 columns island">
        <form action="{{ routeLookup('learningAssessment.postUpdateAssessment', {assessmentId: assessment.id, assessment: assessment}) }}" class="mage" id="assessmentForm" method="post">
            <section>
                <fieldset class="content" data-mage>
                    <div class="small-12 columns">
                        <input type="hidden" name="assessmentType" value="{{ assessmentType }}" />
                        <input type="hidden" name="{{ returnUrlName }}" value="{{ returnUrl }}" />
                        <input type="hidden" name="id" value="{{ assessment.id }}" />
                        <input type="hidden" name="folderId" value="{{ assessment.baseContext.folder.id }}" />
                        {% include '@learningAssessment/'~assessmentType~'/create.twig' with { actionLabel: 'Update' } %}
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>

{# Participation modal w/ form. Must live outside of main form #}
{% include '@learningAssessment/fragments/participationModal.twig' %}
