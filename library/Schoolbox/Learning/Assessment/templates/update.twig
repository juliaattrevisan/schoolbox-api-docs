{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/submitRow.twig' as mage %}

{{ bread.crumbs(
[ folder.name, '/homepage/' ~ folder.id ],
[ 'Update Assessment', routeLookup('learningAssessment.getUpdateAssessment') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>Update Assessment</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 columns island">
        <form action="{{ routeLookup('learningAssessment.postUpdateAssessment', {assessmentId: assessment.id}) }}" id="assessmentForm" method="post">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">

                        {% if assessmentType == 'project' %}
                            <input type="hidden" name="assessmentType" value="project" />
                            {% include '@learningAssessment/fragments/project/create.twig' with {update: true, assessmentList: allAssessments} %}
                        {% elseif assessmentType == 'dueWork' %}
                            <input type="hidden" name="assessmentType" value="dueWork" />
                            {% include '@learningAssessment/fragments/dueWork/create.twig' %}
                        {% elseif assessmentType == 'task' %}
                            <input type="hidden" name="assessmentType" value="task" />
                            {% include '@learningAssessment/fragments/task/create.twig' %}
                        {% elseif assessmentType == 'quiz' %}
                            <input type="hidden" name="assessmentType" value="quiz" />
                            {% include '@learningAssessment/fragments/quiz/create.twig' %}
                        {% endif %}
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>