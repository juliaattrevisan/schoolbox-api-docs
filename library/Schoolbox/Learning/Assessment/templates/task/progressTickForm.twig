{##
 # @learningAssessment/task/progressTickForm.twig
 #
 # Params:
 # * participant: Participant       - The participant object
 # * disabled:    bool              - whether the viewee cannot change the task's marking state
 #                                  - For participant, it should be disabled if:
 #                                    * task is closed, or
 #                                    * participant is already marked as teacher-complete, or
 #                                    * task is not self-assessable
 #                                  - For teacher, it should be disabled if teacher lacks write+ perm to class folder
 #}

{% set mostRecentResponse = participant.findMostRecentResponse %}
<form action="{{ routeLookup('learningAssessment.postCreateResponse', {assessmentId: participant.assessable.id, studentId: participant.user.id}) }}"
      method="POST"
      class="progress-tick-form"
      data-progress-tick-form="{{ participant.assessable.isSelfAssessed ? 'selfAssessed' : 'teacherAssessed' }}">
    {% if mostRecentResponse.isMarkedAsTeacherAssessed %}
        <a href="#"
           disabled
           class="no-text progress-tick reviewed{% if disabled %} disabled{% endif %}"
           title="Completed"
           data-progress-tick-status="teacherAssessed"></a>
    {% elseif mostRecentResponse.isMarkedAsSelfAssessed %}
        <a href="#"
           disabled
           class="no-text progress-tick pending{% if disabled %} disabled{% endif %}"
           title="Self-assessed"
           data-progress-tick-status="selfAssessed"></a>
    {% else %}
        <a href="#"
           disabled
           class="no-text progress-tick{% if disabled %} disabled{% endif %}"
           title="Incomplete"
           data-progress-tick-status="incomplete"></a>
    {% endif %}
</form>
