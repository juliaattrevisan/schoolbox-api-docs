{% extends '@learningAssessment/component.twig' %}

{% set assessmentType = 'task' %}
{% set icon = 'icon-task' %}

{% block studentMessage %}
    There are no tasks to complete at this time.
{% endblock studentMessage %}

{% block teacherMessage %}
    <a href="{{ createRouteType }}" data-test="component-task-empty-create-button">Create a task</a>
    that is not a part of your course for your students to complete.
{% endblock teacherMessage %}

{% block createButton %}
    <a href="{{ createRouteType }}" class="button">Create Task</a>
{% endblock createButton %}

{% block listItem %}
    {% include '@learningAssessment/task/componentListItem.twig' %}
{% endblock %}

{% block scripts %}
    {# Mark as complete form #}
    <script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/task/jquery.progressTickForm.js?v={{ config.site_version }}"></script>
    <script type="text/javascript">
        $(function() {
            // Save form for task completion
            $('#component{{ component_id }}').find('form[data-progress-tick-form]').progressTickForm({
                disabledSelector: 'form:not([data-progress-tick-form="selfAssessed"])',
                transitions: {
                    incomplete:      'selfAssessed',
                    selfAssessed:    'incomplete',
                    teacherAssessed: 'incomplete'
                }
            });
        });
    </script>
{% endblock %}
