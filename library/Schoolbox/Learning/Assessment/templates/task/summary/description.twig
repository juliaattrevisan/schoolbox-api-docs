{##
 # assessment   IAssessable
 # preview      array        - a preview array fragment that came out of PreviewFactory
 # student      User - (optional) If supplied override real assessment values
 #}
{% set participant = assessment.getParticipantIfExtant(student) %}

<section>
    {% set description = participant ? participant.description : assessment.description %}
    {% if description|length %}
        {% if routeLookupIfAuthorized('immersiveReader.getTokenAndSubdomain') %}
            <script src="{{ CDN_PREFIX }}/js/immersive-reader/jquery.immersive-reader.js?v={{ config.site_version }}" type="text/javascript"></script>
            <script type="text/javascript">
                $(function () {
                    $('[data-immersive-reader]').immersiveReader({title: '{{ assessment.title | escape('js') }}'});
                });
            </script>
            <div class='immersive-reader-button' id="ir-button" data-immersive-reader="button"></div>
        {% endif %}
        <article class="content">
            {{ description | purify }}
        </article>
    {% endif %}

    {# An optional link to a place
     # These can co-exist with files now
     #}
    {% if assessment.url|length %}
    <div class="card small-12">
        <a href="{{ assessment.url }}" target="_blank" title="Visit {{ assessment.url }}">
            <sbx-icon name="link"></sbx-icon>
            <p>{{ assessment.url }}</p>
        </a>
    </div>
    {% endif %}

    {# Attached files #}
    {% include '@learningAssessment/fragments/attachments.twig' with { attachments: assessment.attachedFiles } %}
</section>

{% if preview.type is not defined or preview.type in ['image', 'file', 'redirect'] %}

    {# noop #}

    {# Unknown preview types are just ignored
     # Images and other Files now render in their own list
     # Links/urls (preview.type redirect) are rendered further up the screen under the description
     #}

{% elseif preview.type == 'iframe' %}

    {# a task link should display as a link regardless of whether iframe safe url or not #}
    <section>
        <div class="card small-12">
            <a href="{{ preview.fragment }}" target="_blank" title="Visit {{ preview.fragment }}">
                <sbx-icon name="link"></sbx-icon>
                <h3>{{ assessment.title }}</h3>
                <p class="meta">{{ preview.fragment }}</p>
            </a>
        </div>
    </section>

{% elseif preview.fragment|length %}

    {# This usage of raw is because the embedded code is raw html for embedding external content etc using oEmbed or multimedia videos #}
    <section class="content">
        {{ preview.fragment | raw }}
    </section>

{% endif %}
