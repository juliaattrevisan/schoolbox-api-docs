{##
 # assessment   IAssessable
 # preview      array        - a preview array fragment that came out of PreviewFactory
 # participant  ?Participant - (optional) If supplied override real assessment values
 #}
<section>
    {% set description = participant ? participant.description : assessment.description %}
    {% if description|length %}
        <article class="content">
            {{ description | purify }}
        </article>
    {% endif %}

    {% if preview.type == 'image' %}
        <div class="content">
            <img src="{{ preview.fragment }}">
        </div>
    {% elseif preview.type == 'file' %}
        <div class="card small-12 compact">
            <a href="/storage/fetch.php?hash={{ preview.file.hash }}">
                <img src="/ajax/mime/{{ preview.file.mime }}" alt="Preview" class="mime {{ preview.file.mimetype }}" />
                <h3>{{ preview.file.filename }}</h3>
            </a>
            <p class="meta">{{ preview.file.size|bytes}}</p>
        </div>
    {% elseif preview.type == 'redirect' %}
        <div class="card small-12">
            <a href="{{ assessment.url }}" target="_blank" title="Visit {{ preview.fragment }}">
                <div class="icon-link"></div>
                <h3>{{ assessment.title }}</h3>
                <p class="meta">{{ preview.fragment }}</p>
            </a>
        </div>
    {% elseif preview.fragment|length %}
        {# This usage of raw is because the embedded code is raw html for embedding external content etc using oEmbed or multimedia videos #}
        <div class="content">
            {{ preview.fragment | raw }}
        </div>
    {% endif %}
</section>
