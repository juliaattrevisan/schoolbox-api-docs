{##
 # assessment   IAssessable
 # preview      array        - a preview array fragment that came out of PreviewFactory
 # student      User - (optional) If supplied override real assessment values
 #}
{% set participant = assessment.getParticipantIfExtant(student) %}


<section>
    {% set description = participant ? participant.description : assessment.description %}
    {% if description|length %}
        {% if routeLookupIfAuthorized('immersiveReader.getTokenAndSubdomain') %}
            <script src="/javascript/shared/jquery.immersive-reader.js" type="text/javascript"></script>
            <script type="text/javascript">
                $(function () {
                    $('[data-immersive-reader]').immersiveReader({title: '{{ assessment.title }}'});
                });
            </script>
            <div class='immersive-reader-button' id="ir-button" data-immersive-reader="button"></div>
        {% endif %}
        <article class="content">
            {{ description | purify }}
        </article>
    {% endif %}

    {% if preview.type is not defined %}
        {# noop #}
    {% elseif preview.type == 'image' %}
        <div class="content">
            <img src="{{ preview.fragment }}">
        </div>
    {% elseif preview.type == 'file' %}
        <div class="card small-12 compact">
            <a href="/storage/fetch.php?hash={{ preview.file.hash }}">
                <img src="/ajax/mime/{{ preview.file.mime }}" alt="Preview" class="mime {{ preview.file.mimetype }}" />
                <h3>{{ preview.file.filename }}</h3>
            </a>
            <p class="meta">{{ preview.file.size|bytes}}</p>
        </div>
    {# a task link should display as a link regardless of whether iframe safe url or not #}
    {% elseif preview.type == 'redirect' or preview.type == 'iframe' %}
        <div class="card small-12">
            <a href="{{ preview.fragment }}" target="_blank" title="Visit {{ preview.fragment }}">
                <div class="icon-link"></div>
                <h3>{{ assessment.title }}</h3>
                <p class="meta">{{ preview.fragment }}</p>
            </a>
        </div>
    {% elseif preview.fragment|length %}
        {# This usage of raw is because the embedded code is raw html for embedding external content etc using oEmbed or multimedia videos #}
        <div class="content">
            {{ preview.fragment | raw }}
        </div>
    {% endif %}
</section>
