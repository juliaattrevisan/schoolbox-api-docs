{#
Data:
    breadcrumbs Collection|string[][]
    assessment  Task\Model
    student     User
    preview     array
    returnUrl   string
#}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}
<script type="text/javascript" src="/javascript/shared/submissions/task/jquery.progressTickForm.js"></script>
<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();

        // Save form for task completion
        $('form[data-progress-tick-form]').progressTickForm({
            transitions: {
                incomplete:      'teacherAssessed',
                selfAssessed:    'incomplete',
                teacherAssessed: 'incomplete'
            }
        });
    });
</script>

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/meta.twig' with {assessment: assessment, user: USER, student: student, icon: 'icon-task'} %}
    </div>

    {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
    {% if viewRoute or modifyRoute %}
        <nav>
            <a href="#" class="icon-more" data-dropdown="header-options" title="Actions"></a>
        </nav>
        <ul data-dropdown-content id="header-options" class="f-dropdown">
            {% if viewRoute %}
                <li><a class="icon-progress" href="{{ viewRoute }}">View Status</a></li>
            {% endif %}
            {% if modifyRoute %}
                <li><a href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-modify">Modify</a></li>
            {% endif %}
        </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        {% include '@learningAssessment/task/summary/description.twig' with {
            assessment: assessment,
            preview: preview,
            student: student
        } only %}
    </div>
</div>


{# student submit form #}
{% set participant         = assessment.getParticipantIfExtant(student) %}
{% set mostRecentResponse  = participant.findMostRecentSubmittedResponse %}
{% set isViewingOwnSummary = student.id == USER.id %}
{% set reviewer            = mostRecentResponse.submittedBy %}
{% set reviewerName        = reviewer.id == USER.id ? 'You' : reviewer.fullName %}
{% set COMPLETION_STATUS_INCOMPLETE              = 1 %}
{% set COMPLETION_STATUS_SELF_MARKED_COMPLETE    = 2 %}
{% set COMPLETION_STATUS_TEACHER_MARKED_COMPLETE = 3 %}

<div class="row">
    <div class="small-12 island">
        <section>
            <ul class="information-list">
                <li>
                    {# Student's completion of this task #}
                    <div class="actions-small-1">
                        <div class="list-item">
                            <div class="card small-12">
                                <a href="/search/user/{{ student.id }}" title="View Profile">
                                    <img src="/portrait.php?userId={{ student.externalId }}&amp;size=square64"
                                         alt="{{ student.formatName }}"
                                         class="hide-for-small-only">
                                    <p>{{ student.formatName }}</p>

                                    {% if assessment.isImplementation %}
                                        <p class="meta">
                                            {# Are there no responses for this participant ? #}
                                            {% if not mostRecentResponse %}

                                                {# Is this task self-assessable ? #}
                                                {% if assessment.isSelfAssessable %}
                                                    {% if isViewingOwnSummary %}
                                                        You {% if assessment.isPastClose %}did not complete{% else %}have not completed{% endif %} this task.
                                                    {% else %}
                                                        {% if assessment.isPastClose %}did not complete{% else %}has not completed{% endif %} this task.
                                                    {% endif %}
                                                {% else %}
                                                    {% if isViewingOwnSummary %}
                                                        Your teacher {% if assessment.isPastClose %}did not verify{% else %}has not verified{% endif %} that you have completed this task.
                                                    {% else %}
                                                        {% if assessment.isPastClose %}was not{% else %}has not been{% endif %} verified as having completed this task.
                                                    {% endif %}
                                                {% endif %}
                                            {% else %}
                                            {% if isViewingOwnSummary %}You were{% else %}was{% endif %} marked as
                                            {% if mostRecentResponse.isMarkedComplete %}complete{% else %}incomplete{% endif %} on {{ mostRecentResponse.submittedAt.short }}.
                                            {% endif %}
                                        </p>
                                    {% endif %}
                                </a>
                            </div>
                        </div>
                        <nav>
                            {% include '@learningAssessment/fragments/progressTick.twig' with {
                            assessment: assessment,
                            student: student
                            } only %}
                        </nav>
                    </div>

                    {# Was the task non self assessed ? #}
                    {% if mostRecentResponse and not mostRecentResponse.selfAssessed %}
                        <ul class="information-list reply">
                            <li class="list-item">
                                <div class="card small-12">
                                    <a href="/search/user/{{ mostRecentResponse.submittedBy.id }}" title="View Profile">
                                        <img src="/portrait.php?userId={{ mostRecentResponse.submittedBy.externalId }}&amp;size=square64"
                                             alt="{{ mostRecentResponse.submittedBy.formatName }}"
                                             class="hide-for-small-only">
                                        <p>{{ mostRecentResponse.submittedBy.formatName }}</p>
                                        <p class="meta">
                                            marked {% if isViewingOwnSummary %}you{% else %}this task{% endif %} as
                                            {% if mostRecentResponse.isMarkedComplete %}complete{% else %}incomplete{% endif %}.
                                        </p>
                                    </a>

                                </div>
                            </li>
                        </ul>
                    {% endif %}

                </li>
            </ul>
        </section>
        <a href="{{ returnUrl }}" class="submit button full-width">Return</a>
    </div>
</div>
