{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}


<input type="hidden" name="assessmentType" value="{{ assessmentType }}" />
<input type="hidden" name="type" value="{% if assessment.url|length %}url{% else %}attach{% endif %}"/>


{# ----------------------------------------------------------- #}
{# Title #}
{# ----------------------------------------------------------- #}
<label>
    Title
    <input type="text" name="title" value="{{ assessment.title }}" required maxlength="255"/>
</label>


{# ----------------------------------------------------------- #}
{# Work Type #}
{# ----------------------------------------------------------- #}
<label>
    Work Type
    <select name="workType">
        <option value="" selected>None</option>
        {% for workType in allWorkTypes %}
            <option value="{{ workType.id }}" {% if assessment.workType.id == workType.id %}selected="selected"{% endif %}>{{ workType.name }}</option>
        {% endfor %}
    </select>
</label>


{# ----------------------------------------------------------- #}
{# Description #}
{# ----------------------------------------------------------- #}
<label>
    Description
    <textarea name="description">{{ assessment.description }}</textarea>
</label>


{# ----------------------------------------------------------- #}
{# Dates #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification %}
    {% include '@learningAssessment/fragments/dates.twig' %}
{% endif %}


{# ----------------------------------------------------------- #}
{# Attachments #}
{# ----------------------------------------------------------- #}
<div id='taskEditor'>
    <div class="row" {% if assessment.url|length %}style="display:none"{% endif %} data-attachment="attach">
        <div class="small-9 medium-10 columns">
            <label>Attach File</label>
            {% include 'sub/attachzone.twig' with { attachzone: attachzone } %}
        </div>
        <div class="small-3 medium-2 columns no-pad">
            <label>&nbsp;</label>
            <a class='button icon-link' data-value='url'>Link</a>
        </div>
    </div>
    <div class="row" {% if not assessment.url|length %}style="display:none"{% endif %} data-attachment="url">
        <div class="small-9 medium-10 columns">
            <label>
                Link
                <input type='text' name='url' maxlength='1024' placeholder="http://" value="{{ assessment.url }}" />
            </label>
        </div>
        <div class="small-3 medium-2 columns no-pad">
            <label>&nbsp;</label>
            <a class='button icon-attach' data-value='attach'>Attach</a>
        </div>
    </div>
</div>


{# ----------------------------------------------------------- #}
{# Self assess #}
{# ----------------------------------------------------------- #}
<div class="row">
    <div class="small-12 columns">
        <label for="hasSelfAssessed">Allow self-assessed?</label>
        <div class="switch round">
            <input name="hasSelfAssessed" id="hasSelfAssessed" type="checkbox" {% if assessment.isSelfAssessable %}checked="checked"{% endif %} />
            <label for="hasSelfAssessed">
                <span class="icon-approve"></span>
                <span class="icon-cancel"></span>
            </label>
        </div>
    </div>
</div>


{# ----------------------------------------------------------- #}
{# Default Activity Duration #}
{# ----------------------------------------------------------- #}
{% include '@learningAssessment/fragments/default_open_span.twig' with {assessment: assessment} only %}


{# ----------------------------------------------------------- #}
{# Participation #}
{# ----------------------------------------------------------- #}
{% include '@learningAssessment/fragments/participation.twig' %}


{# ----------------------------------------------------------- #}
{# Submit #}
{# ----------------------------------------------------------- #}
{{ mage.submitRow(actionLabel ?: 'Create', 'part-2', 'end') }}


{# ----------------------------------------------------------- #}
{# Scripts #}
{# ----------------------------------------------------------- #}
<script src="/javascript/ckeditor/ckeditor.js"></script>
<script src="/javascript/shared/editor/jquery.editor.js"></script>
<script>
    $(function () {
        // Init CKEditor
        $.fn.alaressEditor();

        //
        $('#taskEditor').on('click', '[data-attachment] a[data-value]', function() {
            var container = $('#assessmentForm');
            var anchor = $(this);
            var type = anchor.attr('data-value');

            /**
             * Clears all the attachments out of the form.
             */
            var clearAttachments = function() {
                container.find('.attachzone').data('plugin_resourceAttach').dropzone.removeAllFiles();
            };

            /* Remember the option we selected
             */
            $('#taskEditor').find('input[name=type]').val(type);

            {# show only the one we want -#}
            var attachers = $('#taskEditor').find('[data-attachment]');
            attachers.hide().filter('[data-attachment="'+type+'"]').show();

            $('#taskEditor').find('input[name=url]').val('').prop('readonly', type == 'attach');

            if (type == 'url') {
                {#
                    tell the attacher to clear any attachments by simulating clicking of all the (one...) delete buttons
                    not jQuery.detach() - it can't trigger dropzone's event listener
                -#}
                clearAttachments();
            }
        });
    });
</script>