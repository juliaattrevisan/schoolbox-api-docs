{% extends '@learningAssessment/componentListItem.twig' %}

{% set extraNavItemCount = assessable.isParticipant(USER) ? 1 : 0 %}

{% block extraNavItems %}

    {% if assessable.isParticipant(USER) %}
        {% set extraNavItemCount = 1 %}
        {% set participant = assessable.getParticipant(USER) %}

        {% include '@learningAssessment/task/progressTickForm.twig' with {
            participant: participant,
            disabled: assessable.closed or participant.findMostRecentPublishedFeedback.markedAsTeacherAssessed or assessable.isTeacherAssessed
        } only %}
    {% endif %}

{% endblock %}
