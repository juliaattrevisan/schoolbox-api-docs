{% if hasAssessmentRoutes or hasCourseRoutes or isParticipant %}
    <nav>
        {% if customisedAssessments is not empty and canWrite %}
        <a class="expand-link icon-down-arrow" data-test="course-outline-expand-activity-{{ assessment.title }}" data-interaction-has-customised></a>
        {% endif %}
        {% if hasAssessmentRoutes or hasCourseRoutes %}
            <sbx-pop-out content-id="component{{ componentInstance.id }}-options-task{{ assessment.id }}"></sbx-pop-out>
        {% elseif isParticipant %}
            {% include '@learningAssessment/fragments/progressTick.twig' with {
                assessment: assessment,
                student: USER
            } only %}
        {% endif %}

    </nav>
{% endif %}

{% if hasAssessmentRoutes or hasCourseRoutes %}
    <ul data-dropdown-content class="f-dropdown" id="component{{ componentInstance.id }}-options-task{{ assessment.id }}">
        {% if hasAssessmentRoutes %}
            <li class="separator">{{ locale.translate('activity', false, true) }}</li>
            {% if statusRoute %}<li><a href="{{ statusRoute }}" data-test="course-outline-view-status-{{ assessment.id }}"><sbx-icon name="progress"></sbx-icon>View Status</a></li>{% endif %}
            {% if assessment is dueWork %}
                {% set viewGradeRoute = routeLookupIfAuthorized('learningDueWorkResponse.getFirstParticipantResponse', {
                    assessmentId: assessment.id,
                    assessment: assessment,
                }) %}
                {% if viewGradeRoute %}
                    <li><a class="icon-task" data-test="course-outline-view-grade-submissions-{{ assessment.id }}" href="{{ viewGradeRoute }}" >View and {{ locale.grades }} submissions</a></li>
                {% endif %}
            {% endif %}
            {% if assessment is dialogAgent %}
                {% set viewResponseRoute = routeLookupIfAuthorized('learningDialogAgent.getFirstParticipantResponse', {
                    assessmentId: assessment.id,
                    assessment: assessment,
                }) %}
                {% if viewResponseRoute %}
                    <li><a class="icon-task" href="{{ viewResponseRoute }}">View Responses</a></li>
                {% endif %}
            {% endif %}
            {% set viewCustomParticipationRoute = routeLookupIfAuthorized('learningAssessment.getAssessmentParticipationForm', {
                assessmentId: assessment.id,
                assessment: assessment
            }) %}
            {% if viewCustomParticipationRoute %}
                <li><a class="icon-group" data-test="course-outline-custom-participation-{{ assessment.id }}" href="{{ viewCustomParticipationRoute }}">Student Participation</a></li>
            {% endif %}
            {% if assessment is dueWork and assessment.enableWorksheet and kamiWorksheetRoute %}
                <li>
                    <a id="kamiWorksheet" class="icon-surveys" href="{{ kamiWorksheetRoute }}">Class View</a>
                </li>
            {% endif %}
            {% if similarityReportRoute %}<li><a href="{{ similarityReportRoute }}?{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-due-work" title="View Similarity Report" data-test="course-outline-similarity-report-{{ assessment.id }}">Similarity Report</a></li>{% endif %}
            {%  if assessment is dueWork and assessment.useRubric %}
                <li>
                    <a href="{{ routeLookup('learningAssessment.getOverview', { assessmentId: assessment.id }) }}"
                       class="icon-criteria" data-test="course-outline-rubric-report-{{ assessment.id }}">Rubric Report</a>
                </li>
            {% endif %}

            {% if modifyRoute %}
                {% if assessment is quiz %}
                    <li><a data-test="course-outline-horizontal-{{ assessment.id }}" href="{{ routeLookup('learnosity.getHorizontalMarking', { assessmentId: assessment.id }) }}"><sbx-icon name="class-list"></sbx-icon>Review horizontally</a></li>
                {% endif %}

                {% include '@learningAssessment/fragments/modifyLinks.twig' with {
                    assessment: assessment,
                    modifyRoute: modifyRoute,
                    returnUrlName: returnUrlName,
                    returnUrl: encodedReturnUrl,
                    dataTestPrefix: 'course-outline-',
                } only %}
            {% endif %}

            {% if deleteRoute %}<li><a href="{{ deleteRoute }}"
                                   class="sbx-icon-only-button no-text"
                                   data-action="delete"
                                   data-test="activity-delete-{{ assessment.id }}"
                                   title="Delete this {{ locale.assessment }}"
                                   aria-label="Delete this {{ locale.assessment }}">
                <sbx-icon name="delete"></sbx-icon>
                Delete
            </a></li>{% endif %}
        {% endif %}
        {% if hasCourseRoutes %}
            <li class="separator">Course</li>
            {% if saveToCourseRoute %}
                <li>
                    <a href="{{ saveToCourseRoute }}"
                       data-test="activity-save-course-{{ assessment.id }}"
                       data-reveal-id="component{{ componentInstance.id }}-save-to-course-modal-{{ assessment.id }}"
                       data-method="{{ saveToCourseMethod }}"
                       data-spec-assessment-id="{{ specAssessment.id ?? null }}"
                       data-spec-assessment-title="{{ specAssessment.title ?? null }}"
                    ><sbx-icon name="export"></sbx-icon>Save to Course...</a>
                    {% include '@learningAssessment/outline/saveToCourseModal.twig' with {
                        assessment: assessment,
                        specAssessment: specAssessment ?? null,
                        saveToCourseRoute: saveToCourseRoute,
                        saveToCourseMethod: saveToCourseMethod,
                        componentInstanceId: componentInstance.id,
                    } only %}
                </li>
            {% endif %}
        {% endif %}
    </ul>
{% endif %}
