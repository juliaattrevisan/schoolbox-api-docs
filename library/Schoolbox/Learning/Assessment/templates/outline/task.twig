{% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}
{% import '@learning/macro/urgency.twig' as urgency %}

<ul class="action-list sortable-card ui-sortable task-list {% if expanded==false %}hide{% endif %}" data-task-list>
    {% for task in unit.assessables %}
        {% set preview    = task is task ? 'data-plugin="preview"' : '' %}
        {% set taskReveal = task is task ? 'data-reveal-id="modifyTask-'~task.id~'"' : '' %}

        {# TODO hook these vars up to data once available #}
        {% set taskClass   = 'incomplete' %}
        {% set taskTooltip = 'Incomplete, click to mark completed' %}

        {% set completionCount    = 0 %}
        {% if studentCount %}
            {% set completionGradient = (completionCount / studentCount) / 10 | round %}
        {% endif %}

        {# TODO: if unit.isopen and not task.requireConfirmation #}
            {# TODO: if task.undoable #}
                {% set taskAction = '/undo' %}
            {# TODO elseif task.completable #}
                {% set taskAction = '/complete' %}
            {# TODO: endif #}
        {# TODO: else #}
            {% set taskAction = '' %}
        {# TODO: endif #}

    <li class="actions-small-1 interact" data-unit-task data-unit_task_id="{{ task.id }}">
        {% if readOnly == false %}
            <div class="grip compact"></div>
        {% endif %}
        <div class="list-item">
            <div class="small-12 compact card wrap-down">
                <a class="" title="{{ task.typeName }}"  href="{{ routeLookup('learningAssessment.getAssessment', {assessmentId: task.id}) }}">
                <span class="{{ icon.renderClass(task) }}"></span>
                <p>{{ task.title }}</p>
                </a>

                <!--
                Student: see buttons for starting/ending task
                Teacher: sees completion stats
                -->
                {% if readOnly == false %}
                <p class="meta">
                    <span class="gradient-{{ completionGradient }}">{{ completionCount }}/{{ studentCount }} students completed</span>
                </p>
                {% else %}
                <p class="meta spaced">
                    <span class="unit-task-due-date">Due {{ task.dueAt.relativeTime }} on {{ task.dueAt.localShort }}</span>
                </p>
                {% endif %}
            </div>
        </div>
        <nav>
            {% if readOnly == false %}
            <a href="#" class="icon-more" data-dropdown="options-task{{ task.id }}" aria-expanded="false" title="Actions"></a>
            {% else %}
            <a href="/task/start/{{ task.id }}{{ taskAction }}" class="progress-tick {{ taskClass }}" data-interaction="update_progress" title="{{ taskTooltip }}"></a>
            {% endif %}
        </nav>
        {% if readOnly == false  %}
        <ul data-dropdown-content class="f-dropdown" id="options-task{{ task.id }}">
            {% if task is quiz %}
            <li><a href="{{ routeLookup('learningAssessment.getAssessment', {assessmentId: task.id}) }}" class="icon-progress">View Results</a></li>
            <li><a href="{{ routeLookup('learningQuiz.getQuizAttemptsByUser', {assessmentId: task.id, userId: user.id}) }}" class="icon-quiz">Previous Attempts</a></li>
            {% endif %}
            {% if task is dueWork %}
            <li><a href="{{ routeLookup('learningAssessment.getAssessment', {assessmentId: task.id}) }}" class="icon-progress">View Results</a></li>
            {% endif %}
            <li><a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: task.id}) }}?returnUrl={{ returnUrl }}" {{ taskReveal }} class="icon-modify" data-interaction="open_edit_task_form" title="Modify this task">Modify</a></li>
            <li><a href="#" class="icon-delete" data-interaction="open_delete_task_form" title="Delete this task">Delete</a></li>
        </ul>
        {% endif %}

        <!-- BEGIN unit_task_delete_form -->
        <form action="/task/saveInstanceForm.php" method="post" data-form_type="delete_task" class="hide">
            <input type="hidden" name="action"    value="delete" />
            <input type="hidden" name="id"        value="{{ task.id }}" />
            <input type="hidden" name="component" value="{{ componentInstance.id }}"/>
            <input type="hidden" name="unit_id"   value="{{ unit.id }}"/>
        </form>
        <!-- END unit_task_delete_form -->
    </li>
    {% endfor %}
</ul>
