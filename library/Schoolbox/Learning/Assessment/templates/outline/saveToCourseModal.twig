<div id="component{{ componentInstance.id }}-save-to-course-modal-{{ assessment.id }}"
     class="reveal-modal"
     data-reveal
     aria-hidden="true"
     role="dialog"
>
    <h2>Are you sure you wish to save this {{ locale.translate('activity') }} back to its course?</h2>

    {# Modal content: spec assessment exists variant #}
    <div data-display-if-spec-assessment-exists
         class="warning alert-box {% if specAssessment is null %}hide{% endif %}">
        <p>
            The original {{ locale.translate('activity') }}
            &ldquo;<span data-spec-assessment-title>{{ specAssessment.title ?? null }}</span>&rdquo;
            in the course

            <span data-display-if-spec-assessment-deleted class="{% if not (specAssessment.deleted ?? false) %}hide{% endif %}">
                has been deleted; it will be <strong>restored</strong> and <strong>replaced</strong>
            </span>
            <span data-display-if-spec-assessment-not-deleted class="{% if (specAssessment.deleted ?? false) %}hide{% endif %}">
                will be <strong>replaced</strong>
            </span>
            with this {{ locale.translate('activity') }}.
        </p>
        {% if assessment is project %}
            {% if assessment.assessables is not empty %}
                <p>
                    As this {{ locale.translate('activity') }} is a project, the {{ locale.translate('activity') }} it contains will also be <strong>replaced</strong>,
                    possibly deleting activities:
                </p>
                <p><strong>Current</strong></p>
                <ul>
                    {##
                     # If the spec assessment wasn't set when this was rendered:
                     # just render the assessment's activities here.
                     #
                     # When the save to course button is pressed again, this
                     # will be shown: we can pretend the spec assessment's
                     # activities are the same as this implementation's.
                     #}
                    {% for activity in (specAssessment.assessables ?? assessment.assessables) %}
                        <li>{{ activity.title }}</li>
                    {% endfor %}
                </ul>
                <p><strong>Replacement</strong></p>
                <ul>
                    {% for activity in assessment.assessables %}
                        <li>{{ activity.title }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if (assessment.assessables | filter(a => a is lessonPlan)) is not empty %}
                <p>
                    As this project contains {{ locale.lessonPlan.plural }},
                    any linked {{ locale.translate('activity', true) }} must be in the destination for the link to remain.
                </p>
            {% endif %}
        {% endif %}
        {% if assessment is lessonPlan %}
            <p>
                As this {{ locale.translate('activity') }} is a {{ locale.lessonPlan }},
                any linked {{ locale.translate('activity', true) }} must be in the destination for the link to remain.
            </p>
        {% endif %}
        <p>
            Any other imports into classes of the original {{ locale.translate('activity') }} will
            <strong>not</strong> be updated.
        </p>
    </div>

    {# Modal content: spec assessment doesn't exist variant #}
    <p data-display-if-spec-assessment-not-exists
       class="{% if specAssessment is not null %}hide{% endif %}"
    >
        This {{ locale.translate('activity') }}
        &ldquo;<span data-spec-assessment-title>{{ assessment.title ?? null }}</span>&rdquo;
        does not yet exist in the course;
        {% if assessment is project %}
            it and the {{ locale.translate('activity', true) }} it contains will be added.
        {% else %}
            it will be added.
        {% endif %}
    </p>

    <ul class="flex-list buttons">
        <li>
            <a href="{{ saveToCourseRoute }}"
               data-method="{{ saveToCourseMethod }}"
               class="button submit"
               data-test="confirm-dialog-yes-button{{ assessment.id }}"
               data-action="save-to-course"
               data-related-component="component{{ componentInstance.id }}"
            >Yes</a>
        </li>
        <li>
            <a href="#"
               class="button"
               data-action="save-to-course-cancel"
               data-related-component="component{{ componentInstance.id }}"
            >No</a>
        </li>
    </ul>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>
