{% import '@learningAssessment/project/macro/icon.twig' as icon %}
{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learning/macro/dueDate.twig' as dueDate %}
<ul class="action-list sortable-card ui-sortable task-list {% if expanded==false %}hide{% endif %}" data-task-list>
    {% for assessment in unit.assessables %}

        {# TODO hook these vars up to data once available #}
        {% set taskClass   = 'incomplete' %}
        {% set taskTooltip = 'Incomplete, click to mark completed' %}

        {% set completionCount    = 0 %}
        {% set studentCount       = 0 %}

        {# Is this user particpating? #}
        {% set isParticipant = assessment.isParticipant(USER) %}

        {# TODO skip this if not displaying counts, eg to teacher #}
        {# count students which have completed this #}
        {% for participant in assessment.allParticipants %}
            {% if not participant.responseRequired %}
                {% set completionCount = completionCount + 1 %}
            {% endif %}
            {% set studentCount = studentCount + 1 %}
        {% endfor %}

        {% if studentCount %}
            {% set completionGradient = (completionCount / studentCount) * 100 %}
        {% endif %}

        <li class="interact" data-unit-assessment="{{ assessment.id }}">
            <div class="actions-small-1">
                {% if canWrite %}
                    <div class="grip compact"></div>
                {% endif %}
                <div class="list-item">
                    <div class="small-12 compact card wrap-down">
                        {##
                        #  Special case for projects, to take teachers to status page rather than summary
                        #}
                        {% if canWrite and assessment is project %}
                            {% set href = routeLookup('learningAssessment.getAssessment', {assessmentId: assessment.id}) %}
                        {% else %}
                            {% if isParticipant or canWrite %}
                                {% set href = routeLookup('learningAssessment.getSummary', {assessmentId: assessment.id, studentId: USER.id}) %}
                            {%  else %}
                                {% set href = routeLookup('learningAssessment.getPreview', {assessmentId: assessment.id}) %}
                            {% endif %}
                        {% endif %}

                        <a title="{% if attribute(locale, assessment.typeName|lower) is defined %}
                                    {{ attribute(locale, assessment.typeName|lower).proper }}
                                  {% else %}
                                    {{ assessment.typeName }}
                                  {% endif %}"
                           href="{{ href }}?{{ returnUrlName }}={{ encodedReturnUrl }}">
                            <span class="{{ icon.renderClass(assessment) }}"></span>
                            <p>{{ assessment.title }}</p>
                        </a>

                        {##
                         # Metadata
                         #
                         # Teacher: sees completion stats
                         # Others: see due date
                         #}
                        {% if canWrite %}
                            <p class="meta">
                                <span class="{{ urgency.marks(completionGradient) }}">{{ completionCount }}/{{ studentCount }} students completed</span>
                            </p>
                        {% else %}
                            <p class="meta spaced">
                                <span class="unit-task-due-date">{{ dueDate.dueDate(assessment, USER) }}</span>
                            </p>
                        {% endif %}
                    </div>
                </div>
                <nav>
                    {##
                     # Buttons
                     #
                     # Teacher: sees nav
                     # Participant: sees complete task button (if of course it's a task that's self-assessable)
                     #}
                    {% if canWrite %}
                        <a href="#" class="icon-more" data-dropdown="options-task{{ assessment.id }}" aria-expanded="false" title="Actions"></a>
                    {% elseif isParticipant %}
                        {% include '@learningAssessment/fragments/progressTick.twig' with {
                            assessment: assessment,
                            participant: assessment.getParticipant(USER)
                        } only %}
                    {#{% elseif isParticipant and not (assessment is project) %}#}
                        {#{% set participant                 = assessment.getParticipant(USER) %}#}
                        {#{% set latestResponse              = participant.findMostRecentSubmittedResposne %}#}
                        {#{% set isMarkedByTeacherAsComplete = latestResponse and latestResponse.teacherAssessed and latestResponse.markedComplete %}#}
                        {#{% include '@learningAssessment/fragments/progressTick.twig' with {#}
                        {#participant: participant,#}
                        {#disabled: not assessment.isOpen or not assessment.isSelfAssessable or isMarkedByTeacherAsComplete#}
                        {#} only %}#}
                    {% endif %}
                </nav>
                {% if canWrite  %}
                    <ul data-dropdown-content class="f-dropdown" id="options-task{{ assessment.id }}">
                        <li><a href="{{ routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id}) }}" class="icon-progress">View Status</a></li>
                        {% if assessment is quiz %}
                            {% set url = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessment.id, assessment: assessment}) %}
                            {% if url %}
                                <li><a href="{{ url }}" class="icon-modify" title="Modify this {{ locale.assessment }}">Modify</a></li>
                            {% endif %}
                        {% else %}
                            {% set url = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
                            {% if url %}
                                <li><a href="{{ url }}?{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-modify" data-interaction="open_edit_task_form" title="Modify this {{ locale.assessment }}">Modify</a></li>
                            {%  endif %}
                        {% endif %}
                        {% set url = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id, assessment: assessment}) %}
                        {% if url %}
                            <li><a href="{{ url }}" class="icon-delete" data-action="delete" title="Delete this {{ locale.assessment }}">Delete</a></li>
                        {% endif %}
                    </ul>
                {% endif %}
            </div>
        </li>
    {% endfor %}
</ul>
