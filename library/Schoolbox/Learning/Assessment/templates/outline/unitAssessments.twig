{% import '@learningAssessment/project/macro/icon.twig' as icon %}
{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learning/macro/dueDate.twig' as dueDate %}
<ul class="action-list sortable-card ui-sortable task-list {% if expanded==false %}hide{% endif %}" data-task-list>
    {% for assessment in unit.assessables %}

        {# TODO hook these vars up to data once available #}
        {% set taskClass   = 'incomplete' %}
        {% set taskTooltip = 'Incomplete, click to mark completed' %}

        {% set completionCount    = 0 %}
        {% set studentCount       = 0 %}

        {# Is this user particpating? #}
        {% set isParticipant = assessment.isParticipant(USER) %}

        {# TODO skip this if not displaying counts, eg to teacher #}
        {# count students which have completed this #}
        {% for participant in assessment.allParticipants %}
            {% if not participant.responseRequired %}
                {% set completionCount = completionCount + 1 %}
            {% endif %}
            {% set studentCount = studentCount + 1 %}
        {% endfor %}

        {% if studentCount %}
            {% set completionGradient = (completionCount / studentCount) * 100 %}
        {% endif %}

        {# What routes are available to this user ? #}
        {% set statusRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
        {% if assessment is quiz %}
            {% set modifyRoute = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessment.id, assessment: assessment}) %}
        {% else %}
            {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
        {% endif %}
        {% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id, assessment: assessment}) %}
        {% set isActionRoutes = statusRoute or modifyRoute or deleteRoute %}
        {% set actionCount = (isActionRoutes ? 1 : 0) + (isParticipant ? 1 : 0) %}

        <li class="interact" data-unit-assessment="{{ assessment.id }}">
            <div{% if actionCount %} class="actions-small-{{ actionCount }}"{% endif %}>
                {% if canWrite %}
                    <div class="grip compact"></div>
                {% endif %}
                <div class="list-item">
                    <div class="small-12 compact card wrap-down">
                        {% set title = attribute(locale, assessment.typeName|lower) is defined ? attribute(locale, assessment.typeName|lower).proper : assessment.typeName %}

                        {# Special case for project. TODO consider making these route names more semanticly informative #}
                        {% if assessment is project %}
                            {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
                        {% else %}
                            {# You can see an assessment, but not visit its summary page if you are a parent, with a child participating, but system is configured to hide due work details #}
                            {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {
                                assessmentId: assessment.id,
                                assessment: assessment,
                                studentId: USER.id,
                                student: USER
                            }) %}

                            {# No route for own participation, what about children ?#}
                            {% if not viewRoute %}
                                {% for child in USER.children if not viewRoute %}
                                    {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {
                                        assessmentId: assessment.id,
                                        assessment: assessment,
                                        studentId: child.id,
                                        student: child
                                    }) %}
                                {% endfor %}
                            {% endif %}

                            {# TODO SA-5769 this should not be necessary #}
                            {% if not viewRoute %}
                                {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getPreview', {
                                    assessmentId: assessment.id,
                                    assessment: assessment
                                }) %}
                            {% endif %}
                        {% endif %}

                        {# Don't render a link if you are unable to view the details #}
                        {% if viewRoute %}
                            <a title="{{ title }}" href="{{ viewRoute }}?{{ returnUrlName }}={{ encodedReturnUrl }}">
                                <span class="{{ icon.renderClass(assessment) }}"></span>
                                <p>{{ assessment.title }}</p>
                            </a>
                        {% else %}
                            <div title="{{ title }}">
                                <span class="{{ icon.renderClass(assessment) }}"></span>
                                <p>{{ assessment.title }}</p>
                            </div>
                        {% endif %}

                        {##
                         # Metadata
                         #
                         # Teacher: sees completion stats
                         # Others: see due date
                         #}
                        {% if canWrite %}
                            <p class="meta">
                                <span class="{{ urgency.marks(completionGradient) }}">{{ completionCount }}/{{ studentCount }} students completed</span>
                            </p>
                        {% else %}
                            <p class="meta spaced">
                                <span class="unit-task-due-date">{{ dueDate.dueDate(assessment, USER) }}</span>
                            </p>
                        {% endif %}
                    </div>
                </div>

                {% if isActionRoutes or isParticipant %}
                    <nav>
                        {% if isParticipant %}
                            {# TODO known bug SA-5984. Participant progress icon renders incorrectly if part of multiple actions. #}
                            {% include '@learningAssessment/fragments/progressTick.twig' with {
                                assessment: assessment,
                                participant: assessment.getParticipant(USER)
                            } only %}
                        {% endif %}
                        {% if isActionRoutes %}
                            <a href="#" class="icon-more" data-dropdown="options-task{{ assessment.id }}" aria-expanded="false" title="Actions"></a>
                        {% endif %}
                    </nav>
                {% endif %}

                {% if isActionRoutes %}
                    <ul data-dropdown-content class="f-dropdown" id="options-task{{ assessment.id }}">
                        {% if statusRoute %}<li><a href="{{ statusRoute }}" class="icon-progress">View Status</a></li>{% endif %}
                        {% if modifyRoute %}<li><a href="{{ modifyRoute }}?{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-modify" title="Modify this {{ locale.assessment }}">Modify</a></li>{% endif %}
                        {% if deleteRoute %}<li><a href="{{ deleteRoute }}" class="icon-delete" data-action="delete" title="Delete this {{ locale.assessment }}">Delete</a></li>{% endif %}
                    </ul>
                {% endif %}
            </div>
        </li>
    {% endfor %}
</ul>
