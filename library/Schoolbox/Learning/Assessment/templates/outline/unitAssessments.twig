{% import '@learningAssessment/project/macro/icon.twig' as icon %}
{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learning/macro/viewRoute.twig' as viewRoute %}
<ul class="action-list sortable-card ui-sortable task-list {% if expanded==false %}hide{% endif %}" data-task-list>
    {% for assessment in unit.assessables %}
        {# student should only see their own assessment and not the nested assessments #}
        {% if (assessment.originalAssessmentId is not null and not canWrite) or assessment.originalAssessmentId is null %}
        {# TODO hook these vars up to data once available #}
        {% set taskClass   = 'incomplete' %}
        {% set taskTooltip = 'Incomplete, click to mark completed' %}

        {% set completionCount    = 0 %}
        {% set studentCount       = 0 %}

        {# Is this user particpating? #}
        {% set isParticipant = assessment.isParticipant(USER) %}

        {# TODO skip this if not displaying counts, eg to teacher #}
        {# count students which have completed this #}
        {% for participant in assessment.allParticipants|filter(participant => participant.isExcluded == false)  %}
            {% if not participant.responseRequired %}
                {% set completionCount = completionCount + 1 %}
            {% endif %}
            {% set studentCount = studentCount + 1 %}
        {% endfor %}

        {% if studentCount %}
            {% set completionGradient = (completionCount / studentCount) * 100 %}
        {% endif %}

        {% set specAssessment = assessment.specificationAssessment ?? null %}

        {# What action-tot routes are available to this user? #}
        {% if readOnly %}
            {# If readonly mode: show no tot #}
            {% set hasAssessmentRoutes = false %}
            {% set hasCourseRoutes = false %}
        {% else %}
            {# If write mode: show tot only if there's at least one action #}
            {% set statusRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
            {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
            {% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id, assessment: assessment}) %}
            {% set similarityReportRoute = routeLookupIfAuthorized('learningAssessment.getSimilarityReport', {assessmentId: assessment.id, assessment: assessment}) %}
            {% set kamiWorksheetRoute = routeLookupIfAuthorized('learningAssessment.getWorksheet', {assessmentId: assessment.id, assessment: assessment}) %}
            {% set hasAssessmentRoutes = statusRoute or modifyRoute or deleteRoute or similarityReportRoute or kamiWorksheetRoute%}

            {# Save to course: if spec assessment exists, this is a PUT: otherwise a POST #}
            {% if specAssessment %}
                {% set saveToCourseRoute = routeLookupIfAuthorized(
                    'courseExport.putAssessmentIntoUnit',
                    {
                        assessmentId: assessment.id,
                        assessment: assessment,
                        unitSpecId: unit.specification.id,
                        unitSpec: unit.specification,
                    }
                ) %}
                {% set saveToCourseMethod = 'PUT' %}
            {% else %}
                {% set saveToCourseRoute = routeLookupIfAuthorized(
                    'courseExport.postAssessmentIntoUnit',
                    {
                        assessmentId: assessment.id,
                        assessment: assessment,
                        unitSpecId: unit.specification.id,
                        unitSpec: unit.specification,
                    }
                ) %}
                {% set saveToCourseMethod = 'POST' %}
            {% endif %}
            {% set hasCourseRoutes = saveToCourseRoute is not empty %}
        {% endif %}

        <li class="interact" {% if filterList and assessment.getFamilyName not in filterList %}data-sortable-hidden="true"{% endif %} data-unit-assessment="{{ assessment.id }}">
            <div{% if hasAssessmentRoutes or hasCourseRoutes or isParticipant %} class="actions-small-1"{% endif %}>
                {% if canWrite %}
                    <div class="grip compact"></div>
                {% endif %}
                {% if assessment.customisedAssessments is not empty %}
                <a class="expand-link icon-up-arrow l-pad-s--left" data-interaction="toggle-expanded" data-interaction-state="collapsed"></a>
                {% endif %}
                <div class="list-item">
                    <div class="small-12 compact card wrap-down">
                        {% set title = attribute(locale, assessment.typeName|lower) is defined ? attribute(locale, assessment.typeName|lower).proper : assessment.typeName %}

                        {# Don't render a link if you are unable to view the details #}
                        {% set route = viewRoute.viewRoute(assessment, USER) %}
                        {% if route %}
                            <a title="{{ title }}" href="{{ route }}" data-test="course-outline-assessment-title-{{ assessment.title }}">
                                {# Render the icon for the assessment type #}
                                <span class="{{ icon.renderClass(assessment) }}"></span>
                                <p>{{ assessment.title }}</p>
                            </a>
                        {% else %}
                            <div title="{{ title }}">
                                <span class="{{ icon.renderClass(assessment) }}"></span>
                                <p>{{ assessment.title }}</p>
                            </div>
                        {% endif %}

                        {##
                         # Metadata
                         #
                         # Teacher: sees completion stats and due date for base assessment
                         # Others: see due date as per participation
                         #}
                        {% if canWrite %}
                            <p class="meta" data-test="course-outline-number-students-{{ assessment.title }}">
                                {{ dueDate.forAssessment(assessment) }}&nbsp;{% if assessment is not lessonPlan %}|&nbsp;<span class="{{ urgency.marks(completionGradient ?? '') }}">{{ completionCount }}/{{ studentCount }} students completed</span>{% endif %}
                            </p>
                        {% else %}
                            <p class="meta">
                                <span class="unit-task-due-date">{{ dueDate.dueDate(assessment, USER) }}</span>
                            </p>
                        {% endif %}
                    </div>
                </div>

                {% include '@learningAssessment/outline/partial.twig' with {
                    assessment: assessment,
                    hasAssessmentRoutes: hasAssessmentRoutes,
                    hasCourseRoutes: hasCourseRoutes,
                    saveToCourseRoute: saveToCourseRoute,
                    saveToCourseMethod: saveToCourseMethod,
                    kamiWorksheetRoute: kamiWorksheetRoute,
                    statusRoute: statusRoute,
                    modifyRoute: modifyRoute,
                    deleteRoute: deleteRoute,
                    similarityReportRoute: similarityReportRoute,
                } %}

            </div>
            {% if assessment.customisedAssessments is not empty %}
            <ul class="information-list threaded">
                {% for customisedAssessment in assessment.customisedAssessments %}
                    {% set customisedAssessmentCompletionCount    = 0 %}
                    {% set customisedAssessmentStudentCount       = 0 %}

                    {# TODO skip this if not displaying counts, eg to teacher #}
                    {# count students which have completed this #}
                    {% for customisedAssessmentParticipant in customisedAssessment.allParticipants|filter(customisedAssessmentParticipant => customisedAssessmentParticipant.isExcluded == false)  %}
                        {% if not customisedAssessmentParticipant.responseRequired %}
                            {% set customisedAssessmentCompletionCount = customisedAssessmentCompletionCount + 1 %}
                        {% endif %}
                        {% set customisedAssessmentStudentCount = customisedAssessmentStudentCount + 1 %}
                    {% endfor %}

                    {% if customisedAssessmentStudentCount %}
                        {% set customisedAssessmentCompletionGradient = (customisedAssessmentCompletionCount / customisedAssessmentStudentCount) * 100 %}
                    {% endif %}

                    {% set specCustomisedAssessment = customisedAssessment.specificationAssessment ?? null %}

                    {# What action-tot routes are available to this user? #}
                    {% if readOnly %}
                        {# If readonly mode: show no tot #}
                        {% set hasAssessmentCustomisedRoutes = false %}
                        {% set hasCourseCustomisedRoutes = false %}
                    {% else %}
                        {# If write mode: show tot only if there's at least one action #}
                        {% set statusCustomisedRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: customisedAssessment.id, assessment: customisedAssessment}) %}
                        {% set modifyCustomisedRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: customisedAssessment.id, assessment: customisedAssessment}) %}
                        {% set deleteCustomisedRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: customisedAssessment.id, assessment: customisedAssessment}) %}
                        {% set similarityReportCustomisedRoute = routeLookupIfAuthorized('learningAssessment.getSimilarityReport', {assessmentId: customisedAssessment.id, assessment: customisedAssessment}) %}
                        {% set kamiWorksheetCustomisedRoute = routeLookupIfAuthorized('learningAssessment.getWorksheet', {assessmentId: customisedAssessment.id, assessment: customisedAssessment}) %}
                        {% set hasAssessmentCustomisedRoutes = statusRoute or modifyRoute or deleteRoute or similarityReportRoute or kamiWorksheetRoute%}

                        {# Save to course: if spec assessment exists, this is a PUT: otherwise a POST #}
                        {% if specCustomisedAssessment %}
                            {% set saveToCourseCustomisedRoute = routeLookupIfAuthorized(
                                'courseExport.putAssessmentIntoUnit',
                                {
                                    assessmentId: customisedAssessment.id,
                                    assessment: customisedAssessment,
                                    unitSpecId: unit.specification.id,
                                    unitSpec: unit.specification,
                                }
                            ) %}
                            {% set saveToCourseCustomisedMethod = 'PUT' %}
                        {% else %}
                            {% set saveToCourseCustomisedRoute = routeLookupIfAuthorized(
                                'courseExport.postAssessmentIntoUnit',
                                {
                                    assessmentId: customisedAssessment.id,
                                    assessment: customisedAssessment,
                                    unitSpecId: unit.specification.id,
                                    unitSpec: unit.specification,
                                }
                            ) %}
                            {% set saveToCourseCustomisedMethod = 'POST' %}
                        {% endif %}
                        {% set hasCourseCustomisedRoutes = saveToCourseCustomisedRoute is not empty %}
                    {% endif %}

                    <li class="child"  {% if filterList and customisedAssessment.getFamilyName not in filterList %}data-sortable-hidden="true"{% endif %} data-unit-assessment="{{ customisedAssessment.id }}">
                    <div class="actions-small-1">
                        <div class="list-item">
                            <div class="small-12 compact card wrap-down">
                                {% set customTitle = attribute(locale, customisedAssessment.typeName|lower) is defined ? attribute(locale, customisedAssessment.typeName|lower).proper : customisedAssessment.typeName %}
                                {% set customRoute = viewRoute.viewRoute(customisedAssessment, USER) %}
                                {% if route %}
                                    <a title="{{ customTitle }}" href="{{ customRoute }}">
                                        <span class="{{ icon.renderClass(customisedAssessment) }}"></span>
                                        <p>{{ customisedAssessment.title }}</p>
                                    </a>
                                {% else %}
                                    <div title="{{ customTitle }}">
                                        <span class="{{ icon.renderClass(customisedAssessment) }}"></span>
                                        <p>{{ customisedAssessment.title }}</p>
                                    </div>
                                {% endif %}
                                {% if canWrite %}
                                    <p class="meta">
                                        {{ dueDate.forAssessment(customisedAssessment) }}&nbsp;{% if customisedAssessment is not lessonPlan %}|&nbsp;<span class="{{ urgency.marks(customisedAssessmentCompletionGradient ?? '') }}">{{ customisedAssessmentCompletionCount }}/{{ customisedAssessmentStudentCount }} students completed</span>{% endif %}
                                    </p>
                                {% else %}
                                    <p class="meta">
                                        <span class="unit-task-due-date">{{ dueDate.dueDate(customisedAssessment, USER) }}</span>
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                        {% include '@learningAssessment/outline/partial.twig' with {
                            assessment: customisedAssessment,
                            hasAssessmentRoutes: hasAssessmentCustomisedRoutes,
                            hasCourseRoutes: hasCourseCustomisedRoutes,
                            saveToCourseRoute: saveToCourseCustomisedRoute,
                            saveToCourseMethod: saveToCourseCustomisedMethod,
                            kamiWorksheetCustomisedRoute: kamiWorksheetCustomisedRoute,
                            statusRoute: statusCustomisedRoute,
                            modifyRoute: modifyCustomisedRoute,
                            deleteRoute: deleteCustomisedRoute,
                            similarityReportRoute: similarityReportCustomisedRoute,
                        } %}

                    </div>
                </li>
                {% endfor %}
