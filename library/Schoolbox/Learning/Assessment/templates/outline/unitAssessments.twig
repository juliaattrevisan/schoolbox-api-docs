{% import '@learningAssessment/fragments/project/macro/icon.twig' as icon %}
{% import '@learning/macro/urgency.twig' as urgency %}
<ul class="action-list sortable-card ui-sortable task-list {% if expanded==false %}hide{% endif %}" data-task-list>
    {% for task in unit.assessables %}
        {% set preview    = task is task ? 'data-plugin="preview"' : '' %}

        {# TODO hook these vars up to data once available #}
        {% set taskClass   = 'incomplete' %}
        {% set taskTooltip = 'Incomplete, click to mark completed' %}

        {% set completionCount    = 0 %}
        {% set studentCount       = 0 %}

        {# Is this user particpating? #}
        {% set isParticipant = task.isParticipant(currentUser) %}

        {# count students which have completed this #}
        {% for participant in task.allParticipants %}
            {% if participant.complete %}
                {% set completionCount = completionCount + 1 %}
            {% endif %}
            {% set studentCount = studentCount + 1 %}
        {% endfor %}

        {% if studentCount %}
            {% set completionGradient = (completionCount / studentCount) * 100 %}
        {% endif %}

        {# TODO: if unit.isopen and not task.requireConfirmation #}
            {# TODO: if task.undoable #}
                {% set taskAction = '/undo' %}
            {# TODO elseif task.completable #}
                {% set taskAction = '/complete' %}
            {# TODO: endif #}
        {# TODO: else #}
            {% set taskAction = '' %}
        {# TODO: endif #}

    <li class="actions-small-1 interact" data-unit-assessment="{{ task.id }}">
        {% if readOnly == false %}
            <div class="grip compact"></div>
        {% endif %}
        <div class="list-item">
            <div class="small-12 compact card wrap-down">
                <a class="" title="{{ task.typeName }}"  href="{{ routeLookup('learningAssessment.getAssessment', {assessmentId: task.id}) }}">
                <span class="{{ icon.renderClass(task) }}"></span>
                <p>{{ task.title }}</p>
                </a>

                {##
                 # Metadata
                 #
                 # Teacher: sees completion stats
                 # Others: see due date
                 #}
                {% if readOnly == false %}
                <p class="meta">
                    <span class="{{ urgency.marks(completionGradient) }}">{{ completionCount }}/{{ studentCount }} students completed</span>
                </p>
                {% else %}
                <p class="meta spaced">
                    <span class="unit-task-due-date">Due {{ task.dueAt.relativeTime }} on {{ task.dueAt.localShort }}</span>
                </p>
                {% endif %}
            </div>
        </div>
        <nav>
            {##
             # Buttons
             #
             # Teacher: sees nav
             # Participant: sees complete task button (if of course it's a task that's self-assessable)
             #}
            {% if readOnly == false %}
            <a href="#" class="icon-more" data-dropdown="options-task{{ task.id }}" aria-expanded="false" title="Actions"></a>
            {% elseif isParticipant and task is task and task.selfAssessed %}

                {% include '@learningMarkScheme/Completion.twig' with {
                    participant: task.getParticipant(currentUser),
                    markScheme: task.markScheme,
                } %}

            {#<a href="/task/start/{{ task.id }}{{ taskAction }}" class="progress-tick {{ taskClass }}" data-interaction="update_progress" title="{{ taskTooltip }}"></a>#}
            {% endif %}
        </nav>
        {% if readOnly == false  %}
        <ul data-dropdown-content class="f-dropdown" id="options-task{{ task.id }}">
            {% if task is quiz %}
            <li><a href="{{ routeLookup('learningAssessment.getAssessment', {assessmentId: task.id}) }}" class="icon-progress">View Results</a></li>
            <li><a href="{{ routeLookup('learningQuiz.getQuizAttemptsByUser', {assessmentId: task.id, userId: user.id}) }}" class="icon-quiz">Previous Attempts</a></li>
            {% endif %}
            {% if task is dueWork %}
            <li><a href="{{ routeLookup('learningAssessment.getAssessment', {assessmentId: task.id}) }}" class="icon-progress">View Results</a></li>
            {% endif %}
            {% if task is quiz %}
            <li><a href="{{ routeLookup('learningQuiz.getQuizSummary', {assessmentId: task.id}) }}" class="icon-modify" title="Modify this task">Modify</a></li>
            {% else %}
            <li><a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: task.id}) }}?returnUrl={{ returnUrl }}" class="icon-modify" data-interaction="open_edit_task_form" title="Modify this task">Modify</a></li>
            {% endif %}
            <li><a href="{{ routeLookup('learningAssessment.postDeleteAssessment', {assessmentId: task.id}) }}" class="icon-delete" data-action="delete" title="Delete this task">Delete</a></li>
        </ul>
        {% endif %}
    </li>
    {% endfor %}
</ul>
