{% import '@learningAssessment/project/macro/icon.twig' as icon %}
{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learning/macro/viewRoute.twig' as viewRoute %}
<ul class="action-list sortable-card ui-sortable task-list {% if expanded==false %}hide{% endif %}" data-task-list>
    {% for assessment in unit.assessables %}

        {# TODO hook these vars up to data once available #}
        {% set taskClass   = 'incomplete' %}
        {% set taskTooltip = 'Incomplete, click to mark completed' %}

        {% set completionCount    = 0 %}
        {% set studentCount       = 0 %}

        {# Is this user particpating? #}
        {% set isParticipant = assessment.isParticipant(USER) %}

        {# TODO skip this if not displaying counts, eg to teacher #}
        {# count students which have completed this #}
        {% for participant in assessment.allParticipants|filter(participant => participant.isExcluded == false)  %}
            {% if not participant.responseRequired %}
                {% set completionCount = completionCount + 1 %}
            {% endif %}
            {% set studentCount = studentCount + 1 %}
        {% endfor %}

        {% if studentCount %}
            {% set completionGradient = (completionCount / studentCount) * 100 %}
        {% endif %}

        {% set specAssessment = assessment.specificationAssessment ?? null %}

        {# What action-tot routes are available to this user? #}
        {% if readOnly %}
            {# If readonly mode: show no tot #}
            {% set hasAssessmentRoutes = false %}
            {% set hasCourseRoutes = false %}
        {% else %}
            {# If write mode: show tot only if there's at least one action #}
            {% set statusRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
            {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
            {% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id, assessment: assessment}) %}
            {% set similarityReportRoute = routeLookupIfAuthorized('learningAssessment.getSimilarityReport', {assessmentId: assessment.id, assessment: assessment}) %}
            {% set kamiWorksheetRoute = routeLookupIfAuthorized('learningAssessment.getWorksheet', {assessmentId: assessment.id, assessment: assessment}) %}
            {% set hasAssessmentRoutes = statusRoute or modifyRoute or deleteRoute or similarityReportRoute or kamiWorksheetRoute%}

            {# Save to course: if spec assessment exists, this is a PUT: otherwise a POST #}
            {% if specAssessment %}
                {% set saveToCourseRoute = routeLookupIfAuthorized(
                    'courseExport.putAssessmentIntoUnit',
                    {
                        assessmentId: assessment.id,
                        assessment: assessment,
                        unitSpecId: unit.specification.id,
                        unitSpec: unit.specification,
                    }
                ) %}
                {% set saveToCourseMethod = 'PUT' %}
            {% else %}
                {% set saveToCourseRoute = routeLookupIfAuthorized(
                    'courseExport.postAssessmentIntoUnit',
                    {
                        assessmentId: assessment.id,
                        assessment: assessment,
                        unitSpecId: unit.specification.id,
                        unitSpec: unit.specification,
                    }
                ) %}
                {% set saveToCourseMethod = 'POST' %}
            {% endif %}
            {% set hasCourseRoutes = saveToCourseRoute is not empty %}
        {% endif %}

        <li class="interact" {% if filterList and assessment.getFamilyName not in filterList %}data-sortable-hidden="true"{% endif %} data-unit-assessment="{{ assessment.id }}">
            <div{% if hasAssessmentRoutes or hasCourseRoutes or isParticipant %} class="actions-small-1"{% endif %}>
                {% if canWrite %}
                    <div class="grip compact"></div>
                {% endif %}
                {% if assessment.id == 32 %}
                <a class="expand-link icon-up-arrow l-pad-s--left" data-interaction="toggle-expanded" data-interaction-state="collapsed"></a>
                {% endif %}
                <div class="list-item">
                    <div class="small-12 compact card wrap-down">
                        {% set title = attribute(locale, assessment.typeName|lower) is defined ? attribute(locale, assessment.typeName|lower).proper : assessment.typeName %}

                        {# Don't render a link if you are unable to view the details #}
                        {% set route = viewRoute.viewRoute(assessment, USER) %}
                        {% if route %}
                            <a title="{{ title }}" href="{{ route }}" data-test="course-outline-assessment-title-{{ assessment.title }}">
                                {# Render the icon for the assessment type #}
                                <span class="{{ icon.renderClass(assessment) }}"></span>
                                <p>{{ assessment.title }}</p>
                            </a>
                        {% else %}
                            <div title="{{ title }}">
                                <span class="{{ icon.renderClass(assessment) }}"></span>
                                <p>{{ assessment.title }}</p>
                            </div>
                        {% endif %}

                        {##
                         # Metadata
                         #
                         # Teacher: sees completion stats and due date for base assessment
                         # Others: see due date as per participation
                         #}
                        {% if canWrite %}
                            <p class="meta" data-test="course-outline-number-students-{{ assessment.title }}">
                                {{ dueDate.forAssessment(assessment) }}&nbsp;{% if assessment is not lessonPlan %}|&nbsp;<span class="{{ urgency.marks(completionGradient ?? '') }}">{{ completionCount }}/{{ studentCount }} students completed</span>{% endif %}
                            </p>
                        {% else %}
                            <p class="meta">
                                <span class="unit-task-due-date">{{ dueDate.dueDate(assessment, USER) }}</span>
                            </p>
                        {% endif %}
                    </div>
                </div>

                {% if hasAssessmentRoutes or hasCourseRoutes or isParticipant %}
                    <nav>
                        {% if hasAssessmentRoutes or hasCourseRoutes %}
                            <sbx-pop-out content-id="component{{ componentInstance.id }}-options-task{{ assessment.id }}"></sbx-pop-out>
                        {% elseif isParticipant %}
                            {% include '@learningAssessment/fragments/progressTick.twig' with {
                                assessment: assessment,
                                student: USER
                            } only %}
                        {% endif %}

                    </nav>
                {% endif %}

                {% if hasAssessmentRoutes or hasCourseRoutes %}
                    <ul data-dropdown-content class="f-dropdown" id="component{{ componentInstance.id }}-options-task{{ assessment.id }}">
                        {% if hasAssessmentRoutes %}
                            <li class="separator">{{ locale.translate('activity', false, true) }}</li>
                            {% if statusRoute %}<li><a href="{{ statusRoute }}" class="icon-progress">View Status</a></li>{% endif %}
                            {% if assessment is dueWork %}
                                {% set viewGradeRoute = routeLookupIfAuthorized('learningDueWorkResponse.getFirstParticipantResponse', {
                                    assessmentId: assessment.id,
                                    assessment: assessment,
                                }) %}
                                {% if viewGradeRoute %}
                                <li><a class="icon-task" href="{{ viewGradeRoute }}" >View and {{ locale.grades }} submissions</a></li>
                                {% endif %}
                            {% endif %}
                            {% set viewCustomParticipationRoute = routeLookupIfAuthorized('learningAssessment.getAssessmentParticipationForm', {
                                assessmentId: assessment.id,
                                assessment: assessment
                            }) %}
                            {% if viewCustomParticipationRoute and assessment is not project and assessment is not lessonPlan %}
                                <li><a class="icon-group" href="{{ viewCustomParticipationRoute }}">Student Participation</a></li>
                            {% endif %}
                            {% if assessment is dueWork and assessment.enableWorksheet and kamiWorksheetRoute %}
                                <li>
                                    <a id="kamiWorksheet" class="icon-surveys" href="{{ kamiWorksheetRoute }}">Class View</a>
                                </li>
                            {% endif %}
                            {% if similarityReportRoute %}<li><a href="{{ similarityReportRoute }}?{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-due-work" title="View Similarity Report">Similarity Report</a></li>{% endif %}
                            {%  if assessment is dueWork and assessment.useRubric %}
                                <li>
                                    <a href="{{ routeLookup('learningAssessment.getOverview', { assessmentId: assessment.id }) }}"
                                       class="icon-criteria">Rubric Report</a>
                                </li>
                            {% endif %}

                            {# Learnosity Quiz has two parts: Modify Quiz and Modify Contents #}
                            {% if modifyRoute %}
                                {% if assessment is quiz %}
                                    {% set modifyContentsRoute = routeLookupIfAuthorized('learnosity.getContent', {assessment: assessment, assessmentId: assessment.id}) %}
                                    <li><a class="icon-class-list" href="{{ routeLookup('learnosity.getHorizontalMarking', { assessmentId: assessment.id }) }}">Review horizontally</a></li>
                                    <li><a class="icon-modify" href="{{ modifyRoute }}?{{ returnUrlName }}={{ encodedReturnUrl }}" title="Modify this {{ locale.assessment }}">Modify Settings</a></li>
                                    <li><a class="icon-modify" href="{{ modifyContentsRoute }}?{{ returnUrlName }}={{ encodedReturnUrl }}" title="Modify this {{ locale.assessment }} contents">Modify Contents</a></li>
                                {% else %}
                                    <li><a class="icon-modify" href="{{ modifyRoute }}?{{ returnUrlName }}={{ encodedReturnUrl }}" title="Modify this {{ locale.assessment }}">Modify</a></li>
                                {% endif %}
                            {% endif %}

                            {% if deleteRoute %}<li><a href="{{ deleteRoute }}" class="icon-delete" data-action="delete" title="Delete this {{ locale.assessment }}">Delete</a></li>{% endif %}
                        {% endif %}
                        {% if hasCourseRoutes %}
                            <li class="separator">Course</li>
                            {% if saveToCourseRoute %}
                                <li>
                                    <a href="{{ saveToCourseRoute }}"
                                       class="icon-export"
                                       data-reveal-id="component{{ componentInstance.id }}-save-to-course-modal-{{ assessment.id }}"
                                       data-method="{{ saveToCourseMethod }}"
                                       data-spec-assessment-id="{{ specAssessment.id ?? null }}"
                                       data-spec-assessment-title="{{ specAssessment.title ?? null }}"
                                    >Save to Course...</a>
                                    {% include '@learningAssessment/outline/saveToCourseModal.twig' with {
                                        assessment: assessment,
                                        specAssessment: specAssessment ?? null,
                                        saveToCourseRoute: saveToCourseRoute,
                                        saveToCourseMethod: saveToCourseMethod,
                                        componentInstance: componentInstance,
                                    } only %}
                                </li>
                            {% endif %}
                        {% endif %}
                    </ul>
                {% endif %}
            </div>
            {% if assessment.id == 32 %}
            <ul class="information-list threaded">
                <li class="child" data-unit-assessment="x" style="">
                    <div class="actions-small-1">
                        <div class="list-item">
                            <div class="small-12 compact card wrap-down">
                                <a title="Learning Activity" href="/learning/assessments/33/1">
                                    <span class="icon-task"></span>
                                    <p>Pre unit customised task</p>
                                </a>
                                <p class="meta">
                                    <span title="Wednesday August 6th 2025 5:00pm">Due
                                    <time datetime="2025-08-06T17:00:00+10:00">Aug 6, 2025 at 5:00pm</time></span>&nbsp;|&nbsp;<span class="gradient-2">1/2 students completed</span>
                                </p>
                            </div>
                        </div>
                        <nav>
                            <sbx-pop-out content-id="component3374-options-task33"></sbx-pop-out>
                        </nav>
                        <ul data-dropdown-content="" class="f-dropdown" id="component3374-options-task33" aria-hidden="true">
                            <li class="separator">Activity</li>
                            <li><a href="/learning/assessments/33/status" class="icon-progress">View Status</a></li>
                            <li><a class="icon-group" href="/learning/assessments/33/participation">Student Participation</a></li>
                            <li><a class="icon-modify" href="/learning/assessments/33/modify?returnUrl=L2hvbWVwYWdlLzgwI2NvbXBvbmVudDMzNzQ%3D" title="Modify this assessment">Modify</a></li>
                            <li><a href="/learning/assessments/33/delete" class="icon-delete" data-action="delete" title="Delete this assessment">Delete</a></li>
                            <li class="separator">Course</li>
                            <li>
                                <a href="/course/export/unitspecs/12/assessment/33" class="icon-export" data-reveal-id="component3374-save-to-course-modal-33" data-method="PUT" data-spec-assessment-id="1" data-spec-assessment-title="Post to Forum: Prologue">Save to Course...</a>
                                <div id="component3374-save-to-course-modal-33" class="reveal-modal" data-reveal="" aria-hidden="true" role="dialog">
                                    <h2>Are you sure you wish to save this activity back to its course?</h2>
                                    <div data-display-if-spec-assessment-exists="" class="warning alert-box ">
                                        <p>
                                            The original activity
                                            “<span data-spec-assessment-title="">Post to Forum: Prologue</span>”
                                            in the course

                                            <span data-display-if-spec-assessment-deleted="" class="hide">
                                                has been deleted; it will be <strong>restored</strong> and <strong>replaced</strong>
                                            </span>
                                            <span data-display-if-spec-assessment-not-deleted="" class="">
                                                will be <strong>replaced</strong>
                                            </span>
                                            with this activity.
                                        </p>
                                        <p>
                                            Any other imports into classes of the original activity will
                                            <strong>not</strong> be updated.
                                        </p>
                                    </div>
                                    <p data-display-if-spec-assessment-not-exists="" class="hide">
                                    This activity
                                    “<span data-spec-assessment-title="">Post to Forum: Prologue</span>”
                                    does not yet exist in the course;
                                                it will be added.
                                    </p>
                                    <ul class="flex-list buttons">
                                        <li>
                                            <a href="/course/export/unitspecs/12/assessment/33" data-method="PUT" class="button submit" data-action="save-to-course" data-related-component="component3374">Yes</a>
                                        </li>
                                        <li>
                                            <a href="#" class="button" data-action="save-to-course-cancel" data-related-component="component3374">No</a>
                                        </li>
                                    </ul>
                                    <a class="close-reveal-modal" aria-label="Close">×</a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </li>
            </ul>
            {% endif %}
        </li>
    {% endfor %}
</ul>
