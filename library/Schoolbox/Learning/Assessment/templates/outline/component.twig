<script type="text/javascript" src="/javascript/shared/course/jquery.course-outline.js"></script>
<script type="text/javascript">
        $(function() {
            var component = $('#component{{ componentInstance.id }}'),
                    socialstreamSession = { categoryId: '{{ course.folder.id }}' };

            component.setupCourseOutline({
                course_homepage: '{{ course.folder.id }}',
                import_base_url: '{{ routeLookup('courseImport.getImportToClassForm', { courseSpecId: course.id, classCode: folder.id }) }}',
                readonly:        {{ readOnly ? 'true':'false' }},
                previewSelector: '[data-plugin=preview]'
            });

            /* Alternate expando style
             */
            component.on('click', 'a[data-interaction="toggle-expanded"]', function(event){
                event.preventDefault();

                $(this).closest('li').find('[data-task-list]').removeClass('hide');
                $(this).toggleClass('icon-down-arrow icon-up-arrow');
                $(this).closest('li').toggleClass('expanded');
            });



        });
</script>
<section>
    {% if courseImplementation.units|length %}
        <p class="component-titlebar meta">
            <a class="icon-course" href="/homepage/{{ course.folder.id }}" title="Visit course page">{{ course.title }}</a>
        </p>
        {% include '@learningAssessment/outline/unit.twig' %}
        <div class="component-action">
            <section>
                <a href="{{ routeLookup('courseImport.importModify', { courseImplId: courseImplementation.id }) }}" class="button">Modify</a>
            </section>
        </div>
    {% else %}
        <div class="content">
            <p>To get started with courses you need to first import an existing course to display</p>

            <a href="#" class="button icon-course" data-add-button data-instance-id="{{ componentInstance.id }}" data-intesction="homepage_selector" data-course-selector="{{ componentInstance.id }}">Import New Course</a>
            <a href="{{ routeLookup('courseImport.getManagement', { folderId: context.id }) }}" class="button icon-export">Manage Courses</a>
        </div>
    {% endif %}
</section>

<!-- Form for reodering tasks -->
<div class="hide">
<form action="/task/saveInstanceForm.php" method="post" class="reorder_form">
    <input type="hidden" name="action"    value="reorder"/>
    <input type="hidden" name="category"  value="{{ context.id }}"/>
    <input type="hidden" name="unit_id" value=""/>
</form>
</div>

