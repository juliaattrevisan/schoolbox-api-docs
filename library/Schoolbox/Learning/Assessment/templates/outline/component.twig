<script type="text/javascript" src="{{ CDN_PREFIX }}/js/course/jquery.course-outline.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/assessment/jquery.assessment-component-tot.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/task/jquery.progressTickForm.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
        $(function() {
            var $component = $('#component{{ componentInstance.id }}'),
                socialstreamSession = { categoryId: '{{ courseSpecification.folder.id ?? '' }}' };

            $component.setupCourseOutline({
                readonly:        {{ readOnly ? 'true' : 'false' }},
                previewSelector: '[data-plugin=preview]'
            });

            $component.setupAssessmentComponentTot();

            /* Alternate expando style
             */
            $component.on('click', 'a[data-interaction="toggle-expanded"]', function(event){
                event.preventDefault();
                $(this).closest('li').find('[data-task-list]').removeClass('hide');
                $(this).toggleClass('icon-down-arrow icon-up-arrow');
                $(this).closest('li').toggleClass('expanded');
            });

            /**
             * Toggle customised assessments visibility
             */
            $component.on('click', 'a[data-interaction-has-customised]', function(event){
                event.preventDefault();
                const $customisedAssessments = $(this).closest('li').find('[data-customised-assessments]');
                if ($customisedAssessments.hasClass('hide')) {
                    $customisedAssessments.removeClass("hide").slideDown();
                } else {
                    $customisedAssessments.slideUp(400, function() {
                        $(this).addClass("hide");
                    });
                }
                $(this).toggleClass('icon-down-arrow icon-up-arrow'); // switch icon to indicate next state
            });

            // Save form for task completion
            $component.find('form[data-progress-tick-form]').progressTickForm({
                disabledSelector: 'form:not([data-progress-tick-form="selfAssessed"])',
                transitions: {
                    incomplete:      'selfAssessed',
                    selfAssessed:    'incomplete',
                    teacherAssessed: 'incomplete'
                }
            });

            // Open component settings on click of filtered info
            $component.find('[data-action="filtered"]').on('click', function(event){
                event.preventDefault();
                document.querySelector('#component{{ componentInstance.id }} [data-target="settings"]').click();
            });
        });
</script>
{% set urlSuffix = (encodedReturnUrl | length) ? ('?' ~ returnUrlName ~ '=' ~ encodedReturnUrl) : '' %}
<section>
{% if filterList and not readOnly%}
    <p class="component-titlebar meta">
            <a title="View / Edit filter" data-action="filtered"><sbx-icon name="filter"></sbx-icon>This is being filtered</a>
    </p>
{% endif %}
    {% if (courseImplementation.units ?? [])|length %}
        <p class="component-titlebar meta">
            {% if courseSpecification.folder.id in accessibleFolderIds %}
                <a class="icon-course" href="{{ '/homepage/' ~ courseSpecification.folder.id }}" title="Visit course page">{{ courseSpecification.title }}</a>
            {% else %}
                <a class="icon-course">{{ courseSpecification.title }}</a>
            {% endif %}
        </p>

        {% include '@learningAssessment/outline/unit.twig' %}

        {% set modifyRoute = routeLookupIfAuthorized('courseImport.getModify', { courseImplId: courseImplementation.id, courseImpl: courseImplementation }) %}
        {% if not readOnly and modifyRoute %}
        <div class="component-action">
            <section>
                <a href="{{ modifyRoute }}{{ urlSuffix }}" class="button">Modify</a>
            </section>
        </div>
        {% endif %}

    {% elseif not readOnly %}

        <div class="empty-state">
            <i class="icon-course-outline"></i>
            <p><a href="#" data-add-button data-instance-id="{{ componentInstance.id }}" data-intesction="homepage_selector" data-course-selector="{{ componentInstance.id }}">Import a course</a> to your class page to make tasks, {{ locale.dueWork }}, quizzes, {{ locale.project.plural }} and {{ locale.lessonPlan.plural }} available for your students to complete.</p>
        </div>

    {% endif %}

</section>
