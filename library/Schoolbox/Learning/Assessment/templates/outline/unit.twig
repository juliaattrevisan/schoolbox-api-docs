{% import '@learningAssessment/fragments/macro/unit/completed.twig' as status %}

<ul class="information-list">
    {% for unit in courseImplementation.units %}
        {% set expanded = unit.isOpen == true %}
        {% set expanded_icon = expanded ? 'icon-up-arrow' :'icon-down-arrow'  %}
        {% set expanded_state = expanded ? 'expanded' :'collapsed' %}

        <li class="interact {{ expanded_state }}" data-unit="{{ unit.id }}" data-open_date="{{ unit.openDate.databaseDate }}" data-due_date="{{ unit.dueDate.databaseDate }}">
            <div class="actions-small-1">
                <div class="list-item">
                    <div class="card small-12">
                        <h3>
                            {% if unit.isBeforeOpenDate==false or readOnly == false %}
                                <a class="expand-link {{ expanded_icon }}" data-interaction="toggle-expanded" data-interaction-state="{{ expanded_state }}"></a>
                                {% if unit.specification.folder.id in accessibleFolderIds %}
                                    <a href="{{ '/homepage/' ~ unit.specification.folder.id }}">{{ unit.title }}</a>
                                {% else %}
                                    {{ unit.title }}
                                {% endif %}
                            {% else %}
                                {{ unit.title }}
                            {% endif %}
                        </h3>
                        <p class="{{ status.unitUrgency(unit) }}">{{ status.unitCompletion(unit) }}</p>
                    </div>
                </div>
                {% if readOnly == false %}
                <nav>
                    <sbx-pop-out content-id="component{{ componentInstance.id }}-unit-options{{ unit.id }}"></sbx-pop-out>
                </nav>
                <ul data-dropdown-content class="f-dropdown" id="component{{ componentInstance.id }}-unit-options{{ unit.id }}">

                    {% if unit.isAfterDueDate == false %}
                    <li class="separator">Create</li>
                    <li><a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'units', contextId: unit.id, context: unit}) }}?type=project&{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-project" data-test="course-outline-menu-add-project">{{ locale.project.proper }}</a></li>
                    <li><a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'units', contextId: unit.id, context: unit}) }}?type=dueWork&{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-due-work" data-test="course-outline-menu-add-due-work" data-add-button data-form_class="for-due-work">{{ locale.dueWork.proper }}</a></li>
                    <li><a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'units', contextId: unit.id, context: unit}) }}?type=quiz&{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-quiz" data-test="course-outline-menu-add-quiz" data-add-button data-form_class="for-assessment">Quiz</a></li>
                    <li><a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'units', contextId: unit.id, context: unit}) }}?type=task&{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-task" data-test="course-outline-menu-add-task">Task</a></li>
                    {% if config.lti_assessments_enable %}
                    <li><a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'units', contextId: unit.id, context: unit}) }}?type=lti&{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-lti">3rd Party Assessment</a></li>
                    {% endif %}
                    <li><a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'units', contextId: unit.id, context: unit}) }}?type=lessonPlan&{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-lesson-plan" data-test="course-outline-menu-add-lesson-plan">{{ locale.lessonPlan.proper }}</a></li>
                    {% endif %}
                    <li class="separator">Manage</li>
                    {% set courseMarkbookRoute = routeLookupIfAuthorized('courseMarkbook.getRedirect', {courseSpec: unit.specification.course, courseSpecId: unit.specification.course.id, unitSpec: unit.specification, unitSpecId: unit.specification.id, folder: unit.course.folder, folderId: unit.course.folder.id}) %}
                    {% if courseMarkbookRoute %}
                        <li><a href="{{ courseMarkbookRoute }}" class="icon-curriculum">Course Markbook</a></li>
                    {% else %}
                        <li><a href="{{ routeLookup('learningMarkbook.getMarkbookForClass', {folder: unit.course.folder, folderId: unit.course.folder.id}) }}" class="icon-curriculum">Class Markbook</a></li>
                    {% endif %}
                    <li><a href="{{ routeLookupIfAuthorized('course.deleteUnitImplementation', {id: unit.id}) }}" data-action="delete-unit" class="icon-delete" title="Delete this {{ locale.unit }}">Delete</a></li>
                </ul>
                {% endif %}

                <!-- Form for reordering tasks - one per unit -->
                <form action="{{ routeLookup('learningAssessment.postReorderAssessments', {contextType: 'units', contextId: unit.id, context: context}) }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" method="post" class="reorder_form"></form>
            </div>

            {% include '@learningAssessment/outline/unitAssessments.twig' %}
        </li>
    {% endfor %}
</ul>
<div class="toast" data-alert></div>
