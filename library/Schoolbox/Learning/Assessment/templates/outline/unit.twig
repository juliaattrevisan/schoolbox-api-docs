{% import '@learningAssessment/fragments/macro/unit/completed.twig' as status %}
{% import '@learningAssessment/project/macro/icon.twig' as icon %}

<ul class="information-list">
    {% for unit in courseImplementation.units %}
        {% set expanded = unit.isOpen == true %}
        {% set expanded_icon = expanded ? 'icon-up-arrow' :'icon-down-arrow'  %}
        {% set expanded_state = expanded ? 'expanded' :'collapsed' %}

        <li class="interact {{ expanded_state }}" data-unit="{{ unit.id }}" data-open_date="{{ unit.openDate.databaseDate }}" data-due_date="{{ unit.dueDate.databaseDate }}">
            <div class="actions-small-1">
                <div class="list-item">
                    <div class="card small-12">
                        <h3>
                            {% if unit.isBeforeOpenDate==false or readOnly == false %}
                                <a class="expand-link {{ expanded_icon }}" data-interaction="toggle-expanded" data-test="course-outline-expand-unit-{{ unit.title }}-{{expanded_state}}" data-interaction-state="{{ expanded_state }}"></a>
                                {% if unit.specification.folder.id in accessibleFolderIds %}
                                    <a href="{{ '/homepage/' ~ unit.specification.folder.id }}">{{ unit.title }}</a>
                                {% else %}
                                    {{ unit.title }}
                                {% endif %}
                            {% else %}
                                {{ unit.title }}
                            {% endif %}
                        </h3>
                        <p class="{{ status.unitUrgency(unit) }}">{{ status.unitCompletion(unit) }}</p>
                    </div>
                </div>
                {% if readOnly == false %}
                <nav>
                    <sbx-pop-out content-id="component{{ componentInstance.id }}-unit-options{{ unit.id }}"></sbx-pop-out>
                </nav>
                <ul data-dropdown-content class="f-dropdown" id="component{{ componentInstance.id }}-unit-options{{ unit.id }}">
                    {% if unit.isAfterDueDate == false %}
                        <li class="separator">Create</li>
                        {% set createAssessmentRoute = routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'units', contextId: unit.id, context: unit}) %}

                        {% for type, label in assessmentTypes %}
                            <li>
                                <a
                                    href="{{ createAssessmentRoute }}?type={{ type }}&{{ returnUrlName }}={{ encodedReturnUrl }}"
                                    class="{{ icon.renderClassForType(type) }}"
                                    data-test="course-outline-menu-add-{{ type }}"
                                >{{ label }}</a>
                            </li>
                        {% endfor %}
                    {% endif %}

                    <li class="separator">Manage</li>
                    {% set courseMarkbookRoute = routeLookupIfAuthorized('courseMarkbook.getRedirect', {courseSpec: unit.specification.course, courseSpecId: unit.specification.course.id, unitSpec: unit.specification, unitSpecId: unit.specification.id, folder: unit.course.folder, folderId: unit.course.folder.id}) %}
                    {% if courseMarkbookRoute %}
                        <li><a href="{{ courseMarkbookRoute }}" class="icon-curriculum" data-test="course-outline-menu-course-markbook">Course Markbook</a></li>
                    {% else %}
                        <li><a href="{{ routeLookup('learningMarkbook.getMarkbookForClass', {folder: unit.course.folder, folderId: unit.course.folder.id}) }}" class="icon-curriculum">Class Markbook</a></li>
                    {% endif %}
                    <li><a href="{{ routeLookupIfAuthorized('course.deleteUnitImplementation', {id: unit.id}) }}" data-action="delete-unit" data-test="course-outline-unit-delete" class="icon-delete" title="Delete this {{ locale.unit }}">Delete</a></li>
                </ul>
                {% endif %}

                <!-- Form for reordering tasks - one per unit -->
                <form action="{{ routeLookup('learningAssessment.postReorderAssessments', {contextType: 'units', contextId: unit.id, context: context}) }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" method="post" class="reorder_form"></form>
            </div>

            {% include '@learningAssessment/outline/unitAssessments.twig' %}
        </li>
    {% endfor %}
</ul>
<div class="toast" data-alert></div>
