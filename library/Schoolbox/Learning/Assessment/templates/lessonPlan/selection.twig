{##
 # Select a Lesson Plan Template
 #
 # This lets users select a Lesson Plan Template upon which to base their
 # Lesson Plan, which is a modified version of the Lesson Plan Template with
 # customisations etc.
 #
 # @param LessonPlan\Template\Model[] $lessonPlanTemplates['recent']
 # @param LessonPlan\Template\Model[] $lessonPlanTemplates['all']
 #
 # @param array $lessonPlanMeta                                An arbitrary array struct of Lesson Plan metadata
 # @param LessonPlan\Template\Model $lessonPlanMeta[template]  A querystring param that exists after a user chose a template
 # @param string $lessonPlanMeta[type]                         Corresponds to the const 'lessonPlan' in AssessmentType
 # @param string $lessonPlanMeta[mageAsync]                    A querystring param that says you came from a Mage form
 #
 # $template and $mageAsync indicate conditionals based on a particular workflow;
 # such as coming from a Course Builder Empty State,
 # or a Create a Course where you chose an activity
 #}
{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

<fieldset class="no-pad no-margin">
    {% if lessonPlanTemplates.recent|length %}
        <div class="row">
            <div class="small-12 columns">
                <h2 class="subheader content">Recently Used Templates</h2>
            </div>
        </div>
        <div class="row">
            <div class="small-12 columns island">
                <section>
                    <div class="row">
                        <div class="small-12 columns">
                            <ul class="information-list">
                                {% for recentLessonPlanTemplate in lessonPlanTemplates.recent %}
                                    <li class="actions-small-1">
                                        <div class="list-item">
                                            <div class="card small-12">
                                                {% set createRoute = routeLookup('learningAssessment.getCreateAssessmentForm', { contextType: contextType, contextId: context.id, context: context }) ~ '?lpt=' ~ recentLessonPlanTemplate.id ~ '&type=' ~ lessonPlanMeta.type ~ '&returnUrl=' ~ returnUrl %}

                                                <a data-reveal-id="lpt-preview-{{ recentLessonPlanTemplate.id }}" title="Preview this template"><h3>{{ recentLessonPlanTemplate.title }}</h3></a>
                                                <p class="meta">
                                                    Last modified by
                                                    {% if recentLessonPlanTemplate.updatedBy.deleted %}
                                                        {{ recentLessonPlanTemplate.updatedBy.fullname }}
                                                    {% else %}
                                                        <a href="/search/user/{{ recentLessonPlanTemplate.updatedBy.id }}">{{ recentLessonPlanTemplate.updatedBy.fullname }}</a>
                                                    {% endif %}

                                                    <time title="{{ recentLessonPlanTemplate.updatedAt.short }}">{{ recentLessonPlanTemplate.updatedAt.relativeTime }}</time>
                                                </p>
                                            </div>
                                        </div>
                                        <nav>
                                            <a class="sbx-icon-only-button no-text" href="{{ createRoute }}" title="Use this template" aria-label="Use this template"><sbx-icon name="next"></sbx-icon></a>
                                        </nav>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    {% endif %}

    {% if lessonPlanTemplates.all|length %}
        <div class="row">
            <div class="small-12 columns">
                <h2 class="subheader content">All Templates</h2>
            </div>
        </div>
        <div class="row">
            <div class="small-12 columns island">
                <section>
                    <div class="row">
                        <div class="small-12 columns">
                            <ul class="information-list">
                                {% for lessonPlanTemplate in lessonPlanTemplates.all %}
                                    <li class="actions-small-1">
                                        <div class="list-item">
                                            <div class="card small-12">
                                                {% set createRoute = routeLookup('learningAssessment.getCreateAssessmentForm', { contextType: contextType, contextId: context.id, context: context }) ~ '?lpt=' ~ lessonPlanTemplate.id ~ '&type=' ~ lessonPlanMeta.type ~ '&returnUrl=' ~ returnUrl %}

                                                <a data-reveal-id="lpt-preview-{{ lessonPlanTemplate.id }}" title="Preview this template"><h3>{{ lessonPlanTemplate.title }}</h3></a>
                                                <p class="meta">
                                                    Last modified by
                                                    {% if lessonPlanTemplate.updatedBy.deleted %}
                                                        {{ lessonPlanTemplate.updatedBy.fullname }}
                                                    {% else %}
                                                        <a href="/search/user/{{ lessonPlanTemplate.updatedBy.id }}">{{ lessonPlanTemplate.updatedBy.fullname }}</a>
                                                    {% endif %}

                                                    <time title="{{ lessonPlanTemplate.updatedAt.short }}">{{ lessonPlanTemplate.updatedAt.relativeTime }}</time>
                                                </p>
                                            </div>
                                        </div>
                                        <nav>
                                            <a class="sbx-icon-only-button no-text" href="{{ createRoute }}" title="Use this template" aria-label="Use this template"><sbx-icon name="next"></sbx-icon></a>
                                        </nav>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    {% else %}
        <div class="row">
            <div class="small-12 columns">
                <div class="empty-state">
                    <sbx-icon name="lesson-plan" size="2.5rem"></sbx-icon>
                    {% set templateCreateRoute = routeLookupIfAuthorized('adminLessonPlanTemplate.getCreate') %}

                    {% if templateCreateRoute %}
                        <p>
                            No {{ locale.lessonPlan }} templates have been created.
                            <a href="{{ templateCreateRoute }}">Click here</a> to build a {{ locale.lessonPlan }} template.
                        </p>
                    {% else %}
                        <p>
                            There are no available {{ locale.lessonPlan }} templates. Please contact a Superuser at your school if you wish to use {{ locale.lessonPlan.plural }}, as you will require a template
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}

    {# Recent Lesson Plan Templates is always a subset of All Lesson Plan Templates
     # so we can save ourselves and async request and just render all the LPTs here
     #}
    {% include '@adminLessonPlanTemplate/preview.twig' with {lessonPlanTemplates: lessonPlanTemplates.all, hasActions: true} %}
    <script>
        $(function() {
            $('[data-cancel]').on('click', function() {
                $('[data-reveal]').foundation("reveal", "close");
            });
        });
    </script>

    {# submit button is only available if any of the following are true:
     #   * a template is selected
     #   * you're in a Part 2 of mage, because in that one particular mage usage Part 1 was the selection screen
     #}
    {% if lessonPlanMeta.template %}
        {{ mage.submitRow(actionLabel ?? 'Create', 'part-2', 'end') }}
    {% elseif lessonPlanMeta.mageAsync %}
        {# Don't provide a Create button at the bottom; users must choose a template,
         # not submit a form, in this Selection step. They have to do it by clicking
         # the title or Use Template via the modal.
         #}
        <div class="hide">
            {{ mage.submitRow(actionLabel ?? 'Create', 'part-2', 'end') }}
        </div>
    {% endif %}
</fieldset>
