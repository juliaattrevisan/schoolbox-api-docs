{##
 # Customise a selected Lesson Plan Template
 #
 # Create a Lesson Plan based on a customised version of a Lesson Plan Template
 #
 # @param IAssessable $assessment                              The Lesson Plan itself, a subclass of AbstractAssessment
 # @param array $lessonPlanMeta                                An arbitrary array struct of Lesson Plan metadata
 # @param LessonPlan\Template\Model $lessonPlanMeta[template]  The LessonPlan Template for this assessment
 # @param string $lessonPlanMeta[type]                         Corresponds to the const 'lessonPlan' in AssessmentType
 # @param string $lessonPlanMeta[mageAsync]                    Whether this was a Mage Step 2 async form fragment (always false here)
 # @param bool $lessonplanMeta[includeBreadcrumbs]             Whether to include breadcrumbs (create requires it; update does not)
 # @param array $breadcrumbs                                   A set of nodes to render as breadcrumb elements
 #
 # @param LessonPlan\Field\Model|LessonPplan\Template\Field\Model $lessonPlanMeta[fields]
 #     A set of Lesson Plan Fields to render here (could be Template Fields) due to somewhat
 #     enforced polymorphism across our AbstractAssessment implementations; create and update
 #     are intricately tied together, but one workflow shows the Template Fields so you can
 #     modify them; but another workflow shows you the Lesson Plan Fields that you had previously
 #     spawned and altered
 #}

{% import "@learningAssessment/fragments/macro/date.twig" as dateForm %}

<input type="hidden" name="lessonPlanTemplateId" value="{{ lessonPlanMeta.template.id }}" />

{# The <lesson-planner> component renders the following parts of the form:
 # - Title (as a slot)
 # - Lesson Date (as a slot)
 # - Curriculum Codes (as a slot)
 # - [Generate lesson with AI] button
 # ----
 # - Lesson Plan Fields, and associated regenerate with AI buttons
 # Form submission is still handled by the form here, not the component
 #}
<div id="lesson-planner-container">
    <input id="templateTitle" type="hidden" name="templateTitle" value="{{ lessonPlanMeta.template.title }}" />

    <lesson-planner
        :new-field-keyword="{{ lessonPlanMeta.newKeyword |json_encode }}"
        :student-const="{{ lessonPlanMeta.consts.student |json_encode }}"
        :file-browser-category-id="{{ context.baseContext.folder.id ?? 0 }}"
        :fields="{{ lessonPlanMeta.fields |json_encode }}"
        context-name="{{ context.baseContext is unitSpecification ? context.baseContext.folder.name : context.baseContext.specification.folder.name }}"
        lesson-plan-duration="{% if assessment.id %}{{ assessment.lessonPlanDuration }}{% endif %}"
        generate-plan-route="{{ routeLookupIfAuthorized('openai.postLessonPlan') }}"
    >
        <template v-slot:title>
            <div class="row">
                <div class="small-12 columns">
                    <label for="title" class="required">Title</label>
                    <input id="title" type="text" name="title" maxlength="255" value="{% if assessment.id %}{{ assessment.title }}{% endif %}" required />
                </div>
            </div>
        </template>

        {# Assessment dates; basically shanked from another assessment type's create.twig
         # You have to manually do it every time you add a new assessment type. Only implementations
         # can have dates, not specifications.
         #
         # This gets sent through to the vue component as a slot so we don't need to duplicate date.twig's logic
         #
         # TODO What is the ordering of this form - do the dates come before or after the Lesson Plan Fields?
         #}
        <template v-slot:date>
            {% if context.baseContext is not unitSpecification %}
                <div class="row">
                    {{ dateForm.dateField(locale.translate('lessonPlan', false, true), 'due', false, assessment.dueAt, 'publish', '') }}
                </div>
            {% endif %}
        </template>

        {# Curriculum Codes
         # This is the same include used by everything else. The entity type is some textual
         # representation, randomly hardcoded here
         # lessonPlanner.js also includes <curriculum-selector> as an available component so this can be used
         #}
        <template v-slot:curriculum-codes>
            {% include '@learningAssessment/fragments/curriculumCodes.twig' with {
                entityType: locale.lessonPlan.proper,
                excludeLegend: true,
                vueSlot: true,
                hasTabs: true,
                parentFolderId: parentFolderId ?? null
            } %}
        </template>
    </lesson-planner>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/lessonPlanner.js?v={{ config.site_version }}"></script>

{# Attach random files to this Lesson Plan
 # It implicitly constructs an attachments[] POST key which contains
 # all the hashes of the files you uploaded via the Mr Matt's Modal
 #}
<fieldset>
    <div class="row">
        <div class="small-12 columns">
            <label>Attach Files</label>
            {% include 'sub/attachzone.twig' with {attachzone: attachzone } %}
        </div>
    </div>

    {# Toggle for deciding whether this Lesson Plan is visible to students
     # or if it's restricted to staff eyes only
     #}

    <div class="row">
        <div class="small-12 medium-3 columns">
            <input type="hidden" name="lessonPlanVisibility" value="staff" />

            <label for="lessonPlanVisibility" class="inline-block">Visible to students <span class="hint has-tip tip-top" title="If toggled to 'ON', students will see the {{ locale.lessonPlan }} and all content that is set to 'visible'." data-tooltip>?</span></label>
            <div class="switch">
                {# The Lesson Plan is visible to students based on this toggle under two circumstances:
                 #     * by default, Lesson Plans are visible to students (assessment.visibility == '')
                 #     * or When assessment.visibility == student
                 #}
                {% set visibility = '' %}

                {% if '' == assessment.visibility or lessonPlanMeta.consts.student == assessment.visibility %}
                    {% set visibility = 'checked' %}
                {% endif %}
                <input id="lessonPlanVisibility"
                       name="lessonPlanVisibility"
                       type="checkbox"
                        {{ visibility }}
                >
                <label for="lessonPlanVisibility">
                    <span>On</span>
                    <span>Off</span>
                </label>
            </div>
        </div>
        <div class="small-12 medium-9 columns">
            {% if context.baseContext is not unitSpecification %}
                <div class="row">
                    {{ dateForm.dateField('Publish', 'publish', false, assessment.publishAt, '', 'due') }}
                </div>
            {% endif %}
        </div>
    </div>

    {# ----------------------------------------------------------- #}
    {# Assessment Location #}
    {# ----------------------------------------------------------- #}
    {% if canRelocate %}
        {% include '@learningAssessment/fragments/assessmentLocation.twig' %}
    {% endif %}
</fieldset>

{% if assessment.id %}
    {% set action = 'Update' %}
{% else %}
    {% set action = 'Create' %}
{% endif %}

<input type="submit" value="{{ action }}">

<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
<script>
    $(function() {
        /* Apply validator rules
         */
        $('input[name="title"]').rules('add', 'requiredNotBlank');
    });

    /* but why? See SA-18416
     */
    window.dispatchEvent(new Event('resize'));
</script>
<style type="text/css">
    /* but why? See SA-18416
     */
    span.image-inline.ck-widget.ck-widget_with-resizer {
        display: inline-block !important;
    }
</style>
