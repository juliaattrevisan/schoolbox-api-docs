{##
 # Select a Lesson Plan Template
 #
 # This lets users select a Lesson Plan Template upon which to base their
 # Lesson Plan, which is a modified version of the Lesson Plan Template with
 # customisations etc.
 #
 # @param LessonPlan\Template\Model[] $lessonPlanTemplates['recent']
 # @param LessonPlan\Template\Model[] $lessonPlanTemplates['all']
 #}
{% if lessonPlanTemplates.recent|length %}
    <div class="row">
        <div class="small-12 columns">
            <h2 class="subheader content">Recently Used Templates</h2>
        </div>
    </div>
    <div class="row">
        <div class="small-12 columns">
            <ul class="information-list">
                {% for recentLessonPlanTemplate in lessonPlanTemplates.recent %}
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="card small-12">
                                <a data-preview="{{ recentLessonPlanTemplate.id }}"><h3>{{ recentLessonPlanTemplate.title }}</h3></a>
                                <p class="meta">
                                    Last modified by
                                    {% if recentLessonPlanTemplate.updatedBy.deleted %}
                                        {{ recentLessonPlanTemplate.updatedBy.fullname }}
                                    {% else %}
                                        <a href="/search/user/{{ recentLessonPlanTemplate.updatedBy.id }}">{{ recentLessonPlanTemplate.updatedBy.fullname }}</a>
                                    {% endif %}

                                    <time title="{{ recentLessonPlanTemplate.updatedAt.short }}">{{ recentLessonPlanTemplate.updatedAt.relativeTime }}</time>
                                </p>
                            </div>
                        </div>
                        <nav>
                            <a class="icon-search"></a>
                        </nav>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <hr />
{% endif %}

{% if lessonPlanTemplates.all|length %}
    <div class="row">
        <div class="small-12 columns">
            <h2 class="subheader content">All Templates</h2>
        </div>
    </div>
    <div class="row">
        <div class="small-12 columns">
            <ul class="information-list">
                {% for lessonPlanTemplate in lessonPlanTemplates.all %}
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="card small-12">
                                <a data-preview="{{ lessonPlanTemplate.id }}"><h3>{{ lessonPlanTemplate.title }}</h3></a>
                                <p class="meta">
                                    Last modified by
                                    {% if lessonPlanTemplate.updatedBy.deleted %}
                                        {{ lessonPlanTemplate.updatedBy.fullname }}
                                    {% else %}
                                        <a href="/search/user/{{ lessonPlanTemplate.updatedBy.id }}">{{ lessonPlanTemplate.updatedBy.fullname }}</a>
                                    {% endif %}

                                    <time title="{{ lessonPlanTemplate.updatedAt.short }}">{{ lessonPlanTemplate.updatedAt.relativeTime }}</time>
                                </p>
                            </div>
                        </div>
                        <nav>
                            <a class="icon-search"></a>
                        </nav>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% else %}
    <div class="empty-state">
        <i class="icon-lesson-plan"></i>
        <p>
            There are no available lesson plan templates. If you expect to find some here, please contact
            a user with administration privileges at your school for assistance.
        </p>
    </div>
{% endif %}
