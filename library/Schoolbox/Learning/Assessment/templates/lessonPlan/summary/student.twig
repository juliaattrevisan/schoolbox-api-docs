{##
 # Student Summary Screen for Lesson Plan
 #
 # @param array             $lastView
 # @param array             $breadcrumbs            A set of nodes to render as breadcrumb elements
 # @param LessonPlan\Model  $assesment              A Lesson Plan assessment domain object instance
 # @param \Schoolbox\User   $student                A \Schoolbox\User instance
 # @param array             $courseAssessments
 # @param array             $linkedAssessments
 # @param string            $returnUrl              A string for where you go when you hit Return
 # @param bool              $isInstructor           A bool for whether currently logged in user is instructor (they see staff-only fields)
 #}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/task/jquery.progressTickForm.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function () {
        $('form[data-progress-tick-form]').progressTickForm({
            disabledSelector: 'form:not([data-progress-tick-form="selfAssessed"])',
            transitions: {
                incomplete:      'selfAssessed',
                selfAssessed:    'incomplete',
                teacherAssessed: 'incomplete'
            }
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learningAssessment/project/macro/icon.twig' as icon %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/meta.twig' with {
            assessment: assessment,
            submissionsBlocked: '',
            student: student,
            icon: 'icon-lesson-plan',
            canShowcase: false,
            isShowcased: false,
            lastViews: lastViews
        } only %}
    </div>

    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}

    {% include '@learningAssessment/fragments/modifyTot.twig' with {
        assessment: assessment,
        gradeRoute: false,
        viewRoute: null,
        modifyRoute: modifyRoute,
        canShowcase: false,
        isShowcased: false,
        hasStudentView: isInstructor
    } %}
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            {# Decide how to render fields, depending on your current view
             # (students get a different view to staff)
             #
             # These render as hidden divs initially
             #}
            {% import '@learningAssessment/lessonPlan/summary/renderFields.twig' as renderFields %}

            {{ renderFields.renderFields(assessment, 'student') }}

            {# Optionally provide a student view if you're an instructor #}
            {% if isInstructor %}
                {{ renderFields.renderFields(assessment, 'staff') }}

                <script>
                    $(function() {
                        $('#lessonPlan-staff').show();
                        window.dispatchEvent(new Event('resize'));
                    });
                </script>
            {% else %}
                {# Forcibly render the student view #}
                <script>
                    $(function() {
                        $('#lessonPlan-student').show();
                        window.dispatchEvent(new Event('resize'));
                    });
                </script>
            {% endif %}
        </section>
    </div>

    {% if assessment.attachments is not empty %}
        <div class="small-12 island">
            <h3 class="subheader">Attachments</h3>
            <section>
                {# Attached files #}
                {% include '@learningAssessment/fragments/attachments.twig' with { attachments: assessment.attachments } %}
            </section>
        </div>
    {% endif %}

    {% if assessment.linkedAssessments is not empty or modifyRoute %}
        <div class="small-12 island">
            <div id="linked-activities-container">
                <linked-activities
                    :source-id = '{{ assessment.id }}'
                    :course-assessments = '{{ courseAssessments |json_encode }}'
                    :linked-activities = '{{ linkedAssessments |json_encode }}'
                    :can-modify = '{% if modifyRoute %}true{% else %}false{% endif %}'
                    :grade-gradient-enable='{{ config.grade_gradient_enable ? 'true' : 'false' }}'
                />
            </div>
            <script>
                window.sbProps.l10n.addTerm({{ locale.unit.toArray |json_encode |raw }})
                window.sbProps.l10n.addTerm({{ locale.activity.toArray |json_encode |raw }});
                window.sbProps.l10n.addTerm({{ locale.lessonPlan.toArray |json_encode |raw }});
            </script>
            <script src="{{ CDN_PREFIX }}/js/bundle/linkedActivities.js?v={{ config.site_version }}"></script>
        </div>
    {% endif %}
    <div class="small-12 island">
        <a href="{{ returnUrl }}" class="submit button full-width">Return</a>
    </div>
</div>
