{##
 # Student Summary Screen for Lesson Plan
 #
 # @param array $breadcrumbs           A set of nodes to render as breadcrumb elements
 # @param LessonPlan\Model $assesment  A Lesson Plan assessment domain object instance
 # @param \Schoolbox\User $student     A \Schoolbox\User instance
 # @param string $returnUrl            A string for where you go when you hit Return
 # @param bool $isInstructor           A bool for whether currently logged in user is instructor (they see staff-only fields)
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/meta.twig' with {
            assessment: assessment,
            submissionsBlocked: '',
            student: student,
            icon: 'icon-lesson-plan',
            canShowcase: false,
            isShowcased: false,
            lastViews: lastViews
        } only %}
    </div>

    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
    {% include '@learningAssessment/fragments/modifyTot.twig' with {
        gradeRoute: false,
        viewRoute: null,
        modifyRoute: modifyRoute,
        canShowcase: false,
        isShowcased: false
    } %}
</div>

{# Optionally provide a student view if you're an instructor #}
{% if isInstructor %}
    <div class="row">
        <div class="small-12 columns">
            <div class="long switch">
                <input id="lessonPlanToggle" type="checkbox">
                <label for="lessonPlanToggle">
                    <span>Student</span>
                    <span>Staff</span>
                </label>
            </div>
        </div>
    </div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <section>
            {# Decide how to render fields, depending on your current view
             # (students get a different view to staff)
             #
             # These render as hidden divs initially
             #}
            {% import '@learningAssessment/lessonPlan/summary/renderFields.twig' as renderFields %}

            {{ renderFields.renderFields(assessment, 'student') }}

            {# Optionally provide a student view if you're an instructor #}
            {% if isInstructor %}
                {{ renderFields.renderFields(assessment, 'staff') }}

                <script>
                    $(function() {
                        /* Toggle teacher-only fields
                         */
                        function showFields(toggle) {
                            if ($(toggle).prop('checked')) {
                                $('#lessonPlan-staff').hide();
                                $('#lessonPlan-student').show();
                            } else {
                                $('#lessonPlan-staff').show();
                                $('#lessonPlan-student').hide();
                            }
                        }

                        /* Initial state
                         */
                        showFields();

                        /* Dynamic state
                         */
                        $('#lessonPlanToggle').on('click', function(event) {
                            showFields($(this));
                        });
                    });
                </script>
            {% else %}
                <script>
                    $(function() {
                        $('#lessonPlan-student').show();
                    });
                </script>
            {% endif %}

            {# Attached files #}
            {% include '@learningAssessment/fragments/attachments.twig' with { attachments: assessment.attachments } %}
        </section>

        <a href="{{ returnUrl }}" class="submit button full-width">Return</a>
    </div>
</div>
