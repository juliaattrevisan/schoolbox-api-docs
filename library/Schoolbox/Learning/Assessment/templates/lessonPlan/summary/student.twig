{##
 # Student Summary Screen for Lesson Plan
 #
 # @param array $breadcrumbs           A set of nodes to render as breadcrumb elements
 # @param LessonPlan\Model $assesment  A Lesson Plan assessment domain object instance
 # @param \Schoolbox\User $student     A \Schoolbox\User instance
 # @param string $returnUrl            A string for where you go when you hit Return
 # @param bool $isInstructor           A bool for whether currently logged in user is instructor (they see staff-only fields)
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]').preview();
    });
</script>

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/meta.twig' with {
            assessment: assessment,
            submissionsBlocked: '',
            student: student,
            icon: 'icon-lesson-plan',
            canShowcase: false,
            isShowcased: false,
            lastViews: lastViews
        } only %}
    </div>

    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
    {% include '@learningAssessment/fragments/modifyTot.twig' with {
        gradeRoute: false,
        viewRoute: null,
        modifyRoute: modifyRoute,
        canShowcase: false,
        isShowcased: false
    } %}
</div>

{# Optionally provide a student view if you're an instructor #}
{% if isInstructor %}
    <div class="row">
        <div class="small-12 columns">
            <div class="long switch">
                <input id="lessonPlanToggle" type="checkbox">
                <label for="lessonPlanToggle">
                    <span>Student</span>
                    <span>Staff</span>
                </label>
            </div>
        </div>
    </div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <section>
            {# Decide how to render fields, depending on your current view
             # (students get a different view to staff)
             #
             # These render as hidden divs initially
             #}
            {% import '@learningAssessment/lessonPlan/summary/renderFields.twig' as renderFields %}

            {{ renderFields.renderFields(assessment, 'student') }}

            {# Optionally provide a student view if you're an instructor #}
            {% if isInstructor %}
                {{ renderFields.renderFields(assessment, 'staff') }}

                <script>
                    $(function() {
                        /* Toggle teacher-only fields
                         */
                        function showFields(toggle) {
                            if ($(toggle).prop('checked')) {
                                $('#lessonPlan-staff').hide();
                                $('#lessonPlan-student').show();
                            } else {
                                $('#lessonPlan-staff').show();
                                $('#lessonPlan-student').hide();
                            }
                        }

                        /* Initial state
                         */
                        showFields();

                        /* Dynamic state
                         */
                        $('#lessonPlanToggle').on('click', function(event) {
                            showFields($(this));
                        });
                    });
                </script>
            {% else %}
                <script>
                    $(function() {
                        $('#lessonPlan-student').show();
                    });
                </script>
            {% endif %}

            {# Attached files #}
            {% if assessment.attachments|length %}
                <script>
                    $(function() {
                        $('[data-plugin="preview"]').preview();
                    });
                </script>
                <ul class="grid small-block-grid-1 medium-block-grid-2">
                    {% for currentFile in assessment.attachments %}
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="card attachment small-12">
                                    <a data-plugin="preview" href="/storage/fetch.php?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}">
                                        {% if currentFile.mimetype.image %}
                                            <img src="/storage/image.php?hash={{ currentFile.hash }}&size=square64" alt="Download" />
                                        {% else %}
                                            <img src="/ajax/mime/{{ currentFile.mime }}" alt="Download" />
                                        {% endif %}

                                        <p>{{ currentFile.filename }}</p>
                                        <p class="meta">{{ currentFile.size|bytes }}</p>
                                    </a>
                                </div>
                            </div>
                            <nav>
                                <a href="/storage/fetch.php?hash={{ currentFile.hash }}&save=1" title="Download" class="icon-download"></a>
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <a href="{{ returnUrl }}" class="submit button full-width">Return</a>
    </div>
</div>

{% if preview.type is not defined or preview.type in ['image', 'file', 'redirect'] %}
    {# noop
     #
     # Unknown preview types are just ignored
     # Images and other Files now render in their own list
     # Links/urls (preview.type redirect) are rendered further up the screen under the description
     #}
{% elseif preview.type == 'iframe' %}
    {# a task link should display as a link regardless of whether iframe safe url or not #}
    <section>
        <div class="card small-12">
            <a href="{{ preview.fragment }}" target="_blank" title="Visit {{ preview.fragment }}">
                <div class="icon-link"></div>
                <h3>{{ assessment.title }}</h3>
                <p class="meta">{{ preview.fragment }}</p>
            </a>
        </div>
    </section>
{% elseif preview.fragment|length %}
    {# This usage of raw is because the embedded code is raw html for embedding external content etc using oEmbed or multimedia videos #}
    <section class="content">
        {{ preview.fragment | raw }}
    </section>
{% endif %}
