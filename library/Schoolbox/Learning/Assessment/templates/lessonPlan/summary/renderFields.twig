{##
 # renderFields
 #
 # Renders all the fields of a Lesson Plan assessment
 #
 # @param LessonPlan\Model $assessment  A Lesson Plan domain object instance, fully hydrated
 # @param string $view                  A string corresponding to 'student' or 'staff', representing the field visibilty state
 #}
{% macro renderFields(assessment, view) %}
    {% if assessment.fields|length %}
        {# This lets you toggle the views on the Summary screen
         #}
        {% set identifier = 'lessonPlan-' ~ view %}

        <ul class="information-list lp-display" id="{{ identifier }}" style="display:none">
                {% for field in assessment.fields %}
                    {% if 'staff' == view %}
                        <li class="content {% if 'staff' == field.visibility %}not-visible-students {% endif %}">

                            <div class="lp-area-header">                  {# This field is only visible to staff #}
                                {% if 'staff' == field.visibility %}
                                    <p class="meta"><span class="icon-view-hollow"></span>This field is not visible to students</p>
                                {% endif %}              {# Staff view: show all the fields and their data #}
                                <h2>{{ field.title }}</h2>
                            </div>
                            <article>{{ field.body|purify }}</article>


                        </li>
                    {% elseif 'student' == view and 'student' == field.visibility %}
                        <li class="content">
                            {# Student view: only show fields that are visible to students #}
                            <h2>{{ field.title }}</h2>
                            <article>{{ field.body|purify }}</article>
                        </li>
                    {% endif %}
                {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}
