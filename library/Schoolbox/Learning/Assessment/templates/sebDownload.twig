{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbsArray(breadcrumbs) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <p class="text-center">
                This activity has been configured so that students may only attempt it using the Safe Exam Browser.
                Before starting, you must ensure you have the correct version of Safe Exam Browser installed on
                your computer.
            </p>
            <p class=" text-center">
                <a href="https://github.com/SafeExamBrowser/seb-win-refactoring/releases/download/3.3.2/SEB_3.3.2.413_SetupBundle.exe"
                   class="icon-download button">Download Safe Exam Browser for Windows</a>
            </p>
            <p class=" text-center">
                <a href="https://github.com/SafeExamBrowser/seb-mac/releases/download/3.0/SafeExamBrowser-3.0.dmg"
                   class="icon-download button">Download Safe Exam Browser for MacOS</a>
            </p>
            <p class=" text-center">
                <a href="https://itunes.apple.com/app/safeexambrowser/id1155002964?mt=8"
                   class="icon-download button">Download Safe Exam Browser for iOS</a>
            </p>
        </section>

        <ul class="flex-list buttons">
            <li><a href="/homepage/{{ assessment.context.folder.id }}" class="button">Return to class</a></li>
            <li><a href="{{ routeLookupIfAuthorized('learningAssessment.getSebConfig', {assessment: assessment, assessmentId: assessmentId}) }}"
                   class="button submit">Launch Safe Exam Browser</a></li>
        </ul>
    </div>
</div>
