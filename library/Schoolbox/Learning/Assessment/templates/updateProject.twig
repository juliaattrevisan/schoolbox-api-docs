{% extends '@learningAssessment/updateAbstract.twig' %}

{% block contents %}
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <input type="hidden" name="assessmentType" value="project" />
                {% include '@learningAssessment/fragments/project/create.twig' %}
            </div>
        </fieldset>
    </section>

    <h2 class="subheader">Assessments within {{ assessment.title }}</h2>
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                {% include '@learningAssessment/fragments/project/assessmentList.twig' %}
                {% include '@learningAssessment/fragments/project/createAssessment.twig' %}
            </div>
        </fieldset>
    </section>
{% endblock %}