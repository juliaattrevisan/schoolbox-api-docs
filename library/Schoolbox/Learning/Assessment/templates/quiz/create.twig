{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

<input type="hidden" name="assessmentType" value="{{ assessmentType }}" />
<input type="hidden" name="learnosityReference" id="learnosity-reference" value="{{ assessment.learnosityReference }}" />

<fieldset>
    {# ----------------------------------------------------------- #}
    {# Title and Import #}
    {# ----------------------------------------------------------- #}
    {% set importRoute = routeLookupIfAuthorized('learningQuiz.postImport', {
        contextId: context.id,
        contextType: contextType
    }) %}
    {# Can only import on creation, not modify #}
    {% set canImport = importRoute is not null and assessment.id is null %}

    <label class="required" for="title">Title</label>
    <div class="input-group">
        <input type="text" name="title" id="title" value="{{ assessment.title }}" required maxlength="255"/>
        {% if canImport %}
            <button
                type="button"
                class="button icon-upload"
                title="Import a {{ config.title }} Quiz File"
                data-reveal-id="importModal"
            >
                Import Quiz
            </button>
        {% endif %}
    </div>

    {# ----------------------------------------------------------- #}
    {# Work Type #}
    {# ----------------------------------------------------------- #}
    {% include '@learningAssessment/fragments/workTypeSelectorWithLabel.twig'
        with {
            allWorkTypes: allWorkTypes,
            assessment: assessment,
            courseManaged: courseManaged
        } only
    %}

    {# ----------------------------------------------------------- #}
    {# Curriculum #}
    {# ----------------------------------------------------------- #}
    {% include '@learningAssessment/fragments/curriculumCodes.twig' with {
        entityType: 'Quiz',
        excludeLegend: true,
        hasTabs: true,
        parentFolderId: parentFolderId ?? null,
    } %}

    {# ----------------------------------------------------------- #}
    {# Description #}
    {# ----------------------------------------------------------- #}
    <label for="assessment-description">
        Description<span class="hint has-tip tip-top" data-tooltip title="This content will be shown to users before they begin to attempt the quiz.">?</span>
    </label>
    <textarea name="description" id="assessment-description">{{ assessment.description }}</textarea>

    {# ----------------------------------------------------------- #}
    {# Assessment Location #}
    {# ----------------------------------------------------------- #}
    {% if canRelocate %}
        {% include '@learningAssessment/fragments/assessmentLocation.twig' %}
    {% endif %}

    {# ----------------------------------------------------------- #}
    {# Completion Message #}
    {# ----------------------------------------------------------- #}
    <label for="completion_message">
        Completion Message<span class="hint has-tip tip-top" data-tooltip title="This content will be shown to users when they complete the quiz.">?</span>
    </label>
    <textarea name="completion_message" id="completion_message">{{ assessment.completionMessage }}</textarea>

    {# ----------------------------------------------------------- #}
    {# Max Attempts #}
    {# ----------------------------------------------------------- #}
    <div class="row">
        <div class="small-12 columns">
            <label>
                Max Attempts<span class="hint has-tip tip-top" data-tooltip title="This is how many times a user can begin the quiz again.">?</span>
                {% set maxAttempts = 10 %}

                <select name="maxAttempts">

                    {% for i in 0..maxAttempts %}
                        {% if i == assessment.maxAttempts %}
                            {% set selected = 'selected' %}
                        {% else %}
                            {% set selected = '' %}
                        {% endif %}

                        {% if i == 0 %}
                            <option value="{{ i }}" {{ selected }}>Unlimited</option>
                        {% else %}
                            <option value="{{ i }}" {{ selected }}>{{ i }}</option>
                        {% endif %}
                    {% endfor %}

                </select>
            </label>
        </div>
    </div>

    {# ----------------------------------------------------------- #}
    {# Default Activity Duration #}
    {% include '@learningAssessment/fragments/default_open_span.twig' with {assessment: assessment} only %}

    {# ----------------------------------------------------------- #}
    {# Allowed Time #}
    {# ----------------------------------------------------------- #}
    <div class="row">
        <div class="small-5 medium-2 columns">
            <label for="hasDuration" class="inline-block">Allowed Time<span class="hint has-tip tip-top" data-tooltip title="After starting a quiz, students will have this much time to complete it. Switch off for no limit.">?</span></label>
            <div class="switch">
                <input name="hasDuration" id="hasDuration" type="checkbox" {% if assessment.duration %}checked="checked"{% endif %} />
                <label for="hasDuration">
                    <span class="icon-approve"></span>
                    <span class="icon-cancel"></span>
                </label>
            </div>
        </div>
        <div class="small-7 medium-10 columns no-pad {% if not assessment.duration %}hide{% endif %}" id="durationPanel">
            <div class="small-6 columns">
                <label>Hours
                    <input name='durationHours' type="text" value="{% if assessment.duration %}{{ assessment.durationComponents(assessment.duration).hours ?? '' }}{% endif %}" />
                </label>
            </div>
            <div class="small-6 columns">
                <label>Minutes
                    <input name='durationMinutes' type="text" value="{% if assessment.duration %}{{ assessment.durationComponents(assessment.duration).minutes ?? '' }}{% endif %}" />
                </label>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="small-5 medium-2 columns">
            <label for="hasReadingTimeDuration" class="inline-block">Reading Time<span class="hint has-tip tip-top" data-tooltip title="The amount of time students have to examine the quiz before starting. Switch off to disable.">?</span></label>
            <div class="switch">
                <input name="hasReadingTimeDuration" id="hasReadingTimeDuration" type="checkbox" {% if assessment.readingTimeDuration %}checked="checked"{% endif %} />
                <label for="hasReadingTimeDuration">
                    <span class="icon-approve"></span>
                    <span class="icon-cancel"></span>
                </label>
            </div>
        </div>
        <div class="small-7 medium-10 columns no-pad {% if not assessment.readingTimeDuration %}hide{% endif %}" id="readingTimeDurationPanel">
            <div class="small-6 columns">
                <label>Hours
                    <input name='readingTimeDurationHours' type="text" value="{% if assessment.readingTimeDuration %}{{ assessment.durationComponents(assessment.readingTimeDuration).hours ?? '' }}{% endif %}" />
                </label>
            </div>
            <div class="small-6 columns">
                <label>Minutes
                    <input name='readingTimeDurationMinutes' type="text" value="{% if assessment.readingTimeDuration %}{{ assessment.durationComponents(assessment.readingTimeDuration).minutes ?? '' }}{% endif %}" />
                </label>
            </div>
        </div>
    </div>

    <div class="row">
        {# Shuffle Items #}
        <div class="small-12 medium-6 columns">
            <label for="shuffleItems" class="inline-block">Shuffle Items<span class="hint has-tip tip-top" data-tooltip title="You can shuffle the order of quiz items displayed.">?</span></label>
            <div class="switch">
                <input name="shuffleItems" id="shuffleItems" type="checkbox" {% if assessment.shuffleItems %}checked="checked"{% endif %} value="1" />
                <label for="shuffleItems">
                    <span class="icon-approve"></span>
                    <span class="icon-cancel"></span>
                </label>
            </div>
        </div>
        {# Prompts And Feedback Mode #}
        <div class="small-12 medium-6 columns">
            <label for="promptsMode" class="inline-block">Prompts And Feedback Mode<span class="hint has-tip tip-top" data-tooltip title="This will allow prompts and feedback to display during a quiz.">?</span></label>
            <div class="switch">
                <input name="promptsMode" id="promptsMode" type="checkbox" {% if assessment.promptsMode %}checked="checked"{% endif %} value="1" />
                <label for="promptsMode">
                    <span class="icon-approve"></span>
                    <span class="icon-cancel"></span>
                </label>
            </div>
        </div>
    </div>

    {# Enforce Safe Exam Browser #}
    {% include '@learningAssessment/fragments/sebSwitch.twig' with {assessment: assessment} only %}
</fieldset>

{# ----------------------------------------------------------- #}
{# Dates #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification %}
    <fieldset>
        <legend>Submission Dates</legend>
        {% include '@learningAssessment/fragments/dates.twig' %}
    </fieldset>
{% endif %}

{# ----------------------------------------------------------- #}
{# Grading #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>{{ locale.grading.proper }}</legend>

    {% include '@learningAssessment/fragments/weight.twig' %}

    {# Letter Grade enables Grading Scheme
     # Total Mark enables Maximum Available Marks
     #}
    {% include '@learningAssessment/fragments/markType.twig' with {
        context: '',
        assessment: assessment,
        allMarkTypes: allMarkTypes,
        allGradeSchemes: allGradeSchemes,
        selectedMaxMark: assessment.maxMark ?? null,
        selectedMarkType: assessment.markType.id ?? null,
        selectedGradeGroup: assessment.gradeGroup.id ?? null,
        defaultGradeGroup: defaultGradeGroup,
        renderMaxMark: false,
        markTypeLabel: 'Mark Type',
        courseManagedReadonly: courseManaged.isReadonly
    } %}

    {% import 'sub/visibility.twig' as visibility %}
    {{ visibility.dropdown(markVisibility, availableVisibilities) }}
</fieldset>

{# ----------------------------------------------------------- #}
{# Participation #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification and custom_assessment_participation %}
    {% include '@learningAssessment/fragments/participation.twig' %}
{% endif %}

{# ----------------------------------------------------------- #}
{# Submit #}
{# ----------------------------------------------------------- #}
{{ mage.submitRow(actionLabel ?? 'Create', 'part-2', 'end') }}

{# ----------------------------------------------------------- #}
{# Scripts #}
{# ----------------------------------------------------------- #}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
<script>
    $(function () {
        // Init CKEditor
        document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
            detail: {
                targetElements: ['textarea[name=description]', 'textarea[name=completion_message]'],
                fileBrowserCategoryId: {{ context.baseContext.folder.id ?? 0 }},
            }
        }));

        $(document).foundation();

        setDurationPanels($('#hasDuration'), $('#durationPanel'));
        setDurationPanels($('#hasReadingTimeDuration'), $('#readingTimeDurationPanel'));

        /**
         * Toggles duration settings.
         *
         * @param toggle
         * @param durationPanel
         */
        function setDurationPanels(toggle, durationPanel) {
            let durationInputs = durationPanel.find('input[type=text]');

            toggle.on('click', function() {
                let $checkbox = $(this);

                if ($checkbox.is(':checked')) {
                    durationPanel.stop().hide().removeClass('hide').fadeIn(400);
                    durationInputs.prop('disabled', false);
                }
                else {
                    /* Hide panel + disable inputs
                     */
                    durationPanel.stop().fadeOut(400);
                    durationInputs.prop('disabled', true);
                }
            });
        }
    });
</script>
