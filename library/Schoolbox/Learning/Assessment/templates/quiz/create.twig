{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}


<input type="hidden" name="assessmentType" value="{{ assessmentType }}" />


{# TODO 'stage' is a temp hack until this fragment gets refactored to use *extend* instead of *include* #}
{# This activates a modal stored in the parent create.twig
 #
 # jquery validator chucks a sad when you have nested forms
 # parent create.twig includes this create.twig which causes nested forms
 #}
{% if not assessment.id and (stage is not defined or stage != 2) %}
<div class="actions-small-1 row">
    <nav>
        <a class="icon-more" data-dropdown="header-options" title="Actions"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content="">
        <li><a href="#" id="import" data-reveal-id="import-modal" class="icon-import">Import from XML file</a></li>
    </ul>
</div>
{% endif %}


<fieldset>
    {# ----------------------------------------------------------- #}
    {# Title #}
    {# ----------------------------------------------------------- #}
    <label class="required" for="title">Title</label>
    <input type="text" name="title" id="title" value="{{ assessment.title }}" required maxlength="255"/>

    {# ----------------------------------------------------------- #}
    {# Work Type #}
    {# ----------------------------------------------------------- #}
    <label>
        Work Type
        <select name="workType">
            <option value="" selected>None</option>
            {% for workType in allWorkTypes %}
                <option value="{{ workType.id }}" {% if assessment.workType.id ?? '' == workType.id %}selected="selected"{% endif %}>{{ workType.name }}</option>
            {% endfor %}
        </select>
    </label>


    {# ----------------------------------------------------------- #}
    {# Description #}
    {# ----------------------------------------------------------- #}
    <label>
        Description<span class="hint has-tip tip-top" data-tooltip title="This content will be shown to users before they begin to attempt the quiz.">?</span>
        <textarea name="description" id="assessment-description">{{ assessment.description }}</textarea>
    </label>

    {# ----------------------------------------------------------- #}
    {# Assessment Location #}
    {# ----------------------------------------------------------- #}
    {% if canRelocate %}
        {% include '@learningAssessment/fragments/assessmentLocation.twig' %}
    {% endif %}

    {# ----------------------------------------------------------- #}
    {# Completion Message #}
    {# ----------------------------------------------------------- #}
    <label>
        Completion Message<span class="hint has-tip tip-top" data-tooltip title="This content will be shown to users when they complete the quiz.">?</span>
        <textarea name="completion_message">{{ assessment.completionMessage }}</textarea>
    </label>


    {# ----------------------------------------------------------- #}
    {# Max Attempts #}
    {# ----------------------------------------------------------- #}
    <div class="row">
        <div class="small-12 columns">
            <label>
                Max Attempts<span class="hint has-tip tip-top" data-tooltip title="This is how many times a user can begin the quiz again.">?</span>
                {% set maxAttempts = 10 %}

                <select name="maxAttempts">

                    {% for i in 0..maxAttempts %}
                        {% if i == assessment.maxAttempts %}
                            {% set selected = 'selected' %}
                        {% else %}
                            {% set selected = '' %}
                        {% endif %}

                        {% if i == 0 %}
                            <option value="{{ i }}" {{ selected }}>Unlimited</option>
                        {% else %}
                            <option value="{{ i }}" {{ selected }}>{{ i }}</option>
                        {% endif %}
                    {% endfor %}

                </select>
            </label>
        </div>
    </div>


    {# ----------------------------------------------------------- #}
    {# Default Activity Duration #}
    {# ----------------------------------------------------------- #}
    {% include '@learningAssessment/fragments/default_open_span.twig' with {assessment: assessment} only %}


    {# ----------------------------------------------------------- #}
    {# Allowed Time #}
    {# ----------------------------------------------------------- #}
    <div class="row">
        <div class="small-5 medium-2 columns">
            <label for="hasDuration" class="inline-block">Allowed Time<span class="hint has-tip tip-top" data-tooltip title="After starting a quiz, students will have this much time to complete it. Switch off for no limit.">?</span></label>
            <div class="switch">
                <input name="hasDuration" id="hasDuration" type="checkbox" {% if assessment.duration != -1 %}checked="checked"{% endif %} />
                <label for="hasDuration">
                    <span class="icon-approve"></span>
                    <span class="icon-cancel"></span>
                </label>
            </div>
        </div>
        <div class="small-7 medium-10 columns no-pad {% if assessment.duration == -1 %}hide{% endif %}" id="durationPanel">
            <div class="small-6 columns">
                <label>Hours
                    <input name='durationHours' type="text" value="{% if assessment.duration != -1 %}{{ assessment.durationComponents.hours ?? '' }}{% endif %}" />
                </label>
            </div>
            <div class="small-6 columns">
                <label>Minutes
                    <input name='durationMinutes' type="text" value="{% if assessment.duration != -1 %}{{ assessment.durationComponents.minutes ?? '' }}{% endif %}" />
                </label>
            </div>
        </div>
    </div>

    {# Enforce Safe Exam Browser #}
    {% include '@learningAssessment/fragments/sebSwitch.twig' with {assessment: assessment} only %}
</fieldset>


{# ----------------------------------------------------------- #}
{# Dates #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification %}
    <fieldset>
        <legend>Submission Dates</legend>
        {% include '@learningAssessment/fragments/dates.twig' %}
    </fieldset>
{% endif %}


{# ----------------------------------------------------------- #}
{# Grading #}
{# ----------------------------------------------------------- #}
<fieldset>
    <legend>{{ locale.grading.proper }}</legend>

    {% include '@learningAssessment/fragments/weight.twig' %}

    {% import 'sub/visibility.twig' as visibility %}
    {{ visibility.dropdown(markVisibility, availableVisibilities) }}
</fieldset>


{# ----------------------------------------------------------- #}
{# Participation #}
{# ----------------------------------------------------------- #}
{% if context.baseContext is not unitSpecification and custom_assessment_participation %}
    {% include '@learningAssessment/fragments/participation.twig' %}
{% endif %}


{# ----------------------------------------------------------- #}
{# Curriculum #}
{# ----------------------------------------------------------- #}
{% include '@learningAssessment/fragments/curriculumCodes.twig' with {entityType: 'Quiz'} %}


{# ----------------------------------------------------------- #}
{# Submit #}
{# ----------------------------------------------------------- #}
{{ mage.submitRow(actionLabel ?? 'Create', 'part-2', 'end') }}


{# ----------------------------------------------------------- #}
{# Scripts #}
{# ----------------------------------------------------------- #}
<script src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script>
    $(function () {
        // Init CKEditor
        $.fn.alaressEditor();

        $(document).foundation();

        var $durationPanel = $('#durationPanel');
        var $durationInputs = $durationPanel.find('input[type=text]');

        $('#hasDuration').on('click', function() {
            var $checkbox = $(this);
            if ($checkbox.is(':checked')) {
                $('#durationPanel').stop().hide().removeClass('hide').fadeIn(400);
                $durationInputs.prop('disabled', false);
            }
            else {
                /* Hide panel + disable inputs
                 */
                $durationPanel.stop().fadeOut(400);
                $durationInputs.prop('disabled', true);
            }
        });
    });
</script>
