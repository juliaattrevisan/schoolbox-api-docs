{##
 # assessment   an IAssesssable instance
 # student      the student currently being viewed
 # icon         a css class representing the assessable
 #}
{% import '@learningAssessment/fragments/macro/duration.twig' as duration %}
<ul class="meta">
    {% include '@learning/fragments/meta/dueDate.twig' %}
    <li class="icon-time-value" title="Allowed Time">Allowed time:
        <time>
            {% if assessment.durationUnlimited %}
                Unlimited
            {% else %}
                {{ duration.secondsToHoursAndMinutes(assessment.duration) }}
            {% endif %}
        </time>
    </li>
    {% include '@learning/fragments/meta/workType.twig' %}
    {% if student.id != USER.id %}
    <li class="icon-staff-students">{{ student.fullname }}</li>
    {% endif %}
    {% if lastViews is not empty %}
        <li class="icon-staff-students" title="{% if lastViews.student.date is not null %}{{ lastViews.student.date }}{% endif %}">
            {{ lastViews.student.name }} {{ lastViews.student.status }}
            {% if 'assessment' is same as(lastViews.student.object) %} this {{ locale.assessment }}{% else %} the feedback {% endif %}
        </li>
        {% for parent in lastViews.parents %}
            {% if parent.date is not null %}
                <li class="icon-staff">
                    <span title="{{ parent.date }}">{{ parent.name }}</span>
                    {{ parent.status }} {% if 'assessment' is same as(parent.object) %} this {{ locale.assessment }}{% else %} the feedback {% endif %}
                </li>
            {% endif %}
        {% endfor %}
    {% endif %}
</ul>
