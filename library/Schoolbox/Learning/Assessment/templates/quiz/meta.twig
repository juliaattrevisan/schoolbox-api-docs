{##
 # assessment   an IAssesssable instance
 # canAttempt   whether the logged-in user can attempt the quiz (boolean)
 # student      the student currently being viewed
 # icon         a css class representing the assessable
 #}
{% import '@learningAssessment/fragments/macro/duration.twig' as duration %}
<ul class="meta">
    {% include '@learning/fragments/meta/dueDate.twig' %}
    {% include '@learning/fragments/meta/curriculumCodes.twig' %}

    {# (optional) Allowed time #}
    <li class="icon-time-value" title="Allowed Time">{% apply spaceless %}
        {% if not canAttempt %}
            You cannot attempt this quiz
        {% else %}
            Allowed time: <time>{{ duration.secondsToHoursAndMinutes(assessment.duration) }}</time>
        {% endif %}
        {% endapply %}</li>

    {# (optional) Reading time #}
    {% if assessment.readingTimeDuration and canAttempt %}
    <li class="icon-time-value" title="Reading Time">{% apply spaceless %}
        Reading time: <time>{{ duration.secondsToHoursAndMinutes(assessment.readingTimeDuration) }}</time>
    {% endapply %}</li>
    {% endif %}

    {% include '@learning/fragments/meta/workType.twig' %}

    {# joining student name with lastView data #}
    {% if student.id != USER.id %}
        <li class="icon-staff-students" title="{% if lastViews.student.date is defined and lastViews.student.date is not null %}{{ lastViews.student.date }}{% endif %}">{% apply spaceless %}
            <a href="/search/user/{{ student.id }}">{{ student.fullname }}</a>
            {% if lastViews is not empty %}
                {{ lastViews.student.status }}
                {% if 'assessment' is same as(lastViews.student.object) %} this {{ locale.activity }}{% else %} the feedback {% endif %}
            {% endif %}
        {% endapply %}</li>
    {% endif %}
    {% if lastViews is not empty %}
        {% for parent in lastViews.parents %}
            {% if parent.date is not null %}
                <li class="icon-staff" title="{{ parent.date }}">{% apply spaceless %}
                    <a href="/search/user/{{ parent.id }}">{{ parent.name }}</a>
                    {{ parent.status }} {% if 'assessment' is same as(parent.object) %} this {{ locale.activity }}{% else %} the feedback {% endif %}
                {% endapply %}</li>
            {% endif %}
        {% endfor %}
    {% endif %}
</ul>
