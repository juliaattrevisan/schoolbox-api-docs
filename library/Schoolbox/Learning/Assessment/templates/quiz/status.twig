{#  usage: per-participation, configure the following vars for the parent template to use
     - pActionResponses: a route to see the list of responses for this participation
     - pStatusText:      the description to output under the user's name
     - pStatusClass:     one of [ '', 'pending', 'complete' ] to denote the action status of this participation
     - pTooltip:         a tooltip explaining the status marker

    available varaibles:
     - routeArgs:        an array that represents a participant, to be pushed into a routeLookup
     - assessment:       the assessment we're looking at
     - participant:      the current participant of the iteration
     - statusIncomplete: a string representing the 'incomplete' state
     - statusPending:    a string representing the 'pending' state
     - statusReviewed:   a string representing the 'reviewed' state

#}
{% import '@learning/macro/urgency.twig' as urgency %}
{% import 'sub/assessmentResponse.twig' as assessmentResponse %}

{% extends '@learningAssessment/status.twig' %}


{% set labelIncomplete = 'Not Attempted' %}
{% set labelPending    = 'Review required' %}
{% set labelReviewed   = 'Reviewed' %}

{# Override default route #}
{% set routeModify = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessment.id}) %}

{% block headerOptions %}
    <li>
        <a class="icon-class-list" href="{{ routeLookup('learningQuiz.getQuizReviewHorizontal', { assessmentId: assessment.id }) }}">Review horizontally</a>
    </li>
    <li>
        <a class="icon-download" href="{{ routeLookup('learningQuiz.getExportAttempts', { assessmentId: assessment.id }) }}?format=csv">Download All</a>
    </li>
    <li class="separator">Bulk Actions</li>
    <li>
        <a class="icon-approve" data-reveal-id="mass-review">Mark attempts as reviewed&hellip;</a>
    </li>
    <li>
        <a class="icon-delete" data-reveal-id="mass-delete">Delete unreviewed attempts&hellip;</a>
    </li>
{% endblock %}


{% block config %}

    {% set latestAttempt     = participant.authoritativeResponse(false) %}
    {% set latestReview      = latestAttempt.findMostRecentFeedback %}
    {% set multipleResponses = participant.allResponses | length > 1 %}

    {% set isPublished  = latestReview.published %}
    {% set canPublish   = latestReview and not isPublished %}

    {% if not latestAttempt %}
        {% set pActionSummary    = '' %}
    {% endif %}

    {% if latestAttempt %}
        {% if latestAttempt.isSubmitted %}
            {% if latestReview %}
                {% if latestReview.publishedAt.lt(latestAttempt.submittedAt) %}
                    {# Feedback Required
                     # Published feedback is outdated - attempt was finished more recently
                     #}
                    {% set pStatusClass = statusPending %}
                    {% set pTooltip     = labelPending %}
                {% else %}
                    {# No feedback required
                     # Published feedback is more recent than latest finished attempt
                     #}
                    {% set pStatusClass = statusReviewed %}
                    {% set pTooltip = labelReviewed %}
                {% endif %}
            {% else %}
                {# Feedback Required
                 # No published feedback ever existed
                 #}
                {% set pStatusClass = statusPending %}
                {% set pTooltip = labelPending %}
            {% endif %}
        {% else %}
            {# Feedback Required
             # Current attempt is being undertaken, and -will- require feedback or other kind
             # of teacher intervention (this situation is not Reviewed or Not Attempted which is
             # where Bagius' light turns green)
             #}
            {% set pStatusClass = statusPending %}
            {% set pTooltip = 'Review will be required when this attempt is finished' %}
        {% endif %}
    {% else %}
        {# No Feedback Required
         # Not Attempted yet
         #}
        {% set pStatusClass = statusIncomplete %}
        {% set pTooltip = 'Not attempted' %}
    {% endif %}

    {% set pStatusText %}
        {%- spaceless %}
            {% if not latestAttempt %}
                Not attempted
            {% else %}
                {% if latestAttempt.submittedAt.isNull %}
                    Attempt in progress
                {% else %}
                    {% if multipleResponses %}
                        Reattempted
                    {% else %}
                        Attempted
                    {% endif %}
                    {% if latestAttempt.submittedOnTime %}
                        on time
                    {% else %}
                        late
                    {% endif %}
                {% endif %}
            {% endif %}
        {% endspaceless -%}
    {% endset %}

    {{ parent() }}
{% endblock %}


{% block extra_nav_items %}
    {% set attempt = participant.findMostRecentResponse %}
    {% if attempt and not attempt.submitted %}
        <form id="form-quiz-submit-{{ attempt.id }}" method="post" action="{{ routeLookupIfAuthorized('learningQuiz.postQuizSubmit')}}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">
            <input type="hidden" name="attemptId" value="{{ attempt.id }}">
        </form>
        <li><a data-quiz-submit="{{ attempt.id }}" class="icon-tick" href="#" title="Mark As Submitted">Mark As Submitted</a></li>
    {% endif %}
{% endblock %}


{% block meta %}
    {% if participant.allResponses | length %}
        <div class="small-12 large-4 column content">
            {% set urgencyClass = latestReview ? urgency.marks(latestReview.normalisedMark) : '' %}

            {% if latestAttempt %}
                {% if latestAttempt.submitted %}
                    {% if latestReview %}
                        <span class="grade {{ urgencyClass }}">
                            <span>{{ latestReview.humanReadableMark }}</span>
                         </span>
                    {% else %}
                        {#<a href="#" class="button expand">Review</a>#}
                        <h4>Awaiting Review</h4>
                    {% endif %}
                {% else %}
                    <h4>In Progress</h4>
                {% endif %}
            {% else %}
                &ndash;
            {% endif %}
        </div>
        <div class="small-12 large-8 column content">
            {% if latestAttempt.submitted %}
                Finished <time title="{{ latestAttempt.submittedAt.local }}"><strong>{{ latestAttempt.submittedAt.relativeTime }}</strong></time> in <strong>{{ latestAttempt.duration.hms }}</strong>
                {% if multipleResponses %}({{ participant.allResponses | length - 1 }} previous attempts){% endif %}
            {% endif %}
        </div>
    {% endif %}
{% endblock %}


{% block action_bar %}
    {% set actionStyle = latestReview.published or not latestAttempt.submitted ? 'display:none;' : '' %}
    <div class="row">
        <div class="small-12 column">
            <div class="component-action">
                <section>
                    <div style="{{ actionStyle }}" data-action-bar="{{ participant.user.id }}">
                        {%- spaceless %}
                            <a class="button" data-interaction-delete="{{ attempt.id }}" href="#" >Delete Attempt</a>
                            <a class="button" data-interaction-review="{{ attempt.id }}" href="{{ assessmentResponse.localUrl(attempt) }}">Review Attempt</a>
                        {% endspaceless -%}
                    </div>
                </section>
            </div>
        </div>
    </div>
{% endblock %}




{% block scripts %}
    <script type="application/javascript" src="/javascript/shared/submissions/jquery.bulky.js"></script>
    <div id="mass-review" class="reveal-modal" data-reveal data-list-id="mass-review-list" aria-hidden="true" role="dialog">
        <h2>Mark Attempts as Reviewed</h2>
        <p data-mass-unavailable>There are no unreviewed attempts for this activity currently visible.</p>
        <p data-mass-available>The following attempts can be marked as reviewed:</p>
        <div style="">
            <section class="checklist" id="mass-review-list">
                <div data-template>{# this will get detached from the DOM on pageload #}
                    <input type="checkbox" data-selected checked />
                    <label class="checkbox-label" data-participant-name>{# populated by JS #}</label>
                </div>
            </section>
        </div>
        <div class="component-action">
            <section>
                {%- spaceless -%}
                    <a class="button">Cancel</a>
                    <a class="button" data-submit>Mark All as Reviewed</a>
                {%- endspaceless -%}
            </section>
        </div>
        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>

    <div id="mass-delete" class="reveal-modal" data-reveal data-list-id="mass-delete-list" aria-hidden="true" role="dialog">
        <h2>Delete Attempts</h2>
        <p data-mass-unavailable>There are no unreviewed attempts for this activity currently visible.</p>
        <p data-mass-available>The following attempts can be deleted:</p>
        <section class="checklist" id="mass-delete-list">
            <div style="">
                <div data-template>{# this will get detached from the DOM on pageload #}
                    <input type="checkbox" data-selected checked />
                    <label class="checkbox-label" data-participant-name>{# populated by JS #}</label>
                </div>
            </div>
        </section>
        <p data-mass-available><em>Note: all unreviewed attempts will be deleted for any students selected.</em></p>
        <div class="component-action">
            <section>
                {%- spaceless -%}
                    <a class="button">Cancel</a>
                    <a class="button" data-submit>Delete All</a>
                {%- endspaceless -%}
            </section>
        </div>
        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>

    <script type="text/javascript">
        $(function() {

            // Finish incomplete quiz attempt
            $('[data-quiz-submit]').click(function(e) {
                e.preventDefault();
                var attemptId = $('[data-quiz-submit]').attr('data-quiz-submit');
                $('#form-quiz-submit-' + attemptId).submit();
            });
        });

        $(function () {

            var $participantList  = $('#assessment-status');

            $('#mass-review').bulky({
                submitText: function (len, all) {
                    if (!len) {
                        return 'None Selected';
                    }
                    if (len == all) {
                        return 'Mark All as Reviewed';
                    }
                    return 'Mark ' + len + ' Selected as Reviewed';
                },
                userList: $participantList,
                onSubmit: function (toReview) {
                    var list = toReview.map(function () {
                        return $(this).find('[data-interaction-review]').data('interactionReview');
                    }).get();

                    $.post(
                        '/assess/reviewAttempt',
                        { selectedIds: list }
                    ).always(function () {
                        location.reload();
                    });
                }
            });

            $('#mass-delete').bulky({
                submitText: function (len, all) {
                    if (!len) {
                        return 'None Selected';
                    }
                    if (len == all) {
                        return 'Delete All';
                    }
                    return 'Delete ' + len + ' Selected';
                },
                userList: $participantList,
                onSubmit: function (toDelete) {
                    var userList = toDelete.map(function () { return $(this).data('interactionDraft'); }).get();

                    $.post(
                        '/assess/deleteAttempt',
                        { userIds: userList, assessmentId: {{ assessment.id }} }
                    ).always(function () {
                        location.reload();
                    });
                }
            });

            $participantList.on('click', '[data-interaction-delete]', function (e) {
                e.preventDefault();

                var $a = $(this);

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this attempt?',
                    confirmEvent: function () {
                        $.post(
                            '/assess/deleteAttempt',
                            { attemptIds: [ $a.attr('data-interaction-delete') ]}
                        ).always(function () {
                            location.reload();
                        });
                    }
                });
            });
        });
    </script>
{% endblock %}
