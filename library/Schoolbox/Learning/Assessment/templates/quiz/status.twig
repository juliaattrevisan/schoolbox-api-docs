{#  usage: per-participation, configure the following vars for the parent template to use
    available variables:
     - routeArgs:        an array that represents a participant, to be pushed into a routeLookup
     - assessment:       the assessment we're looking at
     - participant:      the current participant of the iteration
     - statusIncomplete: a string representing the 'incomplete' state
     - statusPending:    a string representing the 'pending' state
     - statusReviewed:   a string representing the 'reviewed' state
#}
{% import '@learning/macro/urgency.twig' as urgency %}
{% import 'sub/assessmentResponse.twig' as assessmentResponse %}

{% extends '@learningAssessment/status.twig' %}

{% set labelIncomplete = 'Not Attempted' %}
{% set labelPending    = 'Review required' %}
{% set labelReviewed   = 'Reviewed' %}

{% block flashMessage %}
    <div class="row" id="rescore" style="display:none">
        <div class="small-12 columns">
            <div class="alert-box warning">Rescoring in progress; please allow 30 minutes for changes to take effect.</div>
        </div>
    </div>
{% endblock flashMessage %}

{% block routeModify %}
    {% set routeModify = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}

    {% if routeModify %}
        {% set modifyContentsRoute = routeLookupIfAuthorized('learnosity.getContent', {assessment: assessment, assessmentId: assessment.id}) %}
        {% set rescoreRoute = routeLookupIfAuthorized('learnosity.postRescoreAttempts', {assessment: assessment, assessmentId: assessment.id}) %}

        <li><a class="icon-modify" href="{{ routeModify }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Modify Settings</a></li>
        <li><a class="icon-modify" href="{{ modifyContentsRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Modify Contents</a></li>
        <li><a class="icon-quiz" href="{{ rescoreRoute }}" data-rescore>Rescore all attempts</a></li>

        <script>
            $(function() {
                $('[data-rescore]').on('click', function(event) {
                    event.preventDefault();

                    $(this).confirmDialog({
                        header: 'Rescore attempts',
                        text: "If you’ve altered the scoring method of a question (such as changing a <em>Scoring Type option</em>, " +
                              "or changing the amount a question is worth) after students have made attempts, the attempts " +
                              "might not tally in the intended manner. Using this tool will update everyone’s attempt " +
                              "on this quiz and recalculate their scores according to the current questions' setup. " +
                              "It might take a little while to process; results aren’t always immediately available." +
                              "<br /><br />" +
                              "After using this rescoring feature you should review the feedback you’ve provided for " +
                              "students' attempts." +
                              "<br /><br />" +
                              "<strong>Be aware that running the rescore tool will remove all manually input or updated scores " +
                              "(but not the feedback comment) from all questions.</strong> Please also download a csv of answers " +
                              "before rescoring.",
                        format: 'html',
                        confirmLabel: 'Rescore',
                        confirmEvent: function() {
                            $.post('{{ rescoreRoute }}', {}, function(responseText) {
                                $('#rescore').show();
                            });
                        }
                    });
                });
            });
        </script>
    {% endif %}
{% endblock %}

{% set responseHistory = locale.attemptHistory.proper %}

{% block headerOptions %}
    <li>
        <a class="icon-class-list" href="{{ routeLookup('learnosity.getHorizontalMarking', { assessmentId: assessment.id }) }}">Review horizontally</a>
    </li>
    <li>
        <a class="icon-download" data-download="attempts" href="{{ routeLookup('learnosity.getExportAttempts', { assessmentId: assessment.id }) }}">Download All</a>
    </li>
    <li class="separator">Bulk Actions</li>
    <li>
        <a class="icon-approve" data-reveal-id="mass-review">Mark attempts as reviewed&hellip;</a>
    </li>
    <li>
        <a class="icon-delete" data-reveal-id="mass-delete">Delete unreviewed attempts&hellip;</a>
    </li>
{% endblock %}


{##
 # Participant
 #
 # Each person in the list is rendered here
 # Each type of assessment renders their participants uniquely
 #}
{% block participant %}
    {% set latestResponse    = participant.findMostRecentResponse %}
    {% set latestFeedback    = latestResponse ? latestResponse.findMostRecentInstructorGivenFeedback : null %}
    {% set multipleResponses = participant.allResponses | length > 1 %}

    {# Tot actions are derived from access to the Attempt History route
     # By default this empty, hiding the tot
     #}
    {% set pActionSummary = latestResponse ? routeLookupIfAuthorized('learningAssessment.getSummary', routeArgs) : null %}

    {% set pActionCount = (pActionSummary ? 1 : 0) %}

    {# A discriminator for tabindexes #}
    {% set inputNo = 1 %}

    {# Progress icon
     # One of [ '', 'pending', 'complete' ] to denote the action status of this participation
     # The green dot/grey square/oj diamond
     #}
    {% set pStatusClass %}
        {%- apply spaceless %}
            {% if participant.responseRequired %}
                {{ statusIncomplete }}
            {% elseif participant.reviewComplete %}
                {{ statusReviewed }}
            {% else %}
                {{ statusPending }}
            {% endif %}
        {% endapply -%}
    {% endset %}

    {# Progress icon tool tip
     # A tooltip explaining the status marker
     # This is the tooltip that appears when you hover over the green dot/grey square/oj diamond
     #}
    {% set pTooltip %}
        {%- apply spaceless %}
            {% if latestResponse and not latestResponse.isSubmitted %}
                Review will be required when this attempt is finished
            {% elseif participant.responseRequired %}
                Not Attempted
            {% elseif participant.reviewComplete %}
                Reviewed
            {% else %}
                Review required
            {% endif %}
        {% endapply -%}
    {% endset %}

    {# The description to output under the user's name
     # This is the text that appears next to the green dot/grey square/oj diamond
     #}
    {% set pStatusText %}
        {%- apply spaceless %}
            {% if not latestResponse %}
                Not attempted
            {% elseif not latestResponse.submittedAt %}
                Attempt in progress
            {% else %}
                {% if multipleResponses %}
                    Reattempted
                {% else %}
                    Attempted
                {% endif %}

                {% if participant.getDueDate and latestResponse.submittedOnTime %}
                    on time
                {% else %}
                    late
                {% endif %}
            {% endif %}
        {% endapply -%}
    {% endset %}

    <li data-status="{{ pStatusClass }}" data-participant-external-id="{{ participant.user.externalId }}" data-participant="{{ participant.user.id }}" data-participant-name="{{ participant.user.fullName }}">
        <div class="flex-grade">
            <div class="{{ cardSize ?? 'small-12' }} card sibling">
                <a href="/search/user/{{ participant.user.id }}" title="View Profile">
                    {% include 'include/portrait.twig' with {user: participant.user} only %}
                </a>
                {% if not participant.user.deleted %}
                    <h3>
                        <a href="/search/user/{{ participant.user.id }}" title="View Profile">{{ participant.user.fullName }}</a>
                        {% if not participant.plan.isDynamic %}
                            <span class="individualisation has-tip tip-top" data-tooltip title="{{ participant.plan.name }} ({{ participant.plan.duedate.short }})">i</span>
                        {% endif %}
                    </h3>
                {% else %}
                    <h3>{{ participant.user.fullName }}</h3>
                {% endif %}
                <p class="meta">
                    <span title="{{ pTooltip }}" data-status class="progress-tick tiny {{ pStatusClass }}"></span>
                    <span data-status-label>{{ pStatusText }}</span>
                    {% if pActionSummary %}<span class="pipe meta"><a href="{{ pActionSummary }}" title="View {{ participant.user.givenName }}'s history">View {{ responseHistory }}</a></span>{% endif %}
                </p>
            </div>
            {% if participant.allResponses | length %}
                {% if latestResponse.submitted and latestResponse.learnosityReference %}
                    <div class="txt">
                    <p>Finished <time title="{{ latestResponse.submittedAt.local }}"><strong>{{ latestResponse.submittedAt.relativeTime }}</strong></time> in <strong>{{ latestResponse.duration.hms }}</strong></p>
                    {% if multipleResponses %}({{ participant.allResponses | length - 1 }} previous attempts){% endif %}
                    </div>
                {% elseif latestResponse.submitted %}
                    <div class="txt">
                    <p>Published <time title="{{ latestResponse.submittedAt.local }}"><strong>{{ latestResponse.submittedAt.relativeTime }}</strong></time></p>
                    </div>
                {% endif %}

                {% set urgencyClass = latestFeedback ? urgency.marks(latestFeedback.normalisedMark) : '' %}
            {% endif %}

            {# Quiz Attempts could be in either Learnosity, or our legacy quiz system
             # Legacy Quiz attempts are not going to be in learnosity
             #
             # So if we have a learnosity_reference, make a link to learnosity feedback screen
             # Otherwise, prohibit the link; users won't be able to see legacy attempts anymore.
             # We might make a "museum" for these old attempts one day
             #}
            {% if latestResponse %}
                {% if latestResponse.learnosityReference %}
                    {% if latestResponse.submitted %}
                        {% if not latestFeedback %}
                            <div class="grade review">
                                <span>Awaiting Review</span>
                            </div>
                        {% elseif latestFeedback.normalisedMark|length %}
                            <div class="grade {{ urgencyClass }}-bg">
                                <span>{{ latestFeedback.humanReadableMark }}</span>
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="grade in-progress">
                            <span>In Progress</span>
                        </div>
                    {% endif %}
                {% else %}

                    {# Legacy quiz attempts are rendered here
                     # mostly synonymously with learnosity
                     # except for the things you can't action here (ie. to be reviewed)
                     # hence the mark will be hidden from the screen
                     #}
                    {% if latestResponse.submitted %}
                        {% if latestFeedback and latestFeedback.humanReadableMark|length %}
                            <div class="grade {{ urgencyClass }}-bg">
                                <span>{{ latestFeedback.humanReadableMark }}</span>
                            </div>
                        {% endif %}
                    {% endif %}
                {% endif %}
            {% endif %}
        </div>

        {##
         # Action Bar at the bottom of each participant's row
         #}
        {% set canFinish  = latestResponse and not latestResponse.submitted %}

        {# If you have made an attempt, it's officially submitted, you can publish a feedback
         # The existing feedback, if it exists, gets updated with the new grade and comment;
         # otherwise, a new one spawns
         #}
        {% set canPublish = latestResponse and latestResponse.submitted %}
        {% set canDelete  = latestResponse and (not latestFeedback or not latestFeedback.published) %}

        {# Only show if there's an existing learnosity attempt, otherwise we'll show when there's a change to grade/comment #}
        {% set actionStyle = latestResponse.learnosityReference ?? null ? 'display: block' : 'display: none' %}

        {# The most recent feedback, supposedly #}
        {% set latestFeedback = participant.findMostRecentInstructorGivenFeedback %}

        {# Decide if the Save And Publish buton is visible #}
        {% set publishStyle = 'display: none' %}

        {% if (latestFeedback ?? null) and not latestFeedback.published %}
            {% set publishStyle = 'display: block' %}
        {% endif %}

        {# Mass/Bulk actions #}
        {% set massActions = '' %}
        {% if canPublish %}{% set massActions = massActions ~ ' data-mass-review' %}{% endif %}
        {% if canDelete %}{% set massActions = massActions ~ ' data-mass-delete' %}{% endif %}

        {# Buttons #}
        {% apply spaceless %}
            {% set buttons %}
                {# Quiz Attempts could be in either Learnosity, or our legacy quiz system
                 # Legacy Quiz attempts are not going to be in learnosity
                 #
                 # So if we have a learnosity_reference, make a link to learnosity feedback screen
                 # Otherwise, prohibit the link; users won't be able to see legacy attempts anymore.
                 # We might make a "museum" for these old attempts one day
                 #}
                {% if latestResponse.learnosityReference ?? null %}
                    {% if canDelete %}<a class="button" data-interaction-delete="{{ latestResponse.id }}" href="{{ routeLookupIfAuthorized('learnosity.postDeleteAttempts', {assessment: assessment, assessmentId: assessment.id }) }}">Delete Attempt</a>{% endif %}
                    {% if canFinish %}<a class="button" data-interaction-finish="{{ latestResponse.id }}" data-interaction-finish-reference="{{ latestResponse.learnosityReference }}" href="{{ routeLookupIfAuthorized('learnosity.postCompleteAttempt', {assessment: assessment, assessmentId: assessment.id, studentId: latestResponse.submittedBy.id}) }}">Finish Attempt</a>{% endif %}

                    {% if canPublish or canFinish %}
                        <a
                            {% if not canPublish %}style="display:none"{% endif %}
                            class="button"
                            data-interaction-review="{{ latestResponse.id }}"
                            href="{{ routeLookupIfAuthorized('learnosity.getFeedback', {assessment: assessment, assessmentId: assessment.id, studentId: participant.user.id, learnositySessionReference: latestResponse.learnosityReference}) }}"
                        >
                            Review Attempt
                        </a>
                    {% endif %}
                {% endif %}

                {# You can always publish a new feedback...even if the student never attempted it #}
                <a class="button" style="{{ publishStyle }}" data-draft="publish" data-interaction-publish="{{ participant.user.id }}" href="#save-and-publish">Save and Publish</a>
            {% endset %}
        {% endapply %}

        {# Quizzes now support Submission States #}
        <div class="small-12 column">
            <form data-feedback-form="{{ participant.user.id }}" method="post" action="{{ routeLookupIfAuthorized('learningQuizAttempt.postModify', {assessment: assessment, assessmentId: assessment.id, studentId: participant.user.id }) }}">
                {# Maximum available marks for this guy. Total Mark required a learnosity interrogation.
                 # Everything else can be assumed to be out of 100, since that is already hardcoded in each
                 # MarkScheme template already, for whatever reason; this nullsafe operator is syntactic only
                 #
                 # In the absence of any learnosity-derived specific maxMarks values, use the template's
                 # defaulted hardcoded value of 100.
                 #}
                {% set maxMarks = maxMarks[participant.user.id] ?? latestResponse.marksAvailable ?? null %}

                <input type="hidden" name="responseId" value="{{ latestResponse.id ?? '' }}"/>
                <input type="hidden" name="maxMarks" value="{{ maxMarks }}" />

                <div class="row">
                    {# Quiz always has a Mark Type (it's mandatory) #}
                    <div class="small-12 medium-3 column">
                        <label>{{ locale.grades.proper }}
                            {# For quizzes, each person's attempt can vary from other attempts, which occurs
                             # when the content of quiz changes halfway through everyone doing it. This means
                             # the $limit param can't be derived from the assessment's markScheme instance,
                             # which would apply the same limit to everyone. This necessitates a $maxMark
                             # lookup for each person, and in the absence of an attempt, ask Learnosity for
                             # what's available at the moment.
                             #}
                            {% include '@learningMarkScheme/'~assessment.markScheme.template~'.twig' with {
                                assessment:  assessment,
                                participant: participant,
                                feedback:    latestFeedback,
                                markScheme:  assessment.markScheme,
                                limit:       maxMarks,
                                tabIndex:    loop.index0 + inputNo,
                                errors:      errors,
                                readonly:    false,
                            } only %}
                            {% set inputNo = inputNo + 1 %}
                        </label>
                    </div>
                    <div class="small-12 medium-9 column">
                        {% include '@learningAssessment/quiz/comment.twig' with {
                            feedback:       latestFeedback,
                            participant:    participant,
                            tabIndex:       loop.index0 + inputNo
                        } only %}
                        {% set inputNo = inputNo + 1 %}
                    </div>
                </div>
            </form>
        </div>

        {% include '@learningAssessment/fragments/actionBar.twig' with {
            actionStyle:  actionStyle,
            massActions:  massActions,
            buttons:      buttons,
            participant:  participant
        } only %}
    </li>
{% endblock %}


{##
 # Massive javascript hulk
 #}
{% block scripts %}
    <script type="application/javascript" src="{{ CDN_PREFIX }}/js/submissions/jquery.bulky.js?v={{ config.site_version }}"></script>
    <div id="mass-review" class="reveal-modal" data-reveal data-list-id="mass-review-list" aria-hidden="true" role="dialog">
        <h2>Mark Attempts as Reviewed</h2>
        <p data-mass-unavailable>There aren't any unreviewed attempts for this activity.</p>
        <p data-mass-available>The following attempts can be marked as reviewed:</p>
        <div style="">
            <section class="checklist" id="mass-review-list">
                <div data-template>{# this will get detached from the DOM on pageload #}
                    <input type="checkbox" data-selected checked />
                    <label class="checkbox-label" data-participant-name>{# populated by JS #}</label>
                </div>
            </section>
        </div>
        <div class="component-action">
            <section>
                {%- apply spaceless -%}
                    <a class="button">Cancel</a>
                    <a class="button" data-submit>Mark All as Reviewed</a>
                {%- endapply -%}
            </section>
        </div>
        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>

    <div id="mass-delete" class="reveal-modal" data-reveal data-list-id="mass-delete-list" aria-hidden="true" role="dialog">
        <h2>Delete Attempts</h2>
        <p data-mass-unavailable>There aren't any unreviewed attempts for this activity.</p>
        <p data-mass-available>The following attempts can be deleted:</p>
        <section class="checklist" id="mass-delete-list">
            <div style="">
                <div data-template>{# this will get detached from the DOM on pageload #}
                    <input type="checkbox" data-selected checked />
                    <label class="checkbox-label" data-participant-name>{# populated by JS #}</label>
                </div>
            </div>
        </section>
        <p data-mass-available><em>Note: all unreviewed attempts will be deleted for any students selected.</em></p>
        <div class="component-action">
            <section>
                {%- apply spaceless -%}
                    <a class="button">Cancel</a>
                    <a class="button" data-submit>Delete All</a>
                {%- endapply -%}
            </section>
        </div>
        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>

    <div class="toast" data-alert data-save-draft></div>

    <script type="text/javascript" src='{{ CDN_PREFIX }}/js/submissions/jquery.dynamic-feedback.js'></script>
    <script type="text/javascript">
        $(function() {
            var $participantList  = $('#assessment-status');

            /**
            * Currently quiz does not support a draft state, so any changes to grade/comment is published when a 'Save and Publish' button is selected instead.
            * We circumvent the draft state by showing the 'Save and Publish' button immediately and abort the saving of a draft state.
            */
            $.fn.dynamicFeedback({
                isQuiz: true,
                publishText: "Save and Publish",
            });

            {# Mass review submitted but unreviewed quiz attempts #}
            $('#mass-review').bulky({
                submitText: function (len, all) {
                    if (!len) {
                        return 'None Selected';
                    }
                    if (len == all) {
                        return 'Mark All as Reviewed';
                    }
                    return 'Mark ' + len + ' Selected as Reviewed';
                },
                userList: $participantList,
                userSelector: ' [data-interaction-review]:not([style*="display:none"])',
                onSubmit: function (toReview) {
                    let list = toReview.map(function () {
                        return $(this).find('[data-interaction-review]').attr('data-interaction-review') }
                    ).get();

                    $.post(
                        '{{ routeLookup('learnosity.postMassReviewAttempts', {assessmentId: assessment.id }) }}',
                        { attemptIds: list }
                    ).done(function () {
                        location.reload();
                    });
                }
            });

            {# Mass delete unreviewed quiz attempts #}
            $('#mass-delete').bulky({
                submitText: function (len, all) {
                    if (!len) {
                        return 'None Selected';
                    }
                    if (len == all) {
                        return 'Delete All';
                    }
                    return 'Delete ' + len + ' Selected';
                },
                userList: $participantList,
                userSelector: '[data-mass-delete]',
                onSubmit: function (toDelete) {

                    var userList = toDelete.map(function () { return $(this).closest('[data-participant]').attr('data-participant') }).get();

                    $.post(
                        '{{ routeLookup('learnosity.postDeleteUnreviewedAttempts', {assessmentId: assessment.id }) }}',
                        { userIds: userList }
                    ).always(function () {
                        location.reload();
                    });
                }
            });

            {# Delete attempt for single participant #}
            $participantList.on('click', '[data-interaction-delete]', function (e) {
                e.preventDefault();

                let $a = $(this);

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this attempt?',
                    confirmLabel: 'Delete',
                    confirmEvent: function () {
                        $.post(
                            '{{ routeLookup('learnosity.postDeleteAttempts', {assessmentId: assessment.id }) }}',
                            { attemptIds: [ $a.attr('data-interaction-delete') ]}
                        ).done(function () {
                            // We must reload page to populate the action bar with the previous attempt
                            location.reload();
                        });
                    }
                });
            });

            {# Submit/Finish an unfinished/unsubmitted/in-progress quiz attempt #}
            $participantList.on('click', '[data-interaction-finish]', function (e) {
                e.preventDefault();
                let $a = $(this);

                $.post(
                    $a.attr('href'),
                    {
                        attemptId: $a.attr('data-interaction-finish'),
                        learnosityReference: $a.attr('data-interaction-finish-reference')
                    }
                ).done(function () {
                    var $actionBar = $a.closest('[data-action-bar]');
                    $actionBar.attr('data-mass-review', '');
                    $actionBar.find('[data-interaction-review]').show();
                    $a.hide();

                    // Update status for bulk actions to work
                    const participantRow = $a.closest('li');
                    participantRow.attr('data-status', '{{ statusPending }}');

                    // Change "In Progress" grade indicator to "Awaiting Review"
                    const gradeIndicator = participantRow.find(".grade");
                    gradeIndicator.removeClass('in-progress').addClass('review');
                    gradeIndicator.find('span').text('Awaiting Review');

                    // Update status icon and label accordingly
                    participantRow.find('.meta [data-status-label]').text('{{ labelPending }}');
                    const statusIcon = participantRow.find('.meta [data-status]');
                    statusIcon.removeClass('{{ statusIncomplete }}').addClass('{{ statusPending }}');
                    statusIcon.attr('title', '{{ labelPending }}');
                });
            });

            {# download attempts delayed #}
            $('[data-download]').click(function (e) {
                e.preventDefault();
                $(this).confirmDialog({
                    header: 'Download all attempts?',
                    format: 'html',
                    text: `
                                    <p>
                                        Please be aware that your download will take some time
                                        to complete, as we compile the students&rsquo; attempts.
                                    </p>

                                    <p>
                                        Feel free to move away from this page and continue
                                        working: we will send you a notification when the file
                                        is ready to download.
                                    </p>
                                    `,
                    confirmEvent: function () {
                        toast = $('.toast[data-save-draft]');

                        $.post('{{ routeLookup('learnosity.getExportDownload', { assessmentId: assessment.id }) }}').done(function () {
                            toast.toastTimeout({text: 'Generating download...', css: 'info'});
                        })
                    }
                });
            });
        });
    </script>
{% endblock %}
