{##
 # Introduction screen and list of previous attempts
 #
 # @param IAssessable $assessment              Our schoolbgox quiz instance
 # @param Schoolbox\Learning\Quiz\Model $quiz  The representation of schoolbox.assess row
 # @param User $student                        The guy currently at the intro screen
 # @param Attempt\Model[] $attempts            A list of previous attempts
 # @param Attempt\Model|null $existingattempt  An attempt that hasn't been finished
 # @param array $plan                          A set of dates for custom assessment participation
 # @param array $breadcrumbs                   A trail of breadcrumbs
 # @param bool $canAttempt                     Whether users can start/resume attempts
 # @param bool $canReview                      Whether users can provide feedback on an attempt
 # @param bool $canStudentReview               Whether users can see what they responded with, in their attempt
 # @param string $externalRedirectUrl          A url in a third party system (newington canvas) that is relevant to this quiz
 # @param array $lastViews                     A set of (roletype, info) tuples about when a student/parent visited this page
 # @param Participant $participant             A participant of this assessment, used to figure out exclusions and special CAP stuff
 # @param string $returnUrlName                The name of the url parameter to contain $returnUrlEncoded
 # @param string $returnUrlEncoded             An encoded url to visit when navigating between screens and you finsih a workflow somehwere
 #}

{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/macro/duration.twig' as duration %}
{% import '@learningAssessment/fragments/macro/markVisible.twig' as markVisible %}

{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/quiz/meta.twig' with {
            assessment: assessment,
            canAttempt: canAttempt,
            student: student,
            icon: 'icon-quiz',
            lastViews: lastViews
        } only %}
    </div>
    {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}

    {% include '@learningAssessment/fragments/modifyTot.twig' with {
        assessment: assessment,
        gradeRoute: false,
        viewRoute: viewRoute,
        modifyRoute: modifyRoute,
        canShowcase: false,
        isShowcased: false,
        externalRedirectUrl: externalRedirectUrl
    } %}
</div>
{# set a base question number here, so we can use it later... #}
{% set questionCount = 0 %}
<div class="row">
    <div class="small-12 island">
        {% set description = (participant and not participant.isExcluded) ? participant.description : assessment.description  %}
        {% if description|length %}
            <section>
                {% if routeLookupIfAuthorized('immersiveReader.getTokenAndSubdomain') %}
                    <script src="{{ CDN_PREFIX }}/js/immersive-reader/jquery.immersive-reader.js?v={{ config.site_version }}" type="text/javascript"></script>
                    <script type="text/javascript">
                        $(function () {
                            $('[data-immersive-reader]').immersiveReader({title: '{{ assessment.title | escape('js') }}'});
                        });
                    </script>
                    <div class='immersive-reader-button' id="ir-button" data-immersive-reader="button"></div>
                {% endif %}
                <article class="content">
                    {{ description | purify }}
                </article>
            </section>
        {% endif %}
    </div>

    {# Start/Resume an attempt #}
    {% if canAttempt %}
    <div class="small-12 columns">
        {# Decide the name of the start button #}
        {% set callToAction = 'Start Quiz' %}

        {% if existingAttempt %}
            {% set callToAction = 'Resume Quiz' %}
        {% endif %}
        <a class="button submit" href="{{ routeLookupIfAuthorized('learnosity.getAttempt', {assessment: assessment, assessmentId: assessment.id, student: student, studentId: student.id}) }}?{{ returnUrlName }}={{ returnUrlEncoded }}">
            {{ callToAction }}
        </a>
    </div>
    {% endif %}
</div>

{# This is mostly a direct steal from the existing quiz/summary.twig #}
{% if attempts|length %}
<div id='attempts' class="row">
    <div class="small-12 columns">
        <h2 class="subheader">Attempts</h2>

        <table>
            <thead>
            <tr>
                <th>Start</th>
                <th>Finish</th>
                <th>Time Taken</th>
                <th>Reviewed</th>
                <th>Reviewer</th>
                <th>Grade</th>
                <th>&nbsp;</th>
            </tr>
            </thead>
            <tbody>
            {% for attempt in attempts %}
                {% set finished = attempt.finish %}
                <tr data-attempt>
                    <td>{{ attempt.start.short }}</td>
                    <td>
                        {% if finished %}
                            {{ attempt.finish.short }}
                        {% else %}
                            <em>Attempt in progress</em>
                        {% endif %}
                    </td>
                    <td>
                        {% if finished %}
                            {{ duration.secondsToHoursAndMinutes(attempt.start.diffInSeconds(attempt.finish, true)) }}
                        {% else %}
                            <em>{{ duration.secondsToHoursAndMinutes(attempt.start.diffInSeconds(NOW, true)) }}</em>
                        {% endif %}
                    </td>
                    <td>
                        {% if attempt.reviewed %}
                            {{ markVisible.showIfVisible(assessment, attempt.reviewed.short, '—' ) }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>
                        {% if attempt.reviewed %}
                            {% if attempt.reviewer.deleted %}
                                {{ attempt.reviewer.fullname }}
                            {% else %}
                                <a href="/search/user/{{ attempt.reviewer.id }}">{{ attempt.reviewer.fullname }}</a>
                            {% endif %}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>
                        {% if attempt.normalisedMark is not null %}
                            {{ attempt.mark }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td class="actions-small-2">
                        <nav>
                            {% if attempt.learnosityReference %}
                                {% if not finished and canAttempt %}
                                    <a href="{{ routeLookupIfAuthorized('learnosity.getAttempt', {assessment: assessment, assessmentId: assessment.id, student: student, studentId: student.id}) }}" class="icon-next" title="Resume"></a>
                                {% else %}
                                    {% if canStudentReview %}
                                        <a href="{{ routeLookupIfAuthorized('learnosity.getReview', {assessment: assessment, assessmentId: assessment.id, studentId: student.id, learnositySessionReference: attempt.learnosityReference}) }}" class="icon-view" title="Review"></a>
                                    {% endif %}
                                    {% if canReview %}
                                        <a href="{{ routeLookupIfAuthorized('learnosity.getFeedback', {assessment: assessment, assessmentId: assessment.id, studentId: student.id, learnositySessionReference: attempt.learnosityReference}) }}" class="icon-staff" title="Feedback"></a>
                                    {% endif %}
                                {% endif %}
                            {% endif %}

                            {% set deleteRoute = routeLookupIfAuthorized('learningQuiz.postAttemptDelete', {assessmentId: assessment.id, assessment: assessment}) %}
                            {% if deleteRoute %}
                                <a href="{{ deleteRoute }}" class="icon-delete" title="Delete Attempt" data-delete="{{ attempt.id }}"></a>
                            {% endif %}
                        </nav>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

<div id="attempt-toast" class="toast"></div>

<script type="text/javascript">
    $(function() {
        // Delete attempts script
        $('#attempts').find('[data-delete]').click(function (event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this attempt?',
                confirmLabel: 'Delete',
                confirmEvent: function () {
                    var attemptList = $('#attempts');
                    var listItem = $(element).parents('[data-attempt]');

                    var toast = $('#attempt-toast');
                    toast.toastActivate({text: 'Deleting attempt...'});

                    $.post(element.attr('href'), {attemptId: element.attr('data-delete')})
                        .done(function() {
                            toast.toastTimeout({text: 'Attempt deleted.', css: 'success'});

                            listItem.fadeOut({
                                done: function() {
                                    listItem.remove();

                                    if (!attemptList.find('tbody tr').length) {
                                        $('#attempts').hide();
                                    }
                                }
                            });
                        })
                        .fail(function() {
                            toast.toastTimeout({text: 'Could not delete attempt', css: 'alert'});
                        });
                }
            });
        });
    });
</script>
