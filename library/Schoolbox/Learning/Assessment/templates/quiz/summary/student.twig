
{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/macro/duration.twig' as duration %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/quiz/meta.twig' with {
            assessment: assessment,
            submissionsBlocked: submissionsBlocked,
            student: student,
            icon: 'icon-quiz'
        } only %}
    </div>
    {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
    {% set modifyRoute = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessment.id, assessment: assessment}) %}
    {% if viewRoute or modifyRoute %}
        <nav>
            <a href="#" class="icon-more" data-dropdown="header-options" title="Actions"></a>
        </nav>
        <ul data-dropdown-content id="header-options" class="f-dropdown">
            {% if viewRoute %}
                <li><a class="icon-progress" href="{{ viewRoute }}">View Status</a></li>
            {% endif %}
            {% if modifyRoute %}
                <li><a href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-modify">Modify</a></li>
            {% endif %}
        </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        {% set description = (participant and not participant.isExcluded) ? participant.description : assessment.description  %}
        {% if description|length %}
            <section>
                <article class="content">
                    {{ description | purify }}
                </article>
            </section>
        {% endif %}

        <div class="scrollable">
            <table>
                <thead>
                <tr>
                    <th>Section</th>
                    <th>Number of questions</th>
                </tr>
                </thead>
                <tbody>


                {% for section in quiz.sections %}
                <tr>
                    <td>{{ section.title }}</td>
                    <td>
                        {% set questionCount = section.questions | length %}
                        {% if section.pool %}
                            {{ min(questionCount, section.pool) }}
                        {% else %}
                            {{ questionCount }}
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% if canAttempt %}
    <div class="row">
        <div class="small-12 column">
            <p>
                {# TODO allow this to resume an attempt in progress #}
                <a href="/assess/init/{{ quiz.id }}/{{ quiz.sections.first.id }}/{% if returnUrl %}?{{ RETURN_URL.name }}={{ returnUrl|escape('url') }}{% endif %}" class="button expand submit">Begin Quiz</a>
            </p>
        </div>
    </div>
{% endif %}

{# If I'm here I can view attempts #}
{% if quiz.attempts | length %}

    {% set deleteRoute = routeLookupIfAuthorized('learningQuiz.postAttemptDelete') %}

    <div class="row">
        <div class="small-12 columns">
            <h2 class="subheader">Attempts ({{ quiz.attempts | length }} / {{ assessment.attemptsUnlimited ? 'Unlimited' : assessment.maxAttempts }})</h2>
            <table id="attempts">
                <thead>
                <tr>
                    <th>Start</th>
                    <th>Finish</th>
                    <th>Time Taken</th>
                    <th>Reviewed</th>
                    <th>Grade</th>
                    <th>&nbsp;</th>
                </tr>
                </thead>
                <tbody>
                {% for attempt in quiz.attempts %}
                    {% set finished = attempt.finish and not attempt.finish.null %}
                    <tr data-attempt>
                        <td>{{ attempt.start.short }}</td>
                        <td>{{ finished ? attempt.finish.short : 'Unfinished' }}</td>
                        <td>
                            {% if finished %}
                                {{ duration.secondsToHoursAndMinutes(attempt.start.diffInSeconds(attempt.finish, true)) }}
                            {% endif %}
                        </td>
                        <td>{{ attempt.reviewed.short }}</td>
                        <td>{# TODO add marks #}</td>
                        <td class="actions-small-2">
                            <nav>
                                {% if deleteRoute %}
                                    <a href="{{ deleteRoute }}" class="icon-delete" title="Delete Attempt" data-delete="{{ attempt.id }}"></a>
                                {% endif %}
                                {% if canReview %}
                                    <a href="/assess/review/{{ quiz.id }}/{{ quiz.sections.first.id }}/{{ attempt.id }}/{% if returnUrl %}?{{ RETURN_URL.name }}={{ returnUrl|escape('url') }}{% endif %}" class="icon-view" title="Review"></a>
                                {% elseif canStudentReview %}
                                    <a href="/assess/studentReview/{{ quiz.id }}/{{ quiz.sections.first.id }}/{{ attempt.id }}/{% if returnUrl %}?{{ RETURN_URL.name }}={{ returnUrl|escape('url') }}{% endif %}" class="icon-view" title="Review"></a>
                                {% endif %}
                                {#<!-- BEGIN attempt_resume -->#}
                                {#<a href='/assess/attempt/{ATTEMPT_ASSESS_ID}/{ATTEMPT_SECTION_ID}{RETURN_URL_SUFFIX}' class="icon-next" title="Resume"></a>#}
                                {#<!-- END attempt_resume -->#}
                            </nav>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% elseif not canAttempt %}
    <div class="row">
        <div class="small-12 columns">
            <div class="empty-state">
                <i class="icon-quiz"></i>
                <p>There has not been any activity on this {{ locale.assessment }} yet.</p>
            </div>
        </div>
    </div>
{% endif %}

<div id="attempt-toast" class="toast"></div>

<script type="text/javascript">
    $(function() {
        // Delete attempts script
        $('#attempts').find('[data-delete]').click(function (event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this attempt?',
                confirmEvent: function () {
                    var attemptList = $('#attempts');
                    var listItem = $(element).parents('[data-attempt]');

                    var toast = $('#attempt-toast');
                    toast.toastActivate({text: 'Deleting attempt...'});

                    $.post(element.attr('href'), {attemptId: element.attr('data-delete')})
                        .success(function() {
                            toast.toastTimeout({text: 'Attempt deleted.', css: 'success'});

                            listItem.fadeOut({
                                done: function() {
                                    listItem.remove();

                                    if (!attemptList.find('tbody tr').length) {
                                        $('#attempts').hide();
                                        $('#attempt-list-empty-state').removeClass('hide');
                                    }
                                }
                            });
                        })
                        .error(function() {
                            toast.toastTimeout({text: 'Could not delete attempt', css: 'alert'});
                        });
                }
            });
        });
    });
</script>
