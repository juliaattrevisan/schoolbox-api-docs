
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>
        {% include '@learningAssessment/quiz/meta.twig' with {
            assessment: assessment,
            submissionsBlocked: submissionsBlocked,
            student: student,
            duration: duration,
            icon: 'icon-quiz'
        } only %}
    </div>
    {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
    {% set modifyRoute = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessment.id, assessment: assessment}) %}
    {% if viewRoute or modifyRoute %}
        <nav>
            <a href="#" class="icon-more" data-dropdown="header-options" title="Actions"></a>
        </nav>
        <ul data-dropdown-content id="header-options" class="f-dropdown">
            {% if viewRoute %}
                <li><a class="icon-progress" href="{{ viewRoute }}">View Status</a></li>
            {% endif %}
            {% if modifyRoute %}
                <li><a href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="icon-modify">Modify</a></li>
            {% endif %}
        </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        {% set description = (participant and not participant.isExcluded) ? participant.description : assessment.description  %}
        {% if description|length %}
            <section>
                <article class="content">
                    {{ description | purify }}
                </article>
            </section>
        {% endif %}

        <div class="scrollable">
            <table>
                <thead>
                <tr>
                    <th>Section</th>
                    <th>Number of questions</th>
                </tr>
                </thead>
                <tbody>


                {% for section in quiz.sections %}
                <tr>
                    <td>{{ section.title }}</td>
                    <td>
                        {% set questionCount = section.questions | length %}
                        {% if section.pool %}
                            {{ min(questionCount, section.pool) }}
                        {% else %}
                            {{ questionCount }}
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% if canAttempt %}
    <div class="row">
        <div class="small-12 column">
            <p>
                <a href="/assess/init/{{ quiz.id }}/{{ quiz.sections.first.id }}/{% if returnUrl %}?{{ RETURN_URL.name }}={{ returnUrl|escape('url') }}{% endif %}" class="button expand submit">Begin Quiz</a>
            </p>
        </div>
    </div>
{% endif %}

{# show authoritative feedback if it's there #}{#

{% if authoritativeFeedback %}
    {% include '@learningAssessment/dueWork/summary/mark.twig' with {
        feedback: authoritativeFeedback,
        participant: participant,
    } %}
{% else %}
    {% include '@learningAssessment/dueWork/summary/markingGuide.twig' with {
        rubricContext: emptyRubricContext,
        participant: participant,
    } %}
{% endif %}

#}
{# Submit button: goes underneath history if it's empty, above history if not #}{#

{% if timeline is not empty %}
    {% include '@learningAssessment/dueWork/summary/submitButton.twig' with {
        submissionsBlocked: submissionsBlocked,
        acknowlegementBlocked: acknowlegementBlocked,
        selfAcknowledgeRoute: selfAcknowledgeRoute,
        assessment: assessment,
        student: student
    } only%}
{% endif %}

{% include '@learningAssessment/dueWork/history.twig' %}

{% if timeline is empty %}
    {% include '@learningAssessment/dueWork/summary/submitButton.twig' with {
        submissionsBlocked: submissionsBlocked,
        acknowlegementBlocked: acknowlegementBlocked,
        selfAcknowledgeRoute: selfAcknowledgeRoute,
        assessment: assessment,
        student: student
    } only %}
{% endif %}
