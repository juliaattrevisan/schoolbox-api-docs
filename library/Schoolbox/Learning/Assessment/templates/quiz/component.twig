{% extends '@learningAssessment/component.twig' %}

{% set assessmentType = 'quiz' %}
{% set icon = 'icon-quiz' %}

{% block studentMessage %}
    There are no quizzes to complete at this time.
{% endblock studentMessage %}

{% block teacherMessage %}
    <a href="{{ createRouteType }}">Create a quiz</a>
    that is not a part of your course to test your students.
{% endblock teacherMessage %}

{% block createButton %}
    <a href="{{ createRouteType }}" class="button">Create Quiz</a>
{% endblock createButton %}
