{% import '@learningAssessment/fragments/macro/urgency.twig' as urgency %}
<section>
    <ul class="action-list">
        {% for assessable in assessables %}
            <li class="actions-small-4">
                <div class="list-item">
                    <div class="card small-12">
                        <h3>
                            {# TODO: Replace href with routeLookup #}
                            {% if assessable.dueDate.isFuture %}<a href="/assess/intro/{{ assessable.quiz.id }}">{% endif %}
                                {{ assessable.title }}
                            {% if assessable.dueDate.isFuture %}</a>{% endif %}
                        </h3>
                        <p class="meta">
                            <span class="gradient-{{ urgency.gradientIndex(assessment) }}">
                                Due {{ assessable.dueDate.relativeTime }} on {{ assessable.dueDate.dateOnly }}
                            </span>
                        </p>
                    </div>
                </div>
                <nav>
                    {# TODO: Replace hrefs with routeLookup #}
                    {% if isRouteAuthorized('learningAssessment.postDeleteAssessment') %}
                        <a class="icon-delete" href="/assess/delete/{{ assessable.quiz.id }}" data-action="delete" title="Delete Quiz"></a>
                    {% endif %}
                    {% if isRouteAuthorized('learningAssessment.postUpdateAssessment') %}
                        <a class="icon-modify" href="{{ routeLookup('learningAssessment.getUpdateAssessment', {assessmentId: assessable.id}) }}" title="Modify Quiz"></a>
                    {% endif %}
                    <a class="icon-poll" href="/assess/results/{{ assessable.quiz.id }}" title="View Results"></a>

                    {# TODO: Find way to work out if there are any attempts #}
                    {% if true %}
                        <a class="icon-list" href="/assess/attempts/{{ assessable.quiz.id }}/{{ user.id }}" title="See previous attempts"></a>
                    {% endif %}

                </nav>
                <article {% if compact %}class="hide"{% endif %}>
                    {{ assessable.quiz.description | purify }}
                </article>
            </li>
        {% endfor %}
    </ul>
    {% if isRouteAuthorized('learningAssessment.postCreateAssessment') %}
        <div class="content">
            <a href="{{ routeLookup('learningAssessment.getSelectAssessmentInFolder', {folderId: folder.id, assessmentTypeTitle: 'quiz'}) }}" class="button icon-add">Create Quiz</a>
        </div>
    {% endif %}
</section>
{% if isRouteAuthorized('learningAssessment.postDeleteAssessment') %}
    <script type="text/javascript">
        $('#component{{ component_id }}').on('click', 'a[data-action="delete"]', function(e) {
            e.preventDefault();
            $(this).confirmDialog({
                text: "Are you sure you want to delete this quiz?",
                confirmAction: $.confirmDialog.followHref
            });
        });
    </script>
{% endif %}
<script type="text/javascript">
    $('#component{{ component_id }}').on('click', 'a[data-action="delete"]', function(e) {
        e.preventDefault();
        $(this).confirmDialog({
            text: "Are you sure you want to delete this quiz?",
            confirmAction: $.confirmDialog.followHref
        });
    });
</script>