{% set createRoute -%}
    {{ routeLookupIfAuthorized('learningAssessment.getCreateAssessmentForm', {contextId: context.id, contextType: contextType, context: context }) -}}
{%- endset %}

{% if createRoute and assessmentType  %}
    {%- set createRouteType -%}
        {{ createRoute }}?type={{ assessmentType }}{% if returnUrl %}&amp;{{ RETURN_URL.name }}={{ returnUrl }}{% endif %}
    {%- endset -%}
{% endif %}

<div id="assessment-empty-state-{{ component_id }}" class="empty-state {% if assessables is not empty %}hide{% endif %}">
    <sbx-icon name="{{ icon|replace({'icon-': ''}) }}" size="2.5rem"></sbx-icon>
    {# if user does not have createRoute(create assessments) they should still be able to view their results for the assessment #}
    {% if readOnly ?? false or not createRoute %}
        <p>
            {% block studentMessage %}
                There are no assessments to complete at this time.
            {% endblock studentMessage %}
        </p>
        {% set route = routeLookupIfAuthorized(
            'learningGrades.getGrades', {
                viewee:    USER,
                userId:    USER.id,
                subject:   context,
                subjectId: context.id,
                term:      term,
                termCode:  termCode,
            }
        ) %}
        {% if route %}
            <p><a href="{{ route }}">View your {{ locale.grades.plural }}</a>.</p>
        {% endif %}

    {% elseif createRouteType is defined %}
        <p>
            {% block teacherMessage %}
                <a href="{{ createRouteType }}">Create assessment</a> that is not a part of your course for your students to complete.
            {% endblock teacherMessage %}
        </p>
    {% endif %}

</div>


{% if assessables is not empty %}
    <section id="assessment-section-{{ component_id }}" data-component-content>
        <ul id="assessment-list-{{ component_id }}" class="action-list" data-task-list>
            {% for assessable in assessables %}
                {% block listItem %}
                    {% include '@learningAssessment/componentListItem.twig' %}
                {% endblock %}
            {% endfor %}
        </ul>
        {% if createRoute and not readOnly and createRouteType is defined %}
            <div class="component-action">
                <section>
                    {% block createButton %}
                        <a href="{{ createRouteType }}" class="button">Create Assessment</a>
                    {% endblock createButton %}
                </section>
            </div>
        {% endif %}
    </section>
    <div class="toast" data-assessment-toast="{{ component_id }}" data-alert></div>
    <script type="text/javascript" src="{{ CDN_PREFIX }}/js/course/jquery.course-selector.js?v={{ config.site_version }}"></script>
    <script type="text/javascript" src="{{ CDN_PREFIX }}/js/assessment/jquery.assessment-component-tot.js?v={{ config.site_version }}"></script>
    <script type="text/javascript">
        $(function () {
            var $component = $('#component{{ component_id }}');
            $component.setupAssessmentComponentTot({
                emptySelector: '.empty-state',
                contentSelector: '[data-component-content]',
            });

            /* Attach Course Selector Modal listeners
            */
            $.fn.courseSelectorModal({
                courseSelector: {
                    query: {
                        folder:           Number('{{ context.id }}'),
                        hasAdd:           false,
                        hasTot:           false,
                        linkToUnits:      false,
                    }
                }
            });
        })
    </script>
{% endif %}

{% block scripts %}
    {# Any scripts that may be required #}
{% endblock %}
