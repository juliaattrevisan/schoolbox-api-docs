{% set createRoute -%}
    {{ routeLookupIfAuthorized('learningAssessment.getCreateAssessmentForm', {contextId: context.id, contextType: contextType, context: context }) -}}
{%- endset %}
{% if createRoute and assessmentType  %}
    {% set createRouteType = createRoute ~ '?type=' ~ assessmentType -%}
{% endif %}

<div id="assessment-empty-state-{{ component_id }}" class="empty-state {% if assessables is not empty %}hide{% endif %}">
    <i class="{{ icon }}"></i>

    {% if readOnly ?? false %}
        <p>
            {% block studentMessage %}
                There are no assessments to complete at this time.
            {% endblock studentMessage %}
        </p>
        {% set route = routeLookupIfAuthorized(
            'learningGrades.getGrades', {
                viewee:    USER,
                userId:    USER.id,
                subject:   context,
                subjectId: context.id,
                term:      term,
                termCode:  termCode,
            }
        ) %}
        {% if route %}
            <p><a href="{{ route }}">View your {{ locale.grades.plural }}</a>.</p>
        {% endif %}

    {% elseif createRouteType is defined %}
        <p>
            {% block teacherMessage %}
                <a href="{{ createRouteType }}">Create assessment</a> that is not a part of your course for your students to complete.
            {% endblock teacherMessage %}
        </p>
    {% endif %}

</div>


{% if assessables is not empty %}
    <section id="assessment-section-{{ component_id }}">
        <ul id="assessment-list-{{ component_id }}" class="action-list">
            {% for assessable in assessables %}
                {% block listItem %}
                    {% include '@learningAssessment/componentListItem.twig' %}
                {% endblock %}
            {% endfor %}
        </ul>
        {% if createRoute and not readOnly and createRouteType is defined %}
            <div class="component-action">
                <section>
                    {% block createButton %}
                        <a href="{{ createRouteType }}" class="button">Create Assessment</a>
                    {% endblock createButton %}
                </section>
            </div>
        {% endif %}
    </section>
    <div class="toast" data-assessment-toast="{{ component_id }}"></div>
    <script type="text/javascript">
        $(function () {
            $('#component{{ component_id }}').on('click', '[data-action="delete"]', function (event) {
                event.preventDefault();

                var assessmentList = $('#assessment-list-{{ component_id }}'),
                        assessmentId = $(this).data('id'),
                        assessmentListItem = $('#component-assessment-' + assessmentId),
                        assessmentName = assessmentListItem.data('assessment-title');

                $(this).confirmDialog({
                    header: 'Are you sure you want to delete ' + assessmentName + '?',
                    text:  '<span class=\"alert alert-box\"><b>WARNING</b> All student responses, feedback and marks will also be deleted.</span>',
                    format: 'html',
                    confirmLabel: 'Yes, permanently delete',
                    cancelLabel: 'No, keep it',
                    confirmEvent: function (anchor) {

                        var toast = $('div[data-assessment-toast={{ component_id }}]');
                        toast.toastActivate({text: 'Deleting ' + assessmentName + '...'});

                        $.post(anchor.attr('href'))
                                .done(function () {
                                    toast.toastTimeout({text: assessmentName + ' deleted.', css: 'success'});
                                    assessmentListItem.fadeOut({
                                        done: function() {
                                            assessmentListItem.remove();

                                            {# Respawn empty state if that was the last one #}
                                            if (assessmentList.find('li').length == 0) {
                                                $('#assessment-section-{{ component_id }}').remove();
                                                $('#assessment-empty-state-{{ component_id }}').removeClass('hide');
                                            }
                                        }
                                    });

                                })
                                .fail(function() {
                                    toast.toastTimeout({text: 'Could not delete ' + assessmentName + '.', css: 'alert'});
                                });
                    }
                });
            });
        })
    </script>
{% endif %}

{% block scripts %}
    {# Any scripts that may be required #}
{% endblock %}
