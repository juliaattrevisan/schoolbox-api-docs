{% import '@learning/macro/dueDate.twig' as dueDate %}

{% set viewRoute   = routeLookupIfAuthorized('learningAssessment.getAssessment', {assessmentId: assessable.id}) %}
{% if assessable is quiz %}
    {% set modifyRoute = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessable.id}) %}
{% else %}
    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessable.id, assessment: assessable}) %}
{% endif %}
{% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id, assessment: assessable}) %}

{% set actionCount = (modifyRoute ? 1 : 0) + (deleteRoute ? 1 : 0) + extraNavItemCount %}

<li id="component-assessment-{{ assessable.id }}" class="actions-small-{{ actionCount }}" data-assessment="{{ assessable.id }}" data-assessment-title="{{  assessable.title }}">
    <div class="list-item">
        <div class="card small-12">
            {% if viewRoute %}<a href="{{ viewRoute }}">{% endif %}
                <h3 data-assessment-title>{{ assessable.title }}</h3>
            {% if viewRoute %}</a>{% endif %}
            <p class="meta">{{ dueDate.dueDate(assessable, user) }}</p>
        </div>
    </div>
    {% if actionCount %}
        <nav>{% spaceless %}
                {% block extraNavItems %}{% endblock %}
                {% if modifyRoute %}
                    <a class="icon-modify" href="{{ modifyRoute }}" title="Modify"></a>
                {% endif %}
                {% if deleteRoute %}
                    <a class="icon-delete" href="{{ deleteRoute }}" data-action="delete" data-id="{{ assessable.id }}" title="Delete"></a>
                {% endif %}
            {% endspaceless %}</nav>
    {% endif %}
    {% if not compact %}
        <article>{{ assessable.description | purify }}</article>
    {% endif %}
</li>
