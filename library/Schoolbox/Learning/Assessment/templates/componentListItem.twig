{% import '@learning/macro/dueDate.twig' as dueDate %}

{% set viewRoute = routeLookupIfAuthorized('learningAssessment.getAssessment', {assessmentId: assessable.id, assessment: assessable}) %}
{% if assessable is quiz %}
    {% set modifyRoute = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessable.id, assessment: assessable}) %}
{% else %}
    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessable.id, assessment: assessable}) %}
{% endif %}
{% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id, assessment: assessable}) %}

<li id="component-assessment-{{ assessable.id }}" class="actions-small-1" data-assessment="{{ assessable.id }}" data-assessment-title="{{  assessable.title }}">
    <div class="list-item">
        <div class="card small-12">

            {# You can see an assessment, but not visit its summary page if you are a parent, with a child participating, but system is configured to hide due work details #}
            {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {
                assessmentId: assessable.id,
                assessment: assessable,
                studentId: USER.id,
                student: USER
            }) %}
            {# No route for own participation, what about children ?#}
            {% if not viewRoute and USER.role.parent %}
                {% for child in USER.children if not viewRoute %}
                    {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {
                        assessmentId: assessable.id,
                        assessment: assessable,
                        studentId: child.id,
                        student: child
                    }) %}
                {% endfor %}
            {% endif %}

            {% if viewRoute %}<a href="{{ viewRoute }}">{% endif %}
                <h3 data-assessment-title>{{ assessable.title }}</h3>
            {% if viewRoute %}</a>{% endif %}
            <p class="meta">{{ dueDate.dueDate(assessable, USER) }}</p>
        </div>
    </div>
    {% if (modifyRoute or deleteRoute) and not readOnly %}
        <nav><a href="#" class="icon-more" data-dropdown="duework-options{{ assessable.id }}" aria-expanded="false" title="Actions"></a></nav>
        <ul data-dropdown-content class="f-dropdown" id="duework-options{{ assessable.id }}">
            {% spaceless %}
                {% if modifyRoute %}
                <li><a class="icon-progress" href="{{ viewRoute }}">View Status</a></li>
                <li><a class="icon-modify" href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Modify</a></li>
                {% endif %}
                {% if deleteRoute %}
                    <li><a class="icon-delete" href="{{ deleteRoute }}" data-action="delete" data-id="{{ assessable.id }}">Delete</a></li>
                {% endif %}
            {% endspaceless %}
        </ul>
    {% else %}
        <nav>{% block extraNavItems %}{% endblock %}</nav>
    {% endif %}

    {% if not compact %}
        <article>{{ assessable.description | purify }}</article>
    {% endif %}
</li>
