{# componentListItem
 #
 # This is an activity-agnostic fragment that is often used in learning activities' Component (if it exists).
 #
 # @param IAssessable $assessable
 # @param bool readOnly
 #}
{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learning/macro/viewRoute.twig' as viewRoute %}

{# What action-tot routes are available to this user? #}
{% if readOnly %}
    {# If readonly mode: show no tot #}
    {% set hasAssessmentRoutes = false %}
    {% set hasCourseRoutes = false %}
{% else %}
    {# If write mode: show tot only if there's at least one action #}
    {% set statusRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set similarityReportRoute = routeLookupIfAuthorized('learningAssessment.getSimilarityReport', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set worksheetClassView = routeLookupIfAuthorized('learningAssessment.getWorksheet', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set hasAssessmentRoutes = statusRoute or modifyRoute or deleteRoute or similarityReportRoute %}

    {# Save to course: if spec assessment exists, this is a PUT: otherwise a POST #}
    {% set specAssessment = assessable.specificationAssessment ?? null %}
    {% set unit = assessable.baseContext %}

    {% if assessable.context is project %}
        {# apparently you're not allowed to do this if it's from a project, related to SA-21140
         # i've been told even though the routes still let you snap it if you wanted, just not via the component for now
         #}
        {% set saveToCourseRoute = null %}
    {% elseif unit is not unitSpecification and unit is not unitImplementation %}
        {% set saveToCourseRoute = null %}
    {% elseif specAssessment %}
        {% set saveToCourseRoute = routeLookupIfAuthorized(
            'courseExport.putAssessmentIntoUnit',
            {
                assessmentId: assessable.id,
                assessment: assessable,
                unitSpecId: unit.specification.id,
                unitSpec: unit.specification,
            }
        ) %}
        {% set saveToCourseMethod = 'PUT' %}
    {% else %}
        {% set saveToCourseRoute = routeLookupIfAuthorized(
            'courseExport.postAssessmentIntoUnit',
            {
                assessmentId: assessable.id,
                assessment: assessable,
                unitSpecId: unit.specification.id,
                unitSpec: unit.specification,
            }
        ) %}
        {% set saveToCourseMethod = 'POST' %}
    {% endif %}
    {% set hasCourseRoutes = saveToCourseRoute is not empty %}
{% endif %}

{% set isActionRoutes = hasAssessmentRoutes or hasCourseRoutes %}

<li
    id="component-assessment-{{ assessable.id }}"
    class="{% block actionsClass %}{% if isActionRoutes %}actions-small-1{% endif %}{% endblock %}"
    data-assessment="{{ assessable.id }}"
    data-assessment-title="{{ assessable.title }}"
    data-test="component-assessment-{{ assessable.id }}"
>
    <div class="list-item">
        <div class="card small-12">
            {% set route = viewRoute.viewRoute(assessable, USER) %}
            {% if route %}<a href="{{ route }}">{% endif %}
                <h3 data-test="component-assessment-title-{{ assessable.id }}">{{ assessable.title }}</h3>
            {% if route %}</a>{% endif %}
            <p class="meta">{{ dueDate.dueDate(assessable, USER) }}</p>
        </div>
    </div>
    <nav>
        {# TODO known bug SA-5984. Participant progress icon renders incorrectly if part of multiple actions. #}
        {% block extraNavItems %}{% endblock %}
        {% if isActionRoutes %}
            <sbx-pop-out content-id="component-assessment-actions-{{ assessable.id }}" data-test="sbx-pop-out-component-assessment-actions-{{ assessable.id }}"></sbx-pop-out>
        {% endif %}
    </nav>
    {% if isActionRoutes %}
        <ul data-dropdown-content class="f-dropdown" id="component-assessment-actions-{{ assessable.id }}">
            {% apply spaceless %}
            {% if hasAssessmentRoutes %}
                <li class="separator">{{ locale.translate('activity', false, true) }}</li>
                {% if statusRoute %}<li><a href="{{ statusRoute }}" data-test="component-assessment-actions-viewStatus-{{ assessable.id }}" class="sbx-button--has-icon"><sbx-icon name="progress"></sbx-icon>View Status</a></li>{% endif %}
                {% if assessable is dueWork %}
                    {% set viewGradeRoute = routeLookupIfAuthorized('learningDueWorkResponse.getFirstParticipantResponse', {
                        assessmentId: assessable.id,
                        assessment: assessable,
                    }) %}
                    {% if viewGradeRoute %}
                        <li><a href="{{ viewGradeRoute }}" class="sbx-button--has-icon"><sbx-icon name="task"></sbx-icon>View and {{ locale.grades }} submissions</a></li>
                    {% endif %}
                {% endif %}

                {# Reporting Activity's inline grader link #}
                {% if assessable is reporting %}
                    {% set viewGradeRoute = routeLookupIfAuthorized('learningReportingFeedback.getFirstParticipantFeedback', {
                        assessmentId: assessable.id,
                        assessment: assessable,
                    }) %}
                    {% if viewGradeRoute %}
                        <li><a class="icon-task" data-test="course-outline-view-grade-submissions-{{ assessment.id }}" href="{{ viewGradeRoute }}">Provide feedback</a></li>
                    {% endif %}
                {% endif %}

                {% if assessable is dialogAgent %}
                    {% set viewResponseRoute = routeLookupIfAuthorized('learningDialogAgent.getFirstParticipantResponse', {
                        assessmentId: assessable.id,
                        assessment: assessable,
                    }) %}
                    {% if viewResponseRoute %}
                        <li><a href="{{ viewResponseRoute }}" class="sbx-button--has-icon"><sbx-icon name="task"></sbx-icon>View Responses</a></li>
                    {% endif %}
                {% endif %}
                {% set viewCustomParticipationRoute = routeLookupIfAuthorized('learningAssessment.getAssessmentParticipationForm', {
                    assessmentId: assessable.id,
                    assessment: assessable
                }) %}
                {% if viewCustomParticipationRoute %}
                    <li><a href="{{ viewCustomParticipationRoute }}" class="sbx-button--has-icon"><sbx-icon name="group"></sbx-icon>Student Participation</a></li>
                {% endif %}
                {% if assessable is dueWork and assessable.enableWorksheet and assessable.kamiWorksheetTemplate and worksheetClassView %}
                    <li>
                        <a id="kamiWorksheet" href="{{ worksheetClassView }}" class="sbx-button--has-icon"><sbx-icon name="surveys"></sbx-icon>Class View</a>
                    </li>
                {% endif %}
                {% if similarityReportRoute %}<li><a href="{{ similarityReportRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}" class="sbx-button--has-icon"><sbx-icon name="due-work"></sbx-icon>Similarity Report</a></li>{% endif %}

                {% if modifyRoute %}
                    {# configForm.php will use itself as RETURN_URL.current since it parses twig as part of
                     # its component building process. The current url is a form processor in this circumstance
                     # and is functionally invalid for what we intended to do here: use the controllers' returnUrl
                     # param if specified, otherwise fall back to this global const's .current value
                     #}
                    {% set preferredReturnUrl = returnUrl ?? RETURN_URL.current %}

                    {% if assessable is quiz %}
                        <li><a href="{{ routeLookup('learnosity.getHorizontalMarking', {assessment: assessable, assessmentId: assessable.id}) }}" class="sbx-button--has-icon"><sbx-icon name="class-list"></sbx-icon>Review horizontally</a></li>
                    {% endif %}

                    {% include '@learningAssessment/fragments/modifyLinks.twig' with {
                        assessment: assessable,
                        returnUrlName: RETURN_URL.name,
                        returnUrl: preferredReturnUrl,
                        modifyRoute: modifyRoute,
                    } only %}
                {% endif %}

                {% if deleteRoute %}<li><a href="{{ deleteRoute }}" data-action="delete" data-id="{{ assessable.id }}" data-test="component-assessment-actions-delete-{{ assessable.id }}" class="sbx-button--has-icon"><sbx-icon name="delete"></sbx-icon>Delete</a></li>{% endif %}
            {% endif %}
            {% if hasCourseRoutes %}
                <li class="separator">Course</li>
                {% if saveToCourseRoute %}
                    <li>
                        <a href="{{ saveToCourseRoute }}"
                        data-reveal-id="component{{ component_id }}-save-to-course-modal-{{ assessable.id }}"
                        data-method="{{ saveToCourseMethod }}"
                        data-spec-assessment-id="{{ specAssessment.id ?? null }}"
                        data-spec-assessment-title="{{ specAssessment.title ?? null }}"
                        class="sbx-button--has-icon"
                        ><sbx-icon name="export"></sbx-icon>Save to Course...</a>
                        {% include '@learningAssessment/outline/saveToCourseModal.twig' with {
                            assessment: assessable,
                            specAssessment: specAssessment ?? null,
                            saveToCourseRoute: saveToCourseRoute,
                            saveToCourseMethod: saveToCourseMethod,
                            componentInstanceId: component_id,
                        } only %}
                    </li>
                {% endif %}
            {% endif %}
            {% endapply %}
        </ul>
    {% endif %}

    {% if not compact %}
        <article>{{ assessable.description | purify }}</article>
    {% endif %}
</li>
