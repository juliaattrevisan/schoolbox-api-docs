{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learning/macro/viewRoute.twig' as viewRoute %}

{# What action-tot routes are available to this user? #}
{% if readOnly %}
    {# If readonly mode: show no tot #}
    {% set isActionRoutes = false %}
{% else %}
    {# If write mode: show tot only if there's at least one action #}
    {% set statusRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessable.id, assessment: assessable}) %}
    {% if assessable is quiz %}
        {% set modifyRoute = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessable.id, assessment: assessable}) %}
    {% else %}
        {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessable.id, assessment: assessable}) %}
    {% endif %}
    {% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set isActionRoutes = statusRoute or modifyRoute or deleteRoute %}
{% endif %}

<li
    id="component-assessment-{{ assessable.id }}"
    class="{% block actionsClass %}{% if isActionRoutes %}actions-small-1{% endif %}{% endblock %}"
    data-assessment="{{ assessable.id }}"
    data-assessment-title="{{  assessable.title }}"
>
    <div class="list-item">
        <div class="card small-12">
            {% set route = viewRoute.viewRoute(assessable, USER) %}
            {% if route %}<a href="{{ route }}">{% endif %}
                <h3 data-assessment-title>{{ assessable.title }}</h3>
            {% if route %}</a>{% endif %}
            <p class="meta">{{ dueDate.dueDate(assessable, USER) }}</p>
        </div>
    </div>
    <nav>
        {# TODO known bug SA-5984. Participant progress icon renders incorrectly if part of multiple actions. #}
        {% block extraNavItems %}{% endblock %}
        {% if isActionRoutes %}
            <a href="#" class="icon-more" data-dropdown="duework-options{{ assessable.id }}" aria-expanded="false" title="Actions"></a>
        {% endif %}
    </nav>
    {% if isActionRoutes %}
        <ul data-dropdown-content class="f-dropdown" id="duework-options{{ assessable.id }}">
            {% apply spaceless %}
                {% if statusRoute %}<li><a class="icon-progress" href="{{ statusRoute }}">View Status</a></li>{% endif %}
                {% if modifyRoute %}<li><a class="icon-modify" href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Modify</a></li>{% endif %}
                {% if deleteRoute %}<li><a class="icon-delete" href="{{ deleteRoute }}" data-action="delete" data-id="{{ assessable.id }}">Delete</a></li>{% endif %}
            {% endapply %}
        </ul>
    {% endif %}

    {% if not compact %}
        <article>{{ assessable.description | purify }}</article>
    {% endif %}
</li>
