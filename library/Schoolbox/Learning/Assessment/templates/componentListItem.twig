{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learning/macro/viewRoute.twig' as viewRoute %}

{# What action-tot routes are available to this user? #}
{% if readOnly %}
    {# If readonly mode: show no tot #}
    {% set isActionRoutes = false %}
{% else %}
    {# If write mode: show tot only if there's at least one action #}
    {% set statusRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set similarityReportRoute = routeLookupIfAuthorized('learningAssessment.getSimilarityReport', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set worksheetClassView = routeLookupIfAuthorized('learningAssessment.getWorksheet', {assessmentId: assessable.id, assessment: assessable}) %}
    {% set isActionRoutes = statusRoute or modifyRoute or deleteRoute or similarityReportRoute %}
{% endif %}

<li
    id="component-assessment-{{ assessable.id }}"
    class="{% block actionsClass %}{% if isActionRoutes %}actions-small-1{% endif %}{% endblock %}"
    data-assessment="{{ assessable.id }}"
    data-assessment-title="{{  assessable.title }}"
>
    <div class="list-item">
        <div class="card small-12">
            {% set route = viewRoute.viewRoute(assessable, USER) %}
            {% if route %}<a href="{{ route }}">{% endif %}
                <h3 data-assessment-title data-test="component-assessment-title-{{ assessable.id }}">{{ assessable.title }}</h3>
            {% if route %}</a>{% endif %}
            <p class="meta">{{ dueDate.dueDate(assessable, USER) }}</p>
        </div>
    </div>
    <nav>
        {# TODO known bug SA-5984. Participant progress icon renders incorrectly if part of multiple actions. #}
        {% block extraNavItems %}{% endblock %}
        {% if isActionRoutes %}
            <sbx-pop-out content-id="duework-options{{ assessable.id }}" data-test="sbx-pop-out-duework-options{{ assessable.id }}"></sbx-pop-out>
        {% endif %}
    </nav>
    {% if isActionRoutes %}

        <ul data-dropdown-content class="f-dropdown" id="duework-options{{ assessable.id }}">
            {% apply spaceless %}
                {% if statusRoute %}<li><a class="icon-progress" href="{{ statusRoute }}" data-test="component-assessment-actions-viewStatus-{{ assessable.id }}">View Status</a></li>{% endif %}
                {% if assessable is dueWork %}
                    {% set viewGradeRoute = routeLookupIfAuthorized('learningDueWorkResponse.getFirstParticipantResponse', {
                        assessmentId: assessable.id,
                        assessment: assessable,
                    }) %}
                    {% if viewGradeRoute %}
                        <li><a class="icon-task" href="{{ viewGradeRoute }}" >View and {{ locale.grades }} submissions</a></li>
                    {% endif %}
                {% endif %}
                {% set viewCustomParticipationRoute = routeLookupIfAuthorized('learningAssessment.getAssessmentParticipationForm', {
                    assessmentId: assessable.id,
                    assessment: assessable
                }) %}
                {% if viewCustomParticipationRoute %}
                    <li><a class="icon-group" href="{{ viewCustomParticipationRoute }}">Student Participation</a></li>
                {% endif %}
                {% if assessable is dueWork and assessable.enableWorksheet and assessable.kamiWorksheetTemplate and worksheetClassView %}
                    <li>
                        <a id="kamiWorksheet" class="icon-surveys" href="{{ worksheetClassView }}">Class View</a>
                    </li>
                {% endif %}
                {% if similarityReportRoute %}<li><a class="icon-due-work" href="{{ similarityReportRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Similarity Report</a></li>{% endif %}

                {# Learnosity Quiz has two parts: Modify Quiz and Modify Contents #}
                {% if modifyRoute %}
                    {# configForm.php will use itself as RETURN_URL.current since it parses twig as part of
                     # its component building process. The current url is a form processor in this circumstance
                     # and is functionally invalid for what we intended to do here: use the controllers' returnUrl
                     # param if specified, otherwise fall back to this global const's .current value
                     #}
                    {% set preferredReturnUrl = returnUrl ?? RETURN_URL.current %}

                    {% if assessable is quiz %}
                        {% set modifyContentsRoute = routeLookupIfAuthorized('learnosity.getContent', {assessment: assessable, assessmentId: assessable.id}) %}
                        <li><a class="icon-class-list" href="{{ routeLookup('learnosity.getHorizontalMarking', {assessment: assessable, assessmentId: assessable.id}) }}">Review horizontally</a></li>
                        <li><a class="icon-modify" href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ preferredReturnUrl }}">Modify Settings</a></li>
                        <li><a class="icon-modify" href="{{ modifyContentsRoute }}?{{ RETURN_URL.name }}={{ preferredReturnUrl }}">Modify Contents</a></li>
                    {% else %}
                        <li><a class="icon-modify" href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ preferredReturnUrl }}">Modify</a></li>
                    {% endif %}
                {% endif %}

                {% if deleteRoute %}<li><a class="icon-delete" href="{{ deleteRoute }}" data-action="delete" data-id="{{ assessable.id }}" data-test="component-assessment-actions-delete-{{ assessable.id }}">Delete</a></li>{% endif %}
            {% endapply %}
        </ul>
    {% endif %}

    {% if not compact %}
        <article>{{ assessable.description | purify }}</article>
    {% endif %}
</li>
