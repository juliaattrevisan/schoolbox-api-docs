{##
 # @param IAssessable                   assessment          an IAssesssable instance
 # @param bool                          submissionsBlocked  whether you can submit to this assessment, I guess
 # @param User                          student             the student currently being viewed
 # @param string                        icon                a css class representing the assessable
 # @param bool                          canShowcase         a boolean for students' ability to Showcase to their eportfolio
 # @param bool                          isShowcased         whether this assessment is already showcased on a user's eportfolio
 # @param null|Participant\Model        participant         an instance if the student is excluded from the assessment or deleted
 #}
{% import '@learning/macro/dueDate.twig' as dueDate %}
<ul class="meta">
    {% if isShowcased %}
    <li class="icon-eportfolio">Published to ePortfolio</li>
    {% endif %}
    {% include '@learning/fragments/meta/dueDate.twig' %}
    {% include '@learning/fragments/meta/workType.twig' %}
    {% if student.id != USER.id %}
        <li class="icon-staff-students"><a href="/search/user/{{ student.id }}">{{ student.fullname }}</a></li>
    {% endif %}
    {% if submissionsBlocked %}
    <li class="icon-upload">{{ submissionsBlocked }}</li>
    {% endif %}
    {% if assessment.getAllParticipants()[student.id].getExcludedAt().isNull() is defined and assessment.getAllParticipants()[student.id].getExcludedAt().isNull() is same as(false) %}
        {#
         # now using the same code as the assessment update page:
         # library/Schoolbox/Learning/Assessment/templates/fragments/participation.twig:105
         #
         # needed isNull is same as(false) to test if getExcludedAt() has valid data.
         # I was not able to just test as getExcluedAt() is null, or find a better way
        #}
        <li class="icon-close">Excluded from {{ locale.assessment }}</li>
    {% endif %}
    {% if lastViews is not empty %}
    <li class="icon-staff-students" title="{% if lastViews.student.date is not null %}{{ lastViews.student.date }}{% endif %}">
        {{ lastViews.student.name }} {{ lastViews.student.status }}
        {% if 'assessment' is same as(lastViews.student.object) %} this {{ locale.assessment }}{% else %} the feedback {% endif %}
    </li>
    {% for parent in lastViews.parents %}
    <li class="icon-staff">
            <span title="{{ parent.date }}">{{ parent.name }}</span>
        {{ parent.status }} {% if 'assessment' is same as(parent.object) %} this {{ locale.assessment }}{% else %} the feedback {% endif %}
    </li>
    {% endfor %}
    {% endif %}

</ul>
