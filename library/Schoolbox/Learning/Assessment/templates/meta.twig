{##
 # assessment   an IAssesssable instance
 # user         the currently-logged-in user
 # student      the student currently being viewed
 # icon         a css class representing the assessable
 #}
{% import '@learning/macro/dueDate.twig' as dueDate %}
<ul class="meta">
    <li class="icon-calendar">{{ dueDate.assessment(assessment) }}</li>
    <li class="{{ icon }}">{{ assessment.typeName }}</li>
    {% if student.id != user.id %}
    <li class="icon-staff-students">{{ student.fullname }}</li>
    {% endif %}
    {% if submissionsBlocked %}
    <li class="icon-upload">{{ submissionsBlocked }}</li>
    {% endif %}
</ul>
