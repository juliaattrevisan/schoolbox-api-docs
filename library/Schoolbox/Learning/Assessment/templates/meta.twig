{##
 # @param IAssessable                   assessment          an IAssesssable instance
 # @param bool                          submissionsBlocked  whether you can submit to this assessment, I guess
 # @param User                          student             the student currently being viewed
 # @param string                        icon                a css class representing the assessable
 # @param bool                          canShowcase         a boolean for students' ability to Showcase to their eportfolio
 # @param bool                          isShowcased         whether this assessment is already showcased on a user's eportfolio
 # @param null|Participant\Model        participant         an instance if the student is excluded from the assessment or deleted
 #}
{% import '@learning/macro/dueDate.twig' as dueDate %}
<ul class="meta">
    {% if isShowcased %}
    <li class="icon-eportfolio">Published to ePortfolio</li>
    {% endif %}
    {% include '@learning/fragments/meta/dueDate.twig' %}
    {% include '@learning/fragments/meta/workType.twig' %}
    {% if student.id != USER.id %}
        <li class="icon-staff-students"><a href="/search/user/{{ student.id }}">{{ student.fullname }}</a></li>
    {% endif %}
    {% if submissionsBlocked %}
    <li class="icon-upload">{{ submissionsBlocked }}</li>
    {% endif %}
    {% if participant is null and student.id != USER.id and assessment.getParticipantUsers() is not empty %}
        {# logic:
        if participant is null, the user is not in the list of participant users
        confirm the user accessing the page is not the 'submitting user'
        confirm the list of participant users is not empty.
            this list will be empty when a normal (not class / group) has a due work on it (there will be no students contained within the page)

        if all these are correct, the submitting user is not part of the filled list of users listed in the class / group who have been requested to complete this assessment.
            which means they are excluded.
        #}
        <li class="icon-close">Excluded from {{ locale.assessment }}</li>
    {% endif %}
</ul>
