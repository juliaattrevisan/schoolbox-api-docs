{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Learning',    routeLookup('sportsfixtures.getLanding') ],
    [ 'Classname',   routeLookup('sportsfixturesSport.getList') ],
    [ 'Create Assessment',   routeLookup('sportsfixturesSport.getList') ]
) }}

<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript" charset="utf-8" src="/javascript/components/jquery-timepicker-jt/jquery.timepicker.min.js"></script>
<script type="text/javascript">
    $(function () {
        /* Description
         */
        $.fn.alaressEditor();

        /* Datepickers
         */
        $('[data-datepicker]').datepicker();
        $('[data-timepicker]').timepicker({
            appendTo: function ($input) {
                return $input.closest('.timepick');
            }
        });
    });
</script>

<script type="text/javascript" src="/javascript/shared/jquery.collapsable.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.mage.js"></script>
<script type="text/javascript">
    $(function () {
        // the mage plugin is applied to the submit buttons: setup a basic mage on all the buttons
        $('input[data-mage-next]').mage();

        // overload with specific callbacks (or other config values)
        $('input[data-mage-next="part-2"]').mage({
            onXhrDone: function (data) {

                /* Switch between the Assessable types that you might
                 * have selected from part-1
                 */
                var selected = $('#assessmentForm').find('input[name=assessmentType]:checked').val();

                switch(selected) {
                    case 'project':
                    case 'dueWork':
                    case 'quiz':
                    case 'task':
                        var next = $('[data-mage="part-2-'+selected+'"]');
                        next.removeAttr('disabled').removeClass('hide');
                        next.find('[data-mage-collapsed]').hide().removeClass('hide').slideDown(600);
                        break;

                    default:
                        break;
                }
            }
        });
    });
</script>

<div class="row">
    <div class="small-12 columns"><h1>Create Assessment</h1></div>
</div>

<div class="row">
    <div class="small-12 columns island">
        <form action="#" id="assessmentForm">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Title
                            <input type="text" value="{{ assessment.title }}" required />
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>Description
                            <textarea name="description">{{ assessment.description }}</textarea>
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>Weight
                            <input type="number" name="weight" value="{{ assessment.weight }}">
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>Visibility
                            <select>
                                <option>&#xe66b;&nbsp;&nbsp;&nbsp;Staff Only</option>
                                <option>&#xe667;&nbsp;&nbsp;&nbsp;Staff and Students</option>
                                <option>&#xe666;&nbsp;&nbsp;&nbsp;Staff, Students and their Parents</option>
                            </select>
                        </label>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <legend>Dates</legend>

                    <div class="column small-12 medium-6">
                        <label>
                            Publish Date
                            <input type="text" data-datepicker value="{{ assessment.publishAt.localShort }}" />
                        </label>
                    </div>

                    <div class="column small-12 medium-6">
                        <div class="timepick">
                            <label>
                                Publish Time
                                <input type="text" data-timepicker value="{{ assessment.publishAt.timeOnly }}" />
                            </label>
                        </div>
                    </div>

                    <div class="column small-12 medium-6">
                        <label>
                            Commencement Date
                            <input data-datepicker type="text" autocomplete="off" value="{{ assessment.openAt.localShort }}" />
                        </label>
                    </div>

                    <div class="column small-12 medium-6">
                        <div class="timepick">
                            <label>
                                Commencement Time
                                <input data-timepicker type="text" autocomplete="off" value="{{ assessment.openAt.timeOnly }}" />
                            </label>
                        </div>
                    </div>

                    <div class="column small-12 medium-6">
                        <label>
                            Due Date
                            <input data-datepicker type="text" autocomplete="off" value="{{ assessment.dueAt.localShort }}" />
                        </label>
                    </div>

                    <div class="column small-12 medium-6">
                        <div class="timepick">
                            <label>
                                Due Time
                                <input data-timepicker type="text" autocomplete="off" value="{{ assessment.dueAt.timeOnly }}" />
                            </label>
                        </div>
                    </div>

                    <div class="column small-12 medium-6">
                        <label>
                            Close Date
                            <input data-datepicker type="text" autocomplete="off" value="{{ assessment.closeAt.localShort }}" />
                        </label>
                    </div>

                    <div class="column small-12 medium-6">
                        <div class="timepick">
                            <label>
                                Close Time
                                <input data-timepicker type="text" autocomplete="off" value="{{ assessment.closeAt.timeOnly }}" />
                            </label>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="column small-12">
                        <label>Curriculum Codes</label>
                        <input id='user' name="userId" type='text' value='' data-selectizeuser required />
                    </div>
                </fieldset>
                <fieldset class="content">
                    <legend>Type</legend>

                    <fieldset class="radiolist" data-assessment-type>
                        <div class="column small-12">
                            <input type="radio" name="assessmentType" value="project" id="project"><label for="project" class="radio-label">Project</label>
                            <input type="radio" name="assessmentType" value="dueWork" id="due-work"><label for="due-work" class="radio-label">Due Work</label>
                            <input type="radio" name="assessmentType" value="quiz" id="quiz"><label for="quiz" class="radio-label">Quiz</label>
                            <input type="radio" name="assessmentType" value="task" id="task"><label for="task" class="radio-label">Task</label>
                        </div>
                    </fieldset>

                    <div class="column small-12">
                        <div class="row" data-mage-submitrow>
                            <div class="small-12 medium-8 column">
                                <p class="alert alert-box icon-alert" data-mage-error></p>
                            </div>
                            <div class="small-12 medium-4 column">
                                <input type="submit" name="part-1" value="Next" data-mage-next="part-2" data-mage-working="Working..." />
                            </div>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="content">
