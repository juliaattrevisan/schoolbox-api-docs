{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

{{ bread.crumbsArray(breadcrumbs) }}

<script src="{{ CDN_PREFIX }}/js/bundle/mage.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/assessment/validationRules.js?v={{ config.site_version }}" data-locale-grading-proper="{{ locale.grading.proper }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/jquery-validation/dist/additional-methods.min.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script>
    $(function () {
        // the mage plugin is applied to the submit buttons: setup a basic mage on all the buttons
        $('input[data-mage-next]').mage({
            validateOptions: validateOptions
        });

        /**
         * Check if the participation prompt should be shown based on hidden input field values
         * We only want to show the prompt when the assessment(activity) is within a class, and is not a customised assessment
         * @returns {boolean}
         */
        function showParticipationPrompt() {
            // Check if assessmentType is either 'dueWork' or 'task'
            const assessmentTypeInput = document.querySelector("input[name='assessmentType']");
            const assessmentType = assessmentTypeInput ? assessmentTypeInput.value : null;
            const validAssessmentTypes = ["dueWork", "task"];
            const isValidAssessmentType = assessmentType && validAssessmentTypes.includes(assessmentType);

            // Check if contextType is either 'units' or 'projects' - will be 'unitspecs' when assessment is under a unit and not a class
            const contextTypeInput = document.querySelector("input[name='contextType']");
            const contextType = contextTypeInput ? contextTypeInput.value : null;
            const validContextTypes = ["units", "projects"];
            const isValidContextType = contextType && validContextTypes.includes(contextType);

            // Check if baseContextType is 'units' - to avoid showing the prompt in a project under a unit
            const baseContextTypeInput = document.querySelector("input[name='baseContextType']");
            const baseContextType = baseContextTypeInput ? baseContextTypeInput.value : null;
            const validBaseContextTypes = ["units"];
            const isValidBaseContextType = baseContextType && validBaseContextTypes.includes(baseContextType);

            // Check that customisedFor hidden input field doesn't exist - which would indicate a customised assessment
            const customisedForInput = document.querySelector("input[name='customisedFor']");
            const isNotCustomised = !customisedForInput;

            return isValidAssessmentType && isValidContextType && isValidBaseContextType && isNotCustomised;
        }

        /**
         * Before submitting the form, intercept the submission
         * and show a confirmation dialog to check if the user wants to edit participation.
         * If not just continue with the submission
         * If so add a hidden field to the formData to that will be used in the backend
         * to redirect to the student participation page.
         * @returns {Promise}
         */
        function formWillSubmit() {
            return new Promise(function(resolve, reject) {
                if (showParticipationPrompt()) {
                    $("body").confirmDialog({
                        header: "{{ locale.activity.proper }} created",
                        text: "Would you like to edit the student participation for this {{ locale.activity }}?",
                        flipButtons: true,
                        cancelLabel: "Later",
                        cancelEvent: () => {
                            resolve();
                        },
                        confirmLabel: "Yes",
                        confirmEvent: () => {
                            // add a new hidden field to the formData to indicate that the user wants to edit participation
                            const targetFieldSet = document.querySelector('[data-mage="part-2"]');
                            if (targetFieldSet) {
                                const hiddenInput = document.createElement("input");
                                hiddenInput.type = "hidden";
                                hiddenInput.name = "toParticipation";
                                hiddenInput.value = "true";
                                targetFieldSet.appendChild(hiddenInput);
                            }
                            resolve();
                        },
                    });
                } else {
                    resolve();
                }
            });
        }

        /**
         * When you finish configuring a non-project assessment
         */
        function setupAssessmentEnd(assessmentType) {

            $('input[data-mage-next="end"]').mage({
                validateOptions: validateOptions,
                beforeAttemptingSubmit: beforeAttemptingSubmit,
                formWillSubmit: formWillSubmit,
                onXhrDone: function (data) {
                    if('string' == typeof data.returnUrl){
                        window.location.href = data.returnUrl;
                    }
                }
            });
        }

        {% if assessmentType is defined %}

            /* Save everything when Part 1 was already chosen in route
             */
            setupAssessmentEnd('{{ assessmentType }}');

        {% else %}

             /**
             * Update new form action url
             *
             * Inject common details
             * Inject assessmentType-specific details
             */
            $('input[data-mage-next="part-2"]').mage({
                onXhrDone: function(data) {
                    $('#part2loader').hide();

                    $('#assessmentForm')
                        .attr('action', '{{ routeLookup('learningAssessment.postCreateAssessment', { contextType: contextType, contextId: context.id, context: context }) }}')
                        .find('[data-assessment-details]')
                        .html(data);

                    // attach DP
                    $('[data-datepicker]').each(attachAlaressDatePicker);

                    /* Save everything when creating with Part 1
                     */
                    var assessmentType = $('input[name="type"]:checked').val();
                    setupAssessmentEnd(assessmentType);

                    // Re-init foundation plugins
                    $(document).foundation();
                }
            });

            /**
             * Once they have clicked an activity type - trigger a click on the part-2 hidden input
             * to send the user straight to the next section
             */
            $('input[name=type]').click(function() {
                $('#part2loader').show();

                $('[data-mage-next=part-2]').trigger('click');
            });

        {% endif %}

    });
 </script>


<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Create
                {% if assessment.defaultTypeName is defined %}
                    {{ assessment.defaultTypeName }}
                {% else %}
                    Activity
                {% endif %}
            </h1>
         </div>
     </div>
</div>

{% if (customisedFor ?? '') | length and participants ?? [] is not empty %}
    <div class="row">
        <div class="small-12 column">
            <ul class="meta">
                <li>
                    {% include 'sub/userListMetadata.twig'
                        with {
                        users:    participants,
                        message: 'Customisation for '
                    } only
                    %}
                </li>
            </ul>
        </div>
    </div>
{% endif %}


{% set importRoute = routeLookupIfAuthorized('learningQuiz.postImport', {
    contextId: context.id,
    contextType: contextType
}) %}
{# Can only import on creation, not modify #}
{% set canImport = importRoute is not null and (assessment is not defined or assessment.id is null) %}
{% if canImport %}
    <div id="importModal" class="reveal-modal" data-reveal>
        <h2>Import a quiz</h2>

        <p>Select a file that has been exported to create a duplicate version of the quiz.</p>

        <div id="import-loader" style="display:none">
            <div class="loader"></div>
            <p class="text-center">Importing quiz...</p>
        </div>

        <form id='importForm' method="post" action="{{ importRoute }}" enctype="multipart/form-data">
            <input type="hidden" name="contextId" value="{{ context.id }}" />
            <input type="hidden" name="contextType" value="{{ contextType }}" />
            {% if (returnUrl ?? '') | length %}
                <input type="hidden" name="returnUrl" value="{{ returnUrl }}" />
            {% endif %}

            <section>
                <fieldset class="no-pad">
                    <div class="small-12 columns no-pad">
                        <div data-vue-app="file-drop">
                            <file-drop
                                id="quiz-attachment"
                                accept="text/xml, application/xml, application/json"
                                input-name="attachment"
                                required
                            />
                        </div>
                        <script src="{{ CDN_PREFIX }}/js/bundle/fileDrop.js?v={{ config.site_version }}"></script>
                    </div>
                </fieldset>
            </section>
            <div class="component-action">
                <section>
                    <button class="button" type="submit">Upload</button>
                </section>
            </div>
        </form>
        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>
    <script>
        $(function() {
            const importForm = document.querySelector("#importForm");
            const importLoader = document.querySelector("#import-loader");

            // show the loader on successful submission (valid file)
            importForm.addEventListener("submit", function(event) {
                importForm.style.display = "none";
                importLoader.style.display = "block";
            });
        });
    </script>
{% endif %}

{% if assessmentType is defined and assessmentType|length %}
    {% set formAction = routeLookup('learningAssessment.postCreateAssessment', { contextType: contextType, contextId: context.id, context: context }) %}
{% else %}
    {% set formAction = routeLookup('learningAssessment.getCreateAssessmentForm', { contextType: contextType, contextId: context.id, context: context }) %}
{% endif %}

<div class="row">
    <div class="small-12 columns island">
        <form action="{{ formAction }}" class="mage" id="assessmentForm" data-test="assessment-form" method="post">
            <section>
                {% if assessmentType is not defined %}
                <fieldset class="content" data-mage="part-1">
                    {% if (returnUrl ?? '') | length %}
                        <input type="hidden" name="returnUrl" value="{{ returnUrl }}" />
                    {% endif %}

                    <legend>Choose activity type</legend>

                    <fieldset data-has-error-placeholder>
                        {% for type in types %}
                        <div class="column small-12 medium-6{%  if loop.last %} end{% endif %}">
                            <input type="radio" name="type" value="{{ type.value }}" id="{{ type.id }}" />
                            <label title="{{ type.title }}" for="{{ type.id }}" class="block"><i class="icon-{{ type.icon }}"></i>{{ type.label }}</label>
                        </div>
                        {% endfor %}
                        <div class="column small-12 medium-12 error-placeholder"></div>
                    </fieldset>

                    <input type="hidden" name="part-1" data-mage-next="part-2" formmethod="GET">
                    {% if (customisedFor ?? '') | length %}
                        <input type="hidden" name="student" value="{{ participants | json_encode }}" />
                        <input type="hidden" name="customisedFor" value="{{ customisedFor }}" />
                    {% endif %}

                </fieldset>
                {% endif %}

                <fieldset class="content" data-mage="part-2" {% if assessmentType is not defined %}disabled="disabled"{% endif %}>
                    <div id="part2loader" class="loader" style="display:none"></div>

                    {% if (returnUrl ?? '') | length %}
                        <input type="hidden" name="returnUrl" value="{{ returnUrl }}" />
                    {% endif %}
                    <input type="hidden" name="contextType" value="{{ contextType }}" />
                    {% if baseContextType is defined %}
                    <input type="hidden" name="baseContextType" value="{{ baseContextType }}" />
                    {% endif %}
                    <input type="hidden" name="contextId" value="{{ context.id }}" />
                    <input type="hidden" name="folderId" value="{{ context.folder.id }}" />
                    {% if (customisedFor ?? '') | length %}
                        <input type="hidden" name="customisedFor" value="{{ customisedFor }}" />
                    {% endif %}

                    {% if assessmentType is defined and assessmentType|length %}
                    <input type="hidden" name="assessmentType" value="{{ assessmentType }}" />
                    {% endif %}

                    <div class="small-12 columns {% if assessmentType is not defined or not assessmentType|length %}hide{% endif %}" data-mage-collapsed data-assessment-details>
                        {% if assessmentType is defined and assessmentType|length %}
                            {% if assessmentType == 'lessonPlan' and lessonPlanMeta.template is not defined %}
                                {% include '@learningAssessment/'~assessmentType~'/selection.twig' %}
                            {% else %}
                                {% include '@learningAssessment/'~assessmentType~'/create.twig' with {stage: 2} %}
                            {% endif %}
                        {% endif %}
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>
