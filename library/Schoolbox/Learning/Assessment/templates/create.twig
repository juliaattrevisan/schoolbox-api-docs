{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

{{ bread.crumbsArray(breadcrumbs) }}

<script type="text/javascript" src="/javascript/shared/jquery.mage.js"></script>
<script type="text/javascript">
    $(function () {
        // the mage plugin is applied to the submit buttons: setup a basic mage on all the buttons
        $('input[data-mage-next]').mage();

        /**
         * Set jquery validate rules
         */
        var validateOptions = {
            rules: {
                title: {required: true},
                weight: {
                    required: true,
                    number: true,
                    min: 0
                },
                publishDate: {
                    required: true,
                    datepickerDate: true
                },
                publishTime: {
                    required: true,
                    timepickerTime: true
                },
                dueDate: {
                    required: true,
                    datepickerDate: true
                },
                dueTime: {
                    required: true,
                    timepickerTime: true
                }
            },
            messages: {
                weight: 'The grading weight should zero or greater'
            }
        };

        /**
         * These rules can't go in above because they have selectors that need to be
         * run on the content that's ajax'd in.
         */
        var beforeSubmit = function() {

            var publishDate = $('input[name="publishDate"]');
            var publishTime = $('input[name="publishTime"]');
            var openDate = $('input[name="openDate"]');
            var openTime = $('input[name="openTime"]');
            var dueDate = $('input[name="dueDate"]');
            var dueTime = $('input[name="dueTime"]');
            var closeDate = $('input[name="closeDate"]');
            var closeTime = $('input[name="closeTime"]');

            var openVisible = openDate.is(':visible');
            var closeVisible = closeDate.is(':visible');

            if (openVisible && closeVisible) {

               openDate.rules('add', {
                    required: true,
                    datepickerDate: true,
                    datepickerDateNotBefore: publishDate,
                    messages: {
                        datepickerDateNotBefore: 'This should not be before the publish date above'
                    }
                });

                dueDate.rules('add', {
                    datepickerDateNotBefore: openDate,
                    messages: {
                        datepickerDateNotBefore: 'This should not be before the open date above'
                    }
                });

                closeDate.rules('add', {
                    required: true,
                    datepickerDateNotBefore: dueDate,
                    messages: {
                        datepickerDateNotBefore: 'This should not be before the due date above'
                    }
                });

                openTime.rules('add', {
                    required: true,
                    timepickerTime: true
                });

                // check the times aren't earlier than the one above (if the dates are the same)
                if (openDate.val() == publishDate.val()) {
                    openTime.rules('add', {
                        timepickerNotBefore: publishTime,
                        messages: {
                            timepickerNotBefore: 'This should not be before the publish time above'
                        }
                    });
                }

                if (dueDate.val() == openDate.val()) {
                    dueTime.rules('add', {
                        timepickerNotBefore: openTime,
                        messages: {
                            timepickerNotBefore: 'This should not be before the open time above'
                        }
                    });
                }

                closeTime.rules('add', {
                    required: true,
                    timepickerTime: true

                });

                if (closeDate.val() == dueDate.val()) {
                    closeTime.rules('add', {
                        timepickerNotBefore: dueTime,
                        messages: {
                            timepickerNotBefore: 'This should not be before the due time above'
                        }
                    });
                }

            } else {

                dueDate.rules('add', {
                    datepickerDateNotBefore: publishDate,
                    messages: {
                        datepickerDateNotBefore: 'This should not be before the publish date above'
                    }
                });

                // if the dates are the same - need to check due time isn't before publish time
                if (dueDate.val() == publishDate.val()) {
                    dueTime.rules('add', {
                        timepickerNotBefore: publishTime,
                        messages: {
                            timepickerNotBefore: 'This should not be before the publish time above'
                        }
                    });
                }

            }
        };


        /**
         * When you finish configuring a non-project assessment
         */
        function setupAssessmentEnd(assessmentType) {

            $('input[data-mage-next="end"]').mage({
                validateOptions: validateOptions,
                beforeSubmit: beforeSubmit,
                onXhrDone: function (data) {
                    if('string' == typeof data.returnUrl){
                        window.location.href = data.returnUrl;
                    }
                }
            });
        }

        {% if assessmentType|length %}

            /* Save everything when Part 1 was already chosen in route
             */
            setupAssessmentEnd('{{ assessmentType }}');

        {% else %}

            /**
             * Update new form action url
             *
             * Inject common details
             * Inject assessmentType-specific details
             */
            $('input[data-mage-next="part-2"]').mage({
                onXhrDone: function(data) {
                    $('#assessmentForm')
                        .attr('action', '{{ routeLookup('learningAssessment.postCreateAssessment', { contextType: contextType, contextId: context.id, context: context }) }}')
                        .find('[data-assessment-details]')
                        .html(data);

                    /* Save everything when creating with Part 1
                     */
                    var assessmentType = $('input[name="type"]:checked').val();
                    setupAssessmentEnd(assessmentType);
                }
            });

            /**
             * Once they have clicked an activity type - trigger a click on the part-2 hidden input
             * to send the user straight to the next section
             */
            $('input[name=type]').click(function() {
                $('[data-mage-next=part-2]').trigger('click');
            });

        {% endif %}
    });
</script>

<div class="row">
    <div class="small-12 columns"><h1>Create {% if assessment.typeName|length %}{{ assessment.typeName }}{% else %}Activity{% endif %}</h1></div>
</div>

{% if assessmentType|length %}
    {% set formAction = routeLookup('learningAssessment.postCreateAssessment', { contextType: contextType, contextId: context.id, context: context }) %}
{% else %}
    {% set formAction = routeLookup('learningAssessment.getCreateAssessmentForm', { contextType: contextType, contextId: context.id, context: context }) %}
{% endif %}

<div class="row">
    <div class="small-12 columns island">
        <form action="{{ formAction }}" id="assessmentForm" method="post">
            <section>
                {% if not assessmentType|length %}
                <fieldset class="content" data-mage="part-1">
                    <input type="hidden" name="returnUrl" value="{{ returnUrl }}" />

                    <legend>Choose activity type</legend>

                    <fieldset>
                        {% for type in types %}
                        <div class="column small-12 medium-6{%  if loop.last %} end{% endif %}">
                            <input type="radio" name="type" value="{{ type.value }}" id="{{ type.id }}" data-radio-block />
                            <label title="{{ type.title }}" for="{{ type.id }}" class="block"><i class="icon-{{ type.label|replace(' ', '-')|lower }}"></i>{{ type.label }}</label>
                        </div>
                        {% endfor %}
                        <div class="column small-12 medium-12 error-placeholder"></div>
                    </fieldset>

                    <input type="hidden" name="part-1" data-mage-next="part-2" formmethod="GET">

                </fieldset>
                {% endif %}

                <fieldset class="content" data-mage="part-2" {% if not assessmentType|length %}disabled="disabled"{% endif %}>
                    {% if returnUrl|length %}
                        <input type="hidden" name="returnUrl" value="{{ returnUrl }}" />
                    {% endif %}
                    <input type="hidden" name="contextType" value="{{ contextType }}" />
                    <input type="hidden" name="contextId" value="{{ context.id }}" />

                    {% if assessmentType|length %}
                    <input type="hidden" name="assessmentType" value="{{ assessmentType }}" />
                    {% endif %}

                    <div class="small-12 columns {% if not assessmentType|length %}hide{% endif %}" data-mage-collapsed data-assessment-details>
                        {% if assessmentType|length %}
                            {% include '@learningAssessment/fragments/'~assessmentType~'/create.twig' %}
                        {% endif %}
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>
