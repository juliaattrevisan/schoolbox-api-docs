{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ folder.name, '/homepage/' ~ folder.id ],
    [ 'Create Assessment', routeLookup('learningAssessment.getCreateAssessment') ]
) }}

<script type="text/javascript" src="/javascript/shared/jquery.collapsable.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.mage.js"></script>
<script type="text/javascript">
    $(function () {
        // the mage plugin is applied to the submit buttons: setup a basic mage on all the buttons
        $('input[data-mage-next]').mage();

        // overload with specific callbacks (or other config values)
        $('input[data-mage-next="part-2"]').mage({
            onXhrDone: function (data) {

                /**
                 * Update the heading and perform transitions
                 *
                 * @param type
                 * @param selected
                 */
                function updateType(type, selected) {
                    $('#assessmentType').text($('#assessmentType').text() + ': ' + type);

                    var next = $('[data-mage="part-2-'+selected+'"]');
                    next.removeAttr('disabled').removeClass('hide');
                    next.find('[data-mage-collapsed]').hide().removeClass('hide').slideDown(600);
                }

                /* Switch between the Assessable types that you might
                 * have selected from part-1
                 */
                var selected = $('#assessmentForm').find('input[name=assessmentType]:checked').val();

                switch(selected) {
                    case 'project':
                        updateType('Project', selected);

                        /* Update each project assessable url with properly generated routes
                         */
                        $.each($('#projectButtons').find('[data-assessment-type]'), function(index, element) {
                            $(element).attr('href', data.allReturnUrls[$(element).attr('data-assessment-type')]);
                        });

                        break;
//                    case 'dueWork':
//                        updateType('Due Work', selected);
//                        updateFormUrl(data.updateRoute);
//                        break;
//                    case 'quiz':
//                        updateType('Quiz', selected);
//                        updateFormUrl(data.updateRoute);
//                        break;
//                    case 'task':
//                        updateType('Task', selected);
//                        updateFormUrl(data.updateRoute);
//                        break;
                    default:
                        break;
                }
            }
        });
    });
</script>

<div class="row">
    <div class="small-12 columns"><h1>Create Assessment</h1></div>
</div>

<div class="row">
    <div class="small-12 columns island">
        <form action="{{ routeLookup('learningAssessment.postCreateAssessment') }}" id="assessmentForm" method="post">
            <section>
                <fieldset class="content">
                    {% include '@learningAssessment/fragments/common.twig' %}
                </fieldset>
                <fieldset class="content">
                    <legend>Dates</legend>

                    {% include '@learningAssessment/fragments/dates.twig' %}
                </fieldset>
                <fieldset class="content">
                    {% include '@learningAssessment/fragments/curriculumCodes.twig' %}
                </fieldset>
                <fieldset class="content">
                    <legend>Type</legend>

                    <fieldset class="radiolist" data-assessment-type>
                        <div class="column small-12">
                            <input type="radio" name="assessmentType" value="project" id="project"><label for="project" class="radio-label">Project</label>
                            <input type="radio" name="assessmentType" value="dueWork" id="due-work"><label for="due-work" class="radio-label">Due Work</label>
                            <input type="radio" name="assessmentType" value="quiz" id="quiz"><label for="quiz" class="radio-label">Quiz</label>
                            <input type="radio" name="assessmentType" value="task" id="task"><label for="task" class="radio-label">Task</label>
                        </div>
                    </fieldset>

                    <div class="column small-12">
                        <div class="row" data-mage-submitrow>
                            <div class="small-12 medium-8 column">
                                <p class="alert alert-box icon-alert" data-mage-error></p>
                            </div>
                            <div class="small-12 medium-4 column">
                                <input type="submit" name="part-1" value="Next" data-mage-next="part-2" data-mage-working="Working..." />
                            </div>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend id="assessmentType">Assessment Type</legend>

                    <div class="hide" data-mage="part-2-project">
                        <div data-mage-collapsed>
                            {% include '@learningAssessment/fragments/project/create.twig' %}
                        </div>
                    </div>

                    <div class="hide" data-mage="part-2-dueWork">
                        <div data-mage-collapsed>
                            {% include '@learningAssessment/fragments/duework/create.twig' %}
                        </div>
                    </div>

                    <div class="hide" data-mage="part-2-task">
                        <div data-mage-collapsed>
                            {% include '@learningAssessment/fragments/task/create.twig' %}
                        </div>
                    </div>

                    <div class="hide" data-mage="part-2-quiz">
                        <div data-mage-collapsed>
                            {% include '@learningAssessment/fragments/quiz/create.twig' %}
                        </div>
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>