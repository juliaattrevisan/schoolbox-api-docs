{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

{{ bread.crumbsArray(breadcrumbs) }}

<script src="{{ CDN_PREFIX }}/js/bundle/mage.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/assessment/validationRules.js?v={{ config.site_version }}" data-locale-grading-proper="{{ locale.grading.proper }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/jquery-validation/dist/additional-methods.min.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/assessment/participation.js?v={{ config.site_version }}"></script>
<script>
    $(function () {
        // the mage plugin is applied to the submit buttons: setup a basic mage on all the buttons
        $('input[data-mage-next]').mage({
            validateOptions: validateOptions
        });

        /**
         * When you finish configuring a non-project assessment
         */
        function setupAssessmentEnd(assessmentType) {

            $('input[data-mage-next="end"]').mage({
                validateOptions: validateOptions,
                beforeAttemptingSubmit: beforeAttemptingSubmit,
                onXhrDone: function (data) {
                    if('string' == typeof data.returnUrl){
                        window.location.href = data.returnUrl;
                    }
                }
            });
        }

        {% if assessmentType is defined %}

            /* Save everything when Part 1 was already chosen in route
             */
            setupAssessmentEnd('{{ assessmentType }}');

            // Participation
            $('#participation-container').participationSettings({
                getAvailableDateFields: function () {

                    var dateArray = [];

                    if($('#publishDate').length != 0 && $('#publishDate').is(":visible")) {
                        dateArray.push('publish');
                    }
                    if($('#openDate').length != 0 && $('#openDate').is(":visible")) {
                        dateArray.push('open');
                    }
                    if($('#dueDate').length != 0 && $('#dueDate').is(":visible")) {
                        dateArray.push('due');
                    }
                    if($('#closeDate').length != 0 && $('#closeDate').is(":visible")) {
                        dateArray.push('close');
                    }

                    return dateArray;
                }
            });

        {% else %}

             /**
             * Update new form action url
             *
             * Inject common details
             * Inject assessmentType-specific details
             */
            $('input[data-mage-next="part-2"]').mage({
                onXhrDone: function(data) {
                    $('#assessmentForm')
                        .attr('action', '{{ routeLookup('learningAssessment.postCreateAssessment', { contextType: contextType, contextId: context.id, context: context }) }}')
                        .find('[data-assessment-details]')
                        .html(data);

                    // attach DP
                    $('[data-datepicker]').each(attachAlaressDatePicker);

                    /* Save everything when creating with Part 1
                     */
                    var assessmentType = $('input[name="type"]:checked').val();
                    setupAssessmentEnd(assessmentType);

                    // Re-init foundation plugins
                    $(document).foundation();

                    // Participation
                    $('#participation-container').participationSettings({
                        getAvailableDateFields: function () {

                            var dateArray = [];

                            if($('#publishDate').length != 0 && $('#publishDate').is(":visible")) {
                                dateArray.push('publish');
                            }
                            if($('#openDate').length != 0 && $('#openDate').is(":visible")) {
                                dateArray.push('open');
                            }
                            if($('#dueDate').length != 0 && $('#dueDate').is(":visible")) {
                                dateArray.push('due');
                            }
                            if($('#closeDate').length != 0 && $('#closeDate').is(":visible")) {
                                dateArray.push('close');
                            }

                            return dateArray;
                        }
                    });
                }
            });

            /**
             * Once they have clicked an activity type - trigger a click on the part-2 hidden input
             * to send the user straight to the next section
             */
            $('input[name=type]').click(function() {
                $('[data-mage-next=part-2]').trigger('click');
            });

        {% endif %}

    });
 </script>


 <div class="actions-small-1 row">
     <div class="list-item">
         <div class="small-12 column">
             <h1>Create
                 {% if assessment.typeName is defined %}
                     {% if attribute(locale, assessment.typeName|lower) is defined %}
                         {{ attribute(locale, assessment.typeName|lower).proper }}
                     {% else %}
                        {{ assessment.typeName }}
                     {% endif %}
                 {% else %}
                     Activity
                 {% endif %}</h1>
         </div>
     </div>
     {# TODO - Quiz fragment should extend this template, not be included. This template should not know about Quizzes #}
    {% if assessment is defined and assessment is quiz %}
    <nav>
        <a class="icon-more" data-dropdown="header-options" title="Actions"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content="">
        <li><a href="#" id="import" data-reveal-id="import-modal" class="icon-import">Import from XML file</a></li>
    </ul>
    {% endif %}
</div>


{% if assessmentType is defined and assessmentType|length %}
    {% set formAction = routeLookup('learningAssessment.postCreateAssessment', { contextType: contextType, contextId: context.id, context: context }) %}
{% else %}
    {% set formAction = routeLookup('learningAssessment.getCreateAssessmentForm', { contextType: contextType, contextId: context.id, context: context }) %}
{% endif %}

<div class="row">
    <div class="small-12 columns island">
        <form action="{{ formAction }}" class="mage" id="assessmentForm" method="post">
            <section>
                {% if assessmentType is not defined %}
                <fieldset class="content" data-mage="part-1">
                    {% if (returnUrl ?? '') | length %}
                        <input type="hidden" name="returnUrl" value="{{ returnUrl }}" />
                    {% endif %}

                    <legend>Choose activity type</legend>

                    <fieldset data-has-error-placeholder>
                        {% for type in types %}
                        <div class="column small-12 medium-6{%  if loop.last %} end{% endif %}">
                            <input type="radio" name="type" value="{{ type.value }}" id="{{ type.id }}" />
                            <label title="{{ type.title }}" for="{{ type.id }}" class="block"><i class="icon-{{ type.icon }}"></i>{{ type.label }}</label>
                        </div>
                        {% endfor %}
                        <div class="column small-12 medium-12 error-placeholder"></div>
                    </fieldset>

                    <input type="hidden" name="part-1" data-mage-next="part-2" formmethod="GET">

                </fieldset>
                {% endif %}

                <fieldset class="content" data-mage="part-2" {% if assessmentType is not defined %}disabled="disabled"{% endif %}>
                    {% if (returnUrl ?? '') | length %}
                        <input type="hidden" name="returnUrl" value="{{ returnUrl }}" />
                    {% endif %}
                    <input type="hidden" name="contextType" value="{{ contextType }}" />
                    <input type="hidden" name="contextId" value="{{ context.id }}" />
                    <input type="hidden" name="folderId" value="{{ context.folder.id }}" />

                    {% if assessmentType is defined and assessmentType|length %}
                    <input type="hidden" name="assessmentType" value="{{ assessmentType }}" />
                    {% endif %}

                    <div class="small-12 columns {% if assessmentType is not defined or not assessmentType|length %}hide{% endif %}" data-mage-collapsed data-assessment-details>
                        {% if assessmentType is defined and assessmentType|length %}
                            {% include '@learningAssessment/'~assessmentType~'/create.twig' with {stage: 2} %}
                        {% endif %}
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>


{# TODO - This should be in the quiz fragment, not the parent, but that doesn't work because you can't have a form
in a form. The template hierachy should be refactored so that quiz EXTENDS the parent, rather than being included.
#}
{% if (assessment is defined and assessment is quiz) %}
    <div id="import-modal" class="reveal-modal" data-reveal="">
        <form action="/assess/import/xml/{{ context.folder.id }}" method="post" enctype="multipart/form-data">
            <input type="hidden" name="context_type" value="{{ contextType }}">
            <input type="hidden" name="context_id" value="{{ context.id }}">
            {% include 'sub/attachzone.twig' with { attachzone: importAttachzone } %}
            <label>
                <input type="submit" value="Import from XML file">
            </label>
        </form>
    </div>
{% endif %}

