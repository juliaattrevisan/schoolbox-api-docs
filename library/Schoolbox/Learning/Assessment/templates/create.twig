{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Learning',    routeLookup('sportsfixtures.getLanding') ],
    [ 'Classname',   routeLookup('sportsfixturesSport.getList') ],
    [ 'Create Assessment',   routeLookup('sportsfixturesSport.getList') ]
) }}

<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
<script type="text/javascript">
    $(function () {
        $.fn.alaressEditor();
    });
</script>

<div class="row">
    <div class="small-12 columns"><h1>Create Assessment</h1></div>
</div>

<div class="row">
    <div class="small-12 columns island">
        <form action="#">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>Title
                            <input type="text" required />
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>Description
                            <textarea name="description"></textarea>
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>Weight
                            <input type="number" name="weight">
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>Visibility
                            <select>
                                <option>&#xe66b;&nbsp;&nbsp;&nbsp;Staff Only</option>
                                <option>&#xe667;&nbsp;&nbsp;&nbsp;Staff and Students</option>
                                <option>&#xe666;&nbsp;&nbsp;&nbsp;Staff, Students and their Parents</option>
                            </select>
                        </label>
                    </div>

                    <div class="column small-12 medium-4">
                        <label>Publish Date
                            <input type="text" data-datepicker placeholder="Publish Date">
                        </label>
                    </div>
                    <div class="column small-6 medium-4">
                        <div class="timepick">
                            <label>Commencement Date
                                <input data-timepicker type="text" autocomplete="off" placeholder="Commencement Date" />
                            </label>
                        </div>
                    </div>
                    <div class="column small-6 medium-4">
                        <div class="timepick">
                            <label>Due Date
                                <input data-timepicker type="text" autocomplete="off" placeholder="Due Date" />
                            </label>
                        </div>
                    </div>
                    <script type="text/javascript" charset="utf-8" src="/javascript/components/jquery-timepicker-jt/jquery.timepicker.min.js"></script>
                    <script type="text/javascript">
                        $(function () {
                            $('[data-datepicker]').datepicker();
                            $('[data-timepicker]').timepicker({
                                appendTo: function ($input) {
                                    return $input.closest('.timepick');
                                }
                            });
                        });
                    </script>
                    <div class="column small-12">
                        <label>Curriculum Codes</label>
                        <input id='user' name="userId" type='text' value='' placeholder="Curriculum Codes" data-selectizeuser required />
                    </div>
                </fieldset>
                <fieldset class="content">
                    <legend>Type</legend>
                    <input type="radio" name="project" value="Project" id="project" checked><label for="project">Project</label>
                    <input type="radio" name="due-work" value="Due Work" id="due-work"><label for="due-work">Due Work</label>
                    <input type="radio" name="quiz" value="Quiz" id="quiz" disabled><label for="quiz">Quiz</label>
                    <input type="radio" name="task" value="Task" id="task" disabled><label for="task">Task</label>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 column">
                    <input type="submit" name="submit" value="Next" />
                </div>
            </div>
        </form>
    </div>
</div>