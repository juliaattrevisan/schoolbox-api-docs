{#
Usage:
    {% include '@learningAssessment/builder/unitAssessment.twig' with {
            _writable:   bool,
            assessment:  IAssessable,
            USER:        User
    } only %}
#}
{% import '@learningAssessment/project/macro/icon.twig' as icon %}

{% if assessment is quiz %}
    {% set textLinkRoute = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {
        assessmentId: assessment.id,
        assessment: assessment
    }) %}
{% elseif assessment is project %}
    {% set textLinkRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {
        assessmentId: assessment.id,
        assessment: assessment
    })
    %}
{% else %}
    {% set textLinkRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {
        assessmentId: assessment.id,
        assessment: assessment,
        studentId: USER.id,
        student: USER
        })
    %}
{% endif %}

<li class="actions-small-1" data-assessment="{{ assessment.id }}">
    <div class="actions-small-1">
        <div class="grip compact"></div>
        <div class="list-item">
            <div class="card small-12 compact wrap-down">
                {% if textLinkRoute %}<a data-test="course-builder-assessment-title-{{ assessment.title }}" data-test-activity-id="{{ assessment.id }}" href="{{ textLinkRoute }}?{{ returnUrlName }}={{ returnUrl }}">{% endif %}
                    <span class="{{ icon.renderClass(assessment) }}"></span>
                    <p>{{ assessment.title }}</p>
                {% if textLinkRoute %}</a>{% endif %}
            </div>
        </div>
        <nav>
            <sbx-pop-out content-id="dropdown-{{ assessment.id }}"></sbx-pop-out>
        </nav>
        <ul class="f-dropdown" data-dropdown-content id="dropdown-{{ assessment.id }}">
            <li><a href="{{ routeLookup('learningAssessmentExporter.getExportFormForAssessment', {assessmentId: assessment.id}) }}?{{ returnUrlName }}={{ returnUrl }}" class="icon-export" title="Copy this task into classes" data-test="builder-export-activity-{{ assessment.id }}">Export to Classes</a></li>

            {% include '@learningAssessment/fragments/modifyLinks.twig' with {
                assessment: assessment,
                modifyRoute: routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}),
                returnUrlName: RETURN_URL.name,
                returnUrl: RETURN_URL.current,
            } only %}

            {% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {
                assessmentId: assessment.id,
                assessment: assessment
            }) %}
            {% if deleteRoute %}
                <li><a href="{{ deleteRoute }}?{{ returnUrlName }}={{ returnUrl }}" data-action="delete-assessment" data-test="builder-delete-activity-{{ assessment.id }}" class="sbx-button--has-icon"><sbx-icon name="delete"></sbx-icon>Delete</a></li>
            {% endif %}
        </ul>
        <div data-reveal class="reveal-modal" id="export-modal-{{ assessment.id }}"></div>
    </div>
</li>
