{#
Usage:
    {% include '@learningAssessment/builder/unitAssessment.twig' with {
            _writable:   bool,
            assessment:  IAssessable,
            USER:        User
    } only %}
#}
{% import '@learningAssessment/project/macro/icon.twig' as icon %}

{% if assessment is quiz %}
    {% set textLinkRoute = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {
        assessmentId: assessment.id,
        assessment: assessment
    }) %}
{% elseif assessment is project %}
    {% set textLinkRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {
        assessmentId: assessment.id,
        assessment: assessment
    })
    %}
{% else %}
    {% set textLinkRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {
        assessmentId: assessment.id,
        assessment: assessment,
        studentId: USER.id,
        student: USER
        })
    %}
{% endif %}

<li class="actions-small-1" data-assessment="{{ assessment.id }}">
    <div class="actions-small-1">
        <div class="grip compact"></div>
        <div class="list-item">
            <div class="card small-12 compact wrap-down">
                {% if textLinkRoute %}<a data-test="course-builder-assessment-title-{{ assessment.title }}" href="{{ textLinkRoute }}?{{ returnUrlName }}={{ returnUrl }}">{% endif %}
                    <span class="{{ icon.renderClass(assessment) }}"></span>
                    <p>{{ assessment.title }}</p>
                {% if textLinkRoute %}</a>{% endif %}
            </div>
        </div>
        <nav>
            <sbx-pop-out content-id="dropdown-{{ assessment.id }}"></sbx-pop-out>
        </nav>
        <ul class="f-dropdown" data-dropdown-content id="dropdown-{{ assessment.id }}">
            <li><a href="{{ routeLookup('learningAssessmentExporter.getExportFormForAssessment', {assessmentId: assessment.id}) }}?{{ returnUrlName }}={{ returnUrl }}" class="icon-export" title="Copy this task into classes">Export to Classes</a></li>

            {% if assessment is quiz %}
                {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
                {% set modifyContentsRoute = routeLookupIfAuthorized('learnosity.getContent', {assessment: assessment, assessmentId: assessment.id}) %}

                {% if modifyRoute %}<li><a class="icon-modify" href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Modify Settings</a></li>{% endif %}
                {% if modifyContentsRoute %}<li><a class="icon-modify" href="{{ modifyContentsRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Modify Contents</a></li>{% endif %}
            {% else %}
                <li><a href="{{ routeLookup('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id}) }}?{{ returnUrlName }}={{ returnUrl }}" class="icon-modify">Modify</a></li>
            {% endif %}

            <li><a href="{{ routeLookup('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id}) }}?{{ returnUrlName }}={{ returnUrl }}" data-action="delete-assessment" class="icon-delete">Delete</a></li>
        </ul>
        <div data-reveal class="reveal-modal" id="export-modal-{{ assessment.id }}"></div>
    </div>
</li>
