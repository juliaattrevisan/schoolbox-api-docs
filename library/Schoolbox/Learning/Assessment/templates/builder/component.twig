{#
$data = [
    componentInstance: Component_Instance   - the component showing hosting this content
    unitSpec:          UnitSpecification    - never null (if null, component displays empty-state template)
    returnUrlName:     string               - key value of returnUrl key-value pair to insert in URL
    encodedReturnUrl:  string               - encoded address of this page to return to after creating new assessments
];
#}

{% set activityUrl = routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'unitspecs', contextId: unitSpec.id, context: unitSpec}) %}

{% if unitSpec.assessables | length %}

    <script type="text/javascript" src="{{ CDN_PREFIX }}/js/course/jquery.course-builder.js?v={{ config.site_version }}"></script>
    <script type="text/javascript">
        $(function () {
            $('[data-unit-spec={{ unitSpec.id }}]').setupCourseBuilder({toastSelector: '[data-relation="ajax-response-{{ componentInstance.id }}"]'});
        });
    </script>

    {% if breadcrumbs | length %}
        <ul class="breadcrumb">
            <li>
                {% for node in breadcrumbs %}
                    <a href="/homepage/{{ node.id }}/">{{ node.name }}</a>
                {% endfor %}
            </li>
        </ul>
    {% endif %}

    <div data-unit-spec="{{ unitSpec.id }}">
        <ul class="information-list sortable"
            data-sortable
            data-assessment-list
            data-action="{{ routeLookup('learningAssessment.postReorderAssessments', {contextType: 'unitspecs', contextId: unitSpec.id, context: unitSpec}) }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">
            {% for assessment in unitSpec.assessables %}
                {% include '@learningAssessment/builder/assessment.twig' with {
                '_writable': true,
                assessment:  assessment,
                returnUrl: encodedReturnUrl,
                returnUrlName: returnUrlName
                } only %}
            {% endfor %}
        </ul>
    </div>
    <div class="component-action">
        <section>
            <a class="button" href="{{ activityUrl }}?{{ returnUrlName }}={{ encodedReturnUrl }}" title="Create a new activity">Create Activity</a>
        </section>
    </div>
{% else %}
    <div class="empty-state">
        <i class="icon-course"></i>
        <p><a href="{{ activityUrl }}?{{ returnUrlName }}={{ encodedReturnUrl }}">Create a task, {{ locale.dueWork }}, quiz, or {{ locale.project }}</a> for this {{ locale.unit }} that you can import into classes and reuse again.</p>
    </div>
{% endif %}

<div class="toast" data-alert data-relation="ajax-response-{{ componentInstance.id }}"></div>
