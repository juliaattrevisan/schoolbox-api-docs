{% if breadcrumbs | length %}
    <div class="content">
        <ul class="breadcrumb">
            <li>
                {% for node in breadcrumbs %}
                    <a href="/homepage/{{ node.id }}/">{{ node.name }}</a>
                {% endfor %}
            </li>
        </ul>
    </div>
{% endif %}

{% if canRead %}
    {% include '@learningAssessment/builder/unit.twig' with { unit: unit, '_writable': canWrite } %}
{% endif %}

{% if canWrite %}
    <div class="component-action">
        <section>
            <a class="button" href="{{ routeLookup('learningAssessment.getSelectAssessmentInUnitSpecification', {unitSpecId: unit.id}) }}" title="Create a new activity">
                Create Activity
            </a>
        </section>
    </div>
{% endif %}
