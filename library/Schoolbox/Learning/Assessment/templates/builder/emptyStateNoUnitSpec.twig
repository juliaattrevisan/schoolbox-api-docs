{#
Usage:
    {% include '@learningAssessment/builder/emptyStateNoUnitSpec.twig' with {
        componentInstance Component_Instance - The Component displaying this content
        folder:           Folder             - The folder on which this Component resides
        folderHasCourse:  bool               - Whether this folder has a Course
        parentHasCourse:  bool               - Whether this folder's parent has a Course
        parentHasUnit:    bool               - Whether this folder's parent has a Unit
        parentWritable:   bool               - Whether this user has WRITE+ perm to folder parent
    } only %}
#}
<script>
    $(function() {

        $('[data-convert-folders]').on('click', function(event){
            event.preventDefault();
            var $element = $(this);
            var countFolders = $element.attr('data-convert-folders');
            var $convertFeedback = $('[data-relation="save-label"]');
            $convertFeedback.toastActivate({text: 'Converting Folder'+(countFolders > 1 ? 's' : '')+'...'});

            convertFolder($element[0], $convertFeedback);
        });

        /**
         * async function to post convert folder
         */
        async function convertFolder(element, toast) {
            try {
                const response = await fetch(element.href, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With' : 'XMLHttpRequest'
                    }
                });
                const responseData = await response.json();
                if (response.ok) {
                    toast.toastTimeout({text: 'Conversion Complete', css: 'success'});
                    reloadComponent();
                    return responseData;
                } else {
                    throw new Error('Conversion Failed!', {cause: responseData});
                }
            } catch (error) {
                console.warn(error);
                toast.toastTimeout({text: error.message + " " + error.cause.join(', '), css: 'alert'});
            }
        }

        /**
         * Call after successful conversion to AJAX refresh the component
         */
        function reloadComponent()
        {
            var $component = $('#component{{ componentInstance.id }}');
            var $updateForm = $component.find("[data-component-panel='settings'] form");
            $updateForm.trigger('submit');
        }

    });

</script>
<div class="empty-state">
    <sbx-icon name="course" size="2.5rem"></sbx-icon>

    {% if folderHasCourse %}

        <p>This component works on {{ locale.unit }} pages to create activities to import to your class. This is a course page so the component doesn't work here.</p>
    <p><a href="{{ routeLookup('course.courseList') }}">Go to Manage Courses</a> to add a {{ locale.unit }} page to your course and create activities there.</p>

    {% elseif parentHasUnit %}

        <p>This component works on {{ locale.unit }} pages to create activities to import to your class. This page has been created underneath a {{ locale.unit }} page not a course page so the component doesn't work here.</p>
        <p>To create a sub-{{ locale.unit }} to your {{ locale.unit }} page, <a href="{{ routeLookup('course.courseList') }}">go to Manage Courses</a> and create a {{ locale.project }} in your {{ locale.unit }}.</p>

    {% elseif folderHasClass %}

        <p>This component works on {{ locale.unit }} pages to create activities to import to your class. This page is a class page so the component doesn't work here.</p>
        <p><a href="{{ routeLookup('course.courseList') }}">Go to the course list</a> to create a course with {{ locale.unit.plural }} to import into your class.</p>

    {% elseif not parentHasCourse and not folderHasParent %}

        <p>This component works on {{ locale.unit }} pages within courses to create activities to import to your class. This page has no parent folder to use as a course. <a href="#remove-component" data-target="delete">Remove this component</a>.</p>

    {% elseif not parentHasCourse %}

        {% if parentWritable %}
            <p><a data-convert-folders="2" href="{{ routeLookup('course.convertFolders', {courseFolderId: folder.parent.id, unitFolderId: folder.id }) }}">Convert this page to a {{ locale.unit }} page</a> to start creating activities that you can import into classes and reuse again. <b>Important</b>: This action will convert the page above to a course page.</p>
        {% else %}
            <p>This page is not a {{ locale.unit }} and the parent page is not a course.</p>
            <p>You have permission to convert this page to a {{ locale.unit }} but do not have permission to convert the parent page to a course.</p>
        {% endif %}

    {% elseif parentHasCourse %}

        <p><a data-convert-folders="1" href="{{ routeLookup('course.convertFolders', {courseFolderId: folder.parent.id, unitFolderId: folder.id }) }}">Convert this page to a {{ locale.unit }} page</a> to start creating activities that you can import into classes and reuse again.</p>

    {% endif %}

</div>

<div class="toast" data-alert data-relation="save-label"></div>
