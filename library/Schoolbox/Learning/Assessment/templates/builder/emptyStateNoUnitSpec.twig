{#
Usage:
    {% include '@learningAssessment/builder/emptyStateNoUnitSpec.twig' with {
        componentInstance Component_Instance - The Component displaying this content
        folder:           Folder             - The folder on which this Component resides
        folderHasCourse:  bool               - Whether this folder has a Course
        parentHasCourse:  bool               - Whether this folder's parent has a Course
        parentHasUnit:    bool               - Whether this folder's parent has a Unit
    } only %}
#}
<script>
    $(function() {

        $('[data-convert-folders]').on('click', function(event){
            event.preventDefault();
            var $element = $(this);
            var countFolders = $element.attr('data-convert-folders');
            var $convertFeedback = $('[data-relation="save-label"]');
            $convertFeedback.toastActivate({text: 'Converting Folder'+(countFolders > 1 ? 's' : '')+'...'});

            $.post($element[0].href, function(){
                $convertFeedback.toastTimeout({text: 'Conversion Complete', css: 'success'});
                reloadComponent();
            })
            .fail(function(){
                $convertFeedback.toastTimeout({text: 'Conversion Failed!', css: 'alert'});
            });
        });

        /**
         * Call after successful conversion to AJAX refresh the component
         */
        function reloadComponent()
        {
            var $component = $('#component{{ componentInstance.id }}');
            var $updateForm = $component.find("[data-component-panel='settings'] form");
            $updateForm.trigger('submit');
        }

        /**
         * Removing this component with a link
         */
        var $component = $('#component{{ componentInstance.id }}');
        var $deleteIcon = $component.find('[data-target=delete]');

        $component.on('click', '[data-action="delete-component"]', function(event){
            event.preventDefault();
            if('closed' == $deleteIcon.attr('data-state')){
                $deleteIcon.trigger('click');
            }
        });
    });

</script>
<div class="empty-state">
    <i class="icon-course"></i>

    {% if folderHasCourse %}

        <p>This component works on unit pages to create activities to import to your class. This is a course page so the component doesn't work here.</p>
    <p><a href="{{ routeLookup('course.courseList') }}">Go to Manage Courses</a> to add a unit page to your course and create activities there.</p>

    {% elseif parentHasUnit %}

        <p>This component works on unit pages to create activities to import to your class. This page has been created underneath a unit page not a course page so the component doesn't work here.</p>
        <p>To create a sub-unit to your unit page, <a href="{{ routeLookup('course.courseList') }}">go to Manage Courses</a> and create a project in your unit.</p>

    {% elseif folderHasClass %}

        <p>This component works on unit pages to create activities to import to your class. This page is a class page so the component doesn't work here.</p>
        <p><a href="{{ routeLookup('course.courseList') }}">Go to the course list</a> to create a course with units to import into your class.</p>

    {% elseif not parentHasCourse and not folderHasParent %}

        <p>This component works on unit pages within courses to create activities to import to your class. This page is not a unit page so the component doesn't work here. <a href="#" data-action="delete-component">Remove this component</a>.</p>

    {% elseif not parentHasCourse %}

        <p><a data-convert-folders="2" href="{{ routeLookup('course.convertFolders', {courseFolderId: folder.parent.id, unitFolderId: folder.id }) }}">Convert this page to a unit page</a> to start creating activities that you can import into classes and reuse again. <b>Important</b>: This action will convert the page above to a course page.</p>

    {% elseif parentHasCourse %}

        <p><a data-convert-folders="1" href="{{ routeLookup('course.convertFolders', {courseFolderId: folder.parent.id, unitFolderId: folder.id }) }}">Convert this page to a unit page</a> to start creating activities that you can import into classes and reuse again.</p>

    {% endif %}

</div>

<div class="toast" data-alert data-relation="save-label"></div>
