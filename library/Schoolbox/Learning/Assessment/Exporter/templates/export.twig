{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

{#{{ bread.crumbsArray(breadcrumbs) }}#}
<script type="text/javascript">
    $(function() {

        $('#importForm').find('[data-select-all-group]').change(function () {
            var unit = $(this).attr('data-unit-id');
            if(this.checked) {
                $('#unit-' + unit + '-dates').removeAttr('hidden');
            }
            else {
                $('#unit-' + unit + '-dates').attr('hidden', true);
            }
        });

    });
</script>


<div class="row">
    <div class="small-12 columns">
        <h1>Export {{ assessment.typeName }}: {{ assessment.title }}</h1>
    </div>
</div>

<div class="row">

    {% if implementations|length == 0 %}
        <div class="small-12 island">
            <div class = "empty-state">
                <i class="icon-class-list"></i>
                <p>There are no open classes that currently use this {{ locale.unit }}.</p>
            </div>
        </div>

    {% else %}
        <div class="small-12 island">
            <script type="text/javascript" src="/javascript/shared/select-all/attacher.select-all.js"></script>

            <form method="post"
                  action="{{ routeLookup('learningAssessmentExporter.postExport', {assessmentId: assessment.id}) }}?{{ returnUrlName|e('html_attr') }}={{ returnUrl|e('html_attr') }}"
                  id="importForm">

                <table>
                    <colgroup>
                        <col />
                        <col class="full-width" />
                    </colgroup>

                    <thead>
                    <tr>
                        <th>
                            <input id="checkAll"
                                   type="checkbox"
                                   data-select-all
                                   data-select-all-for-group="unit-implementation" />
                            <label for="checkAll" class="checkbox-label"></label>
                        </th>
                        <th>Class</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for implementation in implementations %}
                        <tr>
                            <td>
                                <input type="checkbox"
                                       id="import-{{ implementation.unit.id }}"
                                       value="1"
                                       {% if not implementation.allowed %}disabled{% endif %}
                                       data-select-all-group="unit-implementation"
                                       data-unit-id="{{ implementation.unit.id }}" />
                                <label for="import-{{ implementation.unit.id }}" class="checkbox-label"></label>
                            </td>
                            <td>
                                <div class="card small-12">
                                    <a href="/homepage/{{ implementation.unit.course.folder.id }}">
                                        <span class="size-32 icon-home"></span>
                                        <h3>{{ implementation.unit.course.folder.title }}</h3>
                                    </a>
                                    <p class="meta">
                                        {% spaceless %}
                                        <time title="{{ implementation.unit.openDate.short }}"
                                              datetime="{{ implementation.unit.openDate.databaseDate }}"
                                        >{{ implementation.unit.openDate.relativeTime }}</time>
                                        &ndash;
                                        <time title="{{ implementation.unit.dueDate.short }}"
                                              datetime="{{ implementation.unit.dueDate.databaseDate }}"
                                        >{{ implementation.unit.dueDate.relativeTime }}</time>
                                        {% endspaceless %}
                                    </p>
                                    <p class="meta">
                                        {% if implementation.allowed %}
                                            This activity does not exist in this class.
                                        {% else %}
                                            {# why not? #}
                                            {% if implementation.imported %}
                                                This activity already exists in this class.
                                            {% else %}
                                                You don't have write permission for this class.
                                            {% endif %}
                                        {% endif %}
                                    </p>
                                </div>

                                <div class="list-item" id="unit-{{ implementation.unit.id }}-dates" hidden>
                                    <div class="small-12 medium-6 large-3 columns">
                                        <label for="publish_date-{{ implementation.unit.id }}">Publish</label>
                                        <input id="publish_date-{{ implementation.unit.id }}"
                                               name="unit[implementation.unit.id][publish_date]"
                                               type="text"
                                               value="{{ implementation.unit.openDate.localShort }}"
                                               data-datepicker
                                               data-datepicker-buttontext=""
                                               data-datesync-enddate="#due_date-{{ implementation.unit.id }}" />
                                    </div>
                                    <div class="small-12 medium-6 large-3 columns">
                                        <label for="open_date-{{ implementation.unit.id }}">Open</label>
                                        <input id="open_date-{{ implementation.unit.id }}"
                                               name="unit[{{ implementation.unit.id }}][open_date]"
                                               type="text"
                                               value="{{ implementation.unit.openDate.localShort }}"
                                               data-datepicker
                                               data-datepicker-buttontext=""
                                               data-datesync-startdate="#publish_date-{{ implementation.unit.id }}"
                                               data-datesync-enddate="#due_date-{{ implementation.unit.id }}" />
                                    </div>
                                    <div class="small-12 medium-6 large-3 columns">
                                        <label for="due_date-{{ implementation.unit.id }}">Due</label>
                                        <input id="due_date-{{ implementation.unit.id }}"
                                               name="unit[{{ implementation.unit.id }}][due_date]"
                                               type="text"
                                               value="{{ implementation.unit.dueDate.localShort }}"
                                               data-datepicker
                                               data-datepicker-buttontext=""
                                               data-datesync-startdate="#open_date-{{ implementation.unit.id }}"
                                               data-datesync-endtdate="#close_date-{{ implementation.unit.id }}" />
                                    </div>
                                    <div class="small-12 medium-6 large-3 columns">
                                        <label for="close_date-{{ implementation.unit.id }}">Close</label>
                                        <input id="close_date-{{ implementation.unit.id }}"
                                               name="unit[{{ implementation.unit.id }}][close_date]"
                                               type="text"
                                               value="{{ implementation.unit.dueDate.localShort }}"
                                               data-datepicker
                                               data-datepicker-buttontext=""
                                               data-datesync-startdate="#due_date-{{ implementation.unit.id }}" />
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                <input type="submit" class='expand' value="Export to selected classes" />
            </form>
        </div>

    {% endif %}
</div>
