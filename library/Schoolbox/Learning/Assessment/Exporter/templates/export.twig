{#
    'assessmentSpec'   IAssessable   - The assessment spec
    'returnUrl'        string        - A URL to return to
    'returnUrlName'    string        - query arg name
    'implementations'  IAssessable[] - ID is NULL if not yet imported
    'folderWritePerms' bool[]        - Does current user have WRITE+ perm to the class folder
    'enableReimport'   bool          - Should already imported class assessments be re-importable?
#}
{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learningAssessment/fragments/macro/submitRow.twig' as mage %}

{#{{ bread.crumbsArray(breadcrumbs) }}#}
<script type="text/javascript">
    $(function () {

        $('#importForm').find('[data-select-all-group]').change(function () {
            var unit = $(this).attr('data-unit-id');
            if (this.checked && $(this).attr('disabled') === undefined) {
                $('#unit-' + unit + '-dates').removeAttr('hidden');
            }
            else {
                $('#unit-' + unit + '-dates').attr('hidden', true);
            }
            if ($('#importForm input[data-select-all-group]:checked:not(:disabled)').length) {
                $('#importForm input[type=submit]').removeAttr('disabled');
            }
            else {
                $('#importForm input[type=submit]').attr('disabled', true);
            }
        });

    });
</script>

<div class="row">
    <div class="small-12 island">
        <h1>Export {{ assessmentSpec.typeName }}: {{ assessmentSpec.title }}</h1>
    </div>
</div>
<div class="row">
    {% if implementations|length == 0 %}
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-class-list"></i>
                <p>There are no open classes that currently use this {{ locale.unit }}.</p>
            </div>
        </div>
    {% else %}
        <div class="small-12 island">

            <script type="text/javascript" src="/javascript/shared/select-all/attacher.select-all.js"></script>

            <form method="post"
                  action="{{ routeLookup('learningAssessmentExporter.postExport', {assessmentId: assessmentSpec.id}) }}?{{ returnUrlName|e('html_attr') }}={{ returnUrl|e('html_attr') }}"
                  id="importForm">
                <section>
                    <ul class="information-list card-selectable">
                        <li>
                            <div class="small-12 column">
                                <div class="selector">
                                    <input id="checkAll"
                                           type="checkbox"
                                           data-select-all
                                           data-select-all-for-group="unit-implementation"/>
                                    <label for="checkAll" class="checkbox-label"></label>
                                </div>
                            </div>
                        </li>
                    </ul>
                    <ul class="information-list card-selectable">
                        {% for assessmentImpl in implementations %}
                            {% set unitImpl     = assessmentImpl.baseContext %}
                            {% set isInstructor = folderWritePerms[unitImpl.course.folder.id] %}
                            {% set isImported   = assessmentImpl.id is not null %}
                            {% set canImport    = isInstructor and (not isImported or enableReimport) %}
                            <li>
                                <div class="small-12 columns">
                                    <div class="selector">
                                        <input type="checkbox"
                                               id="import-{{ unitImpl.id }}"
                                               name="unitImplementation[{{ unitImpl.id }}]"
                                               value="1"
                                               {% if not canImport %}disabled{% endif %}
                                               data-select-all-group="unit-implementation"
                                               data-unit-id="{{ unitImpl.id }}"/>
                                        <label for="import-{{ unitImpl.id }}" class="checkbox-label"></label>
                                    </div>
                                    <div class="card small-12">
                                        <span class="size-32 icon-home"></span>
                                        <h3><a href="/homepage/{{ unitImpl.course.folder.id }}">
                                                {{ unitImpl.course.folder.title }}
                                            </a>
                                        </h3>
                                        <p class="meta">
                                            {% spaceless %}
                                                <time title="{{ unitImpl.openDate.short }}"
                                                      datetime="{{ unitImpl.openDate.databaseDate }}"
                                                >{{ unitImpl.openDate.relativeTime }}</time>
                                                &ndash;
                                                <time title="{{ unitImpl.dueDate.short }}"
                                                      datetime="{{ unitImpl.dueDate.databaseDate }}"
                                                >{{ unitImpl.dueDate.relativeTime }}</time>
                                            {% endspaceless %}
                                        </p>
                                        <p class="meta">
                                            {% if isImported %}
                                                This activity already exists in this class.
                                            {% elseif not isInstructor %}
                                                You don't have write permission for this class.
                                            {% else %}
                                                This activity does not exist in this class.
                                            {% endif %}
                                        </p>
                                    </div>
                                </div>

                                {% if (assessmentSpec is quiz or (assessmentSpec is dueWork and not assessmentSpec.acceptNone)) %}
                                    {% set dates = ['publish', 'open', 'due', 'close'] %}
                                    {% set fullSetOfDates = true %}
                                {% else %}
                                    {% set dates = ['publish', 'due'] %}
                                    {% set fullSetOfDates = false %}
                                {% endif %}

                                <div class="list-item" id="unit-{{ unitImpl.id }}-dates" hidden>
                                    {% for date in dates %}
                                        {% include '@learningAssessmentExporter/date.twig' with {
                                            fullSetOfDates:     fullSetOfDates,
                                            dateType:           date,
                                            unitImplementation: unitImpl,
                                            assessment:         assessmentImpl
                                        } only %}
                                    {% endfor %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
                <input type="submit" class='expand' disabled value="Export to selected classes"/>
            </form>
        </div>
    {% endif %}
</div>
