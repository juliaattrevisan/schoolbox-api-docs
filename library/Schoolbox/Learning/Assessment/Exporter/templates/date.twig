{% if (assessment is project or assessment is task) %}
    {% set large = 6 %}
{% else %}
    {% set large = 3 %}
{% endif %}

{% if dateType == 'publish' %}
    {% set date = unitImplementation.openDate.local %}
    {% set endSync = 'open' %}
{% elseif dateType == 'open' %}
    {% set date = unitImplementation.openDate.local %}
    {% set startSync = 'publish' %}
    {% set endSync = 'due' %}
{% elseif dateType == 'due' %}
    {% set date = unitImplementation.dueDate.local %}
    {% set startSync = 'open' %}
    {% set endSync = 'close' %}
{% else %}
    {% set date = unitImplementation.dueDate.local %}
    {% set startSync = 'due' %}
{% endif %}

<div class="small-12 medium-6 large-{{ large }} columns">
    <label for="{{ dateType }}Date-{{ unitImplementation.id }}">{{ dateType|capitalize }} Date</label>
    <input id="{{ dateType }}Date-{{ unitImplementation.id }}"
           name="unit[{{ unitImplementation.id }}][{{ dateType }}]"
           type="text"
           value="{{ date }}"
           data-datepicker
           data-datepicker-time
           data-datepicker-format="datetime"
           data-datepicker-buttontext=""
           {% if startSync %}data-datesync-startdate="#{{ startSync }}Date-{{ unitImplementation.id }}"{% endif %}
            {% if endSync %}data-datesync-enddate="#{{ endSync }}Date-{{ unitImplementation.id }}"{% endif %}
    />
</div>