{#
    'courseImpl'                CourseImplementationModel    - The course implementation into which the unitSpec may be exported
    'folderWritePerms'          bool[]                       - Does current user have WRITE+ perm to the class folder
    'courseOutlineComponentIds' int[]                        - The IDs of course outline component_instance rows
                                                               from components attached to the same folder as the courseImpl.

    NOTE: If the ability to overwrite existing units is ever needed, see https://github.com/alaress/schoolbox/pull/28644.
#}
{% set isInstructor = folderWritePerms[courseImpl.folder.id] %}

<script type="text/javascript">
    $(function () {
        const $checkbox = $('#import-{{ courseImpl.id }}');
        const courseId = $checkbox.attr('data-course-id');

        // Toggle date fields
        $checkbox.change(function () {
            const datesContainer = $('#course-' + courseId + '-dates');

            if ($checkbox.prop('checked') && !$checkbox.prop('disabled')) {
                datesContainer.removeAttr('hidden');
                datesContainer.find('input').attr('required', true);
            } else {
                datesContainer.attr('hidden', true);
                datesContainer.find('input').removeAttr('required');
            }
        });

        $checkbox.change(); // Run function on page load.
    });
</script>

<li>
    <div class="small-12 columns">
        <div class="selector">
            <input type="checkbox"
                   id="import-{{ courseImpl.id }}"
                   name="courseImplementationIds[{{ courseImpl.id }}]"
                   value="1"
                   {% if not isInstructor %}disabled{% endif %}
                   data-course-id="{{ courseImpl.id }}"/>
            <label for="import-{{ courseImpl.id }}" class="checkbox-label"></label>
        </div>
        <div class="card small-12">
            <span class="size-32 icon-home"></span>
            <h3>
                <a href="/homepage/{{ courseImpl.folder.id }}"
                    {% if courseOutlineComponentIds|length == 0 %}
                        class="strike"
                        title="This course is not linked with a course outline component. You can still import units into this course but they won't be visible on the Class homepage."
                    {% endif %}
                >{{ courseImpl.folder.title }}</a>
                {% for courseOutlineComponentId in courseOutlineComponentIds %}
                    <a href='/homepage/{{ courseImpl.folder.id }}#component{{ courseOutlineComponentId }}'>
                        (with linked course outline component)
                    </a>
                {% endfor %}
                <span class='pipe meta'>Course imported on {{ courseImpl.createdAt.long }}</span>
            </h3>
            <p class="meta">
                {% if not isInstructor %}
                    You don't have write permission for this class.
                {% endif %}
            </p>
        </div>
    </div>
    <div class="list-item" id="course-{{ courseImpl.id }}-dates" hidden>
        {% set dateFieldsInfo = [
            {type: 'open' , label: 'Open' },
            {type: 'close', label: 'Close'},
        ] %}
        {% for dateFieldInfo in dateFieldsInfo %}
            {% include '@learningAssessmentExporter/export_unit_row_date.twig' with {
                dateType:             dateFieldInfo.type,
                label:                dateFieldInfo.label,
                courseImplementation: courseImpl,
            } only %}
        {% endfor %}
    </div>
</li>
