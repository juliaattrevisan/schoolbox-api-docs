@startuml
'https://plantuml.com/sequence-diagram

actor Teacher as TC
actor Student as ST
participant Schoolbox as SB
participant "LTI Tool" as LTI

group Create LTI assessment
    TC -> SB: create SB assessment for association with LTI
    SB -> LTI: send request to create LTI assessment
    LTI -> SB: return link to new LTI assessment
    SB -> SB: associate new LTI assessment with SB assessment
end

group Attempt LTI assessment
    ST -> SB: visit assessment summary page
    SB -> LTI: redirect student to LTI assessment
    LTI -> LTI: student attempts LTI assessment
    LTI -> SB: student gets sent back to SB
    SB -> SB: trigger mark synchronisation for assessment (student attempt only)
end

group Mark LTI assessment
    TC -> SB: visit assessment status page
    SB -> LTI: redirect teacher to LTI assessment
    LTI -> LTI: teacher marks LTI assessment attempts
    LTI -> SB: teacher gets sent back to SB
    SB -> SB: trigger mark synchronisation for assessment
end

group Mark synchronisation
    SB -> LTI: request marks for LTI assessment
    LTI -> SB: return marks
    SB -> SB: determine which marks are new, and update them
end

@enduml
