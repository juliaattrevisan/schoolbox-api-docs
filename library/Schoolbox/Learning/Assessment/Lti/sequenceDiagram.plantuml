@startuml
'https://plantuml.com/sequence-diagram

actor Teacher as TC
actor Student as ST
participant "LTI Platform\n(Schoolbox)" as SB
participant "LTI Tool\n(Google Classroom, MS Teams Classes)" as LTI

group Create LTI assessment
    TC -> SB: visit create assessment page
    SB -> SB: create assessment
    SB -> LTI: send request to create LTI assessment
    note right
    The LTI Platform must pass a resource link
    to the LTI Tool.

    This will probably take the form of a
    "Resource link launch request message".
    end note
    LTI -> SB: return link to new LTI assessment
    SB -> SB: associate new LTI assessment with SB assessment
end

group Attempt LTI assessment
    ST -> SB: visit assessment summary page
    SB -> LTI: redirect student to LTI assessment
    LTI -> LTI: student attempts LTI assessment
    LTI -> SB: student gets sent back to SB
    SB -> SB: create response to assessment
end

group Mark LTI assessment
    TC -> SB: visit assessment status page
    SB -> LTI: redirect teacher to LTI assessment
    LTI -> LTI: teacher marks LTI assessment attempts
    LTI -> SB: teacher gets sent back to SB
end

group Mark update
    LTI -> SB: update mark
    note left
    The LTI Platform must implement the
    Score Publish Service.
    end note
    SB -> SB: write mark
end

@enduml
