{# Inline Grader for a particular Response

This lets you create Associated Feedback along with grade, comment and assorted feedback files etc.

Usage:
    assessment        DueWork\Model                  The DueWork being assessed
    breadcrumbs       Collection|string[][]          An array of label + URL pairs
    response          null|DueWork\Submission
    latestFeedback    null|DueWork\Feedback
    attachzone        array
    selectedFileHash  string
    markSchemeName    string
    carousel          StudentCarousel
    submissionStates  Collection|DueWork_Error[]
    responseList      Collection|DueWork\Submission
    file              null|File\Model
    subfragment       null|string[]
    errors            string[]
    participant       Participant
    plagscanEnabled   bool
    rubricContext     null|array
    interactionLocked bool                             Is the assessment due in an archived term?
 #}

{# Required in both self-assess/reflect and regular staff inline grading #}
<script type="text/javascript">
    $(function() {
        var nextHref = findNext(tgt);

        {# Use the next human's href, otherwise go back to assessment's status screen #}
        if (nextHref.data('value') !== undefined) {
            var nextUrl = nextHref.data('value');
        }
        else {
            var nextUrl = '{{ routeLookup("learningAssessment.getStatus", {assessmentId: assessment.id}) }}';
        }
    });
</script>

{% set readonly = interactionLocked and not USER.superUser %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

{% set hasCarousel = true %}
{% if hasCarousel %}
    {% include '@learningDueWorkResponse/inlineGrading/participantCarousel.twig' with {
        carousel: carousel,
        participant: participant
    } only %}
{% endif %}

{% include '@learningDueWorkResponse/inlineGrading/meta.twig' with {
    locale: locale,
    assessment: assessment,
    participant: participant,
    responseList: responseList,
    response: response,
    readonly: readonly,
    deleteRoute: deleteRoute
} only %}

{% include '@learningDueWorkResponse/inlineGrading/dynamicFeedback.twig' with {
    publishText: 'Publish And Continue'
} only %}

{% set deleteRoute = routeLookupIfAuthorized('learningDueWorkResponse.deleteParticularResponse', { assessmentId: assessment.id, responseId: response.id, response: response }) %}

<script type="application/javascript" src="/javascript/shared/submissions/jquery.kami-export.js"></script>
<script type="text/javascript">
    $(function() {
        $('#continue-button').attr('href', nextUrl);

        {# When a different response is selected from dropdown, navigate to its URL #}
        $('#response-selector').change(function(event) {
            event.preventDefault();
            window.location.href = $(this).find('option:selected').attr('data-url');
        });

        {% if deleteRoute %}
        $('#header-options').find('[data-delete]').on('click', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                header: 'Delete Submission',
                format: 'html',
                text: 'Are you sure you want to delete this submission? Anything attached to it will also be deleted.',
                confirmLabel: 'Delete',
                cancelLabel: 'Cancel',
                confirmEvent: function() {

                    // A toast
                    var $toast = $('#toaster');
                    $toast.toastActivate({text: 'Deleting submission...'});

                    $.ajax(element.data('delete'), {
                        headers: {
                            'X-HTTP-Method-Override': 'DELETE'
                        },
                        dataType: 'json',
                        type: 'POST'
                    })
                        .done(function () {

                            {# If there are no submissions remaining, go to next person
                             # Otherwise just refresh screen
                             #}
                            var destination;
                            if ($('#response-selector').find('option').length < 2) {
                                destination = nextUrl;
                            }
                            else {
                                {# Reload summary screen to find what is now the most
                                 # recent submission
                                 #}
                                destination = '{{ routeLookup('learningDueWorkResponse.getParticularResponse', {assessmentId: assessment.id, studentId: participant.user.id}) }}'
                            }

                            {# Go to next available person in the carousel
                             # If there is nobody, just visit Status screen
                             #}
                            window.location.href = destination;
                        })
                        .fail(function () {
                            $toast.toastTimeout({
                                text: 'Could not delete this submission',
                                css: 'pop alert'
                            });
                        })
                }
            });
        });
        {% endif %}

        // Activate export of Kami Documents
        $('[data-kami-export]').kamiExport({
            toast: $('#toaster')
        });
    });
</script>

{% if responseList|length > 1 %}
<div class="row">
    <div class="small-12 columns">
        <select id="response-selector" title="Select a Submission">
            {% for currentResponse in responseList %}
                {% set viewRoute = routeLookupIfAuthorized('learningDueWorkResponse.getParticularResponse', {assessmentId: assessment.id, studentId: participant.user.id, responseId: currentResponse.id, response: currentResponse, participant: participant}) %}

                {% if viewRoute %}
                <option value="{{ currentResponse.id }}" {% if currentResponse.id == response.id %}selected="selected"{% endif %} data-url="{{ viewRoute }}">#{{ loop.revindex }}. Submission at {{ currentResponse.submittedAt.local }}</option>
                {% endif %}
            {% endfor %}
        </select>
    </div>
</div>
{% endif %}

{% if response and file %}
    {% include '@learningDueWorkResponse/inlineGrading/strategy/' ~ subfragment.strategy with {data: subfragment.data} %}
{% endif %}

{% if response and response.allFiles.count %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Files</h2>
        <ul class="inline-grader-filelist grid small-block-grid-1 medium-block-grid-2">
            {% for currentFile in response.allFiles %}
                {% set selected = '' %}
                {% set defaultSelectedFile = selectedFileHash|length == 0 and loop.index0 == 0 %}
                {% set hasSelectedFile = selectedFileHash|length and currentFile.hash == selectedFileHash %}

                {% if hasSelectedFile or defaultSelectedFile %}
                    {% set selected = 'selected' %}
                {% endif %}

                <li class="actions-small-2 {{ selected }} inline-grader-file">
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="{{ routeLookup('learningDueWorkResponse.getParticularResponse', {assessmentId: response.assessable.id, studentId: response.submittedOnBehalfOf.id, responseId: response.id, response: response}) }}?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}">
                                <img src="/ajax/mime/{{ currentFile.mime }}" alt="Download" class="mime" />
                                <p>{{ currentFile.filename }}</p>
                            </a>
                            {% include '@learning/dueWork/plagscan/status.twig' %}
                        </div>
                    </div>
                    <nav>
                        {% include '@learning/dueWork/plagscan/link.twig' with {assessment: assessment, response: response, plagscan: currentFile.plagscan, participant: participant} only %}
                        <a class="icon-download" title="" data-dropdown="download-options-{{ currentFile.id }}"></a>
                    </nav>
                    <ul id="download-options-{{ currentFile.id }}" class="f-dropdown" data-dropdown-content>
                        {% if currentFile.kami %}
                            {% set kamiExportRoute = routeLookupIfAuthorized('learningDueWorkResponse.getKamiExport', {
                                kamiId:       currentFile.kami.id,
                                assessment:   response.assessable,
                                participant:  participant,
                                feedback:     latestFeedback
                            }) %}
                            {% if kamiExportRoute %}
                                <li><a href="{{ kamiExportRoute }}" data-kami-export class="icon-download" title="Download annotated document">Download annotated document</a></li>
                            {% endif %}
                        {% endif %}
                        <li>
                            <a href="/storage/fetch.php?hash={{ currentFile.hash }}&save=true" class='icon-download' title="Download original">Download original</a>
                        </li>
                    </ul>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Feedback</h2>
    </div>
</div>

{# Not the most recent response? Say so, and give a CTA to show the most recent. #}
{% if not isMostRecentResponse %}
    <div class="row">
        <div class="small-12 columns">
            <div class="alert-box warning">
                This is not the most recent response for this due work.
                {% set mostRecentResponseRoute = routeLookup('learningDueWorkResponse.getParticularResponse', {assessmentId: response.assessable.id, studentId: response.submittedOnBehalfOf.id}) %}
                {% if not readonly %}
                    You should consider giving feedback for <a href="{{ mostRecentResponseRoute }}">the most recent response</a> instead.
                {% else %}
                    <a href="{{ mostRecentResponseRoute }}">View the most recent response</a>.
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}

<div class="row mark-scheme" id="assessment-status" data-participant>
    <div class="small-12 island">
        <section class="content">

            <form method="post" data-feedback-form action="{{ routeLookupIfAuthorized('learningDueWorkFeedback.postResponseFeedback', {assessmentId: assessment.id, studentId: participant.user.id, responseId: response.id, participant: participant}) }}">
                <input type="hidden" name="responseId" value="{{ response.id }}" />

                <div class="row">

                    {% if assessment.useRubric and rubricContext %}
                        <div class="small-12 island">
                            {% set rubricTemplate = readonly
                                ? 'grid.twig'
                                : 'grid-markable.twig'
                            %}
                            {% include '@rubric/' ~ rubricTemplate with {
                                rubric:         rubricContext.rubric,
                                markType:       rubricContext.markType,
                                markVisibility: participant.assessable.isFeedbackVisibleToUser(USER)
                            } only %}
                        </div>

                        <script type="text/javascript">
                            $(function () {

                                // cache this stuff, it doesn't change
                                var $status                 = $('#assessment-status'),
                                    $markInput              = $status.find('[data-mark-input]'),
                                    $assignFromRubricButton = $('#use-rubric-value'),
                                    $rb                     = $('#rb-{{ rubricContext.rubric.id }}'),
                                    $finalSummary           = $rb.find('[data-final-summary]');


                                function refreshAssignFromRubricButton() {
                                    var currentRubricValue = $.trim($finalSummary.text());
                                    var currentMarkInput   = $markInput.val();

                                    $assignFromRubricButton.prop('disabled', currentRubricValue === currentMarkInput);
                                }


                                {##
                                 # Use the rubric value in the mark input field
                                 #
                                 # Disabled upon load, since values are the same
                                 # at this point in time. Also disables when copying
                                 # the rubric mark value in.
                                 #}
                                $assignFromRubricButton.on('click', function(e) {

                                    e.preventDefault();
                                    $(this).prop('disabled', true);

                                    $status
                                        .find('[data-mark-input]')
                                        .val($.trim($finalSummary.text()))
                                        .change();
                                });

                                // listen for this
                                $rb.on('change', '[data-rubric], [data-rubric-group]', refreshAssignFromRubricButton);
                                $markInput.on('change', refreshAssignFromRubricButton);

                                // do it on pageload anyway
                                refreshAssignFromRubricButton();
                            });
                        </script>
                    {% endif %}

                    {% if 'none' != markSchemeName | lower %}
                        <div class="small-12 medium-3 column">
                            <label>{{ locale.grades.proper }}
                                {% include '@learningMarkScheme/'~markSchemeName~'.twig' with {
                                    participant: participant,
                                    feedback:    latestFeedback,
                                    markScheme:  assessment.markScheme,
                                    tabIndex:    1,
                                    errors:      errors,
                                    readonly:    readonly
                                } only %}
                            </label>

                            {% if assessment.useRubric and rubricContext and not readonly %}
                                <p><button id="use-rubric-value" class="full-width">Assign {{ locale.grades.proper }} from Rubric</button></p>
                            {% endif %}
                        </div>
                    {% endif %}

                    <div class="small-12{% if 'none' != markSchemeName | lower %} medium-9{% endif %} column">
                        {% include '@learningAssessment/dueWork/comment.twig' with {
                            participant: participant,
                            feedback:    latestFeedback,
                            tabIndex:    2,
                            readonly:    readonly
                        } only %}
                    </div>

                    {# Maybe files may be uploaded here? #}
                    {% if attachzone and not readonly %}
                        <div class="small-12 columns">
                            {% include 'sub/attachzone.twig' with {attachzone: attachzone} only %}
                        </div>
                    {% endif %}


                    {# Action Bar #}
                    {% set isDraftFeedback     = latestFeedback and not latestFeedback.published %}
                    {% set isPublishedFeedback = latestFeedback and latestFeedback.published %}

                    {% spaceless %}
                        {% set buttons %}
                            <span class="button disabled" data-draft="drafted" title="You can discard this draft from the Grading Overview screen" {% if not isDraftFeedback %}style="display:none;"{% endif %}>Saved as Draft</span>
                            {% if not readonly %}
                                <a class="button" id="continue-button">Continue</a>
                                <a class="button"
                                   data-draft="publish"
                                   {% if isPublishedFeedback %}style="display:none;"{% endif %}
                                >Publish and Continue</a>
                            {% endif %}
                        {% endset %}
                    {% endspaceless %}

                    {% include '@learningAssessment/fragments/actionBar.twig' with {
                        actionStyle:  '',
                        buttons:      buttons
                    } only %}
                </div>
            </form>
        </section>
    </div>
</div>

<script src="/javascript/shared/submissions/jquery.combobox.js" type="text/javascript"></script>
<div id='toaster' class="toast" data-alert data-save-draft></div>


