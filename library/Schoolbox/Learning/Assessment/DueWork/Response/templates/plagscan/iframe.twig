{% import 'sub/breadcrumbs.twig' as bread %}

{# Conditional bread?? -_-
 #}
{% if assessment.context is project %}
    {% set nodes = [
    ['Learning', routeLookup('learning.getClasses')],
    [assessment.context.folder.name, routeLookup('learningMarkbook.getMarkbookForClass', {folderId: assessment.context.folder.id}) ],
    [assessment.context.title, routeLookup('learningAssessment.getSummary', {assessmentId: assessment.context.id, studentId: response.submittedOnBehalfOf.id}) ],
    [assessment.title, routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id})],
    ['Inline Grader', routeLookup('learningDueWorkResponse.getParticularResponse', {assessmentId: assessment.id, studentId: response.submittedOnBehalfOf.id, responseId: response.id, response: response})],
    ['Similarity Report', null]
    ] %}
{% else %}
    {% set nodes = [
    ['Learning', routeLookup('learning.getClasses')],
    [assessment.context.folder.name, routeLookup('learningMarkbook.getMarkbookForClass', {folderId: assessment.context.folder.id})],
    [assessment.title, routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id})],
    ['Inline Grader', routeLookup('learningDueWorkResponse.getParticularResponse', {assessmentId: assessment.id, studentId: response.submittedOnBehalfOf.id, responseId: response.id, response: response})],
    ['Similarity Report', null]
    ] %}
{% endif %}

{{ bread.crumbsArray(nodes)}}

{% if interactiveAvailable %}
    <iframe class="fullscreen scroll-wrapper" src="{{ plagscan.interactiveUrl }}"></iframe>
{% else %}
    <iframe class="fullscreen scroll-wrapper" src="{{ routeLookupIfAuthorized('learningDueWorkResponse.getPlagscanReportContents', {
        assessmentId: assessment.id,
        assessment:   assessment,
        responseId:   response.id,
        response:     response,
        participant:  participant,
        plagscanId:   plagscan.plagscanId})
    }}"></iframe>
{% endif %}

