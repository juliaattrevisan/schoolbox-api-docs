{##
 # Metadata for the person doing the marking
 #
 # locale
 # IAssessable assessment
 # IResponse response
 # Collection|IResponse[] responseList
 # string deleteRoute
 # @param bool blindMode
 #}
{% import '@learning/macro/dueDate.twig' as dueDate %}

{% include '@learningDueWorkResponse/inlineGrading/fragments/deleteSubmission.twig' with {
    assessment: assessment,
    participant: participant,
    blindMode: blindMode ?? false
} only %}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1 data-test="assessment-response-meta-title">{{ title }} {{ assessment.title }}</h1>
            <ul class="meta">
                <li><sbx-icon name="calendar"></sbx-icon> {{ dueDate.forParticipant(participant) }}</li>
                <li><sbx-icon name="due-work"></sbx-icon> <a href="/homepage/{{ assessment.context.folder.id }}">{{ assessment.context.title }}</a> {{ assessment.typeName }}</li>
                {% if responseList|length == 1 %}
                    <li><sbx-icon name="calendar"></sbx-icon> Submitted {{ response.submittedAt.short }}</li>
                {% endif %}
                {% if readonly %}
                    <li><sbx-icon name="archive"></sbx-icon> {{ locale.term.proper }} has been archived</li>
                {% endif %}
            </ul>
        </div>
    </div>

    {% if summaryRoute %}
        <nav>
            <sbx-pop-out content-id="header-options"></sbx-pop-out>
        </nav>


        <ul id="header-options" class="f-dropdown" data-dropdown-content>
            <li><a class="sbx-button--has-icon" href="{{ summaryRoute }}"><sbx-icon name="history"></sbx-icon>{{ locale.submissionHistory.proper }}</a></li>
            {% if response and deleteRoute %}
                <li><a class="sbx-button--has-icon" data-delete="{{ deleteRoute }}"><sbx-icon name="delete"></sbx-icon>Delete Submission</a></li>
            {% endif %}
        </ul>
    {% endif %}
</div>
