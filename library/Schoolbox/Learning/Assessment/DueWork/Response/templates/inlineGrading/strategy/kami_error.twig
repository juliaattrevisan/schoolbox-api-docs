{#
    Informs user why we are unable to display expected Kami iFrame.

    Data:
        data.reason      string
        data.resolution  null|string
        data.date        null|AlaressDateFormat
#}
<div class="row">
    <div class="small-12 columns">
        <div class="empty-state">
            <sbx-icon name="info" size="2.5rem"></sbx-icon>
            <h2>Sorry, we are unable to display this Kami document</h2>

            <p>Processing failed for the following reason: {{ data.reason }}</p>

            {% if data.resolution is defined %}<p>{{ data.resolution }}</p>{% endif %}

            {% if data.date %}
                <p><br>Issue occurred at {{ data.date.long }}, further information has been logged.</p>
            {% endif %}
        </div>
    </div>
</div>
