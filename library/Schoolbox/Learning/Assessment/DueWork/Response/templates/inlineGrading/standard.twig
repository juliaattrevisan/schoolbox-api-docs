{##
 # Inline Grader for a particular Response
 #
 # The normal way staff/teachers mark Students' work

This lets you create Associated Feedback along with grade, comment and assorted feedback files etc.

Usage:
    assessment        DueWork\Model                  The DueWork being assessed
    breadcrumbs       Collection|string[][]          An array of label + URL pairs
    response          null|DueWork\Submission
    feedback    null|DueWork\Feedback
    attachzone        array
    selectedFileHash  string
    markSchemeName    string
    carousel          StudentCarousel
    responseList      Collection|DueWork\Submission
    file              null|File\Model
    subfragment       null|string[]
    errors            string[]
    participant       Participant
    plagscanEnabled   bool
    interactionLocked bool                             Is the assessment due in an archived term?
    reviewRoute       string                           The mechansim by which feedback is being given
 #}

{# Required in both self-assess/reflect and regular staff inline grading
 # Don't remove this; it'll cause javascript Undefined errors
 #}
{% block nextUrl %}
    <script>
        var nextUrl = '';
    </script>
{% endblock %}

{# Vars required in both contexts
 # These vars exist regardless of who is looking
 #}
{% set readonly = interactionLocked and not USER.superUser %}

{# Breadcrumbs are always present #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

{# Participant Carousel #}
{% block participantCarousel %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/participantCarousel.twig' with {
        carousel: carousel,
        participant: participant,
        assessment: assessment
    } only %}
{% endblock %}

{# These includes vary depending on who is viewing this page:
 # * Teachers doing their usual grading
 # * Students self-reflecting
 #}
{% block meta %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/meta.twig' with {
        title: locale.grading.proper,
        assessment: assessment,
        participant: participant,
        responseList: responseList,
        response: response,
        readonly: readonly,
        deleteRoute: routeLookupIfAuthorized('learningDueWorkResponse.deleteParticularResponse', { assessmentId: assessment.id, responseId: response.id, response: response })
    } only %}
{% endblock %}

{# Javascript that powers the feedback form #}
{% block dynamicFeedback %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/dynamicFeedback.twig' with {
        publishText: 'Publish And Continue',
        publishingText: 'Publishing...',
        publishedText: 'Feedback published'
    } only %}
{% endblock %}

{# List of Responses from which the user can choose #}
{% block responseList %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/responseList.twig' with {
        assessment: assessment,
        participant: participant,
        responseList: responseList,
        response: response
    } only %}
{% endblock %}

{# A preview of the file currently selected #}
{% block responseFilePreview %}
    {% if response and file %}
        {% include '@learningDueWorkResponse/inlineGrading/strategy/' ~ subfragment.strategy with {data: subfragment.data is defined ? subfragment.data : null} %}
    {% endif %}
{% endblock %}

{# A list of files in the current response #}
{% block responseFileList %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/responseFileList.twig' with {
        assessment: assessment,
        participant: participant,
        response: response,
        latestFeedback: feedback,
        kamiEnabled: true,
        plagscanEnabled: plagscanEnabled,
        selectedFileHash: selectedFileHash
    } only %}
{% endblock %}

{# A subheading for the grading part #}
{% block subheading %}
    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">Feedback</h2>
        </div>
    </div>
{% endblock %}

{# No instructions for the inline grader screen #}
{% block instructions %}{% endblock %}

{# Not the most recent response? Say so, and give a CTA to show the most recent. #}
{% block mightBeOutofDate %}
    {% if not isMostRecentResponse %}
        <div class="row">
            <div class="small-12 columns">
                <div class="alert-box warning">
                    This is not the most recent response for this due work.
                    {% set mostRecentResponseRoute = routeLookup('learningDueWorkResponse.getParticularResponse', {assessmentId: response.assessable.id, studentId: response.submittedOnBehalfOf.id}) %}
                    {% if not readonly %}
                        You should consider giving feedback for <a href="{{ mostRecentResponseRoute }}">the most recent response</a> instead.
                    {% else %}
                        <a href="{{ mostRecentResponseRoute }}">View the most recent response</a>.
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{# Grading logic and structure #}
<div class="row mark-scheme" id="assessment-status" data-participant>
    <div class="small-12 island">
        <form method="post" data-feedback-form="{{ participant.user.id }}" action="{{ routeLookupIfAuthorized('learningDueWorkFeedback.postResponseFeedback', {
            assessmentId: assessment.id,
            studentId:    participant.user.id,
            responseId:   response.id,
            assessment:   assessment,
            student:      participant.user
        }) }}">
            <section>
                <input type="hidden" name="responseId" value="{{ response.id }}" />
                {# Required so that this form is recognised as containing a rubric and files #}
                <input name="fromInlineGrader" value="true" type="hidden"/>

                {# Settings for the rubric grid #}
                {% set showDescriptorValue = true %}
                {% set showGroupTotal = assessment.markPerCapability %}
                {% set showRubricTotal = true %}
                {% set self = 'none' %}

                {% block rubricGrid %}
                    {% if assessment.useRubric %}
                        <fieldset class="content">
                            {% set rubricTemplate = readonly
                                ? 'grid.twig'
                                : 'grid-markable.twig'
                            %}
                            {% set rubricMarkedGrid = feedback is not null ? feedback.rubricMarkedGrid : null %}

                            {% include '@rubric/' ~ rubricTemplate with {
                                rubricGrid: assessment.rubricGrid,
                                rubricMarkedGrid: rubricMarkedGrid,
                                selfAssessmentFeedback: selfAssessmentFeedback ?? null,
                                learner: participant.user,
                                markVisibility: participant.assessable.isFeedbackVisibleToUser(USER),
                                showDescriptorValue: showDescriptorValue,
                                showGroupTotal: showGroupTotal,
                                showRubricTotal: showRubricTotal,
                                self: self,
                                studentView: studentView,
                                selfAssess: selfAssess,
                                selfReflect: selfReflect
                            } only %}
                        </fieldset>
                    {% endif %}
                {% endblock %}

                {# A hole for readonly self-reflection content
                 # Used when the Instructor wants to see the self-reflection while providing Feedback
                 # Presence of a Learner-authored (marker, owner) tuple activates this
                 #}
                {% block readonlyFeedback %}
                    {% if selfAssessmentFeedback %}
                        {% import '@learning/macro/urgency.twig' as urgency %}
                        <fieldset class="content">
                            <div class="small-12 columns">
                                <fieldset>
                                    <legend>
                                        {% spaceless %}
                                            {% if selfAssessmentFeedback.isSelfGrading %}
                                                {{ locale.selfAssessment.proper }}
                                            {% else %}
                                                {{ locale.selfReflection.proper }}
                                            {% endif %}
                                        {% endspaceless %}
                                    </legend>
                                    <div class="flex-grade">
                                        <ul class="information-list threaded sibling">
                                            <li>
                                                <ul class="information-list reply">
                                                    <li>
                                                        <div class="card small-12">
                                                            <a href="/search/user/{{ participant.user.id }}">
                                                                <img src="/portrait.php?userId={{ participant.user.externalId }}&amp;size=square32" title="{{ participant.user.fullname }}" />
                                                                <p>{{ participant.user.fullname }}<span class="pipe meta">{{ selfAssessmentFeedback.publishedAt.short }}</span></p>
                                                            </a>
                                                        </div>
                                                        <article>{{ selfAssessmentFeedback.comment|nl2br }}</article>
                                                    </li>
                                                </ul>
                                            </li>
                                        </ul>
                                        <div class="grade {{ urgency.marks(selfAssessmentFeedback.normalisedMark) }}-bg">
                                            <span>{{ selfAssessmentFeedback.humanReadableMark }}</span>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                        </fieldset>
                    {% endif %}
                {% endblock %}

                {# The little grades input combobox #}
                <fieldset class="content">
                    {% block gradeValue %}
                        {% if 'none' != markSchemeName | lower %}
                            <div class="small-12 medium-3 column">
                                <label>{{ locale.grades.proper }}
                                    {% include '@learningMarkScheme/'~markSchemeName~'.twig' with {
                                        participant: participant,
                                        feedback: feedback,
                                        markScheme: assessment.markScheme,
                                        tabIndex: 1,
                                        errors: errors,
                                        readonly: readonly
                                    } only %}
                                </label>

                                {% if assessment.useRubric and not readonly %}
                                    {% include '@learningDueWorkResponse/inlineGrading/fragments/assignFromRubricButton.twig' with {
                                        locale: locale,
                                        rubricId: assessment.rubricGrid.id,
                                    } only %}
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endblock %}

                    {# Feedback comment textarea #}
                    {% block comment %}
                        <div class="small-12{% if 'none' != markSchemeName | lower %} medium-9{% endif %} column">
                            {% include '@learningAssessment/dueWork/comment.twig' with {
                            participant: participant,
                            feedback: feedback,
                            tabIndex: 2,
                            readonly: readonly
                            } only %}
                        </div>
                    {% endblock %}
                </fieldset>

                {# Maybe files may be uploaded here? #}
                {% block attachzone %}
                    {% if attachzone and not readonly %}
                        <fieldset class="content">
                            <div class="small-12 columns">
                                {% include 'sub/attachzone.twig' with {attachzone: attachzone} only %}
                            </div>
                        </fieldset>
                    {% endif %}
                {% endblock %}

                {# Action Bar #}
                {% set isDraftFeedback     = feedback and not feedback.published %}
                {% set isPublishedFeedback = feedback and feedback.published %}

                {% block actionButtons %}
                    {% spaceless %}
                        {% set buttons %}
                            <span class="button disabled" data-draft="drafted" title="You can discard this draft from the Grading Overview screen" {% if not isDraftFeedback %}style="display:none;"{% endif %}>Saved as Draft</span>
                            {% if not readonly %}
                                <a class="button" id="continue-button">Continue</a>
                                <a class="button"
                                   data-draft="publish"
                                   {% if isPublishedFeedback %}style="display:none;"{% endif %}
                                >Publish and Continue</a>
                            {% endif %}
                        {% endset %}
                    {% endspaceless %}

                    {% include '@learningAssessment/fragments/actionBar.twig' with {
                    actionStyle:  '',
                    buttons: buttons,
                    participant: participant
                    } only %}
                {% endblock %}
            </section>
        </form>
    </div>

<script src="/javascript/shared/submissions/jquery.combobox.js" type="text/javascript"></script>

<div id='toaster' class="toast" data-alert data-save-draft></div>
</div>
