{##
  Student Selector Carousel

  Cycle through students participating in an $assessment

  Usage:
    @param array       carousel.allPeople     - an array of people who populate the selector
    @param string      carousel.currentPerson - the getParticularResponse url for the current response's submittedOnBehalfOf
    @param Participant participant            - currently displayed participant
    @param DueWork     participant.assessable - the assessment to which this Submission belongs
    @param bool        blindMode              - whether you're reviewing in Blind Mode
 #}
<script src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script>

    {# A global var because the Feedback form uses the carousel to determine
     # the next person to continue towards, once Feedback is published
     #
     # Same with findNext() and findPrev()
     #
     # sorry
     #}
    var tgt;

    /**
     * Next person in the carousel
     */
    function findNext(tgt) {
        var ize = tgt[0].selectize;
        var val = ize.getOption(ize.getValue());

        return ize.getAdjacentOption(val, 1);
    }

    /**
     * Previous person in the carousel
     *
     * @param tgt
     * @returns {*|Object}
     */
    function findPrev(tgt) {
        var ize = tgt[0].selectize;
        var val = ize.getOption(ize.getValue());

        return ize.getAdjacentOption(val, -1);
    }

    $(function() {
        var navNext = $('a[rel="next"]');
        var navPrev = $('a[rel="prev"]');
        var markInput = $('[name^="mark"]').not('[type=hidden]').eq(0);

        tgt = $('select[name=student-select]');
        var ize,
            showSubmittedOnly = $('#showSubmittedOnly'),
            students = {{ carousel.allPeople|json_encode|raw }},
            selectizeOptions = {
                preload: true,
                closeAfterSelect: false,
                options: students,
                render: {
                    option: function (item) {
                        item.disabled = showSubmittedOnly.is(':checked') && !item.submitted;
                        return $('<div/>').html(item.html).html();
                    },
                    item: function (item) {
                        return $('<div/>').html(item.html).html();
                    }
                }
            };

        ize = tgt.selectize(selectizeOptions);

        // hack, option not available
        $('.selectize-input input').prop('disabled', true).hide();

        // manually set the value, because selectize
        ize[0].selectize.setValue("{{ carousel.currentPerson }}", true);

        // add the listener AFTER we've set the value
        ize.on('change', function (e) {
            window.location.href = e.target.value;
        });

        function refreshNav(nav, source) {
            if (source.length) {
                nav.attr('href', source.data('value'))
                        .attr('title', source.children('img').attr('alt'))
                        .removeAttr('disabled');
            } else {
                nav.removeAttr('href')
                        .removeAttr('title')
                        .attr('disabled', 'disabled');
            }
        }

        showSubmittedOnly.on('change.preload', function (event) {
            var ize = tgt[0].selectize,
                    skip = $(this).is(':checked') ? 1 : 0,
                    form = $(this).closest('form');

            // clear the selectize render cache
            ize.renderCache.option = {};

            ize.refreshOptions(false);

            if (event.namespace != 'preload') {
                $.ajax('{{ routeLookup('learningAssessment.patchUpdateAssessment', { assessmentId: participant.assessable.id, assessment: participant.assessable }) }}', {
                    headers: {
                        'X-HTTP-Method-Override': 'PATCH'
                    },
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        showSubmittedOnly: skip
                    }
                });
            }

            var nextUrl = findNext(tgt);
            var prevUrl = findPrev(tgt);

            refreshNav(navNext, nextUrl);
            refreshNav(navPrev, prevUrl);

        }).trigger('change.preload');
    });
</script>
<script>
    $(function() {
        var nextHref = findNext(tgt);

        {# Use the next human's href, otherwise go back to assessment's status screen #}
        if (nextHref.data('value') !== undefined) {
            nextUrl = nextHref.data('value');
        }
        else {
            nextUrl = '{{ routeLookup("learningAssessment.getStatus", {assessmentId: assessment.id}) }}';
        }

        $('#continue-button').attr('href', nextUrl);
    });
</script>
<div class="row">
    <div class="small-12 medium-8 columns">
        <div class="avatar-switch">
            <nav>
                <a rel="prev" href="" title=""></a>
            </nav>
            <div class="student">
                <select name="student-select"></select>
            </div>
            <nav>
                <a rel="next" href="" title=""></a>
            </nav>
        </div>
    </div>
    <div class="small-12 medium-4 columns">
        <form action="{{ routeLookup('learningAssessment.patchUpdateAssessment', { assessmentId: participant.assessable.id, assessment: participant.assessable }) }}" method="post">
            <input type="hidden" name='assessmentId' value="{{ participant.assessable.id }}" />
            <input type="hidden" name="skipUnsubmitted" value="0" />

            {% if blindMode %}
                <input type="checkbox" name="showSubmittedOnly" id="showSubmittedOnly" checked="checked" disabled="disabled" />
            {% else %}
                <input type="checkbox" name="showSubmittedOnly" id="showSubmittedOnly" {% if participant.assessable.showSubmittedOnly %}checked="checked"{% endif %} value='1' />
            {% endif %}

            <label for="showSubmittedOnly" class="checkbox-label">Show unmarked submissions <span class='hint has-tip tip-top' title="If selected, you will only see student submissions that need to be marked." data-tooltip="">?</span></label>
        </form>
    </div>
</div>
