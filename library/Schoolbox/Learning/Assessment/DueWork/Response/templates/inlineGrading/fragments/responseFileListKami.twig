{##
 # Make a list of files that were in this IResponse
 # Clicking one loads it into a preview mechanism
 #
 # IResponse response
 # bool kamiEnabled Schoolbox-configured var that determines whether kami export is available
 #}
{#
 # if response.allFiles exits,
 # check if those files have a kami file id,
 # check how many of those exist,
 # if it is more than 1 then show the file list
#}
{% if response.allFiles | filter(file => file.kami.id is defined) | length > 1 %}
        <script src="{{ CDN_PREFIX }}/js/submissions/jquery.kami-export.js?v={{ config.site_version }}"></script>
        <script>
            $(function() {
                // Activate export of Kami Documents
                $('[data-kami-export]').kamiExport({
                    toast: $('#toaster')
                });
            });
        </script>

    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">Files</h2>
            <ul class="inline-grader-filelist grid small-block-grid-1 medium-block-grid-2">
                {% for currentFile in response.allFiles %}
                    {% if currentFile.kami %}
                    {% set selected = '' %}
                    {% if (selectedFileHash is defined and currentFile.hash == selectedFileHash) or (loop.index0 == 0 and not selectedFileHash) %}
                        {% set selected = 'selected' %}
                    {% endif %}

                    <li class="actions-small-2 {{ selected }} inline-grader-file">
                        <div class="list-item">
                            <div class="card small-12">
                                {% set responseRoute = routeLookup('learningDueWorkResponse.getKamiView', {kamiId: currentFile.kami.id}) %}
                                <a href="{{ responseRoute }}" title="{{ currentFile.filename }}">
                                    <img src="/ajax/mime/{{ currentFile.mime }}" alt="Download" class="mime" />
                                    <p>{{ currentFile.filename }}</p>
                                </a>
                            </div>
                        </div>
                        <nav>
                            <sbx-pop-out content-id="download-options-{{ currentFile.id }}"></sbx-pop-out>
                        </nav>

                        <ul id="download-options-{{ currentFile.id }}" class="f-dropdown" data-dropdown-content>
                            {% set kamiExportRoute = routeLookupIfAuthorized('learningDueWorkResponse.getKamiExport', {
                                kamiId:       currentFile.kami.id,
                                assessment:   response.assessable,
                                feedback:     latestFeedback,
                                response: response
                            }) %}
                            {% if kamiExportRoute %}
                                <li><a href="{{ kamiExportRoute }}" data-kami-export class="sbx-button--has-icon" title="Download annotated document"><sbx-icon name="download"></sbx-icon>Download annotated document</a></li>
                            {% endif %}
                            <li>
                                <a href="/storage/fetch.php?hash={{ currentFile.hash }}&save=true" class='sbx-button--has-icon' title="Download original"><sbx-icon name="download"></sbx-icon>Download original</a>
                            </li>
                        </ul>
                    </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    </div>
{% endif %}
