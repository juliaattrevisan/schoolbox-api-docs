{% extends '@learningDueWorkResponse/inlineGrading/standard.twig' %}

{# No participant carousel in self-reflection #}
{% block participantCarousel %}{% endblock %}

{# No delete capability in self-reflection #}
{% block meta %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/meta.twig' with {
        locale: locale,
        assessment: assessment,
        participant: participant,
        responseList: responseList,
        response: response,
        readonly: readonly,
        deleteRoute: false
    } only %}
{% endblock %}

{# Different button text in self-reflection #}
{% block dynamicFeedback %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/dynamicFeedback.twig' with {
        publishText: 'Submit'
    } only %}
{% endblock %}

{# No response list in self-reflection #}
{% block responseList %}{% endblock %}

{# No response file preview in self-reflection #}
{% block responseFilePreview %}{% endblock %}

{# No response file list in self-reflection #}
{% block responseFileList %}{% endblock %}

{% block subheading %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Self-Reflection</h2>
    </div>
</div>
{% endblock %}

{# No rubric descriptor/group/overall totals in self-reflection #}
{% block rubricGrid %}
    {% set showDescriptorValue = false %}
    {% set showGroupTotal = false %}
    {% set showRubricTotal = false %}

    {{ parent() }}
{% endblock %}

{# No grade value input in self-reflection #}
{% block gradeValue %}{% endblock %}

{# Provide comment input field in self-reflection, but in different size #}
{% block comment %}
    <div class="small-12 column">
        {% include '@learningAssessment/dueWork/comment.twig' with {
            participant: participant,
            tabIndex: 2,
            readonly: readonly
        } only %}
    </div>
{% endblock %}

{# Maybe files may be uploaded here? #}
{% block attachzone %}
    {{ parent() }}
{% endblock %}

{# Action Bar #}
{% block actionButtons %}
    {% spaceless %}
        {% set buttons %}
            <span class="button disabled" data-draft="drafted" title="Saved as draft" {% if not isDraftFeedback %}style="display:none;"{% endif %}>Saved as Draft</span>
            {% if not readonly %}
                <a class="button" data-draft="publish"></a>
            {% endif %}
        {% endset %}
    {% endspaceless %}

    {% include '@learningAssessment/fragments/actionBar.twig' with {
        actionStyle:  '',
        buttons: buttons
    } only %}
{% endblock %}
