{##
 # The Assign From Rubric button
 #
 # locale
 # rubricId: the rubric's ID
 #}
{% autoescape 'js' %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const assessmentStatusEl = document.querySelector('[data-assessment-status]');

        const markInputEl = assessmentStatusEl.querySelector('[data-mark-input]');
        const assignFromRubricButtonEl = assessmentStatusEl.querySelector('[data-use-rubric-value]');
        const rubricSumTextEl = assignFromRubricButtonEl.querySelector('[data-rubric-sum]');

        /**
         * Retrieve the rubric grid's human-readable mark
         * @returns {string}
         */
        function getRubricSum() {
            // defer this querySelector until needed as the rubric grid loads via JS
            const rubricSumValueEl = assessmentStatusEl.querySelector('#rubric-total-mark');
            return rubricSumValueEl.value.trim();
        }

        /**
         * @return {boolean} whether the grade was customised by the user and shouldn't be overridden by auto-updates from the rubric
         */
        function wasCustomised() {
            return markInputEl.hasAttribute('data-customised');
        }

        /**
         * Set the customisation status flag when a human enters a grade
         * @param {boolean} isCustomised
         */
        function setCustomised(isCustomised) {
            if (isCustomised) {
                markInputEl.setAttribute('data-customised', '');
            } else {
                markInputEl.removeAttribute('data-customised');
            }
        }

        /**
         * Update text and properties of the Assign From Rubric button
         * @param {string} rubricSum
         */
        function updateButtonMark(rubricSum) {
            rubricSumTextEl.textContent = rubricSum;
            assignFromRubricButtonEl.disabled = !wasCustomised();
        }

        /**
         * Update the Grade based on the grid summation and existence of a
         * customised human-provided value
         *
         * Update the mark input field with current rubric total only if:
         *  - the current rubric total is non-blank (it will be blank if no points have been set on rubric values) AND
         *  - the total is different from the input val AND
         *  - we haven't already customised the mark - don't clobber!
         *
         * @param {string} rubricSum
         */
        function updateGrade(rubricSum) {
            if (rubricSum !== '' && rubricSum !== markInputEl.value && !wasCustomised()) {
                markInputEl.value = rubricSum;

                // Trigger change event manually, so that dynamic feedback JS is aware of the change
                // note this will end up triggering another init() call afterwards too
                markInputEl.dispatchEvent(new Event('change', { bubbles: true }));
            }
        }


        /**
         * Initialise button contents, customisation status based on current conditions
         */
        function init() {
            const rubricSum = getRubricSum();

            setCustomised(rubricSum !== '' && rubricSum !== markInputEl.value);

            updateButtonMark(rubricSum);
        }

        /* Init on load
         */
        init();

        /* Update the input val when manually assigning grade from rubric
         */
        assignFromRubricButtonEl.addEventListener('click', (e) => {
            e.preventDefault();

            setCustomised(false);

            const rubricSum = getRubricSum();
            updateGrade(rubricSum);

            console.log('Assign from rubric clicked, rubricSum:', rubricSum);

            init();
        });

        /* Detect enter keypress; initiate blur() which then initiates change()
         */
        markInputEl.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                markInputEl.blur();
            }
        });

        /* Re-init button and customisation status upon change
         */
        markInputEl.addEventListener('change', (e) => { init(); });

        /* Listen for rubric total updates, which may occur when changing descriptor selections in the rubric grid
         */
        document.addEventListener("RUBRIC__TOTAL_MARK_UPDATED", (e) => {
            if (!wasCustomised()) {
                const rubricSum = getRubricSum();
                updateGrade(rubricSum);
                init();
            }
        });
    });
</script>
{% endautoescape %}
<p>
    <button data-use-rubric-value class="full-width" type="button" disabled>
        Assign
        <span class="descriptor-sum" data-rubric-sum data-test="rubric-sum"></span>
        from Rubric
    </button>
</p>
