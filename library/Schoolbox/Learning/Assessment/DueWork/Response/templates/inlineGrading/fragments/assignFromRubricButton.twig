{##
 # The Assign From Rubric button
 #
 # locale
 # rubricId: the rubric's ID
 #}
{% autoescape 'js' %}
<script>
    $(function () {

        // cache this stuff, it doesn't change
        var $status                 = $('#assessment-status'),
            markInputSelector      = '[data-mark-input]',
            $assignFromRubricButton = $('#use-rubric-value'),
            $rb                     = $('#rb-{{ rubricId }}'),
            finalSummarySelector    = '[data-final-summary]';


        // Mark entered in the overall mark field
        var currentMarkInput   = $status.find(markInputSelector).val();

        // Disable the button if the rubric value is same as input value
        $assignFromRubricButton.prop('disabled', getRubricSum() == currentMarkInput);

        // Dynamically insert the rubric mark into the button on page load
        updateButtonMark();

        function refreshAssignFromRubricInput() {
            // Current calculated rubric total
            var rubricSum = getRubricSum();

            // Mark entered in the overall mark field
            var currentMarkInput   = $status.find(markInputSelector).val();

            // Update the mark input field with current rubric total if the total is different from the input val
            // but ONLY if we haven't already customised the mark - don't clobber!
            if ( rubricSum !== currentMarkInput && (!$status.find(markInputSelector).attr('data-customised')) ) {
                $status.find(markInputSelector).val(rubricSum); // Input val
            }

            updateButtonMark();
        }

        function updateButtonMark() {
            var rubricSum = getRubricSum();
            var isValueCustomised = isCustomGrade(rubricSum);

            $("[data-rubric-sum]").text(rubricSum);

            $assignFromRubricButton.prop('disabled', !isValueCustomised);

            if (isValueCustomised) {
                $status.find(markInputSelector).attr('data-customised', true);
            } else {
                $status.find(markInputSelector).removeAttr('data-customised');
            }
        }


        /**
         * If a human entered the Grade, it was "customised"
         *
         * @param rubricSum
         * @return bool
         */
        function isCustomGrade(rubricSum) {
            return rubricSum !== '' && rubricSum !== $status.find(markInputSelector).val();
        }


        /**
         * Calculate the sum of the selected descriptors in the rubric grid
         * This is used to create a representation of the total in various ui elements
         *
         * @return string
         */
        function getRubricSum() {
            return $.trim($rb.find(finalSummarySelector).text());
        }


        // Update the input val when manually assigning grade from rubric
        $assignFromRubricButton.on('click', function(e) {
            var $markInput = $status.find(markInputSelector);
            // reset customisation state, like we do for cap inputs
            $markInput.removeAttr('data-customised');

            e.preventDefault();
            refreshAssignFromRubricInput();

            // Trigger change event manually, so that dynamic feedback JS is aware of the change
            $markInput.trigger("change");
        });

        /* Detect enter keypress; initiate blur() which then initiates change()
         */
        $status.find(markInputSelector).on('keydown', function(event) {
            if (event.keyCode == 13) {
                $(this).trigger('blur');
            }
        });

        $status.find(markInputSelector).on ('change', function(event) {
            var rubricSum = getRubricSum();

            // Mark entered in the overall mark field
            var currentMarkInput   = $status.find(markInputSelector).val();
            // Disable the button if the rubric value is same as input value
            var isValueCustomised = rubricSum !== currentMarkInput;
            $assignFromRubricButton.prop('disabled', !isValueCustomised);
            if (isValueCustomised) {
                $(this).attr('data-customised', true);
            } else {
                $(this).removeAttr('data-customised');
            }
        })

        // Update the input val when manually assigning grades from descriptor vals
        $("[data-use-descriptor-values]").on('click', function(e) {
            e.preventDefault();
            if (!$status.find(markInputSelector).attr('data-customised')) {
                refreshAssignFromRubricInput();
            }
        });

        // Update the input val when any of these inputs change
        $rb.on('change', '[data-rubric], [data-rubric-group], [data-group-mark]', refreshAssignFromRubricInput);
    });
</script>
<p><button id="use-rubric-value" class="full-width">Assign <span class="descriptor-sum" data-rubric-sum></span> from Rubric</button></p>
{% endautoescape %}
