{##
 # The Assign From Rubric button
 #
 # locale
 # RubricContext rubricContext
 #}
<script>
    $(function () {

        // cache this stuff, it doesn't change
        var $status                 = $('#assessment-status'),
            markInputSelector      = '[data-mark-input]',
            $assignFromRubricButton = $('#use-rubric-value'),
            $rb                     = $('#rb-{{ rubricContext.rubric.id }}'),
            finalSummarySelector    = '[data-final-summary]',
            markType = $rb.find("[data-final-summary]").data("mark-type");

        // Current calculated rubric total
        var rubricTotalText = $.trim($rb.find(finalSummarySelector).text());
        var rubricSum = $.trim(rubricTotalText);

        // Extract the actual mark bit
        if (markType === 'TotalMarkFractional') {
            // Total mark is shown as x / y so extract the x
            rubricSum = rubricTotalText.replace(/\/ \d*/, "");
        }

        // Mark entered in the overall mark field
        var currentMarkInput   = $status.find(markInputSelector).val();

        // Disable the button if the rubric value is same as input value
        $assignFromRubricButton.prop('disabled', rubricSum == currentMarkInput);


        function refreshAssignFromRubricButton() {
            // Current calculated rubric total
            var rubricTotalText = $.trim($rb.find(finalSummarySelector).text());
            var rubricSum = $.trim(rubricTotalText);

            // Extract the actual mark bit
            if (markType === 'TotalMarkFractional') {
                // Total mark is shown as x / y so extract the x
                rubricSum = rubricTotalText.replace(/\/ \d*/, "");
            }

            // Mark entered in the overall mark field
            var currentMarkInput   = $status.find(markInputSelector).val();

            // Update the mark input field with current rubric total if the total is different from the input val
            // but ONLY if we haven't already customised the mark - don't clobber!
            if ( rubricSum !== currentMarkInput && (!$status.find(markInputSelector).attr('data-customised')) ) {
                $status.find(markInputSelector).val(rubricSum); // TODO this will need changing for letter grade?
                $status.find("[data-rubric-sum]").val(rubricSum);
                currentMarkInput = rubricSum;
            }

            // Disable the button if the rubric value is same as input value
            $assignFromRubricButton.prop('disabled', rubricSum == currentMarkInput);
        }

        function updateButtonMark() {
            // Current calculated rubric total
            var rubricTotalText = $.trim($rb.find(finalSummarySelector).text());
            var rubricSum = $.trim(rubricTotalText);

            // Extract the actual mark bit
            if (markType === 'TotalMarkFractional') {
                // Total mark is shown as x / y so extract the x
                rubricSum = rubricTotalText.replace(/\/ \d*/, "");
            }

            $("[data-rubric-sum]").text(rubricSum);

            // Mark entered in the overall mark field
            var currentMarkInput   = $status.find(markInputSelector).val();
            // Disable the button if the rubric value is same as input value
            $assignFromRubricButton.prop('disabled', rubricSum == currentMarkInput);
        }

        // Update the input val when manually assigning grade from rubric
        $assignFromRubricButton.on('click', function(e) {
            // reset customisation state, like we do for cap inputs
            $status.find(markInputSelector).removeAttr('data-customised');

            e.preventDefault();
            refreshAssignFromRubricButton();
        });

        $status.find(markInputSelector).change(function() {
            // Did we manually change the overall grade? Record that it's customised
            $status.find(markInputSelector).attr('data-customised', true);

            var rubricTotalText = $.trim($rb.find(finalSummarySelector).text());
            var rubricSum = $.trim(rubricTotalText);

            // Extract the actual mark bit
            if (markType === 'TotalMarkFractional') {
                // Total mark is shown as x / y so extract the x
                rubricSum = rubricTotalText.replace(/\/ \d*/, "");
            }

            // Mark entered in the overall mark field
            var currentMarkInput   = $status.find(markInputSelector).val();
            // Disable the button if the rubric value is same as input value
            $assignFromRubricButton.prop('disabled', rubricSum == currentMarkInput);
        })

        // Update the input val when manually assigning grades from descriptor vals
        $(".use-descriptor-values").on('click', function(e) {
            e.preventDefault();
            if (!$status.find(markInputSelector).attr('data-customised')) {
                refreshAssignFromRubricButton();
            }
        });

        updateButtonMark();

        // Update the input val when any of these inputs change
        $rb.on('change', '[data-rubric], [data-rubric-group], [data-group-max-value]', refreshAssignFromRubricButton);

        // Update the value shown on the button
        $rb.on('change', '[data-rubric], [data-rubric-group], [data-group-max-value]', updateButtonMark);

    });
</script>
<p><button id="use-rubric-value" class="full-width">Assign <span data-rubric-sum></span> from Rubric</button></p>