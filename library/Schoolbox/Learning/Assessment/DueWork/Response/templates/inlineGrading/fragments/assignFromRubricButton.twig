{##
 # The Assign From Rubric button
 #
 # locale
 # RubricContext rubricContext
 #}
<script>
    $(function () {

        // cache this stuff, it doesn't change
        var $status                 = $('#assessment-status'),
            markInputSelector      = '[data-mark-input]',
            $assignFromRubricButton = $('#use-rubric-value'),
            $rb                     = $('#rb-{{ rubricContext.rubric.id }}'),
            finalSummarySelector    = '[data-final-summary]';

        // Keep track of whether the user has customised the overall mark. This should behave in consistence with capability mark inputs.
        var customised = false;

        function refreshAssignFromRubricButton() {

            // console.log("Mark input element: ");
            // console.log($status.find(markInputSelector));

            // Current calculated rubric total
            var currentRubricValue = $.trim($rb.find(finalSummarySelector).text());

            // console.log("Current rubric value: " + currentRubricValue);

            // Mark entered in the overall mark field
            var currentMarkInput   = $status.find(markInputSelector).val();

            // console.log("Current mark input val: " + $status.find(markInputSelector).val());

            // Update the mark input field with current rubric total if the total is different from the input val
            // but ONLY if we haven't already customised the mark - don't clobber!
            if (currentRubricValue !== currentMarkInput) {
                // console.log("Val differs, updating input val to match rubric total");
                customised = true;
                $status.find(markInputSelector).val(currentRubricValue);
            }

            // Disable the button if the rubric value is same as input value
            // $assignFromRubricButton.prop('disabled', currentRubricValue === currentMarkInput);
        }

        // Update the input val when manually assigning grade from rubric
        $assignFromRubricButton.on('click', function(e) {
            e.preventDefault();
            refreshAssignFromRubricButton();
        });

        // Update the input val when manually assigning grades from descriptor vals
        $(".use-descriptor-values").on('click', function(e) {
            e.preventDefault();
            refreshAssignFromRubricButton();
        });

        // Update the input val when any of these inputs change
        $rb.on('change', '[data-rubric], [data-rubric-group], [data-group-max-value]', refreshAssignFromRubricButton);

        // do it on pageload anyway
        // refreshAssignFromRubricButton();
    });
</script>
<p><button id="use-rubric-value" class="full-width">Assign {{ locale.grades.proper }} from Rubric</button></p>