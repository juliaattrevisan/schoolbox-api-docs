{##
 # The Assign From Rubric button
 #
 # locale
 # rubricId: the rubric's ID
 #}
{% autoescape 'js' %}
<script>
    $(function () {

        // cache this stuff, it doesn't change
        var $status                 = $('#assessment-status'),
            markInputSelector       = '[data-mark-input]',
            $assignFromRubricButton = $('#use-rubric-value'),
            $rb                     = $('#rb-{{ rubricId }}'),
            finalSummarySelector    = '[data-final-summary]';

        /* Init on load
         */
        init($status.find(markInputSelector));


        /**
         * Initialise button contents, customisation status based on current conditions
         *
         * @param element the markInputSelector element containing the data-customised var
         * @return void
         */
        function init(element) {
            var rubricSum = getRubricSum();
            var isValueCustomised = isCustomGrade(rubricSum);

            updateButtonMark(rubricSum, isValueCustomised);
            updateCustomisationStatus(element, isValueCustomised);
        }


        /**
         * Update text and properties of the Assign From Rubric button
         *
         * @param rubricSum string
         * @param isValueCustomised bool
         * @return void
         */
        function updateButtonMark(rubricSum, isValueCustomised) {
            $("[data-rubric-sum]").text(rubricSum);

            $assignFromRubricButton.prop('disabled', !isValueCustomised);
        }


        /**
         * Update the customisation status flag when a human enters a grade
         *
         * @param element the markInputSelector element containing the data-customised var
         * @param isValueCustomised bool
         * @return void
         */
        function updateCustomisationStatus(element, isValueCustomised) {
            if (isValueCustomised) {
                $(element).attr('data-customised', true);
            } else {
                $(element).removeAttr('data-customised');
            }
        }


        /**
         * Update the Grade based on the grid summation and existence of a
         * customised human-provided value
         *
         * Update the mark input field with current rubric total if the total is different from the input val
         * but ONLY if we haven't already customised the mark - don't clobber!
         *
         * @param rubricSum string
         * @return void
         */
        function updateGrade(rubricSum) {
            var currentMarkInput = $status.find(markInputSelector).val();

            if (rubricSum !== currentMarkInput && (!wasCustomised()) ) {
                $status.find(markInputSelector).val(rubricSum);
            }
        }


        /**
         * Update ui elements based on grid selection
         * There are sequential dependencies here that I can't easily avoid atm
         *
         * @return void
         */
        function updateAll() {

            // Current calculated rubric total
            var rubricSum = getRubricSum();

            /* Update Grade value if applicable
             */
            updateGrade(rubricSum);

            /* Sequential dependency with the "don't clobber" code above
             * updateGrade() changes a value that is analysed in isCustomGrade()
             */
            init($status.find(markInputSelector));
        }


        /**
         * If a human entered the Grade, it was "customised"
         *
         * @param rubricSum string
         * @return bool
         */
        function isCustomGrade(rubricSum) {
            return rubricSum !== '' && rubricSum !== $status.find(markInputSelector).val();
        }


        /**
         * Find out if the grade was previously customised
         *
         * This varies from isCustomGrade() in that it remembers historically that you've entered
         * a grade manually, rather than circumstantially based on grid summation
         *
         * TODO: Verify
         * Prevents a clobbering when you cycle through the grid selections, whose summation
         * just so happens to match a human-defined var. This flag explicitly states that a custom
         * grade was provided, even if it matches the current grid selection's summation it won't
         * be overridden by the next selection
         *
         * @return bool
         */
        function wasCustomised() {
            return $status.find(markInputSelector).attr('data-customised')
        }


        /**
         * Calculate the sum of the selected descriptors in the rubric grid
         * This is used to create a representation of the total in various ui elements
         *
         * @return string
         */
        function getRubricSum() {
            return $.trim($rb.find(finalSummarySelector).text());
        }


        // Update the input val when manually assigning grade from rubric
        $assignFromRubricButton.on('click', function(e) {
            var $markInput = $status.find(markInputSelector);
            // reset customisation state, like we do for cap inputs
            $markInput.removeAttr('data-customised');

            e.preventDefault();
            updateAll();

            // Trigger change event manually, so that dynamic feedback JS is aware of the change
            $markInput.trigger("change");
        });

        /* Detect enter keypress; initiate blur() which then initiates change()
         */
        $status.find(markInputSelector).on('keydown', function(event) {
            if (event.keyCode == 13) {
                $(this).trigger('blur');
            }
        });

        /* Re-init button and customisation status upon change
         */
        $status.find(markInputSelector).on('change', function(event) {
            init($(this));
        });

        // Update the input val when manually assigning grades from descriptor vals
        $("[data-use-descriptor-values]").on('click', function(e) {
            e.preventDefault();
            if (!$status.find(markInputSelector).attr('data-customised')) {
                updateAll();
            }
        });

        // Update the input val when any of these inputs change
        $rb.on('change', '[data-rubric], [data-rubric-group], [data-group-mark]', updateAll);
    });
</script>
<p><button id="use-rubric-value" class="full-width">Assign <span class="descriptor-sum" data-rubric-sum></span> from Rubric</button></p>
{% endautoescape %}
