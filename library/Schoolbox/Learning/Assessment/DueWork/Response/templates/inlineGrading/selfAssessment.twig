<h2 class="subheader">
    {{ assessment.selfGradable ? locale.selfAssessment.proper : locale.selfReflection.proper }}
</h2>

{% set gradable = selfAssess and 'none' != markSchemeName | lower %}

{% set rubricText = ''  %}
{% set selfAssessText = '' %}
{% if assessment.useRubric %}
    {% set rubricText = 'rubric and'  %}
{% endif %}
{% if selfAssess %}
    {% set selfAssessText = 'assess and' %}
{% endif %}

{# Instructions #}
<div class="row">
    <div class="small-12 columns">
        <p>Use the {{ rubricText }} comment box below to {{ selfAssessText }} reflect on your own work.</p>
        <div class="alert-box warning">
            Note: your {{ assessment.selfGradable ? locale.selfAssessment : locale.selfReflection }}
            will automatically save to draft, but
            <strong>will not be submitted until you press the Submit for Feedback button.</strong>
        </div>
    </div>
</div>

{# Feedback form section #}
<section id="self-assessment-feedback">
    {# Rubric #}
    {% if assessment.useRubric %}
        <fieldset class="content">
            {% set rubricTemplate = readonly
                ? 'grid.twig'
                : 'grid-markable.twig'
            %}

            {% set rubricMarkedGrid = feedback is not null ? feedback.rubricMarkedGrid : null %}

            {% include '@rubric/' ~ rubricTemplate with {
                rubricGrid: assessment.rubricGrid,
                rubricMarkedGrid: feedback.rubricMarkedGrid ?? null,
                learner: participant.user,
                markVisibility: participant.assessable.isFeedbackVisibleToUser(USER),
                showDescriptorValue: showDescriptorValue,
                showGroupTotal: showGroupTotal,
                showRubricTotal: showRubricTotal,
                studentView: true,
                selfAssessmentFeedback: selfAssessmentFeedback ?? null,
                selfAssess: selfAssess,
                selfReflect: selfReflect,
                blindMode: false
            } only %}
        </fieldset>
    {% endif %}

    {# Grades input combobox #}
    {% if gradable %}
        <div class="small-12 medium-3 column">
            <label>{{ locale.grades.proper }}
                {% include '@learningMarkScheme/'~markSchemeName~'.twig' with {
                    participant: participant,
                    feedback: feedback,
                    markScheme: assessment.markScheme,
                    tabIndex: 1,
                    errors: errors,
                    readonly: readonly
                } only %}
            </label>

            {% if assessment.useRubric and not readonly %}
                {% include '@learningDueWorkResponse/inlineGrading/fragments/assignFromRubricButton.twig' with {
                    locale: locale,
                    rubricId: assessment.rubricGrid.id,
                } only %}
            {% endif %}
        </div>
    {% endif %}

    {# Feedback comment textarea #}
    <div class="small-12{% if gradable %} medium-9{% endif %} column">
        {% include '@learningAssessment/dueWork/comment.twig' with {
            tabIndex: 2,
            readonly: readonly,
            participant: participant,
            feedback: feedback,
            selfAssessment: selfAssess,
            selfReflection: selfReflect,
            blindMode: false
        } only %}
    </div>
</section>

<div id="empty-dialog" class="reveal-modal" data-reveal role="dialog">
    <h2 id="empty-dialog-title">
        Are you sure you wish to submit an incomplete
        {{ assessment.selfGradable ? locale.selfAssessment.singularForm : locale.selfReflection.singularForm }}?
    </h2>
    <p>
        It is preferable to provide a
        {{ assessment.selfGradable ? locale.selfAssessment.singularForm : locale.selfReflection.singularForm }}
        comment. Please confirm that you wish to provide no comment.
    </p>
    <ul class="flex-list buttons">
        <li><a class="button submit" data-interaction="enable">Yes</a></li>
        <li><a class="button" data-interaction="close">No</a></li>
    </ul>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<script src="{{ CDN_PREFIX }}/js/submissions/jquery.combobox.js" type="text/javascript"></script>
