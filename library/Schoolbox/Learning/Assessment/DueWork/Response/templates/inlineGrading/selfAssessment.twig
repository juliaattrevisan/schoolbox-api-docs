{% extends '@learningDueWorkResponse/inlineGrading/standard.twig' %}

{# No participant carousel in self-assessment #}
{% block participantCarousel %}{% endblock %}

{# No delete capability in self-assessment #}
{% block meta %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/meta.twig' with {
        locale: locale,
        assessment: assessment,
        participant: participant,
        responseList: responseList,
        response: response,
        readonly: readonly,
        deleteRoute: false
    } only %}
{% endblock %}

{# Different button text in self-assessment #}
{% block dynamicFeedback %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/dynamicFeedback.twig' with {
        publishText: 'Submit'
    } only %}
{% endblock %}

{# No response list in self-assessment #}
{% block responseList %}{% endblock %}

{# No response file preview in self-assessment #}
{% block responseFilePreview %}{% endblock %}

{# No response file list in self-assessment #}
{% block responseFileList %}{% endblock %}

{% block subheading %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Self-Assessment</h2>
    </div>
</div>
{% endblock %}

{% block grading %}
<div class="row mark-scheme" id="assessment-status" data-participant>
    <div class="small-12 island">
        <section class="content">

            <form method="post" data-feedback-form action="{{ routeLookupIfAuthorized('learningDueWorkFeedback.postResponseFeedback', {assessmentId: assessment.id, studentId: participant.user.id, responseId: response.id, participant: participant}) }}">
                <input type="hidden" name="responseId" value="{{ response.id }}" />

                <div class="row">

                    {# Show totals in self-assessment #}
                    {% block rubricGrid %}
                        {% set showDescriptorValue = true %}
                        {% set showGroupTotal = true %}
                        {% set showRubricTotal = true %}

                        {{ parent() }}
                    {% endblock %}

                    {# Provide grade value input field in self-assessment #}
                    {% block gradeValue %}
                        {{ parent() }}
                    {% endblock %}

                    {# Provide comment input field in self-assessment #}
                    {% block comment %}
                        {{ parent() }}
                    {% endblock %}

                    {# Maybe files may be uploaded here? #}
                    {% if attachzone and not readonly %}
                        <div class="small-12 columns">
                            {% include 'sub/attachzone.twig' with {attachzone: attachzone} only %}
                        </div>
                    {% endif %}

                    {# Action Bar #}
                    {% set isDraftFeedback = latestFeedback and not latestFeedback.published %}

                    {% spaceless %}
                        {% set buttons %}
                            <span class="button disabled" data-draft="drafted" title="Saved as draft" {% if not isDraftFeedback %}style="display:none;"{% endif %}>Saved as Draft</span>
                            {% if not readonly %}
                                <a class="button" data-draft="publish"></a>
                            {% endif %}
                        {% endset %}
                    {% endspaceless %}

                    {% include '@learningAssessment/fragments/actionBar.twig' with {
                        actionStyle:  '',
                        buttons:      buttons
                    } only %}
                </div>
            </form>
        </section>
    </div>
</div>
<script src="/javascript/shared/submissions/jquery.combobox.js" type="text/javascript"></script>
{% endblock %}