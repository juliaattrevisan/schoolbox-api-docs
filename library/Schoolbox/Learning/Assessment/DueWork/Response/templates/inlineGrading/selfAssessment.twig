{#
 # Self-Assessment fragment used in creating a Due Work response
 #
 # This fulfils the grading part of Self Assessment, known as Self-Grading, by providing a rubric grid(s) and the little
 # combobox/comment ui for learners to grade their work.
 #
 # @param IAssessable $assessment            A fully hydrated learning activity instance
 # @param bool $selfAssess                   A bool corresponding to whether Self Assessment was enabled in the Due Work settings and can occur for this response instance
 # @param IFeedback $feedback                A feedback instance for Due Work
 # @param Participant\Model $participant     A participant instance
 # @param bool $showGroupTotal               An arbitrary decision about whether Capability Marks could display here, if extant.
 # @param bool $showRubricTotal              An arbitrary decision about whether Rubric Grid Totals could display here, if extant
 # @param string $rubricMarkedGridPayloads   A json-encoded representation of the rubric grid structure, marked grid, self graded grid
 # @param IFeedback $selfAssessmentFeedback  "the self-assessed feedback, shouldst there be one"
 # @param bool $readonly                     A bool corresponding to whether a combobox is in readonly mode, such as when you revisit this screen but the academic period ended already
 # @param array $errors                      A stack of Submission States, contrary to its naming which is misleading (I know, I know...)
 #}

<h2 class="subheader">
    {{ assessment.selfGradable ? locale.selfAssessment.proper : locale.selfReflection.proper }}
</h2>

{% set markScheme = assessment.markScheme %}

{# If Self-Assessment was enabled and there was a meaningful mark scheme, allow learners to grade themselves #}
{% set gradable = selfAssess and '' != markScheme.template %}

{# Feedback form section #}
<section id="self-assessment-feedback">
    <fieldset class="content">
        {% set rubricTemplate = readonly ? 'grid.twig' : 'grid-markable.twig' %}

        {# Render each rubric grid in a giant stack, I guess: there isn't much of an alternative to the mega scroll #}
        {% include '@rubric/' ~ rubricTemplate with {
            assessment: assessment,
            markVisibility: participant.assessable.isFeedbackVisibleToUser(USER),
            blindMode: false,
            studentView: true,
            learner: participant.user,
            selfAssess: selfAssess,
            selfReflect: selfReflect,
            selfAssessmentFeedback: selfAssessmentFeedback ?? null,
            rubricMarkedGridPayloads: rubricMarkedGridPayloads,
            showGroupTotal: showGroupTotal,
            showRubricTotal: showRubricTotal,
        } only %}
    </fieldset>

    {# Grades input combobox #}
    {% if gradable %}
        <div class="small-12 medium-3 column">
            <label>{{ locale.grades.proper }}
                {% include '@learningMarkScheme/'~markScheme.template~'.twig' with {
                    participant: participant,
                    feedback: feedback,
                    markScheme: markScheme,
                    useInstructorMark: false,
                    tabIndex: 1,
                    errors: errors,
                    readonly: readonly
                } only %}
            </label>

            {% if assessment.useRubric and not readonly %}
                {% include '@learningDueWorkResponse/inlineGrading/fragments/assignFromRubricButton.twig' with {} only %}
            {% endif %}
        </div>
    {% endif %}

    {# Feedback comment textarea #}
    <div class="small-12{% if gradable %} medium-9{% endif %} column">
        {% include '@learningAssessment/dueWork/comment.twig' with {
            tabIndex: 2,
            readonly: readonly,
            participant: participant,
            feedback: feedback,
            selfAssessment: selfAssess,
            selfReflection: selfReflect,
            blindMode: false,
            isRichText: true
        } only %}
    </div>
</section>

<script src="{{ CDN_PREFIX }}/js/submissions/jquery.combobox.js?v={{ config.site_version }}" type="text/javascript"></script>
