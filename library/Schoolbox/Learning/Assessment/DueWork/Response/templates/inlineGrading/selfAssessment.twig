{% extends '@learningDueWorkResponse/inlineGrading/standard.twig' %}

{# Go back to the assessment's summary screen, I guess? #}
{% block nextUrl %}
<script>
    var nextUrl = '{{ routeLookup("learningAssessment.getSummary", {assessmentId: assessment.id, studentId: participant.user.id}) }}';
</script>
{% endblock %}

{# No participant carousel in self-assessment #}
{% block participantCarousel %}{% endblock %}

{# No delete capability in self-assessment #}
{% block meta %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/meta.twig' with {
        title: locale.selfAssessment.proper ~ ' for',
        assessment: assessment,
        participant: participant,
        responseList: responseList ?? null,
        response: response,
        readonly: readonly,
        deleteRoute: false,
        hideDropdown: true
    } only %}
{% endblock %}

{# Different button text in self-assessment #}
{% block dynamicFeedback %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/dynamicFeedback.twig' with {
        publishText: 'Submit ' ~ locale.selfAssessment,
        publishingText: 'Submitting ' ~ locale.selfAssessment ~ '...',
        publishedText: 'Submitted ' ~ locale.selfAssessment
    } only %}
{% endblock %}

{# No response list in self-assessment #}
{% block responseList %}{% endblock %}

{# No response file preview in self-assessment #}
{% block responseFilePreview %}{% endblock %}

{# No response file list in self-assessment #}
{% block responseFileList %}{% endblock %}

{# No subheading in self-assessment #}
{% block subheading %}{% endblock %}

{# Instructions for the self-assessment #}
{% block instructions %}
    {% if assessment.useRubric %}
        {% set text = 'rubric and'  %}
    {% endif %}


    <ul class="train-line">
        <li>
            <a><span class="icon-due-work"></span>Submission</a>
        </li>
        <li class="current-stop">
            <a>
                <span class="icon-blog"></span>
                {{ assessment.selfGradable ? locale.selfAssessment.proper : locale.selfReflection.proper }}
            </a>
        </li>
    </ul>
    <div class="row">
        <div class="small-12 columns">
            <div class="alert-box">{% spaceless %}
                Use the {{ text }} comment box below to submit a {{ locale.selfAssessment.singularForm }} before you submit this
                work to your teacher for feedback.
                {% endspaceless %}</div>
        </div>
    </div>
{% endblock %}

{# Maybe out of date message doesn't exist here #}
{% block mightBeOutofDate %}{% endblock %}

{# A hole for readonly self-reflection content #}
{% block readonlyFeedback %}{% endblock %}

{# Show totals in self-assessment #}
{% block rubricGrid %}
    {% set showDescriptorValue = true %}
    {% set showRubricTotal = true %}
    {% set showGroupTotal = assessment.markPerCapability %}
    {% set self = 'selfAssessment' %}

    {% if assessment.useRubric %}
        <fieldset class="content">
            {% set rubricTemplate = readonly
                ? 'grid.twig'
                : 'grid-markable.twig'
            %}
            {% include '@rubric/' ~ rubricTemplate with {
                rubricGrid: assessment.rubricGrid,
                rubricMarkedGrid: feedback.rubricMarkedGrid,
                learner: participant.user,
                markVisibility: participant.assessable.isFeedbackVisibleToUser(USER),
                showDescriptorValue: showDescriptorValue,
                showGroupTotal: showGroupTotal,
                showRubricTotal: showRubricTotal,
                self: self,
                studentView: true,
                selfAssessmentFeedback: selfAssessmentFeedback,
                selfAssess: selfAssess,
                selfReflect: selfReflect
            } only %}
        </fieldset>
    {% endif %}
{% endblock %}

{# Comment box #}
{% block comment %}
    <div class="small-12{% if 'none' != markSchemeName | lower %} medium-9{% endif %} column">
        {% include '@learningAssessment/dueWork/comment.twig' with {
        tabIndex: 2,
        readonly: readonly,
        selfAssessment: true,
        participant: participant,
        feedback: feedback
        } only %}
    </div>
{% endblock %}

{# Action Bar #}
{% block actionButtons %}
    {% spaceless %}
        {% set buttons %}
            <span class="button disabled" data-draft="drafted" title="Saved as draft" {% if not isDraftFeedback %}style="display:none;"{% endif %}>Saved as Draft</span>
            {% if not readonly %}
                <a class="button" data-draft="publish"></a>
            {% endif %}
        {% endset %}
    {% endspaceless %}

    {% include '@learningAssessment/fragments/actionBar.twig' with {
        actionStyle:  '',
        buttons: buttons
    } only %}
{% endblock %}

{# No Feedback files for self-assessment #}
{% block attachzone %}{% endblock %}
