{##
 # Dynamic Feedback javascript
 # note that nextUrl is defined elsewhere, in the parent, by some other javascript
 #
 # @param string $publishText     A button in the Publish call to action...
 # @param string $publishingText  ...which changes to this once clicked and an async request occurs
 # @param string $publishedText   ...finally ending with this word
 #}
<script src='{{ CDN_PREFIX }}/js/submissions/jquery.dynamic-feedback.js?v={{ config.site_version }}'></script>
{% autoescape 'js' %}
<script>
    $(function() {
        {# nextUrl is defined in javascript in the parent #}

        $.fn.dynamicFeedback({
            {# Special behaviour of the Publish button on this screen
             # Publishing on this screen should be synonymous with the
             # old "Save And Continue" behaviour
             #}
            publishText: '{{ publishText }}',
            publishingText: '{{ publishingText }}',
            publishedText: '{{ publishedText }}',

            onPublishCallback: function () {
                {# if we have a returnURL then lets use that, else do the default #}
                let params = new URLSearchParams(window.location.search);
                let returnUrl = params.get('returnUrl');
                if (null !== returnUrl) {
                    nextUrl = atob(returnUrl);
                }
                window.location.href = nextUrl;
            }
        });
    });
</script>
{% endautoescape %}
