<div class="row">
    <div class="small-12 island">
        {# TODO SA-13980 #}
        <h2 class="subheader">Online Submission</h2>
        {% if file.exists %}
            <section class="content">
                <article>
                    {{ file.storage.read | purify }}
                </article>
            </section>
        {% else %}
            <div data-alert="" class="alert-box warning">
                File not found
            </div>
        {% endif %}
    </div>
</div>
