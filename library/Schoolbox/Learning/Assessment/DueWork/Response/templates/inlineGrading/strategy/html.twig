<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Online Submission</h2>
        {% if data.content is not null %}
            <section class="content">
                <article>
                    {{ data.content | purify }}
                </article>
            </section>
        {% else %}
            <div data-alert="" class="alert-box warning">
                File not found
            </div>
        {% endif %}
    </div>
</div>
