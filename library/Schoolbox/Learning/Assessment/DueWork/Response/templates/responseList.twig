{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    ['Learning', routeLookup('learning.getClasses')],
    [participant.assessable.context.folder.name, routeLookup('learningMarkbook.getMarkbookForClass', {folderId: participant.assessable.context.folder.id})],
    [participant.assessable.title, routeLookup('learningAssessment.getStatus', {assessmentId: participant.assessable.id})],
    ['Timeline']
) }}

<script type="text/javascript">
    $(function () {
        $('[data-plugin="preview"]').preview();
    });
</script>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ locale.grading.proper }} for {{ participant.user.fullname }}</h1>
        </div>
    </div>
    <nav>
        <a href="" class="icon-add" title="Add Feedback for {{ participant.user.fullname }} in {{ participant.assessable.title }}"></a>
    </nav>
</div>

{% include '@learningDueWorkResponse/inlineGrading/fragments/participantCarousel.twig' %}

<div class="row" id="timeline">
    <div class="small-12 island">
        {% if timeline|length %}
            {% include '@learningAssessment/dueWork/history.twig' %}
        {% else %}
            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>There are no interactions for {{ participant.user.fullname }}</p>
            </div>
        {% endif %}
    </div>
</div>
