{#
     Displays a Kami Document for viewing.

     Data:
         kami        Kami\Model
         session     Kami\Session              Optional. Null if document not finished processing.
         response    DueWork\Submission\Model
 #}
{% import 'sub/breadcrumbs.twig' as bread %}

{# Build breadcrumbs #}
{% set nodes = [['Learning', routeLookup('learning.getClasses')]] %}
{# Extra crumb inserted if inside project #}
{% if response.assessable.context is project %}
    {% set nodes = nodes|merge([
        [response.assessable.context.title, routeLookup('learningAssessment.getSummary', {
            assessmentId: response.assessable.context.id,
            studentId:    response.submittedOnBehalfOf.id
        }) ]
    ]) %}
{% endif %}
{% set nodes = nodes|merge([
    [response.assessable.title, routeLookup('learningAssessment.getSummary', {
        assessmentId: response.assessable.id,
        studentId:    response.submittedOnBehalfOf.id
    }) ],
    ['Annotations']
]) %}

{{ bread.crumbsArray(nodes)}}

<div class="row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Annotations for {{ response.assessable.title }}</h1>
            <ul class="meta">
                <li class="icon-staff-students"><a href="/search/user/{{ response.submittedOnBehalfOf.id }}" title="View Profile">{{ response.submittedOnBehalfOf.fullname }}</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if kami.isStatusDone %}
        <section>
            {# Will need confirmations from Kami on how each of the permissions worked within the worksheet, #}
            {# but 'midi' permission probably shouldn't be needed in a 'view/read' only page #}
            {% include 'sub/iframeResponsive.twig' with {
                id: 'kami-viewport',
                src: session.viewerUrl,
                allow: 'midi *; encrypted-media *; autoplay *; fullscreen *',
                dataAttributes: {}
            } only %}
        </section>
        {% else %}
            <div class="empty-state">
                {% if kami.statusQueued%}
                    <sbx-icon name="time-value" size="2.5rem"></sbx-icon>
                    <p>Queued for upload. Please refresh your browser in a few minutes.</p>
                {% elseif kami.isStatusUploading %}
                    <sbx-icon name="upload" size="2.5rem"></sbx-icon>
                    <p>Uploading to Kami. Please refresh your browser in a few minutes.</p>
                {% elseif kami.isStatusProcessing %}
                    <sbx-icon name="refresh" size="2.5rem"></sbx-icon>
                    <p>Document is being processed. Please refresh your browser in a few seconds</p>
                {% elseif kami.isStatusError %}
                    <sbx-icon name="alert" size="2.5rem"></sbx-icon>
                    <p>Something went wrong while processing the document.</p>
                {% else %}
                    <sbx-icon name="alert" size="2.5rem"></sbx-icon>
                    <p>Unable to display document.</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
{% block responseFileList %}
    {% include '@learningDueWorkResponse/inlineGrading/fragments/responseFileListKami.twig' with {
        response: response,
        latestFeedback: response.findMostRecentInstructorGivenPublishedFeedback,
        selectedFileHash: kami.studentSubmissionFile.Storage.hash
    } only %}
{% endblock %}
