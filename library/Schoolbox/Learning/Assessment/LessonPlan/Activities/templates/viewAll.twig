<script type="text/javascript" src="{{ CDN_PREFIX }}/js/course/jquery.course-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/assessment/jquery.assessment-component-tot.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        var $component = $('#component{{ componentInstance.id }}');
        $component.setupAssessmentComponentTot();

        /* Attach Course Selector Modal listeners
         */
        $.fn.courseSelectorModal({
            courseSelector: {
                query: {
                    folder:           Number('{{ folder.id }}'),
                    hasAdd:           false,
                    hasTot:           false,
                    linkToUnits:      false,
                    encodedReturnUrl: "{{ encodedReturnUrl | escape('js') }}"
                }
            }
        });
    });
</script>


{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learningAssessment/fragments/macro/unit/completed.twig' as status %}
{% import '@learningAssessment/project/macro/icon.twig' as icon %}
{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learning/macro/viewRoute.twig' as viewRoute %}

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('learning.getClasses') }}">Learning</a></li>
    <li><a href="/homepage/{{ folder.id }}">{{ folder.getNameWithCodes() }}</a></li>
    <li class="active"><span>{{ locale.lessonPlan.properPlural }}</span></li>
</ul>

<div class="row">
    <div class="small-12">
        <h1>View All {{ locale.lessonPlan.properPlural }}</h1>
    </div>
</div>

<div class="small-12 island" id="component{{ componentInstance.id }}">
{% if courses is empty %}
    <div class="empty-state">
        <sbx-icon name="lesson-plan" size="2.5rem"></sbx-icon>
        <p>
        {% if readOnly %}
            You have no scheduled {{ locale.lessonPlan.plural }}.
        {% else %}
            {{ locale.lessonPlan.plural |capitalize }} must be connected to a course. To start using {{ locale.lessonPlan.plural }} please
        <a href="{{ routeLookup('courseImport.getImport', { courseSpecId: 0, folderId: folder.id }) }}" data-course-selector>
            import a course
        </a>
        to your class page.
        {% endif %}
        </p>
    </div>
{% endif %}
{% for course in courses %}
    {% if course.specification.folder.id in accessibleFolderIds %}
        <h2 class="icon-course subheader"><a href="{{ '/homepage/' ~ course.specification.folder.id }}" title="Visit course page">{{ course.specification.title }}</a></h2>
    {% else %}
        <h2 class="icon-course subheader"><span></span>{{ course.specification.title }}</h2>
    {% endif %}
    <section>
        <ul class="action-list">
            <li>
                <ul class="information-list threaded">
                    {% for unit in course.units %}
                        <li class="interact" data-unit="{{ unit.id }}" data-open_date="{{ unit.openDate.databaseDate }}" data-due_date="{{ unit.dueDate.databaseDate }}">
                            <ul class="action-list">
                                <li>
                                    <div class="actions-small-1">
                                        <div class="list-item">
                                            <div class="card small-12">
                                                <span class="icon-unit"></span>
                                                <h3>
                                                    {% if unit.isBeforeOpenDate==false or readOnly == false %}
                                                        {% if unit.specification.folder.id in accessibleFolderIds %}
                                                            <a href="{{ '/homepage/' ~ unit.specification.folder.id }}">{{ unit.title }}</a>
                                                        {% else %}
                                                            {{ unit.title }}
                                                        {% endif %}
                                                    {% else %}
                                                        {{ unit.title }}
                                                    {% endif %}
                                                </h3>
                                                <p class="{{ status.unitUrgency(unit) }}">{{ status.unitCompletion(unit) }}</p>
                                            </div>
                                        </div>
                                        {% if readOnly == false and unit.isAfterDueDate == false %}
                                            <nav>
                                                <sbx-pop-out content-id="unit-options{{ unit.id }}"></sbx-pop-out>
                                            </nav>
                                            <ul data-dropdown-content class="f-dropdown" id="unit-options{{ unit.id }}">
                                                    <li><a href="{{ routeLookup('learningAssessment.getCreateAssessmentForm', {contextType: 'units', contextId: unit.id, context: unit}) }}?type=lessonPlan&{{ returnUrlName }}={{ encodedReturnUrl }}" class="sbx-button--has-icon"><sbx-icon name="lesson-plan"></sbx-icon>Create {{ locale.lessonPlan.proper }}</a></li>
                                            </ul>
                                        {% endif %}
                                    </div>
                                </li>

                                {% for assessment in unit.assessables %}

                                    {% set specAssessment = assessment.specificationAssessment ?? null %}

                                    {# What action-tot routes are available to this user? #}
                                    {% if readOnly %}
                                        {# If readonly mode: show no tot #}
                                        {% set hasAssessmentRoutes = false %}
                                        {% set hasCourseRoutes = false %}
                                    {% else %}
                                        {# If write mode: show tot only if there's at least one action #}
                                        {% set statusRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
                                        {% if assessment is quiz %}
                                            {% set modifyRoute = routeLookupIfAuthorized('learningQuiz.getQuizSummary', {assessmentId: assessment.id, assessment: assessment}) %}
                                        {% else %}
                                            {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
                                        {% endif %}
                                        {% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: assessment.id, assessment: assessment}) %}
                                        {% set similarityReportRoute = routeLookupIfAuthorized('learningAssessment.getSimilarityReport', {assessmentId: assessment.id, assessment: assessment}) %}
                                        {% set hasAssessmentRoutes = statusRoute or modifyRoute or deleteRoute or similarityReportRoute %}

                                        {% if assessment.context is project %}
                                            {# apparently you're not allowed to do this if it's from a project, related to SA-21140
                                            # i've been told even though the routes still let you snap it if you wanted, just not via the component for now
                                            #}
                                            {% set saveToCourseRoute = null %}
                                        {# Save to course: if spec assessment exists, this is a PUT: otherwise a POST #}
                                        {% elseif specAssessment %}
                                            {% set saveToCourseRoute = routeLookupIfAuthorized(
                                                'courseExport.putAssessmentIntoUnit',
                                                {
                                                    assessmentId: assessment.id,
                                                    assessment: assessment,
                                                    unitSpecId: unit.specification.id,
                                                    unitSpec: unit.specification,
                                                }
                                            ) %}
                                            {% set saveToCourseMethod = 'PUT' %}
                                        {% else %}
                                            {% set saveToCourseRoute = routeLookupIfAuthorized(
                                                'courseExport.postAssessmentIntoUnit',
                                                {
                                                    assessmentId: assessment.id,
                                                    assessment: assessment,
                                                    unitSpecId: unit.specification.id,
                                                    unitSpec: unit.specification,
                                                }
                                            ) %}
                                            {% set saveToCourseMethod = 'POST' %}
                                        {% endif %}
                                        {% set hasCourseRoutes = saveToCourseRoute is not empty %}
                                    {% endif %}

                                    <li class="interact child" data-assessment="{{ assessment.id }}" data-assessment-title="{{ assessment.title }}">
                                        <div{% if hasAssessmentRoutes or hasCourseRoutes %} class="actions-small-1"{% endif %}>
                                            <div class="list-item">
                                                <div class="small-12 compact card wrap-down">
                                                    {% set title = attribute(locale, assessment.typeName|lower) is defined ? attribute(locale, assessment.typeName|lower).proper : assessment.typeName %}

                                                    {# Don't render a link if you are unable to view the details #}
                                                    {% set route = viewRoute.viewRoute(assessment, USER) %}
                                                    {% if route %}
                                                        <a title="{{ title }}" href="{{ route }}?{{ returnUrlName }}={{ encodedReturnUrl }}" class="title">
                                                            <span class="icon-lesson-plan"></span>
                                                            <p class="{% if (dateStart and dateEnd) and assessment.dueAt > dateStart and assessment.dueAt < dateEnd %}active-lesson-plan{% endif %}">{{ assessment.title }}</p>
                                                        </a>
                                                    {% else %}
                                                        <div title="{{ title }}" class="title">
                                                            <span class="icon-lesson-plan"></span>
                                                            <p class="{% if (dateStart and dateEnd) and assessment.dueAt > dateStart and assessment.dueAt < dateEnd %}active-lesson-plan{% endif %}">{{ assessment.title }}</p>
                                                        </div>
                                                    {% endif %}
                                                    <p class="meta">
                                                        <span class="unit-task-due-date">{{ dueDate.forAssessment(assessment) }}</span>
                                                    </p>
                                                    {% if "staff" == assessment.visibility %}
                                                    <p class="meta">
                                                        <span class="icon-eye-hollow"></span>Not visible to students
                                                    </p>
                                                    {% endif %}
                                                </div>
                                            </div>

                                            {% if not readOnly %}
                                                <nav>
                                                    <sbx-pop-out content-id="options-task{{ assessment.id }}"></sbx-pop-out>
                                                </nav>
                                            {% endif %}

                                            {% if hasAssessmentRoutes or hasCourseRoutes %}
                                                <ul data-dropdown-content class="f-dropdown" id="options-task{{ assessment.id }}">
                                                    {% if hasAssessmentRoutes %}
                                                        <li class="separator">{{ locale.translate('activity', false, true) }}</li>
                                                        {% if modifyRoute %}<li><a href="{{ modifyRoute }}?{{ returnUrlName }}={{ encodedReturnUrl }}" title="Modify this {{ locale.activity }}" class="sbx-button--has-icon"><sbx-icon name="modify"></sbx-icon>Modify</a></li>{% endif %}
                                                        {% if deleteRoute %}<li><a href="{{ deleteRoute }}"
                                                                              class="sbx-button--has-icon"
                                                                              data-action="delete"
                                                                              title="Delete this {{ locale.activity }}"
                                                                              aria-label="Delete this {{ locale.activity }}">
                                                            <sbx-icon name="delete"></sbx-icon>
                                                            Delete
                                                        </a></li>{% endif %}
                                                    {% endif %}
                                                    {% if hasCourseRoutes %}
                                                        <li class="separator">Course</li>
                                                        {% if saveToCourseRoute %}
                                                            <li>
                                                                <a href="{{ saveToCourseRoute }}" class="sbx-button--has-icon"
                                                                   data-reveal-id="component{{ componentInstance.id }}-save-to-course-modal-{{ assessment.id }}"
                                                                   data-method="{{ saveToCourseMethod }}"
                                                                   data-spec-assessment-id="{{ specAssessment.id ?? null }}"
                                                                   data-spec-assessment-title="{{ specAssessment.title ?? null }}"
                                                                ><sbx-icon name="export"></sbx-icon>Save to Course...</a>
                                                                {% include '@learningAssessment/outline/saveToCourseModal.twig' with {
                                                                    assessment: assessment,
                                                                    specAssessment: specAssessment ?? null,
                                                                    saveToCourseRoute: saveToCourseRoute,
                                                                    saveToCourseMethod: saveToCourseMethod,
                                                                    componentInstanceId: componentInstance.id,
                                                                } only %}
                                                            </li>
                                                        {% endif %}
                                                    {% endif %}
                                                </ul>
                                            {% endif %}
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>

                        </li>
                    {% endfor %}
                </ul>
            </li>
        </ul>
    </section>
    {% endfor %}
    <div class="toast" data-alert></div>
    <div id="course-selector-modal" class="reveal-modal" data-reveal></div>

</div>

<style>
    .active-lesson-plan {
        font-weight: bold;
    }
</style>
