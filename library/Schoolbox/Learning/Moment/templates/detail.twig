{##
 # Moment Detail Container
 #
 # Launches the detail screen so you can see the fullness of a learning moment,
 # in addition to other parts such as Discussion etc.
 #
 # @param array $moment  An array, representing a translated Moment instance
 #}
{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    [moment.recipient.fullName, '/search/user/' ~ moment.recipient.id],
    ['Learning Moment']
) }}

<div id="moment-detail-container">
    <moment-detail
        :moment="{{ moment|json_encode }}"
        :can-comment="{{ learningMomentCanComment ? 'true' : 'false' }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/learningMomentDetail.js?v={{ config.site_version }}"></script>

<div class="toast" data-toast></div>
