{# Learning Moments Cohort Report #}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs([folder.name, '/homepage/' ~ folder.id], ['Cohort Learning Moments']) }}

{% set endpoint = routeLookup(
    'learningMomentEvidence.getCohortReportPayload',
    { folder: folder, folderId: folder.id }
) %}
<div id="learning-moments-evidence-cohort-report-container">
    <cohort-report
        endpoint-get-report="{{ endpoint }}"
        endpoint-put-bulk-reject="{{ routeLookup('learningMomentModeration.putBulkReject') }}"
        endpoint-put-bulk-publish="{{ routeLookup('learningMomentModeration.putBulkPublish') }}"
        endpoint-delete-bulk-evidence="{{ routeLookup('learningMomentEvidence.deleteBulkDelete') }}"
    />
</div>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/learningMomentsEvidenceCohortReport.js?v={{ config.site_version }}"></script>
