{##
 # The Twig version of the share learning moment modal.

    Parameters:
    id:                the ID of the modal
    baseUrl:           the base URL for the learning moment modal
    encodedReturnUrl:  if set, return to this URL after saving the moment.
                       Defaults to the current URL
    user:              if set, a single user on whose behalf the moment is to be
                       shared
    allowDynamicUsers: if true and user is not set, allow the list of users to
                       be updated dynamically outside of this modal.
                       The list of users may be placed in
                       `<span data-relation="dynamicUsersSlot">`
 #}

<div data-reveal id="{{ id }}" aria-hidden="true" class="reveal-modal small">
    <h2>Share a Learning Moment</h2>

    {% if user is defined and user is not null %}
    <ul class="meta">
        <li>
            Sharing on behalf of <a href="/search/user/{{ user.id }}">{{ user.fullName }}</a>
        </li>
    </ul>
    {% elseif (allowDynamicUsers ?? false) %}
        <ul class="meta">
            <li>
                Sharing on behalf of <span data-relation="dynamicUsersSlot"></span>
            </li>
        </ul>
    {% endif %}
    <div class="share-work-buttons">
        <a data-action="shareLearningMoment" data-test="learning-moment-evidence-share-photo" class="share-photo sbx-button--has-icon" data-take-photo-button href="{{ baseUrl }}?momentType=photo&amp;{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}" title="Take a photo"><sbx-icon name="camera"></sbx-icon>Take a photo</a>
        <a data-action="shareLearningMoment" data-test="learning-moment-evidence-share-video" class="icon-video share-video" data-record-video-button href="{{ baseUrl }}?momentType=video&amp;{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}" title="Record a video">Record a video</a>
        <a data-action="shareLearningMoment" data-test="learning-moment-evidence-share-audio" class="icon-audio share-audio" data-record-audio-button href="{{ baseUrl }}?momentType=audio&amp;{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}" title="Record audio">Record audio</a>
        <a data-action="shareLearningMoment" data-test="learning-moment-evidence-share-file" class="icon-upload share-file" href="{{ baseUrl }}?momentType=upload&amp;{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}" title="Upload file">Upload file</a>
        <a data-action="shareLearningMoment" data-test="learning-moment-evidence-share-text" class="icon-textbox share-text" href="{{ baseUrl }}?momentType=text&amp;{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}" title="Write something">Write something</a>
    </div>
    <!-- Check that the device supports recording audio/video, and if not hide the buttons that aren't supported -->
    <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/checkShareWorkButtons.js?v={{ config.site_version }}"></script>
    <a class="close-reveal-modal" aria-label="Close">×</a>
</div>
