{##
 # Share a Learning Moment
 #
 # @param bool $moderationRequired  Decide if the current user's post requires moderation
 # @param bool $hasComments         Indicates whether there is at least one comment associated with this learning moment
   editorTemplates array Retrieve any pre-existing editor templates to insert into the 'Body' rich text editor
 #}
{% import 'sub/breadcrumbs.twig' as bread %}

{% if isCreate %}
    {{ bread.crumbs(
        [ 'Share Learning' ]
    ) }}
    {% set heading = 'Share a' %}
{% else %}
    {{ bread.crumbs(
        [evidence.recipient.fullName, '/search/user/' ~ evidence.recipient.id],
        ['Learning Moment', routeLookupIfAuthorized('@learningMomentEvidence.getEvidenceDetail', {evidenceId: evidence.id})],
        ['Modify']
    ) }}

    {# Moderation Workflow
     # If this Moment is submitted and moderation is required,
     # the form POSTs to the Moderation controller's postPublish
     # which will also do other stuff like deleting comments.
     #
     # Otherwise, presume updating the Moment's contents as a student
     #}
    {% if USER.role.isStaff and USER.role.accessEvidence and evidence.isSubmitted %}
        {% set heading = 'Publish a' %}
    {% else %}
        {% set heading = 'Modify' %}
    {% endif %}
{% endif %}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ heading }} Learning Moment</h1>
            {##
             # How does the "sharing on behalf of" metadata show?
             # That depends on who the learning moment is being created for:
             # * Only for myself: don't show at all
             # * Only for others: "sharing on behalf of ..."
             # * For both myself and others: "Sharing for myself, and also on behalf of ..."
             # * For neither myself nor others: how did you even get here?
             #}
            {% if otherUsers is not empty %}
                <ul class="meta">
                    <li>
                        {% include 'sub/userListMetadata.twig'
                            with {
                                users:   otherUsers,
                                message: sharingForSelf ? 'Sharing for myself, and also on behalf of' : 'Sharing on behalf of'
                            } only
                        %}
                    </li>
                </ul>
            {% endif %}
        </div>
    </div>

    {% if evidence is defined and evidence.id %}
        {% set deleteRoute = routeLookupIfAuthorized('learningMomentEvidence.deleteEvidence', {evidenceId: evidence.id, creatorId: evidence.creator.id}) %}

        {% if deleteRoute %}
            <nav>
                <sbx-pop-out content-id="overflow"></sbx-pop-out>
            </nav>
            <ul class="f-dropdown" data-dropdown-content id="overflow">
                <li><a data-delete href="{{ deleteRoute }}" class="icon-delete">Delete</a></li>
            </ul>
        {% endif %}
    {% endif %}
</div>
{% if isCreate %}
    {# Share a Learning Moment from the Class List #}
    {% set routePublish = routeLookupIfAuthorized('learningMomentEvidence.postPublish', {userIds: userIds|join(',')}) %}
    {% set routeDraft = routeLookupIfAuthorized('learningMomentEvidence.postDraft', {userIds: userIds|join(',')}) %}
    {% set formAction = routeLookup('learningMomentEvidence.postMomentForUsers', {userIds: userIds|join(',')}) %}
{% else %}
    {% set routeDraft = routeLookupIfAuthorized('learningMomentEvidence.putDraft', {evidenceId: evidence.id, creatorId: evidence.creator.id, userId: evidence.recipient.id }) %}
    {% set routePublish = routeLookupIfAuthorized('learningMomentEvidence.putPublish', {evidenceId: evidence.id, creatorId: evidence.creator.id, userId: evidence.recipient.id }) %}
    {# Moderation Workflow
     # If this Moment is submitted and moderation is required,
     # the form POSTs to the Moderation controller's postPublish
     # which will also do other stuff like deleting comments.
     #
     # Otherwise, presume updating the Moment's contents as a student
    #}
    {% if USER.role.isStaff and USER.role.accessEvidence and evidence.isSubmitted %}
        {% set heading = 'Publish a' %}
        {% set formAction = routeLookup('learningMomentModeration.putPublish', {evidenceId: evidence.id}) %}
    {% else %}
        {% set heading = 'Modify' %}
        {% set formAction = routeLookup('learningMomentEvidence.putEvidence', {evidenceId: evidence.id}) %}
    {% endif %}
{% endif %}

{% if USER.role.isStudent %}
    {% if moderationRequired and (evidence.isDraft or evidence.isRejected) %}
        {% if isCreate %}
            {% set routeSubmit = routeLookupIfAuthorized('learningMomentEvidence.postSubmit', {userIds: userIds|join(',')}) %}
        {% else %}
            {% set routeSubmit = routeLookupIfAuthorized('learningMomentEvidence.putSubmit', {evidenceId: evidence.id, creatorId: evidence.creator.id, userId: evidence.recipient.id }) %}
        {% endif %}
    {% elseif moderationRequired and (evidence.isSubmitted or evidence.isPublished) %}
        {# noop:
         # nothing for the student to do except w8 for staff to move it to the next state because:
         #     - it's submitted and has entered the moderation workflow; or
         #     - it's already published and you shouldn't be able to publish again
        #}
    {% else %}
        {% if isCreate %}
            {% set routeSubmit = routeLookupIfAuthorized('learningMomentEvidence.postPublish', {userIds: userIds|join(',')}) %}
        {% else %}
            {% set routeSubmit = routeLookupIfAuthorized('learningMomentEvidence.putPublish', {evidenceId: evidence.id, creatorId: evidence.creator.id, userId: evidence.recipient.id }) %}
        {% endif %}
    {% endif %}
{% endif %}

<div class="row">
    <div class="small-12 island">
        {# form action is intentionally controlled via javascript now #}
        <form action="" method="{% if isCreate %}post{% else %}put{% endif %}" id="evidence-form" data-action-draft="{{ routeDraft }}" data-action-submit="{{ formAction }}" data-action-publish="{{ routePublish }}">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        {% block formInputFile %}
                        {% endblock formInputFile %}
                        {% block formInputBody %}
                            {% block formInputBodyMeta %}
                                {% if USER.role.staff %}
                                    <p class="meta">
                                        Student detail tokens can be viewed when you press [. Tokens will be substituted with the students details on creation.
                                    </p>
                                {% endif %}
                            {% endblock formInputBodyMeta %}
                        {% endblock formInputBody %}
                        <label for="evidence-tags">Tags</label>
                        <select data-tags name="tags[]" id="evidence-tags" multiple></select>
                        {% if curriculumTaggingEnabled %}
                            <label for="curriculum-code-select">
                                Curriculum Codes
                            </label>
                            {% include 'sub/curriculumCodeSelector.twig' with
                                {
                                    codeList: curriculumCodes ?? [],
                                    renderButton: true
                                } %}
                        {% endif %}
                    </div>
                </fieldset>
            </section>

            {# Moderation Workflow
             # Staff and students share this area, but their buttons are differently described
             #}
            <ul class="flex-list buttons">
                <li><button id="draft">Save for later</button></li>

                <script>
                    $(function() {
                        $('#draft').on('click', function(event) {
                            event.preventDefault();

                            $('#evidence-form').attr('action', $('#evidence-form').data('action-draft'));

                            $('#evidence-persist').trigger('click');
                        });
                    });
                </script>

                {% if USER.role.isStudent %}
                    {% set action = 'submit' %}
                    {% if moderationRequired and (evidence.isDraft or evidence.isRejected) %}
                        <li><button id="submit">Submit for approval</button></li>
                    {% elseif moderationRequired and (evidence.isSubmitted or evidence.isPublished) %}
                        {# noop:
                         # nothing for the student to do except w8 for staff to move it to the next state because:
                         #     - it's submitted and has entered the moderation workflow; or
                         #     - it's already published and you shouldn't be able to publish again
                         #}
                    {% else %}
                        {% set action = 'publish' %}
                        <li><button id="submit" class="submit">Publish</button></li>
                    {% endif %}

                    <script>
                        $(function() {
                            $('#submit').on('click', function(event) {
                                event.preventDefault();

                                $('#evidence-form').attr('action', $('#evidence-form').data('action-{{ action }}'));

                                $('#evidence-persist').trigger('click');
                            });
                        });
                    </script>
                {% elseif USER.role.isParent and config.evidence_parent_create %}
                    {# Parents bypass moderation entirely #}
                    <li><button id="submit" class="submit">Publish</button></li>

                    <script>
                        $(function() {
                            $('#submit').on('click', function(event) {
                                event.preventDefault();

                                $('#evidence-form').attr('action', $('#evidence-form').data('action-publish'));

                                $('#evidence-persist').trigger('click');
                            });
                        });
                    </script>
                {% elseif USER.role.isStaff and USER.role.accessEvidence %}
                    {# Used to decide if comments should be deleted upon publish #}
                    <input type="hidden" name="delete-comments" id="delete-comments" value="0" />

                    {% if evidence.isDraft or evidence.isSubmitted or evidence.isRejected %}
                        {# This triggers an async request to Reject+reason
                         # For the implementation, scroll down to the modal
                         #}
                        {% if evidence.id %}
                            <li><button id="request-update" data-test="learning-moment-evidence-form-reject">Request update</button></li>
                        {% endif %}

                        {# Publish with optional comment deletion
                         # This spawns a modal, which allows for the setting of a flag,
                         # prior to the usual form submission. Sorry about all these cloak-and-dagger input fields
                         # that I need to deconflict at least four workflows in via form + ckeditor bug
                         #}
                        <li><button id="publish" class="submit" data-test="learning-moment-evidence-form-approve">Publish</button></li>

                        <script>
                            $(function() {
                                $('#publish').on('click', function(event) {
                                    event.preventDefault();

                                    $('#evidence-form').attr('action', $('#evidence-form').data('action-publish'));

                                    {% if hasComments ?? false %}
                                        {# Show the modal with an option to delete comments #}
                                        $('#deleteCommentsModal').foundation('reveal', 'open');

                                        {# Set a special flag for the payload to capture
                                         # then proceed to submit the form
                                         #}
                                        $('#deleteComments').on('click', function (event) {
                                            event.preventDefault();

                                            $('#delete-comments').val(1);

                                            $('#evidence-persist').trigger('click');
                                        });

                                        {# Continue with no further alterations #}
                                        $('#preserveComments').on('click', function () {
                                            $('#evidence-persist').trigger('click');
                                        });
                                    {% else %}
                                        $('#evidence-persist').trigger('click');
                                    {% endif %}
                                })
                            });
                        </script>
                    {% elseif isCreate %}
                        {# "Share a Learning Moment" via the Class List #}
                        <li><button id="publish" class="submit">Publish</button></li>
                    {% endif %}
                {% endif %}
            </ul>
            <input type="submit" id="evidence-persist" data-test="learning-moment-evidence-form-submit" value="Secret Submit" style="display:none" />
        </form>
    </div>
</div>

{# Moderation Workflow
 # This modal offers the moderator an opportunity to delete all associated comments.
 # Agreeing to that sets a hidden input field which is then interpreted by the
 # buildPayload method, injecting this for controllers to use.
 #}
{% if USER.role.isStaff and USER.role.accessEvidence and evidence.id and (evidence.isDraft or evidence.isSubmitted or evidence.isRejected) and hasComments %}
    <div id="deleteCommentsModal" class="reveal-modal" data-reveal aria-labelledby="deleteCommentsModalTitle" aria-hidden="true" role="dialog">
        <h2 id="deleteCommentsModalTitle">Please confirm</h2>
        <p>There are comments on this learning moment that have already been made and will become visible to parents.</p>
        <p>Do you want to delete these comments?</p>

        <ul class="flex-list buttons">
            <li><button id="deleteComments" class="submit">Delete and continue</button></li>
            <li><button id="preserveComments">Continue</button></li>
        </ul>

        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>
    <script>
        $(function() {
            $(document).on('closed.fndtn.reveal', '#deleteCommentsModal', function () {
                $('#evidence-persist').prop('disabled', false);
            });
        });
    </script>
{% endif %}

{# Moderation Workflow
 # A secret form that submits a secret payload to the rejection endpoint when the Request Update
 # button is clicked; this exists inside some other form.
 #
 # Rejection is available when:
 #    - evidence.id exists (it's been saved before)
 #    - evidence is in one of draft, submitted, rejected states
 #}
{% if USER.role.isStaff and USER.role.accessEvidence and evidence.id and (evidence.isDraft or evidence.isSubmitted or evidence.isRejected) %}
    {% set rejectAction = routeLookupIfAuthorized('learningMomentModeration.putReject', {evidenceId: evidence.id}) %}

    <div id="rejectModal" class="reveal-modal" data-reveal aria-labelledby="rejectModalTitle" aria-hidden="true" role="dialog">
        <h2 id="rejectModalTitle">Request update</h2>
        <p>You have requested the student updates their learning moment before it is published.</p>
        <p>Provide feedback to the student. This will appear as a comment that can be deleted later.</p>

        <form id="rejectionForm" method="post" action="{{ rejectAction }}">
            <textarea id="rejectionReason" name="rejectionReason"></textarea>

            <button type="submit" class="icon-surveys">Request update</button>
        </form>

        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    </div>

    <script>
        $(function() {
            $('#request-update').on('click', function(event) {
                event.preventDefault();

                $('#rejectModal').foundation('reveal', 'open');
            });

            {# Hijack the existing modify form to send it to the rejection endpoint,
             # injecting the rejection data into the modify form.
             #}
            $('#rejectionForm').on('submit', function(event) {
                event.preventDefault();

                $('#evidence-form')
                    .attr('action', '{{ rejectAction }}')
                    .append($('#rejectionReason'));

                {# Hide it lol #}
                $('#rejectionReason').css('opacity', 0);

                {# If you just use $('#evidence-form').submit() the ckeditor contents won't update
                 # prior to payload being constructed, sending you the original text rather than
                 # the updated text. To dodge this ckeditor hankypanky we just simulate a user click
                 #}
                $('#evidence-persist').trigger('click');
            });
        });
    </script>
{% endif %}


{# Set up CKEditor #}
<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
{# only autosave draft when:
 * there is either only sharing for yourself, or 1 other person
    * the evidence already exists (an evidence entry can only be for 1 user)
        * (when bulk creating learning moments and it (would) autosave, it would return an array of students and and then you could only continue / or publish/submit one student, not all...
        * so we prevent autodraft when there are multiple students)
 * AND the evidence is not published
#}
{% if (evidence.id or (sharingForSelf or (otherUsers | length == 1))) and not evidence.isPublished %}
    <script src="{{ CDN_PREFIX }}/js/comms/draft.js?v={{ config.site_version }}"></script>
{% endif %}
{% block formJs %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            let buildValidationRules = function () { //so the child .twig templates can customise
                return {};
            }
            let buildValidationMessages = function () { //so the child .twig templates can customise
                return {};
            }
        </script>
    {% endautoescape %}
{% endblock formJs %}

{% autoescape 'js' %}
    <script type="text/javascript">
        let buildPayload = function (form) {
            let formData = new FormData(form),
                payload = {
                    body: formData.get('body'),
                    evidence: [{
                        file: formData.get('file')
                    }],
                    curriculumNodes: [],
                    tags: [],
                    type: '{{ momentType }}',
                    {# Moderation Workflow
                     # Append a rejection reason; this payload can go to putEvidence()
                     # or putReject() depending on what the staff did. Rejection changes
                     # the form url to go to putReject() where it essentially does the
                     # same thing as putEvidence().
                     #}
                    rejectionReason: formData.get('rejectionReason'),
                    {# Moderation Workflow
                     # For when someone chose "Delete and continue"
                     #}
                    deleteComments: formData.get('delete-comments'),
                };

            let tags = form.querySelector('#evidence-tags').selectize.items;
            payload.tags = tags.map(
                (v) => {
                    return {id: Number(v)}
                }
            );
            {% if curriculumTaggingEnabled %}
                payload.curriculumNodes = [form.querySelector('input[name="curriculumCodes[]"]').value];
            {% endif %}
            return payload;
        }

        $(function () {
            /**
             * Initialise the editor, enabling tokens if the user is staff
             */
            document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
                detail: {
                    targetElements: ['#evidence-body'],
                    {% if USER.role.staff %}hasTokens: true,{% endif %}
                    {% if editorTemplates is defined %}
                        templates: {{ editorTemplates|json_encode|raw }},
                    {% endif %}
                }
            }));

            /**
             * To determine whether a media recording has to be uploaded prior to continuing with form submission
             *
             * @return { Boolean }
             */
            const isMediaUploadRequired = () => {
                const momentType = '{{ momentType }}';
                return (momentType === 'video' || momentType === 'audio' || momentType === 'photo')
                        && (document.getElementById('file').value === '');
            }

            let isSubmittingForm = false; //ensure not submitting the form more than once

            /**
             * To upload the form
             *
             * @params { <form> element }
             */
            const submitForm = (form) => {
                if (!isSubmittingForm) {
                    isSubmittingForm = true;

                    {# This is either POST or PUT
                     # ...it depends on whether you're creating a new thing, or modifying an existing thing
                     # html forms don't support PUT, only the classical POST and GET methods.
                     #}
                    let formMethod = form.attributes.method.value;

                    // Build a request to post the form
                    let payload = buildPayload(form),
                        toast   = $('#toast'),
                        submit  = $('#evidence-form, #rejectionForm, #deleteCommentsModal').find('input[type="submit"], button');

                    // Toast then post
                    toast.toastActivate('Saving...')
                    submit.prop('disabled', true);

                    {# Moderation Workflow
                     # Rejection is based on the presence of the rejectionReason node in the payload
                     #}
                    if (null !== payload.rejectionReason) {
                        formMethod = 'put';
                    }

                    // Redirect to the return URL provided
                    fetch(form.action, {
                        method: formMethod,
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(payload)
                    })
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error("Save failed!");
                        }
                        toast.toastTimeout({text: 'Saved'});
                        window.location.href = '{{ RETURN_URL.previous.decoded ?? '/' }}';
                        isSubmittingForm = false;
                    })
                    .catch(() => {
                        toast.toastTimeout({text: 'Save failed', css: 'alert'});
                        submit.prop('disabled', false);
                        isSubmittingForm = false;
                    });
                }
            }

            $('#evidence-form').alaressValidate({
                rules: buildValidationRules(),
                messages: buildValidationMessages(),
                submitHandler(form, event) {
                    event.preventDefault();

                    //disable on select to prevent multiple submits
                    /* it already does this during the submitForm() method, not sure why we do it twice
                     * but whatever
                     */
                    $('#evidence-form').find('input[type="submit"], button').prop('disabled', true);

                    if (isMediaUploadRequired()) {
                        document.getElementById('evidence-media-recording').scrollIntoView({behavior: 'smooth'}); //uploading can take a while, so scroll up to know that it's processing
                        document.removeEventListener('evidence-media-recording__onUploadComplete', submitForm);
                        document.addEventListener('evidence-media-recording__onUploadComplete', (event) => submitForm(form)); //once the media is uploaded, #evidence-media-recording.vue will dispatch
                        document.dispatchEvent(new CustomEvent('evidence-media-recording__onFormSubmit')); //dispatch to allow the media recording to start uploading
                    } else {
                        event.preventDefault();

                        submitForm(form);
                    }
                }
            });

            $('[data-tags]').selectizeSelector({
                ajax: {
                    url: '{{ routeLookup('learningMomentEvidence.getTags') }}',
                    type: 'GET',
                    dataType: 'json'
                },
                selectize: {
                    placeholder: '',
                    preload: true,
                    persist: true,
                    hideSelected: true,
                    load: function (query, callback) {
                        // Load: get values from AJAX, and callback with result
                        var ajaxSettings = {
                            url: '{{ routeLookup('learningMomentEvidence.getTags') }}',
                            type: 'GET',
                            dataType: 'json',
                        };
                        $.ajax(ajaxSettings)
                            .done(function (result) {
                                callback(result)
                            })
                            .fail(function () {
                                callback()
                            })
                    }
                },
                value: [
                    {% for tag in (isCreate ? [] : evidence.tags) %}
                        {'id': '{{ tag.id }}', 'name': '{{ tag.name | escape('js') }}'},
                    {% endfor %}
                ],
                multiple: true
            });

            {# stolen from @see library/Schoolbox/Learning/Moment/templates/detail.twig #}
            $('#container').on('click', 'a[data-delete]', function(event) {
                event.preventDefault();

                let element = $(this);
                let toast = $('[data-toast]');

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this Learning Moment?',
                    confirmLabel: 'Delete',
                    confirmEvent: function() {
                        toast.toastActivate({
                            'text': 'Deleting Learning Moment...'
                        });

                        $.ajax({
                            url: element.attr('href'),
                            type: 'DELETE',
                            success: function(result) {
                                toast.toastTimeout({text: 'Learning Moment deleted', css: 'success'});

                                /* Redirect to dashboard, I guess
                                 */
                                window.location.href = '{{ RETURN_URL.previous.decoded ?? '/' }}';
                            },
                            error: function() {
                                toast.toastTimeout({text: 'Delete failed', css: 'alert'});
                            }
                        });
                    }
                });
            });

            {# only autosave draft when:
             * there is either only sharing for yourself, or 1 other person
             * the evidence already exists (an evidence entry can only be for 1 user)
             * AND the evidence is not published
            #}
            {% if (evidence.id or (sharingForSelf or (otherUsers | length == 1))) and not evidence.isPublished %}
                var $createForm = $('#evidence-form');
                var $submitButton = $('#evidence-submit');
                // Init draft plugin
                $createForm.draft({
                    inputs: ['#evidence-tags', '#curriculum-code-select', 'input[name="curriculumCodes[]"]'],
                    textareas: ['evidence-body'],
                    {# only check files if we are accepting files #}
                    {% if momentType != 'text' %}
                        attachzones: ['#storage-zone'],
                        files: [{ filename: '#evidence-filename', storage: '#file' }],
                    {% endif %}
                    toaster: $('#toast'),
                    staller: $submitButton,
                    onSaveSuccess: function (response) {
                        // initial create response is an array of students
                        // modify form is a single student (no array)
                        // so we need to check if the response is an array or not
                        // and then update the form action accordingly
                        if (!Array.isArray(response)) {
                            response = [response];
                        }
                        // Update the form actions (document, so it works for the save)
                        document.querySelector('#evidence-form').dataset.actionDraft = response[0]._links.put;
                        document.querySelector('#evidence-form').dataset.actionPublish = response[0]._links.publish;
                        document.querySelector('#evidence-form').action = response[0]._links.put;
                        document.querySelector('#evidence-form').method = 'put';

                        // update jquery / draft js (has weird cache)
                        $createForm.data('action-draft', response[0]._links.put);
                        $createForm.data('action-publish', response[0]._links.publish);
                        $createForm.attr('action', response[0]._links.put);
                        $createForm.attr('method', 'put');

                        {% if USER.role.isStudent %}
                            {% if moderationRequired and (evidence.isDraft or evidence.isRejected) %}
                                $createForm.data('action-submit', response[0]._links.submit);
                                document.querySelector('#evidence-form').dataset.actionSubmit = response[0]._links.submit;
                            {% elseif moderationRequired and (evidence.isSubmitted or evidence.isPublished) %}
                                {# noop:
                                             # nothing for the student to do except w8 for staff to move it to the next state because:
                                             #     - it's submitted and has entered the moderation workflow; or
                                             #     - it's already published and you shouldn't be able to publish again
                                #}
                            {% else %}
                                $createForm.data('action-submit', response[0]._links.publish);
                                document.querySelector('#evidence-form').dataset.actionSubmit = response[0]._links.publish;
                            {% endif %}
                        {% endif %}

                        // Update the window history
                        window.history.pushState({}, null, response[0]._links.modifyForm);
                    },
                    getFormData: () => {
                        let payload = buildPayload(document.querySelector('#evidence-form'));
                        payload.draft = true;
                        payload.body = window.sbProps.editors['evidence-body'].getData();
                        return JSON.stringify(payload);
                    },
                    contentType: 'application/json',
                });
            {% endif %}
        });
    </script>
{% endautoescape %}

<div id="toast" class="toast"></div>
