{##
 # Share a Learning Moment
 #
 TODO: update these
 # @param bool $moderationRequired  Decide if the current user's post requires moderation
 # @param bool $hasComments         Indicates whether there is at least one comment associated with this learning moment
 # @param array $editorTemplates    Retrieve any pre-existing editor templates to insert into the 'Body' rich text editor
 # @param Collection $folders       A set of folders that -could- be associated with this learning moment based on the recipient's access
 # @param array $selectedFolders    A set of folder ids currently associated with this learning moment (could be empty)
 #}
{% import 'sub/breadcrumbs.twig' as bread %}

{% if isCreate %}
    {{ bread.crumbs(
        [ 'Share Learning' ]
    ) }}
    {% set heading = 'Share a' %}
{% else %}
    {{ bread.crumbs(
        [evidence.recipient.fullName, '/search/user/' ~ evidence.recipient.id],
        ['Learning Moment', routeLookupIfAuthorized('@learningMomentEvidence.getEvidenceDetail', {evidenceId: evidence.id})],
        ['Modify']
    ) }}

    {# Moderation Workflow
     # If this Moment is submitted and moderation is required,
     # the form POSTs to the Moderation controller's postPublish
     # which will also do other stuff like deleting comments.
     #
     # Otherwise, presume updating the Moment's contents as a student
     #}
    {% if USER.role.isStaff and USER.role.accessEvidence and evidence.isSubmitted %}
        {% set heading = 'Publish a' %}
    {% else %}
        {% set heading = 'Modify' %}
    {% endif %}
{% endif %}

<div id="learning-moment-form-container">
    <moment-form
        :has-autosave="{{ payload.hasAutosave ? 'true' : 'false' }}"
        return-url="{{ RETURN_URL.previous.decoded ?? '/' }}"
        :create-routes="{{ payload.createRoutes|json_encode }}"
        :moment="{{ payload.evidence|json_encode }}"
        endpoint-get-evidence-tags="{{ routeLookup('learningMomentEvidence.getTags') }}"
        {% if payload.curriculumTaggingEnabled %}
        :curriculum-nodes="{{ payload.curriculumNodes|json_encode }}"
        endpoint-curriculum-nodes="{{ routeLookup('curriculumApi.searchNode') }}"
        {% else %}
        :curriculum-nodes="[]"
        :endpoint-curriculum-nodes="null"
        {% endif %}
        :folders="{{ payload.folders|json_encode }}"
        :selected-folders="{{ payload.selectedFolders|json_encode }}"
    >
        <template v-slot:heading>
            <h1>{{ heading }} Learning Moment</h1>
            {##
             # How does the "sharing on behalf of" metadata show?
             # That depends on who the learning moment is being created for:
             # * Only for myself: don't show at all
             # * Only for others: "sharing on behalf of ..."
             # * For both myself and others: "Sharing for myself, and also on behalf of ..."
             # * For neither myself nor others: how did you even get here?
             #}
            {% if otherUsers is not empty %}
                <ul class="meta">
                    <li>
                        {% include 'sub/userListMetadata.twig'
                            with {
                                users:   otherUsers,
                                message: sharingForSelf ? 'Sharing for myself, and also on behalf of' : 'Sharing on behalf of'
                            } only
                        %}
                    </li>
                </ul>
            {% endif %}
        </template>
    </moment-form>
</div>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/learningMomentForm.js?v={{ config.site_version }}"></script>


<div class="row">
    <div class="small-12 island">
        {# form action is intentionally controlled via javascript now #}
        <form action="" method="{% if isCreate %}post{% else %}put{% endif %}" id="evidence-form" data-action-draft="{{ routeDraft }}" data-action-submit="{{ formAction }}" data-action-publish="{{ routePublish }}">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        {% block formInputFile %}
                        {% endblock formInputFile %}
                        {% block formInputBody %}
                            {% block formInputBodyMeta %}
                                {% if USER.role.staff %}
                                    <p class="meta">
                                        Student detail tokens can be viewed when you press [. Tokens will be substituted with the students details on creation.
                                    </p>
                                {% endif %}
                            {% endblock formInputBodyMeta %}
                        {% endblock formInputBody %}
                    </div>
                </fieldset>
            </section>
        </form>
    </div>
</div>
