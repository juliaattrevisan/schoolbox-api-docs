<style type="text/css">
    .student-toolkit {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        padding: 1rem;
    }
    .student-toolkit .profile-image {
        flex-grow: 0;
    }
    .student-toolkit .buttons {
        flex-grow: 1;
        display: grid;
        gap: 0.5rem;
        /* Two columns for now: TODO make this scale sensibly to all screens */
        grid-template-columns: 1fr 1fr;
        /*flex-direction: row;*/
        /*align-items: stretch;*/
    }
    .student-toolkit .buttons .button {
        /*flex-grow: 1;*/
    }
</style>
<div class="small-12 columns no-pad">
    <div class="student-toolkit">
        <img class="profile-image" alt="{{ user.fullName }}" src="/portrait.php?id={{ user.id }}&amp;size=profile" />
        <div class="buttons">
            <a class="button" href="#" data-reveal-id="component{{ component.instance.id }}-shareWork">Share my work</a>
            <a class="button" href="#">Set my goals</a>
            <a class="button" href="#">My Achievements</a>
            <a class="button" href="/user/profile/{{ user.id }}">My Activity</a>
        </div>
    </div>
</div>

<div data-reveal id="component{{ component.instance.id }}-shareWork" aria-hidden="true" class="reveal-modal">
    <h2>Share a Learning Moment</h2>
    <form>
        <input type="radio"
               name="moment-type"
               value="photo"
               id="component{{ component.instance.id }}-momentType-photo">
        <label for="component{{ component.instance.id }}-momentType-photo" class="block"><i class="icon-resource-booking"></i>Take a photo</label>

        <input type="radio"
               name="moment-type"
               value="video"
               id="component{{ component.instance.id }}-momentType-video">
        <label for="component{{ component.instance.id }}-momentType-video" class="block"><i class="icon-video"></i>Record a video</label>

        <input type="radio"
               name="moment-type"
               value="audio"
               id="component{{ component.instance.id }}-momentType-audio">
        <label for="component{{ component.instance.id }}-momentType-audio" class="block"><i class="icon-audio"></i>Record audio</label>

        <input type="radio"
               name="moment-type"
               value="upload"
               id="component{{ component.instance.id }}-momentType-upload">
        <label for="component{{ component.instance.id }}-momentType-upload" class="block"><i class="icon-upload"></i>Upload image or video</label>

        <input type="radio"
               name="moment-type"
               value="text"
               id="component{{ component.instance.id }}-momentType-text">
        <label for="component{{ component.instance.id }}-momentType-text" class="block"><i class="icon-textbox"></i>Write something</label>

        <button type="submit">Continue</button>

    </form>
    <a class="close-reveal-modal" aria-label="Close">×</a>
</div>
