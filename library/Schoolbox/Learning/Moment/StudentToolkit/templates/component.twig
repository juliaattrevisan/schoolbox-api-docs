{% set createLearningMomentEvidenceUrl = routeLookupIfAuthorized(
    'learningMomentEvidence.getCreateForm',
    {
        users:   [user],
        userIds: user.id
    }
) %}

<div class="small-12 columns no-pad">
    <div class="student-toolkit">
        <div class="profile-image">
            <a href="/search/user/{{ user.id }}" title="View profile">
                <img alt="{{ user.fullName }}" src="/portrait.php?id={{ user.id }}&amp;size=square64" />
            </a>
        </div>
        <div class="buttons">
            {% if createLearningMomentEvidenceUrl %}
                <a class="button icon-share" href="#" data-reveal-id="component{{ component.instance.id }}-shareWork">Share my work</a>
            {% endif %}
            <a class="button icon-goal" href="#">Set my goals</a>
            <a class="button icon-advanced-list" href="/search/user/{{ user.id }}">My Activity</a>
            <a class="button icon-trophy" href="#">My Achievements</a>
        </div>
    </div>
</div>

{% if createLearningMomentEvidenceUrl %}
    <div data-reveal id="component{{ component.instance.id }}-shareWork" aria-hidden="true" class="reveal-modal">
        <h2>Share a Learning Moment</h2>
        <form id="component{{ component.instance.id }}-shareWork-form" action="{{ createLearningMomentEvidenceUrl }}">
            <input name="{{ RETURN_URL.name }}" value="{{ RETURN_URL.current }}" type="hidden" />
            <input type="radio"
                   name="momentType"
                   value="photo"
                   id="component{{ component.instance.id }}-momentType-photo">
            <label for="component{{ component.instance.id }}-momentType-photo" class="block"><i class="icon-camera"></i>Take a photo</label>

            <input type="radio"
                   name="momentType"
                   value="video"
                   id="component{{ component.instance.id }}-momentType-video">
            <label for="component{{ component.instance.id }}-momentType-video" class="block"><i class="icon-video"></i>Record a video</label>

            <input type="radio"
                   name="momentType"
                   value="audio"
                   id="component{{ component.instance.id }}-momentType-audio">
            <label for="component{{ component.instance.id }}-momentType-audio" class="block"><i class="icon-audio"></i>Record audio</label>

            <input type="radio"
                   name="momentType"
                   value="upload"
                   id="component{{ component.instance.id }}-momentType-upload">
            <label for="component{{ component.instance.id }}-momentType-upload" class="block"><i class="icon-upload"></i>Upload file</label>

            <input type="radio"
                   name="momentType"
                   value="text"
                   id="component{{ component.instance.id }}-momentType-text">
            <label for="component{{ component.instance.id }}-momentType-text" class="block"><i class="icon-textbox"></i>Write something</label>

            <button id="component{{ component.instance.id }}-shareWork-submit" type="submit">Continue</button>

        </form>
        <a class="close-reveal-modal" aria-label="Close">×</a>
    </div>
{% endif %}
