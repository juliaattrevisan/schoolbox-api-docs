{% set createLearningMomentEvidenceUrl = routeLookupIfAuthorized(
    'learningMomentEvidence.getCreateForm',
    {
        users:   [user],
        userIds: user.id
    }
) %}

<div class="small-12 columns no-pad">
    <div class="student-toolkit">
        <div class="profile-image">
            <a href="/search/user/{{ user.id }}" title="View profile">
                <img alt="{{ user.fullName }}" src="/portrait.php?id={{ user.id }}&amp;size=square64" />
            </a>
        </div>
        <div class="buttons">
            {% if createLearningMomentEvidenceUrl %}
                <a class="button icon-share" href="#" data-reveal-id="component{{ component.instance.id }}-shareWork">Share my work</a>
            {% endif %}
            <a class="button icon-goal" href="#">Set my goals</a>
            <a class="button icon-advanced-list" href="/search/user/{{ user.id }}">My Activity</a>
            <a class="button icon-trophy" href="#">My Achievements</a>
        </div>
    </div>
</div>

{% if createLearningMomentEvidenceUrl %}
    <div data-reveal id="component{{ component.instance.id }}-shareWork" aria-hidden="true" class="reveal-modal small">
        <h2>Share a Learning Moment</h2>
        <a href="{{ createLearningMomentEvidenceUrl }}?momentType=photo&amp;{{ RETURN_URL.name }}={{ returnUrl }}" class="block"><i class="icon-camera"></i>Take a photo</a>
        <a href="{{ createLearningMomentEvidenceUrl }}?momentType=video&amp;{{ RETURN_URL.name }}={{ returnUrl }}" class="block"><i class="icon-video"></i>Record a video</a>
        <a href="{{ createLearningMomentEvidenceUrl }}?momentType=audio&amp;{{ RETURN_URL.name }}={{ returnUrl }}" class="block"><i class="icon-audio"></i>Record audio</a>
        <a href="{{ createLearningMomentEvidenceUrl }}?momentType=upload&amp;{{ RETURN_URL.name }}={{ returnUrl }}" class="block"><i class="icon-upload"></i>Upload file</a>
        <a href="{{ createLearningMomentEvidenceUrl }}?momentType=text&amp;{{ RETURN_URL.name }}={{ returnUrl }}" class="block"><i class="icon-textbox"></i>Write something</a>
        <a class="close-reveal-modal" aria-label="Close">×</a>
    </div>
{% endif %}
