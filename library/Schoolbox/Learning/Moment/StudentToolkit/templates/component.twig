{% set createLearningMomentEvidenceUrl = routeLookupIfAuthorized(
    'learningMomentEvidence.getCreateForm',
    {
        users:   [user],
        userIds: user.id
    }
) %}

<div class="small-12 columns no-pad">
    <div class="student-toolkit">
        <div class="profile-image">
            <a href="/search/user/{{ user.id }}" title="View profile">
                <img alt="{{ user.fullName }}" src="/portrait.php?id={{ user.id }}&amp;size=square64" />
            </a>
        </div>
        <div class="buttons">
            {% if createLearningMomentEvidenceUrl %}
                <a class="button sbx-button--has-icon" href="#" data-reveal-id="component{{ component.instance.id }}-shareWork"><sbx-icon name="share"></sbx-icon>Share Learning</a>
            {% endif %}
            {% if config.badges_enabled %}
                     <a class="button sbx-button--has-icon"
                         href="{{ routeLookupIfAuthorized('learningBadgeAward.getSetAsGoalForSelfForm') }}?{{ RETURN_URL.name }}={{ returnUrl ?? RETURN_URL.current }}"><sbx-icon name="goal"></sbx-icon>Set My Goals</a>
            {% endif %}
            <a class="button sbx-button--has-icon" href="/search/user/{{ user.id }}#activity"><sbx-icon name="advanced-list"></sbx-icon>My Activity</a>
            {% if config.badges_enabled %}
                <a class="button sbx-button--has-icon" href="/search/user/{{ user.id }}#achievements"><sbx-icon name="achievement"></sbx-icon>My Achievements</a>
            {% endif %}
        </div>
    </div>
</div>

{% if createLearningMomentEvidenceUrl %}
    {% include '@learningMomentEvidence/shareModal.twig' with {
        id:               "component#{component.instance.id}-shareWork",
        baseUrl:          createLearningMomentEvidenceUrl,
        encodedReturnUrl: returnUrl,
    } only %}
{% endif %}
