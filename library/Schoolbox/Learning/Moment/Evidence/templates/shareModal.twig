{##
 # The Twig version of the share learning moment modal.

    Parameters:
    id:               the ID of the modal
    baseUrl:          the base URL for the learning moment modal
    encodedReturnUrl: if set, return to this URL after saving the moment.
                      Defaults to the current URL
 #}
<div data-reveal id="{{ id }}" aria-hidden="true" class="reveal-modal small">
    <h2>Share a Learning Moment</h2>
    <a data-action="shareLearningMoment" href="{{ baseUrl }}?momentType=photo&amp;{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}" class="block"><i class="icon-camera"></i>Take a photo</a>
    <a data-action="shareLearningMoment" href="{{ baseUrl }}?momentType=video&amp;{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}" class="block"><i class="icon-video"></i>Record a video</a>
    <a data-action="shareLearningMoment" href="{{ baseUrl }}?momentType=audio&amp;{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}" class="block"><i class="icon-audio"></i>Record audio</a>
    <a data-action="shareLearningMoment" href="{{ baseUrl }}?momentType=upload&amp;{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}" class="block"><i class="icon-upload"></i>Upload file</a>
    <a data-action="shareLearningMoment" href="{{ baseUrl }}?momentType=text&amp;{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}" class="block"><i class="icon-textbox"></i>Write something</a>
    <a class="close-reveal-modal" aria-label="Close">×</a>
</div>
