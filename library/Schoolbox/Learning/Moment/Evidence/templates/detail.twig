{##
 # Evidence Detail Container
 #
 # Launches the detail screen so you can see the fullness of an Evidence,
 # in addition to other parts such as Discussion etc.
 #
 # @param array $evidence  An array, representing a translated Evidence instance
 #}
{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    [evidence.recipient.fullName, '/search/user/' ~ evidence.recipient.id],
    ['Learning Moment']
) }}

<div id="evidence-detail-container">
    <evidence-detail
        :evidence="{{ evidence|json_encode }}" 
        :return-url="{{ RETURN_URL|json_encode }}" 
        :can-comment="{{ learningMomentCanComment ? 'true' : 'false' }}"
        site-version="{{ config.site_version }}"
        cdn-prefix="{{ CDN_PREFIX }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/learningMomentsEvidenceDetail.js?v={{ config.site_version }}"></script>

<script>
    $(function() {
        $('#container').on('click', 'a[data-delete]', function(event) {
            event.preventDefault();

            let element = $(this);
            let toast = $('[data-toast]');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Learning Moment?',
                confirmLabel: 'Delete',
                confirmEvent: function() {
                    toast.toastActivate({
                        'text': 'Deleting Learning Moment...'
                    });

                    $.ajax({
                        url: element.attr('href'),
                        type: 'DELETE',
                        success: function(result) {
                            toast.toastTimeout({text: 'Learning Moment deleted', css: 'success'});

                            /* Redirect to dashboard, I guess
                             */
                            window.location.href = '/';
                        },
                        error: function() {
                            toast.toastTimeout({text: 'Delete failed', css: 'alert'});
                        }
                    });
                }
            });
        });
    });
</script>

<div class="toast" data-toast></div>
