{% import 'sub/breadcrumbs.twig' as bread %}
{% if isCreate %}
{{ bread.crumbs(
    [ 'Share Learning' ]
) }}
    {% set formAction = routeLookup('learningMomentEvidence.postMomentForUsers', {userIds: userIds|join(',')}) %}
{% else %}
    {{ bread.crumbs(
        [evidence.recipient.fullName, '/search/user/' ~ evidence.recipient.id],
        ['Learning Moment', routeLookup('@learningMomentEvidence.getEvidenceDetail', {evidenceId: evidence.id})],
        ['Modify']
    ) }}
    {% set formAction = routeLookup('learningMomentEvidence.putEvidence', {evidenceId: evidence.id}) %}
{% endif %}

<div class="small-12 column">
    <h1>{{ isCreate ? 'Share a' : 'Modify' }} Learning Moment</h1>
    {##
     # How does the "sharing on behalf of" metadata show?
     # That depends on who the learning moment is being created for:
     # * Only for myself: don't show at all
     # * Only for others: "sharing on behalf of ..."
     # * For both myself and others: "Sharing for myself, and also on behalf of ..."
     # * For neither myself nor others: how did you even get here?
     #}
    {% if otherUsers is not empty %}
    <ul class="meta">
        <li>
            {% include 'sub/userListMetadata.twig'
                with {
                    users:   otherUsers,
                    message: sharingForSelf ? 'Sharing for myself, and also on behalf of' : 'Sharing on behalf of'
                } only
            %}
        </li>
    </ul>
    {% endif %}
</div>


<div class="row">
    <div class="small-12 island">
        <form action="{{ formAction }}" method="post" id="evidence-form">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            {% block formInputFile %}
                            {% endblock formInputFile %}
                            {% block formInputBody %}
                                {% block formInputBodyMeta %}
                                    {% if USER.role.staff %}
                                        <p class="meta">
                                            You may use the following tokens that will be substituted with the
                                            students details on creation: [firstname], [surname], [fullname],
                                            [year], [house]
                                        </p>
                                    {% endif %}
                                {% endblock formInputBodyMeta %}
                            {% endblock formInputBody %}
                            <label for="evidence-tags">Tags</label>
                            <select data-tags name="tags[]" id="evidence-tags" multiple></select>
                            {% if curriculumTaggingEnabled %}
                                <label for="curriculum-code-select">Curriculum Codes</label>
                                <div class="input-group">
                                    {% include 'sub/curriculumCodeSelector.twig' with
                                        {
                                            codeList: isCreate ? [] : evidence.curriculumNodes,
                                            renderButton: true
                                        } %}
                                </div>
                            {% endif %}
                        </div>
                    </fieldset>
                </section>
            <input type="submit" id="evidence-submit" value="Submit" />
        </form>
    </div>
</div>


{# Set up CKEditor #}
<script src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/curriculum/jquery.curriculumSelector.js?v={{ config.site_version }}"></script>
{% block formJs %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            let buildValidationRules = function () { //so the child .twig templates can customise
                return {};
            }
            let buildValidationMessages = function () { //so the child .twig templates can customise
                return {};
            }
        </script>
    {% endautoescape %}
{% endblock formJs %}

{% autoescape 'js' %}
<script type="text/javascript">
    let buildPayload = function (form) {
        let formData = new FormData(form),
                payload = {
                    body: formData.get('body'),
                    file: formData.get('file'),
                    curriculumNodes: [],
                    tags: [],
                    type: '{{ momentType }}',
                };
        let tags = form.querySelector('#evidence-tags').selectize.items;
        payload.tags = tags.map(
                (v) => {
                    return {id: Number(v)}
                }
        );
        {% if curriculumTaggingEnabled %}
        payload.curriculumNodes = form.querySelector('input[name="curriculumCodes[]"]').value;
        {% endif %}
        return payload;
    }

    $(function () {

        let editorId = 'evidence-body';

        // Add the user token config.
        // (Maybe only staff should get this, or only if there's more than one user?)
        let baseConfig = {
            targetElements: $('#' + editorId)
        };
        {% if USER.role.staff %}
            $.fn.alaressEditor($.alaressEditorConfigWithUserTokens(baseConfig));
        {% else %}
            $.fn.alaressEditor(baseConfig);
        {% endif %}

        // Update the editor's form input on change
        CKEDITOR.instances[editorId].on('change', CKEDITOR.instances[editorId].updateElement);

        /**
         * To determine whether a media recording has to be uploaded prior to continuing with form submission
         *
         * @return { Boolean }
         */
        const isMediaUploadRequired = () => {
            const momentType = '{{ momentType }}';
            return (momentType === 'video' || momentType === 'audio' || momentType === 'photo')
                    && (document.getElementById('file').value === '');
        }

        let isSubmittingForm = false; //ensure not submitting the form more than once

        /**
         * To upload the form
         *
         * @params { <form> element }
         */
        const submitForm = (form) => {

            if (!isSubmittingForm) {

                isSubmittingForm = true;

                // Build a request to post the form
                let payload = buildPayload(form),
                    toast   = $('#toast'),
                    submit  = $('#evidence-submit');

                // Toast then post
                toast.toastActivate('Saving...')
                submit.prop('disabled', true);

                // Redirect to the return URL provided
                fetch(form.action, {
                    method: '{{ isCreate ? 'POST' : 'PUT' }}',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(payload)
                })
                .then(() => {
                    toast.toastTimeout({text: 'Saved'});
                    window.location.href = '{{ RETURN_URL.previous.decoded ?? '/' }}';
                    isSubmittingForm = false;
                })
                .catch(() => {
                    toast.toastTimeout({text: 'Save failed', css: 'alert'});
                    submit.prop('disabled', false);
                    isSubmittingForm = false;
                });

            }
        }

        $('#evidence-form').alaressValidate({
            rules: buildValidationRules(),
            messages: buildValidationMessages(),
            submitHandler(form, event) {

                event.preventDefault();

                document.getElementById('evidence-submit').disabled = true; //disable on select to prevent multiple submits

                if (isMediaUploadRequired()) {
                    document.getElementById('evidence-media-recording').scrollIntoView( { behavior: 'smooth' } ); //uploading can take a while, so scroll up to know that it's processing
                    document.removeEventListener('evidence-media-recording__onUploadComplete', submitForm);
                    document.addEventListener('evidence-media-recording__onUploadComplete', (event) => submitForm(form) ); //once the media is uploaded, #evidence-media-recording.vue will dispatch
                    document.dispatchEvent(new CustomEvent('evidence-media-recording__onFormSubmit')); //dispatch to allow the media recording to start uploading
                } else {
                    submitForm(form);
                }

            }
        });
        $('[data-tags]').selectizeSelector({
            ajax: {
                url: '{{ routeLookup('learningMomentEvidence.getTags') }}',
                type: 'GET',
                dataType: 'json'
            },
            selectize: {
                placeholder: '',
                preload: true,
                persist: true,
                hideSelected: true,
                load: function (query, callback) {
                    // Load: get values from AJAX, and callback with result
                    var ajaxSettings = {
                        url: '{{ routeLookup('learningMomentEvidence.getTags') }}',
                        type: 'GET',
                        dataType: 'json',
                    };
                    $.ajax(ajaxSettings)
                            .done(function (result) {
                                callback(result)
                            })
                            .fail(function () {
                                callback()
                            })
                }
            },
            value: [
                {% for tag in (isCreate ? [] : evidence.tags) %}
                {'id': '{{ tag.id }}', 'name': '{{ tag.name | escape('js') }}'},
                {% endfor %}
            ],
            multiple: true
        });
    });
</script>
{% endautoescape %}

<div id="toast" class="toast"></div>
