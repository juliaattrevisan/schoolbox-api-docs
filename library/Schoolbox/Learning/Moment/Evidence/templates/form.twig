{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Share Work' ]
) }}

<div class="small-12 column">
    <h1>Share a Learning Moment</h1>
    <ul class="meta">
        <li>
            {# Display differently if showing to other users #}
            Sharing on behalf of

            {##
             # Presentation depends on how many students are being shared with.
             # 1-3: just show their names
             # 4+:  show the names of the first 3, and then "and x others"
             #}
            {% set userHead = users[0:3] %}
            {% set userTail = users[3:] %}

            {% if userTail|length %}
                {%- for user in userHead -%}
                    {% if not loop.first %}, {% endif %}<a href="/search/user/{{ user.id }}">{{ user.fullName }}</a>
                {%- endfor %}
                and <a href="#" data-reveal-id="all-users">{{ userTail|length }} more</a>

                <div data-reveal id="all-users" class="reveal-modal">
                    <h2>Sharing on behalf of {{ users|length }} users</h2>
                    <ul class="information-list">
                        {% for user in users %}
                            <li>
                                <div class="compact card">
                                    <a href="/search/user/{{ user.id }}">
                                        <img src="/portrait.php?id={{ user.id }}&amp;size=square64">
                                        <p>{{ user.fullName }}</p>
                                    </a>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                    <a class="close-reveal-modal" aria-label="Close">×</a>
                </div>
            {% else %}
                {%- for user in userHead -%}
                    {% if not loop.first %}{{ loop.last ? 'and' : ',' }} {% endif %}<a href="/search/user/{{ user.id }}">{{ user.fullName }}</a>
                {%- endfor -%}
            {% endif %}
        </li>
    </ul>
</div>


<div class="row">
    <div class="small-12 island">
        <form action="#" method="post" id="evidence-form">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label class="required" for="evidence-body">
                            Write something
                        </label>
                        <textarea name="body" id="evidence-body" required></textarea>
                    </div>
                </fieldset>
            </section>
            <input type="submit" value="Submit" />
        </form>
    </div>
</div>


{# Set up CKEditor #}
<script src="/javascript/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script src="/javascript/shared/editor/jquery.editor.js?v={{ config.site_version }}"></script>
{% autoescape 'js' %}
<script type="text/javascript">
    $(function () {
        let postUrlList = new Set();
        {% for user in users %}
        postUrlList.add('{{ routeLookup('learningMomentEvidence.postMomentForUser', {userId: user.id}) }}');
        {% endfor %}


        $.fn.alaressEditor({
            targetElements: $('#evidence-body')
        });
        $('#evidence-form').alaressValidate({
            submitHandler(form, event) {
                event.preventDefault();

                // Build a request for each user
                let formData = new FormData(form),
                    payload = {
                        body: formData.get('body'),
                    },
                    toast = $('#toast');

                // Toast then post
                toast.toastActivate('Saving...')
                Promise.all(Array.from(postUrlList).map(url => axios.post(url, payload)))
                    .then(() => toast.toastTimeout({text: 'Saved'}))
                    .catch(() => toast.toastTimeout({text: 'Save failed', css: 'alert'}))
            }
        })
    });
</script>
{% endautoescape %}

<div id="toast" class="toast"></div>
