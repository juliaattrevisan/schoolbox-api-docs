{% extends '@learningMomentEvidence/form.twig' %}

{% block formInputs %}
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                {% block formInputFile %}
                    {##
                     # I can't label attachzones as I would standard file inputs.
                     #
                     # I don't think I can make them required either, thus the
                     # existence of this dummy input with a required rule attached.
                     # (This input will only fail validation if there's no files
                     #  attached)
                     #}
                    <label class="required" for="evidence-filename">
                        {% block formInputFileLabel %}
                            Upload File
                        {% endblock formInputFileLabel %}
                    </label>
                    <input type="hidden" name="filename" id="evidence-filename" {{ isCreate ? '' : 'value="'~evidence.filename~'"' }}/>
                    {% include 'sub/attachzone.twig' with { attachzone: zone } %}
                    {% block formInputFilePreview %}
                    {% endblock formInputFilePreview %}
                {% endblock formInputFile %}
            </div>
        </fieldset>
    </section>
{% endblock formInputs %}

{% block formInputBody %}
    <label for="evidence-body">
        Description
    </label>
    <textarea name="body" id="evidence-body">{{ isCreate ? '' : evidence.body | purify }}</textarea>
{% endblock formInputBody %}

{% block formJs %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            let buildValidationRules = function () {
                return {
                    filename: {
                        required: true,
                    },
                }
            };
			let buildValidationMessages = function () {
                return {
                    filename: {
                        required: 'Please upload a file'
                    }
                }
            };
            // Fill/clear filename input
            $(function () {
                let dropzoneInstance = Dropzone.instances.find(v => v.element.id === 'storage-zone');
                if (dropzoneInstance) {
                    let filenameInput = document.getElementById('evidence-filename');
                    dropzoneInstance.on('addedfile', (file) => {
                        //only add if empty, as event could be called multiple times if dragged and dropped multiple files
                        if (filenameInput.value === '') {
                            filenameInput.value = file.name;
                        }
                    });
                    dropzoneInstance.on('removedfile', (file) => {
                        //ensure removing the file that's already in place - as this event could be called when multiple files have been dragged and dropped, 
                        //which in this case would wipe out the existing value when this event is called to remove the other files as only a single file is allowed
                        if (filenameInput.value === file.name) { 
                            filenameInput.value = '';
                        }
                    });
                }
            });
        </script>
    {% endautoescape %}
{% endblock formJs %}
