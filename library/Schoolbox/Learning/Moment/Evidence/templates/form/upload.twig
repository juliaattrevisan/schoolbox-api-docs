{% extends '@learningMomentEvidence/form.twig' %}

{% block formInputs %}
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                {##
                 # I can't label attachzones as I would standard file inputs.
                 #
                 # I don't think I can make them required either.
                 #}
                <label class="required">
                    Upload File
                </label>
                {% include 'sub/attachzone.twig' with { attachzone: zone } %}
            </div>
        </fieldset>
    </section>
{% endblock formInputs %}

{% block formJs %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            let buildPayload = function (form) {
                let formData = new FormData(form),
                    storage  = formData.get('storage'),
                    hash     = null,
                    filename = null;

                // Extract actual hash and filename from storage
                // Hash is something like "store:$hash:$filename"
                if (storage) {
                    let hashParts = storage.split(':');
                    if (hashParts[1]) {
                        hash = hashParts[1];
                    }
                    if (hashParts[2]) {
                        filename = hashParts[2];
                    }
                }

                return {
                    storage: {
                        hash: hash,
                    },
                    filename: filename,
                };
            }
        </script>
    {% endautoescape %}
{% endblock formJs %}
