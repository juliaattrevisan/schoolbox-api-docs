{% extends '@learningMomentEvidence/form.twig' %}

{% block formInputs %}
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                {% block formInputUpload %}
                    {##
                     # I can't label attachzones as I would standard file inputs.
                     #
                     # I don't think I can make them required either, thus the
                     # existence of this dummy input with a required rule attached.
                     # (This input will only fail validation if there's no files
                     #  attached)
                     #}
                    <label class="required" for="evidence-filename">
                        {% block fileUploadLabel %}
                            Upload File
                        {% endblock fileUploadLabel %}
                    </label>
                    <input type="hidden" name="filename" id="evidence-filename" required />
                    {% include 'sub/attachzone.twig' with { attachzone: zone } %}
                    {% block fileUploadPreview %}
                    {% endblock fileUploadPreview %}
                {% endblock formInputUpload %}
            </div>
        </fieldset>
    </section>
{% endblock formInputs %}

{% block formJs %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            let buildValidationRules = function () {
                return {
                    filename: {
                        required: true,
                    },
                }
            };

            let buildPayload = function (form) {
                let formData = new FormData(form);
                return {
                    file: formData.get('file'),
                };
            };

            // Fill/clear filename input
            $(function () {
                let dropzoneInstance = Dropzone.instances.find(v => v.element.id === 'storage-zone');
                if (dropzoneInstance) {
                    let filenameInput = document.getElementById('evidence-filename');
                    dropzoneInstance.on('addedfile', file => filenameInput.value = file.name);
                    dropzoneInstance.on('removedfile', () => filenameInput.value = '');
                }
            });
        </script>
    {% endautoescape %}
{% endblock formJs %}
