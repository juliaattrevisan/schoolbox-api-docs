{% extends '@learningMomentEvidence/form.twig' %}

{% block formInputs %}
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                {##
                 # I can't label attachzones as I would standard file inputs.
                 #
                 # I don't think I can make them required either, thus the
                 # existence of this dummy input with a required rule attached.
                 # (This input will only fail validation if there's no files
                 # attached)
                 #}
                <label class="required" for="evidence-filename">
                    Upload File
                </label>
                <input type="hidden" name="filename" required />
                {% include 'sub/attachzone.twig' with { attachzone: zone } %}
            </div>
        </fieldset>
    </section>
{% endblock formInputs %}

{% block formJs %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            let buildValidationRules = function () {
                return {
                    filename: {
                        required: {
                            depends: function () {
                                // This input will never be filled, and will only
                                // fail validation if there's no storage items
                                return $('#evidence-form [name="file"]').length === 0;
                            }
                        }
                    },
                }
            };

            let buildPayload = function (form) {
                let formData = new FormData(form);
                return {
                    file: formData.get('file'),
                };
            };
        </script>
    {% endautoescape %}
{% endblock formJs %}
