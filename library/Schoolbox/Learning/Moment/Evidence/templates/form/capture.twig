{% extends '@learningMomentEvidence/form/upload.twig' %}

{% block formInputFileLabel %}
    Say something
{% endblock formInputFileLabel %}

{% block formInputFilePreview %}
    <section class="no-margin">
        {% block formInputFilePreviewElement %}
        {% endblock formInputFilePreviewElement %}
    </section>

    {% autoescape 'js' %}
        <script type="text/javascript">
            // Fill/clear preview
            $(function () {
                let dropzoneInstance = Dropzone.instances.find(v => v.element.id === 'storage-zone');
                if (dropzoneInstance) {
                    let previewId = 'evidence-storage-preview',
                        player = null;
                    dropzoneInstance.on('success', (file) => {
                        let reader = new FileReader();
                        reader.addEventListener('load', () => {
                            let preview = document.getElementById(previewId);
                            preview.classList.remove('hide');
                            preview.src = reader.result;
                            player = new MediaElementPlayer(previewId, {
                                // Override the default iconSprite reference and leave blank to avoid load error
                                // CSS is used to display the icons instead
                                // refer to https://github.com/mediaelement/mediaelement/blob/master/docs/api.md#configuration
                                iconSprite: ``,
                            });
                            player.load();
                        });
                        reader.readAsDataURL(file);
                    });
                    dropzoneInstance.on('removedfile', () => {
                        if (player) {
                            if (!player.paused) {
                                player.pause();
                            }
                            player.remove();
                            player = null;
                        }
                        document.getElementById(previewId).classList.add('hide');

                        // Clear width and height too, so that the media player
                        // is properly sized
                        document.getElementById(previewId).style.width = '';
                        document.getElementById(previewId).style.height = '';
                    });
                }
            });
        </script>
    {% endautoescape %}
{% endblock formInputFilePreview %}
