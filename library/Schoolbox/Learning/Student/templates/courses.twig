<div class="row">
    <div class="small-12 large-12 columns">
        <h1>
            {#
                If the user you are viewing is not you, display the student's name.
                format the name with correct grammar:
                if their name ends with s append '
                if their name does NOT end with s append 's
            #}
            {% if USER.id == user.id %}
                My
            {% else %}
                {{ user.fullname }}'{% if user.fullname |last != 's' %}s{% endif %}
            {% endif %}
            Courses
        </h1>
    </div>
</div>

<div class="row">
    {# homepageUrls contain the permission check value, so check if there are any pages the user can actually view... #}
    {% if homepageUrls | filter(url => url != false) is empty %}
        <div class="small-12 island">
            <div class = "empty-state">
                <sbx-icon name="course" size="2.5rem"></sbx-icon>
                <p>You are not participating in any courses.</p>
                <p>If you expect to have courses please contact your system administrator.</p>
            </div>
        </div>
    {% else %}
        {% for course in courseList %}
            {#
             # dont show courses if the user has no pers
             # if homepageUrls[course.id] is false, dont show
            #}
        {% if false != homepageUrls[course.id] %}
            <div class="small-12 medium-6 large-4 xlarge-3 island">
                <section>
                    {% include '@learningStudentCourses/sub/courseTile.twig' with {
                        'course':     course,
                        'homepageUrl': homepageUrls[course.id],
                    } only %}
                </section>
            </div>
            {% endif %}
        {% endfor %}
    {% endif %}
</div>
