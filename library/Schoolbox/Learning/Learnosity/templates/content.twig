{##
 # Modify Learnosity Quiz contents
 #
 # @param IAssessable $assessment    Our schoolbgox quiz instance
 # @param string|array $initOptions  Learnosity API initialisation object
 # @param array $tags                A set of (type, name) tag tuples
 # @param string $returnUrl          A redirect back to a place from whence you came.
 #}
<script src="https://authorapi-au.learnosity.com/?v2023.2.LTS"></script>
<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/learnosity/learnosity.css?v={{ config.site_version }}" />

<div class="actions-small-1 row">
    <div class="small-12 columns">
        <h1>Questions in {{ assessment.title }}</h1>
    </div>

    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
    <nav>
        <sbx-pop-out content-id="header-options"></sbx-pop-out>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        <li><a class="icon-modify" href="{{ modifyRoute }}">Modify Settings</a></li>
    </ul>
</div>

<div class="row">
    <div id='quiz-container' class="small-12 island">
        <section class="content">
            <div id="learnosity-author"></div>
        </section>
    </div>
</div>

{# Only Elite plan has access to Audio and Video player
 # Audio: 734ea0be-309b-4ff8-b004-3abd70094efd
 # Video: 25368800-1ebe-4f2c-b220-6fe90a44883b
 #
 # Hide them in css, then remove the li with javascript since the li elements
 # reserve a 33% width in the learnosity ui lol and I can't css-selector those
 #}
{% if 'elite' != config.site_plan|lower %}
<style>
    [data-lrn-qe-template-reference="734ea0be-309b-4ff8-b004-3abd70094efd"],
    [data-lrn-qe-template-reference="25368800-1ebe-4f2c-b220-6fe90a44883b"]
    {
        display: none !important;
    }
</style>
{% endif %}

<style>
    {# Hide this random search thing that's broken by design
     # The Search for Question Types can find hidden/deprecated items intentionally
     # Also removed via js for surety
     #}
    .lrn-qe-tiles-nav [data-lrn-qe-tiles-search-outlet] {
        display: none;
    }
    /**
     * Changed the island background color and padding in the authoring page and for preventing this to effect on the report page added the styles inline
    **/
    .island section {
    background: var(--body-background);
    }
    .island .content{
        padding:0px;
    }
</style>

{% autoescape 'js' %}
<script>
    /**
     * To add tags to the activity and also add browser state
     */
    const authorAppCallback = {
        readyListener: function () {
            {# Hide this random search thing that's broken by design
             # The Search for Question Types can find hidden/deprecated items intentionally
             # Also hidden via css for surety
             #}
            authorApp.on('widgetedit:editor:ready', function(event) {
                document.querySelector('.lrn-qe-tiles-nav [data-lrn-qe-tiles-search-outlet]')?.remove();
            });

            /**
             * Force tagging to occur immediately
             * tags_on_create requires you to hit the save button or authorApp.saveActivity()
             * in order to spawn tags. Using authorApp.setActivityTags() allows you have tags
             * spawned immediately upon authorApp rendering
             */
            authorApp.on('render:activity', function(event) {
                authorApp.setActivityTags({{ tags|raw }});
            });

            {% if 'elite' != config.site_plan|lower %}
            authorApp.on('widgetedit:editor:ready', function(event) {
                /* Artificially wait for their dom
                 */
                setTimeout(function () {
                    document.querySelector('[data-lrn-qe-template-reference="734ea0be-309b-4ff8-b004-3abd70094efd"]')?.closest('li').remove();
                    document.querySelector('[data-lrn-qe-template-reference="25368800-1ebe-4f2c-b220-6fe90a44883b"]')?.closest('li').remove();
                }, 100);
            });
            {% endif %}

            /**
             * Push app location changes to browser history, so we can use the browser back/forward
             */
            authorApp.on("navigate", function (event) {
                window.location.hash = `#${event.data.location}`;
            });

            /**
             * Go to initial browser location. The window location hash includes
             * the # at the start, so we strip it with some basic regex.
             */
            authorApp.navigate(window.location.hash.replace(/^#/, ""));

            /**
             * Listen for hash changes so we can navigate to the correct part of the app
             */
            window.onhashchange = function () {
                // If the hash is empty, go back to the previous page, as the first hash is injected on quiz load
                if (window.location.hash === "") {
                    history.back();
                } else {
                    authorApp.navigate(window.location.hash.replace(/^#/, ""));
                }
            };
        },
        /* Log errors to console and to screen for users
         */
        errorListener: function(error) {
            let errorElement = document.createElement('div');
            errorElement.classList.add('alert-box', 'warning');
            errorElement.innerHTML = '<p>There was a problem loading this quiz.</p>';
            errorElement.innerHTML += '<p>' + error + '</p>';

            document.getElementById('learnosity-author').replaceWith(errorElement);
            document.getElementById('quiz-container').classList.remove('island');
            document.getElementById('quiz-container').classList.add('columns');

            console.log(error);
        }
    };

    const authorApp = LearnosityAuthor.init(
        {{ initOptions | raw }},
        authorAppCallback
    );
</script>
{% endautoescape %}
