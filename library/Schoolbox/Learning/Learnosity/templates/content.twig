{##
 # Modify Learnosity Quiz contents
 #
 # @param IAssessable $assessment    Our schoolbgox quiz instance
 # @param string|array $initOptions  Learnosity API initialisation object
 # @param string $returnUrl          A redirect back to a place from whence you came.
 #}
<script src="https://authorapi-au.learnosity.com/?v2023.2.LTS"></script>

<style>
    .lrn-author-activity-intro-outro {
        display: none !important;
    }
</style>
<div class="actions-small-1 row">
    <div class="small-12 columns">
        <h1>Questions in {{ assessment.title }}</h1>
    </div>

    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
    <nav>
        <a class="icon-more" title="Actions" data-dropdown="header-options"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        <li><a class="icon-modify" href="{{ modifyRoute }}">Modify Quiz</a></li>
    </ul>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div id="learnosity-author"></div>
        </section>

        {% if returnUrl %}
            <a href="{{ returnUrl }}" class="button">Back</a>
        {% endif %}
    </div>
</div>

{% autoescape 'js' %}
<script>
    /* Force tagging to occur immediately
     * FIXME ...but why must I save it immediately upon spawn? Why can't it have these tags already
     */
    let authorAppCallback = {
        readyListener: function () {
            authorApp.on('render:activity', function(event) {
                authorApp.saveActivity();
            });
        }
    };

    let authorApp = LearnosityAuthor.init(
        {{ initOptions | raw }}, authorAppCallback
    );
</script>
{% endautoescape %}
