{##
 # Modify Learnosity Quiz contents
 #
 # @param IAssessable $assessment    Our schoolbgox quiz instance
 # @param string|array $initOptions  Learnosity API initialisation object
 # @param string $returnUrl          A redirect back to a place from whence you came.
 #}
<script src="https://authorapi.learnosity.com/?v2023.2.LTS"></script>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ assessment.title }} content</h2>
        <section class="content">
            <div id="learnosity-author"></div>
        </section>

        {% if returnUrl %}
            <a href="{{ returnUrl }}" class="button">Back</a>
        {% endif %}
    </div>
</div>

<script>
    let callbacks = {
        readyListener: function () {
            authorApp.on("render:activity", function() {
                document.getElementsByClassName('lrn-author-activity-intro-outro')[0].style.display = 'none';
                document.getElementsByClassName('lrn-author-activity-intro-outro')[1].style.display = 'none';
            });
        }
    };

    let authorApp = LearnosityAuthor.init({{ initOptions | raw }}, callbacks);
</script>
