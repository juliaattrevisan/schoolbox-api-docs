{##
 # Student reviews their attempt, with teacher feedback if such exists
 #
 # @param IAssessable $assessment          Our schoolbgox quiz instance
 # @param array $breadcrumbs               A context trail at the top of the screeen
 # @param string|array $initOptions        Learnosity API initialisation object
 # @param Attempt\Model $attempt           The student's attempt from our local db
 # @param array $comments                  A list of comment tuples that contain per-question comments
 # @param string $returnUrl                A redirect destination we remembered from some previous place
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script src="https://reports-au.learnosity.com/?v2023.2.LTS"></script>
<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/learnosity/learnosity.css?v={{ config.site_version }}" />

<div class="row">
    <div id="student-review-container" class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        <h2 class="subheader">Student Review</h2>
        <section class="content">
            <div id="schoolbox-student"></div>
        </section>

        {% if attempt.reviewed and attempt.comment|length %}
        <div id="overall-comment-container" style="display:none">
            <h2 class="subheader">Overall comments from {{ attempt.reviewer.fullname }}</h2>
            <section class="content">
                <article>{{ attempt.comment|purify }}</article>
            </section>
        </div>
        {% endif %}
    </div>
</div>

{% autoescape 'js' %}
<script>
    {# Show a different report style if feedback was given
     # This uses a whole different payload compared to the
     # one where there was no feedback
     #}
    {% if attempt.reviewed %}
        let attemptComments = JSON.parse(atob('{{ comments|raw }}'));

        let reportCallback = {
            readyListener: function() {
                let attemptReport = reportsApp.getReport('schoolbox-student');

                /* itemsApi only spawns if you used session-detail-by-item
                 */
                attemptReport.on('ready:itemsApi', function(itemsApp) {
                    window.itemsApp = itemsApp;

                    itemsApp.getQuestions(function(questions) {
                        $.each(questions, function(index, element) {
                            /* Access different parts of the dom directly, to place
                             * our input fields etc.
                             */
                            let learnosityReference = element.metadata.sheet_reference;
                            let learnosityReferenceTuple = element.response_id;

                            /* Containers into which we inject things
                             */
                            let container = $('[data-reference="' + learnosityReference + '"]');

                            container.append('' +
                                '<div class="alert-box highlight">' +
                                    '<article>' + attemptComments[learnosityReferenceTuple] + '</article>' +
                                '</div>' +
                            '');
                        });
                    });

                    /* Show container when ready
                     */
                    document.getElementById('overall-comment-container').style.display = '';
                });
            },
            /* Log errors to console and to screen for users
             */
            errorListener: function(error) {
                let errorElement = document.createElement('div');
                errorElement.classList.add('alert-box', 'warning');
                errorElement.innerHTML = '<p>There was a problem loading this attempt.</p>';
                errorElement.innerHTML += '<p>' + error.code + ' ' + error.msg + '</p>';

                document.getElementById('schoolbox-student').replaceWith(errorElement);
                document.getElementById('student-review-container').classList.remove('island');
                document.getElementById('student-review-container').classList.add('columns');

                console.log(error);
            }
        }

        let reportsApp = LearnosityReports.init(
            {{ initOptions | raw }}, reportCallback
        );
    {% else %}
        let reportsApp = LearnosityReports.init(
            {{ initOptions | raw }}
        );
    {% endif %}
</script>
{% endautoescape %}
