{##
 # Do an attempt
 #
 # @param string|array $initOptions    Learnosity API initialisation object
 # @param IAssessable $assessment      Our schoolbgox quiz instance
 # @param int $attemptId               In int corresponding a row in assess_attempt
 # @param string $completionUrl        A url to the endpoint that records an attempt as "finished"
 # @param string $learnosityReference  A Learnosity UUID corresponding uniquely to this attempt
 #}
<script src="https://items-au.learnosity.com/?v2023.2.LTS"></script>
<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/learnosity/learnosity.css?v={{ config.site_version }}" />
<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div id="learnosity_assess"></div>
        </section>
    </div>
</div>

{% autoescape 'js' %}
<script>
    /**
     * So we can add browser state when moving between items (cards)
     */
    const itemsAppCallback = {
        readyListener: function () {
            /**
             * Push app location changes to browser history, so we can use the browser back/forward
             */
            itemsApp.on("item:changed", function (itemIndex) {
                window.location.hash = `#${itemIndex}`;
            });

            /**
             * Go to initial browser location. The window location hash includes
             * the # at the start, so we strip it with some basic regex.
             */
            let previousLocation = parseInt(window.location.hash.replace(/^#/, ""));

            {# Note that one-item quizzes won't let you navigate to anything beyond the
             # current screen. This means the #1 anchor will never exist, causing previousLocation
             # to be NaN (not a number). Using that in a .goto() causes the button to disable.
             #}
            if (!isNaN(previousLocation)) {
                itemsApp.items().goto(previousLocation);
            }

            /**
             * Listen for hash changes so we can navigate to the correct part of the app
             */
            window.onhashchange = function () {
                // If the hash is empty, go back to the previous page, as the first hash is injected on quiz load
                if (window.location.hash === "") {
                    history.back();
                } else {
                    itemsApp.items().goto(parseInt(window.location.hash.replace(/^#/, "")));
                }
            };
        }
    };

    const itemsApp = LearnosityItems.init(
        {{ initOptions | raw }},
        itemsAppCallback
    );

    /* Async attempt completion
     */
    itemsApp.on('test:submit:success', function() {
        const payload = new FormData();
        payload.append('attemptId', '{{ attemptId }}');
        payload.append('learnosityReference','{{ learnositySessionReference }}');

        fetch('{{ completionUrl }}', {
            method: 'POST',
            body: payload
        }).then(response => {
            window.location.href = '{{ outroUrl }}';
        });
    });
</script>
{% endautoescape %}
