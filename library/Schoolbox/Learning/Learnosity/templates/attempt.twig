{##
 # Do an attempt
 #
 # @param IAssessable $assessment      Our schoolbgox quiz instance
 # @param array $breadcrumbs           A context trail at the top of the screeen
 # @param string|array $initOptions    Learnosity API initialisation object
 # @param int $attemptId               In int corresponding a row in assess_attempt
 # @param string $completionUrl        A url to the endpoint that records an attempt as "finished"
 # @param string $learnosityReference  A Learnosity UUID corresponding uniquely to this attempt
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script src="https://cdn.iframe.ly/embed.js?cancel=0&api_key=94aa8fc28ac1089a2dfb28"></script>
<script src="https://items-au.learnosity.com/?v{{ config.learnosity_version }}"></script>
<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/core/learnosity.css?v={{ config.site_version }}" />

<div class="row">
    <div id='quiz-container' class="small-12 island">
        <section class="content">
            <div id="learnosity_assess"></div>
        </section>
    </div>
</div>

<template data-template="time-up">
    <div class="app-panel lrn-dialog-default" style="opacity: 1; display: block" data-modal="time-up">
        <div class="lrn-assess-modal-dialog modal-dialog">
            <div class="lrn-assess-modal-content modal-content" aria-modal="true" role="alertdialog">
                <div class="lrn-assess-modal-header modal-header">
                    <h2>Time's Up</h2>
                </div>
                <div class="lrn-assess-modal-body modal-body">
                    <p>Please wait while your answers are submitted.</p>
                    <div class="lrn-assess-spinner"></div>
                </div>
            </div>
        </div>
    </div>
</template>

{% autoescape 'js' %}
<script>
    // Track if the time has ended or not
    let timeEnded = false;

    // Create a MutationObserver to watch for changes in the quiz container
    const lrnObserver = new MutationObserver((mutationsList) => {
        mutationsList.forEach((mutation) => {
            if (mutation.type === "childList" && mutation.addedNodes.length > 0) {
                mutation.addedNodes.forEach((node) => {
                    // Process any new oembeds
                    if (node.nodeType === Node.ELEMENT_NODE) {
                        node.querySelectorAll('oembed[url]:empty, div[data-oembed-url]:empty')
                        .forEach((oEmbedEl) => {
                            // Ensure not inside a ckeditor
                            if (oEmbedEl.closest('[contenteditable="true"]') !== null) {
                                return;
                            }
                            window.iframely.load(oEmbedEl, oEmbedEl.getAttribute("data-oembed-url") || oEmbedEl.getAttribute("url"));
                        });
                    }
                });
            }
        });
    });
    lrnObserver.observe(document.getElementById("quiz-container"), { subtree: true, childList: true });

    /**
     * So we can add browser state when moving between items (cards)
     */
    const itemsAppCallback = {
        readyListener: function () {
            /**
             * Push app location changes to browser history, so we can use the browser back/forward
             */
            itemsApp.on("item:changed", function (itemIndex) {
                window.location.hash = `#${itemIndex}`;
            });

            /**
             * Track when the time has ended
             */
            itemsApp.on("time:end", function () {
                timeEnded = true;
            });

            /**
             * Go to initial browser location. The window location hash includes
             * the # at the start, so we strip it with some basic regex.
             */
            let previousLocation = parseInt(window.location.hash.replace(/^#/, ""));

            {# Note that one-item quizzes won't let you navigate to anything beyond the
             # current screen. This means the #1 anchor will never exist, causing previousLocation
             # to be NaN (not a number). Using that in a .goto() causes the button to disable.
             #}
            if (!isNaN(previousLocation)) {
                itemsApp.items().goto(previousLocation);
            }

            /* Replace video placeholders with actual player when the ui has loaded
             */
            $.fn.schoolboxResource_ProxyReplacement($('.lrn_stimulus_content'));

            /**
             * Listen for hash changes so we can navigate to the correct part of the app
             */
            window.onhashchange = function () {
                // If the hash is empty, go back to the previous page, as the first hash is injected on quiz load
                if (window.location.hash === "") {
                    history.back();
                } else {
                    itemsApp.items().goto(parseInt(window.location.hash.replace(/^#/, "")));
                }
            };
        },

        /* Log errors to console and to screen for users
         */
        errorListener: function(error) {
            let errorElement = document.createElement('div');
            errorElement.classList.add('alert-box', 'warning');
            errorElement.innerHTML = '<p>There was a problem loading this quiz.</p>';
            errorElement.innerHTML += '<p>' + error.code + ' ' + error.msg + '</p>';

            document.getElementById('learnosity_assess').replaceWith(errorElement);
            document.getElementById('quiz-container').classList.remove('island');
            document.getElementById('quiz-container').classList.add('columns');

            console.log(error);
        },

        /* Only warn the user while leaving the page if doing so will actually loose data.
         * Learnosity's default implementation still shows the warning at the end of the time
         * limit, even though it doesn't matter at that point as it will save anyway...
         *
         * The unload prompt will now only show if there is unsaved data and the time hasn't ended
         */
        customUnload: function() {
            return !(timeEnded || itemsApp.safeToUnload())
        }
    };

    const itemsApp = LearnosityItems.init(
        {{ initOptions | raw }},
        itemsAppCallback
    );

    /**
     * Async attempt completion: either by choice, or automatically
     * by the timer running out
     */
    function completeAttempt() {
        const payload = new FormData();
        payload.append('attemptId', '{{ attemptId }}');
        payload.append('learnosityReference','{{ learnositySessionReference }}');

        fetch('{{ completionUrl }}', {
            method: 'POST',
            body: payload
        })
        .then(response => response.text())
        .then(body => {
            window.location.href = '{{ outroUrl }}';
        });

    }

    /* User consciously finished
     */
    itemsApp.on('test:submit:success', function() {
        completeAttempt();
    });

    /* Allowed Time elapsed
     */
    itemsApp.on('time:end', function() {
        document.getElementById("learnosity_assess").setAttribute("data-time-ended", "true");

        const dialogs = document.querySelector("#learnosity_assess .dialogs");
        const newModal = document.querySelector("template[data-template='time-up']").content.cloneNode(true);
        dialogs.appendChild(newModal);

        completeAttempt();
    });
</script>
<style>
/* Hide the submit confirmation modal after the time has ended */
#learnosity_assess[data-time-ended="true"] [id^="test-save-submit"] {
    display: none !important;
}
</style>
{% endautoescape %}
