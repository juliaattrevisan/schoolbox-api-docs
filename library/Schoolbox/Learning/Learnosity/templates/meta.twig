{##
 # @param Quiz\Attempt\Model $attempt
 #}
{% import '@learningAssessment/fragments/macro/duration.twig' as duration %}

<ul class="meta">
    <li class="icon-calendar" title="Submitted Date/Time">{% apply spaceless %}
        {% if attempt.finish %}
            Finished <time>{{ attempt.finish.relativeDayWithoutMidnight }}</time>
        {% else %}
            <em>Attempt in progress - started <time>{{ attempt.start.relativeDayWithoutMidnight }}</time></em>
        {% endif %}
        {% endapply %}
    </li>

    <li class="icon-time-value" title="Attempt Time Taken">{% apply spaceless %}
        Time taken:
        {% if attempt.finish %}
            {{ duration.secondsToHoursAndMinutes(attempt.start.diffInSeconds(attempt.finish, true)) }}
        {% else %}
            <em>{{ duration.secondsToHoursAndMinutes(attempt.start.diffInSeconds(NOW, true)) }}</em>
        {% endif %}
        {% endapply %}
    </li>

    {% if attempt.reviewed %}
        <li class="icon-staff-students" title="Attempt Time Taken">{% apply spaceless %}
            Reviewed by
                {% if attempt.reviewer.deleted %}
                    {{ attempt.reviewer.fullname }}
                {% else %}
                    <a href="/search/user/{{ attempt.reviewer.id }}">{{ attempt.reviewer.fullname }}</a>
                {% endif %} {{ attempt.reviewed.relativeDayWithoutMidnight }}
            {% endapply %}
        </li>
    {% endif %}
</ul>
