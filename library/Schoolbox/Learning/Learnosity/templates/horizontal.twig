<script src="https://reports-au.learnosity.com/?v2023.2.LTS"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>

{# A list of contents for this quiz
 # Used to help people change questions
 #}
<ul id="item-list" style="display:none">
{% for itemReference in itemReferences %}
    <li><a data-item-reference="{{ itemReference.id }}">{{ itemReference.id }}</a></li>
{% endfor %}
</ul>

{# Render an html element into which each student's attempt will reside
 # This is needed for each Learnosity report which we initially hide in
 # a display:none container
 #}
<div id="reports" style="display:none">
{% for user in users %}
    <div id="schoolbox-student-{{ user.id }}"></div>
{% endfor %}
</div>

<div id="loading">
    <div class="loader"></div>
</div>

<script>
    let reportPayloads = {{ reportPayloads|raw }};

    /* Remember how many reports were loaded
     *
     * We can only really interact with the ui once everyone's
     * full attempt has been loaded...but we don't know any identifiers
     * from within this callback. What we *do* know is how many reports
     * have loaded, which we can compare with how many we expect to load
     * via reportPayloads|length.
     */
    let reportsLoaded = 0;
    let reportsExpected = reportPayloads.length;
    let reportIds = [];
    let reportCallbacks = [];

    /* Remember all the textareas we built
     */
    let attemptEditorFields = [];

    /* Initialise a report for everyone's attempt
     * Selectively showing only one item's responses at a time
     */
    for (let i = 0; i < reportPayloads.length; i++) {
        let initOptions = JSON.parse(reportPayloads[i]);

        /* Remember all the report ids that we'll need to traverse
         */
        let reportId = initOptions.request.reports[0].id;
        reportIds[i] = reportId;

        /* Every report gets its own callback; this is because the readyListeners()
         * don't have any idea which report they are in, which means we can't tell
         * when a report has been fully loaded to the point where we can hide all
         * their divs, because we only want to show one div at a time per report.
         */
        reportCallbacks[i] = {
            readyListener: function() {
                let attemptReport = reportsApp.getReport(reportId);

                /* itemsApi only spawns if you used session-detail-by-item
                 */
                attemptReport.on('ready:itemsApi', function(itemsApp) {
                    window.itemsApp = itemsApp;

                    /* Loosely presume how many have loaded successfully
                     * by maintaining a counter; could use reportId as a
                     * lookup index if you wanted to double-down on this
                     */
                    reportsLoaded++;

                    /* Start hiding things
                     */
                    hideAllResponses(reportId);

                    /* Slap on some our feedback stuff
                     */
                    itemsApp.getQuestions(function(questions) {
                        $.each(questions, function(index, element) {
                            /* Access different parts of the dom directly, to place
                             * our input fields etc.
                             */
                            let learnosityReference = element.metadata.sheet_reference;
                            let learnosityReferenceTuple = element.response_id;

                            /* Student scoring and metadata
                             */
                            // let score = attemptScores[learnosityReferenceTuple].score;
                            // let maxScore = attemptScores[learnosityReferenceTuple].max;

                            /* TODO remove by replace with actual values
                             */
                            let score = Math.random();
                            let maxScore = Math.random();
                            let attemptComments = [];

                            /* Containers into which we inject things
                             */
                            let container = $('#' + reportId).find('[data-reference="' + learnosityReference + '"]');

                            container.append('' +
                                '<div class="sb-custom-score" style="display:none" data-reference="' + learnosityReference + '">' +
                                '<label>Customise score</label>' +
                                '<input name="scores[' + learnosityReferenceTuple + ']" type="number" value="' + score + '">' +
                                '<label>Comment</label>' +
                                '<textarea id="comments-' + learnosityReferenceTuple + '" name="comments[' + learnosityReferenceTuple + ']">' + (attemptComments[learnosityReferenceTuple] ?? '') + '</textarea>' +
                                '</div>' +
                            '');

                            /* We need this for cke replacements
                             */
                            attemptEditorFields.push('#comments-' + learnosityReferenceTuple);
                        });
                    });
                });
            }
        };

        /* Initialise reports for each attempt
         */
        let reportsApp = LearnosityReports.init(initOptions, reportCallbacks[i]);
    }

    /* Poll to see when reportsLoaded == reportsExpected
     * If true, we're ready to go, and can clear the timeout
     */
    let reportsReady = setInterval(function() {
        if (reportsLoaded === reportsExpected) {
            clearInterval(reportsReady);
            /* cke all the commentary fields
             */
            document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
                detail: {
                    targetElements: attemptEditorFields
                }
            }));

            /* Show list of questions to choose from
             */
            document.getElementById('item-list').style = 'display: block';
            document.getElementById('reports').style = 'display: block';

            /* Hide the spinny
             */
            document.getElementById('loading').style = 'display: none';
        }
    }, 100);

    $(function() {
        /* Presume it'll take longer to load all the learnosity reports
         * than it does for jquery to init
         *
         * Spondonicles God of War might have a smarter, less-flavourful
         * way of doing this in vanilla js (I leave this conversion to him)
         */
        $('[data-item-reference]').on('click', function (event) {
            event.preventDefault();

            /* Hide everything first lol
             * Then show certain parts lol
             */
            for (let i = 0; i < reportIds.length; i++) {
                hideAllResponses(reportIds[i]);

                let itemReference = $(this).attr('data-item-reference');

                let response = $('#' + reportIds[i]).find('[data-reference="' + itemReference + '"]');
                let clearfix = response.prev();
                let title = clearfix.prev();
                let score = $('.sb-custom-score').find('[data-reference="'+ itemReference +'"]');

                response.attr('style', '');
                clearfix.attr('style', '');
                title.attr('style', '');

                /* Show our custom scoring fields
                 */
                score.attr('style', '');
            }
        });
    });

    //
    // /**
