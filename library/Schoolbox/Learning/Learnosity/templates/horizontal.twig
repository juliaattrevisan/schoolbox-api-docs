{##
 # Give feedback for each attempt, one question at a time
 #
 # @param string $reportPayloads    Learnosity API initialisation objects (one for each person's attempt, json encoded)
 # @param array $users              A set of (report id, user data) tuples used to render Learnosity app anchor divs
 # @param string $usersEncoded      Same as above, but json encoded for use in js
 # @param IAssessable $assessment   Our schoolbgox quiz instance
 # @param array $itemReferences     A set of (item reference, item title) tuples for rendering the table of contents
 # @param array $scores             A list of score tuples obtained per question in this attempt
 # @param array $comments           A list of comment tuples that contain per-question comments
#}
<script src="https://reports-au.learnosity.com/?v2023.2.LTS"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>

<div class="row">
    <div class="small-12 columns">
        <h1>Horizontal Marking for {{ assessment.title }}</h1>
    </div>
</div>

{# Render an html element into which each student's attempt will reside
 # This is needed for each Learnosity report which we initially hide in
 # a display:none container
 #}
<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div id="loading">
                <div class="loader"></div>
            </div>

            {# A list of contents for this quiz
             # Used to help people change questions
             #}
            <ul id="item-list" style="display:none">
                {% for itemReference in itemReferences %}
                    <li><a data-item-reference="{{ itemReference.reference }}">{{ itemReference.title }}</a></li>
                {% endfor %}
                {# You could craft an intentionally-unusual data-item-reference,
                 # hardcoded to never collide with Learnosity's; this would allow
                 # people to visit the Attempt Comments as part of the navigation
                 # scheme, but that might be a bit disruptive
                 #}
                <li><a href="#">Attempt Comments</a></li>
            </ul>
        </section>
    </div>

    {# Everyone's attempt loads here #}
    <div id="reports" style="display:none">
        <div class="small-12 island">
            {% for user in users %}
                <section class="content">
                    <div id="schoolbox-student-{{ user.id }}" data-name="{{ user.name }}"></div>
                </section>
            {% endfor %}
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 columns">
        <div class="sb-grid u-gap--l sb-grid--2-col dummy-content highlighter u-margin-m--bottom">
            <div><a id="previous-item" class="button full-width">Previous Question</a></div>
            <div><a id="next-item" class="button full-width">Next Question</a></div>
        </div>
    </div>
</div>

<script>
    /* All the scores and comments that people got
     */
    let responseScores = JSON.parse('{{ scores|raw }}');
    let responseComments = JSON.parse(atob('{{ comments|raw }}'));

    /* Remember how many reports were loaded
     *
     * We can only really interact with the ui once everyone's
     * full attempt has been loaded...but we don't know any identifiers
     * from within this callback. What we *do* know is how many reports
     * have loaded, which we can compare with how many we expect to load
     * via reportPayloads|length.
     */
    let reportPayloads = {{ reportPayloads|raw }};
    let reportsLoaded = 0;
    let reportsExpected = reportPayloads.length;

    /* Lookups/indexes - a list of ids, and individualised report callbacks
     */
    let reportIds = [];
    let reportCallbacks = [];

    /* Remember all the textareas we built
     */
    let responseEditorFields = [];

    /* A list of (user_id, name) tuples that we use to replace Item titles
     * with the student's name, e.g. replace "Item 2" with "Michael White"
     */
    let users = JSON.parse('{{ usersEncoded|raw }}');

    /* Initialise a report for everyone's attempt
     * Selectively showing only one item's responses at a time
     */
    for (let i = 0; i < reportPayloads.length; i++) {
        let initOptions = JSON.parse(reportPayloads[i]);

        /* Remember all the report ids that we'll need to traverse
         */
        let reportId = initOptions.request.reports[0].id;
        reportIds[i] = reportId;

        /* Every report gets its own callback; this is because the readyListeners()
         * don't have any idea which report they are in, which means we can't tell
         * when a report has been fully loaded to the point where we can hide all
         * their divs, because we only want to show one div at a time per report.
         */
        reportCallbacks[i] = {
            readyListener: function() {
                let attemptReport = reportsApp.getReport(reportId);

                /* itemsApi only spawns if you used session-detail-by-item
                 */
                attemptReport.on('ready:itemsApi', function(itemsApp) {
                    window.itemsApp = itemsApp;

                    /* Loosely presume how many have loaded successfully
                     * by maintaining a counter; could use reportId as a
                     * lookup index if you wanted to double-down on this
                     */
                    reportsLoaded++;

                    /* Start hiding things
                     */
                    hideAllResponses(reportId);

                    /* Slap on some our feedback stuff
                     */
                    itemsApp.getQuestions(function(questions) {
                        let report = document.querySelector(`#${reportId}`);

                        for (let key in questions) {
                            let element = questions[key];

                            /* Access different parts of the dom directly, to place
                             * our input fields etc.
                             */
                            let learnosityReference = element.metadata.sheet_reference;
                            let learnosityReferenceTuple = element.response_id;

                            /* Student scoring and metadata
                             */
                            let score = responseScores[learnosityReferenceTuple].score;
                            let maxScore = responseScores[learnosityReferenceTuple].max;

                            /* Containers into which we inject things
                             */
                            let container = report.querySelector(`[data-reference="${learnosityReference}"]`);
                            let guts = document.createElement('div');

                            guts.innerHTML = '' +
                                '<div class="sb-custom-score" style="display:none" data-reference="' + learnosityReference + '">' +
                                '<label>Customise score</label>' +
                                '<input id="scores-' + learnosityReferenceTuple + '" name="scores[' + learnosityReferenceTuple + ']" type="number" value="' + score + '">' +
                                '<label>Comment</label>' +
                                '<textarea id="comments-' + learnosityReferenceTuple + '" name="comments[' + learnosityReferenceTuple + ']">' + (responseComments[learnosityReferenceTuple] ?? '') + '</textarea>' +
                                '</div>';

                            container.append(guts);

                            /* We need this for cke replacements
                             */
                            responseEditorFields.push('#comments-' + learnosityReferenceTuple);

                            /* Assign async blur listener to each Score and Comment field
                             * so it sends back to Learnosity upon blur
                             *
                             * TODO make more sophisticated by checking dirtyness first
                             *   just like textboxes I guess
                             */
                            document.querySelector('#scores-' + learnosityReferenceTuple).addEventListener('blur', function() {
                                /* TODO Add toaster
                                 */

                                /* Send it
                                 */
                                console.log('Send ' + learnosityReferenceTuple + ' score back to guys');
                            });
                        }

                        /* Rewrite the item title to be the guy's name
                         */
                        let titles = report.getElementsByClassName('lrn-report-item-title');

                        for (let element of titles) {
                            element.firstChild.textContent = users[reportId].name;
                        }
                    });
                });
            }
        };

        /* Initialise reports for each attempt
         */
        let reportsApp = LearnosityReports.init(initOptions, reportCallbacks[i]);
    }

    /* Poll to see when reportsLoaded == reportsExpected
     * If true, we're ready to go, and can clear the timeout
     */
    let reportsReady = setInterval(function() {
        if (reportsLoaded === reportsExpected) {
            clearInterval(reportsReady);
            /* cke all the commentary fields
             */
            document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
                detail: {
                    targetElements: responseEditorFields
                }
            }));

            /* FIXME Assign event listeners for changes in ckeditors after waiting
             * for them all to spawn (arbitrary 1000ms)
             */
            setTimeout(function() {
                responseEditorFields.forEach(function (element, index) {
                    /* Remove that hash
                     */
                    let key = element.substr(1);

                    /* Detect a change
                     * https://stackoverflow.com/questions/63601901/ckeditor5-how-do-i-write-a-blur-event-handler-in-my-javascript-function
                     */
                    window.sbProps.editors[key].ui.focusTracker.on("change:isFocused", (event, name, isFocused) => {
                        if (!isFocused) {
                            /* TODO Add toaster
                             */

                            console.log('Send ' + key + ' comment to our db');
                        }
                    });
                })
            }, 1000);

            /* Show list of questions to choose from
             */
            document.getElementById('item-list').style = 'display: block';
            document.getElementById('reports').style = 'display: block';

            /* Hide the spinny
             */
            document.getElementById('loading').style = 'display: none';
        }
    }, 100);

    /* Table of contents :p
     */
    let itemIndex = buildItemIndex();

    $(function() {
        /* Presume it'll take longer to load all the learnosity reports
         * than it does for jquery to init
         *
         * Spondonicles God of War might have a smarter, less-flavourful
         * way of doing this in vanilla js (I leave this conversion to him)
         *
         * Tried the replacement specified in
         * https://youmightnotneedjquery.com/#on
         * but kept getting
         * Uncaught TypeError: el.addEventListener is not a function
         */
        $('[data-item-reference]').on('click', function (event) {
            event.preventDefault();

            let currentItemReference = $(this).attr('data-item-reference');

            showResponse(currentItemReference);
            updateNavigator(itemIndex, currentItemReference);
        });
    });


    /**
     * Build a sequenced list of item references used in the table of contents
     * that users can click to navigate around horizontal marking. SURELY there
     * was an easier way with vanilla next() and prev() but kept running into
     * random syntax problems, and you can do this in one line in jquery.
     */
    function buildItemIndex() {
        let itemList = document.querySelectorAll('#item-list [data-item-reference]');

        let itemReferences = [];

        itemList.forEach(function (element, index) {
            itemReferences.push(element.getAttribute('data-item-reference'));
        });

        return itemReferences;
    }


    /**
     * Update previous/next buttons
     *
     * @param itemIndex A list of item references
     * @param current The item reference of the current question that we clicked
     */
    function updateNavigator(itemIndex, current) {
        let previous = null;
        let next = null;

        itemIndex.forEach(function (element, index) {
            if (current === element) {
                previous = itemIndex[index-1];
                next = itemIndex[index+1];
            }
        });

        /* Redefine what Previous button does
         * First, clear all event listeners by replacing the whole thing
         */
        refreshNavigatorState('#previous-item', previous);
        refreshNavigatorState('#next-item', next);
    }


    /**
     * Micromanage the state of each navigator button
     *
     * @param buttonId
     * @param itemReference
     */
    function refreshNavigatorState(buttonId, itemReference) {
        let oldElement = document.querySelector(buttonId);
        let newElement = oldElement.cloneNode(true);
        oldElement.parentNode.replaceChild(newElement, oldElement);

        if (itemReference) {
            newElement.classList.remove('disabled');

            /* Reassign new behaviour
             */
            newElement.addEventListener('click',  function() {
                showResponse(document.querySelector(`#item-list [data-item-reference="${itemReference}"]`).getAttribute('data-item-reference'));
                updateNavigator(itemIndex, itemReference);
            }, null);
        } else {
            /* Disable the button
             */
            newElement.classList.add('disabled');
        }
    }


    /**
     * Every report comes with an ungrouped sequence of these elements:
     *      .lrn-report-item-title
     *      .clearfix
     *      .learnosity-item lrn lrn-item-processed
     *
     * There are no wrapper containers so you have to hide all of them
     * somewhat arbitrarily/naively
     */
    function hideAllResponses(reportId) {
        let report = document.getElementById(reportId);

        let titles = report.getElementsByClassName('lrn-report-item-title');
        let clearfixes = report.getElementsByClassName('clearfix');
        let items = report.getElementsByClassName('learnosity-item');
        let scores = report.getElementsByClassName('sb-custom-score');

        for (let element of titles) {
            element.style = 'display:none';
        }

        for (let element of clearfixes) {
            element.style = 'display:none';
        }

        for (let element of items) {
            element.style = 'display:none';
        }

        for (let element of scores) {
            element.style = 'display:none';
        }
    }


    /**
     * When a user clicks an item from the list,
     * show everyone's responses for that item
     *
     * @param itemReference
     */
    function showResponse(itemReference) {
        /* Hide everything first lol
         * Then show certain parts lol
         */
        for (let i = 0; i < reportIds.length; i++) {
            hideAllResponses(reportIds[i]);

            let report = document.querySelector(`#${reportIds[i]}`);
            let response = report.querySelector(`.learnosity-item[data-reference="${itemReference}"]`);
            let clearfix = prev(response);
            let title = prev(clearfix);
            let score = report.querySelector(`.sb-custom-score[data-reference="${itemReference}"]`);

            /* If elements existed, show them
             * Learnosity Elements need to be shown as a group (response, clearfix, title)
             * and we show our custom scoring interface separately (score)
             */
            if (response) {
                response.style = '';
            }

            if (clearfix) {
                clearfix.style = ''
            }

            if (title) {
                title.style = '';
            }

            if (score) {
                score.style = '';
            }
        }
    }


    /**
     * jquery replacement
     * https://youmightnotneedjquery.com/#prev
     *
     * @param el
     * @param selector
     * @returns {Element|null}
     */
    function prev(el, selector) {
        /* Scenario where el didn't exist
         */
        if (null === el) {
            return null;
        }

        const prevEl = el.previousElementSibling;

        if (!selector || (prevEl && prevEl.matches(selector))) {
            return prevEl;
        }

        return null;
    }


    /**
     * jquery replacement
     * https://youmightnotneedjquery.com/#next
     *
     * @param el
     * @param selector
     * @returns {Element|null}
     */
    function next(el, selector) {
        const nextEl = el.nextElementSibling;

        if (!selector || (nextEl && nextEl.matches(selector))) {
            return nextEl;
        }

        return null;
    }
</script>