    /**
     * Every report comes with an ungrouped sequence of these elements:
     *      .lrn-report-item-title
     *      .clearfix
     *      .learnosity-item lrn lrn-item-processed
     *
     * There are no wrapper containers so you have to hide all of them
     * somewhat arbitrarily/naively
     */
    function hideAllResponses(reportIds) {
        for (let i = 0; i < reportIds.length; i++) {
            let report = document.getElementById(reportIds[i]);

            let titles = report.getElementsByClassName('lrn-report-item-title');
            let clearfixes = report.getElementsByClassName('clearfix');
            let items = report.getElementsByClassName('learnosity-item');

            $.each(titles, function(index, element) {
                element.style = 'display:none';
            });

            $.each(clearfixes, function(index, element) {
                element.style = 'display:none';
            });

            $.each(items, function (index, element) {
                element.style = 'display:none';
            });
        }
    }


    /**
     * When a user clicks an item from the list,
     * show everyone's responses for that item
     *
     * @param learnosityReference
