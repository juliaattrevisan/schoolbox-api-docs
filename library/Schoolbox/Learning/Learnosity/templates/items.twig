{# Add your own javascript, validation etc. #}
{# Use pantry for styling #}

<script src="https://items.learnosity.com/?v2023.2.LTS"></script>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Learnosity Test</h2>
        <section class="content">

            <div id="learnosity_assess"></div>

            <script>
                let itemsApp = LearnosityItems.init({{ initOptions | raw }});

                /* Async attempt completion
                 */
                itemsApp.on('test:submit:success', function() {
                    let payload = new FormData();
                    payload.append('attemptId', '{{ attemptId }}');
                    payload.append('learnosityReference','{{ learnosityReference }}');

                    const response = fetch('{{ completionUrl }}', {
                        method: 'POST',
                        body: payload
                    });

                    /* Redirect to...somewhere else
                     */
                });
            </script>
        </section>
    </div>
</div>

