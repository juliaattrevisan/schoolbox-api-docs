<script src="https://reports-au.learnosity.com/?v2023.2.LTS"></script>
<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/learnosity/learnosity.css?v={{ config.site_version }}" />

<div class="row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        <section class="content">
            {{ assessment.completionMessage | purify }}
        </section>

        <h2 class="subheader">Result Summary</h2>
        <section class="content">
            <p>
                <em>This mark is unconfirmed and may change following teacher review.</em>
            </p>
            <p class="grade no-pad">
                <span>{{ attempt.mark }} ({{ attempt.normalisedMark|number_format(2) }}%)</span>
            </p>
        </section>

        <section class="content">
            <div id="schoolbox-result-1"></div>
        </section>

        {% if returnUrl %}
            <a href="{{ returnUrl }}" class="button">Back to homepage</a>
        {% endif %}
    </div>
</div>

{% autoescape 'js' %}
<script>
    let reportsApp = LearnosityReports.init(
        {{ initOptions | raw }}
    );
</script>
{% endautoescape %}
