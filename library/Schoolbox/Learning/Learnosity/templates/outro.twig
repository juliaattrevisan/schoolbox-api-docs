{##
 # Complete an attempt
 #
 # @param IAssessable $assessment      Our schoolbgox quiz instance
 # @param array $breadcrumbs           A context trail at the top of the screeen
 # @param string|array $initOptions    Learnosity API initialisation object
 # @param Attempt/Model $attempt       An attempt instance
 # @param string $returnUrl            A redirect back to a place from whence you came.
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script src="https://reports-au.learnosity.com/?v2023.2.LTS"></script>
<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/learnosity/learnosity.css?v={{ config.site_version }}" />

<div class="row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>

        <section class="content">
            {{ assessment.completionMessage | purify }}
        </section>

        <h2 class="subheader">Result Summary</h2>
        <section class="content">
            <p>
                <em>This mark is unconfirmed and may change following teacher review.</em>
            </p>
            <p class="grade no-pad">
                <span>{{ attempt.mark }}/{{ attempt.maxMark }} ({{ attempt.normalisedMark|number_format(2) }}%)</span>
            </p>
        </section>

        <section class="content">
            <div id="schoolbox-result-1"></div>
        </section>

        {# This is exactly how it used to be
         # Not sure if we wanted to represent it differently this time around
         #}
        {% if returnUrl %}
            <a href="{{ returnUrl }}" class="submit button">Return</a>
        {% endif %}
    </div>
</div>

{% autoescape 'js' %}
<script>
    let reportsApp = LearnosityReports.init(
        {{ initOptions | raw }}
    );
</script>
{% endautoescape %}
