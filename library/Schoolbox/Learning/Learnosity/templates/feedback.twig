{##
 # Give feedback for an attempt
 #
 # @param string|array $reportInitOptions  Learnosity API initialisation object
 # @param IAssessable $assessment          Our schoolbgox quiz instance
 # @param Attempt\Model $attempt           The student's attempt from our local db
 # @param array $scores                    A list of score tuples obtained per question in this attempt
 #}
<script src="https://reports.learnosity.com/?v2023.2.LTS"></script>


<div class="row">
    <div class="small-12 island">
        <h1>Feedback for {{ assessment.title }}</h1>
        <section class="content">
            <div id="schoolbox-student"></div>
        </section>
        <input id='finalise' type="submit" value="Finalise marks" />
    </div>
</div>

<style>
    .sb-custom-score {
        margin-bottom: 3rem;
    }

    .sb-custom-score label {
        font-weight: bold;
    }
</style>

<script>
    let attemptScores = JSON.parse('{{ scores|raw }}');

    let reportCallback = {
        readyListener: function() {
            let attemptReport = reportsApp.getReport('schoolbox-student');

            /* itemsApi only spawns if you used session-detail-by-item
             */
            attemptReport.on('ready:itemsApi', function(itemsApp) {
                window.itemsApp = itemsApp;

                itemsApp.getQuestions(function(questions) {
                    $.each(questions, function(index, element) {
                        /* Access different parts of the dom directly, to place
                         * our input fields etc.
                         */
                        let learnosityReference = element.metadata.sheet_reference;
                        let learnosityReferenceTuple = element.response_id;
                        let customIdentifier = 'sb-custom__' + learnosityReferenceTuple;

                        /* Student scoring and metadata
                         */
                        let score = attemptScores[learnosityReferenceTuple].score;
                        let maxScore = attemptScores[learnosityReferenceTuple].max;

                        /* Containers into which we inject things
                         */
                        let container = $('[data-reference="' + learnosityReference + '"]');

                        container.append('' +
                            '<div class="sb-custom-score">' +
                                '<label>Customise score</label>' +
                                '<input id="' + customIdentifier + '" type="number" value="' + score + '">' +
                            '</div>' +
                        '');
                    });
                });
            });
        }
    }

    let reportsApp = LearnosityReports.init(
        {{ reportInitOptions | raw }}, reportCallback
    );

    $(function() {
        /* Collate and pump customisations back into Learnosity
         */
        $('#finalise').on('click', function(event) {
            let payload = [];

            $.each(attemptScores, function(index, element) {
                let customIdentifier = 'sb-custom__' + index;

                payload[index] = parseInt($('#' + customIdentifier).val());
            });

            console.log(payload);
        });
    });
</script>
