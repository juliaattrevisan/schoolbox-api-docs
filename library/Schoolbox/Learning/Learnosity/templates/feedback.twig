{##
 # Give feedback for an attempt
 #
 # @param string|array $reportInitOptions  Learnosity API initialisation object
 # @param IAssessable $assessment          Our schoolbgox quiz instance
 # @param Attempt\Model $attempt           The student's attempt from our local db
 # @param array $scores                    A list of score tuples obtained per question in this attempt
 # @param array $comments                  A list of comment tuples that contain per-question comments
 #}
<script src="https://reports-au.learnosity.com/?v2023.2.LTS"></script>


<div class="row">
    <div class="small-12 island">
        <h1>Feedback for {{ assessment.title }}</h1>
        {# Send synchronously
         # Learnosity does this weird caching behaviour where it remembers old
         # scores for a short time, forcing you to refresh manually, which isn't nice
         # Making this form synchronous and redirecting elsewere solves this random
         # issue, plus, the one in chrome where you can't see the async response
         #}
        {% set postFeedbackUrl = routeLookupIfAuthorized('learnosity.postFeedback', {assessmentId: assessment.id, studentId: attempt.user.id, learnositySessionReference: attempt.learnosityReference}) %}
        <form id="feedback-form" action="{{ postFeedbackUrl }}" method="post">
            <section class="content">
                <div id="schoolbox-student"></div>
            </section>
            <section class="content">
                <label>Overall Comment</label>
                <textarea id="attempt-comment" name="attempt-comment">{{ attempt.comment }}</textarea>
                <script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>

                {% autoescape 'js' %}
                <script>
                    $(function() {
                        document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
                            detail: {
                                targetElements: ['#attempt-comment'],
                            }
                        }));
                    });
                </script>
                {% endautoescape %}
            </section>
        </form>
    </div>
</div>

<style>
    .sb-custom-score {
        margin-bottom: 3rem;
    }

    .sb-custom-score label {
        font-weight: bold;
        margin-top: 1rem;
    }
</style>

{% autoescape 'js' %}
<script>
    let attemptScores = JSON.parse('{{ scores|raw }}');
    let attemptComments = JSON.parse(atob('{{ comments|raw }}'));
    let attemptEditorFields = [];

    let reportCallback = {
        readyListener: function() {
            let attemptReport = reportsApp.getReport('schoolbox-student');

            /* itemsApi only spawns if you used session-detail-by-item
             */
            attemptReport.on('ready:itemsApi', function(itemsApp) {
                window.itemsApp = itemsApp;

                itemsApp.getQuestions(function(questions) {
                    $.each(questions, function(index, element) {
                        /* Access different parts of the dom directly, to place
                         * our input fields etc.
                         */
                        let learnosityReference = element.metadata.sheet_reference;
                        let learnosityReferenceTuple = element.response_id;

                        /* Student scoring and metadata
                         */
                        let score = attemptScores[learnosityReferenceTuple].score;
                        let maxScore = attemptScores[learnosityReferenceTuple].max;

                        /* Some questions have a sample answer
                         * If it does, inject that too
                         */
                        let sampleAnswerHtml = '';

                        if (element.metadata.sample_answer) {
                            sampleAnswerHtml = '<label>Sample Answer</label><div>' +
                                element.metadata.sample_answer +
                                '</div></label>';
                        }

                        /* Containers into which we inject things
                         */
                        let container = $('[data-reference="' + learnosityReference + '"]');

                        container.append('' +
                            '<div class="sb-custom-score">' +
                                sampleAnswerHtml +
                                '<label>Customise score</label>' +
                                '<input name="scores[' + learnosityReferenceTuple + ']" type="number" value="' + score + '">' +
                                '<label>Comment</label>' +
                                '<textarea id="comments-' + learnosityReferenceTuple + '" name="comments[' + learnosityReferenceTuple + ']">' + (attemptComments[learnosityReferenceTuple] ?? '') + '</textarea>' +
                            '</div>' +
                        '');

                        /* We need this for cke replacements
                         */
                        attemptEditorFields.push('#comments-' + learnosityReferenceTuple);
                    });
                });

                /* Provide call to action when ready
                 */
                $('#feedback-form').append('<input type="submit" value="Finalise marks" />');

                /* cke all the commentary fields
                 */
                document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
                    detail: {
                        targetElements: attemptEditorFields
                    }
                }));
            });
        }
    }

    let reportsApp = LearnosityReports.init(
        {{ reportInitOptions | raw }}, reportCallback
    );
</script>
{% endautoescape %}
