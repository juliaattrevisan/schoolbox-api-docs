{##
 # Give feedback for an attempt
 #
 # @param object student                   The student's data
 # @param string|array $reportInitOptions  Learnosity API initialisation object
 # @param IAssessable $assessment          Our schoolbgox quiz instance
 # @param array $breadcrumbs               A context trail at the top of the screeen
 # @param string|array $initOptions        Learnosity API initialisation object
 # @param IAssessable $assessment          Our schoolbox quiz instance
 # @param Attempt\Model $attempt           The student's attempt from our local db
 # @param string $itemResponses            A base64_encoded set of (student id, comment, scores) tuples that contain per-question comments and scores
 # @param string $attemptComment           The overall comment for the attempt
 # @param object $urls                     A list of (student id, attempt comment, comment, score) endpoint tuples which tell us each user's persistence urls, indexed by user id
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<script src="https://reports-au.learnosity.com/?v{{ config.learnosity_version }}"></script>
<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/learnosity/learnosity.css?v={{ config.site_version }}" />
<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>

<div class="l-flex-col l-gap-l f-no-margins">
    <h1>Feedback for {{ assessment.title }}</h1>
    <div id="quiz-feedback-container">
        <quiz-feedback
            :student="{{ student|json_encode }}"
            :item-responses="{{ itemResponses|json_encode }}"
            :attempt="{{ attempt|json_encode }}"
            :report-init-options="{{ reportInitOptions }}"
            :attempt-comment="{{ attemptComment|json_encode }}"
            :urls="{{ urls|json_encode }}"
            status-page="{{ routeLookup("learningAssessment.getStatus", {assessmentId: assessment.id}) }}"
        />
    </div>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/quizFeedback.js?v={{ config.site_version }}"></script>
<script>
// to use the new spacing styles
document.getElementById("container").classList.add("c-container");
</script>
