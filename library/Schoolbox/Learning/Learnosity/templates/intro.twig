{##
 # Introduction screen and list of previous attempts
 #
 # @param IAssessable $assessment              Our schoolbgox quiz instance
 # @param User $student                        The guy currently at the intro screen
 # @param Attempt\Model[] $attempts            A list of previous attempts
 # @param Attempt\Model|null $existingattempt  An attempt that hasn't been finished
 #}
{% import '@learningAssessment/fragments/macro/duration.twig' as duration %}

<script src="https://items.learnosity.com/?v2023.2.LTS"></script>

<div class="row">
    <div class="small-12 island">
        <h1>{{ assessment.title }}</h1>
        <section class="content">
            <article>{{ assessment.description | purify }}</article>
        </section>

        {# Decide the name of the start button #}
        {% set callToAction = 'Start Quiz' %}

        {% if existingAttempt %}
            {% set callToAction = 'Resume Quiz' %}
        {% endif %}

        <a class="button submit" href="{{ routeLookupIfAuthorized('learnosity.getAttempt', {assessmentId: assessment.id, studentId: student.id}) }}">{{ callToAction }}</a>
    </div>
</div>

{# This is mostly a direct steal from the existing quiz/summary.twig #}
{% if attempts|length %}
<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">Attempts</h2>

        <table>
            <thead>
                <tr>
                    <th>Start</th>
                    <th>Finish</th>
                    <th>Time Taken</th>
                    <th>Reviewed</th>
                    <th>Grade</th>
                    <th>&nbsp;</th>
                </tr>
            </thead>
            <tbody>
            {% for attempt in attempts %}
                {% set finished = attempt.finish %}
                <tr>
                    <td>{{ attempt.start.short }}</td>
                    <td>
                        {% if finished %}
                            {{ attempt.finish.short }}
                        {% else %}
                            <em>Attempt in progress</em>
                        {% endif %}
                    </td>
                    <td>
                        {% if finished %}
                            {{ duration.secondsToHoursAndMinutes(attempt.start.diffInSeconds(attempt.finish, true)) }}
                        {% else %}
                            <em>{{ duration.secondsToHoursAndMinutes(attempt.start.diffInSeconds(NOW, true)) }}</em>
                        {% endif %}
                    </td>
                    <td>
                        {% if attempt.reviewed %}
                            {{ markVisible.showIfVisible(assessment, attempt.reviewed.short, '—' ) }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>
                        {% if attempt.normalisedMark is not null %}
                            {{ attempt.mark }}/{{ attempt.maxMark }} ({{ attempt.normalisedMark|number_format(2) }}%)
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td class="actions-small-2">
                        <nav>
                            {% if not finished %}
                                <a href="{{ routeLookupIfAuthorized('learnosity.getAttempt', {assessmentId: assessment.id, studentId: student.id}) }}" class="icon-next" title="Resume"></a>
                            {% else %}
                                <a href="{{ routeLookupIfAuthorized('learnosity.getReview', {assessmentId: assessment.id, studentId: student.id, learnosityReference: attempt.learnosityReference}) }}" class="icon-view" title="Review"></a>
                            {% endif %}
                        </nav>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
