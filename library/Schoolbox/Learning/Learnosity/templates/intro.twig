{##
 # Introduction screen and list of previous attempts
 #
 # @param IAssessable $assessment              Our schoolbgox quiz instance
 # @param Schoolbox\Learning\Quiz\Model $quiz  The representation of schoolbox.assess row
 # @param User $student                        The guy currently at the intro screen
 # @param Attempt\Model[] $attempts            A list of previous attempts
 # @param Attempt\Model|null $existingattempt  An attempt that hasn't been finished
 # @param array $plan                          A set of dates for custom assessment participation
 #}
{% import '@learningAssessment/fragments/macro/duration.twig' as duration %}
{% import '@learningAssessment/fragments/macro/markVisible.twig' as markVisible %}

<script src="https://items-au.learnosity.com/?v2023.2.LTS"></script>

{% set statusRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: assessment.id, assessment: assessment}) %}
{% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: assessment.id, assessment: assessment}) %}
{% set modifyContentsRoute = routeLookupIfAuthorized('learnosity.getContent', {assessmentId: assessment.id}) %}

<div class="actions-small-2 row">
    <div class="small-12 columns">
        <h1>{{ assessment.title }}</h1>

        <ul class="meta">
            <!-- BEGIN has_assess_due -->
            <li class="icon-calendar" title="Due">Due <time>{{ plan.finish.short }}</time></li>
            <!-- END has_assess_due -->
            <li class="icon-time-value" title="Allowed Time">Allowed time:
                <time>{{ assessment.durationNeatly(assessment.duration) }}</time>
            </li>
            <li class="icon-home" title="Homepage"><a href="/homepage/{{ assessment.context.id }}">{{ assessment.context.title }}</a></li>
            <li class="icon-staff-students" title="Author">{% apply spaceless %}
                {% if quiz.user.deleted %}
                    {{ quiz.user.fullname }}
                {% else %}
                    <a href="/search/user/{{ quiz.user.id }}">{{ quiz.user.fullname }}</a>
                {% endif %}
            {% endapply %}</li>
        </ul>
    </div>
    {% if statusRoute or modifyRoute or modifyContentsRoute %}
    <nav>
        <sbx-pop-out content-id="header-options"></sbx-pop-out>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        {% if statusRoute %}<li><a class="icon-progress" href="{{ statusRoute }}">View Status</a></li>{% endif %}

        {# Learnosity Quiz has two parts: Modify Settings and Modify Contents #}
        {% if modifyRoute %}<li><a class="icon-modify" href="{{ modifyRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Modify Settings</a></li>{% endif %}
        {% if modifyContentsRoute %}<li><a class="icon-modify" href="{{ modifyContentsRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Modify Contents</a></li>{% endif %}
    </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <article>{{ assessment.description | purify }}</article>
        </section>

        {# Decide the name of the start button #}
        {% set callToAction = 'Start Quiz' %}

        {% if existingAttempt %}
            {% set callToAction = 'Resume Quiz' %}
        {% endif %}

        <a class="button submit" href="{{ routeLookupIfAuthorized('learnosity.getAttempt', {assessmentId: assessment.id, studentId: student.id}) }}">{{ callToAction }}</a>
    </div>
</div>

{# This is mostly a direct steal from the existing quiz/summary.twig #}
{% if attempts|length %}
<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">Attempts</h2>

        <table>
            <thead>
                <tr>
                    <th>User</th>
                    <th>Start</th>
                    <th>Finish</th>
                    <th>Time Taken</th>
                    <th>Reviewed</th>
                    <th>Reviewer</th>
                    <th>Grade</th>
                    <th>&nbsp;</th>
                </tr>
            </thead>
            <tbody>
            {% for attempt in attempts %}
                {% set finished = attempt.finish %}
                <tr>
                    <td>{{ attempt.user.fullname }}</td>
                    <td>{{ attempt.start.short }}</td>
                    <td>
                        {% if finished %}
                            {{ attempt.finish.short }}
                        {% else %}
                            <em>Attempt in progress</em>
                        {% endif %}
                    </td>
                    <td>
                        {% if finished %}
                            {{ duration.secondsToHoursAndMinutes(attempt.start.diffInSeconds(attempt.finish, true)) }}
                        {% else %}
                            <em>{{ duration.secondsToHoursAndMinutes(attempt.start.diffInSeconds(NOW, true)) }}</em>
                        {% endif %}
                    </td>
                    <td>
                        {% if attempt.reviewed %}
                            {{ markVisible.showIfVisible(assessment, attempt.reviewed.short, '—' ) }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>
                        {% if attempt.reviewed %}
                            <a href="/search/user/{{ attempt.reviewer.id }}">{{ attempt.reviewer.fullname }}</a>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>
                        {% if attempt.normalisedMark is not null %}
                            {{ attempt.mark }}/{{ attempt.maxMark }} ({{ attempt.normalisedMark|number_format(2) }}%)
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td class="actions-small-2">
                        <nav>
                            {% if not finished %}
                                <a href="{{ routeLookupIfAuthorized('learnosity.getAttempt', {assessmentId: assessment.id, studentId: student.id}) }}" class="icon-next" title="Resume"></a>
                            {% else %}
                                <a href="{{ routeLookupIfAuthorized('learnosity.getReview', {assessmentId: assessment.id, studentId: student.id, learnositySessionReference: attempt.learnosityReference}) }}" class="icon-view" title="Review"></a>
                                <a href="{{ routeLookupIfAuthorized('learnosity.getFeedback', {assessmentId: assessment.id, studentId: student.id, learnositySessionReference: attempt.learnosityReference}) }}" class="icon-staff" title="Feedback"></a>
                            {% endif %}
                        </nav>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
