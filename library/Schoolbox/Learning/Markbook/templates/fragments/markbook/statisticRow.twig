<tr class="sub-row" data-sub-table-row data-hidable-columns>
    <td>{{ label }}</td>
    <td>&nbsp;</td>
    {% for assessment in markbook.assessments  %}
    <td data-assessment="{{ assessment.id }}">
        {% if markbook.assessmentStatistics[assessment.id][key] is defined %}
            {% if input and assessment is not task %}
                <input type="number" name="weight" data-weight value="{{ assessment.weight }}" min=0 max=100 data-assessment="{{ assessment.id }}">
            {% elseif round %}
                {{ markbook.assessmentStatistics[assessment.id][key] | round(round) }}
            {% else %}
                {{ markbook.assessmentStatistics[assessment.id][key] }}
            {% endif %}
        {% endif %}
    </td>
    {% endfor %}
</tr>
