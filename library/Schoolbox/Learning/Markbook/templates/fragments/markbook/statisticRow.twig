<tr class="sub-row" data-sub-table-row data-hidable-columns>
    <td>{{ label }}</td>
    <td>&nbsp;</td>
    {% if rankEnabled %}
    <td>&nbsp;</td>
    {% endif %}
    {% for assessment in markbook.assessments  %}
    <td data-assessment="{{ assessment.id }}" class="student-grade-cell">
        {% if markbook.assessmentStatistics[assessment.id][key] is defined and writable[assessment.id] is defined %}
            {% if input ?? false and assessment is not task and not assessment.courseManaged and writable[assessment.id] %}
                <input type="text" inputmode="numeric" name="weight" data-weight value="{{ assessment.weight }}" min=0 data-assessment="{{ assessment.id }}">
            {% elseif round is defined %}
                {{ markbook.assessmentStatistics[assessment.id][key] | round(round) }}
            {% else %}
                {{ markbook.assessmentStatistics[assessment.id][key] }}
            {% endif %}
        {% endif %}
    </td>
    {% endfor %}
</tr>
