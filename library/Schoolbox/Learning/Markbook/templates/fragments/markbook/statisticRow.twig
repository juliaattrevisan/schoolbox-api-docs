<tr class="sub-row" data-sub-table-row data-hidable-columns>
    <th class="fixed-left">{{ label }}</th>
    <th class="fixed-left">&nbsp;</th>
    {% if rank %}
    <td></td>
    {% endif %}
    {% for assessment in assessments  %}
    <td data-assessment="{{ assessment.id }}" class="student-grade-cell">
        {% if assessment.stats[key] is defined and assessment.writable is not null %}
            {% if input ?? false and assessment is not task and not assessment.courseManaged and assessment.writable %}
                <input type="number" inputmode="numeric" name="weight" data-weight value="{{ assessment.weight }}" min=0 data-assessment="{{ assessment.id }}">
            {% elseif round is defined %}
                {{ assessment.stats[key] | round(round) }}
            {% else %}
                {{ assessment.stats[key] }}
            {% endif %}
        {% endif %}
    </td>
    {% endfor %}
</tr>
