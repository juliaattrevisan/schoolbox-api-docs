{#
    Filtered markbook report

    Usage:
        markbook      Markbook                         - the markbook to render
        folder        \Schoolbox\Resource\Folder\Model - what folder is this markbook for?
        writable      bool[]                           - which assessments are writable? indexed by assessment.id
        pendingLabel  string                           - the default label for new submissions, pulled from DB
        queryArgs     string                           - the filters used to generate this report, so we can export the exact same report
#}

{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learning/macro/markDecorator.twig' as decorator %}

{# If the markbook has more than this number of participants reduce functionality to improve browser performance#}
{% set functionDegradeLimit = 80 %}
{% set studentCount = markbook.students|length %}

<div class="actions-small-1 small-12 columns">
    <div class="legend">
        <div class="indicators">
            <p class="meta"><span class="legend-indicator indicator-none"></span>Unmarked</p>
            <p class="meta"><span class="legend-indicator indicator-pending"></span>Unpublished draft</p>
            <p class="meta"><span class="legend-indicator indicator-resubmit"></span>Resubmit</p>
            <p class="meta"><span class="legend-indicator indicator-published"></span>Mark Published</p>
        </div>
    </div>
    <div class="checklist">
        <input type="checkbox" id="show-drafts">
        <label for="show-drafts">
            Show Drafts
        </label>
    </div>
    <nav>
        <a class="icon-more" data-dropdown="header-options" title="Actions"></a>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        <li class="separator">Report</li>
        <li><a href='{{ routeLookup('learningMarkbook.getMarkbookExportForClass', {folder: folder, folderId: folder.id}) }}?{{ queryArgs }}' class='icon-download'>Download Spreadsheet</a>
    </ul>
</div>

{% if studentCount >= functionDegradeLimit %}
<div id="report_actions">
    <div class="small-12 column list-item">
        <ul class="meta">
            <li class="icon-alert">This markbook is showing a large number of students; for performance reasons, student portraits and marking of tasks have been disabled.</li>
        </ul>
    </div>
</div>
{% endif %}

<div class="diagonal-headings-table-container small-12 island" data-diagonal-headings-table-container>
    {% if markbook.assessments|length > 0 %}
    <table id="marksheet-styles" class="diagonal-headings-table marksheet" data-mark-sheet>
        <thead>
            <tr class="rotate-headers" data-headers data-hidable-columns>
                <th class="fixed-left"><div></div></th>
                <th class="fixed-left"><div><span>Student Weighted Average</span></div></th>
                {% if rankEnabled %}
                <th>
                    <div>
                        <span>Class Ranking</span>
                    </div>
                </th>
                {% endif %}
                {% for assessment in markbook.assessments %}
                <th data-assessment="{{ assessment.id }}">
                    <div>
                        {# A teacher clicking an assessment from the markbook is most likely interested in seeing more granular results #}
                        {% set href = routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id}) %}
                        <span>
                            <a href="{{ href }}" title="{{ assessment.title }}">{{ assessment.title }}</a><br/>
                            <span class="meta">{{ assessment.typeName }}</span>
                        </span>
                    </div>
                </th>
                {% endfor %}
            </tr>

            <tr class="average-headers" data-hidable-columns>
                <th class="fixed-left white profile-cell average-expander">
                    <a href="#" class='icon-down-arrow' title="Show additional metrics" data-toggle-averages></a>
                    Class Average
                </th>
                {% set weightedMean = markbook.weightedMean %}
                <th class="fixed-left {{ weightedMean is null ? 'gradient-off' : urgency.marks(markbook.normalisedMean) }}-bg student-grade-cell">
                        {{ weightedMean | default('-') }}
                </th>
                {% if rankEnabled %}
                <th>-</th>
                {% endif %}
                {% for assessment in markbook.assessments %}
                    {% set stats = markbook.assessmentStatistics[assessment.id] %}
                    <th data-assessment="{{ assessment.id }}" class="student-grade-cell white">
                        <span {% if stats.draftMean is defined and (markbook.hasDraft[assessment.id] is defined) %} data-actual-mark {% endif %}>
                            {{ stats.mean | default('-') }}
                        </span>
                        {% if stats.draftMean is defined and (markbook.hasDraft[assessment.id] is defined) %}
                            <span data-draft-mark class="meta" style="display:none;">
                                {{ stats.draftMean | default('-') }}
                            </span>
                        {% endif %}
                    </th>
                {% endfor %}
            </tr>

        </thead>

        <tbody>
            {# Statistics: weight, visibility, mean, SD, min, max, submitted, returned #}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {writable: writable, markbook: markbook, label: 'Weight', key: 'weight', input: true} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {writable: writable, markbook: markbook, label: 'Weight in ' ~ locale.project.proper, key: 'weightInProject', input: true} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {writable: writable, markbook: markbook, label: '% Total Weight', key: 'weightPercent', round: 2} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {writable: writable, markbook: markbook, label: '% Total Weight in  ' ~ locale.project.proper, key: 'projectWeightPercent', round: 2} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {writable: writable, markbook: markbook, label: 'Mean', key: 'mean'} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {writable: writable, markbook: markbook, label: 'Standard Deviation', key: 'sd'} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {writable: writable, markbook: markbook, label: 'Min', key: 'min'} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {writable: writable, markbook: markbook, label: 'Max', key: 'max'} %}
            <tr class="sub-row">
                <th class="fixed-left">Visibility</th>
                <th class="fixed-left"></th>
                {% if rankEnabled %}
                <td>&nbsp;</td>
                {% endif %}
                {% for assessment in markbook.assessments %}
                    <td data-assessment="{{ assessment.id }}">
                        {% if assessment is not task %}
                            {% set selected = assessment.markvisibility %}
                            {% set allOptions = {
                                0: { css: 'icon-locked', icon: '&#xe63e;', description: 'Staff Only' },
                                1: { css: 'icon-staff-students', icon: '&#xe667;', description: 'Staff and Students' },
                                2: { css: 'icon-staff', icon: '&#xe666;', description: 'Staff, Students and their Parents' }
                            } %}

                            {% if writable[assessment.id] %}
                                <select name="visibility" data-assessment="{{ assessment.id }}" data-visibility>
                                    {% for currentOption, label in allOptions %}
                                        <option value="{{ currentOption }}"
                                            {% if currentOption not in availableVisibilities %}disabled="disabled"{% endif %}
                                            {% if currentOption == selected %}selected="selected"{% endif %}> {{ (label['icon'] ~ ' ' ~ label['description'])|raw }} </option>
                                    {% endfor %}
                                </select>
                            {% else %}
                                <span class="{{ allOptions[selected].css }}" title="{{ allOptions[selected].description }}"></span>
                            {% endif %}

                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
            {# Need all students that ever participated in any assessments #}
            {% apply spaceless %}
            {% for student in markbook.students %}
            <tr data-student="{{ student.id }}">
                <th class="fixed-left white profile-cell">
                    <div class="c-card">
                        <div class="l-flex-row l-gap-m l-pad-m">
                            {% if studentCount < functionDegradeLimit %}
                                {% include "include/portrait.twig" with {user: student, render: "tiny", roundedCorners: true} only %}
                            {% endif %}
                            <div class="l-flex-col l-flex--justify-center f-no-margins">
                                <a href="/search/user/{{ student.id }}" title="View Profile">{{ student.lastname }}, {{ student.firstname }}</a>
                            </div>
                        </div>
                    </div>

                </th>

                {% set studentMean         = markbook.studentStatistics[student.id].weightedMean %}
                {% set draftWeightedMean   = markbook.studentStatistics[student.id].draftWeightedMean %}
                {% set meanNormalised      = markbook.studentStatistics[student.id].meanNormalised %}
                {% set meanDraftNormalised = markbook.studentStatistics[student.id].meanDraftNormalised %}

                {% set draftsOffClass      = studentMean is null ? 'gradient-off-bg' : urgency.marks(meanNormalised) ~ '-bg' %}
                {% set draftsOnClass       = draftWeightedMean is null ? 'gradient-off-bg' : urgency.marks(meanDraftNormalised) ~ '-bg' %}

                <th class="fixed-left white {{ draftsOffClass }} student-grade-cell"
                    {% if draftWeightedMean %}data-student-average{% endif %}
                    data-off-class="{{ draftsOffClass }}" data-on-class="{{ draftsOnClass }}">
                    {% set gradesRoute = routeLookup('learningGrades.getGrades', {viewee: student, userId: student.id, termCode: ''}) %}
                    {# Regardless of which term is being filtered to, link to default term grades page (ie empty termCode) #}
                    <a class="{{ draftsOffClass }}"
                       href="{{ gradesRoute }}" {% if draftWeightedMean %}data-actual-mark{% endif %}
                       title="View students {{ locale.grades.plural }}"> {{ studentMean | default('-') }}
                    </a>
                    {% if draftWeightedMean %}
                        <a class="{{ draftsOnClass }}"
                           href="{{ gradesRoute }}" data-draft-mark style="display: none"
                           title="View student draft {{ locale.grades.plural }}"> {{ draftWeightedMean | default('-') }}
                        </a>
                    {% endif %}
                </th>
                {% if rankEnabled %}
                <td>
                    {% if rank[student.id] is defined and meanNormalised %}
                        {# check if the rank object exits, and there is / was a mean score #}
                        {{ rank[student.id] }}
                    {% else %}
                        <span>-</span>
                    {% endif %}
                </td>
                {% endif %}

                {% for assessment in markbook.assessments %}
                    {% set participant = assessment.getParticipantIfExtant(student, false) %}
                    <td
                        class="column-{{ assessment.id }}
                            {% if not participant or participant.isExcluded %} excluded
                            {% endif %} student-grade-cell"
                            data-assessment="{{ assessment.id }}"
                            {% if assessment is dueWork or assessment is quiz or assessment is lti or (assessment is project and (participant and not participant.isExcluded)) %}
                            data-pop-out-menu
                            {% endif %}
                            data-assessment-type="{{ assessment.getDefaultTypeName }}"
                            data-endpoint="{{ routeLookupIfAuthorized('learningAssessmentTimeline.getFullTimeline', {assessment: assessment, assessmentId: assessment.id, userId: student.id }) }}"
                            data-update-route="{{ routeLookupIfAuthorized('learningDueWorkResponse.getParticularResponse', {assessment: assessment, assessmentId:assessment.id, student: student, studentId:student.id }) }}"
                            data-review-route="{{ routeLookupIfAuthorized('learningDueWorkResponse.getParticularResponse', {assessment: assessment, assessmentId:assessment.id, student: student, studentId:student.id }) }}"
                            data-publish-route="{{ routeLookupIfAuthorized('learningDueWorkFeedback.postPublishFeedback', {assessment: assessment, assessmentId:assessment.id, student: student, studentId:student.id }) }}"
                            data-exclude-route="{{ routeLookupIfAuthorized('learningAssessment.postExclude', {assessment: assessment, assessmentId:assessment.id, student: student, studentId:student.id }) }}"
                            data-include-route="{{ routeLookupIfAuthorized('learningAssessment.postInclude', {assessment: assessment, assessmentId:assessment.id, student: student, studentId:student.id }) }}"
                            data-is-participant="{% if participant %}true{% else %}false{% endif %}"
                            data-is-excluded="{% if participant and not participant.isExcluded %}false{% else %}true{% endif %}"
                            data-history-route="{{ routeLookupIfAuthorized('learningAssessment.getSummary', {assessment: assessment, assessmentId:assessment.id, student: student, studentId:student.id }) }}"
                    >
                    <!-- Add data for the popup menu above -->
                        {% if participant and not participant.isExcluded %}
                            {% if assessment is task %}
                                {# An icon that shows if the student has attempted the task or not #}
                                {% if studentCount < functionDegradeLimit %}
                                    {% include '@learningAssessment/fragments/progressTick.twig' with {
                                        assessment: assessment,
                                        student: participant.user
                                    } only %}
                                {% else %}
                                    {% if participant.isResponseRequired %}
                                        <div
                                           class="no-text progress-tick readonly"
                                           title="Incomplete"
                                           data-progress-tick-status="incomplete"></div>
                                    {% elseif participant.isFeedbackRequired %}
                                        <div
                                           class="no-text progress-tick pending"
                                           title="Self-assessed"
                                           data-progress-tick-status="selfAssessed"></div>
                                    {% elseif participant.isReviewComplete %}
                                        <div
                                           class="no-text progress-tick reviewed"
                                           title="Completed"
                                           data-progress-tick-status="teacherAssessed"></div>
                                    {% endif %}
                                {% endif %}
                            {% else %}
                                {% set normalisedMark = participant.normalisedMark(true) %}
                                {% set participationRoute = routeLookup('learningAssessment.getSummary', {assessmentId: assessment.id, studentId: student.id}) %}
                                {% set draftMark = markbook.hasDraft[assessment.id][student.id] is defined %}
                                 <span class="{{ urgency.marks(normalisedMark) }}"
                                    href="{{ participationRoute }}" {% if draftMark %} data-actual-mark {% endif %}
                                    title="{{ participant.authoritativeFeedback(true) ? participant.authoritativeFeedback(true).comment : '' }}">{{ decorator.label(participant, true) }}</span>
                                {% if draftMark %}
                                    <span href="{{ participationRoute }}" data-draft-mark style="display: none"
                                       class="meta"
                                       title="{{ participant.authoritativeFeedback(false) ? participant.authoritativeFeedback(false).comment : '' }}">{{ decorator.label(participant, false) }}</span>
                                {% endif %}
                                {% if participant.hasSubmittedResponse or participant.resubmissionRequired or participant.hasPublishedFeedback or draftMark %}
                                    <span class="legend-indicator indicator-{{ decorator.indicator(participant, draftMark) }}" title="{{ decorator.notchTitle(participant, draftMark) }}"></span>
                                {% endif %}
                                {% if not participant.plan.isDynamic %}
                                    <span class="individualisation has-tip tip-left" data-width="200" data-tooltip title="{{ participant.plan.name }} ({{ participant.plan.duedate.short }})">i</span>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
            {% endfor %}
            {% endapply %}
        </tbody>
        </table>
    {% else %}
    <div class="empty-state">
        <i class="icon-curriculum"></i>
        <p>
            There are no activities that match the selected filters.  Try altering the filters to broaden your search.
        </p>
    </div>
    {% endif %}
    <div class="toast" data-alert data-save-progress-state></div>
</div>
