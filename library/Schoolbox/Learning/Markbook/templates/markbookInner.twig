{#
    Filtered markbook report

    Usage:
        markbook      Markbook                         - the markbook to render
        folder        \Schoolbox\Resource\Folder\Model - what folder is this markbook for?
        writable      bool[]                           - which assessments are writable? indexed by assessment.id
        pendingLabel  string                           - the default label for new submissions, pulled from DB
        queryArgs     string                           - the filters used to generate this report, so we can export the exact same report
#}

{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learning/macro/markDecorator.twig' as decorator %}

{# There's only 1 of these currently #}
{% set classImpl = classImpls[0] %}

{# If the markbook has more than this number of participants reduce functionality to improve browser performance#}
{% set functionDegradeLimit = 80 %}
{% set studentCount = classImpl.students|length %}

<div class="actions-small-1">
    <div class="legend">
        <div class="indicators">
            <p class="meta"><span class="legend-indicator indicator-none"></span>Unmarked</p>
            <p class="meta"><span class="legend-indicator indicator-pending"></span>Unpublished draft</p>
            <p class="meta"><span class="legend-indicator indicator-resubmit"></span>Resubmit</p>
            <p class="meta"><span class="legend-indicator indicator-published"></span>Mark Published</p>
        </div>
    </div>
    <div class="checklist">
        <input type="checkbox" id="show-display-marks">
        <label for="show-display-marks" data-test="markbook-show-display-marks">
            Show Display Marks
            <span class="hint has-tip tip-top" data-tooltip title="Shows marks in the same format that students see">?</span>
        </label>
    </div>
    <div class="checklist">
        <input type="checkbox" id="show-drafts">
        <label for="show-drafts">
            Show Drafts
        </label>
    </div>
    <nav>
        <sbx-pop-out content-id="header-options"></sbx-pop-out>
    </nav>
    <ul id="header-options" class="f-dropdown" data-dropdown-content>
        <li class="separator">Report</li>
        <li><a href='{{ _routes.exportReport }}'
               data-download-spreadsheet
               class='icon-download'>Download Spreadsheet</a>
    </ul>
</div>

{% if studentCount >= functionDegradeLimit %}
<div id="report_actions">
    <div class="small-12 column list-item">
        <ul class="meta">
            <li class="icon-alert">This markbook is showing a large number of students; for performance reasons, student portraits and marking of tasks have been disabled.</li>
        </ul>
    </div>
</div>
{% endif %}

<div class="diagonal-headings-table-container small-12 island" data-diagonal-headings-table-container>
    {% if classImpl.assessments|length > 0 %}
    <table id="marksheet-styles" class="diagonal-headings-table marksheet" data-mark-sheet>
        <thead>
            <tr class="rotate-headers" data-headers data-hidable-columns>
                <th class="fixed-left"><div></div></th>
                <th class="fixed-left"><div><span>Student Weighted Average</span></div></th>
                {% if rank %}
                <th>
                    <div>
                        <span>Class Ranking</span>
                    </div>
                </th>
                {% endif %}
                {% for aImpl in classImpl.assessments %}
                {% set assessment = assessments[aImpl.id] %}
                <th data-test="markbook-assessment" data-assessment="{{ assessment.id }}">
                    <div>
                        {# A teacher clicking an assessment from the markbook is most likely interested in seeing more granular results #}
                        <span>
                            <a href="{{ aImpl._routes['learningAssessment.getStatus'] }}" title="{{ assessment.title }}">{{ assessment.title }}</a><br/>
                            <span class="meta">{{ assessment.typeName }}</span>
                        </span>
                    </div>
                </th>
                {% endfor %}
            </tr>

            <tr class="average-headers" data-hidable-columns>
                <th class="fixed-left white profile-cell average-expander">
                    <a href="#" class='icon-down-arrow' title="Show additional metrics" data-toggle-averages></a>
                    Class Average
                </th>
                {% set weightedMean = classImpl.stats.weightedMean %}
                {% set draftWeightedMean = classImpl.stats.draftWeightedMean %}
                {% set draftsOffClass = (weightedMean is null ? 'gradient-off' : urgency.marks(classImpl.stats.normalisedMean) ~ '-bg') %}
                {% set draftsOnClass = (draftWeightedMean is null ? 'gradient-off' : urgency.marks(classImpl.stats.draftNormalisedMean) ~ '-bg') %}
                <th class="fixed-left student-grade-cell {{ draftsOffClass }}"
                    {% if draftWeightedMean %}data-student-average{% endif %}
                    data-off-class="{{ draftsOffClass }}"
                    data-on-class="{{ draftsOnClass }}">
                    <span data-actual-mark>{{ weightedMean | default('-') }}</span>
                    <span data-draft-mark style="display:none">{{ draftWeightedMean | default('-') }}</span>
                </th>
                {% if rank %}
                <th>-</th>
                {% endif %}
                {% for assessment in classImpl.assessments %}
                    <th data-assessment="{{ assessment.id }}" class="student-grade-cell white">
                        <span {% if assessment.stats.draftMean is defined and (assessment.hasDraft) %} data-actual-mark {% endif %}>
                            {{ assessment.stats.mean | default('-') }}
                        </span>
                        {% if assessment.stats.draftMean is defined and (assessment.hasDraft) %}
                            <span data-draft-mark class="meta" style="display:none;">
                                {{ assessment.stats.draftMean | default('-') }}
                            </span>
                        {% endif %}
                    </th>
                {% endfor %}
            </tr>

        </thead>

        <tbody>
            {# Statistics: weight, visibility, mean, SD, min, max, submitted, returned #}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {assessments: classImpl.assessments, label: 'Weight', key: 'weight', input: true} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {assessments: classImpl.assessments, label: 'Weight in ' ~ locale.project.proper, key: 'weightInProject', input: true} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {assessments: classImpl.assessments, label: '% Total Weight', key: 'weightPercent', round: 2} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {assessments: classImpl.assessments, label: '% Total Weight in  ' ~ locale.project.proper, key: 'projectWeightPercent', round: 2} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {assessments: classImpl.assessments, label: 'Mean', key: 'mean'} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {assessments: classImpl.assessments, label: 'Standard Deviation', key: 'sd'} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {assessments: classImpl.assessments, label: 'Min', key: 'min'} %}
            {% include '@learningMarkbook/fragments/markbook/statisticRow.twig' with {assessments: classImpl.assessments, label: 'Max', key: 'max'} %}
            <tr class="sub-row">
                <th class="fixed-left">Visibility</th>
                <th class="fixed-left"></th>
                {% if rank %}
                <td>&nbsp;</td>
                {% endif %}
                {% for aImpl in classImpl.assessments %}
                    {% set assessment = assessments[aImpl.id] %}
                    <td data-assessment="{{ assessment.id }}">
                        {% if assessment.familyName != 'task' %}
                            {% set selected = aImpl.markVisibility %}
                            {% set allOptions = {
                                0: { css: 'icon-locked', icon: '&#xe63e;', description: 'Staff Only' },
                                1: { css: 'icon-staff-students', icon: '&#xe667;', description: 'Staff and Students' },
                                2: { css: 'icon-staff', icon: '&#xe666;', description: 'Staff, Students and their Parents' }
                            } %}

                            {% if aImpl.writable %}
                                <select name="visibility" data-assessment="{{ assessment.id }}" data-visibility>
                                    {% for currentOption, label in allOptions %}
                                        <option value="{{ currentOption }}"
                                            {% if currentOption not in availableVisibilities %}disabled="disabled"{% endif %}
                                            {% if currentOption == selected %}selected="selected"{% endif %}> {{ (label['icon'] ~ ' ' ~ label['description'])|raw }} </option>
                                    {% endfor %}
                                </select>
                            {% else %}
                                <span class="{{ allOptions[selected].css }}" title="{{ allOptions[selected].description }}"></span>
                            {% endif %}

                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
            {# Need all students that ever participated in any assessments #}
            {% apply spaceless %}
            {% for student in classImpl.students %}
            <tr data-student="{{ student.id }}">
                <th class="fixed-left white profile-cell">
                    <div class="c-card">
                        <div class="l-flex-row l-gap-m l-pad-s">
                            {% if studentCount < functionDegradeLimit %}
                                {% include "include/portrait.twig" with {user: student, render: "tiny", roundedCorners: true} only %}
                            {% endif %}
                            <div class="l-flex-col l-flex--justify-center f-no-margins">
                                <a href="/search/user/{{ student.id }}" title="View Profile">{{ student.lastName }}, {{ student.firstName }}</a>
                            </div>
                        </div>
                    </div>

                </th>

                {% set studentMean         = student.stats.weightedMean %}
                {% set draftWeightedMean   = student.stats.draftWeightedMean %}
                {% set meanNormalised      = student.stats.meanNormalised %}
                {% set meanDraftNormalised = student.stats.meanDraftNormalised %}

                {% set draftsOffClass      = studentMean is null ? 'gradient-off-bg' : urgency.marks(meanNormalised) ~ '-bg' %}
                {% set draftsOnClass       = draftWeightedMean is null ? 'gradient-off-bg' : urgency.marks(meanDraftNormalised) ~ '-bg' %}

                <th class="fixed-left {{ draftsOffClass }} student-grade-cell"
                    {% if draftWeightedMean %}data-student-average{% endif %}
                    data-off-class="{{ draftsOffClass }}" data-on-class="{{ draftsOnClass }}">
                    {# Regardless of which term is being filtered to, link to default term grades page (ie empty termCode) #}
                    <a class="{{ draftsOffClass }}"
                       href="{{ student._routes['learningGrades.getGrades'] }}" {% if draftWeightedMean %}data-actual-mark{% endif %}
                       title="View students {{ locale.grades.plural }}"> {{ studentMean | default('-') }}
                    </a>
                    {% if draftWeightedMean %}
                        <a class="{{ draftsOnClass }}"
                           href="{{ student._routes['learningGrades.getGrades'] }}" data-draft-mark style="display: none"
                           title="View student draft {{ locale.grades.plural }}"> {{ draftWeightedMean | default('-') }}
                        </a>
                    {% endif %}
                </th>
                {% if rank %}
                <td>
                    {% if rank[student.id] is defined and meanNormalised %}
                        {# check if the rank object exits, and there is / was a mean score #}
                        {{ rank[student.id] }}
                    {% else %}
                        <span>-</span>
                    {% endif %}
                </td>
                {% endif %}

                {% for aImpl in classImpl.assessments %}
                    {% set assessment = assessments[aImpl.id] %}
                    {% set participant = aImpl.participants[student.id] ?? null %}
                    <td
                        class="column-{{ assessment.id }}
                            {% if not participant or participant.isExcluded %} excluded
                            {% endif %} student-grade-cell"
                            data-test="markbook-cell-{{ assessment.id }}-{{ student.id }}"
                            data-assessment="{{ assessment.id }}"
                            {% if assessment.familyName == 'dueWork' or assessment.familyName == 'quiz' or assessment.familyName == 'lti' %}
                            data-pop-out-menu
                            {% endif %}
                            data-assessment-type="{{ assessment.familyName }}"
                            data-endpoint="{{ aImpl._routes.student[student.id]['learningAssessmentTimeline.getFullTimeline'] }}"
                            data-update-route="{{ aImpl._routes.student[student.id]['learningDueWorkResponse.getParticularResponse'] }}"
                            data-review-route="{{ aImpl._routes.student[student.id]['learningDueWorkResponse.getParticularResponse'] }}"
                            data-publish-route="{{ aImpl._routes.student[student.id]['learningDueWorkFeedback.postPublishFeedback'] }}"
                            data-exclude-route="{{ aImpl._routes.student[student.id]['learningAssessment.postExclude'] }}"
                            data-include-route="{{ aImpl._routes.student[student.id]['learningAssessment.postInclude'] }}"
                            data-is-participant="{% if participant %}true{% else %}false{% endif %}"
                            data-is-excluded="{% if participant and not participant.isExcluded %}false{% else %}true{% endif %}"
                            data-history-route="{{ aImpl._routes.student[student.id]['learningAssessment.getSummary'] }}"
                    >
                    <!-- Add data for the popup menu above -->
                        {% if participant and not participant.isExcluded %}
                            {% if assessment.familyName == 'task' %}
                                {# An icon that shows if the student has attempted the task or not #}
                                {% if studentCount < functionDegradeLimit and participant.progressTick.postRouteUrl %}
                                    <form action="{{ participant.progressTick.postRouteUrl }}"
                                    method="post"
                                    class="progress-tick-form"
                                    data-progress-tick-form="{{ assessment.isSelfAssessable ?? false ? 'selfAssessed' : 'teacherAssessed' }}">
                                        <a
                                            class="no-text progress-tick {{ participant.progressTick.progressClass }}"
                                            {# placeholder for now, this'll get taken out eventually #}
                                            title="Incomplete"
                                            data-progress-tick-status="incomplete"
                                        /></a>
                                    </form>
                                {% else %}
                                    <div
                                        class="no-text progress-tick {{ participant.progressTick.progressClass }}"
                                        {# placeholder for now, this'll get taken out eventually #}
                                        title="Incomplete"
                                        data-progress-tick-status="incomplete"
                                    ></div>
                                {% endif %}
                            {% else %}
                                {% set draftMark = participant.marks.draft is not null %}
                                <span
                                    class="{{ urgency.marks(participant.marks.published.norm ?? null) }}"
                                    href="{{ aImpl._routes.student[student.id]['learningAssessment.getSummary'] }}"
                                    {% if draftMark %} data-actual-mark {% endif %}
                                    title="{{ participant.marks.published.comment ?? '' }}"
                                >
                                    <span data-instructor-mark>{{ decorator.label(participant, true, true) }}</span>
                                    <span data-learner-mark style="display: none">{{ decorator.label(participant, true, false) }}</span>
                                </span>
                                {% if draftMark %}
                                    <span
                                        href="{{ aImpl._routes.student[student.id]['learningAssessment.getSummary'] }}"
                                        data-draft-mark
                                        style="display: none"
                                        class="meta"
                                        title="{{ participant.marks.draft.comment ?? '' }}"
                                    >
                                        <span data-instructor-mark>{{ decorator.label(participant, false, true) }}</span>
                                        <span data-learner-mark style="display: none">{{ decorator.label(participant, false, false) }}</span>
                                    </span>
                                {% endif %}
                                {% if participant.hasSubmittedResponse or participant.resubmissionRequired or participant.hasPublishedFeedback or draftMark %}
                                    <span class="legend-indicator indicator-{{ decorator.indicator(participant, draftMark) }}" title="{{ decorator.notchTitle(participant, draftMark) }}"></span>
                                {% endif %}
                                {% if not participant.plan.isDynamic %}
                                    <span class="individualisation has-tip tip-left" data-width="200" data-tooltip title="{{ participant.plan.name }} ({{ participant.plan.dueDate }})">i</span>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
            {% endfor %}
            {% endapply %}
        </tbody>
        </table>
    {% else %}
    <div class="empty-state">
        <i class="icon-curriculum"></i>
        <p>
            There are no activities that match the selected filters.  Try altering the filters to broaden your search.
        </p>
    </div>
    {% endif %}
    <div class="toast" data-alert data-save-progress-state></div>
</div>
