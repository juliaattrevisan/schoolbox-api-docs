{#
    Class Markbook report wrapper

    Usage:
        folder        \Schoolbox\Resource\Folder\Model - what folder is this markbook for?
        filterPanel   \Schoolbox\Filter\Panel          - which assessments are writable? indexed by assessment.id
#}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    ['Learning', '/learning/classes'],
    [folder.name, '/homepage/' ~ folder.id],
    ['Class Markbook']
) }}

<div class="row">
    <div class="small-12">
        <h1>Class Markbook for {{ folder.name }}</h1>
    </div>
</div>

{% set filterEventKey = 'MARKBOOK' %}

{% include '@filters/panel.twig' with {
    contentId: null,
    eventKey:  filterEventKey,
    panel:     filterPanel,
    quickload: false,
} only %}

<div id="markbook-outer-container" class="marksheet-wrapper row">
    <markbook-outer type='class' filter-event-key="{{ filterEventKey }}" />
</div>
<script src="{{ CDN_PREFIX }}/js/submissions/jquery.combobox.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/markbookOuter.js?v={{ config.site_version }}"></script>
