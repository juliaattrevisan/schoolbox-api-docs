<script type="text/javascript" src="/javascript/shared/submissions/jquery.marksheet.js"></script>
<script type="text/javascript" src="/javascript/shared/submissions/task/jquery.progressTickForm.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.ajax-form.js"></script>

{% import 'sub/breadcrumbs.twig' as bread %}
{# Crumbz: Class > Markbook #}
{{ bread.crumbs(['Learning', '/learning/classes'], ['Markbook']) }}

{% set reportContentId = 'report_content' %}

{% include '@filters/panel.twig' with {
    contentId: reportContentId,
    panel: filterPanel,
    quickload: true,
} only %}


<div id="{{ reportContentId }}"></div>

{% autoescape 'js' %}
<script type="text/javascript">
    $(function() {
        var $toast = $('[data-relation="submit-label"]');
        var $weightInput;
        $(document).on('change', '[data-weight]', function (e) {
            let data = {
                assessmentId: $(this).attr('data-assessment'),
                weight: $(this).val()
            }
            $weightInput = $(this);
            updateAssessment($(this).attr('name'), data);
        });

        $(document).on('change', '[data-visibility]', function (e) {
            let data = {
                assessmentId: $(this).attr('data-assessment'),
                visibility: $(this).val()
            }
            updateAssessment($(this).attr('name'), data);
        });

        function updateAssessment(property, data) {
            let path = '/learning/assessments/' + property + '/' + data['assessmentId'];
            $toast.toastActivate({text: 'Updating assessment...'});

            $.ajax({
                type: "POST",
                url: path,
                data: data,
                dataType: 'json',
            }).success(function (response) {
                if (typeof $weightInput !== 'undefined') {
                    $weightInput.removeClass('invalid-data');
                }
                $toast.toastTimeout({text: response.message, css: 'success'});
            }).error(function (response) {
                if (typeof $weightInput !== 'undefined') {
                    $weightInput.focus().addClass('invalid-data');
                }
                $toast.toastTimeout({
                    text: 'Failed to save weight',
                    css: 'alert'
                });
            });
        }

        $('#{{ reportContentId }}').on('filterContentLoaded', function() {
            // Use datatables to do fixed headers and left column
            // Only do this on small up
            var $windowWidthRems = $(window).width() / parseFloat($('html').css('font-size'));
            var options = {
                scrollY: '34em', // Fairly arbitrary height, catered to a 1080p screen
                scrollX: true,
                scrollCollapse: true,
                paging: false,
                bFilter: false,
                bInfo: false,
                ordering: false
            };

            // Use fixed columns on small
            if ($windowWidthRems >= 40) {
                options.fixedColumns = { leftColumns: 1 };
            }

            $('[data-mark-sheet]').DataTable(options);

            /* Controls for Averages and Dynamic updates for input fields
             */
            $('[data-mark-sheet]').marksheetAverages();

            // Formally disable setting of averages (they have been gone for a while)
            // $('[data-mark-sheet]').marksheetInputs();

            // Enable the download report menu
            // $('#report_actions').foundation();     // Seems like something else is handling this now, a listener higher up in the DOM delegating?
        }).progressTickForm({
            // Save form for task completion: apply only to report content,
            // allow content to handle save
            label: $('[data-save-progress-state]'),
            transitions: {
                incomplete:      'teacherAssessed',
                selfAssessed:    'teacherAssessed',
                teacherAssessed: 'incomplete'
            }
        });

        $(document).on('click', '#show-drafts', function () {
            if ($(this).prop("checked")) {
                $("[data-draft-mark]").show();
                $("[data-actual-mark]").hide();
            } else {
                $("[data-draft-mark]").hide();
                $("[data-actual-mark]").show();
            }
        });

    });
</script>
{% endautoescape %}
