{##
 # Participant Selector Carousel
 # Student Selector Carousel
 #
 # Cycle through students participating in an assessment
 #
 # @param array   $students          - an array of students to populate the selector, each item is directly passed into selectize
 # @param int     $selectedStudentId - the currently selected student's user ID
 #}

<script src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>

<div id="participant-carousel" class="row">
    <div class="small-12 medium-8 columns">
        <template id="participant-carousel-row-template">
            <div class="row" data-test="participant-carousel-row">
                <div class="card small-10">
                    <img data-template="avatar" src="__AVATAR_SRC__" alt="View Profile" />
                    <p data-template="fullName" data-test="participant-carousel-row-name">__FULL_NAME__</p>
                    <div data-template="status" class="label status" data-test="participant-carousel-row-status">__STATUS__</div>
                </div>
            </div>
        </template>
        <div class="avatar-switch">
            <nav>
                <a rel="prev" href="" title="" disabled></a>
            </nav>
            <div class="student">
                <select name="student-select"></select>
            </div>
            <nav>
                <a rel="next" href="" title="" disabled></a>
            </nav>
        </div>
    </div>
</div>

<script>
    $(function() {
        const carousel = document.getElementById('participant-carousel');
        const carouselRowTemplate = carousel.querySelector('#participant-carousel-row-template');
        const target = carousel.querySelector('select[name="student-select"]');
        const navPrev = carousel.querySelector('nav a[rel="prev"]');
        const navNext = carousel.querySelector('nav a[rel="next"]');

        /**
         * Retrieve the template for rendering an item
         * @param {object} item data for a specific participant
         * @returns {HTMLElement} filled in template
         */
        function getTemplate(item) {
            const template = carouselRowTemplate.cloneNode(true).content;

            template.querySelector('[data-template="avatar"]').src =
                item.user._links.avatar ?? `/portrait.php?id=${item.user.id}&size=square64`;
            template.querySelector('[data-template="fullName"]').textContent = item.user.fullName;

            /** convert between dialog agent status and status labels */
            const statusLabelClassMap = {
                'incomplete': 'unsubmitted',
                'in-progress': 'highlight',
                'locked': 'submitted-late',
                'requires-assistance': 'submitted',
                'submitted': 'reviewed',
            };

            template.querySelector('[data-template="status"]').innerText = item.statusLabel;
            template.querySelector('[data-template="status"]').classList.add(statusLabelClassMap[item.status]);

            return template.firstElementChild.outerHTML;
        }

        /**
         * Update a nav link based on an option
         * @param {HTMLElement} nav the nav link to update
         * @param {HTMLElement|null} source the option to get data from
         */
        function refreshNav(nav, source) {
            if (source === null) {
                nav.setAttribute('href', '#');
                nav.removeAttribute('title');
                nav.setAttribute('disabled', 'disabled');
                return;
            }

            nav.setAttribute('href', source.dataset.value);
            nav.setAttribute('title', source.querySelector('[data-template="fullName"]').textContent);
            nav.removeAttribute('disabled');
        }

        const students = {{ students|json_encode|raw }};
        $(target).selectize({
            preload: true,
            closeAfterSelect: false,
            options: students,
            render: {
                option: (item) => getTemplate(item),
                item: (item) => getTemplate(item),
            },
        });

        const ize = target.selectize;

        // hack, option not available
        $('.selectize-input input').prop('disabled', true).hide();

        // manually set the value, because selectize
        const currentStudent = students.find((student) => student.id.toString() === "{{ selectedStudentId }}");
        ize.setValue(currentStudent.value, true);

        // add the listener AFTER we've set the value
        $(target).on('change', function (e) {
            window.location.href = e.target.value;
        });

        // clear the selectize render cache
        ize.renderCache.option = {};
        ize.refreshOptions(false);

        const currentOption = ize.getOption(ize.getValue());
        refreshNav(navPrev, ize.getAdjacentOption(currentOption, -1)[0] ?? null);
        refreshNav(navNext, ize.getAdjacentOption(currentOption, 1)[0] ?? null);
    });
</script>
