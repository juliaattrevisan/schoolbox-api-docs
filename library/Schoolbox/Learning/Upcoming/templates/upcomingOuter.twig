{#
    Data:
        filterIdSlugMap        string[]     Maps filter ids to semantic slugs
        subjects               array        Classes/Groups the student is enrolled/member
        ...
#}
{% import '@learning/macro/urgency.twig' as urgency %}
{% set reportContentId = 'report_content' %}

{# Header #}
<div class="row">
    <div class="small-12 columns">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 column">
                    <h1>Upcoming Due Work for {{ student.formatName }}</h1>
                </div>
            </div>

            {% if children|length > 0 %}
                <nav>
                    <a class='icon-group' data-dropdown='header-options'></a>
                </nav>

                <ul id="header-options" class="f-dropdown" data-dropdown-content>
                    {% for child in children %}
                        <li>
                            <div class="card small-12">
                                <a href="{{ routeLookup('learningUpcoming.getUpcomingForStudent', {studentId: child.id, student: child}) }}" title="View upcoming Due Work">
                                    {% include 'include/portrait.twig' with {user: child, description: 'View upcoming ' ~ locale.assessment.properPlural} only %}
                                    <p>{{ child.formatName }}</p>
                                    <p class="meta">{{ child.role.name }}</p>
                                </a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</div>

{% include '@filters/panel.twig' with {
    contentId: reportContentId,
    panel:     filterPanel,
    quickload: true
} only %}

{% set reportContentId = 'report_content' %}

{% autoescape 'js' %}
    <script type="text/javascript">
        $(function () {
            // Filtered content has been [re]loaded
            // (Shouldn't this trigger contain the filters that are selected?)
            $('#{{ reportContentId }}').on('filterContentLoaded', function (event, selectedFilters) {
                // Pass the list of filters into upcoming-due-work-calendar.vue
                document.dispatchEvent(new CustomEvent('upcoming-due-work-calendar__onFilterChange', {
                    detail: {
                        selectedFilters
                    }
                }));
            });
        });

        window.fullCalendarConfig = {
            schedulerLicenseKey: '{{ config.fullcalendar_scheduler_license_key }}',
            eventLimit:         Boolean('{{ config.calendar_collapse_events }}'),
            firstDay:           Number('{{ config.calendar_start_day }}'),
            dateDisplayFormats: dateDisplayFormats,
            userId:             Number('{{ student.getId() }}')
        };
    </script>
{% endautoescape %}

<div class="row">
    <div class="small-12 island">
        <section>
            <div id="calendar">
                <upcoming-due-work-calendar />
            </div>
            <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/upcomingDueWorkCalendar.js?v={{ config.site_version }}"></script>
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-6 columns island">
        <h2 class="subheader">Upcoming Due Work</h2>
        <div id="{{ reportContentId }}"></div>
    </div>

    <div class="small-12 medium-6 columns">
        <h2 class="subheader">{{ locale.class.properPlural }}</h2>
        {% if subjects|length %}
            <div class="row">
                <div class="small-12 island">
                    {% for subject in subjects %}
                        <section>
                            <ul class="information-list">
                                <li>
                                    <div class="list-item">
                                        {% set gradePath = routeLookupIfAuthorized('learningGrades.getGradesForSubject', {viewee: student, userId: student.id, term: currentTerm, termCode: currentTerm.code, subject: subject.folder, subjectId: subject.folder.id}) %}
                                        <div class="small-{{ subject.grade ? 8 : 12 }} card">
                                            {% if gradePath %}
                                                <a href="{{ gradePath }}" title="View {{ locale.grades.properPlural }}">
                                                    <span class="icon-home size-32" title="{{ subject.folder.title }}"></span>
                                                    <p>{{ subject.folder.title }}</p>
                                                </a>
                                            {% else %}
                                                <span class="icon-home size-32" title="{{ subject.folder.title }}"></span>
                                                <p>{{ subject.folder.title }}</p>
                                            {% endif %}
                                            <p class="meta">{{ subject.folder.codeString }}</p>
                                        </div>

                                        {% if subject.grade %}
                                            <div class="small-4 columns no-pad">
                                                <div class="grade content">
                                                    {% if gradePath  %}
                                                        <a href="{{ gradePath }}">
                                                    <span class="{{ urgency.marks(subject.grade.meanNormalised) }}">
                                                        {{ subject.grade.weightedMean }}
                                                    </span>
                                                        </a>
                                                    {% else %}
                                                        <span class="{{ urgency.marks(subject.grade.meanNormalised) }}">
                                                    {{ subject.grade.weightedMean }}
                                                </span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>
                                </li>

                                {% for teacher in subject.teachers %}
                                    <li class="actions-small-1">
                                        <div class="list-item">
                                            <div class="small-12 card">
                                                <a href="/search/user/{{ teacher.id }}" title="">
                                                    {% include 'include/portrait.twig' with {user: teacher, description: teacher.fullName} only %}
                                                    <p>{{ teacher.formatName }}</p>
                                                </a>
                                                <p class="meta">{{ teacher.role.name }}</p>
                                            </div>

                                        </div>
                                        <nav>
                                            <a href="{{ mailHandle }}{{ teacher.email }}" class="icon-email" title="Email {{ teacher.formatName }}"></a>
                                        </nav>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <section>
                <div class="empty-state">
                    <i class="icon-due-work"></i>
                    <p>
                        {% if USER.id == student.id %}
                            You are not currently enrolled in any classes nor a member of any groups.
                        {% else %}
                            {{ student.formatName }} is not currently enrolled in any classes nor a member of any groups.
                        {% endif %}
                    </p>
                </div>
            </section>
        {% endif %}
    </div>
</div>

