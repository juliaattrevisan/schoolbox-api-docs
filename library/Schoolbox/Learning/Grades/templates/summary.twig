{# Usage:
    terms:      GenericCollection|Term\Model[]   - All terms known to system
    term:       Term\Model                       - Current visible term
    student:    User                             - The visible student
    folders:    GenericCollection|Folder\Model[] - Classes/Groups where the current student has responses or feedback for the current term
    markbooks:  GenericCollection|MarkBook[]     - Indexed by folder.id, each composed of the assessments for that folder and term
    mailHandle: string                           - Prefix for sending mail
#}

{% import '@learning/macro/urgency.twig' as urgency %}
{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(['Learning', routeLookup('learning.getClasses')], [locale.grades.properPlural]) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ locale.grades.properPlural }} for {{ term.title }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-5 island">
        <section>
            <ul class="action-list">
                <li>
                    <div class="small-12 card">
                        <a href="/search/user/{{ student.id }}" title="View Profile">
                            {% include 'include/portrait.twig' with {user: student, description: student.fullName} only %}
                            <p>{{ student.fullName }}</p>
                            <p class="meta">{{ student.year.longName ?? '' }} Student</p>
                        </a>
                    </div>
                </li>
            </ul>
        </section>
    </div>
    <div class="small-12 medium-7 columns">
        <div class="content">
            <div class="context-switch clearfix">
                {% include '@learningGrades/semesterSelector.twig' with {
                    terms:       terms,
                    currentTerm: term,
                    route:       'learningGrades.getGrades',
                    routeArgs:   {viewee: student, userId: student.id},

                    userId:      student.id,
                    yearUrl:     yearUrl,
                    year:        year
                } only %}

                {% include 'sub/subjectSelector.twig' with {
                    subjects:    folders,
                    route:       'learningGrades.getGradesForSubject',
                    routeArgs:   {viewee: student, userId: student.id, term: term, termCode: term.code},
                    year:        year
                } only %}
            </div>
        </div>
    </div>
</div>

{# Display subjects the student is involved in for the selected term #}

<div class="row">
    <div class="small-12 island">
        <section>
            {% for folder in folders %}
                <ul class="activity-list group">
                    <li class="subject-group">
                        {% if year is empty %}
                            <a href="{{ routeLookup('learningGrades.getGradesForSubject', {viewee: student, userId: student.id, term: term, termCode: term.code, subject: folder, subjectId: folder.id}) }}"
                               class="flex-grade link-row" title="View {{ locale.grades.properPlural }}">
                                {% include '@learningGrades/fragments/subject.twig' with {
                                    folder:              folder,
                                    studentGrade:        markbooks[folder.id].studentStatistics[student.id] ?? [],
                                } only %}
                            </a>
                        {% else %}
                            <h4 class="flex-grade">
                                {% include '@learningGrades/fragments/subject.twig' with {
                                    folder:              folder,
                                    studentGrade:        markbooks[folder.id].studentStatistics[student.id] ?? [],
                                } only %}
                            </h4>
                        {% endif %}
                    </li>
                    {% for teacher in folder.teachers %}
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="compact card small-12">
                                <a href="/search/user/{{ teacher.id }}" title="">
                                    {% include 'include/portrait.twig' with {user: teacher, description: teacher.fullName} only %}
                                    <p>{{ teacher.fullName }} <span class="pipe meta">Teacher</span></p>
                                </a>
                            </div>
                        </div>
                        <nav>
                            <a href="{{ mailHandle }}{{ teacher.email }}" class="icon-email" title="Mail"></a>
                        </nav>
                    </li>
                    {% endfor %}
                    {% if (assessmentTasks[folder.id] ?? [])| length %}
                    <li>
                        <ul class="activity-list">
                            {% for assessment in assessmentTasks[folder.id] %}
                                <li class="assessment">
                                    {% include '@learningGrades/fragments/assessmentGrade.twig' with {
                                        assessment:  assessment,
                                        student:     student,
                                    } only %}
                                </li>
                            {% endfor %}
                        </ul>
                    </li>
                    {% endif %}
                </ul>
            {% endfor %}
        </section>
    </div>
</div>



{% if folders | length == 0 %}

    <div class="row">
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>There are no {{ locale.grades.plural }} to view for this {{ locale.term }}.</p>
            </div>
        </div>
    </div>

{% endif %}
