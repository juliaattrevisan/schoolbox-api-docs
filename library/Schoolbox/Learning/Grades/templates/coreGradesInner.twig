{#
    Displays aggregate grade data for a set of assessments.

    Also renders the teacher + comment section for each student-involved folder selected in the filter panel.

    Usage:
        'student'                User
        'folders'                Folder[]         All folders available in filter panel
        'markbook'               Markbook         Filtered markbook
        'canSeeGraph'            bool
        'canSeeInstructorMarks'  bool
        'graph'                  array
        'returnUrlSuffix'        string
        'conversationsPerFolder' Conversation[]   Conversations of selected folders, indexed by folder.id
        'longitudinalRubric'     array TODO either define array structure, or upgrade to object
        'transitions'            array            Used by progressTickForm.
#}

<script type="text/javascript">
    $(function () {
        $('[data-collapser="true"]').collapsable({
            container: '[data-collapse-container]'
        });
    });
</script>
{% block graphs %}
{% if markbook.assessments | length and tabs | length %}
<div class="row">
    <div class="small-12 island">
        <dl class="tabs" data-tab>
            {% for key, data in tabs %}
                <dd {% if key == selectedTab %}class="active"{% endif %} >
                    <a href="#{{ key }}">{{ data.label }}</a>
                </dd>
            {% endfor %}
        </dl>
        <div class="tabs-content">
            {% for key, data in tabs %}
                {% if key == 'graph' %}
                    <div class="content {% if key == selectedTab %}active{% endif %}" id="{{ key }}">
                        {% include '@learningGrades/fragments/graph.twig' with {graph: graph, graphId: 'subject-graph'} only %}
                    </div>
                {% else %}
                    <div class="content {% if key == selectedTab %}active{% endif %}" id="{{ key }}">
                        {% include '@learningGrades/fragments/'~ key ~'.twig' with {
                            longitudinalRubric:     longitudinalRubric,
                            rubricAssessmentList:   rubricAssessmentList,
                            student:                student,
                            assessments:            markbook.assessments,
                            showRubricPoints:       showRubricPoints,
                            returnUrlSuffix:        returnUrlSuffix
                        } only %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
{% if markbook.assessments | length %}
<script type="text/javascript">
    window.sbProps.injectScriptsIfNotLoaded({
        srcList: ["{{ CDN_PREFIX }}/js/submissions/task/jquery.progressTickForm.js?v={{ config.site_version }}"],
        onComplete: () => {
            // Save form for task completion
            $('form[data-progress-tick-form]').progressTickForm({
                transitions: {
                    incomplete:      '{{ transitions['incomplete'] }}',
                    selfAssessed:    '{{ transitions['selfAssessed'] }}',
                    teacherAssessed: '{{ transitions['teacherAssessed'] }}'
                }
            });
        }
    });
</script>
<div class="row">
    <div class="small-12 island">
        <section>
            <script type="text/javascript">
                $(function () {
                    $('[data-collapser]').collapsable();
                    // As this can be loaded asynchonously, we need to reinitialise any media players inside the report
                    $.fn.schoolboxResource_ProxyReplacement('.activity-list');
                });
            </script>

            {% for unit in tree %}
            <ul class="activity-list expandable-card">
                <li>
                    <div class="unit">
                        <div class="expander icon-up-arrow" data-collapser="unit-{{ unit.context.id }}"></div>
                        <div class="small-12 card">
                            <a href="/homepage/{{ unit.context.specification.folder.id ?? unit.context.folder.id }}" title="{{ unit.context.title }}">
                                <h3>{{ unit.context.title }}</h3>
                            </a>
                        </div>
                    </div>
                    <div data-collapse-state="" data-collapsable="unit-{{ unit.context.id }}">
                        <ul>
                            {% for assessment in unit.assessments %}
                                {% if assessment.assessments is defined and assessment.assessments | length %}
                                <li class="project">
                                    {% include '@learningGrades/fragments/assessmentGrade.twig' with {
                                        assessment:  assessment.assessment,
                                        student:     student,
                                        canViewInstructorMarks: canViewInstructorMarks
                                    } only %}
                                    <ul>
                                        {% for projectAssessment in assessment.assessments %}
                                        <li class="assessment">
                                            {% include '@learningGrades/fragments/assessmentGrade.twig' with {
                                                assessment:  projectAssessment,
                                                student:     student,
                                                canViewInstructorMarks: canViewInstructorMarks
                                            } only %}
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </li>
                                {% else %}
                                <li class="assessment">
                                    {% include '@learningGrades/fragments/assessmentGrade.twig' with {
                                        assessment:  assessment.assessment,
                                        student:     student,
                                        canViewInstructorMarks: canViewInstructorMarks
                                    } only %}
                                </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </li>
            </ul>
            {% endfor %}
        </section>
    </div>
</div>
{% else %}
<div class="row">
    <div class="small-12 island">
        <div class="empty-state">
            <sbx-icon name="due-work" size="2.5rem"></sbx-icon>
            <p>No activities match your filter selections.</p>
        </div>
    </div>
</div>
{% endif %}
