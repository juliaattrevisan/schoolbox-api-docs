{#
CUSTOM Generic Term (aka Semester) selector for Peninsula (duplicated from Btac custom work)

Usage: include 'sub/semesterSelector.twig
    currentTerm: null|Term               - (optional) the current selected Term
    terms:       Collection|Term[]       - all Terms to render in dropdown
    termRoute:   string                  - Aura route
    routeArgs:   JSON object             - Aura route args to be merged with {Term.code} inside loop
    year:        null|int                - (optional) If viewing an entire year of results
#}

<script type="text/javascript">
    $(function() {
        let $semesterSelector = $('#context-selector-semester');

        {# Wire up context selector #}
        $semesterSelector.change(function () {
            window.location.href = $semesterSelector.find(':selected').data('href');
        });

        if ($semesterSelector.children().length <= 1) {
            {# Disable next/previous term buttons #}
            $('[data-semester-switch]').addClass('disabled');
        } else {
            {# Wire up next/previous term buttons #}
            $("[data-semester-switch]").on('click', function (e) {
                e.preventDefault();

                let $options = $semesterSelector.children();
                let index    = $semesterSelector.prop('selectedIndex');
                let newIndex = index + (('next' === $(this).data('semester-switch')) ? -1 : +1);

                if (newIndex >= 1 && newIndex < $options.length) {
                    let term = $options.eq(newIndex);
                    window.location.href = term.data('href');
                }

                disableNavsIfNecessary();
            });

            disableNavsIfNecessary();
        }
    });

    function disableNavsIfNecessary() {
        let $selector   = $('#context-selector-semester');
        let $prevButton = $('[data-semester-switch=previous]').removeClass('disabled');
        let $nextButton = $('[data-semester-switch=next]').removeClass('disabled');
        let $options    = $selector.children();

        if ($selector.val() == $($options[$options.length - 1]).val()) {
            $prevButton.addClass('disabled');
        }

        if ($selector.val() == $($options[1]).val()) { // 1 not 0 because of instruction option.
            $nextButton.addClass('disabled');
        }
    }
</script>

<nav><a data-semester-switch="previous" href="#"></a></nav>
<div class="semester">
    <select id="context-selector-semester" title="Select {{ locale.term.indefiniteArticle ~ ' ' ~ locale.term }}{% if year is not empty %}/Year{% endif %}">
        <option disabled {% if currentTerm is empty %}selected{% endif %} label="Select {{ locale.term.indefiniteArticle ~ ' ' ~ locale.term }}{% if year is not empty %}/year{% endif %}">Select {{ locale.term.indefiniteArticle ~ ' ' ~ locale.term }}{% if year is not empty %}/year{% endif %}</option>
        {% set foundYear = {} %}
        {% set selected = false %}
        {% for term in terms %}
            {% if yearUrl %}
                {% set startYear = term.start.startOfSchoolYear.year %}
                {% if foundYear['_'~startYear] is not defined or not foundYear['_'~startYear] %}
                    {% set foundYear = foundYear | merge({('_'~startYear):true}) %}
                    <option data-href="{{ routeLookup('learningGrades.getGradesYear', routeArgs | merge({year: startYear}) ) }}" value="{{ startYear }}" {% if year == startYear %}{% set selected = true %}selected{% endif %}>
                        {#- dessicate -#}{{ term.start.schoolYear }} Grades Summary{#- dessicate -#}
                    </option>
                {% endif %}
            {% endif %}
            <option data-href="{{ routeLookup(route, routeArgs|merge({termCode: term.code})) }}" value="{{ term.code }}" {% if currentTerm.code == term.code and not selected %}{% set selected = true %}selected{% endif %}>
                {#- dessicate -#}{{ term.title }} ({{ term.start.dateOnly }} - {{ term.displayFinish.dateOnly }}){#- dessicate -#}
            </option>
        {% endfor %}
        {% if not selected and year %}
            {#
             # An extra option is added here to cover the case where there are no terms in the schoolbox.terms database table
             # matching the requested year.  No results will be shown in this case.  We add the extra option to avoid the
             # situation where the user requests a year and then a different year or term is selected when the page loads.
             # Specify in the URL a year in the far future to see the extra option.
             #
             # If you leave data-href undefined, the string "undefined" is appended literally to the
             # current url, sending you to /learning/grades-year/25/year/undefined, so we force this
             # to have an href like its kindred
             #}
            <option data-href="{{ routeLookup('learningGrades.getGradesYear', routeArgs | merge({year: year}) ) }}" selected>{{ year }} Grades Summary</option>
        {% endif %}
    </select>
</div>
<nav><a data-semester-switch="next" href="#"></a></nav>
