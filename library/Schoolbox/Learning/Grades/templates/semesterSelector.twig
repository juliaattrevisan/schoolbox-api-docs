{#
CUSTOM Generic Term (aka Semester) selector for Peninsula (duplicated from Btac custom work)

Usage: include 'sub/semesterSelector.twig
    currentTerm: null|Term               - (optional) the current selected Term
    terms:       Collection|Term[]       - all Terms to render in dropdown
    termRoute:   string                  - Aura route
    routeArgs:   JSON object             - Aura route args to be merged with {Term.code} inside loop
    year:        null|int                - (optional) If viewing an entire year of results
#}

<script type="text/javascript">
    $(function() {

        var $semesterSelector = $('#context-selector-semester');
        var $options = $semesterSelector.find('option');

        {# Wire up context selector #}

        $semesterSelector.change(function () {
            window.location.href = $semesterSelector.find(':selected').data('href');
        });

        {# Wire up next/previous term buttons #}

        $("[data-semester-switch]").click(function (e) {
            e.preventDefault();

            var index = $semesterSelector.prop('selectedIndex');
            var newIndex = 'next' === $(this).data('semester-switch') ? index - 1 : index + 1;

            if (newIndex >= 1 && newIndex < $options.length){
                var term = $options.eq(newIndex);
                window.location.href = term.data('href');
            }
        });
    });
</script>

<nav>
    {% if year is not empty %}
        <a data-semester-switch="previous" href="#"></a>
    {% else %}
        {% if terms and terms|length %}
            <a data-semester-switch="previous" href="#" {% if currentTerm.code == terms[terms | length - 1].code %}disabled{% endif %}></a>
        {% endif %}
    {% endif %}
</nav>
<div class="semester">
    <select id="context-selector-semester" title="Select {{ locale.term.indefiniteArticle ~ ' ' ~ locale.term }}{% if year is not empty %}/Year{% endif %}">
        <option disabled {% if currentTerm is empty %}selected{% endif %} label="Select {{ locale.term.indefiniteArticle ~ ' ' ~ locale.term }}{% if year is not empty %}/year{% endif %}">Select {{ locale.term.indefiniteArticle ~ ' ' ~ locale.term }}{% if year is not empty %}/year{% endif %}</option>
        {% set foundYear = {} %}
        {% set selected = false %}
        {% for term in terms %}
            {% if yearUrl %}
                {% if not term.displayFinish.isNull() %}
                    {% if foundYear['_'~term.displayFinish.year] is not defined or not foundYear['_'~term.displayFinish.year] %}
                        {% set foundYear = foundYear | merge({('_'~term.displayFinish.year):true}) %}
                        <option data-href="{{ routeLookup('learningGrades.getGradesYear', routeArgs | merge({year: term.displayFinish.year}) ) }}" value="{{ term.displayFinish.year }}" {% if year == term.displayFinish.year %}{% set selected = true %}selected{% endif %}>
                            {#- dessicate -#}{{ term.displayFinish.year }} Grades Summary{#- dessicate -#}
                        </option>
                    {% endif %}
                {% endif %}
            {% endif %}
            <option data-href="{{ routeLookup(route, routeArgs|merge({termCode: term.code})) }}" value="{{ term.code }}" {% if currentTerm.code == term.code and not selected %}{% set selected = true %}selected{% endif %}>
                {#- dessicate -#}{{ term.title }} ({{ term.start.dateOnly }} - {{ term.displayFinish.dateOnly }}){#- dessicate -#}
            </option>
        {% endfor %}
        {% if not selected %}
            {# This is to cover the case where there are no terms in the schoolbox.terms database table matching the requested year. #}
            <option selected>{{ year }} Grades Summary</option>
        {% endif %}
    </select>
</div>
<nav>
    {% if year is not empty %}
        <a data-semester-switch="next" href="#"></a>
    {% else %}
        {% if terms and terms|length %}
            <a data-semester-switch="next" href="#" {% if currentTerm.code == (terms|first).code %}disabled{% endif %}></a>
        {% endif %}
    {% endif %}
</nav>
