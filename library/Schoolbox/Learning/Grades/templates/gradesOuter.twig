{#
    Render the outside of the filterable Grades report page, into which we will AJAX a filtered Grade Report.

    Usage:
        'student'                User                Student whose grades we are viewing
        'filterPanel'            Filter\Panel
        'term'                   Term\Model          Currently-displayed term model
        'terms'                  Term\Model[]        All term models known to system
        'subject'                Folder\Model        Currently-displayed folder
        'folders'                Folder\Model[]      All folders where this student has interactions for current term
        'markbook'               Markbook            Unfiltered markbook for student, term + folder
        'conversation'           Conversation
#}
{% import 'sub/breadcrumbs.twig' as bread %}
{% import '@learning/macro/urgency.twig' as urgency %}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/jquery.all-work.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/highchartsMore.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/reportCardBoxplot.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/learninganalytics/schoolboxTheme.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/eportfolio/jquery.eportfolio.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function () {
        // Set up comment abilities: post
        $.fn.allWork.commentSetup({
            data: {
                studentId: '{{ student.id }}',
                folderId: '{{ subject.id }}'
            }
        });
        $('[data-print]').click(function () {
            window.print();
            $('#container').highcharts().reflow();
        });
    });
</script>

{# Crumbs: Learning > Grades > {subject.name} #}

{{ bread.crumbs(['Learning', '/learning/classes'], [locale.grades.properPlural, routeLookup('learningGrades.getGrades', {userId: student.id, termCode: term.code})], [subject.name]) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ locale.grades.properPlural }} for {{ subject.name }} - {{ student.fullName }}</h1>

        {% if subject.teachers|length %}
        <ul class="meta">
            <li class="icon-teacher">Teacher(s): {% for teacher in subject.teachers %}<a href="/search/user/{{ teacher.id }}" title="View Profile">{{ teacher.fullName }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</li>
        </ul>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="small-12 medium-6 columns">
        <h2 class="subheader">Time Period</h2>
        <div class="content">
            <div class="context-switch clearfix">
                {% include '@learningGrades/semesterSelector.twig' with {
                    currentTerm: term,
                    terms:       terms,
                    route:       'learningGrades.getGradesForSubject',
                    routeArgs:   {userId: student.id, subjectId: subject.id},
                    yearUrl:     yearUrl,
                    year:        year is defined ? year : null
                } only %}
                {% include 'sub/subjectSelector.twig' with {
                    currentSubject: subject,
                    subjects:       folders,
                    route:         'learningGrades.getGradesForSubject',
                    routeArgs:      {userId: student.id, termCode: term.code},
                    year:        year is defined ? year : null
                } only %}
            </div>
        </div>
    </div>
    {% if markbook.studentStatistics[student.id] is defined and markbook.studentStatistics[student.id].weightedMean is not null %}
    <div class="small-12 medium-3 xlarge-2 right">
        <h2 class="subheader">{{ locale.grades.proper }} Average</h2>
        <div class="grade {{ urgency.marks(markbook.studentStatistics[student.id].meanNormalised) }}-bg text-center">
            {% set weightedMean = markbook.studentStatistics[student.id].weightedMean %}
            <span>{% if weightedMean is null %}<span class="meta">-</span>{% else %}{{ weightedMean }}{% endif %}</span>
        </div>
    </div>
    {% endif %}
</div>

{% if markbook.assessments | length %}

    {% set reportContentId = 'report_content' %}

    {% include '@filters/panel.twig' with {
        contentId: reportContentId,
        panel: filterPanel,
        quickload: false,
    } only %}


    <div id="{{ reportContentId }}"></div>

    {% set comments   = conversation.getVisibleComments(USER) %}
    {% set canComment = conversation.canComment(USER) %}

    {% if comments|length or canComment %}
        <div class="row">
            <div class="small-12 columns">
                <h2 class="subheader">Comments</h2>
            </div>

            {% if canComment %}
            <div class="small-12 island">
                <form id="create-comment" data-comment-form action="/ajax/comment.php" method="post">
                    <section class="content">
                        <input type="hidden" name="studentId" value="{{ student.id }}"/>
                        <input type="hidden" name="categoryId" value="{{ subject.id }}"/>
                        <textarea name="comment" rows="3"></textarea>
                        <div class="row">
                            {% if USER.role.isStaff %}
                                <div class="small-3 medium-3 column">
                                    <input id="vis-student" type="checkbox" name="visibility[student]" value="1" />
                                    <label for="vis-student" class="checkbox-label">Visible To Student</label>
                                </div>
                                <div class="small-3 medium-3 column">
                                    <input id="vis-parent" type="checkbox" name="visibility[parent]" value="1" checked />
                                    <label for="vis-parent" class="checkbox-label">Visible To Parents</label>
                                </div>
                            {% elseif USER.role.isStudent %}
                                <div class="small-3 medium-3 column">
                                    <input id="vis-parent" type="checkbox" name="visibility[parent]" value="1" checked />
                                    <label for="vis-parent" class="checkbox-label">Visible To Parents</label>
                                </div>
                            {% elseif USER.role.isParent %}
                                <div class="small-3 medium-3 column">
                                    <input id="vis-student" type="checkbox" name="visibility[student]" value="1" />
                                    <label for="vis-student" class="checkbox-label">Visible To Student</label>
                                </div>
                            {% endif %}
                        </div>
                    </section>
                    <a class="button submit" data-comment-post="new">Post comment</a>
                </form>
            </div>
            {% endif %}
            <div class="small-12 island">
                <section class="discussion">
                    <ul class="information-list" data-comment-list>
                        {% for comment in comments %}
                            {% set isCommenter = comment.commenter.id == USER.id  %}
                            <li class="actions-small-2" data-id="{{ comment.id }}">
                                <div class="list-item">
                                    <div class="card compact small-10">
                                        {% if comment.commenter.deleted %}
                                            <p>{{ comment.commenter.fullName }}</p>
                                        {% else %}
                                            <a href="/search/user/{{ comment.commenter.id }}" title="View Profile">
                                                <img src="/portrait.php?id={{ comment.commenter.id }}&size=square64" alt="{{ comment.commenter.fullName }}"/>
                                                <p>
                                                    {{ comment.commenter.fullName }}
                                                    <span class="pipe meta">{{ comment.commenter.role.name ?? '' }}</span>
                                                    <span class="pipe meta"><time title="{{ comment.createdAt.long }}">{{ comment.createdAt.relativeTime }}</time></span>
                                                </p>
                                            </a>
                                        {% endif %}
                                    </div>
                                    <div class="small-2 column content">
                                        <span class="icon-staff-students {% if comment.studentVisibility %}on{% else %}off{% endif %}"
                                              title="{% if comment.studentVisibility %}Visible to {% else %}Hidden from {% endif %}student"></span>
                                        <span class="icon-staff {% if comment.parentVisibility %}on{% else %}off{% endif %}"
                                              title="{% if comment.parentVisibility %}Visible to {% else %}Hidden from {% endif %}parents"></span>
                                    </div>
                                </div>
                                <nav>
                                    {% if isCommenter %}
                                        <a class="icon-delete" title="Delete" data-comment-delete></a>
                                        <a class="icon-modify" title="Modify" data-comment-modify></a>
                                    {% endif %}
                                </nav>
                                <article>
                                    <p>
                                        {{ comment.body | linkify | nl2br }}
                                    </p>
                                </article>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            </div>
        </div>
    {% endif %}

{% else %}

    <div class="row">
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>There are no {{ locale.grades.plural }} available for {{ subject.name }} for this {{ locale.term }}.</p>
            </div>
        </div>
    </div>

{% endif %}
