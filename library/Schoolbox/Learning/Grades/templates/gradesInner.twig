{#
    Displays aggregate grade data for a set of assessments.

    Also renders the teacher + comment section for each student-involved folder selected in the filter panel.

    Usage:
        'student'                User
        'folders'                Folder[]         All folders available in filter panel
        'markbook'               Markbook         Filtered markbook
        'canSeeGraph'            bool
        'graph'                  array
        'returnUrlSuffix'        string
        'conversationsPerFolder' Conversation[]   Conversations of selected folders, indexed by folder.id
        'longitudinalRubric'     array TODO either define array structure, or upgrade to object
#}

{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learning/macro/dueDate.twig' as dueDate %}

<script type="text/javascript">
    $(function () {
        $('[data-collapser="true"]').collapsable({
            container: '[data-collapse-container]'
        });
    });
</script>
{% if markbook.assessments | length %}
<div class="row">
    <div class="small-12 island">
        <dl class="tabs" data-tab>
            {% for key, data in tabs %}
                <dd {% if key == selectedTab %}class="active"{% endif %} >
                    <a href="#{{ key }}">{{ data.label }}</a>
                </dd>
            {% endfor %}
        </dl>
        <div class="tabs-content">
            {% for key, data in tabs %}
                {% if key == 'graph' %}
                    <div class="content {% if key == selectedTab %}active{% endif %}" id="{{ key }}">
                        {% include '@learningGrades/fragments/graph.twig' with {graph: graph} only %}
                    </div>
                {% else %}
                    <div class="content {% if key == selectedTab %}active{% endif %}" id="{{ key }}">
                        {% include '@learningGrades/fragments/'~ key ~'.twig' with {
                            longitudinalRubric:     longitudinalRubric,
                            rubricAssessmentList:   rubricAssessmentList,
                            student:                student,
                            assessments:            markbook.assessments,
                            returnUrlSuffix:        returnUrlSuffix
                        } only %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>

    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">Activities</h2>
            <section>
                <ul class="action-list">
                    {% for assessment in markbook.assessments %}
                        {% set participant = assessment.participantIfExtant(student) %}
                        {% if participant %}
                            {% set folder = assessment.baseContext.folder %}
                            <li class="actions-small-1">
                                <div class="list-item content">
                                    <div class="row">
                                        <div class="small-12 large-6 card column xl">
                                            {% set summaryRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {assessmentId: assessment.id, assessment: assessment, studentId: student.id, student: student}) %}

                                            {% if summaryRoute %}
                                            <a href="{{ summaryRoute }}{{ returnUrlSuffix }}">
                                                <h3>{{ assessment.title }}</h3>
                                            </a>
                                            {% else %}
                                                <h3>{{ assessment.title }}</h3>
                                            {% endif %}

                                            <p>
                                                <span class="meta">{{ assessment.typeName }}</span><span
                                                        class="pipe meta">{{ dueDate.dueDate(assessment, student) }}</span>
                                            </p>
                                            {% include '@learningAssessment/fragments/statusLine.twig' with { assessable: assessment, student: student} only %}
                                        </div>

                                        <div class="small-12 large-6 columns">
                                            {% if assessment.isFeedbackVisibleToUser(USER) %}
                                                {% set feedback = participant.findAuthoritativeVisibleFeedback(USER) %}

                                                {% if assessment is task %}
                                                    {% include '@learningAssessment/fragments/progressTick.twig' with {
                                                    assessment: assessable,
                                                    student: participant.user
                                                    } only %}
                                                {% else %}
                                                    <div class="grade {{ urgency.marks(assessment.normalisedMark(participant, true)) }}">
                                                        <span>{{ assessment.humanReadableMark(participant, true) }}</span>
                                                    </div>
                                                {% endif %}
                                                {% if feedback %}
                                                    <p class="comment">{{ feedback.comment | nl2br }}</p>
                                                    {% if (assessment.useRubric or feedback.allFiles | length) and summaryRoute %}
                                                        <a href="{{ summaryRoute }}{{ returnUrlSuffix }}">
                                                            View more feedback</a>
                                                    {% endif %}
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                <nav>
                                    {% if assessment is quiz and participant.allResponses | length %}
                                        <a class="icon-view"
                                           href="{{ routeLookup('learningQuiz.getQuizAttemptsByUser', {assessmentId: assessment.id, userId: student.id}) }}"
                                           title="View Attempts"></a>
                                    {% endif %}
                                    {% if assessment is dueWork and feedback and student.eportfolioEnable %}
                                        {% if canSeeShowcaseButton %}
                                            <a class="icon-showcase" data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0"
                                               title="Publish to ePortfolio"></a>
                                            <form action="/eportfolio/showcase/modifyForm.php" method="post"
                                                  data-publish-to-eportfolio-form="{{ assessment.id }}">
                                                <input type="hidden" name="action" value="publish">
                                                <input type="hidden" name="userId" value="{{ student.id }}">
                                                <input type="hidden" name="assessmentId" value="{{ assessment.id }}">
                                            </form>
                                            <script type="text/javascript">
                                                $(function () {
                                                    {# Publish to ePortfolio #}
                                                    $('[data-publish-to-eportfolio]').click(function (event) {
                                                        event.preventDefault();

                                                        var assessmentId = $(this).data('publishToEportfolio');

                                                        $(this).confirmDialog({
                                                            header: "Publish to ePortfolio Showcase",
                                                            text: 'Are you sure you want to publish this work to your ePortfolio showcase? This will make the work visible to everyone.',
                                                            confirmEvent: function () {
                                                                $('[data-publish-to-eportfolio-form="' + assessmentId + '"]').eportfolio_publish({
                                                                    activator: '[data-publish-to-eportfolio="' + assessmentId + '"]'
                                                                });
                                                            }
                                                        });
                                                    });
                                                });
                                            </script>
                                        {% endif %}
                                    {% endif %}
                                </nav>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
                <div class="toast" data-alert="" id="publish-to-eportfolio-label"></div>
            </section>
        </div>
    </div>
{% else %}

    <div class="row">
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>No activities match your filter selections.</p>
            </div>
        </div>
    </div>

{% endif %}

