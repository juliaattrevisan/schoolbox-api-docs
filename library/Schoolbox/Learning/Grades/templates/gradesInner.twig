{#
    Displays aggregate grade data for a set of assessments.

    Also renders the teacher + comment section for each student-involved folder selected in the filter panel.

    Usage:
        'student'                User
        'folders'                Folder[]         All folders available in filter panel
        'markbook'               Markbook         Filtered markbook
        'canSeeGraph'            bool
        'graph'                  array
        'returnUrlSuffix'        string
        'conversationsPerFolder' Conversation[]   Conversations of selected folders, indexed by folder.id
        'longitudinalRubric'     array TODO either define array structure, or upgrade to object
#}

<script type="text/javascript">
    $(function () {
        $('[data-collapser="true"]').collapsable({
            container: '[data-collapse-container]'
        });
    });
</script>
{% if markbook.assessments | length %}
<div class="row">
    <div class="small-12 island">
        <dl class="tabs" data-tab>
            {% for key, data in tabs %}
                <dd {% if key == selectedTab %}class="active"{% endif %} >
                    <a href="#{{ key }}">{{ data.label }}</a>
                </dd>
            {% endfor %}
        </dl>
        <div class="tabs-content">
            {% for key, data in tabs %}
                {% if key == 'graph' %}
                    <div class="content {% if key == selectedTab %}active{% endif %}" id="{{ key }}">
                        {% include '@learningGrades/fragments/graph.twig' with {graph: graph} only %}
                    </div>
                {% else %}
                    <div class="content {% if key == selectedTab %}active{% endif %}" id="{{ key }}">
                        {% include '@learningGrades/fragments/'~ key ~'.twig' with {
                            longitudinalRubric:     longitudinalRubric,
                            rubricAssessmentList:   rubricAssessmentList,
                            student:                student,
                            assessments:            markbook.assessments,
                            returnUrlSuffix:        returnUrlSuffix
                        } only %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Activities</h2>
        <section>
            <script type="text/javascript">
                $(function () {
                    $('[data-collapser]').collapsable();
                });
            </script>

            {% for unit in tree %}
            <ul class="activity-list expandable-card">
                <li>
                    <div class="unit">
                        <div class="expander" data-collapser="unit-{{ unit.context.id }}"></div>
                        <div class="small-12 card">
                            <a href="/homepage/{{ unit.context.specification.folder.id ?? unit.context.folder.id }}" title="{{ unit.context.title }}">
                                <h3>{{ unit.context.title }}</h3>
                            </a>
                        </div>
                    </div>
                    <div data-collapse-state="" data-collapsable="unit-{{ unit.context.id }}">
                        <ul>
                            {% for assessment in unit.assessments %}
                                {% if assessment.assessments | length %}
                                <li class="project">
                                    {% include '@learningGrades/fragments/assessmentGrade.twig' with {assessment: assessment.assessment, participant: assessment.assessment.participantIfExtant(student)} only %}
                                    <ul>
                                        {% for projectAssessment in assessment.assessments %}
                                        <li class="assessment">
                                            {% include '@learningGrades/fragments/assessmentGrade.twig' with {assessment: projectAssessment, participant: projectAssessment.participantIfExtant(student)} only %}
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </li>
                                {% else %}
                                <li class="assessment">
                                    {% include '@learningGrades/fragments/assessmentGrade.twig' with {assessment: assessment.assessment, participant: assessment.assessment.participantIfExtant(student)} only %}
                                </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </li>
            </ul>
            {% endfor %}
            <div class="toast" data-alert="" id="publish-to-eportfolio-label"></div>
        </section>
    </div>
</div>
{% else %}
<div class="row">
    <div class="small-12 island">
        <div class="empty-state">
            <i class="icon-due-work"></i>
            <p>No activities match your filter selections.</p>
        </div>
    </div>
</div>
{% endif %}

