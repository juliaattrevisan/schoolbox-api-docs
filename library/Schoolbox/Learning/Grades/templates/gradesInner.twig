{#
    Displays aggregate grade data for a set of assessments.

    Also renders the teacher + comment section for each student-involved folder selected in the filter panel.

    Usage:
        'student'                User
        'canSeeGradeAverage'     bool
        'folders'                Folder[]         All folders available in filter panel
        'aggregateMarkbook'      Markbook         Markbook made up of assessments that match filters
        'canSeeGraph'            bool
        'graph'                  array
        'returnUrlSuffix'        string
        'conversationsPerFolder' Conversation[]   Conversations of selected folders, indexed by folder.id
        'longitudinalRubric'     TODO
#}

{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learning/macro/dueDate.twig' as dueDate %}

<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts-more.js"></script>
<script type="text/javascript" src="/javascript/shared/submissions/reportCardBoxplot.js"></script>
<script type="text/javascript" src="/javascript/shared/submissions/jquery.all-work.js"></script>
<script type="text/javascript" src="/learninganalytics/js/schoolboxTheme.js"></script>
<script type="text/javascript" src="/javascript/shared/eportfolio/jquery.eportfolio.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.toast-timeout.js"></script>
<script type="text/javascript">
    $(function () {
        $('[data-collapser="true"]').collapsable({
            container: '[data-collapse-container]'
        });


        $('[data-teacher-comment-selector]').on('change', function(){
            var folderId = $(this).find(':selected').val();
            $('[data-teacher-comments]').hide();
            $('[data-teacher-comments=' + folderId + ']').show();
        });

        /* Set up comment abilities: post
         */
        $.fn.allWork.commentSetup({
            data: {
                studentId: '{{ student.id }}',
                folderId: '{{ subject.id }}'
            }
        });
    });
</script>

<div class="row">
    <div class="small-12 large-6 island">
        <section>
            <ul class="action-list">
                <li>
                    <div class="small-12 card">
                        <a href="/search/user/{{ student.id }}" title="View Profile">
                            <img src="/portrait.php?userId={{ student.externalId }}&size=square64" alt="{{ student.fullName }}"/>
                            <p>{{ student.fullName }}</p>
                            <p class="meta">Year {{ student.year }} Student</p>
                        </a>
                    </div>
                </li>
            </ul>
        </section>
    </div>
    {% if canSeeGradeAverage %}
        <div class="small-12 large-6 island">
            <section class="content">
                {# TODO remove inline styles #}
                <h2 class="subheader" style="display:inline-block;">{{ locale.grades.proper }} Average</h2>
                <div style="display:inline-block;" class="grade {{ urgency.marks(aggregateMarkbook.studentStatistics[student.id].meanNormalised) }}">
                    <span>{{ aggregateMarkbook.studentStatistics[student.id].weightedMean }}</span>
                </div>
            </section>
        </div>
    {% endif %}
</div>

{% if aggregateMarkbook.assessments | length %}

    {% if canSeeGraph %}
        {% include '@learningGrades/fragments/graph.twig' with {graph: graph} only %}
    {% endif %}

    {% if longitudinalRubric %}
        {% include '@learningGrades/fragments/longitudinalRubric.twig' with {
            longitudinalRubric: longitudinalRubric,
            student:            student,
            markbook:           aggregateMarkbook,
            returnUrlSuffix:    returnUrlSuffix
        } only %}
    {% endif %}

    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">Assessments</h2>
            <section>
                <ul class="action-list">
                    {% for assessment in aggregateMarkbook.assessments %}
                        {% set participant = assessment.participantIfExtant(student) %}
                        {% if participant %}
                            {% set folder = assessment.baseContext.folder %}
                            <li class="actions-small-2">
                                <div class="list-item clearfix content">
                                    <div class="row">
                                        <div class="small-12 large-5 card column xl">
                                            <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: assessment.id, studentId: student.id}) }}{{ returnUrlSuffix }}">
                                                <h3>{{ assessment.title }}</h3>
                                            </a>
                                            <p class="meta">
                                                <a href="/homepage/{{ folder.id }}">{{ folder.name }}</a> {{ assessment.typeName }}
                                            </p>
                                        </div>

                                        <div class="small-12 large-4 columns grade">
                                            {% set feedback = participant.findMostRecentVisibleFeedback(USER) %}
                                            {% if feedback %}
                                                <div class="{{ urgency.marks(feedback.normalisedMark) }}"><span>{{ feedback.humanReadableMark }}</span></div>
                                                <p class="comment">{{ feedback.comment | nl2br  }}</p>
                                            {% endif %}
                                        </div>

                                        <div class="small-12 large-3 columns">
                                            {{ dueDate.dueDate(assessment, student) }}
                                        </div>
                                    </div>
                                </div>

                                <nav>
                                    {% if assessment is quiz and participant.allResponses | length %}
                                        <a class="icon-view" href="{{ routeLookup('learningQuiz.getQuizAttemptsByUser', {assessmentId: assessment.id, userId: student.id}) }}" title="View Attempts"></a>
                                    {% endif %}
                                    {% if assessment.getFamilyName == 'dueWork' and feedback %}
                                        {# TODO convert this to AJAX #}
                                        <a class="icon-showcase" title="Publish to ePortfolio" data-publish-to-eportfolio="{{ assessment.id }}" data-publish-status="0"></a>
                                        <form action="/eportfolio/showcase/modifyForm.php" method="post" data-publish-to-eportfolio-form="{{ assessment.id }}">
                                            <input type="hidden" name="action" value="publish">
                                            <input type="hidden" name="userId" value="{{ student.id }}">
                                            <input type="hidden" name="assessmentId" value="{{ assessment.id }}">
                                        </form>
                                        <script type="text/javascript">
                                            $(function() {
                                                {# Publish to ePortfolio #}
                                                $('[data-publish-to-eportfolio-form="{{ assessment.id }}"]').eportfolio_publish({
                                                    activator: '[data-publish-to-eportfolio="{{ assessment.id }}"]'
                                                });
                                            });
                                        </script>
                                    {% endif %}
                                </nav>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
                <div class="toast" data-alert="" id="publish-to-eportfolio-label">Activity showcased</div>
            </section>
        </div>
    </div>

{% else %}

    <div class="row">
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>No {{ locale.grades.plural }} are available for filter set.</p>
            </div>
        </div>
    </div>

{% endif %}


{# Teachers and Comments for all student-involved folders #}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Comments (per Class / Group)</h2>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <select title="Select a class / group to view teachers and comments" data-teacher-comment-selector>
            <option value="" disabled selected>Select a Class / Group</option>
            {% for folderId, conversations in conversationsPerFolder %}
                <option value="{{ folderId }}">{{ folders[folderId].title }}</option>
            {% endfor %}
        </select>
    </div>
</div>

{% for folderId, conversation in conversationsPerFolder %}
    <div data-teacher-comments="{{ folderId }}" class="row" style="display: none;">
        <div class="small-12 large-6 island">
            <h2 class="subheader">Teachers</h2>
            <section>
                <ul class="action-list">
                    {% for teacher in folders[folderId].teachers %}
                        <li>
                            <div class="small-12 card">
                                <a href="/search/user/{{ teacher.id }}" title="View Profile">
                                    <img src="/portrait.php?userId={{ teacher.externalId }}&size=square64"
                                         alt="{{ teacher.fullName }}">
                                    <p>{{ teacher.fullName }}</p>
                                </a>
                                <p class="meta">Teacher</p>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>

        {% set comments   = conversation.getVisibleComments(USER) %}
        {% set canComment = conversation.canComment(USER) %}

        {% if comments|length or canComment %}
            <div class="small-12 island">
                <h2 class="subheader">Comments</h2>
            </div>
        {% endif %}
        {% if canComment %}
            <div class="small-12 columns">
                <form id="create-comment" data-comment-form action="/ajax/comment.php" method="post">
                    <input type="hidden" name="studentId" value="{{ viewee.id }}"/>
                    <input type="hidden" name="categoryId" value="{{ folderId }}"/>
                    <textarea title="TODO" name="comment" rows="3"></textarea>
                    <div class="row">
                        <div class="small-6 medium-offset-6 medium-3 column">
                            <input id="vis-student" type="checkbox" name="visibility[student]" value="1" />
                            <label for="vis-student" class="checkbox-label">Visible To Student</label>
                        </div>
                        <div class="small-6 medium-3 column">
                            <input id="vis-parent" type="checkbox" name="visibility[parent]" value="1" checked />
                            <label for="vis-parent" class="checkbox-label">Visible To Parents</label>
                        </div>
                    </div>
                    <a class="button expand submit" data-comment-post="new">Post to {{ folders[folderId].title }}</a>
                </form>
            </div>
        {% endif %}
        <div class="small-12 island">
            <section>
                <ul class="action-list" data-comment-list>
                    {% for comment in comments %}
                        <li class="actions-small-2" data-id="{{ comment.id }}">
                            <div class="list-item">
                                <div class="small-10 card">
                                    <a href="/search/user/{{ comment.commenter.id }}" title="View Profile">
                                        <img src="/portrait.php?userId={{ comment.commenter.externalId }}&size=square64" alt="{{ comment.commenter.fullName }}" />
                                        <p>{{ comment.commenter.fullName }}</p>
                                    </a>
                                    <p class="meta">{{ comment.commenter.role.name }}</p>
                                    <p class="meta">{{ comment.createdAt.relativeTime }}</p>
                                </div>
                                <div class="small-2 column content">
                            <span class="icon-staff-students {% if comment.studentVisibility %}on{% else %}off{% endif %}"
                                  title="{% if comment.studentVisibility %}Visible to {% else %}Hidden from {% endif %}student"></span>
                                    <span class="icon-staff {% if comment.parentVisibility %}on{% else %}off{% endif %}"
                                          title="{% if comment.parentVisibility %}Visible to {% else %}Hidden from {% endif %}parents"></span>
                                </div>
                            </div>
                            <nav>
                                {% if canComment %}
                                    <a class="icon-delete" title="Delete" data-comment-delete></a>
                                    <a class="icon-modify" title="Modify" data-comment-modify></a>
                                {% endif %}
                            </nav>
                            <article>
                                <p>
                                    {{ comment.body | purify }}
                                </p>
                            </article>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endfor %}
