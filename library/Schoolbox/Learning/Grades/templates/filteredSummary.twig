{% import '@learning/macro/urgency.twig' as urgency %}
{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(['Learning', routeLookup('learning.getClasses')], [locale.grades.properPlural, '#']) }}

<div class="row">
    <div class="small-12 columns">
        {% if year is not empty %}
            <h1>{{ year }} {{ locale.grades.properPlural }} Summary</h1>
        {% else %}
            <h1>Grades for {{ term.title }}</h1>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="small-12 medium-5 island">
        <section>
            <ul class="action-list">
                <li>
                    <div class="small-12 card">
                        <a href="/search/user/{{ student.id }}" title="View Profile">
                            <img src="/portrait.php?userId={{ student.externalId }}&size=square64" alt="{{ student.fullName }}"/>
                            <p>{{ student.fullName }}</p>
                            <p class="meta">Year {{ student.year }} Student</p>
                        </a>
                    </div>
                </li>
            </ul>
        </section>
    </div>
    <div class="small-12 medium-7 columns">
        <div class="content">
            <div class="context-switch clearfix">
                {% include '@learningGrades/semesterSelector.twig' with {
                    currentTerm: term,
                    terms:       terms,
                    termRoute:   'learningGrades.getGrades',
                    yearRoute:   yearRoute,
                    routeArgs:   {viewee: student, userId: student.id},
                    year:        year
                } only %}
            </div>
        </div>
    </div>
</div>

{# Display subjects the student is involved in for the selected term #}

{% if termFallback is not empty %}
    {% set term = termFallback %}
{% endif %}

{% set count = 0 %}

<div class="row">
    <div class="small-12 island">
        {% for folder in folders %}
            {% if assessmentTasks[folder.id] | length %}
                {% set count = count + 1 %}
                <div class="row">
                    <div class="small-12 medium-8 columns">
                        <h2 class="subheader no-margin">
                            <a href="{{ routeLookup('learningGrades.getGradesForSubject', {student: student, userId: student.id, term: term, termCode: term.code, subject: subject, subjectId: folder.id}) }}"
                               title="View {{ locale.grades.properPlural }}">
                                {{ folder.name }}
                            </a>
                        </h2>
                        {% for code in folder.codes %}
                            {% if loop.first %}<p class="meta">{% endif -%}
                            {{ code.code }}{% if not loop.last and code.code is not empty %},{% endif %}
                            {%- if loop.last %}</p>{% endif %}
                        {% endfor %}
                    </div>
                    <div class="small-12 medium-4 island">
                        <section>
                            {% for teacher in folder.teachers %}
                                <div class="list-item">
                                    <div class="small-12 card">
                                        <a href="/search/user/{{ teacher.id }}" title="">
                                            <img src="/portrait.php?userId={{ teacher.externalId }}&size=square64"
                                                 alt="{{ teacher.fullName }}"/>
                                            <p>{{ teacher.fullName }}</p>
                                        </a>
                                        <p class="meta">Teacher</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </section>
                    </div>
                </div>

                <section>
                    <ul class="information-list">
                        {% for assessment in assessmentTasks[folder.id] %}
                            {% set participant = assessment.participantIfExtant(student) %}
                            <li class="actions-small-2">
                                <div class="list-item clearfix content">
                                    <div class="row">
                                        <div class="small-12 large-5 card column xl">
                                            <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: assessment.id, studentId: student.id}) }}{{ returnUrlSuffix }}">
                                                {{ assessment.title }}
                                            </a>
                                            <p class="meta">
                                                <a href="/homepage/{{ subject.id }}">{{ subject.name }}</a> {{ assessment.typeName }}
                                            </p>
                                        </div>

                                        <div class="small-12 large-4 columns grade">
                                            {% set feedback = participant.findAuthoritativeVisibleFeedback(currentUser) %}
                                            {% if feedback %}
                                                <div class="{{ urgency.marks(feedback.normalisedMark) }}"><span>{{ feedback.humanReadableMark }}</span></div>
                                                <p class="comment">{{ feedback.comment | nl2br }}</p>
                                            {% endif %}
                                        </div>

                                        <div class="small-12 large-3 columns">
                                            Due <span class="{{ urgency.datetime(participant) }}">{{ assessment.dueAt.relativeTime }}</span>
                                            on {{ assessment.dueAt.dateOnly }}
                                        </div>
                                    </div>
                                </div>
                                <nav>
                                    {% if quizzes[assessment.id] is not empty %}
                                        <a class="icon-view" href="/assess/attempts/{{ quizzes[assessment.id].id }}/{{ student.id }}" title="View Attempts"></a>
                                    {% endif %}
                                </nav>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        {% endfor %}
    </div>
</div>

{% if count == 0 %}

    <div class="row">
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>There are no {{ locale.grades.plural }} to view for this term.</p>
            </div>
        </div>
    </div>

{% endif %}
