{##
 # Capability Marks panel on a student's Grades page
 #
 # Renders a list of students capability grades to a table.
 # A unique list of capabilities and corresponding indicators are listed in a column on the left with activities
 # (along with a particular grid now that we support multiple grids per activities) running horizontally, for a
 # particular student.
 #
 # @param array $longitudinalAssessments  A set of array-represented activity metadata (these are not object instances)
 # @param array $longitudinalStudentMarks A set of (student, grid outcome) tuples; stolen from the rubric markbook struct
 # @param User $student                   The student whose grades page we are viewing
 # @param GenericCollection $assessments  A collection of IAssessable instances indexed by assessment id
 # @param string $returnUrlSuffix         A redirect fragment
 #}
<div class="scrollable">
    <table class="rb">
        <thead>
            <tr>
                <td>&nbsp;</td>
                {% for activityId, activity in longitudinalAssessments %}
                    {% for rubricInstanceId, rubricInstanceData in activity.gridData %}
                        <td>
                            {% set summaryLink = routeLookupIfAuthorized('learningAssessment.getSummary', {
                                studentId: student.id,
                                student: student,
                                assessmentId: activityId,
                                assessment: assessments.by('id', activityId)
                            }) %}
                            <a href="{{ summaryLink ?? null }}{{ returnUrlSuffix }}">{{ activity.name }}</a><br />
                            {{ rubricInstanceData.title }}
                        </td>
                    {% endfor %}
                {% endfor %}
            </tr>
        </thead>
        {% for capabilityId, capabilityData in longitudinalStudentMarks %}
            <tr>
                <th class="rb-group-name markdown">{{ capabilityData.name | markdown }}</th>

                {% for activityId, activity in longitudinalAssessments %}
                    {% for rubricInstanceId, rubricInstanceData in activity.gridData %}
                        <td>
                            {% if capabilityData.assessmentResults is defined and capabilityData.assessmentResults[activityId] is defined %}
                                {{ capabilityData.assessmentResults[activityId].grid[rubricInstanceId].published.humanReadableMark ?? null }}
                            {% else %}
                                &nbsp;
                            {% endif %}
                        </td>
                    {% endfor %}
                {% endfor %}
            </tr>
        {% endfor %}
    </table>
</div>
