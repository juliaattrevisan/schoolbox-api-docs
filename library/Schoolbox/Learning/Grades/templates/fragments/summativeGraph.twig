{#
    Render a box-and-whiskers plot of a single student's assessment results

    This is a print-friendly version for use within the summative report

    Usage:
        graph: Grades\Graph
        graphId: the div element ID so we can render multiple entries and not have issues...
#}

<script type="text/javascript">
    $(function() {

        let infoArray = {{ graph.info | purify }};
        let graphData = {{ graph.scatter | purify }};

        const formatGraphLabel = (template, infoArrayIndex) => {
            let retString = template;

            if (infoArray[infoArrayIndex].displayMark !== null) {
                retString = retString.replace(/{DISPLAYMARK}/, infoArray[infoArrayIndex].displayMark);
                retString = retString.replace(/{GRADIENTMARK}/, infoArray[infoArrayIndex].gradientMark);
            }
            else {
                retString = retString.replace(/{DISPLAYMARK}/, '');
                retString = retString.replace(/{GRADIENTMARK}/, '');
            }
            retString = retString.replace(/{INFO}/, infoArray[infoArrayIndex].info);

            return retString;
        };

        // Format the data points to include dataLabels for print display
        graphData = graphData.map((data, i) => {
            return {
                dataLabels: {
                    enabled: true,
                    useHTML: true,
                    formatter: function () {
                        if (infoArray[i] && infoArray[i]?.displayMark){
                            const template = `<div class="summative-graph-data-label">{DISPLAYMARK}</div>`;
                            return formatGraphLabel(template, i);
                        }
                        return '';
                    }
                },
                y: data,
            };
        });

        /**
         *  Boxplots for each Task in the Unit
         */

        $.fn.reportCardBoxplotRender({
            element: '#{{ graphId }}',
            /* Title of the graph
             */
            title: '',
            /* Orientation of the box plots
             */
            orientation: 'vertical',
            /* A list of all the assessment names that are being graphed
             * These correspond to a series of data and their respective
             * five-point summaries
             */

            allAssessments: {{ graph.assessments | purify }},
            /* All the raw data
             */
            allData: $.fn.reportCardBoxplotCalculateAllSeriesData({{ graph.data | purify }}),
            /* You
             */
            additionalSeries: [
                {
                    type: 'scatter',
                    name: 'You',
                    color: 'rgb(255, 87, 87)',
                    marker: {
                        radius: 6
                    },
                    data: graphData,
                }
            ],
            // Tooltips aren't necessary in print media
            tooltip: {
                enabled: false
            }
        });
    });
</script>

<div class="row">
    <div class="small-12 island">
        <section class="content summative-graph-container">
            <div id="{{ graphId }}"></div>
        </section>
    </div>
</div>
