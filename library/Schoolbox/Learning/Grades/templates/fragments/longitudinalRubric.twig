{#
    Render a bar graph of a single student's assessment results

    Usage:
        longitudinalRubric    array
        student               User
        assessments           IAssessable[]
        returnUrlSuffix       string
#}
<script type="text/javascript">
    $(function() {
        Highcharts.boxLine = function (a, b, c) {
            var hasRenderToArg = typeof a === 'string' || a.nodeName,
                options = arguments[hasRenderToArg ? 1 : 0],
                defaultOptions = {
                    chart: {
                        renderTo: (options.chart && options.chart.renderTo) || this,
                        height: 80,
                        borderWidth: 0,
                        margin: 0,
                    },
                    title: {
                        text: ''
                    },
                    credits: {
                        enabled: false
                    },
                    yAxis: {
                        visible: false,
                        title: {
                            text: null
                        },
                        endOnTick: false,
                        startOnTick: false,
                        tickPositions: [0]
                    },
                    tooltip: {
                        crosshairs: false,
                        useHTML: true,
                        shared: true,
                        valueSuffix: '',
                        formatter: function() {
                            return 'The value for '+this.points[0].x;
                        }
                    },
                    legend: {
                        enabled: false
                    }
                };

            options = Highcharts.merge(defaultOptions, options);

            return hasRenderToArg ?
                new Highcharts.Chart(a, options, c) :
                new Highcharts.Chart(options, b);
        }
    });
</script>

<div class="row">
    <div class="small-12 island">
        <dl class="tabs" data-tab>
            <dd class="active"><a href="#progression" aria-selected="true" tabindex="0">Progression</a></dd>
            <dd class=""><a href="#descriptors" aria-selected="false" tabindex="0">Descriptors</a></dd>
        </dl>
        <div class="tabs-content">
            <div class="content active" id="progression">
                {% for capability in longitudinalRubric %}
                    <h2 class="subheader">{{ capability.name }}</h2>
                    <table>
                        {% for indicatorId,indicator in capability.indicators %}
                            <tr>
                                <th width="15%">{{ indicator.name }}</th>
                                <td>
                                    <div id="rubricGraph{{ indicatorId }}"></div>
                                    <script type="application/javascript">
                                        $(function() {
                                            var assessments = [
                                                {% for activity_id, activity in indicator.activities %}
                                                {% if activity.max_value > 0  %}
                                                "{{ activity.name }}",
                                                {% endif %}
                                                {% endfor %}
                                            ];

                                            var grades = [
                                                {% for activity_id, activity in indicator.activities %}
                                                {% if activity.max_value > 0  %}
                                                {{ ((activity.value / activity.max_value) * 100) }},
                                                {% endif %}
                                                {% endfor %}
                                            ];

                                            var ranges = [
                                                {% for activity_id, activity in indicator.activities %}
                                                {% if activity.max_value > 0  %}
                                                ["{{ activity.name  }}",{{ (activity.statistics.min / activity.max_value) * 100 }}, {{ (activity.statistics.quartile1 / activity.max_value) * 100 }}, {{ (activity.statistics.quartile2 / activity.max_value) * 100 }}, {{ (activity.statistics.quartile3 / activity.max_value) * 100 }}, {{ (activity.statistics.max / activity.max_value) * 100 }}],
                                                {% endif %}
                                                {% endfor %}
                                            ];

                                            $('#rubricGraph{{ indicatorId }}').highcharts('boxLine', {
                                                xAxis: [{
                                                    categories: assessments,
                                                    visible: false,
                                                    title: {
                                                        text: null
                                                    }
                                                }],
                                                series: [{
                                                    name: 'Marks',
                                                    data: grades,
                                                    zIndex: 1,
                                                    color: 'rgb(255, 87, 87)',
                                                }, {
                                                    name: 'Range',
                                                    data: ranges,
                                                    type: 'boxplot',
                                                    linkedTo: ':previous',
                                                    color: Highcharts.getOptions().colors[0],
                                                    fillOpacity: 0.3,
                                                    zIndex: 0,
                                                    marker: {
                                                        enabled: false
                                                    }
                                                }]
                                            })
                                        });
                                    </script>
                                </td>
                            </tr>
                        {% endfor %}
                    </table>
                {% endfor %}
            </div>
            <div class="content" id="descriptors">
                <section>
                    <div class="row" id="rubric-table">
                        {% for capability in longitudinalRubric %}
                            <div class="small-12 island">
                                <section data-interaction="collapse" data-collapse-container>
                                    <ul class="information-list">
                                        <li class="list-item">
                                            <div class="card small small-12">
                                                <h3>
                                                <span data-collapser="true" class="expander" title="{{ capability.name }}">
                                                    <a href="#">{{ capability.name | nl2br }}</a>
                                                </span>
                                                </h3>
                                            </div>
                                        </li>
                                        {% for indicator in capability.indicators %}
                                            <li class="hide" data-collapsable="true" data-collapse-state='collapsed'>
                                                <div class="content">
                                                    <h4>{{ indicator.name | nl2br }}</h4>
                                                    <ul class="information-list">
                                                        {% for activity_id, activity in indicator.activities %}
                                                            <li>
                                                                {% set activityAssessment = assessments.by('id', activity_id) %}
                                                                {% if activityAssessment %}
                                                                    {%- set activityHref = routeLookupIfAuthorized(
                                                                        'learningAssessment.getSummary',
                                                                        {
                                                                            assessmentId: activity_id,
                                                                            studentId: student.id,
                                                                            student: student,
                                                                            assessment: activityAssessment,
                                                                        }
                                                                        ) -%}
                                                                {% else %}
                                                                    {%- set activityHref = '' -%}
                                                                {% endif %}
                                                                {%- if activityHref -%}
                                                                    <a href="{{ activityHref }}{{ returnUrlSuffix }}">{{ activity.name }}</a>
                                                                {%- else -%}
                                                                    {{ activity.name }}
                                                                {%- endif -%}
                                                                : <em>{{ activity.descriptor }} {% if activity.value %}({{ activity.value|round }}/{{ activity.max_value|round }}){% endif %}</em>
                                                            </li>
                                                        {% endfor %}
                                                    </ul>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </section>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

