{#
    Render a bar graph of a single student's assessment results

    Usage:
        longitudinalRubric    array
        student               User
        assessments           IAssessable[]
        returnUrlSuffix       string
#}

<div class="row">
    <div class="small-12 column">
        <h2 class="subheader">{{ locale.translate('rubricGroup', true, true) }}</h2>
        <section>
            <div class="row" id="rubric-table">
                {% for capability in longitudinalRubric %}
                    <div class="small-12 island">
                        <section data-interaction="collapse" data-collapse-container>
                            <ul class="information-list">
                                <li class="list-item">
                                    <div class="card small small-12">
                                        <h3>
                                        <span data-collapser="true" class="expander" title="{{ capability.name }}">
                                            <a href="#">{{ capability.name | nl2br }}</a>
                                        </span>
                                        </h3>
                                    </div>
                                </li>
                                {% for indicator in capability.indicators %}
                                    <li class="hide" data-collapsable="true" data-collapse-state='collapsed'>
                                        <div class="content">
                                            <h4>{{ indicator.name | nl2br }}</h4>
                                            <ul class="information-list">
                                                {% for activity in indicator.activities %}
                                                    <li>
                                                        {% set activityAssessment = assessments.by('id', activity.id) %}
                                                        {% if activityAssessment %}
                                                            {%- set activityHref = routeLookupIfAuthorized(
                                                                'learningAssessment.getSummary',
                                                                {
                                                                    assessmentId: activity.id,
                                                                    studentId: student.id,
                                                                    student: student,
                                                                    assessment: activityAssessment,
                                                                }
                                                            ) -%}
                                                        {% else %}
                                                            {%- set activityHref = '' -%}
                                                        {% endif %}
                                                        {%- if activityHref -%}
                                                            <a href="{{ activityHref }}{{ returnUrlSuffix }}">{{ activity.name }}</a>
                                                        {%- else -%}
                                                            {{ activity.name }}
                                                        {%- endif -%}
                                                        : <em>{{ activity.descriptor }}</em>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>
</div>
