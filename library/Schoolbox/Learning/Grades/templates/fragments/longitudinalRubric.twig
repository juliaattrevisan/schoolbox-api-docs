{#
    Render a bar graph of a single student's assessment results

    Usage:
        longitudinalRubric    array
        student               User
        assessments           IAssessable[]
        returnUrlSuffix       string
#}
<script type="text/javascript">
    $(function() {
        Highcharts.boxLine = function (a, b, c) {
            var hasRenderToArg = typeof a === 'string' || a.nodeName,
                options = arguments[hasRenderToArg ? 1 : 0],
                defaultOptions = {
                    chart: {
                        renderTo: (options.chart && options.chart.renderTo) || this,
                        height: 80,
                        borderWidth: 0,
                        margin: 0,
                    },
                    title: {
                        text: ''
                    },
                    credits: {
                        enabled: false
                    },
                    yAxis: {
                        visible: false,
                        title: {
                            text: null
                        },
                        endOnTick: false,
                        startOnTick: false,
                        tickPositions: [0]
                    },
                    tooltip: {
                        crosshairs: false,
                        useHTML: true,
                        shared: true,
                        valueSuffix: '',
                        formatter: function() {
                            return 'The value for '+this.points[0].x;
                        }
                    },
                    legend: {
                        enabled: false
                    }
                }

            options = Highcharts.merge(defaultOptions, options);

            return hasRenderToArg ?
                new Highcharts.Chart(a, options, c) :
                new Highcharts.Chart(options, b);
        }
    });
</script>

<div class="row">
    <div class="small-12 column">
        <h2 class="subheader">{{ locale.translate('rubricGroup', true, true) }}</h2>
        <section>
            <div class="row" id="rubric-table">
                {% for capability in longitudinalRubric %}
                    <div class="small-12 island">
                        <section data-interaction="collapse" data-collapse-container>
                            <ul class="information-list">
                                <li class="list-item">
                                    <div class="card small small-12">
                                        <h3>
                                        <span data-collapser="true" class="expander" title="{{ capability.name }}">
                                            <a href="#">{{ capability.name | nl2br }}</a>
                                        </span>
                                        </h3>
                                    </div>
                                </li>
                                {% for indicator in capability.indicators %}
                                    <li class="hide" data-collapsable="true" data-collapse-state='collapsed'>
                                        <div class="content">
                                            <h4>{{ indicator.name | nl2br }}</h4>
                                            <ul class="information-list">
                                                {% for activity in indicator.activities %}
                                                    <li>
                                                        {% set activityAssessment = assessments.by('id', activity.id) %}
                                                        {% if activityAssessment %}
                                                            {%- set activityHref = routeLookupIfAuthorized(
                                                                'learningAssessment.getSummary',
                                                                {
                                                                    assessmentId: activity.id,
                                                                    studentId: student.id,
                                                                    student: student,
                                                                    assessment: activityAssessment,
                                                                }
                                                                ) -%}
                                                        {% else %}
                                                            {%- set activityHref = '' -%}
                                                        {% endif %}
                                                        {%- if activityHref -%}
                                                            <a href="{{ activityHref }}{{ returnUrlSuffix }}">{{ activity.name }}</a>
                                                        {%- else -%}
                                                            {{ activity.name }}
                                                        {%- endif -%}
                                                        : <em>{{ activity.descriptor }}</em>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>
</div>


<div class="row">
    <div class="small-12 column">
        {% for capability in longitudinalRubric %}
        <h2 class="subheader">{{ capability.name }}</h2>
            <table>
                {% for indicatorId,indicator in capability.indicators %}
                <tr>
                    <th width="15%">{{ indicator.name }}</th>
                    <td>
                        <div id="rubricGraph{{ indicatorId }}"></div>
                        <script type="application/javascript">
                            $(function() {

                                var assessments = ["Assessment 1", "Assessment 2", "Assessment 3", "Assessment 4", "Assessment 5"];
                                var ranges = [
                                        ["Assessment 1", 14.3, 27.7, 29.1, 40.2, 60.2],
                                        [ "Assessment 2", 14.5, 27.8, 29.1, 40.2, 60.2],
                                        ["Assessment 3", 15.5, 49.6, 53, 68, 79.3],
                                        ["Assessment 4", 16.7, 53.7, 60.2, 82, 95],
                                        ["Assessment 5", 16.5, 60, 68, 80, 100]

                                    ],
                                    ranges2 = [
                                        [1246406400000, 14.3, 27.7, 29.1, 40.2, 60.2],
                                        [1246492800000, null, null,null,null,null],
                                        [1246579200000, 15.5, 29.6, 49.3, 58.2, 64.5],
                                        [1246665600000, 16.7, 30.7, 43, 48.3, 56.3],
                                        [1246752000000, null, null,null,null,null]
                                    ],
                                    averages = [
                                         30, 42.1, 53, 63.8, 87.4
                                    ],
                                    averages2 = [
                                        [1246406400000, 21.5],
                                        [1246492800000, null],
                                        [1246579200000, 23],
                                        [1246665600000, 23.8],
                                        [1246752000000, null]
                                    ];

                                $('#rubricGraph{{ indicatorId }}').highcharts('boxLine', {
                                    xAxis: [{
                                        categories: assessments,
                                        visible: false,
                                        title: {
                                            text: null
                                        }
                                    }],
                                    series: [{
                                        name: 'Marks',
                                        data: averages,
                                        zIndex: 1,
                                        color: 'rgb(255, 87, 87)',
                                    }, {
                                        name: 'Range',
                                        data: ranges,
                                        type: 'boxplot',
                                        linkedTo: ':previous',
                                        color: Highcharts.getOptions().colors[0],
                                        fillOpacity: 0.3,
                                        zIndex: 0,
                                        marker: {
                                            enabled: false
                                        }
                                    }]
                                })
                            });
                        </script>
                    </td>
                </tr>
                {% endfor %}
            </table>
        {% endfor %}
        </section>
    </div>
</div>
