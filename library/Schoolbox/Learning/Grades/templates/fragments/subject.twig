
<div class="small-12 content sibling">
    <h3 class="no-margin">
        {{ folder.name }}
        <span class="meta">
            {% for code in folder.codes %}
                ({{ code.code }}){% if not loop.last %},{% endif %}
            {% endfor %}
        </span>
    </h3>
</div>
{% if showOverallGrade %}
    {% set gradient = (urgency.marks(markbooks[folder.id].studentStatistics[studentId].meanNormalised)) ?: 'gradient-none' %}
    <div class="grade {{ gradient }}-bg no-margin">
        <span>{{ studentGrade.weightedMean }}</span>
    </div>
{% endif %}
