{# Server-side grades view selector, rendered as sub-nav links.
 # Expects viewMode, viewModes and currentRouteBase. #}
<div class="grades-view-mode-switcher u-flex u-flex-row u-flex--align-center u-gap-m u-mar-m--bottom" data-grades-view-mode-switcher>
    <span class="grades-view-mode-switcher__label">Viewing feedback as</span>
    <ul class="sub-nav">
        {% for mode in viewModes %}
            <li{% if viewMode == mode %} class="active"{% endif %}>
                <a href="{{ currentRouteBase }}?viewMode={{ mode|url_encode }}"
                   data-grades-view-mode="{{ mode }}"
                   {% if viewMode == mode %}aria-current="page"{% endif %}>{{ mode|capitalize }}</a>
            </li>
        {% endfor %}
    </ul>
</div>
