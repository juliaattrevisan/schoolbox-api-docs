{##
 # Renders an assessment with a grade, used to display students results on the grade card
 #
 # Params:
 # * assessment:  IAssessable  - The assessment object
 # * participant: Participant  - The participant record for the student
 #}
{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learning/macro/urgency.twig' as urgency %}

<div class="flex-grade">
    <div class="small-12 card columns">
        {% set summaryRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {assessmentId: assessment.id, assessment: assessment, studentId: participant.user.id, student: participant.user}) %}
        {% if summaryRoute %}
            <a href="{{ summaryRoute }}{{ returnUrlSuffix }}">
                <h3>{{ assessment.title }}</h3>
            </a>
        {% else %}
            <h3>{{ assessment.title }}</h3>
        {% endif %}
        <p>
            <span class="meta">{{ assessment.typeName }}</span>
            <span class="pipe meta">{{ dueDate.dueDate(assessment, participant.user) }}</span>
            {% if assessment is quiz and participant.allResponses | length %}
            <span class="pipe meta">
                <a href="{{ routeLookup('learningQuiz.getQuizAttemptsByUser', {assessmentId: assessment.id, assessment: assessment, userId: participant.user.id, user: participant.user}) }}"
                   title="View Attempts">View Attempts</a>
            </span>
            {% endif %}
        </p>
    </div>
    {% include '@learningAssessment/fragments/statusLine.twig' with { assessable: assessment, student: participant.user} only %}
    {% if assessment.isFeedbackVisibleToUser(USER) %}
        {% set feedback = participant.findAuthoritativeVisibleFeedback(USER) %}
        {% if assessment is task %}
            {% include '@learningAssessment/fragments/progressTick.twig' with {
                assessment: assessable,
                student: participant.user
            } only %}
        {% elseif feedback %}
            <div class="grade {{ urgency.marks(feedback.normalisedMark()) }}-bg">
                <span>{{ feedback.humanReadableMark() }}</span>
            </div>
        {% endif %}
    {% endif %}
</div>
{% if assessment.isFeedbackVisibleToUser(USER) %}
    {% if feedback %}
        <div class="content">
            <p class="comment">{{ feedback.comment | nl2br }}</p>
            {% if (assessment.useRubric or feedback.allFiles | length) and summaryRoute %}
                <a href="{{ summaryRoute }}{{ returnUrlSuffix }}">
                    View assessment details</a>
            {% endif %}
        </div>
    {% endif %}
{% endif %}


