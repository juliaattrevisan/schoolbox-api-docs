{##
 # Renders an assessment with a grade, used to display students results on the grade card
 #
 # Params:
 # * assessment:  IAssessable - The assessment object
 # * student:     User        - The user record for the student
 # * canViewInstructorMarks: bool - Whether the user can view instructor marks
 #}
{% import '@learning/macro/dueDate.twig' as dueDate %}
{% import '@learning/macro/urgency.twig' as urgency %}
{% import '@learningAssessment/project/macro/icon.twig' as icon %}

{% set participant = assessment ? assessment.participantIfExtant(student) : null %}

{# Lesson Plans do not appear in the Grades page
 # cos nothing to do about Responses or Feedbacks
 #}
<div class="flex-grade">
    <div class="small-12 card columns">
        {% set summaryRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {
            assessmentId: assessment.id,
            assessment:   assessment,
            studentId:    student.id,
            student:      student
        }) %}
        {% if summaryRoute %}
            <a class="grades-assessment-link" href="{{ summaryRoute }}{{ returnUrlSuffix is defined ? returnUrlSuffix : '' }}">
                <sbx-icon class="grades-assessment-link__icon" name="{{ icon.renderName(assessment)|trim }}" color="var(--sbx-color-text-secondary)"></sbx-icon>
                <p>{{ assessment.title }}
                    {% if participant and USER.role.isStaff and participant.plan.isStatic %}
                        <span class="individualisation has-tip tip-top" data-tooltip title="{{ participant.plan.name}} ({{ participant.plan.duedate.short}})">i</span>
                    {% endif %}
                </p>
            </a>
        {% else %}
            <div class="grades-assessment-link">
                <sbx-icon class="grades-assessment-link__icon" name="{{ icon.renderName(assessment)|trim }}" color="var(--sbx-color-text-secondary)"></sbx-icon>
                <p>{{ assessment.title }}</p>
            </div>
        {% endif %}
        <p>
            {% if assessment.isSpecification %}
                <span class="meta">{{ assessment.typeName }}</span>
            {% else %}
                {% include '@learningAssessment/fragments/statusLine.twig' with {
                    assessable: assessment,
                    student:    student
                } only %}
                <span class="{{ participant or assessment is lessonPlan ? 'pipe' : '' }} meta">{{ assessment.typeName }}</span>
                <span class="pipe meta">{{ dueDate.dueDate(assessment, student) }}</span>
                {% if assessment is quiz and summaryRoute and participant and participant.allResponses | length %}
                    <span class="pipe meta">
                        <a href="{{ summaryRoute }}" title="View Attempts">View Attempts</a>
                    </span>
                {% endif %}
            {% endif %}
        </p>
    </div>

    {% if participant and assessment.isFeedbackVisibleToUser(USER) %}
        {% if assessment is task %}
            {% include '@learningAssessment/fragments/progressTick.twig' with {
                assessment: assessment,
                student:    student
            } only %}
        {% else %}
            {# learners and instructors can view the display mark, only instructors can see the instructor mark #}
            {% set grade = participant.humanReadableMark(true) %}
            {% set instructorGrade = canViewInstructorMarks ?? false ? participant.humanReadableInstructorMark(true) : null %}

            {% if grade %}
                <div data-learner-mark class="grade {{ urgency.marks(participant.normalisedMark(true)) }}-bg"
                    {# If there's an instructor grade available, then hide this by default #}
                    {% if instructorGrade %}style="display: none"{% endif %}
                >
                    <span>{{ grade }}</span>
                </div>
            {% endif %}

            {% if instructorGrade %}
                <div data-instructor-mark class="grade {{ urgency.marks(participant.normalisedMark(true)) }}-bg">
                    <span>{{ instructorGrade }}</span>
                </div>
            {% endif %}
        {% endif %}
    {% endif %}
</div>
{% if participant and assessment.isFeedbackVisibleToUser(USER) %}
    {% set feedback = participant.findAuthoritativeVisibleFeedback(USER) %}
    {% if feedback and feedback.comment   %}
        <div class="content">
            <blockquote>{{ feedback.comment | purify }}</blockquote>
            {% if assessment is dueWork and (assessment.useRubric or feedback.allFiles | length) and summaryRoute %}
                <a href="{{ summaryRoute }}{{ returnUrlSuffix is defined ? returnUrlSuffix : '' }}">
                    View assessment details</a>
            {% endif %}
        </div>
    {% endif %}
{% endif %}
