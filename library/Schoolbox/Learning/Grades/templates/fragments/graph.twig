{#
    Render a box-and-whiskers plot of a single student's assessment results

    Usage:
        graph: Grades\Graph
        graphId: the div element ID so we can render multiple entries and not have issues...
#}

<script type="text/javascript">
    $(function() {
        // Gather the data sets
        let infoIndex = {{ graph.info | json_encode | raw }};
        let graphData = {{ graph.scatter | json_encode | raw }};
        let allData = {{ graph.data | json_encode | raw }};
        let assessments = {{ graph.assessments | json_encode | raw }};

        /**
         *  Reformat the data into an object, then check for results. If we don't have results,
         *  filter out the data as we don't want to display it.
        **/
        let mergedData = graphData.map((item, i) => {
            return {
                graphData: item,
                allData: allData[i] || null,
                assessment: assessments[i] || null,
                displayValues: infoIndex[i] || null,
            }
        }).filter(item => item.graphData != null);

        if( mergedData.length > 0 ) {

            /**
            *  Boxplots for each Task in the Unit
            */
            $.fn.reportCardBoxplotRender({
                element: '#{{ graphId }}',
                /* Title of the graph
                */
                title: '',
                /* Orientation of the box plots
                */
                orientation: 'vertical',
                /* A list of all the assessment names that are being graphed
                * These correspond to a series of data and their respective
                * five-point summaries
                */

                allAssessments: mergedData.map(item => item.assessment),
                /* All the raw data
                */
                allData: $.fn.reportCardBoxplotCalculateAllSeriesData(mergedData.map(item => item.allData)),
                /* You
                */
                additionalSeries: [
                    {
                        type: 'scatter',
                        name: 'You',
                        color: 'rgb(255, 87, 87)',
                        marker: {
                            radius: 6
                        },
                        data: mergedData.map(item => item.graphData),
                        tooltip: {
                            headerFormat: '',
                            borderColor: '#000000',
                            pointFormatter: function () {

                                /* Concatenate everything
                                */

                                if( typeof mergedData[this.x].displayValues !== 'undefined' ){
                                    let displayMark = '';
                                    let gradientMark = '';
                                    let info = mergedData[this.x].displayValues.info;

                                    if(mergedData[this.x].displayValues.displayMark !== null) {
                                        displayMark = mergedData[this.x].displayValues.displayMark;
                                        gradientMark = mergedData[this.x].displayValues.gradientMark;
                                    }

                                    // Interpolate values into tooltip template string
                                    let tooltipContent =
                                    `<div style="width:200px!important;overflow:auto;white-space:normal !important;">
                                        <div class="grade gradient-${gradientMark}"><span>${displayMark}</span></div>
                                        <p class="comment">${info}</p>
                                    </div>`;

                                    /* Show tooltip
                                    */
                                    $('.highcharts-tooltip').show();

                                    return tooltipContent;
                                }
                                else {

                                    /* Hide tooltip when no data
                                    */
                                    $('.highcharts-tooltip').hide();
                                }
                            }
                        }
                    }
                ]
            });
        }
        else {
            //Add logic for zero state here.
        }
    });
</script>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div id="{{ graphId }}"></div>
        </section>
    </div>
</div>
