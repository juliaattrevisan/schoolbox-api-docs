{##
 # Learning Levels panel on a student's Grades page
 #
 # "Renders all the selected descriptors in rubrics across all the rubrics students have been marked for"
 #
 # Shows the selected descriptor text that a student received for each indicator used among assessments.
 # We were already obtaining this selected descriptor text from the rubric markbook mega hash lookup data struct;
 # The Learning Levels panel is identical in layout to Capability Marks panel, but we go deeper into the rubric tree
 #
 # @param array $longitudinalAssessments  A set of array-represented activity metadata (these are not object instances)
 # @param array $longitudinalStudentMarks A set of (student, grid outcome) tuples; stolen from the rubric markbook struct
 # @param User $student                   The student whose grades page we are viewing
 # @param GenericCollection $assessments  A collection of IAssessable instances indexed by assessment id
 # @param string $returnUrlSuffix         A redirect fragment
#}
<div class="scrollable">
    <table class="rb markable">
        <thead>
            <tr>
                <th colspan="2">&nbsp;</th>

                {% for activityId, activity in longitudinalAssessments %}
                    {% for rubricInstanceId, rubricInstanceData in activity.gridData %}
                        <th>
                            {% set summaryLink = routeLookupIfAuthorized('learningAssessment.getSummary', {
                                studentId: student.id,
                                student: student,
                                assessmentId: activityId,
                                assessment: assessments.by('id', activityId)
                            }) %}
                            <a href="{{ summaryLink ?? null }}{{ returnUrlSuffix }}">{{ activity.name }}</a><br />
                            {{ rubricInstanceData.title }}
                        </th>
                    {% endfor %}
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for capabilityId, capabilityData in longitudinalStudentMarks %}
                <tr>
                    <th class="rb-group-name markdown" rowspan="{{ capabilityData.indicators|length }}">{{ capabilityData.name | markdown }}</th>

                    {% for indicatorId, indicatorData in capabilityData.indicators %}
                        {# mystical html table witchery #}
                        {% if not loop.first %}
                            </tr>
                            <tr>
                        {% endif %}

                        <th class="rb-criterion-name markdown">{{ (indicatorData.name  ?? '') | markdown }}</th>

                        {% for activityId, activity in longitudinalAssessments %}
                            {% for rubricInstanceId, rubricInstanceData in activity.gridData %}
                                <td>
                                    <div>
                                        <span class="rb-description markdown">
                                            {{ (indicatorData.assessmentResults[activityId].grid[rubricInstanceId].published.selectedDescriptorText ?? '') | markdown }}

{#                                            {% if activity %}<b>{{ activity.level ?? '' }}</b><br />{% endif %}#}
{#                                            {{ (activity.descriptor ?? '') | markdown }}#}

                                            {% set numerator = indicatorData.assessmentResults[activityId].grid[rubricInstanceId].published.selectedDescriptorValue ?? null %}
                                            {% set denominator = activity.gridData[rubricInstanceId].capabilities[capabilityId].indicators[indicatorId].max ?? null %}

                                            <pre>{{ dump(activity) }}</pre>
                                            {% if numerator and denominator and showRubricPoints %}
                                                ({{ numerator|round }}/{{ denominator|round }})
                                            {% endif %}
                                        </span>
                                    </div>
                                </td>
                            {% endfor %}
                        {% endfor %}
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>











