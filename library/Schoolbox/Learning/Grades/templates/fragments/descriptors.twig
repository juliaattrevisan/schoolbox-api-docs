{#
    Renders all the selected descriptors in rubrics across all the rubrics students have been marked for

    Usage:
        rubricAssessmentList  array
        longitudinalRubric    array
        student               User
        assessments           IAssessable[]
        returnUrlSuffix       string
#}
<div class="scrollable">
    <table class="rb markable">
        <thead>
        <tr><th colspan="2">&nbsp;</th>
            {% for activity_id, activity in rubricAssessmentList  %}
                <th>
                    {% set activityAssessment = assessments.by('id', activity_id) %}
                    {% if activityAssessment %}
                        {%- set activityHref = routeLookupIfAuthorized(
                            'learningAssessment.getSummary',
                            {
                                assessmentId: activity_id,
                                studentId: student.id,
                                student: student,
                                assessment: activityAssessment,
                            }
                            ) -%}
                    {% else %}
                        {%- set activityHref = '' -%}
                    {% endif %}
                    {%- if activityHref -%}
                        <a href="{{ activityHref }}{{ returnUrlSuffix }}">{{ activity.name }}</a>
                    {%- else -%}
                        {{ activity.name }}
                    {%- endif -%}
                </th>
            {% endfor %}
        </tr>
        </thead>
        <tbody>
        {% for capability in longitudinalRubric %}
            <tr>
            <th class="rb-group-name markdown" rowspan="{{ capability.indicators|length }}">{{ capability.name | markdown }}</th>
            {% for indicator in capability.indicators %}
                {% if not loop.first %}
                    <tr>
                {% endif %}
                <th class="rb-criterion-name markdown">{{ (indicator.name  ?? '') | markdown }}</th>
                {% for activity_id, activity in rubricAssessmentList %}
                    {% set activity = indicator.activities[activity_id] is defined ? indicator.activities[activity_id] : null %}
                    <td><div><span class="rb-description markdown">
                            {% if activity %}<b>{{ activity.level ?? '' }}</b><br />{% endif %}
                            {{ (activity.descriptor ?? '') | markdown }} {% if activity and activity.value is defined and activity.max_value > 0 and showRubricPoints %}({{ activity.value|round }}/{{ activity.max_value|round }}){% endif %}
                        </span></div>
                    </td>
                {% endfor %}
                </tr>
            {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>


