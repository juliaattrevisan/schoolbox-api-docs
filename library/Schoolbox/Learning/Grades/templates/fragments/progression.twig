{#
    Render a bar graph of a single student's assessment results

    Usage:
        longitudinalRubric    array
        student               User
        assessments           IAssessable[]
        returnUrlSuffix       string
#}
<script type="text/javascript">
    $(function() {
        Highcharts.boxLine = function (a, b, c) {
            var hasRenderToArg = typeof a === 'string' || a.nodeName,
                    options = arguments[hasRenderToArg ? 1 : 0],
                    defaultOptions = {
                        chart: {
                            renderTo: (options.chart && options.chart.renderTo) || this,
                            height: 80,
                            borderWidth: 0,
                            margin: 0,
                        },
                        title: {
                            text: ''
                        },
                        credits: {
                            enabled: false
                        },
                        yAxis: {
                            min: -5,
                            max: 105,
                            visible: false,
                            title: {
                                text: null
                            },
                            endOnTick: false,
                            startOnTick: false,
                            tickPositions: [0, 25, 50, 75, 100],

                        },
                        tooltip: {
                            crosshairs: false,
                            useHTML: true,
                            shared: true,
                            valueSuffix: '',
                            formatter: function() {
                                return 'The value for '+this.points[0].x;
                            }
                        },
                        legend: {
                            enabled: false
                        }
                    };

            options = Highcharts.merge(defaultOptions, options);

            return hasRenderToArg ?
                    new Highcharts.Chart(a, options, c) :
                    new Highcharts.Chart(options, b);
        }
    });
</script>
<script type="text/css">
    .highcharts-container, .highcharts-container svg { width: 100% !important; }
</script>

<table>
    {% for capability in longitudinalRubric %}
        <tr><td width="15%"><b>{{ capability.name | nl2br }}</b></td>
        {% for indicatorId,indicator in capability.indicators %}
            {% if not loop.first %}
                <tr><td width="15%">&nbsp;</td>
            {% endif %}
            <th width="15%">{{ indicator.name | nl2br}}</th>
            <td>
                <div id="rubricGraph{{ indicatorId }}"></div>
                <script type="application/javascript">
                    $(function() {
                        var assessments = [
                            {% for activity_id, activity_name in rubricAssessmentList %}
                            "{{ activity_name }}",
                            {% endfor %}
                        ];
                        var grades = [
                            {% for activity_id, activity_name in rubricAssessmentList %}
                            {% set activity = indicator.activities[activity_id] %}
                            {% if activity.max_value > 0  %}
                            {{ ((activity.value / activity.max_value) * 100) }},
                            {% else %}
                            '',
                            {% endif %}
                            {% endfor %}
                        ];
                        var ranges = [
                            {% for activity_id, activity in rubricAssessmentList %}
                            {% set activity = indicator.activities[activity_id] %}
                            {% if activity.max_value > 0  %}
                            ["{{ activity.name  }}",{{ (activity.statistics.min / activity.max_value) * 100 }}, {{ (activity.statistics.quartile1 / activity.max_value) * 100 }}, {{ (activity.statistics.quartile2 / activity.max_value) * 100 }}, {{ (activity.statistics.quartile3 / activity.max_value) * 100 }}, {{ (activity.statistics.max / activity.max_value) * 100 }}],
                            {% else %}
                            '',
                            {% endif %}
                            {% endfor %}
                        ];
                        $('#rubricGraph{{ indicatorId }}').highcharts('boxLine', {
                            xAxis: [{
                                categories: assessments,
                                visible: false,
                                title: {
                                    text: null
                                }
                            }],
                            series: [{
                                name: 'Marks',
                                data: grades,
                                zIndex: 1,
                                connectNulls: true,
                                color: 'rgb(255, 87, 87)',
                            }, {
                                name: 'Range',
                                data: ranges,
                                type: 'boxplot',
                                pointWidth: 40,
                                linkedTo: ':previous',
                                color: Highcharts.getOptions().colors[0],
                                fillOpacity: 0.3,
                                zIndex: 0,
                                marker: {
                                    enabled: false
                                }
                            }]
                        })
                    });
                </script>
            </td>
            </tr>
        {% endfor %}
    {% endfor %}
</table>
