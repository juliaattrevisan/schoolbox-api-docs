{##
 # Progression panel on a student's Grades page
 #
 # Show sthe value obtained by a student for each indicator.
 #
 # This student's indicator value is charted against their peers using a John Tukey Five Point Summary
 # sans outliers; this tracks the progression/evolution of someone's indicator(s) over a series of grids
 # and their corresponding assessments, ordered by due date.
 #
 # Indicators that are repated within an assessment via multiple grids might show some variance and this is
 # left to the human to interpret.
 #
 # @param array $longitudinalAssessments  A set of array-represented activity metadata (these are not object instances)
 # @param array $longitudinalStudentMarks A set of (student, grid outcome) tuples; stolen from the rubric markbook struct
 # @param User $student                   The student whose grades page we are viewing
 # @param GenericCollection $assessments  A collection of IAssessable instances indexed by assessment id
 # @param string $returnUrlSuffix         A redirect fragment
 #}
<script type="text/javascript">
    $(function() {
        Highcharts.boxLine = function (a, b, c) {
            var hasRenderToArg = typeof a === 'string' || a.nodeName,
                    options = arguments[hasRenderToArg ? 1 : 0],
                    defaultOptions = {
                        chart: {
                            renderTo: (options.chart && options.chart.renderTo) || this,
                            height: 80,
                            borderWidth: 0,
                            margin: 0,
                        },
                        title: {
                            text: ''
                        },
                        credits: {
                            enabled: false
                        },
                        yAxis: {
                            min: -15,
                            max: 115,
                            visible: false,
                            title: {
                                text: null
                            },
                            endOnTick: false,
                            startOnTick: false,
                            tickPositions: [0, 25, 50, 75, 100],

                        },
                        tooltip: {
                            crosshairs: false,
                            useHTML: true,
                            shared: true,
                            outside: true,
                            valueSuffix: '',
                            hideDelay: 0,
                            formatter: function() {
                                let template =
                                        '<div style="width:250px!important;overflow:auto;white-space:normal !important;">' +
                                        '<h2>{NAME}</h2>' +
                                        '{CONTENT}' +
                                        '</div>';

                                /* Concatenate everything
                                 */
                                if (typeof this.points[0].x !== 'undefined') {
                                    let tooltipContent = template;
                                    let desc = this.points[0].point.desc ?? ''
                                    let level = this.points[0].point.level ?? '';
                                    let content = '';

                                    /* Decorate with more html
                                     */
                                    if ('' !== level) {
                                        level = '<b>' + level + '</b><br />';
                                    }

                                    /* Something to show
                                     */
                                    if ('' !== level || '' !== desc) {
                                        content = '<p>' + level + desc + '</p>';
                                    }

                                    tooltipContent = tooltipContent.replace(/{NAME}/, this.points[0].x);
                                    tooltipContent = tooltipContent.replace(/{CONTENT}/, content);

                                    return tooltipContent;
                                }
                            }
                        },
                        legend: {
                            enabled: false
                        }
                    };

            options = Highcharts.merge(defaultOptions, options);

            return hasRenderToArg ?
                    new Highcharts.Chart(a, options, c) :
                    new Highcharts.Chart(options, b);
        }
    });
</script>
<table class="rb">
    {% for capabilityId, capabilityData in longitudinalStudentMarks %}
    <tr>
        <th class="rubric-progression-capability markdown" rowspan="{{ capabilityData.indicators|length }}">{{ (capabilityData.name ?? '') | markdown }}</th>

        {% for indicatorId, indicatorData in capabilityData.indicators %}
            {# mystical html table witchery #}
            {% if not loop.first %}
                </tr>
                <tr>
            {% endif %}

            <th class="rubric-progression-indicator markdown">{{ (indicatorData.name ?? '') | markdown }}</th>
            <td class="rubric-progression-graph">
                <div id="rubricGraph{{ indicatorId }}"></div>

                <script type="application/javascript">
                    $(function() {
                        const rootStyles = getComputedStyle(document.documentElement); // Get the computed styles of the :root element
                        const depthDefault = parseInt(rootStyles.getPropertyValue('--sbx-depth-default')); // Get the default depth for the graph

                        let assessments = [
                            {% for activityId, activity in longitudinalAssessments %}
                                {% for rubricInstanceId, rubricInstanceData in activity.gridData %}
                                    "{{ activity.name }}<br />{{ rubricInstanceData.title }}",
                                {% endfor %}
                            {% endfor %}
                        ];

                        let grades = [
                            {% for activityId, activity in longitudinalAssessments %}
                                {% for rubricInstanceId, rubricInstanceData in activity.gridData %}
                                    {# Shortcuts to marks of various types #}
                                    {% set publishedMarks = indicatorData.assessmentResults[activityId].grid[rubricInstanceId].published ?? null %}

                                    {% if publishedMarks is not null and publishedMarks.normalisedMark is not null %}
                                        {
                                            y: {{ publishedMarks.normalisedMark }},
                                            desc: "{{ (publishedMarks.selectedDescriptorText ?? '') | markdown | escape('js') }}",
                                            title: "{{ activity.name }}",
                                            level: "{{ publishedMarks.selectedLevel }}"
                                        },
                                    {% else %}
                                        '',
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}
                        ];

                        var ranges = [
{#                            {% for activityId, activity in longitudinalAssessments %}#}
{#                                {% set activity = indicator.activities[activityId] is defined ? indicator.activities[activity_id] : null %}#}

{#                                {% if activity.max_value ?? 0 > 0 and activity.statistics is defined %}#}
{#                                    ["{{ activity.name  }}",{{ (activity.statistics.min / activity.max_value) * 100 }}, {{ (activity.statistics.quartile1 / activity.max_value) * 100 }}, {{ (activity.statistics.quartile2 / activity.max_value) * 100 }}, {{ (activity.statistics.quartile3 / activity.max_value) * 100 }}, {{ (activity.statistics.max / activity.max_value) * 100 }}],#}
{#                                {% else %}#}
{#                                    '',#}
{#                                {% endif %}#}
{#                            {% endfor %}#}
                        ];

                        $('#rubricGraph{{ indicatorId }}').highcharts('boxLine', {
                            xAxis: [{
                                categories: assessments,
                                visible: false,
                                title: {
                                    text: null
                                }
                            }],
                            series: [{
                                name: 'Marks',
                                data: grades,
                                zIndex: depthDefault,
                                connectNulls: true,
                                color: 'rgb(255, 87, 87)',
                            }, {
                                name: 'Range',
                                data: ranges,
                                type: 'boxplot',
                                pointWidth: 40,
                                linkedTo: ':previous',
                                color: Highcharts.getOptions().colors[0],
                                fillOpacity: 0.3,
                                zIndex: depthDefault-1,
                                marker: {
                                    enabled: false
                                }
                            }]
                        });
                    });
                </script>
            </td>
        {% endfor %}
    {% endfor %}
</table>

<style>
/* Adjust Highcharts tooltip z-index to match our pop-over depth */
.highcharts-tooltip-container {
    z-index: var(--sbx-depth-pop-over)!important;
}
</style>
