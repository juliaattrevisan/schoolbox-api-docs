{% extends '@learning/coreClassLists.twig' %}

{# Hide due work and grades links for Lauriston, they are a portal-only school #}

{% block classListSlots %}
    {% verbatim %}
    <template v-slot:student-menu-items="slotProps">
        <template v-for="(element, index) in slotProps.student.routes">
            <li v-if="!index.match(/(dueWork|grades)/)">
                <a :href="element.href" :class="element.class" :title="element.title">
                    {{ element.label }}
                </a>
            </li>
        </template>
    </template>
    {% endverbatim %}
{% endblock classListSlots %}
