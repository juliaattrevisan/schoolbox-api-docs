{% extends '@learning/coreClassLists.twig' %}

{# Hide due work and grades links for Lauriston, they are a portal-only school #}

{% block data_dropdown_content %}
    <li v-for="(element, index) in student.routes" v-if="!index.match(/(dueWork|grades)/)">
        <a :href="element.href" :class="element.class" :title="element.title">${ element.label }</a>
    </li>
{% endblock %}
