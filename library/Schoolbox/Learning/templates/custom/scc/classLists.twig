{% extends '@learning/coreClassLists.twig' %}

{# SCC: show different student alerts #}

{% block classListSlots %}
    <template v-slot:student-meta="slotProps">
        <span v-if="slotProps.student.StudentSpecialNeedsFlag != 0" class="icon-bell warning" title="{{ specialNeeds }}"></span>
        <span v-if="slotProps.student.StudentMedicalAlert != ''" class="icon-alert alert" :title="'Medical Alert: ' + slotProps.student.StudentMedicalAlert"></span>
        <span v-if="slotProps.student.StudentNonResidentFlag != 0" class="icon-international-student" title="International Student"></span>
        <span v-if="slotProps.student.StudentIBFlag != 0" class="icon-international-baccalaureate" title="International Baccalaureate Student"></span>
        <span v-if="slotProps.student.EnglishSecondFlag != 0" class="icon-eng-second-lang highlight" title="English as an Additional Language"></span>
        <span v-if="slotProps.student.StudentTSIFlag != 0" class="icon-boarder-leave" title="Boarder"></span>
        <span v-if="slotProps.student.IntegrationFlag != 0" class="icon-integration-student" title="SAC"></span>
        <span v-if="slotProps.student.EMAFlag != 0" class="icon-education-mainentance" title="Ed Psych"></span>
    </template>
{% endblock classListSlots %}
