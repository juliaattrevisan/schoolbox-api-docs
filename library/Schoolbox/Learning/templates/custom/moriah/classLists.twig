{% extends '@learning/coreClassLists.twig' %}

{% block header %}
    <div class="small-10 column">
        <h1>${ subject }</h1>
    </div>
    <div class="small-2 column">
        <a :href="'http://samwise3/ReportServer/Pages/ReportViewer.aspx?%2feLYReports%2fStudentResultsSummary_1&rs:Command=Render&rc:Parameters=false&ClassCode=' + classCode"
           class="button right icon-progress" rel="external" title="Actions">Class Report</a>
    </div>
    <template v-if="showSkeletonLoader" v-for="n in 3">
        <div class="list-item">
            <div class="small-12 card skeleton">
                <div class="img"></div>
                <h3></h3>
                <p class="meta"></p>
            </div>
        </div>
    </template>
{% endblock %}
