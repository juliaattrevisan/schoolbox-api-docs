{#
    Renders a participant to-chase in the assessments to-chase section of the pending assessment page
    In own template to enable AJAX insertion.

    Data:
        participant:  Participant
        assessment:   IAssessable
        isTask:       bool                   (optional) Override to indicate to render as Task
        isQuiz:       bool                   (optional) Override to indicate to render as Quiz
        isDueWork:    bool                   (optional) Override to indicate to render as DueWork
#}

{# Enable insertion of non IAssessable instance data transfer objects #}
{% set isTask     = isTask    ?? assessment is task %}
{% set isQuiz     = isQuiz    ?? assessment is quiz %}
{% set isDueWork  = isDueWork ?? assessment is dueWork %}

<li data-participant="{{ participant.user.id }}" data-email="{{ participant.user.email }}">
    {% if isTask %}
    <div class="compact card small-11">
        <div>
            {% include 'include/portrait.twig' with {user: participant.user, description: participant.user.fullName} only %}
            <p>{{ participant.user.firstname }} {{ participant.user.lastname }}</p>
        </div>
    </div>
    <div class="small-1 columns no-pad">
        {# An icon that shows if the student has attempted the task or not #}
        {% include '@learningAssessment/fragments/progressTick.twig' with {
            assessment:  assessment,
            student: participant.user
        } only %}
    </div>
    {% else %}
        {% if isDueWork %}
            {% set ackReceipt = routeLookupIfAuthorized('learningAssessment.postPendingAcknowledge', {
                assessmentId: assessment.Id,
                assessment:   assessment,
                studentId:    participant.user.id,
                student:      participant.user
            }) %}
            {% set href = routeLookup('learningDueWorkResponse.getParticularResponse', {assessmentId: assessment.id, studentId: participant.user.id}) %}
            {% set title = 'View and ' ~ locale.grades ~ ' submission' %}
        {% else %}
            {% set ackReceipt = '' %}
            {% set href = '/search/user/' ~ participant.user.id %}
            {% set title = 'View student profile' %}
        {% endif %}


        <div class="{% if ackReceipt %}small-6 medium-8{% else %}small-12{% endif %} columns no-pad">
            <a class="link-row" href="{{ href }}" title="{{ title }}">
                <div class="compact card">
                    <div>
                        {% include 'include/portrait.twig' with {user: participant.user, description: participant.user.fullName} only %}
                        <p>{{ participant.user.firstname }} {{ participant.user.lastname }}</p>
                    </div>
                </div>
            </a>
        </div>
        {% if ackReceipt %}
            <div class="small-6 medium-4 columns no-pad component-action text-right">
                <a class="button" data-sobo data-assessment-due-at-unix="{{ assessment.dueAt.unixTimestamp }}"
                 title="Acknowledge receipt of student submission" href="{{ ackReceipt }}">
                    Mark as Submitted
                </a>
            </div>
        {% endif %}
    {% endif %}
</li>
