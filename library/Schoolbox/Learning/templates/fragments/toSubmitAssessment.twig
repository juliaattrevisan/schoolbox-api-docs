{#
    Renders an assessment to-chase section for the pending assessment page.
    In own fragment so we can render consistently for both visible items, and template for AJAX inserted fragments

    Data:
        assessment:      IAssessible
        stats:           Assessment\Statistics
        studentsToEmail: string[]               An array of student ids to email
        isTask:          bool                   (optional) Override to indicate to render as Task
        isQuiz:          bool                   (optional) Override to indicate to render as Quiz
        isDueWork:       bool                   (optional) Override to indicate to render as DueWork
#}
{% import 'sub/assessmentContext.twig' as assessmentContext %}
{% import '@learning/macro/dueDate.twig' as dueDate %}

{# Enable insertion of non IAssessable instance data transfer objects #}
{% set isTask    = isTask    ?? assessment is task %}
{% set isQuiz    = isQuiz    ?? assessment is quiz %}
{% set isDueWork = isDueWork ?? assessment is dueWork %}

{%- set icon  = isTask ? 'task' : (isQuiz ? 'quiz' : 'due-work') -%}
{%- set state = isQuiz ? 'unattempted' : 'unsubmitted' -%}

{%- if isQuiz %}
    {%- set submitTitleSuffix    = 'attempted this quiz' -%}
    {%- set markedTitleSuffix    = 'review' -%}
    {%- set noResultsTitleSuffix = 'attempted this quiz' -%}
    {% set markedPastTense = 'reviewed' %}
{%- elseif isDueWork %}
    {%- set submitTitleSuffix    = 'submitted work' -%}
    {%- set markedTitleSuffix    = 'marking' -%}
    {%- set noResultsTitleSuffix = 'submitted work or been marked' -%}
    {% set markedPastTense = 'marked' %}
{%- elseif isTask %}
    {%- set submitTitleSuffix    = 'completed this task' -%}
    {%- set markedTitleSuffix    = 'teacher assessment' -%}
    {%- set noResultsTitleSuffix = 'completed this task' -%}
    {% set markedPastTense = 'assessed' %}
{%- else -%}
    {% set submitTitleSuffix = '' -%}
    {% set markedTitleSuffix = '' -%}
    {% set markedPastTense = '' %}
{%- endif -%}

{# Round the percentage values to prevent things like '66.666666%' being displayed. #}
    {% set displayPercentageResponseRequired = (100 - stats.percentageResponseRequired) | round %}
    {% set displayPercentageReviewComplete = stats.percentageReviewComplete | round %}

<section data-assessment="{{ assessment.id }}" data-due-timestamp="{{ assessment.dueAt.unixTimeStamp }}">
    <div class="content collapsible">
        <div class="card small-8 medium-6 columns no-pad">
            {#- Dessicator -#}
            <span data-collapser="to-chase-{{ assessment.id }}" class="icon-down-arrow"></span>
            <i class="size-32 icon-{{ icon }}"></i>
            <div class="card-content">
                <h3>
                    {#- Dessicator -#}
                    <a data-title href="{{ routeLookup('learningAssessment.getStatus', { assessmentId: assessment.id }) }}">{{ assessment.title }}</a>
                    {#- Dessicator -#}
                </h3>
                <div data-crumbs>{{ assessmentContext.crumbs(assessment) }}</div>
                <p class="meta" data-due-date>{{ dueDate.forAssessment(assessment) }}</p>
            </div>
        </div>
        <div class="card medium-6">
            <div class="progress-bar"
                data-progress
                title="{{ stats.countParticipants - stats.countResponseRequired }} of {{ stats.countParticipants }} students have {{ submitTitleSuffix }}"
                data-title-suffix="{{ submitTitleSuffix }}"
                data-count-total="{{ stats.countParticipants }}"
                data-count-response-required="{{ stats.countResponseRequired }}"
                data-count-feedback-required="{{ stats.countFeedbackRequired }}"
                data-count-review-complete="{{ stats.countReviewComplete }}"
            />
                <div class="bar">
                    <div class="meter warning" style="width: {{ (100 - stats.percentageResponseRequired) }}%;">
                        <div>{{ displayPercentageResponseRequired }}%</div>
                    </div>
                    <div 
                        class="meter success" 
                        title="{{stats.countReviewComplete}} of {{stats.countParticipants}} students {{ markedPastTense }}" 
                        style="width: {{ stats.percentageReviewComplete }}%;"
                    >
                        <div>{{ displayPercentageReviewComplete }}%</div>
                    </div>
                </div>
                <div class="legend">
                    <div class="legend-item success">{{ stats.countReviewComplete }} {{ markedPastTense }}</div>
                    <div class="legend-item">{{ stats.countParticipants - stats.countResponseRequired }} OF {{ stats.countParticipants }} {{ submitTitleSuffix }}</div>
                    <div class="legend-item warning">{{ stats.countFeedbackRequired }} REQUIRE {{ markedTitleSuffix }}</div>
                </div>
            </div>
        </div>
    </div>
    <div class="content collapsible hide" data-participant-list data-collapsable="to-chase-{{ assessment.id }}" data-collapse-state="collapsed">
        <ul class="information-list">
            {% for participant in assessment.allParticipants | filter(participant => not participant.excluded) %}
                {% if participant.responseRequired %}
                    {% include '@learning/fragments/toSubmitParticipant.twig' with {
                        participant: participant,
                        assessment:  assessment
                    } only %}
                {% endif %}
            {% endfor %}
        </ul>
    </div>
    <div class="component-action" data-collapsable="to-chase-{{ assessment.id }}" data-collapse-state="collapsed" style="display: none;">
        <section>
            <form action="{{ routeLookupIfAuthorized('mail.postCreateMail') }}" method="post" class="no-margin">
                <div class="row">
                    <div class="small-12 columns">
                        <input type="hidden" name="subject" value="Overdue - {{ assessment.title }}"/>
                        <input type="hidden" name="folderId" value="{{ assessment.baseContext.folder.id }}"/>
                        <input data-email-students type="hidden" name="userIds" value="{{ studentsToEmail|join(',') }}"/>
                        <button type="submit" class="button">Email all</button>
                    </div>
                </div>
            </form>
        </section>
    </div>
</section>
