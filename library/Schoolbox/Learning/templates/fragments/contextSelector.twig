<script type="text/javascript">
    $(function() {

        {# Wire up context selector #}

        $('#context-selector-semester').change(function() {
            window.location.href = $('#context-selector-semester :selected').data('href');
        });

        $('#context-selector-enrolled-subjects').change(function() {
            window.location.href = $('#context-selector-enrolled-subjects :selected').data('href');
        });

        {# Wire up next/previous term buttons #}

        $("[data-interaction='next']").click(function(e) {
            e.preventDefault();

            var index = $('#context-selector-semester').prop('selectedIndex')

            if (index > 1) {
                var term = $('#context-selector-semester option').eq(index - 1);
                window.location.href = term.data('href');
            }
        });

        $("[data-interaction='previous']").click(function(e) {
            e.preventDefault();

            var index = $('#context-selector-semester').prop('selectedIndex')
            var term = $('#context-selector-semester option').eq(index + 1);

            if (term.data('href') !== undefined) {
                window.location.href = term.data('href');
            }
        });
    });
</script>

<div class="context-switch clearfix">
    <nav>
        <a data-interaction="previous" href="#"></a>
    </nav>
    <div class="semester">
        <select id="context-selector-semester">
            <option disabled {% if term is empty %}selected{% endif %} label="Select a term">Select a term</option>
            {% for termCurrent in terms %}
                <option data-href="{{ routeLookup('learning.getGrades', {studentId: student.id, termCode: termCurrent.code }) }}" value="{{ termCurrent.code }}" {% if term.code == termCurrent.code %}selected{% endif %}>
                    {{ termCurrent.title }} ({{ termCurrent.start.dateOnly }} - {{ termCurrent.displayFinish.dateOnly }})
                </option>
            {% endfor %}
        </select>
    </div>
    <nav>
        <a data-interaction="next" href="#"></a>
    </nav>
    <div class="subject">
        <select id="context-selector-enrolled-subjects">
            <option disabled="" selected="" label="Select a subject">Select a subject</option>
            {% for folder in folders %}
                <option data-href="{{ routeLookup('learning.getGradesForSubject', {studentId: student.id, termCode: term.code, subjectId: folder.id }) }}" {% if folder.id == subject.id %}selected{% endif %} value="{{ folder.id }}">{{ folder.name }} ({% for code in folder.codes %}{{ code.code }}{% if not loop.last %}, {% endif %}{% endfor %})</option>
            {% endfor %}
        </select>
    </div>
</div>