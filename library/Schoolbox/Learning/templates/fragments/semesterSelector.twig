{#
Usage:
    term:    Term                    - the current selected Term
    terms:   Collection|Term[]       - all Terms to render in dropdown
    student: User                    - the relevant student
#}

<script type="text/javascript">
    $(function() {

        var $semesterSelector = $('#context-selector-semester');
        var $options = $semesterSelector.find('option');

        {# Wire up context selector #}

        $semesterSelector.change(function() {
            window.location.href = $semesterSelector.find(':selected').data('href');
        });

        {# Wire up next/previous term buttons #}

        $("[data-semester-switch]").click(function(e) {
            e.preventDefault();

            var index = $semesterSelector.prop('selectedIndex');
            var newIndex = 'next' == $(this).data('semester-switch') ? index + 1 : index - 1;

            if(newIndex >= 1 && newIndex < $options.length){
                var term = $options.eq(newIndex);
                window.location.href = term.data('href');
            }
        });
    });
</script>

<nav>
    <a data-semester-switch="previous" href="#" {% if term.code == terms[0].code %}disabled{% endif %}></a>
</nav>
<div class="semester">
    <select id="context-selector-semester" title="Select a Term">
        <option disabled {% if term is empty %}selected{% endif %} label="Select a term">Select a term</option>
        {% for termCurrent in terms %}
            <option data-href="{{ routeLookup('learning.getGrades', {userId: student.id, termCode: termCurrent.code }) }}" value="{{ termCurrent.code }}" {% if term.code == termCurrent.code %}selected{% endif %}>
                {#- dessicate -#}{{ termCurrent.title }} ({{ termCurrent.start.dateOnly }} - {{ termCurrent.displayFinish.dateOnly }}){#- dessicate -#}
            </option>
        {% endfor %}
    </select>
</div>
<nav>
    <a data-semester-switch="next" href="#" {% if term.code == terms[terms | length - 1].code %}disabled{% endif %}></a>
</nav>
