{% if config.curriculum_tagging_enabled and (assessment.curriculumNodes | length) > 0 %}
    <ul class="meta">
        <li class="icon-curriculum">
            {%- for node in assessment.curriculumNodes | filter(node => node.enabled) %}
                {% if not loop.first %}, {% endif %}
                <span title="{{ node.name }}">{{ node.code }}
            {%- endfor %}
        </li>
    </ul>
{% endif %}