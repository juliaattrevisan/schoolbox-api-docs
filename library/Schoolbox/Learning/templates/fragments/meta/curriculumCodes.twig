{% if config.curriculum_tagging_enabled and (assessment.curriculumNodes | length) > 0 %}
<li id="curriculum-codes-container" class="icon-curriculum">
    <curriculum-codes
        :nodes="{{ assessment.getViewableCurriculumNodes.reindex|json_encode }}"
    />
</li>
<script src="{{ CDN_PREFIX }}/js/bundle/curriculumCodes.js?v={{ config.site_version }}"></script>
{% endif %}
