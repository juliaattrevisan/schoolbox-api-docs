{##
 # Lesson Plan View indicator
 #
 # This tells you what view you're in, when you're looking at a Lesson Plan
 # Staff can switch between student view and staff view
 #
 # @param LessonPlan\Model $assessment
 # @param \Schoolbox\User $student
 #}
{% if assessment is lessonPlan and USER.role.isStaff %}
    {% if assessment.visibility == 'student' %}
        <li data-has-student-view-meta></li>
    {% else %}
        <li><sbx-icon name="teacher" color="var(--sbx-color-text-secondary)"></sbx-icon> This {{ locale.lessonPlan }} is not visible to students.</li>
    {% endif %}
{% endif %}
