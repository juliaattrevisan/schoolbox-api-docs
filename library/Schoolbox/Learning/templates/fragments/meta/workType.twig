{% import '@learningAssessment/project/macro/icon.twig' as icon %}

{% if assessment.isSelfGradable ?? false %}
    {% set selfReflectSuffix = ' includes ' ~ locale.selfAssessment.proper %}
{% elseif assessment.isSelfReflectableOnly ?? false %}
    {% set selfReflectSuffix = ' includes ' ~ locale.selfReflection.proper %}
{% else %}
    {% set selfReflectSuffix = '' %}
{% endif %}

<li class="{{ icon.renderClass(assessment) }}">{{ assessment.typeName }}{{ selfReflectSuffix }}{% if assessment.weight %}, Weighting: {{ assessment.weight }}{% endif %}</li>
