{#
Usage:
    term:    Term                      - the current selected Term
    subject: Folder                    - the current selected Subject Folder
    folders: Collection|Folder[]       - the subjects to render in dropdown
    student: User                      - the relevant student
#}

<script type="text/javascript">
    $(function() {

        var $subjectSelector = $('#context-selector-subject');

        {# Wire up context selector #}
        $subjectSelector.change(function() {
            window.location.href = $subjectSelector.find(':selected').data('href');
        });
    });
</script>

<div class="subject">
    <select id="context-selector-subject" title="Select a subject">
        <option disabled="" selected="" label="Select a subject">Select a subject</option>
        {% for folder in folders %}
            <option data-href="{{ routeLookup('learning.getGradesForSubject', {userId: student.id, termCode: term.code, subjectId: folder.id }) }}" {% if folder.id == subject.id %}selected{% endif %} value="{{ folder.id }}">
                {#- dessicate -#}{{ folder.name }} ({% for code in folder.codes %}{{ code.code }}{% if not loop.last %}, {% endif %}{% endfor %}){#- dessicate -#}
            </option>
        {% endfor %}
    </select>
</div>
