{#
    Renders a participant to-mark in the assessments to-mark section of the pending assessment page
    In own template to enable AJAX insertion.

    Data:
        participant:  Participant
        assessment:   IAssessable
        isTask:       bool                   (optional) Override to indicate to render as Task
        isQuiz:       bool                   (optional) Override to indicate to render as Quiz
        isDueWork:    bool                   (optional) Override to indicate to render as DueWork
#}
{% import 'sub/assessmentResponse.twig' as assessmentResponse %}

{# Enable insertion of non IAssessable instance data transfer objects #}
{% set isTask = isTask ?? assessment is task %}
{% set isQuiz = isQuiz ?? assessment is quiz %}
{% set isDueWork = isDueWork ?? assessment is dueWork %}
{% set isDialogAgent = isDialogAgent ?? assessment is dialogAgent %}
{% set isReporting = isReporting ?? assessment is reporting %}

<li data-participant="{{ participant.user.id }}">
    {% if isDialogAgent %}
        {# Dialog Agents revovle around manual election of authoritative responses and authorititative feedbacks,
         # rather than the primitive idea of the most recent one of each that every other activity uses
         #}
        {% set response = participant.authoritativeResponse(true) %}

        <a class="link-row" href="{{ assessmentResponse.localUrl(response, response.assessable) }}" title="{{ assessmentResponse.reviewResponseTitle(response) }}">
            <div class="compact card small-12">
                <div>
                    {% include 'include/portrait.twig' with {user: participant.user, description: 'View submission'} only %}
                    <p>
                        {{ participant.user.fullName }}
                        <span class="pipe meta" title="{{ response.submittedAt.local }}">Submitted {{ response.submittedAt.relativeTime }}</span>
                    </p>
                </div>
            </div>
        </a>
    {% elseif isReporting %}
        {# TODO jezwords #}
        <a class="link-row" href="{{ assessmentResponse.localUrl(null, assessment) }}" title="">
            <div class="compact card small-12">
                <div>
                    {% include 'include/portrait.twig' with {user: participant.user, description: 'View submission'} only %}
                    <p>
                        {{ participant.user.fullName }}
                    </p>
                </div>
            </div>
        </a>
    {% else %}
        {% set response = participant.findMostRecentSubmittedResponse %}
        {% if isTask %}
            <div class="compact card small-11">
                <div>
                    {% include 'include/portrait.twig' with {user: participant.user, description: 'View submission'} only %}
                    <p>
                        {{ participant.user.fullName }}
                        <span class="pipe meta" title="{{ response.submittedAt.local }}">Submitted {{ response.submittedAt.relativeTime }}</span>
                    </p>
                </div>
            </div>
            <div class="small-1 columns no-pad">
                {# An icon that shows if the student has attempted the task or not #}
                {% include '@learningAssessment/fragments/progressTick.twig' with {
                    assessment:  assessment,
                    student: participant.user
                } only %}
            </div>
        {% elseif isQuiz %}
            {# Quiz Attempts could be in either Learnosity, or our legacy quiz system
             # Legacy Quiz attempts are not going to be in learnosity
             #
             # So if we have a learnosity_reference, make a link to learnosity feedback screen
             # Otherwise, prohibit the link; users won't be able to see legacy attempts anymore.
             # We might make a "museum" for these old attempts one day
            #}
            {% if response.learnosityReference %}
                {% set quizAttemptRoute = routeLookup('learnosity.getFeedback', {
                    assessmentId: response.assessable.id,
                    studentId: response.submittedBy.id,
                    learnositySessionReference: response.learnosityReference
                }) %}

                <a class="link-row" href="{{ quizAttemptRoute }}" title="{{ assessmentResponse.reviewResponseTitle(response) }}">
                    <div class="compact card small-12">
                        <div>
                            {% include 'include/portrait.twig' with {user: participant.user, description: 'View attempt'} only %}
                            <p>
                                {{ participant.user.fullName }}
                                <span class="pipe meta" title="{{ response.submittedAt.local }}">Submitted {{ response.submittedAt.relativeTime }}</span>
                            </p>
                        </div>
                    </div>
                </a>
            {% else %}
                {# Legacy Attempt; this goes nowhere, for now #}
                <div class="compact card small-12">
                    <div>
                        {% include 'include/portrait.twig' with {user: participant.user, description: 'View attempt'} only %}
                        <p>
                            {{ participant.user.fullName }}
                            <span class="pipe meta" title="{{ response.submittedAt.local }}">Submitted {{ response.submittedAt.relativeTime }}</span>
                        </p>
                    </div>
                </div>
            {% endif %}
        {% else %}
            {# Due Work, etc. #}
            <a class="link-row" href="{{ assessmentResponse.localUrl(response, response.assessable) }}" title="{{ assessmentResponse.reviewResponseTitle(response) }}">
                <div class="compact card small-12">
                    <div>
                        {% include 'include/portrait.twig' with {user: participant.user, description: 'View submission'} only %}
                        <p>
                            {{ participant.user.fullName }}
                            <span class="pipe meta" title="{{ response.submittedAt.local }}">Submitted {{ response.submittedAt.relativeTime }}</span>
                        </p>
                    </div>
                </div>
            </a>
        {% endif %}
    {% endif %}
</li>
