{#
Data:
    folder                 object    The folder object
    specialNeeds           string    A localised label for Special Needs
    replyTo                string    Current user's email address
    mailEnabled            bool      Config for whether mail is enabled
    learningMomentsEnabled bool      Config for whether learning moment creation is enabled
    emailGroups            array     Data for mail group checkboxes
#}

{% include '@learning/component/classLists/breadcrumbs.twig' %}

<div class="row" id="email-class-lists">
    <div class="small-12 island">
        {% block header %}
        <h1>${ subject }</h1>

            <ul class="flex-list buttons">
                <li><a href="#" class="disabled">Award Achievement</a></li>
                <li><a href="#" class="disabled">Set Goal(s)</a></li>
                {% if pastoralEnabled %}
                    <li><a @click.prevent="addPastoralRecord"
                           :class="{disabled: selectedStudentIds.length === 0}">Add Pastoral Record</a></li>
                {% endif %}
                {% if learningMomentsEnabled %}
                    <li><a @click.prevent="openShareLearningMomentDialog"
                           :class="{disabled: selectedStudentIds.length === 0}">Share Learning Moment</a></li>
                {% endif %}
                {% if mailEnabled %}
                    <li><a href="#" class="disabled">Email</a></li>
                {% endif %}
            </ul>

        <template v-if="showSkeletonLoader" v-for="n in 3">
            <div class="list-item">
                <div class="small-12 card skeleton">
                    <div class="img"></div>
                    <h3></h3>
                    <p class="meta"></p>
                </div>
            </div>
        </template>
        {% endblock %}

        <table id="contact-table" v-if="!showSkeletonLoader && studentLists.length">
            <thead>
            {% block table_header %}
            <tr>
                <th v-if="showCheckboxes">
                    <input type="checkbox" id="select-all" v-model="allSelected"/>
                    <label for="select-all" class="checkbox-label"></label>
                </th>
                <th></th>
                <th>Name</th>
                <th class="show-for-large-up">Year Level</th>
                <th class="show-for-medium-up">House</th>
                <th class="show-for-medium-up">Last Visited</th>
                <th></th>
            </tr>
            {% endblock %}
            </thead>
            <tbody>
                <template v-if="studentLists.length > 0">
                    <tr v-for="(student, index) in studentLists">
                        <td v-if="showCheckboxes">
                            <input type="checkbox" name="students[]" :id="'id-' + index" v-model="student.isChecked" />
                            <label :for="'id-' + index" class="checkbox-label"></label>
                        </td>
                        <td>
                            <img :src="'/portrait.php?id=' + student.id + '&size=square64'"
                                 :alt="student.lastname + ', ' + student.firstname">
                        </td>
                        <td>
                            <template v-if="student.id">
                                <a :href="'/search/user/' + student.id">${ student.lastname + ', ' + student.firstname }</a>
                            </template>
                            <template v-else>
                                ${ student.lastname + ', ' + student.firstname }
                            </template>
                            <span class="meta">(${ student.synergy_id })</span>
                            <span class="show-for-print"><br>${ student.email }</span>

                            {% block meta %}
                            <p class="meta">
                                <span v-if="student.EnglishSecondFlag == '1'" class="icon-eng-second-lang highlight"
                                      title="English as an Additional Language">
                                </span>
                                <span v-if="!hideMedicalAlerts && student.StudentSpecialNeedsFlag == '1'" class="icon-bell warning"
                                      :title="specialNeeds">
                                </span>
                                <span v-if="!hideMedicalAlerts && student.StudentMedicalAlert != ''" class="icon-alert alert"
                                      :title="'Medical Alert: ' + student.StudentMedicalAlert">
                                </span>
                            </p>
                            {% endblock %}

                            <ul data-dropdown-content class="f-dropdown" :id="'overflow' + student.id" v-if="student.id && Object.keys(student.routes).length">
                                {% block data_dropdown_content %}
                                <li v-for="element in student.routes">
                                    <a :href="element.href" :class="element.class" :title="element.title">${ element.label }</a>
                                </li>
                                {% endblock %}
                            </ul>
                        </td>
                        <td class="show-for-large-up">${ student.yearlevel }</td>
                        {% block tutor_group %}<td class="show-for-medium-up">${ student.house }</td>{% endblock %}
                        {% block core_group %}{% endblock %}
                        <td class="show-for-medium-up">${ student.lastAccessTime }</td>
                        <td class="no-pad">
                            <div class="actions-small-1" v-if="student.id && Object.keys(student.routes).length">
                                <nav>
                                    <a href="#" :data-dropdown="'overflow' + student.id" class="icon-more" title="Actions"></a>
                                </nav>
                            </div>
                        </td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>

    <div class="checklist small-12 island" v-if="! showSkeletonLoader && mailEnabled && studentLists.length">
        <div class="content clearfix" style="background-color: #FFF;">
            <ul class="inline-list no-margin left">
                <template v-for="(group, index) in groups">
                    <li v-bind:class="index < 1 ? 'no-margin' : ''">
                        <input :id="group.label"
                               name="groups[]"
                               type="checkbox"
                               :value="group.value"
                               v-model="group.isChecked" />
                        <label :for="group.label">${ group.label }</label>
                    </li>
                </template>
            </ul>
            <span class="right">
                <form ref="form" action="/mail/createMail.php" method="post" v-on:submit.prevent class="class-list-form">
                    <input type="hidden" name="replyto" :value="replyTo"/>
                    <input type="hidden" id="selectedIds" name="selectedIds" :value="selectedStudentExternalIds.join(',')" />
                    <input type="hidden" id="selectedGroups" name="selectedGroups" :value="selectedGroups.join(',')" />
                    <button type="submit" class="button icon-email" :disabled="! enableSendEmailButton" @click="sendEmail">${ sendEmailButtonText }</button>
                </form>
            </span>
        </div>
    </div>

    <div class="small-12 island" v-if="! showSkeletonLoader && !studentLists.length">
        <div class="empty-state">
            <i class="icon-class-list"></i>
            <p>Sorry, the system is unable to find any student in this class.</p>
        </div>
    </div>

    <template v-if="actionsPlaceholder">
        {#  Just a place holder. Cause currently when we remove this line, the actions doesn't work.
            Seems like when the page has loaded, foundation JS looks for this element right-away.
         #}
        <a href="#" data-dropdown="overflow" class="icon-more" title="Actions" style="display: none"></a>
    </template>
</div>

<div id="toaster" class="toast" data-toast></div>

<script src="/javascript/components/schoolbox-vue.min.js"></script>

{% autoescape 'js' %}
<script type="text/javascript">
    var postHeaders = {
        'X-Requested-With' : 'XMLHttpRequest',
    };

    var $toast = $('#toaster');

    var app = new Vue({
        el: '#email-class-lists',
        delimiters: ['${', '}'],
        data: {
            subjectName: '{{ folder.name }}',
            classCode: '{{ folder.codeString }}',
            replyToEmail: '{{ replyTo }}',
            mailEnabled: Boolean({{ mailEnabled }}),
            learningMomentsEnabled: Boolean({{ learningMomentsEnabled }}),
            specialNeeds: '{{ specialNeeds }}',
            hideMedicalAlerts: Boolean({{ config.protect_medicalspecial }}),
            studentLists: [],
            showSkeletonLoader: true,
            selectedStudents: [],
            studentsCheckboxElements: undefined,
            groups: {{ emailGroups | raw }},
            groupsCheckboxElements: [],
            sendEmailButtonDefaultText: 'Email Selected',
            sendEmailButtonText: null,
            getStudentListsEndpoint: '{{ routeLookup('learning.getStudentListByClassId', {folderId: folder.getId, folder: folder}) }}',
            formIsReady: false,
            actionsPlaceholder: true,
            loadingText: 'Please Wait...',
            noEmailsFoundText: 'Sorry we cannot send an email to the selected users as they do not have an email',
        },
        mounted: function() {
            var self = this;

            new Promise(function () {
                self.getStudents();
            });

            self.sendEmailButtonText = self.sendEmailButtonDefaultText;
        },
        methods: {
            getStudents: function () {
                var self = this;

                var studentLists;

                studentLists = new Promise(function (resolve) {
                    axios.get(self.getStudentListsEndpoint)
                        .then(function (response) {
                            // Set all students to checked by default
                            self.studentLists = response.data
                                .map(function (student) {
                                    student.isChecked = true;
                                    return student;
                                });
                            resolve();
                        })
                        .catch(function (error) {
                            console.log(error);
                        }).finally(function() {
                        self.showSkeletonLoader = false; // Hide skeleton loader and show class list table
                    });
                });

                studentLists.then(function() {
                    setTimeout(function() {
                        self.studentsCheckboxElements = document.getElementsByName('students[]');
                        self.groupsCheckboxElements = document.getElementsByName('groups[]');
                        self.actionsPlaceholder = false; // Remove actions placeholder once everything is ready
                    }, 100);
                });
            },
            sendEmail: function() {
                var self = this;

                // While the system is preparing the email lists, disable the button
                self.enableSendEmailButton = false;
                self.sendEmailButtonText = self.loadingText;
                this.$refs.form.submit();
            },
            addPastoralRecord: function () {
                window.location.href = '/pastoral/student/' + this.selectedStudentIds.shift() + '/record/insert?duplicates=' + this.selectedStudentIds.join(',');
            },
            openShareLearningMomentDialog: function() {
                // Set the form's target to the selected users
                $('#classList-shareLearningMoment-form')
                    .attr('action', '/learning/evidence/user/' + this.selectedStudentIds.join(',') + '/create');
                $('#classList-shareLearningMoment').foundation('reveal', 'open');
            },
        },
        computed: {
            replyTo: function() {
                return '"' + this.subject + '"' + ' <' + this.replyToEmail + '>';
            },
            subject: function() {
                return this.subjectName + ' (' + this.classCode + ')';
            },
            showCheckboxes: function() {
                return this.learningMomentsEnabled || this.mailEnabled;
            },
            allSelected: {
                get: function () {
                    return this.studentLists.every(function (student) {
                        return student.isChecked;
                    });
                },
                set: function (value) {
                    this.studentLists = this.studentLists.map(function (student) {
                        student.isChecked = value;
                        return student;
                    });
                }
            },
            selectedStudentIds: function () {
                let ids  = [],
                    self = this;
                self.studentLists.forEach(function (student) {
                    if (student.isChecked && student.id) {
                        ids.push(student.id);
                    }
                });
                return ids;
            },
            selectedStudentExternalIds: function () {
                let externalIds = [],
                    self        = this;
                self.studentLists.forEach(function (student) {
                    if (student.isChecked && student.synergy_id) {
                        externalIds.push(student.synergy_id);
                    }
                });
                return externalIds;
            },
            selectedGroups: function () {
                let groups = [],
                    self   = this;
                self.groups.forEach(function (group) {
                    if (group.isChecked) {
                        groups.push(group.value);
                    }
                });
                return groups;
            },
            enableSendEmailButton: function () {
                return this.selectedStudentExternalIds.length > 0 && this.selectedGroups.length > 0;
            },
        },
        filters: {
            capitalise: function (val) {
                if (!val) {
                    return '';
                }

                return val.replace(/(?:^|\s)\S/g, function(a) { return a.toUpperCase(); });
            }
        }
    });
</script>
{% endautoescape %}

<div data-reveal id="classList-shareLearningMoment" aria-hidden="true" class="reveal-modal small">
    <h2>Share a Learning Moment</h2>
    <form id="classList-shareLearningMoment-form" method="get">
        <input name="{{ RETURN_URL.name }}" value="{{ RETURN_URL.current }}" type="hidden" />
        <input type="radio"
               name="momentType"
               value="photo"
               id="classList-shareLearningMoment-momentType-photo">
        <label for="classList-shareLearningMoment-momentType-photo" class="block"><i class="icon-camera"></i>Take a photo</label>

        <input type="radio"
               name="momentType"
               value="video"
               id="classList-shareLearningMoment-momentType-video">
        <label for="classList-shareLearningMoment-momentType-video" class="block"><i class="icon-video"></i>Record a video</label>

        <input type="radio"
               name="momentType"
               value="audio"
               id="classList-shareLearningMoment-momentType-audio">
        <label for="classList-shareLearningMoment-momentType-audio" class="block"><i class="icon-audio"></i>Record audio</label>

        <input type="radio"
               name="momentType"
               value="upload"
               id="classList-shareLearningMoment-momentType-upload">
        <label for="classList-shareLearningMoment-momentType-upload" class="block"><i class="icon-upload"></i>Upload image or video</label>

        <input type="radio"
               name="momentType"
               value="text"
               id="classList-shareLearningMoment-momentType-text">
        <label for="classList-shareLearningMoment-momentType-text" class="block"><i class="icon-textbox"></i>Write something</label>

        <button id="classList-shareLearningMoment-shareWork-submit" type="submit">Continue</button>

    </form>
    <a class="close-reveal-modal" aria-label="Close">×</a>
</div>
