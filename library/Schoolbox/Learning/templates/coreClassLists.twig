{#
Data:
    folder                 object    The folder object
    specialNeeds           string    A localised label for Special Needs
    replyTo                string    Current user's email address
    mailEnabled            bool      Config for whether mail is enabled
    pastoralEnabled        bool      Config for whether pastoral care is enabled
    learningMomentsEnabled bool      Config for whether learning moment creation is enabled
    emailGroups            array     Data for mail group checkboxes
    houseLabel             string    A label for the house column (default: "House"). May be customised in child templates
    showHouseColumn        bool      Should the house column be shown (default: true)? May be customised in child templates
    showTutorGroupColumn   bool      Should the tutor group column be shown (default: false)? May be customised in child templates
    showCoreGroupColumn    bool      Should the core group column be shown (default: false)? May be customised in child templates
#}

{% include '@learning/component/classLists/breadcrumbs.twig' %}

{% set houseLabel           = houseLabel           ?? "House" %}
{% set showHouseColumn      = showHouseColumn      ?? true %}
{% set showTutorGroupColumn = showTutorGroupColumn ?? false %}
{% set showCoreGroupColumn  = showCoreGroupColumn  ?? false %}

<div class="row class-list" id="email-class-lists">
    <class-list
        subject-title="{{ folder.title }}"
        :class-code-list="{{ folder.codes | keys | json_encode }}"
        :learning-moments-enabled="Boolean({{ learningMomentsEnabled }})"
        :badges-enabled="Boolean({{ badgesEnabled }})"
        :pastoral-enabled="Boolean({{ pastoralEnabled }})"
        :mail-enabled="Boolean({{ mailEnabled }})"
        :current-user-can-email="Boolean({{ USER.hasEmail }})"
        pastoral-care-label="{{ locale.pastoralCare.proper }}"
        folder-id="{{ folder.id }}"
        special-needs-label="{{ specialNeeds }}"
        :show-house-column="Boolean({{ showHouseColumn }})"
        :show-tutor-group-column="Boolean({{ showTutorGroupColumn }})"
        :show-core-group-column="Boolean({{ showCoreGroupColumn }})"
        house-label="{{ houseLabel }}"
        :show-medical-alerts="!Boolean({{ config.protect_medicalspecial }})"
        :email-groups="{{ emailGroups }}"
        return-url-name="{{ returnUrlName }}"
        get-student-lists-endpoint="{{ routeLookup('learning.getStudentListByClassId', {folderId: folder.getId, folder: folder}) }}"
        get-students-pastoral-counts-url="{{ routeLookup('pastoral.getStudentsCount') }}"
        encoded-return-url="{{ encodedReturnUrl }}"
        get-award-as-achievement-form-endpoint="{{ routeLookup('learningBadgeAward.redirectToAwardAsAchievementForm') }}"
        get-set-as-goal-form-endpoint="{{ routeLookup('learningBadgeAward.redirectToSetAsGoalForm') }}"
        get-create-learning-moment-form-endpoint="{{ routeLookup('learningMomentEvidence.redirectToCreateForm') }}"
    >
        {% block classListSlots %}
        {% endblock classListSlots %}
    </class-list>
</div>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/classList.js?v={{ config.site_version }}"></script>

<div id="toaster" class="toast" data-toast></div>

{% if learningMomentsEnabled %}
    {% include '@learningMomentEvidence/shareModal.twig' with {
        id:                "classList-shareLearningMoment",
        baseUrl:           '',
        allowDynamicUsers: true,
    } only %}
{% endif %}
