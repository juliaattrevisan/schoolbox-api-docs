{#
Data:
    folder            object    The folder object
    specialNeeds      string    A localised label for Special Needs
    replyTo           string    Current user's email address
    mailEnabled       bool      Config for whether mail is enabled
    pastoralEnabled   bool      Config for whether pastoral is enabled
    today             string    Today's date
    mailHandle        string    Mail handler
    emailGroups       array     Data for mail group checkboxes
#}

{% include '@learning/component/classLists/breadcrumbs.twig' %}

<div class="row" id="email-class-lists">
    <div class="small-12 island">
        {% block header %}
        <h1>${ subject }</h1>
        <template v-if="showSkeletonLoader" v-for="n in 3">
            <div class="list-item">
                <div class="small-12 card skeleton">
                    <div class="img"></div>
                    <h3></h3>
                    <p class="meta"></p>
                </div>
            </div>
        </template>
        {% endblock %}

        <table id="contact-table" v-if="! showSkeletonLoader && studentLists.length">
            <thead>
            {% block table_header %}
            <tr>
                <th v-if="mailEnabled">
                    <input type="checkbox" id="select-all" @click="selectAllStudents" v-model="isAllSelected"/>
                    <label for="select-all" class="checkbox-label"></label>
                </th>
                <th></th>
                <th>Name</th>
                <th class="show-for-large-up">Year Level</th>
                <th class="show-for-medium-up">House</th>
                <th class="show-for-medium-up">Last Visited</th>
                <th></th>
            </tr>
            {% endblock %}
            </thead>
            <tbody>
                <template v-if="studentLists.length > 0">
                    <tr v-for="student in studentLists">
                        <td v-if="mailEnabled">
                            <input type="checkbox" name="students[]" :id="'id-' + student.synergy_id" :value="student.synergy_id"
                                   @click="select"/>
                            <label :for="'id-' + student.synergy_id" class="checkbox-label"></label>
                        </td>
                        <td>
                            <img :src="'/portrait.php?userId=' + student.synergy_id + '&size=square64'"
                                 :alt="student.lastname + ', ' + student.firstname"></a>
                        </td>
                        <td>
                            <template v-if="student.id">
                                <a :href="'/search/user/' + student.id">${ student.lastname + ', ' + student.firstname }</a>
                            </template>
                            <template v-else>
                                ${ student.lastname + ', ' + student.firstname }
                            </template>
                            <span class="meta">(${ student.synergy_id })</span>
                            <span class="show-for-print"><br>${ student.email }</span>

                            {% block meta %}
                            <p class="meta">
                                <span v-if="student.EnglishSecondFlag == '1'" class="icon-eng-second-lang highlight"
                                      title="English as a second language">
                                </span>
                                <span v-if="student.StudentSpecialNeedsFlag == '1'" class="icon-bell warning"
                                      :title="specialNeeds">
                                </span>
                                <span v-if="student.StudentMedicalAlert != ''" class="icon-alert alert"
                                      :title="'Medical Alert: ' + student.StudentMedicalAlert">
                                </span>
                            </p>
                            {% endblock %}

                            <ul data-dropdown-content class="f-dropdown" :id="'overflow' + student.id" v-if="student.id">
                                {% block data_dropdown_content %}
                                <li>
                                    <a :href="student.routes.duework" class="icon-due-work">${ linkTitle.dueWork | capitalise }</a>
                                </li>
                                <li>
                                    <a :href="student.routes.grades" class="icon-approve">${ linkTitle.grades | capitalise }</a>
                                </li>
                                <li v-if="student.ePortfolioIsEnabled">
                                    <a :href="'/eportfolio/' + student.id + '/profile'" class="icon-eportfolio">${ linkTitle.ePortfolio }</a>
                                </li>
                                <li v-if="student.routes.pastoral.length">
                                    <a :href="student.routes.pastoral" class="icon-pastoral">${ linkTitle.pastoralCare | capitalise }</a>
                                </li>
                                <li>
                                    <a :href="calendarPath + '/' + student.id" class="icon-calendar">${ linkTitle.calendar | capitalise }</a>
                                </li>
                                <li v-if="!student.timetableIsHidden">
                                    <a :href="/timetable/+ student.id" class="icon-timetable">${ linkTitle.timetable | capitalise }</a>
                                </li>
                                <li v-if="student.email && mailEnabled">
                                    <a :href="mailHandle + student.email" class="icon-mail" title="Send Email">${ linkTitle.email | capitalise }</a>
                                </li>
                                {% endblock %}
                            </ul>
                        </td>
                        <td class="show-for-large-up">${ student.yearlevel }</td>
                        {% block tutor_group %}<td class="show-for-medium-up">${ student.house }</td>{% endblock %}
                        {% block core_group %}{% endblock %}
                        <td class="show-for-medium-up">${ student.lastAccessTime }</td>
                        <td class="no-pad">
                            <div class="actions-small-1" v-if="student.id">
                                <nav>
                                    <a href="#" :data-dropdown="'overflow' + student.id" class="icon-more" title="Actions"></a>
                                </nav>
                            </div>
                        </td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>

    <div class="checklist small-12 island" v-if="! showSkeletonLoader && mailEnabled && studentLists.length">
        <div class="content clearfix" style="background-color: #FFF;">
            <ul class="inline-list no-margin left">
                <template v-for="(group, index) in groups">
                    <li v-bind:class="index < 1 ? 'no-margin' : ''">
                        <input :id="group.label" name="groups[]" type="checkbox" :value="group.label" @click="updateSelectedGroups" v-model="group.isChecked" />
                        <label :for="group.label">${ group.label | capitalise }</label>
                    </li>
                </template>
            </ul>
            <span class="right">
                <form ref="form" action="/mail/createMail.php" method="post" v-on:submit.prevent class="class-list-form">
                    <input type="hidden" name="replyto" :value="replyTo"/>
                    <input type="hidden" name="bcc" v-model="emailLists.join(emailDelimiter)" />
                    <button type="submit" class="button icon-email" :disabled="! enableSendEmailButton" @click="sendEmail">${ sendEmailButtonText }</button>
                </form>
            </span>
        </div>
    </div>

    <div class="small-12 island" v-if="! showSkeletonLoader && !studentLists.length">
        <div class="empty-state">
            <i class="icon-class-list"></i>
            <p>Sorry, the system is unable to find any student in this class.</p>
        </div>
    </div>

    <template v-if="actionsPlaceholder">
        {#  Just a place holder. Cause currently when we remove this line, the actions doesn't work.
            Seems like when the page has loaded, foundation JS looks for this element right-away.
         #}
        <a href="#" data-dropdown="overflow" class="icon-more" title="Actions" style="display: none"></a>
    </template>
</div>

<div id="toaster" class="toast" data-toast></div>

<script src="/javascript/components/schoolbox-vue.min.js"></script>

{% autoescape 'js' %}
<script type="text/javascript">
    var postHeaders = {
        'X-Requested-With' : 'XMLHttpRequest',
    };

    var $toast = $('#toaster');

    var app = new Vue({
        el: '#email-class-lists',
        delimiters: ['${', '}'],
        data: {
            subjectName: '{{ folder.name }}',
            classCode: '{{ folder.codeString }}',
            replyToEmail: '{{ replyTo }}',
            mailEnabled: Boolean({{ mailEnabled }}),
            specialNeeds: '{{ specialNeeds }}',
            studentLists: [],
            showSkeletonLoader: true,
            isAllSelected: false,
            selectedStudentIds: [],
            studentsCheckboxElements: undefined,
            groups: {{ emailGroups | raw }},
            groupsCheckboxElements: [],
            selectedGroups: [],
            enableSendEmailButton: false,
            sendEmailButtonDefaultText: 'Email Selected',
            sendEmailButtonText: null,
            emailLists: [],
            emailDelimiter: String.fromCharCode(30),
            classListsEndpointPrefix: '/subject/classList/ajax/',
            getStudentListsEndpoint: '{{ routeLookup('learning.getStudentListByClassId', {folderId: folder.getId, folder: folder}) }}',
            formIsReady: false,
            linkTitle: {
                'dueWork':      '{{ locale.dueWork }}',
                'grades':       '{{ locale.grades.plural }}',
                'pastoralCare': '{{ locale.pastoralCare.proper }}',
                'calendar':     '{{ locale.calendar }}',
                'ePortfolio':   'ePortfolio',
                'timetable':    'Timetable',
                'email':        'Email',
            },
            calendarPath: '{{ '/calendar/' ~ today }}',
            pastoralIsEnabled: Boolean({{ pastoralEnabled }}),
            mailHandle: '{{ mailHandle }}',
            actionsPlaceholder: true,
            loadingText: 'Please Wait...',
            noEmailsFoundText: 'Sorry we cannot send an email to the selected users as they do not have an email',
        },
        mounted: function() {
            var self = this;

            new Promise(function () {
                self.getStudents();
            });

            self.sendEmailButtonText = self.sendEmailButtonDefaultText;
        },
        methods: {
            getStudents: function () {
                var self = this;

                var studentLists;

                studentLists = new Promise(function (resolve) {
                    axios.get(self.getStudentListsEndpoint)
                        .then(function (response) {
                            self.studentLists = response.data;
                            resolve();
                        })
                        .catch(function (error) {
                            console.log(error);
                        }).finally(function() {
                        self.showSkeletonLoader = false; // Hide skeleton loader and show class list table
                    });
                });

                studentLists.then(function() {
                    setTimeout(function() {
                        self.studentsCheckboxElements = document.getElementsByName('students[]');
                        self.groupsCheckboxElements = document.getElementsByName('groups[]');
                        self.actionsPlaceholder = false; // Remove actions placeholder once everything is ready

                        $.each(self.groupsCheckboxElements, function (index, element) {
                            if (element.checked) {
                                self.selectedGroups.push(element.value);
                            }
                        });

                        self.selectAllStudents();
                    }, 100);
                });
            },
            fetchEmails: function (event) {
                var self = this;

                var endpoint = '';

                var promises = [];

                self.emailLists = [];

                // While the system is preparing the email lists, disable the button
                self.enableSendEmailButton = false;

                self.sendEmailButtonText = self.loadingText;

                // Prepare endpoints to requests. Loop through the selected groups.
                // We need to do this for now as our endpoints to fetch email addresses are designed this way.
                // TODO: Re-architect fetching of email address to prevent doing this
                $.each(self.selectedGroups, function(index, groupname) {
                    switch(groupname) {
                        case 'students':
                            endpoint = 'emailStudentsById.php';
                            break;
                        case 'parents':
                            endpoint = 'emailParentsById.php';
                            break;
                        case 'housemasters':
                            endpoint = 'emailHousemastersById.php';
                            break;
                    }

                    promises.push(self.requestData(event, endpoint));
                });

                Promise.all(promises).then(function() {
                    if (self.emailLists.length) {
                        // Once all the requests are done, set the ready flag to true.
                        // The watcher will then trigger the submit
                        // More for watchers: https://vuejs.org/v2/guide/computed.html#Watchers
                        self.formIsReady = true;
                    } else {
                        self.enableSendEmailButton = true;
                        self.sendEmailButtonText = self.sendEmailButtonDefaultText;
                        $toast.toastActivate();
                        $toast.toastTimeout({text: self.noEmailsFoundText, duration: 6000, css: 'alert'});
                    }
                }).catch(function(e) {
                    console.log(e);
                });
            },
            requestData: function(event, endpoint) {
                var self = this;

                if (endpoint !== '') {
                    return axios.post(self.classListsEndpointPrefix + endpoint,
                        {classCode: self.classCode, allIds: self.selectedStudentIds},
                        {headers: postHeaders})
                        .then(function (response) {
                            if (response.data[0].length > 0) {
                                self.emailLists.push(response.data);
                            }
                        })
                        .catch(function (error) {
                            console.log(error);
                        });
                }
            },
            selectAllStudents: function(event) {
                var self = this;
                var isChecked = (event === undefined || event.target.checked);

                self.selectedStudentIds = [];

                $.each(self.studentsCheckboxElements, function (index, element) {
                    element.checked = isChecked;
                    if (isChecked) {
                        self.selectedStudentIds.push(element.value);
                    }
                });

                self.updateSendEmailButtonState();

                self.isAllSelected = isChecked;
            },
            select: function(event) {
                var self = this;

                // If selected, add the student ids into the array. Otherwise, just remove the id
                if (event.target.checked) {
                    self.selectedStudentIds.push(event.target.value);
                } else {
                    self.selectedStudentIds.splice(self.selectedStudentIds.indexOf(event.target.value), 1);
                }

                // Check whether all the students are selected. If so make the select all checkbox ticked
                if (self.selectedStudentIds.length < self.studentsCheckboxElements.length) {
                    this.isAllSelected = false;
                } else {
                    self.isAllSelected = true;
                }

                self.updateSendEmailButtonState();
            },
            sendEmail: function(event) {
                var self = this;

                self.fetchEmails();
            },
            updateSelectedGroups: function(event)
            {
                var self = this;

                if (!self.groupsCheckboxElements) {
                    return;
                }

                if (event.target.checked) {
                    self.selectedGroups.push(event.target.value);
                } else {
                    self.selectedGroups.splice(self.selectedGroups.indexOf(event.target.value), 1);
                }

                self.updateSendEmailButtonState();
            },
            updateSendEmailButtonState: function()
            {
                var self = this;

                self.enableSendEmailButton = self.selectedStudentIds.length > 0 && self.selectedGroups.length > 0;
            },
        },
        computed: {
            replyTo: function() {
                return '"' + this.subject + '"' + ' <' + this.replyToEmail + '>';
            },
            subject: function() {
                return this.subjectName + ' (' + this.classCode + ')';
            }
        },
        watch: {
            formIsReady: function(val) {
                this.$refs.form.submit();
            }
        },
        filters: {
            capitalise: function (val) {
                if (!val) return '';

                return val.replace(/(?:^|\s)\S/g, function(a) { return a.toUpperCase(); });
            }
        }
    });
</script>
{% endautoescape %}
