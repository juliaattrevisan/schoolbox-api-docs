{% import '@learning/macro/urgency.twig' as urgency %}

{% if currentFile.plagscan %}
    <p class="meta">
        {% if currentFile.plagscan.isComplete %}
            <a href="{{ routeLookup('learningResponse.getPlagscanReport', {plagscanId: currentFile.plagscan.id }) }}">
                <span class="{{ urgency.plagscan(currentFile.plagscan.score|purify) }}">{{ currentFile.plagscan.score|purify }}</span>
                <span class="meta" title="Plagiarism check completed.">plagiarised</span>
            </a>
        {% elseif currentFile.plagscan.isProcessing %}
            <span class="meta" title="Plagiarism check is currently processing - check back again soon.">Processing</span>
        {% elseif currentFile.plagscan.isPending %}
            <span class="meta" title="Plagiarism check is pending.">Pending</span>
        {% endif %}
    </p>
{% endif %}