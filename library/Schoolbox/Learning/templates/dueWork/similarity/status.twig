{##
 # Similarity Check Status Factory
 #
 # Decide which of the apis (if any) to use for the Similarity Check rendering
 # and reporting links
 #
 # Note that a set of user/config policies determine availability of Similarity Reports
 # These are checked inside Plag mapper and Turnitin Mapper isEnabled()
 #
 # @param bool $turnitinApiEnabled              A bool declaring whether Turnitin was configured adequately
 # @param IAssessable $assessment               An assessment instance (typically a due work)
 # @param IResponse $response                   A response instance (what the student submitted)
 # @param Participant $participant              The participating student
 # @param SingleFile\Model $currentFile         A student submission file instance (Schoolbox\Assessment\Component\SubmissionBox\Submission\SingleFile)
 #}

{# If the similarity report policy vars allow you to see further,
 # try and figure out which tool to use: turnitin, plag, or neither
 #}
{% if turnitinApiEnabled %}
    {# Historical turnitin records don't have a report
     # We only display turnitin reports for non-historical turnitin records
     # Historical documents should fall back to plagscan
     #}
    {% if currentFile.turnitin and not currentFile.turnitin.historical %}
        {# If the turnitin api was configured then assume we're using that
         # unless there is no turnitin file, then check if there is a plagscan file
         #}
        {% include '@learning/dueWork/turnitin/status.twig' with {
            assessment:   assessment,
            response:     response,
            participant:  participant,
            currentFile:  currentFile
        } only %}
    {% elseif currentFile.plagscan %}
        {# if turnitin is enabled, plag will be disabled (most likely),
         # but if there is no turnitin file. Check if there is an old plag file
         # if that file does exist, display it for historical reasons
         #}
        {% include '@learning/dueWork/plagscan/status.twig' with {
            currentFile: currentFile
        } %}
    {% endif %}
{% endif %}

{# You might not be using either similiarity checkers; do nothing,
 # I don't care if there are old plag files, nothing is enabled, show nothing.
 #}
