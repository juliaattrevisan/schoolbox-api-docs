{##
 # Turnitin report status
 #
 # @param IAssessable $assessment               An assessment instance (typically a due work)
 # @param IResponse $response                   A response instance (what the student submitted)
 # @param Participant $participant              The participating student
 # @param SingleFile\Model $currentFile         A student submission file instance (Schoolbox\Assessment\Component\SubmissionBox\Submission\SingleFile)
 #}

{##
 # Decide Urgency of a Similarity Check percentage
 #
 # $value represents how much of the document was plagiarised
 # so a high percentage means a lot was copied from somewhere
 #}
{% macro similarity(value) %}
{% apply spaceless %}
    {% set numericValue = value|replace({'%': ''})|round %}
    {% if numericValue >= 75 %}
        turnitin-red
    {% elseif numericValue >= 50 %}
        turnitin-orange
    {% elseif numericValue >= 25 %}
        turnitin-yellow
    {% elseif numericValue >= 1 %}
        turnitin-green
    {% elseif numericValue == 0 %}
        turnitin-blue
    {% endif %}
{% endapply %}
{% endmacro %}

{% if currentFile.turnitin %}
<p class="meta">
    {# Only provide links to turnitin reports which generated
     # Historical Turnitin records won't have a report
     #}
    {% if currentFile.turnitin.hasReport %}
        {% set reportRoute = routeLookupIfAuthorized('learningDueWorkResponse.getTurnitinReport', {
            assessmentId: assessment.id,
            assessment:   assessment,
            responseId:   response.id,
            response:     response,
            participant:  participant,
            turnitinSubId:   currentFile.turnitin.getTurnitinSubmissionId })
        %}
        {% if reportRoute %}
            <a href="{{ reportRoute }}">
                <span class="{{ _self.similarity(currentFile.turnitin.overallMatchPercentage|purify) }}">{{ currentFile.turnitin.overallMatchPercentage|purify }}% </span>
                <span title="Similarity check completed.">similar content</span>
            </a>
        {% else %}
            <span class="{{ _self.similarity(currentFile.turnitin.overallMatchPercentage|purify) }}">{{ currentFile.turnitin.overallMatchPercentage|purify }}% </span>
            <span title="Similarity check completed.">similar content</span>
        {%  endif %}
    {% elseif currentFile.turnitin.isProcessing %}
        <span title="Similarity check is currently processing - check back again soon.">Calculating similarity...</span>
    {% elseif currentFile.turnitin.isPending %}
        <span title="Similarity check has been queued for processing and is pending being sent">Similarity check pending</span>
    {% elseif currentFile.turnitin.isError %}
        <span title="Similarity check is unavailable.">Unable to calculate similarity score.</span>
        <span class='hint has-tip tip-top' title="{{ currentFile.turnitin.humanReadableError }}" data-tooltip>?</span>
    {% endif %}
</p>
{% endif %}
