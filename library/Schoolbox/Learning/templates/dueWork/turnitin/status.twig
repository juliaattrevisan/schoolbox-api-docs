{##
 # Turnitin report status
 #
 # @param IAssessable $assessment               An assessment instance (typically a due work)
 # @param IResponse $response                   A response instance (what the student submitted)
 # @param Participant $participant              The participating student
 # @param SingleFile\Model $currentFile         A student submission file instance (Schoolbox\Assessment\Component\SubmissionBox\Submission\SingleFile)
 #}
{% import '@learning/macro/urgency.twig' as urgency %}

<p class="meta">
    {% if currentFile.turnitin.isComplete %}
        {% set reportRoute = routeLookupIfAuthorized('learningDueWorkResponse.getTurnitinReport', {
            assessmentId: assessment.id,
            assessment:   assessment,
            responseId:   response.id,
            response:     response,
            participant:  participant,
            turnitinId:   currentFile.turnitin.id })
        %}
        {% if reportRoute %}
            <a href="{{ reportRoute }}">
                <span class="{{ urgency.plagscan(currentFile.turnitin.overallMatchPercentage|purify) }}">{{ currentFile.turnitin.overallMatchPercentage|purify }}% </span>
                <span title="Similarity check completed.">similar content</span>
            </a>
        {% else %}
            <span class="{{ urgency.plagscan(currentFile.turnitin.overallMatchPercentage|purify) }}">{{ currentFile.turnitin.overallMatchPercentage|purify }}% </span>
            <span title="Similarity check completed.">similar content</span>
        {%  endif %}
    {% elseif currentFile.turnitin.isProcessing %}
        <span title="Similarity check is currently processing - check back again soon.">Calculating similarity...</span>
    {% elseif currentFile.turnitin.isPending %}
        <span title="Similarity check has been queued for processing and is pending being sent">Similarity check pending</span>
    {% elseif currentFile.turnitin.isError %}
        <span title="Similarity check is unavailable.">Similarity check unavailable</span>
        <span class='hint has-tip tip-top' title="Similarity check is unavailable. Most likely this type of file cannot be checked for similarity, or the system is not configured." data-tooltip="">?</span>
    {% endif %}
</p>