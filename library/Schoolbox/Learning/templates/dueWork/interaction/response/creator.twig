<div class="list-item">
    <div class="card small-12">
        <a href="/search/user/{{ student.id }}" title="View Profile">
            {% include 'include/portrait.twig' with {user: student, description: student.fullname, class: 'hide-for-small-only'} %}
            <p>{{ student.fullname }}</p>
            <p class="meta">
            {% if currentInteraction.submitted %}
                Submitted {{ currentInteraction.submittedAt.short }}
            {% else %}
                (Draft &ndash; last updated {{ currentInteraction.updatedAt.short }})
            {% endif %}
            </p>
        </a>
    </div>
</div>
{% set deleteRoute = routeLookupIfAuthorized(
    'learningDueWorkResponse.deleteParticularResponse',
    {
        assessmentId: assessment.id,
        assessment: assessment,
        responseId: currentInteraction.id,
        response: currentInteraction,
    }
    ) %}
{% if deleteRoute %}
<nav>
    <a class="icon-delete" data-delete="{{ deleteRoute }}"></a>
</nav>
{% endif %}
