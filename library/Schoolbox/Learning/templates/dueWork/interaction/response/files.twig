<div class="card attachment small-12">
    <a href="/storage/fetch.php?hash={{ currentFile.hash }}&save=1" title="{{ currentFile.filename }}">
        <img src="/ajax/mime/{{ currentFile.mime }}" alt="Download" />
        <p>{{ currentFile.filename }} | <span class="meta">Download</span></p>

        {% include '@learning/dueWork/plagscan/status.twig' with {
            currentFile: currentFile,
            plagscanEnabled: plagscanEnabled,
            assessment: assessment,
            assessmentId: assessmentId,
            participant: participant,
            response: response,
            plagscanId: plagscanId
        } only %}
    </a>
</div>

