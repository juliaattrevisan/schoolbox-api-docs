<li class="actions-small-1">
    {% if currentFile.editableInline %}
        {% set previewHref = routeLookupIfAuthorized(
            'learningDueWorkResponse.getResponseFileInline',
            {
                assessment: assessment,
                assessmentId: assessment.id,
                student: participant.user,
                studentId: participant.user.id,
                response: response,
                responseId: response.id,
                file: currentFile,
                fileId: currentFile.id,
            }
        ) %}
        {% set downloadHref = previewHref ~ '?save=true' %}
    {% else %}
        {% set downloadHref = routeLookupIfAuthorized('learningDueWorkResponse.getResponseFileDownload', {
            assessment: assessment,
            assessmentId: assessment.id,
            student: participant.user,
            studentId: participant.user.id,
            response: response,
            responseId: response.id,
            file: currentFile,
            fileId: currentFile.id,
        }) %}
        {% set previewHref = downloadHref %}
    {% endif %}
    <div class="list-item">
        <div class="card attachment small-12">
            <a href="{{ previewHref }}" title="{{ currentFile.filename }}" data-plugin="preview" data-test="assessment-summary-files-list-file">
                <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" />
                <p>{{ currentFile.filename }}</p>
            </a>
            {% include '@learning/dueWork/similarity/status.twig' with {
                turnitinApiEnabled: turnitinApiEnabled,
                assessment: assessment,
                participant: participant,
                response: response,
                currentFile: currentFile
            } only %}
        </div>
    </div>
    <nav>
        <a href="{{ downloadHref }}?save=1" class='icon-download' title="Download"></a>
    </nav>
</li>
