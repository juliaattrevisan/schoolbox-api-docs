<div class="list-item">
    <div class="card small-12 compact">
        <a href="/storage/fetch.php?hash={{ currentFile.hash }}" title="{{ currentFile.filename }}" rel="external" data-plugin="preview">
            <img src="/ajax/mime/{{ currentFile.mime }}" alt="Preview" class="mime" />
            <p>{{ currentFile.filename }}</p>

            {% include '@learning/dueWork/plagscan/status.twig' with {currentFile: currentFile, plagscanEnabled: plagscanEnabled} %}
        </a>
    </div>
</div>
<nav>
    <a href="/storage/fetch.php?hash={{ currentFile.hash }}" class='icon-download' title="Download original"></a>
</nav>
