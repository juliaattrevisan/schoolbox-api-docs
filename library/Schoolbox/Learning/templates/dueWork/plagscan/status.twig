{##
 # currentFile      an instance of duework/submission/file with plagscan instance joined
 #}

{##
 # Decide Urgency of a Similarity Check percentage
 #
 # $value represents how much of the document was plagiarised
 # so a high percentage means a lot was copied from somewhere
 #
 # Status of -1 should be hidden entirely, and the default
 # thresholds are 60, 20 and 0 (represented in red, orange,
 # and green respectively)
 #}
{% macro similarity(value) %}
{% apply spaceless %}
    {% set numericValue = value|replace({'%': ''}) %}
    {% if numericValue > 60 %}
        plagscan-critical
    {% elseif numericValue > 20 %}
        plagscan-warning
    {% elseif numericValue > 0 %}
        plagscan-ok
    {% endif %}
{% endapply %}
{% endmacro %}

{% if currentFile.plagscan %}
    <p class="meta">
        {% if currentFile.plagscan.isComplete %}
            {% set plagscanReport = routeLookupIfAuthorized('learningDueWorkResponse.getPlagscanReport', {
                assessmentId: assessment.id,
                assessment:   assessment,
                responseId:   response.id,
                response:     response,
                participant:  participant,
                plagscanId:   currentFile.plagscan.plagscanId}
            ) %}
            {% if plagscanReport %}
                <a href="{{ plagscanReport }}">
                    <span class="{{ _self.similarity(currentFile.plagscan.score|purify) }}">{{ currentFile.plagscan.score|purify }}% </span>
                    <span title="Similarity check completed.">similar content</span>
                </a>
            {% else %}
                <span class="{{ _self.similarity(currentFile.plagscan.score|purify) }}">{{ currentFile.plagscan.score|purify }}% </span>
                <span title="Similarity check completed.">similar content</span>
            {%  endif %}
        {% elseif currentFile.plagscan.isProcessing %}
            <span title="Similarity check is currently processing - check back again soon.">Calculating similarity...</span>
        {% elseif currentFile.plagscan.isPending %}
            <span title="Similarity check has been queued for processing and is pending being sent">Similarity check pending</span>
        {% elseif currentFile.plagscan.isUnscannable %}
            <span title="Similarity check is unavailable.">Similarity check unavailable</span>
            <span class='hint has-tip tip-top' title="Similarity check is unavailable. Most likely this type of file cannot be checked for similarity, or the system is not configured." data-tooltip="">?</span>
        {% endif %}
    </p>
{% endif %}
