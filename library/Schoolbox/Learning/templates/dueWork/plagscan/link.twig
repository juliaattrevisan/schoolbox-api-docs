{##
 # assessment   an IAssessable instance containing id
 # response     an IResponse instance containing id
 # plagscan     a Plagscan\Model instance containing plagscan_id
 # participant  a Participant instance
 #}

{% if plagscan.isComplete ?? false %}
<a href="{{ routeLookupIfAuthorized('learningDueWorkResponse.getPlagscanReport', {
    assessmentId: assessment.id,
    assessment:   assessment,
    responseId:   response.id,
    response:     response,
    participant:  participant,
    plagscanId:   plagscan.plagscanId }) }}"
   class="icon-due-work" title="Similarity Report"></a>
{% endif %}
