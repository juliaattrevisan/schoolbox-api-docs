{##
 # Gets classname for due work/quiz mark indicator
 #}
{% macro indicator(participant, hasDraft) %}
{% apply spaceless %}
    {% if hasDraft %}
        pending
    {% elseif participant.resubmissionRequired %}
        resubmit
    {% elseif participant.hasPublishedFeedback %}
        published
    {% else %}
        none
    {% endif %}
{% endapply %}
{% endmacro %}

{##
 # Gets title for due work/quiz mark indicator
 #}
{% macro notchTitle(participant, hasDraft) %}
{% apply spaceless %}
    {% if hasDraft %}
        Unpublished draft
    {% elseif participant.resubmissionRequired %}
        Resubmit
    {% elseif participant.hasPublishedFeedback %}
        Mark Published
    {% else %}
        Unmarked
    {% endif %}
{% endapply %}
{% endmacro %}

{##
 # Gets label for due work/task/quiz/project mark
 #}
{% macro label(participant, isPublished, useInstructorMark) %}
{% apply spaceless %}
    {% if participant.hasSubmittedResponse and (not participant.hasPublishedFeedback and isPublished) %}
        Pending
    {% elseif useInstructorMark %}
        {{ participant.humanReadableInstructorMark(isPublished) | default('–') }}
    {% else %}
        {{ participant.humanReadableMark(isPublished) | default('–') }}
    {% endif %}
{% endapply %}
{% endmacro %}
