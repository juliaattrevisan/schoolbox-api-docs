{##
 # Gets classname for due work/quiz mark indicator
 #}
{% macro indicator(participant, hasDraft) %}
{% spaceless %}
    {% if hasDraft %}
        pending
    {% elseif participant.resubmissionRequired %}
        resubmit
    {% elseif participant.hasPublishedFeedback %}
        published
    {% else %}
        none
    {% endif %}
{% endspaceless %}
{% endmacro %}

{##
 # Gets title for due work/quiz mark indicator
 #}
{% macro notchTitle(participant, hasDraft) %}
{% spaceless %}
    {% if hasDraft %}
        Unpublished draft
    {% elseif participant.resubmissionRequired %}
        Resubmit
    {% elseif participant.hasPublishedFeedback %}
        Mark Published
    {% else %}
        No mark
    {% endif %}
{% endspaceless %}
{% endmacro %}

{##
 # Gets label for due work/quiz mark
 #}
{% macro label(participant, isPublished) %}
{% spaceless %}
    {% if participant.hasSubmittedResponse and not participant.hasPublishedFeedback %}
        Pending
    {% else %}
        {{ participant.humanReadableMark(isPublished) | default('–') }}
    {% endif %}
{% endspaceless %}
{% endmacro %}
