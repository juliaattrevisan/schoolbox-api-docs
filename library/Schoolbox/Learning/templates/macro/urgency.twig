{##
 # Get css classname representing gradient
 #
 # This represents a colour shift in the due date from green
 # (you have 10+ days to create responses) to red (you have
 # run out of time to create responses)
 #}
{% macro datetime(participant) %}
    {% spaceless %}
        {# Only due works have an acceptOnline option; all other assessment types are accept online by default #}
        {% set acceptOnline = participant.plan.assessable.acceptOnline|default(true) %}

        {# Datetime urgency only has meaning to the logged-in user #}
        {% if participant.user.id == USER.id and participant.submittedResponses|length == 0 %}
            {% set currentTimestamp = NOW.unixTimestamp %}
            {% set urgency = (participant.dueDate.unixTimestamp - currentTimestamp) / 86400 %}

            {# Only show the color coding if the assessment accepts online submission OR it is not yet overdue #}
            {# Have to look at due date, not late date, because an assessment without online submission doesn't have a late date #}
            {% set overdue = participant.dueDate.unixTimestamp < currentTimestamp %}

            {% if acceptOnline or not overdue %}
                gradient-{{ max(0, min(10, urgency))|round(0, 'floor') }}
            {% endif %}
        {% endif %}
    {% endspaceless %}
{% endmacro %}


{##
 # Decide Urgency of a Plagscan percentage
 #
 # $value represents how much of the document was plagiarised
 # so a high percentage means a lot was copied from somewhere
 #
 # Status of -1 should be hidden entirely, and the default
 # thresholds are 60, 20 and 0 (represented in red, orange,
 # and green respectively)
 #}
{% macro plagscan(value) %}
{% spaceless %}
    {% set numericValue = value|replace({'%': ''}) %}
    {% if numericValue > 60 %}
        plagscan-critical
    {% elseif numericValue > 20 %}
        plagscan-warning
    {% elseif numericValue > 0 %}
        plagscan-ok
    {% endif %}
{% endspaceless %}
{% endmacro %}


{##
 # Decide urgency of normalised marks
 #}
{% macro marks(normalisedMark) %}
{% spaceless %}
    {% set index = 'none' %}
    {% if config.grade_gradient_enable %}
        {% if normalisedMark|length %}
            {% set index = (normalisedMark/10)|round(0, 'floor') %}
            {% set max = 10 %}
            {% set min = 0 %}

            {# For Quiz, you can get bonus marks/penalties (> 100% and < 0 respectively)
            # Assign a gradient class for these particular scenarios. This prevents grades
            # appearing in plain black
            #}
            {% if index > max %}
                {% set index = max %}
            {% endif %}

            {% if index < min %}
                {% set index = min %}
            {% endif %}
        {% endif %}
    {% endif %}
    gradient-{{ index }}
{% endspaceless %}
{% endmacro %}
