{##
 # Display the due date for an assessment activity
 #
 # TODO: attach some JS to the relative time to countdown to the due date
 #}
{% macro dueDate(assessment, user) %}
{% spaceless %}

    {% import '@learning/macro/urgency.twig' as urgency %}
    <span class="{{ urgency.datetime(assessment, user) }}">Due
        <span title="{{ assessment.dueAt.long }}">
            <time datetime="{{ assessment.dueAt }}">{{ assessment.dueAt.getRelativeDay(true, true) }}</time>
            {% if assessment.dueAt.diffInDays(now) < 7 %}
                <span> (<time datetime="{{ assessment.dueAt }}">{{ assessment.dueAt.relativeTime(null, true) }} remaining</time>)</span>
            {% endif %}
        </span>
    </span>

{% endspaceless %}
{% endmacro %}