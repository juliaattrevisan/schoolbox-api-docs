{##
 # Displays an assessment's due date.
 #
 # If we are interested in a specific student's interaction with the assessment,
 # we should call dueDate.participant, otherwise if interested in the assessment itself,
 # we should call dueDate.assessment.
 #
 # If you are calling from a fragment where you don't know, you can fallback to dueDate().
 #
 # TODO: attach some JS to the relative time to countdown to the due date
 #}

{##
 # Display an assessment's due date for the specified user.
 #}
{% macro dueDate(assessable, user) %}
{% spaceless %}
    {% import _self as dueDate %}
    {# Is the current user a participant ? #}
    {% set participant = assessable.participantIfExtant(user) %}
    {% if participant %}
        {{ dueDate.participant(participant) }}
    {% else %}
        {# Is the user a parent? Check if any of their children are participants #}
        {% set childParticipant = null %}
        {% if user.role.parent %}
            {% for child in user.children if not childParticipant %}
                {% if assessable.isParticipant(child) %}
                    {% set childParticipant = assessable.participant(child) %}
                {% endif %}
            {% endfor %}
        {% endif %}

        {% if childParticipant %}
            {# We found a child of the parent who is participating, render their due date  #}
            {{ dueDate.participant(childParticipant) }}
        {% else %}
            {# Not a participant, and not a parent of a participant  #}
            {{ dueDate.assessment(assessable) }}
        {% endif %}
    {% endif %}
{% endspaceless %}
{% endmacro %}


{##
 # Display a participant's due date (ie the participant's plan's due date)
 #}
{% macro participant(participant) %}
    {% spaceless %}
        {# cache this for performance #}
        {% set participantDueDate = participant.dueDate %}
        {% import '@learning/macro/urgency.twig' as urgency %}
        <span class="{{ urgency.datetime(participant) }}" title="{{ participantDueDate.long }}">Due
            <time datetime="{{ participantDueDate }}">{{ participantDueDate.relativeDay|replace({' at 11:59pm': ''}) }}</time>
            {% if participantDueDate.isFuture and participantDueDate.diffInDays(NOW) < 7 %}
                (<time datetime="{{ participantDueDate }}">{{ participantDueDate.relativeTime(null, true) }} remaining</time>)
            {% endif %}
        </span>
    {% endspaceless %}
{% endmacro %}


{##
 # Display an assessment's real due date
 #}
{% macro assessment(assessment) %}
    {% spaceless %}
        {% import '@learning/macro/urgency.twig' as urgency %}
        <span title="{{ assessment.dueAt.long }}">Due
            <time datetime="{{ assessment.dueAt }}">{{ assessment.dueAt.relativeDay|replace({' at 11:59pm': ''}) }}</time>
            {% if assessment.dueAt.isFuture and assessment.dueAt.diffInDays(NOW) < 7 %}
                (<time datetime="{{ assessment.dueAt }}">{{ assessment.dueAt.relativeTime(null, true) }} remaining</time>)
            {% endif %}
        </span>
    {% endspaceless %}
{% endmacro %}
