{##
 # Displays an assessment's due date.
 #
 # TODO: attach some JS to the relative time to countdown to the due date
 #}

{##
 # Display an assessment's due date for the specified user.
 #}
{% macro dueDate(assessable, user) %}
{% apply spaceless %}
    {% import _self as dueDate %}
    {# Is the nominated user a participant ? #}
    {% set participant = assessable.participantIfExtant(user) %}
    {% if participant and not participant.isExcluded %}
        {{ dueDate.forParticipant(participant) }}
    {% else %}
        {# Is the user a parent? Check if any of their children are participants #}
        {% set childParticipant = null %}
        {% for child in user.children %}
            {% if assessable.isParticipant(child) and not childParticipant %}
                {% set childParticipant = assessable.getParticipantIfExtant(child) %}
            {% endif %}
        {% endfor %}

        {% if childParticipant %}
            {# We found a child of the parent who is participating, render their due date  #}
            {{ dueDate.forParticipant(childParticipant) }}
        {% else %}
            {# Not a participant, and not a parent of a participant  #}
            {{ dueDate.forAssessment(assessable) }}
        {% endif %}
    {% endif %}
{% endapply %}
{% endmacro %}


{##
 # Helper macro to render due date for a participant's plan.
 #}
{% macro forParticipant(participant) %}
{% apply spaceless %}
    {# cache this for performance #}
    {% set participantDueDate = participant.dueDate %}
    {% import '@learning/macro/urgency.twig' as urgency %}
    <span class="{{ urgency.datetime(participant) }}" title="{{ participantDueDate.long }}">Due
        <time datetime="{{ participantDueDate }}">{{ participantDueDate.relativeDay|replace({' at 11:59pm': ''}) }}</time>
        {% if participantDueDate.isFuture and participantDueDate.diffInDays(NOW) < 7 %}
            (<time datetime="{{ participantDueDate }}">{{ participantDueDate.relativeTime(null, true) }} remaining</time>)
        {% endif %}
    </span>
{% endapply %}
{% endmacro %}


{##
 # Helper macro to render an assessment's default (not participant-specific) due date.
 #}
{% macro forAssessment(assessment) %}
{% apply spaceless %}
    {% set dueAt = assessment.dueAt %}
    {% if dueAt is not null and not dueAt.isNull %}
        <span title="{{ dueAt.long }}">Due
            <time datetime="{{ dueAt }}">{{ dueAt.relativeDay|replace({' at 11:59pm': ''}) }}</time>
            {% if dueAt.isFuture and dueAt.diffInDays(NOW) < 7 %}
                (<time datetime="{{ dueAt }}">{{ dueAt.relativeTime(null, true) }} remaining</time>)
            {% endif %}
        </span>
    {% endif %}
{% endapply %}
{% endmacro %}
