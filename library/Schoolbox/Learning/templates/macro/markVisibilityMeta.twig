{##
 # Display the mark visiblity for an assessment
 #}
{% macro markVisibilityMeta(assessment, plural = false) %}
    {% if assessment.markVisibility == 2 %}
        <li class="sbx-meta-item--with-icon"><sbx-icon name="staff"></sbx-icon> {{ (plural) ? locale.grades.properPlural : locale.grades.proper }} visible to staff, students and parents</li>
    {% elseif assessment.markVisibility == 1 %}
        <li class="sbx-meta-item--with-icon"><sbx-icon name="staff-students"></sbx-icon> {{ (plural) ? locale.grades.properPlural : locale.grades.proper }} visible to staff and students</li>
    {% elseif assessment.markVisibility == 0 %}
        <li class="sbx-meta-item--with-icon"><sbx-icon name="teacher"></sbx-icon> {{ (plural) ? locale.grades.properPlural : locale.grades.proper }} visible to staff</li>
    {% endif %}
{% endmacro %}
