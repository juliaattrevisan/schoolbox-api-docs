{##
 # Display the mark visiblity for an assessment
 #}
{% macro markVisibilityMeta(assessment, plural = false) %}
    {% if assessment.markVisibility == 2 %}
        <li class="icon-staff">{{ (plural) ? locale.properPlural : locale.proper }} visible to staff, students and parents</li>
    {% elseif assessment.markVisibility == 1 %}
        <li class="icon-staff-students">{{ (plural) ? locale.properPlural : locale.proper }} visible to staff and students</li>
    {% elseif assessment.markVisibility == 0 %}
        <li class="icon-teacher">{{ (plural) ? locale.grades.properPlural : locale.grades.proper }} visible to staff</li>
    {% endif %}
{% endmacro %}