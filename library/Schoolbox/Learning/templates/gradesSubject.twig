{% import '@learning/macro/urgency.twig' as urgency %}

<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts-more.js"></script>
<script type="text/javascript" src="/javascript/shared/submissions/reportCardBoxplot.js"></script>
<script type="text/javascript" src="/javascript/shared/submissions/jquery.all-work.js"></script>
<script type="text/javascript" src="/learninganalytics/js/schoolboxTheme.js"></script>
<script type="text/javascript" src="/javascript/shared/eportfolio/jquery.eportfolio.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.toast-timeout.js"></script>

<div class="row">
    <div class="small-12 columns">
        <h1>Grades for {{ subject.name }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-5 island">
        <section>
            <ul class="action-list">
                <li>
                    <div class="small-12 card">
                        <a href="/search/user/{{ student.id }}" title="View Profile">
                            <img src="/portrait.php?userId={{ student.externalId }}&size=square64" alt="{{ student.fullName }}"/>
                            <p>{{ student.fullName }}</p>
                            <p class="meta">Year {{ student.year }} Student</p>
                        </a>
                    </div>
                </li>
            </ul>
        </section>
    </div>
    <div class="small-12 medium-7 columns">
        <div class="content">
            {% include '@learning/fragments/contextSelector.twig' with {folders: folders, terms: terms} %}
        </div>
    </div>
</div>

{% if markbook.assessments | length %}

    <div class="row">
        <div class="small-12 large-6 island">
            <h2 class="subheader">Teachers</h2>
            <section>
                <ul class="action-list">
                    {% for teacher in subject.teachers %}
                        <li>
                            <div class="small-12 card">
                                <a href="/search/user/{{ teacher.id }}" title="View Profile">
                                    <img src="/portrait.php?userId={{ teacher.externalId }}&size=square64"
                                         alt="{{ teacher.fullName }}">
                                    <p>{{ teacher.fullName }}</p>
                                </a>
                                <p class="meta">Teacher</p>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
        <div class="small-12 large-6 island">
            <h2 class="subheader">Current Grade Average</h2>
            <section class="content {{ urgency.marks(markbook.studentStatistics[student.id].meanNormalised) }}-bg">
                <div class="grade">
                <span class="{{ urgency.marks(markbooks[student.id].meanNormalised) }}">
                    {{ markbook.studentStatistics[student.id].mean }}
                </span>
                </div>
            </section>
        </div>
    </div>

    <script type="text/javascript">
        $(function() {

            var infoIndex = {{ graphInfo | purify }};
            /**
             *  Boxplots for each Task in the Unit
             */
            $.fn.reportCardBoxplotRender({
                element: '#subject-graph',
                /* Title of the graph
                 */
                title: '',
                /* Orientation of the box plots
                 */
                orientation: 'vertical',
                /* A list of all the assessment names that are being graphed
                 * These correspond to a series of data and their respective
                 * five-point summaries
                 */

                allAssessments: {{ graphAssessments | purify }},
                /* All the raw data
                 */
                allData: $.fn.reportCardBoxplotCalculateAllSeriesData({{ graphData | purify }}),
                /* You
                 */
                additionalSeries: [
                    {
                        type: 'scatter',
                        name: 'You',
                        color: 'rgb(255, 87, 87)',
                        marker: {
                            radius: 6
                        },
                        data: {{ graphScatter | purify }},
                        tooltip: {
                            headerFormat: '',
                            borderColor: '#000000',
                            pointFormatter: function () {
                                /* Basic template for each outlier
                                 */
                                var template =
                                        '<div style="width:200px!important;overflow:auto;white-space:normal !important;">' +
                                        '<div class="grade gradient-{GRADIENTMARK}"><span>{DISPLAYMARK}</span></div>' +
                                        '<p class="comment">{INFO}</p>' +
                                        '</div>';
                                /* Concatenate everything
                                 */
                                if (typeof infoIndex[this.x].displayMark != 'undefined') {
                                    tooltipContent = template;

                                    if (infoIndex[this.x].displayMark != null) {
                                        tooltipContent = tooltipContent.replace(/{DISPLAYMARK}/, infoIndex[this.x].displayMark);
                                        tooltipContent = tooltipContent.replace(/{GRADIENTMARK}/, infoIndex[this.x].gradientMark);
                                    }
                                    else {
                                        tooltipContent = tooltipContent.replace(/{DISPLAYMARK}/, '');
                                        tooltipContent = tooltipContent.replace(/{GRADIENTMARK}/, '');
                                    }
                                    tooltipContent = tooltipContent.replace(/{INFO}/, infoIndex[this.x].info);

                                    /* Show tooltip
                                     */
                                    $('.highcharts-tooltip').show();

                                    return tooltipContent;
                                }
                                else {

                                    /* Hide tooltip when no data
                                     */
                                    $('.highcharts-tooltip').hide();
                                }
                            }
                        }
                    }
                ]
            });

            /* Set up comment abilities: post
             */
            $.fn.allWork.commentSetup({
                data: {
                    term: '{{ term.code }}',
                    studentId: '{{ student.id }}',
                    folderId: '{{ subject.id }}'
                }
            });
        });
    </script>

    <div class="row">
        <div class="small-12 island">
            <section class="content">
                <div id="subject-graph"></div>
            </section>
        </div>
    </div>
    <div class="row">
        <div class="small-12 island">
            <h2 class="subheader">Assessments</h2>
            <section>
                <ul class="action-list">
                    {% for assessment in markbook.assessments %}
                        <li class="actions-small-1">
                            <div class="list-item clearfix content">
                                <div class="row">
                                    <div class="small-12 large-5 card column xl">
                                        <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: assessment.id, studentId: student.id}) }}">
                                            <h3>{{ assessment.title }}</h3>
                                        </a>
                                        <p class="meta">
                                            <a href="/homepage/{{ subject.id }}">{{ subject.name }}</a> {{ assessment.typeName }}
                                        </p>
                                    </div>

                                    <div class="small-12 large-4 columns grade">
                                        {% set feedback = assessment.participant(student).findMostRecentFeedback %}
                                        {% if feedback %}
                                            <div class="{{ urgency.marks(feedback.normalisedMark) }}"><span>{{ feedback.humanReadableMark }}</span></div>
                                            <p class="comment">{{ feedback.comment }}</p>
                                        {% endif %}
                                    </div>

                                    <div class="small-12 large-3 columns">
                                        Due <span class="{{ urgency.datetime(assessment, student) }}">{{ assessment.dueAt.relativeTime }}</span>
                                        on {{ assessment.dueAt.dateOnly }}
                                    </div>
                                </div>
                            </div>
                            <nav>
                                {% if (showcase[assessment.id] | length) == 0 and feedback %}
                                    <a class="icon-showcase" data-publish-to-eportfolio="publish-boxId-{{ assessment.id }}" title="Publish to ePortfolio"></a>
                                    <form action="/eportfolio/showcase/modifyForm.php" method="post" data-publish-to-eportfolio-form="publish-boxId-{{ assessment.id }}">
                                        <input type="hidden" name="action" value="publish">
                                        <input type="hidden" name="userId" value="{{ student.id }}">
                                        <input type="hidden" name="boxId" value="{{ assessment.id }}">
                                    </form>
                                    <script type="text/javascript">
                                        $(function() {
                                            {# Publish to ePortfolio #}
                                            $('[data-publish-to-eportfolio-form="publish-boxId-{{ assessment.id }}"]').eportfolio_publish({
                                                activator: '[data-publish-to-eportfolio="publish-boxId-{{ assessment.id }}"]',
                                                label: '[data-publish-to-eportfolio-label="publish-boxId-{{ assessment.id }}"]'
                                            });
                                        });
                                    </script>
                                {% endif %}
                            </nav>
                            <div class="toast" data-alert="" data-publish-to-eportfolio-label="publish-boxId-{{ assessment.id }}">Showcase Updated</div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>

    {% if comment|length or canComment %}
    <div class="row">
        <div class="small-12">
            <h2 class="subheader">Comments</h2>
        </div>
    </div>
    {% endif %}

    <div class="row">
        <div class="small-12 columns">
            {% if canComment %}
                <form id="create-comment" data-comment-form action="/ajax/comment.php" method="post">
                    <input type="hidden" name="studentId" value="{{ student.id }}"/>
                    <input type="hidden" name="categoryId" value="{{ subject.id }}"/>
                    <textarea name="comment" rows="3"></textarea>
                    <div class="row">
                        <div class="small-6 medium-offset-6 medium-3 column">
                            <input id="vis-student" type="checkbox" name="visibility[student]" value="1" />
                            <label for="vis-student" class="checkbox-label">Visible To Student</label>
                        </div>
                        <div class="small-6 medium-3 column">
                            <input id="vis-parent" type="checkbox" name="visibility[parent]" value="1" checked />
                            <label for="vis-parent" class="checkbox-label">Visible To Parents</label>
                        </div>
                    </div>
                    <a class="button expand submit" data-comment-post="new">Post</a>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="row">
        <div class="small-12 island">
            <section>
                <ul class="action-list" data-comment-list>
                    {% for comment in comments %}
                        <li class="actions-small-2" data-id="{{ comment.id }}">
                            <div class="list-item">
                                <div class="small-10 card">
                                    <a href="/search/user/{{ comment.commenter.id }}" title="View Profile">
                                        <img src="/portrait.php?userId={{ comment.commenter.externalId }}&size=square64" alt="{{ comment.commenter.fullName }}" />
                                        <p>{{ comment.commenter.fullName }}</p>
                                    </a>
                                    <p class="meta">{{ comment.commenter.role.name }}</p>
                                    <p class="meta">{{ comment.createdAt.relativeTime }}</p>
                                </div>
                                <div class="small-2 column content">
                                <span class="icon-staff-students {% if comment.studentVisibility %}on{% else %}off{% endif %}"
                                      title="{% if comment.studentVisibility %}Visible to {% else %}Hidden from {% endif %}student"></span>
                                    <span class="icon-staff {% if comment.parentVisibility %}on{% else %}off{% endif %}"
                                          title="{% if comment.parentVisibility %}Visible to {% else %}Hidden from {% endif %}parents"></span>
                                </div>
                            </div>
                            <nav>
                                {% if canComment %}
                                    <a class="icon-delete" title="Delete" data-comment-delete></a>
                                    <a class="icon-modify" title="Modify" data-comment-modify></a>
                                {% endif %}
                            </nav>
                            <article>
                                <p>
                                    {{ comment.body | purify }}
                                </p>
                            </article>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>

{% else %}

    <div class="row">
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>No grades are available for this subject.</p>
            </div>
        </div>
    </div>

{% endif %}