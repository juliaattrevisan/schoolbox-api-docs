{# Usage:
    terms:      GenericCollection|Term\Model[]   - All terms known to system
    term:       Term\Model                       - Current visible term
    student:    User                             - The visible student
    folders:    GenericCollection|Folder\Model[] - Classes/Groups that student is enrolled in or has feedback or responses in the current term
    mailHandle: string                           - Prefix for sending mail
#}

{% import '@learning/macro/urgency.twig' as urgency %}
{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(['Learning', routeLookup('learning.getClasses')], ['Grades', '#']) }}

<div class="row">
    <div class="small-12 columns">
        <h1>Grades for {{ term.title }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-5 island">
        <section>
            <ul class="action-list">
                <li>
                    <div class="small-12 card">
                        <a href="/search/user/{{ student.id }}" title="View Profile">
                            <img src="/portrait.php?userId={{ student.externalId }}&size=square64" alt="{{ student.fullName }}"/>
                            <p>{{ student.fullName }}</p>
                            <p class="meta">Year {{ student.year }} Student</p>
                        </a>
                    </div>
                </li>
            </ul>
        </section>
    </div>
    <div class="small-12 medium-7 columns">
        <div class="content">
            <div class="context-switch clearfix">
                {% include 'sub/semesterSelector.twig' with {
                    terms:       terms,
                    currentTerm: term,
                    route:       'learning.getGrades',
                    routeArgs:   {viewee: student, userId: student.id}
                } only %}

                {% include 'sub/subjectSelector.twig' with {
                    subjects:       folders,
                    route:          'learning.getGradesForSubject',
                    routeArgs:      {viewee: user, userId: student.id, term: term, termCode: term.code}
                } only %}
            </div>
        </div>
    </div>
</div>

{# Display subjects the student is involved in for the selected term #}

<div class="row">
    <div class="small-12 island">
        <section>
            <ul class="information-list">
                {% for folder in folders %}
                    <li>
                        <a href="{{ routeLookup('learning.getGradesForSubject', {student: student, userId: student.id, term: term, termCode: term.code, subject: subject, subjectId: folder.id}) }}" class="link-row" title="View Grades">
                        <div class="medium-10 small-8 card">
                                <span class="icon-home size-32" title="{{ folder.name }}"></span>
                                <p>{{ folder.name }}</p>
                            <p class="meta">
                                {% for code in folder.codes %}
                                    {{ code.code }}{% if not loop.last %},{% endif %}
                                {% endfor %}
                            </p>
                        </div>
                        <div class="medium-2 small-4 columns no-pad">
                            <div class="grade content">
                                <span class="{{ urgency.marks(markbooks[folder.id].meanNormalised) }}">
                                    {{ markbooks[folder.id].weightedMean }}
                                </span>
                            </div>
                        </div>
                        </a>
                    </li>
                    {% for teacher in folder.teachers %}
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="small-12 card">
                                <a href="/search/user/{{ teacher.id }}" title="">
                                    <img src="/portrait.php?userId={{ teacher.externalId }}&size=square64"
                                         alt="{{ teacher.fullName }}"/>
                                    <p>{{ teacher.fullName }}</p>
                                </a>
                                <p class="meta">Teacher</p>
                            </div>

                        </div>
                        <nav>
                            <a href="{{ mailHandle }}{{ teacher.email }}" class="icon-email" title="Mail"></a>
                        </nav>
                    </li>
                    {% endfor %}
                {% endfor %}
                </ul>
            </section>
        </div>
    </div>



{% if folders | length == 0 %}

    <div class="row">
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-due-work"></i>
                <p>You are not enrolled in any classes this term.  If you believe this is incorrect please contact your administrator.</p>
            </div>
        </div>
    </div>

{% endif %}
