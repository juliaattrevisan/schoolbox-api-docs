{# TODO rename this to better name. 'pendingAssessments.twig' + 'pendingAssessmentsContent.twig' ?

Usage:
    filterPanel: FilterPanel - a filter panel that can filter and AJAX in the report

#}

{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
['Learning', routeLookup('learning.getClasses')],
['Pending Assessments', routeLookup('learning.getPendingAssessmentsForUser', { viewee: viewee })]
) }}

<div class="row">
    <div class="small-12 columns"><h1>{% if USER.id != viewee.id %}{{ viewee.fullName }}'s {% endif %}Pending Assessments</h1></div>
</div>

<div class="row">
    <div class="small-12 columns island">
        {% include filterPanel.template with {
            contentId: 'content_id',
            panel: filterPanel
        } only %}
    </div>
</div>

<div class="small-12 columns island">
    <div id="content_id">
        <img src="/images/foundation/preloader.gif" alt="preloader.gif" style="text-align:center;margin:auto;display: block;">
    </div>
</div>

