{#
    Renders the content of the filtered pending assessment page
    Data:
        statistics:                Assessment\Statistics[]  indexed by assessment.id
        assessmentsToMark:         IAssessable[]            indexed by assessment.id
        assessmentsToChase:        IAssessable[]            indexed by assessment.id
        assessmentStudentsToEmail: string[][]               indexed by assessment.id, user.id
        emailSeparator:            string                   ASCII Character
#}
{% import 'sub/assessmentContext.twig' as assessmentContext %}
{% import 'sub/assessmentResponse.twig' as assessmentResponse %}
{% import '@learning/macro/dueDate.twig' as dueDate %}

<script type="text/javascript" src="/javascript/shared/submissions/task/jquery.progressTickForm.js"></script>
<script type="text/javascript">
    $(function() {
        // Save form for task completion
        $('form[data-progress-tick-form]').progressTickForm({
            transitions: {
                incomplete:      'teacherAssessed',
                selfAssessed:    'teacherAssessed',
                teacherAssessed: 'incomplete'
            }
        });

        // Just the stuff we've AJAXed in
        $('#pending_assessments').find('[data-collapser]').collapsable();
    });
</script>


<div class="row" id="pending_assessments">
    <div class="small-12 columns island">

        <h2 data-heading-to-mark class="subheader {% if not assessmentsToMark|length %}hide{% endif %}">Requires {{ locale.assessment.proper }} ({{ statistics|reduce((carry,v) => carry + v.countFeedbackRequired) }})</h2>
        <div data-list-to-mark>
            {% for assessment in assessmentsToMark %}
                {% include '@learning/fragments/toMarkAssessment.twig' with {
                    assessment:        assessment,
                    stats:             statistics[assessment.id]
                } only %}
            {% endfor %}
        </div>

        <h2 data-heading-to-chase class="subheader {% if not assessmentsToChase|length %}hide{% endif %}">Not Submitted ({{ statistics|reduce((carry,v) => carry + v.countResponseRequired) }})</h2>
        <div data-list-to-chase>
        {% for assessment in assessmentsToChase %}
            {% include '@learning/fragments/toSubmitAssessment.twig' with {
                assessment:      assessment,
                stats:           statistics[assessment.id],
                studentsToEmail: assessmentStudentsToEmail[assessment.id],
                emailSeparator:  emailSeparator
            } only %}
        {% endfor %}
        </div>

        {% if not assessmentsToMark|length and not assessmentsToChase|length %}
            <div class="empty-state">
                <i class="icon-approve"></i>
                <p>You have no {{ locale.assessment.plural }} to review or follow up. To view a complete list of past {{ locale.assessment.plural }} visit your <a href="{{ routeLookup('learning.getClasses') }}">class'</a> markbook.</p>
            </div>
        {% endif %}
    </div>
</div>

<div class="toast" data-toast></div>

<div class="hide" id="template-assessment-to-mark">
    {% include '@learning/fragments/toMarkAssessment.twig' with {
        assessment: {
            id:              0,
            title:           'TEMPLATE ASSESSMENT TO MARK',
            allParticipants: []
        },
        stats: {
            countParticipants:     0,
            countResponseRequired: 0,
            countFeedbackRequired: 0
        },
        isDueWork: true
    } only %}
</div>

<script type="text/javascript">
    $(function() {

        // get handles to static DOM elements
        var $toast                 = $('[data-toast]'),
            $toMarkHeading         = $('[data-heading-to-mark]'),
            $toMarkList            = $('[data-list-to-mark]'),
            $dueWorkToMarkTemplate = $('#template-assessment-to-mark').find('[data-assessment]').detach(),
            $toChaseHeading        = $('[data-heading-to-chase]'),
            $toChaseList           = $('[data-list-to-chase]');

        {# Handle clicks on 'Submission Received' buttons #}
        $('[data-sobo]').on('click', function (event) {
            event.preventDefault();

            var $button            = $(this),
                buttonText         = $button.html();

            $toast.toastActivate({text: 'Marking submission as received...'});
            $button.html('Working...');
            $button.attr('disabled', '');

            $.post($button.attr('href'))
                .done(function (response) {
                    soboSuccess($button, response);
                    $toast.toastTimeout({text: 'Submission marked as received', css: 'success'});
                })
                .fail(function () {
                    soboFailure($button, buttonText);
                    $toast.toastTimeout({text: 'Unable to mark submission as received', css: 'alert'});
                });
        });

        /**
         * Handle an 'acknowledgment of submission receipt' success
         *
         * @param {jQuery} $button
         * @param {string} participantHtml
         */
        function soboSuccess($button, participantHtml)
        {
            var $participantToChase = $button.closest('[data-participant]'),
                $assessmentToChase  = $participantToChase.closest('[data-assessment]'),
                assessmentId        = $assessmentToChase.attr('data-assessment'),
                $assessmentToMark   = $toMarkList.find('[data-assessment='+assessmentId+']');

            // Ensure the 'Requires Assessment' list is visible
            if($toMarkHeading.hasClass('hide')){
                $toMarkHeading.removeClass('hide'); // TODO make this transition slide down for smoothness
            }

            // Ensure the assessment exists in the 'Requires Assessment' list
            if(!$assessmentToMark.length){
                $assessmentToMark = insertAssessmentToMark($assessmentToChase, assessmentId);
            }

            // Insert the participant in the 'to-mark' assessment
            var $participantsToMarkList = $assessmentToMark.find('[data-participant-list]');
            $participantsToMarkList.append(participantHtml);

            updateParticipationCounts($assessmentToMark, $assessmentToChase);
            removeParticipant($assessmentToChase, $participantToChase);
        }

        /**
         * Calculate new counts, and update DOM
         *
         * @param {jQuery} $assessmentToMark
         * @param {jQuery} $assessmentToChase
         */
        function updateParticipationCounts($assessmentToMark, $assessmentToChase)
        {
            // Get handles to DOM elements
            var $toMarkProgress       = $assessmentToMark.find('[data-progress]'),
                $toMarkMeter          = $assessmentToMark.find('[data-meter]'),
                $toMarkPipe           = $assessmentToMark.find('[data-pipe]'),
                $toMarkSummary        = $assessmentToMark.find('[data-count-to-mark]'),
                $toMarkCount          = $toMarkSummary.find('[data-user-count]'),
                $toChaseProgress      = $assessmentToChase.find('[data-progress]'),
                $toChaseMeter         = $assessmentToChase.find('[data-meter]'),
                $toChasePipe          = $assessmentToChase.find('[data-pipe]'),
                $toChaseSummary       = $assessmentToChase.find('[data-count-to-chase]'),
                $toChaseCount         = $toChaseSummary.find('[data-user-count]'),
                countTotal            = parseInt($toChaseProgress.attr('data-count-total')),
                countResponseRequired = parseInt($toChaseProgress.attr('data-count-response-required')),
                countFeedbackRequired = parseInt($toChaseProgress.attr('data-count-feedback-required')),
                countReviewComplete   = parseInt($toChaseProgress.attr('data-count-review-complete'));

            // Update the counts
            countResponseRequired--;
            countFeedbackRequired++;

            var cssWidth = (100 - (countResponseRequired / countTotal * 100)) + '%',
                cssLeft  = (countReviewComplete / countTotal * 100) + '%';

            // Update data attributes, CSS + titles
            $toMarkProgress.attr('data-count-total', countTotal);
            $toMarkProgress.attr('data-count-response-required', countResponseRequired);
            $toMarkProgress.attr('data-count-feedback-required', countFeedbackRequired);
            $toMarkProgress.attr('data-count-review-complete', countReviewComplete);
            $toMarkProgress.attr('title', (countTotal - countResponseRequired) + ' of ' + countTotal + ' students have ' + $toMarkProgress.attr('data-title-suffix'));

            $toMarkMeter.css({width: cssWidth});

            $toMarkPipe.css({left: cssLeft});
            $toMarkPipe.attr('title', countFeedbackRequired + ' of ' + countTotal + ' students require ' + $toMarkPipe.attr('data-title-suffix'));

            $toMarkSummary.attr('title', countFeedbackRequired + ' of ' + countTotal + ' students require marking');
            $toMarkCount.html(countFeedbackRequired);

            $toChaseProgress.attr('data-count-response-required', countResponseRequired);
            $toChaseProgress.attr('data-count-feedback-required', countFeedbackRequired);
            $toChaseProgress.attr('title', (countTotal - countResponseRequired) + ' of ' + countTotal + ' students have ' + $toChaseProgress.attr('data-title-suffix'));

            $toChaseMeter.css({width: cssWidth});
            $toChasePipe.css({left: cssLeft});
            $toChasePipe.attr('title', countFeedbackRequired + ' of ' + countTotal + ' students require ' + $toChasePipe.attr('data-title-suffix'));

            $toChaseSummary.attr('title', countResponseRequired + ' of ' + countTotal + ' students have not ' + $toChaseSummary.attr('data-title-suffix'));
            $toChaseCount.html(countResponseRequired);
        }

        /**
         * Insert the 'Assessment to-mark' in the 'Assessments-to-mark' list, and copy attributes.
         *
         * @param {jQuery} $assessmentToChase
         * @param {int}    assessmentId
         * @return {jQuery}
         */
        function insertAssessmentToMark($assessmentToChase, assessmentId)
        {
            var $assessmentToMark = $dueWorkToMarkTemplate.clone();
            $assessmentToMark.attr('data-assessment', assessmentId);
            var dueTimestamp = parseInt($assessmentToChase.attr('data-due-timestamp'));
            $assessmentToMark.attr('data-due-timestamp', dueTimestamp);

            $assessmentToMark.find('[data-collapser]').attr('data-collapser', 'to-mark-' + assessmentId);
            $assessmentToMark.find('[data-collapsable]').attr('data-collapsable', 'to-mark-' + assessmentId);

            $assessmentToMark.find('[data-title]').html($assessmentToChase.find('[data-title]').html());

            var href = $assessmentToMark.find('[data-title]').attr('href');
            $assessmentToMark.find('[data-title]').attr('href', href.replace(/\d+/, assessmentId));

            $assessmentToMark.find('[data-crumbs]').html($assessmentToChase.find('[data-crumbs]').html());
            $assessmentToMark.find('[data-due-date]').html($assessmentToChase.find('[data-due-date]').html());
            $assessmentToMark.css({
                'max-height': 0,
                overflow:     'hidden'
            });

            var insertIndex = 0;
            $toMarkList.find('[data-assessment]').each(function(idx, elem){
                var currentTimestamp = parseInt($(elem).attr('data-due-timestamp'));
                insertIndex = idx;
                return currentTimestamp <= dueTimestamp;
            });

            if (0 === insertIndex) {
                $toMarkList.prepend($assessmentToMark);
            } else {
                $toMarkList.children().eq(insertIndex - 1).after($assessmentToMark);
            }

            $assessmentToMark.animate({'max-height': '400px'}, 1000);
            $assessmentToMark.find('[data-collapser]').collapsable();

            return $assessmentToMark;
        }

        /**
         * Either remove participant, or whole assessment if they were the last one
         *
         * @param {jQuery} $assessmentToChase
         * @param {jQuery} $participantToChase
         */
        function removeParticipant($assessmentToChase, $participantToChase)
        {
            var
                $participantsToChaseList = $assessmentToChase.find('[data-participant-list]'),
                isLastParticipant        = 1 === $participantsToChaseList.find('[data-participant]').length,
                isLastAssessment         = 1 === $toChaseList.find('[data-assessment]').length;

            if(isLastParticipant) {
                if(isLastAssessment){
                    // Last participant in last assessment: Remove whole list
                    $toChaseHeading.hide();
                    $toChaseList.slideUp();
                } else {
                    // Last participant in assessment, other assessments remain: Remove assessment
                    $assessmentToChase.slideUp({done: function(){
                        $assessmentToChase.remove();
                    }})
                }
            } else {
                // Not last participant: Just remove participant
                $participantToChase.slideUp({
                    done: function () {
                        $participantToChase.remove();
                        updateEmailList($assessmentToChase, $participantsToChaseList);
                    }
                });
            }
        }

        /**
         * Update the 'Email All' button to just email the remaining participants
         *
         * @param {jQuery} $assessmentToChase
         * @param {jQuery} $participantsToChaseList
         */
        function updateEmailList($assessmentToChase, $participantsToChaseList)
        {
            var studentEmailArr = [],
                $emailList      = $assessmentToChase.find('[data-email-students]');

            $participantsToChaseList.find('[data-participant]').each(function(idx, elem){
                var email = $(elem).attr('data-email');
                if(email){
                    studentEmailArr.push(email);
                }
            });
            $emailList.val(studentEmailArr.join());
        }

        /**
         * Handle a submission receipt failure
         *
         * @param {jQuery} $button
         * @param {string} buttonText
         */
        function soboFailure($button, buttonText)
        {
            $button.html(buttonText);
            $button.removeAttr('disabled');
        }
    });
</script>


