{% set getStudentListsEndpoint = routeLookupIfAuthorized('learning.getStudentListByClassId', { folderId: folder.id, folder: folder }) %}
{% set showUserSelect = user.role.isStaff and user.role.accessEvidence and getStudentListsEndpoint %}

{% if user.role.isStudent or showUserSelect %}
    <section>
        {% set getCreateForm = routeLookupIfAuthorized('learningMomentEvidence.getCreateForm', { userIds: user.id }) %}
        {% if getCreateForm != '' %}
            {% set baseUrlParams = '?folderId=' ~ folder.id ~ '&' ~ RETURN_URL.name ~ '=' ~ (encodedReturnUrl ?? RETURN_URL.current) %}
            <div class="share-work-buttons l-mar-m">
                <a
                    data-action="shareLearningMoment"
                    data-moment-type="photo"
                    data-take-photo-button
                    data-test="learning-moment-evidence-share-takeAPhoto"
                    href="{% if showUserSelect %}#{% else %}{{ getCreateForm }}{{ baseUrlParams }}&momentType=photo{% endif %}"
                    class="icon-camera share-photo"
                    title="Take a photo"
                >
                    Take a photo
                </a>
                <a
                    data-action="shareLearningMoment"
                    data-moment-type="video"
                    data-record-video-button
                    href="{% if showUserSelect %}#{% else %}{{ getCreateForm }}{{ baseUrlParams }}&momentType=video{% endif %}"
                    class="icon-video share-video"
                    title="Record a video"
                >
                    Record a video
                </a>
                <a
                    data-action="shareLearningMoment"
                    data-moment-type="audio"
                    data-record-audio-button
                    href="{% if showUserSelect %}#{% else %}{{ getCreateForm }}{{ baseUrlParams }}&momentType=audio{% endif %}"
                    class="icon-audio share-audio"
                    title="Record audio"
                >
                    Record audio
                </a>
                <a
                    data-action="shareLearningMoment"
                    data-moment-type="upload"
                    href="{% if showUserSelect %}#{% else %}{{ getCreateForm }}{{ baseUrlParams }}&momentType=upload{% endif %}"
                    class="icon-upload share-file"
                    title="Upload file"
                >
                    Upload file
                </a>
                <a
                    data-action="shareLearningMoment"
                    data-moment-type="text"
                    data-test="learning-moment-evidence-share-writeSomething"
                    href="{% if showUserSelect %}#{% else %}{{ getCreateForm }}{{ baseUrlParams }}&momentType=text{% endif %}"
                    class="icon-textbox share-text"
                    title="Write something"
                >
                    Write something
                </a>
            </div>
        {% endif %}

        <div class="component-action">
            <section>
                {% if user.role.isStudent %}
                    <a class='button' href="{{ routeLookup('searchUser.getProfile', { userId: user.id }) }}#tab-activity" target="_self">View Activity Feed</a>
                {% endif %}

                {% set cohortReportLink = routeLookupIfAuthorized('learningMomentEvidence.getCohortReport', { folderId: folder.id }) %}
                {% if cohortReportLink %}
                    <a class='button' href="{{ cohortReportLink }}" target="_self">View Cohort Learning Moments</a>
                {% endif %}
            </section>
        </div>

        <!-- Check that the device supports recording audio/video, and if not hide the buttons that aren't supported -->
        {# TODO: do we need to do ^^ THAT in the new page too? probably. #}
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/checkShareWorkButtons.js?v={{ config.site_version }}"></script>

        {% if showUserSelect %}
            {% set revealId = 'learning-moments-homepage-share-work-' ~ component.instance.id %}
            <div data-reveal id="{{ revealId }}" class="reveal-modal">
                <h2>Share a Learning Moment</h2>
                <a class="close-reveal-modal" aria-label="Close">&#215;</a>

                {% if students|length %}
                    <input id="chk-{{ revealId }}-all" type="checkbox">
                    <label for="chk-{{ revealId }}-all" class="checkbox-label">Select All</label>

                    <ul class="information-list card-selectable">
                        {% for student in students %}
                            <li {% if not student.getLearningMomentsEnabled %}style="opacity: 0.5"{% endif %}>
                                <div>
                                    <div class="selector">
                                        <input
                                            id="chk-{{ revealId }}-{{ student.id }}"
                                            type="checkbox"
                                            data-user-id="{{ student.id }}"
                                            {% if student.getLearningMomentsEnabled %}
                                                data-checkbox="{{ revealId }}"
                                            {% else %}
                                                disabled
                                            {% endif %}
                                        >
                                        <label for="chk-{{ revealId }}-{{ student.id }}" class="checkbox-label"></label>
                                    </div>
                                    <div class="small-12 card">
                                        <a href="/search/user/{{ student.id }}" title="View Profile">
                                            {% include 'include/portrait.twig' with {user: student} only %}
                                            <h3>{{ student.fullName }}</h3>
                                            <p class="meta">{{ student.preferredTitle }}
                                                {% if not student.getLearningMomentsEnabled %}
                                                    (Learning Moments not enabled)
                                                {% endif %}
                                            </p>
                                        </a>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>

                    <ul class="flex-list buttons l-mar-m--top">
                        <li><a class="icon-share button" data-moment-share-submit disabled>Share Learning Moment</a></li>
                    </ul>
                {% else %}
                    <div class="empty-state">
                        <i class="icon-share"></i>
                        {% if folder.folder.codes|length %}
                            <p>There are no students added to the class at this time.</p>
                        {% else %}
                            <p>There are no group members in this folder.</p>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            <script type="text/javascript">
            (() => {
                /**
                 * When a given checkbox is changed, update the share button link and disabled state
                 */
                function onUserSelectChange() {
                    const checkedUserIds = [...document.querySelectorAll('#{{ revealId }} [data-checkbox="{{ revealId }}"]')]
                        .filter((el) => el.checked)
                        .map((el) => el.getAttribute('data-user-id'));

                    const shareButton = document.querySelector('#{{ revealId }} [data-moment-share-submit]');
                    shareButton.removeAttribute('disabled');

                    // build up the new URL
                    const params = new URLSearchParams();
                    params.set('folderId', '{{ folder.id }}');
                    params.set('{{ RETURN_URL.name }}', '{{ encodedReturnUrl ?? RETURN_URL.current }}');
                    params.set('momentType', shareButton.getAttribute('data-moment-type'));

                    // the route generator will leave behind a {userIds} for us to inject to
                    const href = `{{ routeLookupIfAuthorized('learningMomentEvidence.getCreateForm') }}`.replace('{userIds}', checkedUserIds.join(','));
                    shareButton.setAttribute('href', `${href}?${params.toString()}`);

                    if (checkedUserIds.length === 0) {
                        shareButton.setAttribute('disabled', 'true');
                        return;
                    }
                }

                window.sbProps.injectScriptsIfNotLoaded(
                    {
                        srcList: ['{{ CDN_PREFIX }}/js/select-all/jquery.select-all.basic.js?v={{ config.site_version }}'],
                        onComplete: () => {
                            $("#chk-{{ revealId }}-all").selectAllBasic({
                                selector: '[data-checkbox="{{ revealId }}"]',
                                onAfterCheckboxChange: onUserSelectChange
                            });
                        }
                    }
                );

                document.querySelectorAll('#component{{ component.instance.id }} [data-action="shareLearningMoment"][data-moment-type]').forEach((el) => {
                    el.addEventListener('click', (event) => {
                        event.preventDefault();
                        $('#{{ revealId }}').foundation('reveal', 'open');

                        const baseMomentType = event.currentTarget.getAttribute('data-moment-type');
                        const shareButton = document.querySelector('#{{ revealId }} [data-moment-share-submit]');
                        shareButton.setAttribute('data-moment-type', baseMomentType);

                        onUserSelectChange(); // initialise the button state on load
                    });
                });
            })();
            </script>
        {% endif %}
    </section>
{% elseif user.role.isStaff %}
    {# only staff that can't create learning moments should see this empty state, there's no reason to show something to parents #}
    <div class="empty-state">
        <p>
            You do not have permission to create learning moments from this component.
        </p>
    </div>
{% endif %}
