{% set getStudentListsEndpoint = routeLookupIfAuthorized('learning.getStudentListByClassId', { folderId: folder.id, folder: folder }) %}
{% set showUserSelect = user.role.isStaff and user.role.accessEvidence and getStudentListsEndpoint %}

{% if user.role.isStudent or showUserSelect %}
    <section>
        {% set baseUrl = routeLookupIfAuthorized('learningMomentEvidence.getCreateForm', { userIds: user.id }) %}
        {% if baseUrl != '' %}
            <div class="share-work-buttons l-mar-m">
                <a
                    data-action="shareLearningMoment"
                    data-moment-type="photo"
                    data-take-photo-button
                    data-test="learning-moment-evidence-share-takeAPhoto"
                    {% if not showUserSelect %}
                        href="{{ baseUrl }}?momentType=photo&folderId={{ folder.id }}&{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}"
                    {% endif %}
                    class="icon-camera share-photo"
                    title="Take a photo"
                >
                    Take a photo
                </a>
                <a
                    data-action="shareLearningMoment"
                    data-moment-type="video"
                    data-record-video-button
                    {% if not showUserSelect %}
                        href="{{ baseUrl }}?momentType=video&folderId={{ folder.id }}&{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}"
                    {% endif %}
                    class="icon-video share-video"
                    title="Record a video"
                >
                    Record a video
                </a>
                <a
                    data-action="shareLearningMoment"
                    data-moment-type="audio"
                    data-record-audio-button
                    {% if not showUserSelect %}
                        href="{{ baseUrl }}?momentType=audio&folderId={{ folder.id }}&{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}"
                    {% endif %}
                    class="icon-audio share-audio"
                    title="Record audio"
                >
                    Record audio
                </a>
                <a
                    data-action="shareLearningMoment"
                    data-moment-type="upload"
                    {% if not showUserSelect %}
                        href="{{ baseUrl }}?momentType=upload&folderId={{ folder.id }}&{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}"
                    {% endif %}
                    class="icon-upload share-file"
                    title="Upload file"
                >
                    Upload file
                </a>
                <a
                    data-action="shareLearningMoment"
                    data-moment-type="text"
                    data-test="learning-moment-evidence-share-writeSomething"
                    {% if not showUserSelect %}
                        href="{{ baseUrl }}?momentType=text&folderId={{ folder.id }}&{{ RETURN_URL.name }}={{ encodedReturnUrl ?? RETURN_URL.current }}"
                    {% endif %}
                    class="icon-textbox share-text"
                    title="Write something"
                >
                    Write something
                </a>
            </div>
        {% endif %}

        <div class="component-action">
            <section>
                {% if user.role.isStudent %}
                    <a class='button' href="{{ routeLookup('searchUser.getProfile', { userId: user.id }) }}#tab-activity" target="_self">View Activity Feed</a>
                {% endif %}

                {% set cohortReportLink = routeLookupIfAuthorized('learningMomentEvidence.getCohortReport', { folderId: folder.id }) %}
                {% if cohortReportLink %}
                    <a class='button' href="{{ cohortReportLink }}" target="_self">View Cohort Learning Moments</a>
                {% endif %}
            </section>
        </div>

        <!-- Check that the device supports recording audio/video, and if not hide the buttons that aren't supported -->
        {# TODO: do we need to do ^^ THAT in the new page too? probably. #}
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/checkShareWorkButtons.js?v={{ config.site_version }}"></script>

        {% if showUserSelect %}
            {# TODO script/modal #}
        {% endif %}
    </section>
{% else %}
    <div class="empty-state">
        <p>
            You do not have permission to create learning moments from this component.
        </p>
    </div>
{% endif %}
