<ul class="action-list">
    {% for lesson in lessonPlans %}
        <li>
                <h3>
                    <a class="title" href="{{ lesson._links.assessment }}">{{ lesson.title }}</a>
                </h3>
                <p class="meta">
                    <span title="{{ lesson.dueDate.local }}">
                        Scheduled <time datetime="{{ lesson.dueDate.json }}">{{ lesson.dueDate.getRelativeDay }} </time>
                    </span>
                </p>
            </div>
        </li>
    {% endfor %}
</ul>
