<script type="text/javascript" src="{{ CDN_PREFIX }}/js/course/jquery.course-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/assessment/jquery.assessment-component-tot.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        var $component = $('#component{{ component.instance.id }}');
        $component.setupAssessmentComponentTot({
            emptySelector: '.empty-state',
            contentSelector: '[data-component-content]',
        });

        /* Attach Course Selector Modal listeners
         */
        $.fn.courseSelectorModal({
            courseSelector: {
                query: {
                    folder:           Number('{{ component.getContext.getFolder.getId }}'),
                    hasAdd:           false,
                    hasTot:           false,
                    linkToUnits:      false,
                    encodedReturnUrl: "{{ encodedReturnUrl | escape('js') }}"
                }
            }
        });
    });
</script>
{% import '@learning/macro/dueDate.twig' as dueDate %}
{% if lessonPlans|length %}
    <section data-component-content>
        <ul class="action-list" data-task-list>
            {% for lesson in lessonPlans %}
                {% set unit = lesson.baseContext %}

                {# What action-tot routes are available to this user? #}
                {% if readOnly %}
                    {# If readonly mode: show no tot #}
                    {% set hasAssessmentRoutes = false %}
                    {% set hasCourseRoutes = false %}
                {% else %}
                    {# If write mode: show tot only if there's at least one action #}
                    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: lesson.id, assessment: lesson}) %}
                    {% set deleteRoute = routeLookupIfAuthorized('learningAssessment.postDeleteAssessment', {assessmentId: lesson.id, assessment: lesson}) %}
                    {% set hasAssessmentRoutes = modifyRoute or deleteRoute or similarityReportRoute %}

                    {# Save to course: if spec assessment exists, this is a PUT: otherwise a POST #}
                    {% set specAssessment = lesson.specificationAssessment ?? null %}
                    {% if specAssessment %}
                        {% set saveToCourseRoute = routeLookupIfAuthorized(
                            'courseExport.putAssessmentIntoUnit',
                            {
                                assessmentId: lesson.id,
                                assessment: lesson,
                                unitSpecId: unit.specification.id,
                                unitSpec: unit.specification,
                            }
                        ) %}
                        {% set saveToCourseMethod = 'PUT' %}
                    {% else %}
                        {% set saveToCourseRoute = routeLookupIfAuthorized(
                            'courseExport.postAssessmentIntoUnit',
                            {
                                assessmentId: lesson.id,
                                assessment: lesson,
                                unitSpecId: unit.specification.id,
                                unitSpec: unit.specification,
                            }
                        ) %}
                        {% set saveToCourseMethod = 'POST' %}
                    {% endif %}
                    {% set hasCourseRoutes = saveToCourseRoute is not empty %}
                {% endif %}

                <li{% if hasAssessmentRoutes or hasCourseRoutes %} class="actions-small-1"{% endif %} data-unit-assessment="{{ lesson.id }}">
                    <div class="list-item">
                        <div class="card small-12">
                            <h3>
                                <a class="title" href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: lesson.id, studentId: USER.id}) }}">{{ lesson.title }}</a>
                            </h3>
                            <p class="meta">
                                {% if unit.specification.course.folder %}{{ unit.specification.course.folder.name }}{% endif %} | {{ unit.title }} {% if lesson.context is project and lesson.context.title %} | {{ lesson.context.title }} {% endif %}
                            </p>
                            <p class="meta">
                                {{ dueDate.forAssessment(lesson) }}
                            </p>
                        </div>
                    </div>
                    {% if hasAssessmentRoutes or hasCourseRoutes %}
                        {% set dropdownId = "options-component" ~ component.instance.id ~ "-lessonplan" ~ lesson.id %}
                        <nav>
                            <sbx-pop-out content-id="{{ dropdownId }}"></sbx-pop-out>
                        </nav>
                        <ul data-dropdown-content class="f-dropdown" id="{{ dropdownId }}">
                            {% if hasAssessmentRoutes %}
                                <li class="separator">{{ locale.translate('activity', false, true) }}</li>
                                {% if modifyRoute %}<li><a href="{{ modifyRoute }}?{{ returnUrlName }}={{ encodedReturnUrl }}" class="icon-modify" title="Modify this {{ locale.activity }}">Modify</a></li>{% endif %}
                                {% if deleteRoute %}<li><a href="{{ deleteRoute }}" class="icon-delete" data-action="delete" title="Delete this {{ locale.activity }}">Delete</a></li>{% endif %}
                            {% endif %}
                            {% if hasCourseRoutes %}
                                <li class="separator">Course</li>
                                {% if saveToCourseRoute %}
                                    <li>
                                        <a href="{{ saveToCourseRoute }}"
                                        class="icon-export"
                                        data-reveal-id="component{{ component.instance.id }}-save-to-course-modal-{{ lesson.id }}"
                                        data-method="{{ saveToCourseMethod }}"
                                        data-spec-assessment-id="{{ specAssessment.id ?? null }}"
                                        data-spec-assessment-title="{{ specAssessment.title ?? null }}"
                                        >Save to Course...</a>
                                        {% include '@learningAssessment/outline/saveToCourseModal.twig' with {
                                            assessment: lesson,
                                            specAssessment: specAssessment ?? null,
                                            saveToCourseRoute: saveToCourseRoute,
                                            saveToCourseMethod: saveToCourseMethod,
                                            componentInstance: component.instance,
                                        } only %}
                                    </li>
                                {% endif %}
                            {% endif %}
                        </ul>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        <div class="component-action">
            <section>
                <a href="{{ routeLookup('lessonPlanActivities.getHomepageComponent', {folderId: component.getContext.getFolder.getId, componentId: component.instance.id}) }}" class="button">View All</a>
            </section>
        </div>
    </section>
{% endif %}
<div class="empty-state" {% if lessonPlans|length %}hidden{% endif %}>
    <i class="icon-lesson-plan"></i>
    {% if not readOnly and not hasCourses %}
        <p>
        Lesson plans must be connected to a course. To start using lesson plans please
        <a href="{{ routeLookup('courseImport.getImport', { courseSpecId: 0, folderId: component.getContext.getFolder.getId }) }}" data-course-selector>
            import a course
        </a>
        to your class page.
        </p>
    {% else %}
        <p>You currently have no scheduled lesson plans available. You may wish to <a href="{{ routeLookup('lessonPlanActivities.getHomepageComponent', {folderId: component.getContext.getFolder.getId, componentId: component.instance.id}) }}">view all</a> lesson plans</p>
    {% endif %}
</div>
<div class="toast" data-alert></div>
