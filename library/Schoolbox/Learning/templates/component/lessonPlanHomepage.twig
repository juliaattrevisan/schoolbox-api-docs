{% import '@learning/macro/dueDate.twig' as dueDate %}
<ul class="action-list">
    {% for lesson in lessonPlans %}
        <li>
                <h3>
                    <a class="title" href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: lesson.id, studentId: USER.id}) }}">{{ lesson.title }}</a>
                </h3>
                <p class="meta">
                    {{ routeLookup('learningAssessment.getSummary', {assessmentId: lesson.id, studentId: USER.id}) }}
                    {{ routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: lesson.id, assessment: lesson}) }}
                    library/Schoolbox/Learning/Assessment/templates/outline/unitAssessments.twig
                    {{ dueDate.forAssessment(lesson) }}
{#                    <span title="{{ lesson.getAssessmentModel.dueDate.local }}">#}
{#                        Scheduled <time datetime="{{ lesson.getAssessmentModel.dueDate.json }}">{{ lesson.getAssessmentModel.dueDate.getRelativeDay }} </time>#}
{#                    </span>#}
                </p>
            </div>
        </li>
    {% endfor %}
</ul>
