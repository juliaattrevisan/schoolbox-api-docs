<ul class="action-list">
    {% for lesson in lessonPlans %}
        <li>
            <div class="card small-12" style="border-left: 6px solid {{ lesson.context.folder.colour ?? 'white' }}">
                <h3>
                    <a class="title" href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: lesson.id, studentId: USER.id}) }}">{{ lesson.title }}</a>
                </h3>
                <p>
                    <a href="/homepage/{{ lesson.context.folder.id }}">{{ lesson.context.folder.title }}</a>
                </p>
                <p class="meta">
                    <span title="{{ lesson.dueAt.local }}">
                        Scheduled <time datetime="{{ lesson.dueAt.json }}">{{ lesson.dueAt.getRelativeDay }} </time>
                    </span>
                </p>
            </div>
        </li>
    {% endfor %}
</ul>
