{#
Usage:
    assessments: IAssessable[],
#}
<ul class="information-list">
    {% for assessment in assessments %}
        <li class="list-item" data-equalizer>
            <div class="small-2 columns">
                {% set responseType = assessment is quiz ? 'attempt' : 'submission' %}
                <p class='counter' title="{{ assessment.responses | length }} new {{ responseType }}{% if assessment.responses | length > 1%}s{% endif %}">{{ assessment.responses | length }}</p>
            </div>
            <div class="card small-10" data-equalizer-watch>
                <h3><a href="{{ routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id}) }}">{{ assessment.title }}</a></h3>

                <p class="meta">
                    Last {{ responseType }} {{ assessment.responses.first.submittedAt.relativeTime }} in

                    {% set context = assessment.context %}

                    {% if context is folder %}
                        <a href="/homepage/{{ context.id }}">{{ context.title }}</a>
                    {% elseif context is unitImplementation %}
                        <a href="/homepage/{{ context.folder.id }}">{{ context.folder.title }}</a>
                    {% elseif context is project %}
                        <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: context.id}) }}">{{ context.title }}</a>
                    {% endif %}
                </p>
            </div>
        </li>
    {% endfor %}
</ul>
