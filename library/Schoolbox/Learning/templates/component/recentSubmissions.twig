{#
Usage:
    assessments: IAssessable[],
    limit:       int,
#}
<ul class="information-list">
    {% set count = 0 %}
    {% for assessment in assessments %}
        {% if not limit or count < limit %}
            <li class="list-item" data-equalizer>
                <div class="small-2 columns">
                    {% set responseType = assessment is quiz ? 'attempt' : 'submission' %}
                    {% if assessment.responses | length > 1 %}
                        {% set responseType = responseType ~ 's' %}
                    {% endif %}
                    <p class='counter' title="{{ assessment.responses | length }} new {{ responseType }}">{{ assessment.responses | length }}</p>
                </div>
                <div class="card small-10" data-equalizer-watch>
                    <h3><a href="{{ routeLookup('learningAssessment.getStatus', {assessmentId: assessment.id}) }}">{{ assessment.title }}</a></h3>

                    <p class="meta">
                        Last attempt {{ assessment.responses.first.submittedAt.relativeTime }} in
                        <a href="/homepage/{{ assessment.context.id }}">{{ assessment.context.name }}</a>
                    </p>
                </div>
            </li>
        {% endif %}

        {% set count = count + 1 %}

    {% endfor %}
</ul>