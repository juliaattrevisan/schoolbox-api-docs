{#
Usage:
    assessments: IAssessable[],
    limit:       int,
#}
{% import '@learning/macro/dueDate.twig' as dueDate %}

<ul class="information-list">
    {% for assessment in assessments %}
        <li>
            <div class="card small-12" data-equalizer>

                <h3><a class="title" href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: assessment.id, studentId: USER.id}) }}{{ returnUrl }}">{{ assessment.title }}</a></h3>

                <p class="meta">
                    {% if assessment.context is project %}
                        <a href="/homepage/{{ assessment.context.context.folder.id }}">{{ assessment.context.context.folder.title }}</a> >
                        <a href="/homepage/{{ assessment.context.context.folder.id }}">{{ assessment.context.context.title }}</a> >
                        <a href="{{ routeLookup('learningAssessment.getSummary', {assessmentId: assessment.context.id, studentId: USER.id}) }}">
                        {{ assessment.context.title }}</a>
                        {{ assessment.typeName }}
                    {% elseif assessment.context is unitImplementation %}
                        <a href="/homepage/{{ assessment.context.folder.id }}">{{ assessment.context.folder.title }}</a> >
                        <a href="/homepage/{{ assessment.context.folder.id }}">{{ assessment.context.title }}</a> {{ assessment.typeName }}
                    {% else %}
                        <a href="/homepage/{{ assessment.context.id }}">{{ assessment.context.title }}</a> {{ assessment.typeName }}
                    {% endif %}
                </p>
                <p class="meta">
                    {% if assessment.participantIfExtant(USER).isResubmissionRequired %}
                        <span data-status data-assessment-status-light class="progress-tick no-text tiny failed" title="Resubmission Required"></span><span data-status-label data-assessment-status-text>Resubmission required</span>
                    {% else %}
                    {{ dueDate.dueDate(assessment, USER) }}
                    {% endif %}
                </p>
            </div>
        </li>
    {% endfor %}
</ul>
