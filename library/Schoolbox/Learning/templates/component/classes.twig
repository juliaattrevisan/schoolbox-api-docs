{% for class in classList %}
    <div class="columns small-6 medium-6 large-4 left">
        <div class="row">
            {% include 'sub/classTile.twig' with {
                'term':      term,
                'class':     class,
                'classType': classTypes[class.id],
                'courses':   courses[class.id],
            } only %}
        </div>
    </div>
{% endfor %}
