<div class="row">
    <div class="small-12 large-6 columns">
        <h1>My Classes</h1>
    </div>
    <div class="small-12 large-6 columns">
        <div class="context-switch clearfix">
            {% include 'sub/semesterSelector.twig' with {
            terms:       terms,
            currentTerm: term,
            route:       'learning.getClasses',
            routeArgs:   {}
            } only %}
        </div>
    </div>
</div>

<div class="row">
    {% if classList is empty %}
        <div class="small-12 island">
            <div class = "empty-state">
                <i class="icon-class-list"></i>
                {% if term.contains(now) or hideTimetable %}
                    <p>You are currently not enrolled in any class.</p>
                {% else %}
                    <p>You were not enrolled in any classes during {{ term.title }}.</p>
                {% endif %}
                <p>If you expect to have classes please contact your system administrator.</p>
            </div>
        </div>
    {% else %}
        {% for class in classList %}
            <div class="small-12 medium-6 large-4 xlarge-3 island">
                <section>
                    {% include 'sub/classTile.twig' with {
                        'term':       term,
                        'class':      class,
                        'classType':  classTypes[class.id],
                        'courses':    courses[class.id],
                        'homepageUrl':homepageUrls[class.id],
                    } only %}
                </section>
            </div>
        {% endfor %}
    {% endif %}
</div>
