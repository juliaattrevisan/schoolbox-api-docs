{% import 'sub/assessmentContext.twig' as assessmentContext %}
{% import 'sub/assessmentResponse.twig' as assessmentResponse %}

<!-- BEGIN custom_head -->
<script type="text/javascript" src="/javascript/shared/jquery.collapsable.js"></script>
<!-- END custom_head -->

<ul class="breadcrumb">
    <li><a href="/">Schoolbox</a></li>
    <li class="active"><a href="{{ routeLookup('learning.getPendingAssessmentsForUser', { userId: user.id }) }}" title="Pending Assessments">Pending Assessments</a></li>
</ul>

<div class="row">
    <div class="small-12 columns"><h1>{% if viewer.id != viewee.id %}{{ viewee.fullName }}'s {% endif %}Pending Assessments</h1></div>
</div>

<div class="row">
    <div class="small-12 columns island">
        {% if assessmentsToMark|length %}
            <h2 class="subheader">Stuff you need to mark</h2>
        {% endif %}
        {% for assessment in assessmentsToMark %}
            {% set icon = assessment is task ? 'task' : assessment is quiz ? 'quiz' : 'due-work'  %}
            <section>
                <div class="content collapsible">
                    <div class="small-6 columns no-pad">
                        <h3>
                            {#- Dessicator -#}
                            <span data-collapser="to-mark-{{ assessment.id }}" class="icon-down-arrow"><span class="icon-{{ icon }}"></span>
                            {#- Dessicator -#}
                            </span><a href="{{ routeLookup('learningAssessment.getStatus', { assessmentId: assessment.id }) }}">{{ assessment.title }}</a>
                            {#- Dessicator -#}
                        </h3>
                        {{ assessmentContext.crumbs(assessment) }}
                    </div>
                    <div class="small-4 columns hide-for-small-only">

                        {%- if assessment is quiz -%}
                            {%- set submitTitleSuffix = 'attempted this quiz' -%}
                            {%- set markedTitleSuffix = 'been reviewed' -%}
                        {%- elseif assessment is dueWork %}
                            {%- set submitTitleSuffix = 'submitted work' -%}
                            {%- set markedTitleSuffix = 'recevied feedback' -%}
                        {%- elseif assessment is task -%}
                            {% set submitTitleSuffix = 'completed this task' -%}
                            {% set markedTitleSuffix = 'been teacher assessed' -%}
                        {%- endif -%}

                        <div class="progress" title="{{ assessment.numSubmitted }} of {{ assessment.numParticipants }} students have {{ submitTitleSuffix }}">
                            <span class="meter" style="width:{{ assessment.getPercentageSubmitted }}%"></span>
                            <span class="pipe-meter" style="left: {{ assessment.getPercentageMarked }}%" title="{{ assessment.numMarked }} of {{ assessment.numParticipants }} students have  {{ markedTitleSuffix }}"></span>
                        </div>
                    </div>
                    <div class="small-6 medium-2 columns text-right">
                        <p title="{{ assessment.numMarkingRequired }} of {{ assessment.numParticipants }} students require marking">{{ assessment.numMarkingRequired }} unmarked</p>
                        <p><span class="meta" title="{{ assessment.dueAt.local }}">Due {{ assessment.dueAt.relativeTime }}</span></p>
                    </div>
                    <ul class="information-list hide" data-collapsable="to-mark-{{ assessment.id }}" data-collapse-state="collapsed">
                        {% for participant in assessment.allParticipants %}
                            {% if participant.isMarkingRequired(assessment) %}
                                {% set response = participant.findMostRecentResponse(assessment) %}
                                <li>
                                    <a class="link-row" href="{{ assessmentResponse.localUrl(response) }}" title="{{ assessmentResponse.reviewResponseTitle(response) }}">
                                        <div class="compact card small-6">
                                            <img src="/portrait.php?userId={{ participant.user.externalId }}&amp;size=square64" alt="View Submission">
                                            <h3>{{ participant.user.firstname }} {{ participant.user.lastname }}</h3>
                                        </div>
                                        <div class="small-6 columns">
                                            <p title="{{ response.updatedAt.local }}">Submitted {{ response.updatedAt.relativeTime }}</p>
                                        </div>
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            </section>
        {% endfor %}

        {% if assessmentsToChase|length %}
            <h2 class="subheader">Stuff you need to chase</h2>
        {% endif %}
        {% for assessment in assessmentsToChase %}
            {%- set icon = assessment is task ? 'task' : assessment is quiz ? 'quiz' : 'due-work'  -%}
            {%- set state = assessment is quiz ? 'unattempted' : 'unsubmitted' -%}
            {%- if assessment is quiz %}
                {%- set submitTitleSuffix = 'attempted this quiz' -%}
                {%- set markedTitleSuffix = 'been reviewed' -%}
                {%- set noResultsTitleSuffix = 'attempted this quiz' -%}
            {%- elseif assessment is dueWork %}
                {%- set submitTitleSuffix = 'submitted work' -%}
                {%- set markedTitleSuffix = 'recevied feedback' -%}
                {%- set noResultsTitleSuffix = 'submitted work or received feedback' -%}
            {%- elseif assessment is task %}
                {%- set submitTitleSuffix = 'self-assessed this task' -%}
                {%- set markedTitleSuffix = 'been teacher assessed' -%}
                {%- set noResultsTitleSuffix = 'completed this task' -%}
            {%- endif -%}
            <section>
                <div class="content collapsible">
                    <div class="small-6 columns no-pad">
                        <h3>
                            {#- Dessicator -#}
                            <span data-collapser="to-chase-{{ assessment.id }}" class="icon-down-arrow"><span class="icon-{{ icon }}"></span>
                            {#- Dessicator -#}
                            </span><a href="{{ routeLookup('learningAssessment.getStatus', { assessmentId: assessment.id }) }}">{{ assessment.title }}</a>
                            {#- Dessicator -#}
                        </h3>
                        {{ assessmentContext.crumbs(assessment) }}
                    </div>
                    <div class="small-4 columns hide-for-small-only">
                        <div class="progress" title="{{ assessment.numSubmitted }} of {{ assessment.numParticipants }} students have {{ submitTitleSuffix }}">
                            <span class="meter" style="width:{{ assessment.getPercentageSubmitted }}%"></span>
                            <span class="pipe-meter" style="left: {{ assessment.getPercentageMarked }}%" title="{{ assessment.numMarked }} of {{ assessment.numParticipants }} students have  {{ markedTitleSuffix }}"></span>
                        </div>
                    </div>
                    <div class="small-6 medium-2 columns text-right">
                        <p title="{{ assessment.numNoResponseOrFeedback }} of {{ assessment.numParticipants }} students have not {{ noResultsTitleSuffix }}">{{ assessment.numNoResponseOrFeedback }} {{ state }}</p>
                        <p><span class="meta" title="{{ assessment.dueAt.local }}">Due {{ assessment.dueAt.relativeTime }}</span></p>
                    </div>
                    <ul class="information-list hide" data-collapsable="to-chase-{{ assessment.id }}" data-collapse-state="collapsed">
                        {% set studentEmails = [] %}
                        {% for participant in assessment.allParticipants %}
                            {% if not participant.findAllResponsesForAssessable(assessment)|length and not participant.findAllFeedbackForAssessable(assessment)|length %}
                                {% set studentEmails = studentEmails|merge([participant.user.getEmail()]) %}
                                <li>
                                    <a class="link-row" href="/search/user/{{ participant.user.id }}">
                                        <div class="compact card small-6">
                                            <img src="/portrait.php?userId={{ participant.user.externalId }}&amp;size=square64" alt="View Submission">
                                            <h3>{{ participant.user.firstname }} {{ participant.user.lastname }}</h3>
                                        </div>
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
                <div class="component-action" data-collapsable="to-chase-{{ assessment.id }}" data-collapse-state="collapsed" style="display: none;">
                    <section>
                        <form action="/mail/createMail.php" method="post" class="no-margin">
                            <div class="row">
                                <div class="small-12 columns">
                                    <input type="hidden" name="subject" value="Overdue - {{ assessment.title }}"/>
                                    <input type="hidden" name="replyto" value="{{ viewee.getEmail() }}"/>
                                    <input type="hidden" name="bcc" value="{{ studentEmails|join(',') }}"/>
                                    <button type="submit" class="button icon-email">Email all</button>
                                </div>
                            </div>
                        </form>
                    </section>


                </div>
            </section>
        {% endfor %}

        {% if not assessmentsToMark|length and not assessmentsToChase|length %}
            <div class="empty-state">
                <i class="icon-approve"></i>
                <p>You have no Assessments to Mark or Chase. Nice one!</p>
            </div>
        {% endif %}
    </div>
</div>

<script type="text/javascript">
    $(function () {
        $('[data-collapser]').collapsable();
    });
</script>