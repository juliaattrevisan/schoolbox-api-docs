{#
    Text-input for 'total-mark' markScheme.

    Usage: [
        markScheme:  MarkScheme\TotalMarkFractional
        tabIndex:    int
        errors:      string[]       Admin-configured submission states
        readonly:    bool           Should this form input be rendered as readonly?
    ]
#}

{% if markScheme.totalMark // 1 != markScheme.totalMark %}
    {% set formattedMark = markScheme.totalMark | number_format(2) %}
{% else %}
    {% set formattedMark = markScheme.totalMark | number_format(0) %}
{% endif %}

{% include '@learningMarkScheme/fragments/text-input.twig' with {
participant: participant,
feedback:    feedback,
tabIndex:    tabIndex,
placeholder: readonly ? '(no mark given)' : 'Mark out of ' ~ formattedMark,
limit:       formattedMark,
maxLength:   16,
inputTitle:  'Maximum Mark: ' ~ formattedMark,
errors:      errors,
readonly:    readonly,
totalMark: 1,
} only %}

