{#
    Text-input for 'total-mark' markScheme.

    Usage: [
        markScheme:  MarkScheme\TotalMarkFractional
        tabIndex:    int
        errors:      string[]       Admin-configured submission states
        readonly:    bool           Should this form input be rendered as readonly?
    ]
#}
{% import '@learningMarkScheme/macro/limitDecimal.twig' as limit_decimal %}

{% include '@learningMarkScheme/fragments/text-input.twig' with {
    participant: participant,
    feedback:    feedback,
    tabIndex:    tabIndex,
    placeholder: readonly ? '(no mark given)' : 'Mark out of ' ~ limit_decimal.limit(markScheme.totalMark, 2),
    limit:       limit_decimal.limit(markScheme.totalMark, 2),
    maxLength:   16,
    inputTitle:  'Maximum Mark: ' ~ limit_decimal.limit(markScheme.totalMark, 2),
    errors:      errors,
    readonly:    readonly,
    totalMark: 1,
} only %}

{% if not readonly %}

    <script type="text/javascript">
        $(function() {
            $('#mark-{{ participant.user.id }}').combobox({{ errors | json_encode | raw }});

            {# Explode on the slash to determine numerator/denominator
             # Unfortunately this replicates backend logic
             # Both parts must be numeric
             # Numerator must be at least 0 otherwise it's an illegal attribution
             #}
            jQuery.validator.addMethod("withinRange", function(value, element) {
                var parts = $(element).val().split('/');

                {# Trim perhaps-adjacent spaces to test for numeric representation
                 #}
                parts[0] = $.trim(parts[0]);
                parts[1] = $.trim(parts[1]);

                if ($.isNumeric(parts[0]) && $.isNumeric(parts[1])) {
                    var numerator = parseInt(parts[0]);
                    var denominator = $(element).attr('data-validation-limit');

                    return numerator >= 0 && numerator <= denominator;
                }

                {# Otherwise it could be one of the submission states like Absent or Not Submitted
                 # so test that it's one of the available customisable options
                 #}
                return $(element).parents('.combobox').find('.combobox_selector li:contains("' + $(element).val() + '")').length > 0;

            }, 'The grade must be between 0 and ' + $('input[name="mark"]').attr('data-validation-limit') + '.');

            $("[data-feedback-form]").alaressValidate(
                {
                    rules: {
                        mark: {
                            withinRange: true
                        }
                    }
                }
            );

            {# Always run upon load #}
            $('[data-feedback-form]').valid();
        });
    </script>
{% endif %}
