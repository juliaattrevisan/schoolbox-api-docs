{##
 # Combobox text input/dropdown ui element
 #
 # This is where you type in a grade for the Response given by the student.
 # It applies to the "Total Mark" MarkType.
 #
 # For quizzes, each person's attempt can vary from other attempts, which occurs
 # when the content of quiz changes halfway through everyone doing it. The $limit
 # param, if specified, takes precedence over a derived value from the assessment's
 # MarkScheme instance.
 #
 # @param MarkScheme\TotalMarkFractional $markScheme
 # @param int $tabIndex
 # @param string[] $errors  Admin-configured submission states
 # @param bool $readonly  Should this form input be rendered as readonly?
 # @param bool $useInstructorMark  Should the instructor mark be used? (only relevant for due works)
 #
 # Optional precdence: used for quiz only
 # @param float $limit  Maximum marks available per attempt, indexed by user id
 #}
{% import '@learningMarkScheme/macro/limitDecimal.twig' as limit_decimal %}

{# How many decimal places we allow #}
{% set precision = 2 %}

{# Accommodate quiz attempts' uniqueness #}
{% set limit = limit ?? limit_decimal.limit(markScheme.totalMark, precision) %}

{% include '@learningMarkScheme/fragments/text-input.twig' with {
    participant: participant,
    feedback:    feedback,
    tabIndex:    tabIndex,
    placeholder: readonly ? '(no mark given)' : 'Mark out of ' ~ limit,
    useInstructorMark: useInstructorMark,
    limit:       limit,
    maxLength:   48,
    inputTitle:  'Maximum Mark: ' ~ limit,
    errors:      errors,
    readonly:    readonly,
    totalMark: 1,
} only %}

{% if not readonly %}
    <script type="text/javascript">
        $(function() {
            $('#mark-{{ participant.user.id }}').combobox({{ errors | json_encode | raw }});

            let participantForm = $('[data-feedback-form="' + '{{ participant.user.id }}' + '"]');

            participantForm.alaressValidate(
                {
                    rules: {
                        mark: {
                            withinRange: true
                        }
                    },
                    messages: {
                        mark: {
                            withinRange: 'The grade must be between 0 and ' + participantForm.find('input[name="mark"]').attr('data-validation-limit') + '.'
                        }
                    }
                }
            );

            {# Always run upon load #}
            participantForm.valid();
        });
    </script>
{% endif %}
