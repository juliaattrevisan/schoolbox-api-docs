{% extends '@learningMarkScheme/commentable.twig' %}

{% block grading %}
<label>Grade
    <input
            placeholder='    / {{ markScheme.totalMark }}'
            data-validation-limit="{{ markScheme.totalMark }}"
            class="no-margin"
            id="mark-{{ participant.user.id }}" name="mark"
            type="text"
            maxlength="16"
            value="{{ participant.mark.unpublished.humanReadable }}"
            title="Maximum Mark: {{ markScheme.totalMark }}"
            data-mark-input
            data-combobox
    />
</label>
{% endblock %}
