{#
    Renders a text input where teachers. Combo box data attr picked up by plugin to insert submission-states.

    Usage: [
        participant:  Participant    a fully hydrated participant object
        tabIndex:     int
        placeholder:  string         the placeholder text
        limit:        float          JS validation
        maxLength:    int            how big can this input be?
        inputTitle:   string         the tooltip to display on this input
        errors:       string[]       Admin-configured submission states
        readonly:     bool           Should this form input be rendered as readonly?
    ]
#}

{% if feedback %}
    {% set humanReadableMark = feedback.humanReadableMark(false) %}
{% else %}
    {% set humanReadableMark = '' %}
{% endif %}

<input
        tabindex="{{ tabIndex }}"
        placeholder="{{ placeholder }}"
        data-validation-limit="{{ limit }}"
        class="no-margin"
        id="mark-{{ participant.user.id }}" name="mark"
        type="text"
        maxlength="{{ maxLength }}"
        value="{{ humanReadableMark }}"
        title="{{ inputTitle }}"
        data-mark-input
        data-combobox
        {% if readonly %}readonly{% endif %}
/>

{% if not readonly %}
    <script type="text/javascript">
        $(function() {
            $('#mark-{{ participant.user.id }}').combobox({{ errors | json_encode | raw }});

            $("[data-feedback-form]").alaressValidate(
                {
                    rules: {
                        mark: {
                            min: {
                                depends: function () {
                                    if ($.isNumeric($(this).val()) && parseInt($(this).val()) < 0) {
                                        return true;
                                    }
                                }
                            },
                            max: {
                                depends: function () {
                                    if ($.isNumeric($(this).val()) && $(this).val() > parseInt($(this).attr('data-validation-limit'))) {
                                        return $(this).attr('data-validation-limit');
                                    }
                                }
                            }
                        }
                    },
                    messages: {
                        mark: 'The grade must be between 0 and ' + $('input[name="mark"]').attr('data-validation-limit') + '.'
                    }
                }
            );
        });
    </script>
{% endif %}
