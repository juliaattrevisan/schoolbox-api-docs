{#
    Renders an input where teachers can specify a letter grade

    Usage: [
        participant:  Participant
        tabIndex:     int
        markScheme:   LetterGrade
        errors:       string[]       Admin-configured submission states
        readonly:     bool           Should this form input be rendered as readonly?
    ]
#}

{% set humanReadableMark = participant.humanReadableMark(false) %}

<select data-mark-input name="mark" tabindex="{{ tabIndex }}" {% if readonly %}disabled{% endif %}>

    {# Empty state #}
    {% set found = (humanReadableMark is null) %}
    <option value="" disabled {% if humanReadableMark is null %}selected{% endif %}>(no grade)</option>

    {# Grade levels #}
    <optgroup label="{{ locale.grades.properPlural }}">
        {% for level in markScheme.gradeGroup.gradeLevels %}
            {% set selected = false %}
            {% if not (humanReadableMark is null) and (humanReadableMark == level.caption) %}
                {% set selected = true %}
                {% set found = true %}
            {% endif %}
            <option {% if selected %}selected{% endif %} value="{{ level.caption }}">{{ level.caption }}</option>
        {% endfor %}
    </optgroup>

    {# Submission states #}
    <optgroup label="States">
        {% for state in errors %}
            {% set selected = false %}
            {% if not (humanReadableMark is null) and (humanReadableMark == state) %}
                {% set selected = true %}
                {% set found = true %}
            {% endif %}
            <option {% if selected %}selected{% endif %} value="{{ state }}">{{ state }}</option>
        {% endfor %}
    </optgroup>

    {# If nothing at all was selected, then either a grade level or submission state changed. #}
    {# Show this as a disabled option - on save, nothing will change #}
    {% if not found %}
        <option value="" disabled selected>{{ humanReadableMark }}</option>
    {% endif %}
</select>


