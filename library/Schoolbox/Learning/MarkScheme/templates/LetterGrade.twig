{% extends '@learningMarkScheme/commentable.twig' %}

{% block grading %}
    <label>Grade
        <select>
            {% if participant.mark.unpublished.humanReadable %}
                <option disabled="disabled">(Select grade)</option>
                <option selected="selected" value="{{ latestFeedback.normalisedMark }}">{{ latestFeedback.humanReadableMark }}</option>
            {% else %}
                <option disabled="disabled" selected="selected">(Select grade)</option>
            {% endif %}
            <option>A+</option>
            <option>A</option>
            <option>B+</option>
            <option>B</option>
        </select>
    </label>
{% endblock %}
