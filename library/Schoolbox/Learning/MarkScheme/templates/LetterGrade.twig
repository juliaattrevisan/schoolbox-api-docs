{#
    Renders an input where teachers can specify a letter grade

    Usage: [
        participant:  Participant
        tabIndex:     int
        markScheme:   LetterGrade
        errors:       string[]       Admin-configured submission states
        readonly:     bool           Should this form input be rendered as readonly?
    ]
#}

{% if readonly %}
    {% include '@learningMarkScheme/fragments/text-input.twig' with {
        participant: participant,
        feedback:    feedback,
        tabIndex:    tabIndex,
        placeholder: readonly ? '(no grade given)' : '(no grade)',
        limit:       100,
        maxLength:   16,
        inputTitle:  '',
        errors:      errors,
        readonly:    readonly
    } only %}
{% else %}

    <script type="text/javascript">
        $(function() {
            $('#mark-{{ participant.user.id }}').combobox({{ errors | json_encode | raw }});

            $("[data-feedback-form]").alaressValidate(
                {
                    rules: {
                        mark: {
                            min: {
                                depends: function () {
                                    if ($.isNumeric($(this).val()) && parseInt($(this).val()) < 0) {
                                        return true;
                                    }
                                }
                            },
                            max: {
                                depends: function () {
                                    if ($.isNumeric($(this).val()) && $(this).val() > parseInt($(this).attr('data-validation-limit'))) {
                                        return $(this).attr('data-validation-limit');
                                    }
                                }
                            }
                        }
                    },
                    messages: {
                        mark: 'The grade must be between 0 and ' + $('input[name="mark"]').attr('data-validation-limit') + '.'
                    }
                }
            );
        });
    </script>

    {% if feedback %}
        {% set humanReadableMark = feedback.humanReadableMark(false) %}
    {% else %}
        {% set humanReadableMark = participant.humanReadableMark(false) %}
    {% endif %}

    <select class="letter-grade-select" data-mark-input name="mark" tabindex="{{ tabIndex }}" title="Select a {{ locale.grades.proper }}">

        {# Empty state #}
        {% set found = (humanReadableMark is null) %}
        <option value="" disabled {% if humanReadableMark is null %}selected{% endif %}>(no grade)</option>

        {# Grade levels #}
        <optgroup label="{{ locale.grades.properPlural }}">
            {% for level in markScheme.gradeGroup.gradeLevels %}
                {% set selected = false %}
                {% if not (humanReadableMark is null) and (humanReadableMark == level.caption) %}
                    {% set selected = true %}
                    {% set found = true %}
                {% endif %}
                <option {% if selected %}selected{% endif %} value="{{ level.caption }}">{{ level.caption }}</option>
            {% endfor %}
        </optgroup>

        {# Submission states #}
        <optgroup label="States">
            {% for state in errors %}
                {% set selected = false %}
                {% if not (humanReadableMark is null) and (humanReadableMark == state) %}
                    {% set selected = true %}
                    {% set found = true %}
                {% endif %}
                <option {% if selected %}selected{% endif %} value="{{ state }}">{{ state }}</option>
            {% endfor %}
        </optgroup>

        {# If nothing at all was selected, then either a grade level or submission state changed. #}
        {# Show this as a disabled option - on save, nothing will change #}
        {% if not found %}
            <option value="" disabled selected>{{ humanReadableMark }}</option>
        {% endif %}
    </select>
{% endif %}


