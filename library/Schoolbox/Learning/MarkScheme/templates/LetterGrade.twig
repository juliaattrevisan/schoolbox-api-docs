{% extends '@learningMarkScheme/commentable.twig' %}

{% block grading %}
    {% set mark = participant.mark.unpublished %}
    <label>Grade
        <select name="mark" tabindex="{{ tabIndex.mark }}">

            {# Empty state #}
            <option value="" disabled {% if mark.humanReadable is null %}selected{% endif %}>(no grade)</option>

            {# Grade levels #}
            <optgroup label="Grades">
                {% for level in markScheme.gradeGroup.gradeLevels %}
                    {% set selected = not (mark.humanReadable is null) and (mark.humanReadable == level.caption) %}
                    <option {% if selected %}selected{% endif %} value="{{ level.caption }}">{{ level.caption }}</option>
                {% endfor %}
            </optgroup>

            {# Submission states #}
            <optgroup label="States">
                {% for state in errors %}
                    {% set selected = not (mark.humanReadable is null) and (mark.humanReadable == state) %}
                    <option {% if selected %}selected{% endif %} value="{{ state }}">{{ state }}</option>
                {% endfor %}
            </optgroup>

        </select>
    </label>
{% endblock %}
