{#
    Renders an input where teachers can specify a letter grade

    Usage: [
        participant:  Participant
        tabIndex:     int
        markScheme:   LetterGrade
        errors:       string[]       Admin-configured submission states
        readonly:     bool           Should this form input be rendered as readonly?
    ]
#}

{% if readonly %}
    {% include '@learningMarkScheme/fragments/text-input.twig' with {
        participant: participant,
        feedback:    feedback,
        tabIndex:    tabIndex,
        placeholder: readonly ? '(no grade given)' : '(no grade)',
        limit:       100,
        maxLength:   16,
        inputTitle:  '',
        errors:      errors,
        readonly:    readonly
    } only %}
{% else %}

    <script type="text/javascript">
        $(function() {
            $('#mark-{{ participant.user.id }}').combobox({{ errors | json_encode | raw }});

            $('[data-feedback-form="' + '{{ participant.user.id }}' + '"]').alaressValidate(
                {
                    rules: {
                        mark: {
                            withinLetterGradeRange: true
                        }
                    },
                    messages: {
                        mark: {
                            withinLetterGradeRange: 'Please select one of the available letter grade options.'
                        }
                    }
                }
            );

            {# Always run upon load #}
            $('[data-feedback-form="' + '{{ participant.user.id }}' + '"]').valid();
        });
    </script>

    {% if feedback %}
        {% set humanReadableMark = feedback.humanReadableMark(false) %}
    {% else %}
        {% set humanReadableMark = participant.humanReadableMark(false) %}
    {% endif %}

    {% set found = false %}
    <select class="letter-grade-select" data-mark-input name="mark" tabindex="{{ tabIndex }}" title="Select a {{ locale.grades.proper }}">

        {# If humanReadableMark is null, there isn't an existing mark; this is a new draft
         # Select No Grade. Otherwise we need to find out whether the humanReadableMark exists
         # in one of the other places that might match
         #}
        <option value="" disabled {% if humanReadableMark|length == 0 %}selected{% endif %}>(no grade)</option>

        {# If humanReadableMark has a value, look for it among the current Grade Group dropdown options.
         # If it's not here, then it might be one of the Submission States
         #}
        <optgroup label="{{ locale.grades.properPlural }}">
            {% for level in markScheme.gradeGroup.gradeLevels %}
                {% set selected = '' %}

                {% if humanReadableMark == level.caption %}
                    {% set found = true %}
                    {% set selected = 'selected' %}
                {% endif %}

                <option {{ selected }} value="{{ level.caption }}">
                    {{ level.caption }}
                </option>
            {% endfor %}
        </optgroup>

        {# If it didn't exist in the Grade Group, it might have been one of the Submission States
         # like Submitted/Absent/Pending etc. so look there as well
         #}
        <optgroup label="States">
            {% for state in errors %}
                {% set selected = '' %}

                {% if humanReadableMark == state %}
                    {% set found = true %}
                    {% set selected = 'selected' %}
                {% endif %}

                <option {{ selected }} value="{{ state }}">
                    {{ state }}
                </option>
            {% endfor %}
        </optgroup>

        {# If it still hasn't been found, then the humanReadableMark needs amendment by the teacher because:
         #   a) it's a value from a different mark scheme than what the assessment currently uses; or
         #   b) it's a value from a Grade Group option that no longer exists; or
         #   c) it's a value from a Submission State option that no longer exists; or
         #   d) some other unknown value under some other unknown circumstance
         #
         # Use -1 as an illegal value flag so alaressValidate can understand that this selected option
         # should be changed to an actual option
         #}
        {% if humanReadableMark|length and not found %}
            <option value="-1" selected style="display:none"></option>
        {% endif %}
    </select>
{% endif %}


