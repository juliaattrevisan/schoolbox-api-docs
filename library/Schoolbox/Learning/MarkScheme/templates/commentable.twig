{# TODO create feedback routes #}

{##
 # assessment           An IAssessable instance
 # fbUrl                A url to a place which saves the values of this form
 # feedbackAttachzone   An attachzone for uploading files
 # latestFeedback       An IFeedback instance for most recent Feedback for response
 # participant          A Participant instance
 # response             An IResponse instance
 # rubricContext        A RubricContext instance
 #}

{% if participant.allFeedbacks | length and not participant.findMostRecentFeedback.published %}
    {% set savedStatusText = 'Saved as Draft' %}
{% else %}
    {% set actionStyle     = 'display:none;' %}
    {% set publishHide     = 'hide' %}
    {% set publishDisabled = 'disabled="disabled"' %}
{% endif %}

{% set tabIndex = {
    mark: (loop.index0 * 2) + 1,
    comment: (loop.index0 * 2) + 2
} %}

<form method="post" action="{{ fbUrl }}">
    <input type="hidden" name="responseId" value="{{ response.id }}" />

    <div class="row">

        {% if assessment.useRubric and rubricContext %}
        <div class="small-12 island">
            {% include '@rubric/grid-markable.twig' with {
                rubric: rubricContext.rubric,
                markType: rubricContext.markType
            } only %}
        </div>
        {% endif %}

        <div class="small-12 medium-3 column">
            {% block grading %}{% endblock %}

            {% if assessment.useRubric and rubricContext %}
            <script type="text/javascript">
                $(function () {

                    // cache this stuff, it doesn't change
                    var $status                 = $('#assessment-status'),
                        $markInput              = $status.find('[data-mark-input]'),
                        $assignFromRubricButton = $('#use-rubric-value'),
                        $rb                     = $('#rb-{{ rubricContext.rubric.id }}'),
                        $finalSummary           = $rb.find('[data-final-summary]');


                    function refreshAssignFromRubricButton() {
                        var currentRubricValue = $.trim($finalSummary.text());
                        var currentMarkInput   = $markInput.val();

                        $assignFromRubricButton.prop('disabled', currentRubricValue === currentMarkInput);
                    }


                    {##
                     # Use the rubric value in the mark input field
                     #
                     # Disabled upon load, since values are the same
                     # at this point in time. Also disables when copying
                     # the rubric mark value in.
                     #}
                    $assignFromRubricButton.on('click', function() {
                        $(this).prop('disabled', true);

                        $status
                            .find('[data-mark-input]')
                            .val($.trim($finalSummary.text()))
                            .change();
                    });

                    // listen for this
                    $rb.on('change', '[data-rubric], [data-rubric-group]', refreshAssignFromRubricButton);
                    $markInput.on('change', refreshAssignFromRubricButton);

                    // do it on pageload anyway
                    refreshAssignFromRubricButton();
                });
            </script>

            {% if assessment.markType.id != MARK_TYPE_NONE %}
                <p><button id="use-rubric-value" class="full-width">Assign Grade from Rubric</button></p>
            {% endif %}
            {% endif %}
        </div>
        <div class="small-12 medium-9 column">
            <label>Comment
                <textarea tabindex="{{ tabIndex.comment }}" name="comment" placeholder="Feedback for {{ participant.user.firstName }}" rows="3">{{ latestFeedback.comment }}</textarea>
            </label>
        </div>
        {# Maybe files may be uploaded here? #}
        {% if feedbackAttachzone %}
            <div class="small-12 columns">
                {% include 'sub/attachzone.twig' with {attachzone: feedbackAttachzone} %}
            </div>
        {% endif %}


        {#
        If this is the quick mark screen and there's any files, rubric marks, or crocoodoc annotated doc
        attached to the feedback - tell the user that this feedback also includes those.
        #}
        {% if not inlineGrader and latestFeedback and (latestFeedback.allFiles.count > 0 or rubricMarks[participant.user.id]) %}

            {# If we're going to be displaying something here - override the hide on .component-action #}
            {% set actionStyle = '' %}

            {% set attachedMsg = 'Feedback also includes <a href="' ~ pActionResponses ~ '">' %}

            {# Check if this feedback has a crocodoc annotation attached to it #}
            {% set hasCrocodoc = false %}
            {% if latestFeedback.response.allFiles.count > 0 %}
                {% for currentFile in latestFeedback.response.allFiles %}
                    {% if currentFile.crocodocId %}
                        {% set hasCrocodoc = true %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            {# Annotated document/Crocodoc #}
            {% if hasCrocodoc %}
                {% set attachedMsg = attachedMsg ~ 'annotated document' %}
            {% endif %}

            {# Rubric #}
            {% if rubricMarks[participant.user.id] %}
                {% if hasCrocodoc and latestFeedback.allFiles.count > 0 %}
                    {% set attachedMsg = attachedMsg ~ ', ' %}
                {% elseif hasCrocodoc and latestFeedback.allFiles.count == 0 %}
                    {% set attachedMsg = attachedMsg ~ ' and ' %}
                {% endif %}
                {% set attachedMsg = attachedMsg ~ 'rubric' %}
            {% endif %}

            {# Files #}
            {% if latestFeedback.allFiles.count > 0 %}

                {% if hasCrocodoc or rubricMarks[participant.user.id] %}
                    {% set attachedMsg = attachedMsg ~ ' and ' %}
                {% endif %}

                {% set attachedMsg = attachedMsg ~ latestFeedback.allFiles.count ~ ' file' %}

                {% if latestFeedback.allFiles.count > 1 %}
                    {% set attachedMsg = attachedMsg ~ 's' %}
                {% endif %}

            {% endif %}

            {% set attachedMsg = attachedMsg ~ '</a>.' %}

        {% endif %}

        <div class="small-12 column no-pad">
            <div class="component-action" data-interaction-draft="{{ participant.user.id }}" {% if latestFeedback.published %}data-published="true"{% endif %} style="{{ actionStyle }}">
                <section>

                    {% if attachedMsg %}
                        <div class="component-action-info" data-feedback-attach-info>{{ attachedMsg|capitalize|raw }}</div>
                    {% endif %}

                    <div>
                        {%- spaceless %}
                            <span class="button disabled" data-draft="drafted" title="You can discard this draft from the Grading Overview screen">{{ savedStatusText }}</span>
                            <a class="button {{ publishHide }}" data-draft="publish" {{ publishDisabled }}>Publish</a>
                        {% endspaceless -%}
                    </div>
                </section>
            </div>
        </div>
    </div>
</form>
