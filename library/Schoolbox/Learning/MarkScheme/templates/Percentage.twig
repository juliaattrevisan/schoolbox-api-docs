{#
    Text-input for 'percentage' markScheme.

    Usage: [
        markScheme:  MarkScheme\Percentage
        tabIndex:    int
        errors:      string[]       Admin-configured submission states
        readonly:     bool          Should this form input be rendered as readonly?
    ]
#}


{% include '@learningMarkScheme/fragments/text-input.twig' with {
    participant: participant,
    feedback:    feedback,
    tabIndex:    tabIndex,
    placeholder: readonly ? '(no mark given)' : 'Percentage mark',
    limit:       100,
    maxLength:   16,
    inputTitle:  'Percentage',
    errors:      errors,
    readonly:    readonly
} only %}

{% if not readonly %}
    <script type="text/javascript">
        $(function() {
            $('#mark-{{ participant.user.id }}').combobox({{ errors | json_encode | raw }});

            $("[data-feedback-form]").alaressValidate(
                {
                    rules: {
                        mark: {
                            min: {
                                depends: function () {
                                    if ($.isNumeric($(this).val()) && parseInt($(this).val()) < 0) {
                                        return true;
                                    }
                                }
                            },
                            max: {
                                depends: function () {
                                    if ($.isNumeric($(this).val()) && $(this).val() > parseInt($(this).attr('data-validation-limit'))) {
                                        return $(this).attr('data-validation-limit');
                                    }
                                }
                            }
                        }
                    },
                    messages: {
                        mark: 'The grade must be between 0 and ' + $('input[name="mark"]').attr('data-validation-limit') + '.'
                    }
                }
            );
        });
    </script>
{% endif %}

