{#
    Text-input for 'percentage' markScheme.

    Usage: [
        markScheme:  MarkScheme\Percentage
        tabIndex:    int
        errors:      string[]       Admin-configured submission states
        readonly:     bool          Should this form input be rendered as readonly?
        useInstructorMark: bool     Should the instructor mark be used? (only relevant for due works)
    ]
#}


{% include '@learningMarkScheme/fragments/text-input.twig' with {
    participant: participant,
    feedback:    feedback,
    tabIndex:    tabIndex,
    placeholder: readonly ? '(no mark given)' : 'Percentage mark',
    useInstructorMark: useInstructorMark,
    limit:       100,
    maxLength:   48,
    inputTitle:  'Percentage',
    errors:      errors,
    readonly:    readonly
} only %}

{% if not readonly %}
    <script type="text/javascript">
        $(function() {
            $('#mark-{{ participant.user.id }}').combobox({{ errors | json_encode | raw }});

            $('[data-feedback-form="' + '{{ participant.user.id }}' + '"]').alaressValidate(
                {
                    rules: {
                        mark: {
                            withinPercentageRange: true
                        }
                    },
                    messages: {
                        mark: {
                            withinPercentageRange: 'The grade must be between 0 and ' + $('input[name="mark"]').attr('data-validation-limit') + '.'
                        }
                    }
                }
            );

            {# Always run upon load #}
            $('[data-feedback-form="' + '{{ participant.user.id }}' + '"]').valid();
        });
    </script>
{% endif %}
