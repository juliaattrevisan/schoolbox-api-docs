<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/doT/doT.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/curriculum/jquery.curriculum-import.js?v={{ config.site_version }}"></script>
<!-- Template for the tree -->
{% verbatim %}
<script id="node-template" type="text/x-dot-template">
    <li>
        {{?it.code }}
        <strong>[{{!it.code }}]</strong>
        {{?}}
        {{?it.name }}
        {{!it.name }}
        {{?}}
        {{?it.description }}
        <article>{{=it.description }}</article>
        {{?}}
    </li>
</script>
{% endverbatim %}
<script type="text/javascript">
    $(function() {
        $('[data-role="curriculum-import"]').curriculumImport({
            formSelector: 'form',
            source: {
                tabSelector: '#step-1',
                sourceSelect: {
                    selector: 'select[name="source"]'
                }
            },
            curriculum: {
                tabSelector: '#step-2',
                levelSelect: {
                    selector: 'select[name="learningLevel"]'
                },
                areaSelect: {
                    selector: 'select[name="learningArea"]'
                },
                optionsUrl: {{ routeLookup('curriculumImport.learningLevels')|json_encode|raw }}
            },
            outcomes: {
                containerSelector: '[data-role="outcomes-container"]',
                tabSelector: '#step-3',
                nodeTemplate: $('script#node-template').html().trim(),
                outcomeUrl: {{ routeLookup('curriculumImport.outcomes')|json_encode|raw }},
                returnUrl: {{ routeLookup('curriculum.browse')|json_encode|raw }}
            }
        });
    });
</script>


<ul class="breadcrumb">
    <li><a href="/curriculum">Curriculum</a></li>
    <li class="active"><span>Import</span></li>
</ul>


<div class="row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Import Curriculum</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 island" data-role="curriculum-import">
        <form action="{{ routeLookup('curriculumImport.create')|e('html_attr') }}" method="post">
            <dl class="tabs" data-tab>
                <dd class="active"><a href="#step-1">Source</a></dd>
                <dd><a href="#step-2" disabled class="disabled">Curriculum</a></dd>
                <dd><a href="#step-3" disabled class="disabled">Preview</a></dd>
            </dl>
            <div class="tabs-content">
                <div id="step-1" class="content active">
                    <section>
                        <fieldset class="content">
                            <div class="small-12 column">
                                <label for="curriculumSource">Curriculum Source</label>
                                <select name="source" id="curriculumSource">
                                    <option value="">Select a source</option>
                                    {% for item in sourceList %}
                                        <option value="{{ item.id|e('html_attr') }}"
                                                label="{{ item.name|e('html_attr') }}"
                                                title="{{ item.description|e('html_attr') }}"
                                                >{{ item.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </fieldset>
                    </section>
                    <input type="submit" value="Use This Source" disabled />
                </div>
                <div id="step-2" class="content">
                    <section>
                        <fieldset class="content">
                            <div class="small-12 column">
                                <label for="curriculumLearningLevel">Level:</label>
                                <select name="learningLevel" id="curriculumLearningLevel" disabled>
                                    <option value="">Select a level</option>
                                </select>
                                <label for="curriculumLearningArea">Learning Area</label>
                                <select name="learningArea" id="curriculumLearningArea" disabled>
                                    <option value="">Select an area</option>
                                </select>
                            </div>
                        </fieldset>
                    </section>
                    <input type="submit" value="Search" disabled />
                </div>
                <div id="step-3" class="content">
                    <section>
                        <fieldset class="content">
                            <div class="small-12 column">
                                <article>
                                    <ul data-role="outcomes-container"></ul>
                                </article>
                            </div>
                        </fieldset>
                    </section>
                    <input type="submit" value="Save Curriculum" disabled />
                </div>
            </div>
        </form>
    </div>
</div>
