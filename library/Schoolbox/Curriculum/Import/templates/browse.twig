<script type="text/javascript" src="/javascript/components/doT/doT.js"></script>
<!-- Template for the tree -->
{% verbatim %}
<script id="node-template" type="text/x-dot-template">
    <li class="curriculum-node">
        {{?it.code }}
        <span class="code">[{{!it.code }}]</span>
        {{?}}
        {{?it.name }}
        <span class="name">{{!it.name }}</span>
        {{?}}
        {{=it.description }}
    </li>
</script>
{% endverbatim %}
<script type="text/javascript">
    (function($) {
        var template         = doT.template($('script#node-template').html().trim());
        var learningLevelUrl = {{ routeLookup('curriculumImport.learningLevels')|json_encode|raw }};
        var outcomeUrl       = {{ routeLookup('curriculumImport.outcomes')|json_encode|raw }};
        var browseUrl        = {{ routeLookup('curriculum.browse')|json_encode|raw }};

        var makeTree = function(nodes, destination) {
            nodes.forEach(function(node) {
                var subList = [];
                if (node.children.length) {
                    subList = $('<ul />');
                    makeTree(node.children, subList);
                }
                var listItem = $(template(node))
                    .data('reference', node.reference)
                    .append(subList);
                destination.append(listItem);
            })
        };

        $(function() {
            var form = $('form#curriculum-import-form');

//            // Tabs 1 and 2 get activated as you go through the wizard.
//            form.tabs({
//                active: 0,
//                disabled: [1, 2]
//            });

            var sourceSelect = form.find('select[name="source"]');
            var levelSelect  = form.find('select[name="learningLevel"]');
            var areaSelect   = form.find('select[name="learningArea"]');
            var nameInput    = form.find('input[name="curriculumName"]');
            form.on('click', 'input[data-role="wizard-step-1-submit"]', function(event) {
                event.preventDefault();
                var value = sourceSelect.val();
                var tab   = $(event.target).closest('section');
                tab.addClass('loading').find(':input').prop('disabled', true);

                // Clear previous settings:
                // remember, if anything changes in a previous wizard step,
                // invalidate steps after it

                // Load the learning areas and levels for the selected source.
                // Do it asynchronously
                if (value) {
                    // have some sort of ajax spinner or state change
                    $.get(
                        learningLevelUrl,
                        {id: value},
                        $.noop,
                        'json'
                    )
                        .done(function(data) {
                            // Remove the old levels, and add new ones
                            levelSelect
                                .prop('disabled', false)
                                .find('option')
                                .filter(function() { return this.value; })
                                .remove();
                            data.levels.forEach(function(level) {
                                $('<option />')
                                    .attr('label', level.name)
                                    .attr('value', level.name)
                                    .data('level', level)
                                    .text(level.name)
                                    .appendTo(levelSelect);
                            });
                            areaSelect
                                .prop('disabled', false)
                                .find('option')
                                .filter(function() { return this.value; })
                                .remove();
                            data.areas.forEach(function(area) {
                                $('<option />')
                                    .attr('label', area.name)
                                    .attr('value', area.name)
                                    .data('area',  area)
                                    .text(area.name)
                                    .appendTo(areaSelect);
                            });
                            tab.next('section').addClass('loaded');
//                            form.tabs('enable', 1)
//                                .tabs('option', 'active', 1)
                            // Animate next tab?
                        })
                        .fail(function() {
                            // do something else
//                            form.tabs('disable', 1)
//                                .tabs('disable', 2)
//                                .tabs('option', 'active', 0);
                            tab.addClass('failed');
                        })
                        .always(function() {
                            tab.removeClass('loading').find(':input').prop('disabled', false);
                        });
                } else {
                    // Remove all filled in levels
                    levelSelect
                        .prop('disabled', true)
                        .find('option')
                        .filter(function() { return this.value; })
                        .remove();
                    areaSelect
                        .prop('disabled', true)
                        .find('option')
                        .filter(function() { return this.value; })
                        .remove();
                }
            });

            form.on('click', 'input[data-role="wizard-step-2-submit"]', function(event) {
                event.preventDefault();
                var tab = $(event.target).closest('section');
                tab.addClass('loading').find(':input').prop('disabled', true);
                $.get(
                    outcomeUrl,
                    {
                        id:    sourceSelect.val(),
                        area:  areaSelect.find(':selected').data('area').reference,
                        level: levelSelect.find(':selected').data('level').reference
                    },
                    $.noop,
                    'json'
                )
                    .done(function(data) {
                        // Create a default name
                        nameInput.val(
                            form.find('select[name="learningLevel"] :selected').text()
                            + ' '
                            + form.find('select[name="learningArea"] :selected').text()
                        );
                        // Shove all of this into a tree
                        makeTree(data.outcomes, form.find('#outcomes').empty())
                        tab.next('section').addClass('loaded');
                        form.find('input[data-role="wizard-step-3-submit"]').prop('disabled', false);
//                        form.tabs('enable', 2)
//                            .tabs('option', 'active', 2);
                        // Enable the submit button
                    })
                    .fail(function() {
                        // do something else
                        form.find('input[data-role="wizard-step-3-submit"]').prop('disabled', true);
//                        form.tabs('disable', 2)
//                            .tabs('option', 'active', 1);
                        tab.addClass('failed');
                    })
                    .always(function() {
                        tab.removeClass('loading').find(':input').prop('disabled', false);
                    });
            });

            form.on('click', 'input[data-role="wizard-step-3-submit"]', function(event) {
                event.preventDefault();
                // Save this box
                // Craft a request, consisting of:
                // Source
                // Learning area and level (with or without an ID)
                //  Use the reference instead?
                // A map of outcomes
                // (Allow editing after the fact)

                var tab = $(event.target).closest('section');
                tab.addClass('loading').find(':input').prop('disabled', true);

                var formData = {
                    id:     sourceSelect.val(),
                    area:   areaSelect.find(':selected').data('area').reference,
                    level:  levelSelect.find(':selected').data('level').reference,
                    name:   nameInput.val()
                };

                $.ajax({
                    url:       form.attr('action'),
                    data:      formData,
                    dataType: 'json',
                    type:     'post'
                })
                    .done(function(data) {
                        // Save succeeded, redirect somewhere
                        tab.addClass('loaded');
                        window.location.href = browseUrl+'#'+data.outcomes[0].id;
                    })
                    .fail(function() {
                        // do something else
                        tab.addClass('failed');
                    })
                    .always(function() {
                        tab.removeClass('loading').find(':input').prop('disabled', false);
                    });
            });

            // Ensure that I can't submit without selecting a source
            form.on('change', 'select[name="source"]', function() {
                form.find('input[data-role="wizard-step-1-submit"]').prop('disabled', !this.value);
            });

            // Ensure that I can't submit without selecting a learning area and level
            form.on('change', 'select[name="learningArea"], select[name="learningLevel"]', function() {
                var area  = form.find('select[name="learningArea"]').val();
                var level = form.find('select[name="learningLevel"]').val();
                form.find('input[data-role="wizard-step-2-submit"]').prop('disabled', !(area && level));
            });

            // Fade out the loaded class on the new tab
            form.on('tabsactivate', function(event, ui) {
                setTimeout(function() {
                    ui.newPanel.removeClass('loaded failed');
                }, 2000)
            });
        });
    })(jQuery);
</script>

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Import Curriculum</h1>
        </div>
    </div>
    <nav>
        <a href="{{ routeLookup('curriculum.browse')|escape('html_attr') }}"
           class="icon icon-undo"
           title="Return to Curriculum"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        <ul class="tabs" data-tab>
            <li class="tab-title active"><a href="#step-1">Source</a></li>
            <li class="tab-title"><a href="#step-2">Curriculum</a></li>
            <li class="tab-title"><a href="#step-3">Outcomes</a></li>
        </ul>

        <section>
            <div class="tabs-content no-margin">
                <div id="step-1" class="content active">
                    <em>Curriculum Source:</em>
                    <select name="source">
                        <option value="">Select a source</option>
                        {% for item in sourceList %}
                            <option value="{{ item.id|e('html_attr') }}"
                                    label="{{ item.name|e('html_attr') }}"
                                    title="{{ item.description|e('html_attr') }}"
                                    >{{ item.name }}</option>
                        {% endfor %}
                    </select>
                    <input type="submit"
                           value="Use This Source"
                           class="submit-btn-plain inline"
                           data-role="wizard-step-1-submit"
                           disabled
                    />
                </div>
                <div id="step-2" class="content">
                    <em>Level:</em>
                    <select name="learningLevel" disabled>
                        <option value="">Select a level</option>
                    </select>
                    <em>Learning Area:</em>
                    <select name="learningArea" disabled>
                        <option value="">Select an area</option>
                    </select>
                    <input type="submit"
                           value="Search"
                           class="submit-btn-plain inline"
                           data-role="wizard-step-2-submit"
                           disabled
                            />
                </div>
                <div id="step-3" class="content">
                    <h4>Name of curriculum</h4>
                    <input type="text" name="curriculumName" value="" />
                    <h2>Preview</h2>

                    <ul class="wysiwyg curriculum-import-widget-outcomes" id="outcomes"></ul>
                    You can make changes after saving your curriculum.
                    <input type="submit"
                           value="Save Curriculum"
                           class="submit-btn-plain inline"
                           data-role="wizard-step-3-submit"
                           disabled
                            />
                </div>
            </div>
        </section>
    </div>
</div>

<form id="curriculum-import-form"
      class="clearfix curriculum-import-widget"
      action="{{ routeLookup('curriculumImport.create')|e('html_attr') }}"
      method="post"
      name="form"
>
</form>
