<script type="text/javascript">
    (function($) {

        var makeTree = function(nodes, destination) {
            nodes.forEach(function(node) {
                var listItem = $('<li />')
                    .data('reference', node.reference)
                    .html(node.description);
                if (node.code) {
                    listItem.append(' ('+node.code+')');
                }
                if (node.children.length) {
                    var subList = $('<ul />');
                    makeTree(node.children, subList);
                    listItem.append(subList);
                }
                destination.append(listItem);
            })
        };

        $(function() {
            var form        = $('form#curriculum-import-form');
            var levelSelect = form.find('select[name="learningLevel"]');
            var areaSelect  = form.find('select[name="learningArea"]');
            form.on('click', 'input[data-role="wizard-step-1-submit"]', function(event) {
                event.preventDefault();
                var value = form.find('select[name="source"]').val();
                form.find('input[data-role="wizard-step-2-submit"]').prop('disabled', true);

                // Clear previous settings:
                // remember, if anything changes in a previous wizard step,
                // invalidate steps after it

                // Load the learning areas and levels for the selected source.
                // Do it asynchronously
                if (value) {
                    $.get(
                        {{ routeLookup('curriculumImport.learningLevels')|json_encode|raw }},
                        {id: value},
                        $.noop,
                        'json'
                    )
                        .done(function(data) {
                            // Remove the old levels, and add new ones
                            levelSelect
                                .prop('disabled', false)
                                .find('option')
                                .filter(function() { return this.value; })
                                .remove();
                            data.levels.forEach(function(level) {
                                $('<option />')
                                    .attr('label', level.name)
                                    .attr('value', level.name)
                                    .data('level', level)
                                    .text(level.name)
                                    .appendTo(levelSelect);
                            });
                            areaSelect
                                .prop('disabled', false)
                                .find('option')
                                .filter(function() { return this.value; })
                                .remove();
                            data.areas.forEach(function(area) {
                                $('<option />')
                                    .attr('label', area.name)
                                    .attr('value', area.name)
                                    .data('area',  area)
                                    .text(area.name)
                                    .appendTo(areaSelect);
                            });
                        })
                        .fail(function(jqXhr, textStatus, error) {
                            // do something else
                        });
                } else {
                    // Remove all filled in levels
                    levelSelect
                        .prop('disabled', true)
                        .find('option')
                        .filter(function() { return this.value; })
                        .remove();
                    areaSelect
                        .prop('disabled', true)
                        .find('option')
                        .filter(function() { return this.value; })
                        .remove();
                }
            });

            form.on('click', 'input[data-role="wizard-step-2-submit"]', function(event) {
                event.preventDefault();
                var value = form.find('select[name="source"]').val();
                $.get(
                    {{ routeLookup('curriculumImport.outcomes')|json_encode|raw }},
                    {
                        id:    form.find('select[name="source"]').val(),
                        area:  form.find('select[name="learningArea"] :selected').data('area').reference,
                        level: form.find('select[name="learningLevel"] :selected').data('level').reference
                    },
                    $.noop,
                    'json'
                )
                    .done(function(data) {
                        // Shove all of this into a tree
                        makeTree(data.outcomes, form.find('#outcomes').empty())
                    });
            });

            form.on('change', 'select[name="source"]', function() {
                form.find('input[data-role="wizard-step-1-submit"]').prop('disabled', !this.value);
            });

            form.on('change', 'select[name="learningArea"], select[name="learningLevel"]', function() {
                var area  = form.find('select[name="learningArea"]').val();
                var level = form.find('select[name="learningLevel"]').val();
                form.find('input[data-role="wizard-step-2-submit"]').prop('disabled', !(area && level));
            });
        });
    })(jQuery);
</script>

<h1>Import Curriculum</h1>

<form id="curriculum-import-form"
      action="{{ saveAction }}"
      method="post"
      name="form" class="clearfix"
>
    <table class="standardForm table" data-wizard>
        <tr data-wizard-step="1">
            <td class="formLabelWidth">
                <h4>Source</h4>
                <em>Choose a curriculum source to import your curriculum from.</em>
            </td>
            <td>
                <select name="source">
                    <option value="">-- select a source --</option>
                    {% for item in sourceList %}
                        <option value="{{ item.id|e('html_attr') }}"
                                label="{{ item.name|e('html_attr') }}"
                                title="{{ item.description|e('html_attr') }}"
                                >{{ item.name }}</option>
                    {% endfor %}
                </select>
                <input type="submit"
                       value="Use This Source"
                       class="submit-btn-plain inline"
                       data-role="wizard-step-1-submit"
                       disabled
                />
            </td>
        </tr>
        <tr data-wizard-step="2">
            <td class="formLabelWidth">
                <h4>Curriculum</h4>
            </td>
            <td>
                <select name="learningLevel" disabled>
                    <option value="">-- select a level --</option>
                </select>
                <select name="learningArea" disabled>
                    <option value="">-- select an area --</option>
                </select>
                <input type="submit"
                       value="Search"
                       class="submit-btn-plain inline"
                       data-role="wizard-step-2-submit"
                       disabled
                />
            </td>
        </tr>
        <tr data-wizard-step="3">
            <td class="formLabelWidth">
                <h4>Outcomes</h4>
            </td>
            <td>
                <ul id="outcomes"></ul>
            </td>
        </tr>
    </table>
</form>
