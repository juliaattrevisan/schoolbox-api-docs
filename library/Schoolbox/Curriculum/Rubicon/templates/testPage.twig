{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    ['Curriculum', routeLookup('curriculum.browse')],
    ['Rubicon Test', '#']
) }}

<div class="row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Rubicon Test</h1>
        </div>
    </div>
</div>


<div class="row">
    <div class="small-12 columns">
        <div class="row">
            <div class="small-12 island">
                <section>
                    <ul id="curriculum-list" class="information-list threaded">
                        <li id="curriculum-template" class="hide" data-curriculum>
                            <div class="list-item">
                                <div class="card small-12">
                                    <h3 data-template="title"></h3>
                                    <p class="meta">
                                        <span data-template="grade"></span>
                                        <span data-template="subject"></span>
                                    </p>
                                </div>
                                <article data-template="description"></article>
                                <button class="submit" data-action="loadUnits">Load Units</button>
                            </div>
                        </li>
                        <li id="unit-template" class="hide child" data-unit>
                            <h3 data-template="title"></h3>
                            <button class="submit" data-action="loadAssessments">Load Assessments</button>
                        </li>
                    </ul>
                </section>
            </div>
        </div>
    </div>
</div>

{% autoescape 'js' %}
<script type="text/javascript">
    {#var token = "{{ token }}";#}
    // var api   = "https://api.rubicon.com/api/";
    var api = "/curriculum/rubicon/proxy/";
    (function($){
        $(function() {
            // On load: load the list of curricula via AJAX
            var toast = $('#toast'),
                list  = $('#curriculum-list'),
                request = $.ajax(api + 'curriculummap/');

            toast.toastActivate({text: 'Loading curricula...'});
            request
                .done(function(response) {
                    toast.toastTimeout({text: 'Loaded', css: 'success'});

                    var template = $('#curriculum-template');
                    response.data.forEach(function(item) {
                        var row = template.clone()
                            .removeClass('hide')
                            .removeAttr('id')
                            .data('curriculum', item.id);
                        row.find('[data-template="title"]').text(item.title);
                        row.find('[data-template="grade"]').text(item.grade);
                        row.find('[data-template="subject"]').text(item.subject);
                        row.find('[data-template="description"]').html(item.description);
                        list.append(row);
                    });
                })
                .fail(function() {
                    toast.toastTimeout({text: 'Failed!', css: 'alert'});
                });

            // On click of a curriculum: load its units and assessments
            list.on('click', '[data-action="loadUnits"]', function() {
                var button     = $(this),
                    curriculum = button.closest('[data-curriculum]'),
                    nextPoint  = curriculum,
                    request    = $.ajax(
                        api + 'unit/',
                        {data: {curriculummap_id: curriculum.data('curriculum')}}
                    );

                toast.toastActivate({text: 'Loading units...'});
                button.prop('disabled', true);

                request
                    .done(function(response) {
                        toast.toastTimeout({text: 'Loaded', css: 'success'});

                        var template = $('#unit-template');
                        response.data.forEach(function(item) {
                            var row = template.clone()
                                .removeClass('hide')
                                .removeAttr('id')
                                .data('unit', item.id);
                            row.find('[data-template="title"]').text(item.title);
                            nextPoint.after(row);
                            nextPoint = row;
                        });
                    })
                    .fail(function() {
                        toast.toastTimeout({text: 'Failed!', css: 'alert'});
                        button.prop('disabled', false);
                    });
            });
        });
    })(jQuery);
</script>
{% endautoescape %}

<div class="toast" id="toast"></div>
