{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    ['Curriculum', routeLookup('curriculum.browse')],
    ['Rubicon Test', '#']
) }}

<div class="row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Rubicon Test</h1>
        </div>
    </div>
</div>


<div class="row">
    <div class="small-12 columns">
        <div class="row">
            <div class="small-12 island">
                <section>
                    <ul id="curriculum-list" class="information-list threaded">
                        <li id="curriculum-template" class="hide" data-curriculum>
                            <div class="list-item">
                                <div class="card small-12">
                                    <h3 data-template="title"></h3>
                                    <p class="meta">
                                        <span data-template="grade"></span>
                                        <span data-template="subject"></span>
                                    </p>
                                </div>
                                <article data-template="description"></article>
                                <button class="submit" data-action="loadUnits">Load Units</button>
                            </div>
                        </li>
                    </ul>
                    <ul id="units-template" class="hide information-list reply">
                        <li id="unit-template" class="hide" data-unit>
                            <div class="list-item">
                                <div class="card small-12">
                                    <span data-template="title"></span>
                                    <div class="meta">
                                        <span data-template="assessments-loading">
                                            Loading...
                                        </span>
                                        <span data-template="assessments" class="hide">
                                            <span data-template="assessments-count"></span> assessments
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </li>
                    </ul>
                    <ul id="assessments-template" class="hide information-list reply">
                        <li id="assessment-template" class="hide" data-assessment>
                            <div class="list-item">
                                <div class="card small-12">
                                    <span data-template="title"></span>
                                    <ul data-template="standards" class="information-list reply">
                                        <li data-template="standard" class="hide">
                                            <div class="list-item">
                                                <div class="card small-12">
                                                    <span data-template="description"></span>
                                                </div>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                    </ul>
                </section>
            </div>
        </div>
    </div>
</div>

{% autoescape 'js' %}
<script type="text/javascript">

    // API token for Rubicon
    var token = "{{ token }}";

    // Live API doesn't work locally, thus I proxy thru Schoolbox
    // var api   = "https://api.rubicon.com/api/";
    var api   = "/curriculum/rubicon/proxy/";

    // Headers and data type that Rubicon requires
    var ajaxOptions = {
        dataType: 'json',
        headers: {
            Authorization: "Bearer " + token
        }
    };

    (function($){
        // On load: load the list of curricula via AJAX
        $(function() {
            var toast = $('#toast'),
                list  = $('#curriculum-list'),
                request = $.ajax(api + 'curriculummap/', ajaxOptions);

            toast.toastActivate({text: 'Loading curricula...'});
            request
                .done(function(response) {
                    toast.toastTimeout({text: 'Loaded', css: 'success'});

                    var template = $('#curriculum-template')
                        .clone()
                        .removeClass('hide')
                        .removeAttr('id');
                    response.data.forEach(function(item) {
                        var row = template.clone()
                            .data('curriculum', item.id);
                        row.find('[data-template="title"]').text(item.title);
                        row.find('[data-template="grade"]').text(item.grade);
                        row.find('[data-template="subject"]').text(item.subject);
                        row.find('[data-template="description"]').html(item.description);
                        list.append(row);
                    });
                })
                .fail(function() {
                    toast.toastTimeout({text: 'Failed!', css: 'alert'});
                });

            // On click of a curriculum's load units button
            list.on('click', '[data-action="loadUnits"]', function() {
                var button     = $(this),
                    curriculum = button.closest('[data-curriculum]'),
                    request    = $.ajax(
                        api + 'unit/',
                        $.extend({}, ajaxOptions, {data: {curriculummap_id: curriculum.data('curriculum')}})
                    );

                toast.toastActivate({text: 'Loading units and assessments...'});
                button.prop('disabled', true);

                request
                    .done(function(response) {

                        var template     = $('#unit-template')
                            .clone()
                            .removeClass('hide')
                            .removeAttr('id');
                        var baseTemplate = $('#units-template')
                            .clone()
                            .removeClass('hide')
                            .removeAttr('id')
                            .empty();

                        // May as well load all assessments as well
                        var requests = [];
                        response.data.forEach(function(item) {
                            var row = template
                                .clone()
                                .data('unit', item.id);
                            var assessmentRequest = $.ajax(
                                api + 'assessment/',
                                $.extend({}, ajaxOptions, {data: {unit_id: item.id}})
                            );
                            assessmentRequest.then(function(response) {
                                loadAssessments(response, row)
                            });
                            requests.push(assessmentRequest);

                            row.find('[data-template="title"]').text(item.title);
                            baseTemplate.append(row);

                        });

                        $.when.apply(this, requests)
                            .done(function() {
                                toast.toastTimeout({text: 'Loaded', css: 'success'});
                            });

                        curriculum.append(baseTemplate);
                    })
                    .fail(function() {
                        toast.toastTimeout({text: 'Failed!', css: 'alert'});
                        button.prop('disabled', false);
                    });
            });

            // On click of a unit's load assessments button
            var loadAssessments = function(response, unit) {
                var template     = $('#assessment-template')
                    .clone()
                    .removeClass('hide')
                    .removeAttr('id');
                var baseTemplate = $('#assessments-template')
                    .clone()
                    .removeClass('hide')
                    .removeAttr('id')
                    .empty();
                var standardTemplate = template.find('[data-template="standard"]')
                    .clone()
                    .removeClass('hide');

                // Add each assessment
                response.data.forEach(function(item) {
                    var row = template
                        .clone()
                        .data('unit', item.id);
                    var standards = row.find('[data-template="standards"]');
                    row.find('[data-template="title"]').text(item.title);

                    // Add its standards too
                    if (item.standards) {
                        item.standards.forEach(function(standard) {
                            var standardHtml = standardTemplate.clone();
                            standardHtml
                                .find('[data-template="description"]')
                                .html(standard);
                            // Remove noise
                            standardHtml.find('img').remove();
                            standards.append(standardHtml);
                        });
                    }
                    baseTemplate.append(row);
                });

                // Add assessment count
                unit.find('[data-template="assessments-loading"]').addClass('hide');
                unit.find('[data-template="assessments"]')
                    .removeClass('hide')
                    .find('[data-template="assessments-count"]').text(response.data.length);

                unit.append(baseTemplate);
            };
        });
    })(jQuery);
</script>
{% endautoescape %}

<div class="toast" id="toast"></div>
