<div id="curriculum-coverage-container" class="f-container">
    <curriculum-coverage
        courses-endpoint="/api/courses/"
        curriculum-endpoint="{{ routeLookup('curriculumApi.searchNode') }}"
        :selected-courses="{{ (selectedCourses ?? []) | json_encode }}"
        :selected-nodes="{{ (selectedNodes ?? []) | json_encode }}"
        report-endpoint="{{ routeLookup('curriculumreports.generateCoverage') }}"
        usage-endpoint="{{ routeLookup('curriculumreports.getCoverageUsage') }}"
    />
</div>
<script>
    {# Add required locales for the Curriculum coverage #}
    window.sbProps.l10n.addTerm({{ locale.activity.toArray |json_encode |raw }});
    window.sbProps.l10n.addTerm({{ locale.lessonPlan.toArray |json_encode |raw }});
    window.sbProps.l10n.addTerm({{ locale.unit.toArray |json_encode |raw }});
    window.sbProps.l10n.addTerm({{ locale.rubricGroup.toArray |json_encode |raw }});
    window.sbProps.l10n.addTerm({{ locale.rubricCriterion.toArray |json_encode |raw }});
</script>
<script src="{{ CDN_PREFIX }}/js/bundle/curriculumCoverage.js?v={{ config.site_version }}"></script>
