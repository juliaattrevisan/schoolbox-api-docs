<!-- Template for browsing curricula -->
<link rel="stylesheet" href="/javascript/components/jstree/dist/themes/default/style.css" />
<script type="application/javascript" src="/javascript/components/jstree/dist/jstree.min.js"></script>
<script type="text/javascript" src="/javascript/jquery.resourceTree.js"></script>
<script type="text/javascript" src="/javascript/components/doT/doT.js"></script>
<script type="text/javascript" src="/javascript/tiny_mce/tiny_mce.js"></script>
<script type="text/javascript" src="/javascript/jquery.alaressTiny.js"></script>
<script type="application/javascript">
    (function($) {
        $(function() {
            // Setup Tiny now, for later addition
            $.fn.alaressTiny({
                mode: 'none'
            });

            // Twig-generated JS
            var readonly  = {% if readonly %}true{% else %}false{% endif %};
            var areas     = {{ areas|json_encode|raw }};
            var levels    = {{ levels|json_encode|raw }};
            var createUri = {{ routeLookup('curriculum.create')|json_encode|raw }};

            // add classes to tree, because jstree doesn't allow me to define
            // a base style for trees
            var treeData = {{ tree|json_encode|raw }}.map(function(row) {
                try {
                    row.li_attr.class += ' curriculum-node';
                } catch (e) {
                    row.li_attr.class = 'curriculum-node';
                }
                return row;
            });

            var dialogOptions = {autoOpen: false, modal: true};
            var areaDialog    = $('[data-role="add-area-dialog"]').dialog(dialogOptions);
            var levelDialog   = $('[data-role="add-level-dialog"]').dialog(dialogOptions);

            /**
             * Builds a readonly view of the curriculum node
             *
             * @param actions
             * @param data
             */
            var buildView = function(actions, data) {
                data.actions  = actions;
                data.readonly = readonly;
                formPanel
                    .empty()
                    .append(template(data));
                // Add an edit existing curriculum event to the edit button here
                formPanel.find('#edit-button').click(function(event) {
                    event.preventDefault();
                    buildForm(actions, data);
                });
                // Add child to existing curriculum
                formPanel.find('#create-child-button').click(function(event) {
                    event.preventDefault();
                    var form = $(this).closest('form');
                    buildForm({ save: createUri }, { parent: form.data('nodeid') }, data);
                });
            };

            /**
             * Builds a writable view of the curriculum node
             *
             * @param actions
             * @param data
             * @param previous If creating a subsection, fall back to this data
             */
            var buildForm = function(actions, data, previous) {
                tinyMCE.execCommand('mceRemoveControl', true, 'node-description');
                data.actions = actions;
                data.areas   = areas;
                data.levels  = levels;
                formPanel
                    .empty()
                    .append(editTemplate(data));
                // Cancel editing
                formPanel.find('#cancel-button').click(function(event) {
                    event.preventDefault();
                    // Is data empty? Load data from whatever the current node is.
                    if (!data.id) {
                        buildView(actions, previous);
                    } else {
                        buildView(actions, data);
                    }
                });
                tinyMCE.execCommand('mceAddControl', true, 'node-description');
            };

            var template     = doT.template($('script#node-template').html().trim());
            var editTemplate = doT.template($('script#node-edit-template').html().trim());
            var treePanel    = $('.curriculum-selector');
            var formPanel    = $('[data-role="curriculum-editor"]');
            var tree         = $('[data-role="curriculum-tree"]').jstree({
                core: {
                    animation: 50,
                    data: treeData,
                    force_text: true,
                    multiple: false,
                    check_callback: true,
                    themes: {
                        variant: "resourcetree",
                        dots: true,
                        icons: true,
                        responsive: false
                    }
                },
                plugins: ['sort', 'types'],
                types: {
                    root: {
                        icon: '/images/tree/server.gif'
                    },
                    'default': {
                        icon: '/images/icons/22x22/folder.png'
                    },
                    folder: {
                        icon: '/images/icons/22x22/folder.png'
                    },
                    code: {
                        icon: '/images/famicons/star.png'
                    }
                }
            })
                .on('select_node.jstree', function(event, jstree) {
                    // Open a node when you select it
                    jstree.instance.open_node(jstree.node.id);
                })
                .on('ready.jstree', function(event, jstree) {
                    // Is there a hash? If so, open all nodes below that hash.
                    // (but maybe not curriculum codes)
                    var match = window.location.hash.match(/^#(.*)/);
                    if (match) {
                        jstree.instance.select_node(match[1]);
                        jstree.instance.open_all(match[1]);
                    }
                })
                .on('select_node.jstree', function(event, jstree) {
                    // Load this node in the node browser
                    // read URL comes from the node I just clicked
                    formPanel
                        .addClass('loading')
                        .find(':input').prop('disabled', true);
                    $.getJSON(jstree.node.a_attr.href+'.json')
                        .done(function(data) {
                            buildView(
                                {
                                    save:   jstree.node.a_attr['data-saveuri'],
                                    delete: jstree.node.a_attr['data-deleteuri']
                                },
                                data.item
                            );
                        })
                        .fail(function(jqXhr, textStatus, error) {
                            formPanel.addClass('failed');
                        })
                        .always(function() {
                            formPanel.removeClass('loading');
                            setTimeout(function() {
                                formPanel.removeClass('loaded failed');
                            }, 2000)
                        });
                })

            var jstree = $.jstree.reference('[data-role="curriculum-tree"]');

            // resizer - stolen from three panel
            var resizePanels = function() {
                $().add(formPanel).add(treePanel).outerHeight(
                    $(window).height() - $('#header').height() - $('#footer').height() - 50
                );
            };
            resizePanels();
            $(window).resize(resizePanels);

            // Triggers for adding new levels or areas
            formPanel.on('change', '#node-form select', function(event) {
                var option      = $(this).find(':selected');
                var interaction = option.data('interaction');
                switch (interaction) {
                    case 'add-level-dialog-open':
                        event.preventDefault();
                        levelDialog.dialog('open');
                        break;
                    case 'add-area-dialog-open':
                        event.preventDefault();
                        areaDialog.dialog('open');
                        break;
                    default:
                        break;
                }
            });

            // Node save form submission
            formPanel.on('submit', '#node-form', function(event) {
                event.preventDefault();

                // Do it via AJAX instead
                var form     = $(this);
                var formData = form.serializeArray();
                formPanel
                    .addClass('loading')
                    .find(':input').prop('disabled', true);
                $.ajax({
                    type:     this.method,
                    data:     formData,
                    dataType: 'json',
                    url:      this.action
                })
                    .done(function(data) {
                        // Is this a newly created node? If so, add it in.
                        // jsTree has no comprehensive updateNode, so update what I can.
                        formPanel.addClass('loaded');
                        if (jstree.get_node(data.item.id)) {
                            jstree.rename_node(data.item.id, data.tree.text);
                        } else {
                            jstree.create_node(data.tree.parent, data.tree);
                            jstree.deselect_all(true);
                            jstree.select_node(data.tree.id);
                        }
                    })
                    .fail(function(jqXhr, textStatus, error) {
                        formPanel.addClass('failed');
                    })
                    .always(function() {
                        formPanel.removeClass('loading')
                            .find(':input').prop('disabled', false);
                        setTimeout(function() {
                            formPanel.removeClass('loaded failed');
                        }, 2000)
                    });
            });

            // IE9 doesn't support form attribute on inputs.
            // Add a click delete button polyfill.
            if (!('form' in $('<input>')[0])) {
                formPanel.on('click', '#delete-button', function(event) {
                    event.preventDefault();
                    formPanel.find('#node-delete-form').submit();
                });
            }

            // Delete node form
            formPanel.on('submit', '#node-delete-form', function(event) {
                event.preventDefault();
                formPanel
                    .addClass('loading')
                    .find(':input').prop('disabled', true);
                $.ajax({
                    type:     this.method,
                    dataType: 'json',
                    url:      this.action
                })
                    .done(function(data) {
                        formPanel.addClass('loaded');
                        jstree.delete_node(data.item.id);
                        jstree.select_node(data.tree.parent);
                    })
                    .fail(function(jqXhr, textStatus, error) {
                        formPanel.addClass('failed');
                    })
                    .always(function() {
                        formPanel.removeClass('loading')
                            .find(':input').prop('disabled', false);
                    });
            })

            // Create new curriculum
            treePanel.on('click', '[data-interaction="create-curriculum"]', function(event) {
                event.preventDefault();
                buildForm({ save: createUri }, {});
            });

            // Create new level/area submit event
            var allDialogs = $(areaDialog).add(levelDialog)
            allDialogs.on('submit', 'form', function(event) {
                event.preventDefault();
                formPanel.addClass('loading');
                var form     = $(this);
                var selector = form.data('relation');
                var submit   = form.find(':submit').prop('disabled', true);
                var ajax     = $.ajax({
                    method: this.method,
                    url:    this.action,
                    data:   form.serializeArray()
                });
                ajax
                    .done(function(data) {
                        // Update what gets chosen
                        formPanel.addClass('loaded');
                        var nameInput = form.find('input[name="name"]');
                        var name      = nameInput.val();
                        nameInput.val('');
                        formPanel.find('#node-form').find(selector).append(
                            $('<option />')
                                .attr('value', data.item.id)
                                .attr('label', name)
                                .prop('selected', true)
                                .text(name)
                        );
                        allDialogs.dialog('close');
                    })
                    .fail(function() {
                        // Not sure?
                        formPanel.addClass('failed');
                    })
                    .always(function() {
                        // Re-enable submit button no matter what
                        formPanel.removeClass('loading');
                        submit.prop('disabled', false);
                    });
            });
        })
    })(jQuery);
</script>

<!-- Template for displaying of a curriculum node -->
{% verbatim %}
<script id="node-template" type="text/x-dot-template">
    <h2>
        {{? it.code }}
            [{{! it.code }}]
        {{?}}
        {{! it.name }}
    </h2>

    {{? it.reference }}
    <p>
        <strong>Reference:</strong>
        <a href="{{! it.reference }}">{{! it.reference }}</a>
    </p>
    {{?}}

    <article>{{= it.description }}</article>

    {{? !it.readonly }}
    <ul class="button-group even-3">
        <li>
            <button id="edit-button" class="button">Edit</button>
        </li>
        <li>
            <button id="create-child-button" class="button secondary">Add Subsection</button>
        </li>
        <li>
            <form method="post" action="{{! it.actions.delete }}">
                <button type="submit" id="delete-button" class="alert">Delete</button>
            </form>
        </li>
    </ul>
    {{?}}
</script>
{% endverbatim %}

<!-- Template for editing a curriculum node -->
{% verbatim %}
<script id="node-edit-template" type="text/x-dot-template">
    <form id="node-form" method="post" action="{{! it.actions.save }}" data-nodeid="{{! it.id }}">
        <input type="hidden" name="parent" value="{{! it.parent }}" />
        <!--
        Only show curriculum selection for new base nodes
        Also consider making these selectors selectized so I can add dynamically
        -->
        {{? !it.id && !it.parent }}
        <h2>Create New Curriculum</h2>
        <dl>
            <dt>Curriculum</dt>
            <dd>
                <select name="learningLevel">
                    <option value="">-- select a level --</option>
                    {{~ it.levels :levelGroup }}
                    <optgroup label="{{! levelGroup.name || 'Uncategorized' }}">
                        {{~ levelGroup.list :level }}
                        <option value="{{! level.id }}" label="{{! level.name }}">{{! level.name }}</option>
                        {{~ }}
                    </optgroup>
                    {{~}}
                    <option value="" data-interaction="add-level-dialog-open">Add New Level...</option>
                </select>
                <select name="learningArea">
                    <option value="">-- select an area --</option>
                    {{~ it.areas :areaGroup }}
                    <optgroup label="{{! areaGroup.name || 'Uncategorized' }}">
                        {{~ areaGroup.list :area }}
                        <option value="{{! area.id }}" label="{{! area.name }}">{{! area.name }}</option>
                        {{~ }}
                    </optgroup>
                    {{~}}
                    <option value="" data-interaction="add-area-dialog-open">Add New Area...</option>
                </select>
            </dd>
        </dl>
        {{?}}

        {{? it.id }}
        <h2>Edit Curriculum Subsection</h2>
        {{?}}
        {{? !it.id && it.parent }}
        <h2>Create New Curriculum Subsection</h2>
        {{?}}

        <dl>
            <dt>Name</dt>
            <dd><input type="text" name="name" value="{{! it.name }}" /></dd>
        </dl>
        <dl>
            <dt>Code</dt>
            <dd><input type="text" name="code" value="{{! it.code }}" /></dd>
        </dl>
        <dl>
            <dt>Reference</dt>
            <dd><input type="text" name="reference" value="{{! it.reference }}" /></dd>
        </dl>
        <dl>
            <dt>Description</dt>
            <dd><textarea id="node-description" name="description">{{! it.description }}</textarea>
        </dl>

        <ul class="button-group even-2">
            <li>
                {{? it.id }}
                    <button type="submit" class="button">Save Changes</button>
                {{?}}
                {{? !it.id && it.parent }}
                    <button type="submit" class="button">Create Subsection</button>
                {{?}}
                {{? !it.id && !it.parent }}
                    <button type="submit" class="button">Create Curriculum</button>
                {{?}}
            </li>
            <li>
                <button type="submit" id="cancel-button" class="button secondary">Cancel</button>
            </li>
        </ul>
    </form>
</script>
{% endverbatim %}

<div class="row {% if not readonly %}actions-small-1 actions-medium-2{% endif %}">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Curriculum Browser</h1>
        </div>
    </div>
    {% if not readonly %}
    <nav>
        <span class="hide-for-small">
            <a href="{{ routeLookup('curriculum.add')|escape('html_attr') }}"
               data-interaction="create-curriculum"
               class="icon icon-add"
               title="Create New Curriculum"></a>
            <a href="{{ routeLookup('curriculumImport.browse')|escape('html_attr') }}"
               class="icon icon-upload"
               title="Import Curriculum"></a>
        </span>
        <a href="#" class="icon-more show-for-small" data-dropdown="tab-control"></a>
    </nav>
    <ul id="tab-control" class="f-dropdown" data-dropdown-content>
        <li>
            <a href="{{ routeLookup('curriculum.add')|escape('html_attr') }}"
               data-interaction="create-curriculum"
               class="icon icon-add">Create New Curriculum</a>
        </li>
        <li>
            <a href="{{ routeLookup('curriculumImport.browse')|escape('html_attr') }}"
               class="icon icon-upload">Import Curriculum</a>
        </li>
    </ul>
    {% endif %}
</div>

