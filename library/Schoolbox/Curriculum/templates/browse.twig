<!-- Template for browsing curricula -->
<link rel="stylesheet" href="/javascript/components/jstree/dist/themes/default/style.css" />
<script type="text/javascript" src="/javascript/shared/curriculum/jquery.curriculum-browser.js"></script>
<script type="text/javascript" src="/javascript/components/jstree/dist/jstree.min.js"></script>
<script type="text/javascript" src="/javascript/components/doT/doT.js"></script>
<script type="text/javascript" src="/javascript/tiny_mce/tiny_mce.js"></script>
<script type="text/javascript" src="/javascript/jquery.alaressTiny.js"></script>
<script type="text/javascript">
    (function($) {
        $(function() {
            // Setup Tiny now, for later addition
            $.fn.alaressTiny({
                mode: 'none'
            });

            // add classes to tree, because jstree doesn't allow me to define
            // a base style for trees
            var treeData = {{ tree|json_encode|raw }}.map(function(row) {
                try {
                    row.li_attr.class += ' curriculum-node';
                } catch (e) {
                    row.li_attr.class = 'curriculum-node';
                }
                return row;
            });

            // Set up the browser
            var browser = $('[data-role="curriculum-browser"]').curriculumBrowser({
                areas: {
                    data: {{ areas|json_encode|raw }},
                    dialog: $('[data-role="add-area-dialog"]')
                },
                levels: {
                    data: {{ levels|json_encode|raw }},
                    dialog: $('[data-role="add-level-dialog"]')
                },
                view: {
                    readonly: {% if readonly %}true{% else %}false{% endif %},
                    selector: '[data-role="curriculum-editor"]',
                    editFormSelector: '[data-role="node-form"]',
                    deleteFormSelector: '[data-role="node-delete-form"]',
                    createUri: {{ routeLookup('curriculum.create')|json_encode|raw }},
                    templates: {
                        view: $('script#node-template').html().trim(),
                        edit: $('script#node-edit-template').html().trim()
                    },
                    dialog: $('[data-role="node-dialog"]')
                },
                tree: {
                    data: treeData,
                    selector: '[data-role="curriculum-tree"]'
                }
            });

            // Create new curriculum
            $('[data-interaction="create-curriculum"]').on('click', function(event) {
                event.preventDefault();
                browser.curriculumBrowser('openCreateForm');
            });
        })
    })(jQuery);
</script>

<!-- Template for displaying of a curriculum node -->
{% verbatim %}
<script id="node-template" type="text/x-dot-template">
    <div class="row">
        <div class="small-12 column">
            <h3 id="nodeTitle">
                {{? it.code }}
                    [{{! it.code }}]
                {{?}}
                {{! it.name }}
            </h3>

            {{? it.reference }}
            <p class="meta">
                Reference: <a href="{{! it.reference }}">{{! it.reference }}</a>
            </p>
            {{?}}

            <article>{{= it.description }}</article>

            {{? !it.readonly }}
            <ul class="flex-list buttons small-1 medium-2 large-2 xlarge-4 xxlarge-2">
                <li><a data-interaction="edit" class="icon-modify">Edit</a></li>
                <li><a data-interaction="add-subsection" class="icon-add" data-nodeid="{{! it.id }}">Add Subsection</a></li>
                <li><a data-interaction="delete" class="icon-delete" data-nodeid="{{! it.id }}" data-action="{{! it.actions.delete }}">Delete</a></li>
                <li class="overflow">
                    <a class="icon-more" data-dropdown="node-template-dropdown"></a>
                    <ul class="f-dropdown" id="node-template-dropdown" data-dropdown-content>
                        <li><a data-interaction="edit" class="icon-modify">Edit</a></li>
                        <li><a data-interaction="add-subsection" class="icon-add" data-nodeid="{{! it.id }}">Add Subsection</a></li>
                        <li><a data-interaction="delete" class="icon-delete" data-nodeid="{{! it.id }}" data-action="{{! it.actions.delete }}">Delete</a></li>
                    </ul>
                </li>
            </ul>
            {{?}}
        </div>
    </div>
</script>
{% endverbatim %}

<!-- Template for editing a curriculum node -->
{% verbatim %}
<script id="node-edit-template" type="text/x-dot-template">
    <div class="row">
        <div class="small-12 column">
            <form method="post" action="{{! it.actions.save }}" data-nodeid="{{! it.id }}" data-role="node-form">
                <input type="hidden" name="parent" value="{{! it.parent }}" />
                {{? !it.id && !it.parent }}
                <h3 id="nodeTitle">Create New Curriculum</h3>
                <label for="curriculumLearningLevel">Level</label>
                <select name="learningLevel" id="curriculumLearningLevel">
                    <option value="">-- select a level --</option>
                    {{~ it.levels :levelGroup }}
                    <optgroup label="{{! levelGroup.name || 'Uncategorized' }}">
                        {{~ levelGroup.list :level }}
                        <option value="{{! level.id }}" label="{{! level.name }}">{{! level.name }}</option>
                        {{~ }}
                    </optgroup>
                    {{~}}
                    <option value="" data-interaction="add-level-dialog-open">Add New Level...</option>
                </select>
                <label for="curriculumLearningArea">Learning Area</label>
                <select name="learningArea" id="curriculumLearningArea">
                    <option value="">-- select an area --</option>
                    {{~ it.areas :areaGroup }}
                    <optgroup label="{{! areaGroup.name || 'Uncategorized' }}">
                        {{~ areaGroup.list :area }}
                        <option value="{{! area.id }}" label="{{! area.name }}">{{! area.name }}</option>
                        {{~ }}
                    </optgroup>
                    {{~}}
                    <option value="" data-interaction="add-area-dialog-open">Add New Area...</option>
                </select>
                {{?}}

                {{? it.id }}
                <h3 id="nodeTitle">Edit Curriculum Subsection</h3>
                {{?}}
                {{? !it.id && it.parent }}
                <h3 id="nodeTitle">Create New Curriculum Subsection</h3>
                {{?}}

                <label for="curriculumName">Name</label>
                <input id="curriculumName" type="text" name="name" value="{{! it.name }}" />
                <label for="curriculumCode">Code</label>
                <input id="curriculumCode" type="text" name="code" value="{{! it.code }}" />
                <label for="curriculumReference">Reference</label>
                <input id="curriculumReference" type="text" name="reference" value="{{! it.reference }}" />
                <label for="curriculumDescription">Description</label>
                <textarea id="curriculumDescription" name="description">{{! it.description }}</textarea>

                <ul class="button-group even-2">
                    <li>
                        {{? it.id }}
                            <button type="submit" class="button">Save Changes</button>
                        {{?}}
                        {{? !it.id && it.parent }}
                            <button type="submit" class="button">Create Subsection</button>
                        {{?}}
                        {{? !it.id && !it.parent }}
                            <button type="submit" class="button">Create Curriculum</button>
                        {{?}}
                    </li>
                    <li>
                        <button type="submit" data-interaction="cancel" class="button secondary">Cancel</button>
                    </li>
                </ul>
            </form>
        </div>
    </div>
</script>
{% endverbatim %}

<div class="row {% if not readonly %}actions-small-1 actions-medium-2{% endif %}">
    <div class="list-item">
        <div class="small-12 column">
            <h1>Curriculum Browser</h1>
        </div>
    </div>
    {% if not readonly %}
    <nav>
        <span class="hide-for-small">
            <a href="{{ routeLookup('curriculum.add')|escape('html_attr') }}"
               data-interaction="create-curriculum"
               class="icon icon-add"
               title="Create New Curriculum"></a>
            <a href="{{ routeLookup('curriculumImport.browse')|escape('html_attr') }}"
               class="icon icon-upload"
               title="Import Curriculum"></a>
        </span>
        <a href="#" class="icon-more show-for-small" data-dropdown="tab-control"></a>
    </nav>
    <ul id="tab-control" class="f-dropdown" data-dropdown-content>
        <li>
            <a href="{{ routeLookup('curriculum.add')|escape('html_attr') }}"
               data-interaction="create-curriculum"
               class="icon icon-add">Create New Curriculum</a>
        </li>
        <li>
            <a href="{{ routeLookup('curriculumImport.browse')|escape('html_attr') }}"
               class="icon icon-upload">Import Curriculum</a>
        </li>
    </ul>
    {% endif %}
</div>

<div class="resource-browser row" data-role="curriculum-browser">
    <div class="small-12 island">
        <section>
            <div class="scroller">
                <div data-role="curriculum-tree" class="curriculum-tree"></div>
            </div>
        </section>
    </div>
    <div class="small-12 island">
        <section>
            <div class="meta-panel" data-role="curriculum-editor">
            </div>
        </section>
    </div>
</div>

<div class="reveal-modal" data-reveal data-role="add-area-dialog" aria-labelledby="addAreaTitle" aria-hidden="true" role="dialog">
    <h2 id="addAreaTitle">Create New Learning Area</h2>
    <form action="{{ routeLookup('curriculumLearningArea.create') }}" method="post" data-relation="[name='learningArea']">
        <input name="name" type="text" value="" />
        <input type="submit" value="Create" />
    </form>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div class="reveal-modal" data-reveal data-role="add-level-dialog" aria-labelledby="addLevelTitle" aria-hidden="true" role="dialog">
    <h2 id="addLevelTitle">Create New Learning Level</h2>
    <form action="{{ routeLookup('curriculumLearningLevel.create') }}" method="post" data-relation="[name='learningLevel']">
        <input name="name" type="text" value="" />
        <input type="submit" value="Create" />
    </form>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

{# Dialog that replaces the second panel on medium down - for now, readonly #}
<div class="reveal-modal" data-reveal data-role="node-dialog" aria-labelledby="nodeTitle" aria-hidden="true" role="dialog">
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>
