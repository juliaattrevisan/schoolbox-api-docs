<!-- Template for browsing curricula -->
<link rel="stylesheet" href="/javascript/components/jstree/dist/themes/default/style.css" />
<script type="application/javascript" src="/javascript/components/jstree/dist/jstree.min.js"></script>
<script type="text/javascript" src="/javascript/jquery.resourceTree.js"></script>
<script type="text/javascript" src="/javascript/components/doT/doT.js"></script>
<script type="text/javascript" src="/javascript/tiny_mce/tiny_mce.js"></script>
<script type="text/javascript" src="/javascript/jquery.alaressTiny.js"></script>
<script type="application/javascript">
    (function($) {
        $(function() {
            // Setup Tiny now, for later addition
            $.fn.alaressTiny({
                mode: 'none'
            });

            // Method for building the form
            // Tears down and sets up TinyMCE dynamically too
            var buildForm = function(action, data) {
                tinyMCE.execCommand('mceRemoveControl', true, 'node-description');
                data.action = action;
                formPanel
                    .empty()
                    .append(template(data));
                tinyMCE.execCommand('mceAddControl', true, 'node-description');
            };

            var template  = doT.template($('script#node-template').html().trim());
            var treePanel = $('#category-window');
            var formPanel = $('#detail-window');
            var tree      = $('#browser').jstree({
                core: {
                    animation: 50,
                    data: {{ tree|json_encode|raw }},
                    force_text: true,
                    multiple: false,
                    check_callback: true,
                    themes: {
                        variant: "resourcetree",
                        dots: true,
                        icons: true,
                        responsive: false
                    }
                },
                plugins: ['sort', 'types'],
                types: {
                    root: {
                        icon: '/images/tree/server.gif'
                    },
                    'default': {
                        icon: '/images/icons/22x22/folder.png'
                    },
                    folder: {
                        icon: '/images/icons/22x22/folder.png'
                    },
                    code: {
                        icon: '/images/famicons/star.png'
                    }
                }
            })
                .on('select_node.jstree', function(event, jstree) {
                    jstree.instance.open_node(jstree.node.id);
                })
                .on('ready.jstree', function(event, jstree) {
                    // Is there a hash? If so, open all nodes below that hash.
                    // (but maybe not curriculum codes)
                    var match = window.location.hash.match(/^#(.*)/);
                    if (match) {
                        jstree.instance.select_node(match[1]);
                        jstree.instance.open_all(match[1]);
                    }
                })
                .on('select_node.jstree', function(event, jstree) {
                    // Load this node in the node browser
                    // read URL comes from the node I just clicked
                    formPanel
                        .addClass('loading')
                        .find(':input').prop('disabled', true);
                    $.getJSON(jstree.node.a_attr.href+'.json')
                        .done(function(data) {
                            buildForm(jstree.node.a_attr['data-saveuri'], data.item);
                        })
                        .always(function() {
                            formPanel.removeClass('loading');
                        });
                })

            // resizer - stolen from three panel
            var resizePanels = function() {
                $('#category-window, #detail-window').height(
                    $(window).height() - $('#header').height() - $('#footer').height() - 50
                );
            };
            resizePanels();
            $(window).resize(resizePanels);

            // Node save form submission
            formPanel.on('submit', '#node-form', function(event) {
                event.preventDefault();

                // Do it via AJAX instead
                var form     = $(this);
                var formData = form.serializeArray();
                formPanel
                    .addClass('loading')
                    .find(':input').prop('disabled', true);
                $.ajax({
                    type:     this.method,
                    data:     formData,
                    dataType: 'json',
                    url:      this.action
                })
                    .done(function(data) {
                        // Is this a newly created node? If so, add it in.
                        // jsTree has no comprehensive updateNode, so update what I can.
                        var jstree = $.jstree.reference('#browser');
                        if (jstree.get_node(data.item.id)) {
                            jstree.rename_node(data.item.id, data.tree.text);
                        } else {
                            jstree.create_node(data.tree.parent, data.tree);
                        }
                    })
                    .always(function() {
                        formPanel.removeClass('loading')
                            .find(':input').prop('disabled', false);
                    });
            })

            // Node addition
            treePanel.on('click', '#create-node-button', function(event) {
                event.preventDefault();
                buildForm($(this).data('saveuri'), {});
            })
        })
    })(jQuery);
</script>
<style type="text/css">
    #category-window .jstree-node {
        overflow-x: hidden;
        text-overflow: ellipsis;
    }
    #category-window .jstree-anchor {
        display: inline;
    }
</style>

<!-- Template for the display of a curriculum node -->
{% verbatim %}
<script id="node-template" type="text/x-dot-template">
    <form id="node-form" method="post" action="{{! it.action }}">
        <input type="hidden" name="parent" value="{{! it.parent }}"
        <dl>
            <dt>Name</dt>
            <dd><input type="text" name="name" value="{{! it.name }}" /></dd>
        </dl>
        <!-- Only show learning level for new curriculum base nodes -->
        <dl>
            <dt>Code</dt>
            <dd><input type="text" name="code" value="{{! it.code }}" /></dd>
        </dl>
        <dl>
            <dt>Reference</dt>
            <dd><input type="text" name="reference" value="{{! it.reference }}" /></dd>
        </dl>
        <dl>
            <dt>Description</dt>
            <dd><textarea id="node-description" name="description">{{! it.description }}</textarea>
        </dl>
        <input type="submit" class="submit-btn-plain" value="Save Changes" />
    </form>
</script>
{% endverbatim %}

<div class="template2">
    <div class="left">
        <div id="category-window">
            <div class="loading"></div>
            <table id="category-head" class="table">
                <thead>
                    <tr>
                        <th>
                            Curricula
                            <a href="{{ routeLookup('curriculum.add')|escape('html_attr') }}"
                               id="create-node-button"
                               class="submit-btn-plain float-right inline-block"
                               data-saveuri="{{ routeLookup('curriculum.create')|escape('html_attr') }}"
                            >Create New Curriculum</a>
                        </th>
                    </tr>
                </thead>
            </table>
            <div class="scroller">
                <div id="browser"></div>
            </div>
        </div>
    </div>
    <div class="right">
        <div id="detail-window">
        </div>
    </div>
</div>