<!-- Template for browsing curricula -->
<link rel="stylesheet" type="text/css" media="screen" href="/css/tree.css" />
<link rel="stylesheet" href="/javascript/components/jstree/dist/themes/default/style.css" />
<script type="application/javascript" src="/javascript/components/jstree/dist/jstree.min.js"></script>
<script type="text/javascript" src="/javascript/jquery.resourceTree.js"></script>
<script type="application/javascript">
    (function($) {
        $(function() {
            $('#browser').jstree({
                core: {
                    animation: 50,
                    data: {{ tree|json_encode|raw }},
                    force_text: true,
                    multiple: false,
                    check_callback: true,
                    themes: {
                        variant: "resourcetree",
                        dots: true,
                        icons: true,
                        responsive: false
                    }
                },
                plugins: ['sort', 'types'],
                types: {
                    root: {
                        icon: '/images/tree/server.gif'
                    },
                    'default': {
                        icon: '/images/icons/22x22/folder.png'
                    },
                    folder: {
                        icon: '/images/icons/22x22/folder.png'
                    },
                    code: {
                        icon: '/images/famicons/star.png'
                    }
                }
            })
                .on('select_node.jstree', function(event, jstree) {
                    jstree.instance.open_node(jstree.node.id);
                })
                .on('ready.jstree', function(event, jstree) {
                    // Is there a hash? If so, open all nodes below that hash.
                    // (but maybe not curriculum codes)
                    var match = window.location.hash.match(/^#(.*)/);
                    if (match) {
                        jstree.instance.select_node(match[1]);
                        jstree.instance.open_all(match[1]);
                    }
                })

            // resizer - stolen from three panel
            var resizePanels = function() {
                $('#category-window, #detail-window').height(
                    $(window).height() - $('#header').height() - $('#footer').height() - 50
                );
            };
            resizePanels();
            $(window).resize(resizePanels);
        })
    })(jQuery);
</script>

<h1>Curriculum Browser</h1>

<div class="template2">
    <div class="left">
        <div id="category-window">
            <div class="loading"></div>
            <table id="category-head" class="table">
                <thead>
                    <tr>
                        <th>Curricula</th>
                    </tr>
                </thead>
            </table>
            <div class="scroller">
                <div id="browser"></div>
            </div>
        </div>
    </div>
    <div class="right">
        <div id="detail-window">
        </div>
    </div>
</div>