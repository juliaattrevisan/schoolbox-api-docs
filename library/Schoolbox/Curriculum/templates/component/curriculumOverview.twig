{% macro outputCurriculumNode(node) %}
    <li class="row">
        <div class="twelve-column">
            {% if node.code %}
                {% if isRouteAuthorized('curriculum.browse') %}
                    [<a title="View in curriculum browser" href="{{ routeLookup('curriculum.browse') }}#{{ node.id }}">{{ node.code }}</a>]
                {% else %}
                    [{{ node.code }}]
                {% endif %}
            {% endif %}
            {{ node.name }}

            <ul class="information-list">
                {% if node.children %}
                    {% for subnode in node.children %}
                        {# _self should work here even in twig 2.x #}
                        {{ _self.outputCurriculumNode(subnode) }}
                    {% endfor %}
                {% endif %}
            </ul>
        </div>
    </li>
{% endmacro %}

{% import _self as macros %}


{% if node %}

    <div class="content">
        <ul class="information-list">
            {{ macros.outputCurriculumNode(node) }}
        </ul>
    </div>
{% else %}

    <div class="empty-state">
        <i class="icon-curriculum"></i>

        {% if readonly %}

            <p>There is no curriculum overview to view at this time.</p>

        {% else %}

            {% if not curriculumTagging %}

                {% if USER.isSuperuser %}
                    <p><a href="/adminv2/setting/LMS+Policy">Turn on the Enable Curriculum Tagging toggle</a> in the Administration system to use this feature.</p>
                {% else %}
                    <p>Ask your System Administrator to enable curriculum mapping to use this feature.</p>
                {% endif %}

            {% else %}
                <p><a href="{{ routeLookup('folder.getFolderModify', {id: context.id}) }}#curriculum-codes">Map a curriculum code</a> to your course or {{ locale.unit }} page to display a list of all of the curriculum codes and matching skill descriptors covered in this area of the curriculum.</p>
            {% endif %}

        {% endif %}
    </div>

{% endif %}
