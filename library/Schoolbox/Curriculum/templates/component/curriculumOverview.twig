<div data-overview-component>
    <overview-component
        :node-trees="{{ nodes|json_encode }}"
        :is-read-only="false"
        :selected-nodes="{{ (selectedNodes ?? []) | json_encode }}"
        data-endpoint="{{ routeLookup('curriculumApi.searchNode') }}"
        form-value-name="form-value-name"
        :is-super-user="{{ USER.isSuperuser ? "true" : "false" }}"
        :has-tagging="{{ curriculumTagging ? "true" : "false" }}"
        locale-unit="{{ locale.unit }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/overviewComponent.js?v={{ config.site_version }}"></script>
