{% if node %}

    <div class="content">
        <h3>
            {% if node.code %}
                {% if isRouteAuthorized('curriculum.browse') %}
                    [<a title="View in curriculum browser" href="{{ routeLookup('curriculum.browse') }}#{{ node.id }}">{{ node.code }}</a>]
                {% else %}
                    [{{ node.code }}]
                {% endif %}
            {% endif %}
            {{ node.name }}
        </h3>

        {% if node.description %}
        <article>{{ node.description|purify }}</article>
        {% endif %}
    </div>

{% else %}

    <div class="empty-state">
        <i class="icon-curriculum-details"></i>

        {% if readonly %}

            <p>There are no curriculum details to view at this time.</p>

        {% else %}

            {% if not curriculumTagging %}

                {% if currentUser.isSuperuser %}
                    <p><a href="/adminv2/setting/LMS+Policy">Turn on the Enable Curriculum Tagging toggle</a> in the Administration system to use this feature.</p>
                {% else %}
                    <p>Ask your IT team to turn on the Enable Curriculum Tagging toggle in the LMS Policy Settings in the Administration system to use this feature.</p>
                {% endif %}

            {% else %}
                <p><a href="/resource/folder/modify/{{ context.id }}">Enter curriculum codes</a> to link and display the codes, along with matching skill descriptors, that relate to this page. This component works best on course and unit pages.</p>
            {% endif %}

        {% endif %}
    </div>

{% endif %}