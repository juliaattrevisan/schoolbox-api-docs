{% if nodes | length > 0 %}
    <ul class="information-list">
      {% for node in nodes %}
          <li class="content">
              <p class="no-margin">
                  {% if node.code %}
                      {% if isRouteAuthorized('curriculum.browse') %}
                          [<a title="View in Manage Curriculum" 
                              data-test="curriculum-code-{{ node.code }}"
                              href="{{ routeLookup('curriculum.browse') }}#{{ node.id }}">{{ node.code }}</a>]
                      {% else %}
                          [<span data-test="curriculum-code-{{ node.code }}">{{ node.code }}</span>]
                      {% endif %}
                  {% endif %}
                   <span data-test="curriculum-description-{{ node.code }}">{{ node.name }}</span>
              </p>

              {% if node.description %}
                  <article data-test="curriculum-body-{{ node.code }}">
                {{ node.description|purify }}
            </article>
              {% endif %}
          </li>
      {% endfor %}
    </ul>
{% else %}
    <div class="empty-state">
        <i class="icon-curriculum-details"></i>

        {% if not curriculumTagging %}

            {% if USER.isSuperuser %}
                <p><a href="/adminv2/setting/LMS+Policy">Turn on the Enable Curriculum Tagging toggle</a> in the Administration system to use this feature.</p>
            {% else %}
                <p>Ask your System Administrator to enable curriculum mapping to use this feature.</p>
            {% endif %}

        {% else %}
            <p><a href="{{ routeLookup('folder.getFolderModify', {id: context.id}) }}#curriculum-codes">Map a curriculum or an area of the curriculum</a> to your course or {{ locale.unit }} page to display the associated description of your curriculum.</p>
        {% endif %}
    </div>
{% endif %}
