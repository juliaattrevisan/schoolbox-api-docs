<div class="content">
    {% if node %}
        <h3>
            {% if node.code %}
                {% if isRouteAuthorized('curriculum.browse') %}
                    [<a title="View in curriculum browser" href="{{ routeLookup('curriculum.browse') }}#{{ node.id }}">{{ node.code }}</a>]
                {% else %}
                    [{{ node.code }}]
                {% endif %}
            {% endif %}
            {{ node.name }}
        </h3>

        {% if node.description %}
        <article>{{ node.description|purify }}</article>
        {% endif %}
    {% else %}
        <div class="alert-box warning">
            No curriculum codes have been set for this folder.
        </div>
        {% if not readonly %}
            <a href="/resource/folder/modify/{{ context.id }}" class="button icon-modify">Set curriculum codes</a>
        {% endif %}
    {% endif %}
</div>
