{% if node %}

    <div class="content">
        <h3>
            {% if node.code %}
                {% if isRouteAuthorized('curriculum.browse') %}
                    [<a title="View in curriculum browser" href="{{ routeLookup('curriculum.browse') }}#{{ node.id }}">{{ node.code }}</a>]
                {% else %}
                    [{{ node.code }}]
                {% endif %}
            {% endif %}
            {{ node.name }}
        </h3>

        {% if node.description %}
        <article>{{ node.description|purify }}</article>
        {% endif %}
    </div>

{% else %}

    <div class="empty-state">
        <i class="icon-curriculum-details"></i>

        {% if readonly %}

            <p>Nothing found.</p>

        {% else %}

            {% if not curriculumTagging %}

                {% if currentUser.isSuperuser %}
                    <p>Curriculum tagging is not enabled. This needs to be enabled in <a href="/adminv2/setting/LMS+Policy">Adminstration under Settings -> LMS Policy</a> before you can set curriculum codes for this folder.</p>
                {% else %}
                    <p>Curriculum tagging is not enabled. This will need to be enabled by a superuser in Administration before you can use this component.</p>
                {% endif %}

            {% else %}
                <p>Before anything will display here you need to first <a href="/resource/folder/modify/{{ context.id }}">set curriculum codes</a> for this folder.</p>
            {% endif %}

        {% endif %}
    </div>

{% endif %}