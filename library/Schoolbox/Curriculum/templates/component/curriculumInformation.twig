<div class="box clearfix">
    {% if node %}
        <h3>{{ node.name }} [{{ node.code }}]</h3>
        {% if node.description %}
            {{ node.description|purify }}
        {% endif %}
    {% else %}
        No curriculum codes have been set for this folder.
        You may set them in the
        <a href="/cms/category/{{ context.id }}" class="btn modify inline-block">
            <span></span> Modify Folder
        </a>
        screen.
    {% endif %}
</div>
