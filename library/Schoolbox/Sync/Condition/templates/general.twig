{% set allNDSField = ['Alpha', 'Bravo', 'Charlie', 'Delta'] %}
{% set allMatches = ['Matches', "Doesn't Match"] %}

<li id="condition-{{ currentCondition.condition.id }}" class="actions-small-2 content">
    <input type="hidden" name="condition[{{ currentCondition.condition.id }}][type]" value="0">

    <div class="list-item">
        <div class="row">
            <div class="small-1 medium-1 large-1 columns">
                If
            </div>
            <div class="small-11 medium-5 large-5 columns">
                <select name="condition[{{ currentCondition.condition.id }}][ndsfield]">
                    {% for currentNDSField in allNDSField %}
                    <option value="{{ loop.index0 }}" {% if loop.index0 == currentCondition.selected.NDSField %}selected="selected"{% endif %}>
                        {{ currentNDSField }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            <div class="small-6 medium-3 large-3 columns">
                <select name="condition[{{ currentCondition.condition.id }}][matches]">
                    {% for currentMatches in allMatches %}
                    <option value="{{ loop.index0 }}" {% if loop.index0 == currentCondition.selected.matches %}selected="selected"{% endif %}>{{ currentMatches }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="small-6 medium-3 large-3 columns">
                <textarea name='condition[{{ currentCondition.condition.id }}][values]' rows="5">{{ currentCondition.selected.values }}</textarea>
            </div>
        </div>
    </div>
    <nav>
        <a href="/adminv2/sync/condition/delete/{{ currentCondition.condition.id }}" class="icon-delete" title="Delete"></a>
        <a href="" class="icon-modify" title="Modify"></a>
    </nav>
</li>