{% set allMatches = ['User Exists', "User Doesn't Exist"] %}

<li id="condition-{{ currentCondition.id }}" class="actions-small-2 content" data-locked="{{ meta.condition[currentCondition.id].lock.status }}">
    <input type="hidden" name="rule[{{ currentCondition.rule.id }}][condition][{{ currentCondition.id }}][type]" value="2">

    <div class="list-item">
        <div class="row">
            <div class="small-1 columns">
                <span class="meta">If</span>
            </div>
            <div class="small-11 columns">
                <select {{ meta.condition[currentCondition.id].disabled }} name="rule[{{ currentCondition.rule.id }}][condition][{{ currentCondition.id }}][arguments][0]">
                    {% for currentMatches in allMatches %}
                    <option value="{{ loop.index0 }}" {% if loop.index0 == currentCondition.arguments[0] %}selected="selected"{% endif %}>{{ currentMatches }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="small-12 columns">
                <span id='condition-{{ currentCondition.id }}-status' class="label highlight full-width {{ meta.condition[currentCondition.id].status ? '' : 'hide' }}">{{ meta.condition[currentCondition.id].status }}</span>
            </div>
        </div>
    </div>
    <nav>
        <a href="/adminv2/ups/condition/delete/{{ currentCondition.id }}" class="icon-delete" title="Delete" data-condition-delete="{{ currentCondition.id }}"></a>
        <a href="" class="icon-{{ meta.condition[currentCondition.id].lock.icon }}" title='Toggle Readonly Mode' data-condition-modify-lock="condition-{{ currentCondition.id }}"></a>
    </nav>
</li>