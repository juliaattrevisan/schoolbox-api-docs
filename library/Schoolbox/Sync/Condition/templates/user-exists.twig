<div class="list-item">
    <div class="row">
        <div class="small-1 columns">
            <span class="meta">If</span>
        </div>
        <div class="small-11 columns">
            {% include 'sub/select.twig' with {
                name: 'rule[' ~ currentCondition.rule.id ~ '][condition][' ~ currentCondition.id ~ '][arguments][0]',
                options: ['User Exists', "User Doesn't Exist"],
                preselected: currentCondition.arguments[0]
            } %}
        </div>
        <div id='condition-{{ currentCondition.id }}-status' class="toast {{ meta.condition[currentCondition.id].status ? '' : 'hide' }}" data-alert>{{ meta.condition[currentCondition.id].status }}</div>
    </div>
</div>
