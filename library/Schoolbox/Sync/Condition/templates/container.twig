<li id="condition-{{ currentCondition.id }}" class="actions-small-1" data-condition data-locked="{{ meta.condition[currentCondition.id].lock.status ?? '' }}">
    <input type="hidden" name="rule[{{ currentCondition.rule.id }}][condition][{{ currentCondition.id }}][type]" value="{{ currentCondition.conditionType.id }}">

    {% include allConditionStructures.fragments[currentCondition.id].subfragments.fragment.getFilename() %}
    <nav>
        <a href="/adminv2/ups/condition/delete/{{ currentCondition.id }}" class="sbx-icon-only-button" title="Delete" aria-label="Delete" data-condition-delete="{{ currentCondition.id }}"><sbx-icon name="delete"></sbx-icon></a>
    </nav>
</li>
