<div class="row">
    <div class="small-12 columns">
        <h1>Sync (UPS)</h1>
    </div>

    <div class="small-12 island">
        <section class="content">
            <dl class="tabs" data-tab>
                <dd class="active"><a href="#ruleset-student">Student</a></dd>
                <dd><a href="#ruleset-parent">Parent</a></dd>
                <dd><a href="#ruleset-staff">Staff</a></dd>
            </dl>

            <div class="tabs-content">
                <div id="ruleset-student" class="content active">
                    <form action='/adminv2/sync/testsubmit' method="post">
                        <h2>Student Ruleset</h2>

                        <h3>Conditions</h3>

                        <ul class="information-list">
                            {% include '@syncCondition/general.twig' with { conditionId: 1231, selectedNDSField: 3, selectedMatches: 1, selectedValues:"Mort\nBart\nGruber"} %}
                            {% include '@syncCondition/userExists.twig' with { conditionId: 1232, selectedMatches: 1 } %}
                        </ul>

                        <h3>Effects</h3>

                        <input type="submit" />
                    </form>
                </div>

                <div id="ruleset-parent" class="content">
                    <h2>Parent Ruleset</h2>
                </div>

                <div id="ruleset-staff" class="content">
                    <h2>Staff Ruleset</h2>
                </div>
            </div>
        </section>
    </div>
</div>