{% set allMatches = ['User Exists', "User Doesn't Exist"] %}

<li id="user-condition-{{ conditionId }}" class="actions-small-2 content">
    <input type="hidden" name="condition[{{ conditionId }}][type]" value="1">

    <div class="list-item">
        <div class="row">
            <div class="small-1 columns">
                If
            </div>
            <div class="small-11 columns">
                <select name="condition[{{ conditionId }}][matches]">
                    {% for currentMatches in allMatches %}
                    <option value="{{ loop.index0 }}" {% if loop.index0 == selectedMatches %}selected="selected"{% endif %}>{{ currentMatches }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
    <nav>
        <a href="/adminv2/sync/condition/delete/{{ conditionId }}" class="icon-delete" title="Delete"></a>
        <a href="" class="icon-modify" title="Modify"></a>
    </nav>
</li>