<div class="row">
    <div class="small-12 columns">
        <h1>Sync (UPS)</h1>
    </div>

    <div class="small-12 island">
        <section class="content">
            <dl class="tabs" data-tab>
                <dd class="active"><a href="#ruleset-student">Student</a></dd>
                <dd><a href="#ruleset-parent">Parent</a></dd>
                <dd><a href="#ruleset-staff">Staff</a></dd>
            </dl>
        </section>

        <h2 class="subheader">Student Ruleset</h2>

        <form action='/adminv2/sync/testsubmit' method="post">
            {% for currentRule in ruleset.rules %}
            <section class="content">
                <div class="actions-small-1 row">
                    <div class="list-item">
                        <div class="small-12 columns">
                            <h3>Conditions</h3>
                        </div>
                    </div>
                    <nav>
                        <a class="icon-more" title="" data-dropdown="rule-{{ currentRule.id }}-options"></a>
                    </nav>
                    <ul id="rule-{{ currentRule.id }}-options" class="f-dropdown" data-dropdown-content>
                        <li><a href="/adminv2/sync/condition/new/general" class="icon-add" title="Spawn new General Condition">General Condition</a></li>
                        <li><a href="/adminv2/sync/condition/new/user" class="icon-add" title="Spawn new User Condition">User Condition</a></li>
                    </ul>
                </div>

                <ul class="information-list">
                    {% for currentCondition in currentRule.conditions %}
                        {% if currentCondition.condition.type == 1 %}
                            {% include '@syncCondition/general.twig' with currentCondition %}
                        {% elseif currentCondition.condition.type == 2 %}
                            {% include '@syncCondition/userExists.twig' with currentCondition %}
                        {% endif %}
                    {% endfor %}
                </ul>

                <h3>Effects</h3>
            </section>
            {% endfor %}

            <input type="submit" />
        </form>
    </div>
</div>