<li id="effect-{{ currentEffect.id }}" class="actions-small-{{ numActions }} content" data-locked="{{ meta.effect[currentEffect.id].lock.status }}">
    <input type="hidden" name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][type]" value="3">

    <div class="list-item">
        <div class="row">
            <div class="small-2 medium-1 large-1 columns">
                <span class="meta">Then</span>
            </div>

            <div class="small-10 medium-11 large-11 columns">
                Skip

                <input type="hidden" name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][userProperty]" value="" />
            </div>

            <div>
                <div class="small-12 columns">
                    <span id='effect-{{ currentEffect.id }}-status' class="label highlight full-width {{ meta.effect[currentEffect.id].status ? '' : 'hide' }}">{{ meta.effect[currentEffect.id].status }}</span>
                </div>
            </div>
        </div>
    </div>
    <nav>
        <a href="/adminv2/ups/effect/delete/{{ currentEffect.id }}" class="icon-delete" title="Delete" data-effect-delete="{{ currentEffect.id }}"></a>
    </nav>
</li>