<div id="effect-{{ currentEffect.id }}" class="actions-small-1" data-effect data-locked="{{ meta.effect[currentEffect.id].lock.status ?? 0 }}">
    <input type="hidden" name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][type]" value="3">

    <div class="list-item">
        <div class="row">
            <div class="small-2 medium-1 large-1 columns">
                <span class="meta">Then</span>
            </div>

            <div class="small-10 medium-11 large-11 columns">
                Skip
                <input type="hidden" name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][userProperty]" value="" />
            </div>
            {% set status = meta.effect[currentEffect.id].status ?? false %}

            <div class="small-12 columns {{ status ? '' : 'hide' }}">
                <div id='effect-{{ currentEffect.id }}-status' data-label-status class="label highlight full-width">{{ status }}</div>
            </div>
        </div>
    </div>
    <nav>
        <a href="/adminv2/ups/effect/delete/{{ currentEffect.id }}" class="sbx-icon-only-button" title="Delete" aria-label="Delete" data-effect-delete="{{ currentEffect.id }}"><sbx-icon name="delete"></sbx-icon></a>
    </nav>
</div>
