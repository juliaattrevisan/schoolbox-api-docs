<div class="small-12 medium-6 large-4 columns">
    <select {{ dynamicDisabled }} name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][arguments]">
        <option value="1" {% if currentEffect.arguments[0] == true %}selected="selected"{% endif %}>True</option>
        <option value="0" {% if currentEffect.arguments[0] == false %}selected="selected"{% endif %}>False</option>
    </select>
</div>