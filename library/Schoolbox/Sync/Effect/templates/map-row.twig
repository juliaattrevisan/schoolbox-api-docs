<div class="row" data-map>

    <div class="hide-for-small medium-1 large-1 columns">&nbsp;</div>

    <div class="small-12 medium-4 large-3 columns">
        <label title="This is the value found in your SIS and also the value of your SIS after you alter it with tokens. Both can be used to determine the resultant Schoolbox Value.">
            <input type="text" data-key name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][from][]" value="{{ mapFrom }}" placeholder="SIS Output" />
        </label>
    </div>

    <div class="small-12 medium-3 large-3 columns text-center no-pad">
        <span class="ups-mapping-arrow">&rarr;</span>
    </div>

    <div class="small-12 medium-4 large-5 columns">
        <label title="Schoolbox Value">
        {% include allEffectStructures.fragments[currentEffect.id].subfragments.fragment.getFilename() with { placeholder: "Schoolbox Value"} %}
        </label>
    </div>

</div>
