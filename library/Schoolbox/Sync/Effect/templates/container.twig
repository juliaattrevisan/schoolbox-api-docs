{# Corresponds to db indexes for effectType - could be fed from backend one day #}
{% set allEffectMappingTypes = ['Maps', 'Equals'] %}

<li id="effect-{{ currentEffect.id }}" class="actions-small-2 content" data-locked="{{ meta.effect[currentEffect.id].lock.status }}">
    <input type="hidden" name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][type]" value="">

    <div class="list-item">
        <div class="row">
            <div class="small-2 medium-1 large-1 columns">
                <span class="meta">Then</span>
            </div>
            <div class="small-10 medium-11 large-4 columns">
                <select {{ meta.effect[currentEffect.id].disabled }} name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][userProperty]" data-effect-userfield="{{ currentEffect.id }}" >
                    <option value="-1" disabled selected="selected">Please Select</option>

                    {% for currentUserKey, currentUserField in allEffectStructures.allUserField %}
                        <option value="{{ currentUserKey }}" {% if currentUserKey == currentEffect.getUserProperty() %}selected="selected"{% endif %}>
                            {{ currentUserField.label }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="small-12 medium-6 large-3 columns">
                <select {{ meta.effect[currentEffect.id].disabled }} name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][type]" data-effect-mappingtype="{{ currentEffect.id }}" data-effect-ruleid="{{ currentEffect.rule.id }}">
                    <option value="-1" disabled selected="selected">Please Select</option>

                    {% for currentEffectMappingType in allEffectMappingTypes %}
                        <option value="{{ loop.index }}" {% if loop.index == currentEffect.effectType.id %}selected="selected"{% endif %}>{{ currentEffectMappingType }}</option>
                    {% endfor %}
                </select>
            </div>

            {# Dynamically construct input names
             #}
            {% set dynamicDisabled = meta.effect[currentEffect.id].disabled %}

            <div>
                <div data-effect-fragment="{{ currentEffect.id }}">
                    {% include allEffectStructures.fragments[currentEffect.id].fragment.getFilename() %}
                </div>
                <div class="small-12 columns">
                    <span id='effect-{{ currentEffect.id }}-fragment-status' class="label highlight full-width hide">Loading</span>

                    <span id='effect-{{ currentEffect.id }}-status' class="label highlight full-width {{ meta.effect[currentEffect.id].status ? '' : 'hide' }}">{{ meta.effect[currentEffect.id].status }}</span>
                </div>
            </div>
        </div>
    </div>
    <nav>
        <a href="/adminv2/ups/effect/delete/{{ currentEffect.id }}" class="icon-delete" title="Delete" data-effect-delete="{{ currentEffect.id }}"></a>
        <a href="" class="icon-{{ meta.effect[currentEffect.id].lock.icon }}" title='Toggle Readonly Mode' data-effect-modify-lock="effect-{{ currentEffect.id }}"></a>
    </nav>
</li>