<li id="effect-{{ currentEffect.id }}" class="actions-small-1" data-effect data-locked="{{ meta.effect[currentEffect.id].lock.status ?? 0 }}">
    <input type="hidden" name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][type]" value="">

    <div class="list-item">
        <div class="row">
            <div class="small-12 medium-1 columns">
                <span class="meta">Then</span>
            </div>
            <div class="small-12 medium-4 columns">
                <label title="This Schoolbox User Field will be modified">
                    {% include 'sub/select.twig' with {
                        name: 'rule[' ~ currentEffect.rule.id ~ '][effect][' ~ currentEffect.id ~ '][userProperty]',
                        options: allEffectStructures.allUserField,
                        preselected: currentEffect.getUserProperty(),
                        selectData: {
                            'data-effect-userfield': currentEffect.id
                        }
                    } %}
                </label>
            </div>
            <div class="small-12 medium-3 columns">
                <label title="Mapping Type">
                    {% include 'sub/select.twig' with {
                        name: 'rule[' ~ currentEffect.rule.id ~ '][effect][' ~ currentEffect.id ~ '][type]',
                        options: {
                            1: 'Maps',
                            2: 'Equals'
                        },
                        showPrompt: true,
                        preselected: currentEffect.effectType.id,
                        selectData: {
                            'data-effect-mappingtype': currentEffect.id,
                            'data-effect-ruleid': currentEffect.rule.id
                        }
                    } %}
                </label>
            </div>
            <div>
                <div data-effect-fragment="{{ currentEffect.id }}">
                    {% include allEffectStructures.fragments[currentEffect.id].fragment.getFilename() %}
                </div>
                <div id='effect-{{ currentEffect.id }}-fragment-status' class="label highlight full-width hide">Loading</div>
            </div>
            <div class="small-12 columns {{ meta.effect[currentEffect.id] and meta.effect[currentEffect.id].status ? '' : 'hide' }}">
                <div id='effect-{{ currentEffect.id }}-status' data-label-status class="label highlight full-width">{{ meta.effect[currentEffect.id] ? meta.effect[currentEffect.id].status : '' }}</div>
            </div>
        </div>
    </div>
    <nav>
        <a href="/adminv2/ups/effect/delete/{{ currentEffect.id }}" class="sbx-icon-only-button" title="Delete" aria-label="Delete" data-effect-delete="{{ currentEffect.id }}"><sbx-icon name="delete"></sbx-icon></a>
    </nav>
</li>
