<select {{ dynamicDisabled }} name="{{ dynamicInputName }}">
    {% for current in allEffectStructures.fragments[currentEffect.id].subfragments.fragment.getData() %}
        {% set selected = '' %}

        {% if currentEffect.arguments[0] == current.value %}
            {% set selected = 'selected="selected"' %}
        {% endif %}

        <option value="{{ current.value }}" {{ selected }}>{{ current.label }}</option>
    {% endfor %}
</select>
