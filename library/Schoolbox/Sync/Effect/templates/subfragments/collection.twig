{% set mapRowIdentifier = 'mappingrow-' ~ random(100000000) %}

<input id='mapping-row-input-{{ mapRowIdentifier }}' type="text" {{ dynamicDisabled }} name="{{ dynamicInputName }}" value="{{ preselected }}" />

<div data-mapping-row="{{ mapRowIdentifier }}">
    <script type="text/javascript">
        $(function() {

            /* Pre-tick checkboxes
             */
            $.each($('#ruleset').find('[data-mapping-row]'), function(index, element) {
                var container = $(element);
                var mapRowIdentifier = container.attr('data-mapping-row');

                var csv = $('#mapping-row-input-' + mapRowIdentifier).val();

                /* Split csv into their origina values
                 */
                var values = csv.split(',');

                /* Tick, where values were previously saved
                 */
                for (var i = 0; i < values.length; i++) {
                    container.find('input[value='+values[i]+']').prop('checked', true);
                }
            });
        });
    </script>

    {% for campusId, campusName in allEffectStructures.fragments[currentEffect.id].subfragments.fragment.getData() %}

        {# Each checkbox needs to be unique on the whole page
         # due to custom checkbox design requiring ids
         #}
        {% set checkboxIdentifier = 'effect-' ~ currentEffect.id ~ '-' ~ 'checkbox-' ~ random(10000000) %}

        <input {{ dynamicDisabled }} id="{{ checkboxIdentifier }}" type="checkbox" value="{{ campusId }}" />
        <label for="{{ checkboxIdentifier }}" class="checkbox-label">{{ campusName }}</label>
    {% endfor %}
</div>

