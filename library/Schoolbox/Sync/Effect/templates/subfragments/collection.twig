{% set mapRowIdentifier = 'mappingrow-' ~ random(100000000) %}
{% set entireDataset = allEffectStructures.fragments[currentEffect.id].subfragments.fragment.getData() %}
{% set ajaxUrl = allEffectStructures.fragments[currentEffect.id].subfragments.fragment.getAjaxUrl() %}

<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript">
    $(function() {
        $('#{{ mapRowIdentifier }}-input').selectizeSelector({
            value: [
                {% if preselected is iterable %}
                    {% for current in preselected %}
                        {% if current in entireDataset|keys %}
                            {% raw %}{{% endraw %}"id":{{ current }},"name":"{{ entireDataset[current] }}"{% raw %}}{% endraw %}
                        {% endif %}
                        {% if not loop.last %},{% endif %}
                    {% endfor %}
                {% else %}
                    {% raw %}{{% endraw %}"id":{{ preselected }},"name":"{{ entireDataset[preselected] }}"{% raw %}}{% endraw %}
                {% endif %}
            ],
            ajax: {
                url: '/ajax/ups/ups.php',
                type: 'GET',
                data: {
                    type: '{{ ajaxUrl }}'
                },
                dataType: 'json'
            },
            multiple: true
        });
    });
</script>

<input id='{{ mapRowIdentifier }}-input' name="{{ dynamicInputName }}" type='text' value='' placeholder="Search" />