{% set mapRowIdentifier = 'mappingrow-' ~ random(100000000) %}

{# Multiple selected values for checkbox arrays #}
{% if preselected is iterable %}
    <input id='{{ mapRowIdentifier }}-input' type="hidden" name="{{ dynamicInputName }}" value="{% for value in preselected %}{{ value }}{% if not loop.last %},{% endif %}{% endfor %}" />
{% else %}
    <input id='{{ mapRowIdentifier }}-input' type="hidden" name="{{ dynamicInputName }}" value="{{ preselected }}" />
{% endif %}

<div data-mapping-row="{{ mapRowIdentifier }}" class="ups-mapping-row-collection">
    {% for campusId, campusName in allEffectStructures.fragments[currentEffect.id].subfragments.fragment.getData() %}
        {# Each checkbox needs to be unique on the whole page
         # due to custom checkbox design requiring ids
         #}
        {% set checkboxIdentifier = mapRowIdentifier ~ '-' ~ campusId %}

        <input id="{{ checkboxIdentifier }}" type="checkbox" value="{{ campusId }}" />
        <label for="{{ checkboxIdentifier }}" class="checkbox-label">{{ campusName }}</label>
    {% endfor %}
</div>

