{# Configure input names and preselection comparator values
 # This is how we can share templates between Literal and Mapped types
 #}
{% set dynamicInputName = 'rule[' ~ currentEffect.rule.id ~ '][effect][' ~ currentEffect.id ~ '][to][]' %}

<div class="small-12 medium-6 large-4 columns">
    <label title="You can use optionally use tokens to modify your SIS Output Value, which is then used to determine Schoolbox Values in the key/value inputs below">
        <input {{ dynamicDisabled }} type="text" name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][arguments][0]" value="{{ currentEffect.arguments[0] }}" placeholder="Alter SIS Output with tokens">
    </label>
</div>

<div class="small-12 columns">
    {% for mapFrom, preselected in currentEffect.arguments[1] %}
        {% include '@upsEffect/map-row.twig' %}
    {% endfor %}

    {# Always spawn an empty row to use #}
    {% include '@upsEffect/map-row.twig' %}
</div>