<div class="small-12 medium-6 large-4 columns">
    <input {{ meta.effect[currentEffect.id].disabled }} type="text" name="rule[{{ currentEffect.rule.id }}][effect][{{ currentEffect.id }}][arguments][0]" value="{{ currentEffect.arguments[0] }}">
</div>

<div class="small-12 columns">
    {% if currentEffect.arguments[1]|length %}
        {% for mapFrom, mapTo in currentEffect.arguments[1] %}
            {% include '@syncEffect/map-row.twig' %}
        {% endfor %}
    {% else %}
        {% include '@syncEffect/map-row.twig' %}
    {% endif %}
</div>