{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <h2 class="subheader">Logs</h2>
        </div>
        <div class="small-12 island">
            {% include '@upsRuleset/log/table.twig' %}
        </div>
    </div>
</div>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/dataTables.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function(){
        $('[data-tablesorter]').DataTable({
            info: false,
            paging: false,
            searching: false,
            order: [[ 0, "desc" ]]
        });
    });
</script>
