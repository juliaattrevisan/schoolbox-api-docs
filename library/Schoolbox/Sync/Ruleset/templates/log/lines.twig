{% if useInlineCSS %}
    {# this is a super-minimal, stripped out version of the css to make it readable, for use when the ENTIRE logfile is being displayed in HTML #}
    <style type="text/css">
        ul.information-list {
            padding: 0;
        }
        ul.information-list > li > a {
            display: block;
            text-decoration: none;
            font-weight: bold;
        }
        a.level-100 { color: #98CDD2; }
        a.level-200 { color: #338042; }
        a.level-250 { color: #69502C; }
        a.level-300 { color: #3d1405; }
        ul.information-list a span.meta {
            position: absolute;
            top: 8px;
            right: 8px;
            font-weight: normal;
            color: gray;
            font-size: small;
        }
        ul.information-list > li {
            position: relative;
            border-bottom: solid 1px #eee;
            list-style: none;
            padding: 8px;
        }
        ul.information-list > li:after {
            display: block;
            content: " ";
            clear: both;
        }
        dt {
            width: 25%;
            float: left;
            clear: both;
        }
        dd {
            width: 75%;
            float: right;
            margin: 0;
        }
        pre {
            margin: 0;
        }
        .row > div {
            width: 33%;
            float: left;
        }
    </style>
{% endif %}
{%- for lineNumber, line in log.lines -%}
    <li data-level="{{ line.level }}">
        <a href="#" class="level-{{ line.level }}" data-collapser="line-{{ lineNumber }}">
            <div class="small-8 medium-10 column">
                <span>{{ line.message }}</span>
            </div>
            <div class="text-right small-4 medium-2 column">
                <span class="meta">
                    {{- line.datetime.date | slice(11,12) -}}
                </span>
            </div>
        </a>
        <div class="small-12 column hide" data-collapsable="line-{{ lineNumber }}" data-collapse-state="collapsed">
            {% if line.context %}

                <dl class="inline-dl">
                    {% for key, val in line.context %}
                        <dt class="small-4 large-3">{{ key }}</dt>
                        <dd class="small-8 large-9">
                            {% if val is iterable %}
                                {% include '@upsRuleset/log/key-value-pair.twig' with { dataset: val } %}
                            {% elseif key not in filterBlacklist %}
                                <a href="?filter={{ key }}({{ val }})" title="Filter log on {{ key }} = {{ val }}">
                                    <pre>
                                        {%- include '@upsRuleset/log/visible-value.twig' with { value: val } -%}
                                    </pre>
                                </a>
                            {% else %}
                                <pre>
                                    {%- include '@upsRuleset/log/visible-value.twig' with { value: val } -%}
                                </pre>
                            {% endif %}
                        </dd>
                    {% endfor %}
                </dl>
            {% else %}
                <p class="meta">No context data available</p>
            {% endif %}
        </div>
    </li>
{%- endfor -%}
