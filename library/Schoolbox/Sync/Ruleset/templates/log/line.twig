{% set keyLookup = {'diff': 'Changes', 'externalUser': 'External Data'} %}
<li data-level="{{ line.level }}">
    <a href="#" class="level-{{ line.level }}" data-collapser="line-{{ lineNumber }}">
        <div class="small-8 medium-10 column">
            <span>{{ line.message }}</span>
        </div>
        <div class="text-right small-4 medium-2 column">
                <span class="meta">
                    {{- line.datetime.date | slice(11,12) -}}
                </span>
        </div>
    </a>
    <div class="small-12 column hide" data-collapsable="line-{{ lineNumber }}" data-collapse-state="collapsed">
        {% if line.context and line.level > 200 %}

        <dl class="inline-dl">
            {% for key, val in line.context %}
                {% if keyLookup[key] is defined and keyLookup[key] != '' %}
            <dt class="small-4 large-3">{{ keyLookup[key] }}</dt>
            <dd class="small-8 large-9">
                {% if val is iterable %}
                    {% include '@upsRuleset/log/key-value-pair.twig' with { dataset: val } %}
                {% elseif key not in filterBlacklist %}
                <a href="?filter={{ key }}({{ val }})" title="Filter log on {{ key }} = {{ val }}">
                    <pre>
                        {%- include '@upsRuleset/log/visible-value.twig' with { value: val } -%}
                    </pre>
                </a>
                {% else %}
                <pre>
                    {%- include '@upsRuleset/log/visible-value.twig' with { value: val } -%}
                </pre>
                {% endif %}
            </dd>
                {% endif %}
            {% endfor %}
        </dl>
        {% endif %}
    </div>
</li>
