<table data-tablesorter class="stack-for-small-down">
    <thead>
    <tr>
        {% for th, td in logs|first %}
            <th>{{ th }}</th>
        {% endfor %}
    </tr>
    </thead>
    <tbody>
    {% for id, log in logs %}
        <tr>
            {% for th, td in log %}
                <td title="{{ th }}">
                    {% if td is iterable %}
                        <ul>
                            {% for li in td %}
                                <li>{{ li }}</li>
                            {% endfor %}
                        </ul>
                    {% elseif td is same as(false) %}
                    <a href="{{ routeLookup('upsRuleset.logFormat', { logId: id, format: 'html' }) }}"
                       target="_blank"
                       title="View log">No</a>
                    {% elseif td is same as(true) %}
                        <a href="{{ routeLookup('upsRuleset.logFormat', { logId: id, format: 'html' }) }}"
                           target="_blank"
                           title="View log">Yes</a>
                    {% else %}
                    <a href="{{ routeLookup('upsRuleset.logFormat', { logId: id, format: 'html' }) }}"
                       target="_blank"
                       title="View log">{{ td }}</a>
                    {% endif %}
                </td>
            {% endfor %}
        </tr>
    {% endfor %}
    </tbody>
</table>
