<table data-tablesorter class="stack-for-small-down">
    <thead>
    <tr>
        <th>Timestamp</th>
        <th>Role Type</th>
        <th>Dry Run</th>
        <th>Created</th>
        <th>Updated</th>
        <th>Skipped</th>
    </tr>
    </thead>
    <tbody>
    {% for id, log in logs %}
        {% set route = routeLookup('upsRuleset.logFormat', { logId: id, format: 'html' }) %}
        <tr>
            <td data-order="{{ log['Timestamp'].unixTimestamp }}">
                <a href="{{ route }}" target="_blank" title="View log">{{ log['Timestamp'].short }} </a>
            </td>
            <td>
                <a href="{{ route }}" target="_blank" title="View log">{{ log['Role Type'] }}</a>
            </td>
            <td>
                <a href="{{ route }}" target="_blank" title="View log">{{ log['Dry Run'] ? 'Yes': 'No' }}</a>
            </td>
            <td>
                <a href="{{ route }}" target="_blank" title="View log">{{ log['Created'] }}</a>
            </td>
            <td>
                <a href="{{ route }}" target="_blank" title="View log">{{ log['Updated'] }}</a>
            </td>
            <td>
                <a href="{{ route }}" target="_blank" title="View log">{{ log['Skipped'] }}</a>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
