{% include '@upsRuleset/breadcrumbs.twig' with { allNodes: allBreadcrumbs } %}

<div class="row">
    <div class="small-12 columns">
        <h1>User Provisioning System</h1>

        {% include '@upsRuleset/navigation.twig' with { allNodes: allNavigation } %}
    </div>

    <div class="small-12 island">
        <section class="content">
            <h2 class="subheader">Running {{ rulesetId|capitalize }} Dry Run</h2>
            {% if config.messaging_enabled %}
                <p>Please be patient - we'll let you know when it's done.</p>
            {% else %}
                <p>
                    If messaging was enabled, you would receive an alert when the dry run was completed.
                    It isn't though, so maybe check again in a few minutes?
                </p>
            {% endif %}
        </section>
    </div>
</div>