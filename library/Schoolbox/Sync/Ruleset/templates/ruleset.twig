{# Configuration in Twig Land
 #
 # Use to provide some front-end configurability
 # and a bunch of const-like settings, without
 # having to do it in back-end first
 #}
{%
set config = {
    'condition': {
        'general': 1,
        'userExists': 2
    }
}
%}

<script type="text/javascript" src="/javascript/shared/jquery.collapsable.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.label-timeout.js"></script>
<script type="text/javascript" src="/javascript/shared/ups/jquery.ups.js"></script>

<script type="text/javascript">
    $(function() {
        $('#ruleset').ups();
    });
</script>

{% include '@upsRuleset/breadcrumbs.twig' with { allNodes: allBreadcrumbs } %}

<div class="row">
    <div class="small-12 columns">
        <h1>User Provisioning System</h1>

        {% include '@upsRuleset/navigation.twig' with { allNodes: allNavigation } %}
    </div>

    <div class="small-12 island">
        {% if hasDryRun %}
            <div data-alert class="alert-box">
                <h2>Running {{ rulesetId|capitalize }} Dry Run</h2>
                {% if config.messaging_enabled %}
                    <p>Please be patient - we'll notify you when it's done.</p>
                {% else %}
                    <p>
                        If messaging was enabled, you would be notified when the dry run was completed.
                        It isn't though, so maybe check again in a few minutes?
                    </p>
                {% endif %}
                <a href="" class="close">×</a>
            </div>
        {% endif %}
        <form id='ruleset' action='/adminv2/ups/ruleset/update' method="post">
            <input type="hidden" name="rulesetId" value="{{ rulesetId }}" />

            <div class="actions-small-1">
                <div class="list-item">
                    <h2 class="subheader">{{ rulesetId|capitalize }} Ruleset</h2>
                </div>
                <nav>
                    <span class="switch round">
                        <input type="hidden"
                               name="config[{{ rulesetId }}][enabled]"
                               value="0">
                        <input type="checkbox"
                               id="config-{{ rulesetId }}-switch"
                               name="config[{{ rulesetId }}][enabled]"
                               {% if ruleset.getConfig().getEnabled() %}checked{% endif %}
                               value="1">
                        <label for="config-{{ rulesetId }}-switch">
                            <span>On</span>
                            <span>Off</span>
                        </label>
                    </span>
                    <a href='/adminv2/ups/rule/add/{{ rulesetId }}' class="icon-add" title="Add New Rule"></a>
                    <a class="icon-more" title="" data-dropdown="ruleset-options"></a>
                </nav>
                <ul id="ruleset-options" class="f-dropdown" data-dropdown-content>
                    <li><a href='{{ routeLookup('upsRuleset.dryRun', {rulesetId: rulesetId}) }}' class="icon-export" title="Perform Dry Run">Perform Dry Run</a></li>
                </ul>
            </div>

            <ul class="information-list sortable" data-sortable>
            
                {% for currentRule in ruleset.getRules() %}
                <li class="row" id="rule-{{ currentRule.id }}" data-rule="{{ currentRule.id }}">

                    {# Ensure rule[] gets POSTed, even when it has no Conditions or Effects
                      # We do that so the Rule can be sequenced prior to creation of Conditions
                      # and/or Effects
                      #}
                    {% if currentRule.conditions|length == 0 %}
                    <input type="hidden" name="rule[{{ currentRule.id }}]" value="" />
                    <input type="hidden" name="rule[{{ currentRule.id }}][conditions]" value="" />
                    <input type="hidden" name="rule[{{ currentRule.id }}][effects]" value="" />
                    {% endif %}

                    <div class="grip"></div>
                    <div class="small-11 columns no-pad">
                        <div class="actions-small-4">
                            <div class="list-item">
                                <h3 class="subheader">
                                    {% if currentRule.name|length %}
                                        {{ currentRule.name }}
                                    {% else %}
                                        Rule {{ currentRule.id }}
                                    {% endif %}
    
                                    {% if currentRule.description|length %}
                                        <span class='hint has-tip tip-top' data-tooltip title="{{ currentRule.description }}">?</span>
                                    {% endif %}
                                </h3>
                            </div>
                            <nav>
                                <a href="#" class="icon-down-arrow" data-collapser="rule-{{ currentRule.id }}-contents" title="Expand/Collapse Content"></a>
                                <a class="icon-more" title="" data-dropdown="rule-{{ currentRule.id }}-options"></a>
                            </nav>
                        </div>
    
                        <span id='rule-{{ currentRule.id }}-status' class="label highlight full-width hide"></span>
                    </div>

                    <div class="small-12 columns no-pad">
                        <section class="content hide" data-collapsable="rule-{{ currentRule.id }}-contents" data-collapse-state="collapsed">
                            <h4>Conditions</h4>

                            <ul class="information-list no-pad" id="rule-{{ currentRule.id }}-conditions">
                                {% for currentCondition in currentRule.conditions %}
                                {% include allConditionStructures.fragments[currentCondition.id].fragment.getFilename() %}
                                {% endfor %}
                            </ul>
    
                            <div class="actions-small-1 row">
                                <div class="list-item">
                                    <div class="small-12 columns">
                                        <h4>Effects</h4>
                                    </div>
                                </div>
                                <nav>
                                    <a class="icon-help" title="Show available Tokens" data-reveal-id="token-list"></a>
                                </nav>
                            </div>
    
                            <ul class="information-list no-pad" id="rule-{{ currentRule.id }}-effects">
                                {% for currentEffect in currentRule.effects %}
                                {% include allEffectStructures.containers[currentEffect.id] %}
                                {% endfor %}
                            </ul>
                        </section>
                    </div>

                    <ul id="rule-{{ currentRule.id }}-options" class="f-dropdown" data-dropdown-content>
                        <li class="separator">Rule</li>
                        <li><a href="/adminv2/ups/rule/edit/{{ currentRule.id }}" class="icon-modify" title="Edit Rule">Edit Rule</a></li>
                        <li><a href="/adminv2/ups/rule/delete/{{ currentRule.id }}" class="icon-delete" data-rule-delete="{{ currentRule.id }}" title="Delete Rule">Delete Rule</a></li>
                        <li class="separator">Conditions</li>
                        <li><a href="/adminv2/ups/condition/add/{{ currentRule.id }}/{{ config.condition.general }}" class="icon-add" title="Spawn new General Condition" data-condition-create="{{ currentRule.id }}">General Condition</a></li>
                        <li><a href="/adminv2/ups/condition/add/{{ currentRule.id }}/{{ config.condition.userExists }}" class="icon-add" title="Spawn new User Exists Condition" data-condition-create="{{ currentRule.id }}">User Exists Condition</a></li>
                        <li class="separator">Effects</li>
                        <li><a href="/adminv2/ups/effect/add/{{ currentRule.id }}" class="icon-add" title="Spawn new Effect" data-effect-create="{{ currentRule.id }}">Add New Effect</a></li>
                        <li><a href="/adminv2/ups/effect/add/{{ currentRule.id }}/skip" class="icon-add" title="Skip" data-effect-create="{{ currentRule.id }}">Skip User</a></li>
                    </ul>
                </li>
                {% endfor %}
            </ul>

            {# Display custom rules #}
            {% if ruleset.getCustomRules() is not empty %}

            <h2 class="subheader">Custom Rules</h2>

            {% for customRule in ruleset.getCustomRules() %}
            <div class="row" id="customRule-{{ customRule.getId() }}">
                <div class="small-12 columns">
                    <div class="actions-small-1">
                        <div class="list-item">
                            <h3 class="subheader">
                                {{ customRule.getHydrator().getName() }}
                                <span class='hint has-tip tip-top'
                                      data-tooltip
                                      title="{{ customRule.getHydrator().getDescription() }}">?</span>
                            </h3>
                        </div>
                        <nav>
                            <span class="switch round">
                                <input type="hidden"
                                       name="customRule[{{ customRule.getId() }}][enabled]"
                                       value="0">
                                <input type="checkbox"
                                       id="customRule-{{ customRule.getId() }}-switch"
                                       name="customRule[{{ customRule.getId() }}][enabled]"
                                       {% if customRule.getEnabled() %}checked{% endif %}
                                       value="1">
                                <label for="customRule-{{ customRule.getId() }}-switch">
                                    <span>On</span>
                                    <span>Off</span>
                                </label>
                            </span>
                        </nav>
                    </div>
                </div>
            </div>
            {% endfor %}
            {% endif %}

            <input type="submit" value="Save Ruleset" />
        </form>

        <div id="token-list" class="reveal-modal" data-reveal>
            <div class="row">
                <div class="small-12 columns">
                    <h2>Tokens and Filters</h2>
                    <p>
                        Tokens and Filters allow you to modify your SIS Output value.
                        The modified output value can be used in Effects to construct
                        or match complicated text strings. They are entirely optional.
                    </p>
                </div>
            </div>

            <div class="row">
                <div class="small-12 large-6 columns">
                    <h3>Available Tokens</h3>

                    <dl class="inline-dl">
                        {% for token, description in allNDSField %}
                        <dt class="small-6">{:{{ token|replace({'[]': ''}) }}}</dt>
                        <dd class="small-6">{{ description }}</dd>
                        {% endfor %}
                    </dl>

                    <p>
                        Note that you can use square brackets to reference nth elements.
                        This applies to tokens for {:email.address}, {:campus.code}
                        and {:campus.name}
                    </p>
                    <p>
                        For example, you can use them like this:<br />
                        {:email[0].address}<br />
                        {:campus[1].code}<br />
                        {:campus[2].name}
                    </p>
                </div>
                <div class="small-12 large-6 columns">
                    <h3>Available Filters</h3>

                    <dl class="inline-dl">
                        <dt class="small-6">uc</dt>
                        <dd class="small-6">Converts to uppercase</dd>

                        <dt class="small-6">lc</dt>
                        <dd class="small-6">Converts to lowercase</dd>

                        <dt class="small-6">first</dt>
                        <dd class="small-6">Returns only the first character</dd>

                        <dt class="small-6">alpha</dt>
                        <dd class="small-6">Strips all non-alpha characters</dd>
                    </dl>
                </div>
            </div>

            <a class="close-reveal-modal">&#215;</a>
        </div>
    </div>
</div>