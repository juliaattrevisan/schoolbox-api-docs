{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [folder.name, '/homepage/' ~ folder.id],
    ['Generate Login Codes']
) }}
<div class="small-12 island">
    <h1>Generate login codes for {{ folder.nameWithCodes }}</h1>
</div>
<div id="manage-qr-codes-container">
    <manage-qr-codes
        endpoint-generate="{{ routeLookupIfAuthorized('qrcode.generate', {folder:folder, folderId:folder.id}) }}"
        folder-name-with-code="{{ folder.nameWithCodes }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/manageQrCodes.js?v={{ config.site_version }}"></script>
