{#
    The most basic filter sub-panel template, renders a flat list of checkboxes
    Usage:
        isAvailable:    bool              - Should this component be available in the panel ?
        definition:     IFilterDefinition
        roleSelections: FilterSelection[] - Default filter selections for current user's role, indexed by selection.key
        userSelections: FilterSelection[] - A set of filter selections made by the current user, indexed by selection.key
#}

{# Are any options available? If not, don't render this filter at all #}
{% if isAvailable %}

    {# Concrete component template to define #}
    {% set filterName = filterName ?: 'undefined' %}

    <div class="checklist" data-component="{{ definition.filter.id }}" style="margin: 0 20px; min-width: 150px;">
        <h4 data-filter-name>{{ filterName }}</h4>
        {% for selection in userSelections %}
            {% include '@filters/_selectionCheckbox.twig' with {
                userSelection: selection,
                roleSelection: defaultSelections[selection.key],
                label:         definition.label(selection.key)
            } only %}
        {% endfor %}
    </div>
{% endif %}

