{#
    Displays a list of all filters that are visible in the UI, grouped by filtered entity type

    Usage:
        filtersPerEntity Filter[][]           Grouped by filtered entity
        ENTITY_*         int                  All entity type constants known to system (@see Filter\Model)
#}

<div class="row">
    {{ renderAdminNavigation(pageCurrent) }}
</div>

{% for entity, filters in filtersPerEntity %}
    <h2>
        {%- if ENTITY_ASSESSMENTS == entity -%}
            Assessments
        {%- else -%}
            {# Graceful degradation #}
            Entity Type: {{ entity }}
        {%- endif -%}
    </h2>
    <table>
        <tr>
            <th>Filter</th>
            <th>Option Availability</th>
            <th>Default Selections</th>
        </tr>
        {% for filter in filters %}
        <tr>
            <td>{{ filter.name }}</td>
            <td><a href="{{ routeLookup('filters.getAvailableOptions', { filter: filter.id }) }}">Options</a></td>
            <td><a href="{{ routeLookup('filters.getDefaultsSelections', { filter: filter.id }) }}">Defaults</a></td>
        </tr>
        {% endfor %}
    </table>
{% endfor %}
