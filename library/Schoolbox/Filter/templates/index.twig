{#
    Displays a list of all pages in the system that contain filter panels

    Usage:
            filtersPerPage           Filter\Model[][] Indexed by page, then filter.class.name
            showCourseMarkbook       bool
            ENTITY_ASSESSMENTS       string
            pageCurrent              string
            pageLabels               string[]
            allBreadcrumbs           array
#}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <h2 class="subheader">Filterable Pages</h2>
            <section>
                <ul class="information-list">
                    {% for page, pageFilters in filtersPerPage | filter(page => showCourseMarkbook or page != 'courseMarkbook')  %}

                        {% set pageName = pageLabels[page]|default(page) %}

                        {# Filters on a page are all for same entity type, so just inspect first #}
                        {% set entity = (pageFilters | first).entity %}
                        {%- if ENTITY_ASSESSMENTS == entity -%}
                            {% set icon = 'due-work' %}
                        {%- elseif ENTITY_BADGES == entity -%}
                            {% set icon = 'showcase' %}
                        {%- else -%}
                         {# Graceful degradation to generic filter icon if constant not injected into twig #}
                            {%- set icon = 'filter' -%}
                        {%- endif -%}
                        <li>
                            <div class="list-item">
                                <div class="card small-12">
                                    <a href="{{ routeLookup('filters.getPageSettings', { page: page }) }}">
                                        <h3><i class="icon-{{ icon }} size-24"></i>{{ pageName }}</h3>
                                        <p class="meta">
                                            {%- for className, filterInstance in pageFilters -%}
                                                {%- if not loop.first -%}, {% endif -%}{{ className }}
                                            {%- endfor -%}
                                        </p>
                                    </a>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
</div>

