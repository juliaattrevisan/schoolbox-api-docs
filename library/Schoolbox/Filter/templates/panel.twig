{#
A panel that displays various filters.

Usage:
    contentId string      - the ID of the HTML element where we will replace with AJAX content
    panel     Filterpanel
    quickload bool        - if true, fill contentId with .innerHTML instead of jQuery.html()
                            When true, any JavaScript must be applied on the "filterContentLoaded"
                            event of the contentId element.

    ? TODO convert to JS plugin that is executed against the panel element (so it can get with $this), and takes contentPanelId as single arg
#}
<script type="text/javascript" src="/javascript/shared/jquery.select-multi-checkboxes.js"></script>

{% autoescape 'js' %}
<script type="text/javascript">

    $(function() {

        // ============== Other Plugins

        $('[data-component]').selectMulti({});
        $('[data-collapser]').collapsable();

        // ============== Global Variables & Constants
        var MAX_VISIBLE_SELECTIONS = 4;

        // ============== Configuration
        var quickload = Boolean("{{ quickload }}");

        // ============== jQuery DOM handles
        var $reportContent       = $('#{{ contentId }}');
        var $filterPanel         = $('#filter_panel');
        var $interactionContainer= $filterPanel.find('[data-interaction-container]');
        var $panelComponents     = $filterPanel.find('[data-component]');
        var $appliedFilters      = $filterPanel.find('[data-applied-filters]');
        var $submitButton        = $('#submit_button');
        var $optionCheckboxes    = $filterPanel.find('input[type=checkbox], input[type=hidden]');
        var $toast               = $('[data-relation="submit-label"]');
        var $serverErrorFeedback = $filterPanel.find('#server_error_feedback');
        var $filterLoaderIcon    = $filterPanel.find('#filter-loader');
        var $resetToDefaultsBtn  = $filterPanel.find('#defaults_reset');
        var $countMoreModal      = $('#filter-options');
        var $countMoreModalName  = $countMoreModal.find('[data-filter-name]');
        var $countMoreModalList  = $countMoreModal.find('[data-selected-list]');
        var $clearAllBtn         = $filterPanel.find('#clear-all');

        //  Error messages to display for different server errors
        var $alertOutOfMemory       = null;
        var $alertTimeout           = null;
        var $alertUncaughtException = null;
        var $alertErrorUnknown      = null;

        // A tab to insert in filter summary - illustrating what filters are being used
        var $tabAppliedFilter  = null;

        // A selected option in the modal's option list
        var $modalListItem     = null;

        // ============== Event Handlers

        // Listen for clicks on the submit button
        $submitButton.on('click', function(event){
            event.preventDefault();
            updateOriginalSelections();
            fetchReport();
            return false; // don't bubble
        });

        // Listen for user checking filter options
        $optionCheckboxes.on('change', function(){
            updateFiltersInUseLabel();
        });

        // Listen for user removing an applied filter
        $appliedFilters.on('click', '[data-close]', function(){
            var $filterTab = $(this).closest('[data-applied-filter-tab]');
            clearFilter($filterTab.data('applied-filter-tab'));
            $filterTab.remove();
            return false; // don't bubble
        });

        // Cancel changes since last selection submit
        $clearAllBtn.on('click', function (){
            $filterPanel.find('input[type=checkbox][data-value-original]').each(function(idx, elem){
                var $checkbox = $(elem);
                $checkbox.prop('checked', $checkbox.data('value-original'));
            });
            updateFiltersInUseLabel();
        });

        // Reset to role-specific default selections
        $resetToDefaultsBtn.on('click', function (){
            $filterPanel.find('input[type=checkbox][data-value-default]').each(function(idx, elem){
                var $checkbox = $(elem);
                $checkbox.prop('checked', $checkbox.data('value-default'));
            });
            updateFiltersInUseLabel();
        });

        // Clicking on "X more" modal reveal
        $filterPanel.on('click', '[data-reveal-id]', function(a){
            var filterId = $(a.currentTarget).closest('[data-applied-filter-tab]').data('applied-filter-tab');
            updateCountMoreModal(filterId);
        });

        // ============== Internal Helpers

        /**
         * To ensure each checkbox's original value data attribute is synchronised with the DB, we need to
         * update their values each time we submit a set of filter selections to the server
         */
        function updateOriginalSelections(){
            $filterPanel.find('input[type=checkbox][data-value-original]').each(function(idx, elem){
                var $checkbox = $(elem);
                var checkedState = $checkbox.prop('checked') ? 1 : 0;
                $checkbox.data('value-original', checkedState);
                $checkbox.attr('data-value-original', checkedState);
            });
            updateFiltersInUseLabel();
        }

        /**
         * Clears checkboxes for the specified filter
         *
         * @param {int} filterId
         */
        function clearFilter(filterId) {
            $panelComponents.filter('[data-component='+filterId+']').find('input[type=checkbox]').prop('checked', false);
            updateFiltersInUseLabel();
        }

        /**
         * Requests a filtered report via AJAX
         */
        function fetchReport() {
            $toast.toastActivate({text: 'Requesting report...'});
            showFilterLoader();
            var href        = $submitButton.data('href'),
                data        = $optionCheckboxes.serialize(),
                decodedData = deserialize(data);
            $submitButton.val($submitButton.data('working'));

            disableInputs();
            hidePanel();
            if(isContentLoaded()){
                showContentPlaceholder();
            }

            // Is there a href to post to?
            // Post there if so, otherwise update the history state and filters
            // immediately.
            if (href) {
                $.post(href, data)
                    .success(function(response){

                        // Did we get not get JSON ?
                        if('object' !== typeof response){
                            processFilterUpdateError(response);
                            return;
                        }

                        // Was an exception thrown?
                        if(200 !== response.status){
                            renderExceptionThrown(response.code, response.message, response.line, response.file);
                            return;
                        }

                        updateHistoryState(decodedData);
                        replaceReportContent(response.content);
                        processFilterUpdateSuccess(decodedData);
                    })
                    .fail(function(response){
                        processFilterUpdateError(response.responseText);
                    })
                    .always(processFilterUpdateAlways);
            } else {
                updateHistoryState(decodedData);
                processFilterUpdateSuccess(decodedData);
                processFilterUpdateAlways();
            }
        }


        /**
         * Replace the content of the report with the given HTML.
         *
         * @param {string} html
         */
        function replaceReportContent(html) {
            if (quickload) {
                $reportContent.get(0).innerHTML = html;
            } else {
                $reportContent.html(html);
            }
        }


        /**
         * Action for after the selected filters have been changed successfully.
         *
         * @param {object} decodedSelections
         */
        function processFilterUpdateSuccess(decodedSelections) {
            $serverErrorFeedback.hide();
            $reportContent.attr('data-loaded', '1');
            $reportContent.trigger('filterContentLoaded', [decodedSelections]);
            $toast.toastTimeout({text: 'Success!', css: 'success'});
        }


        /**
         * Action for after an attempt (successful or not) to update the
         * selected filters.
         */
        function processFilterUpdateAlways() {
            $submitButton.val($submitButton.data('value'));
            hideFilterLoader();
            enableInputs();
            hideContentPlaceholder();
        }


        /**
         * Returns the panel's serialised filter option selections in object structure.
         *
         * Includes all options, regardless of whether checked or unchecked. (ie [0|1])
         *
         * TODO consider replacing with qs.parse
         *
         * @param {string} serialised
         * @return {object}
         */
        function deserialize(serialised){
            var decodedData = decodeURIComponent(serialised),
                flatArray   = decodedData.split('&'),
                nestedObj   = {},
                regEx       = /^filter_selection\[(\d+)]\[(\w+)]=([01])$/, // eg 'filter_selection[1][task]=1'
                emptyRegEx  = /^filter_selection\[(\d+)]=$/;               // eg 'filter_selection[17]='

            // Convert flat string array to nested object
            flatArray.forEach(function (keyValue) {
                var filterId  = null,
                    optionKey = null,
                    optionVal = null,
                    result = regEx.exec(keyValue);

                if (!result){
                    // This happens if a filter has no options, eg course import not imported to any classes
                    // Still attempt to output an empty nested object
                    result = emptyRegEx.exec(keyValue);
                    if (!result) {
                        return;
                    }
                    filterId = result[1];
                } else {
                    filterId  = result[1];
                    optionKey = result[2];
                    optionVal = result[3];
                }

                if (!nestedObj.hasOwnProperty(filterId)) {
                    nestedObj[filterId] = {};
                }

                if (optionKey !== null) {
                    nestedObj[filterId][optionKey] = optionVal;
                }
            });

            // Set all nested values to NULL if they're empty
            // This is required so that qs submits an empty value (required so that
            Object.keys(nestedObj).forEach(function (filterId) {
                if (Object.keys(nestedObj[filterId]).length === 0) {
                    nestedObj[filterId] = null;
                }
            });

            return nestedObj;
        }

        /**
         * Converts the filter selections to a URL and updates the browser history so that the URL
         * reflects the current view. This ensures the user can copy/paste the URL, and page refresh works
         * as expected.
         *
         * @param {object} decodedSelections
         */
        function updateHistoryState(decodedSelections)
        {
            var nestedObj = {};

            // Convert flat string array to nested object
            for (var filterId in decodedSelections) {
                // Don't include inherited properties
                if (!decodedSelections.hasOwnProperty(filterId)) {
                    continue;
                }
                nestedObj[filterId] = {};

                for(var optionKey in decodedSelections[filterId]){
                    // Don't include inherited properties
                    if (!decodedSelections[filterId].hasOwnProperty(optionKey)) {
                        continue;
                    }
                    var optionVal = decodedSelections[filterId][optionKey];

                    // We only need to know about checked values
                    if ("1" === optionVal) {
                        nestedObj[filterId][optionKey] = optionVal;
                    }
                }
            }

            // Convert to query args
            var queryArgs = [];
            for (filterId in nestedObj) {
                if(nestedObj.hasOwnProperty(filterId)) {
                    var selections = nestedObj[filterId];
                    if (0 === Object.keys(selections).length) {
                        queryArgs.push(filterId + '='); // empty filter selection syntax
                    } else {
                        for (optionKey in selections) {
                            if (selections.hasOwnProperty(optionKey)) {
                                queryArgs.push(filterId + '[' + optionKey + ']=' + selections[optionKey]); // filter option selected syntax
                            }
                        }
                    }
                }
            }

            var url = window.location.origin + window.location.pathname + '?' + queryArgs.join('&');
            history.replaceState({}, '', url);
        }

        /**
         * Action for after an attempt to update the selected filters fails.
         *
         * Try to figure out why the server failed to return a report, and to
         * display something helpful to the end user.
         *
         * @param {string} responseText
         */
        function processFilterUpdateError(responseText) {

            // Was this an OOM error ?
            var oomErrorIndex = responseText.indexOf('Fatal error: Allowed memory size of');
            if(-1 !== oomErrorIndex && oomErrorIndex < 400) {
                displayAlert($alertOutOfMemory);
                showPanel();
                return;
            }

            // Was this a Timeout ?
            var timeoutIndex = responseText.indexOf('Fatal error: Maximum execution time');
            if(-1 !== timeoutIndex && timeoutIndex < 400) {
                displayAlert($alertTimeout);
                showPanel();
                return;
            }

            // Not sure what went wrong - show generic error alert messge
            displayAlert($alertErrorUnknown);
        }


        /**
         * Render a helpful HTML error alert when the server indicates an uncaught exception has occurred
         *
         * @param {int}    code
         * @param {string} message
         * @param {int}    line
         * @param {string} file
         **/
        function renderExceptionThrown(code, message, line, file)
        {
            $alertUncaughtException.find('[data-code]').html(code);
            $alertUncaughtException.find('[data-message]').html(message);
            $alertUncaughtException.find('[data-line]').html(line);
            $alertUncaughtException.find('[data-file]').html(file);
            displayAlert($alertUncaughtException);
        }


        /**
         * Disable panel inputs
         */
        function enableInputs() {
            $submitButton.attr('disabled', false);
            $clearAllBtn.attr('disabled', false);
            $resetToDefaultsBtn.attr('disabled', false);
            $optionCheckboxes.filter(':not([data-disabled])').attr('disabled', false);
        }

        /**
         * Disable panel inputs
         */
        function disableInputs() {
            $submitButton.attr('disabled', true);
            $clearAllBtn.attr('disabled', true);
            $resetToDefaultsBtn.attr('disabled', true);
            $optionCheckboxes.attr('disabled', true);
        }

        /**
         * Hide the filter panel components
         */
        function hidePanel() {
            if('uncollapsed' === $filterPanel.find('[data-collapsable]').attr('data-collapse-state')){
                $filterPanel.find('[data-collapser]').trigger('click');
            }
        }

        /**
         * Show the filter panel components
         */
        function showPanel() {
            if('collapsed' === $filterPanel.find('[data-collapsable]').attr('data-collapse-state')){
                $filterPanel.find('[data-collapser]').trigger('click');
            }
        }

        /**
         * Fetch the HTML we will render by JS into an alert. Then remove the template from the DOM.
         */
        function cacheErrorAlerts() {
            // Cache error messages
            $alertOutOfMemory       = $serverErrorFeedback.find('[data-reason="out-of-memory"]');
            $alertTimeout           = $serverErrorFeedback.find('[data-reason="timeout"]');
            $alertUncaughtException = $serverErrorFeedback.find('[data-reason="uncaught-exception"]');
            $alertErrorUnknown      = $serverErrorFeedback.find('[data-reason="unknown"]');

            // Remove from DOM
            $serverErrorFeedback.find('[data-reason]').detach();
        }

        /**
         * Grab and store DOM element markup so we can clone and insert as required
         */
        function cacheDomElements() {
            $tabAppliedFilter = $('[data-applied-filter-tab]').remove().removeClass('hide');
            $modalListItem    = $countMoreModalList.find('[data-selected-option]').remove();
        }

        /**
         * Show an alert in the server feedback panel
         *
         * @param {jQuery} $alert
         */
        function displayAlert($alert) {
            // Remove previous alerts
            $serverErrorFeedback.children().remove();

            $toast.toastTimeout({text: 'Failure!', css: 'alert'});
            $alert.removeClass('alert-close');
            $serverErrorFeedback.append($alert);
            $serverErrorFeedback.show();
        }

        /**
         * Update the 'in-use' filter label according to current filter option selections
         *
         * A filter is not selected if either:
         * * all options are selected, or
         * * no options are selected.
         *
         * Always sorts in the same order as the options appear in the full list, regardless of selection order.
         * This is because otherwise we would need to store selection order to ensure we could re-create layout on page reload.
         */
        function updateFiltersInUseLabel() {
            var componentsInUse = {};
            $panelComponents.each(function (idx, component) {
                var $component = $(component),
                    filterId   = $component.data('component'),
                    $available = $component.find('input[type=checkbox]'),
                    $selected  = $component.find('input:checked[type=checkbox]');

                // Are a subset of available options selected ?
                if($selected.length !== 0 && $selected.length !== $available.length){
                    // Filter is being applied, add its name and selected option labels.
                    componentsInUse[filterId]           = {};
                    componentsInUse[filterId]['name']   = $component.find('[data-filter-name]').html();
                    componentsInUse[filterId]['labels'] = [];
                    $selected.each(function(idx, elem){
                        var label = $component.find('label[for='+$(elem).attr('id')+']').html();
                        componentsInUse[filterId]['labels'].push(label);
                    });
                }
            });

            // Are any filters being used?
            if(Object.keys(componentsInUse).length){
                $appliedFilters.html('');
                for (var filterId in componentsInUse) {
                    if (componentsInUse.hasOwnProperty(filterId)) {
                        $interactionContainer.removeClass('hide');
                        // Create a new brick
                        var $newTab = $tabAppliedFilter.clone();
                        // Set the filter id and name
                        $newTab.attr('data-applied-filter-tab', filterId).find('[data-filter-name]').html(componentsInUse[filterId]['name']);
                        // Get handle to selected option list and option
                        var $selectedOptionList = $newTab.find('[data-selected-list]'),
                            $selectedOption     = $newTab.find('[data-selected-item]').remove();
                        // Add selected options to list
                        var labels = componentsInUse[filterId]['labels'];
                        for(var i in labels){
                            if(!labels.hasOwnProperty(i)){
                                continue;
                            }
                            if(i >= MAX_VISIBLE_SELECTIONS){
                                break;
                            }
                            $selectedOptionList.append($selectedOption.clone().html(labels[i]));
                        }
                        // Configure 'more' count
                        var $moreCount = $newTab.find('[data-more-count]');
                        if(labels.length <= MAX_VISIBLE_SELECTIONS){
                            $moreCount.addClass('hide');
                        } else {
                            var moreCountText = '+ '+(labels.length - MAX_VISIBLE_SELECTIONS)+' more';
                            $moreCount.find('[data-count]').attr('title', moreCountText).html(moreCountText);
                        }
                        $appliedFilters.append($newTab);
                    }
                }
            } else {
                $interactionContainer.addClass('hide');
            }
        }

        /**
         * Updates the modal with all selected options for this filter
         *
         * @param {Number} filterId
         */
        function updateCountMoreModal(filterId)
        {
            var $component  = $panelComponents.filter('[data-component=' + filterId + ']'),
                decodedData = deserialize($optionCheckboxes.serialize())[filterId];

            $countMoreModalName.html($component.find('[data-filter-name]').html());

            $countMoreModalList.html('');
            for(var key in decodedData){
                if(decodedData.hasOwnProperty(key) && decodedData[key] === "1"){
                    var label = $component.find('label[for=filter_selection_' +filterId+ '_'+key+']').html();
                    $countMoreModalList.append($modalListItem.clone().html(label));
                }
            }
        }

        /**
         * Indicate a request is in progress
         */
        function showFilterLoader() {
            $filterLoaderIcon.prop('disabled', false);
            $filterLoaderIcon.css('display', 'inline-block');
        }

        /**
         * Indicated a request is not in progress
         */
        function hideFilterLoader() {
            $filterLoaderIcon.prop('disabled', true);
            $filterLoaderIcon.css('display', 'none');
        }

        /**
         * Hides the initially-rendered placeholder content
         */
        function hideContentPlaceholder() {
            $reportContent.find('[data-placeholder]').hide();
        }

        /**
         * Hides the initially-rendered placeholder content
         */
        function showContentPlaceholder() {
            $reportContent.find('[data-placeholder]').show();
        }

        /**
         * Returns whether filter content has been loaded
         */
        function isContentLoaded() {
            return $reportContent.is('[data-loaded=0]');
        }

        /**
         * Populates the 'in-use' filter label and fetches the report
         */
        function init() {
            cacheErrorAlerts();
            cacheDomElements();
            updateFiltersInUseLabel();
            fetchReport();
        }

        init();
    });

</script>
{% endautoescape %}

{# Rip outta DOM on load, and remove 'hide' #}
<div data-applied-filter-tab="{FILTER ID}" class="hide applied-filter-tab">
    <span class="label filter">
        <span data-filter-name>{FILTER NAME}</span>
        <a href="#" data-close class="close" title="Remove filter">×</a>
    </span>
    <ul data-selected-list class="selected-list">
        <li data-selected-item class="selected-item">{ filter option }</li>
    </ul>
    <div data-more-count>
        <p class="more-count"><a data-count data-reveal-id="filter-options" title="+ { count } more">+ { count } more</a></p>
    </div>
</div>

{# Modal contents #}
<div id="filter-options" class="reveal-modal" data-reveal>
    <h2>Selected filters in <i><b data-filter-name>{ filter name }</b></i></h2>
    <ul data-selected-list class="selected-list">
        <li data-selected-option>{ filter option }</li>
    </ul>
    <a class="close-reveal-modal" aria-label="Close">×</a>
</div>

<div class="toast" data-alert data-relation="submit-label"></div>

<div class="row">
    <div class="small-12 island" id="filter_panel">
        <section>
            <div class="filter-interaction content" data-interaction-container>
                <div id="panel-summary">
                    <div class="small-12 columns">
                        <label><span id="filter-loader" class="loader" title="Loading..."></span>Filter(s) selected:</label>
                    </div>
                    <div id="applied_filters" data-applied-filters>
                    </div>
                </div>
            </div>
            <div class="small-12 column no-pad">

                {# HIDABLE CONTENT #}
                <ul class="filter-dropdown flex-list flex-wrap">
                    {% set countComponents = 0 %}
                    {% for component in panel.components %}
                        {% set template = component.template %}
                        {% set data     = component.toContext() %}
                        {% if data.isUserConfigurable %}
                            {% set countComponents = countComponents + 1 %}
                        {% endif %}
                        {% include component.template with data only %}
                    {% endfor %}

                    {% if not countComponents %}
                        <div class="empty-state">
                            <i class="icon-info"></i>
                            <p>No filters are user-configurable on this page.</p>
                        </div>
                    {% endif %}
                    <li class="filter-component btn">
                        {#<a class="button" id="clear-all" title="Revert to your most recently applied filter">Clear all</a>#}
                        <a class="button" id="defaults_reset" title="Reset to default selections">Reset to defaults</a>
                    </li>
                    <li class="filter-component btn">
                        <input id="submit_button"
                               type="submit"
                               data-value="Apply filters"
                               value="Apply filters"
                               data-href="{{ panel.route }}" data-working="Submitting...">
                    </li>
                </ul>
            </div>
        </section>

        {# Will contain error message HTML, as defined in template below #}
        <div id="server_error_feedback" style="display: none;" >
            <div data-reason="out-of-memory" data-alert="" class="alert-box alert">
                The server has run out of memory while attempting to build the requested report.<br><br>
                This is usually due to filters being too liberal, which generates too much data to process.
                Please try setting your filters to be more restrictive to return a smaller data set.
                <a href="" class="close">×</a>
            </div>
            <div data-reason="timeout" data-alert="" class="alert-box alert">
                Maximum server execution time exceeded.<br><br>
                This is usually due to filters being too liberal, which generates too much data to process.
                Please try setting your filters to be more restrictive to return a smaller data set.
                <a href="" class="close">×</a>
            </div>

            <div data-reason="uncaught-exception" data-alert="" class="alert-box alert">
                An exception was thrown during report generation. Please report this to Schoolbox support.<br>
                <pre><br>
                    {#- dessicate -#}Code:    <span data-code></span><br>
                    {#- dessicate -#}Message: <span data-message></span><br>
                    {#- dessicate -#}File:    <span data-file></span><br>
                    {#- dessicate -#}Line:    <span data-line></span>
                </pre>
                <a href="" class="close">×</a>
            </div>

            <div data-reason="unknown" data-alert="" class="alert-box alert">
                The server failed to generate the report. Please try setting your filters to be more restrictive to generate a smaller data set.
                If the issue continues, please report this to Schoolbox support.
                <a href="" class="close">×</a>
            </div>
        </div>
    </div>
</div>


