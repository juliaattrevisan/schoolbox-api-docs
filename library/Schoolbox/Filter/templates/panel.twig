{#
A panel that displays various filters.

Usage:
    contentId string      - the ID of the HTML element where we will replace with AJAX content
    panel     Filterpanel

    ? TODO convert to JS plugin that is executed against the panel element (so it can get with $this), and takes contentPanelId as single arg
#}

{% set filterPanelId = 'filter_panel' %}
{% set submitButtonId = 'submit_button' %}


<script type="text/javascript">

    $(function() {

        $('[data-collapser]').collapsable();


        var $contentPanel = $('#{{ contentId }}');
        var $filterPanel = $('#{{ filterPanelId }}');
        var $panelComponents = $filterPanel.find('[data-component]');
        var $filtersInUseLabel = $filterPanel.find('[data-filters-in-use]');
        var $submitButton = $('#{{ submitButtonId }}');
        var $optionCheckboxes = $filterPanel.find('input[type=checkbox], input[type=hidden]');


        $submitButton.on('click', function(event){
            event.preventDefault();
            var href = $submitButton.data('href');
            var data = $optionCheckboxes.serialize();
            $submitButton.val($submitButton.data('working'));

            disableInputs();

            // TODO display a toast
            $.post(href, data)
            .done(function(html){
                $contentPanel.html(html);
            })
            .fail(function(data){
                console.log(data)
            })
            .always(function() {
                $submitButton.val('Submit');
                enableInputs();
            });
        });

        $optionCheckboxes.on('change', function(){
            console.log('checkbox changed');
            updateFiltersInUseLabel();
        });


        function enableInputs(){
            $submitButton.attr('disabled', false);
            $optionCheckboxes.attr('disabled', false);
        }

        function disableInputs(){
            $submitButton.attr('disabled', true);
            $optionCheckboxes.attr('disabled', true);
        }

        /**
         * Update the
         * @todo rename
         */
        function updateFiltersInUseLabel(){
            console.log('updateFiltersInUse');
            var $componentsInUse = [];
            $panelComponents.each(function (idx, component) {
                console.log();
                $.each($(component).find('input[type=checkbox]'), function(idx, checkbox){

                    if($(checkbox).prop('checked')){
                        $componentsInUse.push($(component).find('[data-filter-name]').html());
                        return true;
                    }
                });
            });
            console.log($componentsInUse.join(', '));
            $filtersInUseLabel.html($componentsInUse.length ? $componentsInUse.join(', ') : 'None');
        }

        function init() {
            console.log('init');
            updateFiltersInUseLabel();
            $submitButton.trigger('click');

        }

        init();
    });

</script>

<style>
    .flex-container{
        display: flex;
        flex-direction: row;
    }
</style>


<fieldset id="{{ filterPanelId }}">
    <legend data-collapser="panel-components" class="icon-down-arrow">Filters in use: <span data-filters-in-use></span></legend>

    <div data-collapsable="panel-components" data-collapse-state="collapsed" style="display: none;">
        <div>
            <div class="flex-container" style="margin: 0 -20px;">
                {% for component in panel.components %}
                <div class="checklist" data-component style="margin: 0 20px;">
                    {% include component.template with component.toContext() %}
                </div>
                {% endfor %}
            </div>
        </div>
        <input id="{{ submitButtonId }}" type="submit" value="Submit" href="{{ panel.route }}" data-working="Submitting ...">
    </div>
</fieldset>


<hr>





