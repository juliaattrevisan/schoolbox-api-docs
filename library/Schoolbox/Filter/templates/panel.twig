{#
A panel that displays various filters.

Usage:
    contentId string      - the ID of the HTML element where we will replace with AJAX content
    panel     Filterpanel

    ? TODO convert to JS plugin that is executed against the panel element (so it can get with $this), and takes contentPanelId as single arg
#}

{% set filterPanelId = 'filter_panel' %}
{% set submitButtonId = 'submit_button' %}


<script type="text/javascript">




    $(function() {
        {#TODO - move this to plugin called 'multi-checkbox-select' or similar#}
        // Track the most recently changed checkbox per component
        var mostRecentChangePerComponent = [];

        $(document).on('click', '[data-component] label', function (e) {

            var $component           = $(this).closest('[data-component]');
            var $componentId         = $component.data('component');
            var $componentLabels     = $component.find('label');
            var $componentCheckboxes = $component.find('input[type=checkbox]');
            var labelIndex           = $componentLabels.index(this);

            // Is this not the first checkbox changed for this component ?
            var mostRecentChangedIndex = mostRecentChangePerComponent[$componentId];

            // Was this a shiftClick on a different checkbox ?
            if(e.shiftKey && typeof mostRecentChangedIndex === 'number' && mostRecentChangedIndex !== labelIndex){

                // Change all intervening checkboxes to the new value
                var changedCheckbox  = $componentCheckboxes.get(labelIndex);
                var newState         = !$(changedCheckbox).prop('checked');
                var increment = labelIndex > mostRecentChangedIndex ? +1 : -1;
                for(var i = mostRecentChangedIndex; i !== labelIndex; i += increment){
                    var checkbox = $componentCheckboxes.get(i);
                    $(checkbox).prop('checked', newState);
                }
                clearSelection();
            }
            mostRecentChangePerComponent[$componentId] = labelIndex;

        });

        /**
         * Clears any text selection that occurred when shift+clicking a selection of text-boxes
         */
        function clearSelection() {
            if ( document.selection ) {
                document.selection.empty();
            } else if ( window.getSelection ) {
                window.getSelection().removeAllRanges();
            }
        }
    });


    $(function() {

        // ============== Plugins

        $('[data-collapser]').collapsable();

        // ============== Vars

        var $reportContent       = $('#{{ contentId }}');
        var $filterPanel         = $('#{{ filterPanelId }}');
        var $panelComponents     = $filterPanel.find('[data-component]');
        var $appliedFilters      = $filterPanel.find('[data-applied-filters]');
        var $submitButton        = $('#{{ submitButtonId }}');
        var $optionCheckboxes    = $filterPanel.find('input[type=checkbox], input[type=hidden]');
        var $toast               = $('[data-relation="submit-label"]');
        var $serverErrorFeedback = $filterPanel.find('#server_error_feedback');
        var $filterLoaderIcon    = $filterPanel.find('#filter-loader');

        //  Error messages to display for different server errors
        var $alertOutOfMemory  = null;
        var $alertFatalError   = null;
        var $alertErrorUnknown = null;

        // A tab to insert in filter summary - illustrating what filters are being used
        var $tabAppliedFilter  = null;

        // ============== Event Handlers

        // Listen for clicks on the submit button
        $submitButton.on('click', function(event){
            event.preventDefault();
            fetchReport();
            return false; // don't bubble
        });

        // Listen for user checking filter options
        $optionCheckboxes.on('change', function(){
            updateFiltersInUseLabel();
        });

        // Listen for user removing an applied filter
        $appliedFilters.on('click', '[data-close]', function(event){
            var $filterTab = $(this).closest('[data-applied-filter-tab]');
            clearFilter($filterTab.find('[data-filter]').data('filter'));
            $filterTab.remove();
            return false; // don't bubble
        });

        // ============== Helpers

        /**
         * Remove filter ta
         * Clears checkboxes for the specified filter
         * @param {int} filterId
         */
        function clearFilter(filterId) {
            $panelComponents.filter('[data-component='+filterId+']').find('input[type=checkbox]').prop('checked', false);
            updateFiltersInUseLabel();
        }

        /**
         * Requests a filtered report via AJAX
         */
        function fetchReport() {
            $toast.toastActivate({text: 'Requesting report...'});
            showFilterLoader();
            var href = $submitButton.data('href');
            var data = $optionCheckboxes.serialize();
            $submitButton.val($submitButton.data('working'));

            disableInputs();

            $.post(href, data)
                .success(function(html){

                    // Does the first 400 chars indicate a fatal error? But returned 200 for some reason? why does this happen sometimes??
                    var fatalErrorStringIndex = html.indexOf('Fatal error:');
                    if( -1 !== fatalErrorStringIndex && fatalErrorStringIndex < 400 ){
                        processServerError();
                        return;
                    }

                    $serverErrorFeedback.hide();
                    hidePanel();
                    $reportContent.html(html);
                    $toast.toastTimeout({text: 'Success!', css: 'success'});
                })
                .fail(function(response){
                    processServerError(response.responseText);
                })
                .always(function() {
                    $submitButton.val('Submit');
                    hideFilterLoader();
                    enableInputs();
                });
        }

        /**
         * Try to figure out why the server failed to return a report
         */
        function processServerError(responseText)
        {
            if('string' !== typeof responseText) {
                displayAlert($alertErrorUnknown);
                return;
            }

            // Was this an OOM error ?
            var oomErrorIndex = responseText.indexOf('Fatal error: Allowed memory size of');
            if(-1 !== oomErrorIndex && oomErrorIndex < 400) {
                displayAlert($alertOutOfMemory);
                return;
            }

            // Was an uncaught exception thrown ?
            var uncaughtExceptionIndex = responseText.indexOf('Error Encountered');
            if(-1 !== uncaughtExceptionIndex && uncaughtExceptionIndex < 400) {
                displayAlert($alertFatalError);
                return;
            }
            displayAlert($alertErrorUnknown);
        }



        /**
         * Disable panel inputs
         */
        function enableInputs(){
            $submitButton.attr('disabled', false);
            $optionCheckboxes.attr('disabled', false);
        }

        /**
         * Disable panel inputs
         */
        function disableInputs(){
            $submitButton.attr('disabled', true);
            $optionCheckboxes.attr('disabled', true);
        }

        /**
         * Hide the filter panel components
         */
        function hidePanel() {
            if('uncollapsed' === $filterPanel.find('[data-collapsable]').attr('data-collapse-state')){
                $filterPanel.find('[data-collapser]').trigger('click');
            }
        }

        /**
         * Fetch the HTML we will render by JS into an alert. Then remove the template from the DOM.
         */
        function cacheErrorAlerts(){
            // Cache error messages
            $alertOutOfMemory  = $serverErrorFeedback.find('[data-reason="out-of-memory"]');
            $alertFatalError   = $serverErrorFeedback.find('[data-reason="uncaught-exception"]');
            $alertErrorUnknown = $serverErrorFeedback.find('[data-reason=unknown]');

            // Remove from DOM
            $serverErrorFeedback.find('[data-reason]').detach();
        }

        /**
         * Grab the applied filter template so we can insert as required
         */
        function cacheAppliedFilterTab() {
            $tabAppliedFilter = $('[data-applied-filter-tab]').remove().removeClass('hide');
        }

        /**
         * Show an alert in the server feedback panel
         */
        function displayAlert($alert){
            $toast.toastTimeout({text: 'Failure!', css: 'alert'});
            $alert.removeClass('alert-close');
            $serverErrorFeedback.append($alert);
            $serverErrorFeedback.show();
        }

        /**
         * Update the 'in-use' filter label according to current filter option selections
         *
         * A filter is not selected if either:
         * * all options are selected, or
         * * no options are selected.
         */
        function updateFiltersInUseLabel()
        {
            var componentsInUse = {};
            $panelComponents.each(function (idx, component) {
                var $component = $(component);
                var filterId   = $component.data('component');
                var countAvailable = $component.find('input[type=checkbox]').length;
                var countSelected = $component.find('input:checked[type=checkbox]').length;

                // Are a subset of available options selected ?
                if(countSelected !== 0 && countSelected !== countAvailable){
                    // Filter is being applied
                    componentsInUse[filterId] = $component.find('[data-filter-name]').html();
                }
            });

            // Are any filters being used?
            if(Object.keys(componentsInUse).length){
                $appliedFilters.html('');
                for (var property in componentsInUse) {
                    if (componentsInUse.hasOwnProperty(property)) {
                        var $newTab = $tabAppliedFilter.clone();
                        $newTab.find('[data-filter]').attr('data-filter', property).html(componentsInUse[property]);
                        $appliedFilters.append($newTab);
                    }
                }
            } else {
                $appliedFilters.html('None');
            }

        }

        /**
         * Indicate a request is in progress
         */
        function showFilterLoader(){
            $filterLoaderIcon.prop('disabled', false);
            $filterLoaderIcon.css('opacity', 1);
        }

        /**
         * Indicated a request is not in progress
         */
        function hideFilterLoader(){
            $filterLoaderIcon.prop('disabled', true);
            $filterLoaderIcon.css('opacity', 0);
        }

        /**
         * Populates the 'in-use' filter label and fetches the report
         */
        function init() {
            cacheErrorAlerts();
            cacheAppliedFilterTab();
            updateFiltersInUseLabel();
            fetchReport();
        }

        init();
    });

</script>

{# Rip outta DOM on load, and remove 'hide' #}
<span data-applied-filter-tab class="label highlight hide"><span data-filter></span> <a href="#" data-close class="close" title="Remove filter" style="font-size: 24px;line-height: 14px; vertical-align: text-bottom;" >×</a></span>

<style>
    .flex-container{
        display: flex;
        flex-direction: row;
    }

    #filter_panel .label{
        cursor: default;
    }

    #filter_panel .label .close:hover{
        color: red;
    }
</style>

<div class="toast" data-alert data-relation="submit-label"></div>

<div id="{{ filterPanelId }}">
    <div data-collapser="panel-components" class="icon-up-arrow">
        <span id="filter-loader" class="loader" title="request sent ..." style="position: relative; top: 3px;"></span>Applied filters: <span data-applied-filters></span>

        {# This needs to be outside the collapsable panel so we can hit it after removing filters from summary div #}
        <input id="{{ submitButtonId }}" type="submit" value="Submit" href="{{ panel.route }}" data-working="Submitting ..." style="width: auto; min-width: 120px; float:right;">
    </div>

    <div data-collapsable="panel-components" data-collapse-state="uncollapsed">
        <div>
            <div class="flex-container" style="margin: 0 -20px;">
                {% set countComponents = 0 %}
                {% for component in panel.components %}
                    {% set template = component.template %}
                    {% set data = component.toContext() %}
                    {% if data.isAvailable %}
                        {% set countComponents = countComponents + 1 %}
                        {% include component.template with component.toContext() %}
                    {% endif %}
                {% endfor %}

                {% if not countComponents %}
                    <div class="empty-state" style="flex-grow: 1; margin: 0 20px;">
                        <i class="icon-info"></i>
                        <p>No filters are configured for this page.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Will contain error message HTML, as defined in template below #}
    <div id="server_error_feedback" style="display: none;" >
        <div data-reason="out-of-memory" data-alert="" class="alert-box alert">
            The server has run out of memory while attempting to build the requested report.<br>
            This is usually due to filters being too liberal, which generates too much data to process.<br>
            Please try setting your filters to be more restrictive to return a smaller data set.
            <a href="" class="close">×</a>
        </div>

        <div data-reason="uncaught-exception" data-alert="" class="alert-box alert">
            An exception was thrown during report generation. Please report this to Schoolbox support.
            <a href="" class="close">×</a>
        </div>

        <div data-reason="unknown" data-alert="" class="alert-box alert">
            The server failed to generate the report. Please try setting your filters to be more restrictive to generate a smaller data set.
            If the issue continues, please report this to Schoolbox support.
            <a href="" class="close">×</a>
        </div>
    </div>
</div>


<hr>






