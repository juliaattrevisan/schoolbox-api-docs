{#
    Displays the filters available for a filterable page.

    Enables the admin to

    Usage:
        page                     string
        definitions              IDefinition[]         Indexed by definition.class
        pageFilters              Filter\Page\Model[]   Indexed by definition.class
        PAGE_GRADES              string
        PAGE_MARK_BOOK           string
        PAGE_PENDING_ASSESSMENTS string
        ENTITY_ASSESSMENTS       string

#}
{% import 'sub/breadcrumbs.twig' as bread %}

{% if PAGE_GRADES == page %}
    {% set pageName = 'Grades' %}
{% elseif PAGE_MARK_BOOK == page %}
    {% set pageName = 'Markbook' %}
{% elseif PAGE_PENDING_ASSESSMENTS == page %}
    {% set pageName = 'Pending ' ~ locale.assessment.proper %}
{% else %}
    {# Graceful fallback if constant not injected into twig #}
    {% set pageName = page %}
{% endif %}

{% set entity = (definitions | first).filter.entity %}
{%- if ENTITY_ASSESSMENTS == entity -%}
    {%- set entityName = locale.assessment -%}
    {%- set entityIcon = 'due-work' -%}
{%- else -%}
    {# Graceful degradation to generic filter icon if constant not injected into twig #}
    {%- set entityName = 'Entity' -%}
    {%- set entityIcon = 'filter' -%}
{%- endif -%}

{{ bread.crumbs(
    [ 'Home', routeLookup('adminHome.getIndex') ],
    [ 'Filters', routeLookup('filters.getIndex') ],
    [ pageName ]
) }}


<script type="text/javascript">
    $(function() {

        var $optionAvailable        = $('[data-option-available]');
        var $roleDefaultAvailable   = $('[data-role-type-available]');
        var $roleDefaultUnavailable = $('[data-role-type-unavailable]');
        var $saveButton             = $('#save_settings');
        var $toast                  = $('[data-toast]');

        // User toggles 'Enabled' checkbox
        $('[data-filter-enable]').on('change', function(){
            var $checkbox = $(this);
            var $section  = $checkbox.closest('[data-filter]');

            var $panel            = $section.find('[data-filter-settings]');
            var $configurableWrap = $section.find('[data-filter-user-configurable-wrap]');

            if($checkbox.prop('checked')){
                $panel.slideDown();
                $configurableWrap.show();
            } else {
                $panel.slideUp();
                $configurableWrap.hide();
            }
            hideNoConfigurableOptionsMsg($section.data('filter'));
        });

        /**
         * Hide the 'No Configurable Options message' for the specified filter
         * @param {number} filterId
         */
        function hideNoConfigurableOptionsMsg(filterId)
        {
            // Remove any validation warnings about invalid state
            $('#filter_user_configurable\\['+filterId+'\\]-error').remove();
        }


        // User toggles a 'User-configurable' checkbox
        $('[data-filter-user-configurable]').on('change', function(){
            var $checkbox = $(this);
            var $section  = $checkbox.closest('[data-filter]');

            var $legendHardCoded    = $section.find('[data-hard-coded]');
            var $legendConfigurable = $section.find('[data-configurable]');
            var $availableColumns   = $section.find('[data-available-col]');

            if($checkbox.prop('checked')){
                $legendHardCoded.hide();
                $legendConfigurable.show();
                $availableColumns.show();
                $section.find('[data-option-available]').trigger('change');
            } else {
                $legendHardCoded.show();
                $legendConfigurable.hide();
                $availableColumns.hide();
                $roleDefaultAvailable.show();
                $roleDefaultUnavailable.hide();
            }
        });

        // User toggles an 'Available' checkbox
        $optionAvailable.on('change', function(){
            var $checkbox        = $(this);
            var $row             = $checkbox.closest('[data-options-row]');
            var $availableWrap   = $row.find('[data-role-type-available]');
            var $unavailableWrap = $row.find('[data-role-type-unavailable]');

            if($checkbox.prop('checked')){
                $availableWrap.show();
                $unavailableWrap.hide();
            } else {
                $availableWrap.hide();
                $unavailableWrap.show();
            }

            // Remove any validation warnings about invalid state
            var filterId = $checkbox.closest('[data-filter]').data('filter');
            hideNoConfigurableOptionsMsg(filterId);
        });


        $.validator.addMethod(
            "hasAvailableOptions",
            function(value, element) {
                // Not user configurable?
                if(undefined === value){
                    // Always valid
                    return true;
                }
                var $elem    = $(element);
                var $section = $elem.closest('[data-filter]');
                var countAvailable = $section.find(':checked[data-option-available]').length;

                // No available options selected?
                if(!countAvailable){
                    $elem.focus();
                    return false;
                }
                return true;
            },
            "You've configured this filter to be user-configurable, but no options are available for users to configure."
        );

        $('form[data-filter-settings]').alaressValidate({
            rules: {
                {% for definition in definitions %}
                    'filter_user_configurable[{{ definition.filter.id }}]': 'hasAvailableOptions'{% if not loop.last %},{% endif %}
                {% endfor %}
            },
            errorPlacement: function($error, $elem) {
                if($elem.is('[data-filter-user-configurable]')){
                    $elem.closest('[data-filter-user-configurable-wrap]').after($error);
                } else {
                    $.alaressValidate.defaultErrorPlacement($error, $elem);
                }
            },
            submitHandler: function(form) {
                $saveButton.attr('disabled', true);

                var data = $(form).find('input').serialize();
                var href = $saveButton.data('href');

                $toast.toastActivate({text: 'Saving settings...'});

                // Hack to fix current bug in plugin which shows previous return state when initiating repeated action
                var duration = 2000;

                $.post(href, data)
                    .success(function () {
                        $toast.toastTimeout({text: 'Settings saved.', css: 'success', duration: duration});
                    })
                    .error(function(){
                        $toast.toastTimeout({text: 'Unable to save.', css: 'alert', duration: duration});
                    })
                    .always(function() {
                        $saveButton.attr('disabled', false);
                        setTimeout(function(){
                            $toast.removeClass('success alert');
                        }, duration);
                    });
            }
        });
    });
</script>

<style>
    .column-options-label,
    .column-available,
    .column-role-type{
        width: 120px;
    }
</style>

<div class="row">
    <div class="small-12">
        <h1>{{ pageName }}</h1>

        <ul class="meta">
            <li class="icon-{{ entityIcon }}">Filtered entity: {{ entityName }}</li>
        </ul>
    </div>
</div>

<div class="row">
    <form data-filter-settings>
        {% for class, pageFilter in pageFilters %}
            <div class="small-12 island">
                {% set definition = definitions[class] %}
                {% set options    = pageFilter.options %}
                <section data-filter="{{ definition.filter.id }}">
                    {# Header #}
                    <fieldset class="content">
                        <div class="small-4 columns">
                            <h2>{{ definition.name }}</h2>
                        </div>
                        <div class="small-4 columns">
                            <input
                                    id="checkbox_enabled_{{ definition.filter.id }}"
                                    type="checkbox"
                                    name="filter_enabled[{{ definition.filter.id }}]"
                                    {% if pageFilter.enabled %}checked{% endif %}
                                    data-filter-enable
                            >
                            <label for="checkbox_enabled_{{ definition.filter.id }}" class="checkbox-label">Enabled</label>
                        </div>
                        <div class="small-4 columns">
                            <span data-filter-user-configurable-wrap {% if not pageFilter.enabled %} style="display:none;"{% endif %}>
                                <input
                                        id="checkbox_user_configurable_{{ definition.filter.id }}"
                                        type="checkbox"
                                        name="filter_user_configurable[{{ definition.filter.id }}]"
                                        {% if pageFilter.userConfigurable %}checked{% endif %}
                                        data-filter-user-configurable
                                >
                                <label for="checkbox_user_configurable_{{ definition.filter.id }}" class="checkbox-label">User-configurable</label>
                            </span>
                        </div>
                    </fieldset>
                    <fieldset data-filter-settings class="content"{% if not pageFilter.enabled %} style="display:none;"{% endif %}>
                        <legend>
                            <span data-hard-coded{% if pageFilter.userConfigurable %} style="display: none;"{% endif %}>
                                <strong>Hard-Coded Selections</strong>: Users' reports will be filtered to these settings. Users will be unable to view or alter these selections.
                            </span>
                            <span data-configurable{% if not pageFilter.userConfigurable %} style="display: none;"{% endif %}>
                                <strong>Default Selections</strong>: Select which options should be available to the user, and whether they are selected by default.
                            </span>
                        </legend>



                        <table>
                            <colgroup>
                                <col class="column-options-label">
                                <col class="column-options">
                                <col class="column-available">
                                <col class="column-role-type" span="4">
                            </colgroup>
                            <tr>
                                <th colspan="3"></th>
                                <th colspan="{{ roleTypes | length }}">Role Types</th>
                            </tr>
                            <tr>
                                <th colspan="2"></th>
                                <th><span data-available-col{% if not pageFilter.userConfigurable %} style="display:none;"{% endif %}>Available</span></th>
                                {% for roleType in roleTypes %}
                                    <th>{{ roleType | capitalize }}</th>
                                {% endfor %}
                            </tr>
                            {% for option in options %}
                                <tr data-options-row>
                                    <th>{% if loop.first %}Options:{% endif %}</th>
                                    <th>{{ definition.label(option.key) | capitalize }}</th>
                                    <td>
                                        <span data-available-col {% if not pageFilter.userConfigurable %} style="display:none;"{% endif %}>
                                            <input
                                                    id="checkbox_{{ definition.filter.id }}_{{ option.key }}"
                                                    type="checkbox"
                                                    name="filter_options[{{ definition.filter.id }}][{{ option.key }}]"
                                                    {% if option.available %}checked{% endif %}
                                                    data-option-available
                                                    data-filter-id="{{ definition.filter.id }}"
                                                    data-option-key="{{ option.key }}"
                                            >
                                            <label for="checkbox_{{ definition.filter.id }}_{{ option.key }}" class="checkbox-label"></label>
                                        </span>
                                    </td>
                                    {% for roleType in roleTypes %}
                                        <td>
                                            {% set default = option.defaults[roleType] %}
                                            {% if not default %}
                                                <span title="This role type does not have access to this page">NA</span>
                                            {% else %}
                                                <span data-role-type-available {% if not option.available and pageFilter.userConfigurable %}style="display: none;"{% endif %}>
                                                    <input
                                                            id="checkbox_{{ definition.filter.id }}_{{ option.key }}_{{ roleType }}"
                                                            type="checkbox"
                                                            name="filter_defaults[{{ definition.filter.id }}][{{ option.key }}][{{ roleType }}]"
                                                            {% if default.selected %}checked{% endif %}
                                                            data-option-default
                                                            data-filter-id="{{ definition.filter.id }}"
                                                            data-option-key="{{ option.key }}"
                                                            data-role-type="{{ roleType }}"
                                                    >
                                                    <label for="checkbox_{{ definition.filter.id }}_{{ option.key }}_{{ roleType }}" class="checkbox-label"></label>
                                                </span>
                                                <span data-role-type-unavailable {% if option.available or not pageFilter.userConfigurable %}style="display: none;"{% endif %}>
                                                    <span title="Option not available on this page">-</span>
                                                </span>
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </table>
                    </fieldset>
                </section>
            </div>
        {% endfor %}

        <div class="small-12 island">
            <input type="submit" id="save_settings" value="Save Settings" data-href="{{ routeLookup('filters.postSavePageSettings', { page: page }) }}">
            <div class="toast" data-toast></div>
        </div>
    </form>
</div>



