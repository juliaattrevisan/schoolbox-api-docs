{#
    The most basic filter sub-panel template, renders a flat list of checkboxes
    Usage:
        component:  IFilterComponent
        selections: FilterSelection[] - A set of filter selections made by the current user.
#}
{% block title %}{% endblock %}
<fieldset class="checklist">
    {% for selection in selections %}
        <input type="hidden" name="filter_selection[{{ selection.filter.id }}][{{ selection.key }}]" value="0">
        <input
            id="filter_selection_{{ selection.filter.id }}_{{ selection.key }}"
            type="checkbox"
            name="filter_selection[{{ selection.filter.id }}][{{ selection.key }}]"
            value="1"
            {% if selection.selected %}checked{% endif %}
        >
        <label for="filter_selection_{{ selection.filter.id }}_{{ selection.key }}">{{ definition.label(selection.key) }}</label>
    {% endfor %}
</fieldset>
