{#
    Usage:
        definition:     IFilterDefinition
        roleSelections: FilterSelection[] - Default filter selections for current user's role, indexed by selection.key
        userSelections: FilterSelection[] - A set of filter selections made by the current user, indexed by selection.key
        folders:        Folder\Model[]

#}
{% extends '@filterDefinitions/Assessment/Folder/templates/component.twig' %}

{% block filterName %}Classes and Groups{% endblock %}

{# This component is never empty, for the purpose of selecting a folder #}
{% block filterComponent %}
    {% set isEmpty    = false %}
    {% set isDisabled = false %}
    {% set hasOptions = true %}
    {{ parent() }}
{% endblock filterComponent %}

{% block userOptions %}
    <script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
    <script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>

    {% autoescape 'js' %}
    <script type="text/javascript">
        $(function () {
            var $filterSelector = $('#filter-selector-readable');
            $filterSelector.selectizeSelector({
                value: $.selectizeSelector.getValueFromSelect($filterSelector),
                ajax: {
                    url:      '{{ routeLookup('folderSearch.getFolderSearch') }}',
                    type:     'GET',
                    data:     {
                        types: ['class', 'group', 'otherClass', 'otherGroup']
                    },
                    dataType: 'json'
                },
                multiple: true,
                selectize: {
                    optgroups: [
                        {value: 'class',       label: 'My Classes'},
                        {value: 'group',       label: 'My Groups'},
                        {value: 'otherClass',  label: 'Other Classes'},
                        {value: 'otherGroup',  label: 'Other Groups'},
                        {value: 'otherFolder', label: 'Other Folders'}
                    ],
                    lockOptgroupOrder: true,
                    render: {
                        option: function (option, escape) {
                            // Add breadcrumb if there is one
                            var breadcrumb = null;
                            if (option.breadcrumb && option.breadcrumb.length) {
                                breadcrumb = option.breadcrumb
                                    .map(function (v) { return v.name; })
                                    .join(' > ');
                            }
                            return '<div class="option">'
                                + escape(option.name)
                                + (breadcrumb ? ('<p><em>(' + escape(breadcrumb) + ')</em></p>') : '')
                                + '</div>';
                        }
                    }
                }
            });
        });
    </script>
    {% endautoescape %}

    <input type="hidden" name="filter_selection[{{ definition.filter.id }}]" value="" />
    <select id="filter-selector-readable"
            name="filter_selection[{{ definition.filter.id }}][]"
            multiple
            placeholder="Enter one or more folder names or class codes"
            data-selectize
    >
        {# For this filter, folders are just all the URL override folders #}
        {% for folder in folders %}
            <option value="{{ folder.id }}" label="{{ folder.nameWithCodes }}" selected>{{ folder.nameWithCodes }}</option>
        {% endfor %}
    </select>
{% endblock %}
