{#
    Usage:
        isUserConfigurable: bool          - If false, just hidden input. If true, render a checkbox to clobber hidden value
        definition:     IFilterDefinition
        roleSelections: FilterSelection[] - Default filter selections for current user's role, indexed by selection.key
        userSelections: FilterSelection[] - A set of filter selections made by the current user, indexed by selection.key
        projects:       Project\Model[]   - Project data models, linked via assessment model to Folder or UnitImpl
        keyNone:        string            - The 'NONE' key
#}
{% extends '@filters/_component.twig' %}

{% block filterName %}{{ locale.project.proper }}{% endblock %}

{% block userOptions %}

    {% if roleSelections[keyNone] %}
        {% include '@filters/_selectionCheckbox.twig' with {
            roleSelection:      roleSelections[keyNone],
            userSelection:      userSelections[keyNone],
            label:              '(none)',
            disabled:           isDisabled
        } only %}
    {% endif %}

    {% for project in projects %}
        {% set selection = roleSelections[project.id] %}
        {% if project.assessmentModel.assessmentContext is unitImplementation %}
            {% set title = project.title ~ ' (' ~ project.folder.title ~ ')' %}
        {% else %}
            {% set title = project.title %}
        {% endif %}

        {% include '@filters/_selectionCheckbox.twig' with {
            roleSelection: selection,
            userSelection: userSelections[project.id],
            label:         title,
            disabled:      isDisabled
        } only %}
    {% endfor %}
{% endblock %}

