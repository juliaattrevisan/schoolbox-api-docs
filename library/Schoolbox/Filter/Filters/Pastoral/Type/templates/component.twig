{% extends '@filters/_component.twig' %}

{% block filterName %}Type{% endblock %}

{% block userOptions %}
    {% for type in types %}
        {% set selectionId = type.id %}

        {##
            Does this type have sub-types?
            If so: don't output the select checkbox, only output for sub-types
        #}

        {% if type.subtypes is empty %}
            {% include '@filters/_selectionCheckbox.twig' with {
                roleSelection:      roleSelections[selectionId] ?? null,
                userSelection:      userSelections[selectionId] ?? null,
                label:              type.name,
                disabled:           isDisabled,
            } only %}
        {% else %}
            {% for subtype in type.subtypes %}
                {% set selectionId = type.id ~ '_' ~ subtype.id %}
                {% include '@filters/_selectionCheckbox.twig' with {
                    roleSelection:      roleSelections[selectionId] ?? null,
                    userSelection:      userSelections[selectionId] ?? null,
                    label:              type.name ~ ' › ' ~ subtype.name,
                    disabled:           isDisabled,
                } only %}
            {% endfor %}

{#            #}{# Select all/none for subtypes #}
{#            <input id="filter_selection_{{ definition.filter.id }}_{{ type.id }}"#}
{#                   type="checkbox"#}
{#                   {% if isDisabled %}disabled data-disabled{% endif %}#}
{#            />#}
{#            <label for="filter_selection_{{ definition.filter.id }}_{{ type.id }}"#}
{#                   class="noselect"#}
{#            >{{ type.name }}</label>#}

{#            <div class="checklist">#}
{#                <ul class="option-list">#}
{#                    {% for subtype in type.subtypes %}#}
{#                        {% set selectionId = type.id ~ '_' ~ subtype.id %}#}
{#                        {% include '@filters/_selectionCheckbox.twig' with {#}
{#                            roleSelection:      roleSelections[selectionId] ?? null,#}
{#                            userSelection:      userSelections[selectionId] ?? null,#}
{#                            label:              type.name ~ ' › ' ~ subtype.name,#}
{#                            disabled:           isDisabled,#}
{#                        } only %}#}
{#                    {% endfor %}#}
{#                </ul>#}
{#            </div>#}
        {% endif %}
    {% endfor %}
{% endblock userOptions %}
