{% extends '@filters/_component.twig' %}

{% block filterName %}Curriculum Codes{% endblock %}

{% block filterComponent %}
    {% set isDisabled = false %}
    {{ parent() }}
{% endblock filterComponent %}

{% block userOptions %}
    <li>
    {% if isUserConfigurable %}
        <div data-cs-container>
            <curriculum-selector
                :is-read-only="false"
                :selected-codes="{{ (selectedNodes ?? []) | json_encode }}"
                data-endpoint="{{ routeLookup('curriculumApi.searchNode') }}"
                form-value-name="filter_selection[{{ definition.filter.id }}]"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/curriculumSelector.js?v={{ config.site_version }}"></script>
    {% else %}
        {# Empty input is required so that filter works if not user-configurable, or
        nothing is selected #}
        <input type="hidden" name="filter_selection[{{ definition.filter.id }}]" value="" />
        {{ parent() }}
    {% endif %}
    </li>
{% endblock userOptions %}
