{% extends '@filters/_component.twig' %}

{% block filterName %}Name{% endblock %}

{% block filterComponent %}
    {% set isDisabled = false %}
    {{ parent() }}
{% endblock filterComponent %}

{% block userOptions %}
    <li>
        {% if isUserConfigurable %}
            <sbx-search-select
                    id="studentSearch"
                    label="Search"
                    label-id="Search"
                    form-value-name="filter_selection[{{ definition.filter.id }}]"
                    endpoint="/ajax/user.php?roleTypeID=student&"
                    :selected-default="[]"
                    for-filter-panel
                    placeholder="Search for students...">
            </sbx-search-select>
        {% else %}
            {# Empty input is required so that filter works if not user-configurable, or
            nothing is selected #}
            <input type="hidden" name="filter_selection[{{ definition.filter.id }}]" value="" />
            {{ parent() }}
        {% endif %}
    </li>
{% endblock userOptions %}
