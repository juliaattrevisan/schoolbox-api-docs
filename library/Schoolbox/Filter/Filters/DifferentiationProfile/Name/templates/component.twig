{% extends '@filters/_component.twig' %}

{% block filterName %}Name{% endblock %}

{% block dropdownClass %} f-dropdown--wider{% endblock %}

{% block filterComponent %}
    {% set isDisabled = false %}
    {{ parent() }}
{% endblock filterComponent %}

{% block userOptions %}
    <li>
        {% if isUserConfigurable %}
            <sbx-search-select
                id="search-{{ definition.filter.id }}"
                class="l-width-100"
                label="Search"
                label-id="search-label-{{ definition.filter.id }}"
                form-value-name="filter_selection[{{ definition.filter.id }}]"
                endpoint="/ajax/user.php?roleTypeID=student&"
                for-filter-panel
                placeholder="Search for students...">
            </sbx-search-select>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const searchSelect = document.getElementById('search-{{ definition.filter.id }}');
                    // Pre-populating the search select with any existing user selection
                    searchSelect.selected = {{ userSelectionIds | json_encode | raw }};
                });
            </script>
        {% else %}
            {# Empty input is required so that filter works if not user-configurable, or
            nothing is selected #}
            <input type="hidden" name="filter_selection[{{ definition.filter.id }}]" value="" />
            {{ parent() }}
        {% endif %}
    </li>
{% endblock userOptions %}
