{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ 'Fixtures',    routeLookup('sportsfixtures.getLanding') ],
[ 'CSV Import',  routeLookup('sportsfixturesImport.getUpload') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>CSV Import</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">


        <section class="content">
            <article>
                <h2>Instructions</h2>
                <p>
                    Using the example templates below as a guide, download and populate each file with the required information
                    then attach the completed files at the bottom of the page and click on the 'Import' button to import the data.
                    You can upload one or many files at a time so if you fixture contains new venues you can also include the new venue import while uploading the fixture.
                </p>
            </article>
        </section>

        <section>
            <div class="content">
                <h2>CSV Templates</h2>
            </div>
            <ul class="grid small-block-grid-1 medium-block-grid-2">
                <li>
                    <div class="card small-12">
                        <a href="{{ CDN_PREFIX }}/fixtures/import/sports.csv">
                            <div class="u-flex-row u-flex--no-wrap u-flex--align-center u-gap-s">
                                <sbx-icon name="sport" size="l"></sbx-icon>
                                <div>
                                    <h3 class="f-no-margins">Sports Template</h3>
                                    <p class="meta">Sports played at your school</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </li>
                <li>
                    <div class="card small-12">
                        <a href="{{ CDN_PREFIX }}/fixtures/import/positions.csv">
                            <div class="u-flex-row u-flex--no-wrap u-flex--align-center u-gap-s">
                                <sbx-icon name="position" size="l"></sbx-icon>
                                <div>
                                    <h3 class="f-no-margins">Positions Template</h3>
                                    <p class="meta">Positions played in sport (optional)</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </li>
                <li>
                    <div class="card small-12">
                        <a href="{{ CDN_PREFIX }}/fixtures/import/seasons.csv">
                            <div class="u-flex-row u-flex--no-wrap u-flex--align-center u-gap-s">
                                <sbx-icon name="calendar" size="l"></sbx-icon>
                                <div>
                                    <h3 class="f-no-margins">Seasons Template</h3>
                                    <p class="meta">Seasons in which sports are played</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </li>
                <li>
                    <div class="card small-12">
                        <a href="{{ CDN_PREFIX }}/fixtures/import/teams.csv">
                            <div class="u-flex-row u-flex--no-wrap u-flex--align-center u-gap-s">
                                <sbx-icon name="team" size="l"></sbx-icon>
                                <div>
                                    <h3 class="f-no-margins">Teams Template</h3>
                                    <p class="meta">All the teams at your school for each sport</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </li>
                <li>
                    <div class="card small-12">
                        <a href="{{ CDN_PREFIX }}/fixtures/import/schools.csv">
                            <div class="u-flex-row u-flex--no-wrap u-flex--align-center u-gap-s">
                                <sbx-icon name="home" size="l"></sbx-icon>
                                <div>
                                    <h3 class="f-no-margins">Schools Template</h3>
                                    <p class="meta">Opposition schools that you play against</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </li>
                <li>
                    <div class="card small-12">
                        <a href="{{ CDN_PREFIX }}/fixtures/import/venues.csv">
                            <div class="u-flex-row u-flex--no-wrap u-flex--align-center u-gap-s">
                                <sbx-icon name="venue" size="l"></sbx-icon>
                                <div>
                                    <h3 class="f-no-margins">Venues Template</h3>
                                    <p class="meta">Locations of the venues you play games</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </li>
                <li>
                    <div class="card small-12">
                        <a href="{{ CDN_PREFIX }}/fixtures/import/coaches.csv">
                            <div class="u-flex-row u-flex--no-wrap u-flex--align-center u-gap-s">
                                <sbx-icon name="player" size="l"></sbx-icon>
                                <div>
                                    <h3 class="f-no-margins">Coaches Template</h3>
                                    <p class="meta">The coaches for each team</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </li>
                <li>
                    <div class="card small-12">
                        <a href="{{ CDN_PREFIX }}/fixtures/import/fixture.csv">
                            <div class="u-flex-row u-flex--no-wrap u-flex--align-center u-gap-s">
                                <sbx-icon name="match" size="l"></sbx-icon>
                                <div>
                                    <h3 class="f-no-margins">Fixture Template</h3>
                                    <p class="meta">The teams playing, location and time of each game</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </li>
            </ul>
        </section>

        <form method="post" enctype="multipart/form-data" action="{{ routeLookup('sportsfixturesImport.postUpload') }}">
            <h2 class="subheader">Attach Files</h2>
            {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
            <input type="submit" data-submit value="Import">
        </form>
    </div>
</div>
