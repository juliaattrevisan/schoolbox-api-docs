<div class="list-item">
    <input type="hidden" name="positions[sportId][]" value="{{ sport.id }}"/>
    <input type="hidden" name="positions[id][]" value="{{ position.id ?? '' }}"/>
    <div class="small-12 columns">
        <label>
            <input type="text" name="positions[name][]" value="{{ position.name ?? '' }}"  data-item-original-value="{{ position.name ?? '' }}" data-item-element />
        </label>
    </div>
</div>
{% if hideNav is not defined or not hideNav %}
<nav>
    <a href="{{ (position.id ?? null)
        ? routeLookup('sportsfixturesPosition.deleteEntity', { entityId: position.id })
        : '#'
        }}"
       title="Delete"
       data-delete="{{ position.id ?? '' }}"><sbx-icon name="delete"></sbx-icon></a>
</nav>
{% endif %}
