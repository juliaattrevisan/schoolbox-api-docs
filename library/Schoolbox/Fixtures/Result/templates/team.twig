{% extends '@sportsfixturesMatch/match.twig' %}
{% import '@sportsfixturesMatch/macro/heading.twig' as matchHeading %}
{% block breadcrumbs %}
    {% import 'sub/breadcrumbs.twig' as bread %}

    {% set headingCrumb = match.id ? routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: team.id}) : '' %}
    {% set actionCrumb  = match.id ? action ?? '' : '' %}

    {{ bread.crumbs(
        [ 'Fixtures',                   routeLookupIfAuthorized('sportsfixtures.getLanding') ],
        [ 'Sports',                     routeLookupIfAuthorized('sportsfixturesSport.getList') ],
        [ sport.name,                   routeLookupIfAuthorized('sportsfixturesSport.getEntity', { entityId: sport.id }) ],
        [ division.name,                routeLookupIfAuthorized('sportsfixturesDivision.getLobby', { entityId: division.id }) ],
        [ matchHeading.generate(match), headingCrumb ],
        [ actionCrumb ]
    ) }}

{% endblock %}

{% block results %}
    {% if match.result[team.id] %}
    <script type="text/javascript">
        $(function() {
            $('[data-delete]').on('click', function(event) {
                event.preventDefault();

                var element = $(this);

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this Result?',
                    confirmLabel: 'Delete',
                    confirmEvent: function() {
                        $.post(element.attr('href'), {}, function() {
                            window.location.reload();
                        });
                    }
                });
            });
        });
    </script>

    <h3 class="subheader">Results</h3>
    <section class="content">
        <div class="row">
            <div class="small-12 columns">
                <div class="actions-small-1 row">
                    <div class="list-item">
                        <div class="small-12 columns">
                            <h4>{{ team.name }}</h4>
                            {{ match.result[team.id].description|purify }}
                        </div>
                    </div>
                    <nav>
                        <a href="{{ routeLookup('sportsfixturesResult.deleteEntity', {entityId: match.result[team.id].id}) }}" class="sbx-icon-only-button" title="Delete" aria-label="Delete" data-delete="{{ match.result[team.id].id }}">
                            <sbx-icon name="delete"></sbx-icon>
                        </a>
                        <a href="{{ routeLookup('sportsfixturesResult.getModifyForm', {entityId: match.result[team.id].id}) }}" class="sbx-icon-only-button" title="Modify" aria-label="Modify">
                            <sbx-icon name="modify"></sbx-icon>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    </section>
    {% else %}
    <div class="empty-state">
        <i class="icon-result"></i>
        <p>There are no Results for {{ team.name }}.</p>

        <p><a href="{{ routeLookup('sportsfixturesResult.getCreateFormForTeam', {contextId: match.id, teamId: team.id}) }}" title="Add Results">Add Results for {{ team.name }}.</a></p>
    </div>
    {% endif %}
{% endblock %}
