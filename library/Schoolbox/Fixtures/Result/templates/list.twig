<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: division.id}) }}">Matches in {{ division.name }}</a></li>
    <li class="active"><span>{{ match.name }}</span></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">

        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Results for {{ match.name }}</h2>
                </div>
            </div>
            <nav>
                {% if not allResults|length %}
                <a href='{{ routeLookup('sportsfixturesResult.getCreateForm', {contextId: match.id}) }}' class="sbx-icon-only-button" title="Add Results to {{ match.name }}" aria-label="Add Results to {{ match.name }}">
                    <sbx-icon name="add"></sbx-icon>
                </a>
                {% endif %}
            </nav>
        </div>

        {% if allResults|length %}
            <section>
                <ul class="action-list">
                    {% for currentResult in allResults %}
                    <li class="actions-small-2">
                        <div class="list-item">
                            <div class="card small-12">
                                <p class="meta">{{ currentResult.team.name }}</p>

                                <article>
                                {{ currentResult.description|purify }}
                                </article>
                            </div>
                        </div>
                        <nav>
                            <a href="{{ routeLookup('sportsfixturesResult.getModifyForm', {entityId: currentResult.id}) }}" class="sbx-icon-only-button" title="Modify" aria-label="Modify">
                                <sbx-icon name="modify"></sbx-icon>
                            </a>
                        </nav>
                    </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <sbx-icon name="result" size="2.5rem"></sbx-icon>
                <p>There are no Results for {{ match.name }}.</p>
                <p><a href="{{ routeLookup('sportsfixturesResult.getCreateForm', {contextId: match.id}) }}" title="Add Results to {{ match.name }}">Add Results to {{ match.name }}</a></p>
            </div>
        {% endif %}
    </div>
</div>
