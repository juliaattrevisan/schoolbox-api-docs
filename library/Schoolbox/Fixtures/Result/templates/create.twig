{% import '@sportsfixturesMatch/macro/heading.twig' as matchHeading %}

<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>

<script type="text/javascript">
    $(function() {
        $('#resultForm').alaressValidate({
            rules: {
                matchId: {
                    required: true,
                    min: 1
                }
            },
            messages: {
                'matchId': 'Please choose a Match.'
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        });

        $('#resultForm').find('[data-description]').alaressEditor();
    });
</script>

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Fixtures</a></li>
    <li><a href="#">{{ sport.name }}</a></li>
    <li><a href="3">{{ division.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: team.id}) }}">{{ matchHeading.generate(match) }}</a></li>

    {% if result.id %}
        <li class="active"><a href="{{ routeLookup('sportsfixturesResult.getModifyForm', {entityId: result.id}) }}">Result for {{ team.name }}</a></li>
    {% else %}
        <li class="active"><a href="#">{{ action }} Result for {{ team.name }}</a></li>
    {% endif %}
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>{{ action }} Result for {{ team.name }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if result.id %}
            {% set formUrl = routeLookup('sportsfixturesResult.updateEntity', {entityId: result.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesResult.createResultForTeam', {matchId: match.id, teamId: team.id}) %}
        {% endif %}

        <form id='resultForm' action="{{ formUrl }}" method="post">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="hidden" name="matchId" value="{{ match.id }}"/>
                        <input type="hidden" name="teamId" value="{{ team.id }}"/>
                        <input type="hidden" name="resultId" value="{{ result.id }}"/>

                        <label>
                            Match Status
                            <select name="statusId">
                                <option value="">-- no status yet --</option>
                                {% for status in statuses %}
                                    <option {% if result.status.id == status.id %}selected{% endif %}
                                            value="{{ status.id }}"
                                            label="{{ status.name }}">{{ status.name }}</option>
                                {% endfor %}
                            </select>
                        </label>

                        <label>
                            Description
                        </label>

                        <textarea name="description" data-description>{{ result.description }}</textarea>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Result" />
        </form>
    </div>
</div>
