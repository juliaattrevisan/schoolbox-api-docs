<script type="text/javascript" charset="utf-8" src="/javascript/components/jquery-timepicker-jt/jquery.timepicker.min.js"></script>
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/ajax/nanospell/autoload.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>

{% autoescape 'js' %}
<script type="text/javascript">
    $(function() {
        $('#matchForm').alaressValidate({
            ignore: ':hidden',
            rules: {
                venueId: {
                    required: true,
                    min: 1
                },
                seasonId: {
                    required: true,
                    minlength: 1
                },
                startAtDate: {
                    required: true,
                    minlength: 1,
                    datepickerDate: true
                },
                startAtTime: {
                    required: true,
                    minlength: 1,
                    timepickerTime: true
                },
                homeTeamId: {
                    required: true,
                    minlength: 1
                },
                awayTeamId: {
                    required: true,
                    minlength: 1
                },
                'itinerary[date][]': {
                    datepickerDate: true
                },
                'itinerary[time][]': {
                    timepickerTime: true
                }
            },
            messages: {
                'venueId': 'Please choose a Venue.',
                'name': 'Please enter a Match name.',
                'seasonId': 'Please choose a Season',
                'startAtDate': {
                    required: 'Please choose a date.'
                },
                'startAtTime': {
                    required: 'Please choose a time.'
                }
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        });


        $('#season').selectizeSelector({
            {% if division.season.id %}
            value: {
                id: {{ match.season.id }},
                name: "{{ match.season.name }} - {{ match.season.start.localShort }} to {{ match.season.end.localShort }}"
            },
            {% endif %}
            multiple: false,
            ajax: {
                url: '{{ routeLookup('sportsfixturesSeason.getList') }}',
                type: 'GET',
                dataType: 'json'
            },
            selectize: {
                preload: true,
                persist: true,
                hideSelected: false,
                score: function(search) {
                    return function(item) {
                        // Simply filter list, don't reorder
                        return -1 === item.name.toLowerCase().indexOf(search.toLowerCase()) ? 0 : 1;
                    };
                }
            }
        });

        // Ensure match is scheduled within the season
        $('[data-datepicker]').datepicker();

        $('#matchForm').find('[data-timepicker]').timepicker({
            appendTo: function ($input) {
                return $input.closest('.timepick');
            },
            scrollDefault: '08:00'
        });

        $('#homeTeam').selectizeSelector({
            {% if match.homeTeam.id -%}
            value: {
                id: {{ match.homeTeam.id }},
                name: "{{ match.homeTeam.name }}"
            },
            {% elseif match.homeSchool.Id -%}
            value: {
                id: "{{ tagPrefix }}{{ match.homeSchool.id }}",
                name: "{{ match.homeSchool.name }}"
            },
            {% endif -%}
            multiple: false,
            selectize: {
                preload: true,
                hideSelected: false,
                load: function(query, callback) {
                    // Load: get values from AJAX, and callback with result
                    var ajaxSettings = {
                        url: '{{ routeLookup('sportsfixturesTeam.getList', { contextId: match.division.id }) }}?schools=1',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: query }
                    };
                    $.ajax(ajaxSettings)
                            .done(function(result) {
                                callback(result)
                            })
                            .fail(function() {
                                callback()
                            })
                }
            }
        });

        $('#awayTeam').selectizeSelector({
            {% if match.awayTeam.id -%}
            value: {
                id: {{ match.awayTeam.id }},
                name: "{{ match.awayTeam.name }}"
            },
            {% elseif match.awaySchool.id -%}
            value: {
                id: "{{ tagPrefix }}{{ match.awaySchool.id }}",
                name: "{{ match.awaySchool.name }}"
            },
            {% endif -%}
            multiple: false,
            selectize: {
                preload: true,
                hideSelected: false,
                load: function(query, callback) {
                    // Load: get values from AJAX, and callback with result
                    var ajaxSettings = {
                        url: '{{ routeLookup('sportsfixturesTeam.getList', { contextId: match.division.id }) }}?schools=1',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: query }
                    };
                    $.ajax(ajaxSettings)
                            .done(function(result) {
                                callback(result)
                            })
                            .fail(function() {
                                callback()
                            })
                }
            }
        });

        $('#venue').selectizeSelector({
            ajax: {
                url: '{{ routeLookup('sportsfixturesVenue.getList') }}',
                type: 'GET',
                dataType: 'json'
            },
            {% if match.venue.id -%}
            value: {
                id: {{ match.venue.id }},
                name: "{{ match.venue.name }}"
            },
            {% endif -%}
            multiple: false,
            selectize: {
                preload: true,
                hideSelected: false,
                load: function(query, callback) {
                    // Load: get values from AJAX, and callback with result
                    var ajaxSettings = {
                        url: '{{ routeLookup('sportsfixturesVenue.getList') }}',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: query }
                    };
                    $.ajax(ajaxSettings)
                            .done(function(result) {
                                callback(result)
                            })
                            .fail(function() {
                                callback()
                            })
                }
            }
        });

        $('textarea').alaressEditor();
    });
</script>
{% endautoescape %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'Sports', routeLookup('sportsfixturesSport.getList') ],
    [ match.division.sport.name, routeLookup('sportsfixturesSport.getEntity', { entityId: match.division.sport.id }) ],
    [ match.division.name, routeLookup('sportsfixturesDivision.getLobby', { entityId: match.division.id }) ],
    [ 'Seasons', routeLookup('sportsfixturesMatch.getList', { contextId: match.division.id }) ],
    [ match.name | default(action ~ ' Match') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ match.division.name }} {{ match.division.sport.name }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if match %}
            {% set formUrl = routeLookup('sportsfixturesMatch.updateEntity', {entityId: match.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesMatch.createEntity') %}
        {% endif %}

        <form id="matchForm" action="{{ formUrl }}" method="post">
            <h2 class="subheader">{{ action }} Match</h2>

            <section>
                <fieldset class="content">
                    <input type="hidden" name="divisionId" value="{{ match.division.id }}"/>
                    <input type="hidden" name="matchId" value="{{ match.id }}"/>

                    <div class="small-12 columns">
                        <label>
                            Name
                            <input type="text" name="name" value="{{ match.name }}"/>
                        </label>
                    </div>

                    <div class="column small-12 medium-4">
                        <label>
                            Season
                            <input id="season" name="seasonId" type="text" value='' placeholder="Search Seasons" />
                        </label>
                    </div>

                    <div class="column small-12 medium-4">
                        <label>
                            Date
                            <input type="text" name="startAtDate" placeholder="Date" data-datepicker value="{{ match.startAt.localShort }}">
                        </label>
                    </div>

                    <div class="column small-12 medium-4">
                        <div class="timepick">
                            <label>
                                Time
                                <input type="text" name="startAtTime" autocomplete="off" placeholder="Start Time" class="ui-timepicker-input" data-timepicker value="{{ match.startAt.timeOnly }}">
                            </label>
                        </div>
                    </div>

                    <div class="small-12 columns">
                        <label>
                            Venue
                            <input id="venue" name="venueId" type="text" value='' placeholder="Search Venues" />
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Participating Teams</legend>
                    <div class="small-12 medium-6 columns">
                        <label>
                            Home
                            <input id="homeTeam" name="homeTeamId" type="text" value='' placeholder="Search Teams" />
                        </label>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>
                            Away
                            <input id="awayTeam" name="awayTeamId" type="text" value='' placeholder="Search Teams" />
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Itinerary</legend>
                    <div class="small-12 column" id="itinerary">
                        {% include '@sportsfixturesItineraryItem/listContent.twig' with { itineraryItems: match.itinerary } %}
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Notes</legend>
                    <div class="small-12 columns">
                        <textarea name="notes">{{ match.notes }}</textarea>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Match" />
        </form>
    </div>
</div>
