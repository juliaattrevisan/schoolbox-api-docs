<script type="text/javascript">
    $(function() {
        $('[data-delete]').click(function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Result?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>

{% set teamResult = match.results[team.id] %}
<h3 class="subheader">Results</h3>
<section class="content">
    <div class="row">
        <div class="small-12 columns">
            <div class="actions-small-2 row">
                <div class="list-item">
                    <div class="small-12 columns">
                        <h4>{{ team.name }}{% if teamResult.status.id %} - {{ teamResult.status.name }}{% endif %}</h4>
                        {{ teamResult.description|purify }}
                    </div>
                </div>


                <nav>
                    {% if hasMatchModify and not match.season.isArchived %}
                    <a href="{{ routeLookup('sportsfixturesResult.getModifyForm', {entityId: teamResult.id}) }}" class="icon-modify" title="Modify"></a>
                    {% endif %}
                    <a href="#" class="icon-more" data-dropdown="sportsfixtures-position-{{ currentPosition.getId() }}-actions"></a>
                </nav>
                <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-position-{{ currentPosition.getId() }}-actions">
                    <li><a href="{{ routeLookup('sportsfixturesResult.deleteEntity', {entityId: teamResult.id}) }}" class="icon-delete" title="Delete" data-delete="{{ match.result[team.id].id }}">Delete</a></li>
                </ul>
            </div>
        </div>
    </div>
</section>
