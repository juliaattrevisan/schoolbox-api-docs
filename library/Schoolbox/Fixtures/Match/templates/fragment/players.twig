{% if teamMetadata.players.offset(team.id)|length %}
    <h2 class="subheader">{{ team.name }} Players</h2>
    <section>
        <ul class="information-list">
            {% for currentPlayer in teamMetadata.players.offset(team.id) %}
            <li>
                <div class="card small-12">
                    <a href="/search/user/{{ currentPlayer.user.id }}" title="View Profile">
                        {% include 'include/portrait.twig' with {user: currentPlayer.user} only %}
                        <p>{{ currentPlayer.user.fullname }}</p>
                    </a>
                    <p class="meta">
                        {% for currentPosition in currentPlayer.positions %}
                        {{ currentPosition.name ?? '' }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </p>
                </div>
            </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
