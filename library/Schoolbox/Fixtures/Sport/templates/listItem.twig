<li class="actions-small-1" data-sport>
    <div class="list-item">
        <div class="small-12 card">
            <div class="icon-sport"></div>
            <h3><a href="{{ routeLookup('sportsfixturesSport.getEntity', {entityId: sport.id}) }}" title="Manage Divisions in {{ sport.name }}">{{ sport.name }}</a></h3>
            <p><a href="{{ sport.url }}">{{ sport.url }}</a>
        </div>
    </div>
    <nav>
        <a href="{{ routeLookup('sportsfixturesSport.getModifyForm', {entityId: sport.id}) }}" class="sbx-icon-only-button" title="Modify" aria-label="Modify">
            <sbx-icon name="modify"></sbx-icon>
        </a>
        <sbx-pop-out content-id="sportsfixtures-sport-{{ sport.getId() }}-actions"></sbx-pop-out>
    </nav>
    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-sport-{{ sport.getId() }}-actions">
        <li>
            <a href="#" data-action="delete" data-post-action="{{ routeLookup('sportsfixturesSport.deleteEntity', {entityId: sport.id}) }}" class="sbx-button--has-icon" title="Delete" data-delete="{{ sport.id }}">
                <sbx-icon name="delete"></sbx-icon>
                Delete
            </a>
        </li>
    </ul>
</li>
