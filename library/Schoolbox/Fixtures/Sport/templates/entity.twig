<script type="text/javascript">
    $(function () {
        $('[data-collapser]').collapsable();

        $('#allDivisions').on('click', '[data-division-action="delete"]', function(event) {
            event.preventDefault();

            var element = $(this);
            var $division = element.closest('[data-division]');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Division?',
                confirmLabel: 'Delete',
                confirmEvent: function() {
                    $.post(element.attr('data-post-action'), {}, function() {

                        // Is this the last division in this sport ?
                        if( 1 == $('[data-division]').length){
                            window.location.href = window.location.href;
                        } else {
                            $division.fadeOut({ done: $division.remove });
                        }
                    });
                }
            });
        });

        $('#allDivisions').on('click', '[data-delete-team]', function(event) {
            event.preventDefault();

            var element = $(this);
            var $team = element.closest('[data-team]');
            var $division = element.closest('[data-division]');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Team?',
                confirmLabel: 'Delete',
                confirmEvent: function() {
                    $.post(element.attr('href'), {}, function() {

                        // Is this the last team in this division ?
                        if (1 == $division.find('[data-team]').length) {
                            window.location.href = window.location.href;
                        } else {
                            $team.fadeOut({ done: $team.remove });
                        }
                    });
                }
            });
        });

        $('#fdrop-sport').on('click', '[data-post-action]', function(event) {
            event.preventDefault();

            let element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Sport?',
                confirmEvent: function() {
                    $.post(element.attr('data-post-action'), function(responseText) {
                        window.location.href = '{{ routeLookup('sportsfixturesSport.getList') }}';
                    });
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures',    routeLookup('sportsfixtures.getLanding') ],
    [ 'Sports',      routeLookup('sportsfixturesSport.getList') ],
    [ sport.name ]
) }}

<div class="row actions-small-1">
    <div class="small-12 columns list-item">
        <h1>{{ sport.name }}</h1>
        {%  if sport.url %}
        <ul class="meta">
            <li class="icon-home"><a href="{{ sport.url }}">{{ sport.url }}</a></li>
        </ul>
        {% endif %}
    </div>
    <nav>
        <sbx-pop-out content-id="fdrop-sport"></sbx-pop-out>
    </nav>
    <ul id="fdrop-sport" class="f-dropdown" data-dropdown-content>
        <li>
            <a class="sbx-button--has-icon" href="{{ routeLookup('sportsfixturesDivision.getCreateForm', { contextId: sport.id }) }}">
                <sbx-icon name="add"></sbx-icon>
                Add new division
            </a>
        </li>
        <li>
            <a class="sbx-button--has-icon" href="{{ routeLookup('sportsfixturesSport.getModifyForm', { entityId: sport.id }) }}">
                <sbx-icon name="modify"></sbx-icon>
                Modify {{ sport.name }}
            </a>
        </li>
        <li>
            <a class="sbx-button--has-icon" data-post-action="{{ routeLookup('sportsfixturesSport.deleteEntity', {entityId: sport.id}) }}" >
                <sbx-icon name="delete"></sbx-icon>
                Delete {{ sport.name }}
            </a>
        </li>
    </ul>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Divisions</h2>
            {% if not divisions | length %}
                <div class="empty-state">
                    <i class="icon-division"></i>
                    <p>There are no divisions in {{ sport.name }}.</p>
                    <p><a href="{{ routeLookup('sportsfixturesDivision.getCreateForm', {contextId: sport.id}) }}">Add a division</a></p>
                </div>
            {% else %}
        <section>
            <ul class="information-list expandable-card" id="allDivisions">
                {% for division in divisions %}
                {% set teamCount = division.teams | length %}
                <li data-division>
                    <div class="actions-small-1">
                        {% if teamCount %}
                        <div class="expander" data-collapser="division-{{ division.id }}"></div>
                        {% endif %}
                        <div class="card small-12 list-item">
                            <a href="{{ routeLookup('sportsfixturesDivision.getLobby', { entityId: division.id }) }}" title="Go to {{ division.name }} lobby">
                                <sbx-icon name="division"></sbx-icon>
                                <h3>{{ division.name }}</h3>
                            </a>
                            <p class="meta">
                                {%- if teamCount == 1 -%}
                                    One team
                                {%- elseif teamCount -%}
                                    {{ teamCount }} teams
                                {%- else -%}
                                    No teams
                                {%- endif -%}
                            </p>
                        </div>
                        <nav>
                            <sbx-pop-out content-id="division-{{ division.id }}-dropdown"></sbx-pop-out>
                        </nav>
                        <ul class="f-dropdown" data-division-dropdown data-dropdown-content id="division-{{ division.id }}-dropdown">
                            <li>
                                <a href="{{ routeLookup('sportsfixturesMatch.getList', { contextId: division.id }) }}" class="sbx-button--has-icon">
                                    <sbx-icon name="search"></sbx-icon>
                                    View Fixture
                                </a>
                            </li>
                            <li>
                                <a href="{{ routeLookup('sportsfixturesTeam.getCreateForm', { contextId: division.id }) }}" class="sbx-button--has-icon">
                                    <sbx-icon name="add"></sbx-icon>
                                    Add New Team
                                </a>
                            </li>
                            <li>
                                <a href="{{ routeLookup('sportsfixturesDivision.getModifyForm', { entityId: division.id }) }}" class="sbx-button--has-icon">
                                    <sbx-icon name="modify"></sbx-icon>
                                    Modify
                                </a>
                            </li>
                            <li>
                                <a href="#" data-division-action="delete" data-post-action="{{ routeLookup('sportsfixturesDivision.deleteEntity', {entityId: division.id}) }}" class="sbx-button--has-icon">
                                    <sbx-icon name="delete"></sbx-icon>
                                    Delete
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="hide" data-collapse-state="collapsed" data-collapsable="division-{{ division.id }}">
                        <ul class="information-list">
                            {% for team in division.teams %}
                                <li data-team="{{ team.id }}">
                                    <div class="actions-small-1">
                                        <div class="list-item">
                                            <div class="card compact small-12">
                                                {% set routeModifyTeam = routeLookupIfAuthorized('sportsfixturesTeam.getModifyForm', {
                                                    entityId: team.id,
                                                    entity:   team,
                                                }) %}
                                                {% if routeModifyTeam %}
                                                    <div>
                                                        <span class="icon-team"></span>
                                                        <a href="{{ routeModifyTeam }}">{{ team.name }}</a>
                                                        {% if team.coaches | length %}
                                                            <span class="pipe meta">({{ team.coaches | column('name') | join(', ') }})</span>
                                                        {% endif %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                        {% set routeDeleteTeam = routeLookupIfAuthorized('sportsfixturesTeam.deleteEntity', {
                                            entityId: team.id,
                                            entity:   team
                                        }) %}
                                        {% if routeDeleteTeam %}
                                            <nav>
                                                <a href="{{ routeDeleteTeam }}" class="sbx-icon-only-button" title="Delete Team" aria-label="Delete Team" data-delete-team="{{ team.id }}">
                                                    <sbx-icon name="delete"></sbx-icon>
                                                </a>
                                            </nav>
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </section>
            {% endif %}
    </div>
</div>
