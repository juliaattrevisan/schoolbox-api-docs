<div class="list-item">
    <div class="small-12 compact card"
         data-action="{{ (currentStatus.id ?? null)
             ? routeLookup('sportsfixturesStatus.updateEntity', { entityId: currentStatus.id })
             : '#'
         }}"
    >
        <label for="status-name-{{ currentStatus.id ?? 'new' }}">Status Name</label>
        <input id="status-name-{{ currentStatus.id ?? 'new' }}" type="text" name="name" placeholder="Status name" value="{{ currentStatus.name ?? '' }}" data-item-original-value="{{ currentStatus.name ?? '' }}" data-item-element />

        <span class="toast" data-save-item></span>
    </div>
</div>
<nav>
    <span data-unsaved-indicator class="icon-info hide" title="Not yet saved"></span>
    <a href="{{ (currentStatus.id ?? null)
        ? routeLookup('sportsfixturesStatus.deleteEntity', {entityId: currentStatus.id ?? null})
        : '#'
        }}"
       title="Delete"
       data-delete
    ><sbx-icon name="delete"></sbx-icon></a>
</nav>
