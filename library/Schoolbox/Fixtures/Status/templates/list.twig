<script type="text/javascript" src="{{ CDN_PREFIX }}/js/sportsfixtures/jquery.mightyList.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        $('#allItems').mightyList({
            deleteKey: 'statusId'
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'Statuses' ]
) }}
<div id="allItems">
    <div class="actions-small-1 row">
        <div class="list-item">
            <div class="small-12 columns">
                <h1>Match Status</h1>
            </div>
        </div>
        <nav>
            <a class="icon-add" title="Add Status" data-item-add></a>
        </nav>
    </div>

    <div class="row">
        <div class="small-12 island" id="allItems">
            <section>
                <ul class="information-list hide" data-item-list>
                    {% for currentStatus in allStatus %}
                        <li class="actions-small-2" data-item="{{ currentStatus.id }}">
                            {% include '@sportsfixturesStatus/listItem.twig' %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
            <div class="empty-state hide">
                <i class="icon-position"></i>
                <p>You have no match status, these must exist in order to conclude a match.</p>
                <p>Please <a title="Add a Status" data-item-add>add a status</a> now.</p>
            </div>
            <ul class="information-list hide">
                <li id="item-clone" class="actions-small-2" data-item="">
                    {% include '@sportsfixturesStatus/listItem.twig' %}
                </li>
            </ul>
        </div>
    </div>
</div>
