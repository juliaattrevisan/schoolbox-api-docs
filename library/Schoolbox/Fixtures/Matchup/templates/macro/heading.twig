{# Use to generate the text for Fixture Component List Item
 #
 # Links the Team name to results for the given team and match
 #}
{% macro generateWithStatusLink(match) %}
{% apply spaceless %}
    {# Home Team #}
    {% if match.homeTeam.id %}
        {% set homeTeamData %}
            <a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: match.homeTeam.id}) }}">{{ match.homeTeam.name ?? '' }}</a>
            {% if match.homeTeamResult %}
                ({{ match.homeTeamResult.status.name ?? '' }})
            {% endif %}
        {% endset %}
    {% else %}
        {% set homeTeamData = match.homeSchool.name ?? '' %}
    {% endif %}

    {# Away Team #}
    {% if match.awayTeam.id %}
        {% set awayTeamData %}
            <a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: match.awayTeam.id}) }}">{{ match.awayTeam.name ?? '' }}</a>
            {% if match.awayTeamResult %}
                ({{ match.awayTeamResult.status.name ?? '' }})
            {% endif %}
        {% endset %}
    {% else %}
        {% set awayTeamData = match.awaySchool.name ?? '' %}
    {% endif %}

    {% if awayTeamData %}
        {{ homeTeamData }} vs {{ awayTeamData }}
    {% else %}
        {{ homeTeamData }}
    {% endif %}
{% endapply %}
{% endmacro %}




