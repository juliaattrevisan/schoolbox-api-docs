{# Use to generate the text for a Component list element
 #
 # If the Team has an appropriate Match Result page,
 # hyperlink it
 #}
{% macro generateWithResultLink(match) %}
{% apply spaceless %}
    {# Home Team #}
    {% if match.homeTeam %}
        {% set homeTeamData %}
            <a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: match.homeTeam.id}) }}">{{ match.homeTeam.name ?? '' }}</a>
        {% endset %}
    {% else %}
        {% set homeTeamData = match.homeSchool.name ?? '' %}
    {% endif %}

    {# Away Team #}
    {% if match.awayTeam %}
        {% set awayTeamData %}
            <a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: match.awayTeam.id}) }}">{{ match.awayTeam.name ?? '' }}</a>
        {% endset %}
    {% else %}
        {% set awayTeamData = match.awaySchool.name ?? '' %}
    {% endif %}

    {% if awayTeamData %}
        {{ homeTeamData }} vs {{ awayTeamData }}
    {% else %}
        {{ homeTeamData }}
    {% endif %}
{% endapply %}
{% endmacro %}


