{% import '@sportsfixturesMatch/macro/heading.twig' as matchHeading %}

{% if match.results.offset(team.id) %}
    {% set hasResult = true %}
{% else %}
    {% set hasResult = false %}
{% endif %}

{% block breadcrumbs %}
{% endblock %}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ matchHeading.generateWithTeamLink(match) }}</h1>
        </div>
    </div>
    <nav>
        {% if hasMatchModify and not match.season.archived %}
        <a href="{{ routeLookup('sportsfixturesMatch.getModifyForm', {entityId: match.id}) }}" class="icon-modify" title="Modify"></a>
        {% endif %}
    </nav>
</div>

<div class="row">
    <div class="small-12 columns">
        <ul class="meta">
            {% if match.name %}{% apply spaceless %}
            <li class="icon-sport" title="{{ matchHeading.generate(match) }}">{{ match.name }}</li>
            {% endapply %}{% endif %}
            <li class="icon-calendar" title="{{ match.startAt.local }}">{{ match.startAt.long }} ({{ match.startAt.relativeTime }})</li>

            {# Optional venue #}
            {% if match.venue %}
                <li class="icon-location">{{ match.venue.name }} {% if match.venue.address %}<a href="https://www.google.com/maps/place/{{ match.venue.address|url_encode }}" target="_blank">{{ match.venue.address }}{% endif %}</a></li>
            {% endif %}

            {% if forecast.hasResults %}
            <li class="icon-weather" >{{ forecast.condition }}, {{ forecast.temp }}&deg;C</li>
            {% endif %}
        </ul>
    </div>
</div>

{% if hasResult %}
<div class="row">
    <div class="small-12 island">
        {% include '@sportsfixturesMatch/fragment/hasResult.twig' %}
    </div>
</div>
{% elseif match.venue %}
    <div class="row">
        <div class="small-12 columns">
            {% include '@sportsfixturesMatch/fragment/map.twig' %}
        </div>
    </div>
{% endif %}

<div class="row">
    {% if hasResult %}
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/players.twig' %}
            {% include '@sportsfixturesMatch/fragment/coaches.twig' %}
        </div>
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/itinerary.twig' %}
            {% include '@sportsfixturesMatch/fragment/notes.twig' %}
        </div>
    {% else %}
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/itinerary.twig' %}
            {% include '@sportsfixturesMatch/fragment/notes.twig' %}
        </div>
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/players.twig' %}
            {% include '@sportsfixturesMatch/fragment/coaches.twig' %}
        </div>
    {% endif %}
</div>

{% if not hasResult %}
    {% if hasMatchModify and not match.season.isArchived %}
    <div class="row">
        <div class="small-12 columns">
            {% include '@sportsfixturesMatch/fragment/noResult.twig' %}
        </div>
    </div>
    {% endif %}
{% endif %}


