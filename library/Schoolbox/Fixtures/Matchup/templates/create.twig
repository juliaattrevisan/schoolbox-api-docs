<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>

{% autoescape 'js' %}
<script type="text/javascript">
    $(function() {
        $('#matchForm').alaressValidate({
            rules: {
                startAtDate: {
                    datepickerDate: true
                },
                finishAtDate: {
                    datepickerDate: true
                },
                seasonId: {
                    required: true
                },
                homeTeamId: {
                    required: true,
                },
                awayTeamId: {
                    required: true,
                }
            },
            messages: {
                'name': 'Please enter a match name.',
                'seasonId': 'Please choose a season',
                'startAtDate': {
                    required: 'Please choose a date.'
                },
                'finishAtDate': {
                    required: 'Please choose a date.'
                }
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        });


        $('#season').selectizeSelector({
            {% if match.season.id %}
            value: {
                id: {{ match.season.id }},
                name: "{{ match.season.name }} - {{ match.season.start.localShort }} to {{ match.season.end.localShort }}"
            },
            {% endif %}
            multiple: false,
            ajax: {
                url: '{{ routeLookup('sportsfixturesSeason.getList') }}',
                type: 'GET',
                dataType: 'json'
            },
            selectize: {
                preload: true,
                persist: true,
                hideSelected: false,
                score: function(search) {
                    return function(item) {
                        // Simply filter list, don't reorder
                        return -1 === item.name.toLowerCase().indexOf(search.toLowerCase()) ? 0 : 1;
                    };
                }
            }
        });

        // Ensure match is scheduled within the season

        $('#homeTeam').selectizeSelector({
            {% if match.homeTeam -%}
            value: {
                id: {{ match.homeTeam.id }},
                name: "{{ match.homeTeam.name }}"
            },
            {% elseif match.homeSchool -%}
            value: {
                id: "{{ tagPrefix }}{{ match.homeSchool.id }}",
                name: "{{ match.homeSchool.name }}"
            },
            {% endif -%}
            multiple: false,
            selectize: {
                preload: true,
                hideSelected: false,
                load: function(query, callback) {
                    // Load: get values from AJAX, and callback with result
                    var ajaxSettings = {
                        url: '{{ routeLookup('sportsfixturesTeam.getList', { contextId: match.division.id }) }}?schools=1',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: query }
                    };
                    $.ajax(ajaxSettings)
                            .done(function(result) {
                                callback(result)
                            })
                            .fail(function() {
                                callback()
                            })
                }
            }
        });

        $('#awayTeam').selectizeSelector({
            {% if match.awayTeam -%}
            value: {
                id: {{ match.awayTeam.id }},
                name: "{{ match.awayTeam.name }}"
            },
            {% elseif match.awaySchool -%}
            value: {
                id: "{{ tagPrefix }}{{ match.awaySchool.id }}",
                name: "{{ match.awaySchool.name }}"
            },
            {% endif -%}
            multiple: false,
            selectize: {
                preload: true,
                hideSelected: false,
                load: function(query, callback) {
                    // Load: get values from AJAX, and callback with result
                    var ajaxSettings = {
                        url: '{{ routeLookup('sportsfixturesTeam.getList', { contextId: match.division.id }) }}?schools=1',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: query }
                    };
                    $.ajax(ajaxSettings)
                            .done(function(result) {
                                callback(result)
                            })
                            .fail(function() {
                                callback()
                            })
                }
            }
        });

        $('#venue').selectizeSelector({
            ajax: {
                url: '{{ routeLookup('sportsfixturesVenue.getList') }}',
                type: 'GET',
                dataType: 'json'
            },
            {% if match.venue -%}
            value: {
                id: {{ match.venue.id }},
                name: "{{ match.venue.name }}"
            },
            {% endif -%}
            multiple: false,
            selectize: {
                preload: true,
                hideSelected: false,
                load: function(query, callback) {
                    // Load: get values from AJAX, and callback with result
                    var ajaxSettings = {
                        url: '{{ routeLookup('sportsfixturesVenue.getList') }}',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: query }
                    };
                    $.ajax(ajaxSettings)
                            .done(function(result) {
                                callback(result)
                            })
                            .fail(function() {
                                callback()
                            })
                }
            }
        });

        $('textarea').alaressEditor();
    });
</script>
{% endautoescape %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'Sports', routeLookup('sportsfixturesSport.getList') ],
    [ match.division.sport.name, routeLookup('sportsfixturesSport.getEntity', { entityId: match.division.sport.id }) ],
    [ match.division.name, routeLookup('sportsfixturesDivision.getLobby', { entityId: match.division.id }) ],
    [ 'Seasons', routeLookup('sportsfixturesMatch.getList', { contextId: match.division.id }) ],
    [ match.name | default(action ~ ' Match') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ match.division.name }} {{ match.division.sport.name }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if match %}
            {% set formUrl = routeLookup('sportsfixturesMatch.updateEntity', {entityId: match.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesMatch.createEntity') %}
        {% endif %}

        <form id="matchForm" action="{{ formUrl }}" method="post">
            <h2 class="subheader">{{ action }} Match</h2>

            <section>
                <fieldset class="content">
                    <input type="hidden" name="divisionId" value="{{ match.division.id }}"/>
                    <input type="hidden" name="matchId" value="{{ match.id }}"/>

                    <div class="small-12 columns">
                        <label for="name" class="required">Name</label>
                        <input type="text" name="name" id="name" value="{{ match.name }}" required />
                    </div>

                    <div class="column small-12 medium-4">
                        <label for="season" class="required">Season</label>
                        <input id="season" name="seasonId" type="text" value='' placeholder="Search Seasons" required/>
                    </div>

                    <div class="column small-12 medium-4">
                        <label for="startAtDate" class="required">Start Date</label>
                        <input type="text" id="startAtDate" name="startAtDate" placeholder="Date" data-datepicker data-datepicker-time data-datesync-enddate="#finishAtDate" value="{{ match.startAt ? match.startAt.local : '' }}" required />
                    </div>

                    <div class="column small-12 medium-4">
                        <label for="finishAtDate" class="required">Finish Date</label>
                        <input type="text" id="finishAtDate" name="finishAtDate" placeholder="Date" data-datepicker data-datepicker-time data-datesync-startdate="#startAtDate" value="{{ match.finishAt ? match.finishAt.local : '' }}" required />
                    </div>

                    <div class="small-12 columns">
                        <label for="venue">Venue</label>
                        <input id="venue" name="venueId" type="text" value='' placeholder="Search Venues" />
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Participating Teams</legend>
                    <div class="small-12 medium-6 columns">
                        <label for="homeTeam" class="required">Home</label>
                            <input id="homeTeam" name="homeTeamId" type="text" value='' placeholder="Search Teams" required />

                    </div>
                    <div class="small-12 medium-6 columns">
                        <label for="awayTeam" class="required">Away</label>
                        <input id="awayTeam" name="awayTeamId" type="text" value='' placeholder="Search Teams" required />
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Itinerary</legend>
                    <div class="small-12 column" id="itinerary">
                        {% include '@sportsfixturesItineraryItem/listContent.twig' with { itineraryItems: match.itinerary } %}
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Notes</legend>
                    <div class="small-12 columns">
                        <textarea name="notes">{{ match.notes }}</textarea>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Match" />
        </form>
    </div>
</div>
