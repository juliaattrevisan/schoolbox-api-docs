{% import '@sportsfixturesMatch/macro/heading.twig' as matchHeading %}

<script type="text/javascript">
    $(function() {

        // Season selector
        var $seasonSelector = $('[data-context-switcher]');
        var $seasons        = $('[data-season]');
        var $seasonDropdown = $seasonSelector.find('#context-selector-semester');
        var $previous       = $seasonSelector.find('[data-interaction=previous]');
        var $next           = $seasonSelector.find('[data-interaction=next]');
        var ALL_SEASONS     = 0;
        $seasonDropdown.on('change',function(event){
            var seasonId = $(this).val();
            $seasons.each(function(idx,elem){
                if(ALL_SEASONS == seasonId || $(elem).data('season') == seasonId){
                    $(elem).removeClass('hide');
                } else {
                    $(elem).addClass('hide');
                }
            });
            checkNav();
        });

        // User clicks a navigation element
        $previous.add($next).on('click',function(event){
            event.preventDefault();
            $seasonDropdown[0].selectedIndex += $(this).data('interaction') == 'previous' ? -1 : 1;
            $seasonDropdown.trigger('change');
        });

        /**
         * Disable/Enable season selector nav buttons
         */
        function checkNav(){
            var index  = $seasonDropdown[0].selectedIndex;
            var length = $seasonDropdown[0].length;

            var enablePrevious = index > 0 && length > 1;
            var enableNext     = index < (length-1) && length > 1;

            enablePrevious ? $previous.removeAttr('disabled') : $previous.attr('disabled','disabled');
            $previous.prop('disabled', enablePrevious);

            enableNext ? $next.removeAttr('disabled') : $next.attr('disabled','disabled');
            $next.prop('disabled', enableNext);
        }
        // Refresh UI if user got here by clicking browser 'back'
        $seasonDropdown.trigger('change');


        $('#allMatches').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);
            var $match  = element.closest('[data-match]');
            var $season = $match.closest('[data-season]');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Match?',
                confirmLabel: 'Delete',
                confirmEvent: function() {
                    $.post(element.attr('href'), {}, function() {

                        // Is this the last match in an archived season ?
                        if( $season.data('archived') && 1 == $season.find('[data-match]').length){
                            $season.fadeOut({ done: $season.remove });

                            var currentSeasonId = $seasonDropdown.val();

                            // Also remove option from select
                            $seasonDropdown.find('option[value='+$season.data('season')+']').remove();

                            // Did we remove the currently selected option?
                            if($season.data('season') == currentSeasonId){
                                $seasonDropdown.trigger('change');
                            }
                        }

                        // Is this the last match in the division ?
                        if( 1 == $('[data-match]').length){
                            window.location.href = window.location.href;
                        } else {
                            $match.fadeOut({ done: $match.remove });
                        }
                    });
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures',          routeLookup('sportsfixtures.getLanding') ],
    [ 'Sports',            routeLookup('sportsfixturesSport.getList') ],
    [ division.sport.name, routeLookup('sportsfixturesSport.getEntity', { entityId: division.sport.id }) ],
    [ division.name,       routeLookup('sportsfixturesDivision.getLobby', { entityId: division.id }) ],
    [ 'Seasons ']
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ division.name }} {{ division.sport.name }} Seasons</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-6 columns">
        <div class="content">
            <div data-context-switcher class="context-switch clearfix">
                <nav>
                    <a data-interaction="previous" {% if allSeasons.last.id != division.season.id %} disabled {% endif %} href="#" title="Previous Season"></a>
                </nav>
                <div class="semester">
                    <select id="context-selector-semester">
                        <option value="0" selected="selected">All Seasons</option>
                        {% for season in allSeasons %}
                            {% set isCurrent = season.id == division.season.id %}

                            {# If the season ends in a different year than it starts,
                             # then show the year so it doesn't look weird like this:
                             #     Jan 1 - Jan 1
                             #     Mar 5 - Feb 2
                             #
                             # Otherwise, if you're in the same year, show it as before:
                             #     Apr 27 - Aug 4
                             #}
                            {% if season.start.year != season.end.year %}
                                {% set seasonInterval = season.start.dateOnly ~ ' ' ~ season.start.year ~ '—' ~ season.end.dateOnly ~ ' ' ~ season.end.year %}
                            {% else %}
                                {% set seasonInterval = season.start.dateOnly ~ '—' ~ season.end.dateOnly %}
                            {% endif %}

                            <option value="{{ season.id }}" {% if isCurrent %} selected="selected" {% endif %}
                            >{{ season.name }} ({{ seasonInterval }}){% if isCurrent %} *{% endif %}</option>
                        {% endfor %}
                    </select>
                </div>
                <nav>
                    <a data-interaction="next" {% if allSeasons.first.id != division.season.id %} disabled {% endif %} href="#" title="Next Season"></a>
                </nav>
            </div>
        </div>
    </div>

    <div class="small-12 island" id="allMatches">
        <div>
            {% for season in allSeasons %}
                {% set matchCount = (allMatches[season.id] ?? [])|length %}

                <div data-season="{{ season.id }}" {% if season.archived %} data-archived="1" {% endif %}  {% if season.id != division.season.id %} class="hide" {% endif %}  >
                    <div class="actions-small-1">
                        <div class="list-item">
                            <h2 class="subheader">
                                {% if season.archived %}
                                    <del class="icon icon-archive" title="Season has been archived.">{{ season.name }}</del>
                                {% else %}
                                    <span title="View season details">{{ season.name }}</span>
                                {% endif %}
                                {% if season.id == division.season.id %} (<span title="{{ division.name }} is currently attached to this season">current</span>) {% endif %}
                            </h2>
                            <ul class="meta">
                                <li class="icon-match">
                                    {% if not matchCount %}
                                    No matches
                                    {% elseif matchCount == 1 %}
                                    One match
                                    {% else %}
                                    {{ matchCount }} matches
                                    {% endif %}
                                    in fixture
                                </li>
                            </ul>
                        </div>

                        <nav>
                            {% if not season.archived %}
                                <a href='{{ routeLookup('sportsfixturesMatch.getCreateForm', {contextId: division.id}) }}?season={{ season.id }}' class="icon-add" title="Add Match to {{ division.name }} {{ division.sport.name }} {{ season.name }} "></a>
                            {% endif %}
                        </nav>
                    </div>

                    {% if matchCount %}
                    <section>
                        <ul class="action-list">
                            {% for currentMatch in allMatches[season.id] %}
                                {% include '@sportsfixturesMatch/listItem.twig' %}
                            {% endfor %}
                        </ul>
                    </section>
                    {% else %}
                        <div class="empty-state">
                            <i class="icon-match"></i>
                            <p>There are no matches scheduled for {{ division.name }} {{ division.sport.name }} in the {{ season.name }} season.</p>
                        {% if division.season.archived %}
                            <p>This season is currently archived. To add a match, you first need to <a href="{{ routeLookup('sportsfixturesSeason.getList') }}">restore it</a> or <a href="{{ routeLookup('sportsfixturesDivision.getModifyForm', { entityId: division.id }) }}">assign the division to a different season</a>.</p>
                        {% else %}
                            <p>You may <a href="{{ routeLookup('sportsfixturesMatch.getCreateForm', {contextId: division.id}) }}?season={{ season.id }}" title="Add match to {{ division.name }} {{ division.sport.name }} {{ season.name }}">add a match</a> or <a href="{{ routeLookup('sportsfixturesImport.getUpload') }}">bulk upload</a> an entire fixture.</p>
                        {% endif %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>
