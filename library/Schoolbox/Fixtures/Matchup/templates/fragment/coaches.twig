{% if teamMetadata.coaches.offset(team.id)|length %}
    <h2 class="subheader">{{ team.name }} Coaches</h2>
    <section>
        <ul class="information-list">
            {% for currentCoach in teamMetadata.coaches.offset(team.id) %}
                <li>
                    <div class="card small-12">
                        {% if currentCoach.user.id %}
                        <a href="/search/user/{{ currentCoach.user.id }}" title="View Profile">
                            {% include 'include/portrait.twig' with {user: currentCoach.user} only %}
                            <p>{{ currentCoach.name }}</p>
                        </a>
                        {% else %}
                        {% include 'include/portrait.twig' with {user: false} only %}
                        <p class="meta">{{ currentCoach.name }}</p>
                    </div>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
