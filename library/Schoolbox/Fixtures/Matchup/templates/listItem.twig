{% import '@sportsfixturesMatch/macro/heading.twig' as matchHeading %}

<li class="actions-small-2" data-match>
    <div class="list-item">
        <div class="small-12 card">
            {% if currentMatch.name | length %}

                {%  if currentMatch.homeTeam and currentMatch.awayTeam %}
                    <h3>{{ currentMatch.name }}</h3>
                {% elseif currentMatch.homeTeam %}
                    <h3><a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: currentMatch.id, teamId: currentMatch.homeTeam.id}) }}">{{ currentMatch.name }}</a></h3>
                {% elseif currentMatch.awayTeam %}
                    <h3><a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: currentMatch.id, teamId: currentMatch.awayTeam.id}) }}">{{ currentMatch.name }}</a></h3>
                {% endif %}

            {% else %}
                <h3>{{ matchHeading.generateWithResultLink(currentMatch) }}</h3>
            {% endif %}

            <p class="meta">{{ matchHeading.generateWithResultLink(currentMatch) }}</p>
            <p class="meta">{{ currentMatch.startAt.getLong }}</p>
        </div>
    </div>
    <nav>
        {%- if not currentMatch.season.isArchived -%}
            <a href="{{ routeLookup('sportsfixturesMatch.getModifyForm', {entityId: currentMatch.id}) }}" class="sbx-icon-only-button" title="Modify" aria-label="Modify">
                <sbx-icon name="modify"></sbx-icon>
            </a>
        {%- endif -%}
        <sbx-pop-out content-id="sportsfixtures-match-{{ currentMatch.getId() }}-actions"></sbx-pop-out>
    </nav>
    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-match-{{ currentMatch.getId() }}-actions">
        <li>
            <a href="{{ routeLookup('sportsfixturesMatch.deleteEntity', {entityId: currentMatch.id}) }}" class="sbx-button--has-icon" title="Delete" data-delete="{{ currentMatch.id }}">
                <sbx-icon name="delete"></sbx-icon>
                Delete
            </a>
        </li>
    </ul>
</li>
