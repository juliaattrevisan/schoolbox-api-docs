
{% if not noInstall and matches | length %}
    {% import '@sportsfixturesMatch/macro/heading.twig' as matchHeading %}

    <div class="small-12 columns no-pad">
        <ul class="action-list">
            {% for match in matches %}
                <li>
                    <div class="list-item">
                        <div class="card small-12">

                            {% if match.name|length %}
                                {%  if match.homeTeam.id and match.awayTeam.id %}
                                    <h3>{{ match.name }}</h3>
                                {% elseif match.homeTeam.id %}
                                    <h3><a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: match.homeTeam.id}) }}">{{ match.name }}</a></h3>
                                {% elseif match.awayTeam.id  %}
                                    <h3><a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: match.awayTeam.id}) }}">{{ match.name }}</a></h3>
                                {% endif %}
                                <p class="meta">{{ matchHeading.generateWithResultLink(match) }}</p>
                            {% else %}
                                <h3>{{ matchHeading.generateWithStatusLink(match) }}</h3>
                            {% endif %}

                            <p class="meta">{{ match.startAt.getLong }}</p>

                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
{% else %}

    <div class="empty-state">
        <i class="icon-sport"></i>

        {% if noInstall %}
            <p>The fixtures module is currently not installed, please ask your System Administrator about how to enable this component.</p>
        {% elseif (readOnly or ((matches is empty) and ((team is not empty) and team != '0'))) %}
            <p>There are no upcoming matches to display at this time.</p>
        {% else %}

            {#
            TODO:   Allow fixture admins to go straight to a create match form
                    Can't happen at the moment because the route needs a division
                    if (fixtureAdmin or superuser) and !noConfig
                        <p><a href="{{ routeLookup('sportsfixturesMatch.getCreateForm') }}">Create a match</a> to show users the upcoming matches for this team.</p>
            #}

            <p><a href="#" class="edit empty-edit" data-target="settings" data-state="closed">Choose a team</a> to display their results and upcoming matches.</p>

        {% endif %}

    </div>

{% endif %}
