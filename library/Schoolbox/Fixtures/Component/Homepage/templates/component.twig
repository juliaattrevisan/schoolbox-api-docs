{% import '@sportsfixturesMatch/macro/heading.twig' as matchHeading %}

{% if matches | length %}
    <div class="small-12 columns no-pad">
        <ul class="action-list">

            {% for match in matches %}
                <li>
                    <div class="list-item">
                        <div class="card small-12">

                            {% if match.name|length %}
                                <h3>{{ match.name }}: {{ matchHeading.generateWithStatusLink(match) }}</h3>
                            {% else %}
                                <h3>{{ matchHeading.generateWithStatusLink(match) }}</h3>
                            {% endif %}

                            <p class="meta">
                                <span data-tooltip title="{{ match.startAt.getLong }}">{{ match.startAt.getRelativeTime }}</span>
                            </p>

                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>

{% else %}

    <div class="empty-state">
        <i class="icon-sport"></i>

        {% if readOnly %}

            <p>There are no upcoming matches at this time.</p>

        {% else %}

            {#
            TODO:   Allow fixture admins to go straight to a create match form
                    Can't happen at the moment because the route needs a division
                    if fixtureAdmin and !noConfig
                        <p><a href="{{ routeLookup('sportsfixturesMatch.getCreateForm') }}">Create a match</a> to show users the upcoming matches for this team.</p>
            #}

            <p><a href="#" class="edit empty-edit" data-target="settings" data-state="closed">Choose a team</a> to display their results and upcoming matches.</p>

        {% endif %}

    </div>

{% endif %}
