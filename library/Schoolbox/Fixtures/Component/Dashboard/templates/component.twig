{% import '@sportsfixturesMatch/macro/heading.twig' as matchHeading %}

{% if matches | length %}
    <div class="small-12 columns no-pad">
        <ul class="action-list">

            {% for match in matches %}
                <li>
                    <div class="list-item">
                        <div class="card small-12">
                            {% if match.name|length %}
                                {%  if match.homeTeam.id and match.awayTeam.id %}
                                    <h3>{{ match.name }}</h3>
                                {% elseif match.homeTeam.id %}
                                    <h3><a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: match.homeTeam.id}) }}">{{ match.name }}</a></h3>
                                {% elseif match.awayTeam.id  %}
                                    <h3><a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: match.awayTeam.id}) }}">{{ match.name }}</a></h3>
                                {% endif %}
                                    <p class="meta">{{ matchHeading.generateWithResultLink(match) }}</p>
                            {% else %}
                                <h3>{{ matchHeading.generateWithResultLink(match) }}</h3>
                            {% endif %}

                            <p class="meta">{{ match.startAt.getLong }}</p>

                            {% if user.role.type == 'parent' %}
                                {% if match.homeTeam.players | length %}
                                    <p class="meta">
                                        {% for child in match.homeTeam.players %}
                                            {% if not loop.first and not loop.last %},{% endif %}
                                            {% if loop.last and not loop.first %}and{% endif %}
                                            <a href="/search/user/{{ child.getId }}">{{ child.formatName }}</a>
                                            {% if loop.last and not loop.first %}are{% endif %}
                                            {% if loop.last and loop.first %}is{% endif %}
                                        {% endfor %} playing for {{ match.homeTeam.name }}
                                    </p>
                                {% endif %}

                                {% if match.awayTeam.players | length %}
                                    <p class="meta">
                                        {% for child in match.awayTeam.players %}
                                            {% if not loop.first and not loop.last %},{% endif %}
                                            {% if loop.last and not loop.first %}and{% endif %}
                                            <a href="/search/user/{{ child.getId }}">{{ child.formatName }}</a>
                                            {% if loop.last and not loop.first %}are{% endif %}
                                            {% if loop.last and loop.first %}is{% endif %}
                                        {% endfor %} playing for {{ match.awayTeam.name }}
                                    </p>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
{% else %}
    <div class="content">
        <p>
            {% if user.role.type == 'parent' %}
                Your children do not have any upcoming matches scheduled.
            {% elseif user.role.type == 'student' %}
                You have no upcoming matches scheduled.
            {% endif %}
        </p>
    </div>
{% endif %}
