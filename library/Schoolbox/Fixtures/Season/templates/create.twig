<script type="text/javascript">
    $(function() {
        $('#seasonForm').alaressValidate();
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'Seasons',  routeLookup('sportsfixturesSeason.getList') ],
    [ season.name | default('Create Season') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ action }} Season</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if season %}
            {% set formUrl = routeLookup('sportsfixturesSeason.updateEntity', {entityId: season.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesSeason.createEntity') %}
        {% endif %}

        <form id='seasonForm' action="{{ formUrl }}" method="post">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="hidden" name="id" value="{{ season.id }}"/>

                        <label for="name" class="required">Name</label>
                        <input type="text" name="name" id="name" value="{{ season.name }}" required />
                    </div>

                    <div class="column small-12 medium-6">
                        <label for="start" class="required">Start Date</label>
                        <input type="text" id="start" name="start" placeholder="Start Date" data-datepicker data-datesync-enddate="#end" value="{{ season.start.getLocalShort ?? '' }}" required >
                    </div>

                    <div class="column small-12 medium-6">
                        <label for="end" class="required">End Date</label>
                        <input type="text" id="end" name="end" placeholder="End Date" data-datepicker data-datesync-startdate="#start" value="{{ season.end.getLocalShort ?? '' }}" required >
                    </div>

                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Season" />
        </form>
    </div>
</div>
