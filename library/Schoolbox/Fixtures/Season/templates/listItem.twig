<li class="actions-small-1" data-season="{{ currentSeason.id }}" data-name="{{ currentSeason.name }}" data-archived="{{ currentSeason.isArchived ? 1 : 0 }}" data-division-count="{{ divisionCounts[currentSeason.id] }}" data-match-count="{{ matchCounts[currentSeason.id]  }}">
    <div class="list-item">
        <div class="small-12 card">
            <h3>
                <a href="{{ routeLookup('sportsfixturesSeason.getModifyForm', {entityId: currentSeason.id}) }}">
                    {% if currentSeason.isArchived %}
                        <del class="icon icon-archive" title="This season is archived, and will be de-emphasised in selectors.">{{ currentSeason.name }}</del>
                    {% else %}
                        {{ currentSeason.name }}
                    {% endif %}
                </a>
            </h3>
            <p class="meta">{{ currentSeason.start.getDateOnly }}—{{ currentSeason.end.getDateOnly }}</p>
        </div>
    </div>
    <nav>
        {% if not currentSeason.isArchived %}
            <a href="{{ routeLookup('sportsfixturesSeason.getModifyForm', {entityId: currentSeason.id}) }}" class="sbx-icon-only-button" title="Modify" aria-label="Modify">
                <sbx-icon name="modify"></sbx-icon>
            </a>
        {% endif %}
        <sbx-pop-out content-id="sportsfixtures-season-{{ currentSeason.getId() }}-actions"></sbx-pop-out>
    </nav>

    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-season-{{ currentSeason.getId() }}-actions">
        {% if currentSeason.isArchived %}
            <li>
                <a href="#" data-action="restore" data-post-action="{{ routeLookup('sportsfixturesSeason.unArchiveEntity', {entityId: currentSeason.id}) }}" class="sbx-button--has-icon" title="Restore">
                    <sbx-icon name="undo"></sbx-icon>
                    Restore
                </a>
            </li>
        {% else %}
            <li>
                <a href="#" data-action="archive" data-post-action="{{ routeLookup('sportsfixturesSeason.archiveEntity', {entityId: currentSeason.id}) }}" class="sbx-button--has-icon" title="Archive">
                    <sbx-icon name="archive"></sbx-icon>
                    Archive
                </a>
            </li>
        {% endif %}
        <li>
            <a href="#" data-action="delete" data-post-action="{{ routeLookup('sportsfixturesSeason.deleteEntity', {entityId: currentSeason.id}) }}" class="sbx-button--has-icon" title="Delete" data-delete="{{ currentSeason.id }}">
                <sbx-icon name="delete"></sbx-icon>
                Delete
            </a>
        </li>
    </ul>
</li>
