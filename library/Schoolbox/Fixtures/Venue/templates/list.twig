<script type="text/javascript">
    $(function() {
        $('#allVenues').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);
            var $venue  = element.closest('[data-venue]');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Venue?',
                confirmLabel: 'Delete',
                confirmEvent: function() {
                    $.post(element.attr('href'), {}, function() {
                        // Is this the last venue ?
                        if( 1 == $('[data-venue]').length){
                            window.location.href = window.location.href;
                        } else {
                            $venue.fadeOut({ done: $venue.remove });
                        }
                    });
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'Venues' ]
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Venues</h1>
        </div>
    </div>
    <nav>
        <a href='{{ routeLookup('sportsfixturesVenue.getCreateForm', {}) }}' class="icon-add" title="Add Venue"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island" id="allVenues">
        {% if allVenues|length %}
            <section>
                <ul class="information-list">
                    {% for venue in allVenues %}
                        {% include '@sportsfixturesVenue/listItem.twig' %}
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-venue"></i>
                <p>You currently have no venues, these must exist before you can schedule matches.<br /> Start by <a href="{{ routeLookup('sportsfixturesVenue.getCreateForm') }}" title="Add a Venue">adding a venue</a> or you can <a href="{{ routeLookup('sportsfixturesImport.getUpload') }}">bulk upload</a> a list.</p>
            </div>
        {% endif %}
    </div>
</div>
