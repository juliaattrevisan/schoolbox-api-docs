<script type="text/javascript">
    $(function() {
        $('#venueForm').alaressValidate({
            messages: {
                latitude: {
                    min: 'Latitude must lie between -90.000000 and 90.0000000',
                    max: 'Latitude must lie between -90.000000 and 90.0000000'
                },
                longitude: {
                    min: 'Longitude must lie between -180.000000 and 180.0000000',
                    max: 'Longitude must lie between -180.000000 and 180.0000000'
                }
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        })
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'Venues',   routeLookup('sportsfixturesVenue.getList') ],
    [ venue.name | default ('Create Venue') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ action }} Venue</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if venue %}
            {% set formUrl = routeLookup('sportsfixturesVenue.updateEntity', {entityId: venue.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesVenue.createEntity') %}
        {% endif %}

        <form id='venueForm' action="{{ formUrl }}" method="post">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="hidden" name="id" value="{{ venue.id }}"/>

                        <label for="name" class="required">Name</label>
                        <input type="text" name="name" id="name" value="{{ venue.name }}" required/>

                        {% if venue.address or (venue.latitude and venue.longitude) %}
                            <label>
                                Location
                                <span data-tooltip class="hint has-tip tip-top" title="Select the venue by clicking its location on the map, scrolling and zooming as required.">?</span>
                            </label>

                            {% import '@sportsfixturesMatch/macro/map.twig' as matchMap %}

                            {% if googleApiKey %}
                                <iframe src="{{ matchMap.generate(venue, googleApiKey) }}" frameborder="0" width='100%' height='450' allowfullscreen="true"></iframe>
                            {% endif %}
                        {% endif %}

                        <label>
                            Street Address
                            <span data-tooltip class="hint has-tip tip-top" title="Enter the street address of your venue.">?</span>
                            <input type="text" name="address" value="{{ venue.address }}" maxlength="255"/>
                        </label>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Venue" />
        </form>
    </div>
</div>
