<li class="actions-small-1" data-venue>
    <div class="list-item">
        <div class="small-12 card">
            <h3><a href="{{ routeLookup('sportsfixturesVenue.getModifyForm', {entityId: venue.id}) }}">{{ venue.name }}</a></h3>
            <p class="meta">{{ venue.address }}</p>
        </div>
    </div>
    <nav>
        <a href="{{ routeLookup('sportsfixturesVenue.getModifyForm', {entityId: venue.id}) }}" class="sbx-icon-only-button" title="Modify" aria-label="Modify">
            <sbx-icon name="modify"></sbx-icon>
        </a>
        <sbx-pop-out content-id="sportsfixtures-venue-{{ venue.getId() }}-actions"></sbx-pop-out>
    </nav>
    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-venue-{{ venue.getId() }}-actions">
        <li>
            <a href="{{ routeLookup('sportsfixturesVenue.deleteEntity', {entityId: venue.id}) }}" class="sbx-button--has-icon" title="Delete" data-delete="{{ venue.id }}">
                <sbx-icon name="delete"></sbx-icon>
                Delete
            </a>
        </li>
    </ul>
</li>
