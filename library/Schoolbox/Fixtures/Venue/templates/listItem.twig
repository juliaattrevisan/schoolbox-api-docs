<li class="actions-small-1" data-venue>
    <div class="list-item">
        <div class="small-12 card">
            <h3><a href="{{ routeLookup('sportsfixturesVenue.getModifyForm', {entityId: venue.id}) }}">{{ venue.name }}</a></h3>
            <p class="meta">{{ venue.address }}</p>
        </div>
    </div>
    <nav>
        <a href="{{ routeLookup('sportsfixturesVenue.getModifyForm', {entityId: venue.id}) }}" class="icon-modify" title="Modify"></a>
        <wc-actions-dropdown content-id="sportsfixtures-venue-{{ venue.getId() }}-actions"></wc-actions-dropdown>
    </nav>
    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-venue-{{ venue.getId() }}-actions">
        <li><a href="{{ routeLookup('sportsfixturesVenue.deleteEntity', {entityId: venue.id}) }}" class="icon-delete" title="Delete" data-delete="{{ venue.id }}">Delete</a></li>
    </ul>
</li>
