{#
  Renders a list of teams.

  Data:
    sport:    Sport\Model
    division: Division\Model
    allTeams: Collection|Team\Model[]
#}
<script type="text/javascript">
    $(function() {
        $('#allTeams').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);
            var $team   = element.closest('[data-team]');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Team?',
                confirmLabel: 'Delete',
                confirmEvent: function() {
                    $.post(element.attr('href'), {teamId: element.attr('data-delete')}, function() {

                        // Is this the last team in the division ?
                        if( 1 === $('[data-team]').length){
                            location.reload();
                        } else {
                            $team.fadeOut({ done: $team.remove });
                        }
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li class="active"><span>Teams in {{ division.name }}</span></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allTeams">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">{{ division.name }}</h2>
                </div>
            </div>
            {% set routeCreateTeam = routeLookupIfAuthorized('sportsfixturesTeam.getCreateForm', {
                contextId: division.id,
                context:   division
            }) %}
            {% if routeCreateTeam %}
            <nav>
                <a href='{{ routeCreateTeam }}' class="sbx-icon-only-button" title="Add Team to {{ division.name }}" aria-label="Add Team to {{ division.name }}">
                    <sbx-icon name="add"></sbx-icon>
                </a>
            </nav>
            {% endif %}
        </div>

        {% if allTeams|length %}
        <section>
            <ul class="action-list">
                {% for currentTeam in allTeams %}
                <li class="actions-small-1" data-team>
                    <div class="list-item">
                        <div class="small-12 card">
                            <h3>{{ currentTeam.name }}</h3>
                            <p class="meta"><a href="{{ currentTeam.url }}">{{ currentTeam.url }}</a>
                        </div>
                    </div>

                    {% set routeModifyTeam = routeLookupIfAuthorized('sportsfixturesTeam.getModifyForm', {
                        entityId: currentTeam.id,
                        entity:   currentTeam
                    }) %}

                    {% set routeDeleteTeam = routeLookupIfAuthorized('sportsfixturesTeam.deleteEntity', {
                        entityId: currentTeam.id,
                        entity:   currentTeam
                    }) %}

                    {% if routeModifyTeam or routeDeleteTeam %}
                        <nav>
                            {% if routeModifyTeam %}
                                <a href="{{ routeModifyTeam }}" class="sbx-icon-only-button" title="Modify" aria-label="Modify">
                                    <sbx-icon name="modify"></sbx-icon>
                                </a>
                            {% endif %}

                            {% if routeDeleteTeam %}
                                <sbx-pop-out content-id="sportsfixtures-team-{{ currentTeam.getId() }}-actions"></sbx-pop-out>
                            {% endif %}
                        </nav>
                        {% if routeDeleteTeam %}
                            <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-team-{{ currentTeam.getId() }}-actions">
                                <li>
                                    <a href="{{ routeDeleteTeam }}" class="sbx-button--has-icon" title="Delete" data-delete="{{ currentTeam.id }}">
                                        <sbx-icon name="delete"></sbx-icon>
                                        Delete
                                    </a>
                                </li>
                            </ul>
                        {% endif %}
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <sbx-icon name="team" size="2.5rem"></sbx-icon>
            <p>There are no Teams in {{ division.name }}.</p>
            {% if routeCreateTeam %}
            <p><a href="{{ routeCreateTeam }}" title="Add a Team">Add a Team</a></p>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
