<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        $('#teamForm').alaressValidate({
            rules: {
                url: {
                    isURL: true
                }
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        });

        // Selectize box for selecting one or more users
        // This box allows freetext entry, because of the requirement that
        // coaches won't always be Schoolbox users.
        var selector = $('[data-role="userSelector"]');
        selector
            .selectizeSelector({
                multiple: true,
                ajax: {
                    url:      '/ajax/tags/sport_coach',
                    type:     'GET',
                    dataType: 'json'
                },
                selectize: {
                    create: function(input) {
                        var freeEntry = {};
                        freeEntry[this.settings.valueField]  = 'newFromInput:'+input;
                        freeEntry[this.settings.searchField] = input;
                        return freeEntry;
                    },
                    render: {
                        item: function (data, escape) {
                            var klass   = "item",
                                title   = '',
                                hasUser = ('user' in data && 'id' in data.user && data.user.id);
                            if (!hasUser) {
                                // Not a SB user: put some icon there
                                klass += ' icon-info';
                                title = 'This user does not exist in Schoolbox.';
                            }
                            return '<div class="'+klass+'" title="'+title+'">'
                                    + escape(data[this.settings.labelField])
                                    + '</div>'
                        }
                    }
                },
                value: $.selectizeSelector.getValueFromSelect(selector)
            });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures',    routeLookup('sportsfixtures.getLanding') ],
    [ 'Sports',      routeLookup('sportsfixturesSport.getList') ],
    [ sport.name,    routeLookup('sportsfixturesSport.getEntity', { entityId: sport.id }) ],
    [ division.name, routeLookup('sportsfixturesDivision.getLobby', { entityId: division.id }) ],
    [ team.name | default(action ~ ' Team') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ division.name }} {{ sport.name }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if team %}
            {% set formUrl = routeLookup('sportsfixturesTeam.updateEntity', {entityId: team.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesTeam.createEntity', {contextId: division.id}) %}
        {% endif %}

        <form id='teamForm' action="{{ formUrl }}" method="post">
            <h2 class="subheader">{{ action }} Team</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="hidden" name="divisionId" value="{{ division.id }}"/>
                        <input type="hidden" name="teamId" value="{{ team.id }}"/>
                    </div>
                    <div class="small-12 columns">
                        <label for="name" class="required">Name</label>
                        <input type="text" name="name" id="name" value="{{ team.name }}" required />
                    </div>
                    <div class="small-12 columns">
                        <label for="url">Homepage URL</label>
                        <script>
                            $(function() {
                                $('#modalLinkButton').schoolboxLink({
                                    allowedFilesystems: 'folder',
                                    onSelect: function(url, name, mime, dialog) {
                                        $('input[name="url"]').val(url);
                                    }
                                });
                            });
                        </script>
                        <div class="input-group">
                            <input type="text" name="url" value="{{ team.url }}" placeholder="http://" />
                            <a id="modalLinkButton" class="button icon-link">Browse</a>
                        </div>
                    </div>
                    <div class="small-12 columns">
                        <label>
                            Coaches
                            <select type="text" data-role="userSelector" name="coach[]" multiple placeholder="Search Users">
                            {% for coach in team.coaches %}
                                <option selected data-value-object="{{ coach|json_encode }}" value="{{ coach.formatId }}">{{ coach.formatName }}</option>
                            {% endfor %}
                            </select>
                        </label>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Team" />
        </form>
    </div>
</div>
