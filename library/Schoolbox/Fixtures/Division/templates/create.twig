<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        $('#divisionForm').alaressValidate({
            rules: {
                url: {
                    isURL: true
                },
                seasonId: {
                    required: true
                }
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        });

        var ize = $('#season').selectizeSelector({
            {% if division.season %}
            value: {"id":{{ division.season.id }}, "name": "{{ division.season.name }}"},
            {% endif %}
            multiple: false,
            ajax: {
                url: '{{ routeLookup('sportsfixturesSeason.getList') }}',
                type: 'GET',
                dataType: 'json'
            },
            selectize: {
                preload: true,
                persist: true,
                hideSelected: false,
                score: function(search) {
                    return function(item) {
                        // Simply filter list, don't reorder
                        return -1 === item.name.toLowerCase().indexOf(search.toLowerCase()) ? 0 : 1;
                    };
                }
            }
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures',    routeLookup('sportsfixtures.getLanding') ],
    [ 'Sports',      routeLookup('sportsfixturesSport.getList') ],
    [ sport.name,    routeLookup('sportsfixturesSport.getEntity', { entityId: sport.id }) ],
    [ division.name | default(action ~ ' Division') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ sport.name }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if division %}
            {% set formUrl = routeLookup('sportsfixturesDivision.updateEntity', {entityId: division.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesDivision.createEntity') %}
        {% endif %}

        <form id="divisionForm" action="{{ formUrl }}" method="post">
            <input type="hidden" name="returnUrl" value="{{ referer }}" />
            <h2 class="subheader">{{ action }} Division in {{ sport.name }}</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="hidden" name="sportId" value="{{ sport.id }}"/>
                        <input type="hidden" name="divisionId" value="{{ division.id }}"/>

                        <label for="name" class="required">Name</label>
                        <input type="text" name="name" id="name" value="{{ division.name }}" required/>

                        <label for="season" class="required">Current Season</label>
                        <input id="season" name="seasonId" type="text" value="{{ division.season.name ?? '' }}" placeholder="Search Seasons" required />

                        <label for="url">Homepage URL</label>
                        <script>
                            $(function() {
                                $('#modalLinkButton').schoolboxLink({
                                    allowedFilesystems: 'folder',
                                    onSelect: function(url, name, mime, dialog) {
                                        $('input[name="url"]').val(url);
                                    }
                                });
                            });
                        </script>
                        <div class="input-group">
                            <input type="text" name="url" value="{{ division.url }}" placeholder="http://" />
                            <a id="modalLinkButton" class="button icon-link">Browse</a>
                        </div>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Division" />
        </form>
    </div>
</div>
