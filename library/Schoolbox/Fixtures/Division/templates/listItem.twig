<li class="actions-small-1" data-division>
    <div class="list-item">
        <div class="small-12 card">
            <h3>
                {% if division.season.isArchived %}
                    <span title="Select a new season to manage Players">{{ division.name }}</span>
                {% else %}
                    <a href="{{ routeLookup('sportsfixturesDivision.getLobby', {entityId: division.id}) }}"><span title="Division Lobby">{{ division.name }}</span></a>
                {% endif %}
            </h3>

            <p class="meta">
                {% if division.season.isArchived %}
                    <del class="icon icon-archive" title="This season is archived.">{{ division.season.name }}</del>
                {% else %}
                    <span title="This season is archived">{{ division.season.name }}</span>
                {% endif %}
            </p>
        </div>
    </div>

    {% set action = division.season.isArchived ? 'View' : 'Manage' %}
    <nav>
        <a href="{{ routeLookup('sportsfixturesDivision.getModifyForm', {entityId: division.id}) }}" class="sbx-icon-only-button" title="Modify" aria-label="Modify">
            <sbx-icon name="modify"></sbx-icon>
        </a>
        <sbx-pop-out content-id="sportsfixtures-division-{{ division.getId() }}-actions"></sbx-pop-out>
    </nav>
    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-division-{{ division.getId() }}-actions">
        <li>
            <a href="{{ routeLookup('sportsfixturesTeam.getList', {contextId: division.id}) }}" class="sbx-button--has-icon" title="{{ action }} Teams in {{ division.name }}">
                <sbx-icon name="group"></sbx-icon>
                {{ action }} Teams
            </a>
        </li>
        <li>
            <a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: division.id}) }}" class="sbx-button--has-icon" title="{{ action }} Matches in {{ division.name }}">
                <sbx-icon name="match"></sbx-icon>
                {{ action }} Matches
            </a>
        </li>
        <li>
            <a href="{{ routeLookup('sportsfixturesDivision.deleteEntity', {entityId: division.id}) }}" class="sbx-button--has-icon" title="Delete" data-delete="{{ division.id }}">
                <sbx-icon name="delete"></sbx-icon>
                Delete
            </a>
        </li>
    </ul>
</li>
