<script type="text/javascript" charset="utf-8" src="/javascript/components/jquery-timepicker-jt/jquery.timepicker.min.js"></script>
<script type="text/javascript">
    $(function() {
        $('#itineraryItemForm').alaressValidate({
            rules: {
                startAtDate: {
                    required: true
                },
                startAtTime: {
                    required: true
                },
                description: {
                    required: true,
                    minlength: 2
                }
            },
            messages: {
                'startAtDate': 'Please choose a Date',
                'startAtTime': 'Please choose a Time',
                'description': 'Please enter a name.'
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        });
    });
</script>

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: division.id}) }}">Matches in {{ division.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesMatch.getModifyForm', {entityId: match.id}) }}">{{ match.name }}</a></li>

    {% if itineraryItem.id %}
        <li class="active"><a href="{{ routeLookup('sportsfixturesItineraryItem.getModifyForm', {entityId: itineraryItem.id}) }}">{{ itineraryItem.decription }}</a></li>
    {% else %}
        <li class="active"><a href="#">{{ action }}</a></li>
    {% endif %}
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if itineraryItem %}
            {% set formUrl = routeLookup('sportsfixturesItineraryItem.updateEntity', {entityId: itineraryItem.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesItineraryItem.createEntity') %}
        {% endif %}

        <form id="itineraryItemForm" action="{{ formUrl }}" method="post">
            <h2 class="subheader">{{ action }} Itinerary Item in {{ match.name }}</h2>

            <section>
                <fieldset class="content">
                    {% include '@sportsfixturesItineraryItem/listItem.twig' with { hideNav: true } %}
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Itinerary Item" />
        </form>
    </div>
</div>
