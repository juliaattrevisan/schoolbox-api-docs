<div class="list-item">
    <input type="hidden" name="itinerary[matchId][]" value="{{ match.id }}"/>
    <input type="hidden" name="itinerary[itemId][]" value="{{ itineraryItem.id ?? '' }}"/>
    <div class="column small-12 large-6 xlarge-4">
        <label for="itineraryDate-{{ itineraryItem.id ?? '' }}">
            Date
            {# If this input has data - it can use the datepicker attacher,
               otherwise it needs to use a custom one which is attached on MightyList create (in listContent.twig)
             #}
        </label>
        <input type="text" name="itinerary[date][]" id="itineraryDate-{{ itineraryItem.id ?? '' }}" placeholder="Date" {{ (itineraryItem is defined and itineraryItem.startAt and itineraryItem.startAt.localShort) ? 'data-datepicker' : 'data-itinerary-date' }} data-datepicker-time value="{{ itineraryItem.startAt.local ?? '' }}">
    </div>
    <div class="small-12 large-6 xlarge-8 columns">
        <label for="itineraryDescription-{{ itineraryItem.id ?? '' }}">
            Description
        </label>
        <input id="itineraryDescription-{{ itineraryItem.id ?? '' }}" type="text" name="itinerary[description][]" value="{{ itineraryItem.description ?? '' }}"  data-item-original-value="{{ itineraryItem.description ?? '' }}" data-item-element />
    </div>
</div>
{% if hideNav is not defined or not hideNav %}
<nav>
    <a href="{{ routeLookup('sportsfixturesItineraryItem.deleteEntity', {entityId: currentItineraryItem.id ?? 0}) }}" class="sbx-icon-only-button" title="Delete" aria-label="Delete" data-delete="{{ currentItineraryItem.id ?? '' }}">
        <sbx-icon name="delete"></sbx-icon>
    </a>
</nav>
{% endif %}
