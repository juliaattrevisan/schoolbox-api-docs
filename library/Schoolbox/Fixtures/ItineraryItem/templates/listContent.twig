<script type="text/javascript" src="{{ CDN_PREFIX }}/js/sportsfixtures/jquery.mightyList.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        $('#itinerary').mightyList({
            deleteKey: 'itineraryItemId',
            templateSelector: '[data-template]',
            focusSelector: '[name="itinerary[description][]"]',
            onModify: function (element) {
                element.closest('[data-item]').find('[data-unsaved-indicator]').removeClass('hide');
            },
            onDelete: function (element, container) {
                container.detach();
            },
            onRevert: function (element) {
                element.closest('[data-item]').find('[data-unsaved-indicator]').addClass('hide');
            },
            onCreate: function (element) {
                // Add datepicker
                element.find('[data-itinerary-date]')
                    .attr('id', 'itineraryDate-new-' + String(Date.now()))
                    .alaressDateTimePicker();
                $('input[name="itinerary[date][]"]').rules("add", {
                    datepickerDate: true
                });
            }
        });
    });
</script>

<section>
    <ul class="action-list hide" data-item-list>
        {% for itineraryItem in itineraryItems %}
        <li class="actions-small-1" data-item>
            {% include '@sportsfixturesItineraryItem/listItem.twig' %}
        </li>
        {% endfor %}
    </ul>
</section>
<div class="empty-state hide">
    <i class="icon-itineraryitem"></i>
    <p>There is no itinerary for {{ match.name | default('this match') }}.</p>
    <p><a data-item-add>Create an itinerary</a></p>
</div>
<ul class="information-list hide">
    <li data-template class="actions-small-1" data-item>
        {% include '@sportsfixturesItineraryItem/listItem.twig' %}
    </li>
</ul>
