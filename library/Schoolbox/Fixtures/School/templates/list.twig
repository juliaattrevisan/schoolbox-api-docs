<script type="text/javascript" src="{{ CDN_PREFIX }}/js/sportsfixtures/jquery.mightyList.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        $('#allSchools').mightyList({
            deleteKey: 'id',
            templateSelector: '[data-clone]'
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'External Schools' ]
) }}


<div id="allSchools">

    <div class="actions-small-1 row">
        <div class="list-item">
            <div class="small-12 columns">
                <h1>External Schools</h1>
            </div>
        </div>
        <nav>
            <a class="icon-add" title="Add School" data-item-add></a>
        </nav>
    </div>

    <div class="row">
        <div class="small-12 island">
            <section>
                <ul class="information-list hide" data-item-list>
                    {% for school in schools %}
                        <li class="actions-small-1" data-item="{{ school.id }}">
                            {% include '@sportsfixturesSchool/listItem.twig' %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
            <div id="schoolEmpty" class="empty-state hide">
                <i class="icon-match"></i>
                <p>There are currently no schools, in order to play against other schools these must be created.</p>
                <p>You may <a href="#" data-item-add>add a school</a> or import a <a href="{{ routeLookup('sportsfixturesImport.getUpload') }}">bulk list</a></p>
            </div>
            <ul class="information-list hide">
                <li data-clone class="actions-small-1" data-item>
                    {% include '@sportsfixturesSchool/listItem.twig' %}
                </li>
            </ul>
        </div>
    </div>
</div>
