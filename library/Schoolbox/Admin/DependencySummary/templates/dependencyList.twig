{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <table data-sortable style="table-layout: fixed;">
                <colgroup>
                    <col />
                    <col />
                    <col />
                </colgroup>
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Class</th>
                    <th>Implemented Interfaces</th>
                </tr>
                </thead>
                <tbody>
                {% for dependency in dependencies %}
                    <tr>
                        <td><pre>{{ dependency.name }}</pre></td>
                        <td><pre>{{ dependency.class }}</pre></td>
                        <td>
                            {% if dependency.interfaces %}
                            <pre>{{ dependency.interfaces | join("\n") }}</pre>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/dataTables.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    // Sortable table
    $(function () {
        $('table[data-sortable]').DataTable({
            info: false,
            paging: false,
            searching: false
        });
    });
</script>
