{##
 # subnav
 #
 # Render the Admin subnav independently of everything else via Subnav.php
 #
 # @param array adminSubnav
 #}
<nav id="admin-nav">
    <h2 class="subheader">Menu</h2>
    <a href="#" class="dropdown-btn">Go to...</a>
    <ul class="admin side-nav" role="navigation">

        {% for parentUrl, parentData in adminSubnav %}
            <li {% if parentData.children|length %}class="parent-item"{% endif %} role="menuitem">

                {# LMS is a node that doesn't actually exist
                 # Personalisation is a node that doesn't actually exist
                 #
                 # They are a hybrid concoction of a variety of urls
                #}
                {% if parentUrl in ['lms', 'personalisation'] %}
                    <a>{{ parentData.name }}</a>
                {% else %}
                    <a href="{{ parentUrl }}">{{ parentData.name }}</a>
                {% endif %}

                {% if parentData.children|length %}
                    <ul class="flyout" role="navigation">
                        {% for childUrl, childData in parentData.children %}
                            <li role="menuitem"><a href="/adminv2/{{ childUrl }}">{{ childData.name }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</nav>