{##
 # subnav
 #
 # Render the Admin subnav independently of everything else via Subnav.php
 # This is purely the menu only, it doesn't include the heading for the page
 # you're currently viewing; you get that by combining this with index.twig
 # via renderAdminNavigation() twig extension
 #
 # @param array $adminSubnav   A set of tuples for each node in the menu
 # @param string $pageCurrent  A string corresponding to identifier in a tuple
 #}
<script type="text/javascript">
    $(function() {
        const mq = window.matchMedia( "(max-width: 950px)" );
        if (mq.matches) {
            $("[data-parent-item] a").on('click', function(event) {
                event.preventDefault();

                let $target = $(this).closest('[data-parent-item]').find("[data-admin-subnav-flyout]").slideToggle();

                $('[data-admin-subnav-flyout]').not($target).slideUp();
            });
        }

        $('[data-admin-subnav-dropdown]').on('click', function(event) {
            event.preventDefault();

            $('[data-admin]').toggle();
        });
    });
</script>
<nav id="admin-nav">
    <h2 class="subheader">Menu</h2>
    <a href="#" class="dropdown-btn" data-admin-subnav-dropdown>Go to...</a>
    <ul class="admin side-nav" role="navigation" data-admin>

        {% for parentUrl, parentData in adminSubnav %}
            {# Decide if the current node is selected
                 #
                 # Each phplib controller specifies a string for pageCurrent so you have to match
                 # them up here, circumstantially, to provide indication of which node is active
            #}
            {% set selected = '' %}

            {% if parentData.identifier == pageCurrent %}
                {% set selected = 'active' %}
            {% endif %}

            <li class="{{ selected }} {% if parentData.children|length %}parent-item{% endif %}" role="menuitem" data-parent-item>

                {# These are nodes that doesn't actually exist
                 # They are a hybrid concoction of a variety of urls
                 #}
                {% if parentUrl in ['lms', 'personalisation', 'eportfolio'] %}
                    <a>{{ parentData.name }}</a>
                {% else %}
                    <a href="/adminv2/{{ parentUrl }}">{{ parentData.name }}</a>
                {% endif %}

                {% if parentData.children|length %}
                    <ul class="flyout" role="navigation" data-admin-subnav-flyout>
                        {% for childUrl, childData in parentData.children %}
                            <li role="menuitem"><a href="/adminv2/{{ childUrl }}">{{ childData.name }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</nav>