<div class="row">
    <div class="small-12 columns">
        <h1>Schoolbox Administration › {{ links[pageCurrent] }}</h1>
        <ul class="sub-nav">
            {% for key,value in links %}
                <li class="{% if key == pageCurrent %}active{% endif %}"><a href="{{ key }}">{{ value }}</a></li>
            {% endfor %}
        </ul>
    </div>
</div>