{#
    name:          string
    value:         string
    required:      bool
#}
<input id="{{ name }}-field"
       {{ required ? 'required ' }}
       type="{% block inputType %}text{% endblock %}"
       name="{{ name }}"
       value="{{ value }}"
       {% if maxlength ?? false %}maxlength="{{ maxlength }}"{% endif %}
       {% if not editable %}disabled="disabled"{% endif %}
/>
