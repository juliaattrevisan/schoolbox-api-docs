{#
    name:          string
    value:         string
    required:      bool
#}
{% extends '@settings/fieldTypeBase.twig' %}
{% block inputElement %}
    <input id="{{ name }}-field" {{ required ? 'required ' }}type="{% block inputType %}text{% endblock %}" name="{{ name }}" value="{{ value }}" {% if not editable %}disabled="disabled"{% endif %} />
{% endblock %}
