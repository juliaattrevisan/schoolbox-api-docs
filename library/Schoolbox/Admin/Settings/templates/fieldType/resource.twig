{#
    name:          string
    value:         string
    required:      bool
#}
<div>
    <input id="{{ name }}" {% if required %}class="required" required{% endif %} type="text" name="{{ name }}" value="{{ value }}" />
    <a href="#" class="button" data-interaction="homepage_selector" data-input_name="{{ name }}">Select Source</a>
</div>
