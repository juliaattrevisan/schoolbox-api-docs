{#
    name:          string
    value:         string
    required:      bool
#}
{% extends '@settings/fieldTypeBase.twig' %}
{% block extraContent %}
    <script>
        $(function() {
            $('#modalLinkButton-{{ name }}').schoolboxLink({
                allowedFiles: false,
                allowedFilesystems: 'folder',
                onSelect: function(url, name, mime, dialog) {
                    $('#{{ name }}-field').val(url);
                }
            });
        });
    </script>
{% endblock %}
{% block inputElement %}
    <div class="input-group">
        <input id="{{ name }}-field" {{  required ? 'required ' }} type="text" name="{{ name }}" value="{{ value }}" />
        <a id="modalLinkButton-{{ name }}" class="button sbx-button--has-icon">
            <sbx-icon name="link"></sbx-icon>
            Browse
        </a>
    </div>
{% endblock %}
