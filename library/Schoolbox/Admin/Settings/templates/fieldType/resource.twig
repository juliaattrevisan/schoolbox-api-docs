{#
    name:          string
    value:         string
    required:      bool
#}
<script>
    $(function() {
        $('#modalLinkButton-{{ name }}').schoolboxLink({
            allowedFiles: false,
            allowedFilesystems: 'folder',
            onSelect: function(url, name, mime, dialog) {
                $('#{{ name }}').val(url);
            }
        });
    });
</script>
<div class="input-group">
    <input id="{{ name }}-field" {{  required ? 'required ' }} type="text" name="{{ name }}" value="{{ value }}" />
    <a id="modalLinkButton-{{ name }}" class="button icon-link">Browse</a>
</div>
