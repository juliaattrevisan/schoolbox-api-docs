{#
    name:          string
    value:         string
    required:      bool
#}
<div class="input-group">
    <input id="{{ name }}" {{  required ? 'required ' }} type="text" name="{{ name }}" value="{{ value }}" />
    <a href="#" class="button" data-interaction="homepage_selector" data-input_name="{{ name }}">Select Source</a>
</div>
