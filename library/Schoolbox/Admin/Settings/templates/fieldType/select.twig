{#
    name:              string
    value:             null|string     This has been sanitised before injecting into this template and may not match DB value.
                                       Eg, invalid values are coerced to NULL.
    options:           string[]
    required:          bool
    renderEmptyOption: bool            Should we insert an empty option in the dropdown select?
#}

<select name="{{ name }}">
    {% if renderEmptyOption %}
        <option {% if required %} style="display: none;"{% endif %}{% if value is null %} selected="selected"{% endif %}>-- select an option --</option>
    {% endif %}
    {% for key, option in options %}
        {# We still need to convert numeric keys to strings, eg 0 => '0' so that a falsy value (eg NULL, '') does not erroneously match a key of 0 #}
        {% set keyString = key ~ '' %}
        <option value="{{ key }}" {% if keyString is same as(value) %}selected="selected"{% endif %}>{{ option }}</option>
    {% endfor %}
</select>
