{#
    name:          string
    value:         string
    required:      bool
#}
{% extends '@settings/fieldTypeBase.twig' %}
{% block inputElement %}
    <textarea id="{{ name }}-field" {{ required ? 'required ' }} name="{{ name }}" rows="5" {% block extraInputAttributes %}{% endblock %} {% if not editable %}disabled="disabled"{% endif %}>{{ value }}</textarea>
{% endblock %}
