{#
    siteVersion:              string
    hasColourPicker:          bool        - Does this set of config options include an editable colour picker?
    hasHtmlEditor:            bool        - Does this set of config options include an editable html editor?
    hasResourcePicker:        bool        - Does this set of config options include an editable resource picker?
    hasTimePicker:            bool        - Does this set of config options include an editable timepicker?
    isEditable                bool        - Is the form editable?
    postRoute:                string      - Where to post form to
#}
<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/vendors/spectrum/spectrum.css?v={{ config.site_version }}" />
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/spectrum.js?v={{ siteVersion }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ siteVersion }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ siteVersion }}"></script>

<script type="text/javascript">
    $(function() {

        /**
         * checks if a search result has been selected from #admin-settings-search.vue
         * so can highlight and scroll to the result accordingly
         *
         * @return {DOMElement} selected setting highlighted
         */
        const checkForAdminSearchHighlight = () => {
            const hash = window.location.hash.substr(1);
            const element = document.getElementById(hash);
            if (element) {
                element.parentElement.classList.add('highlight-admin-search-selection');
                setTimeout(() => {
                    element.parentElement.classList.remove('highlight-admin-search-selection');
                }, 5000);
            }
            return element;
        }
        let currentHighlightedElement = checkForAdminSearchHighlight();

        /**
         * to handle additional search results selected that exist
         * on the same page, dispatched from #admin-settings-search.vue
         */
        document.addEventListener('admin-settings-search__on-result-selected', (event) => {
            if (currentHighlightedElement) {
                currentHighlightedElement.parentElement.classList.remove('highlight-admin-search-selection');
            }
            currentHighlightedElement = checkForAdminSearchHighlight();
        });


        let settingsForm = $('#settings');

        {% if hasColourPicker %}
        $("[data-colour-picker]").spectrum({
            allowEmpty: false,
            showAlpha: true,
            showInput: true,
            preferredFormat: 'rgb',
            clickoutFiresChange: true,
            showInitial: true,
            change: function(color) {
                $(this).val(color.toRgbString());
            }
        });
        {% endif %}

        {% if hasHtmlEditor %}
        $.fn.alaressEditor($.alaressEditorConfigWithUserEmailTokens({
            targetElements: settingsForm.find('[data-html-editor]'),
            baseHref: settingsForm.find('[data-html-editor]')[0].dataset.href
        }));
        {% endif %}

        {% if hasResourcePicker %}
        // Homepage selector
        settingsForm.on('click', 'a[data-interaction="homepage_selector"]', function(e) {
            e.preventDefault();
            var inputName = $(this).data('input_name');
            $('#resource-browser').socialstreamBrowser({
                title: 'Choose a folder',
                mimeFilter: false,
                categoryId: 0,
                submitCallback: function(url) {
                    settingsForm.find('input[name="'+inputName+'"]').val(url);
                }
            });
        });
        {% endif %}
        settingsForm.alaressValidate({
            rules: {
                {% for setting in settings %}
                {% set data = setting.data %}
                    {% if not data.hidden and setting.template == 'uri.twig' %}
                {{ data.name }}: {
                    isURL: true
                },
                    {% endif %}
                {% endfor %}
            },
            errorPlacement: function(error, element) {
            $.alaressValidate.defaultErrorPlacement(error, element);
        },
        });
    });
</script>
{% if hasTimePicker %}
    <datalist id="time-steps">
        {% for hour in 0..23 %}
            {% set value = '%02d:00' | format(hour) %}
            <option value="{{ value }}">{{ value }}</option>
        {% endfor %}
    </datalist>
{% endif %}

<div class="small-12 island">
    <form data-action="saveSettings" id="settings" method="post" action="{{ postRoute }}">
        <section>
            <fieldset class="content">
                {# Remember if we encountered a dropzone here somewhere
                 # We need it for the vue component's polling
                #}
                {% set hasAttachzone = 0 %}
                {% set usePolling = 0 %}

                {% for setting in settings %}
                        {% set data = setting.data %}
                    {% if data.attachzone is defined %}
                        {% set hasAttachzone = 1 %}
                    {% endif %}
                        {% if not data.hidden %}
                            <div class="small-12 columns">
                                <label id="{{ data.name }}" for="{{ data.name }}-field" class="inline-block">
                                    <span {{ data.required and data.editable ? 'class="required-with-tip"' }}>{{ data.title }}</span>
                                    <span data-tooltip class="has-tip tip-top hint"  data-allow-html='true' title="{{ data.description|replace({'<': '&lt;'}) }}">?</span>
                                </label>
                                {% include '@settings/fieldType/' ~ setting.template with data only %}
                            </div>

                        {% endif %}
                    {% endfor %}
            </fieldset>
        </section>

        {% block secondarySection %}
        {% endblock %}

        {% if isEditable %}
            {% if hasColourPicker or hasAttachzone %}
                {% set usePolling = 1 %}
            {% endif %}
            {% if useBottomDrawer %}
            <div id="save-admin-settings-container">
                <save-admin-settings
                    form-id="settings"
                    :use-polling="{{ usePolling ? 'true' : 'false' }}"
                />
            </div>
            <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/saveAdminSettings.js?v={{ config.site_version }}"></script>
            {% else %}
            <input type="submit" value="Save" />
            {% endif %}
        {% endif %}
    </form>
</div>

<div id="resource-browser" class="hide"></div>
