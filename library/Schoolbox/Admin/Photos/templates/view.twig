<script>
    $(function() {
        $('[data-delete]').click(function(event) {
            event.preventDefault();

            $(this).confirmDialog({
                text: 'Are you sure you want to remove this users photo?',
                confirmEvent: function() {
                    $.post('/adminv2/photos/delete', {
                        id: $(event.target).attr('data-delete')
                    })
                    .done(function() {
                        $(event.target).closest('li').remove();
                    });
                }
            });
        });
    });
</script>

