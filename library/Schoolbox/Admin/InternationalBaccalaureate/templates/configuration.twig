{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div id="ib-configuration-container">
            <ib-configuration
                :categories="{{ (categories ?? []) | json_encode }}"
                configuration-endpoint="{{ routeLookupIfAuthorized('internationalBaccalaureate.getConfigurationData') }}"
                save-endpoint="{{ routeLookupIfAuthorized('internationalBaccalaureate.saveConfiguration') }}"
                subjects-endpoint="{{ routeLookupIfAuthorized('internationalBaccalaureate.getCategorySubjects') }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/ibConfiguration.js?v={{ config.site_version }}"></script>
    </div>
</div>
