{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div id="ib-report-app">
            <ib-report
                candidates-endpoint="{{ _routes.candidatesEndpoint }}"
                candidate-export-endpoint="{{ _routes.candidateExportEndpoint }}"
                search-languages-endpoint="{{ _routes.searchLanguages }}"
                renotify-endpoint="{{ _routes.renotifyUnconfirmed }}"
                complete-preparation-endpoint="{{ _routes.completePreparation }}"
                session-title="{{ sessionTitle }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/ibReport.js?v={{ config.site_version }}"></script>
    </div>
</div>
