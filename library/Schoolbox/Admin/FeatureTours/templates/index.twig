{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <h2 class="subheader">Feature Tours</h2>

            <form method="post" action="{{ routeLookup('featureTours.updateConfig') }}">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="tours-enabled" class="inline-block">Enabled<span data-tooltip class="hint has-tip tip-bottom" title="Enable or disable all feature tours system-wide.">?</span></label>
                            <div class="switch">
                                <input id="tours-enabled" type="checkbox" name="enabled" {% if toursEnabled %}checked{% endif %}/>
                                <label for="tours-enabled">
                                    <span>On</span>
                                    <span>Off</span>
                                </label>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="content {% if not toursEnabled %}hide{% endif %}" id="available-tours">
                        <legend>Available Tours</legend>

                        <ul class="information-list">
                            {% for tour in tours %}
                            <li>
                                <div class="list-item l-grid l-grid--12">
                                    <div class="hide-for-medium-up small-12 columns card compact no-pad">
                                        <h3>
                                            {{ tour.title }}
                                            <p class="pipe meta" title="Will be seen by Staff">
                                                Staff
                                            </p>
                                        </h3>
                                    </div>
                                    <div class="small-12 medium-2 columns">
                                        <div class="switch">
                                            <input id="tour-enable-{{ tour.uuid }}" type="checkbox" name="tour-enable[]" value="{{ tour.uuid }}" {% if tour.active %}checked{% endif %}/>
                                            <label for="tour-enable-{{ tour.uuid }}">
                                                <span>On</span>
                                                <span>Off</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="hide-for-small small-10 columns">
                                        {{ tour.title }}
                                        <p class="meta" title="Will be seen by Staff">
                                            Staff
                                        </p>
                                    </div>
                                </div>
                            </li>
                            {% endfor %}
                        </ul>
                    </fieldset>
                </section>

                <div class="row">
                    <div class="small-12 column">
                        <input type="submit" name="btnSubmit" value="Save">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // On change of global enable/disable - toggle show/hide of options
    $('#tours-enabled').change(function() {
        if ($(this).is(':checked')) {
            $('#available-tours').removeClass('hide');
        } else {
            $('#available-tours').addClass('hide');
        }
    });
</script>
