{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Feature Tours</h2>
        <section>
            <form method="post" action="{{ routeLookup('featureTours.updateConfig')}}">
                <label>Enabled<span data-tooltip class="hint has-tip tip-bottom" title="Controls if files of this type can be uploaded">?</span></label>
                <span class="switch">
                    <input id="enabled" type="checkbox" name="enabled" {% if toursEnabled  %} checked {% endif %}/>
                    <label for="enabled">
                        <span>On</span>
                        <span>Off</span>
                    </label>
                </span>
                <input type="submit" value="Save" />
            </form>
        </section>
    </div>
</div>

