{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <h2 class="subheader">Feature Tours</h2>

            <form method="post" action="{{ routeLookup('featureTours.updateConfig') }}">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label id="tours_enabled" class="inline-block" for="tours_enabled-field">
                                <span class="required-with-tip">Enable Feature Tours</span>
                                <span data-tooltip class="hint has-tip tip-bottom" title="Enable or disable all feature tours system-wide.">?</span>
                            </label>
                            <div class="switch">
                                <input id="tours_enabled-field" type="checkbox" name="enabled" {% if toursEnabled %}checked{% endif %}/>
                                <label for="tours_enabled">
                                    <span>On</span>
                                    <span>Off</span>
                                </label>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="content {% if not toursEnabled %}hide{% endif %}" id="available-tours">
                        <legend>Available Tours</legend>

                        {% for tour in tours %}
                            <div class="small-12 columns">
                                <label for="tour-enable-{{ tour.uuid }}">
                                    {{ tour.title }}
                                    <span class="pipe meta" title="Will be seen by Staff">
                                        Staff
                                    </span>
                                </label>
                                <div class="switch">
                                    <input id="tour-enable-{{ tour.uuid }}" type="checkbox" name="tour-enable[]" value="{{ tour.uuid }}" {% if tour.active %}checked{% endif %}/>
                                    <label for="tour-enable-{{ tour.uuid }}">
                                        <span>On</span>
                                        <span>Off</span>
                                    </label>
                                </div>
                            </div>
                        {% endfor %}
                        </ul>
                    </fieldset>
                </section>

                <div class="row">
                    <div class="small-12 column">
                        <input type="submit" name="btnSubmit" value="Save">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // On change of global enable/disable - toggle show/hide of options
    $('#tours_enabled-field').change(function() {
        if ($(this).is(':checked')) {
            $('#available-tours').removeClass('hide');
        } else {
            $('#available-tours').addClass('hide');
        }
    });

    // The code below was copied from moduleConfig.twig. ///////////////////////////////////////////////////////////////

    /**
     * checks if a search result has been selected from #admin-settings-search.vue
     * so can highlight and scroll to the result accordingly
     *
     * @return {DOMElement} selected setting highlighted
     */
    const checkForAdminSearchHighlight = () => {
        const hash = window.location.hash.substr(1);
        const element = document.getElementById(hash);
        if (element) {
            element.parentElement.classList.add('highlight-selection');
            setTimeout(() => {
                element.parentElement.classList.remove('highlight-selection');
            }, 5000);
        }
        return element;
    }
    let currentHighlightedElement = checkForAdminSearchHighlight();

    /**
     * to handle additional search results selected that exist
     * on the same page, dispatched from #admin-settings-search.vue
     */
    document.addEventListener('admin-settings-search__on-result-selected', (event) => {
        if (currentHighlightedElement) {
            currentHighlightedElement.parentElement.classList.remove('highlight-selection');
        }
        currentHighlightedElement = checkForAdminSearchHighlight();
    });
</script>
