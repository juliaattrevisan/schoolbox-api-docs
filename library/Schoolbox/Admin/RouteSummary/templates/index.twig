{# Shared navigation menu #}
{{ renderAdminNavigation(pageCurrent) }}

{# show each term #}
<div class="row">
    <div class="small-12 island">

        <section>

            <table>
                <thead>
                <tr>
                    <th>Route</th>
                    <th>Path</th>
                    <th>Method</th>
                </tr>
                </thead>
                <tbody>
                {% for route in routes %}
                    <tr>
                        <td>{{ route.name }}</td>
                        <td>{{ route.path }}</td>
                        <td>{{ route.method }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

        </section>

    </div>
</div>
