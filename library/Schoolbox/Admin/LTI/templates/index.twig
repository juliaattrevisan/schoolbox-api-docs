{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        {% include '@settings/moduleConfig.twig' with configContext only %}
        <div class="small-12 island">
            {# show each provider #}
            <div class="row actions-small-1">
                <div class="list-item">
                    <div class="small-12 island">
                        <h2 class="subheader">LTI Tools</h2>
                    </div>
                </div>
                <nav>
                    <a href="#" data-reveal-id="addProviderModal" class="icon-add" title="Add LTI Tool"></a>
                </nav>
            </div>
            {% for provider in providers %}
            <section>
                {% include '@adminLti/listItem.twig' with {
                    provider:              provider,
                    providerLtiVersion11:  providerLtiVersion11,
                    providerLtiVersion13:  providerLtiVersion13,
                    providerTargetIframe:  providerTargetIframe,
                    providerTargetWindow:  providerTargetWindow,
                    identifier:            loop.index0,
                    issuer:                issuer,
                    oidcAuthenticationUrl: oidcAuthenticationUrl,
                    oauthAccessTokenUrl:   oauthAccessTokenUrl,
                    jsonWebKeySetUrl:      jsonWebKeySetUrl,
                } only %}
            </section>
            {% endfor %}

            {% if providers is empty %}
                <div class="empty-state">
                    <i class="icon-lti"></i>
                    <p>You have no LTI Tools currently installed. Start by <a href="#" data-reveal-id="addProviderModal">adding your first tool</a>.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<div id="addProviderModal" class="reveal-modal" data-reveal aria-labelledby="addProviderModalTitle" aria-hidden="true" role="dialog">
    <h2 id="addProviderModalTitle">Add Tools</h2>
    {% include '@adminLti/form.twig' with {
        providerLtiVersion11:  providerLtiVersion11,
        providerLtiVersion13:  providerLtiVersion13,
        providerTargetIframe:  providerTargetIframe,
        providerTargetWindow:  providerTargetWindow,
        identifier:            providers|length,
        issuer:                issuer,
        oidcAuthenticationUrl: oidcAuthenticationUrl,
        oauthAccessTokenUrl:   oauthAccessTokenUrl,
        jsonWebKeySetUrl:      jsonWebKeySetUrl,
    } only %}
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div id="errorModal" class="reveal-modal" data-reveal aria-labelledby="errorModalTitle" aria-hidden="true" role="dialog">
    <h2 id="errorModalTitle">Error</h2>
    <p class="alert alert-box icon-alert">Something went wrong - maybe try reloading your page and trying again?</p>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div id="toast" class="toast"></div>

<script type="text/javascript">
    $(function(){

        $('[data-collapser]').collapsable();

        // Set up forms: show/hide LTI inputs conditionally
        $('form[data-action="saveProvider"]').each(function () {
            let $form = $(this);
            $form.alaressValidate({
                ignore: function () {
                    // Any field for a different LTI version is ignored
                    let fieldLtiVersion = $(this).attr('data-lti-version');
                    if (fieldLtiVersion) {
                        let selectedLtiVersion = $form.find(':input[name="lti_version"]').val();
                        if (selectedLtiVersion !== fieldLtiVersion) {
                            return true;
                        }
                    }
                    return false;
                }
            });
            $form.on('change', ':input[name="lti_version"]', function () {
                let selectedLtiVersion = this.value;
                $form.find('[data-lti-version-section]').each(function () {
                    let segmentLtiVersion = $(this).attr('data-lti-version-section');
                    $(this).toggleClass('hide', segmentLtiVersion !== selectedLtiVersion);
                })
            });

            // Handle redirect URL addition and removal
            let $redirectUrls = $form.find('[data-redirect-urls]'),
                $redirectUrlList = $redirectUrls.find('[data-list]'),
                $redirectUrlTemplate = $redirectUrls.find('[data-template]'),
                newRedirectUrlCount = 1;
            $redirectUrls.on('click', '[data-action="add"]', function (event) {
                event.preventDefault();
                let $newRedirectUrlItem = $redirectUrlTemplate.clone().removeAttr('data-template').removeClass('hide');
                $newRedirectUrlItem.find(':input').each(function () {
                    let $input = $(this);
                    $input.attr('name', $input.attr('name').replace('-1', String(-newRedirectUrlCount)));
                });
                newRedirectUrlCount += 1;
                $redirectUrlList.append($newRedirectUrlItem);
            });
            $redirectUrls.on('click', '[data-action="delete"]', function (event) {
                event.preventDefault();
                $(this).closest('[data-item]').remove();
            });
        });

        let $content       = $('#content'),
            $toast         = $('#toast'),
            clipboardToast = {text: 'Copied!', css: 'success'};

        // Jellytot actions
        $content.on('click', 'a[data-provider-action]', function(event) {
            event.preventDefault();

            let button = $(this),
                action = button.data('providerAction'),
                provider   = button.closest('[data-provider]');

            button.confirmDialog({
                confirmEvent: function(el) {
                    // AJAX, then update DOM
                    // Delete: remove completely
                    $.post(el.data('postAction'))
                            .done(function(data) {
                                switch (action) {
                                    case 'delete':
                                        provider.fadeOut({ done: provider.remove });
                                        break;
                                }
                            })
                            .fail(function() {
                                // ¯\_(ツ)_/¯
                                $('#errorModal').foundation('reveal', 'open');
                            });
                }
            });
        });

        // Set up copy of inputs
        $content.on('click', 'a[data-clipboard-text]', function (event) {
            event.preventDefault();
            navigator.clipboard.writeText($(this).attr('data-clipboard-text'));
            $toast.toastActivate(clipboardToast);
            $toast.toastTimeout(clipboardToast)
        });
    });
</script>
