{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        {% include '@settings/moduleConfig.twig' with configContext only %}
        <div class="small-12 island">
            {# show each provider #}
            <div class="row actions-small-1">
                <div class="list-item">
                    <div class="small-12 island">
                        <h2 class="subheader">Menu Items</h2>
                    </div>
                </div>
                <nav>
                    <a href="#" data-reveal-id="addProviderModal" class="icon-add" title="Add LTI Provider"></a>
                </nav>
            </div>
            {% for provider in providers %}
            <section>
                {% include '@adminLti/listItem.twig' with {
                    provider: provider,
                    providerLtiVersion11: providerLtiVersion11,
                    providerLtiVersion13: providerLtiVersion13,
                    identifier: loop.index0,
                } only %}
            </section>
            {% endfor %}

            {% if providers is empty %}
                <div class="empty-state">
                    <i class="icon-lti"></i>
                    <p>You have no LTI providers currently installed. Start by <a href="#" data-reveal-id="addProviderModal">adding your first provider</a>.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<div id="addProviderModal" class="reveal-modal" data-reveal aria-labelledby="addProviderModalTitle" aria-hidden="true" role="dialog">
    <h2 id="addProviderModalTitle">Add Provider</h2>
    {% include '@adminLti/form.twig' with {
        providerLtiVersion11: providerLtiVersion11,
        providerLtiVersion13: providerLtiVersion13,
        identifier: providers|length,
    } only %}
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div id="errorModal" class="reveal-modal" data-reveal aria-labelledby="errorModalTitle" aria-hidden="true" role="dialog">
    <h2 id="errorModalTitle">Error</h2>
    <p class="alert alert-box icon-alert">Something went wrong - maybe try reloading your page and trying again?</p>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<script type="text/javascript">
    $(function(){

        $('[data-collapser]').collapsable();

        // Set up forms: show/hide LTI inputs conditionally
        $('form[data-action="saveProvider"]').each(function () {
            let $form = $(this);
            $form.alaressValidate({
                ignore: function () {
                    // Any field for a different LTI version is ignored
                    let fieldLtiVersion = $(this).attr('data-lti-version');
                    if (fieldLtiVersion) {
                        let selectedLtiVersion = $form.find(':input[name="lti_version"]').val();
                        if (selectedLtiVersion !== fieldLtiVersion) {
                            return true;
                        }
                    }
                    return false;
                }
            });
            $form.on('change', ':input[name="lti_version"]', function () {
                let selectedLtiVersion = this.value;
                $form.find('[data-lti-version-section]').each(function () {
                    let segmentLtiVersion = $(this).attr('data-lti-version-section');
                    $(this).toggleClass('hide', segmentLtiVersion !== selectedLtiVersion);
                })
            })
        });


        // Jellytot actions
        $('#content').on('click', 'a[data-provider-action]', function(event) {

            event.preventDefault();

            var button = $(this),
                action = button.data('providerAction'),
                provider   = button.closest('[data-provider]');

            button.confirmDialog({
                confirmEvent: function(el) {
                    // AJAX, then update DOM
                    // Delete: remove completely
                    $.post(el.data('postAction'))
                            .done(function(data) {
                                switch (action) {
                                    case 'delete':
                                        provider.fadeOut({ done: provider.remove });
                                        break;
                                }
                            })
                            .fail(function() {
                                // ¯\_(ツ)_/¯
                                $('#errorModal').foundation('reveal', 'open');
                            });
                }
            })
        });
    });
</script>
