<div class="actions-small-2" data-provider>
    <div class="list-item">
        <div class="card small-12" data-provider-infocard>
            <h3>
                {{ provider.name ?? '' }}
            </h3>
            <p class="meta">
                {% if provider.url is empty %}
                    <span class="gradient-0">Provider Disabled - No Launch URL detected</span>
                {% else %}
                    {{ provider.url ?? ''}}
                {% endif %}
            </p>
        </div>
    </div>
    <div class="small-12 column hide" data-collapse-state="collapsed" data-collapsable="provider-{{ identifier }}">
        {% include '@adminLti/form.twig' with {
            provider: provider,
            providerVersions: providerVersions,
            identifier: identifier,
        } only %}
    </div>
    <nav>
        <a href="#" class="icon-down-arrow" data-collapser="provider-{{ identifier }}"></a>
        <a href="#" class="icon-delete" data-provider-action="delete" data-post-action="{{ routeLookup('adminLti.postDelete', {providerId: provider.id}) }}"></a>
    </nav>
</div>
