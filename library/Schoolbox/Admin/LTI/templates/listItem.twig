<div class="actions-small-2" data-provider>
    <div class="list-item">
        <div class="card small-12" data-provider-infocard>
            <h3>
                {{ provider.name ?? '' }}
                {% if provider.isLtiVersion11 ?? false and provider.url is empty %}
                    <span class="label alert">Tool Disabled - No Launch URL detected</span>
                {% endif %}
            </h3>
        </div>
    </div>
    <div class="small-12 column hide" data-collapse-state="collapsed" data-collapsable="provider-{{ identifier }}">
        {% include '@adminLti/form.twig' with {
            provider:              provider,
            providerLtiVersion11:  providerLtiVersion11,
            providerLtiVersion13:  providerLtiVersion13,
            identifier:            identifier,
            issuer:                issuer,
            oidcAuthenticationUrl: oidcAuthenticationUrl,
            oauthAccessTokenUrl:   oauthAccessTokenUrl,
            jsonWebKeySetUrl:      jsonWebKeySetUrl,
        } only %}
    </div>
    <nav>
        <a href="#" class="icon-down-arrow" data-collapser="provider-{{ identifier }}"></a>
        <a href="#" class="icon-delete" data-provider-action="delete" data-post-action="{{ routeLookup('adminLti.postDelete', {providerId: provider.id}) }}"></a>
    </nav>
</div>
