{% if provider.id ?? false %}
    {% set saveValue = 'Update Tool' %}
    {% set saveType  = 'update' %}
    {% set isNew     = false %}
{% else %}
    {% set saveValue = 'Create Tool' %}
    {% set saveType  = 'create' %}
    {% set isNew     = true %}
{% endif %}

<form method="post" action="{{ routeLookup('adminLti.postModify') }}" data-action="saveProvider">
    <input type="hidden" name="id" value="{{ provider.id ?? '' }}">

    <fieldset>
        <legend>LTI Tool Identity</legend>
        <div class="small-12 large-6 columns">
            <label class="required" for="name-{{ identifier }}">
                Name
            </label>
            <input required id="name-{{ identifier }}" type="text" name="name" value="{{ provider.name ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label {% if isNew %}class="required"{% endif%} for="lti_version-{{ identifier }}">
                Version
            </label>
            {% if isNew %}
                <select required id="lti_version-{{ identifier }}" name="lti_version">
                    <option value="" readonly>-- select version --</option>
                    <option value="{{ providerLtiVersion13 }}" {% if (provider.isLtiVersion13 ?? false) %}selected{% endif %}>{{ providerLtiVersion13 }}</option>
                    <option value="{{ providerLtiVersion11 }}" {% if (provider.isLtiVersion11 ?? false) %}selected{% endif %}>{{ providerLtiVersion11 }}</option>
                </select>
            {% else %}
                <input readonly id="lti_version-{{ identifier }}" type="text" name="lti_version" value="{{ provider.ltiVersion ?? '' }}">
            {% endif %}
        </div>
    </fieldset>

    {# 1.3 configuration fields #}
    <fieldset {% if not (provider.isLtiVersion13 ?? false) %}class="hide"{% endif %} data-lti-version-section="{{ providerLtiVersion13 }}">
        <legend>Tool Configuration</legend>
        <div class="small-12 columns">
            <p class="meta">
                These details need to be copied from your LTI tool.
            </p>
        </div>
        <div class="small-12 large-6 columns">
            <label for="oidc_initiation_url-{{ identifier }}" class="required">
                OpenID Connect Initiation URL
            </label>
            <input required
                   data-lti-version="{{ providerLtiVersion13 }}"
                   id="oidc_initiation_url-{{ identifier }}"
                   type="text"
                   name="oidc_initiation_url"
                   value="{{ provider.oidcInitiationUrl ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="launch_url-{{ identifier }}">
                Launch URL
            </label>
            <input data-lti-version="{{ providerLtiVersion13 }}"
                   id="launch_url-{{ identifier }}"
                   type="text"
                   name="launch_url"
                   value="{{ provider.launchUrl ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="deep_linking_url-{{ identifier }}">
                Deep Linking URL
                <span data-tooltip
                      class="has-tip tip-top hint"
                      title="Usually, this will be the same as the Launch URL.">?</span>
            </label>
            <input data-lti-version="{{ providerLtiVersion13 }}"
                   id="deep_linking_url-{{ identifier }}"
                   type="text"
                   name="deep_linking_url"
                   value="{{ provider.deepLinkingUrl ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="jwks_url-{{ identifier }}">
                JSON Web Key Set URL
            </label>
            <input data-lti-version="{{ providerLtiVersion13 }}"
                   id="jwks_url-{{ identifier }}"
                   type="text"
                   name="jwks_url"
                   value="{{ provider.jwksUrl ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="public_key-{{ identifier }}">
                Public Key
                <span data-tooltip
                      class="has-tip tip-top hint"
                      title="Most tools will provide a JSON Web Key Set URL instead of directly providing the public key; in this case, this field may be left empty.">?</span>
            </label>
            <textarea data-lti-version="{{ providerLtiVersion13 }}"
                      id="public_key-{{ identifier }}"
                      type="text"
                      name="public_key"
                      rows="10"
            >{{ provider.publicKey ?? '' }}</textarea>
        </div>

        {# Redirect URLs are stored as individual models, but are displayed as a list for ease of editing. #}
        <div class="small-12 large-6 columns" data-redirect-urls>
            <label for="redirect_urls-{{ identifier }}">
                Additional Redirect URL(s)
                <span data-tooltip
                      class="has-tip tip-top hint"
                      title="Optional additional URLs which the LTI tool is permitted to request Schoolbox redirect to after OpenID Connect initiation; the Launch and Deep Linking URLs are always permitted, and need not be copied here.">?</span>
            </label>
            <ul class="information-list" data-list>
                <li class="list-item-container hide" data-template data-item>
                    <div class="actions-small-1">
                        <div class="list-item">
                            <input name="redirect_urls[-1][id]" type="hidden" />
                            <input name="redirect_urls[-1][redirect_url]" />
                        </div>
                        <nav><a class="delete-row-button icon-delete" title="Delete this Redirect URL" data-action="delete"></a></nav>
                    </div>
                </li>
                {% for i, redirectUrl in (provider.redirectUrls ?? []) %}
                <li class="list-item-container" data-item>
                    <div class="actions-small-1">
                        <div class="list-item">
                            <input name="redirect_urls[{{ i }}][id]" type="hidden" value="{{ redirectUrl.id }}" />
                            <input name="redirect_urls[{{ i }}][redirect_url]" value="{{ redirectUrl.redirectUrl }}" />
                        </div>
                        <nav><a class="delete-row-button icon-delete" title="Delete this Redirect URL" data-action="delete"></a></nav>
                    </div>
                </li>
                {% endfor %}
            </ul>
            <button class="full-width" data-action="add">Add Redirect URL</button>
        </div>

        <div class="small-12 large-6 columns">
            <label>
                Availability
            </label>
            <ul class="option-list">
                <li>
                    <input data-lti-version="{{ providerLtiVersion13 }}"
                           id="available_for_component-{{ identifier }}"
                           name="available_for_component"
                           type="checkbox"
                           {% if provider.availableForComponent ?? true %}checked{% endif %}
                    />
                    <label for="available_for_component-{{ identifier }}" class="checkbox-label">Homepage Components</label>
                </li>
                <li>
                    <input data-lti-version="{{ providerLtiVersion13 }}"
                           id="available_for_assessment-{{ identifier }}"
                           name="available_for_assessment"
                           type="checkbox"
                           {% if provider.availableForAssessment ?? true %}checked{% endif %}
                    />
                    <label for="available_for_assessment-{{ identifier }}" class="checkbox-label">3rd Party Assessments</label>
                </li>
            </ul>
        </div>

        <div class="small-12 large-6 end columns">
            <label for="target1p3-{{ identifier }}">
                Target
            </label>
            <select data-lti-version="{{ providerLtiVersion13 }}"
                    id="target1p3-{{ identifier }}"
                    name="target1p3">
                <option {% if provider is defined and provider.isTargetIframe %}selected{% endif %}
                        value="{{ providerTargetIframe }}">Iframe</option>
                <option {% if provider is defined and provider.isTargetWindow %}selected{% endif %}
                        value="{{ providerTargetWindow }}">New tab/window</option>
            </select>
        </div>
    </fieldset>

    {# 1.3 read-only Schoolbox instance fields #}
    <fieldset {% if not (provider.isLtiVersion13 ?? false) %}class="hide"{% endif %} data-lti-version-section="{{ providerLtiVersion13 }}">
        <legend>Schoolbox Instance Details</legend>
        <div class="small-12 columns">
            <p class="meta">
                These details are read-only, and need to be copied into your LTI tool's configuration.
            </p>
        </div>

        <div class="small-12 large-6 columns">
            <label for="platform_issuer-{{ identifier }}">
                Issuer
            </label>
            <div class="input-group">
                <input readonly
                       data-lti-version="{{ providerLtiVersion13 }}"
                       id="platform_issuer-{{ identifier }}"
                       type="text"
                       name="platform_issuer"
                       value="{{ issuer }}">
                <a href="#"
                   data-clipboard-text="{{ issuer }}"
                   class="button icon-copy">Copy</a>
            </div>
        </div>

        <div class="small-12 large-6 columns">
            <label for="platform_oidc_authentication_url-{{ identifier }}">
                OpenID Connect Authentication URL
            </label>
            <div class="input-group">
                <input readonly
                       data-lti-version="{{ providerLtiVersion13 }}"
                       id="platform_oidc_authentication_url-{{ identifier }}"
                       type="text"
                       name="platform_oidc_authentication_url"
                       value="{{ oidcAuthenticationUrl }}">
                <a href="#"
                   data-clipboard-text="{{ oidcAuthenticationUrl }}"
                   class="button icon-copy">Copy</a>
            </div>
        </div>

        <div class="small-12 large-6 columns">
            <label for="platform_oauth_access_token_url-{{ identifier }}">
                oAuth Access Token URL
            </label>
            <div class="input-group">
                <input readonly
                       data-lti-version="{{ providerLtiVersion13 }}"
                       id="platform_oauth_access_token_url-{{ identifier }}"
                       type="text"
                       name="platform_oauth_access_token_url"
                       value="{{ oauthAccessTokenUrl }}">
                <a href="#"
                   data-clipboard-text="{{ oauthAccessTokenUrl }}"
                   class="button icon-copy">Copy</a>
            </div>
        </div>

        <div class="small-12 large-6 columns">
            <label for="platform_jwks_url-{{ identifier }}">
                JSON Web Key Set URL
            </label>
            <div class="input-group">
                <input readonly
                       data-lti-version="{{ providerLtiVersion13 }}"
                       id="platform_jwks_url-{{ identifier }}"
                       type="text"
                       name="platform_jwks_url"
                       value="{{ jsonWebKeySetUrl }}">
                <a href="#"
                   data-clipboard-text="{{ jsonWebKeySetUrl }}"
                   class="button icon-copy">Copy</a>
            </div>
        </div>

        <div class="small-12 large-6 columns">
            <label for="deployment_id-{{ identifier }}">
                Client/Deployment ID
            </label>
            <div class="input-group">
                <input readonly
                       data-lti-version="{{ providerLtiVersion13 }}"
                       placeholder="(generated on creation)"
                       id="deployment_id-{{ identifier }}"
                       type="text"
                       name="deployment_id"
                       value="{{ provider.deploymentId ?? '' }}">
                <a href="#"
                   data-clipboard-text="{{ provider.deploymentId ?? '' }}"
                   class="button icon-copy {% if isNew %}disabled{% endif %}">Copy</a>
            </div>
        </div>
    </fieldset>

    {# 1.1 fields #}
    <fieldset {% if not (provider.isLtiVersion11 ?? false) %}class="hide"{% endif %} data-lti-version-section="{{ providerLtiVersion11 }}">
        <legend>Configuration</legend>
        <div class="small-12 large-6 columns">
            <label for="xml-{{ identifier }}">
                Configuration XML URL
                <span data-tooltip class="has-tip tip-top hint" title="If provided, Launch and Icon URL will be extracted from this configuration.">?</span>
            </label>
            <input data-lti-version="{{ providerLtiVersion11 }}"
                   id="xml-{{ identifier }}"
                   type="text"
                   name="xml"
                   value="{{ provider.xml ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="url-{{ identifier }}">
                Launch URL
            </label>
            <input data-lti-version="{{ providerLtiVersion11 }}"
                   id="url-{{ identifier }}"
                   type="text"
                   name="url"
                   value="{{ provider.url ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="icon-{{ identifier }}">
                Icon URL
            </label>
            <input data-lti-version="{{ providerLtiVersion11 }}"
                   id="icon-{{ identifier }}"
                   type="text"
                   name="icon"
                   value="{{ provider.icon ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="key-{{ identifier }}">
                Consumer Key
            </label>
            <input data-lti-version="{{ providerLtiVersion11 }}"
                   id="key-{{ identifier }}"
                   type="text"
                   name="key"
                   value="{{ provider.key ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="secret-{{ identifier }}">
                Consumer Secret
            </label>
            <input data-lti-version="{{ providerLtiVersion11 }}"
                   id="secret-{{ identifier }}"
                   type="text"
                   name="secret"
                   value="{{ provider.secret ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="launch_type-{{ identifier }}">
                LTI Request Type
            </label>
            <select data-lti-version="{{ providerLtiVersion11 }}"
                    id="launch_type-{{ identifier }}"
                    name="launch_type">
                <option {% if provider is defined and provider.launchType == 'LTI_LAUNCH_TYPE_BASIC' %}selected{% endif %} value="LTI_LAUNCH_TYPE_BASIC">Basic Launch</option>
                <option {% if provider is defined and provider.launchType == 'LTI_LAUNCH_TYPE_PICKER' %}selected{% endif %} value="LTI_LAUNCH_TYPE_PICKER">Picker</option>
            </select>
        </div>
        <div class="small-12 large-6 end columns">
            <label for="target1p1-{{ identifier }}">
                Target
            </label>
            <select data-lti-version="{{ providerLtiVersion11 }}"
                    id="target1p1-{{ identifier }}"
                    name="target1p1">
                <option {% if provider is defined and provider.isTargetIframe %}selected{% endif %}
                        value="{{ providerTargetIframe }}">Iframe</option>
                <option {% if provider is defined and provider.isTargetWindow %}selected{% endif %}
                        value="{{ providerTargetWindow }}">New tab/window</option>
            </select>
        </div>
    </fieldset>

    <input type="submit" value="{{ saveValue }}" />
</form>
