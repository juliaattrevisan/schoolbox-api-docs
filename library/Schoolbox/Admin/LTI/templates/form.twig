{% if provider.id ?? false %}
    {% set saveValue = 'Update Provider' %}
    {% set saveType  = 'update' %}
    {% set isNew     = false %}
{% else %}
    {% set saveValue = 'Create Provider' %}
    {% set saveType  = 'create' %}
    {% set isNew     = true %}
{% endif %}

<form method="post" action="{{ routeLookup('adminLti.postModify') }}" data-action="saveProvider">
    <input type="hidden" name="id" value="{{ provider.id ?? '' }}">

    <fieldset>
        <legend>Provider Identity</legend>
        <div class="small-12 large-6 columns">
            <label class="required" for="name-{{ identifier }}">
                Name
            </label>
            <input required id="name-{{ identifier }}" type="text" name="name" value="{{ provider.name ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label {% if isNew %}class="required"{% endif%} for="lti_version-{{ identifier }}">
                Version
            </label>
            {% if isNew %}
                <select required id="lti_version-{{ identifier }}" name="lti_version">
                    <option value="" readonly>-- select version --</option>
                    <option value="{{ providerLtiVersion13 }}" {% if (provider.isLtiVersion13 ?? false) %}selected{% endif %}>{{ providerLtiVersion13 }}</option>
                    <option value="{{ providerLtiVersion11 }}" {% if (provider.isLtiVersion11 ?? false) %}selected{% endif %}>{{ providerLtiVersion11 }}</option>
                </select>
            {% else %}
                <input readonly id="lti_version-{{ identifier }}" type="text" name="lti_version" value="{{ provider.ltiVersion ?? '' }}">
            {% endif %}
        </div>
    </fieldset>

    {# 1.3 configuration fields #}
    <fieldset {% if not (provider.isLtiVersion13 ?? false) %}class="hide"{% endif %} data-lti-version-section="{{ providerLtiVersion13 }}">
        <legend>Provider Configuration</legend>
        <div class="small-12 columns">
            <p class="meta">
                These details need to be copied from your LTI provider.
            </p>
        </div>
        <div class="small-12 large-6 columns">
            <label for="oidc_initiation_url-{{ identifier }}" class="required">
                OpenID Connect Initiation URL
            </label>
            <input required
                   data-lti-version="{{ providerLtiVersion13 }}"
                   id="oidc_initiation_url-{{ identifier }}"
                   type="text"
                   name="oidc_initiation_url"
                   value="{{ provider.oidcInitiationUrl ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="launch_url-{{ identifier }}">
                Launch URL
            </label>
            <input data-lti-version="{{ providerLtiVersion13 }}"
                   id="launch_url-{{ identifier }}"
                   type="text"
                   name="launch_url"
                   value="{{ provider.launchUrl ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="deep_linking_url-{{ identifier }}">
                Deep Linking URL
            </label>
            <input data-lti-version="{{ providerLtiVersion13 }}"
                   id="deep_linking_url-{{ identifier }}"
                   type="text"
                   name="deep_linking_url"
                   value="{{ provider.deepLinkingUrl ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="jwks_url-{{ identifier }}">
                JSON Web Key Set URL
            </label>
            <input data-lti-version="{{ providerLtiVersion13 }}"
                   id="jwks_url-{{ identifier }}"
                   type="text"
                   name="jwks_url"
                   value="{{ provider.jwksUrl ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="public_key-{{ identifier }}">
                Public Key
                <span data-tooltip
                      class="has-tip tip-top hint"
                      title="Most providers will provide a JSON Web Key Set URL instead of a key; this may be left blank if that URL is provided.">?</span>
            </label>
            <textarea data-lti-version="{{ providerLtiVersion13 }}"
                      id="public_key-{{ identifier }}"
                      type="text"
                      name="public_key"
                      rows="10"
            >{{ provider.publicKey ?? '' }}</textarea>
        </div>
    </fieldset>

    {# 1.3 read-only Schoolbox instance fields #}
    <fieldset {% if not (provider.isLtiVersion13 ?? false) %}class="hide"{% endif %} data-lti-version-section="{{ providerLtiVersion13 }}">
        <legend>Schoolbox Instance Details</legend>
        <div class="small-12 columns">
            <p class="meta">
                These details are read-only, and need to be copied into your LTI provider's configuration.
            </p>
        </div>
        <div class="small-12 large-6 columns">
            <label for="platform_oidc_authentication_url-{{ identifier }}">
                OpenID Connect Authentication URL
            </label>
            <input readonly
                   data-lti-version="{{ providerLtiVersion13 }}"
                   id="platform_oidc_authentication_url-{{ identifier }}"
                   type="text"
                   name="platform_oidc_authentication_url"
                   value="{{ oidcAuthenticationUrl }}">
        </div>

        <div class="small-12 large-6 columns">
            <label for="platform_oauth_access_token_url-{{ identifier }}">
                oAuth Access Token URL
            </label>
            <input readonly
                   data-lti-version="{{ providerLtiVersion13 }}"
                   id="platform_oauth_access_token_url-{{ identifier }}"
                   type="text"
                   name="platform_oauth_access_token_url"
                   value="{{ oauthAccessTokenUrl }}">
        </div>

        <div class="small-12 large-6 columns">
            <label for="platform_jwks_url-{{ identifier }}">
                JSON Web Key Set URL
            </label>
            <input readonly
                   data-lti-version="{{ providerLtiVersion13 }}"
                   id="platform_jwks_url-{{ identifier }}"
                   type="text"
                   name="platform_jwks_url"
                   value="{{ jsonWebKeySetUrl }}">
        </div>

        <div class="small-12 large-6 columns">
            <label for="deployment_id-{{ identifier }}">
                Client/Deployment ID
            </label>
            <input readonly
                   data-lti-version="{{ providerLtiVersion13 }}"
                   placeholder="(generated on creation)"
                   id="deployment_id-{{ identifier }}"
                   type="text"
                   name="deployment_id"
                   value="{{ provider.deploymentId ?? '' }}">
        </div>
    </fieldset>

    {# 1.1 fields #}
    <fieldset {% if not (provider.isLtiVersion11 ?? false) %}class="hide"{% endif %} data-lti-version-section="{{ providerLtiVersion11 }}">
        <legend>Configuration</legend>
        <div class="small-12 large-6 columns">
            <label for="xml-{{ identifier }}">
                Configuration XML URL
                <span data-tooltip class="has-tip tip-top hint" title="If provided, Launch and Icon URL will be extracted from this configuration.">?</span>
            </label>
            <input data-lti-version="{{ providerLtiVersion11 }}"
                   id="xml-{{ identifier }}"
                   type="text"
                   name="xml"
                   value="{{ provider.xml ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="url-{{ identifier }}">
                Launch URL
            </label>
            <input data-lti-version="{{ providerLtiVersion11 }}"
                   id="url-{{ identifier }}"
                   type="text"
                   name="url"
                   value="{{ provider.url ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="icon-{{ identifier }}">
                Icon URL
            </label>
            <input data-lti-version="{{ providerLtiVersion11 }}"
                   id="icon-{{ identifier }}"
                   type="text"
                   name="icon"
                   value="{{ provider.icon ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="key-{{ identifier }}">
                Consumer Key
            </label>
            <input data-lti-version="{{ providerLtiVersion11 }}"
                   id="key-{{ identifier }}"
                   type="text"
                   name="key"
                   value="{{ provider.key ?? '' }}">
        </div>
        <div class="small-12 large-6 columns">
            <label for="secret-{{ identifier }}">
                Consumer Secret
            </label>
            <input data-lti-version="{{ providerLtiVersion11 }}"
                   id="secret-{{ identifier }}"
                   type="text"
                   name="secret"
                   value="{{ provider.secret ?? '' }}">
        </div>
        <div class="small-12 columns">
            <label for="launch_type-{{ identifier }}">
                LTI Request Type
            </label>
            <select data-lti-version="{{ providerLtiVersion11 }}"
                    id="launch_type-{{ identifier }}"
                    name="launch_type">
                <option {% if provider is defined and provider.launchType == 'LTI_LAUNCH_TYPE_BASIC' %}selected{% endif %} value="LTI_LAUNCH_TYPE_BASIC">Basic Launch</option>
                <option {% if provider is defined and provider.launchType == 'LTI_LAUNCH_TYPE_PICKER' %}selected{% endif %} value="LTI_LAUNCH_TYPE_PICKER">Picker</option>
            </select>
        </div>
    </fieldset>

    <input type="submit" value="{{ saveValue }}" />
</form>
