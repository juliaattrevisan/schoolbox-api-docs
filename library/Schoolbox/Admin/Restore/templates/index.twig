{% autoescape 'js' %}
<script>
    $(function() {
        var $toast = $('[data-toast]');

        $('[data-restore]').click(function(event) {
            event.preventDefault();
            let object = $(event.target).attr('data-restore-type'),
                href = $(event.target).attr('data-restore-href');
            $(this).confirmDialog({
                text: 'Are you sure you want to recover this ' + object + '?',
                confirmEvent: function() {
                    var config = {text: 'Restoring ' + object + '...'};
                    $toast.toastActivate(config);

                    $.ajax({
                        type: 'POST',
                        url: href,
                        dataType: 'json',
                        data: {
                            id: $(event.target).attr('data-restore-id')
                        }
                    })
                        .done(function() {
                            $toast.toastTimeout({
                                text: object + ' recovered!',
                                css: 'success'
                            });
                            $(event.target).closest('tr').remove();
                        })
                        .fail(function(response) {
                            var temp = $.parseJSON(response.responseText);

                            $toast.toastTimeout({
                                text: temp.message,
                                css: 'alert'
                            });
                        });
                }
            });
        });
    });
</script>
{% endautoescape %}

<style>
/* to allow horizontal scrolling of tables within the tabs */
.tabs-content > .content.active {
    overflow-x: auto;
}
</style>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <dl class="tabs" data-tab>
                <dd class="active"><a href="#panel1-1">Folder</a></dd>
                <dd><a href="#panel1-2">Learning Activity</a></dd>
                <dd><a href="#panel1-3">Users</a></dd>
                <dd><a href="#panel1-4">Files</a></dd>
                <dd><a href="#panel1-5">Courses</a></dd>
                <dd><a href="#panel1-6">Units</a></dd>
                <dd><a href="#panel1-7">Imported Courses</a></dd>
                <dd><a href="#panel1-8">Imported Units</a></dd>
            </dl>
            <section class="content tabs-content">
                <div class="content active" id="panel1-1">
                    <table>
                        <thead>
                        <tr>
                            <td>Folder Name</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for folder in deletedFolders %}
                        <tr>
                            <td>{{ folder.nameWithCodes }}</td>
                            <td>{{ folder.deletedAt.long }}</td>
                            <td><a data-restore data-restore-id="{{ folder.id }}" data-restore-href="{{ routeLookup('restore.restoreFolder') }}" data-restore-type="Folder" href="#" class="icon-upload" title="Restore"></a></td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="content" id="panel1-2">
                    <table>
                        <thead>
                        <tr>
                            <td>Activity Name</td>
                            <td>Type</td>
                            <td>Location</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for assessment in deletedAssessments %}
                        <tr>
                            <td>{{ assessment.title }}</td>
                            <td>
                                {% set assessmentType = '' %}
                                {% if assessment.hasProject %}
                                    {% set assessmentType = assessmentTypes.project %}
                                {% elseif assessment.hasTask %}
                                    {% set assessmentType = assessmentTypes.task %}
                                {% elseif assessment.hasQuiz %}
                                    {% set assessmentType = assessmentTypes.quiz %}
                                {% elseif assessment.hasDueWork %}
                                    {% set assessmentType = assessmentTypes.dueWork %}
                                {% elseif assessment.hasLtiAssessment %}
                                    {% set assessmentType = assessmentTypes.lti %}
                                {% elseif assessment.hasLessonPlan %}
                                    {% set assessmentType = assessmentTypes.lessonPlan %}
                                {% endif %}
                                {{ assessmentType }}
                            </td>
                            <td>{{ assessment.assessmentContext.folder.nameWithCodes }}</td>
                            <td>{{ assessment.deletedAt.long }}</td>
                            <td><span><a data-restore data-restore-id="{{ assessment.id }}" data-restore-href="{{ routeLookup('restore.restoreAssessment') }}" data-restore-type="Assessment" href="#" class="icon-upload" title="Restore"></a></span></td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="content" id="panel1-3">
                    <table>
                        <thead>
                        <tr>
                            <td>User</td>
                            <td>Role/type</td>
                            <td>Campus</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for user in deletedUsers %}
                            <tr>
                                <td>{{ user.getFullName }}{% if user.getExternalId %} ({{ user.getExternalId }}){% endif %}</td>
                                <td>{{ user.getRole.getName }}/{{ user.getRole.getType }}</td>
                                <td>{% for campus in user.getCampusCollection %}{{ campus.name }}<br>{% endfor %}</td>
                                <td>{{ user.deletedAt.long }}</td>
                                <td><a data-restore data-restore-id="{{ user.id }}" data-restore-href="{{ routeLookup('restore.restoreUser') }}" data-restore-type="User" href="#" class="icon-upload" title="Restore"></a></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="content" id="panel1-4">
                    <table>
                        <thead>
                        <tr>
                            <td>File</td>
                            <td>Location</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for file in deletedFiles %}
                            <tr>
                                <td>{{ file.getBaseName }}</td>
                                <td><a href="/resources/{{ file.getFolder.getId }}">{{ file.getFolder.getTitle }}</a></td>
                                <td>{{ file.deletedAt.long }}</td>
                                <td><a data-restore data-restore-id="{{ file.id }}" data-restore-href="{{ routeLookup('restore.restoreFile') }}" data-restore-type="File" href="#" class="icon-upload" title="Restore"></a></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {# Course / unit #}
                <div class="content" id="panel1-5">
                    <table>
                        <thead>
                        <tr>
                            <td>Course</td>
                            <td>Location</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for course in deletedCourseSpec %}
                            <tr>
                                <td>{{ course.getTitle }}</td>
                                <td><a href="/resources/{{ course.getFolder.getId }}">{{ course.getFolder.getTitle }}</a></td>
                                <td>{{ course.deletedAt.long }}</td>
                                <td><a data-restore data-restore-id="{{ course.id }}" data-restore-href="{{ routeLookup('restore.restoreCourseSpec') }}" data-restore-type="Course" href="#" class="icon-upload" title="Restore"></a></td>
                            </tr>
                        {% endfor %}
                        </tbody>

                    </table>
                </div>
                <div class="content" id="panel1-6">
                    <table>
                        <thead>
                        <tr>
                            <td>Unit</td>
                            <td>Course</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for unit in deletedUnitSpec %}
                            <tr>
                                <td>{{ unit.getTitle }}</td>
                                <td><a href="{{ routeLookupIfAuthorized('course.modifyCourse', {courseSpec: unit.getCourse, id: unit.getCourse.getId})  }}">{{ unit.getCourse.getTitle }}</a></td>
                                <td>{{ unit.deletedAt.long }}</td>
                                <td><a data-restore data-restore-id="{{ unit.id }}" data-restore-href="{{ routeLookup('restore.restoreUnitSpec') }}" data-restore-type="Unit" href="#" class="icon-upload" title="Restore"></a></td>
                            </tr>
                        {% endfor %}
                        </tbody>

                    </table>
                </div>
                <div class="content" id="panel1-7">
                    <table>
                        <thead>
                        <tr>
                            <td>Course</td>
                            <td>Location</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for course in deletedCourseImpl %}
                            <tr>
                                <td>{{ course.getSpecification.getTitle }}</td>
                                <td><a href="/resources/{{ course.getFolder.getId }}">{{ course.getFolder.getTitle }}</a></td>
                                <td>{{ course.deletedAt.long }}</td>
                                <td><a data-restore data-restore-id="{{ course.id }}" data-restore-href="{{ routeLookup('restore.restoreCourseImpl') }}" data-restore-type="Course" href="#" class="icon-upload" title="Restore"></a></td>
                            </tr>
                        {% endfor %}
                        </tbody>

                    </table>
                </div>
                <div class="content" id="panel1-8">
                    <table>
                        <thead>
                        <tr>
                            <td>Unit</td>
                            <td>Location</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for unit in deletedUnitImpl %}
                            <tr>
                                <td>{{ unit.getTitle }}</td>
                                <td><a href="/resources/{{ unit.getFolder.getId }}">{{ unit.getFolder.getTitle }}</a></td>
                                <td>{{ unit.deletedAt.long }}</td>
                                <td><a data-restore data-restore-id="{{ unit.id }}" data-restore-href="{{ routeLookup('restore.restoreUnitImpl') }}" data-restore-type="Unit" href="#" class="icon-upload" title="Restore"></a></td>
                            </tr>
                        {% endfor %}
                        </tbody>

                    </table>
                </div>
            </section>
        </div>
    </div>
</div>
<div id='toaster' class="toast" data-toast></div>
