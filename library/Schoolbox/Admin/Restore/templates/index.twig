{% autoescape 'js' %}
<script>
    $(function() {
        var $toast = $('[data-toast]');

        $('[data-restore-folder]').click(function(event) {
            event.preventDefault();
            $(this).confirmDialog({
                text: 'Are you sure you want to recover this folder?',
                confirmEvent: function() {
                    var config = {text: 'Restoring folder...'};
                    $toast.toastActivate(config);

                    $.ajax({
                        type: 'POST',
                        url: "{{ routeLookup('restore.restoreFolder') }}",
                        dataType: 'json',
                        data: {
                            id: $(event.target).attr('data-restore-folder')
                        }
                    })
                    .done(function() {
                        $toast.toastTimeout({
                            text: 'Folder recovered!',
                            css: 'success'
                        });
                        $(event.target).closest('tr').remove();
                    })
                    .fail(function(response) {
                        var temp = $.parseJSON(response.responseText);

                        $toast.toastTimeout({
                            text: temp.message,
                            css: 'alert'
                        });
                    });
                }
            });
        });

        $('[data-restore-assessment]').click(function(event) {
            event.preventDefault();
            $(this).confirmDialog({
                text: 'Are you sure you want to recover this activity?',
                confirmEvent: function() {
                    var config = {text: 'Restoring activity...'};
                    $toast.toastActivate(config);

                    $.ajax({
                        type: 'POST',
                        url: "{{ routeLookup('restore.restoreAssessment') }}",
                        dataType: 'json',
                        data: {
                            id: $(event.target).attr('data-restore-assessment')
                        }
                    })
                    .done(function() {
                        $toast.toastTimeout({
                            text: 'Activity recovered!',
                            css: 'success'
                        });
                        $(event.target).closest('tr').remove();
                    })
                    .fail(function(response) {
                        var temp = $.parseJSON(response.responseText);

                        $toast.toastTimeout({
                            text: temp.message,
                            css: 'alert'
                        });
                    });
                }
            });
        });

        $('[data-restore-user]').click(function(event) {
            event.preventDefault();
            $(this).confirmDialog({
                text: 'Are you sure you want to recover this user?',
                confirmEvent: function() {
                    var config = {text: 'Restoring user...'};
                    $toast.toastActivate(config);

                    $.ajax({
                        type: 'POST',
                        url: "{{ routeLookup('restore.restoreUser') }}",
                        dataType: 'json',
                        data: {
                            id: $(event.target).attr('data-restore-user')
                        }
                    })
                        .done(function() {
                            $toast.toastTimeout({
                                text: 'User recovered!',
                                css: 'success'
                            });
                            $(event.target).closest('tr').remove();
                        })
                        .fail(function(response) {
                            var temp = $.parseJSON(response.responseText);

                            $toast.toastTimeout({
                                text: temp.message,
                                css: 'alert'
                            });
                        });
                }
            });
        });

        $('[data-restore-file]').click(function(event) {
            event.preventDefault();
            $(this).confirmDialog({
                text: 'Are you sure you want to recover this file?',
                confirmEvent: function() {
                    var config = {text: 'Restoring file...'};
                    $toast.toastActivate(config);

                    $.ajax({
                        type: 'POST',
                        url: "{{ routeLookup('restore.restoreFile') }}",
                        dataType: 'json',
                        data: {
                            id: $(event.target).attr('data-restore-file')
                        }
                    })
                        .done(function() {
                            $toast.toastTimeout({
                                text: 'File recovered!',
                                css: 'success'
                            });
                            $(event.target).closest('tr').remove();
                        })
                        .fail(function(response) {
                            var temp = $.parseJSON(response.responseText);

                            $toast.toastTimeout({
                                text: temp.message,
                                css: 'alert'
                            });
                        });
                }
            });
        });
    });
</script>
{% endautoescape %}

<style>
/* to allow horizontal scrolling of tables within the tabs */
.tabs-content > .content.active {
    overflow-x: auto;
}
</style>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <dl class="tabs" data-tab>
                <dd class="active"><a href="#panel1-1">Folder</a></dd>
                <dd><a href="#panel1-2">Learning Activity</a></dd>
                <dd><a href="#panel1-3">Users</a></dd>
                <dd><a href="#panel1-4">Files</a></dd>
            </dl>
            <section class="content tabs-content">
                <div class="content active" id="panel1-1">
                    <table>
                        <thead>
                        <tr>
                            <td>Folder Name</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for folder in deletedFolders %}
                        <tr>
                            <td>{{ folder.nameWithCodes }}</td>
                            <td>{{ folder.deletedAt.long }}</td>
                            <td><a data-restore-folder="{{ folder.id }}" href="#" class="icon-upload" title="Restore"></a></td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="content" id="panel1-2">
                    <table>
                        <thead>
                        <tr>
                            <td>Activity Name</td>
                            <td>Type</td>
                            <td>Location</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for assessment in deletedAssessments %}
                        <tr>
                            <td>{{ assessment.title }}</td>
                            <td>
                                {% set assessmentType = '' %}
                                {% if assessment.hasProject %}
                                    {% set assessmentType = assessmentTypes.project %}
                                {% elseif assessment.hasTask %}
                                    {% set assessmentType = assessmentTypes.task %}
                                {% elseif assessment.hasQuiz %}
                                    {% set assessmentType = assessmentTypes.quiz %}
                                {% elseif assessment.hasDueWork %}
                                    {% set assessmentType = assessmentTypes.dueWork %}
                                {% elseif assessment.hasLtiAssessment %}
                                    {% set assessmentType = assessmentTypes.lti %}
                                {% elseif assessment.hasLessonPlan %}
                                    {% set assessmentType = assessmentTypes.lessonPlan %}
                                {% endif %}
                                {{ assessmentType }}
                            </td>
                            <td>{{ assessment.assessmentContext.folder.nameWithCodes }}</td>
                            <td>{{ assessment.deletedAt.long }}</td>
                            <td><span><a data-restore-assessment="{{ assessment.id }}" href="#" class="icon-upload" title="Restore"></a></span></td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="content" id="panel1-3">
                    <table>
                        <thead>
                        <tr>
                            <td>User</td>
                            <td>Role/type</td>
                            <td>Campus</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for user in deletedUsers %}
                            <tr>
                                <td>{{ user.getFullName }}{% if user.getExternalId %} ({{ user.getExternalId }}){% endif %}</td>
                                <td>{{ user.getRole.getName }}/{{ user.getRole.getType }}</td>
                                <td>{% for campus in user.getCampusCollection %}{{ campus.name }}<br>{% endfor %}</td>
                                <td>{{ user.deletedAt.long }}</td>
                                <td><a data-restore-user="{{ user.id }}" href="#" class="icon-upload" title="Restore"></a></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="content" id="panel1-4">
                    <table>
                        <thead>
                        <tr>
                            <td>File</td>
                            <td>Location</td>
                            <td>Deleted On</td>
                            <td>Restore</td>
                        </tr>
                        </thead>
                        <tbody>
                        {% for file in deletedFiles %}
                            <tr>
                                <td>{{ file.getBaseName }}</td>
                                <td><a href="/resources/{{ file.getFolder.getId }}">{{ file.getFolder.getTitle }}</a></td>
                                <td>{{ file.deletedAt.long }}</td>
                                <td><a data-restore-file="{{ file.id }}" href="#" class="icon-upload" title="Restore"></a></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</div>
<div id='toaster' class="toast" data-toast></div>
