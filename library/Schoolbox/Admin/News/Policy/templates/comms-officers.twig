{##
 # Comms Officers
 #
 # A list of people who have the Comms Officer service permission
 #
 # @param Collection|User[] commsOfficers
 #}
<div class="small-12 island">
    <h2 class="subheader">News Moderators</h2>
    {% if commsOfficers|length %}
    <section>
        <ul class="grid medium-block-grid-2 large-block-grid-4">
            {% for officer in commsOfficers %}
            <li>
                <div class="card small-12">
                    <a href="/search/user/{{ officer.id }}" title="View Profile">
                        {% include 'include/portrait.twig' with {user: officer} only %}
                        <p>{{ officer.fullname }}</p>
                    </a>
                    <p class="meta">{{ officer.role.name }}</p>
                </div>

            </li>
            {% endfor %}
        </ul>
    </section>
    {% else %}
    <div class="empty-state">
        <i class="icon-staff-students"></i>
        <p>There are currently no news moderators setup.</p>
        {% if USER.isSuperuser %}
        <p><a href="/adminv2/user" title="Add Comms Officers">Assign news moderation service permissions</a> to a user via the user modify page.</p>
        {% endif %}
    </div>
    {% endif %}
</div>
