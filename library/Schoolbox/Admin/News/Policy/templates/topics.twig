{##
 # Topics
 #
 # A list of topics that were defined by superuser
 # Because selectize, but it's also a handy reference I suppose
 #
 # @param Collection|Topic[] topics
 #}
<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader" id="topics">News Topics</h2>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if topics|length %}
            <section>
                <ul class="information-list">

                    {# TODO: Probably add a url to the topic's index page
                     # So you can see all the articles associated with that topic
                     #}
                    {% for topic in topics %}
                        <li class="content">{{ topic.name }}</li>
                    {% endfor %}
                </ul>
                <div class="component-action">
                    <section>
                        <a href="/adminv2/lists/news-topic" class="button">Modify List</a>
                    </section>
                </div>
            </section>

        {% else %}
            <div class="empty-state">
                <i class="icon-news"></i>
                <p>{{ locale.news.proper }} topics haven't been created.</p>

                {% set topicRoute = routeLookupIfAuthorized('adminLists.getNewsIndex', {table: 'news-topic'}) %}

                {% if topicRoute %}
                <p><a href="{{ topicRoute }}" title="Define {{ locale.news }} topics">Define {{ locale.news }} topics</a> so that content creators can categorise their articles.</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
