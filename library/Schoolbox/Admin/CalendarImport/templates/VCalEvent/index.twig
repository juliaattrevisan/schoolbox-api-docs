{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(breadcrumbs) }}

<div class="admin-container row">

    {{ renderAdminNavigation(routeLookup('adminCalendarImport.getCalendarVcalImportForm')) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <div class="row">
                <div class="island small-12">
                    <section class="content">
                        <h3>Microsoft Outlook ICS</h3>
                        <ol>
                            <li>In Outlook, click calendar in the bottom left</li>
                            <li>Go to File, Save As</li>
                            <li>Choose iCalendar format (*.ics)</li>
                            <li>Click 'More Options'</li>
                            <li>Change Detail from Availability Only to Full Details</li>
                            <li>Click OK</li>
                            <li>Save it</li>
                            <li>Upload by clicking 'choose file' under "Upload new calendar entries"</li>
                        </ol>
                    </section>
                </div>
            </div>

            <h2 class="subheader">Select file</h2>

            <div class="row">
                <div class="small-12 island">
                    <form method="post" enctype="multipart/form-data" name="form" id="importForm"
                    action="{{ routeLookupIfAuthorized('adminCalendarImport.postCalendarVcalImportForm') }}">
                        <section>
                            <fieldset class="content">
                                <div class="small-12 columns">
                                    {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
                                    <input type="hidden" name="bulkadd-file" id="bulkadd-file" />
                                </div>
                                <div class="small-12 medium-6 columns">
                                    <label>
                                        Campus
                                        <span class="hint has-tip tip-right" data-tooltip title="Select the campuses that will be able to view these events">?</span>
                                    </label>
                                    <ul class="option-list">
                                        {% for campus in campusList %}
                                        <li>
                                            <input id="campus-{{ campus.id }}" type="checkbox" name="campusList[]" data-checkbox-group="campusList" value="{{ campus.id }}" />
                                            <label for="campus-{{ campus.id }}" class="checkbox-label">{{ campus.name }}</label>
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div class="small-12 medium-6 columns">
                                    <label>
                                        Roles
                                        <span class="hint has-tip tip-right" data-tooltip title="Select the roles that will be able to view these events">?</span>
                                    </label>
                                    <ul class="option-list">
                                        {% for role in roleList %}
                                        <li>
                                            <input id="role-{{ role.id }}" type="checkbox" name="userGroup[]" data-checkbox-group="userGroup" value="{{ role.id }}" />
                                            <label for="role-{{ role.id }}" class="checkbox-label">{{ role.name }}</label>
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div class="small-12 columns">
                                    <label>Event Owner</label>
                                    <p class="meta">The owner of the events.
                                        This field is optional: it will only be used if the 'Event Owner' column is not included.
                                        If the 'Event Owner' column is not included and no user is provided here, the current user will be used.</p>
                                    <label>
                                        <input name="name" id="name" type="text" placeholder="Search Users" />
                                    </label>
                                    <input name="userid" type="hidden" id="userid" size="6" maxlength="6" />
                                </div>
                            </fieldset>
                        </section>

                        <input type="submit" value="Preview" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        $('#name')
                .userSelectizeSelector({
                    ajax: {
                        data:     {groupID: 0},
                    }
                })
                .on('selectize.item_add', function(event, value) {
                    $('#userid').val(value)
                })
                .on('selectize.item_remove', function() {
                    $('#userid').val('')
                });
    });
</script>
<script>
    //Checkbox validation
    $('#importForm').alaressValidate({
        rules: {
            "campusList[]": {
                oneCheckbox: "campusList",
            },
            "userGroup[]": {
                oneCheckbox: "userGroup",
            },
            "bulkadd-file": {
                required: {
                    depends: function () {
                        return document.getElementById("bulkadd-zone").querySelector("[data-dz-previews]").children.length === 0;
                    },
                },
            }
        },
        messages: {
            "bulkadd-file": "Pleaes add a file to import"
        }
    });
</script>
