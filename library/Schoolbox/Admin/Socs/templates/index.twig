{##
 # Configure SOCS integration settings.
 #
 # @param array allBreadcrumbs // The breadcrumbs for the page.
 # @param string pageCurrent The current page name, used to highlight the correct navigation item.
 # @param array configContext // The config entries for the SOCS settings.
 # @param int calendarMaxFailed the const Calendar_Api_Config_Record::MAXFAILED
 # @param array subscriptions {calendarEvents: Calendar_Api_Config_Record, musicLessons: Calendar_Api_Config_Record} subscriptions SOCS calendar subscription data.
#}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div id="option-container">
            <div class="small-12 columns">
                <div class="actions-small-1">
                    <div class="list-item">
                        <h2 class="subheader">SOCS System Settings</h2>
                    </div>
                </div>
            </div>

            {# if socs Calendar Import has failed, there may be a creds issue #}
            {% if subscriptions.calendarEvents.failedCount >= calendarMaxFailed or subscriptions.musicLessons.failedCount >= calendarMaxFailed %}
                <div class="small-12 island">
                    <div class="alert-box alert">
                        {% if subscriptions.calendarEvents.failedCount >= calendarMaxFailed %}
                            The <strong>Calendar Events Import</strong> has failed {{ subscriptions.calendarEvents.failedCount }} times.<br>
                        {% endif %}

                        {% if subscriptions.musicLessons.failedCount >= calendarMaxFailed %}
                            The <strong>Music Lessons Import</strong> has failed {{ subscriptions.musicLessons.failedCount }} times.<br>
                        {% endif %}
                        It may be one of the following issues:<br>
                        <ul>
                            <li>The request to the remote server has timed out. </li>
                            <li>The remote server is unavailable.</li>
                            <li>The General Feed Host is incorrect.</li>
                            <li>The SOCS Endpoint ID is incorrect.</li>
                            <li>The SOCS Endpoint Token is incorrect or expired.</li>
                        </ul>
                    </div>
                </div>
            {% endif %}

            {% include '@settings/moduleConfig.twig' with configContext only %}
        </div>
    </div>
</div>
