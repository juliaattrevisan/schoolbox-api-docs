{##
 # Configure SOCS integration settings.
 #
 # @param array allBreadcrumbs // The breadcrumbs for the page.
 # @param string pageCurrent The current page name, used to highlight the correct navigation item.
 # @param array configContext // The config entries for the SOCS settings.
 # @param int calendarMaxFailed the const Calendar_Api_Config_Record::MAXFAILED
 # @param array musicLessonsSub // SOCS Music Lessons Import subscription data
 # @param array calendarEventsSub // SOCS Calendar Events Import subscription data
#}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div id="option-container">
            <div class="small-12 columns">
                <div class="actions-small-1">
                    <div class="list-item">
                        <h2 class="subheader">SOCS System Settings</h2>
                    </div>
                </div>
            </div>

            {# if socs Calendar Events Import has failed, there may be a creds issue #}
            {% if calendarEventsSub.failedCount >= calendarMaxFailed %}
                <div class="small-12 island">
                    <div class="alert-box alert">
                        The Calendar Events Import has failed {{ calendarEventsSub.failedCount }} times.<br>
                        It may be one of the following issues:<br>
                        <ul>
                            <li>The request to the remote server has timed out. </li>
                            <li>The remote server is unavailable.</li>
                            <li>The Authorisation token is malformed or expired.</li>
                        </ul>
                    </div>
                </div>
            {% endif %}

            {# if socs Music Lessons Import has failed, there may be a creds issue #}
            {% if musicLessonsSub.failedCount >= calendarMaxFailed %}
                <div class="small-12 island">
                    <div class="alert-box alert">
                        The Music Lessons Import has failed {{ musicLessonsSub.failedCount }} times.<br>
                        It may be one of the following issues:<br>
                        <ul>
                            <li>The request to the remote server has timed out. </li>
                            <li>The remote server is unavailable.</li>
                            <li>The Authorisation token is malformed or expired.</li>
                        </ul>
                    </div>
                </div>
            {% endif %}

            {% include '@settings/moduleConfig.twig' with configContext only %}
        </div>
    </div>
</div>
