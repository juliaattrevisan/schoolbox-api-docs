{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">
    {{ renderAdminNavigation(pageCurrent) }}
    <div class="admin-content">
        <div id="skin-config-container">
            <skin-config
                post-route="{{ routeLookup('adminDesignSkinConfig.postConfig') }}"
                preview-route="{{ routeLookup('adminDesignSkinConfig.previewCss') }}"
                :configs="{{ configs|json_encode }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/colourPicker.js?v={{ config.site_version }}"></script>
        <script src="{{ CDN_PREFIX }}/js/bundle/skinConfig.js?v={{ config.site_version }}"></script>
    </div>
</div>
