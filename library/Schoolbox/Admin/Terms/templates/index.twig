{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

{# show each term #}
<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <section>
                <ul class="action-list">
                    {% for term in terms %}
                        {% include '@adminTerms/listItem.twig' with {term: term} %}
                    {% endfor %}
                </ul>
            </section>
            <a href="#" class="button submit" data-reveal-id="addTermModal">Add Academic Period</a>
        </div>
    </div>
</div>

<div id="addTermModal" class="reveal-modal" data-reveal aria-labelledby="addTermModalTitle" aria-hidden="true" role="dialog">
    <h2 id="addTermModalTitle">Add Academic Period</h2>
    {% include '@adminTerms/form.twig' %}
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div id="errorModal" class="reveal-modal" data-reveal aria-labelledby="errorModalTitle" aria-hidden="true" role="dialog">
    <h2 id="errorModalTitle">Error</h2>
    <p class="alert alert-box icon-alert">Something went wrong - maybe try reloading your page and trying again?</p>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<script src="{{ CDN_PREFIX }}/js/bundle/mage.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/jquery-validation/dist/additional-methods.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript">

    var initForm = function(form) {
        form.find(':submit').mage({
            submittable: '[data-mage-wrapper]',
            reenablePrevious: true,
            onXhrDone: function(data) {
                if (form.data('termForm') == 'create') {
                    // New term? reload whole page for now, as I don't know where to put it.
                    // I also want to clear the form's contents.
                    window.location.reload();
                } else {
                    var newDom  = $(data),
                        oldDom  = $(this).closest('[data-term]'),
                        butonye = oldDom.find('[data-term-form] :submit');
                    // Replace infocard
                    oldDom.find('[data-term-infocard]').replaceWith(newDom.find('[data-term-infocard]'));
                    // Restore butonye
                    butonye.val(butonye.data('mage-reset')).removeAttr('readonly');
                    $.fn.executeCollapsable(oldDom.find('[data-collapsable]'), oldDom.find('[data-collapser]'));
                }
            }
        });
        form.alaressValidate({
            rules: {
                code: {
                    pattern: /^[a-z0-9-_]+$/i
                }
            },
            messages: {
                code: {
                    pattern: 'A code may only contain alphanumeric, hyphen and underscore characters.'
                }
            }
        });
    };

    $(function(){
        $('[data-collapser]').collapsable();
        $('form[data-term-form]').each(function() {
            initForm($(this));
        });

        // Jellytot actions
        $('#content').on('click', 'a[data-term-action]', function(event) {
            event.preventDefault();
            var button = $(this),
                action = button.data('termAction'),
                term   = button.closest('[data-term]');
            button.confirmDialog({
                confirmEvent: function(el) {
                    // AJAX, then update DOM
                    // Archive/restore: refresh
                    // Delete: remove completely
                    $.post(el.data('postAction'))
                        .done(function(data) {
                            switch (action) {
                                case 'delete':
                                    term.fadeOut({ done: term.remove });
                                    break;
                                case 'archive':
                                case 'restore':
                                default:
                                    var newDom  = $(data);
                                    // Replace infocard and jellytot
                                    term.find('[data-term-infocard]').replaceWith(newDom.find('[data-term-infocard]'));
                                    term.find('[data-term-dropdown]').replaceWith(newDom.find('[data-term-dropdown]'));
                                    break;
                            }
                        })
                        .fail(function() {
                            // ¯\_(ツ)_/¯
                            $('#errorModal').foundation('reveal', 'open');
                        });
                }
            })
        });
    });
</script>
