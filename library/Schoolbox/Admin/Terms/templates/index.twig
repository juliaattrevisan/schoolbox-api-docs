{# Shared navigation menu #}
{{ renderAdminNavigation(pageCurrent) }}

{# show each term #}
<div class="row">
    <div class="small-12 island">

        <section>
            <ul class="action-list">
                {% for term in terms %}
                    {% include '@adminTerms/listItem.twig' with {term: term} %}
                {% endfor %}
            </ul>
        </section>

        <a href="#" class="button submit full-width" data-reveal-id="addTermModal">Add Term</a>

    </div>
</div>

<div id="addTermModal" class="reveal-modal" data-reveal aria-labelledby="addTermModalTitle" aria-hidden="true" role="dialog">
    <h2 id="addTermModalTitle">Add Term</h2>
    {% include '@adminTerms/form.twig' %}
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.collapsable.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.mage.js"></script>
<script type="text/javascript">

    var initForm = function(form) {
        form.find(':submit').mage({
            submittable: '[data-mage-wrapper]',
            reenablePrevious: true,
            onXhrDone: function(data) {
                var newDom  = $(data),
                    oldDom  = $(this).closest('[data-term]'),
                    butonye = oldDom.find('[data-term-form] :submit');
                // Replace infocard
                oldDom.find('[data-term-infocard]').replaceWith(newDom.find('[data-term-infocard]'));
                // Restore butonye
                butonye.val(butonye.data('mage-reset')).removeAttr('readonly');
                $.fn.executeCollapsable(oldDom.find('[data-collapsable]'), oldDom.find('[data-collapser]'));
            }
        });
        form.alaressValidate();
    };

    $(function(){
        $('[data-collapser]').collapsable();
        $('form[data-term-form]').each(function() {
            initForm($(this));
        });

        // Archive/restore action
        $('#content').on('click', 'a[data-term-action="archive"], a[data-term-action="restore"]', function(event) {
            event.preventDefault();
            var button = $(this);
            button.confirmDialog({
                confirmEvent: function(el) {
                    // AJAX, then update DOM
                    $.post(el.data('postAction'))
                        .done(function(data) {
                            var newDom  = $(data),
                                oldDom  = button.closest('[data-term]');
                            // Replace infocard and jellytot
                            oldDom.find('[data-term-infocard]').replaceWith(newDom.find('[data-term-infocard]'));
                            oldDom.find('[data-term-dropdown]').replaceWith(newDom.find('[data-term-dropdown]'));
                        })
                        .fail(function() {
                            // ¯\_(ツ)_/¯
                        });
                }
            })
        });

        // Delete action
        $('#content').on('click', 'a[data-term-action="delete"]', function(event) {
            event.preventDefault();
            var button = $(this);
            button.confirmDialog({
                confirmEvent: function(el) {
                    // AJAX, then remove from DOM
                    $.post(el.data('postAction'))
                        .done(function() {
                            var term = button.closest('[data-term]');
                            term.fadeOut({
                                done: term.remove
                            });
                        })
                        .fail(function() {
                            // ¯\_(ツ)_/¯
                        });
                }
            })
        });
    });
</script>
