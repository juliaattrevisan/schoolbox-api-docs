{# Shared navigation menu #}
{{ renderAdminNavigation(pageCurrent) }}

{# show each term #}
<div class="row">
    <div class="small-12 island">

        <section>
            <ul class="action-list">
                {% for term in terms %}
                    {% include '@adminTerms/listItem.twig' with {term: term} %}
                {% endfor %}
            </ul>
        </section>

        <a href="#" class="button submit full-width" data-reveal-id="addTermModal">Add Term</a>

    </div>
</div>

<div id="addTermModal" class="reveal-modal" data-reveal aria-labelledby="addTermModalTitle" aria-hidden="true" role="dialog">
    <h2 id="addTermModalTitle">Add Term</h2>
    {% include '@adminTerms/form.twig' %}
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<script type="text/javascript" src="/javascript/shared/datetime/attacher.datepicker.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.collapsable.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.mage.js"></script>
<script type="text/javascript">
    $(function(){
        $('[data-collapser]').collapsable();
        $('form[data-term-form]').each(function() {
            $(this).find(':submit').mage({
                submittable: '[data-mage-wrapper]',
                onXhrDone: function(data) {
                    var newDom = $(data);
                    var oldDom = $(this).closest('[data-term]');
                    // Replace infocard and maged submit only
                    oldDom.find('[data-term-infocard]').replaceWith(newDom.find('[data-term-infocard]'));
                    oldDom.find('[data-term-form] :submit').replaceWith(newDom.find('[data-term-form] :submit'));
                    $.fn.executeCollapsable(oldDom.find('[data-collapsable]'), oldDom.find('[data-collapser]'));
                },
                onXhrFail: function(data) {
                    // Show error messages
                }
            });
            $(this).alaressValidate();
        });
        $('#content').on('click', 'a[data-post-action]', function(event) {
            event.preventDefault();
            $(this).confirmDialog({
                confirmEvent: function(el) {
                    // Build a POST form, and submit it.
                    // Not currently AJAXing.
                    $('<form method="post" />').attr('action', el.data('postAction')).submit();
                }
            })
        });
    });
</script>
