{% if term.getId() %}
    {% set saveRoute = routeLookup('adminTerms.postUpdateTerm', {id: term.getId()}) %}
    {% set saveValue = 'Update Term' %}
{% else %}
    {% set saveRoute = routeLookup('adminTerms.postCreateTerm') %}
    {% set saveValue = 'Create Term' %}
{% endif %}
<form method="post" action="{{ saveRoute }}" class="row" data-term-form>
    {# This wrapper exists solely to get around a bug in Mage where the form can't be used as the submittable. #}
    <div data-mage-wrapper>
        <div class="small-6 columns">
            <label>
                Title
                <input type="text"
                       name="title"
                       value="{{ term.getTitle() }}"
                       required
                       maxlength="100" />
            </label>
        </div>
        <div class="small-6 columns">
            <label>
                Code
                <input type="text"
                       name="code"
                       value="{{ term.getCode() }}"
                       required
                       maxlength="16" />
            </label>
        </div>
        <div class="small-6 columns">
            <label>
                Start
                <input type="text"
                       name="start"
                       value="{{ term.getStart().getLocalShort() }}"
                       required
                       data-datepicker />
            </label>
        </div>
        <div class="small-6 columns">
            <label>
                Finish
                <input type="text"
                       name="finish"
                       value="{{ term.getFinish().getLocalShort() }}"
                       required
                       data-datepicker />
            </label>
        </div>
        <input type="submit" class="full-width" value="{{ saveValue }}" data-mage-working="Saving..." />
        <!-- Don't delete the inline style, it's needed -->
        <p data-mage-error style="display:none;" class="alert alert-box icon-alert"></p>
        <p data-mage-custom-error class="hide alert alert-box icon-alert"></p>
    </div>
</form>
