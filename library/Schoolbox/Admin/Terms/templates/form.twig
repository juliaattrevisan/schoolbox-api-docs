{##
 # Form
 #
 # Create/Edit the Term's settings. There's a Year Level relationship (optional)
 # that can be configured by a school to take a Term out of the normally-mandated
 # sequence where they aren't allowed to overlap. Making an Extraordinary Term is
 # required in some schools who need to disobey our sequencing.
 #
 # This fragment manifets in a Modal in the Terms admin area.
 #
 # @param array $yearLevelOptions  a set of YearLevel\Model instances to choose
 #}


{% if term.id ?? false %}
    {% set saveRoute = routeLookup('adminTerms.postUpdateTerm', {id: term.id}) %}
    {% set saveValue = 'Update Term' %}
    {% set saveType  = 'update' %}
{% else %}
    {% set saveRoute = routeLookup('adminTerms.postCreateTerm') %}
    {% set saveValue = 'Create Term' %}
    {% set saveType  = 'create' %}
{% endif %}
<form method="post" action="{{ saveRoute }}" class="row" data-term-form="{{ saveType }}">
    {# This wrapper exists solely to get around a bug in Mage where the form can't be used as the submittable. #}
    <div data-mage-wrapper>
        <div class="small-6 columns">
            <label>
                Title
                <input type="text"
                       name="title"
                       value="{{ term.title ?? '' }}"
                       required
                       maxlength="100" />
            </label>
        </div>
        <div class="small-6 columns">
            <label>
                Code
                <input type="text"
                       name="code"
                       value="{{ term.code ?? '' }}"
                       required
                       maxlength="16" />
            </label>
        </div>
        <div class="small-6 columns">
            <label>
                Start
                <input type="text"
                       name="start"
                       value="{{ term.start.localShort ?? '' }}"
                       required
                       data-datepicker />
            </label>
        </div>
        <div class="small-6 columns">
            <label>
                Finish
                <input type="text"
                       name="finish"
                       value="{{ term.displayFinish.localShort ?? '' }}"
                       required
                       data-datepicker />
            </label>
        </div>

        {# TODO Supply in controller #}
        {% set yearLevelValues = [] %}

        <script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
        <script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>

        <script>
            $(function() {
                $('#yearLevels-{{ term.id ?? 0 }}').selectizeSelector({
                    multiple: true,
                    value: {{ yearLevelValues|json_encode|raw }},
                    selectize: {
                        load: null,
                        options: {{ yearLevelOptions|json_encode|raw }},
                        hideSelected: true
                    }
                });
            });
        </script>
        <div class="small-12 columns">
            <label>Year Levels</label>
            <span class="hint has-tip tip-top" title="Associate a year level to take this Term out of sequence" data-tooltip="">?</span>

            <input title="Year Levels" id="yearLevels-{{ term.id ?? 0 }}" name="yearLevelIds" placeholder="Select year levels" tabindex="-1" class="selectized" type="text" />
        </div>

        <input type="submit" class="expand" value="{{ saveValue }}" data-mage-working="Saving..." data-mage-reset="{{ saveValue }}" />
        <!-- Don't delete the inline style, it's needed -->
        <p data-mage-error style="display:none;" class="alert alert-box icon-alert"></p>
        <p data-mage-custom-error class="hide alert alert-box icon-alert"></p>
    </div>
</form>
