<script>
    $(function () {
        var form = $('form#itemForm');

        $('[data-cancel]').click(function () {
            window.location.href = '{{ routeLookup('adminMenuSide.getIndex') }}';
            return false;
        });

        $('[data-submit]').click(function () {
            form.alaressValidate({
                ignore: ':disabled',
                rules: {
                    'title': {required: true},
                    'url': {required: true, isURL: true}
                },
                messages: {
                    'title': {required: 'You must enter a title before you can proceed.'},
                    'url': {required: 'You must enter a valid URL for this menu item before you can proceed.'}
                }
            });
        });

        $('[data-delete]').click(function (event) {
            event.preventDefault();
            var id = $(this).data('delete');
            var listItem = $(this).closest('li');
            console.log(id);
            $(this).confirmDialog({
                text: 'Are you sure you want to delete this menu item?',
                confirmEvent: function () {
                    $.post('{{ routeLookup('adminMenuSide.postDelete') }}', {
                        id: id
                    }).success(function (e) {
                        $(listItem).remove();
                    });
                }
            });
        });
    });
</script>

{# Shared navigation menu #}
{{ renderAdminNavigation(pageCurrent) }}

<form id="itemForm" action="{{ routeLookup('adminMenuSide.postModify') }}" method="post">
    <input type="hidden" name="id" value="{{ item.id }}">
    <div class="row">
        <div class="small-12 island">
            {% if item.id is empty %}
                <h1>Insert Menu Item</h1>
            {% else %}
                <h1>Edit Menu Item</h1>
            {% endif %}
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Title
                            <input name='title' type="text" placeholder="Item Label" value="{{ item.title }}">
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>
                            Destination URL
                            <input name="url" required type="text" placeholder="Destination URL" value="{{ item.url }}">
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>
                            Destination Target
                            <select name="target">
                                <option {% if item.target == '' %}selected{% endif %} value="">Same Window</option>
                                <option {% if item.target == '_blank' %}selected{% endif %} value="_blank">New Window</option>
                            </select>
                        </label>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <fieldset class="checklist">
                            <legend>
                                Display To These Campuses
                                <span data-tooltip="" class="hint has-tip tip-top" data-width="200" title="">?</span>
                            </legend>
                            <input id="campus-all" type="checkbox">
                            <label for="campus-all">Select All</label>
                            {% for campus in campuses %}
                                <input name="campuses[]" data-campus id="campus-{{ campus.id }}" type="checkbox" {% if campusesSelected[campus.id] %}checked{% endif %} value="{{ campus.id }}">
                                <label for="campus-{{ campus.id }}">{{ campus.name }}</label>
                            {% endfor %}
                        </fieldset>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <fieldset class="checklist">
                            <legend>
                                Display To These Groups
                                <span data-tooltip="" class="hint has-tip tip-top" data-width="200" title="">?</span>
                            </legend>
                            <input id="group-all" type="checkbox">
                            <label for="group-all">Select All</label>
                            {% for group in groups %}
                                <input name="groups[]" data-group id="group-{{ group.id }}" type="checkbox" {% if groupsSelected[group.id] %}checked{% endif %} value="{{ group.id }}">
                                <label for="group-{{ group.id }}">{{ group.name }}</label>
                            {% endfor %}
                        </fieldset>
                    </div>
                </fieldset>
            </section>
        </div>
    </div>
    <div class="row">
        <div class="small-12 column">
            <ul class="flex-list buttons">
                <li><input data-submit type="submit" class="submit expand" value="Save"></li>
                <li><button data-cancel data-delete="{{ item.id }}" class="button expand icon-cancel">Delete</button></li>
                <li><button data-cancel class="button expand icon-cancel">Cancel Changes</button></li>
            </ul>
        </div>
    </div>
</form>

<script>
    $(function() {

        {# Check all checkboxes if everything was selected #}

        var allChecked = true;

        {# Groups #}

        $('[data-group]').each(function() {
            if (!$(this).prop('checked')) {
                allChecked = false;
            }
        });

        if (allChecked) {
            $('#group-all').prop('checked', true);
        }

        {# Campuses #}

        $('[data-campus]').each(function() {
            if (!$(this).prop('checked')) {
                allChecked = false;
            }
        });

        if (allChecked) {
            $('#campus-all').prop('checked', true);
        }
        
        $('[data-campus]').change(function() {
            $('#campus-all').prop('checked', false);
        });

        $('#campus-all').change(function() {
            var status = $(this).prop('checked');
            $('[data-campus]').each(function() {
                $(this).prop('checked', status);
            });
        });

        $('[data-group]').change(function() {
            $('#group-all').prop('checked', false);
        });

        $('#group-all').change(function() {
            var status = $(this).prop('checked');
            $('[data-group]').each(function() {
                $(this).prop('checked', status);
            });
        });

    });
</script>