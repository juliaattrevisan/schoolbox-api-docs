{# Shared navigation menu #}
{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 island">
        <div class="row">
            <div class="list-item">
                <div class="small-12 island">
                    <h1>Side Menu</h1>
                    <h2 class="subheader">Sections</h2>
                </div>
            </div>
            </nav>
        </div>
        <section>
            <ul class="information-list sortable-card ui-sortable" data-sortable="">
                {% for section in sections %}
                    <li class="actions-small-2" data-menu-section="{{ section.section }}">
                        <div class="grip"></div>
                        <div class="list-item">
                            <div class="card small-12">
                                <a>
                                    <h3>
                                        {{ sectionName[section.section] }}
                                    </h3>
                                    <p class="meta">
                                        {% if section.title == '' and section.section == 'menu' %}
                                            {{ configTitle }}
                                        {% else %}
                                            {{ section.title }}
                                        {% endif %}
                                        {% if section.visible %}
                                            (Visible)
                                        {% else %}
                                            (Hidden)
                                        {% endif %}
                                    </p>
                                </a>
                            </div>
                        </div>
                        <nav>
                            <a class="icon-modify" title="Edit menu item"
                               href="{{ routeLookup('adminMenuSide.getSectionModify', {id: section.section}) }}"></a>
                        </nav>
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <div class="row actions-small-3">
            <div class="list-item">
                <div class="small-12 island">
                    <h2 class="subheader">Menu Items</h2>
                </div>
            </div>
            <nav>
                <a href="{{ routeLookup('adminMenuSide.getInsert') }}" class="icon-add" title="Add Menu Item"></a>
            </nav>
        </div>
        <section class="content">
            <section data-role="sideMenuTree">
                {{ tree | purify }}
            </section>
        </section>
    </div>
</div>

<!-- BEGIN custom_head -->
<link type="text/css" rel="stylesheet" href="/javascript/components/jstree/dist/themes/default/style.css"/>
<script type="text/javascript" src="/javascript/components/jstree/dist/jstree.js"></script>

<script>
    $(function () {
        $('section[data-role="sideMenuTree"]')
                .on('ready.jstree', function (event, jstree) {
                    jstree.instance.open_node(jstree.instance.get_node('node_0'));
                })
                .on('click', 'a[href]', function () {
                    // Listen on click, instead of select_node, because select_node
                    // fires on initial page load.
                    window.location.href = this.href;
                })
                .jstree({
                    "animation": 50,
                    "core": {
                        force_text: true,
                        check_callback: true,
                        "themes": {
                            "variant": "schoolbox",
                            "dots": true,
                            "icons": false
                        }
                    },
                    "plugins": ["dnd", 'state'],
                    dnd: {
                        copy: false
                    }
                })
                .on('move_node.jstree', function (e, data) {
                    var id = data.node.id.split('_').pop();
                    var parentId = data.parent.split('_').pop();
                    var position = data.position;

                    $.ajax({
                        url: '/adminv2/menu-side/order',
                        method: 'post',
                        data: {
                            position: position,
                            parentId: parentId,
                            id: id
                        }
                    });
                });
    });

    $(function () {
        $('#content').find('ul[data-sortable]').sortable({
            handle: '.grip',
            axis: 'y',
            update: function () {
                var order = '';
                // Update the sort order in the database
                $('[data-menu-section]').each(function (e) {
                    if (order != '') {
                        order += ',';
                    }
                    order += $(this).data('menu-section');
                });

                $.post('{{ routeLookup('adminMenuSide.postSectionOrder') }}', {
                    order: order
                })
                        .success(function () {
                        });
            }
        });
    });
</script>
<!-- END custom_head -->
