<link type="text/css" rel="stylesheet" href="{{ CDN_PREFIX }}/js/vendors/jstree/dist/themes/default/style.css"/>

<script src="{{ CDN_PREFIX }}/js/sportsfixtures/jquery.mightyList.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/vendors/jstree/dist/jstree.min.js?v={{ config.site_version }}"></script>
<script>
    $(function() {
        $('#sections').mightyList({});

        $('section[data-role="sideMenuTree"]')
            .on('ready.jstree', function (event, jstree) {
                jstree.instance.open_node(jstree.instance.get_node('node_0'));
            })
            .on('click', 'a[href]', function () {
                // Listen on click, instead of select_node, because select_node
                // fires on initial page load.
                window.location.href = this.href;
            })
            .jstree({
                "animation": 50,
                "core": {
                    force_text: true,
                    check_callback: true,
                    "themes": {
                        "variant": "schoolbox",
                        "dots": true,
                        "icons": false
                    }
                },
                "plugins": ["dnd", 'state'],
                dnd: {
                    copy: false
                }
            })
            .on('move_node.jstree', function (e, data) {
                var id = data.node.id.split('_').pop();
                var parentId = data.parent.split('_').pop();
                var position = data.position;

                $.ajax({
                    url: '/adminv2/menu-side/order',
                    method: 'post',
                    data: {
                        position: position,
                        parentId: parentId,
                        id: id
                    }
                });
            });

        $('#content').find('ul[data-sortable]').sortable({
            handle: '.grip',
            axis: 'y',

            update: function () {
                var order = '';
                // Update the sort order in the database
                $('[data-menu-section]').each(function (e) {
                    if (order != '') {
                        order += ',';
                    }
                    order += $(this).data('menu-section');
                });

                $.post('{{ routeLookup('adminMenuSide.postSectionOrder') }}', {
                    order: order
                })
                .done(function () {
                });
            }
        });

    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <div class="row">
                <div class="list-item">
                    <div class="small-12 island">
                        <h2 class="subheader">Sections</h2>
                    </div>
                </div>
                </nav>
            </div>
            <section>
                <ul class="information-list sortable ui-sortable" data-sortable data-list id="sections">
                    {% for section in sections %}
                        {% if section.title is empty %}
                            {% set title = sectionName[section.section] %}
                        {% else %}
                            {% set title = section.title %}
                        {% endif %}

                        <li>
                            <div class="actions-small-1">
                                <div class="grip ui-sortable-handle">&nbsp;</div>
                                <div class="card" data-menu-section="{{ section.section }}" data-item="{{ section.id }}">
                                    <label data-action="{{ routeLookup('adminMenuSide.postSectionModify', {sectionId: section.section, field: 'title'}) }}">
                                        <input type="text" name="title" value="{{ title }}" data-item-original-value="{{ title }}"
                                               placeholder="{{ sectionName[section.section] }}" data-item-element/>
                                    </label>
                                    <span class="toast" data-save-item></span>
                                </div>
                                <div class="card" data-menu-section="{{ section.section }}" data-item="{{ section.id }}">
                                    <label data-action="{{ routeLookup('adminMenuSide.postSectionModify', {sectionId: section.section, field:'visible'}) }}">
                                        <select name="visible" data-item-element data-item-original-value="{{ section.visible }}">
                                            <option {% if not section.visible %}selected{% endif %} value="0">Hidden</option>
                                            <option {% if section.visible %}selected{% endif %} value="1">Visible</option>
                                        </select>
                                    </label>
                                    <span class="toast" data-save-item></span>
                                </div>
                            </div>
                        </li>

                    {% endfor %}
                </ul>
            </section>
        </div>
        <div class="small-12 island">
            <div class="row actions-small-1">
                <div class="list-item">
                    <div class="small-12 island">
                        <h2 class="subheader">
                            Menu Items
                            <span class="hint has-tip tip-top" data-tooltip title="Click on any of the menu items below to edit its details.">?</span>
                        </h2>
                    </div>
                </div>
                <nav>
                    <a href="{{ routeLookup('adminMenuSide.getCreate') }}" class="icon-add" title="Add Menu Item"></a>
                </nav>
            </div>
            <section class="content">
                <section data-role="sideMenuTree">
                    {{ tree | purify }}
                </section>
            </section>
        </div>
    </div>
</div>
