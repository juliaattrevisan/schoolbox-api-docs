<script>
    $(function () {
        var form = $('form#sectionForm');

        $('[data-cancel]').click(function () {
            window.location.href = '{{ routeLookup('adminMenuSide.getIndex') }}';
            return false;
        });
    });
</script>

{# Shared navigation menu #}
{{ renderAdminNavigation(pageCurrent) }}

<form id="sectionForm" action="{{ routeLookup('adminMenuSide.postSectionModify') }}" method="post">
    <input type="hidden" name="id" value="{{ section.section }}">
    <div class="row">
        <div class="small-12 island">
            <h1>Edit Menu Section</h1>
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Title
                            <input name='title' type="text" placeholder="{{ sectionName[section.section] }}" value="{{ section.title }}">
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>
                            Section Visibility
                            <select name="visible">
                                <option {% if section.visible == 1%}selected{% endif %} value="1">Visible</option>
                                <option {% if section.visible == 0 %}selected{% endif %} value="0">Hidden</option>
                            </select>
                        </label>
                    </div>
                </fieldset>
            </section>
        </div>
    </div>
    <div class="row">
        <div class="small-12 column">
            <ul class="flex-list buttons">
                <li><input data-submit type="submit" class="submit expand" value="Save"></li>
                <li><button data-cancel class="button expand icon-cancel">Cancel Changes</button></li>
            </ul>
        </div>
    </div>
</form>