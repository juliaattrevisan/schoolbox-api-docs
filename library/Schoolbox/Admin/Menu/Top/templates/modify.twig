<script type="text/javascript" src="{{ CDN_PREFIX }}/js/attacher/attacher.checkbox-group.js?v={{ config.site_version }}"></script>
<script>
    $(function () {
        var form = $('form#itemForm');

        $('[data-submit]').click(function () {
            form.alaressValidate({
                ignore: ':disabled',
                rules: {
                    'text': {required: true},
                    'url': {required: true, isURL: true}
                },
                messages: {
                    'text': {required: 'You must enter a name before you can proceed.'},
                    'url': {required: 'You must enter a valid URL for this menu item before you can proceed.'}
                }
            });
        });

    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <form id="itemForm" action="{{ routeLookup('adminMenuTop.postModify') }}" method="post">
            <input type="hidden" name="id" value="{{ item.id ?? '' }}">
            <div class="row">
                <div class="small-12 island">
                    {% if item is defined %}
                        <h2 class="subheader">Modify Menu Item</h2>
                    {% else %}
                        <h2 class="subheader">Create Menu Item</h2>
                    {% endif %}
                    <section>
                        <fieldset class="content">
                            <div class="small-12 columns">
                                <label>
                                    Title
                                    <input required type="text" name='text' value="{{ item.text ?? '' }}">
                                </label>
                            </div>
                            <div class="small-12 columns">
                                <label>
                                    Hover Description
                                    <input name='title' type="text" value="{{ item.title ?? '' }}">
                                </label>
                            </div>
                            <div class="small-10 columns">
                                <label>
                                    Icon
                                    <select id="icon-select" name="icon" data-icon>
                                        {% for icon in icons %}
                                            <option {% if item is defined and icon.name == item.icon %}selected{% endif %} value="{{ icon.name }}">{{ icon.title }}</option>
                                        {% endfor %}
                                    </select>
                                </label>
                            </div>
                            <div class="small-2 columns">
                                <label>
                                    Preview
                                </label>
                                <div id="icon" style="margin-top:5px" class="size-32 icon-{{ item.icon ?? '' }}"></div>
                            </div>
                        </fieldset>
                        <fieldset class="content">
                            <div class="small-12 columns">
                                <label for="url">
                                    Destination URL
                                    <span data-tooltip class="hint has-tip tip-top" data-width="200" title="You can use [id], [firstName], [lastName], [externalId], [username], [email] in your URLs, these will be replaced for the user">?</span>
                                </label>
                                <script>
                                    $(function() {
                                        $('#modalLinkButton').schoolboxLink({
                                            onSelect: function(url, name, mime, dialog) {
                                                $('input[name="url"]').val(url);
                                            }
                                        });
                                    });
                                </script>
                                <div class="input-group">
                                    <input name="url" required type="text" value="{{ item.url ?? '' }}" />
                                    <a id="modalLinkButton" class="button icon-link">Browse</a>
                                </div>
                            </div>
                            <div class="small-6 columns">
                                <label>
                                    Destination Target
                                    <select name="target">
                                        <option {% if item is defined and item.target == '' %}selected{% endif %} value="">Same Window</option>
                                        <option {% if item is defined and item.target == '_blank' %}selected{% endif %} value="_blank">New Window</option>
                                    </select>
                                </label>
                            </div>
                            <div class="small-6 columns">
                                <label for="webmail" class="inline-block">Webmail Link
                                    <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Special logic is used for webmail display based on the individual, this will indicate that this item represents the webmail tab">?</span>
                                </label>
                                <div class="switch">
                                    <input id="webmail" type="checkbox" name="webmail" data-checkbox-group="webmail" {% if item.webmail ?? false %}checked{% endif %}/>
                                    <label for="webmail">
                                        <span>On</span>
                                        <span>Off</span>
                                    </label>
                                </div>
                            </div>
                        </fieldset>
                        <fieldset class="content">
                            <div class="small-12 medium-6 columns">
                                <fieldset class="checklist">
                                    <legend>
                                        Visible Campus
                                        <span data-tooltip="" class="hint has-tip tip-top" data-width="200" title="Users in these campus will see the tab, remember users can be in multiple campus">?</span>
                                    </legend>
                                    <ul class="option-list">
                                        <li>
                                            <input id="campus-all" type="checkbox">
                                            <label for="campus-all">Select All</label>
                                        </li>
                                        {% for campus in campuses %}
                                            <li>
                                                <input name="campuses[]" data-campus id="campus-{{ campus.id }}" type="checkbox" {% if campusesSelected[campus.id] ?? false %}checked{% endif %} value="{{ campus.id }}">
                                                <label for="campus-{{ campus.id }}">{{ campus.name }}</label>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </fieldset>
                            </div>
                            <div class="small-12 medium-6 columns">
                                <fieldset class="checklist">
                                    <legend>
                                        Visible Roles
                                        <span data-tooltip="" class="hint has-tip tip-top" data-width="200" title="Users in these roles will see the tab">?</span>
                                    </legend>
                                    <ul class="option-list">
                                        <li>
                                            <input id="role-all" type="checkbox">
                                            <label for="role-all">Select All</label>
                                        </li>
                                        {% for role in roles %}
                                            <li>
                                                <input name="roles[]" data-role id="role-{{ role.id }}" type="checkbox" {% if rolesSelected[role.id] ?? false %}checked{% endif %} value="{{ role.id }}">
                                                <label for="role-{{ role.id }}">{{ role.name }}</label>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </fieldset>
                            </div>
                        </fieldset>
                    </section>
                </div>
            </div>

            <div class="row">
                <div class="small-12 column">
                    <input data-submit type="submit" value="Save">
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    $(function() {

        {# Icon preview#}

        $('[data-icon]').change(function() {
            $('#icon').attr('class', 'size-32 icon-' + $('#icon-select').val())
        });

        $('#icon').attr('class', 'size-32 icon-' + $('#icon-select').val())

        {# Check all checkboxes if everything was selected #}

        var allChecked = true;

        {# Roles #}

        $('[data-role]').each(function() {
            if (!$(this).prop('checked')) {
                allChecked = false;
            }
        });

        if (allChecked) {
            $('#role-all').prop('checked', true);
        }

        {# Campuses #}

        $('[data-campus]').each(function() {
            if (!$(this).prop('checked')) {
                allChecked = false;
            }
        });

        if (allChecked) {
            $('#campus-all').prop('checked', true);
        }

        $('[data-campus]').change(function() {
            $('#campus-all').prop('checked', false);
        });

        $('#campus-all').change(function() {
            var status = $(this).prop('checked');
            $('[data-campus]').each(function() {
                $(this).prop('checked', status);
            });
        });

        $('[data-role]').change(function() {
            $('#role-all').prop('checked', false);
        });

        $('#role-all').change(function() {
            var status = $(this).prop('checked');
            $('[data-role]').each(function() {
                $(this).prop('checked', status);
            });
        });
    });
</script>
