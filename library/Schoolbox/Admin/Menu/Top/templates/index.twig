{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        {% if menu | length == 0 %}
        <div class="small-12 island">
            <div class="empty-state">
                <sbx-icon name="month-view" size="2rem"></sbx-icon>
                <p>Your top menu is empty.</p>
                <p><a href="{{ routeLookup('adminMenuTop.getCreate') }}" title="Post some news">Create first top menu item</a></p>
            </div>
        </div>
        {% else %}
        <div class="small-12 hide" data-tabs-empty>
            <div class="empty-state">
                <sbx-icon name="month-view" size="2rem"></sbx-icon>
                <p>Your top menu is empty.</p>
                <p><a href="{{ routeLookup('adminMenuTop.getCreate') }}" title="Post some news">Create first top menu item</a></p>
            </div>
        </div>

        <div class="small-12 island" data-tab>
            <div class="row actions-small-1">
                <div class="list-item">
                    <div class="small-12 island">
                        <h2 class="subheader">Menu Items</h2>
                    </div>
                </div>
                <nav>
                    <a href="{{ routeLookup('adminMenuTop.getCreate') }}" class="sbx-icon-only-button" title="Add Menu Item" aria-label="Add Menu Item">
                        <sbx-icon name="add"></sbx-icon>
                    </a>
                </nav>
            </div>

            <section>
                <ul class="information-list sortable-card ui-sortable" data-sortable="">
                    {% for item in menu %}
                        <li data-menu-top="{{ item.id }}">
                            <div class="actions-small-2">
                                <div class="grip"></div>
                                <div class="list-item">
                                    <div class="card small-12">
                                        <a class="l-flex-row l-flex--no-wrap l-flex--align-start l-gap-m">
                                            <sbx-icon name="{{ item.icon }}" size="1.5rem" color="var(--body-foreground)"></sbx-icon>
                                            <div class="l-flex-col l-gap-xs">
                                                <h3>{{ item.text }}</h3>
                                                <p class="meta">{{ item.title }}</p>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                                <nav>
                                    <a class="sbx-icon-only-button" title="Edit menu item" aria-label="Edit menu item" href="{{ routeLookup('adminMenuTop.getModify', {id: item.id}) }}">
                                        <sbx-icon name="modify"></sbx-icon>
                                    </a>
                                    <a class="sbx-icon-only-button" data-delete="{{ item.id }}" title="Delete menu item" aria-label="Delete menu item">
                                        <sbx-icon name="delete"></sbx-icon>
                                    </a>
                                </nav>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
        {% endif %}
    </div>
</div>

<!-- BEGIN custom_head -->
<script>
    $(function () {
        $('#content').find('ul[data-sortable]').sortable({
            handle: '.grip',
            axis: 'y',
            update: function () {
                var order = '';
                // Update the sort order in the database
                $('[data-menu-top]').each(function (e) {
                    if (order != '') {
                        order += ',';
                    }
                    order += $(this).data('menu-top');
                });

                $.post('{{ routeLookup('adminMenuTop.postOrder') }}', {
                    order: order
                })
                        .done(function () {
                        });
            }
        });

        $('[data-delete]').on('click', function (event) {
            event.preventDefault();
            var id = $(this).data('delete');
            var listItem = $(this).closest('li');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this menu item?',
                confirmLabel: 'Delete',
                confirmEvent: function () {
                    $.post('{{ routeLookup('adminMenuTop.postDelete') }}', {
                        id: id
                    }).done(function (e) {
                        $(listItem).remove();

                        if ($('[data-menu-top]').length == 0) {
                            $('[data-tabs-empty]').removeClass('hide');
                            $('[data-tabs]').addClass('hide');
                        }
                    });
                }
            });
        });
    });
</script>
<!-- END custom_head -->
