<script>
    $(function() {
        $('[data-checkbox-unit-inherit]').change(function(event) {
            if ($(event.target).prop('checked')) {
                $('#unit-permissions').addClass('hide');
            } else {
                $('#unit-permissions').removeClass('hide');
            }
        });

        $('[data-checkbox-course-inherit]').change(function(event) {
            if ($(event.target).prop('checked')) {
                $('#course-permissions').addClass('hide');
            } else {
                $('#course-permissions').removeClass('hide');
            }
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        {# Config page contents #}

        <table>
            <tr>
                <th>ID</th>
                <th class="required">Template Name</th>
                <th class="required">Selected Course Page Template</th>
{#                <th class="required">Course Folder Inherit Perms?</th>#}
                <th class="required">Selected Unit Page Template</th>
{#                <th class="required">Unit Folder Inherit Perms?</th>#}
                <th>Delete</th>
            </tr>
        {% for courseTemplate in courseTemplates %}
            <tr>
                <td>{{ courseTemplate.id }}</td>
                <td>{{ courseTemplate.name }}</td>
                <td>{{ courseTemplate.courseTemplate.name }}</td>
{#                <td>{{ courseTemplate.courseInherit ? 'true' : 'false' }}</td>#}
                <td>{{ courseTemplate.unitTemplate.name }}</td>
{#                <td>{{ courseTemplate.unitInherit ? 'true' : 'false' }}</td>#}
                <td><a href="#" class="icon-delete" title="Delete Row"></a></td>
            </tr>
        {% endfor %}
            <tr>
                <td>NEW</td>
                <td><input></td>
                <td>
                    <select name="courseTemplate">
                        {% for template in availableTemplates %}
                            <option value="{{ template.id }}">{{ template.name }}</option>
                        {% endfor %}
                    </select>
                </td>
                <td>
                    <select name="unitTemplate">
                        {% for template in availableTemplates %}
                            <option value="{{ template.id }}">{{ template.name }}</option>
                        {% endfor %}
                    </select>
                </td>
                <td>Save?</td>
            </tr>

        </table>
        <hr />

        <div class="small-12 columns">
            <form action="/adminv2/course-builder/save" method="post">
                <div class="content">
                    <div class="l-grid l-gap-l l-grid--2-col highlighter l-mar-m--bottom">
                        <div class="island">
                            <section>
                                <fieldset class="content">
                                    <div class="columns">
                                        <label>Course Default Access Permissions</label>
                                    </div>
                                    <div class="columns">
                                        <input data-checkbox-course-inherit type="checkbox" id="courseInherit" name="courseInherit" value="1" {% if courseInherit == 1 %}checked{% endif %} />
                                        <label for="courseInherit" class="checkbox-label">Inherit permissions from the course's parent folder</label>
                                    </div>
                                </fieldset>
                                <table id="course-permissions" {% if courseInherit == 1 %}class="hide"{% endif %}>
                                    <thead>
                                        <tr>
                                            <th>Role</th>
                                            <th>None</th>
                                            <th>Read</th>
                                            <th>Write</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for role in roles %}
                                            <tr>
                                                <td>{{ role.getName }}</td>
                                                <td>
                                                    <input type="radio" name="course_group[{{ role.getId }}]" id="courseGroupNone{{ role.getId }}" value="0" {{ permissions['course'][role.getId][0] ?? '' }}>
                                                    <label class="radio-label" for="courseGroupNone{{ role.getId }}"></label>
                                                </td>
                                                <td>
                                                    <input type="radio" name="course_group[{{ role.getId }}]" id="courseGroupRead{{ role.getId }}" value="1" {{ permissions['course'][role.getId][1] ?? '' }}>
                                                    <label class="radio-label" for="courseGroupRead{{ role.getId }}"></label>
                                                </td>
                                                <td>
                                                    <input type="radio" name="course_group[{{ role.getId }}]" id="courseGroupWrite{{ role.getId }}" value="2" {{ permissions['course'][role.getId][2] ?? ''}}>
                                                    <label class="radio-label" for="courseGroupWrite{{ role.getId }}"></label>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </section>
                        </div>
                    </div>
                    <div class="l-grid l-gap-l l-grid--2-col highlighter l-mar-m--bottom">
                        <div class="island">
                            <section>
                                <fieldset class="content">
                                    <div class="columns">
                                        <label>Unit Default Access Permissions</label>
                                    </div>
                                    <div class="columns">
                                        <input data-checkbox-unit-inherit type="checkbox" id="unitInherit" name="unitInherit" value="1" {% if unitInherit == 1 %}checked{% endif %} />
                                        <label for="unitInherit" class="checkbox-label">Inherit permissions from the course's parent folder</label>
                                    </div>
                                </fieldset>
                                <table id="unit-permissions" {% if unitInherit == 1 %}class="hide"{% endif %}>
                                    <thead>
                                        <tr>
                                            <th>Role</th>
                                            <th>None</th>
                                            <th>Read</th>
                                            <th>Write</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for role in roles %}
                                            <tr>
                                                <td>{{ role.getName }}</td>
                                                <td>
                                                    <input type="radio" name="unit_group[{{ role.getId }}]" id="unitGroupNone{{ role.getId }}" value="0" {{ permissions['unit'][role.getId][0] ?? '' }}>
                                                    <label class="radio-label" for="unitGroupNone{{ role.getId }}"></label>
                                                </td>
                                                <td>
                                                    <input type="radio" name="unit_group[{{ role.getId }}]" id="unitGroupRead{{ role.getId }}" value="1" {{ permissions['unit'][role.getId][1] ?? '' }}>
                                                    <label class="radio-label" for="unitGroupRead{{ role.getId }}"></label>
                                                </td>
                                                <td>
                                                    <input type="radio" name="unit_group[{{ role.getId }}]" id="unitGroupWrite{{ role.getId }}" value="2" {{ permissions['unit'][role.getId][2] ?? '' }}>
                                                    <label class="radio-label" for="unitGroupWrite{{ role.getId }}"></label>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </section>
                        </div>
                    </div>
                </div>
                <button class="submit" type="submit">Save Changes</button>
            </form>
        </div>
    </div>
</div>
