{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}


    <div class="admin-content">
        {# Config page contents #}
        <div id="course-builder-container">
            <course-builder
                :course-templates = '{{ courseTemplates |json_encode }}'
                :available-templates = '{{ availableTemplates |json_encode }}'
                :course-permissions = '{{ coursePermissions |json_encode }}'
                :unit-permissions = '{{ unitPermissions |json_encode }}'
                :course-inherit = '{{ courseInherit |json_encode }}'
                :unit-inherit = '{{ unitInherit |json_encode }}'
                :roles = '{{ roles |json_encode }}'
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/courseBuilder.js?v={{ config.site_version }}"></script>
    </div>
</div>
