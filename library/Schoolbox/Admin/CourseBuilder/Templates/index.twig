{# Shared navigation menu #}

{{ navigation | raw }}

{# Config page contents #}

<div class="small-12 island">
    <dl class="tabs" data-tab="">
        <dd class="active"><a href="#panel-course">Course Page</a></dd>
        <dd class=""><a href="#panel-unit">Unit Page</a></dd>
    </dl>
</div>

<form action="/adminv2/course-builder/save" method="post">
    <div class="tabs-content">
        <div class="content active" id="panel-course">
            <div class="list-item small-12 island">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>
                                Homepage Template
                                <select name="template_course">
                                    <option {% if courseTemplate == -1 %}selected{% endif %} value="-1">No Homepage</option>
                                    <option {% if courseTemplate == 1 %}selected{% endif %} value="1">Class</option>
                                    <option {% if courseTemplate == 2 %}selected{% endif %} value="2">Collab Group</option>
                                    <option {% if courseTemplate == 4 %}selected{% endif %} value="4">Faculty</option>
                                    <option {% if courseTemplate == 3 %}selected{% endif %} value="3">Extra-Curricular</option>
                                    <option {% if courseTemplate == 5 %}selected{% endif %} value="5">Committee</option>
                                    <option {% if courseTemplate == 6 %}selected{% endif %} value="6">House</option>
                                    <option {% if courseTemplate == 7 %}selected{% endif %} value="7">Blog</option>
                                    <option {% if courseTemplate == 9 %}selected{% endif %} value="9">Blank</option>
                                    <option {% if courseTemplate == 10 %}selected{% endif %} value="10">Files and Folders</option>
                                    <option {% if courseTemplate == 13 %}selected{% endif %} value="13">Course - Overview</option>
                                    <option {% if courseTemplate == 14 %}selected{% endif %} value="14">Course - Lesson</option>
                                </select>
                            </label>
                        </div>
                    </fieldset>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>Default Access Permissions</label>
                        </div>
                    </fieldset>
                    <table>
                        <thead>
                            <tr>
                                <th>Role</th>
                                <th>None</th>
                                <th>Read</th>
                                <th>Write</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for role in roles %}
                                <tr>
                                    <td>{{ role.getName }}</td>
                                    <td>
                                        <input type="radio" name="course_group[{{ role.getId }}]" id="courseGroupNone{{ role.getId }}" value="0" {{ permissions['course'][role.getId][0] }}>
                                        <label class="radio-label" for="courseGroupNone{{ role.getId }}"></label>
                                    </td>
                                    <td>
                                        <input type="radio" name="course_group[{{ role.getId }}]" id="courseGroupRead{{ role.getId }}" value="1" {{ permissions['course'][role.getId][1] }}>
                                        <label class="radio-label" for="courseGroupRead{{ role.getId }}"></label>
                                    </td>
                                    <td>
                                        <input type="radio" name="course_group[{{ role.getId }}]" id="courseGroupWrite{{ role.getId }}" value="2" {{ permissions['course'][role.getId][2] }}>
                                        <label class="radio-label" for="courseGroupWrite{{ role.getId }}"></label>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </section>
            </div>
        </div>
        <div class="content" id="panel-unit">
            <div class="list-item small-12 island">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>
                                Homepage Template
                                <select name="template_unit">
                                    <option {% if unitTemplate == -1 %}selected{% endif %} value="-1">No Homepage</option>
                                    <option {% if unitTemplate == 1 %}selected{% endif %} value="1">Class</option>
                                    <option {% if unitTemplate == 2 %}selected{% endif %} value="2">Collab Group</option>
                                    <option {% if unitTemplate == 4 %}selected{% endif %} value="4">Faculty</option>
                                    <option {% if unitTemplate == 3 %}selected{% endif %} value="3">Extra-Curricular</option>
                                    <option {% if unitTemplate == 5 %}selected{% endif %} value="5">Committee</option>
                                    <option {% if unitTemplate == 6 %}selected{% endif %} value="6">House</option>
                                    <option {% if unitTemplate == 7 %}selected{% endif %} value="7">Blog</option>
                                    <option {% if unitTemplate == 9 %}selected{% endif %} value="9">Blank</option>
                                    <option {% if unitTemplate == 10 %}selected{% endif %} value="10">Files and Folders</option>
                                    <option {% if unitTemplate == 13 %}selected{% endif %} value="13">Course - Overview</option>
                                    <option {% if unitTemplate == 14 %}selected{% endif %} value="14">Course - Lesson</option>
                                </select>
                            </label>
                        </div>
                    </fieldset>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>Default Access Permissions</label>
                        </div>
                    </fieldset>
                    <table>
                        <thead>
                            <tr>
                                <th>Role</th>
                                <th>None</th>
                                <th>Read</th>
                                <th>Write</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for role in roles %}
                                <tr>
                                    <td>{{ role.getName }}</td>
                                    <td>
                                        <input type="radio" name="unit_group[{{ role.getId }}]" id="unitGroupNone{{ role.getId }}" value="0" {{ permissions['unit'][role.getId][0] }}>
                                        <label class="radio-label" for="unitGroupNone{{ role.getId }}"></label>
                                    </td>
                                    <td>
                                        <input type="radio" name="unit_group[{{ role.getId }}]" id="unitGroupRead{{ role.getId }}" value="1" {{ permissions['unit'][role.getId][1] }}>
                                        <label class="radio-label" for="unitGroupRead{{ role.getId }}"></label>
                                    </td>
                                    <td>
                                        <input type="radio" name="unit_group[{{ role.getId }}]" id="unitGroupWrite{{ role.getId }}" value="2" {{ permissions['unit'][role.getId][2] }}>
                                        <label class="radio-label" for="unitGroupWrite{{ role.getId }}"></label>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </section>
            </div>
        </div>
        <div class="small-12 island">
            <button class="expand" type="submit">Save Changes</button>
        </div>
    </div>
</form>