{##
 # Preview
 #
 # @param array $settings  A (worktype, user, sourceFile) struct representing identification method, feedback author and uploaded csv
 # @param array $outcoem   A list of log messages
 #}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <section>
                <div class="content">
                    <ul>
                        <li><strong>Feedback Author:</strong>
                            {% if settings.feedbackAuthor.deleted %}
                                {{ settings.feedbackAuthor.fullname }}
                            {% else %}
                                <a href="/search/user/{{ settings.feedbackAuthor.id }}" target="_blank" title="{{ settings.feedbackAuthor.fullname }}">{{ settings.feedbackAuthor.fullname }}</a>
                            {% endif %}
                        </li>
                        <li><strong>Source File:</strong> <a href="/storage/fetch.php?hash={{ settings.sourceFile.hash }}">{{ settings.sourceFile.filename }}</a></li>
                    </ul>
                </div>
            </section>

            {% if outcome|length %}
                <h2 class="subheader">Preview</h2>
                <section class="content">
                    <div>
                        <ul class="information-list">
                            {% for row in outcome %}
                                <li>
                                    {% if row.type == 'warning' %}
                                        <span style="color:red">{{ row.message }}</span>
                                    {% else %}
                                        {{ row.message }}
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </section>
            {% endif %}
        </div>

        {# Recycle the form params for immediate effect #}
        {% set formRoute = routeLookupIfAuthorized('adminBulkAssessmentResult.postPerform') %}

        <div class="small-12 columns">
            <form action="{{ formRoute }}" method="post">
                <input type="hidden" name="worktypeId" value="{{ settings.worktype.id }}" />
                <input type="hidden" name="attachment" value="{{ settings.sourceFile.hash }}" />
                <input type="hidden" name="userId" value="{{ settings.feedbackAuthor.id }}" />
                <input type="submit" value="Perform Import" />
            </form>
        </div>
    </div>
</div>
