{##
 # Bulk Assessment Result configuration
 #
 # @param string $pageCurrent    The current page we're on
 # @param array $allBreadcrumbs  A set of breadcrumb nodes, as defined by Admin Subnav
 # @param Collection $worktypes  A list of Work Type instances, ordered by sequence
 #}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>

<script>
    $(function() {
        let bulkAssessmentResultForm = $('#bulkAssessmentResult');

        bulkAssessmentResultForm.find('input[data-selectizeuser]')
            .userSelectizeSelector({
                ajax: {
                    data: {roleTypeID: '{{ roletypeStaff }}'},
                }
            })
            .on('selectize.item_add', function() {
                bulkAssessmentResultForm.find(':submit').prop('disabled', false).focus();
            })
            .on('selectize.item_remove', function() {
                bulkAssessmentResultForm.find(':submit').prop('disabled', true);
            });

        bulkAssessmentResultForm.alaressValidate({
            rules: {
                'userId': {
                    'required': true
                },
                'assessmentTitle': {
                    'required': true
                },
                "sourceFile-file": {
                    required: {
                        depends: function () {
                            console.log('fox');
                            return document.getElementById("sourceFile-zone").querySelector("[data-dz-previews]").children.length === 0;
                        },
                    },
                },
            },
            messages: {
                'userId': {
                    'required': 'You must specify a feedback author before you can proceed'
                },
                "sourceFile-file-file": "Please attach a csv file",
            },
        });

        // Remove the error message when a worksheet file is uploaded
        $('#sourceFileZone').on('success.attachzone', () => {
            $('#sourceFile-file-error').remove();
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <section>
                <div class="content">
                    <p>To bulk import feedback (marks and/or comments) to due work items follow these instructions:</p>

                    <ol>
                        <li>Download and edit the template file using the link below.</li>
                        <li>Add compulsory data to the CSV for:
                            <ul>
                                <li><strong>Assessment ID(s).</strong> This can either be the Assessment ID for a Due Work item on a Class page or the Assessment ID for the Due Work item within the Course Builder on the Unit page.</li>
                                <li><strong>Class Code(s).</strong> Feedback will only be imported to classes where the data on the CSV matches that on a homepage within Schoolbox. If a homepage utilises multiple class codes, a match will occur on any of the class codes on the homepage.</li>
                                <li><strong>Student External ID.</strong> This value will come from the Student Information System, but can be found on the user profile in Schoolbox.</li>
                            </ul>
                        </li>
                        <li>Add optional data to the CSV for either 1 or 2 elements of feedback:
                            <ul>
                                <li><strong>Normalised Mark.</strong> This must use a value between 0 and 100. If the mark type is set to <em>Total Mark</em> or <em>Letter Grade</em>, Schoolbox will convert the grade on uploading the file. Leave this blank if using the mark type <em>None</em>.</li>
                                <li><strong>Comment.</strong> This will appear as written feedback and can be left blank if not wanting to add a comment.</li>
                            </ul>
                        </li>
                        <li>Select a Feedback Author below. Every feedback entry must be linked to a user for a successful import.</li>
                        <li>Upload the file. You will be presented with a preview screen for confirming the Feedback Author, publish date of the feedback and the result of each row of data imported.</li>
                    </ol>
                </div>
                <div class="component-action">
                    <section>
                        <a href="{{ CDN_PREFIX }}/adminv2/bulk-assessment-result/bulkFeedbackImportTemplate.csv" class="button">Download Template</a>
                    </section>
                </div>
            </section>
        </div>
        <div class="small-12 island">
            {% set formRoute = routeLookupIfAuthorized('adminBulkAssessmentResult.postPreview') %}

            <form action="{{ formRoute }}" method="post" id="bulkAssessmentResult">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="assessmentTitle" class="required">Assessment Title</label>
                            <input id="assessmentTitle" type="text" name="assessmentTitle" value='' />
                        </div>

                        <div class="small-12 columns">
                            <label for="worktype" class="required">Work Type</label>

                            <select id="worktype" name="worktypeId">
                                {% for worktype in worktypes %}
                                    <option value="{{ worktype.id }}">{{ worktype.name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="small-12 columns">
                            <label for="userId" class="required">Feedback Author</label>
                            <input id="userId" data-selectizeuser type="text" name="userId" placeholder="Search Users">
                        </div>

                        <div class="small-12 columns">
                            <label>Source File</label>
                            {% include 'sub/attachzone.twig' with { attachzone: sourceFileZone } %}
                            <input type="hidden" name="sourceFile-file" id="sourceFile-file" />
                        </div>
                    </fieldset>
                </section>

                <input type="submit" value="Preview" />
            </form>
        </div>
    </div>
</div>
