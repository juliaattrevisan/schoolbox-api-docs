{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <section>
                <div class="content">
                    <p>
                        This lets you create feedbacks en masse for all Due Work activities that match the selected work type.
                    </p>
                    <p>
                        Each feedback must be associated with a user who represents its owner, regardless of whomever
                        actually performs the import. You'll get an opportunity to preview the outcome before committing
                        to actually creating the feedbacks; once created, they cannot be removed.
                    </p>
                </div>
                <div class="component-action">
                    <section>
                        <a href="{{ CDN_PREFIX }}/adminv2/bulk-assessment-result/bulkAssessmentResultTemplate.csv" class="button">Download Template</a>
                    </section>
                </div>
            </section>
        </div>
        <div class="small-12 island">
            {% set formRoute = routeLookupIfAuthorized('adminBulkAssessmentResult.postPreview') %}

            <form action="{{ formRoute }}" method="post">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="worktype" class="required">Work Type</label>

                            <select id="worktype" name="worktype">
                                {% for worktype in worktypes %}
                                    <option value="{{ worktype.id }}">{{ worktype.name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        Feedback Owner
                    </fieldset>
                </section>
                <input type="submit" />
            </form>
        </div>
    </div>
</div>
