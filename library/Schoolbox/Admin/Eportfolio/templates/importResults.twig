<script>
    $(function () {
        window.skipCount = 0;
        window.countErrors = 0;

        function update() {
            $.get('{{ routeLookup('adminEportfolio.getImportProgress', {id: id}) }}' + window.skipCount)
                    .success(function (data) {
                        if (data.logs.length > 0) {

                            // Add any new errors to the end of the table body

                            for (var i = 0; i < data.logs.length; i++) {

                                var createdAt = data.logs[i]['created_at'];
                                var result = data.logs[i]['result'];

                                $("#table-body").append("<tr><td>" + createdAt + "</td><td>" + result + "</td></tr>");
                            }

                            // Keep polling for updates if the import hasn't completed/failed

                            if (data.status != 'COMPLETED') {
                                window.setTimeout(update, 2000);
                                $('#progress').html('Deployment In Progress');
                            } else {
                                $('#progress').html('Deployment Completed');
                            }
                        } else {
                            if (data.status != 'COMPLETED') {
                                window.setTimeout(update, 2000);
                                $('#progress').html('Deployment In Progress');
                            } else {
                                $('#progress').html('Deployment Completed');
                            }
                        }

                        window.skipCount += data.logs.length;
                    });
        }

        update();
    });
</script>

{# Shared navigation menu #}
{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 columns">
        <h1 id="progress"></h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Deployment Log</h2>
        <table>
            <thead>
            <tr>
                <th>Time</th>
                <th width="100%">Description</th>
            </tr>
            </thead>
            <tbody id="table-body"></tbody>
        </table>
    </div>
</div>