{% import '@adminVideo/macros/statusIcon.twig' as statusIcon %}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/dataTables.js?v={{ config.site_version }}"></script>
<script>
    $(function () {
        $('[data-submit]').click(function (e) {
            e.preventDefault();
            var formName = '#update' + $(this).data('submit');
            var form = $(formName);
            $(formName + ' input[name="videoAction"]').val('resubmit');
            form.submit();
        });
        $('[data-delete]').click(function (e) {
            e.preventDefault();
            var deleteId = $(this).data('delete');
            var row = $(this).closest('tr');
            var toaster = $('#toaster');
            $(this).confirmDialog({
                text: 'Are you sure you want to remove this video from the queue?',
                confirmEvent: function () {
                    toaster.toastActivate({text: 'Removing'});
                    $.post('{{ routeLookup('adminVideo.postSubmit') }}', {
                        videoId: deleteId,
                        videoAction: 'delete'
                    }).done(function () {
                        $(row).remove();
                        if ($('[data-delete]').length == 0) {
                            $('#empty').removeClass('hide');
                        }
                        toaster.toastTimeout({text: 'Removed from queue', css: 'success'});
                    }).fail(function () {
                        toaster.toastTimeout({text: 'Error removing item from queue', css: 'alert'});
                    });
                }
            });
        });

        $('table[data-sortable]').DataTable({
            info: false,
            paging: false,
            searching: false
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            {% if queue | length %}

                {% for status in statusOrder %}

                    {% for video in queue[status]|default([]) %}

                        {% if loop.first %}
                            <h2 class="subheader">
                                {{ status }} Media Conversions
                            </h2>
                            <table data-sortable>
                                <thead>
                                <tr>
                                    <th>Uploaded At</th>
                                    <th>Uploaded By</th>
                                    <th>File Name</th>
                                    <th>Duration</th>
                                    <th>Size</th>
                                    <th>Mime</th>
                                    <th data-sortable="false"></th>
                                </tr>
                                </thead>
                        {% endif %}
                                <tr>
                                    <td>{{ video.createdAt.database }}</td>
                                    <td>{% if video.user %}<a href="/search/user/{{ video.user.id }}">{{ video.user.fullName }}</a>{% else %}Unknown{% endif %}</td>
                                    <td>{{ video.storage.filename }}</td>
                                    <td>{{ video.duration }}</td>
                                    <td data-order="{{ video.storage.size  }}">{{ video.storage.size | bytes }}</td>
                                    <td>{{ video.storage.mime }}</td>
                                    <td class="actions-small-3">
                                        <nav>
                                            {% if video.isFailed %}
                                                <form id="update{{ video.id }}" method="post" action="{{ routeLookup('adminVideo.postSubmit') }}">
                                                    <input type="hidden" value="{{ video.id }}" name="videoId">
                                                    <input type="hidden" value="" name="videoAction">
                                                    <a class="icon-download no-text" href="/storage/fetch.php?hash={{ video.storage.hash }}" title="Download file"></a>
                                                    <a class="icon-search no-text" data-view="{{ video.id }}" href="#" title="View Transcode Results" data-reveal-id="ajax-load" data-reveal-ajax="/adminv2/video/{{ video.id }}"></a>
                                                    <a class="icon-refresh no-text" data-submit="{{ video.id }}" href="#" title="Restart Processing"></a>
                                                    <a class="icon-delete no-text" data-delete="{{ video.id }}" href="#" title="Delete From Queue"></a>
                                                </form>
                                            {% endif %}
                                        </nav>
                                    </td>
                                </tr>
                        {% if loop.last %}
                            </table>
                        {% endif %}

                    {% endfor %}

                {% endfor %}

                <div id="empty" class="empty-state hide">
                    <i class="icon-video"></i>
                    <p>There are no failed, pending or processing media transcodes.</p>
                </div>

            {% else %}

                <div class="empty-state">
                    <i class="icon-video"></i>
                    <p>There are no failed, pending or processing media transcodes.</p>
                </div>

            {% endif %}
        </div>
    </div>
</div>

<div data-reveal id="ajax-load" class="reveal-modal"></div>

<div class="toast" id="toaster"></div>

