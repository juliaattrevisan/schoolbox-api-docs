{% import '@adminVideo/macros/statusIcon.twig' as statusIcon %}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/dataTables.js?v={{ config.site_version }}"></script>
<script>
    $(function () {
        $('[data-restart-processing]').on('click', async function (e) {
            e.preventDefault();
            const deleteId = $(this).data('restartProcessing');
            const row = $(this).closest('tr');

            const toast = window.sbProps.toastActivate("Restarting processing...");
            try {
                const response = await fetch(
                    "{{ routeLookup('adminVideo.postSubmit') }}",
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            videoId: deleteId,
                            videoAction: 'resubmit'
                        })
                    }
                );

                if (!response.ok) {
                    throw new Error('Error restarting processing of item');
                }

                /* reload the page since the item will be in a different section now
                 * note, the toast is left loading since the page will reload */
                window.location.reload();
            } catch (error) {
                console.error(error);
                toast.timeout({
                    text: 'Error restarting processing of item',
                    isSuccess: false
                });
            }
        });
        $('[data-delete]').on('click', function (e) {
            e.preventDefault();
            var deleteId = $(this).data('delete');
            var row = $(this).closest('tr');
            var toaster = $('#toaster');
            $(this).confirmDialog({
                text: 'Are you sure you want to remove this video from the queue?',
                confirmEvent: function () {
                    toaster.toastActivate({text: 'Removing'});
                    $.post('{{ routeLookup('adminVideo.postSubmit') }}', {
                        videoId: deleteId,
                        videoAction: 'delete'
                    }).done(function () {
                        $(row).remove();
                        if ($('[data-delete]').length == 0) {
                            $('#empty').removeClass('hide');
                        }
                        toaster.toastTimeout({text: 'Removed from queue', css: 'success'});
                    }).fail(function () {
                        toaster.toastTimeout({text: 'Error removing item from queue', css: 'alert'});
                    });
                }
            });
        });

        $('table[data-sortable]').DataTable({
            info: false,
            paging: false,
            searching: false
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            {% if queue | length %}

                {% for status in statusOrder %}

                    {% for video in queue[status]|default([]) %}

                        {% if loop.first %}
                            <h2 class="subheader">
                                {{ status }} Media Conversions
                            </h2>
                            <table data-sortable>
                                <thead>
                                <tr>
                                    <th>Uploaded At</th>
                                    <th>Uploaded By</th>
                                    <th>File Name</th>
                                    <th>Duration</th>
                                    <th>Size</th>
                                    <th>Mime</th>
                                    <th data-sortable="false"></th>
                                </tr>
                                </thead>
                        {% endif %}
                                <tr>
                                    <td>{{ video.createdAt.database }}</td>
                                    <td>{% if video.user %}<a href="/search/user/{{ video.user.id }}">{{ video.user.fullName }}</a>{% else %}Unknown{% endif %}</td>
                                    <td>{{ video.storage.filename }}</td>
                                    <td>{{ video.duration }}</td>
                                    <td data-order="{{ video.storage.size  }}">{{ video.storage.size | bytes }}</td>
                                    <td>{{ video.storage.mime }}</td>
                                    <td class="actions-small-3">
                                        <nav>
                                            {% if video.isFailed %}
                                                <a class="sbx-icon-only-button no-text" href="/storage/fetch.php?hash={{ video.storage.hash }}" title="Download file" aria-label="Download file"><sbx-icon name="download"></sbx-icon></a>
                                                <a class="sbx-icon-only-button no-text" data-view="{{ video.id }}" href="#" title="View Transcode Results" aria-label="View Transcode Results" data-reveal-id="ajax-load" data-reveal-ajax="/adminv2/video/{{ video.id }}"><sbx-icon name="search"></sbx-icon></a>
                                                <a class="sbx-icon-only-button no-text" data-restart-processing="{{ video.id }}" href="#" title="Restart Processing" aria-label="Restart Processing"><sbx-icon name="refresh"></sbx-icon></a>
                                                <a class="sbx-icon-only-button no-text" data-delete="{{ video.id }}" href="#" title="Delete From Queue" aria-label="Delete From Queue"><sbx-icon name="delete"></sbx-icon></a>
                                            {% endif %}
                                        </nav>
                                    </td>
                                </tr>
                        {% if loop.last %}
                            </table>
                        {% endif %}

                    {% endfor %}

                {% endfor %}

                <div id="empty" class="empty-state hide">
                    <sbx-icon name="video" size="2.5rem"></sbx-icon>
                    <p>There are no failed, pending or processing media transcodes.</p>
                </div>

            {% else %}

                <div class="empty-state">
                    <sbx-icon name="video" size="2.5rem"></sbx-icon>
                    <p>There are no failed, pending or processing media transcodes.</p>
                </div>

            {% endif %}
        </div>
    </div>
</div>

<div data-reveal id="ajax-load" class="reveal-modal"></div>

<div class="toast" id="toaster"></div>
