{##
 # Configuration panels for AI Services
 #
 # Each panel presents a user interface that represents (ultimately) a serialized payload that we persist to the db.
 # Each payload consists of all the possible settings but only a subset is shown, such as all the azure-related ones
 # if you enabled an Azure-based service.
 #
 # System Prompts are customisable per-feature.
 #
 # @param array $feature  A set of configurations per-feature with their own values and representations
 #}


<div data-feature="{{ feature.feature }}" data-test="ai-feature-{{ feature.feature }}">
    {% for name, formInput in feature.formInputs %}
        {% include '@adminOpenAi/formInput.twig' with {
            name: name,
            formInput: formInput,
            feature: feature,
        } only %}
    {% endfor %}

    <script type="application/javascript">
    (() => {
        // use a const feature as the container selector
        const REASONING_EFFORT_MODEL_OPTIONS = {{ reasoningEffortModelOptions | json_encode | raw }};
        const TEXT_VERBOSITY_MODEL_OPTIONS   = {{ textVerbosityModelOptions | json_encode | raw }};
        const FEATURE                        = '{{ feature.feature }}';
        const featureEl                      = document.querySelector(`[data-feature="${FEATURE}"]`);
        const providerSelect                 = featureEl.querySelector(`#${FEATURE}-provider-value`);
        const modelSelect                    = featureEl.querySelector(`#${FEATURE}-model-value`);
        const reasoningEffortSelect          = featureEl.querySelector(`#${FEATURE}-reasoning_effort-value`);
        const textVerbositySelect            = featureEl.querySelector(`#${FEATURE}-text_verbosity-value`);

        /**
         * reusable function to show/hide fields based on provider
         * @param provider
         */
        function toggleInputVisibility(provider) {
            // hide all fields
            featureEl.querySelectorAll('[data-feature-openai]').forEach(el => el.style.display = 'none');
            featureEl.querySelectorAll('[data-feature-azure]').forEach(el => el.style.display = 'none');

            if (provider === 'OpenAI') {
                featureEl.querySelectorAll('[data-feature-openai]').forEach(el => el.style.display = 'block');
                return;
            } else if (provider === 'Azure') {
                featureEl.querySelectorAll('[data-feature-azure]').forEach(el => el.style.display = 'block');
                return;
            }
        }

        /**
         * Reusable function for enabling/disabling options, based on the
         * selected model and provider.
         *
         * @param baseOptions
         * @param model
         * @param provider
         * @param selectEl
         */
        function toggleOptions(baseOptions, model, provider, selectEl) {
            if (!selectEl) {
                return;
            }
            const modelOptions = baseOptions[model] ?? null;
            Array.from(selectEl.options).forEach(el => {
                if (el.value !== null) {
                    if (provider === 'OpenAI') {
                        if (modelOptions !== null) {
                            el.disabled = !modelOptions.includes(el.value);
                        }
                    } else {
                        el.disabled = false;
                    }
                }
            });
        }

        /**
         * If the currently selected option in `selectEl` is now disabled:
         * select the first option which is not disabled.
         *
         * @param selectEl
         */
        function selectFirstNonDisabledOption(selectEl) {
            if (!selectEl) {
                return;
            }
            const selectedAndDisabled = Array.from(selectEl.options).find(el => el.selected && el.disabled);
            if (selectedAndDisabled) {
                const firstEnabled = Array.from(selectEl.options).find(el => !el.disabled);
                if (firstEnabled) {
                    firstEnabled.selected = true;
                }
            }
        }

        // Disable reasoning levels which are incompatible with the model
        modelSelect.addEventListener('change', (event) => {
            toggleOptions(REASONING_EFFORT_MODEL_OPTIONS[FEATURE], event.target.value, providerSelect.value, reasoningEffortSelect);
            selectFirstNonDisabledOption(reasoningEffortSelect);

            toggleOptions(TEXT_VERBOSITY_MODEL_OPTIONS[FEATURE], event.target.value, providerSelect.value, textVerbositySelect);
            selectFirstNonDisabledOption(textVerbositySelect);
        });

        // when changing the provider select, show/hide the relevant fields
        providerSelect.addEventListener('change', (event) => {
            toggleInputVisibility(event.target.value);

            toggleOptions(REASONING_EFFORT_MODEL_OPTIONS[FEATURE], modelSelect.value, event.target.value, reasoningEffortSelect);
            selectFirstNonDisabledOption(reasoningEffortSelect);

            toggleOptions(TEXT_VERBOSITY_MODEL_OPTIONS[FEATURE], modelSelect.value, event.target.value, textVerbositySelect);
            selectFirstNonDisabledOption(textVerbositySelect);
        });

        // on page load, show the current selected provider fields
        document.addEventListener('DOMContentLoaded', () => {
            toggleInputVisibility(providerSelect.value);
            toggleOptions(REASONING_EFFORT_MODEL_OPTIONS[FEATURE], modelSelect.value, providerSelect.value, reasoningEffortSelect);
            toggleOptions(TEXT_VERBOSITY_MODEL_OPTIONS[FEATURE], modelSelect.value, providerSelect.value, textVerbositySelect);
        });
    })();
    </script>
</div>
