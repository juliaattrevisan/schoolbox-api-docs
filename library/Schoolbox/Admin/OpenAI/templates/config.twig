{##
 # Configuration panels for AI Services
 #
 # Each panel presents a user interface that represents (ultimately) a serialized payload that we persist to the db.
 # Each payload consists of all the possible settings but only a subset is shown, such as all the azure-related ones
 # if you enabled an Azure-based service.
 #
 # System Prompts are customisable per-feature.
 #
 # @param array $feature  A set of configurations per-feature with their own values and representations
 #}


<div data-feature="{{ feature.feature }}" data-test="ai-feature-{{ feature.feature }}">
    {% set advancedInputs = '' %}
    {% for name, formInput in feature.formInputs %}
        {#
         # Is this an advanced feature?
         # If so, hide it in an advanced settings accordion.
         #
         # For now assume that all advanced settings are in the General section.
         #}
        {% set formInputHtml %}
            {% include '@adminOpenAi/formInput.twig' with {
                name: name,
                formInput: formInput,
                feature: feature,
            } only %}
        {% endset %}
        {% if not (formInput.advanced ?? false) %}
            {{ formInputHtml | raw }}
        {% else %}
            {% set advancedInputs = advancedInputs ~ formInputHtml %}
        {% endif %}
    {% endfor %}

    {% if advancedInputs is not empty %}
        <fieldset data-advanced-options>
            <legend>
                <a href="#" class="icon-down-arrow" data-collapser="ai-feature-{{ feature.feature }}-advanced">Advanced Settings</a>
            </legend>
            <section class="hide" data-collapsable="ai-feature-{{ feature.feature }}-advanced" data-collapse-state="collapsed">
                {{ advancedInputs | raw }}
            </section>
        </fieldset>
    {% endif %}

    <script type="application/javascript">
    (() => {
        // use a const feature as the container selector
        const REASONING_EFFORT_MODEL_OPTIONS = {{ reasoningEffortModelOptions | json_encode | raw }};
        const TEXT_VERBOSITY_MODEL_OPTIONS   = {{ textVerbosityModelOptions | json_encode | raw }};
        const FEATURE                        = '{{ feature.feature }}';
        const featureEl                      = document.querySelector(`[data-feature="${FEATURE}"]`);
        const providerSelect                 = featureEl.querySelector(`#${FEATURE}-provider-value`);
        const modelSelect                    = featureEl.querySelector(`#${FEATURE}-model-value`);
        const azureDeploymentModelSelect     = featureEl.querySelector(`#${FEATURE}-deployment_model-value`);
        const reasoningEffortSelect          = featureEl.querySelector(`#${FEATURE}-reasoning_effort-value`);
        const textVerbositySelect            = featureEl.querySelector(`#${FEATURE}-text_verbosity-value`);

        /**
         * reusable function to show/hide fields based on provider
         * @param provider
         */
        function toggleInputVisibility(provider) {
            // hide all fields
            let openAiFeatures = featureEl.querySelectorAll('[data-feature-openai]'),
                azureFeatures = featureEl.querySelectorAll('[data-feature-azure]'),
                advancedOptions = featureEl.querySelectorAll('[data-advanced-options]');

            openAiFeatures.forEach(el => el.style.display = 'none');
            azureFeatures.forEach(el => el.style.display = 'none');
            advancedOptions.forEach(el => el.style.display = 'none');

            if (provider === 'OpenAI') {
                openAiFeatures.forEach(el => el.style.display = 'block');
                advancedOptions.forEach(el => el.style.display = 'block');
            } else if (provider === 'Azure') {
                azureFeatures.forEach(el => el.style.display = 'block');
                advancedOptions.forEach(el => el.style.display = 'block');
            }
        }

        /**
         * Reusable function for enabling/disabling options, based on the
         * selected model and provider.
         *
         * @param baseOptions
         * @param model
         * @param selectEl
         */
        function toggleOptions(baseOptions, model, selectEl) {
            if (!selectEl) {
                return;
            }
            const modelOptions = baseOptions[model] ?? null;
            Array.from(selectEl.options).forEach(el => {
                if (el.value !== null) {
                    el.disabled = !modelOptions.includes(el.value);
                }
            });
        }

        /**
         * If the currently selected option in `selectEl` is now disabled:
         * select the first option which is not disabled.
         *
         * @param selectEl
         */
        function selectFirstNonDisabledOption(selectEl) {
            if (!selectEl) {
                return;
            }
            const selectedAndDisabled = Array.from(selectEl.options).find(el => el.selected && el.disabled);
            if (selectedAndDisabled) {
                const firstEnabled = Array.from(selectEl.options).find(el => !el.disabled);
                if (firstEnabled) {
                    firstEnabled.selected = true;
                }
            }
        }

        /**
         * Set the availability of options, depending on what is selected in the
         * model selector.
         *
         * @param modelSelector          The model selector: for OpenAI, the OpenAI Model selector; for Azure, the
         *                               Azure deployment model selector.
         * @param selectFirstNonDisabled Should the first non-disabled option be selected automatically?
         *                               True if switching after page load, false on initial page load.
         */
        function setOptionAvailability(modelSelector, selectFirstNonDisabled) {
            toggleOptions(REASONING_EFFORT_MODEL_OPTIONS[FEATURE], modelSelector.value, reasoningEffortSelect);
            toggleOptions(TEXT_VERBOSITY_MODEL_OPTIONS[FEATURE], modelSelector.value, textVerbositySelect);

            if (selectFirstNonDisabled) {
                selectFirstNonDisabledOption(textVerbositySelect);
                selectFirstNonDisabledOption(reasoningEffortSelect);
            }
        }

        // Disable reasoning levels which are incompatible with the model
        modelSelect.addEventListener('change', (event) => {
            setOptionAvailability(event.target, true)
        });
        azureDeploymentModelSelect.addEventListener('change', (event) => {
            setOptionAvailability(event.target, true)
        });

        // when changing the provider select, show/hide the relevant fields
        providerSelect.addEventListener('change', (event) => {
            toggleInputVisibility(event.target.value);

            // Toggle options based on whichever model selector is visible:
            // OpenAI's direct model selector, or Azure's deployment model
            if (event.target.value === 'OpenAI') {
                setOptionAvailability(modelSelect, true)
            } else if (event.target.value === 'Azure') {
                setOptionAvailability(azureDeploymentModelSelect, true)
            }
        });

        // on page load, show the current selected provider fields
        document.addEventListener('DOMContentLoaded', () => {
            toggleInputVisibility(providerSelect.value);

            // Toggle options based on whichever model selector is visible:
            // OpenAI's direct model selector, or Azure's deployment model.
            // Do not select the first non-disabled option, though:
            // leave whatever is selected at first, selected.
            if (providerSelect.value === 'OpenAI') {
                setOptionAvailability(modelSelect, false)
            } else if (providerSelect.value === 'Azure') {
                setOptionAvailability(azureDeploymentModelSelect, false)
            }
        });
    })();
    </script>
</div>
