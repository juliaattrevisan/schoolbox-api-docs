<div data-feature="{{ feature.feature }}">
    <label id="{{ feature.feature }}-provider" for="{{ feature.feature }}-provider-value">
        <span>Provider</span>
        <span data-tooltip class="has-tip tip-top hint"  data-allow-html='true' title='Select which provider you will use for conducting AI text queries; choose "Off" to disable this feature.'>?</span>
    </label>
    <select id="{{ feature.feature }}-provider-value" type="text" name="[{{ feature.feature }}][{{ fields.provider }}]">
        {% for provider in providers %}
            <option value="{{ provider }}"{% if feature.config.provider ==  provider %} selected {% endif %}>{{ provider }}</option>
        {% endfor %}
    </select>

    <label id="{{ feature.feature }}-open_ai_key" for="{{ feature.feature }}-open_ai_key-value" data-feature-openai data-feature-azure style="display:none">
        <span>OpenAI API Key</span>
        <span data-tooltip class="has-tip tip-top hint"  data-allow-html='true' title="This is your secure key for authorising GPT based AI assistant services. The key can be created at https://openai.com/ or in Azure.">?</span>
    </label>
    <input id="{{ feature.feature }}-open_ai_key-value" type="text" name="[{{ feature.feature }}][OpenAI][open_ai_key][value]" value="{{ feature.config.OpenAI.open_ai_key.value }}" data-feature-openai data-feature-azure style="display:none">

    <label id="{{ feature.feature }}-model" for="{{ feature.feature }}-model-value" data-feature-openai style="display:none">
        <span>OpenAI Model</span>
        <span data-tooltip class="has-tip tip-top hint"  data-allow-html='true' title="Select which model you wish to use for your OpenAI service.">?</span>
    </label>
    <select id="{{ feature.feature }}-model-value" type="text" name="[{{ feature.feature }}][OpenAI][model][value]" data-feature-openai style="display:none">
        <option value="">-- select an option --</option>
        {% for model in models %}
            <option value="{{ model }}"{% if feature.config.OpenAI.model.value ==  model %} selected {% endif %}>{{ model }}</option>
        {% endfor %}
    </select>

    <label id="{{ feature.feature }}-resource_name" for="{{ feature.feature }}-resource_name-value" data-feature-azure style="display:none">
        <span>Azure OpenAI Resource Name</span>
        <span data-tooltip class="has-tip tip-top hint"  data-allow-html='true' title="The name of your Azure OpenAI Resource.">?</span>
    </label>
    <input id="{{ feature.feature }}-resource_name-value" type="text" name="[{{ feature.feature }}][Azure][resource_name][value]" value="{{ feature.config.Azure.resource_name.value }}" data-feature-azure style="display:none">

    <label id="{{ feature.feature }}-deployment_id" for="{{ feature.feature }}-deployment_id-value" data-feature-azure style="display:none">
        <span>Azure OpenAI Deployment ID</span>
        <span data-tooltip class="has-tip tip-top hint"  data-allow-html='true' title="The deployment name you chose when you deployed the model in Azure.">?</span>
    </label>
    <input id="{{ feature.feature }}-deployment_id-value" type="text" name="[{{ feature.feature }}][Azure][deployment_id][value]" value="{{ feature.config.Azure.deployment_id.value }}" data-feature-azure style="display:none">

    <label id="{{ feature.feature }}-system_prompt" for="{{ feature.feature }}-system_prompt-value" data-feature-azure data-feature-openai style="display:none">
        <span>{{ feature.title }} Generation System Prompt</span>
        <span data-tooltip class="has-tip tip-top hint"  data-allow-html='true' title="Provide some additional instructions to shape what the AI service generates for {{ feature.title }} Generation requests.">?</span>
    </label>
    <textarea id="{{ feature.feature }}-system_prompt-value" name="[{{ feature.feature }}][OpenAI][system_prompt][value]" rows="5" data-feature-azure data-feature-openai style="display:none">{{ feature.config.OpenAI.system_prompt.value }}</textarea>

    <script type="application/javascript">
    (() => {
        // use a const feature as the container selector
        const FEATURE = '{{ feature.feature }}';
        const featureEl = document.querySelector(`[data-feature="${FEATURE}"]`);

        /**
         * reusable function to show/hide fields based on provider
         * @param provider
         */
        function showHide(provider) {
            // hide all fields
            featureEl.querySelectorAll('[data-feature-openai]').forEach(el => el.style.display = 'none');
            featureEl.querySelectorAll('[data-feature-azure]').forEach(el => el.style.display = 'none');

            if (provider === 'OpenAI') {
                featureEl.querySelectorAll('[data-feature-openai]').forEach(el => el.style.display = 'block');
                return;
            } else if (provider === 'Azure') {
                featureEl.querySelectorAll('[data-feature-azure]').forEach(el => el.style.display = 'block');
                return;
            }
        }

        // on page load, show the current selected provider fields
        document.addEventListener('DOMContentLoaded', () => {
            const currentValue = featureEl.querySelector(`#${FEATURE}-provider-value`).value;
            showHide(currentValue);
        });

        // when changing the provider select, show/hide the relevant fields
        featureEl.querySelector(`#${FEATURE}-provider-value`).addEventListener('change', (event) => {
            const value = event.target.value;

            // show relevant fields
            showHide(value);
        });
    })();
    </script>
</div>
