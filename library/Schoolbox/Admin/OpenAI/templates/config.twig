{##
 # Configuration panels for AI Services
 #
 # Each panel presents a user interface that represents (ultimately) a serialized payload that we persist to the db.
 # Each payload consists of all the possible settings but only a subset is shown, such as all the azure-related ones
 # if you enabled an Azure-based service.
 #
 # System Prompts are customisable per-feature.
 #
 # @param array $feature  A set of configurations per-feature with their own values and representations
 #}

{# A set of (name, (title/description)) tuples for easy-to-read indexing here
 # Also, when you add a new thing, it's easier to see where
 #}
{% set manifest = {
    'provider': {
        'title': 'Provider',
        'description': 'Select which provider you will use for this AI service; choose "Off" to disable this feature.'
    },
    'ai_key': {
        'title': 'OpenAI API Key',
        'description': 'This is your secure key for authorising GPT based AI assistant services. The key can be created at https://openai.com/ or in Azure.'
    },
    'model': {
        'title': 'OpenAI Model',
        'description': 'Select which model you wish to use for your OpenAI service.'
    },
    'resource_name': {
        'title': 'Azure OpenAI Resource Name',
        'description': 'The name of your Azure OpenAI Resource.'
    },
    'deployment_id': {
        'title': 'Azure OpenAI Deployment ID',
        'description': 'The deployment name you chose when you deployed the model in Azure.'
    },
    'system_prompt': {
        'title': 'Generation System Prompt',
        'description': 'Provide some additional instructions to shape what the AI service generates for requests.'
    },
    'output_quality': {
        'title': 'Output Quality',
        'description': 'Select which output quality you wish to use for image generation. A higher quality will improve the result of more complex images but will take longer to generate and use more credit.'
    }
} %}

<div data-feature="{{ feature.feature }}">
    {% for name, formInput in feature.formInputs %}
        {% set section = formInput.section ?? null %}

        {# "provider" doesn't belong in a section and has its own treatment... #}
        {% if section is null %}
            {% set inputName %}[{{ feature.feature }}][{{ name }}][value]{% endset %}
            {% set inputValue %}{{ feature.config[name].value ?? '' }}{% endset %}
        {% else %}
            {% set inputName %}[{{ feature.feature }}][{{ section }}][{{ name }}][value]{% endset %}
            {% set inputValue %}{{ feature.config[section][name].value ?? '' }}{% endset %}
        {% endif %}

        {# Output depends on formInput.field #}
        {% set type = formInput.type %}

        {# As does style and attributes #}
        {% if section == 'general' %}
            {% set dataAttrs = "data-feature-openai data-feature-azure" %}
            {% set style = 'display:none' %}
        {% elseif section == 'OpenAI' %}
            {% set dataAttrs = "data-feature-openai" %}
            {% set style = 'display:none' %}
        {% elseif section == 'Azure' %}
            {% set dataAttrs = "data-feature-azure" %}
            {% set style = 'display:none' %}
        {% else %}
            {% set dataAttrs = '' %}
            {% set style = '' %}
        {% endif %}

        {# Generate label and description from a lookup here, instead of in PHP code #}
        {% set title = manifest[name].title ?? 'No title - please add one' %}
        {% set description = manifest[name].description ?? 'No description - please add one' %}

        <label id="{{ feature.feature }}-{{ name }}-label"
               for="{{ feature.feature }}-{{ name }}-value"
               {{ dataAttrs }}
               {{ style }}
        >
            <span>{{ title }}</span>
            <span data-tooltip class="has-tip tip-top hint" data-allow-html='true' title='{{ description }}'>?</span>
        </label>

        {% if type == 'textarea' %}
            <textarea id="{{ feature.feature }}-{{ name }}-value"
                      name="{{ inputName }}"
                      rows="5"
                      {{ dataAttrs }}
                      {{ style }}
            >{{ inputValue }}</textarea>
        {% elseif type == 'select' %}
            <select id="{{ feature.feature }}-{{ name }}-value"
                    name="{{ inputName }}"
                    {{ dataAttrs }}
                    {{ style }}
            >
                <option value="" disabled>-- select an option --</option>
                {% for option in formInput.options %}
                    <option value="{{ option }}"{% if inputValue == option %} selected {% endif %}>{{ option }}</option>
                {% endfor %}
            </select>
        {% else %}
            <input id="{{ feature.feature }}-{{ name }}-value"
                   type="text"
                   name="{{ inputName }}"
                   value="{{ inputValue }}"
                   {{ dataAttrs }}
                   style="display:none"
            />
        {% endif %}
    {% endfor %}

    <script type="application/javascript">
    (() => {
        // use a const feature as the container selector
        const FEATURE = '{{ feature.feature }}';
        const featureEl = document.querySelector(`[data-feature="${FEATURE}"]`);

        /**
         * reusable function to show/hide fields based on provider
         * @param provider
         */
        function showHide(provider) {
            // hide all fields
            featureEl.querySelectorAll('[data-feature-openai]').forEach(el => el.style.display = 'none');
            featureEl.querySelectorAll('[data-feature-azure]').forEach(el => el.style.display = 'none');

            if (provider === 'OpenAI') {
                featureEl.querySelectorAll('[data-feature-openai]').forEach(el => el.style.display = 'block');
                return;
            } else if (provider === 'Azure') {
                featureEl.querySelectorAll('[data-feature-azure]').forEach(el => el.style.display = 'block');
                return;
            }
        }

        // on page load, show the current selected provider fields
        document.addEventListener('DOMContentLoaded', () => {
            const currentValue = featureEl.querySelector(`#${FEATURE}-provider-value`).value;
            showHide(currentValue);
        });

        // when changing the provider select, show/hide the relevant fields
        featureEl.querySelector(`#${FEATURE}-provider-value`).addEventListener('change', (event) => {
            const value = event.target.value;

            // show relevant fields
            showHide(value);
        });
    })();
    </script>
</div>
