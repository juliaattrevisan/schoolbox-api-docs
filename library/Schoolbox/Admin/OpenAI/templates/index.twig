{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <h2>Settings go here</h2>
        </div>

        {% include '@adminImportIndex/schoolData/dsn/moduleConfig.twig' with configContext only %}

        <script>
            $(function() {
                const PROVIDER_OPENAI = 'OpenAI';
                const PROVIDER_AZURE = 'Azure';

                let provider = $('#openai_endpoint-field');
                let key = $('#openai_key-field').parent('div');
                let model = $('#openai_model-field').parent('div');
                let azureResourceName = $('#openai_azure_resource_name-field').parent('div');
                let azureDeploymentId = $('#openai_azure_deployment_id-field').parent('div');

                init(provider, key, model, azureResourceName, azureDeploymentId);

                provider.on('change', function(event) {
                    event.preventDefault();
                    init(provider, key, model, azureResourceName, azureDeploymentId)
                })

                /**
                 *  Hide everything if you haven't chozen a provider yet
                 */
                function init(provider, key, model, azureResourceName, azureDeploymentId)
                {
                    if ('' === provider.val()) {
                        key.parent('div').hide();
                        model.hide();
                        azureResourceName.hide();
                        azureDeploymentId.hide();
                    } else if (PROVIDER_OPENAI === provider.val()) {
                        key.show();
                        model.show();
                        azureResourceName.hide();
                        azureDeploymentId.hide();
                    } else if (PROVIDER_AZURE === provider.val()) {
                        key.show();
                        model.hide();
                        azureResourceName.show();
                        azureDeploymentId.show();
                    }
                }
            });
        </script>

        <div class="small-12 columns">
            <table>
                <thead>
                    <tr>
                        <th></th>
                        <th>CKEditor AI</th>
                        <th>Lesson Plans AI</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>gpt-4</td>
                        <td>Yes</td>
                        <td>No</td>
                    </tr>
                    <tr>
                        <td>gpt-4o</td>
                        <td>Yes</td>
                        <td>Yes</td>
                    </tr>
                    <tr>
                        <td>gpt-4o-mini</td>
                        <td>Yes</td>
                        <td>Yes</td>
                    </tr>
                    <tr>
                        <td>gpt-4-turbo</td>
                        <td>Yes</td>
                        <td>No</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>