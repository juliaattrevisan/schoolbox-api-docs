{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <h2 class="subheader" style="display:none" data-subheader>Text Generation</h2>
        </div>

        {# main text config space, which provider. #}
        <div class="small-12 columns island">
            <section id="textSettingsContainer">
                {# module specific config #}
                <form id="textForm" method="post" action="{{ routeLookupIfAuthorized('adminOpenAi.postTextOptions') }}">
                    <div id="textModuleContainer" class="l-grid l-gap-l l-mar-m--bottom" style="display:none">
                        {% for feature in features %}
                            {% include '@adminOpenAi/config.twig' with {feature:feature, providers:providers, models:models, fields:fields} only %}
                        {% endfor %}
                    </div>
                    {# manually create a save button for this section... #}
                    <input id="textFormSubmit" type="submit" value="Save">
{#                    <div id="save-admin-settings-container">#}
{#                        <save-admin-settings#}
{#                                form-id="textForm"#}
{#                                :use-polling="'false'"#}
{#                        />#}
{#                    </div>#}
{#                    <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/saveAdminSettings.js?v={{ config.site_version }}"></script>#}
                </form>
            </section>
        </div>

        <div class="small-12 columns">
            <h2 class="subheader" style="display:none" data-subheader>Image Generation</h2>
        </div>

        <div id="imageSettingsContainer" style="display:none">
            {% include '@settings/moduleConfig.twig' with imageConfigContext only %}
        </div>

        <script>
            $(function() {
                const PROVIDER_OPENAI = '{{ providersOld.openai }}';
                const PROVIDER_AZURE = '{{ providersOld.azure }}';

                /* Text credentials
                 */
                const textModuleContainer = $('#textModuleContainer');
                const textProvider = $('#openai_text_endpoint-field');
                const textSystemPrompt = $('#openai_text_generation_system_prompt-field').parent('div');

                textProvider.on('change', function (event) {
                    event.preventDefault();
                    initText(textModuleContainer, textProvider);
                });

                // init load
                initText(textModuleContainer, textProvider, true);

                // when the text provider changes, we need to fetch the new html from adminOpenAi.getConfigStruct
                function initText(textModuleContainer, textProvider, initLoad = false) {
                    // get the provider
                    const provider = textProvider.val();
                    if ('Off' === provider || '' === provider) {
                        textModuleContainer.hide();
                        textSystemPrompt.hide();
                        textProvider.show();
                        return;
                    }
                    textModuleContainer.show();
                    textSystemPrompt.show();

                    // don't fetch, first load...
                    if (initLoad) {
                        return;
                    }
                    //replace the url with the provider
                    const path = '{{ routeLookupIfAuthorized('adminOpenAi.getBlankConfig') }}'.replace('{provider}', provider);
                    // fetch the new html
                    $.ajax({
                        url: path,
                        type: 'GET',
                        success: function (response) {
                            // replace the html in the textModuleContainer
                            textModuleContainer.html(response);
                        },
                        error: function (xhr, status, error) {
                            console.error('Error fetching config struct:', error);
                        }
                    })
                }

                /* Image credentials
                 */
                const imageContainer = $('#imageSettingsContainer');
                const imageProvider = $('#openai_image_endpoint-field');
                const imageKey = $('#openai_image_key-field').parent('div');
                const imageModel = $('#openai_image_model-field').parent('div');
                const imageAzureResourceName = $('#openai_image_azure_resource_name-field').parent('div');
                const imageAzureDeploymentId = $('#openai_image_azure_deployment_id-field').parent('div');
                const imageOutputQuality = $('#openai_image_output_quality-field').parent('div');
                const imageSystemPrompt = $('#openai_image_system_prompt-field').parent('div');

                imageProvider.on('change', function (event) {
                    event.preventDefault();
                    init(imageContainer, imageProvider, imageKey, imageModel, imageAzureResourceName, imageAzureDeploymentId, imageOutputQuality, imageSystemPrompt);
                });

                init(imageContainer, imageProvider, imageKey, imageModel, imageAzureResourceName, imageAzureDeploymentId, imageOutputQuality, imageSystemPrompt);

                /**
                 *  Hide everything if you haven't chosen a provider yet
                 */
                function init(container, provider, key, model, azureResourceName, azureDeploymentId, outputQuality, systemPrompt) {
                    if ('{{ endpointTypeOff }}' === provider.val() || '' === provider.val()) {
                        key.hide();
                        model.hide();
                        azureResourceName.hide();
                        azureDeploymentId.hide();

                        if (null !== outputQuality) {
                            outputQuality.hide();
                        }

                        systemPrompt.hide();
                    } else if (PROVIDER_OPENAI === provider.val()) {
                        key.show();
                        model.show();
                        azureResourceName.hide();
                        azureDeploymentId.hide();

                        if (null !== outputQuality) {
                            outputQuality.show();
                        }

                        systemPrompt.show();
                    } else if (PROVIDER_AZURE === provider.val()) {
                        key.show();
                        model.hide();
                        azureResourceName.show();
                        azureDeploymentId.show();

                        if (null !== outputQuality) {
                            outputQuality.show();
                        }

                        systemPrompt.show();
                    }

                    $('[data-subheader]').show();
                    container.show();
                }

                $('#textFormSubmit').on('click', function (event) {
                    event.preventDefault();
                    submitTextSettings();
                });

                /** submit text settings from all text forms **/
                async function submitTextSettings() {
                    //grab the text setting form, and post the data via fetch
                    const textForm = document.getElementById('textForm');
                    const formData = new FormData(textForm);
                    const data = Object.fromEntries(formData.entries());

                    /**
                     * Convert flat form array with bracketed keys to nested JSON (written by gpt-4.1)
                     * @param flatObj
                     * @returns {}
                     */
                    function formArrayToNestedJson(flatObj) {
                        const result = {};

                        Object.entries(flatObj).forEach(([flatKey, value]) => {
                            // Match all bracketed keys, e.g. [chat][openai][key]
                            const keys = [];
                            flatKey.replace(/\[([^\]]+)\]/g, (_, k) => keys.push(k));

                            if (keys.length === 0) return; // skip if no brackets

                            let current = result;
                            keys.forEach((key, idx) => {
                                if (idx === keys.length - 1) {
                                    current[key] = value;
                                } else {
                                    if (!current[key] || typeof current[key] !== 'object') {
                                        current[key] = {};
                                    }
                                    current = current[key];
                                }
                            });
                        });

                        return result;
                    }

                    // send via javascript fetch to adminOpenAi.postTextOptions
                    const response = await fetch('{{ routeLookupIfAuthorized('adminOpenAi.postTextOptions') }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify(formArrayToNestedJson(data))
                    });
                    if (response.ok) {
                        // success
                        window.location.reload()
                    } else {
                        // check response code...
                        // may be redirect
                        if (response.status >= 300 && response.status < 400) {
                            window.location.href = response.url;
                            return;
                        }
                        //something else happened...
                        // error
                        console.log('Error saving text settings.');
                    }
                }
            });
        </script>
        <style>
            [id$=";provider-field"], [id$=";provider"] {
                display: none !important;
            }
        </style>
    </div>
</div>
