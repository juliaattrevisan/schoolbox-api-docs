<ul class="breadcrumb">
    <li><a href="/adminv2/home">Admin</a></li>
    <li><a href="/adminv2/user">Users</a></li>
    <li class="active"><span>Service Permissions</span></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Service Permissions</h1>
    </div>
</div>

{% for serviceName, users in usersByServiceName %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader" id="{{ serviceName }}">{{ serviceName }}</h2>
        {% if users|length %}
        <section>
            <ul class="information-list">
                {% for user in users %}
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="compact card small-12">
                                <span>
                                    {% include 'include/portrait.twig' with {user: user} only %}
                                    {% set uaStructs = uaStructsByServiceNameByUserId[user.id][serviceName] %}
                                    <table class='info-table'>
                                        {% for uaStruct in uaStructs %}
                                            <tr>
                                                <td><a href="/adminv2/user/{{ user.id }}/modify">{{ user.fullname }}</a></td>
                                                <td title='Access type'>{{ uaStruct['accessType'] }}</td>
                                                <td{% if uaStruct['sidLabel'] %} title='Service details'{% endif %}>
                                                    {% if uaStruct['sidLabel'] %}({{ uaStruct['sidLabel'] }}: {{ uaStruct['sidDisplayValue'] }}){% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </table>
                                </span>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-staff-students"></i>
                <p>Nobody is assigned to this service.</p>
            </div>
        {% endif %}
    </div>
</div>
<style>
.info-table {
    margin-bottom: 0;
}

.info-table tr > td {
    width: 33%;
}
</style>
{% endfor %}
