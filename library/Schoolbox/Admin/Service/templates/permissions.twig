<ul class="breadcrumb">
    <li><a href="/adminv2/home">Admin</a></li>
    <li><a href="/adminv2/user">Users</a></li>
    <li class="active"><a href="">Service Permissions</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Service Permissions</h1>
        </div>
    </div>
</div>

{% for service, people in services %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader" id="{{ service }}">{{ service }}</h2>

        {% if people|length %}
        <section>
            <ul class="information-list">
                {% for person in people %}
                    <li class="content"><a href="/adminv2/user/{{ person.id }}/modify" title="View Profile">{{ person.fullname }}</a></li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-staff-students"></i>
                <p>Nobody is assigned to this service permission.</p>
            </div>

        {% endif %}
    </div>
</div>
{% endfor %}