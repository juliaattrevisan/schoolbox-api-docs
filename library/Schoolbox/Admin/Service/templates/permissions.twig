<ul class="breadcrumb">
    <li><a href="/adminv2/home">Admin</a></li>
    <li><a href="/adminv2/user">Users</a></li>
    <li class="active"><span>Service Permissions</span></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Service Permissions</h1>
    </div>
</div>

{% for serviceName, users in usersByServiceName %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader" id="{{ serviceName }}">{{ serviceName }}</h2>
        {% if users|length %}
        <section>
            <ul class="information-list">
                {% for user in users %}
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="compact card small-12">
                                <a href="/adminv2/user/{{ user.id }}/modify">
                                    {% include 'include/portrait.twig' with {user: user} only %}
                                    <div class='l-grid l-gap l-grid--2-col'>
                                        <div>{{ user.fullname }}</div>
                                        <div title='Access type'>({{ accessTypeByServiceNameByUserId[user.id][serviceName] }})</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <nav>
                            <!-- <a class="icon-delete no-text" href="#" title="Delete"></a> -->
                        </nav>
                    </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-staff-students"></i>
                <p>Nobody is assigned to this service.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endfor %}
