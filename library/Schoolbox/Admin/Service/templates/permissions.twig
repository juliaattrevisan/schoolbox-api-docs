<ul class="breadcrumb">
    <li><a href="/adminv2/home">Admin</a></li>
    <li><a href="/adminv2/user">Users</a></li>
    <li class="active"><span>Service Permissions</span></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Service Permissions</h1>
    </div>
</div>

{% for serviceName, users in usersByServiceName %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader" id="{{ serviceName }}">{{ serviceName }}</h2>
        {% if users|length %}
            <section>
                <table>
                    <thead>
                        <th>User</th>
                        <th>Service Identifier</th>
                        <th>Access</th>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            {% set rows = userAccessInfoByUserId[user.id][serviceName] %}
                            {% for row in rows %}
                                <tr>
                                    <td>
                                        <a href="/adminv2/user/{{ user.id }}/modify">
                                            {% include 'include/portrait.twig' with {user: user, render: 'tiny'} only %}
                                            {{ user.fullname }}
                                        </a>
                                    </td>
                                    <td>{% if row['sidLabel'] %}{{ row['sidLabel'] }}: {{ row['sidDisplayValue'] }}{% endif %}</td>
                                    <td>{{ row['accessType'] }}</td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-staff-students"></i>
                <p>Nobody is assigned to this service.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endfor %}
