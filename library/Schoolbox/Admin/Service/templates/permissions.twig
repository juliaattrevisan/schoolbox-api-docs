<ul class="breadcrumb">
    <li><a href="/adminv2/home">Admin</a></li>
    <li><a href="/adminv2/user">Users</a></li>
    <li class="active"><span>Service Permissions</span></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Service Permissions</h1>
    </div>
</div>

{% for serviceName, tableData in servicePermissionTablesData %}
<div class="row">
    <div class="small-12 island">
        {% if servicePermissionTablesData|length %}
            <h2 class="subheader" id="{{ serviceName }}">{{ serviceName }}</h2>
            <section>
                <table class='service-permissions'>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Service Identifier</th>
                            <th>Access</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for row in tableData %}
                        <tr>
                            <td>
                                <a href="/adminv2/user/{{ row.user.id }}/modify">
                                    {% include 'include/portrait.twig' with {user: row.user, render: 'tiny'} only %}
                                    {{ row.user.fullname }}
                                </a>
                            </td>
                            <td>{% if row['sidLabel'] %}{{ row['sidLabel'] }}: {{ row['sidDisplayValue'] }}{% endif %}</td>
                            <td>{{ row['accessName'] }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </section>
        {% else %}
            <div class="empty-state">
                <sbx-icon name="staff-students" size="2.5rem"></sbx-icon>
                <p>Nobody is assigned to this service.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endfor %}
<style>
/* Set column widths so columns in all tables line up vertically. */
table.service-permissions td:nth-child(1) {
   width: 45%;
}
table.service-permissions td:nth-child(2) {
    width: 35%;
}
table.service-permissions td:nth-child(3) {
    width: 20%;
}
</style>
