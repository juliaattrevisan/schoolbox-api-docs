{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/attacher/attacher.checkbox-group.js?v={{ config.site_version }}"></script>

        {# Config page contents #}

        <div class="small-12 island">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <p>From this screen you can bulk import courses to classes. This import uses a specific CSV format which you can download from the link below.</p>
                    </div>
                </fieldset>
                <div class="component-action">
                    <section>
                        <a href="{{ CDN_PREFIX }}/adminv2/csv/courseBulkImport.csv" class="button" title="Download template">Download Template</a>
                    </section>
                </div>
            </section>
            <form action="{{ routeLookupIfAuthorized('adminBulkCourseImport.postImportResults') }}" method="post" enctype="multipart/form-data" name="form" id="form">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>Apply Changes<span data-tooltip class="hint has-tip tip-top" data-width="200" title="Leaving this off will show you what would happen, but not actually make the change. ">?</span></label>
                        </div>
                        <div class="small-12 columns">
                            <div class="switch">
                                <input id="perform" name="perform" type="checkbox" data-ordinary-checkbox="">
                                <label for="perform">
                                    <span>On</span>
                                    <span>Off</span>
                                </label>
                            </div>
                        </div>
                        <div class="small-12 columns">
                            {% include 'sub/attachzone.twig' with { attachzone: attachzone } %}
                        </div>
                    </fieldset>
                </section>
                <input type="submit" value="Import" />
            </form>
        </div>
    </div>
</div>
