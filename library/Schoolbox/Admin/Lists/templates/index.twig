<link rel="stylesheet" type="text/css" href="/javascript/components/spectrum/spectrum.css" />
<script type="text/javascript" src="/javascript/components/schoolbox-masonry.min.js?v={{ config.site_version }}"></script>

<script type="text/javascript">

    $(function() {

        {# Function to add new rows to the end of the list #}

        {# New rows will be given sequential negative numbers #}

        var newId = -1;

        $('[data-button=add-row]').click(function(event) {
            event.preventDefault();

            var newRow = $('[data-clone]').find('li').clone()

            {#
                Ninja ID numbers into the cloned HTML. We also have to rename the data-colour-picker class so that
                when we wire it up the template row doesn't get wired up- otherwise this screws up any subsequent
                adds. Bit hacky, but works.
            #}

            newRow[0].innerHTML = newRow[0].innerHTML
                    .replace(/#ID#/g, newId--)
                    .replace(/data-colour-picker-clone/g, 'data-colour-picker-new');

            $('[data-list]')
                .append(newRow)
                .find('[data-focus]')
                .last()
                .focus();

            {# Wire up any colour pickers that were just added #}

            $("[data-colour-picker-new]").spectrum({
                allowEmpty: false,
                showAlpha: true,
                showInput: true,
                preferredFormat: 'hex',
                clickoutFiresChange: true,
                showInitial: true,
                change: function(color) {
                    $(this).val(color.toHexString());
                }
            });
        });

        {# Wire up colour pickers #}

        $("[data-colour-picker]").spectrum({
            allowEmpty: false,
            showAlpha: true,
            showInput: true,
            preferredFormat: 'hex',
            clickoutFiresChange: true,
            showInitial: true,
            change: function(color) {
                $(this).val(color.toHexString());
            }
        });

        {# Wire up sortable lists #}

        $('[data-sortable]').sortable({ handle: '.grip', axis: 'y' });
    });

</script>

{# Shared navigation menu #}

{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 island">
        <dl class="sub-nav">
            {% for tableKey, tableCurrent in tables %}
                <dd {% if tableKey == table %}class="active"{% endif %}><a href="/adminv2/lists/{{ tableKey }}">{{ tableCurrent.title }}</a></dd>
            {% endfor %}
        </dl>

        <form method="post" action="/adminv2/lists/save">
            <input name="table" type="hidden" value="{{ table }}" />
            <input name="sortable_column" type="hidden" value="{{ tables[table].sortable }}">

            {# This is used when hidden fields cannot be NULL. Existing records should already be set in DB #}

            {% for field_key, value in tables[table].fixed %}
                <input type="hidden" name="fixed-{{field_key}}" value="{{ value }}">
            {% endfor %}

            <section>

                <ul class="information-list sortable ui-sortable" data-sortable data-list>

                    {# Heading row #}

                    <li class="show-for-medium-up no-border">
                        <div class="list-item">

                            {# If the data is sortable need to add a blank column for drag handle #}

                            {% if tables[table].sortable %}
                                <div class="small-1 columns">
                                    <h3>Order</h3>
                                </div>
                            {% endif %}

                            {% for field_key, field in tables[table].fields %}
                                {% if field.hidden is empty %}
                                    <div class="small-12 medium-{% if field.width is not empty %}{{ field.width }}{% else %}2{% endif %} columns">
                                        <h3>
                                            {{ field.caption }}
                                            {% if field.tooltip %}
                                                <span class="hint has-tip tip-top" data-tooltip title="{{ field.tooltip }}">?</span>
                                            {% endif %}
                                        </h3>
                                    </div>
                                {% endif %}
                            {% endfor %}

                        </div>
                    </li>

                    {# Render each row of data#}

                    {% for key,record in records %}

                        <li class="no-border">
                            <input type="hidden" name="id[]" value="{{ key }}">

                            {% set recordIndex = loop.index %}

                            <div>

                                {% if tables[table].sortable %}
                                    <div class="small-1 column grip">&nbsp;</div>
                                {% endif %}

                                {% for field_key, field in tables[table].fields %}

                                    <div class="small-12 column hide-for-medium-up">
                                        <label>
                                            {{ field.caption }}
                                        </label>
                                    </div>

                                    {% if field.hidden is empty %}

                                        <div class="small-12 medium-{% if field.width is not empty %}{{ field.width }}{% else %}2{% endif %} column">

                                            {% if field.readonly is not empty %}

                                                {# Read only field, just display label #}

                                                {{ record[field_key] }}

                                            {% elseif field.radio is not empty %}

                                                {# Radio field, shared between all rows #}

                                                <div class="radiolist">
                                                    <input type="radio" name="radio-{{ field_key }}" value="{{ recordIndex - 1 }}" id="{{ field_key }}-{{ recordIndex }}" {% if (record[field_key] == 1) %} checked {% endif %}">
                                                    <label for="{{ field_key }}-{{ recordIndex }}"></label>
                                                </div>

                                            {% elseif field.lookup is not empty %}

                                                {# Lookup select box #}

                                                <select name="value-{{ field_key }}[]">
                                                    {% for option in field.lookup %}

                                                        <option {% if record[field_key] == option.key %}selected {% endif %}value="{{ option.key }}">{{ option.value }}</option>
                                                    {% endfor %}
                                                </select>

                                            {% elseif field.colour is not empty %}

                                                {# Color picker #}

                                                <input name="value-{{field_key}}[]" type="text" placeholder="{{ field.caption }}" value="{{ record[field_key] }}" data-colour-picker />

                                            {% else %}

                                                {# All other fields are just text boxes #}

                                                <input name="value-{{field_key}}[]" type="text" placeholder="{{ field.caption }}" value="{{ record[field_key] }}" maxlength="{{field.maxLength}}" />

                                                {# Nullable text boxes get a tickbox as well #}

                                                {% if field.nullable is not empty %}
                                                    <div class="checklist">
                                                        <input name="null-{{ field_key }}[]" value="{{ recordIndex - 1 }}" id="{{ field_key }}-{{ recordIndex }}" type="checkbox" {% if record[field_key] == null %}checked{% endif %}>
                                                        <label for="{{ field_key }}-{{ recordIndex }}">Null</label>
                                                    </div>
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                {% endfor %}

                            </div>

                        </li>
                    {% endfor %}
                </ul>

            </section>
            <a href="#" data-button="add-row" class="button expand icon-add">New Row</a>
            <input type="submit" value="Save"/>
        </form>
    </div>
</div>

{# Draw cloneable row for use when adding new rows#}

<div data-clone class="hide">
    <li class="row">
        <input type="hidden" name="id[]" value="#ID#">

        {# The first non-hidden input field needs to have the data-focus attribute set, this variable keeps track of that #}

        {% set focusSet = false %}

        {% if tables[table].sortable %}
            <div class="small-1 column grip">&nbsp;</div>
        {% endif %}

        {% for field_key, field in tables[table].fields %}
            {% if field.hidden is empty %}

                <div class="small-12 medium-{% if field.width is not empty %}{{ field.width }}{% else %}2{% endif %} column">

                    {% if field.readonly is not empty %}

                        {# Read only field, just display label #}

                        {{ record[field_key] }}

                    {% elseif field.radio is not empty %}

                        {# Radio field, shared between all rows #}

                        <div class="radiolist">
                            <input {% if not focusSet %}data-focus{% set focusSet = true %}{% endif %} type="radio" name="radio-{{ field_key }}" value="#ID#" id="{{ field_key }}-{{ recordIndex }}">
                            <label for="{{ field_key }}-{{ recordIndex }}"></label>
                        </div>

                    {% elseif field.lookup is not empty %}

                        {# Lookup select box #}

                        <select {% if not focusSet %}data-focus{% set focusSet = true %}{% endif %} name="value-{{ field_key }}[]">
                            {% for option in field.lookup %}
                                <option value="{{ option.key }}">{{ option.value }}</option>
                            {% endfor %}
                        </select>

                    {% elseif field.colour is not empty %}

                        {# Color picker #}

                        <input {% if not focusSet %}data-focus{% set focusSet = true %}{% endif %} name="value-{{field_key}}[]" type="text" placeholder="{{ field.caption }}" data-colour-picker-clone />

                    {% else %}

                        {# All other fields are just text boxes #}

                        <input {% if not focusSet %}data-focus{% set focusSet = true %}{% endif %} name="value-{{field_key}}[]" type="text" placeholder="{{ field.caption }}"/>

                        {# Nullable text boxes get a tickbox as well #}

                        {% if field.nullable is not empty %}
                            <div class="checklist">
                                <input name="null-{{ field_key }}[]" id="{{ field_key }}-{{ recordIndex }}" value="#ID#" type="checkbox">
                                <label for="{{ field_key }}-{{ recordIndex }}">Null</label>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            {% endif %}
        {% endfor %}
    </li>
</div>
