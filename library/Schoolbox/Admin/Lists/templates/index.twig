<link rel="stylesheet" type="text/css" href="/javascript/components/spectrum/spectrum.css" />
<script type="text/javascript" src="/javascript/components/schoolbox-masonry.min.js?v={{ config.site_version }}"></script>

<script type="text/javascript">

    $(function() {

        {# Function to add new rows to the end of the list #}

        {# New rows will be given sequential negative numbers #}

        var newId = -1;

        var dataList = $('[data-list]');

        dataList.on('change', '[data-nullcheck]', function() {
            // Find closest input
            // Enable/disable it
            var $this = $(this);
            var input = $this.closest('.column').find(':input').not($this);
            if ($this.is(':checked')) {
                input.prop('disabled', true);
            } else {
                input.prop('disabled', false);
            }
        });

        $('[data-button=add-row]').click(function(event) {
            event.preventDefault();

            var listEmptyState = $('#listEmptyState');
            var listEditor = $('#listEditor');

            if (listEditor.hasClass('hide')) {
                listEditor.removeClass('hide');
                listEmptyState.addClass('hide');
            }

            var newRow = $('[data-clone]').find('li').clone()

            {#
                Ninja ID numbers into the cloned HTML. We also have to rename the data-colour-picker class so that
                when we wire it up the template row doesn't get wired up- otherwise this screws up any subsequent
                adds. Bit hacky, but works.
            #}

            newRow[0].innerHTML = newRow[0].innerHTML
                    .replace(/#ID#/g, newId--)
                    .replace(/data-colour-picker-clone/g, 'data-colour-picker-new');

            dataList
                .append(newRow)
                .find('[data-focus]')
                .last()
                .focus();

            {# Wire up any colour pickers that were just added #}

            $("[data-colour-picker-new]").spectrum({
                allowEmpty: false,
                showAlpha: true,
                showInput: true,
                preferredFormat: 'hex',
                clickoutFiresChange: true,
                showInitial: true,
                change: function(color) {
                    $(this).val(color.toHexString());
                }
            });

            {#
                Attach delete event to new rows, this doesn't ask for confirmation because
                its not in the database, so its not going to do anything irreversable
            #}

            $('[data-delete-new]').click(function(event)
            {
                event.preventDefault();
                $(this).closest('li').remove();
            });
        });

        $('[data-delete]').click(function (event) {
            event.preventDefault();

            var deleteId = $(this).data('delete');
            var listItem = $(this).closest('li');

            $(this).confirmDialog({
                text: '{{ tables[table].deleteWarning }}',
                confirmEvent: function () {

                    var $toast = $('#toast');
                    $toast.toastActivate({text: 'Deleting item...'});

                    $.post('{{ routeLookup('adminLists.postDelete') }}', {
                        table: '{{ table }}',
                        id: deleteId
                    })
                    .done(function (response) {
                        if (response.result !== false) {
                            listItem.remove();
                        $toast.toastTimeout({text: 'Item deleted', css: 'success'});
                        } else {
                            $toast.toastTimeout({text: 'Deletion Failed. ' + response.message, css: 'alert'});}
                    });
                }
            });
        });

        {# Wire up colour pickers #}

        $("[data-colour-picker]").spectrum({
            allowEmpty: false,
            showAlpha: true,
            showInput: true,
            preferredFormat: 'hex',
            clickoutFiresChange: true,
            showInitial: true,
            change: function(color) {
                $(this).val(color.toHexString());
            }
        });

        {# Wire up sortable lists #}

        $('[data-sortable]').sortable({ handle: '.grip', axis: 'y' });
    });

</script>

{# Shared navigation menu #}

{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 island">
        <dl class="sub-nav">
            {% for tableKey, tableCurrent in tables %}
                <dd {% if tableKey == table %}class="active"{% endif %}><a href="/adminv2/lists/{{ tableKey }}">{{ tableCurrent.title }}</a></dd>
            {% endfor %}
        </dl>

        {% if records | length > 0 %}
            {% set emptyStateClass = 'hide' %}
        {% else %}
            {% set listClass = 'hide' %}
        {% endif %}

        <div id="listEmptyState" class="empty-state {{ emptyStateClass }}">
            <i class="icon-list"></i>
            <p>The {{ tables[table].title }} list is empty.<br><a href="#" data-button="add-row">Add an item to this list</a>.</p>
        </div>

        <form method="post" action="/adminv2/lists/save">{# TODO routeLookup #}

            <input name="table" type="hidden" value="{{ table }}" />
            <input name="sortable_column" type="hidden" value="{{ sortable }}" />

            {# This is used when hidden fields cannot be NULL. Existing records should already be set in DB #}

            {% for field_key, value in tables[table].fixed %}
                <input type="hidden" name="fixed-{{field_key}}" value="{{ value }}" />
            {% endfor %}

            <section id="listEditor" class="{{ listClass }}">
                <div{% if sortable %} class="sortable"{% endif %}>
                    <header class="list-header actions-small-{{ deletable ? 1 : 0 }}">
                        <div class="list-item">
                            {% for field_key, field in tables[table].fields %}
                                {% if field.hidden is empty %}
                                    <div class="small-12 medium-{% if field.width is not empty %}{{ field.width }}{% else %}2{% endif %} columns">
                                        {{ field.caption }}
                                        {% if field.tooltip %}
                                            <span class="hint has-tip tip-top" data-tooltip title="{{ field.tooltip }}">?</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </header>
                </div>

                {% set ulAttr = sortable ? 'class="information-list sortable ui-sortable" data-sortable data-list' : 'class="information-list" data-list' %}

                <ul {{ ulAttr | raw }}>
                    {# Render each row of data#}
                    {% for key, record in records %}
                        {% include '@adminLists/list-item.twig' %}
                    {% endfor %}
                </ul>
                {% if canSpawn %}
                <div class="component-action">
                    <section>
                        <a href="#" data-button="add-row" class="button">Add New Row</a>
                    </section>
                </div>
                {% endif %}
            </section>
            <input type="submit" value="Save"/>
        </form>
    </div>
</div>

{# Draw cloneable row for use when adding new rows#}
{# #ID# is used as a placeholder for an ID that is preg_replaced in JS when rows are inserted. #}

{% if canSpawn %}
<ul data-clone class="hide">
    {% include '@adminLists/list-item.twig' with {
        key: "#ID#",
        recordIndex: "#ID#",
        deleteAttr: 'data-delete-new'
    } %}
</ul>
{% endif %}

<div id="toast" class="toast" data-alert></div>
