{##
 # Victorian Curriculum Progression Point visualisation chart
 #
 # @param string $identifier  An arbitrarily-chosen string - use with Skin Config
 # @param array $payload      A struct containing all the curriculum nodes, feedbacks and student metadata
 # @param bool $annotate      Optionally show some diagnostic data
 #}
{% if payload is not null and payload.data is not null and payload.data|length %}
<style>
    table.victorian-progression  {
        border-collapse: collapse;
    }

    table.victorian-progression th,
    table.victorian-progression td {
        border: 1px solid #ccc;
        padding: 0.5rem;
    }

    table.victorian-progression tbody td.rating,
    table.victorian-progression thead th.rating {
        border-right: 0;
        padding-right: 32px;
        text-align: left;
    }

    /* Dots go in these
     */
    table.victorian-progression .outcome-cell {
        max-width: 50px;
        min-width: 50px;
        padding: 0;
        text-align: left;
        vertical-align: middle;
    }

    /* Manage subdivisions' borders
     * Each Level comes in a pair of cells for each half of an academic period, I guess
     * These should not have a dividing line in between
     */
    table.victorian-progression .outcome-cell:nth-child(n) {
        border-right-width: 0;
    }

    table.victorian-progression .outcome-cell:nth-child(2n) {
        border-left-width: 0;
    }

    table.victorian-progression .outcome-cell:last-child {
        border-right-width: 1px;
    }

    /* Make Dots Great
     */
    table.victorian-progression .dot {
        border: 3px solid black;
        border-radius: 50%;
        float: left;
        margin-left: -8px;
        position: relative;
        width: 16px;
        z-index: 2;
        -moz-border-radius: 50%;
        -webkit-border-radius: 50%;
    }

    /* Same height as .dot, to enforce foreground line drawing alignment funny business
     */
    table.victorian-progression .dot,
    table.victorian-progression .placeholder {
        height: 16px;
    }

    /* Actual progression points
     */
    table.victorian-progression .dot.white {
        background-color: #fff;
    }

    table.victorian-progression .dot.black {
        background-color: #000;
        /* ensure the background colour is displayed when printing */
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
    }

    /* Line between dots; z-index ensures it's always rendered below a .dot
     */
    table.victorian-progression .bridge {
        border-top: 3px solid #000;
        float: left;
        margin-top: -9px;
        width: 100%;
        z-index: 1
    }

    /* Show the value of the dot for diagnostic convenience
     */
    table.victorian-progression span.annotation {
        clear: none;
        {% if not (annotate ?? false) %}
            display: none;
        {% endif %}
        float: left;
        font-size: 10px;
        margin-left: 8px;
        margin-top: -40px;
    }

    /* Smear a yellow stripe
     */
    table.victorian-progression .yellow {
        background-color: gold;
        /* ensure the background colour is displayed when printing */
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
    }

    /* The top-left corner of the grid
     */
    table.victorian-progression .corner {
        border-left: 0;
        border-top: 0;
    }

    /* Heading style
     */
    .summative-content h2.victorian-progression-heading {
        margin-top: 1rem;
        margin-bottom: 1rem;
    }
</style>

<div id="{{ identifier }}">
    <h2 class="victorian-progression-heading">{{ title }}</h2>

    <table class="victorian-progression">
        <thead>
            <tr class="header">
                <th colspan="2" class="corner"></th>
                <th class="rating">Rating</th>

                {% for i in payload.levels %}
                    {# Check current year; smear it yellow if i matches student year level #}
                    <th colspan="2" class="text-center {% if i == payload.student.currentYearLevel %}yellow{% endif %}">
                        Level {{ i }}
                    </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
        {% for parentNodeId, parentNodeData in payload.data %}
            {% set nSubrows = parentNodeData.subnodes|length %}

            {% if nSubrows %}
                {# Render at least one subnode with various spanning for presentation #}
                <tr>
                    <td rowspan="{{ nSubrows + 1 }}">
                        {{ parentNodeData.name }}
                    </td>
                </tr>
                {% for nodeId, nodeData in parentNodeData.subnodes %}
                    <tr>
                        <td>{{ nodeData.name }}</td>
                        {{ _self.renderOutcomes(nodeData, payload.possibleOutcomes, payload.student.currentYearLevel, payload.currentSemester, annotate) }}
                    </tr>
                {% endfor %}
            {% else %}
                {# No subnodes: occupy available space #}
                <tr>
                    <td colspan="2">{{ parentNodeData.name }}</td>
                    {{ _self.renderOutcomes(parentNodeData, payload.possibleOutcomes, payload.student.currentYearLevel, payload.currentSemester, annotate) }}
                </tr>
            {% endif %}
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{##
 # Render the possible outcomes for a curriculum node
 # and, if applicable, a Progression Point
 #
 # @param array $nodeData
 # @param array $possibleOutcomes
 # @param int $currentYearLevel     Corresponds to the student's current year level
 # @param int $currentSemester      Either 1 or 2
 # @param bool $annotate            Decides whether to render annotations, for debugging without a developer
 #}
{% macro renderOutcomes(nodeData, possibleOutcomes, currentYearLevel, currentSemester, annotate) %}
    {# Remember when we start drawing a line #}
    {% set lineStarted = false %}

    {# The mysterious line betwen two dots has specific requirements:
     #     - There is both a white and black dot in this row
     #     - We started drawing a line already
     #     - We aren't in a cell with a black dot
     #}
    {% set hasBothDots = (nodeData.previous.mark ?? false) and (nodeData.current.mark ?? false) %}

    <td class="rating">{{ nodeData.rating }}</td>

    {# Iterate each subcell #}
    {% for i in possibleOutcomes %}
        {% set css = '' %}
        {% set hasDot = false %}

        {# If i > floor(i), we're in a halfway point hide the left border
         # Otherwise, hide the right border
         #}
        {% set nearestFloor = i|round(0, 'floor') %}

        {# Yellow Streak
         # Check current year; smear it yellow if column matches student year level
         # then figure out if it's the left cell or the right cell, since each of these
         # subdivisions corresponds to a semester. There's stable-genius logic here, sry
         #}
        {% if nearestFloor == currentYearLevel %}
            {% if i == nearestFloor and currentSemester == 1 %}
                {% set css = 'yellow' %}
            {% elseif i != nearestFloor and currentSemester == 2 %}
                {% set css = 'yellow' %}
            {% endif %}
        {% endif %}

        <td class="outcome-cell {{ css }}">
            {# Note that there's a convention with the values: feedback values that start with 9
             # (such as 9 and 9.5) will appear in the Level 10 column. They're offset by one.
             # The feedbacks represent the student's journey -toward- a particular level.
             #}
            {% set offset = i-1 %}

            {# Progression Point from something in the past; special rendering condition exists.
             #
             # If "previous" mark exists, but "current" does not, show the previous Progression Point as black
             # Otherwise show it as white
             #}
            {% if offset == (nodeData.previous.mark ?? null) %}
                <div class="white dot" title="{{ nodeData.previous.mark }} ({{ nodeData.previous.feedback_id ?? null }})"></div>

                {% if annotate ?? false %}
                <span class="annotation">{{ nodeData.previous.mark }} ({{ nodeData.previous.feedback_id ?? null }})</span>
                {% endif %}

                {# Start drawing a line to the next dot; but be careful!
                 # Don't try to draw a line to a Submission State whose prefix starts with DNP
                 #}
                {% if (nodeData.current.mark ?? null) and not (nodeData.current.mark matches '/^DNP/') %}
                    {% set lineStarted = true %}
                    {% set hasDot = true %}
                {% endif %}
            {% endif %}

            {# Progression Point from current academic period #}
            {% if offset == (nodeData.current.mark ?? null) %}
                <div class="black dot" title="{{ nodeData.current.mark }} ({{ nodeData.current.feedback_id ?? null }})"></div>

                {% if annotate ?? false %}
                <span class="annotation">{{ nodeData.current.mark }} ({{ nodeData.current.feedback_id ?? null }})</span>
                {% endif %}

                {# Stop drawing line #}
                {% set lineStarted = false %}
                {% set hasDot = true %}
            {% endif %}

            {# The mysterious line betwen two dots has specific requirements:
             #     - There is both a white and black dot in this row
             #     - We started drawing a line already
             #     - We aren't in a cell with a black dot
             #}
            {% if lineStarted and hasBothDots %}
                <div class="placeholder"></div>
                <div class="bridge"></div>
            {% endif %}
        </td>
    {% endfor %}
{% endmacro %}
