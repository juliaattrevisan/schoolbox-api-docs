{##
 # Create/Update a Summative Report
 #
 # @param string $pageCurrent            url to the current page
 # @param array allBreadcrumbs           A set of breadcrumbs
 # @param SummativeReport\Model $report  A of SummativeReportModel instance
 # @param array $options                 A structure containing report options
 # @param Zone $logoZone                 An attachzone for uploading images
 #}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
<script src="{{CDN_PREFIX}}/js/bundle/editor.js?v={{ config.site_version }}"></script>

<script>
    $(function () {
        /**
         * Initialise the editor
         */
        document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
            detail: {
                targetElements: ['#report-introduction'],
                removeFromToolbar: [
                    'subscript',
                    'superscript',
                    'style',
                    'mediaEmbed',
                    'emoji',
                    'eqneditor5Button'
                ]
            },
        }));

        $('#summative-report-form').alaressValidate({
            rules: {
                'title': {
                    requiredNotBlank: true
                },
                'terms': {
                    requiredNotBlank: true
                }
            },
            messages: {
                'title': "Please enter a title (max length 100 characters)",
                'terms': "Please select at least one academic period"
            }
        });

        $('#report-terms').selectizeSelector({
            multiple: true,
            value: {{ options.terms|json_encode|raw }},
            selectize: {
                create: false,
                placeholder: 'Search {{ locale.term.plural }}',
                preload: true,
                persist: true,
                hideSelected: true,
                load: function (query, callback) {
                    $.ajax({
                        url: '{{ routeLookup('adminSummativeReport.getTerms') }}',
                        type: 'GET',
                        dataType: 'json',
                        data: {query: query}
                    }).done(function (result) {
                        callback(result)
                    }).fail(function () {
                        callback()
                    })
                }
            },
        });

        $('#report-year-levels').selectizeSelector({
            multiple: true,
            value: {{ options.yearLevels|json_encode|raw }},
            selectize: {
                create: false,
                placeholder: 'Search year levels',
                preload: true,
                persist: true,
                hideSelected: true,
                load: function (query, callback) {
                    $.ajax({
                        url: '{{ routeLookup('adminSummativeReport.getYearLevels') }}',
                        type: 'GET',
                        dataType: 'json',
                        data: {query: query}
                    }).done(function (result) {
                        callback(result)
                    }).fail(function () {
                        callback()
                    })
                }
            },
        });

        $('#report-campuses').selectizeSelector({
            multiple: true,
            value: {{ options.campuses|json_encode|raw }},
            selectize: {
                create: false,
                placeholder: 'Search campuses',
                preload: true,
                persist: true,
                hideSelected: true,
                load: function (query, callback) {
                    $.ajax({
                        url: '{{ routeLookup('adminSummativeReport.getCampuses') }}',
                        type: 'GET',
                        dataType: 'json',
                        data: {query: query}
                    }).done(function (result) {
                        callback(result)
                    }).fail(function () {
                        callback()
                    })
                }
            },
        });

        $('#report-students').userSelectizeSelector({
            multiple: true,
            value: {{ options.students|json_encode|raw }},
            ajax: {
                data: {
                    roleTypeID: 'student',
                },
            },
        });

        /* Dynamically enable sections
         */
        $('[data-section-enabled]').each(function(index, element) {
            let sectionId = $(element).attr('data-section-enabled');
            let fieldsets = $('#' + sectionId).find('fieldset');

            /* Make checkboxes unchangeable
             */
            fieldsets.find('input:checkbox').each(function(index, input) {
                $(input).on('click', function (event) {
                    if ($(this).prop('readonly')) {
                        event.preventDefault();
                    }
                });
            });

            /* Initialise sections
             */
            initSections($(this), fieldsets);

            /* Toggle settings in the section
             */
            $(element).on('change', function() {
                initSections($(this), fieldsets);
            });
        });


        /**
         * Set up the initial conditions for the fieldsets
         * based on whether the report section was enabled
         *
         * @param sectionSwitch
         * @param fieldsets
         */
        function initSections(sectionSwitch, fieldsets) {
            if ($(sectionSwitch).prop('checked')) {
                fieldsets.find('input:checkbox, input:text').each(function(index, checkbox) {
                    $(checkbox).prop('readonly', false);
                    $(checkbox).removeAttr('onclick');
                });

                /* Micromanage selectize
                 */
                fieldsets.find('.selectize-control').each(function (index, selectizeControl) {
                    $(selectizeControl).css('opacity', 1);
                    $(selectizeControl).siblings('select').data('selectize').unlock();
                });

                /* micro manage the subject overview
                 * we should adhere to the subject overview checkbox, now that the class section is enabled
                 */
                if (document.querySelector('#report-class-show-subject-overview').checked) {
                    document.querySelector('#report-class-search-subject-overview').removeAttribute('readonly');
                } else {
                    document.querySelector('#report-class-search-subject-overview').setAttribute('readonly', true);
                }

            } else {
                fieldsets.find('input:checkbox, input:text').each(function(index, checkbox) {
                    $(checkbox).prop('readonly', true);
                });

                /* Micromanage selectize
                 */
                fieldsets.find('.selectize-control').each(function (index, selectizeControl) {
                    $(selectizeControl).css('opacity', 0.5);
                    $(selectizeControl).siblings('select').data('selectize').lock();
                });

                /* micro manage the subject overview
                 * always disable, as the class section is disabled
                 */
                document.querySelector('#report-class-search-subject-overview').setAttribute('readonly', true);
            }
        }

        /**
         * listen to each data workTypes
         */
        // if selecting show for a row, we should enable all options for that row
        document.querySelectorAll('[data-summary-worktype-show]').forEach(function(checkboxShow) {
            checkboxShow.addEventListener('change', function() {
                let workTypeId = this.dataset.summaryWorktypeShow;
                // if checked, enable the row
                if (this.checked) {
                    document.querySelector('[data-summary-worktype-grades="'+workTypeId+'"]').disabled = false;
                    document.querySelector('[data-summary-worktype-comments="'+workTypeId+'"]').disabled = false;
                    document.querySelector('[data-summary-worktype-rubrics="'+workTypeId+'"]').disabled = false;
                } else {
                    document.querySelector('[data-summary-worktype-grades="'+workTypeId+'"]').disabled = true;
                    document.querySelector('[data-summary-worktype-comments="'+workTypeId+'"]').disabled = true;
                    document.querySelector('[data-summary-worktype-rubrics="'+workTypeId+'"]').disabled = true;
                }
            })
        });
        document.querySelectorAll('[data-class-worktype-show]').forEach(function(checkboxShow) {
            checkboxShow.addEventListener('change', function() {
                let workTypeId = this.dataset.classWorktypeShow;
                // if checked, enable the row
                if (this.checked) {
                    document.querySelector('[data-class-worktype-grades="'+workTypeId+'"]').disabled = false;
                    document.querySelector('[data-class-worktype-comments="'+workTypeId+'"]').disabled = false;
                    document.querySelector('[data-class-worktype-rubrics="'+workTypeId+'"]').disabled = false;
                } else {
                    document.querySelector('[data-class-worktype-grades="'+workTypeId+'"]').disabled = true;
                    document.querySelector('[data-class-worktype-comments="'+workTypeId+'"]').disabled = true;
                    document.querySelector('[data-class-worktype-rubrics="'+workTypeId+'"]').disabled = true;
                }
            })
        });

        // if enabling the subject overview, we should allow the user to enter a title to search for
        document.querySelector('#report-class-show-subject-overview').addEventListener('change', function(event) {
            if (event.target.checked) {
                document.querySelector('#report-class-search-subject-overview').removeAttribute('readonly');
            } else {
                document.querySelector('#report-class-search-subject-overview').setAttribute('readonly', true);
            }
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    {% if report and report.id %}
        {% set formAction = routeLookupIfAuthorized('adminSummativeReport.postUpdate', {report: report, reportId: report.id}) %}
    {% else %}
        {% set formAction = routeLookupIfAuthorized('adminSummativeReport.postCreate') %}
    {% endif %}

    <div class="admin-content">
        <form id="summative-report-form" action="{{ formAction }}" method="post">
            <div class="small-12 island">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="report-title" class="required">Title</label>
                            {# This maxlength corresponds to the schema field length #}
                            <input type="text" id="report-title" name="title" maxlength="100" value="{{ report.title }}" />
                        </div>

                        <div class="small-12 columns">
                            <label for="report-logo">School Logo</label>
                            {% include 'sub/attachzone.twig' with { attachzone: logoZone } %}
                        </div>

                        <div class="small-12 columns">
                            <label for="report-introduction">Introductory Message</label>
                            <textarea id="report-introduction" name="introduction">{{ report.introduction }}</textarea>
                        </div>

                        <div class="small-12 columns">
                            <label for="report-view-as">View as</label>
                            <p class="meta">Show assessment feedback that is visible to this role type.</p>
                            <select name="viewAs">
                                {% for key, value in viewAs %}
                                    {% set selected = '' %}

                                    {% if (options.viewAs ?? null) == key %}
                                        {% set selected = 'selected="selected"' %}
                                    {% endif %}

                                    <option value="{{ key }}" {{ selected }}>{{ value }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="small-12 columns">
                            <label for="report-filename">Filename</label>
                            <p class="meta">
                                Filenames should be unique for each student. [externalId] is suggested to be part of the filename.
                                You may use the following tokens that will be substituted with the
                                students details on creation:
                                [externalId], [title], [firstname], [surname], [preferredname], [year].
                                <br>
                                .pdf will be appended automatically.
                            </p>
                            <input type="text" id="report-filename" name="filename" maxlength="255" value="{{ report.filename }}" />
                        </div>
                    </fieldset>

                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="report-terms" class="required">Academic Periods</label>
                            <p class="meta">
                                The report will only include assessments that are due within this academic period.
                            </p>
                            <input type="text" id="report-terms" name="terms" />
                        </div>
                    </fieldset>

                    <fieldset class="content">
                        <legend class="no-margin">Student Selection</legend>
                        <div class="small-12 columns">
                            <p class="meta">
                                Select the students to be included in the report export.
                                All users from each field will be included in the final export.
                            </p>

                            <div class="row">
                                <div class="small-12 large-6 columns">
                                    <label for="report-year-levels">Year Levels</label>
                                    <input type="text" id="report-year-levels" name="yearLevels" />
                                </div>
                                <div class="small-12 large-6 columns">
                                    <label for="report-campuses">Campuses</label>
                                    <input type="text" id="report-campuses" name="campuses" />
                                </div>
                                <div class="small-12 columns">
                                    <label for="report-students">Students</label>
                                    <input type="text" id="report-students" name="students" />
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </section>

                <div class="row actions-small-1">
                    <div class="list-item">
                        <div class="small-12 columns">
                            <h2 class="subheader">Summary Page
                                <span class="hint has-tip tip-top" title="The summary page will display a list of subjects. You may choose to display just overall grades or the grades from specific assessments in each subject." data-tooltip="">?</span>
                            </h2>
                        </div>
                    </div>
                    <nav>
                        <span class="switch inline">
                            <input type="hidden" name="summary[active]" value="0" />

                            <input id="report-include-summary" name="summary[active]" type="checkbox" value="1" data-section-enabled="section-summary" {% if options.summary.active ?? false %}checked="checked"{% endif %} />
                            <label for="report-include-summary">
                                <span>On</span>
                                <span>Off</span>
                            </label>
                        </span>
                    </nav>
                </div>

                <section id="section-summary">
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="report-summary-heading">Heading</label>
                            <p class="meta">
                                Add a title to customise the name of the summary page.
                                Leaving this field blank will omit a title for the summary section on the summative report.
                            </p>
                            <input type="text" name="summary[heading]" value="{{ options.summary.heading ?? '' }}" />
                        </div>
                    </fieldset>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <fieldset class="checklist">
                                <legend>Display Options</legend>
                                <ul class="option-list">
                                    <li>
                                        <input name="summary[overallGrade]" type="hidden" value="0" />
                                        <input id="report-summary-show-overall-grade" name="summary[overallGrade]" type="checkbox" value="1" {% if options.summary.overallGrade ?? false %}checked="checked"{% endif %} />
                                        <label for="report-summary-show-overall-grade" class="checkbox-label">Show overall grade</label>
                                    </li>
                                    <li>
                                        <input name="summary[cohort]" type="hidden" value="0" />
                                        <input id="report-summary-show-cohort" name="summary[cohort]" type="checkbox" value="1" {% if options.summary.cohort ?? false %}checked="checked"{% endif %} />
                                        <label for="report-summary-show-cohort" class="checkbox-label">Show cohort/class distribution</label>
                                    </li>
                                    <li>
                                        <input name="summary[classCode]" type="hidden" value="0" />
                                        <input id="report-summary-show-class-code" name="summary[classCode]" type="checkbox" value="1" {% if options.summary.classCode ?? true %}checked="checked"{% endif %} />
                                        <label for="report-summary-show-class-code" class="checkbox-label">Show class code</label>
                                    </li>
                                </ul>
                            </fieldset>
                        </div>
                        </fieldset>
                        <fieldset class="content">
                            <div class="small-12 columns">
                                <legend>Work Types</legend>
                                <p class="meta">Select the work types and the type of feedback you would like included on the report.</p>
                                <table>
                                    <tr>
                                        <th>&nbsp;</th>
                                        <th>Show</th>
                                        <th>Grade</th>
                                        <th>Comment</th>
                                        <th>Rubric</th>
                                    </tr>
                                    {% for worktype in worktypesSummary %}
                                    <tr data-summary-worktype-id="{{ worktype.id }}">
                                        <td>{{ worktype.name }}</td>
                                        <td>
                                            <input name="summary[workType][{{ worktype.id }}][show]" type="hidden" value="0" />
                                            <input data-summary-worktype-show="{{ worktype.id }}" id="report-summary-worktype-{{ worktype.id }}-show" name="summary[workType][{{ worktype.id }}][show]" type="checkbox" value="1" {% if worktype.show ?? false %}checked="checked"{% endif %}/>
                                            <label for="report-summary-worktype-{{ worktype.id }}-show" class="checkbox-label"></label>
                                        </td>
                                        <td>
                                            <input name="summary[workType][{{ worktype.id }}][grades]" type="hidden" value="0" />
                                            <input data-summary-worktype-option="{{ worktype.id }}" data-summary-worktype-grades="{{ worktype.id }}" id="report-summary-worktype-{{ worktype.id }}-grades" name="summary[workType][{{ worktype.id }}][grades]" type="checkbox" value="1" {% if worktype.grades ?? false %}checked="checked"{% endif %} {% if not worktype.show ?? false %} disabled="disabled" {% endif %}/>
                                            <label for="report-summary-worktype-{{ worktype.id }}-grades" class="checkbox-label"></label>
                                        </td>
                                        <td>
                                            <input name="summary[workType][{{ worktype.id }}][comments]" type="hidden" value="0" />
                                            <input data-summary-worktype-option="{{ worktype.id }}" data-summary-worktype-comments="{{ worktype.id }}" id="report-summary-worktype-{{ worktype.id }}-comments" name="summary[workType][{{ worktype.id }}][comments]" type="checkbox" value="1" {% if worktype.comments ?? false %}checked="checked"{% endif %} {% if not worktype.show ?? false %} disabled="disabled" {% endif %}/>
                                            <label for="report-summary-worktype-{{ worktype.id }}-comments" class="checkbox-label"></label>
                                        </td>
                                        <td>
                                            <input name="summary[workType][{{ worktype.id }}][rubrics]" type="hidden" value="0" />
                                            <input data-summary-worktype-option="{{ worktype.id }}" data-summary-worktype-rubrics="{{ worktype.id }}" id="report-summary-worktype-{{ worktype.id }}-rubrics" name="summary[workType][{{ worktype.id }}][rubrics]" type="checkbox" value="1" {% if worktype.rubrics ?? false %}checked="checked"{% endif %} {% if not worktype.show ?? false %} disabled="disabled" {% endif %}/>
                                            <label for="report-summary-worktype-{{ worktype.id }}-rubrics" class="checkbox-label"></label>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </table>
                            </div>
                        </fieldset>
                        {# Victorian Curriculum Progressions is Penola-specific atm #}
                        {% if 'pcc' == config.site_school_code|lower  %}
                        <fieldset class="content">
                            <legend>Victorian Curriculum Progressions</legend>
                            <div class="small-12 columns">
                                <p class="meta">
                                    Enabling this will provide a visualisation of <strong>progression points</strong> that students have achieved
                                    whilst undertaking any assessments that use the prescribed <strong>work type</strong>.
                                </p>

                                <ul class="option-list">
                                    <li>
                                        <input name="summary[vicProgression][enable]" type="hidden" value="0" />
                                        <input id="report-summary-enable-vic-progression" name="summary[vicProgression][enable]" type="checkbox" value="1" {% if options.summary.vicProgression.enable ?? false %}checked="checked"{% endif %} />
                                        <label for="report-summary-enable-vic-progression" class="checkbox-label">Enable</label>
                                    </li>
                                </ul>

                                <label for="report-summary-vic-progression-worktype">Work Type</label>
                                <select id="report-summary-vic-progression-worktype" name="summary[vicProgression][workType]">
                                    {% for worktype in worktypesSummary %}
                                        <option value="{{ worktype.id }}" {% if worktype.id == options.summary.vicProgression.workType ?? null %}selected="selected"{% endif %}>{{ worktype.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </fieldset>
                        {% endif %}
                </section>

                <div class="row actions-small-1">
                    <div class="list-item">
                        <div class="small-12 columns">
                            <h2 class="subheader">Class Page
                                <span class="hint has-tip tip-top" title="This will include a new page in the report for each class. This may include summary graphs and assessments for more detailed information about the class." data-tooltip="">?</span>
                            </h2>
                        </div>
                    </div>
                    <nav>
                        <span class="switch inline">
                            <input type="hidden" name="class[active]" value="0" />

                            <input id="report-include-class" name="class[active]" type="checkbox" value="1" data-section-enabled="section-class" {% if options.class.active ?? false %}checked="checked"{% endif %} />
                            <label for="report-include-class">
                                <span>On</span>
                                <span>Off</span>
                            </label>
                        </span>
                    </nav>
                </div>
                <section id="section-class">
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <fieldset class="checklist">
                                <legend>Display Options</legend>
                                <ul class="option-list">
                                    <li>
                                        <input name="class[overallGrade]" type="hidden" value="0" />
                                        <input id="report-class-show-overall-grade" name="class[overallGrade]" type="checkbox" value="1" {% if options.class.overallGrade ?? false %}checked="checked"{% endif %} />
                                        <label for="report-class-show-overall-grade" class="checkbox-label">Show overall grade</label>
                                    </li>
                                    <li>
                                        <input name="class[cohort]" type="hidden" value="0" />
                                        <input id="report-class-show-cohort" name="class[cohort]" type="checkbox" value="1" {% if options.class.cohort ?? false %}checked="checked"{% endif %} />
                                        <label for="report-class-show-cohort" class="checkbox-label">Show cohort/class distribution</label>
                                    </li>
                                    <li>
                                        <input name="class[classCode]" type="hidden" value="0" />
                                        <input id="report-class-show-class-code" name="class[classCode]" type="checkbox" value="1" {% if options.class.classCode ?? true %}checked="checked"{% endif %} />
                                        <label for="report-class-show-class-code" class="checkbox-label">Show class code</label>
                                    </li>
                                    <li>
                                        <input name="class[subjectOverview]" type="hidden" value="0" />
                                        <input id="report-class-show-subject-overview" name="class[subjectOverview]" type="checkbox" value="1" {% if options.class.subjectOverview ?? false %}checked="checked"{% endif %} />
                                        <label for="report-class-show-subject-overview" class="checkbox-label">Show Subject overview</label>
                                        <label for="report-class-search-subject-overview" class="checkbox-label">Title of Subject overview:</label>
                                        <p class="meta">Add a textbox heading to show associated subject overviews from imported courses.</p>
                                        <input id="report-class-search-subject-overview" name="class[subjectOverviewSearch]" type="text" value="{{ options.class.subjectOverviewSearch ?? '' }}" placeholder="Title of Subject overview"/>
                                    </li>
                                </ul>
                            </fieldset>
                        </div>
                    </fieldset>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <legend>Work Types</legend>
                            <p class="meta">Select the work types and the type of feedback you would like included on the report.</p>
                            <table>
                                <tr>
                                    <th>&nbsp;</th>
                                    <th>Show</th>
                                    <th>Grade</th>
                                    <th>Comment</th>
                                    <th>Rubric</th>
                                </tr>
                                {% for worktype in worktypesClass %}
                                    <tr data-class-worktype-id="{{ worktype.id }}">
                                        <td>{{ worktype.name }}</td>
                                        <td>
                                            <input name="class[workType][{{ worktype.id }}][show]" type="hidden" value="0" />
                                            <input data-class-worktype-show="{{ worktype.id }}" id="report-class-worktype-{{ worktype.id }}-show" name="class[workType][{{ worktype.id }}][show]" type="checkbox" value="1" {% if worktype.show ?? false %}checked="checked"{% endif %}/>
                                            <label for="report-class-worktype-{{ worktype.id }}-show" class="checkbox-label"></label>
                                        </td>
                                        <td>
                                            <input name="class[workType][{{ worktype.id }}][grades]" type="hidden" value="0" />
                                            <input data-class-worktype-option="{{ worktype.id }}" data-class-worktype-grades="{{ worktype.id }}" id="report-class-worktype-{{ worktype.id }}-grades" name="class[workType][{{ worktype.id }}][grades]" type="checkbox" value="1" {% if worktype.grades ?? false %}checked="checked"{% endif %} {% if not worktype.show ?? false %} disabled="disabled" {% endif %}/>
                                            <label for="report-class-worktype-{{ worktype.id }}-grades" class="checkbox-label"></label>
                                        </td>
                                        <td>
                                            <input name="class[workType][{{ worktype.id }}][comments]" type="hidden" value="0" />
                                            <input data-class-worktype-option="{{ worktype.id }}" data-class-worktype-comments="{{ worktype.id }}" id="report-class-worktype-{{ worktype.id }}-comments" name="class[workType][{{ worktype.id }}][comments]" type="checkbox" value="1" {% if worktype.comments ?? false %}checked="checked"{% endif %} {% if not worktype.show ?? false %} disabled="disabled" {% endif %}/>
                                            <label for="report-class-worktype-{{ worktype.id }}-comments" class="checkbox-label"></label>
                                        </td>
                                        <td>
                                            <input name="class[workType][{{ worktype.id }}][rubrics]" type="hidden" value="0" />
                                            <input data-class-worktype-option="{{ worktype.id }}" data-class-worktype-rubrics="{{ worktype.id }}" id="report-class-worktype-{{ worktype.id }}-rubrics" name="class[workType][{{ worktype.id }}][rubrics]" type="checkbox" value="1" {% if worktype.rubrics ?? false %}checked="checked"{% endif %} {% if not worktype.show ?? false %} disabled="disabled" {% endif %}/>
                                            <label for="report-class-worktype-{{ worktype.id }}-rubrics" class="checkbox-label"></label>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </div>
                    </fieldset>
                    {# Victorian Curriculum Progressions is Penola-specific atm #}
                    {% if 'pcc' == config.site_school_code|lower  %}
                    <fieldset class="content">
                        <legend>Victorian Curriculum Progressions</legend>
                        <div class="small-12 columns">
                            <p class="meta">
                                Enabling this will provide a visualisation of <strong>progression points</strong> that students have achieved
                                whilst undertaking any <strong>class-specific</strong> assessments that use the prescribed <strong>work type</strong>.
                            </p>

                            <ul class="option-list">
                                <li>
                                    <input name="class[vicProgression][enable]" type="hidden" value="0" />
                                    <input id="report-class-enable-vic-progression" name="class[vicProgression][enable]" type="checkbox" value="1" {% if options.class.vicProgression.enable ?? false %}checked="checked"{% endif %} />
                                    <label for="report-class-enable-vic-progression" class="checkbox-label">Enable</label>
                                </li>
                            </ul>

                            <label for="report-class-vic-progression-worktype">Work Type</label>
                            <select id="report-class-vic-progression-worktype" name="class[vicProgression][workType]">
                                {% for worktype in worktypesClass %}
                                    <option value="{{ worktype.id }}" {% if worktype.id == options.class.vicProgression.workType %}selected="selected"{% endif %}>{{ worktype.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </fieldset>
                    {% endif %}

