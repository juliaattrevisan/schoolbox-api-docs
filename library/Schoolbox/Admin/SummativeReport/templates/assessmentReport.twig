{##
 # Assessment template in Summative Report Export
 #
 # @param \Schoolbox\User $student
 # @param string $page
 # @param IFeedback $feedback
 # @param IAssessable $assessment
 # @param array $options // the report options
 #}

{# Rubric grid is optional and spans full width of the page
 # so you can't throw it in .feedback-assessment
 #}
{% set participant = assessment.allParticipants[student.id] ?? null %}

{# If $student participation excluded or removed from this assessment
 # just skip the rendering of this assessment entirely
 #}
{% if participant %}
    <div class="feedback-assessment-container" data-test="summative-preview-feedback-container-{{ assessment.title }}">
        <div class="feedback-assessment">
            <div class="left">
                <h5>{{ assessment.title }}</h5>

                {% if '' != assessment.workType.name %}
                <p class="worktype">{{ assessment.workType.name }}</p>
                {% endif %}

                {# Only show comment if it exists
                 # Otherwise, just occupy space
                 # Foundation-related behaviour requires a character to do that
                 #}
                {% if "1" == options.workType[assessment.workType.id].comments and feedback and feedback.comment %}
                    <div class="comment">
                        <article>{{ feedback.comment | purify }}</article>
                    </div>
                {% endif %}
            </div>
            {% if feedback or (assessment is project) %}
                <div>
                    {% set grade = assessment.humanReadableMark(participant, true) %}
                    {% if "1" == options.workType[assessment.workType.id].grades and grade|length %}
                        <p class="grade">{{ grade }}</p>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {# If there's no feedback, don't render anything else about
         # rubrics, comments and grades - nothing to show
         #
         # If this feedback has a rubric grid, show that
         #}
        {% if feedback and "1" == options.workType[assessment.workType.id].rubrics and (feedback.rubricMarkedGrids.count ?? null) %}
            {% for rubricInstanceId, rubricMarkedGrid in feedback.rubricMarkedGrids %}
                <div class="rubric-wrap">
                    {# showGroupTotal and showRubricTotal are vars that unilaterally decide whether the Capability Mark
                     # value and Rubric Total value shows on the grid, regardless of the feedbacks or assessment setting
                     # that you could potentially use to derive this outcome. It's so that you can arbitrarily decide
                     # when and where each of these can be seen by a user. For example, in summative reports, you
                     # always want to show the capability mark but never show the rubric total - even if the assessment
                     # settings suggest you could.
                     #}
                    {% include '@rubric/grid.twig' with {
                        assessment: assessment,
                        rubricInstance: rubricMarkedGrid.grid.rubricInstance,
                        showGroupTotal: true,
                        showRubricTotal: false,
                        learner: student,
                        rubricGrid: rubricMarkedGrid.grid,
                        rubricMarkedGrid: rubricMarkedGrid,
                        rubricSelfGradedGrid: null,
                        selfAssessmentFeedback: null,
                        collapsible: false
                    } only %}
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endif %}
