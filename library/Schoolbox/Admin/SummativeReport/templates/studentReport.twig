<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/vendors.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/main.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/jquery.all-work.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/highchartsMore.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/submissions/reportCardBoxplot.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/learninganalytics/schoolboxTheme.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/eportfolio/jquery.eportfolio.js?v={{ config.site_version }}"></script>

<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/core/schoolbox-ck-content.css?v={{ config.site_version }}"/>
<style>
    /**
     *  Why .summative-content?
     *  Inside this report we include CK editor content and custom font and text styles.
     *  Without encapsulating these to within their specific areas, they leak and fight each
     *  other, causing inconsistency between how the content is shown on the page. Any text
     *  styles need to be wrapped up to prevent this, hence the .summative-content tag.
    **/

    /* Vaguely analogous to A4 dimensions so you can preview in browser
     * otherwise the pdf print wraps in a different place, throwing your judgement
     */
    .summative-report {
        width: 1000px;
        margin: auto;
    }

    /* Make table font size match one to one. */
    article table {
        font-size: 0.8125rem;
    }

    /* Typography
     */
    .summative-content h1,
    .summative-content h2,
    .summative-content h3,
    .summative-content h4,
    .summative-content h5,
    .summative-content h6 {
        color: black;
        font-weight: 700;
        margin: 0;
        padding: 0;
    }

    .summative-content h1 {
        font-size: 2.45rem;
        margin-bottom: 0.25rem;
    }

    .summative-content h2 {
        font-size: 1.75rem;
    }

    .summative-content h3 {
        font-size: 1.5rem;
    }

    .summative-content h4 {
        font-size: 1.3rem;
    }

    .summative-content h5 {
        font-size: 1.15rem;
    }

    .summative-content h6 {
        font-size: 1rem;
    }

    .summative-content p {
        color: black;
        line-height: 1.5rem;
    }

    /* Images must be no larger than 100% max-width
     * otherwise they go off the page
     */
    img {
        max-width: 100%;
    }

    /* Make background colours print
     */
    body .summative-content{
        -webkit-print-color-adjust: exact !important;
        font-family: Arial, sans-serif;
        font-style: normal;
        font-weight: 400;
        line-height: 1.25;
    }

    /* header-content is stuff at the top of the report
     * Report title, school name, logo
     */
    .header-content {
        align-items: center;
        display: flex;
        margin-bottom: 2rem;
    }

    /* Left hand column in the header - contains report title, school name
     */
    .header-content .left {
        flex-grow: 2;
    }

    /* Special cosmetic representation of semantic h1
     * The report title should look like it pwns your face
     * Linux doesn't have a good equivalent to TNR so...I picked a nice one
     */
    .header-content h1 {
        font-weight: normal;
    }

    /* Special cosmetic representation of semantic h2
     * If there isn't a logo, the margin-bottom pushes everything else around
     * to provide appropriate negative space
     */
    .header-content h2.school-name {
        font-size: 1.5rem;
        font-weight: normal;
        margin: 0;
    }

    /* Ensure school logos have a max dimension
     * so broken svgs don't break YOU
     */
    .logo {
        max-width: 12rem;
        margin: 0 0 0 2rem;
        padding: 0;
    }

    /* The thing that tells you about students
     */
    .card {
        align-items: center;
        display: flex;
    }

    .card img {
        margin-right: 0.75rem;
    }

    .card .year {
        margin: 0;
    }

    /* Introductory text
     * Can't tell what the schools are going to compose here, but I imagined this
     * as a lead-in paragraph which should typographically be different than the
     * rest of the body text in this report
     */
    .introduction {
        clear: both;
        margin-top: 2rem;
        width: 100%;
    }

    /* Name of the subject/folder has a special style
     * which also encompasses the subject's overall grade
     * Use a flexbox to optionally show a grade
     */
    .folder-title {
        align-items: center;
        display: flex;
        padding: 0.75rem;
    }

    .folder-title .left {
        flex-grow: 2;
    }

    /* These appear the name of the assessment and the comment
     * as little subtitle sort of things
     */
    .summative-content .worktype {
        color: grey;
        font-size: 0.75rem;
        font-style: italic;
        margin: 0;
    }

    /* A grade value, suitable for Folder Title
     * or for an assessment.
     *
     * Allot 8rem for it, and right-align it so it
     * lines up with the right edge of the page.
     * break-word prevent word break on grade area
     */
    .grade {
        font-size: 1.5rem;
        font-weight: bold;
        margin: 0;
        padding-left: 2rem;
        padding-right: 0.75rem;
        min-width: 8rem;
        text-align: right;
        overflow-wrap: break-word;
    }

    /* Comments, if provided, are generally plaintext but could be ckeditor stuff
     * Wrap it in a div anyway. If the comment is very long, padding-right stops
     * it from being directly adjacent to the grade if it exists
     */
    .comment {
        margin: 1rem 0;
        padding-right: 2rem;
    }

    /* This .feedback-assessment-container element typically has a bottom border for a
     * separator and a page break in the media query
     */
    .feedback-assessment-container {
        border-bottom: 1px solid #ccc;
    }

    /* The width of the Assessment and Grade columns
     * Using small-* names is going to be misleading - specify them explicitly
     */
    .feedback-assessment {
        display: flex;
        padding: 0.75rem;
    }

    /* Assessment name lives here
     */
    .feedback-assessment .left {
        flex-grow: 2;
    }

    /* The grade already has a right-margin from container element .feedback-assessment
     * and also doesn't have a border or anything - resetting padding here mostly centers
     * the content int his little flexbox place
     */
    .feedback-assessment .grade {
        padding-right: 0;
    }

    /* The summary section is anticipated to be a less-detailed overview of what
     * a student accomplished for this reporting period. Functionally identical to the
     * Class Pages section, but their intents are different. The styling is specifically
     * so that content flows contiguously; no page breaks, no obtrusive folder highlighting,
     * and indenting to show the hierarchy of assessments. The rubric grid, while
     * optional, probably shouldn't be activated for this section. We don't stop people
     * from doing that though.
     */
    .summary .folder-title {
        border-bottom: 1px solid #ccc;
        clear: both;
        margin: 2rem 0 0.5rem 2rem;
        padding: 0 0 0.5rem 0;
    }

    .summary {
        margin-bottom: 1rem;
    }

    /* Reduce the bottom margin in the Summary area
     * because we don't have the wrapping block here
     */
    .summary .grade {
        margin: 0 0 0.5rem 0;
    }

    .summary .feedback-assessment-container {
        border: 0;
        margin-left: 4rem;
    }

    /* A folder title in the class summary section
     */
    .class-page {
        background: lightgrey;
        border: 1px solid black;
        padding: 0.75rem;
    }

    /* Teachers in the Class Summary section have a more space-efficient style
     * and layout, but we don't need its excess padding
     */
    .class-page .card.compact {
        margin: 0.75rem 0 0 0;
    }

    /* Special cosmetic representation of semantic h5
     */
    .class-page h5 {
        font-size: 1rem;
    }

    /* Push the rubric grid down a little bit, if it exists
     */
    .rubric-wrap {
        display: block;
        margin-top: 1rem;
        margin-bottom: 2rem;
        width: 100%;
    }

    /* All p elements get squished to fit more aggressively
     */
    .rubric-wrap p {
        line-height: 1rem;
    }

    /* Rubric table
     * This is the only table element we render here
     */
    .summative-content table.rb {
        border-collapse: collapse;
        table-layout: fixed;
        width: 100%;
    }

    .summative-content table.rb,
    .summative-content table.rb p {
        font-size: 0.75rem;
    }

    /* Headings were oddly grey by intent but black we go
     */
    .summative-content th p {
        font-weight: 700;
        margin-bottom: 0;
        padding-left: 0.25rem;
        text-align: left;
        word-wrap: break-word;
    }

    /* All cells have lines everywhere around it
     * All cells have padding just because
     */
    .rb th, .rb td {
        border: solid 1px #8c8c8c;
        padding: 4px;
    }

    /* All descriptor cells top-align
     */
    .rb td {
        vertical-align: top
    }

    /* The value of a descriptor, if such a value exists
     */
    .rb-value {
        color: #acacac;
        display: block;
        margin-top: 1rem;
    }

    /* All descriptor cells have black text regardless of their selection state
     */
    .rb-selected .rb-description, .rb-selected .rb-value {
        color: black;
    }

    /* The descriptor that was selected by the instructor
     */
    .rb-selected {
        background-color: lightgray !important;
        border-left: 2px solid black !important;
    }

    .summative-content th.rb-final-summary {
        padding: 0.5rem;
    }

    /* Rubric heading cells for Capabilities, Indicators, Levels
     * Use a lighter shade of grey than selected Descriptors
     */
    .rb th {
        background-color: #ececec;
    }

    /* Capabilities can optionally have a mark
     */
    .rb th.rb-group-summary {
        padding: 0.33rem;
        font-size: 1rem;
        text-align: right;
    }

    /* Top-left cell is a meaningless cell
     */
    .rb.markable thead tr th:first-child {
        background-color: transparent;
        border-left: 0;
        border-top: 0;
    }

    /* Contents of capabilities, indicators, descriptors can have markdown
     */
    .markdown li, .markdown p {
        white-space: pre-wrap;
    }

    .summative-graph-container {
        padding-left: 1rem;
    }

    .summative-graph-type {
        font-size: 1rem;
        margin-top: 1rem;
    }

    .summative-graph-type,
    .summary-subtitle {
        font-weight: 600;
        padding-left: 2rem;
    }

    /* Padding is inconsistent between the summary area and class area.
       as we're on a merge deadline, here's a quick fix. */
    .folder-title.class-page + .summative-graph-type {
        padding-left: 1rem;
    }

    /* Make the first letter uppercase... */
    .summative-graph-type::first-letter {
        text-transform: uppercase;
    }

    /* Apply measured margins to report. You can adjust those to suit
     * tested printouts to ensure you don't print over edges and stuff
     */
    @page {
        size: A4 portrait; /* try and enforce portrait orientation */
        margin: 0.5in 0.5in 0.75in 0.5in;
    }

    @media print {
        .content {
            padding: 0; /* to get more of the page real estate */
        }

        /* Folder titles in the Class Pages section always get a page break
         * They always start on a new page.
         */
        .class-page {
            page-break-before: always; /* ensure each individual subject goes on new page */
        }

        /* Summary always starts on a separate page
         * Folders In the Summary section will just
         * render one underneath the other, contiguously
         */
        .summary {
            page-break-before: always;
        }

        /*
         * This was previously being applied on only a .rubric-wrap level, however there was a bug
         * reported (SA-14817) in which an assessment title and a rubric could be split across
         * multiple pages. Adding this to the feedback-assessment-container level resolved
         * this. The original comment is included below. There are still issues with some odd
         * page breaks - read more at https://schoolbox.atlassian.net/browse/SA-14817
         *
         * page-break-inside has been deprecated, the new style to apply is break-inside.
         * However, it is maintained for legacy compatability as suggested on the MDN.
         * https://developer.mozilla.org/en-US/docs/Web/CSS/page-break-inside
         *
         * "This is so so so extremely wasteful if grids are very short
         * Without javascript it's impossible to html/css a detection to see if a grid fits
         * and a blanket rule like this will cause all grids to start on a new page - even
         * if they can fit on an existing one
         *
         * .xxxxx { page-break-before: always }
         *
         * Instead, avoid page breaks inside an element, which is far superior"
         */
        .rubric-wrap, .feedback-assessment-container {
            page-break-inside: avoid;
            break-inside: avoid;
        }

        /* Page Breaks in css exhibit a really oddball behaviour where they are affected by a parent
         * element's display property. Changing this property changes the behaviour of page breaks,
         * which isn't a very obvious logical leap...but we use inline-table to retain some styling.
         * display:block causes us to lose padding and other visual niceness.
         * https://stackoverflow.com/questions/34534231/page-break-insideavoid-not-working
         */
        .summative-content table.rb.markable {
            display: inline-table;
        }
    }

    {{ customReportStyle ?? '' }}
</style>

<div class="summative-report">
    <div class="header-content summative-content">
        <div class="left">
            <h1>{{ report.title }}</h1>
            <h2 class="school-name">{{ config.school_name }}</h2>
        </div>
        {% if report.logo and report.logo.hash %}
        <img src="/storage/image.php?hash={{ report.logo.hash }}" alt="{{ config.school_name }}" class="logo" />
        {% endif %}
    </div>

    <div class="card summative-content">
        {% if student.portrait %}
        <img src="/portrait.php?id={{ student.id }}&amp;size=square64" alt="{{ student.fullName }}" />
        {% endif %}
        <div>
            <h3 class="name">{{ student.firstname }} {{ student.lastname }}</h3>

            {# Only show year if it was ever set and meaningful
             #}
            {% if student.year and student.year.longName(locale.year.proper) != '' %}
            <p class="year">{{ student.year.longName(locale.year.proper) }}</p>
            {% endif %}
        </div>
    </div>

    {% if report.introduction|length %}
    <div class="introduction">
        <article>
            {{ report.introduction | purify }}
        </article>
    </div>
    {% endif %}

    {# Summary #}
    {% if showSummary %}
    <div class="summary summative-content">
        {% if summaryHeading|length %}
            <h3>{{ summaryHeading }}</h3>
        {% endif %}

        {% for folder in folders %}
            {% set studentGrade = markbooks[folder.id].studentStatistics[student.id] %}
            {% set weightedMean = studentGrade.weightedMean %}
            {% set hasAssessments = summaryAssessments[folder.id] ?? [] | length %}

            {# only show the folder if there are filtered assessments or if an overall mark can be shown #}
            {% if hasAssessments or (showSummaryOverallGrade and weightedMean != '') %}
                <div class="folder-title">
                    <div class="left">
                        {% block summaryFolderTitle %}
                            {% if summaryOptions.classCode is not defined or summaryOptions.classCode %}
                                <h4>{{ folder.title }}</h4>
                            {% else %}
                                <h4>{{ folder.name }}</h4>
                            {% endif %}
                        {% endblock %}
                    </div>

                    {% if showSummaryOverallGrade %}
                    <p class="grade">{{ weightedMean ?? '' }}</p>
                    {% endif %}
                </div>

                {% if allGraphs['summary'][folder.id] is defined %}
                    {% include '@learningGrades/fragments/summativeGraph.twig' with { graph: allGraphs['summary'][folder.id].graph, graphId: 'summary_' ~ folder.id, folderType: allGraphs['summary'][folder.id].type, location: 'summary' } only %}
                {% endif %}

                {# The class may have a mark but no assessments, ignore this class and move along #}
                {% if hasAssessments %}
                    {% for assessment in summaryAssessments[folder.id] %}
                        {% set participant = assessment ? assessment.participantIfExtant(student) : null %}
                        {% include '@adminSummativeReport/assessmentReport.twig' with
                            {
                                student: student,
                                assessment: assessment,
                                feedback: summaryAssessmentFeedbacks[assessment.id] ?? null,
                                page: 'subject-summary',
                                options: summaryOptions
                            } only %}
                    {% endfor %}
                {% endif %}
            {% endif %}
        {% endfor %}

        {# Victorian Curriculum Progression: Summary #}
        {% include '@adminSummativeReport/VictorianProgression.twig' with {
            payload: vicProgression.summary,
            annotate: vicProgression.annotate
        } only %}
    </div>
    {% endif %}

    {# Class #}
    {% if showClass %}
        {% for folder in folders %}
            {# if there are no filtered assessments for this folder, ignore the folder #}
            {% if (classAssessments[folder.id] ?? [])| length %}
            {% set studentGrade = markbooks[folder.id].studentStatistics[student.id] %}
            {% set weightedMean = studentGrade.weightedMean %}
            <div class="folder-title class-page summative-content">
                <div class="left">
                    {% block classFolderTitle %}
                        {% if classOptions.classCode is not defined or classOptions.classCode %}
                            <h4>{{ folder.title }}</h4>
                        {% else %}
                            <h4>{{ folder.name }}</h4>
                        {% endif %}
                    {% endblock %}
                    {% for teacher in folder.teachers %}
                        <div class="card compact">
                            <img src="/portrait.php?id={{ teacher.id }}&size=square32" />
                            <h5>{{ teacher.fullname }}</h5>
                        </div>
                    {% endfor %}
                </div>
                {% if showClassOverallGrade and weightedMean %}
                    <div>
                        <p class="grade">{{ weightedMean ?? '' }}</p>
                    </div>
                {% endif %}
            </div>
            {% if subjectOverviews[folder.id] is not empty %}
                <div>
                    <h2 class="subject-overview">{{ classOptions.subjectOverviewSearch }}</h2>
                        {% for course in subjectOverviews[folder.id] %}
                            {% if course.textboxes is not empty %}
                            {% for textbox in  course.textboxes %}
                                <div class="content">
                                    <h4 class="subject-overview-course">{{ course.title }}</h4>
                                    <article class="course-overview-textbox" id="textBoxBody{{ textbox.textboxID }}">{{ textbox.textboxBody | purify }}</article>
                                </div>
                            {% endfor %}
                            {% endif %}
                        {% endfor %}
                </div>
            {% endif %}
                {% if allGraphs['class'][folder.id] is defined %}
                    {% include '@learningGrades/fragments/summativeGraph.twig' with { graph: allGraphs['class'][folder.id].graph, graphId: 'class_' ~ folder.id, folderType: allGraphs['class'][folder.id].type, location: 'class' } only %}
                {% endif %}
            <div class="summative-content">
                {% for assessment in classAssessments[folder.id] %}
                    {% include '@adminSummativeReport/assessmentReport.twig' with
                        {
                            student: student,
                            assessment: assessment,
                            feedback: classAssessmentFeedbacks[assessment.id] ?? null,
                            page: 'subject',
                            options: classOptions
                        } only %}
                {% endfor %}
            </div>
            {% endif %}

            {# Victorian Curriculum Progression: Class #}
            {% if vicProgression.class[folder.id] ?? false %}
                {% include '@adminSummativeReport/VictorianProgression.twig' with {
                    payload: vicProgression.class[folder.id],
                    annotate: vicProgression.annotate
                } only %}
            {% endif %}
        {% endfor %}
    {% endif %}
</div>
