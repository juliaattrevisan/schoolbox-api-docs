{##
 # List of Summative Reports
 #
 # @param GenericCollection $reports  A list of SummativeReport/Model instances
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    {% set createRoute = routeLookupIfAuthorized('adminSummativeReport.getCreate') %}

    <div class="admin-content">
        {% if reports|length %}
            <div class="small-12 island">
                <div class="row actions-small-1">
                    <div class="list-item">
                        <div class="small-12 island">
                            <h2 class="subheader">Summative Report List</h2>
                        </div>
                    </div>
                    <nav>
                        <a href="{{ createRoute }}" class="sbx-icon-only-button" title="Add a summative report" aria-label="Add a summative report">
                            <sbx-icon name="add"></sbx-icon>
                        </a>
                    </nav>
                </div>
                <section>
                    <ul class="information-list">
                        {% for report in reports %}
                        {% set updateRoute = routeLookupIfAuthorized('adminSummativeReport.getUpdate', {report: report, reportId: report.id}) %}

                        <li class="actions-small-5">
                            <div class="list-item">
                                <div class="card small-12">
                                    {% if updateRoute %}
                                        <a href="{{ updateRoute }}">
                                            <h3 data-test="summative-report-title-{{ report.title }}">{{ report.title }}</h3>
                                        </a>
                                        {% else %}
                                        <h3>{{ report.title }}</h3>
                                    {% endif %}
                                    <p class="meta">
                                        Last modified by
                                        {% if report.updatedBy.deleted %}
                                            {{ report.updatedBy.fullname }}
                                        {% else %}
                                            <a href="/search/user/{{ report.updatedBy.id }}" title="{{ report.updatedBy.fullname }}">{{ report.updatedBy.fullname }}</a>
                                        {% endif %}

                                        on {{ report.updatedAt.local }}
                                    </p>
                                </div>
                            </div>
                            <nav>
                                {% set previewRoute = routeLookupIfAuthorized('adminSummativeReport.getPreview', {report: report, reportId: report.id}) %}
                                {% if previewRoute %}
                                    <a class="sbx-icon-only-button" href="{{ previewRoute }}" title="Preview Report" aria-label="Preview Report" data-test="summative-report-preview-{{ report.title }}" data-preview>
                                        <sbx-icon name="view"></sbx-icon>
                                    </a>
                                {% endif %}

                                {% set generateRoute = routeLookupIfAuthorized('adminSummativeReport.getGenerate', {report: report, reportId: report.id}) %}
                                {% if generateRoute %}
                                <a class="sbx-icon-only-button" href="{{ generateRoute }}" title="Download" aria-label="Download" data-test="summative-report-download-{{ report.title }}">
                                    <sbx-icon name="download"></sbx-icon>
                                </a>
                                {% endif %}

                                {% if updateRoute %}
                                    <a class="sbx-icon-only-button" href="{{ updateRoute }}" title="Modify" aria-label="Modify" data-test="summative-report-modify-{{ report.title }}">
                                        <sbx-icon name="modify"></sbx-icon>
                                    </a>
                                {% endif %}

                                {% set dupeRoute = routeLookupIfAuthorized('adminSummativeReport.getDuplicate', {report: report, reportId: report.id}) %}
                                {% if dupeRoute %}
                                <a class="sbx-icon-only-button" href="{{ dupeRoute }}" title="Duplicate" aria-label="Duplicate" data-test="summative-report-copy-{{ report.title }}">
                                    <sbx-icon name="copy"></sbx-icon>
                                </a>
                                {% endif %}

                                {% set deleteRoute = routeLookupIfAuthorized('adminSummativeReport.postDelete', {report: report, reportId: report.id}) %}
                                {% if deleteRoute %}
                                    <script>
                                        $(function() {
                                            let toast = $('#toast');

                                            $('#container').on('click', 'a[data-delete="{{ report.id }}"]', function(event) {
                                                event.preventDefault();

                                                let element = $(this);

                                                element.confirmDialog({
                                                    text: 'Are you sure you want to delete this summative report?',
                                                    confirmEvent: function() {
                                                        /* Activate indicator label
                                                         */
                                                        toast.toastActivate({
                                                            text: "Deleting..."
                                                        });

                                                        $.post(element.attr('href'), function() {
                                                            })
                                                            .done(function() {
                                                                toast.toastTimeout({
                                                                    text: 'Saved',
                                                                    css: 'success'
                                                                });

                                                                location.reload();
                                                            })
                                                            .fail(function(response) {
                                                                let temp = JSON.parse(response.responseText);

                                                                toast.toastTimeout({
                                                                    text: 'Could not save: ' + temp.error,
                                                                    css: 'alert'
                                                                });
                                                            });
                                                    }
                                                });
                                            });
                                        });
                                        //preview in new window at specific size
                                        $(function() {
                                            $('[data-preview]').on('click', function(event) {
                                                event.preventDefault();

                                                window.open($(this).attr('href'),'1396330261396','width=950,height=800,toolbar=0,menubar=0,location=0,status=1,scrollbars=1,resizable=0,left=0,top=0');
                                            });
                                        });
                                    </script>
                                    <a class="sbx-icon-only-button" href="{{ deleteRoute }}" title="Delete" aria-label="Delete" data-delete="{{ report.id }}" data-test="summative-report-delete-{{ report.title }}">
                                        <sbx-icon name="delete"></sbx-icon>
                                    </a>
                                {% endif %}
                            </nav>
                        </li>
                        {% endfor %}
                    </ul>
                </section>
            </div>
        {% else %}
            <div class="empty-state">
                <i class="icon-progress"></i>
                <p>No summative reports have been created.</p>
                {% if createRoute %}
                <p><a href="{{ createRoute }}">Click here</a> to build a summative report.</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>

<div id='toast' class="toast" data-toast></div>
