<script type="application/javascript">
    $(function() {
        var $toast = $('[data-toast]');

        $('[data-install-package]').on('click', function(event) {
            event.preventDefault();
            $(this).confirmDialog({
                text: 'Are you sure you want to install this package?',
                confirmEvent: function() {
                    /** check if the package has already been installed, or is being installed? */
                    if (true === $(event.target).prop('checked')) {
                        return;
                    }
                    var config = {text: 'Installing package...'};

                    /** mark the package as installed. if it fails we will undo this */
                    $(event.target).prop('checked', true).prop('disabled', true);
                    $toast.toastActivate(config);

                    $.ajax({
                        type: 'POST',
                        url: "{{ routeLookup('adminPackage.installPackage') }}",
                        dataType: 'json',
                        data: {
                            id: $(event.target).attr('data-install-package')
                        }
                    })
                    .done(function() {
                        $toast.toastTimeout({
                            text: 'Package has been successfully installed!',
                            css: 'success'
                        });
                        $(event.target).prop('checked', true).prop('disabled', true);
                    })
                    .fail(function(response) {
                        var temp = JSON.parse(response.responseText);

                        /** package failed, allow this package to be re-installed */
                        $(event.target).prop('checked', false).prop('disabled', false);
                        $toast.toastTimeout({
                            text: temp.message,
                            css: 'alert'
                        });
                    });
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <h2 class="subheader">Packages</h2>
        </div>

        <div class="small-12 island">
            <section>
                <ul class="information-list card-selectable">
                    {% for package in packages %}
                        <li>
                            <div>
                                <div class="selector">
                                    <input id="chk-{{ package.id }}" data-install-package="{{ package.id }}" type="checkbox" {{  package.isInstalled ? 'checked disabled' : '' }}>
                                    <label for="chk-{{ package.id }}" class="checkbox-label"></label>
                                </div>
                                <div class="card small-12">
                                    <h3 class="package-title">{{ package.title }}</h3>
                                    <article>{{ package.description }}</article>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
</div>
<div id='toaster' class="toast" data-toast></div>
