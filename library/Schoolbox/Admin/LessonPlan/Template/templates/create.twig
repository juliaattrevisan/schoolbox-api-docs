{##
 # Create Lesson Plan Templates
 #
 # @param Template/Model $lessonPlanTemplate  A Lesson Plan Template instance, with its Fields
 # @param string $studentRole                 The const corresponding to the Student roletype
 # @param string $newKeyword                  The const corresponding to the New Keyword in backend
 #}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/sportsfixtures/jquery.mightyList.js?v={{ config.site_version }}"></script>

<script>
    $(function() {
        /**
         *  Mandate at least one field existing at all times
         */
        function refreshDeletes() {
            if ($('#fields').find('li').length === 1) {
                $('#fields li [data-delete]').first().addClass('hide');
            } else {
                $('#fields li [data-delete]').removeClass('hide');
            }
        }


        let fieldCount = 1;

        // Set up draggable menu
        $('#fields').mightyList({});
        $('#fields').sortable({
            handle: '.grip',
            axis: 'y',
            tolerance: 'pointer',
            placeholder: 's-placeholder',
            forcePlaceholderSize: true,
            start: (e) => {
                //Get all our field sections, but don't select the one in the 'blueprint'
                const items = document.querySelector('#fields').querySelectorAll('[data-template-section]') || [];
                //Update the topbar name display for each of our fields
                items.forEach(field => {
                    const nameDisplay = field.querySelector('[data-name-display]');
                    const nameInput = field.querySelector('[data-field-title]').value;
                    nameDisplay.innerHTML = nameInput;
                });

                //Add a class to apply our rules whilst we're dragging
                document.querySelector('#fields').classList.add('s-is-dragging');
                $('#fields').sortable('refreshPositions');
            },
            stop: () => {
                //Remove the class applying our draggable rules
                document.querySelector('#fields').classList.remove('s-is-dragging');
            }
        });

        $('#add-field').on('click', function() {
            /* Make a clone
             */
            let clone = $($('#field-blueprint').html());

            /* Update the ids and name attributes
             */
            let newId = '{{ newKeyword }}' + fieldCount;

            let titleId = 'field-title-' + newId;
            let titleName = 'field[' + newId + '][title]';

            let bodyId = 'field-body-' + newId;
            let bodyName = 'field[' + newId + '][body]';

            let visibilityId = 'field-visibility-' + newId;
            let visibilityName = 'field[' + newId + '][visibility]';

            clone.find('input[id="field-title"]').attr('name', titleName);
            clone.find('input[id="field-title"]').attr('id', titleId);
            clone.find('label[for="field-title"]').attr('for', titleId);

            clone.find('textarea[id="field-body"]').attr('name', bodyName);
            clone.find('textarea[id="field-body"]').attr('id', bodyId);
            clone.find('label[for="field-body"]').attr('for', bodyId);

            clone.find('input[id="field-visibility"]').attr('name', visibilityName);
            clone.find('input[id="field-visibility"]').attr('id', visibilityId);
            clone.find('label[for="field-visibility"]').attr('for', visibilityId);

            /* Placeholder
             */
            clone.find('input[type="hidden"]').attr('name', visibilityName);

            /* Inject it into the stack
             */
            let li = $('<li></li>');
            li.append(clone);

            $('#fields').append(li);

            /* Apply validator rules
             */
            $('input[name="'+titleName+'"]').rules('add', 'requiredNotBlank');

            /* Spawn a cke for this new field
             */
            document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
                detail: {
                    maxCharCount: window.sbProps.MAX_BYTES_MYSQL_MEDIUMTEXT,
                    targetElements: ['#' + bodyId]
                }
            }));

            /* Postincrement in preparation for another new row
             */
            fieldCount++;

            /* Mandate at least one field existing at all times
             */
            refreshDeletes();
        });

        /* A dynamic mix-it-up of fields that already exist
         * and fields which were just spawned
         */
        $('#lesson-plan-template-form').alaressValidate({
            rules: {
                {% if lessonPlanTemplate is not null %}
                {% for field in lessonPlanTemplate.fields %}
                'field[{{ field.id }}][title]': {
                    requiredNotBlank: true
                },
                {% endfor %}
                {% endif %}

                /* LPT title is always required
                 */
                'title' : {
                    requiredNotBlank: true
                }
            }
        });

        /* Delete a field
         */
        $('#lesson-plan-template-form').on('click', 'a[data-delete]', function (event) {
            event.preventDefault();

            let element = $(this);

            element.confirmDialog({
                text: 'Are you sure you want to delete this field?',
                confirmEvent: function () {
                    const lis = element.closest('li');
                    const li = lis[0];
                    const textarea = li.querySelector('textarea');
                    const textareaId = textarea.getAttribute('id');

                    // Request that the editor instance be deleted from window.sbProps.editors.
                    // The event listener in editor.ts will deal with re-enabling the submit buttons if necessary.
                    document.dispatchEvent(new CustomEvent("EDITOR__DELETE", {
                        detail: {
                            // See definition of type EditorDeletedEventInfo in editorEvents.ts.
                            editor: window.sbProps.editors[textareaId],
                            containingFormId:'lesson-plan-template-form',
                            submitButtons: [document.getElementById('save-button')]
                        }
                    }));

                    // We assume the deletion was successful, and now we remove the enclosing <li> too.
                    $(li).remove();

                    /* Mandate at least one field existing at all times
                     */
                    refreshDeletes();
                }
            });
        });

        /* Mandate at least one field existing at all times
         */
        refreshDeletes();

        /* Spawn multiple ckeditors for fields which already existed
         */
        document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
            detail: {
                maxCharCount: window.sbProps.MAX_BYTES_MYSQL_MEDIUMTEXT,
                targetElements: [
                    {% if lessonPlanTemplate is not null %}
                    {% for field in lessonPlanTemplate.fields %}
                    '#field-body-{{ field.id }}',
                    {% endfor %}
                    {% endif %}
                ]
            }
        }));
    });
</script>

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    {% if lessonPlanTemplate and lessonPlanTemplate.id %}
        {% set formAction = routeLookupIfAuthorized('adminLessonPlanTemplate.postUpdate', {lessonPlanTemplate: lessonPlanTemplate, lessonPlanTemplateId: lessonPlanTemplate.id}) %}
    {% else %}
        {% set formAction = routeLookupIfAuthorized('adminLessonPlanTemplate.postCreate') %}
    {% endif %}

    <div class="admin-content">
        <form id="lesson-plan-template-form" class="lesson-plan-template-form" action="{{ formAction }}" method="post">
            <div class="small-12 island">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="lesson-plan-template-title" class="required">Title</label>
                            {# This maxlength corresponds to the schema field length #}
                            <input type="text" id="lesson-plan-template-title" name="title" maxlength="255" value="{{ lessonPlanTemplate.title ?? ''}}" />
                        </div>
                    </fieldset>
                    <fieldset class="content">
                        <legend>Fields</legend>

                        <ul id="fields" class="information-list sortable ui-sortable lpt-fields" data-sortable data-list>
                            {% if lessonPlanTemplate is not null %}
                                {% for field in lessonPlanTemplate.fields %}
                                    {% if not field.isDeleted %}
                                        <li>
                                            <!-- See further down the file for why we use section here -->
                                            <section data-template-section>
                                                <div class="s-topbar" data-topbar>
                                                    <div class="grip ui-sortable-handle">
                                                    </div>
                                                    <div class="s-name-display" data-name-display>{{ field.title }}</div>
                                                    <nav>
                                                        <a class="button icon-delete" data-delete></a>
                                                    </nav>
                                                </div>
                                                <div class="s-field-contents">
                                                    <div>
                                                        <div class="s-title-row">
                                                            <div class="s-field-title">
                                                                <label for="field-title-{{ field.id }}" class="required">Field Title</label>
                                                                <input type="text" id="field-title-{{ field.id }}" name="field[{{ field.id }}][title]" data-field-title maxlength="255" value="{{ field.title }}" />
                                                            </div>
                                                            <div class="s-field-visibility">
                                                                <input type="hidden" name="field-visibility[{{ field.id }}]" value="off" />
                                                                <input id="field-new-visibility-{{ field.id }}" name="field[{{ field.id }}][visibility]" type="checkbox" {% if field.visibility == studentRole %}checked="checked"{% endif %}/>
                                                                <label for="field-new-visibility-{{ field.id }}" class="checkbox-label">Field visible to students</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <label for="field-body-{{ field.id }}">Body</label>
                                                        <textarea id="field-body-{{ field.id }}" name="field[{{ field.id }}][body]" rows="5">{{  field.body }}</textarea>
                                                    </div>
                                                </div>
                                            </section>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                {# Mandate at least one field per template to prevent people spawning unusable data
                                 # This reuses the ui to spawn one arbitrarily
                                 #}
                                <script>
                                    $(function() {
                                        $('#add-field').trigger('click');
                                    });
                                </script>
                            {% endif %}
                        </ul>

                        <div class="small-12 columns">
                            <a class='icon-add button full-width' id="add-field">Add a new field</a>
                        </div>
                    </fieldset>
                </section>
            </div>
            <div class="small-12 columns">
                <section>
                    <input id="save-button" type="submit" value="Save" />
                </section>
            </div>
        </form>
    </div>
</div>

<!--
    We use a section below avoid some weird inheritance rules cascading
    on div elements (coming from .information-list - we shouldn't be using
    inheritance selectors if a parent class isn't explicitly encapsulating
    the scope to the component we want it to appear in. Otherwise you get
    stuff leaking out when it ought to stay put instead.)
-->
<div id="field-blueprint" style="display:none">
    <section class="field-content" data-template-section>
        <div class="s-topbar" data-topbar>
            <div class="grip ui-sortable-handle"></div>
            <div class="s-name-display" data-name-display></div>
            <nav>
                <a class="button icon-delete" data-delete></a>
            </nav>
        </div>
        <div class="s-field-contents">
            <div>
                <div class="s-title-row">
                    <div class="s-field-title">
                        <label for="field-title" class="required">Field Title</label>
                        <input type="text" id="field-title" data-field-title maxlength="255" value="" />
                    </div>
                    <div class="s-field-visibility">
                        <input type="hidden" value="off" />
                        <input id="field-visibility" type="checkbox" checked="checked" />
                        <label for="field-visibility" class="checkbox-label">Field visible to students</label>
                    </div>
                </div>
            </div>
            <div>
                <label for="field-body">Body</label>
                <textarea id="field-body" rows="5"></textarea>
            </div>
        </div>
    </section>
</div>
