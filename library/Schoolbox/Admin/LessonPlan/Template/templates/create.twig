{##
 # Create Lesson Plan Templates
 #
 # @param LessonPlan/Template/Model $lessonPlanTemplate
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    {% if lessonPlanTemplate and lessonPlanTemplate.id %}
        {% set formAction = routeLookupIfAuthorized('adminLessonPlanTemplate.postUpdate', {lessonPlanTemplate: lessonPlanTemplate, lessonPlanTemplateId: lessonPlanTemplate.id}) %}
    {% else %}
        {% set formAction = routeLookupIfAuthorized('adminLessonPlanTemplate.postCreate') %}
    {% endif %}

    <div class="admin-content">
        <form id="lesson-plan-template-form" action="{{ formAction }}" method="post">
            <div class="small-12 island">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="lesson-plan-template-title" class="required">Title</label>
                            {# This maxlength corresponds to the schema field length #}
                            <input type="text" id="lesson-plan-template-title" name="title" maxlength="255" value="{{ lessonPlanTemplate.title ?? ''}}" />
                        </div>
                    </fieldset>
                    <fieldset class="content">
                        <legend>Fields</legend>

                        <ul id="fields" class="information-list lesson-plan-template-fields">
                            {% for field in lessonPlanTemplate.fields %}
                            <li>
                                <div>
                                    <label for="field-title-{{ field.id }}" class="required">Title</label>
                                    <input type="text" id="field-title-{{ field.id }}" maxlength="255" value="{{ field.title }}" />
                                </div>
                                <div>
                                    <label for="field-body-{{ field.id }}" class="required">Body</label>
                                    <textarea id="field-body-{{ field.id }}" rows="5">{{ field.body }}</textarea>
                                </div>
                                <div>
                                    <input type="hidden" value="off" />
                                    <input id="field-new-visibility" type="checkbox" />
                                    <label for="field-new-visibility" class="checkbox-label">Visible to students</label>
                                </div>
                            </li>
                            {% endfor %}
                        </ul>

                        <div class="small-12 columns">
                            <a class='icon-add button full-width' id="add-field">Add a new field</a>
                        </div>
                    </fieldset>
                </section>
            </div>
            <div class="small-12 columns">
                <section>
                    <input type="submit" value="Save" />
                </section>
            </div>
        </form>
    </div>
</div>

<div id="field-blueprint" style="display:none">
    <div>
        <label for="field-new-title" class="required">Title</label>
        <input type="text" id="field-new-title" maxlength="255" value="" />
    </div>
    <div>
        <label for="field-new-body" class="required">Body</label>
        <textarea id="field-new-body" rows="5"></textarea>
    </div>
    <div>
        <input type="hidden" value="off" />
        <input id="field-new-visibility" type="checkbox" />
        <label for="field-new-visibility" class="checkbox-label">Visible to students</label>
    </div>
</div>

<script>
    $(function() {
        $('#add-field').on('click', function() {
            /* Make a clone
             */
            let clone = $($('#field-blueprint').html());

            /* Update the ids and name attributes
             */
            let fieldCount = $('#fields').find('li').length + 1;

            let titleId = 'field-new-title-' + fieldCount;
            let titleName = 'field-new-title[' + fieldCount + ']';

            let bodyId = 'field-new-body-' + fieldCount;
            let bodyName = 'field-new-body[' + fieldCount + ']';

            let visibilityId = 'field-new-visibility-' + fieldCount;
            let visibilityName = 'field-new-visibility[' + fieldCount + ']';

            clone.find('input[id="field-new-title"]').attr('name', titleName);
            clone.find('input[id="field-new-title"]').attr('id', titleId);
            clone.find('label[for="field-new-title"]').attr('for', titleId);

            clone.find('textarea[id="field-new-body"]').attr('name', bodyName);
            clone.find('textarea[id="field-new-body"]').attr('id', bodyId);
            clone.find('label[for="field-new-body"]').attr('for', bodyId);

            clone.find('input[id="field-new-visibility"]').attr('name', visibilityName);
            clone.find('input[id="field-new-visibility"]').attr('id', visibilityId);
            clone.find('label[for="field-new-visibility"]').attr('for', visibilityId);

            /* Placeholder
             */
            clone.find('input[type="hidden"]').attr('name', visibilityName);

            /* Inject it into the stack
             */
            let li = $('<li></li>');
            li.append(clone);

            $('#fields').append(li);
        });
    });
</script>

<style type="text/css">
    .lesson-plan-template-fields li {
        list-style: none;
        border-bottom: 1px solid #ddd;
        padding: 1rem;
        margin-bottom: 1rem;
    }
</style>
