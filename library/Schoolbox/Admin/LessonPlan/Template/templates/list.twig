{##
 # List of Lesson Plan Templates
 #
 # @param GenericCollection $lessonPlanTemplates  A list of LessonPlan/Template/Model instances
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    {% set createRoute = routeLookupIfAuthorized('adminLessonPlanTemplate.getCreate') %}

    <div class="admin-content">
        {% if lessonPlanTemplates|length %}
            <div class="small-12 island">
                <div class="row actions-small-1">
                    <div class="list-item">
                        <div class="small-12 island">
                            <h2 class="subheader">{{ locale.lessonPlan.proper }} Template List</h2>
                        </div>
                    </div>
                    <nav>
                        <a href="{{ createRoute }}" class="icon-add" title="Add a {{ locale.lessonPlan }} template"></a>
                    </nav>
                </div>
                <section>
                    <ul class="information-list">
                        {% for lessonPlanTemplate in lessonPlanTemplates %}
                            {% set updateRoute = routeLookupIfAuthorized('adminLessonPlanTemplate.getUpdate', {lessonPlanTemplateId: lessonPlanTemplate.id}) %}

                            <li class="actions-small-3 {% if not lessonPlanTemplate.enabled %}faded{% endif %}">
                                <div class="list-item">
                                    <div class="card small-12">
                                        {# TODO Redo this <del> style properly. This isn't what a <del> tag is supposed to represent. #}
                                        {% if updateRoute %}
                                            <a data-reveal-id="lpt-preview-{{ lessonPlanTemplate.id }}">
                                                {% if lessonPlanTemplate.enabled %}
                                                    <h3>{{ lessonPlanTemplate.title }}</h3>
                                                {% else %}
                                                    <h3><del>{{ lessonPlanTemplate.title }}</del></h3>
                                                {% endif %}
                                            </a>
                                        {% else %}
                                            {% if lessonPlanTemplate.enabled %}
                                                <h3 data-reveal-id="lpt-preview-{{ lessonPlanTemplate.id }}">{{ lessonPlanTemplate.title }}</h3>
                                            {% else %}
                                                <h3><del>{{ lessonPlanTemplate.title }}</del></h3>
                                            {% endif %}
                                        {% endif %}
                                        <p class="meta">
                                            Last modified by
                                            {% if lessonPlanTemplate.updatedBy.deleted %}
                                                {{ lessonPlanTemplate.updatedBy.fullname }}
                                            {% else %}
                                                <a href="/search/user/{{ lessonPlanTemplate.updatedBy.id }}" title="{{ lessonPlanTemplate.updatedBy.fullname }}">{{ lessonPlanTemplate.updatedBy.fullname }}</a>
                                            {% endif %}

                                            on {{ lessonPlanTemplate.updatedAt.local }}
                                        </p>
                                    </div>
                                </div>
                                {% set enableRoute = routeLookupIfAuthorized('adminLessonPlanTemplate.postToggleEnableState', {lessonPlanTemplate: lessonPlanTemplate, lessonPlanTemplateId: lessonPlanTemplate.id}) %}
                                {% set deleteRoute = routeLookupIfAuthorized('adminLessonPlanTemplate.delete', {lessonPlanTemplate: lessonPlanTemplate, lessonPlanTemplateId: lessonPlanTemplate.id}) %}
                                <nav>
                                    {# Fudge some accessibility text here later, I guess #}
                                    {% if updateRoute %}
                                        <a class="icon-modify" href="{{ updateRoute }}" title="Modify"></a>
                                    {% endif %}

                                    {% if enableRoute or deleteRoute %}
                                    <sbx-pop-out content-id="lpt-{{ lessonPlanTemplate.id }}" data-test="sbx-pop-out-lpt-{{ lessonPlanTemplate.id }}"></sbx-pop-out>
                                    {% endif %}
                                </nav>
                                <ul class="f-dropdown" data-dropdown-content id="lpt-{{ lessonPlanTemplate.id }}" aria-hidden="true">
                                    {% if enableRoute %}
                                        {% if lessonPlanTemplate.enabled %}
                                            {% set icon = 'icon-view' %}
                                            {% set action = 'Disable visibility' %}
                                        {% else %}
                                            {% set icon = 'icon-view-hollow' %}
                                            {% set action = 'Enable visibility' %}
                                        {% endif %}
                                        <li><a class="{{ icon }}" href="{{ enableRoute }}" title="{{ action }}" data-toggle-enable-state="{{ lessonPlanTemplate.id }}">{{ action }}</a></li>
                                        <script>
                                            $(function() {
                                                $('#container').on('click', 'a[data-toggle-enable-state="{{ lessonPlanTemplate.id }}"]', function(event) {
                                                    let toast = $('#toast');

                                                    event.preventDefault();

                                                    /* Activate indicator label
                                                    */
                                                    toast.toastActivate({
                                                        text: "Changing enabled state..."
                                                    });

                                                    let element = $(this);

                                                    $.post(element.attr('href'), function() {
                                                    })
                                                    .done(function() {
                                                        toast.toastTimeout({
                                                            text: 'Saved',
                                                            css: 'success'
                                                        });

                                                        location.reload();
                                                    })
                                                    .fail(function(response) {
                                                    let temp = JSON.parse(response.responseText);

                                                        toast.toastTimeout({
                                                            text: 'Could not save: ' + temp.error,
                                                            css: 'alert'
                                                        });
                                                    });
                                                });
                                            });
                                        </script>
                                    {% endif %}
                                    {% if deleteRoute %}
                                        <script>
                                            $(function() {
                                                $('#container').on('click', 'a[data-delete="{{ lessonPlanTemplate.id }}"]', function(event) {
                                                    let toast = $('#toast');

                                                    event.preventDefault();

                                                    let element = $(this);

                                                    element.confirmDialog({
                                                        text: 'Are you sure you want to delete this {{ locale.lessonPlan }} template?',
                                                        confirmEvent: function() {
                                                            /* Activate indicator label
                                                            */
                                                            toast.toastActivate({
                                                                text: "Deleting..."
                                                            });
                                                            $.ajax(
                                                                {
                                                                    type: 'DELETE',
                                                                  url: element.attr('href'),
                                                                    success: function() {}
                                                                }
                                                            )
                                                            .done(function() {
                                                                toast.toastTimeout({
                                                                    text: 'Saved',
                                                                    css: 'success'
                                                                });

                                                                location.reload();
                                                            })
                                                            .fail(function(response) {
                                                            let temp = JSON.parse(response.responseText);

                                                                toast.toastTimeout({
                                                                    text: 'Could not save: ' + temp.error,
                                                                    css: 'alert'
                                                                });
                                                            });
                                                        }
                                                    });
                                                });
                                            });
                                        </script>
                                        <li><a class="icon-delete" href="{{ deleteRoute }}" title="Delete" data-delete="{{ lessonPlanTemplate.id }}">Delete template</a></li>
                                    {% endif %}
                                </ul>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            </div>
        {% else %}
            <div class="empty-state">
                <i class="icon-lesson-plan"></i>
                <p>No {{ locale.lessonPlan }} templates have been created.</p>
                {% if createRoute %}
                    <p><a href="{{ createRoute }}">Click here</a> to build a {{ locale.lessonPlan }} template.</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>

<div id='toast' class="toast" data-toast></div>

{# Preview Lesson Plan Templates
 # This is so you can see what they are without having to interpret 1000 ckeditor fields
 #}
{% include '@adminLessonPlanTemplate/preview.twig' with {lessonPlanTemplates: lessonPlanTemplates.all, hasActions: false} %}
