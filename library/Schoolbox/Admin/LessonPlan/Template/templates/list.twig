{##
 # List of Lesson Plan Templates
 #
 # @param GenericCollection $lessonPlanTemplates  A list of LessonPlan/Template/Model instances
#}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    {# {% set createRoute = routeLookupIfAuthorized('adminLessonPlanTemplate.getCreate') %}#}
    {% set createRoute = '#' %}

    <div class="admin-content">
        {% if lessonPlanTemplates|length %}
            <div class="small-12 island">
                <div class="row actions-small-1">
                    <div class="list-item">
                        <div class="small-12 island">
                            <h2 class="subheader">Lesson Plan Template List</h2>
                        </div>
                    </div>
                    <nav>
                        <a href="{{ createRoute }}" class="icon-add" title="Add a lesson plan template"></a>
                    </nav>
                </div>
                <section>
                    <ul class="information-list">
                        {% for lessonPlanTemplate in lessonPlanTemplates %}
                            {#  {% set updateRoute = routeLookupIfAuthorized('adminSummativeReport.getUpdate', {reportId: report.id}) %}#}
                            {% set updateRoute = '#' %}

                            <li class="actions-small-3">
                                <div class="list-item">
                                    <div class="card small-12">
                                        {% if updateRoute %}
                                            <a href="{{ updateRoute }}">
                                                <h3>{{ lessonPlanTemplate.title }}</h3>
                                            </a>
                                        {% else %}
                                            <h3>{{ lessonPlanTemplate.title }}</h3>
                                        {% endif %}
                                        <p class="meta">
                                            Last modified by
                                            {% if lessonPlanTemplate.updatedBy.deleted %}
                                                {{ lessonPlanTemplate.updatedBy.fullname }}
                                            {% else %}
                                                <a href="/search/user/{{ lessonPlanTemplate.updatedBy.id }}" title="{{ lessonPlanTemplate.updatedBy.fullname }}">{{ lessonPlanTemplate.updatedBy.fullname }}</a>
                                            {% endif %}

                                            on {{ lessonPlanTemplate.updatedAt.local }}
                                        </p>
                                    </div>
                                </div>
                                <nav>
                                    {% if updateRoute %}
                                        <a class="icon-modify" href="{{ updateRoute }}" title="Modify"></a>
                                    {% endif %}

                                    {# {% set deleteRoute = routeLookupIfAuthorized('adminLessonPlanTemplate.postDelete', {lessonPlanTemplate: lessonPlanTemplate, lessonPlanTemplateId: lessonPlanTemplate.id}) %}#}
                                    {% set deleteRoute = '#' %}
                                    {% if deleteRoute %}
                                        <script>
                                            $(function() {
                                                let toast = $('#toast');

                                                $('#container').on('click', 'a[data-delete="{{ lessonPlanTemplate.id }}"]', function(event) {
                                                    event.preventDefault();

                                                    /* Activate indicator label
                                                     */
                                                    toast.toastActivate({
                                                        text: "Deleting..."
                                                    });

                                                    let element = $(this);

                                                    element.confirmDialog({
                                                        text: 'Are you sure you want to delete this lesson plan template?',
                                                        confirmEvent: function() {
                                                            $.post(element.attr('href'), function() {
                                                            })
                                                            .done(function() {
                                                                toast.toastTimeout({
                                                                    text: 'Saved',
                                                                    css: 'success'
                                                                });

                                                                location.reload();
                                                            })
                                                            .fail(function(response) {
                                                                let temp = $.parseJSON(response.responseText);

                                                                toast.toastTimeout({
                                                                    text: 'Could not save: ' + temp.error,
                                                                    css: 'alert'
                                                                });
                                                            });
                                                        }
                                                    });
                                                });
                                            });
                                        </script>
                                        <a class="icon-delete" href="{{ deleteRoute }}" title="Delete" data-delete="{{ lessonPlanTemplate.id }}"></a>
                                    {% endif %}
                                </nav>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            </div>
        {% else %}
            <div class="empty-state">
                <i class="icon-progress"></i>
                <p>No lesson plan templates have been created.</p>
                {% if createRoute %}
                    <p><a href="{{ createRoute }}">Click here</a> to build a lesson plan template.</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>

<div id='toast' class="toast" data-toast></div>
