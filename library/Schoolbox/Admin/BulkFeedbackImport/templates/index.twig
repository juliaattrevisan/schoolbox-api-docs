{##
 # Bulk Feedback Import configuration
 #
 # @param string $pageCurrent    The current page we're on
 # @param array $allBreadcrumbs  A set of breadcrumb nodes, as defined by Admin Subnav
 # @param Collection $worktypes  A list of Work Type instances, ordered by sequence
 #}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>

<script>
    $(function() {
        let bulkFeedbackImportForm = $('#bulkFeedbackImport');

        bulkFeedbackImportForm.find('input[data-selectizeuser]')
            .userSelectizeSelector({
                ajax: {
                    data: {roleTypeID: '{{ roletypeStaff }}'},
                }
            });

        bulkFeedbackImportForm.alaressValidate({
            rules: {
                'userId': {
                    'required': true
                },
                'assessmentTitle': {
                    'required': true
                },
                "sourceFile-file": {
                    required: {
                        depends: function () {
                            return document.getElementById("sourceFile-zone").querySelector("[data-dz-previews]").children.length === 0;
                        },
                    },
                },
            },
            messages: {
                'userId': {
                    'required': 'You must specify a feedback author before you can proceed'
                },
                "sourceFile-file-file": "Please attach a csv file",
            },
        });

        // Remove the error message when a worksheet file is uploaded
        $('#sourceFile-zone').on('success.attachzone', () => {
            $('#sourceFile-file-error').remove();
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <section>
                <div class="content">
                    <p>To bulk import feedback (normalised marks and/or comments) to existing {{ locale.dueWork.proper }} items follow these steps:</p>

                    <ol>
                        <li>Insert the exact {{ locale.dueWork.proper }} Title as it currently exists on all the {{ locale.class }} pages. The title must be unique for the import to work.</li>
                        <li>Select the Work Type for the {{ locale.dueWork.proper }} item. The Work Type must be the same one as used on all the {{ locale.dueWork.proper }} pages listed on the CSV.</li>
                        <li>Select a Feedback Author. This will determine who has given the feedback.</li>
                        <li>Download and edit the provided template CSV file.</li>
                        <li>
                            Add compulsory data to the CSV for:
                            <ol>
                                <li><strong>{{ locale.class.proper }} Code(s):</strong> Feedback will only be imported to {{ locale.class.plural }} where the data on the CSV matches that on a homepage within Schoolbox. If a homepage utilises multiple class codes, a match will occur on any of the class codes on the homepage.</li>
                                <li><strong>Student External ID:</strong> This value will come from the Student Information System, but can be found on the user profile in Schoolbox.</li>
                            </ol>
                        </li>
                        <li>
                            Add feedback to the CSV for either or both the:
                            <ol>
                                <li><strong>Normalised Mark:</strong> This must use a value between 0 and 100. If the mark type is set to 'Total Mark' or 'Letter Grade', Schoolbox will convert the grade on uploading the file. Leave this blank if using the mark type 'None'.</li>
                                <li><strong>Comment:</strong> This will appear as written feedback and can be left blank if not wanting to add a comment. Comments within the CSV utilising commas, line breaks and quotation marks should be added using the RFC 4180 standard.</li>
                            </ol>
                        </li>
                        <li>Upload the CSV file.</li>
                        <li>Select Preview.</li>
                    <ol>
                </div>
                <div class="component-action">
                    <section>
                        <a href="{{ CDN_PREFIX }}/adminv2/bulk-feedback-import/bulkFeedbackImportTemplate.csv" class="button">Download Template</a>
                    </section>
                </div>
            </section>
        </div>
        <div class="small-12 island">
            {% set formRoute = routeLookupIfAuthorized('adminBulkFeedbackImport.postPreview') %}

            <form action="{{ formRoute }}" method="post" id="bulkFeedbackImport">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="assessmentTitle" class="required">{{ locale.dueWork.proper }} Title</label>
                            <input id="assessmentTitle" type="text" name="assessmentTitle" value='' />
                        </div>

                        <div class="small-12 columns">
                            <label for="worktype" class="required">Work Type</label>

                            <select id="worktype" name="worktypeId">
                                {% for worktype in worktypes %}
                                    <option value="{{ worktype.id }}">{{ worktype.name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="small-12 columns">
                            <label for="userId" class="required">Feedback Author</label>
                            <input id="userId" data-selectizeuser type="text" name="userId" placeholder="Search Users">
                        </div>

                        <div class="small-12 columns">
                            <label class="required">Source File</label>
                            {% include 'sub/attachzone.twig' with { attachzone: sourceFileZone } %}
                            <input type="hidden" name="sourceFile-file" id="sourceFile-file" />
                        </div>
                    </fieldset>
                </section>

                <input type="submit" value="Preview" />
            </form>
        </div>
    </div>
</div>
