{##
 # List of Editor Templates
 #
 # @param GenericCollection $categories  The categories to display
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    {# {% set createRoute = routeLookupIfAuthorized('adminLessonPlanTemplate.getCreate') %} #}
    <div class="admin-content">
        <div id="editor-templates-container">
            <editor-templates
                :categories="{{ (categories ?? []) | json_encode }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/editorTemplates.js?v={{ config.site_version }}"></script>
    </div>
</div>
