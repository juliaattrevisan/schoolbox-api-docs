{##
 # List of Editor Templates
 #
 # @param GenericCollection $categories  The categories to display
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        {% set templatesEndpoint = routeLookup('editorTemplates.getTemplates') %}
        {% set createTemplateEndpoint = routeLookup('adminEditorTemplates.getCreate') %}
        {% set updateTemplateEndpoint = routeLookup('adminEditorTemplates.getUpdate') %}
        {% set deleteTemplateEndpoint = routeLookup('adminEditorTemplates.delete') %}
        <div id="editor-templates-container">
            <editor-templates
                :categories="{{ (categories ?? []) | json_encode }}"
                templates-endpoint="{{ templatesEndpoint ?? ''}}"
                create-template-endpoint="{{ createTemplateEndpoint ?? '' }}"
                update-template-endpoint="{{ updateTemplateEndpoint ?? '' }}"
                delete-template-endpoint="{{ deleteTemplateEndpoint ?? '' }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/editorTemplates.js?v={{ config.site_version }}"></script>
    </div>
</div>
