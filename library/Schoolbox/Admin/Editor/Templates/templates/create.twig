{##
 # Create Editor Templates
 #
 # @param Model $category The category to create the template in
 # @param Editor/Templates/Model $template The current template being edited
 #}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            {% set formAction = routeLookupIfAuthorized('adminEditorTemplates.postCreate', {categoryId: category.id}) %}
            <form id="editor-template-form" action="{{ formAction }}" method="post">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="template-title" class="required">Title</label>
                            {# This maxlength corresponds to the schema field length #}
                            <input type="text" id="template-title" name="title" maxlength="255" value="{{ template.title ?? ''}}" />
                        </div>
                        <div class="small-12 columns">
                            <label for="template-description">Description <span data-tooltip class="hint has-tip tip-top" data-width="200" title="To provide more context about what the template should be used for.">?</span></label>
                            {# This maxlength corresponds to the schema field length #}
                            <input type="text" id="template-description" name="description" maxlength="255" value="{{ template.description ?? ''}}" />
                        </div>
                        <div class="small-12 columns">
                            <label for="template-body" class="required">Body</label>
                            <textarea id="template-body" name="body" rows="5">{{ template.body ?? '' }}</textarea>
                        </div>
                    </fieldset>
                </section>
                <input type="submit" value="Save">
            </form>
        </div><!-- small-12 island -->
    </div><!-- admin-content -->
</div><!-- admin-container -->

<script src="{{ CDN_PREFIX }}/js/bundle/editor.js?v={{ config.site_version }}"></script>
<script>

/**
 * Initialise the body editor
 */
document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
    detail: {
        targetElements: ['#template-body']
    }
}));

$(function() {
    /**
     * Ensure title and body are not blank
     */
    $('#editor-template-form').alaressValidate({
        rules: {
            title: {
                requiredNotBlank: true
            },
            body: {
                requiredNotBlank: true
            }
        }
    });
});

</script>
