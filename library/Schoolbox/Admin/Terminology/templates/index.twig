{##
 # Terminology (localisation of specific words in schoolbox)
 #
 # You can choose how each schoolbox concept will be represented in the front end
 # in accordance with each school's preferred words/language.
 #
 # @param array terms  (not to be confused with school terms like semesters etc)
 #}

{# Shared navigation menu #}
{{ renderAdminNavigation(pageCurrent) }}

<script>
    $(function() {
        $('#terminology-form').alaressValidate();
    });
</script>

{# show each term #}
<div class="row">
    <div class="small-12 column">
        <h2 class="subheader">Terminology</h2>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <form id="terminology-form" method="post" action="{{ routeLookup('adminTerminology.postUpdateTerms') }}">
            <section>
                <ul class="information-list gridded-inputs">
                    <li>
                        <div class="list-item">
                            <div class="small-3 column"><h3>Term</h3></div>
                            <div class="small-3 column"><h3>Singular Form</h3></div>
                            <div class="small-3 column"><h3>Plural Form</h3></div>
                            <div class="small-1 column"><h3>Indefinite Article</h3></div>
                            <div class="small-2 column"><h3>Capitalisation<span data-tooltip class="hint has-tip tip-left" data-width="200" title="Determines if the first letter can be capitalised">?</span></h3></div>
                        </div>
                    </li>
                    {% for term in terms %}
                        <li>
                            <div>
                                <div class="small-3 column">
                                    {{ term.title }}
                                </div>
                                <div class="small-3 column">
                                    <input required type="text" name="singularForm[{{ term.term }}]" value="{{ term.singularForm }}">
                                </div>
                                <div class="small-3 column">
                                    <input required type="text" name="pluralForm[{{ term.term }}]" value="{{ term.pluralForm }}">
                                </div>
                                <div class="small-1 column">
                                    <input required type="text" name="indefiniteArticle[{{ term.term }}]" value="{{ term.indefiniteArticle }}">
                                </div>
                                <div class="small-2 column">
                                    <div class="switch round">
                                        <input id="capitaliseFirst-{{ term.term }}" name="capitaliseFirst[{{ term.term }}]" type="checkbox" {% if term.capitaliseFirst %}checked{% endif %} data-checkbox-group="capitaliseFirst-{{ term.term }}">
                                        <label for="capitaliseFirst-{{ term.term }}">
                                            <span>Yes</span>
                                            <span>No</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
            <input type="submit" value="Save">
        </form>
    </div>
</div>
