{# Shared navigation menu #}
{{ renderAdminNavigation(pageCurrent) }}

{# Friendly names for terms #}
{% set termNames = {
    'calendar': 'Calendar (Calendars)',
    'news': 'News',
    'resource': 'Resource (Resources)',
    'rubricCriterion': 'Rubrics: Indicator (Indicators)',
    'rubricGroup': 'Rubrics: Capability (Capabilities)',
    'rubricLevel': 'Rubrics: Level (Levels)',
    'specialNeeds': 'Special Needs'
} %}

{# show each term #}
<div class="row">
    <div class="small-12 island">
        <form method="post" action="{{ routeLookup('adminTerminology.postUpdateTerms') }}">
            <section>
                <ul class="information-list sortable ui-sortable" data-sortable="" data-list="">
                    <li class="show-for-medium-up no-border">
                        <div class="list-item">
                            <div class="small-12 medium-5 columns"><h3>Term</h3></div>
                            <div class="small-12 medium-3 columns"><h3>Singular Form</h3></div>
                            <div class="small-12 medium-3 columns"><h3>Plural Form</h3></div>
                            <div class="small-12 medium-1 columns"><h3>Capitalize</h3></div>
                        </div>
                    </li>
                    {% for term in terms %}
                        <li class="no-border">
                            <div>
                                <div class="small-12 column hide-for-medium-up"><label>Name</label></div>
                                <div class="small-12 medium-5 column">
                                    {{ termNames[term.term] }}
                                </div>
                                <div class="small-12 column hide-for-medium-up"><label>Singular Form</label></div>
                                <div class="small-12 medium-3 column">
                                    <input required type="text" name="singularForm[{{ term.term }}]" value="{{ term.singularForm }}">
                                </div>
                                <div class="small-12 column hide-for-medium-up"><label>Plural Form</label></div>
                                <div class="small-12 medium-3 column">
                                    <input required type="text" name="pluralForm[{{ term.term }}]" value="{{ term.pluralForm }}">
                                </div>
                                <div class="small-12 column hide-for-medium-up"><label>Capitalize First</label></div>
                                <div class="small-12 medium-1 column">
                                    <div class="switch round">
                                        <input id="capitaliseFirst-{{ term.term }}" name="capitaliseFirst[{{ term.term }}]" type="checkbox" {% if term.capitaliseFirst %}checked{% endif %} data-checkbox-group="capitaliseFirst-{{ term.term }}">
                                        <label for="capitaliseFirst-{{ term.term }}">
                                            <span>Yes</span>
                                            <span>No</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
            <input type="submit" value="Save">
        </form>
    </div>
</div>
