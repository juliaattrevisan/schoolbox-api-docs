{# Shared navigation menu #}
{{ renderAdminNavigation(pageCurrent) }}

{# show each term #}
<div class="row">
    <div class="small-12 island">
        <form method="post" action="{{ routeLookup('adminTerminology.postUpdateTerms') }}">
            <section>
                <ul class="information-list sortable ui-sortable" data-sortable="" data-list="">
                    <li class="no-border">
                        <div class="list-item">
                            <div class="small-3 columns"><h3>Term</h3></div>
                            <div class="small-3 columns"><h3>Singular Form</h3></div>
                            <div class="small-3 columns"><h3>Plural Form</h3></div>
                            <div class="small-1 columns"><h3>Indefinite Article</h3></div>
                            <div class="small-2 columns"><h3>Capitalisation<span data-tooltip class="hint has-tip tip-top" data-width="200" title="Determines if the first letter can be capitalised">?</span></h3></div>                       </div>
                    </li>
                    {% for term in terms %}
                        <li class="no-border">
                            <div>
                                <div class="small-3 column">
                                    {{ term.title }}
                                </div>
                                <div class="small-3 column">
                                    <input required type="text" name="singularForm[{{ term.term }}]" value="{{ term.singularForm }}">
                                </div>
                                <div class="small-3 column">
                                    <input required type="text" name="pluralForm[{{ term.term }}]" value="{{ term.pluralForm }}">
                                </div>
                                <div class="small-1 column">
                                    <input required type="text" name="indefiniteArticle[{{ term.term }}]" value="{{ term.indefiniteArticle }}">
                                </div>
                                <div class="small-2 column">
                                    <div class="switch round">
                                        <input id="capitaliseFirst-{{ term.term }}" name="capitaliseFirst[{{ term.term }}]" type="checkbox" {% if term.capitaliseFirst %}checked{% endif %} data-checkbox-group="capitaliseFirst-{{ term.term }}">
                                        <label for="capitaliseFirst-{{ term.term }}">
                                            <span>Yes</span>
                                            <span>No</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
            <input type="submit" value="Save">
        </form>
    </div>
</div>
