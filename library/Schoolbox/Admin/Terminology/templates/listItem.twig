<li class="actions-small-2" data-term>
    <div class="list-item">
        <div class="card small-12" data-term-infocard>
            <h3>
                {{ term.term }}
            </h3>
            <p class="meta">
                {{ term.singularForm}}/{{ term.pluralForm }}
            </p>
            {% if term.capitaliseFirst %}
            <p class="meta">
                <span class="gradient-0">Capitalise First Letter</span>
            </p>
            {% endif %}
        </div>
    </div>
    <div class="small-12 column hide" data-collapse-state="collapsed" data-collapsable="term-{{ term.term }}">
        {% include '@adminTerminology/form.twig' with {term: term} %}
    </div>
    <nav>
        <a href="#" class="icon-down-arrow" data-collapser="term-{{ term.term }}"></a>
    </nav>
</li>
