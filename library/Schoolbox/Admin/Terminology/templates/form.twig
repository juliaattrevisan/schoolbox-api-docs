{% set saveValue = 'Update Term' %}

<form method="post" action="{{ routeLookup('adminTerminology.postUpdateTerm') }}" class="row" data-term-form="update">
    <input type="hidden" name="term" value="{{ term.term }}">
    <div data-mage-wrapper>
        <div class="small-6 columns">
            <label>
                Singular Form
                <input required type="text" name="singularForm" value="{{ term.singularForm }}">
            </label>
        </div>
        <div class="small-6 columns">
            <label>
                Plural Form
                <input required type="text" name="pluralForm" value="{{ term.pluralForm }}">
            </label>
        </div>
        <div class="small-6 columns">
            <label>
                Capitalise First Letter
                <div class="switch round">
                    <input id="capitaliseFirst-{{ term.term }}" name="capitaliseFirst" type="checkbox" {% if term.capitaliseFirst %}checked{% endif %} data-checkbox-group="capitaliseFirst-{{ term.term }}">
                    <label for="capitaliseFirst-{{ term.term }}">
                        <span>Yes</span>
                        <span>No</span>
                    </label>
                </div>
            </label>
        </div>
        <div class="small-6 columns">
        </div>
        <input type="submit" class="expand" value="{{ saveValue }}" data-mage-working="Saving..." data-mage-reset="{{ saveValue }}" />
        <!-- Don't delete the inline style, it's needed -->
        <p data-mage-error style="display:none;" class="alert alert-box icon-alert"></p>
        <p data-mage-custom-error class="hide alert alert-box icon-alert"></p>
    </div>
</form>