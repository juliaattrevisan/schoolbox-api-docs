<style>
div.create-new-button-container-div
{
    text-align: right;
}

div.result-set-row-div
{
}

span.result-rubric-label-span
{
    display: inline-block;
    padding: 0.5rem;
    background-color: lightgrey;
    margin-right: 0.2rem;
    vertical-align: bottom;
}

span.buttons-container-span
{
    display: inline-block;
    float: right;
}

span.buttons-container-span > a
{
    background-color: white;
}

div.clear-floats
{
    clear: both;
}
</style>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}
<div class="admin-container row">
    {{ renderAdminNavigation(pageCurrent) }}
    <div class="admin-content">
        <!-- Main content section starts here. -->
        <div class="row">
            <div class="small-12 island">
                <section>
                    <header class="list-header actions-small-0">
                    </header>
                    <div class="small-12 medium-12 column">
                        <p>
                            Edit rubric result set templates here.
                        </p>
                        <p>
                            Each set should be a discrete list of items of a single measurement;
                            for example, 'Very Good' and 'Yes' should not be in the same set.
                        </p>
                        <p>
                            Deleting or modifying a result set here will not affect any previous use of that result set elsewhere in Schoolbox.
                            This is because the result sets here are just templates that are copied to create new result sets on rubrics.
                        </p>
                    </div>
                <section>
            </div>
        </div>
        <div class="row">
            <div class="small-12 island">
                <div class="create-new-button-container-div">
                    <a class='button icon-add' href="/adminv2/rubric-results-set/create">Create new result set</a>
                </div>
                <section>
                    <header class="list-header actions-small-0">
                        <div class="list-item">
                            <div class="medium-12 column">Result Set</div>
                        </div>
                    </header>
                    <ul class="information-list unsortable">
                        {% for resultSetId, rubrics in rubricsByResultSetId %}
                            <li>
                                <div class="actions-small-0">
                                    <div class="list-item">
                                        <div class="small-12 medium-12 column">
                                            <label>
                                                {% for rubric in rubrics %}
                                                    <span class="result-rubric-label-span">
                                                        {{ rubric.label|purify }}
                                                    </span>
                                                {% endfor %}
                                                <span class="buttons-container-span">
                                                    <a class="button icon-modify" href="/adminv2/rubric-results-set/{{ resultSetId }}"></a>
                                                    <a class="button icon-delete" href="/adminv2/rubric-results-sets/delete/{{ resultSetId }}"></a>
                                                </span>
                                                <div class="clear-floats"></div>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            </div>
        </div>
        <!-- Main content section ends here. -->
    </div>
</div>
