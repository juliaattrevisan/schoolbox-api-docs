<style>
span.result-set-comma-separated-container
{
    display: inline-block;
    width: 90%;
}

button.create-new-result-set-button
{
   float: right;
}

div.clear-floats
{
    clear: both;
    margin-bottom: 5px;
}
</style>
{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <section class="content">
                <div class="row">
                    <div class="small-12 columns">
                        <h3>Creating Rubric Results</h3>
                    </div>
                    <div class="small-12 large-12 columns">
                        <p>
                            Edit the rubric result sets here: these are the pre-populated default values that will appear on every rubric.
                        </p>
                        <p>
                            Each set should be a discrete list of items of a single measurement;
                            for example, 'Very Good' and 'Yes' should not be in the same set.
                        </p>
                        <p>
                            Deleting a result set here will not affect any previous use of that result set in rubrics elsewhere in Schoolbox.
                            This is because the result sets here are just templates that are copied to create new result sets on rubrics.
                        </p>
                    </div>
                </div>
            </section>
        </div>
        <div class="small-12 island">
            <div data-role="rubricList">
                <div>
                    <button class='create-new-result-set-button icon-add' onclick="document.location.href='/adminv2/rubric-results/-1';">Create new result set</button>
                    <h3>Result Sets</h3>
                    <div class="clear-floats"></div>
                </div>
                {% set currentResultSetId = null %}
                {% for resultSetId, rubrics in rubricsByResultSetId %}
                    <section class="content">
                        <div data-role="rubricSet" data-setNumber="{{ resultSetId }}">
                            <span class="result-set-comma-separated-container">
                            {% for rubric in rubrics %}
                                {{ rubric.label|purify }}{% if loop.index != loop.last %},{% endif %}
                            {% endfor %}
                            </span>
                            <a href="/adminv2/rubric-results/{{ resultSetId }}">Edit</a> |
                            <a href="/adminv2/rubric-results/delete/{{ resultSetId }}" onclick="return confirm('Do you really want to delete this result set?')">Delete</a>
                        </div>
                    </section>
                    {% set currentResultSetId = resultSetId %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
