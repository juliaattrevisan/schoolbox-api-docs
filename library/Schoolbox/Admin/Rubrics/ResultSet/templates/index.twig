<style>
    span.result-set-comma-separated-container
    {
        display: inline-block;
        width: 90%;
    }

    div.plus-button-container-div
    {
        text-align: right;
    }
</style>
<script>
/**
 * When the plus button is clicked, we add a new row to the form.
 */
function onClickPlusButton()
{
    let rowsContainerDiv = document.getElementById('rowsContainerDiv');
    let newRowValue      = getHighestRowNumberOnPage(true) + 1;
    let newRowHtml       = (
        // NOTE: The newlines at the end of each line below are important for styling.
        //       The HTML here must match the HTML used in the inner-loop of the twig template.
        "<div id='row-div-" + newRowValue + "' data-role='newRow'>\n" +
            "<label>\n" +
                "<span class='rubric-value-span' data-role='newRowValue'>" + newRowValue + "</span>\n" +
                "<input class='rubric-wide-input' type='text' name='row-" + newRowValue + "-label' maxlength='64' required/>\n" +
                "<a onclick='onClickDeleteRow(" + newRowValue + ")'>Delete</a>\n" +
            "</label>\n" +
        "</div>\n"
    );

    rowsContainerDiv.innerHTML += newRowHtml;
    enableSaveButton();
}

/**
 * When the delete button is clicked on a new row, we remove the new row from the form.
 * We also must update the numbers on the left of the new form rows so there are no gaps.
 */
function onClickDeleteRow(rowValue)
{
    let rowDiv = document.getElementById('row-div-' + rowValue);
    rowDiv.remove();

    renumberNewRows();
    enableSaveButton();
}

/**
 * Find the highest number from the non-new rows, then update the numbers on the new rows
 * so that the number of each row is one more than the number on the row directly above.
 */
function renumberNewRows()
{
    let spans    = document.getElementsByClassName('rubric-value-span');
    let newValue = getHighestRowNumberOnPage(false);

    for (let i = 0; i < spans.length; ++i) {
        let span     = spans[i];

        if (span.getAttribute('data-role') !== 'newRowValue') {
            continue;
        }

        span.innerHTML = ++newValue;

        // Must also rename the text input.
        var labelTextInput = span.nextElementSibling;
        labelTextInput.setAttribute('name', 'row-' + newValue + '-label');
    }
}

/**
 * Find the highest number from all rows on the page.
 *
 * @param boolIncludeNewRows
 *    Set to false to exclude the row numbers.
 */
function getHighestRowNumberOnPage(boolIncludeNewRows)
{
    let spans    = document.getElementsByClassName('rubric-value-span');
    let maxValue = 0;

    for (let i = 0; i < spans.length; ++i) {
        let span = spans[i];

        if (!boolIncludeNewRows && span.getAttribute('data-role') === 'newRowValue') {
            continue;
        }

        let spanValue = Number(span.innerHTML);

        if (spanValue > maxValue) {
            maxValue = spanValue;
        }
    }

    return maxValue;
}

function enableSaveButton()
{
    document.getElementById('save-button').disabled = false;
}
</script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}
<div class="admin-container row">
    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}
    <div class="admin-content">
        <div><a href="/adminv2/rubric-results/">Back to Rubrics Result Sets</a></div>
        <div class="small-12 island">
            <section class="content">
                <div class="row">
                    <div class="small-12 columns">
                        <h3>Creating Rubric Results</h3>
                    </div>
                    <div class="small-12 large-12 columns">
                        <p>
                            Edit the rubric result set here.
                            These are the pre-populated default values that will appear when creating a rubric.
                        </p>
                        <p>
                            Each set should be a discrete list of items of a single measurement;
                            for example, 'Very Good' and 'Yes' should not be in the same set.
                        </p>
                        <p>The first element is always valued zero, and sets must contain at least two elements.</p>
                    </div>
                </div>
            </section>
        </div>
        <div class="small-12 island">
            <form data-action="saveRubricResultRows" method="POST" name="rubricResultRows" action="/adminv2/rubric-results/{{ resultSetId }}">
                <div id="rowsContainerDiv">
                    {% for row in rubricResultRows %}
                        <div id="row-div-{{ row.value|purify }}">
                            <label>
                                <span class="rubric-value-span" data-role="value">{{ row.value|purify }}</span>
                                <input class="rubric-wide-input" type="text" name="row-{{ row.value|purify }}-label" value="{{ row.label|purify }}" onkeyup="enableSaveButton()" maxlength="64" required/>
                                <a onclick='onClickDeleteRow({{  row.value|purify }})'>Delete</a>
                            </label>
                        </div>
                    {% endfor %}
                </div>
                <div class="plus-button-container-div">
                    <button onclick="onClickPlusButton()">+</button>
                </div>
                <input id='save-button' disabled='disabled' type="submit" value="Save Changes"/>
            </form>
        </div>
    </div>
</div>
