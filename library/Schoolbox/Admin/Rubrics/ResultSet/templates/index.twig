<style>
    span.result-set-comma-separated-container
    {
        display: inline-block;
        width: 90%;
    }

    div#plusButtonContainerDiv
    {
        text-align: right;
    }
</style>
<script>
/**
 * When the plus button is clicked, we add a new row to the form.
 */
function onClickPlusButton()
{
    let rowsContainerDiv = document.getElementById('rowsContainerDiv');
    let newRowValue      = getHighestRowNumberOnPage(true) + 1;
    let newRowHtml       = (
        "<div id='new-row-div-" + newRowValue + "' data-role='newRow'>" +
            "<label>" +
                "<span class='rubric-value-span' data-role='newRowValue'>" + newRowValue + "</span> " + // Whitespace at end of line is important.
                "<input type='hidden' name='new-row-" + newRowValue + "-value' value='" + newRowValue + "'/>" +
                "<input class='rubric-wide-input' type='text' name='new-row-" + newRowValue + "-label' maxlength='64' value=''/> " + // Whitespace at end of line is important.
                "<a onclick='onClickDeleteNewRow(" + newRowValue + ")'>Delete</a>" +
            "</label>" +
        "</div>"
    );

    rowsContainerDiv.innerHTML += newRowHtml;
}

/**
 * When the delete button is clicked on a new row, we remove the new row from the form.
 * We also must update the numbers on the left of the new form rows so there are no gaps.
 */
function onClickDeleteNewRow(newRowValue)
{
    let newRowDiv = document.getElementById('new-row-div-' + newRowValue);
    newRowDiv.remove();

    renumberNewRows();
}

/**
 * Find the highest number from the non-new rows, then update the numbers on the new rows
 * so that the number of each row is one more than the number on the row directly above.
 */
function renumberNewRows()
{
    let maxValue = getHighestRowNumberOnPage(false);
    let spans    = document.getElementsByClassName('rubric-value-span');

    for (let i = 0; i < spans.length; ++i) {
        let span = spans[i];

        if (span.getAttribute('data-role') != 'newRowValue') {
            continue;
        }

        span.innerHTML = ++maxValue;
    }
}

/**
 * Find the highest number from all rows on the page.
 *
 * @param boolIncludeNewRows
 *    Set to false to exclude the new-row numbers.
 */
function getHighestRowNumberOnPage(boolIncludeNewRows)
{
    let spans    = document.getElementsByClassName('rubric-value-span');
    let maxValue = 0;

    for (let i = 0; i < spans.length; ++i) {
        let span = spans[i];

        if (!boolIncludeNewRows && span.getAttribute('data-role') == 'newRowValue') {
            continue;
        }

        let spanValue = Number(span.innerHTML);

            if (spanValue > maxValue) {
            maxValue = spanValue;
        }
    }

    return maxValue;
}
</script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <section class="content">
                <div class="row">
                    <div class="small-12 columns">
                        <h3>Creating Rubric Results</h3>
                    </div>
                    <div class="small-12 large-12 columns">
                        <p>
                            Edit the rubric result set here.  These are the pre-populated default values that will appear when creating a rubric.
                        </p>
                        <p>
                            Each set should be a discrete list of items of a single measurement;
                            for example, 'Very Good' and 'Yes' should not be in the same set.
                        </p>
                        <p>The first element is always valued zero, and sets must contain at least two elements.</p>
                    </div>
                </div>
            </section>
        </div>
        <div class="small-12 island">
<!--            <form data-action="saveRubricResultRows" method="POST" action="{{ routeLookupIfAuthorized('adminRubric.saveRubricResults') }}">-->
                <input type="hidden" name="resultSetId" value="{{ resultSetId }}"/>

                <div id="rowsContainerDiv">
                    <h3>Existing Set</h3>
                    {% set currentRow = null %}
                    {% for row in rubricResultRows %}
                        <div data-role="existingRubricResult" data-resultNumber="{{ row.value|purify }}">
                            <label>
                                <span class="rubric-value-span" data-role="value">{{ row.value|purify }}</span>
                                <input class="rubric-wide-input" type="text" name="items[{{ row.resultset_id }}][{{ row.value|purify }}]" value="{{ row.label|purify }}" maxlength="64" required />
                                <a href="/adminv2/rubric-results/{{ resultSetId }}/delete">Delete</a>
                            </label>
                        </div>
                        {% set currentRow = row%}
                    {% endfor %}
                </div>
                <div id="plusButtonContainerDiv">
                    <button onclick="onClickPlusButton()">+</button>
                </div>

            <input type="submit" value="Save Changes" />
<!--            </form>-->
        </div>
    </div>
</div>
