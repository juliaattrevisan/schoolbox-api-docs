{##
 # Veracross SUDS Configuration fragment
 #
 # A list of dsn pieces for this suds connector are provided by their key names already
 # via the include of this template
 #
 # @param string|null $schoolRoute   An authentication string for school route
 # @param string|null $clientId      An authentication string for client identifier
 # @param string|null $clientSecret  An authentication string for client secret
 # @param string|null $region        A string telling you which region was chosen by the user
 # @param array|null $_domains       A lookup of (key, value) tuples corresponding to various domains that could be chosen
 #}
<div data-data-source="veracross" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>Veracross Configuration</h3>

                <div class="row">
                    <div class="small-12 columns">
                        <label class="required" for="veracross-region">Authentication Region</label>

                        <select id="veracross-region" name="dsn[veracross][region]">
                            {% for key, hosts in _domains.available ?? [] %}
                                {% set selected = '' %}

                                {% if key == (region ?? false) %}
                                    {% set selected = 'selected="selected"' %}
                                {% endif %}

                                <option value="{{ key }}" {{ selected }}>{{ key }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="small-12 columns">
                        <label class="required">School Route</label>
                        <input type="text" class='required suds-crypto' name="dsn[veracross][schoolroute]" value="{{ schoolroute ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label class="required">Client ID</label>
                        <input type="text" class='required suds-crypto' name="dsn[veracross][clientid]" value="{{ clientid ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label class="required">Client Secret</label>
                        <input type="password" class='required suds-crypto' name="dsn[veracross][clientsecret]" value="{{ clientsecret ?? ''}}" />
                    </div>
                    <div class="small-12 medium-12 columns">
                        <label class="required">Portal Access Name</label>
                        <input type="text" class='required suds-crypto' name="dsn[veracross][portalaccessname]" value="{{ portalaccessname ?? 'faculty'}}" />
                    </div>
                </div>
            </div>
        </fieldset>
    </section>
</div>
