{##
 # Kamar SUDS Configuration fragment
 #
 # A list of dsn pieces for this suds connector are provided by their key names already
 # via the include of this template
 #
 # @param string|null $key
 #}
<div data-data-source="kamar" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>Kamar Configuration</h3>

                <div class="row">
                    <div class="small-12 columns">
                        <label><span class="required-with-tip">Key</span></label>
                        <input type="text" class='required' name="dsn[kamar][key]" value="{{ key ?? ''}}" />
                    </div>
                </div>
            </div>
        </fieldset>
    </section>
</div>
