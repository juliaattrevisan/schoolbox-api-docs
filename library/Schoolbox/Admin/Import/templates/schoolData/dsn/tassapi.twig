{##
 # TASS SUDS Configuration fragment
 #
 # A list of dsn pieces for this suds connector are provided by their key names already
 # via the include of this template
 #
 # Each tass product is a tuple of three bits:
 #
 # @param string|null $companycode
 # @param string|null $appcode
 # @param string|null $token
 #}
<div data-data-source="tassapi" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>TASS Configuration</h3>

                <h4>Student Details</h4>
                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label class="required">Company Code</label>
                        <input type="text" class='required' name="dsn[tassapi][modules][studentdetails][companycode]" value="{{ modules.studentdetails.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label class="required">App Code</label>
                        <input type="text" class='required' name="dsn[tassapi][modules][studentdetails][appcode]" value="{{ modules.studentdetails.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label class="required">Token</label>
                        <input type="text" class='required suds-crypto' name="dsn[tassapi][modules][studentdetails][token]" value="{{ modules.studentdetails.token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4>Identity Management</h4>

                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label class="required">Company Code</label>
                        <input type="text" class='required' name="dsn[tassapi][modules][identitymanagement][companycode]" value="{{ modules.identitymanagement.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label class="required">App Code</label>
                        <input type="text" class='required' name="dsn[tassapi][modules][identitymanagement][appcode]" value="{{ modules.identitymanagement.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label class="required">Token</label>
                        <input type="text" class='required suds-crypto' name="dsn[tassapi][modules][identitymanagement][token]" value="{{ modules.identitymanagement.token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4>LMS Integration</h4>

                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label class="required">Company Code</label>
                        <input type="text" class='required' name="dsn[tassapi][modules][lmsintegration][companycode]" value="{{ modules.lmsintegration.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label class="required">App Code</label>
                        <input type="text" class='required' name="dsn[tassapi][modules][lmsintegration][appcode]" value="{{ modules.lmsintegration.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label class="required">Token</label>
                        <input type="text" class='required suds-crypto' name="dsn[tassapi][modules][lmsintegration][token]" value="{{ modules.lmsintegration.token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4 class="no-margin">School Calendar And Notices</h4>
                <p class="meta">This is an optional module. If you don't wish to use it, leave the fields empty.</p>

                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label>Company Code</label>
                        <input type="text" name="dsn[tassapi][modules][schoolcalendarandnotices][companycode]" value="{{ modules.schoolcalendarandnotices.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label>App Code</label>
                        <input type="text" name="dsn[tassapi][modules][schoolcalendarandnotices][appcode]" value="{{ modules.schoolcalendarandnotices.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>Token</label>
                        <input type="text" class='suds-crypto' name="dsn[tassapi][modules][schoolcalendarandnotices][token]" value="{{ modules.schoolcalendarandnotices.token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4 class="no-margin">TASS Academic Periods</h4>
                <p class="meta">
                    Put your school's Term Dates in here, according to your TASS timetable setup.
                    We use this to calculate the Semester value that we send to TASS when fetching timetables.
                    The dates are <strong>inclusive</strong> when calculated in backend.
                </p>

                <div class="row">
                    <div class="small-12 medium-6 columns">
                        <label>TASS Academic Period 1 Start</label>
                        <input id='tap1start' type="text" name="dsn[tassapi][options][tap1start]" value="{{ options.tap1start ?? '' }}" data-datepicker data-datesync-enddate="#tap1end" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>TASS Academic Period 1 End</label>
                        <input id='tap1end' type="text" name="dsn[tassapi][options][tap1end]" value="{{ options.tap1end ?? '' }}" data-datepicker data-datesync-startdate="#tap1start" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>TASS Academic Period 2 Start</label>
                        <input id='tap2start' type="text" name="dsn[tassapi][options][tap2start]" value="{{ options.tap2start ?? '' }}" data-datepicker data-datesync-enddate="#tap2end" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>TASS Academic Period 2 End</label>
                        <input id='tap2end' type="text" name="dsn[tassapi][options][tap2end]" value="{{ options.tap2end ?? '' }}" data-datepicker data-datesync-startdate="#tap2start" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>TASS Academic Period 3 Start</label>
                        <input id='tap3start' type="text" name="dsn[tassapi][options][tap3start]" value="{{ options.tap3start ?? '' }}" data-datepicker data-datesync-enddate="#tap3end" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>TASS Academic Period 3 End</label>
                        <input id='tap3end' type="text" name="dsn[tassapi][options][tap3end]" value="{{ options.tap3end ?? '' }}" data-datepicker data-datesync-startdate="#tap3start" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>TASS Academic Period 4 Start</label>
                        <input id='tap4start' type="text" name="dsn[tassapi][options][tap4start]" value="{{ options.tap4start ?? '' }}" data-datepicker data-datesync-enddate="#tap4end" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>TASS Academic Period 4 End</label>
                        <input id='tap4end' type="text" name="dsn[tassapi][options][tap4end]" value="{{ options.tap4end ?? '' }}" data-datepicker data-datesync-startdate="#tap4start" />
                    </div>
                </div>

                <hr />

                <h4 class="no-margin">Communal Classes</h4>
                <p class="meta">
                    This primarily affects staff timetables.
                    Yard Duties, classes taught by multiple teachers on alternating days, etc. could
                    show up incorrectly on staff timetables. For these classes/duties, specify their
                    class identifier here and we'll treat them specially. If you had a class code like
                    <strong>12-ABCD-X</strong> you should have <strong>X</strong> in this field.
                    You can specify multiple Yard Duties separated by a comma.
                </p>

                <div class="row">
                    <div class="small-12 medium-6 columns">
                        <label>TASS Class Identifier</label>
                        <input id='communal' type="text" name="dsn[tassapi][options][communal]" value="{{ options.communal ?? '' }}" />
                    </div>
                </div>
            </div>
        </fieldset>
    </section>
</div>
