{##
 # TASS SUDS Configuration fragment
 #
 # A list of dsn pieces for this suds connector are provided by their key names already
 # via the include of this template
 #
 # Each tass product is a tuple of three bits:
 #
 # @param string|null $companycode
 # @param string|null $appcode
 # @param string|null $token
 #}
<div data-data-source="tassapi" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>TASS Configuration</h3>

                <h4>Student Details</h4>
                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label><span class="required-with-tip">Company Code</span> <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" class='required' name="dsn[tass][studentdetails][companycode]" value="{{ studentdetails.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label><span class="required-with-tip">App Code</span> <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" class='required' name="dsn[tass][studentdetails][appcode]" value="{{ studentdetails.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label><span class="required-with-tip">Token</span> <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" class='required' name="dsn[tass][studentdetails][token]" value="{{ studentdetails.token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4>Identity Management</h4>

                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label><span class="required-with-tip">Company Code</span> <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" class='required' name="dsn[tass][identitymanagement][companycode]" value="{{ identitymanagement.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label><span class="required-with-tip">App Code</span> <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" class='required' name="dsn[tass][identitymanagement][appcode]" value="{{ identitymanagement.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label><span class="required-with-tip">Token</span> <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" class='required' name="dsn[tass][identitymanagement][token]" value="{{ identitymanagement.token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4>LMS Integration</h4>

                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label><span class="required-with-tip">Company Code</span> <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" class='required' name="dsn[tass][lmsintegration][companycode]" value="{{ lmsintegration.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label><span class="required-with-tip">App Code</span> <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" class='required' name="dsn[tass][lmsintegration][appcode]" value="{{ lmsintegration.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label><span class="required-with-tip">Token</span> <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" class='required' name="dsn[tass][lmsintegration][token]" value="{{ lmsintegration.token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4 class="no-margin">School Calendar And Notices</h4>
                <p class="meta">This is an optional module; if you don't use it, just leave these fields empty.</p>

                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label>Company Code<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" name="dsn[tass][schoolcalendarandnotices][companycode]" value="{{ schoolcalendarandnotices.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label>App Code<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" name="dsn[tass][schoolcalendarandnotices][appcode]" value="{{ schoolcalendarandnotices.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>Token<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" name="dsn[tass][schoolcalendarandnotices][token]" value="{{ schoolcalendarandnotices.token ?? ''}}" />
                    </div>
                </div>
            </div>
        </fieldset>
    </section>
</div>
