{##
 # TASS SUDS Configuration fragment
 #
 # A list of dsn pieces for this suds connector are provided by their key names already
 # via the include of this template
 #
 # @param string|null $school
 # @param string|null $token
 #}
<div data-data-source="tassapi" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>TASS Configuration</h3>

                <h4>Student Details</h4>
                <label>Company Code<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[studentdetails][companycode]" value="{{ studentdetails.companycode ?? ''}}" />

                <label>App Code<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[studentdetails][appcode]" value="{{ studentdetails.appcode ?? ''}}" />

                <label>Token<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[studentdetails][token]" value="{{ studentdetails.token ?? ''}}" />

                <hr />

                <h4>Identity Management</h4>
                <label>Company Code<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[identitymanagement][companycode]" value="{{ identitymanagement.companycode ?? ''}}" />

                <label>App Code<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[identitymanagement][appcode]" value="{{ identitymanagement.appcode ?? ''}}" />

                <label>Token<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[identitymanagement][token]" value="{{ identitymanagement.token ?? ''}}" />

                <hr />

                <h4>LMS Integration</h4>
                <label>Company Code<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[lmsintegration][companycode]" value="{{ lmsintegration.companycode ?? ''}}" />

                <label>App Code<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[lmsintegration][appcode]" value="{{ lmsintegration.appcode ?? ''}}" />

                <label>Token<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[lmsintegration][token]" value="{{ lmsintegration.token ?? ''}}" />

                <hr />

                <h4>School Calendar And Notices</h4>
                <label>Company Code<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[schoolcalendarandnotices][companycode]" value="{{ schoolcalendarandnotices.companycode ?? ''}}" />

                <label>App Code<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[schoolcalendarandnotices][appcode]" value="{{ schoolcalendarandnotices.appcode ?? ''}}" />

                <label>Token<span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[schoolcalendarandnotices][token]" value="{{ schoolcalendarandnotices.token ?? ''}}" />
            </div>
        </fieldset>
    </section>
</div>
