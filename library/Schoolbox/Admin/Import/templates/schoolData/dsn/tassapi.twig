{##
 # TASS SUDS Configuration fragment
 #
 # A list of dsn pieces for this suds connector are provided by their key names already
 # via the include of this template
 #
 # Each tass product is a tuple of three bits:
 #
 # @param string|null $companycode
 # @param string|null $appcode
 # @param string|null $token
 #}
<div data-data-source="tassapi" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>TASS Configuration</h3>

                <h4>Student Details</h4>
                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label class="required">Company Code</label>
                        <input type="text" class='required' name="dsn[tassapi][studentdetails][companycode]" value="{{ studentdetails.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label class="required">App Code</label>
                        <input type="text" class='required' name="dsn[tassapi][studentdetails][appcode]" value="{{ studentdetails.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label class="required">Token</label>
                        <input type="text" class='required suds-crypto' name="dsn[tassapi][studentdetails][token]" value="{{ studentdetails.token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4>Identity Management</h4>

                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label class="required">Company Code</label>
                        <input type="text" class='required' name="dsn[tassapi][identitymanagement][companycode]" value="{{ identitymanagement.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label class="required">App Code</label>
                        <input type="text" class='required' name="dsn[tassapi][identitymanagement][appcode]" value="{{ identitymanagement.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label class="required">Token</label>
                        <input type="text" class='required suds-crypto' name="dsn[tassapi][identitymanagement][token]" value="{{ identitymanagement.token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4>LMS Integration</h4>

                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label class="required">Company Code</label>
                        <input type="text" class='required' name="dsn[tassapi][lmsintegration][companycode]" value="{{ lmsintegration.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label class="required">App Code</label>
                        <input type="text" class='required' name="dsn[tassapi][lmsintegration][appcode]" value="{{ lmsintegration.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label class="required">Token</label>
                        <input type="text" class='required suds-crypto' name="dsn[tassapi][lmsintegration][token]" value="{{ lmsintegration.token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4 class="no-margin">School Calendar And Notices</h4>
                <p class="meta">This is an optional module. If you don't wish to use it, leave the fields empty.</p>

                <div class="row">
                    <div class="small-12 medium-3 columns">
                        <label>Company Code</label>
                        <input type="text" name="dsn[tassapi][schoolcalendarandnotices][companycode]" value="{{ schoolcalendarandnotices.companycode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-3 columns">
                        <label>App Code</label>
                        <input type="text" name="dsn[tassapi][schoolcalendarandnotices][appcode]" value="{{ schoolcalendarandnotices.appcode ?? ''}}" />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>Token</label>
                        <input type="text" class='suds-crypto' name="dsn[tassapi][schoolcalendarandnotices][token]" value="{{ schoolcalendarandnotices.token ?? ''}}" />
                    </div>
                </div>
            </div>
        </fieldset>
    </section>
</div>
