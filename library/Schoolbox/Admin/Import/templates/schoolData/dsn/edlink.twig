{##
 # Edlink SUDS Configuration fragment
 #
 # A list of dsn pieces for this suds connector are provided by their key names already
 # via the include of this template
 #
 # @param string|null $token
 #}
<div data-data-source="edlink" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>Edlink Configuration</h3>

                <div class="row">
                    <div class="small-12 columns">
                        <label class="required">Integration Access Token</label>
                        <input type="password" autocomplete="new-password" class='required suds-crypto' name="dsn[edlink][token]" value="{{ token ?? ''}}" />
                    </div>
                </div>
            </div>
        </fieldset>
    </section>
</div>
