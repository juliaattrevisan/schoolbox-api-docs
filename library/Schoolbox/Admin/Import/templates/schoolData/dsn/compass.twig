{##
 # Compass SUDS Configuration fragment
 #
 # A list of dsn pieces for this suds connector are provided by their key names already
 # via the include of this template
 #
 # @param string|null $key
 # @param int|null $timetableowner
 #}
<div data-data-source="compass" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>Compass Configuration</h3>

                <div class="row">
                    <div class="small-12 medium-4 columns">
                        <label>Key <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="text" name="dsn[key]" value="{{ key ?? ''}}" />
                    </div>
                    <div class="small-12 medium-8 columns">
                        <label>Timetable Owner User ID <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                        <input type="number" name="dsn[timetableowner]" value="{{ timetableowner ?? ''}}" />
                    </div>
                </div>
            </div>
        </fieldset>
    </section>
</div>
