{##
 # Wonde SUDS Configuration fragment
 #
 # A list of dsn pieces for this suds connector are provided by their key names already
 # via the include of this template
 #
 # @param string|null $school
 # @param string|null $token
 #}
<div data-data-source="wonde" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>Wonde Configuration</h3>

                <div class="row">
                    <div class="small-12 medium-4 columns">
                        <label class="required">School Identifier</label>
                        <input type="text" class='required suds-crypto' name="dsn[wonde][school]" value="{{ school ?? ''}}" />
                    </div>
                    <div class="small-12 medium-8 columns">
                        <label class="required">Token</label>
                        <input type="text" class='required suds-crypto' name="dsn[wonde][token]" value="{{ token ?? ''}}" />
                    </div>
                </div>

                <hr />

                <h4 class="no-margin">Future Families</h4>
                <p class="meta">If enabled, we will also look for students and their parents who have yet to commence their enrolment.</p>

                <div class="row">
                    <div class="small-12 columns">
                        <input type="hidden" name="dsn[wonde][options][futurefamilies]" value="0" />
                        <input id="futurefamilies" type="checkbox" name="dsn[wonde][options][futurefamilies]" value="1" {% if options.futurefamilies ?? false %}checked="checked"{% endif %} />
                        <label for="futurefamilies" class="checkbox-label">Enable processing of future families</label>
                    </div>
                </div>
            </div>
        </fieldset>
    </section>
</div>
