{##
 # Wonde SUDS Configuration fragment
 #
 # @param array $dsn  A list of dsn pieces for this suds connector
 #}
<div data-data-source="wonde" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>Wonde Configuration</h3>

                <label>School Identifier <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[school]" value="{{ school }}" />

                <label>Token <span class="hint has-tip tip-top" title="" data-tooltip>?</span></label>
                <input type="text" name="dsn[token]" value="{{ token }}" />
            </div>
        </fieldset>
    </section>
</div>
