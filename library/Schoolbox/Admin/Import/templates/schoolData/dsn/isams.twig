{##
 # iSAMS SUDS Configuration fragment
 #
 # A list of dsn pieces for this suds connector are provided by their key names already
 # via the include of this template
 #
 # @param string|null $key
 #}
<div data-data-source="isams" style="display:none">
    <section>
        <fieldset class="content">
            <div class="small-12 columns">
                <h3>iSAMS Configuration</h3>

                <div class="row">
                    <div class="small-12 columns">
                        <label class="required">Batch XML Key</label>
                        <input type="text" class='required suds-crypto' name="dsn[isams][modules][batch][key]" value="{{ modules.batch.key ?? ''}}" />
                    </div>
                </div>

                <div class="row">
                    <div class="small-12 columns">
                        <label>Staff Photos Key</label>
                        <input type="text" class='suds-crypto' name="dsn[isams][modules][staffphoto][key]" value="{{ modules.staffphoto.key ?? ''}}" />
                    </div>
                </div>

                <div class="row">
                    <div class="small-12 columns">
                        <label>Student Photos Key</label>
                        <input type="text" class='suds-crypto' name="dsn[isams][modules][studentphoto][key]" value="{{ modules.studentphoto.key ?? ''}}" />
                    </div>
                </div>
            </div>
        </fieldset>
    </section>
</div>
