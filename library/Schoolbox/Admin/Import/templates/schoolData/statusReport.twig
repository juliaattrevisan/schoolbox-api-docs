{##
 # Status
 #
 # Get a report about an endpoint's availability and what it's producing
 # These are unique to each sis so isams will do it differently to kamar et al.
 #
 # @param IStatus status
 #}

{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">School Data Import</h2>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h3 class="subheader">Status Report</h3>

        <section>
            <div class="scrollable schooldata-statusreport-container">
                <table>
                    <tbody>
                        {% for endpoint in report %}
                            <tr>
                                <td>{{ endpoint.message }}</td>
                                <td>

                                    {% if endpoint.status == 'OK' %}
                                        {% set css = 'success' %}
                                    {% elseif endpoint.status == 'ERROR' %}
                                        {% set css = 'alert' %}
                                    {% else %}
                                        {% set css = 'warning' %}
                                    {% endif %}

                                    <span class="full-width {{ css }} label">{{ endpoint.status }}</span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
