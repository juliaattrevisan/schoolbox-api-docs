{##
 # Configure your sis importer
 #
 # @param string pageCurrent
 # @param array configContext
 # @param array allNavigation
 # @param string dataSource
 # @param stirng logPath
 #}
<script>
    $(function() {

        {# Hide the container that has both the system-generated config vars
         # and the handcrafted csv island - this stops a visual glitch when
         # we have to use javascript to hide/show one or the other
         #}

        {# These config elements can be either hidden or shown, contextually
         # csv is a special subset
         #}
        let sisConfigElements = $('#schooldata_import_endpoint_host, #schooldata_import_endpoint_key, #schooldata_import_frequency, #schooldata_import_dailyorg_time, #schooldata_import_dailyorg_time-field, #schooldata_import_managed_hours, #schooldata_import_managed_hours-field, #schooldata_import_timeout');
        let csvConfigElements = $('#schooldata_import_frequency, #schooldata_import_managed_hours, #schooldata_import_managed_hours-field, #schooldata_import_timeout');

        {# On document.ready, using dataSource, decide which island to show:
         # it's one of either csv island or config island
         #}
        initIslands('{{ dataSource }}');

        {# Show the container that we originally hid
         #}
        $('#option-container').removeClass('hide');

        {# On dataSource change, decide which island to show:
         # it's one of either csv island or config island
         #}
        $('#schooldata_import_data_source-field').on('change', function(event) {
            switchIslands($(this).val());
        });

        $('#schooldata_import_frequency-field').on('change', function(event) {
            toggleCustomHours();
        });

        /**
         * Switch configuration options
         *
         * If you haven't chosen anything, hide both csv and config islands
         * If you chose csv island, just show that and hide config island
         * Otherwise show config island and hide the csv island
         *
         * @param {string} dataSource
         */
        function initIslands(dataSource) {
            if ([''].indexOf(dataSource) !== -1) {
                {# If you haven't chosen anything (select an option)
                 # Hide the Status Island and all configuration fields
                 #}
                $('#status-island').hide();
                hideConfig(sisConfigElements);
            } else if (['csv'].indexOf(dataSource) !== -1) {
                {# If you chose CSV, you now have the chance to manage the
                 # scheduler frequency for liss inputs (if you choose to use it)
                 # Otherwise you can just ignore them and just use csv files alone
                 #}
                $('#status-island').show();
                hideConfig(sisConfigElements);
                showConfig(csvConfigElements);
            } else {
                {# Otherwise, show the config island and hide the csv island
                 # Show the host/key/frequency input elements
                 #}
                $('#status-island').show();
                showConfig(sisConfigElements);
            }
        }

        /**
         * Switch configuration options
         *
         * If you haven't chosen anything, hide both csv and config islands
         * If you chose csv, just show that and hide config island
         * Otherwise show config island and hide the csv island
         *
         * @param dataSource string
         */
        function switchIslands(dataSource) {

            {# Show ui elements that are relevant to your choice
             # (the config island contains the status indicator, relevant only to actual api connectivities)
             #
             # Select An Option: hide the config island, hide the endpoint config fields
             # CSV: hide the config island, hide the endpoint config fields
             # Anything else: show the config island, show the config fields
             #}
            if (dataSource === '') {
                $('#status-island').hide();
                hideConfig(sisConfigElements);
            } else if (dataSource === 'csv') {
                $('#status-island').show();
                hideConfig(sisConfigElements);
                showConfig(csvConfigElements);
            } else {
                $('#status-island').show();
                showConfig(sisConfigElements);
            }
        }


        /**
         * Decide if Custom Import Hours should be made available
         *
         * You only need it when you've got a non-csv Data Source and when
         * the Import Frequency is something other than None
         */
        function toggleCustomHours() {
            const dataSource = $('#schooldata_import_data_source-field').val();
            const importFrequency = $('#schooldata_import_frequency-field').val();
            const importFrequencyContainer = $('#schooldata_import_managed_hours-field').parent('div');
            const dailyOrgFrequencyContainer = $('#schooldata_import_dailyorg_time-field').parent('div');

            /* Hide it by default
             */
            importFrequencyContainer.hide();
            dailyOrgFrequencyContainer.hide();

            /* If your data source is not Select An Option and not None,
             * And the import frequency is sb,
             * Show the options
             */
            if ([''].indexOf(dataSource) === -1) {
                /* If 'sb' was selected, reveal the custom hours
                 */
                if ('sb' === importFrequency) {
                    importFrequencyContainer.show();
                }

                /* If '' and 'none' were selected, let daily org import time stay hidden
                 * Otherwise reveal it
                 */
                if (['', 'none'].indexOf(importFrequency) === -1) {
                    dailyOrgFrequencyContainer.show();
                }
            }
        }

        /**
         * Hide config island elements in a special way
         *
         * @param elements
         */
        function hideConfig(elements) {
            $.each(elements, function (index, element) {
                $(element).parent('div').hide();
            });

            toggleCustomHours();

            /* Hide all fragments and disable all their inputs
             */
            $('[data-data-source]').hide();
            $('[data-data-source] input').prop('disabled', true)
        }


        /**
         * Show config island elements in a special way
         *
         * @param elements
         */
        function showConfig(elements) {
            $.each(elements, function (index, element) {
                $(element).parent('div').show();
            });

            toggleCustomHours();

            /* Decide which fragment we're showing here
             * Hide all fragments and disable all their inputs
             */
            $('[data-data-source]').hide();
            $('[data-data-source] input').prop('disabled', true)

            /* Then show the one we chose
             */
            const dataSource = $('#schooldata_import_data_source-field').val();

            $('[data-data-source="'+dataSource+'"]').show();
            $('[data-data-source="'+dataSource+'"] input').prop('disabled', false);
        }

        /* Live Update as per UPS implementation
         */
        $('[data-perform-update]').on('click', function(e) {
            e.preventDefault();

            let strats = $(this).attr('data-perform-update');

            $(this).confirmDialog({
                header: 'Warning! Live School Data Sync Selected',
                format: 'html',
                text: '<div class="alert-box warning">You have selected to perform a live School Data Sync. This will update profile and timetable data with the latest from your SIS.</div><p>Are you sure you wish to proceed?</p>',
                confirmEvent: function () {
                    window.location.href = '{{ routeLookup('adminImportIndex.getPerformUpdate') }}?strats=' + strats;
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        {% if hasPerformUpdate ?? false %}
            <div class="small-12 columns">
                <div data-alert class="alert-box">
                    <h2>Performing Live Sync</h2>
                    {% if config.messaging_enabled %}
                        <p>
                            Please be patient - a sync is in progress.
                           If you manually initiated this sync, you'll be notified when it's complete.
                        </p>
                    {% else %}
                        <p>
                            If messaging was enabled, you would have been notified when the School Data sync
                            was completed. It isn't though, so maybe check again in a few minutes?
                        </p>
                    {% endif %}
                    <a href="" class="close">×</a>
                </div>
            </div>
        {% endif %}

        <div id='option-container' class="hide">
            <div class="small-12 columns">
                <div class="actions-small-1">
                    <div class="list-item">
                        <h2 class="subheader">School Data Import</h2>
                    </div>
                    {% if canPerformUpdate ?? false %}
                    <nav>
                        <sbx-pop-out content-id="suds-options"></sbx-pop-out>
                    </nav>
                    <ul id="suds-options" class="f-dropdown" data-dropdown-content>
                        <li><a data-perform-update="{{ strats.full }}" href='#' class="sbx-button--has-icon" title="Update profile and timetable data for students, parents and staff"><sbx-icon name="export"></sbx-icon>Update user data and timetables</a></li>
                        <li><a data-perform-update="{{ strats.profiles }}" href='#' class="sbx-button--has-icon" title="Update profile data for students, parents and staff"><sbx-icon name="export"></sbx-icon>Update user data only</a></li>
                        <li><a data-perform-update="{{ strats.timetable }}" href='#' class="sbx-button--has-icon" title="Update timetables for students and staff"><sbx-icon name="export"></sbx-icon>Update timetable data only</a></li>
                        <li><a data-perform-update="{{ strats.calendar }}" href='#' class="sbx-button--has-icon" title="Update calendar data if your SIS supports it"><sbx-icon name="export"></sbx-icon>Update calendar data only</a></li>
                    </ul>
                    {% endif %}
                </div>
            </div>

            {# Pre-render all suds control panels for all connectors so you can change, configure and save
             # all in one step rather than having to intermezzo save
             #}
            {% include '@adminImportIndex/schoolData/dsn/moduleConfig.twig' with configContext only %}

            <div class="small-12 island" id="status-island">
                {% if hasIndicator %}
                    <h3 class="subheader">Status</h3>

                    <section class="content">
                        <div id="status-indicator-container">
                            <div class="loader"></div>
                        </div>

                        <script>
                            $(function() {
                                $.get('{{ statusIndicatorRoute }}', function(response) {
                                    $('#status-indicator-container').html(response);
                                });
                            });
                        </script>

                        <p>
                            Find out more about your
                            <a href="{{ routeLookupIfAuthorized('adminImportIndex.getStatusReport') }}">current endpoint status</a>.
                        </p>
                    </section>
                {% endif %}
            </div>
        </div>
        {% if importQueue.instance %}
            <div class="small-12 island scheduled-imports">
                <h3 class="subheader">Scheduled Imports</h3>
                <p class="meta">Note that you can only schedule one sync at a time.</p>
                <section>
                    {% include '@adminImportIndex/schoolData/importQueue.twig' with {
                        importQueue: importQueue
                    } %}
                </section>
            </div>
        {% endif %}

        {% if importLogs|length %}
            <div class="small-12 island" id="previous">
                <h3 class="subheader">Previous Imports</h3>
                <section>
                    {% include '@adminImportIndex/schoolData/importLog.twig' with {
                        importLogs: importLogs
                    } %}
                </section>
            </div>
        {% endif %}

        {% if lissInputPayloads.all|length %}
            <div class="small-12 island liss-input-payloads" id="liss-input-payloads">
                {% include '@adminImportIndex/schoolData/lissInputPayloads.twig' with {
                    lissInputPayloads: lissInputPayloads
                } %}
            </div>
        {% endif %}

        <div class="small-12 island">
            <h3 class="subheader">Your Data</h3>

            <section class="content">
                <p>You can download the current state of your data below.</p>

                <a href="{{ routeLookupIfAuthorized('adminImportProfile.getExport', {type: 'staff'}) }}" class="button sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Export Staff Data</a>
                <a href="{{ routeLookupIfAuthorized('adminImportProfile.getExport', {type: 'student'}) }}" class="button sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Export Student Data</a>
                <a href="{{ routeLookupIfAuthorized('adminImportProfile.getExport', {type: 'parent'}) }}" class="button sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Export Parent Data</a>
                <a href="{{ routeLookupIfAuthorized('adminImportProfile.getExport', {type: 'relationship'}) }}" class="button sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Export Relationship Data</a>

                {% if cyclicGrid %}
                    {# Only show these buttons if you're using the cyclic grid
                     # Kamar, Live Connectors and No Data Source download from cyclic grid
                     #}
                    <a href="{{ routeLookupIfAuthorized('adminImportTimetableStructure.getExport') }}" class="button sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Export Timetable Structure</a>
                    <a href="{{ routeLookupIfAuthorized('adminImportTimetable.getExport') }}" class="button sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Export Timetable</a>
                {% else %}
                    {# Otherwise, provide link to download csvs from SUDS Timetable and SUDS Events
                     #}
                    <a href="{{ routeLookupIfAuthorized('adminImportIndex.getClassesExport') }}" class="button sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Export Classes</a>
                    <a href="{{ routeLookupIfAuthorized('adminImportIndex.getTimetableExport') }}" class="button sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Export Timetable</a>
                {% endif %}

                {# Timetable Enrolments (sis_class_user) is actually the same in both cases
                 # since we reused that concept
                 #}
                <a href="{{ routeLookupIfAuthorized('adminImportTimetableEnrolment.getExport') }}" class="button sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Export Timetable Enrolments</a>
            </section>
        </div>
    </div>
</div>
