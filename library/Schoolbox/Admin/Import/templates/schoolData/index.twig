{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">School Data Import</h2>
    </div>

    <div class="small-12 island">
        <form data-action="saveSettings" id="settings" method="post" action="/adminv2/schoolData" novalidate="novalidate" _lpchecked="1">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="schoolData-import-data-source" class="required" aria-required="true">Data Source</label>

                        {{ dump(configContext) }}
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="Submit" />
        </form>
    </div>
</div>
