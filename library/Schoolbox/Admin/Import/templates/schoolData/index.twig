<script>
    $(function() {

        /**
         * Init the available options based on the Data Source selected
         *
         * @param decider
         */
        function initOptions(dataSource) {
            if ($(dataSource).val() == 'csv' || $(dataSource).val() == '') {
                $('#schooldata_import_batchxml_host').parent('div').hide();
                $('#schooldata_import_batchxml_key').parent('div').hide();
                $('#schooldata_import_frequency').parent('div').hide();
            } else {
                $('#schooldata_import_batchxml_host').parent('div').show();
                $('#schooldata_import_batchxml_key').parent('div').show();
                $('#schooldata_import_frequency').parent('div').show();
            }
        }

        {# Set up all the options
         # Set up the event listeners
         # Un-hide the container element when everything is ready to avoid visual artefact
         #}
        initOptions($('#schooldata_import_data_source'));

        $('#schooldata_import_data_source').on('change', function(event) {
            event.preventDefault();

            initOptions($(this));
        });

        $('#option-container').removeClass('hide');
    });
</script>

