{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation('import/directImport', subpageCurrent) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <h2 class="subheader">
                {% block title %}
                {% endblock %}
            </h2>
        </div>
        <div class="small-12 columns">

            {% if uploadMissing %}
                <div class="alert-box alert">
                    <h2>You must upload a file!</h2>
                    <p>Download the template below, enter your data, and upload it when done.</p>
                </div>
            {% endif %}

            {% include '@adminImportIndex/subnavigation.twig' with { allNodes: allNavigation } %}
        </div>
        <div class="small-12 island">
            <form action="{{ routeLookupIfAuthorized(basename ~ '.postPreview') }}" method="post">
                {% block helpText %}
                {% endblock helpText %}

                {% block form %}
                    <input type="submit" value="Preview Import" />
                {% endblock form %}
            </form>
        </div>
    </div>
</div>