 #}
{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">Direct Import</h2>
    </div>

    <div class="small-12 island">
        {% include '@adminImportIndex/subnavigation.twig' with { allNodes: allNavigation } %}

        <section class="content">
            <p>From this page, you can import User Accounts and User Photos that are not available in your SIS. You also have the ability to bulk upload folders to create a folder structure or to create class pages. If your SIS is compatible, External Pastoral Synchronisation will be available and you will be able to upload Pastoral Care Records.</p>
        </section>
    </div>
</div>
