{##
 # student.twig
 #
 # Renders the Student island
 #
 # @param attachzone attachzone
 # @param int        numProfiles
 #}
<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div class="row">
                <div class="small-12 medium-6 columns">
                    <h2>Students</h2>

                    <p>
                        This file will populate the records for Students in your school.
                    </p>

                    <h3>Instructions</h3>

                    <ul>
                        <li>Download the template for this user type and populate all fields.</li>
                        <li>Information for the Emergency Contact columns of CSV.</li>
                        <li>
                            <ul>
                                <li>Any details entered in these columns will be shown on the User Profile page of a current Student, if viewed by a Staff member.</li>
                                <li>The User Profile will display any text provided in these columns, it does not link to a Parent User ID.</li>
                            </ul>
                        </li>
                        <li>Once your CSV is ready, drop it in the attach zone.</li>
                    </ul>
                </div>
                <div class="small-12 medium-6 columns">
                    <form method="post" action="{{ routeLookupIfAuthorized('adminImportProfile.postUpload') }}">
                        <input type="hidden" name="file" value="student" />
                        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}

                        <ul class="flex-list buttons">
                            <li>
                                {% if numProfiles %}
                                    <a href="{{ routeLookupIfAuthorized('adminImportProfile.getExport', {type: 'student'}) }}" class="icon-download button">Export Student Data</a>
                                {% else %}
                                    <a href="/adminv2/import/profile/student.csv" class="icon-download button">Download Student Template</a>
                                {% endif %}
                            </li>
                            <li>
                                <input type="submit" class="button" value="Dry Run">
                            </li>
                        </ul>
                    </form>
                </div>
            </div>
        </section>
    </div>
</div>
