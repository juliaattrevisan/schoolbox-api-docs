{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>Import User Profiles</h1>
        {% include '@adminImportIndex/subnavigation.twig' with { allNodes: allNavigation } %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <p>
                This page allows you to populate your user data into the School User Data Store.
                This data can then be used by the <a href="{{ routeLookupIfAuthorized('upsRuleset.intro') }}">User Provisioning System</a>
                to create and update users in Schoolbox and Profile data will be shown on the User Profile screen.
            </p>

            <h2>Important Information</h2>

            <ul>
                <li>The files must be in CSV format.</li>
                <li>When you upload a file, all previous data of the uploaded role will be removed from the database, so the CSV must contain the entire list of current records.</li>
                <li>Empty fields will clear that field’s data for each user.</li>
                <li>The fields must have the same heading as provided in the template.</li>
            </ul>
        </section>

        {% include '@adminImportProfile/staff.twig' with {attachzone: attachzone.staff, numProfiles: profiles.numStaff} only %}
        {% include '@adminImportProfile/student.twig' with {attachzone: attachzone.student, numProfiles: profiles.numStudents} only %}
        {% include '@adminImportProfile/parent.twig' with {attachzone: attachzone.parent, numProfiles: profiles.numParents} only %}
        {% include '@adminImportProfile/relationship.twig' with {attachzone: attachzone.relationship, numProfiles: profiles.numRelationships} only %}

    </div>
</div>

