{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">User Profiles</h2>
        {% include '@adminImport/subnavigation.twig' with { allNodes: allNavigation } %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <form method="post" action="/adminv2/import/profile/upload">
            <section class="content">
                <p>Import profile data by attaching the CSV files here.</p>
            </section>

            {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}

            <input type="submit" class="button" value="Upload CSV">
        </form>
    </div>
</div>

