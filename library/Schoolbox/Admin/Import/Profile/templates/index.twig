{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>Import User Profiles</h1>
        {% include '@adminImportIndex/navigation/subnavigation.twig' with { allNodes: allNavigation } %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <p>
                These uploads will help you populate records for the people in your school.
                Once the User Provisioning System runs, it may use these records to create and update user accounts.
            </p>

            <h2>File Requirements</h2>

            <ul>
                <li>The files should be saved in CSV format.</li>
                <li>When you upload a file, all previous records will be removed from the database, so the CSV must contain the entire list of current records.</li>
                <li>All fields are required, if you don’t provide a field, it will clear that field’s data for each user.</li>
                <li>The fields must have the same heading as provided in the template, but they are case insensitive and order insensitive.</li>
                <li>Any other field that you add will be ignored.</li>
            </ul>
        </section>

        {% include '@adminImportProfile/staff.twig' with {attachzone: attachzone.staff, numProfiles: profiles.numStaff} only %}
        {% include '@adminImportProfile/student.twig' with {attachzone: attachzone.student, numProfiles: profiles.numStudents} only %}
        {% include '@adminImportProfile/parent.twig' with {attachzone: attachzone.parent, numProfiles: profiles.numParents} only %}
        {% include '@adminImportProfile/relationship.twig' with {attachzone: attachzone.relationship, numProfiles: profiles.numRelationships} only %}

    </div>
</div>

