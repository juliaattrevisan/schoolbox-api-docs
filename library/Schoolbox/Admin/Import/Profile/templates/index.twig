{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>Import User Profiles</h1>
        {% include '@adminImportIndex/navigation/subnavigation.twig' with { allNodes: allNavigation } %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <p>
                This page will allow you to add user data to the School Data Store.
                The data can then be used by the <a href="/adminv2/ups">User Provisioning System</a> to create users in Schoolbox.
                Additionally, once a user has been added to your instance, information from the database
                will be visible on the User Profile page.
            </p>

            <h2>Important Information</h2>

            <ul>
                <li>The files must be in CSV format.</li>
                <li>When you upload a file, all previous records of the uploaded type will be removed from the database, so the CSV must contain the entire list of current records.</li>
                <li>All fields are required, empty fields will clear that field’s data for each user.</li>
                <li>The fields must have the same heading as provided in the template. The order of the headings is not relevant.</li>
            </ul>
        </section>

        {% include '@adminImportProfile/staff.twig' with {attachzone: attachzone.staff, numProfiles: profiles.numStaff} only %}
        {% include '@adminImportProfile/student.twig' with {attachzone: attachzone.student, numProfiles: profiles.numStudents} only %}
        {% include '@adminImportProfile/parent.twig' with {attachzone: attachzone.parent, numProfiles: profiles.numParents} only %}
        {% include '@adminImportProfile/relationship.twig' with {attachzone: attachzone.relationship, numProfiles: profiles.numRelationships} only %}

    </div>
</div>

