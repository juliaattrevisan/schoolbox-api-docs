{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>User Profiles</h1>
        {% include '@adminImport/subnavigation.twig' with { allNodes: allNavigation } %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <form method="post" action="/adminv2/import/profile/upload">
            <section>
                <div class="content">
                    <p>Import profile data by attaching the CSV files here.</p>
                </div>
                <div class="component-action">
                    <section>
                        <a href="/adminv2/import/profile/student.csv" class="button">Download Student Template</a>
                        <a href="/adminv2/import/profile/parent.csv" class="button">Download Parent Template</a>
                        <a href="/adminv2/import/profile/staff.csv" class="button">Download Staff Template</a>
                        <a href="/adminv2/import/profile/relationship.csv" class="button">Download Relationship Template</a>
                    </section>
                </div>
            </section>
            {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}

            <input type="submit" class="button" value="Upload CSV">
        </form>
    </div>
</div>

