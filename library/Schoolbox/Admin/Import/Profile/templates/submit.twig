{# Add your own javascript, validation etc. #}
{# Use pantry for styling #}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">POST contents</h2>
        <section class="content">
            <p>var1: {{ var1 }}</p>

            {% set formRoute = routeLookupIfAuthorized('adminImportProfile.getIndex', {id: user.id}) %}

            {% if formRoute %}
                <a href="{{ formRoute }}" class="button icon-previous">Back to {{ formRoute }}</a>
            {% else %}
                Not authorised to POST
            {% endif %}
        </section>
    </div>
</div>

