{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>User Profiles</h1>
        {% include '@adminImport/subnavigation.twig' with { allNodes: allNavigation } %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Import Results</h2>
        {% for log in logs %}
        <section>
            <table>
                <thead>
                    <th width="10%">Time</th>
                    <th width="50%">Heading</th>
                    <th width="20%">Person</th>
                    <th width="20%" class="text-right">Import Result</th>
                </thead>
                <tbody>
                {% for row in log %}
                    <tr>
                        <td>{{ row.timestamp }}</td>
                        <td>{{ row.message }}</td>
                        <td>{{ row.person }}</td>
                        <td class="text-right">{{ row.status }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </section>
        {% endfor %}
    </div>
</div>

