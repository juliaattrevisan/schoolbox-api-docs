{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>User Profiles</h1>
        {% include '@adminImport/subnavigation.twig' with { allNodes: allNavigation } %}
    </div>
</div>

{% if errors|length %}
<div class="row">
    <div class="small-12 columns">
        <div class="alert-box alert">
            The following errors were detected:
            <ul>
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
{% else %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Import Results</h2>
        <section>
            <table>
                <thead>
                    <th width="10%">Time</th>
                    <th width="50%">Heading</th>
                    <th width="40%" class="text-right">Import Result</th>
                </thead>
                <tbody>
                {% for log in logs %}
                    <tr>
                        <td>{{ log.timestamp }}</td>
                        <td>{{ log.message }}</td>
                        <td class="text-right">{{ log.status }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </section>
    </div>
</div>
{% endif %}
