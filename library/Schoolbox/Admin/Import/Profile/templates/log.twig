{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>User Profiles</h1>
        {% include '@adminImport/subnavigation.twig' with { allNodes: allNavigation } %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Import Results</h2>
        <section>
            <table>
                <thead>
                    <th>Time</th>
                    <th>Heading</th>
                    <th>Person</th>
                    <th>Import Result</th>
                </thead>
                <tbody>
                {% for log in log %}
                    <tr>
                        <td>{{ log.timestamp }}</td>
                        <td>{{ log.message }}</td>
                        <td>{{ log.person }}</td>
                        <td>{{ log.status }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </section>
    </div>
</div>

