{##
 # staff.twig
 #
 # Renders the Staff island
 #
 # @param attachzone attachzone
 # @param int        numProfiles
 #}
<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div class="row">
                <div class="small-12 medium-6 columns">
                    <h2>Staff</h2>
                </div>
                <div class="small-12 medium-6 columns">
                    <form method="post" action="{{ routeLookupIfAuthorized('adminImportProfile.postUpload') }}">
                        <input type="hidden" name="file" value="staff" />
                        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}

                        <ul class="flex-list buttons">
                            <li>
                                {% if numProfiles %}
                                    <a href="{{ routeLookupIfAuthorized('adminImportProfile.getExport', {type: 'staff'}) }}" class="button sbx-button--has-icon"><sbx-icon name="export"></sbx-icon>Export Staff Data</a>
                                {% else %}
                                    <a href="{{ CDN_PREFIX }}/adminv2/import/profile/staff.csv" class="button sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Download Staff Template</a>
                                {% endif %}
                            </li>
                            <li>
                                <input type="submit" class="button" value="Dry Run">
                            </li>
                        </ul>
                    </form>
                </div>
            </div>
        </section>
    </div>
</div>
