{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>Import Folders</h1>
    </div>
</div>

<div class="row">
    <div class="large-12 columns">
        <table>
            <thead>
                <tr>
                    <th>Folder<em></em>
                        <span data-tooltip class="hint has-tip tip-right" title="The name of the folder, indicated from reading the rows in the CSV file.">?</span>
                    </th>
                    <th>Action
                        <span data-tooltip class="hint has-tip tip-right" title="The function schoolbox has attempted to complete.">?</span>
                    </th>
                    <th>Response
                        <span data-tooltip class="hint has-tip tip-right" title="Schoolbox's feedback after attempting to complete the requested function.">?</span>
                    </th>

                </tr>
            </thead>
            <tbody>
                {% for result in folders %}
                    <tr>
                        <td>Row {{ result.row }}</td>
                        <td>
                        {% if result.id %}
                            <a href="/homepage/{{ result.id }}">{{ result.name }}</a>
                        {% else %}
                            {{ result.name }}
                        {% endif %}
                        </td>
                        <td>{{ result.status }}</td>
                        <td>{{ result.error }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <a href="{{ routeLookupIfAuthorized('adminImportFolder.getIndex') }}" class="button icon-previous">Back to folders</a>
    </div>
</div>
