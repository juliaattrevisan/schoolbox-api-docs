<script>
    $(function(){
        $('[data-import]').click(function(e) {
            $("[data-import]").prop('value', 'Please Wait...');
            $("[data-import]").prop('disabled', true);
            $("[data-form-import]").submit();
        });
    });
</script>

{# Shared navigation menu #}

{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 island collapse">
        <h1>Pastoral Care Records</h1>
        <dl class="sub-nav">
            <dd>
                <a href="/adminv2/import/user">User</a>
            </dd>
            <dd>
                <a href="/adminv2/import/timetable-structure">Timetable Structure</a>
            </dd>
            <dd>
                <a href="/adminv2/import/timetable">Timetable</a>
            </dd>
            <dd>
                <a href="/adminv2/import/enrolment">Enrolment</a>
            </dd>
            <dd>
                <a href="/adminv2/photos/upload">User Photos</a>
            </dd>
            <dd class="active">
                <a href="/adminv2/import-pastoral">Pastoral Care Records</a>
            </dd>
        </dl>
    </div>
</div>

{% if externalEnabled == '1' %}

    <div class="small-12 island">
        <form data-form-import method="post" action="/adminv2/import-pastoral/process">
            <section class="content">
                <p>
                    This screen will import all pastoral care records currently stored in your SIS to the Schoolbox Pastoral
                    Care module. This is intended for a one-time import when first enabling the Pastoral Care module, any
                    records created using the import feature (and associated comments/attachment) will be removed on
                    subsequent imports.
                </p>
                <p>
                    Click on the button below to begin the import (the import process may take several minutes to complete).
                </p>
                <input type="submit" data-import value="Import Pastoral Care Records">
            </section>
        </form>
    </div>

{% else %}

    <div class="small-12 island">
        <form data-form-import method="post" action="/adminv2/import-pastoral/process">
            <section class="content">
                <p class="no-margin">
                    Sorry, importing of pastoral care records is only possible if
                    <a href='/adminv2/setting/External+DB'>External Pastoral Synchronisation</a> is enabled on the
                    External DB configuration screen.
                </p>
            </section>
        </form>
    </div>

{% endif %}