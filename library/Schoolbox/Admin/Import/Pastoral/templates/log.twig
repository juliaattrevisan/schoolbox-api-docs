{# Shared navigation menu #}

{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 island collapse">
        <h1>Pastoral Care Records</h1>
        <dl class="sub-nav">
            <dd>
                <a href="/adminv2/import/user">User</a>
            </dd>
            <dd>
                <a href="/adminv2/import/timetable-structure">Timetable Structure</a>
            </dd>
            <dd>
                <a href="/adminv2/import/timetable">Timetable</a>
            </dd>
            <dd>
                <a href="/adminv2/import/enrolment">Enrolment</a>
            </dd>
            <dd>
                <a href="/adminv2/photos/upload">User Photos</a>
            </dd>
            <dd class="active">
                <a href="/adminv2/import-pastoral">Pastoral Care Records</a>
            </dd>
        </dl>
    </div>
</div>

<div class="small-12 island">
    <h2 class="subheader">Pastoral Care Import Logs</h2>
    {% if message %}
        <div data-alert class="alert-box">
            Your pastoral import is now running, you will receive a notification once it has completed- alternatively
            you can click on the most recent log record below to view its current progress.
        </div>
    {% endif %}
    {% if logs | length > 0 %}
        <section>
            <ul class="information-list actions-small-1">
                {% for log in logs %}
                    <li class="actions-small-1">
                        <div class="card small-12">
                            <img src="/portrait.php?userId={{ log.creator.externalId }}&amp;size=square64" alt="View Profile">
                            <h3>{{ log.creator.fullName }} - {{ log.createdAt.short }}</h3>
                            <p class="meta">Last Message - {{ log.result }}</p>
                            <p></p>
                        </div>
                        <nav>
                            <a class="icon-eye no-text" href="{{ routeLookup('adminImportPastoral.getLogDetail', {logId: log.importId}) }}" title="View Log"></a>
                        </nav>
                    </li>
                {% endfor %}
            </ul>
        </section>
        <input type="submit" data-back value="Back">
    {% else %}
        <div class="empty-state">
            <i class="icon-pastoral"></i>
            <p>No log entries were found</p>
            <p>if you just started an import it may take a few seconds to start. <a href="{{ routeLookup('adminImportPastoral.getLog') }}" onclick="window.reload()">Click here to refresh the page</a></p>
        </div>
    {% endif %}
</div>