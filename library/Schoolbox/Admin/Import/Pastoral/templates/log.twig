{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island collapse">
        <h1>{{ locale.pastoralCare.proper }} Records</h1>
        {% include '@adminImport/subnavigation.twig' with { allNodes: allNavigation } %}
    </div>
</div>

<div class="small-12 island">
    <h2 class="subheader">{{ locale.pastoralCare.proper }} Import Logs</h2>
    {% if message %}
        <div data-alert class="alert-box">
            Your {{ locale.pastoral.proper }} import is now running, you will receive a notification once it has completed - alternatively
            you can click on the most recent log record below to view its current progress.
        </div>
    {% endif %}
    {% if logs | length > 0 %}
        <section>
            <ul class="information-list">
                {% for log in logs %}
                    <li>
                        <div class="list-item">
                            <div class="card small-12">
                                <img src="/portrait.php?userId={{ log.creator.externalId }}&amp;size=square64" alt="View Profile">
                                <h3><a href="{{ routeLookup('adminImportPastoral.getLogDetail', {logId: log.importId}) }}" title="View Log">{{ log.creator.fullName }} - {{ log.createdAt.short }}</a></h3>
                                <p class="meta">Last Message - {{ log.result }}</p>
                                <p></p>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
        <input type="submit" data-back value="Back">
    {% else %}
        <div class="empty-state">
            <i class="icon-pastoral"></i>
            <p>No log entries were found.</p>
            <p>If you just started an import it may take a few seconds to start. <a href="{{ routeLookup('adminImportPastoral.getLog') }}" onclick="window.reload()">Click here to refresh the page</a>.</p>
        </div>
    {% endif %}
</div>
