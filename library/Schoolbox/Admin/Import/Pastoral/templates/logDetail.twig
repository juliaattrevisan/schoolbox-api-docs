<script>
    $(function(){
        $('[data-import-logs]').click(function(e) {
            e.preventDefault();
            window.location.href = '{{ routeLookup('adminImportPastoral.getLog') }}';
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island collapse">
        <h1>Import {{ locale.pastoralCare.proper }} Records</h1>
        {% include '@adminImport/subnavigation.twig' with { allNodes: allNavigation } %}
    </div>
</div>

<div class="small-12 island">
    {% if log | length > 0 %}
        <h2 class="subheader">{{ locale.pastoralCare.proper }} Log</h2>
        <table>
            <thead>
                <tr>
                    <td>Time</td>
                    <td>Heading</td>
                    <td>Student Name</td>
                    <td>Creator Name</td>
                    <td class="text-right">Import Result</td>
                </tr>
            </thead>
            <tbody>
                {% for entry in log %}
                    {% if entry.studentName is not empty %}
                        <tr>
                            <td>{{ entry.createdAt.databaseTime }}</td>
                            <td>{{ entry.heading }}</td>
                            <td>{{ entry.studentName }}</td>
                            <td>{{ entry.creatorName }}</td>
                            <td class="text-right">{{ entry.result }}</td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="empty-state">
            <i class="icon-news"></i>
            <p>No log entries were found, if you just started an import it may take a few seconds to start. <a href="#" onclick="window.reload()">Click here to refresh the page</a></p>.
        </div>
    {% endif %}
    <input type="submit" data-import-logs value="Back">
</div>
