{# Shared navigation menu #}

{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="large-12 columns">
        <h3>Bulk Add Folders</h3>
        <table>
            <thead>
                <tr>
                    <th>Folder<em></em>
                        <span data-tooltip class="hint has-tip tip-right" title="The name of the folder, indicated from reading the rows in the CSV file.">?</span>
                    </th>
                    <th>Action
                        <span data-tooltip class="hint has-tip tip-right" title="The function schoolbox has attempted to complete.">?</span>
                    </th>
                    <th>Response
                        <span data-tooltip class="hint has-tip tip-right" title="Schoolbox's feedback after attempting to complete the requested function.">?</span>
                    </th>

                </tr>
            </thead>
            <tbody>
                {% for folder in folders %}
                    <tr>
                        <td>{{ folder.category }}</td>
                        <td>{{ folder.status }}</td>
                        <td>{{ folder.error }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <a href="/adminv2/bulk-add-folders" class="button icon-previous">Back to folders</a>
    </div>
</div>