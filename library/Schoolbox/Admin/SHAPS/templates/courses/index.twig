{#
    errorMessage:   null|string       If present, the page cannot be displayed for this reason
#}

<!-- BEGIN custom_head -->
<script type="text/javascript">
    $(function() {
        /* Collapse content on components
         */
        $('[data-component]').find('[data-collapser=true]').collapsable();
    });
</script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/select-all/jquery.select-all.js?v={{ config.site_version }}"></script>
<!-- END custom_head -->

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <h2 class="subheader">Accounts</h2>
        </div>
        <div class="small-12 island">
            <dl class="tabs">
                {% block pageAll %}<dd>{% endblock %}
                    <a href="{{ routeLookup('shaps.getAll') }}">All</a>
                </dd>
                {% block pageProvisioned %}<dd>{% endblock %}
                    <a href="{{ routeLookup('shaps.getProvisioned') }}">Provisioned</a>
                </dd>
                {% block pageUnprovisioned %}<dd>{% endblock %}
                    <a href="{{ routeLookup('shaps.getUnprovisioned') }}">Not Provisioned</a>
                </dd>
                {% block pageSearch %}<dd>{% endblock %}
                    <a href="{{ routeLookup('shaps.getUserProvisioningSearch') }}">Search</a>
                </dd>
                {% block pageHelpCourses %}<dd class="active">{% endblock %}
                    <a href="{{ routeLookup('shaps.getUsersInCourses') }}">Courses</a>
                </dd>
            </dl>

            {% if errorMessage %}
                <div class="empty-state">
                    <i class="icon-info"></i>
                    <h2>Sorry, we are unable to complete this request </h2>

                    <p>{{ errorMessage }}</p>
                </div>
            {% else %}
            <section>
                <ul class="information-list expandable-card">
                    {% for course in courses %}
                        <li>
                            <div class="actions-small-1">
                                <div class="expander" data-collapser="collap-{{loop.index}}"></div>
                                <div class="small-12 card compact list-item">
                                    <div class="icon-course"></div>
                                    <a href="{{ serverUrl }}/homepage/{{ course.folderId }}">
                                        <h3>{{ course.folderName }}</h3>
                                    </a>
                                </div>
                            </div>
                            <div class="small-12 column hide" data-collapse-state="collapsed" data-collapsable="collap-{{loop.index}}">

                                <div class="row">
                                    <div class="small-12 island">
                                        {#
                                        <dl class="tabs" data-tab>
                                            <dd class="active"><a href="#enrolments-{{ course.folderId }}">Current Enrolments</a></dd>
                                            <dd><a href="#enrol-{{ course.folderId}}">Enrol users</a></dd>
                                        </dl>
                                        #}

                                        <section>
                                            <div class="tabs-content content no-margin">
                                                <div class="content active" id="enrolments-{{ course.folderId }}">
                                                    <input type="hidden" name="folderId" value="{{ course.folderId }}" />

                                                    <ul class="information-list card-selectable">
                                                        {#
                                                        <li data-relation="member">
                                                            <div class="actions-small-4">

                                                                <div class="selector">
                                                                    <input data-toggle-all name="check-all-{{ course.folderId }}" id="check-all-{{ course.folderId }}" type="checkbox">
                                                                    <label for="check-all-{{ course.folderId}}" class="checkbox-label"></label>
                                                                </div>
                                                                <div class="list-item">
                                                                    <div class="card small-12">
                                                                        <p>Select All</p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </li>
                                                        #}
                                                        {% for user in course.participants %}
                                                            {% if user.id is null %}
                                                                {# Users without IDs have been created on Help via non-standard workflow (e.g. prospects)
                                                                So cannot be identified locally - don't link to them #}
                                                                <li data-relation="member">
                                                                    <div class="actions-small-4">
                                                                        {#
                                                                        <div class="selector">
                                                                            <input id="check-{{ user.id }}" name="check[]" type="checkbox" disabled>
                                                                            <label for="check-{{ user.id }}" class="checkbox-label"></label>
                                                                        </div>
                                                                        #}
                                                                        <div class="list-item">
                                                                            <div class="card small-12 prospect" title="This user could only be found on Help">
                                                                                {{ user.firstname }} {{ user.lastname }}
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </li>
                                                            {% else %}
                                                                <li data-relation="member">
                                                                    <div class="actions-small-4">
                                                                        {#
                                                                        <div class="selector">
                                                                            <input id="check-{{ user.id }}" name="check[]" type="checkbox" data-checkbox>
                                                                            <label for="check-{{ user.id }}" class="checkbox-label"></label>
                                                                        </div>
                                                                        #}
                                                                        <div class="list-item">
                                                                            <div class="card small-12">
                                                                                <a href="/search/user/{{ user.id }}">
                                                                                    {{ user.firstname }} {{ user.lastname }}
                                                                                </a>
                                                                            </div>
                                                                        </div>
                                                                        {#
                                                                        <nav>
                                                                            <!-- TODO change this form action -->
                                                                            <form action="/group/modifyForm.php" method="post" class="no-margin">
                                                                                <input id="unenrol-{{ user.id }}" type="button" />
                                                                                <label for="unenrol-{{ user.id }}" title="Remove user from this course">
                                                                                    <i class="icon-close alert"></i>
                                                                                </label>
                                                                            </form>
                                                                        </nav>
                                                                        #}
                                                                    </div>
                                                                </li>
                                                            {% endif %}
                                                        {% endfor %}
                                                    </ul>

                                                    {#<hr>#}
                                                    {#<button disabled data-delete-members class="expand">Remove Selected Users From Course</button>#}
                                                </div>

                                                {#
                                                <div class="content" id="enrol-{{ course.folderId}}" data-enrol>
                                                    <dl class="tabs" data-tab>
                                                        <dd><a href="#userRoles-{{ course.folderId }}">From Role</a></dd>
                                                        <dd><a href="#userList-{{ course.folderId }}">From List</a></dd>
                                                    </dl>
                                                    <section>
                                                        <div class="tabs-content no-margin">

                                                            <div class="content" id="userRoles-{{ course.folderId }}">
                                                                <!-- TODO change this form action -->
                                                                <form action="" method="post" class="no-margin">
                                                                    <input type="hidden" name="systemGroupID" id="systemGroupID" />
                                                                    <label for="addUsersBySystemGroup">
                                                                        Role
                                                                        <span data-tooltip class="has-tip tip-top hint" title="Add all users of a particular role in the system.">?</span>
                                                                    </label>
                                                                    <input type="hidden" name="folderId" value="{{ course.folderId }}" />
                                                                    <input id="enrolUsersBySystemGroup" type="text" size="30" placeholder="Search User Roles" />
                                                                    <input type="submit" value="Enrol Users" />
                                                                </form>
                                                            </div>

                                                            <div class="content" id="userList-{{ course.folderId }}">
                                                                <!-- TODO change this form action -->
                                                                <form action="" method="post" class="no-margin">
                                                                    <label for="addUsersByList">
                                                                        User List
                                                                        <span data-tooltip class="has-tip tip-top hint" title="Add a list of users (either external user IDs or Schoolbox usernames).">?</span>
                                                                    </label>
                                                                    <input type="hidden" name="folderId" value="{{ course.folderId }}" />
                                                                    <textarea name="bulkAdd" id="enrolUsersByList" cols="30" rows="20"></textarea>
                                                                    <input type="submit" value="Enrol Users" />
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </section>
                                                </div>
                                                #}
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <script>
                            $("ul").selectAll({
                                selector: "#check-all-{{ course.folderId }}",
                                checkboxes: "[data-checkbox]"
                            });
                        </script>

                    {% endfor %}
                </ul>

                <script type="text/javascript">
                    $(function () {
                        $('[data-collapser]').collapsable();
                    });
                </script>
            </section>

            <div class="empty-state{% if courses | length > 0 %} hide{% endif %}" data-empty-state>
                <i class="icon-course"></i>
                <p>{% block emptyStateText %}No courses found for your school.{% endblock %}</p>
            </div>
            {% endif %}
        </div>
    </div>
</div>
