{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <dl class="tabs">
                {% block pageAll %}<dd>{% endblock %}
                    <a href="{{ routeLookup('shaps.getAll') }}">All</a>
                </dd>
                {% block pageProvisioned %}<dd>{% endblock %}
                    <a href="{{ routeLookup('shaps.getProvisioned') }}">Provisioned</a>
                </dd>
                {% block pageUnprovisioned %}<dd>{% endblock %}
                    <a href="{{ routeLookup('shaps.getUnprovisioned') }}">Not Provisioned</a>
                </dd>
                {% block pageSearch %}<dd>{% endblock %}
                    <a href="{{ routeLookup('shaps.getUserProvisioningSearch') }}">Search</a>
                </dd>
                {% block pageHelpCourses %}<dd>{% endblock %}
                    <a href="{{ routeLookup('shaps.getUsersInCourses') }}">Courses</a>
                </dd>

            </dl>

            {% if errorMessage %}
                <div class="empty-state">
                    <i class="icon-info"></i>
                    <h2>Sorry, we are unable to complete this request </h2>

                    <p>{{ errorMessage }}</p>
                </div>
            {% else %}
                {% block page_specific_content %}{% endblock %}

                <div id="statusFormContainer" {% if allUsers | length == 0 %}class="hide"{% endif %}>
                    <form id="statusForm" action="{{ routeLookup('shaps.postProvision') }}" method="post">
                        <section id="statusTable">
                            <table>
                                <tr>
                                    <th>Status</th>
                                    <th>User</th>
                                    {% block provisioned_column_heading %}
                                    <th>
                                        <div class="checklist">
                                            <input id="select-all" type="checkbox">
                                            <label for="select-all" title="Select All">Provision?</label>
                                        </div>
                                    </th>
                                    {% endblock %}
                                </tr>

                                {% for user in allUsers %}
                                    {% set provisioned = provisionedUsers[user.id] is defined %}
                                    {% if not provisioned %}
                                        {% if errors[user.id] %}
                                            <tr class="highlight-alert">
                                        {% else %}
                                            <tr class="highlight-warning">
                                        {% endif %}
                                    {% else %}
                                        <tr>
                                    {% endif %}
                                    <td>
                                        {% if provisioned %}
                                            <span data-provision-status class="icon-course-outline" title="Provisioned"></span>
                                        {% else %}
                                            {% if errors[user.id] %}
                                                <span data-provision-status>Required field/s missing -
                                                    <span class="errorList">{{ errors[user.id] | join(', ') }}</span>
                                                </span>
                                            {% else %}
                                                <span data-provision-status>Not Provisioned</span>
                                            {% endif %}
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="/search/user/{{ user.id }}">{{ user.fullname }}</a>
                                    </td>

                                    {% block provisioned_column %}
                                        <td>
                                            {% if provisioned %}
                                                <div class="checklist">
                                                    <input id="provision-{{ user.id }}" name="userId[]" value="{{ user.id }}" type="checkbox" disabled>
                                                    <label for="provision-{{ user.id }}" title="Already provisioned"></label>
                                                </div>
                                            {% else %}
                                                <div class="checklist">
                                                    {% if errors[user.id] %}
                                                        <input id="provision-{{ user.id }}" name="userId[]" value="{{ user.id }}" type="checkbox" data-checkbox disabled>
                                                        <label for="provision-{{ user.id }}" title="Cannot provision - missing fields"></label>
                                                    {% else %}
                                                        <input id="provision-{{ user.id }}" name="userId[]" value="{{ user.id }}" type="checkbox" data-checkbox>
                                                    {% endif %}
                                                    <label for="provision-{{ user.id }}"></label>
                                                </div>
                                            {% endif %}
                                        </td>
                                    {% endblock %}
                                    </tr>
                                {% endfor %}
                            </table>
                        </section>

                        {% block submit_button %}
                            <input type="submit" value="Save changes">
                        {% endblock %}
                    </form>
                </div>

                <div class="empty-state{% if allUsers | length > 0 %} hide{% endif %}" data-empty-state>
                    <i class="icon-staff-students"></i>
                    <p>{% block emptyStateText %}No matching users found.{% endblock %}</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/select-all/jquery.select-all.js?v={{ config.site_version }}"></script>
<script>
    $(function() {
        var form = $("#statusForm"),
            findSelectedRows = function () {
                return form.find('#statusTable tr').has(':checkbox:checked');
            },
            markRowStatus = function ($tableRow, failedProvisions) {
                var $checkbox = $tableRow.find(':checkbox');
                // Did this fail provision?
                var userId   = $checkbox.attr('value');
                var isFailed = false;
                var reason   = '';
                failedProvisions.forEach(function (failedProvision) {
                    var payload = failedProvision[1];
                    if (payload.id === userId) {
                        isFailed = true;
                        reason   = failedProvision[0];
                    }
                });

                if (isFailed) {
                    markAsFailed($tableRow, reason);
                } else {
                    markAsProvisioned($tableRow);
                }
            },
            markAsFailed = function ($tableRow, reason) {
                $tableRow.find(':checkbox').prop('checked', false);
                $tableRow.removeClass('highlight-warning').addClass('highlight-alert');
                $tableRow.find('[data-provision-status]').text(reason);
            },
            markAsProvisioned = function ($tableRow) {
                $tableRow.find(':checkbox').prop('checked', false).prop('disabled', true);
                $tableRow.removeClass('highlight-warning highlight-alert');
                $tableRow.find('[data-provision-status]').text('').addClass('icon-course-outline');
            };

        form.selectAll({
            selector: "#select-all",
            checkboxes: "[data-checkbox]",
            observerParent: "tbody"
        });

        form.on('submit', function (event) {
            form.find('input[type=submit]').prop("disabled", true);
            event.preventDefault();

            var $toast     = $('#toast'),
                ajaxParams = {
                    method:   form.attr('method'),
                    data:     form.serializeArray(),
                    dataType: 'json'
                };

            $toast.toastActivate({text: 'Provisioning users...'});
            $.ajax(form.attr('action'), ajaxParams)
                .done(function () {
                    $toast.toastTimeout({text: 'Provisioned!'});
                    // Now update DOM w/ provisioned users (assume all submitted were updated)
                    findSelectedRows().each(function() {
                        markAsProvisioned($(this));
                    });
                    form.find('input[type=submit]').prop("disabled", false);
                })
                .fail(function (xhr) {
                    $toast.toastTimeout({text: 'Provision failed!', css: 'alert'});

                    // Maybe the response has more information on what failed?
                    // Assume error 400 was a partial fail that returns what failed,
                    // any others unknown.
                    if (xhr.status === 400) {
                        findSelectedRows().each(function() {
                            markRowStatus($(this), xhr.responseJSON.data);
                        });
                    } else {
                        findSelectedRows().each(function() {
                            markAsFailed($(this), 'Failed');
                        });
                    }
                    form.find('input[type=submit]').prop("disabled", false);
                })
        });
    });
</script>
<div class="toast" id="toast"></div>
