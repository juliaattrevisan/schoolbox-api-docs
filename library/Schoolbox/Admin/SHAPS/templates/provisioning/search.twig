{% embed "@shaps/provisioning/provisioning_base.twig" %}
    {% block pageStaffProvisioning %}<dd class="active">{% endblock %}
    {% block pageSearch %}<dd class="active">{% endblock %}

    {% block page_specific_content %}

        <section id="staffSearch" class="content">
            <input id="users" name="userId" value="" placeholder="Search Staff" data-selectizeuser="" required="" tabindex="-1" style="display: none;" class="selectized" type="text">
            <script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
            <script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
            <script type="text/javascript">
                $(function() {

                    var $statusFormContainer = $("#statusFormContainer").addClass("hide");

                    var $selectize = $('#users').selectizeSelector({
                        ajax: {
                            url:      '/ajax/user.php',
                            type:     'GET',
                            data:     {roleTypeID: 'staff', showCampus: true},
                            dataType: 'json'
                        },
                        multiple: true
                    });

                    var tableSelector = "#statusTable table";

                    $selectize = $selectize[0].selectize;
                    $selectize.on("item_add", function(userId) {
                        var url = '{{ routeLookup("shaps.getSearchUsers") }}'.replace('{userId}', userId);

                        $.get(url, function(data) {

                            if ($.isEmptyObject(data)) {
                                // Not sure under what circumstances this could possibly happen with a selectize,
                                // but accommodating it anyway
                                $("[data-empty-state]").show();
                                $statusFormContainer.addClass("hide");
                            } else {
                                $("[data-empty-state]").hide();
                                $statusFormContainer.removeClass("hide");
                            }

                            $(data).each(function(index, user) {
                                var statusMarkup = $('<span data-provision-status></span>');
                                var inputMarkup = $('<input type="checkbox" name="userId[]" data-checkbox>')
                                    .attr('id', 'provision-'+user.id)
                                    .attr('value', user.id);
                                var labelMarkup = $('<label>')
                                    .attr('for', 'provision-'+user.id);
                                var trMarkup = $('<tr />').attr('id', user.id);

                                var errors = user.errorList[user.id];

                                if (user.provisioned) {
                                    statusMarkup.addClass("icon-course-outline").attr('title', 'Provisioned');
                                    inputMarkup.prop('disabled', true);
                                    labelMarkup.attr('title', 'Already provisioned')
                                } else if (errors.length) {
                                    var errorText = "Required field/s missing - <span class='errorList'>" + (errors.join(', ') + "</span>");
                                    statusMarkup.html(errorText);
                                    inputMarkup.prop('disabled', true);
                                    labelMarkup.attr('title', 'Cannot provision - missing fields')
                                    trMarkup.addClass('highlight-alert');
                                } else {
                                    statusMarkup.text('Not Provisioned');
                                    trMarkup.addClass('highlight-warning');
                                }

                                var markup = trMarkup
                                    .append($('<td />').append(statusMarkup))
                                    .append($('<td />').text(user.name))
                                    .append($('<td />').append($('<div class="checklist">').append(inputMarkup).append(labelMarkup)));

                                $(tableSelector).append(markup);
                            });

                        }, "json")
                            .fail(function(xhr, status, error) {
                                /** @var {Object} xhr.responseJSON */
                                if ('object' === typeof xhr.responseJSON) {
                                    error = xhr.responseJSON.errorMessage
                                }
                                var $toast = $('[data-toast]');
                                var config = {text: 'Unable to connect to Schoolbox Help: ' + error, duration: 2500, css: 'alert'};
                                $toast.toastActivate(config);
                                $toast.toastTimeout(config);
                            })
                    });

                    $selectize.on("item_remove", function(userId) {
                        // Remove users from search results when they are removed from the selectize
                        var userRow = tableSelector + " tr#" + userId;
                        $(userRow).remove();

                        // Show empty state if the selectize is no longer searching for anyone
                        var selectizeEmpty = ($selectize.items.length < 1);
                        if (selectizeEmpty) {
                            $("[data-empty-state]").show();
                            $statusFormContainer.addClass("hide");
                        }
                    });

                });
            </script>
        </section>

        <div id='toaster' class="toast" data-toast></div>

    {% endblock %}
    {% block emptyStateText %}Users you search for will appear here.{% endblock %}
{% endembed %}
