<script type="text/javascript" src="/javascript/components/jquery-validation/dist/additional-methods.js"></script>
{# Shared navigation menu #}

<div class="row">
    {{ renderAdminNavigation(pageCurrent) }}
</div>

{# Display header #}

{% if user %}

    {% set method = 'Update' %}

    {# Display modify user header with drop-down #}

    <div class="actions-small-2 row">
        <div class="list-item">
            <div class="small-12 columns">
                <h2 class="subheader">{{ user.fullName }}</h2>
                <h3 class="subheader">User Detail</h3>
            </div>
        </div>
        <nav>
            <a class="icon-more" title="Actions" data-dropdown="header-options"></a>
        </nav>
        <ul id="header-options" class="f-dropdown" data-dropdown-content>
            <li>
                {% if user.enabled %}
                    <a href="{{ routeLookup('user.impersonate', {userId: user.id}) }}" class="icon-staff-students" title="Login as user">Impersonate</a>
                {% else %}
                    <a class="icon-staff-students menu_disabled" title="Account disabled">Impersonate</a>
                {% endif %}
            </li>
            <li><a href="/search/user/{{ user.id }}" class="icon-eye">View Profile</a></li>
            <li><a class="icon-delete" title="Delete User" data-delete data-action="{{ routeLookup('adminUser.postDeleteUser', {userId: user.id}) }}">Delete User</a></li>
        </ul>
    </div>

{% else %}

    {% set method = 'Create' %}

    {# Display create new user header with nothing #}

    <div class="row">
        <div class="list-item">
            <div class="small-12 columns">
                <h2 class="subheader">Create New User</h2>
                <h3 class="subheader">User Detail</h3>
            </div>
        </div>
    </div>

{% endif %}

{# User detail section #}

<div class="row">
    <form method="POST" action="{{ routeLookup('adminUser.postDetails', {userId: user.id}) }}" data-validatable-as="userDetails" data-modify-user-form>
    <div class="small-12 island">
        <section class="content">
            <fieldset class="content">

                <div class="row">
                    <input type="hidden" name="type" value="modify"/>
                    <input type="hidden" name="userID" value="{{ user.id }}"/>

                    <div class="small-12 medium-6 island">

                        <label for="title">Title</label>
                        <select id="title" name="title">
                            {% for title in titles %}
                                <option value="{{ title.title }}" {% if user.title == title.title %}selected{% endif %}>{{ title.title }}</option>
                            {% endfor %}
                        </select>

                        <label for="firstname">First Name</label>
                        <input id="firstname" type="text" class="given_name" name="firstname" value="{{ user.firstName }}"/>

                        <label for="lastname">Surname</label>
                        <input id="lastname" type="text" class="given_name" name="lastname" value="{{ user.lastName }}"/>

                        <label for="database">{{ externalDatabase }} ID</label>
                        <input id="database" type="text" name="database_id" value="{{ user.externalId }}"/>

                        {% if user %}
                            {# Can't display a schoolbox user ID on insert screen #}
                            <label for="userId">Schoolbox User ID</label>
                            <input id="userId" type="text" disabled value="{{ user.id }}"/>
                        {% endif %}

                        <label for="group">Role</label>
                        <select id="group" name="group">
                            {% for role in roles %}
                                <option value="{{ role.id }}" {% if user.role.id == role.id %}selected{% endif %}>{{ role.name }}</option>
                            {% endfor %}
                        </select>

                        <label for="position_title">Position Title</label>
                        <input id="position_title" type="text" name="position_title" value="{{ user.positionTitle }}"/>

                        <label>Campus Involvement</label>

                        <fieldset class="checklist">
                        {% for campus in campuses %}
                            {# Work out if the user is in this campus- really need to write a collection.contains() method #}

                            {% set campusChecked = false %}
                            {% for userCampus in user.campusCollection %}
                                {% if userCampus.id == campus.id %}
                                    {% set campusChecked = true %}
                                {% endif %}
                            {% endfor %}
                            <input id="campus-{{ campus.id }}" type="checkbox" name="campus[]" value="{{ campus.id }}" {% if campusChecked %}checked{% endif %}>
                            <label for="campus-{{ campus.id }}" class="checkbox-label">{{ campus.name }}</label>
                        {% endfor %}
                        </fieldset>
                    </div>

                    <div class="small-12 medium-6 island">
                        <label for="username">Username</label>
                        <input id="username" type="text" class="required" name="modusername" value="{{ user.username }}"/>

                        <label for="password">Password</label>
                        <input id="password" type="password" name="modpassword" class="password" value="donotchange"/>

                        <label for="alt_email">Alternate Email</label>
                        <input id="alt_email" type="email" name="alt_email" value="{{ user.altEmail }}"/>

                        <label for="year">Year</label>
                        <input id="year" type="text" name="year" value="{{ user.year }}"/>

                        <label for="house">House</label>
                        <select id="house" name="house">
                            <option value="">Not Set</option>
                            {% for house in houses %}
                                <option value="{{ house.id }}" {% if user.schoolHouse.id == house.id %}selected{% endif %}>{{ house.house }}</option>
                            {% endfor %}
                        </select>

                        <label for="residential_house">Residential House</label>
                        <select id="residential_house" name="residential_house">
                            <option value="">Not Set</option>
                            {% for residentialHouse in residentialHouses %}
                                <option value="{{ residentialHouse.id }}"
                                        {% if user.residentialHouse.id == residentialHouse.id %}selected{% endif %}>{{ residentialHouse.house }}</option>
                            {% endfor %}
                        </select>

                        <input id="eportfolio" type="checkbox" name="eportfolio" value="1" {% if user.eportfolioEnable %}checked{% endif %} />
                        <label for="eportfolio" class="checkbox-label">E-Portfolio</label>

                        <input id="hide_contacts" type="checkbox" name="hide_contacts" value="1" {% if user.hideContacts %}checked{% endif %} />
                        <label for="hide_contacts" class="checkbox-label">Hide Contact Details</label>

                        <input id="hide_timetable" type="checkbox" name="hide_timetable" value="1" {% if user.hideTimetable %}checked{% endif %} />
                        <label for="hide_timetable" class="checkbox-label">Hide Timetable</label>

                        <input id="local_email" type="checkbox" name="local_email" value="1" {% if user.localEmail %}checked{% endif %} />
                        <label for="local_email" class="checkbox-label">Email Address from Username</label>

                        <input id="mail_handler" type="checkbox" name="mail_handler" value="1" {% if user.useInternalMail %}checked{% endif %}/>
                        <label for="mail_handler" class="checkbox-label">Use External Mail Client</label>

                        <input id="webmail" type="checkbox" name="webmail" value="1" {% if user.webMail %}checked{% endif %} />
                        <label for="webmail" class="checkbox-label">Enable Webmail Tab</label>

                        <input id="display_grade_graph" type="checkbox" name="display_grade_graph" value="1" {% if user.displayGradeGraph %}checked{% endif %} />
                        <label for="display_grade_graph" class="checkbox-label">Display Graph on Student Grade Card</label>

                        <input id="superuser" type="checkbox" name="superuser" data-role="superuser" value="1" {% if user.isSuperuser %}checked{% endif %} />
                        <label for="superuser" class="checkbox-label">Superuser</label>

                        {% if user %}
                            {# Only modify user screen has the enabled checkbox #}
                            <input id="account_enabled" type="checkbox" name="account_enabled" data-role="enabled" value="1"
                                   {% if user.enabled %}checked{% endif %} />
                            <label for="account_enabled" class="checkbox-label">Account Enabled</label>
                        {% endif %}
                    </div>

                </div>
            </fieldset>
        </section>
    </div>
    <div class="small-12 columns">
        <input type="submit" value="{{ method }} User"/>
    </div>
</form>
</div>

{% if user %}

    {# Synergetic file year and semester #}

    {% if (externalDatabase | lower) == 'synergetic' %}
        <div class="row">
            <div class="small-12 island">
                <h3 class="subheader">Synergetic Info</h3>
                <section class="profile content">
                    <dl>
                        <dt class="small-12 medium-3">Year:</dt>
                        <dd class="small-12 medium-9">{{ fileYear }}</dd>
                        <dt class="small-12 medium-3">Semester:</dt>
                        <dd class="small-12 medium-9">{{ fileSemester }}</dd>
                    </dl>
                </section>
            </div>
        </div>
    {% endif %}

    {# Group Access #}

    <div class="row">
        <div class="small-12 island">
            <h3 class="subheader" id="groups">Groups</h3>
            <section>
                <ul class="action-list">
                    <li class="actions-small-1 row-header">
                        <div class="list-item">
                            <div class="small-7 columns">Group Name</div>
                            <div class="small-5 columns">Access</div>
                        </div>
                    </li>

                    {# Show all groups the user is a member of #}
                    {% for folder in userGroups %}
                        <li class="actions-small-1" data-group>
                            <div class="list-item">
                                <div class="card small-7">
                                    <a href="/homepage/{{ folder.id }}">{{ folder.name }}</a>
                                </div>
                                <div class="card small-5">
                                    <form action="{{ routeLookup('adminUser.postUpdateGroup', {userId: user.id, folderId: folder.id}) }}" method="post">
                                        {% set perm = userGroupPermissions[folder.id].accessLevel %}
                                        <select name="type" data-autosubmit-group data-folder="{{ folder.id }}" title="Access">
                                            <option value="1" {% if perm == 1 %}selected{% endif %}>Read</option>
                                            <option value="2" {% if perm == 2 %}selected{% endif %}>Write</option>
                                            <option value="3" {% if perm == 3 %}selected{% endif %}>Group Admin</option>
                                        </select>
                                    </form>
                                </div>
                            </div>
                            <nav>
                                <a href="#" data-delete-group="{{ folder.id }}" class="icon-delete" title="Remove"></a>
                            </nav>
                        </li>
                    {% endfor %}

                    <li class="actions-small-1">
                        <form action="{{ routeLookup('adminUser.postInsertGroup', {userId: user.id }) }}" method="post" id="groupAdd" data-validatable-as="addGroup" class="list-item">
                            <div class="card small-7">
                                <select required name="sid" id="groupSelect" form="groupAdd" class="required" title="Group">
                                    <option value="">Select a Group</option>
                                    {% for folder in allGroups %}
                                        <option value="{{ folder.id }}">{{ folder.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="card small-5 end">
                                <select required name="type" form="groupAdd" title="Access">
                                    <option value="1">Read</option>
                                    <option value="2">Write</option>
                                    <option value="3">Group Admin</option>
                                </select>
                            </div>
                            <div class="card small-12">
                                <p><input type="submit" value="Add"/></p>
                            </div>
                        </form>
                    </li>
                </ul>
            </section>
        </div>
    </div>

    {# Service permissions #}

    <div class="row">
        <div class="small-12 island">
            <h3 class="subheader" id="permissions">Permissions</h3>
            <section>
                <ul class="action-list">
                    <li class="actions-small-1 row-header">
                        <div class="list-item">
                            <div class="small-4 columns">Service</div>
                            <div class="small-4 columns">Service Identifier</div>
                            <div class="small-4 columns">Access</div>
                        </div>
                    </li>
                    {% for permission in userPermissions if permission.service != constant('HOMEPAGE_SERVICE') %}

                        <li class="actions-small-1" data-permission>
                            <div class="list-item">
                                <div class="small-4 card">
                                    {% if permission.service == constant('CALENDAR_SERVICE') %}Calendar{% endif %}
                                    {% if permission.service == constant('NEWS_SERVICE') %}News{% endif %}
                                    {% if permission.service == constant('CMS_SERVICE') %}CMS{% endif %}
                                    {% if permission.service == constant('HOUSEMASTER_SERVICE') %}Housemaster{% endif %}
                                    {% if permission.service == constant('RESOURCE_BOOKING_SERVICE') %}Resource Booking{% endif %}
                                    {% if permission.service == constant('CURRICULUM_SERVICE') %}Curriculum{% endif %}
                                    {% if permission.service == constant('PASTORAL_SERVICE') %}Pastoral Moderator{% endif %}
                                    {% if permission.service == constant('SPORTS_ADMINISTRATOR_SERVICE') %}Sports Administrator{% endif %}
                                </div>
                                <div class="small-4 card">
                                    {% if permission.service == constant('CALENDAR_SERVICE') or permission.service == constant('NEWS_SERVICE') %}
                                        Campus:
                                        {% for campus in campuses if campus.id == permission.serviceIdentifier %}
                                            {{ campus.name }}
                                        {% endfor %}
                                    {% elseif permission.service == constant('HOUSEMASTER_SERVICE') %}
                                        House:
                                        {% for residentialHouse in residentialHouses if residentialHouse.id == permission.serviceIdentifier %}
                                            {{ residentialHouse.house }}
                                        {% endfor %}
                                    {% endif %}
                                </div>
                                <div class="small-4 card">
                                    <form action="{{ routeLookup('adminUser.postUpdateService', {userId: user.id, service: permission.service, sid: permission.serviceIdentifier}) }}" method="post" class="updateServicesForm">
                                        <input type="hidden" name="sid" value="{{ permission.serviceIdentifier }}"/>
                                        <input type="hidden" name="service" value="{{ permission.service }}"/>
                                        <input type="hidden" name="updateServices" value="1"/>
                                        <select name="type" data-autosubmit-service data-service="{{ permission.service }}" data-sid="{{ permission.serviceIdentifier }}">
                                            {% if permission.service != constant('RESOURCE_BOOKING_SERVICE')
                                            and permission.service != constant('SPORTS_ADMINISTRATOR_SERVICE') %}
                                                <option value="1" {% if permission.accessLevel == 1 %}selected{% endif %}>Read</option>
                                                <option value="2" {% if permission.accessLevel == 2 %}selected{% endif %}>Write</option>
                                            {% endif %}
                                            <option value="3" {% if permission.accessLevel == 3 %}selected{% endif %}>Moderate</option>
                                        </select>
                                    </form>
                                </div>
                            </div>
                            <nav>
                                <a href="#" data-delete-permission="{{ permission.serviceIdentifier }}" data-service="{{ permission.service}}" class="icon-delete" title="Remove"></a>
                            </nav>
                        </li>
                    {% endfor %}

                    <li class="actions-small-1">
                        <form id="serviceCloneForm" action="{{ routeLookup('adminUser.postInsertPermission', {userId: user.id}) }}" method="post" data-validatable-as="addService"
                              data-action="addService" class="list-item">
                            <div class="small-4 card">
                                <select data-role="serviceSelector" name="service" id="serviceSelect" form="serviceCloneForm" required>
                                    <option value="" data-identifier="none">Select Service</option>
                                    <option value="2" data-identifier="campus">Calendar</option>
                                    <option value="3" data-identifier="campus">News</option>
                                    <option value="5" data-identifier="none">CMS</option>
                                    <option value="6" data-identifier="residentialHouse">Housemaster</option>
                                    <option value="7" data-identifier="none">Resource Booking</option>
                                    <option value="8" data-identifier="none">Curriculum</option>
                                    <option value="9" data-identifier="none">Pastoral Moderator</option>
                                    <option value="10" data-identifier="none">Sports Administrator</option>
                                </select>
                            </div>
                            <div class="small-4 card">
                                <select data-service-type="campus" name="sid" id="campusSelect" class="hide" disabled required>
                                    <option value="">Select Campus</option>
                                    {% for campus in campuses %}
                                        <option value="{{ campus.id }}">{{ campus.name }}</option>
                                    {% endfor %}
                                </select>
                                <select data-service-type="residentialHouse" name="sid" id="residentialHouseSelect" class="hide" disabled required>
                                    <option value="">Select Residential House</option>
                                    {% for residentialHouse in residentialHouses %}
                                        <option value="{{ residentialHouse.id }}">{{ residentialHouse.house }}</option>
                                    {% endfor %}
                                </select>
                                <select data-service-type="none" name="sid" id="defaultSelect">
                                    <option value="" disabled>--</option>
                                </select>
                            </div>
                            <div class="small-4 card end">
                                <select name="type" id="permissionSelect" form="serviceCloneForm" required>
                                    <option id="read" value="1">Read</option>
                                    <option id="write" value="2">Write</option>
                                    <option id="moderate" value="3">Moderate</option>
                                </select>
                            </div>
                            <div class="small-12 card">
                                <input type="submit" class="submit-btn-plain" value="Add" name="serviceSubmit">
                            </div>
                        </form>
                    </li>
                </ul>
            </section>
        </div>
    </div>

    {# Linked user accounts #}

    <div class="row">
        <div class="small-12 island">
            <h3 class="subheader" id="linked">Linked Accounts</h3>
            <section>
                <ul class="action-list">
                    <li class="actions-small-1 row-header">
                        <div class="list-item">
                            <div class="small-12 columns">User</div>
                        </div>
                    </li>

                    {% for linkedUser in user.linkedUser %}
                        <li class="actions-small-1" data-linked-user>
                            <div class="list-item">
                                <div class="card small-12">
                                    <a href="/adminv2/user/{{ linkedUser.id }}/modify">{{ linkedUser.fullName }}</a>
                                </div>
                            </div>
                            <nav>
                                <a href="#" data-delete-linked="{{ linkedUser.id }}" class="icon-delete" title="Remove"></a>
                            </nav>
                        </li>
                    {% endfor %}

                    <li class="actions-small-1">
                        <form action="{{ routeLookup('adminUser.postInsertLinked', {userId: user.id}) }}" method="post" id="linkedUserAdd" class="list-item">
                            <div class="small-12 card">
                                <select data-selectizeuser="addUser" name="linkUser[]" multiple placeholder="Search Users" form="linkedUserAdd"></select>
                            </div>
                            <div class="small-12 card">
                                <input type="submit" value="Add" disabled/>
                            </div>
                        </form>
                    </li>
                </ul>
            </section>
        </div>
    </div>

    {# Recent activity log #}

    <div class="row">
        <div class="small-12 columns">
            <h3 class="subheader">Recent Activity Logs</h3>
        </div>
        <div class="small-12 medium-6 island">
            <section>
                {% if (userLog | length) > 0 %}
                    <div class="actions-small-1">
                        <div class="list-item">
                            <div class="small-12 columns">
                                <h4>Logins</h4>
                            </div>
                        </div>
                        <nav>
                            <a class="icon-view" href="/adminv2/reports/login/user={{ user.username }}" title="See All"></a>
                        </nav>
                    </div>
                    <table>
                        <thead>
                        <tr>
                            <th>Date</th>
                            <th>IP</th>
                            <th>Result</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for log in userLog %}
                            <tr>
                                <td>{{ log.date.getLocal }}</td>
                                <td>{{ log.ip }}</td>
                                <td>
                                    {% if log.login == 1 %}
                                        Success
                                    {% elseif log.login == 0 %}
                                        Failed
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="content">No recorded logins</p>
                {% endif %}
            </section>
        </div>

        <div class="small-12 medium-6 island">
            <section>
                {% if (cmsLog | length) > 0 %}
                    <div class="actions-small-1">
                        <div class="list-item">
                            <div class="small-12 columns">
                                <h4>Activity</h4>
                            </div>
                        </div>
                        <nav>
                            <a class="icon-view" href="/adminv2/reports/activity/user={{ user.username }}" title="See All"></a>
                        </nav>
                    </div>
                    <table>
                        <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for log in cmsLog %}
                            <tr>
                                <td>{{ log.time.getLocal }}</td>
                                <td>
                                    {{ log.action | capitalize }}
                                    {% if log.folder %}
                                        '{{ log.folder.name }}'
                                    {% elseif log.file %}
                                        '{{ log.file.filename }}'
                                    {% elseif log.link %}
                                        '{{ log.link.name }}'
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="content">No recent activity</p>
                {% endif %}
            </section>
        </div>
    </div>

    <div class="row">
        <div class="small-12 island">
            <h3 class="subheader">Send Message to {{ user.fullName }}</h3>

            <div class="alert-box">
                <p class="no-margin">{{ user.firstName }} must be signed in to receive a popup alert.</p>
            </div>

            <form action="{{ routeLookup('adminUser.postAlert', {userId: user.id}) }}" method="POST">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>
                                Message from {{ USER.fullName }}
                                <input type="text" value="" name="body"/>
                            </label>
                        </div>
                    </fieldset>
                </section>
                <div class="row">
                    <div class="small-12 columns">
                        <input type="submit" value="Send"/>
                    </div>
                </div>
            </form>
        </div>
    </div>

{% endif %}

<!-- BEGIN custom_head -->
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript">
    $(function () {
        var servicesDropdown = $("#serviceSelect");
        var middleDropdown = $("#defaultSelect");
        var permissionsDropdown = $("#permissionSelect");

        // Hide the last middle and last dropdowns initially, when no service is selected yet
        if (servicesDropdown.val() === "") {
            permissionsDropdown.hide();
            middleDropdown.hide();
        }

        servicesDropdown.change(function(e) {
            // Hide the last middle and last dropdowns when no service is selected
            if (servicesDropdown.val() === "") {
                permissionsDropdown.hide();
                middleDropdown.hide();
            } else {
                permissionsDropdown.show();
                middleDropdown.show();
            }

            var selectedServiceId = $(e.target).val();

            var resourceBooking = '{{ constant('RESOURCE_BOOKING_SERVICE') }}';
            var fixtures = '{{ constant('SPORTS_ADMINISTRATOR_SERVICE') }}';
            var cms = '{{ constant('CMS_SERVICE') }}';
            var curriculum = '{{ constant('CURRICULUM_SERVICE') }}';
            var pastoralCare = '{{ constant('PASTORAL_SERVICE') }}';

            var moderateOnlyServices = [resourceBooking, fixtures];
            var noMiddleDropdownServices = [cms, resourceBooking, curriculum, pastoralCare, fixtures]

            var moderateAccess = 3;
            var readAccess = 1;

            // Hide the middle dropdown for services where it's empty
            if (noMiddleDropdownServices.indexOf(selectedServiceId) !== -1) {
                middleDropdown.hide();
            } else if (servicesDropdown.val() !== "")  {
                middleDropdown.show();
            }

            {# Hide Read and Write permission options in dropdown for certain services #}
            if (moderateOnlyServices.indexOf(selectedServiceId) !== -1) {
                $("#read").hide();
                $("#write").hide()
                permissionsDropdown.val(moderateAccess);
            } else {
                $("#read").show();
                $("#write").show()
                permissionsDropdown.val(readAccess);
            }
        });

        {# Validate user details#}

        $('form[data-validatable-as="userDetails"]').alaressValidate({
            rules: {
                'alt_email':        { emailTrimmed: true },
                'firstname':        { require_from_group: [1,".given_name"] },
                'lastname':         { require_from_group: [1,".given_name"] },
                'campus[]':         { required: true }
            },
            messages: {
                'alt_email':        "Please enter a valid email address",
                'firstname':        "Please enter either a first name or surname",
                'lastname':         "Please enter either a first name or surname",
                'campus[]':         "Please select at least one campus"
            }
        });

        {# Confirm change of superuser status #}

        $('input[data-role="superuser"]').click(function (event) {
            event.preventDefault();
            $(this).confirmDialog({
                text: 'Change this user\'s superuser status?',
                confirmEvent: function (element) {
                    element.prop('checked', !(element.prop('checked')));
                }
            });
        });

        {# This is script that only relates to the modify user screen #}

        {% if user %}

            {# Confirm change of enabled flag#}

            $('input[data-role="enabled"]').click(function (event) {
                event.preventDefault();
                $(this).confirmDialog({
                    text: 'Change this user\'s account status?',
                    confirmEvent: function (element) {
                        element.prop('checked', !(element.prop('checked')));
                    }
                });
            });

            {# Delete user #}

            $('[data-delete]').click(function (event) {
                event.preventDefault();

                var action = $(this).data('action');

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this user?',
                    confirmEvent: function () {
                        $.post(action).done(function() {
                            window.location = '/adminv2/user'
                        });
                    }
                });
            });

            {# Delete linked user #}
    
            $('[data-delete-linked]').click(function (event) {
                event.preventDefault();
    
                var linkedId = $(this).data('delete-linked');
                var linkedUserRow = $(this).closest('[data-linked-user]');
    
                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this linked user?',
                    confirmEvent: function () {
                        $.post('{{ routeLookup('adminUser.postDeleteLinked', {userId: user.id, linkedId: 'linkedId'}) }}'.replace(/linkedId/g, linkedId)).done(function() {
                            linkedUserRow.remove();
                        });
                    }
                });
            });

            {# Delete group #}

            $('[data-delete-group]').click(function (event) {
                event.preventDefault();

                var folderId = $(this).data('delete-group');
                var groupRow = $(this).closest('[data-group]');

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this group?',
                    confirmEvent: function () {
                        $.post('{{ routeLookup('adminUser.postDeleteGroup', {userId: user.id, folderId: 'folderId'}) }}'.replace(/folderId/g, folderId)).done(function() {
                            groupRow.remove();
                        });
                    }
                });
            });

            {# Delete permission #}

            $('[data-delete-permission]').click(function (event) {
                event.preventDefault();

                var sid = $(this).data('delete-permission');
                var service = $(this).data('service');
                var permissionRow = $(this).closest('[data-permission]');

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this permission?',
                    confirmEvent: function () {
                        $.post('{{ routeLookup('adminUser.postDeletePermission', {userId: user.id, service: 'service', sid: 'sid'}) }}'
                                .replace(/service/g, service)
                                .replace(/sid/g, sid)
                        ).done(function() {
                            permissionRow.remove();
                        });
                    }
                });
            });

            {# Setup service and group form validation #}

            $('form[data-validatable-as="addService"]').alaressValidate();
            $('form[data-validatable-as="addGroup"]').alaressValidate();

            {# Selectize user picker #}

            var addUserSelector = $(':input[data-selectizeuser="addUser"]');
            var addUserButton = $(addUserSelector.prop('form')).find(':submit');

            addUserSelector
                .selectizeSelector({
                    multiple: true,
                    ajax: {
                        url: '/ajax/user.php',
                        type: 'GET',
                        data: {groupID: 0},
                        dataType: 'json'
                    }
                })
                .on('selectize.item_add', function () {
                    addUserButton.prop('disabled', false);
                })
                .on('selectize.item_remove', function () {
                    {# Disable only if empty #}
                    if ($(this).data('selectize').items.length === 0) {
                        addUserButton.prop('disabled', true);
                    }
                });

            {# AJAX submission of groups #}

            $(':input[data-autosubmit-group]').change(function () {
                var form = $(this).parents('form:first');
                $.post(form.attr('action'), form.serializeArray());
            });

            {# AJAX submission of services #}

            $(':input[data-autosubmit-service]').change(function () {
                var form = $(this).parents('form:first');
                $.post(form.attr('action'), form.serializeArray());
            });

            {# Hide campus selector if user selected a service that doesn't use them #}

            var addServiceForm = $('form[data-action="addService"]');

            addServiceForm.on(
                'change',
                ':input[data-role="serviceSelector"]',
                function () {
                    {# Search for this item, disable others #}
                    var currentService = $(this).find(':selected').data('identifier');
                    var selectors = addServiceForm.find(':input[data-service-type]');
                    selectors.addClass('hide').prop('disabled', true);
                    selectors.filter('[data-service-type="' + currentService + '"]').removeClass('hide').prop('disabled', false);
                }
            );

        {% endif %}
    });
</script>
<!-- END custom_head -->
