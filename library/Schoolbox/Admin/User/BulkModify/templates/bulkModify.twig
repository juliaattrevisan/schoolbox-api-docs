{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">
    {{ renderAdminNavigation(pageCurrent) }}
    <div class="admin-content">
        <div class="small-12 columns">
            <div id='user-bulk-modify-container'>
                <user-bulk-modify
                    src-user-list="{{ routeLookupIfAuthorized('adminUserBulkModify.getUserList') }}"
                    src-user-modify="{{ routeLookupIfAuthorized('adminUserBulkModify.postModify') }}"
                    src-user-delete="{{ routeLookupIfAuthorized('adminUserBulkModify.deleteUsers') }}"
                    :campuses="{{ campuses | json_encode }}"
                    :roles="{{ roles | json_encode }}"
                    :year-levels="{{ yearLevels | json_encode }}"
                    :eportfolio-enabled="Boolean({{ config.eportfolio_enabled }})"
                    :houses="{{ houses | json_encode }}"
                />
            </div>
            <script src="{{ CDN_PREFIX }}/js/bundle/userBulkModify.js?v={{ config.site_version }}"></script>
        </div>
    </div>
</div>
