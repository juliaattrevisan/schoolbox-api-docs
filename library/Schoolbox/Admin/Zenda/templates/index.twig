{##
 # Zenda configuration page
 #
 # @param array $allBreadcrumbs  A set of breadcrumb nodes, as defined by Admin Subnav
 # @param string $pageCurrent    The current page we're on
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <div class="actions-small-1">
                <div class="list-item">
                    <h2 class="subheader">Zenda Configuration</h2>
                </div>
            </div>
        </div>

        {% include '@settings/moduleConfig.twig' with configContext only %}
    </div>
</div>
