{# Shared navigation menu #}

{{ renderAdminNavigation(pageCurrent) }}

{# Config page contents #}

<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<script type="text/javascript" src="/javascript/shared/server-usage/jquery.server-usage.js"></script>
<script type="text/javascript">

    $(function() {
        var allCategories = [];
        var allSeriesData = [];
        var allTooltips = [];
        var allData = [];

        allData.push({
            label: 'Storage',
            value: parseFloat('{{ disk_percentage }}')
        });

        allTooltips.push('{{ disk_used }} / {{ disk_total }}');

        allData.push({
            label: 'Memory',
            value: parseFloat('{{ memory_percentage }}')
        });

        allTooltips.push('{{ memory_used }} / {{ memory_total }}');

        for (var i = 0; i < allData.length; i++) {
            allCategories.push(allData[i].label);
            allSeriesData.push(allData[i].value);
        }

        /* Render it out
         */
        $('[data-graph="usage"]').serverUsage({
            title: '',
            categories: allCategories,
            tooltip: {
                enabled: true,
                formatter: function() {
                    return allTooltips[this.point.x];
                }
            },
            series: [
                {
                    data: allSeriesData
                }
            ],
            formatter: function() {
                var str = '';

                if (this.y > 0) {
                    str = this.y + '%';
                }

                return str;
            }
        });
    });

    $(window).load( function() {

        // Test that the non-js page has not been requested

        if (window.location.pathname.indexOf("nojscript") == -1)
        {
            // Load the user statistics via ajax
            $.post('/ajax/adminStats.php', { module : 'users' }, function(data)
            {
                for (i in data)
                {
                    var row = data[i];

                    if(row.GROUP_ID > 0) {
                        $('<tr><td><a href="/adminv2/reports/group/' + row.GROUP_ID + '">' + row.GROUP_NAME +
                                '</a></td><td>' + row.GROUP_USER +
                                '</td><td>' + row.GROUP_LOGGED_IN + '</td></tr>').appendTo($('#group-summary'));
                    } else {
                        $('<tr><td>' + row.GROUP_NAME +
                                '</td><td>' + row.GROUP_USER +
                                '</td><td>' + row.GROUP_LOGGED_IN + '</td></tr>').appendTo($('#group-summary'));
                    }
                }
            });

            // Replace the default www status 'untested' with 'testing'
            $('[data-light="www"]').html('Testing...');

            // Load service statuses via ajax

            $.post('/ajax/adminStats.php', { module : 'service_www' }, function(data)
            {
                for(i in data) {
                    var light = data[i].WWW_LIGHT;
                    var status = data[i].WWW_STATUS;
                }

                $('[data-light="www"]').html(status);
                $('[data-light="www"]').removeClass('warning');
                $('[data-light="www"]').addClass(light);
            });
        }
    });

</script>

<div class="row">
    <div class="small-12 large-4 island collapse">

        <!-- Usage Graphs -->

        <h2 class="subheader">Server Usage</h2>
        <section>
            <div data-graph="usage"></div>
        </section>

        <!-- Service Statuses -->

        <h2 class="subheader">Status of Services</h2>
        <section>
            <ul class="information-list">
                <li>
                    <div class="small-5 columns content">
                        <a href="/adminv2/home/healthcheck">{{ external_db }}</a>
                    </div>
                    <div class="small-7 columns content">
                        <span class="full-width {{ external_db_light }} label">{{ external_db_status }}</span>
                    </div>
                </li>
                <li>
                    <div class="small-5 columns content">
                        Email
                    </div>
                    <div class="small-7 columns content">
                        <span class="full-width {{ email_light }} label">{{ email_status }}</span>
                    </div>
                </li>
                <li>
                    <div class="small-5 columns content">
                        LDAP Primary
                    </div>
                    <div class="small-7 columns content">
                        <span class="full-width {{ ldap_light }} label">{{ ldap_status }}</span>
                    </div>
                </li>
                <li>
                    <div class="small-5 columns content">
                        LDAP Secondary
                    </div>
                    <div class="small-7 columns content">
                        <span class="full-width {{ ldap_alt_light }} label">{{ ldap_alt_status }}</span>
                    </div>
                </li>
                <li>
                    <div class="small-5 columns content">
                        WWW
                    </div>
                    <div class="small-7 columns content">
                        <span class="full-width {{ www_light }} label" data-light="www">{{ www_status }}</span>
                    </div>
                </li>
            </ul>
        </section>

        <!-- Role Statistics -->

        <h2 class="subheader">Role Statistics</h2>
        <section>
            <div class="loading"></div>
            <div class="scrollable">
                <table id="group-summary">
                    <colgroup>
                        <col width="50%" />
                        <col width="20%" />
                        <col width="30%" />
                    </colgroup>
                    <thead>
                    <tr>
                        <th>Role</th>
                        <th>Total</th>
                        <th>Logged In</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </section>

    </div>

    <!-- Recent Log Entries -->

    <div class="small-12 large-8 island">
        <div class="actions-small-2 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Recent Activity</h2>
                </div>
            </div>
            <nav>
                <a href="/adminv2/reports/login/all" class="icon-progress" title="Login Report"></a>
                <a href="/adminv2/reports/activity/all" class="icon-list" title="Activity Report"></a>
            </nav>
        </div>
        <section>
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Action</th>
                        <th>User</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        <tr>
                            <td>{{ log.date }}</td>
                            <td>{{ log.action }}</td>
                            <td>{{ log.name}}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </div>

</div>


