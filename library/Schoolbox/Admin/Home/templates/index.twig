{# Config page contents #}

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/highcharts.js"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/server-usage/jquery.server-usage.js"></script>
<script type="text/javascript">

    $(function() {
        var allCategories = [];
        var allSeriesData = [];
        var allTooltips = [];
        var allData = [];

        allData.push({
            label: 'Storage',
            value: parseFloat('{{ disk_percentage }}')
        });

        allTooltips.push('{{ disk_used }} / {{ disk_total }}');

        allData.push({
            label: 'Memory',
            value: parseFloat('{{ memory_percentage }}')
        });

        allTooltips.push('{{ memory_used }} / {{ memory_total }}');

        for (var i = 0; i < allData.length; i++) {
            allCategories.push(allData[i].label);
            allSeriesData.push(allData[i].value);
        }

        /* Render it out
         */
        $('[data-graph="usage"]').serverUsage({
            title: '',
            categories: allCategories,
            tooltip: {
                enabled: true,
                formatter: function() {
                    return allTooltips[this.point.x];
                }
            },
            series: [
                {
                    data: allSeriesData
                }
            ],
            formatter: function() {
                var str = '';

                if (this.y > 0) {
                    str = this.y + '%';
                }

                return str;
            }
        });
    });

    $(window).on('load', function () {

        // Test that the non-js page has not been requested

        if (window.location.pathname.indexOf("nojscript") == -1)
        {
            // Load the user statistics via ajax
            $.post('/ajax/adminStats.php', { module : 'users' }, function(data)
            {
                for (i in data)
                {
                    var row = data[i];

                    if(row.GROUP_ID > 0) {
                        $('<tr><td><a href="/adminv2/reports/group/' + row.GROUP_ID + '">' + row.GROUP_NAME +
                                '</a></td><td>' + row.GROUP_USER +
                                '</td><td>' + row.GROUP_LOGGED_IN + '</td></tr>').appendTo($('#group-summary'));
                    } else {
                        $('<tr><td>' + row.GROUP_NAME +
                                '</td><td>' + row.GROUP_USER +
                                '</td><td>' + row.GROUP_LOGGED_IN + '</td></tr>').appendTo($('#group-summary'));
                    }
                }
            });

            // Replace the default www status 'untested' with 'testing'
            $('[data-light="www"]').html('Testing...');

            // Load service statuses via ajax
            $.post('/ajax/adminStats.php', { module : 'service_www' }, function(data)
            {
                $('[data-light="www"]').html(data[0].WWW_STATUS).removeClass('neutral').addClass(data[0].WWW_LIGHT);
            });

            {% if saml_enabled %}
            // Replace the default saml status with 'loading...'
            $('[data-light="saml_cert"]').html('Loading...');
            // Load service statuses via ajax
            $.post('/ajax/adminStats.php', { module : 'service_saml_cert' }, function(data)
            {
                $('[data-light="saml_cert"]').html(data[0].SAML_MESSAGE).removeClass('neutral').addClass(data[0].SAML_LIGHT);
            });
            {% endif %}
        }
        {% if collabDocsEnabled %}
        // check if /pad is accessible
        $.ajax({
            url: '/pad',
            success: function() {
                $('[data-light="etherpad"]').html('Online').removeClass('neutral').addClass('success');
            },
            error: function() {
                $('[data-light="etherpad"]').html('Offline').removeClass('neutral').addClass('alert');
            }
        });
        {% endif %}

        {% if not is_cloud %}
        // check if https://api.schoolbox.cloud/urlCheck?url=http://$current_domain/.well-known/ping is accessible
        $.ajax({
            url: "{{ api_url }}/urlCheck/?url=http://" + location.hostname + "/.well-known/ping",
            success: function() {
                $('[data-light="port_80"]').html('Online').removeClass('neutral').addClass('success');
            },
            error: function() {
                $('[data-light="port_80"]').html('Offline').removeClass('neutral').addClass('alert');
            }
        });
        // check ntp status
        $.ajax({
            url: "/ajax/adminStats.php",
            data: { module : 'ntp' },
            method: "POST",
            success: function(data) {
                if (data.error !== undefined || data.diff === undefined) {
                    $('[data-light="ntp"]').html('Unavailable').removeClass('neutral').addClass('alert');
                } else if (data.diff >= 0 && data.diff <= 1) {
                    $('[data-light="ntp"]').html('OK').removeClass('neutral').addClass('success');
                } else if (data.diff > 1 && data.diff <= 5) {
                    $('[data-light="ntp"]').html('Drifted ' + data.diff + " seconds").removeClass('neutral').addClass('warning');
                } else {
                    $('[data-light="ntp"]').html('Drifted ' + data.diff + ' seconds').removeClass('neutral').addClass('alert');
                }
            }
        });
        // get ssl cert status
        $.ajax({
            url: "/ajax/adminStats.php",
            data: { module : 'ssl_cert' },
            method: "POST",
            success: function(data) {
                let status = "";
                let light = "";
                if (data.expiry < 0){
                    status = "Expired";
                    light = "alert";
                } else if (data.expiry < 30){
                    status = "Expires in " + data.expiry + " days";
                    light = "warning";
                    if (data.isCustomCert) {
                        status = "Unmanaged" + status;
                    }
                    if (data.expiry < 7) {
                        light = "alert";
                    }
                } else if (data.isCustomCert){
                    status = "Unmanaged";
                    light = 'warning';
                } else {
                    status = "Valid";
                    light = "success";
                }
                $('[data-light="cert_status"]').html(status).removeClass('neutral').addClass(light);
            }
        });
        {% endif %}
        {%  if ldap_enabled %}
        //set ldap status
        $.ajax({
            url: "/ajax/adminStats.php",
            method: "POST",
            data: {
                "module": "service_ldap"
            },
            success: function (data) {
                $('[data-light="ldap_status"]').html(data.ldap_status).removeClass('neutral').addClass(data.ldap_light);
                $('[data-light="ldap_alt_status"]').html(data.ldap_alt_status).removeClass('neutral').addClass(data.ldap_alt_light);
            }
        });
        {% endif %}
        // get rss feed
        $.ajax({
            url: "/ajax/adminStats.php",
            method: "POST",
            data: {
                "module": "rss"
            },
            success:function(data) {
                let html = '<h2 class=sub-header>Recent Updates</h2>';
                if (data.length > 0) {
                    html  += '<section><ul class="information-list">';
                    for (let row in data) {
                        let pubDate = new Date(data[row].pubDate.date);
                        options = {
                            weekday: 'long',
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                            hour: 'numeric',
                            minute: 'numeric',
                            hour12: true
                        };
                        let date = pubDate.toLocaleString(undefined, options);
                        html += "<li><div class='list-item'><div class='card small-12'><h3><a href='" + data[row].link + "'target='_blank'>" + data[row].title + "</a></h3><p class='meta'>Posted " + date + "</p></div></div></li>";
                    }
                    html += '</ul></section>';
                } else {
                    html += '<div class="empty-state"><i class="icon-rss"></i><p>We checked and there is no recent update news available.</p></div>';
                }
                $('div.rss-feed').html(html);
            }
        });
        {%  if external_db != 'Schoolbox' %}
        // get external db status
        $.ajax({
            url: "/ajax/adminStats.php",
            method: "POST",
            data: {
                "module": "service_external_db"
            },
            success:function(data) {
                let version = ""
                if (data.external_db_version !== "") {
                    version = " (" + data.external_db_version + ")";
                }
                $('[id="healthcheck-link"]').html(data.external_db + version) ;
                $('[data-light="external_db"]').html(data.external_db_status).removeClass('neutral').addClass(data.external_db_light);
            }
        });
        {% endif %}
        // get email status
        $.ajax({
            url: "/ajax/adminStats.php",
            method: "POST",
            data: {
                "module": "service_email"
            },
            success:function(data) {
                $('[data-light="email_status"]').html(data.email_status).removeClass('neutral').addClass(data.email_light);
            }
        });
        // get logs
        $.ajax({
            url: "/ajax/adminStats.php",
            method: "POST",
            data: {
                "module": "logs"
            },
            success:function (data) {
                let html = "";
                for (let row in data){
                    html += "<tr><td>" + data[row].date + "</td><td>"+ data[row].action + "</td><td>" + data[row].name + "</td></tr>"
                }
                $('tbody.logs').html(html);
            }
        });
        // get rabbitmq status
        $.ajax({
            url: "/ajax/adminStats.php",
            method: "POST",
            data: {
                "module": "rabbitmq"
            },
            success:function(data) {
                $('[data-light="rabbitmq"]').html(data.rabbitmq_status).removeClass('neutral').addClass(data.rabbitmq_light);
            }
        });
        // get turnitin status
        $.ajax({
            url: "/ajax/adminStats.php",
            method: "POST",
            data: {
                "module": "turnitin"
            },
            success:function(data) {
                if (data.show === true){
                    let light = "";
                    if (data.available) {
                        light = "success";
                    } else {
                        light = "alert";
                    }
                    $('[id="turnitin-url"]').attr('href', data.url).html(data.name);
                    $('[data-light="turnitin"]').html(data.message).removeClass('neutral').addClass(light);
                    $('[id="turnitin-block"]').removeAttr('hidden');
                }
            }
        });
        // get kami status
        $.ajax({
            url: "/ajax/adminStats.php",
            method: "POST",
            data: {
                "module": "kami"
            },
            success:function(data) {
                $('[data-light="kami"]').html(data.kami_status).removeClass('neutral').addClass(data.kami_light);
            }
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <!-- Upgrade Reminder -->
        {% if showUpgradeReminder %}
            {% include '@adminHome/upgrade-reminder.twig' %}
        {% endif %}

        <div class="row">
            <div class="small-12 large-5 island">

                <!-- Usage Graphs -->

                <h2 class="subheader">Server Usage</h2>
                {% if usageInGraph %}
                    <section>
                        <div data-graph="usage"></div>
                    </section>
                {% else %}
                    <table>
                        <tbody>
                        <tr><th>Storage</th><td>{{ disk_used }}</td></tr>
                        <tr><th>Memory</th><td>{{ memory_used }} / {{ memory_total }}</td></tr>
                        </tbody>
                    </table>
                {% endif %}

                <!-- Service Statuses -->

                <h2 class="subheader">Status of Services</h2>
                <section>
                    <ul class="information-list">
                        {% if external_db and external_db != 'Schoolbox' %}
                        <li>
                            <div class="small-5 columns content">
                                <a href="{{ routeLookup('adminHome.getHealthcheck') }}">{{ external_db }}</a>
                            </div>
                            <div class="small-7 columns content">
                                <span class="full-width neutral label" data-light="external_db">Testing...</span>
                            </div>
                        </li>
                        {% endif %}
                        <li>
                            <div class="small-5 columns content">
                                Email
                            </div>
                            <div class="small-7 columns content">
                                <span class="full-width neutral label" data-light="email_status">Testing...</span>
                            </div>
                        </li>
                        <li>
                            <div class="small-5 columns content">
                                Notifications
                            </div>
                            <div class="small-7 columns content">
                                <span class="full-width neutral label" data-light="rabbitmq">Testing...</span>
                            </div>
                        </li>
                        {% if ldap_enabled %}
                        <li>
                            <div class="small-5 columns content">
                                LDAP Primary
                            </div>
                            <div class="small-7 columns content">
                                <span class="full-width neutral label" data-light="ldap_status">Testing...</span>
                            </div>
                        </li>
                        <li>
                            <div class="small-5 columns content">
                                LDAP Secondary
                            </div>
                            <div class="small-7 columns content">
                                <span class="full-width neutral label" data-light="ldap_alt_status">Testing...</span>
                            </div>
                        </li>
                        {% endif %}
                        <li>
                            <div class="small-5 columns content">
                                WWW
                            </div>
                            <div class="small-7 columns content">
                                <span class="full-width neutral label" data-light="www">Testing...</span>
                            </div>
                        </li>
                        {% if collabDocsEnabled %}
                        <li>
                            <div class="small-5 columns content">
                                Collab Docs
                            </div>
                            <div class="small-7 columns content">
                                <span class="full-width neutral label" data-light="etherpad">Testing...</span>
                            </div>
                        </li>
                        {% endif %}
                            <li>
                                <div class="small-5 columns content"><a href="https://status.kamihq.com/" target="_blank">Kami</a></div>
                                <div class="small-7 columns content">
                                    <span class="full-width neutral label" data-light="kami">Testing...</span>
                                </div>
                            </li>
                        {% set drRoute = routeLookupIfAuthorized('adminHome.getDisasterRecovery') %}
                        {% if drRoute %}
                            <li>
                                <div class="small-5 columns content">
                                    <a href="{{ drRoute }}">Disaster Recovery</a>
                                </div>
                                <div class="small-7 columns content">
                                    <span class="full-width {% if backupsEnabled %}success{% else%}highlight{% endif %} label">{% if backupsEnabled %}Enabled{% else%}Disabled{% endif %}</span>
                                </div>
                            </li>
                        {% endif %}

                        {# Optionally show turnitin status #}
                            <li id="turnitin-block" hidden>
                                <div class="small-5 columns content">
                                    <a id="turnitin-url" href="" target="_blank"></a>
                                </div>
                                <div class="small-7 columns content">
                                    <span class="full-width success neutral label" data-light="turnitin">Testing...</span>
                                </div>
                            </li>
                        {# Show ssh + SSL cert status if not cloud hosted #}
                        {% if not is_cloud %}
                            <li>
                                <div class="small-5 columns content">
                                    Support Available
                                </div>
                                <div class="small-7 columns content">
                                    <span class="full-width {{ ssh_light }} label" data-light="ssh">{{ ssh_status }}</span>
                                </div>
                            </li>
                            <li>
                                <div class="small-5 columns content">
                                    SSL Certificate
                                </div>
                                <div class="small-7 columns content">
                                    <span class="full-width neutral label" data-light="cert_status">Testing...</span>
                                </div>
                            </li>
                            {% if show_port_80_availability_check %}
                            <li>
                                <div class="small-5 columns content">
                                    SSL Renewal
                                </div>
                                <div class="small-7 columns content">
                                    <span class="full-width neutral label" data-light="port_80">Testing...</span>
                                </div>
                            </li>
                            {% endif %}


                            {% if suds_import_data_enabled %}
                                {% for importLog in suds_import_logs %}
                                    <li>
                                        <div class="small-5 columns content">
                                            {% set route = routeLookup('adminImportIndex.getSchoolDataIndex') %}
                                            <a href="{{ route }}#previous">{{ importLog.script }}</a>
                                        </div>
                                        <div class="small-7 columns content">
                                            {% if importLog.isComplete %}
                                                <span class="full-width success label" title="{{ importLog.finishAt.local }}">Complete</span>
                                            {% elseif importLog.isRunning %}
                                                <span class="full-width warning label" title="Started at {{ importLog.startAt.local }}">In Progress</span>
                                            {% elseif importLog.isError %}
                                                <span class="full-width alert label">Error</span>
                                            {% endif %}
                                        </div>
                                    </li>
                                {% endfor %}
                            {% endif %}
                            <li>
                                <div class="small-5 columns content">
                                    NTP Drift
                                </div>
                                <div class="small-7 columns content">
                                    <span class="full-width neutral label" data-light="ntp">Testing...</span>
                                </div>
                            </li>
                            {% if saml_enabled %}
                            <li>
                                <div class="small-5 columns content">
                                    SAML Public Cert Expiry
                                </div>
                                <div class="small-7 columns content">
                                    <span class="full-width neutral label" data-light="saml_cert">loading...</span>
                                </div>
                            </li>
                            {% endif %}
                        {% endif %}
                    </ul>
                </section>

                <!-- Role Statistics -->

                <h2 class="subheader">Role Statistics</h2>
                <section>
                    <div class="loading"></div>
                    <div class="scrollable">
                        <table id="group-summary">
                            <colgroup>
                                <col width="50%" />
                                <col width="20%" />
                                <col width="30%" />
                            </colgroup>
                            <thead>
                            <tr>
                                <th>Role</th>
                                <th>Total</th>
                                <th>Logged In</th>
                            </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <!-- Recent Log Entries -->

            <div class="small-12 large-7 island">
                <div class="rss-feed">
                    <h2 class="subheader">Recent Updates</h2>
                    <div class="empty-state">
                        <i class="icon-rss"></i>
                        <p>Loading...</p>
                    </div>
                </div>
                <div class="actions-small-2 row">
                    <div class="list-item">
                        <div class="small-12 columns">
                            <h2 class="subheader">Recent Activity</h2>
                        </div>
                    </div>
                    <nav>
                        <a href="/adminv2/reports/login/all" class="icon-progress" title="Login Report"></a>
                        <a href="/adminv2/reports/activity/all" class="icon-list" title="Activity Report"></a>
                    </nav>
                </div>
                <section>
                    <table>
                        <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>User</th>
                        </tr>
                        </thead>
                        <tbody class="logs">
                        </tbody>
                    </table>
                </section>
            </div>

        </div>
    </div>
</div>


