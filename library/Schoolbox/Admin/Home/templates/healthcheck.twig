{{ renderAdminNavigation(pageCurrent) }}

<sec class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ output['externalType'] }} Database Health Check</h2>

        {% if output['errors'] | length %}
            {% for error in output['errors'] %}
                <div data-alert class="alert-box alert">
                    {{ error }}
                </div>
            {% endfor %}
        {% else %}
            <div data-alert class="alert-box success">
                No Errors Detected
            </div>
        {% endif %}

        {% if output['log'] is not empty %}
            <section class="content">
                <pre>{{ output['log'] }}</pre>
            </section>
        {% endif %}
    </div>
</sec>