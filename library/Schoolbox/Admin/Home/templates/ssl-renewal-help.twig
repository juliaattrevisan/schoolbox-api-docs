{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

{% set
    PORT_80_BLOCKED,
    HTTPS_UPGRADE,
    UPSTREAM_ERROR,
    USER_AGENT_BLOCKING,
    GEOBLOCKING
    =
    'ssl_port_80',
    'ssl_https_upgrade',
    'ssl_upstream_error',
    'ssl_user_agent',
    'ssl_geoblocking'
%}

<script>
    const LETS_ENCRYPT_USER_AGENT_STRING = 'Mozilla/5.0 (compatible; Let\'s Encrypt validation server; +https://letsencrypt.org)';
    const CHROME_USER_AGENT_STRING = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.36';

    const PORT_80_BLOCKED        = {{ PORT_80_BLOCKED }};
    const HTTPS_UPGRADE          = {{ HTTPS_UPGRADE }};
    const UPSTREAM_ERROR         = {{ UPSTREAM_ERROR }};
    const USER_AGENT_BLOCKING    = {{ USER_AGENT_BLOCKING }};
    const GEOBLOCKING            = {{ GEOBLOCKING }};

    const API_ENDPOINT = '/urlCheck/v2';
    const CURRENT_HOSTNAME = location.hostname;
    const URL_TO_CHECK = 'http://' + CURRENT_HOSTNAME + '/.well-known/acme-challenge/ping';

    //General function for building a string of the keys and values in an object
    function buildHeadersString(headersObj) {
        let headersString = '';
        for (const [key,value] of Object.entries(headersObj)) {
            headersString += key + ': ' + value + "\n";
        }
        return headersString
    }

    //General function for updating labels
    function updateStatusBar(dataLight, text, colour) {
        $('[data-light=' + dataLight + ']').html(text).removeClass('neutral').addClass(colour);
    }

    //If present, shows the server header on the page so that the user knows what service is causing the issue
    function updateServer(text) {
        const span = document.getElementById("https_upgrade_server_span");
        const div = document.getElementById("https_upgrade_server_div");
        span.innerText = text;
        div.classList.remove('hide');
    }

    //Populate the request details part of the page
    function updateRequestDetails(type, uri, headersString) {
        document.getElementById("request_type").innerText = type;
        document.getElementById("request_uri").innerText = uri;
        document.getElementById("request_headers").innerText = headersString;
    }

    //Shows the user what response the API is getting
    function updateResponseDetails(statusCode, headersString, body, createLinkOnStatusCode=false) {
        let statusCodeHTMLString;
        if (createLinkOnStatusCode) {
            const statusCodeATag = document.createElement("a");
            statusCodeATag.setAttribute("href", "https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/" + statusCode);
            statusCodeATag.innerText = statusCode;
            statusCodeHTMLString = statusCodeATag.outerText;
        } else {
            statusCodeHTMLString = statusCode;
        }

        document.getElementById("response_status").innerText = statusCodeHTMLString ? statusCodeHTMLString : "(nothing to show)";
        document.getElementById("response_headers").innerText = headersString ? headersString : "(nothing to show)";
        document.getElementById("response_body").innerText = body ? body : "(nothing to show)";
    }

    $(window).on('load', function () {
        updateRequestDetails(
                "GET",
                URL_TO_CHECK,
                buildHeadersString({
                    "user-agent": LETS_ENCRYPT_USER_AGENT_STRING,
                }),
        );

        const baseCheck = $.ajax({
            url: "{{ api_url }}" + API_ENDPOINT + "?url=" + encodeURIComponent(URL_TO_CHECK),
            success: function (result, status, xhr) {
                if (xhr.responseJSON.message === "Request timeout occurred") {
                    updateResponseDetails("", "", "", false);
                    updateStatusBar(PORT_80_BLOCKED, "Fail: Timeout", "alert");
                    updateStatusBar(HTTPS_UPGRADE, "Indeterminate", "warning");
                    updateStatusBar(UPSTREAM_ERROR, "Fail: Timeout", "alert");
                } else {
                    updateResponseDetails(
                            xhr.responseJSON.response.status,
                            buildHeadersString(xhr.responseJSON.response.headers),
                            xhr.responseJSON.response.body,
                            true
                    );
                    if (xhr.responseJSON.response.status === 200) {
                        updateStatusBar(PORT_80_BLOCKED, "Pass", "success");
                        updateStatusBar(HTTPS_UPGRADE, "Pass", "success");
                        updateStatusBar(UPSTREAM_ERROR, "Pass", "success");
                    } else {
                        updateStatusBar(PORT_80_BLOCKED, "Fail", "alert");
                        updateStatusBar(UPSTREAM_ERROR, "Fail", "alert");
                        if ('location' in xhr.responseJSON.response.headers) {
                            if (xhr.responseJSON.response.headers['location'].startsWith("https")) {
                                if ('server' in xhr.responseJSON.response.headers) {
                                    const serverResponseHeader = xhr.responseJSON.response.headers['server']
                                    updateStatusBar(HTTPS_UPGRADE, "Fail: Check " + serverResponseHeader, "alert");
                                    updateServer(serverResponseHeader);
                                } else {
                                    updateStatusBar(HTTPS_UPGRADE, "Fail", "alert");
                                }
                            } else {
                                updateStatusBar(HTTPS_UPGRADE, "Indeterminate", "warning");
                            }
                        } else {
                            updateStatusBar(HTTPS_UPGRADE, "Indeterminate", "warning");
                        }
                    }
                }
            },
            error: function (xhr, status, error) {
                updateResponseDetails("", "", "", false);

                let errorMessage;
                if (status === 400) {
                    errorMessage = 'Schoolbox error';
                } else if (status === 500) {
                    errorMessage = 'API error';
                } else {
                    errorMessage = 'Unknown error';
                }

                updateStatusBar(PORT_80_BLOCKED, errorMessage, "alert");
                updateStatusBar(HTTPS_UPGRADE, errorMessage, "alert");
                updateStatusBar(UPSTREAM_ERROR, errorMessage, "alert");
            },
        });

        $.ajax({
            url: "{{ api_url }}" + API_ENDPOINT + "?url=" + encodeURIComponent(URL_TO_CHECK) + "&useragent=" + encodeURIComponent(CHROME_USER_AGENT_STRING),
            success: function (chromeResult, chromeStatus, chromeXhr) {
                // wait for baseCheck to complete
                $.when(baseCheck).then(
                    function(baseResult, baseStatus, baseXhr) {
                        //if neither url check timed out
                        if (chromeXhr.responseJSON.message === "Response received" && baseXhr.responseJSON.message === "Response received") {
                            //if both checks pass
                            if (chromeXhr.responseJSON.response.status === 200 && chromeXhr.responseJSON.response.status === 200) {
                                updateStatusBar(USER_AGENT_BLOCKING, "Pass", "success");
                            }
                            //if chrome user agent check passes but let's encrypt user agent check fails
                            else if (chromeXhr.responseJSON.response.status !== 200 && chromeXhr.responseJSON.response.status === 200) {
                                updateStatusBar(USER_AGENT_BLOCKING, "Fail", "alert");
                            }
                            else {
                                updateStatusBar(USER_AGENT_BLOCKING, "Indeterminate", "warning");
                            }
                        }
                        //if either or both url checks timed out
                        else {
                            updateStatusBar(USER_AGENT_BLOCKING, "Indeterminate", "warning");
                        }
                    },
                    function(baseXhr, baseStatus, baseError) {
                        updateStatusBar(USER_AGENT_BLOCKING, "Indeterminate", "warning");
                    }
                )
            },
            error: function (xhr, status, error) {
                let errorMessage;
                if (status === 400) {
                    errorMessage = 'Schoolbox error';
                } else if (status === 500) {
                    errorMessage = 'API error';
                } else {
                    errorMessage = 'Unknown error';
                }
                updateStatusBar(USER_AGENT_BLOCKING, errorMessage, "alert");
            },
        });
    });
</script>

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <h2 class="subheader">SSL Renewal Help</h2>
            <section class="content">
                <article>
                    <p>
                        This page is intended to assist IT systems administrators who manage their school's firewall and on-premises Schoolbox server in troubleshooting their firewall and network configuration to allow automatic SSL renewal.
                    </p>
                    <h3>Schoolbox's SSL certificate policy</h3>
                    <p>
                        Schoolbox uses Let's Encrypt as a certificate provider and uses Certbot to manage these certificates. Our Certbot scripts are configured to provision certs with 3 months of validity. Certbot will automatically attempt to renew SSL certificates when the current certs have less than 30 days of validity.
                    </p>
                    <p>
                        There are times when this automatic certificate renewal process fails. Most of the time, all is needed is a small change in the firewall configuration to allow this traffic through to the Schoolbox server. This page is intended to assist in diagnosing the cause and finding the change that needs to be made.
                    </p>
                    <div class="alert-box highlight no-margin">
                        <p>
                            While this page attempts to aid self-diagnosis of SSL renewal issues using the tests above, the accuracy of the results cannot be guaranteed. The information on this page is provided to aid troubleshooting and should not be taken as 100% fact. Schoolbox takes no responsibility for the changes made to your firewall as a result of the information provided by this page.
                        </p>
                    </div>
                </article>
            </section>
        </div>
        <div class="small-12 island">
            <h3 class="subheader">Troubleshooting</h3>
            <section>
                <ol class="information-list expandable-card">
                    <li>
                        <div id="{{ PORT_80_BLOCKED }}">
                            <div class="expander icon-down-arrow" data-collapser="{{ PORT_80_BLOCKED }}"></div>
                            <div class="column-left columns content">
                                <h3 class="no-margin">Port 80 timeout</h3>
                            </div>
                            <div class="column-right content">
                                <span class="full-width no-margin neutral label" data-light="{{ PORT_80_BLOCKED }}"><span class="loader"></span></span>
                            </div>
                        </div>
                        <div class="content small-12 column" data-collapse-state="collapsed" data-collapsable="{{ PORT_80_BLOCKED }}" style="display: none;">
                            <article>
                                <h5>Problem</h5>
                                <p>Let's Encrypt sends domain verification requests via HTTP on port 80. If port 80 traffic is restricted, that could be causing SSL certificate renewal requests to fail.</p>
                                <h5>Common causes</h5>
                                <ol>
                                    <li>A firewall may be restricting traffic on port 80</li>
                                    <li>A firewall may be restricting HTTP requests</li>
                                    <li>A firewall if restricting traffic from the US/EU (see <a href="#{{ GEOBLOCKING }}">Geoblocking</a>)</li>
                                </ol>
                                <h5>Resolution steps</h5>
                                <p>Review the firewall configuration and ensure that HTTP traffic on port 80 is able to reach the Schoolbox server directly. For more information, visit <a href="https://help.schoolbox.com.au/homepage/483#component6918">Schoolbox Help - System Requirements - Security, Firewall and Ports</a>.</p>
                            </article>
                        </div>
                    </li>
                    <li>
                        <div id="{{ HTTPS_UPGRADE }}">
                            <div class="expander icon-down-arrow" data-collapser="{{ HTTPS_UPGRADE }}"></div>
                            <div class="column-left columns content">
                                <h3 class="no-margin">HTTP > HTTPS upgrade</h3>
                            </div>
                            <div class="column-right content">
                                <span class="full-width no-margin neutral label" data-light="{{ HTTPS_UPGRADE }}"><span class="loader"></span></span>
                            </div>
                        </div>
                        <div class="content small-12 column" data-collapse-state="collapsed" data-collapsable="{{ HTTPS_UPGRADE }}" style="display: none;">
                            <article>
                                <h5>Problem</h5>
                                <p>Let's Encrypt domain verification requests are made with HTTP. If these requests are escalated to HTTPS, Schoolbox will redirect this unauthenticated traffic to the Schoolbox login page and the SSL certificate renewal process will fail.</p>
                                <h5>Common cause</h5>
                                <ul>
                                    <li>A service upstream of the Schoolbox server may be intercepting Let's Encrypt's requests and escalating it from HTTP to HTTPS</li>
                                </ul>
                                <h5>Resolution steps</h5>
                                <p>Review the firewall configuration and ensure that HTTP traffic on port 80 is able to reach the Schoolbox server directly. For more information, visit <a href="https://help.schoolbox.com.au/homepage/483#component6918">Schoolbox Help - System Requirements - Security, Firewall and Ports</a>.</p>
                                <div id="https_upgrade_server_div" class="alert-box highlight no-margin hide">
                                    <p>
                                        Our test has identified that the service causing the HTTP to HTTPS escalation identifies itself as
                                        <code id="https_upgrade_server_span" class=""></code>.
                                        Please review the configuration of this service and remove the rules that are redirecting HTTP requests to HTTPS.
                                    </p>
                                </div>
                            </article>
                        </div>
                    </li>
                    <li>
                        <div id="{{ UPSTREAM_ERROR }}">
                            <div class="expander icon-down-arrow" data-collapser="{{ UPSTREAM_ERROR }}"></div>
                            <div class="column-left columns content">
                                <h3 class="no-margin">Upstream error</h3>
                            </div>
                            <div class="column-right content">
                                <span class="full-width no-margin neutral label" data-light="{{ UPSTREAM_ERROR }}"><span class="loader"></span></span>
                            </div>
                        </div>
                        <div class="content small-12 column" data-collapse-state="collapsed" data-collapsable="{{ UPSTREAM_ERROR }}" style="display: none;">
                            <article>
                                <h5>Problem</h5>
                                <p>'Upstream error' is an umbrella term for any number of issues that could be restricting the Let's Encrypt requests trying to reach the Schoolbox server.</p>
                                <h5>Common causes</h5>
                                <ol>
                                    <li>A firewall/service may be severing the connection that Let's Encrypt is trying to establish</li>
                                    <li>A firewall/service may be filtering Let's Encrypt requests based on some kind of 'smart filtering' feature</li>
                                    <li>A firewall/service placed in front may be filtering Let's Encrypt requests based on their use of the <code>acme-challenge</code> application protocol</li>
                                </ol>
                                <h5>Resolution steps</h5>
                                <p>Check the configuration of any security infrastructure placed in front of Schoolbox and ensure that Let's Encrypt traffic is able to reach the Schoolbox server directly.</p>
                            </article>
                        </div>
                    </li>
                    <li>
                        <div id="{{ USER_AGENT_BLOCKING }}">
                            <div class="expander icon-down-arrow" data-collapser="{{ USER_AGENT_BLOCKING }}"></div>
                            <div class="column-left columns content">
                                <h3 class="no-margin">User agent blocking</h3>
                            </div>
                            <div class="column-right content">
                                <span class="full-width no-margin neutral label" data-light="{{ USER_AGENT_BLOCKING }}"><span class="loader"></span></span>
                            </div>
                        </div>
                        <div class="content small-12 column" data-collapse-state="collapsed" data-collapsable="{{ USER_AGENT_BLOCKING }}" style="display: none;">
                            <article>
                                <h5>Problem</h5>
                                <p>Let's Encrypt domain verification requests use the user-agent header <code>Mozilla/5.0 (compatible; Let's Encrypt validation server; +https://letsencrypt.org)</code>. Some firewalls may block this user-agent when they do not recognise it.</p>
                                <h5>Common causes</h5>
                                <ul>
                                    <li>A firewall/service placed in front of the Schoolbox server may be blocking requests with the Let's Encrypt user agent.</li>
                                </ul>
                                <h5>Resolution steps</h5>
                                <p>Whitelist traffic matching the Let's Encrypt domain verification requests (see <a href="#request-details">Let's Encrypt request details</a>).</p>
                            </article>
                        </div>
                    </li>
                    <li>
                        <div id="{{ GEOBLOCKING }}">
                            <div class="expander icon-down-arrow" data-collapser="{{ GEOBLOCKING }}"></div>
                            <div class="column-left columns content">
                                <h3 class="no-margin">Geoblocking</h3>
                            </div>
                            <div class="column-right content">
                                <span class="full-width no-margin neutral label" data-light="{{ GEOBLOCKING }}">No test available</span>
                            </div>
                        </div>
                        <div class="content small-12 column" data-collapse-state="collapsed" data-collapsable="{{ GEOBLOCKING }}" style="display: none;">
                            <article>
                                <h5>Problem</h5>
                                <p>Let's Encrypt domain verification requests can come from a range of IP addresses around world including the US, EU, etc. Blocking web requests from specific regions can cause Let's Encrypt domain verification to fail.</p>
                                <h5>Common causes</h5>
                                <ul>
                                    <li>A firewall/service placed in front of Schoolbox may be blocking web requests from certain regions based on IP ranges (aka 'geoblocking')</li>
                                </ul>
                                <h5>Resolution steps</h5>
                                <ul>
                                    <li>Review the firewall configuration and remove any rules that are geoblocking HTTP requests on port 80.</li>
                                </ul>
                            </article>
                        </div>
                    </li>
                </ol>
                <script type="text/javascript">
                    $(function () {
                        $('[data-collapser]').collapsable();
                    });
                </script>
            </section>
        </div>
        <div id="request-details">
            <div class="medium-12 large-6 island">
                <h3 class="subheader">Let's Encrypt request details</h3>
                <section>
                    <ol class="information-list">
                        <li class="">
                            <div class="large-12 xlarge-3 columns content">
                                <h5 class="no-margin">Request type:</h5>
                            </div>
                            <div class="large-12 xlarge-9 alert-box highlight columns no-margin">
                                <pre id="request_type">Loading...</pre>
                            </div>
                        </li>
                        <li class="">
                            <div class="large-12 xlarge-3 columns content">
                                <h5 class="no-margin">Request URI:</h5>
                            </div>
                            <div class="large-12 xlarge-9 alert-box highlight columns no-margin">
                                <pre id="request_uri">Loading...</pre>
                            </div>
                        </li>
                        <li class="">
                            <div class="large-12 xlarge-3 columns content">
                                <h5 class="no-margin">Request headers:</h5>
                            </div>
                            <div class="large-12 xlarge-9 alert-box highlight columns no-margin">
                                <pre id="request_headers">Loading...</pre>
                            </div>
                        </li>
                    </ol>
                </section>
            </div>
        </div>
        <div id="response-details">
            <div class="medium-12 large-6 island">
                <h3 class="subheader">Response details</h3>
                <section>
                    <ol class="information-list">
                        <li class="">
                            <div class="large-12 xlarge-3 columns content">
                                <h5 class="no-margin">Response status code:</h5>
                            </div>
                            <div class="large-12 xlarge-9 alert-box highlight columns no-margin">
                                <pre id="response_status"><span class="loader"></span></pre>
                            </div>
                        </li>
                        <li class="">
                            <div class="large-12 xlarge-3 columns content">
                                <h5 class="no-margin">Response headers:</h5>
                            </div>
                            <div class="large-12 xlarge-9 alert-box highlight columns no-margin">
                                <pre id="response_headers"><span class="loader"></span></pre>
                            </div>
                        </li>
                        <li class="">
                            <div class="large-12 xlarge-3 columns content">
                                <h5 class="no-margin">Response body:</h5>
                            </div>
                            <div class="large-12 xlarge-9 alert-box highlight columns no-margin">
                                <pre id="response_body"><span class="loader"></span></pre>
                            </div>
                        </li>
                    </ol>
                </section>
            </div>
        </div>
    </div>
</div>
