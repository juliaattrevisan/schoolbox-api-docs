{#
data:
    pageCurrent:    string     - current breakcrumb path
    allBreadcrumbs: string[][] - all breadcrumbs to render
    is_cloud:       bool       - is this a cloud instance
    api_url:        string     - Lamda API URL (without the path. If you're testing with local API you may need to edit API_ENDPOINT below)
    hostnames:      string[]   - Hostnames for this instance
    primaryDomain:  string     - primary domain for this instance
#}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

{# Used by both HTML + JS #}
{% set USER_AGENT_STRING_LETS_ENCRYPT = 'Mozilla/5.0 (compatible; Let\'s Encrypt validation server; +https://letsencrypt.org)' %}
{% set USER_AGENT_STRING_CHROME       = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.36' %}


<script>
    const USER_AGENT_STRING_LETS_ENCRYPT = '{{ USER_AGENT_STRING_LETS_ENCRYPT }}';
    const USER_AGENT_STRING_CHROME       = '{{ USER_AGENT_STRING_CHROME }}';
    const EXPECTED_RESPONSE_BODY         = "port 80 accessible from your location\n"
    const EXPECTED_SERVER_HEADER         = "nginx"
    const API_ENDPOINT                   = '/urlCheck/v2';            // Set to "/v2" if testing against local SAM api
    const HOSTNAMES                      = [{% for h in hostnames %}"{{ h }}"{% if not loop.last %},{% endif %}{% endfor %}]

    function getUrlToCheckFromHostname(hostname){
        return 'http://' + hostname + '/.well-known/acme-challenge/ping';
    }

    /**
     * Escapes the provided HTML string and returns the escaped value.
     *
     * @param {string} html
     * @returns {string}
     */
    function escapeHtml(html) {
        return html
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;")
                .replace(/\n/g, "<br>");
    }

    /**
     * General function for building a string of the keys and values in an object
     *
     * @param {object} headersObj
     * @returns {string}
     */
    function buildHeadersString(headersObj) {
        let headersString = '';
        for (const [key, value] of Object.entries(headersObj)) {
            headersString += key + ': ' + value + "\n";
        }
        return headersString
    }

    /**
     * Updates the 'DIAGNOSTICS' alert box
     *
     * @param {int} idx   Hostname index
     * @param {string} html   Text to display
     * @param {string} colour A CSS class
     */
    function updateDiagnosticsAlertBox(idx, html, colour) {
        let elem = document.getElementById("diagnostics-" + idx)
        elem.innerHTML = html;
        elem.classList.add(colour)
    }

    /**
     * Updates the 'COMMON CAUSES' text.
     *
     * noop if text is an empty string.
     *
     * @param {int} idx   Hostname index
     * @param {string} innerHtml
     */
    function displayCommonCauses(idx, innerHtml) {
        if (innerHtml !== "") {
            document.getElementById("common-causes-wrap-" + idx).classList.remove("hide")
            document.getElementById("common-causes-" + idx).innerHTML = innerHtml
        }
    }

    /**
     * Updates the 'RESOLUTION' text
     *
     * @param {int} idx   Hostname index
     * @param {string} innerHtml
     */
    function displayResolutionText(idx, innerHtml) {
        document.getElementById("resolution-wrap-" + idx).classList.remove("hide")
        document.getElementById("resolution-" + idx).innerHTML = innerHtml
    }

    /**
     * Displays details of the response received by Lambda API from Schoolbox
     *
     * @param {int} idx   Hostname index
     * @param {string} userAgent
     * @param {object} response
     */
    function displayResponseDetails(idx, userAgent, response) {
        let status  = Object.hasOwn(response, "status") ? response.status : null;
        let headers = Object.hasOwn(response, "headers") ? response.headers : {};
        let body    = Object.hasOwn(response, "body") ? response.body : "";
        switch (userAgent) {
            case USER_AGENT_STRING_LETS_ENCRYPT:
                displayLetsEncryptResponseDetails(idx, status, headers, body)
                return;
            case USER_AGENT_STRING_CHROME:
                displayChromeResponseDetails(idx, status, headers, body)
                return;
        }
        throw new Error('Unrecognised userAgent: ' + userAgent);
    }

    /**
     * Displays the details of the response received by Lambda API when userAgent is LE
     *
     * @param {int} idx   Hostname index
     * @param {int|null} statusCode
     * @param {object} headers
     * @param {string} body
     */
    function displayLetsEncryptResponseDetails(idx, statusCode, headers, body) {
        let headersString = buildHeadersString(headers);
        document.getElementById("request-response-letsencrypt-" + idx).classList.remove("hide")
        document.getElementById("response-status-letsencrypt-" + idx).innerHTML = statusCode !== null ? statusCode.toString() : "(nothing to show)";
        document.getElementById("response-headers-letsencrypt-" + idx).innerText = headersString ? headersString : "(nothing to show)";
        document.getElementById("response-body-letsencrypt-" + idx).innerText = body ? body : "(nothing to show)";
    }

    /**
     * Displays the details of the response received by Lambda API when userAgent is Chrome
     *
     * @param {int} idx   Hostname index
     * @param {int|null} statusCode
     * @param {object} headers
     * @param {string} body
     */
    function displayChromeResponseDetails(idx, statusCode, headers, body) {
        let headersString = buildHeadersString(headers);
        document.getElementById("request-response-chrome-" + idx).classList.remove("hide")
        document.getElementById("response-status-chrome-" + idx).innerHTML = statusCode !== null ? statusCode.toString() : "(nothing to show)";
        document.getElementById("response-headers-chrome-" + idx).innerText = headersString ? headersString : "(nothing to show)";
        document.getElementById("response-body-chrome-" + idx).innerText = body ? body : "(nothing to show)";
    }


    /**
     * Test URL w/ Chrome userAgent to determine if that is the sole reason for failure.
     *
     * If the Chrome test fails too, then just render the LE diagnosis/common-causes/resolution.
     * If the Chrome test succeeds, we can assume the issue is userAgent-dependent filtering.
     *
     * @param {int} idx   Hostname index
     * @param failedLetsEncryptXhr The failing XHR with the LE UserAgent
     * @param diagnosticHtml       Diagnostics for the LE request
     * @param commonCausesHtml     Common Causes of the failure of the LE request
     * @param resolutionHtml       Suggested resolution
     */
    function testChromeUserAgent(idx, failedLetsEncryptXhr, diagnosticHtml, commonCausesHtml, resolutionHtml) {
        let urlToCheck = getUrlToCheckFromHostname(HOSTNAMES[idx]);
        $.ajax({
            url: "{{ api_url }}" + API_ENDPOINT + "?url=" + encodeURIComponent(urlToCheck) + "&useragent=" + encodeURIComponent(USER_AGENT_STRING_CHROME),
            complete: function (chromeXhr) {
                // Did the Chrome request succeeds where the LE request failed?
                if (
                        chromeXhr.status === 200 &&
                        Object.hasOwn(chromeXhr.responseJSON, "message") &&
                        chromeXhr.responseJSON.message === "Response received" &&
                        chromeXhr.responseJSON.response.body === EXPECTED_RESPONSE_BODY
                ) {
                    diagnosticHtml += "<p>An upstream network component appears to be blocking the Let's Encrypt user agent (<code>" + USER_AGENT_STRING_LETS_ENCRYPT + "</code>).</p>";
                    updateDiagnosticsAlertBox(idx, diagnosticHtml, "alert")
                    displayCommonCauses(
                            idx,
                            "<ul>" +
                            "<li>A firewall/service placed in front may be filtering Let's Encrypt requests based on their use of the <code>acme-challenge</code> application protocol</li>" +
                            "<li>A firewall/service placed in front of the Schoolbox server may be blocking requests with the Let's Encrypt user agent.</li>" +
                            "</ul>"
                    );
                    displayResolutionText(
                            idx,
                            "<p>Test results indicate requests are being filtered depending on the value of the <strong>user-agent</strong> request header.<br>" +
                            "A request with <strong>user-agent</strong> set to <code>" + USER_AGENT_STRING_LETS_ENCRYPT + "</code> failed, " +
                            "whereas a request with <strong>user-agent</strong> set to <code>" + USER_AGENT_STRING_CHROME + "</code> succeeded.<br>" +
                            "The former is used by real domain validation requests sent from Let's Encrypt servers. " +
                            "The latter is commonly used by browsers.<br>" +
                            "Check the configuration of any security infrastructure placed in front of Schoolbox and ensure that Let's Encrypt " +
                            "traffic is able to reach the Schoolbox server directly.</p>"
                    );
                    displayResponseDetails(idx, USER_AGENT_STRING_CHROME, chromeXhr.responseJSON.response)
                } else {
                    // Both LE + Chrome test failed. Just render LE failure.
                    updateDiagnosticsAlertBox(idx, diagnosticHtml, "alert")
                    displayCommonCauses(idx, commonCausesHtml)
                    displayResolutionText(idx, resolutionHtml)
                }
            },
        });
    }

    $(window).on('load', function () {
        HOSTNAMES.forEach(function(hostname, idx){
            let urlToCheck = getUrlToCheckFromHostname(hostname);

            // Set the Request URI. Need to execute this via JS to read domain being presented to client.
            document.getElementById("request-uri-letsencrypt-" + idx).innerText = urlToCheck;
            document.getElementById("request-uri-chrome-" + idx).innerText = urlToCheck;

            // Call LambdaAPI w/ UserAgent=LetsEncrypt
            // Cases:
            //  1. connection closed
            //  2. 200, message="Response received", response.status=200, response.body="port 80 accessible from your location"   > PASS
            //  3. 200, message="Response received", response.status=200, response.body=!"port 80 accessible from your location"  > FAIL - Not Schoolbox
            //  4. 200, message="Response received", response.status=!200                                                         > FAIL - Not Schoolbox
            //  5. 200, message="Request timeout occurred"
            //  6. 200, message=null
            //  7. 400, message="No URL supplied"
            //  8. 400, message="Malformed URL supplied - unable to decode"
            //  9. 400, message="Malformed URL supplied - not a valid URL string"
            // 10. 400, message="Malformed User-Agent supplied - unable to decode"
            // 11. 400, message=null                                                                                              > FAIL - NOT API
            // 12. 500, message="Internal error encountered"                                                                      > FAIL - API Error
            // 13. 500, message=null                                                                                              > FAIL - Not API | Uncaught error
            // 14. !in(200,400,500)                                                                                               > FAIL - NOT API
            $.ajax({
                url: "{{ api_url }}" + API_ENDPOINT + "?url=" + encodeURIComponent(urlToCheck),
                complete: function (xhr) {
                    // Unable to communicate w/ Lambda API
                    // * Lambda API offline
                    // * Network issues between browser + Lambda API
                    if (xhr.readyState !== 4) {
                        updateDiagnosticsAlertBox(idx, "Diagnostic API offline", "alert")
                        displayResolutionText(idx, "<p>Check your internet connection. If issue persists, please report issue to Schoolbox Support</p>");
                        return;
                    }

                    // Unrecognised Lambda API response?
                    // * request intercepted (e.g. by outbound firewall) and not coming from our Lambda API
                    // * invalid Lambda API response structure
                    if (!Object.hasOwn(xhr, "responseJSON") || !Object.hasOwn(xhr.responseJSON, "message")) {
                        updateDiagnosticsAlertBox(idx, "Unrecognised Diagnostic API response", "alert")
                        displayResolutionText(idx, "<p>Check your internet connection. If issue persists, please report issue to Schoolbox Support</p>");
                        return;
                    }

                    let message = xhr.responseJSON.message;

                    // Handle Lambda API response
                    switch (xhr.status) {
                        case 200:
                            // Lambda API was able to issue a request to Schoolbox.
                            if (message === "Cannot resolve DNS") {
                                // Lambda API unable to resolve 'url' DNS?
                                updateDiagnosticsAlertBox(idx, "Unable to resolve DNS for <strong>" + hostname + "</strong>", "alert")
                                displayCommonCauses(idx, "<p>No public DNS records configured for " + hostname + "</p>")
                                displayResolutionText(idx, "<p>Check public DNS records exist for <strong>" + hostname + "</strong></p>");
                            } else if (["Connection refused", "Request timeout occurred"].indexOf(message) !== -1) {
                                // Was Lambda unable to connect to port 80 (either rejected or timeout)?
                                let diagnostic = message === "Connection refused"
                                        ? "Connection refused when"
                                        : "Timeout";
                                diagnostic += " connecting to <strong>" + hostname + "</strong>";
                                let commonCauses =
                                        "<ul>" +
                                        "<li>A firewall may be restricting traffic on port 80</li>" +
                                        "<li>A firewall may be restricting HTTP requests</li>" +
                                        "<li>A firewall may be restricting traffic from the US/EU (Geoblocking)</li>" +
                                        "<li>The ISP may be blocking inbound port 80 traffic</li>" +
                                        "</li>";
                                displayResponseDetails(idx, USER_AGENT_STRING_LETS_ENCRYPT, {})
                                testChromeUserAgent(idx, xhr, diagnostic, commonCauses, "<p>Check that port 80 traffic is being routed to Schoolbox server.</p>");
                            } else if (message === "Response received") {
                                // Did Lambda API get a response from requested 'url' on port 80?
                                let response = xhr.responseJSON.response;
                                displayResponseDetails(idx, USER_AGENT_STRING_LETS_ENCRYPT, response)

                                // Was the response from Schoolbox nginx?
                                if (response.status === 200 && response.body === EXPECTED_RESPONSE_BODY) {
                                    updateDiagnosticsAlertBox(idx, "SSL Renewal simulation successful. ", "success")
                                } else {
                                    // Generate diff b/w expected + actual
                                    let diff = {}
                                    if (response.status !== 200) {
                                        diff["status"] = [200, response.status]
                                    }
                                    if (!Object.hasOwn(response.headers, "server")) {
                                        diff["server"] = [EXPECTED_SERVER_HEADER, ""]
                                    } else if (response.headers.server !== EXPECTED_SERVER_HEADER) {
                                        diff["server"] = [EXPECTED_SERVER_HEADER, response.headers.server]
                                    }
                                    if (response.body !== EXPECTED_RESPONSE_BODY) {
                                        diff["body"] = [EXPECTED_RESPONSE_BODY, escapeHtml(response.body)]
                                    }
                                    if ('location' in response.headers) {
                                        diff["location header"] = ["", response.headers['location']]
                                    }
                                    let html = "<table>" +
                                            "<tr><th></th><th>Expected</th><th>Actual</th></tr>";
                                    for (let key in diff) {
                                        let aDiff = diff[key]
                                        html += "<tr><th>" + key + "</th><td>" + aDiff[0] + "</td><td>" + aDiff[1] + "</td></tr>"
                                    }
                                    html += "</table>";

                                    let commonCauses = "";
                                    let resolutionText;

                                    // Is this a case of HTTP to HTTPS redirection?
                                    if ('location' in response.headers && response.headers['location'].startsWith("https")) {
                                        commonCauses = "An upstream firewall/service performing HTTP to HTTPS redirection"
                                        if ('server' in response.headers) {
                                            resolutionText = "Test results indicate the service generating the redirect identifies itself as <code>" + response.headers.server + "</code>. " +
                                                    "Please review the configuration of this service and remove any HTTP to HTTPS redirection."
                                        } else {
                                            resolutionText = "Check no upstream network components are performing HTTP to HTTPS redirection."
                                        }
                                    } else {
                                        resolutionText = "Check that port 80 traffic is being routed to Schoolbox server";
                                    }
                                    testChromeUserAgent(idx, xhr, "Unexpected response to domain verification request<br><br>" + html, commonCauses, "<p>" + resolutionText + "</p>");
                                }
                            } else {
                                // Lambda API has returned a 200, but this code doesn't know how to handle it.
                                // Probably a bug that needs fixing here.
                                updateDiagnosticsAlertBox(idx, "Unrecognised Diagnostic API response: " + message, "alert")
                                displayResolutionText(idx, "<p>If issue persists, please report issue to Schoolbox Support</p>");
                            }
                            return;

                        case 400:
                            // Lambda API refused to check URL because request was invalid
                            updateDiagnosticsAlertBox(idx, "Schoolbox error. " + message + ". Unable to check " + urlToCheck, "alert")
                            displayResolutionText(idx, "<p>If issue persists, please report issue to Schoolbox Support</p>");
                            return;

                        case 500:
                            // Lambda API encountered an unexpected error
                            updateDiagnosticsAlertBox(idx, "Diagnostic API error.", "alert")
                            displayResolutionText(idx, "<p>If issue persists, please report issue to Schoolbox Support</p>");
                            return;

                        default:
                            // Lambda API returned an unexpected response
                            updateDiagnosticsAlertBox(idx, "Diagnostic API error. Unrecognised status code: " + xhr.status, "alert")
                            displayResolutionText(idx, "<p>If issue persists, please report issue to Schoolbox Support</p>");
                            return;
                    }
                },
            });
        });
    });
    $(function () {
        $('[data-collapser]').collapsable();
    });
</script>

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <h2 class="subheader">SSL Renewal Help</h2>
            <section class="content">
                <article>
                    <p>
                        This page performs diagnostics to assist IT systems administrators troubleshoot common firewall
                        and network configuration issues that prevent automatic SSL certificate renewal.
                    </p>
                    <h3>SSL certificate renewal process</h3>
                    <p>
                        Certificates are managed via Certbot and issued by Let's Encrypt with 3 months of validity.
                        Certbot will automatically attempt to renew SSL certificates when the current certificates have
                        less than 30 days till expiry.
                        Domain verification is performed using the <a
                                href="https://letsencrypt.org/docs/challenge-types/#http-01-challenge" target="_blank">HTTP-01
                            challenge</a> which can only be done on port 80.
                        Port 80 is <strong>only</strong> used for domain verification. All other traffic is redirected
                        to HTTPS.
                    </p>
                    <h3>Test logic</h3>
                    <p>This page attempts to send a request from a cloud-based service to the Schoolbox server. The
                        request is designed to simulate domain verification requests sent from Let's Encrypt servers
                        during SSL certificate generation.</p>
                    <div class="alert-box warning no-margin">
                        <p>
                            Failure to route port 80 traffic to the server will cause domain verification and SSL
                            certificate generation to fail.
                        </p>
                    </div>
                </article>
            </section>
        </div>

        {% for idx,hostname in hostnames %}
            <div class="small-12 island">
                <h2 class="subheader">{{ hostname }} ({% if hostname|lower == primaryDomain|lower %}primary{% else %}alternate{% endif %})</h2>
            </div>

            <div class="small-12 island">
                <h3 class="subheader">Diagnostics</h3>
                <div id="diagnostics-{{ idx }}" data-alert class="alert-box t-break-word"><span class="loader"></span>Testing in progress,
                    please wait...
                </div>
            </div>

            <div id="common-causes-wrap-{{ idx }}" class="small-12 island hide">
                <h3 class="subheader">Common Causes</h3>
                <section class="content">
                    <article id="common-causes-{{ idx }}"></article>
                </section>
            </div>

            <div id="resolution-wrap-{{ idx }}" class="small-12 island hide">
                <h3 class="subheader">Resolution</h3>
                <section class="content">
                    <article id="resolution-{{ idx }}"></article>
                </section>
            </div>

            <div id="request-response-letsencrypt-{{ idx }}" class="hide">
                <div id="request-details-le-{{ idx }}">
                    <div class="small-12 large-6 island">
                        <h3 class="subheader">Request (User Agent: Let's Encrypt)</h3>
                        <table>
                            <tr>
                                <th>Method:</th>
                                <td>GET</td>
                            </tr>
                            <tr>
                                <th>URI:</th>
                                <td id="request-uri-letsencrypt-{{ idx }}" class="t-break-word">Loading...</td>
                            </tr>
                            <tr>
                                <th>Headers:</th>
                                <td class="t-break-word">user-agent: {{ USER_AGENT_STRING_LETS_ENCRYPT }}</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div id="response-details-{{ idx }}">
                    <div class="small-12 large-6 island">
                        <h3 class="subheader">Response</h3>
                        <table>
                            <tr>
                                <th>Status Code:</th>
                                <td id="response-status-letsencrypt-{{ idx }}"><span class="loader"></span>.</td>
                            </tr>
                            <tr>
                                <th>Headers:</th>
                                <td id="response-headers-letsencrypt-{{ idx }}" class="t-break-word"><span class="loader"></span></td>
                            </tr>
                            <tr>
                                <th>Body:</th>
                                <td id="response-body-letsencrypt-{{ idx }}" class="t-break-word"><span class="loader"></span></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <div id="request-response-chrome-{{ idx }}" class="hide">
                <div id="request-details-chrome-{{ idx }}">
                    <div class="small-12 large-6 island">
                        <h3 class="subheader">Request (User Agent: Chrome)</h3>
                        <table>
                            <tr>
                                <th>Method:</th>
                                <td>GET</td>
                            </tr>
                            <tr>
                                <th>URI:</th>
                                <td id="request-uri-chrome-{{ idx }}">Loading...</td>
                            </tr>
                            <tr>
                                <th>Headers:</th>
                                <td>user-agent: {{ USER_AGENT_STRING_CHROME }}</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div id="response-details-{{ idx }}">
                    <div class="small-12 large-6 island">
                        <h3 class="subheader">Response</h3>
                        <table>
                            <tr>
                                <th>Status Code:</th>
                                <td id="response-status-chrome-{{ idx }}"><span class="loader"></span>.</td>
                            </tr>
                            <tr>
                                <th>Headers:</th>
                                <td id="response-headers-chrome-{{ idx }}" class="t-break-word"><span class="loader"></span></td>
                            </tr>
                            <tr>
                                <th>Body:</th>
                                <td id="response-body-chrome-{{ idx }}" class="t-break-word"><span class="loader"></span></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            {% if not loop.last %}<div class="small-12 island"><hr></div>{% endif %}
        {% endfor %}
    </div>
</div>
