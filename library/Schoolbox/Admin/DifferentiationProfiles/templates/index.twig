{#                        {% for differentiationProfile in differentiationProfilesConfig %}#}
{#                        <div class="small-12 columns">#}
{#                            <div class="switch">#}
{#                                <input id="differentiation-profiles-adjustments-field" type="checkbox" name="enabled" {% if differentiationProfile.isEnabled ?? false %}checked{% endif %}/>#}
{#                                <label for="differentiation-profiles-adjustments-field">#}
{#                                    <span>On</span>#}
{#                                    <span>Off</span>#}
{#                                </label>#}
{#                            </div>#}
{#                        </div>#}
{#                        {% endfor %}#}
{#                    </fieldset>#}
{#                </section>#}
                <div class="row">
                    <div class="small-12 column">
                        <input type="hidden" name="returnUrl" value="{{ returnUrl }}">
                        <input type="submit" name="btnSubmit" value="Save">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
