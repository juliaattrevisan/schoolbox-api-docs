{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island">
            <form method="post" action="{{ routeLookup('differentiationProfiles.postConfig') }}">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            {% set featureToggle = data.differentiationProfiles.featureToggle %}
                            <label id="differentiation-profiles" class="inline-block" for="differentiation-profiles-field">
                                <span class="{% if featureToggle.required %} required-with-tip{% endif %}">{{ (featureToggle.title)|trim }}</span>
                                {% if featureToggle.description|trim %}
                                    <span data-tooltip class="hint has-tip tip-bottom" title="{{ featureToggle.description }}">?</span>
                                {% endif %}
                            </label>
                            <div class="switch">
                                <input id="differentiation-profiles-field" type="checkbox" name="enabled" {% if featureToggle.enabled %}checked{% endif %}/>
                                <label for="differentiation-profiles-field">
                                    <span>On</span>
                                    <span>Off</span>
                                </label>
                            </div>
                        </div>
                    </fieldset>
                </section>
                {# TODO: Temporary twig code for testing; to be removed #}
                {% for key, differentiationProfile in data.differentiationProfiles.modules %}
                    <section>
                        <fieldset class="content">
                            {% for module in differentiationProfile.fields %}
                                <div class="small-12 medium-1 columns">
                                    <div class="switch">
                                        <input id="differentiation-profiles-adjustments-field-{{ module.id }}" type="checkbox" name="modules[{{key}}][{{ module.name }}][is_enabled]" {% if module.is_enabled ?? false %}checked{% endif %}/>
                                        <label for="differentiation-profiles-adjustments-field-{{ module.id }}">
                                            <span>On</span>
                                            <span>Off</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="small-12 medium-3 columns">
                                    <label>
                                        <input type="text" name="modules[{{key}}][{{ module.name }}][title]" value="{{ module.title }}" readonly />
                                    </label>
                                </div>
                                <div class="small-12 medium-3 columns">
                                    <label>
                                        <input type="text" name="modules[{{key}}][{{ module.name }}][terminology]" value="{{ module.terminology }}" />
                                    </label>
                                </div>
                                <div class="small-12 medium-5 columns">
                                    <label>
                                        <input type="text" name="modules[{{key}}][{{ module.name }}][description]" value="{{ module.description }}" />
                                    </label>
                                </div>
                                <input type="hidden" name="modules[{{key}}][{{ module.name }}][name]" value="{{ module.name }}" />
                                <input type="hidden" name="modules[{{key}}][{{ module.name }}][id]" value="{{ module.id }}" />
                            {% endfor %}
                        </fieldset>
                    </section>
                {% endfor %}
                {# End of temporary twig code #}
                <div class="row">
                    <div class="small-12 column">
                        <input type="hidden" name="returnUrl" value="{{ returnUrl }}">
                        <input type="submit" name="btnSubmit" value="Save">
                    </div>
                </div>
            </form>
        </div>
        <div id="differentiation-profiles-container">
            <differentiation-profiles
                post-route="{{ routeLookup('differentiationProfiles.postConfig') }}"
                :data="{{ data.differentiationProfiles|json_encode }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/differentiationProfiles.js?v={{ config.site_version }}"></script>
    </div>
</div>
