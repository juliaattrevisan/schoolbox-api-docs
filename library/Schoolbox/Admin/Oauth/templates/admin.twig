{#
    configContext:  array     - Data required to render a config settings form
#}

{% import 'sub/breadcrumbs.twig' as bread  %}
{{ bread.crumbs(
    [ 'Admin', routeLookup('adminHome.getIndex') ],
    [ 'Messages', '/adminv2/messages' ],
    [ 'oAuth Provider Configuration', routeLookup('adminOauth.getAdmin') ]
) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent, subpageCurrent) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <h2 class="subheader">oAuth Provider Configuration</h2>
        </div>

        {% include '@settings/moduleConfig.twig' with configContext only %}
    </div>
</div>
