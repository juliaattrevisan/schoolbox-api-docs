{#
configContext:  array     - Data required to render a config settings form
#}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <oauth-client-list
            :get-list-endpoint="{{ routeLookup('adminOauthClientApi.getList') }}"
            :post-item-endpoint="{{ routeLookup('adminOauthClientApi.postItem') }}"
            :put-item-endpoint-base="{{ routeLookup('adminOauthClientApi.putItem') }}"
            :delete-item-endpoint-base="{{ routeLookup('adminOauthClientApi.deleteItem') }}"
        >
        </oauth-client-list>
        <script type="text/javascript" src="{{CDN_PREFIX}}/js/bundle/oauthClientList.js?v={{ config.site_version }}"></script>
    </div>
</div>
