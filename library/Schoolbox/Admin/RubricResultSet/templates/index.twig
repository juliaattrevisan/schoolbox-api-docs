<style>
div.create-new-button-container-div
{
    text-align: right;
}

span.result-rubric-label-span
{
    background-color: lightgrey;
    display: inline-block;
    margin-bottom: 0.2rem;
    margin-right: 0.2rem;
    padding: 0.5rem;
}

span.buttons-container-span
{
    display: inline-block;
    float: right;
}

div.clear-floats
{
    clear: both;
}
</style>
<script>
$(document).ready(
    function () {
        $('a.delete-row-button').click(
            function (e) {
                e.preventDefault();
                $(this).confirmDialog(
                    {
                        text: 'Are you sure you want to delete this result set?',
                        confirmLabel: 'Delete',
                        confirmEvent: $.confirmDialog.followHref
                    }
                );
            }
        );
    }
);

function onClickDeleteRow(resultSetId)
{
    let aJq = $('#delete-row-a');

    aJq.confirmDialog(
        {
            confirmEvent: function ()
            {
                $.post(aJq.attr('href')).done(function () {location.reload();});
            }
        }
    );

    return false;
}
</script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}
<div class="admin-container row">
    {{ renderAdminNavigation(pageCurrent) }}
    <div class="admin-content">
        <!-- Main content section starts here. -->
        <div class="row">
            {% if not rubricsByResultSetId %}
                <div id="empty-state-island-div" class="small-12 island">
                    <div class="empty-state">
                        <i class="icon-list"></i>
                        <p>No rubric result sets have been created.</p>
                        <p><a href="/adminv2/rubric-result-set/create">Create new result set</a></p>
                    </div>
                </div>
            {% else %}
                <div id="rubric-rows-island-div" class="small-12 island">
                    <div class="create-new-button-container-div">
                        <a class='button icon-add' href="/adminv2/rubric-result-set/create"></a>
                    </div>
                    <section>
                        <header class="list-header actions-small-0">
                            <div class="list-item">
                                <div class="medium-12 column">Result Set</div>
                            </div>
                        </header>
                        <ul id="rows-container-ul" class="information-list unsortable">
                            {% for resultSetId, rubrics in rubricsByResultSetId %}
                                <li>
                                    <div class="actions-small-0">
                                        <div class="list-item">
                                            <div class="small-12 medium-12 column">
                                                <label>
                                                    {% for rubric in rubrics %}
                                                        <span class="result-rubric-label-span">
                                                            {{ rubric.label|purify }}
                                                        </span>
                                                    {% endfor %}
                                                    <span class="buttons-container-span">
                                                        <a class="edit-row-button icon-modify" href="/adminv2/rubric-result-set/{{ resultSetId }}/update"></a>
                                                        <a id="delete-row-a" class="delete-row-button icon-delete" href="/adminv2/rubric-result-set/{{ resultSetId }}/delete" onclick="onClickDeleteRow({{ resultSetId }})"></a>
                                                    </span>
                                                    <div class="clear-floats"></div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                </div>
            {% endif %}
        </div>
        <!-- Main content section ends here. -->
    </div>
</div>
