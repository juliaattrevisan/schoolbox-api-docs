<style>
    span.result-rubric-label
    {
        display: inline-block;
        margin-bottom: 0.2rem;
        margin-right: 0.2rem;
        padding: 0.5rem;
    }

    span.buttons-container
    {
        display: inline-block;
        float: right;
    }
</style>
<script>
    function deleteRow(resultSetId)
    {
        let aJq = $('#delete-row-button');

        aJq.confirmDialog(
            {
                confirmEvent: function ()
                {
                    $.ajax(
                        {
                            url: '/adminv2/rubric-result-set/' + resultSetId,
                            type: 'DELETE',
                            success: function () {location.reload();}
                        }
                    );
                }
            }
        );

        return false;
    }
</script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}
<div class="admin-container row">
    {{ renderAdminNavigation(pageCurrent) }}
    <div class="admin-content">
        <!-- Main content section starts here. -->
        <div class="row">
            {% if not rubricsByResultSetId %}
                <div class="small-12 island">
                    <div class="empty-state">
                        <i class="icon-list"></i>
                        <p>No rubric result sets have been created.</p>
                        <p><a href="{{ routeLookup('adminRubricResultSet.getCreate') }}">Create new result set</a></p>
                    </div>
                </div>
            {% else %}
                <div class="small-12 island">
                    <div class="row actions-small-1">
                        <nav>
                            <a class='icon-add' href="{{ routeLookup('adminRubricResultSet.getCreate') }}" title="Add new result set"></a>
                        </nav>
                    </div>
                    <section>
                        <ul class="information-list unsortable">
                            {% for resultSetId, rubrics in rubricsByResultSetId %}
                                <li>
                                    <div class="small-12 medium-12 column">
                                        <label>
                                            {% for rubric in rubrics %}
                                                <span class="result-rubric-label gainsboro">
                                                    {{ rubric.label|purify }}
                                                </span>
                                            {% endfor %}
                                            <span class="buttons-container">
                                                <a class="edit-row-button icon-modify" href="{{ routeLookup('adminRubricResultSet.getUpdate', {resultSetId: resultSetId}) }}"></a>
                                                <a id="delete-row-button" class="delete-row-button icon-delete" onclick="return deleteRow({{ resultSetId }})"></a>
                                            </span>
                                        </label>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                </div>
            {% endif %}
        </div>
        <!-- Main content section ends here. -->
    </div>
</div>
