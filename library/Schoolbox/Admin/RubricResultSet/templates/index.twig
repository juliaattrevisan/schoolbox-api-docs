<style>
div.create-new-button-container
{
    text-align: right;
}

span.result-rubric-label-span
{
    display: inline-block;
    margin-bottom: 0.2rem;
    margin-right: 0.2rem;
    padding: 0.5rem;
}

span.buttons-container-span
{
    display: inline-block;
    float: right;
}

div.clear-floats
{
    clear: both;
}
</style>
<script>
function deleteRow(resultSetId)
{
    let aJq = $('#delete-row-button');

    aJq.confirmDialog(
        {
            confirmEvent: function ()
            {
                $.ajax(
                    {
                        url: '/adminv2/rubric-result-set/' + resultSetId,
                        type: 'DELETE',
                        success: function () {location.reload();}
                    }
                );
            }
        }
    );

    return false;
}
</script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}
<div class="admin-container row">
    {{ renderAdminNavigation(pageCurrent) }}
    <div class="admin-content">
        <!-- Main content section starts here. -->
        <div class="row">
            {% if not rubricsByResultSetId %}
                <div class="small-12 island">
                    <div class="empty-state">
                        <i class="icon-list"></i>
                        <p>No rubric result sets have been created.</p>
                        <p><a href="/adminv2/rubric-result-set/create">Create new result set</a></p>
                    </div>
                </div>
            {% else %}
                <div class="small-12 island">
                    <div class="create-new-button-container">
                        <a class='button icon-add' href="/adminv2/rubric-result-set/create"></a>
                    </div>
                    <section>
                        <ul class="information-list unsortable">
                            {% for resultSetId, rubrics in rubricsByResultSetId %}
                                <li>
                                    <div class="small-12 medium-12 column">
                                        <label>
                                            {% for rubric in rubrics %}
                                                <span class="result-rubric-label-span gainsboro">
                                                    {{ rubric.label|purify }}
                                                </span>
                                            {% endfor %}
                                            <span class="buttons-container-span">
                                                <a class="edit-row-button icon-modify" href="/adminv2/rubric-result-set/{{ resultSetId }}/update"></a>
                                                <a id="delete-row-button" class="delete-row-button icon-delete" onclick="return deleteRow({{ resultSetId }})"></a>
                                            </span>
                                            <div class="clear-floats"></div>
                                        </label>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                </div>
            {% endif %}
        </div>
        <!-- Main content section ends here. -->
    </div>
</div>
