<style>
span.rubric-value-span {
    display: inline-block;
    width: 10px;
}

input.rubric-wide-input {
    display: inline-block;
    margin-left: 10px;
    width: 95%;
}

label.rubric-result-set-row-label {
    white-space: nowrap;
}

label.rubric-result-set-row-label > span.rubric-value-span,
label.rubric-result-set-row-label > a.delete-row-button {
    /* These styles are important when the validation message appears below the input field. */
    padding-top: 0.5rem;
    vertical-align: top;
}

label.rubric-result-set-row-label > span.input-container {
    display: inline-block;
    width: 97%;
}
</style>
<script>
    /**
     * When the plus button is clicked, we add a new row to the form.
     */
    function onClickPlusButton() {
        let rowsContainerUl = document.getElementById('rows-container-ul');
        let nRows           = document.getElementsByClassName('rubric-value-span').length;

        if (nRows > 0) {
            if (nRows > {{ MAX_ROWS_PER_RESULT_SET }}) {
                // We limit the number of rows here to an arbitrarily chosen sensible value.
                return;
            }
        }

        let newRowHtml = (
            "<li id='row-li-" + nRows + "'>\n" +
            "    <div class='actions-small-0'>\n" +
            "        <div class='list-item'>\n" +
            "            <div class='small-12 medium-12 column'>\n" +
            "                <label class='rubric-result-set-row-label'>\n" +
            "                    <span class='rubric-value-span' data-role='value'>" + nRows + "</span>\n" +
            "                    <span class='input-container'>\n" +
            "                        <!-- This input-container span is necessary in order to contain the input and the validation message span that will be added if the field contains invalid data. -->\n" +
            "                        <input class='rubric-wide-input' type='text' name='rubricResultLabels[" + nRows + "]' maxlength='64' required/>\n" +
            "                    </span>\n" +
            "                    <a class='delete-row-button icon-delete' onclick='onClickDeleteRow(" + nRows + ")'></a>\n" +
            "                </label>\n" +
            "            </div>\n" +
            "        </div>\n" +
            "    </div>\n" +
            "</li>\n"
        );

        rowsContainerUl.insertAdjacentHTML('beforeend', newRowHtml);

        // Add validation rules to new input.
        $('input[name="rubricResultLabels[' + String(nRows) + ']"').rules('add', {requiredNotBlank: true});

        togglePlusAndSaveButtons(true);
        document.getElementById('empty-state-island-div').style.display = 'none'; // Hide empty state box.
    }

    /**
     * When the delete button is clicked on a new row, we remove the new row from the form.
     * We also must update the numbers on the left of the new form rows so there are no gaps.
     */
    function onClickDeleteRow(rowValue) {
        let rowLi = document.getElementById('row-li-' + rowValue);
        rowLi.remove();
        renumberRows();

        if (document.getElementById('rows-container-ul').children.length == 0) {
            document.getElementById('empty-state-island-div').style.display = ''; // Show empty state box.
            togglePlusAndSaveButtons(false);
        } else {
            togglePlusAndSaveButtons(true);
        }
    }

    /**
     * Find the highest number from the non-new rows, then update the numbers on the new rows
     * so that the number of each row is one more than the number on the row directly above.
     */
    function renumberRows() {
        let spans = document.getElementsByClassName('rubric-value-span');

        for (let i = 0; i < spans.length; ++i) {
            let span = spans[i];

            span.innerHTML = String(i); // Cast to avoid warning.

            // Must also rename the text input.
            let labelTextInput = span.nextElementSibling;
            labelTextInput.setAttribute('name', 'rubricResultLabels[' + i + ']');
        }
    }

    /**
     *
     */
    function togglePlusAndSaveButtons(boolShow) {
        let displayValue = ((boolShow)? '': 'none');
        document.getElementById('save-button'              ).style.display = displayValue;
        document.getElementById('plus-button-container-div').style.display = displayValue;
    }
</script>
<script>
    // This script block uses JQuery.

    $(function() {
        $('#rubricResultSetForm').alaressValidate();

        $('#rubricResultSetForm input').each(function(index, element) {
            if (element.getAttribute('type') != 'hidden') {
                $(element).rules('add', {requiredNotBlank: true});
            }
        });
    });
</script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}
<div class="admin-container row">
    {{ renderAdminNavigation(pageCurrent) }}
    <div class="admin-content">
        <!-- Main content section starts here. -->
        <div class="row">
            <div id="empty-state-island-div" class="small-12 island"{% if rubricResultRows %}style="display:none"{% endif %}>
                <div class="empty-state">
                    <i class="icon-list"></i>
                    <p>This rubrics result set is empty.</p>
                    <p><a onclick="onClickPlusButton()">Add a row</a></p>
                </div>
            </div>
            <div class="small-12 island">
                <form id="rubricResultSetForm" method="post" action="/adminv2/rubric-result-set/create">
                    <input type='hidden' name='resultSetIdOrBlank' value='{{ resultSetId }}'/>
                    <section>
                        <ul id="rows-container-ul" class="information-list unsortable">
                            {% for row in rubricResultRows %}
                                <li id="row-li-{{ row.value|purify }}">
                                    <div class="actions-small-0">
                                        <div class="list-item">
                                            <div class="small-12 medium-12 column">
                                                <label class="rubric-result-set-row-label">
                                                    <span class="rubric-value-span" data-role="value">{{ row.value|purify }}</span>
                                                    <!-- A sensible maxlength of 64 chars was chosen arbitrarily for the input below.  The database field can handle more. -->
                                                    <span class="input-container">
                                                        <!-- This input-container span is necessary in order to contain the input and the validation message span that will be added if the field contains invalid data. -->
                                                        <input class="rubric-wide-input" type="text" name="rubricResultLabels[{{ row.value|purify }}]" value="{{ row.label|purify }}" maxlength="64" required/>
                                                    </span>
                                                    <a class='delete-row-button icon-delete' onclick='onClickDeleteRow({{ row.value|purify }})'></a>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                        <div id="plus-button-container-div" class="component-action"{% if not rubricResultRows %}style="display:none"{% endif %}>
                            <section>
                                <a class="button" onclick="onClickPlusButton()">Add Row</a>
                            </section>
                        </div>
                    </section>
                    <input id="save-button" type="submit" value="Save"{% if not rubricResultRows %}style="display:none"{% endif %}>
                </form>
            </div>
        </div>
        <!-- Main content section ends here. -->
    </div>
</div>
