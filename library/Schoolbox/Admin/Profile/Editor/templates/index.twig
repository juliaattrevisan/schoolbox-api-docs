{# Add your own javascript, validation etc. #}
{# Use pantry for styling #}

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ user.fullname }}</h2>
        <section class="content">
        {% set formAction = routeLookupIfAuthorized('example.postExample') %}
        {% if formAction %}
            <form action="{{ formAction }}" method="post">
                <input type="hidden" name="id" value="{{ user.id }}" />

                <label>var1</label>
                <input type="text" name="var1" />

                <input type="submit" />
            </form>
        {% else %}
            Not authorised to POST
        {% endif %}
        </section>
    </div>
</div>

