{# Shared navigation profile #}
{{ renderAdminNavigation(pageCurrent) }}

{% if item.id is empty %}
    {% set createForm = true %}
{% else %}
    {% set createForm = false %}
{% endif %}

<form id="itemForm" action="{{ routeLookup('adminProfileButton.postModify') }}" method="post">
    <input type="hidden" name="id" value="{{ item.id }}">
    <div class="row">
        <div class="small-12 island">
            
            <h2 class="subheader">
                {% if createForm %}
                    Create Profile Button
                {% else %}
                    Modify Profile Button
                {% endif %}
            </h2>
            
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="profile-button-title" class="required">Button Text</label>
                        <input required type="text" id="profile-button-title" name='text' value="{{ item.text }}">
                    </div>
                    <div class="small-12 columns">
                        <label for="profile-button-desc">Hover Description</label>
                        <input name='title' id="profile-button-desc" type="text" value="{{ item.title }}">
                    </div>
                    <div class="small-10 columns">
                        <label for="icon-select">Icon</label>
                        <select id="icon-select" name="icon">
                            {% for icon in icons %}
                                <option {% if icon.name == item.icon %}selected{% endif %} value="{{ icon.name }}">{{ icon.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="small-2 columns">
                        <label>Preview</label>
                        <div id="icon-preview" style="margin-button:5px" class="size-32 icon-{{ item.icon }}"></div>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="profile-button-url" class="required">Destination URL</label>
                        <p class="meta">You can use [profileId], [profileFirstName], [profileLastName], [profileExternalId], [profileUsername], [profileEmail] in the URL, these will be replaced with details of the user being <b>viewed</b>.</p> <p class="meta">You can also use [id], [firstName], [lastName], [externalId], [username], [email], these will be replaced with details of the user <b>viewing</b> the page.</p>
                        <div class="input-group">
                            <input name="url" id="profile-button-url" required type="text" value="{{ item.url }}">
                            <a href="#" class="button icon-folder" data-role="openResourceBrowser">Browse {{ locale.resource.properPlural }}</a>
                        </div>
                    </div>
                    <div class="small-12 columns">
                        <label for="profile-button-destination">Destination Target</label>
                        <select name="target" id="profile-button-destination">
                            <option {% if item.target == '' %}selected{% endif %} value="">Same Window</option>
                            <option {% if item.target == '_blank' %}selected{% endif %} value="_blank">New Window</option>
                        </select>
                    </div>
                </fieldset>
                <fieldset class="content" id="profile-button-user-selections">
                    <legend>
                        User Profiles To Show On
                        <span data-tooltip class="has-tip hint" title="The button will appear on the profiles of the users in the selected roles and campuses.">?</span>
                    </legend>

                    <div class="small-12 medium-6 columns">
                        <fieldset>
                            <label class="required">Campuses</label>
                            <div class="checklist">
                                <input id="campus-all" type="checkbox">
                                <label for="campus-all">Select All</label>
                                {% for campus in campuses %}
                                    <input name="campuses[]" data-campus id="campus-{{ campus.id }}" type="checkbox" {% if campusAvailabilitySelected[campus.id] %}checked{% endif %} value="{{ campus.id }}">
                                    <label for="campus-{{ campus.id }}">{{ campus.name }}</label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <fieldset>
                            <label class="required">Roles</label>
                            <div class="checklist">
                                <input id="role-all" type="checkbox">
                                <label for="role-all">Select All</label>
                                {% for role in roles %}
                                    <input name="roles[]" data-role id="role-{{ role.id }}" type="checkbox" {% if roleAvailabilitySelected[role.id] %}checked{% endif %} value="{{ role.id }}">
                                    <label for="role-{{ role.id }}">{{ role.name }}</label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>
                </fieldset>
                <fieldset>
                    <legend>
                        Visibility
                    </legend>
                    <div class="small-12 columns">
                        <div class="meta">
                            Buttons will be visible to all staff, users viewing their own profile, and parents viewing their child's profile or My Students component.
                        </div>
                    </div>
                </fieldset>
            </section>
        </div>
    </div>

    <div class="row">
        <div class="small-12 column">
            <ul class="flex-list buttons">
                <li><a href="{{ routeLookup('adminProfileButton.getIndex') }}" class="button">Cancel</button></a>
                <li>
                    <button type="submit" class="submit expand" id="profile-button-submit">
                        {% if createForm %}
                            Create profile button
                        {% else %}
                            Save
                        {% endif %}
                    </button>
                </li>
            </ul>
        </div>
    </div>
</form>

<script src="/javascript/shared/select-all/jquery.select-all.js"></script>
<script>
    $(function() {
        // Init validation
        $('#itemForm').alaressValidate({
            ignore: ':disabled',
            rules: {
                'text': 'required',
                'url': {required: true, isURL: true},
                'campuses[]': 'required',
                'roles[]': 'required'
            },
            messages: {
                'text': {required: 'Please enter a name for the profile button.'},
                'url': {
                    required: 'Please enter a destination URL for the profile button.',
                    isURL: 'Please enter a valid URL for the profile button.'
                },
                'campuses[]': {required: 'Please select at least one campus.'},
                'roles[]': {required: 'Please select at least one role.'},
            }
        });

        // Resource browser
        $('a[data-role="openResourceBrowser"]').click(function(e) {
            e.preventDefault();
            $('[data-role="resourceBrowser"]').socialstreamBrowser({
                title: 'Choose a folder',
                categoryId: 0,
                mimeFilter: false,
                submitCallback: function(url, filename) {
                    $('#profile-button-url').val(url);
                }
            });
        });

        /*
         * Update the icon preview with the selected icon
         *
         * @param string icon
         */
        function updateIconPreview(icon) {
            // Remove existing icon-* class and add the new one
            $('#icon-preview').removeClass(function(index, className) {
               return (className.match (/(^|\s)icon-\S+/g) || []).join(' ');
            }).addClass('icon-' + icon);
        }

        // Update icon preview on page load
        updateIconPreview($('#icon-select').val());

        // Update icon preview on change of the dropdown
        $('#icon-select').change(function() {
            updateIconPreview($('#icon-select').val());
        });

        // Select all
        $("#profile-button-user-selections").selectAll({    
            selector: "#campus-all",
            checkboxes: "[data-campus]"
        });

         $("#profile-button-user-selections").selectAll({    
            selector: "#role-all",
            checkboxes: "[data-role]"
        });
       
    });
</script>