{% set createForm = item is not defined %}

{# Decide whether we're editing a system button or a custom button #}
{% set buttonType = item.type ?? 'custom' %}
{% set isCustomButton = ('custom' == buttonType) %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation profile #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 columns">
            <h2 class="subheader">
                {% if createForm %}
                    Create Profile Button
                {% else %}
                    Modify Profile Button
                {% endif %}
            </h2>
        </div>

        <form id="itemForm" action="{{ routeLookup('adminProfileButton.postModify') }}" method="post">
            <input type="hidden" name="id" value="{{ item.id ?? '' }}">

            <div class="small-12 island">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="profile-button-title" class="required">Button Text</label>
                            <input type="text" id="profile-button-title" name='text' value="{{ item.text ?? '' }}">
                        </div>
                        <div class="small-12 columns">
                            <label for="profile-button-desc">Hover Description</label>
                            <input name='title' id="profile-button-desc" type="text" value="{{ item.title ?? '' }}">
                        </div>
                        <div class="small-12 columns">
                            <label for="profile-button-css">
                                CSS Class
                                <span data-tooltip class="has-tip hint" title="Add a css class to this button so it can be used with your custom Skin Config.">?</span>
                            </label>

                            <input name='css' id="profile-button-css" type="text" value="{{ item.css ?? '' }}">
                        </div>
                        <div class="small-10 columns">
                            <label for="icon-select">Icon</label>
                            <select id="icon-select" name="icon">
                                {% for icon in icons %}
                                    <option {% if not createForm and icon.name == item.icon %}selected{% endif %} value="{{ icon.name }}">{{ icon.title }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="small-2 columns">
                            <label>Preview</label>
                            <div id="icon-preview" style="margin-button:5px" class="size-32 icon-{{ item.icon ?? '' }}"></div>
                        </div>
                    </fieldset>
                    <fieldset class="content">
                        {% if isCustomButton %}
                            <div class="small-12 columns">
                                <label for="profile-button-url" class="required">Destination URL</label>
                                <p class="meta">You can use [profileId], [profileFirstName], [profileLastName], [profileExternalId], [profileUsername], [profileEmail] in the URL, these will be replaced with details of the user being <b>viewed</b>.</p> <p class="meta">You can also use [id], [firstName], [lastName], [externalId], [username], [email], these will be replaced with details of the user <b>viewing</b> the page.</p>
                                <script>
                                    $(function() {
                                        $('#modalLinkButton').schoolboxLink({
                                            onSelect: function(url, name, mime, dialog) {
                                                $('#profile-button-url').val(url);
                                            }
                                        });
                                    });
                                </script>
                                <div class="input-group">
                                    <input name="url" id="profile-button-url" type="text" value="{{ item.url ?? '' }}">
                                    <a id="modalLinkButton" class="button icon-link">Browse</a>
                                </div>
                            </div>
                        {% endif %}

                        <div class="small-12 columns">
                            <label for="profile-button-destination">Destination Target</label>
                            <select name="target" id="profile-button-destination">
                                <option {% if not createForm and item.target == '' %}selected{% endif %} value="">Same Window</option>
                                <option {% if not createForm and item.target == '_blank' %}selected{% endif %} value="_blank">New Window</option>
                            </select>
                        </div>
                    </fieldset>
                    <fieldset class="content" id="profile-button-user-availability-selections">
                        <legend>
                            Button Availability
                            <span data-tooltip class="has-tip hint" title="The button will appear on the profiles of the users in the selected roles and campuses.">?</span>
                        </legend>

                        <div class="small-12 medium-6 columns">
                            <fieldset>
                                <label class="required">Campuses</label>
                                <div class="checklist">
                                    <ul class="option-list">
                                        <li>
                                            <input id="campus-availability-all" type="checkbox">
                                            <label for="campus-availability-all">Select All</label>
                                        </li>
                                        {% for campus in campuses %}
                                            <li>
                                                <input name="campusAvailability[]" data-campus-availability id="campus-availability-{{ campus.id }}" type="checkbox" {% if campusAvailabilitySelected[campus.id] ?? false %}checked{% endif %} value="{{ campus.id }}">
                                                <label for="campus-availability-{{ campus.id }}">{{ campus.name }}</label>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </fieldset>
                        </div>
                        <div class="small-12 medium-6 columns">
                            <fieldset>
                                <label class="required">Roles</label>
                                <div class="checklist">
                                    <ul class="option-list">
                                        <li>
                                            <input id="role-availability-all" type="checkbox">
                                            <label for="role-availability-all">Select All</label>
                                        </li>
                                        {% for role in roles %}
                                            <li>
                                                <input name="roleAvailability[]" data-role-availability id="role-availability-{{ role.id }}" type="checkbox" {% if roleAvailabilitySelected[role.id] ?? false %}checked{% endif %} value="{{ role.id }}">
                                                <label for="role-availability-{{ role.id }}">{{ role.name }}</label>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </fieldset>
                        </div>
                    </fieldset>

                    <fieldset class="content" id="profile-button-user-visibility-selections">
                        <legend>
                            Button Visibility
                            <span data-tooltip class="has-tip hint" title="The button will appear for profile viewers in the selected roles and campuses.">?</span>
                        </legend>

                        <div class="small-12 medium-6 columns">
                            <fieldset>
                                <label class="required">Campuses</label>
                                <div class="checklist">
                                    <ul class="option-list">
                                        <li>
                                            <input id="campus-visibility-all" type="checkbox">
                                            <label for="campus-visibility-all">Select All</label>
                                        </li>
                                        {% for campus in campuses %}
                                            <li>
                                                <input name="campusVisibility[]" data-campus-visibility id="campus-visibility-{{ campus.id }}" type="checkbox" {% if campusVisibilitySelected[campus.id] ?? false %}checked{% endif %} value="{{ campus.id }}">
                                                <label for="campus-visibility-{{ campus.id }}">{{ campus.name }}</label>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </fieldset>
                        </div>
                        <div class="small-12 medium-6 columns">
                            <fieldset>
                                <label class="required">Roles</label>
                                <div class="checklist">
                                    <ul class="option-list">
                                        <li>
                                            <input id="role-visibility-all" type="checkbox">
                                            <label for="role-visibility-all">Select All</label>
                                        </li>
                                        {% for role in roles %}
                                            <li>
                                                <input name="roleVisibility[]" data-role-visibility id="role-visibility-{{ role.id }}" type="checkbox" {% if roleVisibilitySelected[role.id] ?? false %}checked{% endif %} value="{{ role.id }}">
                                                <label for="role-visibility-{{ role.id }}">{{ role.name }}</label>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </fieldset>
                        </div>
                    </fieldset>
                </section>
            </div>

            <div class="row">
                <div class="small-12 column">
                    <ul class="flex-list buttons">
                        <li><a href="{{ routeLookup('adminProfileButton.getIndex') }}" class="button">Cancel</a>
                        <li>
                            <button type="submit" class="submit" id="profile-button-submit">
                                {% if createForm %}
                                    Create profile button
                                {% else %}
                                    Save
                                {% endif %}
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="{{ CDN_PREFIX }}/js/select-all/jquery.select-all.js?v={{ config.site_version }}"></script>
<script>
    $(function() {
        // Init validation
        $('#itemForm').alaressValidate({
            ignore: ':disabled',
            rules: {
                'text': 'required',
                {% if isCustomButton %}
                'url': {required: true, isURL: true},
                {% endif %}
                'campusAvailability[]': 'required',
                'roleAvailability[]': 'required',
                'campusVisibility[]': 'required',
                'roleVisibility[]': 'required'
            },
            messages: {
                'text': {required: 'Please enter a name for the profile button.'},
                {% if isCustomButton %}
                'url': {
                    required: 'Please enter a destination URL for the profile button.',
                    isURL: 'Please enter a valid URL for the profile button.'
                },
                {% endif %}
                'campusAvailability[]': {required: 'Please select at least one campus.'},
                'roleAvailability[]': {required: 'Please select at least one role.'},
                'campusVisibility[]': {required: 'Please select at least one campus.'},
                'roleVisibility[]': {required: 'Please select at least one role.'}
            }
        });

        /*
         * Update the icon preview with the selected icon
         *
         * @param string icon
         */
        function updateIconPreview(icon) {
            // Remove existing icon-* class and add the new one
            $('#icon-preview').removeClass(function(index, className) {
               return (className.match (/(^|\s)icon-\S+/g) || []).join(' ');
            }).addClass('icon-' + icon);
        }

        // Update icon preview on page load
        updateIconPreview($('#icon-select').val());

        // Update icon preview on change of the dropdown
        $('#icon-select').change(function() {
            updateIconPreview($('#icon-select').val());
        });

        /* Availability select-all
         */
        $("#profile-button-user-availability-selections").selectAll({
            selector: "#campus-availability-all",
            checkboxes: "[data-campus-availability]"
        });

         $("#profile-button-user-availability-selections").selectAll({
            selector: "#role-availability-all",
            checkboxes: "[data-role-availability]"
        });

         /* Visibility select-all
          */
        $("#profile-button-user-visibility-selections").selectAll({
            selector: "#campus-visibility-all",
            checkboxes: "[data-campus-visibility]"
        });

        $("#profile-button-user-visibility-selections").selectAll({
            selector: "#role-visibility-all",
            checkboxes: "[data-role-visibility]"
        });
    });
</script>
