<script type="text/javascript" src="/javascript/shared/attacher.checkbox-group.js"></script>
<script>
    $(function () {
        $('#itemForm').alaressValidate({
            ignore: ':disabled',
            rules: {
                'text': {required: true},
                'url': {required: true, isURL: true}
            },
            messages: {
                'text': {required: 'You must enter a name before you can proceed.'},
                'url': {required: 'You must enter a valid URL for this profile item before you can proceed.'}
            }
        });

        $('[data-role="openResourceBrowser"]').click(function(e) {
            e.preventDefault();
            $('[data-role="resourceBrowser"]').socialstreamBrowser({
                title: 'Choose a folder',
                categoryId: 0,
                mimeFilter: false,
                submitCallback: function(url, filename) {
                    $('input[name="url"]').val(url);
                }
            });
        });
    });
</script>

{# Shared navigation profile #}
{{ renderAdminNavigation(pageCurrent) }}

<form id="itemForm" action="{{ routeLookup('adminProfileButton.postModify') }}" method="post">
    <input type="hidden" name="id" value="{{ item.id }}">
    <div class="row">
        <div class="small-12 island">
            {% if item.id is empty %}
                <h2 class="subheader">Create Profile Item</h2>
            {% else %}
                <h2 class="subheader">Modify Profile Item</h2>
            {% endif %}
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Title
                            <input required type="text" name='text' value="{{ item.text }}">
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>
                            Hover Description
                            <input name='title' type="text" value="{{ item.title }}">
                        </label>
                    </div>
                    <div class="small-10 columns">
                        <label>
                            Icon
                            <select id="icon-select" name="icon" data-icon>
                                {% for icon in icons %}
                                    <option {% if icon.name == item.icon %}selected{% endif %} value="{{ icon.name }}">{{ icon.title }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                    <div class="small-2 columns">
                        <label>
                            Preview
                        </label>
                        <div id="icon" style="margin-button:5px" class="size-32 icon-{{ item.icon }}"></div>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="url">
                            Destination URL
                            <span data-tooltip class="hint has-tip tip-button" data-width="200" title="You can use [id], [firstName], [lastName], [externalId], [username], [email] in your URLs, these will be replaced for the user">?</span>
                        </label>
                        <div class="input-group">
                            <input name="url" required type="text" value="{{ item.url }}">
                            <a href="#" class="button icon-folder" data-role="openResourceBrowser">Browse {{ resource }}</a>
                        </div>
                    </div>
                    <div class="small-12 columns">
                        <label>
                            Destination Target
                            <select name="target">
                                <option {% if item.target == '' %}selected{% endif %} value="">Same Window</option>
                                <option {% if item.target == '_blank' %}selected{% endif %} value="_blank">New Window</option>
                            </select>
                        </label>
                    </div>
                </fieldset>
                <fieldset class="content">
                    <div class="small-12 medium-6 columns">
                        <fieldset class="checklist">
                            <legend>
                                Visible Campus
                                <span data-tooltip="" class="hint has-tip tip-button" data-width="200" title="Users in these campus will see the tab, remember users can be in multiple campus">?</span>
                            </legend>
                            <input id="campus-all" type="checkbox">
                            <label for="campus-all">Select All</label>
                            {% for campus in campuses %}
                                <input name="campuses[]" data-campus id="campus-{{ campus.id }}" type="checkbox" {% if campusesSelected[campus.id] %}checked{% endif %} value="{{ campus.id }}">
                                <label for="campus-{{ campus.id }}">{{ campus.name }}</label>
                            {% endfor %}
                        </fieldset>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <fieldset class="checklist">
                            <legend>
                                Visible Roles
                                <span data-tooltip="" class="hint has-tip tip-button" data-width="200" title="Users in these roles will see the tab">?</span>
                            </legend>
                            <input id="role-all" type="checkbox">
                            <label for="role-all">Select All</label>
                            {% for role in roles %}
                                <input name="roles[]" data-role id="role-{{ role.id }}" type="checkbox" {% if rolesSelected[role.id] %}checked{% endif %} value="{{ role.id }}">
                                <label for="role-{{ role.id }}">{{ role.name }}</label>
                            {% endfor %}
                        </fieldset>
                    </div>
                </fieldset>
            </section>
        </div>
    </div>

    <div class="row">
        <div class="small-12 column">
            <ul class="flex-list buttons">
                <li><a href="{{ routeLookup('adminProfileButton.getIndex') }}" class="button">Cancel</button></a>
                <li><button type="submit" class="submit expand">Save</button></li>
            </ul>
        </div>
    </div>
</form>
<script>
    $(function() {
        // Icon preview
        $('[data-icon]').change(function() {
            $('#icon').attr('class', 'size-32 icon-' + $('#icon-select').val())
        });

        $('#icon').attr('class', 'size-32 icon-' + $('#icon-select').val())

        // Check all checkboxes if everything was selected
        var allChecked = true;

        // Roles
        $('[data-role]').each(function() {
            if (!$(this).prop('checked')) {
                allChecked = false;
            }
        });

        if (allChecked) {
            $('#role-all').prop('checked', true);
        }

        // Campuses
        $('[data-campus]').each(function() {
            if (!$(this).prop('checked')) {
                allChecked = false;
            }
        });

        if (allChecked) {
            $('#campus-all').prop('checked', true);
        }

        $('[data-campus]').change(function() {
            $('#campus-all').prop('checked', false);
        });

        $('#campus-all').change(function() {
            var status = $(this).prop('checked');
            $('[data-campus]').each(function() {
                $(this).prop('checked', status);
            });
        });

        $('[data-role]').change(function() {
            $('#role-all').prop('checked', false);
        });

        $('#role-all').change(function() {
            var status = $(this).prop('checked');
            $('[data-role]').each(function() {
                $(this).prop('checked', status);
            });
        });

    });
</script>