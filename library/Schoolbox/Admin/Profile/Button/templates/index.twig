{# checkboxString
 # Renders a text string that describes the checkboxes you ticked
 #
 # @param Profile\Button\Model      item a profileButton instance
 # @param Collection collection     a collection of checkbox item instances (e.g. all the role instances)
 # @param array selectedCollection  an associative array of index=>true pairs
 #}
{% macro checkboxString(item, collection, selectedCollection) %}
    {% set i = 1 %}
    {% set n = selectedCollection[item.id] | length %}

    {% for obj in collection %}
        {% if selectedCollection[item.id][obj.id] ?? false %}
            {{ obj.name }}{% if i < n %}, {% endif %}
            {% set i = i+1 %}
        {% endif %}
    {% endfor %}
{% endmacro %}
{% import _self as macro %}

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation profile #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        <div class="small-12 island {% if profile|length > 0 %}hide{% endif %}" id="profile-button-empty-state">
            <div class="empty-state">
                <i class="icon-staff-students"></i>
                <p><a href="{{ routeLookup('adminProfileButton.getCreate', {roleType: roleType}) }}">Add a custom button</a> to the profile page and 'My Students' dashboard component for certain users.</p>
            </div>
        </div>

        {% if profile | length > 0 %}
        <div class="small-12 island" id="profile-button-container">
            <ul class="sub-nav">
                {% for i in ['student', 'staff', 'parent'] %}
                    {% set selected = '' %}

                    {% if i == roleType %}
                        {% set selected = 'class="active"' %}
                    {% endif %}

                    {% set route = routeLookup('adminProfileButton.getIndex', {roleType: i}) %}
                    <li {{ selected|purify }}><a href="{{ route }}">{{ i|capitalize }}</a></li>
                {% endfor %}
            </ul>

            <div class="row actions-small-1">
                <div class="list-item">
                    <div class="small-12 island">
                        <h2 class="subheader">{{ roleType|capitalize }} Profile Buttons</h2>
                    </div>
                </div>
                <nav>
                    <a href="{{ routeLookup('adminProfileButton.getCreate', {roleType: roleType}) }}" class="icon-add" title="Create a new profile button"></a>
                </nav>
            </div>

            <section>
                <ul class="information-list sortable-card ui-sortable" id="profile-button-list">
                    {% for item in profile %}
                        <li data-profile-button="{{ item.id }}">
                            <div class="actions-small-2">
                                <div class="grip"></div>
                                <div class="list-item">
                                    <div class="card small-12 wrap-down">
                                        <a>
                                            <div class="icon-{{ item.icon }} size-64"></div>
                                            <h3>{{ item.text }}</h3>
                                        </a>

                                        <p class="meta">
                                            Available on profiles for
                                            <strong>{{ macro.checkboxString(item, roles, roleAvailabilitySelected) }}</strong> role(s)
                                            within
                                            <strong>{{ macro.checkboxString(item, campuses, campusAvailabilitySelected) }}</strong>
                                            campus
                                        </p>

                                        <p class="meta">
                                            Visible to viewers in
                                            <strong>{{ macro.checkboxString(item, roles, roleVisibilitySelected) }}</strong> role(s)
                                            within
                                            <strong>{{ macro.checkboxString(item, campuses, campusVisibilitySelected) }}</strong>
                                            campus
                                        </p>
                                    </div>
                                </div>
                                <nav>
                                    <a class="icon-modify" title="Edit this profile button" href="{{ routeLookup('adminProfileButton.getModify', {id: item.id}) }}"></a>
                                    <a class="icon-delete" data-delete="{{ item.id }}" title="Delete this profile button"></a>
                                </nav>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
        {% endif %}
    </div>
</div>

<div class="toast" data-button-toast></div>

<!-- BEGIN custom_head -->
<script>
    $(function () {
        $('#profile-button-list').sortable({
            handle: '.grip',
            axis: 'y',
            update: function () {
                var order = '';
                // Update the sort order in the database
                $('#profile-button-list').find('[data-profile-button]').each(function (e) {
                    if (order != '') {
                        order += ',';
                    }
                    order += $(this).data('profile-button');
                });

                $.post('{{ routeLookup('adminProfileButton.postOrder') }}', {
                    order: order
                });
            }
        });

        $('a[data-delete]').click(function (event) {
            event.preventDefault();

            var $toast = $('[data-button-toast]');

            var id = $(this).data('delete');
            var listItem = $(this).closest('li');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this profile button?',
                confirmLabel: 'Delete',
                confirmEvent: function () {
                    $toast.toastActivate({text: 'Deleting button...'});

                    $.post('{{ routeLookup('adminProfileButton.postDelete') }}', {
                        id: id
                    }).done(function (e) {
                        $(listItem).remove();

                        if ($('#profile-button-list').find('[data-profile-button]').length == 0) {
                            $('#profile-button-empty-state').removeClass('hide');
                            $('#profile-button-container').addClass('hide');
                        }
                        // Toast success
                        $toast.toastTimeout({text: 'Button deleted', css: 'success'});
                    }).fail(function() {
                        // Toast fail
                        $toast.toastTimeout({text: 'Delete failed', css: 'alert'});
                    });
                }
            });
        });
    });
</script>
<!-- END custom_head -->
