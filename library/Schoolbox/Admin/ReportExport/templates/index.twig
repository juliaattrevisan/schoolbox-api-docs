<script type="text/javascript"
        src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js"></script>
<script type="text/javascript"
        src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js"></script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        {% include '@settings/moduleConfig.twig' with configContext only %}
        <div class="small-12 island" id="formReportExport">
            <form class="top" id="reportExportForm" method="post" enctype="multipart/form-data" action="{{ routeLookupIfAuthorized('adminReportExport.postReport') }}">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="report-terms">{{ locale.term.properPlural }}</label>
                            <p class="meta">The report will only include assessments that are due between the start and end of these {{ locale.term.plural }}.</p>
                            <select data-actions name="terms[]" id="report-terms" multiple></select>
                        </div>
                        <script type="text/javascript">
                            {% autoescape 'js' %}

                            $('#report-terms').selectizeSelector({
                                multiple: true,
                                selectize: {
                                    create: false,
                                    placeholder: 'Search {{ locale.term.plural }}',
                                    preload: true,
                                    persist: true,
                                    hideSelected: true,
                                    load: function (query, callback) {
                                        $.ajax({
                                            url: '{{ routeLookup('adminReportExport.getTerms') }}',
                                            type: 'GET',
                                            dataType: 'json',
                                            data: {query: query}
                                        }).done(function (result) {
                                            callback(result)
                                        }).fail(function () {
                                            callback()
                                        })
                                    }
                                },
                            });
                            {% endautoescape %}
                        </script>
                    </fieldset>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <p class="meta">Select the students to be included in the report generation, all students in each group will be included in the final export.</p>
                            <label for="report-year-levels">Year levels</label>
                            <select data-actions name="yearLevels[]" id="report-year-levels" multiple></select>
                        </div>
                        <script type="text/javascript">
                            {% autoescape 'js' %}

                            $('#report-year-levels').selectizeSelector({
                                multiple: true,
                                selectize: {
                                    create: false,
                                    placeholder: 'Search year levels',
                                    preload: true,
                                    persist: true,
                                    hideSelected: true,
                                    load: function (query, callback) {
                                        $.ajax({
                                            url: '{{ routeLookup('adminReportExport.getYearLevels') }}',
                                            type: 'GET',
                                            dataType: 'json',
                                            data: {query: query}
                                        }).done(function (result) {
                                            callback(result)
                                        }).fail(function () {
                                            callback()
                                        })
                                    }
                                },
                            });
                            {% endautoescape %}
                        </script>
                        <div class="small-12 columns">
                            <label for="report-campuses">Campuses</label>
                            <select data-actions name="campuses[]" id="report-campuses" multiple></select>
                        </div>
                        <script type="text/javascript">
                            {% autoescape 'js' %}

                            $('#report-campuses').selectizeSelector({
                                multiple: true,
                                selectize: {
                                    create: false,
                                    placeholder: 'Search campuses',
                                    preload: true,
                                    persist: true,
                                    hideSelected: true,
                                    load: function (query, callback) {
                                        $.ajax({
                                            url: '{{ routeLookup('adminReportExport.getCampuses') }}',
                                            type: 'GET',
                                            dataType: 'json',
                                            data: {query: query}
                                        }).done(function (result) {
                                            callback(result)
                                        }).fail(function () {
                                            callback()
                                        })
                                    }
                                },
                            });
                            {% endautoescape %}
                        </script>
                        <div class="small-12 columns">
                            <label for="report-students">Students</label>
                            <select data-actions name="studentIds[]" id="report-students" multiple></select>
                        </div>
                        <script type="text/javascript">
                            {% autoescape 'js' %}

                            $('#report-students').selectizeSelector({
                                multiple: true,
                                ajax: {
                                    url: '/ajax/user.php',
                                    type: 'GET',
                                    data: {
                                        roleTypeID: 'student',
                                    },
                                    dataType: 'json'
                                },
                            });
                            {% endautoescape %}
                        </script>
                    </fieldset>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="showSummary">Include summary page</label>
                            <p class="meta">The summary page will display a list of subjects. You may choose to display just overall grades or the grades from specific assessments in each subject.</p>
                            <div class="switch">
                                <input name="showSummary" id="showSummary" type="checkbox" value="1"/>
                                <label for="showSummary">
                                    <span>ON</span>
                                    <span>OFF</span>
                                </label>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset id="summaryPageOptions" class="hide">
                        {% for optionId, summaryPageOption in summaryPageOptions %}
                            <div class="small-12 medium-6 large-6 columns">
                                <label for="{{ optionId }}">{{ summaryPageOption }}</label>
                                <div class="switch">
                                    <input name="{{ optionId }}" id="{{ optionId }}"
                                           type="checkbox" value="1"/>
                                    <label for="{{ optionId }}">
                                        <span>ON</span>
                                        <span>OFF</span>
                                    </label>
                                </div>
                            </div>
                        {% endfor %}
                    </fieldset>
                    <fieldset id="summaryPageAssessmentOptions" class="hide">
                        {% include '@adminReportExport/assessmentOptions.twig' with
                            {assessmentOptions: summaryAssessmentOptions, page: 'summary', workTypeOption: 'workTypes'} only %}
                    </fieldset>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="showClass">Include class page</label>
                            <p class="meta">This will include a new page in the report for each class.  This may include summary graphs and assessments for more detailed information about the class</p>
                            <div class="switch">
                                <input name="showClass" id="showClass" type="checkbox" value="1"/>
                                <label for="showClass">
                                    <span>ON</span>
                                    <span>OFF</span>
                                </label>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset id="classPageOptions" class="hide">
                        {% for optionId, classPageOption in classPageOptions %}
                            <div class="small-12 medium-6 large-6 columns">
                                <label for="{{ optionId }}">{{ classPageOption }}</label>
                                <div class="switch">
                                    <input name="{{ optionId }}" id="{{ optionId }}" type="checkbox"
                                           value="1"/>
                                    <label for="{{ optionId }}">
                                        <span>ON</span>
                                        <span>OFF</span>
                                    </label>
                                </div>
                            </div>
                        {% endfor %}
                    </fieldset>
                    <fieldset id="classPageAssessmentOptions" class="hide">
                        {% include '@adminReportExport/assessmentOptions.twig' with
                            {assessmentOptions: classAssessmentOptions, page: 'class', workTypeOption: 'classWorkTypes'} only %}
                    </fieldset>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label for="viewAs">View as</label>
                            <p class="meta">Only show assessment results that are visible as this type of user</p>
                            <select id="viewAs" name="viewAs">
                                <option value="staff">Staff</option>
                                <option value="student">Student</option>
                                <option value="parent">Parent</option>
                            </select>
                        </div>
                    </fieldset>
                </section>
                <input type="submit" class="expand" value="Download ZIP">
            </form>
        </div>
    </div>
</div>
<script>
    $('#showSummary').on('change', function () {
                if ($(this).is(":checked")) {
                    $('#summaryPageOptions').removeClass('hide');
                    $('#summaryPageAssessmentOptions').removeClass('hide');
                } else {
                    $('#summaryPageOptions').addClass('hide');
                    $('#summaryPageAssessmentOptions').addClass('hide');
                }
            }
    );
    $('#showClass').on('change', function () {
                if ($(this).is(":checked")) {
                    $('#classPageOptions').removeClass('hide');
                    $('#classPageAssessmentOptions').removeClass('hide');
                } else {
                    $('#classPageOptions').addClass('hide');
                    $('#classPageAssessmentOptions').addClass('hide');
                }
            }
    );
</script>
