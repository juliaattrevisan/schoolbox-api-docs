{#
assessment
#}
<div class="row row__{{ page }}-details">
    <div class="small-4 columns">
        <p class="item-title">Assessment</p>
        <h3 class="heading__tertiary">
            {{ assessment.title }}
        </h3>
    </div>

    {# Only show comment if it exists
     # Otherwise, just occupy small-6 space
     # Foundation-related behaviour requires a character to do that
     #}
    {% if showComments and feedback %}
        <div class="small-6 columns">
            {% if feedback.comment %}
                <p class="item-title">Comment</p>
                <p>{{ feedback.comment | linkify | nl2br }}</p>
            {% else %}
                &nbsp;
            {% endif %}
        </div>
    {% endif %}

    <div class="small-1 columns text-right">
        {% if feedback %}
            {% set grade = feedback.humanReadableMark %}
            {% if showGrades and grade %}
                <p class="item-title text-right">Result</p>
                <h3 class="heading__tertiary text-right">{{ grade }}</h3>
            {% endif %}
        {% endif %}

        {# Was this really how we did it?
         # I could have sworn there was a real way to determine an assessment's class
         # rather than this random loose comparison
         #}
        {% if assessment.familyName == 'project' %}
            {% set participant = assessment.allParticipants[student.id] %}
            <h3 class="heading__tertiary text-right">{{ assessment.humanReadableMark(participant, true) }}</h3>
        {% endif %}
    </div>

    {% if feedback %}
        {% if showRubrics and feedback.rubricMarkedGrid %}
        <div class="small-12 columns">
            <div class="rubric-wrap">
                {% include '@rubric/grid.twig' with {
                    rubricGrid:       feedback.rubricMarkedGrid.grid,
                    rubricMarkedGrid: feedback.rubricMarkedGrid,
                    learner: student,
                    showDescriptorValue: true,
                    showGroupTotal: true,
                    showRubricTotal: true,
                    selfAssessmentFeedback: null
                } only %}
            </div>
        </div>
        {% endif %}
    {% endif %}
</div>
