{##
 # List of Summative Reports
 #
 # @param GenericCollection $reports  A list of ReportExport/Model instances
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">
        {% if reports|length %}
            <div class="small-12 island">
                <section>
                    <ul class="information-list">
                        {% for report in reports %}
                        <li class="actions-small-4">
                            <div class="list-item">
                                <div class="card small-12">
                                    <a href="#">
                                        <h3>{{ report.title }}</h3>
                                    </a>
                                    <p class="meta">
                                        Last modified by {{ report.updatedBy.fullname }} on {{ report.updatedAt.local }}
                                    </p>
                                </div>
                            </div>
                            <nav>
                                <a class="icon-download" href="#" title="Generate"></a>

                                {% set updateRoute = routeLookupIfAuthorized('adminReportExport.getUpdate', {reportId: report.id}) %}
                                {% if updateRoute %}
                                    <a class="icon-modify" href="{{ updateRoute }}" title="Modify"></a>
                                {% endif %}

                                <a class="icon-copy" href="#" title="Duplicate"></a>
                                <a class="icon-delete" href="#" title="Delete"></a>
                            </nav>
                        </li>
                        {% endfor %}
                    </ul>
                </section>
            </div>
        {% else %}
            {% set createRoute = routeLookupIfAuthorized('adminReportExport.getCreate') %}

            <div class="empty-state">
                <i class="icon-progress"></i>
                <p>There aren't any summative reports yet.</p>
                {% if createRoute %}
                <p><a href="{{ createRoute }}">Create one</a> so you can generate the reports later.</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>


