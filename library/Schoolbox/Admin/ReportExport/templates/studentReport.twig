<style>
    /* chromeFoundation */
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Droid Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-style: normal;
        font-weight: 400;
        line-height: 1.25;
    }

    img {
        display: inline-block;
        vertical-align: middle;
    }


    .text-right {
        text-align: right;
        margin-left: 1em;
    }

    .report-category {
        color: green;
    }

    .island section {
        margin-bottom: 1rem;
    }

    .row {
        max-width: none;
    }

    .row:after {
        clear: both;
    }

    .row:before, .row:after {
        content: " ";
        display: table;
    }

    .row__margin-bottom {
        margin-bottom: 1rem;
    }

    .row__flex {
        display: flex;
        justify-content: space-between;
    }

    .row__flex:before,
    .row__flex:after {
        content: none;
    }
    .row-container {
        border-bottom: 1px solid lightgray;
    }

    .row__subject-summary-result,
    .row__subject-summary-details,
    .row__subject-details {
        margin-top: -1px; /*to avoid 2px borders */
        padding: 0.5rem 0;
    }
    .row__subject-summary-result {
        border: 1px solid dimgrey;
        background-color: lightgrey;
    }

    .row__subject-details:last-of-type {
        border-bottom: none;
    }

    .row__subject-summary-details {
        padding: 0.5rem 0.25rem;
    }

    .row__subject-summary-details .columns,
    .row__subject-detail .columns {
        margin-bottom: 0.25rem;
    }

    .row__subject-start {
        margin-top: 1rem;
    }

    .card.compact {
        min-height: 2.5rem;
        padding: 0 1rem;
    }

    .columns {
        position: relative;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        float: left;
    }

    .columns .columns { /* avoid double paddings */
        padding: 0;
    }

    .text-center, .card.compact [class*=icon-] {
        text-align: center !important;
    }

    .heading__primary, .heading__secondary, .heading__tertiary {
        margin: 0;
    }

    .heading__primary {
        font-size: 1.6rem;
    }

    .heading__secondary {
        font-size: 1.2rem;
    }

    .heading__tertiary {
        font-size: 1rem;
        padding-top: 0.25rem;
        padding-bottom: 0.25rem;
    }

    .heading__subject {
        margin-bottom: 1rem;
    }

    /* Quarantine zone
     */

    /* Vaguely analogous to A4 dimensions so you can preview in browser
     * otherwise the pdf print wraps in a different place, throwing your judgement
     */
    .report {
        width: 1100px;
        margin: auto;
    }

    /* Typography
     */
    p,
    h1, h2, h3, h4, h5, h6 {
        color: black;
        margin: 0;
        padding: 0;
    }

    h1 {
        font-size: 2.45rem;
        margin-bottom: 0.25rem;
    }

    h2 {
        font-size: 1.75rem;
    }

    h3 {
        font-size: 1.5rem;
    }

    h4 {
        font-size: 1.3rem;
    }

    h5 {
        font-size: 1.15rem;
    }

    h6 {
        font-size: 1rem;
    }

    /* Make background colours print
     */
    body {
        -webkit-print-color-adjust: exact !important;
    }

    /* header-content is stuff at the top of the report
     * Report title, school name, logo
     */
    .header-content {
        display: flex;
        align-items: center;
    }

    /* Left hand column in the header - contains report title, school name
     */
    .header-content .left {
        flex-grow: 2;
    }

    /* Special cosmetic representation of semantic h1
     * The report title should look like it pwns your face
     * Linux doesn't have a good equivalent to TNR so...I picked a nice one
     */
    .header-content h1 {
        font-family: FreeSerif, "Times New Roman", serif;
        font-weight: normal;
    }

    /* Special cosmetic representation of semantic h2
     * If there isn't a logo, the margin-bottom pushes everything else around
     * to provide appropriate negative space
     */
    .header-content h2.school-name {
        font-family: FreeSerif, "Times New Roman", serif;
        font-size: 1.5rem;
        font-weight: normal;
        margin: 0 0 2rem 0;
    }

    /* Ensure school logos have a max dimension
     * so broken svgs don't break YOU
     */
    .logo {
        max-width: 12rem;
        margin: 0 0 0 2rem;
        padding: 0;
    }

    /* The thing that tells you about students
     */
    .card {
        float: left;
        margin-top: 2rem;
        margin-bottom: 2rem;
        position: relative;
    }

    /* Removes side padding on student card at top when there's no picture
     */
    .card.no-pad {
        padding-left: 0;
        padding-right: 0;
    }

    .card .name {
        margin: 0;
    }

    .card .year {
        font-size: 1.2rem;
        margin: 0 0 1rem 0;
    }

    .card.compact > * {
        align-items: center;
        display: flex;
    }

    .card h2 {
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
        margin-top: 0;
        margin-bottom: 0;
    }

    .compact img {
        width: 2rem;
    }

    .card img, .card .img, .card [class^=icon-], .card [class*=" icon-"] {
        float: left;
        margin-right: 0.75rem;
    }

    /* Introductory text
     * Can't tell what the schools are going to compose here, but I imagined this
     * as a lead-in paragraph which should typographically be different than the
     * rest of the body text in this report
     */
    .introduction {
        margin-top: 2rem;
    }

    /* Name of the subject/folder has a special style
     * which also encompasses the subject's overall grade
     * Use a flexbox to optionally show a grade
     */
    .folder-title {
        background: lightgrey;
        border: 1px solid black;
        display: flex;
        padding: 0.75rem;
    }

    .folder-title .left {
        flex-grow: 2;
    }

    /* A grade value, suitable for Folder Title
     * or for an assessment
     */
    .grade {
        border-left: 1px solid #333;
        font-size: 1.5rem;
        font-weight: bold;
        padding-left: 2rem;
        padding-right: 0.75rem;
    }

    /* For some reason there's a thing called a summary result
     * and another thing called a subject result, but the demo
     * data makes them all seem the same data? Unsure of the
     * functional difference between the two
     */
    .columns__subject-summary-result,
    .columns__subject-result {
        border-left: 1px solid #333;
        float: right;
        padding-left: 2rem;
        text-align: right;
    }

    /* The width of the Assessment and Grade columns
     * Using small-* names is going to be misleading - specify them explicitly
     */
    .feedback-assessment {
        width: 77%;
    }

    /* These appear the name of the assessment and the comment
     * as little subtitle sort of things
     */
    .worktype {
        color: grey;
        font-size: 0.75rem;
        font-style: italic;
        margin-top: 0.25rem;
    }

    /* The grade column always sits adjacent to assessment column
     */
    .feedback-grade {
        float: right;
        text-align: right;
        width: 15%;
    }

    /* These are used, but derived programmatically - storm thinks they are unused
     * See the top of assessmentReport.twig which uses the `page` var as css classname
     */
    .row__subject-details,
    .row__subject-summary-details {
        border-bottom: 1px solid #ccc;
    }

    /* Push the rubric grid down a little bit, if it exists
     */
    .rubric-wrap {
        display: block;
        float: left;
        margin-top: 1rem;
        margin-bottom: 2rem;
        width: 100%;
    }

    /* Rubric table
     * This is the only table element we render here
     */
    table.rb {
        border-collapse: collapse;
        table-layout: fixed;
        width: 100%;
        font-size: 0.75rem;
    }

    /* Headings were oddly grey by intent but black we go
     */
    th p {
        text-align: left;
        word-wrap: break-word;
    }

    /* All cells have lines everywhere around it
     * All cells have padding just because
     */
    .rb th, .rb td {
        border: solid 1px #8c8c8c;
        padding: 4px;
    }

    /* All descriptor cells top-align
     */
    .rb td {
        vertical-align: top
    }

    /* The value of a descriptor, if such a value exists
     */
    .rb-value {
        color: #acacac;
    }

    /* All descriptor cells have black text regardless of their selection state
     */
    .rb-selected .rb-description, .rb-selected .rb-value {
        color: black;
    }

    /* The descriptor that was selected by the instructor
     */
    .rb-selected {
        background-color: lightgray !important;
        border-left: 2px solid black !important;
    }

    th.rb-final-summary {
        padding: 0.5rem;
    }

    /* Rubric heading cells for Capabilities, Indicators, Levels
     * Use a lighter shade of grey than selected Descriptors
     */
    .rb th {
        background-color: #ececec;
    }

    /* Capabilities can optionally have a mark
     */
    .rb th.rb-group-summary {
        padding: 0.33rem;
        font-size: 1rem;
        text-align: left;
    }

    /* Top-left cell is a meaningless cell
     */
    .rb.markable thead tr th:first-child {
        background-color: transparent;
        border-left: 0;
        border-top: 0;
    }

    /* Contents of capabilities, indicators, descriptors can have markdown
     */
    .markdown li, .markdown p {
        white-space: pre-wrap;
    }


    @page {
        counter-increment: page;
        size: A4 portrait; /* try and enforce portrait orientation */
        margin: 0.25in;
        @bottom-right {
            content: 'Page ' counter(page) ' / ' counter(pages);
        }
    }

    @media print {
        .content, .island {
            padding: 0; /* to get more of the page real estate */
        }

        .row__subject-start {
            page-break-before: always; /* ensure each individual subject goes on new page */
        }

        table {
            page-break-before: always;
        }
    }
    /* Medium devices (landscape tablets, 768px and up) */
    @media only screen and (min-width: 768px) {
        .island{
            width: 90%;
        }
    }
    /* Large devices (laptops/desktops, 1020px and up) */
    @media only screen and (min-width: 1020px) {
        .island {
            width: 80%;
        }
        td {
            width: 70%;
        }
    }
    /* Larger devices (Desktops/Screens, 1200px and up) */
    @media only screen and (min-width: 1200px) {
        .island {
            width: 70%;
        }
        td {
            width: 70%;
        }
    }
</style>

<div class="report">
    <section class="content">
        <div class="header-content">
            <div class="left">
                <h1>{{ config.report_title }}</h1>
                <h2 class="school-name">{{ config.school_name }}</h2>
            </div>
            {% if config.report_school_logo %}
            <img src="/storage/image.php?hash={{ config.report_school_logo }}" alt="{{ config.school_name }}" class="logo" />
            {% endif %}
        </div>

        <div class="card {% if not student.portrait %}no-pad{% endif %}">
            {% if student.portrait %}
            <img src="/portrait.php?id={{ student.id }}&amp;size=square64" alt="{{ student.fullName }}" />
            {% endif %}
            <h3 class="name">{{ student.fullname }}</h3>

            {# Only show year if it was ever set and meaningful
             #}
            {% if student.year and student.year.longName != '' %}
            <p class="year">{{ student.year.longName }}</p>
            {% endif %}

            <div class="introduction">
                {{ config.report_export_introduction | purify }}
            </div>
        </div>

        {# Summary #}
        {% if showSummary %}
            {% for folder in folders %}
                {% set studentGrade = markbooks[folder.id].studentStatistics[student.id] %}
                {% set weightedMean = studentGrade.weightedMean %}
                <div class="folder-title">
                    <div class="left">
                        <h4>{{ folder.title }}</h4>
                    </div>

                    {% if showSummaryOverallGrade %}
                    <p class="grade">{{ weightedMean ?? '' }}</p>
                    {% endif %}
                </div>

                {% if (summaryAssessments[folder.id] ?? [])| length %}
                    {% for assessment in summaryAssessments[folder.id] %}
                        {% set participant = assessment ? assessment.participantIfExtant(student) : null %}
                        {% include '@adminReportExport/assessmentReport.twig' with
                            {
                                student: student,
                                assessment: assessment,
                                feedback: summaryAssessmentFeedbacks[assessment.id] ?? null,
                                showGrades: showSummaryGrades,
                                showComments: showSummaryComments,
                                showRubrics: showSummaryRubrics,
                                page: 'subject-summary'
                            } only %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        {% endif %}

        {# Class #}
        {% if showClass %}
            {% for folder in folders %}
                {% set studentGrade = markbooks[folder.id].studentStatistics[student.id] %}
                {% set weightedMean = studentGrade.weightedMean %}
                <div class="row row__margin-bottom row__subject-start">
                    <div class="small-10 columns">
                        <h2 class="heading__secondary heading__subject">{{ folder.title }}</h2>
                        {% for teacher in folder.teachers %}
                            <div class="card compact">
                                <img src="/portrait.php?id={{ teacher.id }}&size=square32" />
                                <h2 class="heading__tertiary">{{ teacher.fullname }}</h2>
                            </div>
                        {% endfor %}
                    </div>
                    {% if showClassOverallGrade and weightedMean %}
                        <div class="small-2 columns columns__subject-result">
                            <h3 class="heading__tertiary">{{ weightedMean ?? '' }}</h3>
                        </div>
                    {% else %}
                        <div class="small-2 columns">
                        </div>
                    {% endif %}
                </div>

                {% if (classAssessments[folder.id] ?? [])| length %}
                    {% for assessment in classAssessments[folder.id] %}
                        {% include '@adminReportExport/assessmentReport.twig' with
                            {
                                student: student,
                                assessment: assessment,
                                feedback: classAssessmentFeedbacks[assessment.id] ?? null,
                                showGrades: showClassGrades,
                                showComments: showClassComments,
                                showRubrics: showClassRubrics,
                                page: 'subject'
                            } only %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        {% endif %}
    </section>
</div>
