<style>
    /* chromeFoundation */
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Droid Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-style: normal;
        font-weight: 400;
        line-height: 1.25;
    }

    img {
        display: inline-block;
        vertical-align: middle;
    }

    p,
    h1,
    h2,
    h3 {
        color: black;
    }

    .report {
        margin: auto;
    }

    p,
    .rb-value {
        font-size: 0.75rem;
    }
    .island {
        margin-top: 2em;
    }

    /* Dimensioning
     * Foundation classes small-* etc. are now arbitrarily defined here
     * with percentage widths. They no longer need to add up to 12
     */
    .small-1 {
        width:9%;
    }

    .small-2 {
        width:12%;
    }

    .small-4 {
        width:33% !important;
    }

    .small-5 {
        width: 41%;
    }

    .small-6 {
        width: 50%;
    }

    .small-10 {
        width: 75%;
    }

    .text-right {
        text-align: right;
        margin-left: 1em;
    }

    .report-category {
        color: green;
    }

    .header-content{
        display: flex;
        justify-content: space-between;
    }
    .header-content div:first-child {
        min-width: 50%;
    }
    .logo{
        max-width: 200px;
    }
    .header-content div:nth-child(2) h1 {
        text-align: right;
        margin-bottom: 0.25em;
    }

    .island .content {
        padding: 0.75rem;
    }

    .island section {
        margin-bottom: 16px;
    }

    .row {
        max-width: none;
    }

    .row:after {
        clear: both;
    }

    .row:before, .row:after {
        content: " ";
        display: table;
    }

    .row__margin-bottom {
        margin-bottom: 1rem;
    }

    .row__flex {
        display: flex;
        justify-content: space-between;
    }

    .row__flex:before,
    .row__flex:after {
        content: none;
    }
    .row-container {
        border-bottom: 1px solid lightgray;
    }

    .row__subject-summary-result,
    .row__subject-summary-details,
    .row__subject-details {
        margin-top: -1px; /*to avoid 2px borders */
        padding: 0.5rem 0;
    }
    .row__subject-summary-result {
        border: 1px solid dimgrey;
        background-color: lightgrey;
    }
    tbody  {
        text-align: left;
    }
    table {
        table-layout: fixed;
        width: 100% ;
    }
    th {
        width: 30%;
        background-color: lightgrey;
    }
    th p{
        color: #333333;
        text-align: left;
        word-wrap: break-word;
    }
    table p {
        margin: 0.25em;
        text-align: start;
    }
    .row__subject-details:last-of-type {
        border-bottom: none;
    }

    .row__subject-summary-details {
        padding: 0.5rem 0.25rem;
    }

    .row__subject-summary-details .columns,
    .row__subject-detail .columns {
        margin-bottom: 0.25rem;
    }

    .row__subject-start {
        margin-top: 1rem;
    }

    .card {
        float: left;
        position: relative;
        padding: 0.5rem 1rem 0 1rem;
    }

    .card.compact {
        min-height: 2.5rem;
        padding: 0 1rem;
    }

    .card.compact > * {
        align-items: center;
        display: flex;
    }

    .card h2 {
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
        margin-top: 0;
        margin-bottom: 0;
    }

    .compact img {
        width: 2rem;
    }

    .card img, .card .img, .card [class^=icon-], .card [class*=" icon-"] {
        float: left;
        margin: -0.25rem 0.5rem 0 -0.5rem;
    }

    .columns {
        position: relative;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        float: left;
    }

    .columns .columns { /* avoid double paddings */
        padding: 0;
    }

    .text-center, .card.compact [class*=icon-] {
        text-align: center !important;
    }

    .heading__primary, .heading__secondary, .heading__tertiary {
        margin: 0;
    }

    .heading__primary {
        font-size: 1.6rem;
    }

    .heading__secondary {
        font-size: 1.2rem;
    }

    .heading__tertiary {
        font-size: 1rem;
    }

    .heading__subject {
        margin-bottom: 1rem;
    }

    /* rubric */
    table.rb {
        border-collapse: collapse;
    }
    .rb th, .rb td {
        border: solid 1px #8c8c8c;
        padding: 0px 2px;
    }
    .rb-description, .rb-value {
        color: #acacac;
    }

    .rb-selected .rb-description, .rb-selected .rb-value {
        color: black;
    }
    .rb-selected {
        background-color: lightgray !important;
        border-left: 2px solid black !important;
    }

    th.rb-final-summary {
        padding: 0.5rem;
    }

    .markdown li, .markdown p {
        white-space: pre-wrap;
    }

    /* Begin Steve Quarantine Styles
     */

    /* Make background colours print
     */
    body {
        -webkit-print-color-adjust: exact !important;
    }

    /* Name of the subject/folder has a special style
     * which also encompasses the subject's overall grade
     */
    .folder-title {
        background: lightgrey;
        border: 1px solid black;
        padding: 0.75rem 0.25rem;
    }

    /* For some reason there's a thing called a summary result
     * and another thing called a subject result, but the demo
     * data makes them all seem the same data? Unsure of the
     * functional difference between the two
     */
    .columns__subject-summary-result,
    .columns__subject-result {
        border-left: 1px solid #333;
        float: right;
        padding-left: 2rem;
        text-align: right;
    }

    /* These appear the name of the assessment and the comment
     * as little subtitle sort of things
     */
    .item-title {
        color: grey;
    }

    /* The width of the Assessment, Comment and Grade columns
     * Using small-* names is going to be misleading - specify them explicitly
     */
    .feedback-assessment {
        width: 30%;
    }

    .feedback-comment {
        width: 47%;
    }

    .feedback-grade {
        float: right;
        text-align: right;
        width: 15%;
    }

    /* This is a special case when a rubric grid displays
     * Takes up the width of feedback-assessment + feedback-comment
     */
    .feedback-rubric-comment {
        width: 77%;
    }

    /* These are used, but derived programmatically - storm thinks they are unused
     * See the top of assessmentReport.twig which uses the `pag` var as css clasname
     */
    .row__subject-details,
    .row__subject-summary-details {
        border-bottom: 1px solid #ccc;
    }

    /* Push the rubric grid down a little bit, if it exists
     */
    .rubric-wrap {
        margin-top: 0.75rem;
        margin-bottom: 1rem;
    }

    /* Rubric heading cells for Capabilities, Indicators, Levels
     * Use a lighter shade of grey than selected Descriptors
     */
    .rb th {
        background-color: #ececec;
    }

    /* I think floating elements cause this to need such a large margin
     * since they are no longer in document flow
     */
    .rb.markable {
        margin-top: 4.5rem;
    }

    /* Top-left cell is a meaningless cell
     */
    .rb.markable thead tr th:first-child {
        background-color: transparent;
        border-left: 0;
        border-top: 0;
    }

    /* End Steve Quarantine Styles
     */

    @page {
        counter-increment: page;
        size: A4 portrait; /* try and enforce portrait orientation */
        margin: 0.1in ! default; /* stretch out the left/right margins further */
        @bottom-right {
            content: 'Page ' counter(page) ' / ' counter(pages);
        }
    }

    @media print {
        .content, .island {
            padding: 0; /* to get more of the page real estate */
        }

        .row__subject-start {
            page-break-before: always; /* ensure each individual subject goes on new page */
        }

        table {
            page-break-before: always;
        }
    }
    /* Medium devices (landscape tablets, 768px and up) */
    @media only screen and (min-width: 768px) {
        .island{
            width: 90%;
        }
    }
    /* Large devices (laptops/desktops, 1020px and up) */
    @media only screen and (min-width: 1020px) {
        .island {
            width: 80%;
        }
        td {
            width: 70%;
        }
    }
    /* Larger devices (Desktops/Screens, 1200px and up) */
    @media only screen and (min-width: 1200px) {
        .island {
            width: 70%;
        }
        td {
            width: 70%;
        }
    }
</style>

<div class="small-12 island report">
    <section class="content">
        <div class="header-content">
            <div class="row row__margin-bottom">
                <div class="card small-12">
                    {% if student.portrait is not null %}
                        <img src="/portrait.php?id={{ student.id }}&amp;size=square64" alt="{{ student.fullName }}" />
                    {% endif %}
                    <h2 class="heading__primary">{{ student.fullname }}</h2>
                    <h3 class="heading__secondary">{{ student.year.longName ?? '' }}</h3>
                </div>
            </div>
            <div class="row row__margin-bottom">
                <h1 class="heading__secondary">{{ config.school_name }}</h1>
                {% if config.report_school_logo %}
                    <img src="/storage/image.php?hash={{ config.report_school_logo }}" alt="{{ config.school_name }}" class="logo" />
                {% endif %}
            </div>
        </div>
        <div class="row row__margin-bottom">
            {{ config.report_export_introduction | purify }}
        </div>
        {# Summary #}
        {% if showSummary %}
            {% for folder in folders %}
                {% set studentGrade = markbooks[folder.id].studentStatistics[student.id] %}
                {% set weightedMean = studentGrade.weightedMean %}
                <div class="row folder-title">
                    <div class="small-10 columns">
                        <h3 class="heading__secondary">{{ folder.title }}</h3>
                    </div>
                    <div class="small-1 columns columns__subject-summary-result">
                        {% if showSummaryOverallGrade %}
                        <h3 class="heading__secondary">{{ weightedMean ?? '' }}</h3>
                        {% endif %}
                    </div>
                </div>
                {% if (summaryAssessments[folder.id] ?? [])| length %}
                    {% for assessment in summaryAssessments[folder.id] %}
                        {% set participant = assessment ? assessment.participantIfExtant(student) : null %}
                        {% include '@adminReportExport/assessmentReport.twig' with
                            {
                                student: student,
                                assessment: assessment,
                                feedback: summaryAssessmentFeedbacks[assessment.id] ?? null,
                                showGrades: showSummaryGrades,
                                showComments: showSummaryComments,
                                showRubrics: showSummaryRubrics,
                                page: 'subject-summary'
                            } only %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        {% endif %}

        {# Class #}
        {% if showClass %}
            {% for folder in folders %}
                {% set studentGrade = markbooks[folder.id].studentStatistics[student.id] %}
                {% set weightedMean = studentGrade.weightedMean %}
                <div class="row row__margin-bottom row__subject-start">
                    <div class="small-10 columns">
                        <h2 class="heading__secondary heading__subject">{{ folder.title }}</h2>
                        {% for teacher in folder.teachers %}
                            <div class="card compact">
                                <img src="/portrait.php?id={{ teacher.id }}&size=square32" />
                                <h2 class="heading__tertiary">{{ teacher.fullname }}</h2>
                            </div>
                        {% endfor %}
                    </div>
                    {% if showClassOverallGrade and weightedMean %}
                        <div class="small-2 columns columns__subject-result">
                            <h3 class="heading__tertiary">{{ weightedMean ?? '' }}</h3>
                        </div>
                    {% else %}
                        <div class="small-2 columns">
                        </div>
                    {% endif %}
                </div>

                {% if (classAssessments[folder.id] ?? [])| length %}
                    {% for assessment in classAssessments[folder.id] %}
                        {% include '@adminReportExport/assessmentReport.twig' with
                            {
                                student: student,
                                assessment: assessment,
                                feedback: classAssessmentFeedbacks[assessment.id] ?? null,
                                showGrades: showClassGrades,
                                showComments: showClassComments,
                                showRubrics: showClassRubrics,
                                page: 'subject'
                            } only %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        {% endif %}
    </section>
</div>
