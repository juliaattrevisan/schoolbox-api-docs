<style>
    /* chromeFoundation */
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Droid Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-style: normal;
        font-weight: 400;
        line-height: 1.25;
    }

    img {
        display: inline-block;
        vertical-align: middle;
    }

    p, 
    h1, 
    h2, 
    h3 {
        color: black;
    }

    p,
    .rb-value {
        font-size: 0.825rem;
    }

    .small-12 {
        width: 98%;
    }

    .small-10 {
        width: 75%;
    }

    .small-2 {
        width: 15%;
    }

    .island .content {
        padding: 0.75rem;
    }

    .island section {
        margin-bottom: 16px;
    }

    .row {
        max-width: none;
    }

    .row:after {
        clear: both;
    }

    .row:before, .row:after {
        content: " ";
        display: table;
    }

    .row__margin-bottom {
        margin-bottom: 1rem;
    }

    .row__flex { 
        display: flex;
        justify-content: space-between;
    }

        .row__flex:before,
        .row__flex:after {
            content: none;
        }

    .row__subject-summary-result,
    .row__subject-summary-details,
    .row__subject-details {
        border: 1px solid black;
        margin-top: -1px; /*to avoid 2px borders */
        padding: 0.5rem 0;
    }

    .row__subject-summary-details {
        padding: 0.5rem 0.25rem;
    }

    .row__subject-summary-details .columns,
    .row__subject-detail .columns {
        margin-bottom: 0.25rem;
    }

    .row__subject-start {
        margin-top: 1rem;
    }

    .card {
        float: left;
        position: relative;
        padding: 0.5rem 1rem 0 1rem;
    }

    .card.compact {
        min-height: 2.5rem;
        padding: 0 1rem;
    }

    .card.compact > * {
        align-items: center;
        display: flex;
    }

    .card h2 {
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
        margin-top: 0;
        margin-bottom: 0;
    }

    .card img, .card .img {
        width: 4rem;
    }

    .card img, .card .img, .card [class^=icon-], .card [class*=" icon-"] {
        float: left;
        margin: -0.25rem 0.5rem 0 -0.5rem;
    }

    .columns {
        position: relative;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        float: left;
    }

        .columns .columns { /* avoid double paddings */
            padding: 0;
        }

    .columns + .columns:last-child {
        float: left;
    }

    .text-center, .card.compact [class*=icon-] {
        text-align: center !important;
    }

    .columns__subject-summary-result {
        border-left: 1px solid black;
    }

    .columns__subject-result {
        border: 2px solid black;
        padding: 0.25rem 0;
    }

    .heading__primary, .heading__secondary, .heading__tertiary {
        margin: 0;
    }

    .heading__primary {
        font-size: 1.4rem;
    }

    .heading__secondary {
        font-size: 1.2rem;
    }

    .heading__tertiary {
        font-size: 1rem;
    }

    .heading__subject {
        margin-bottom: 1rem;
    }

    /* rubric */
    table.rb {
        border-collapse: collapse;
    }
    .rb th, .rb td {
        border: solid 1px #8c8c8c;
        padding: 0px 2px;
    }
    .rb-description, .rb-value {
        color: #acacac;
    }

    .rb-selected .rb-description, .rb-selected .rb-value {
        color: #000000;
    }

    th.rb-final-summary {
        padding: 0.5rem;
    }

    @page {
        counter-increment: page;
        size: A4 portrait; /* try and enforce portrait orientation */
        margin: 0.1in ! default; /* stretch out the left/right margins further */
        @bottom-right {
            content: 'Page ' counter(page) ' / ' counter(pages);
        }
    }

    @media print {
        .content, .island {
            padding: 0; /* to get more of the page real estate */
        }

        .row__subject-start {
            page-break-before: always; /* ensure each individual subject goes on new page */
        }

        #footer {
            display: none;
        }
    }
</style>
<div class="small-12 island">
    <section class="content">
        <div class="row row__margin-bottom row__flex">
            <h1 class="heading__primary">{{ config.school_name }}</h1>
            {% if config.report_school_logo %}
            <img src="/storage/image.php?hash={{ config.report_school_logo }}&size=square128" alt="{{ config.school_name }}" class="logo" />
            {% endif %}
        </div>
        <div class="row row__margin-bottom">
            {{ config.report_export_introduction | purify }}
        </div>
        <div class="row row__margin-bottom">
            <div class="card small-12">
                <img src="/portrait.php?id={{ student.id }}&amp;size=square64" alt="{{ student.fullName }}"/>
                <h2 class="heading__secondary">{{ student.fullname }}</h2>
                <h3 class="heading__tertiary">{{ student.year.longName ?? '' }}</h3>
            </div>
        </div>
        {# Summary #}
        {% if showSummary %}
            {% for folder in folders %}
                {% set studentGrade = markbooks[folder.id].studentStatistics[student.id] %}
                {% set weightedMean = studentGrade.weightedMean %}
                <div class="row row__subject-summary-result">
                    <div class="small-10 columns">
                        <h3 class="heading__secondary">{{ folder.title }}</h3>
                    </div>
                    <div class="small-2 columns columns__subject-summary-result">
                        {% if showSummaryOverallGrade %}<h3
                                class="heading__secondary text-center">{{ weightedMean ?? '' }}</h3>{% endif %}
                    </div>
                </div>
                {% if (summaryAssessments[folder.id] ?? [])| length %}
                    {% for assessment in summaryAssessments[folder.id] %}
                        {#                        {% set participant = assessment ? assessment.participantIfExtant(student) : null %} #}
                        {% include '@adminReportExport/assessmentReport.twig' with
                            {
                                student: student,
                                assessment: assessment,
                                feedback: summaryAssessmentFeedbacks[assessment.id] ?? null,
                                showGrades: showSummaryGrades,
                                showComments: showSummaryComments,
                                showRubrics: showSummaryRubrics,
                                page: 'subject-summary'
                            } only %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        {% endif %}
        {# Class #}
        {% if showClass %}
            <div class="row row__margin-bottom">
                <div class="small-12 columns"></div>
            </div>
            {% for folder in folders %}
                {% set studentGrade = markbooks[folder.id].studentStatistics[student.id] %}
                {% set weightedMean = studentGrade.weightedMean %}
                <div class="row row__margin-bottom row__subject-start">
                    <div class="small-10 columns">
                        <h2 class="heading__secondary heading__subject">{{ folder.title }}</h2>
                        {% for teacher in folder.teachers %}
                            <div class="card compact">
                                <img src="/portrait.php?id={{ teacher.id }}&size=square32"/>
                                <h2 class="heading__tertiary">{{ teacher.fullname }}</h2>
                            </div>
                        {% endfor %}
                    </div>
                    {% if showClassOverallGrade and weightedMean %}
                        <div class="small-2 columns columns__subject-result">
                            <h3 class="heading__tertiary text-center">{{ weightedMean ?? '' }}</h3>
                        </div>
                    {% else %}
                        <div class="small-2 columns">
                        </div>
                    {% endif %}
                </div>
                {% if (classAssessments[folder.id] ?? [])| length %}
                    {% for assessment in classAssessments[folder.id] %}
                        {% include '@adminReportExport/assessmentReport.twig' with
                            {
                                student: student,
                                assessment: assessment,
                                feedback: classAssessmentFeedbacks[assessment.id] ?? null,
                                showGrades: showClassGrades,
                                showComments: showClassComments,
                                showRubrics: showClassRubrics,
                                page: 'subject'
                            } only %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        {% endif %}
    </section>
</div>
