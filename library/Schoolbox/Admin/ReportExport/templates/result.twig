{% set warnings = ["X warning","Y warning"] %}
<style>

    .wait-content {
        width: 50%;
        margin: auto;
    }

    .wait-content h1 {
        font-weight: bold;
        text-align: center;
        margin-top: 1rem;
    }

    #wave-1, #wave-3 {
        animation: waves 3.5s ease-in-out infinite;
    }

    #wave-2, #wave-4 {
        animation: waves-alt 3s ease-in-out infinite;
    }

    #wave-5 {
        animation: wave-bounce 2.5s ease-in-out infinite;
        transform-box: fill-box;
        transform-origin: center;
    }

    #wave-6, #wave-9 {
        animation: waves 3s ease-in-out infinite;
    }

    #wave-7 {
        animation: waves-alt 3.5s ease-in-out infinite;
    }

    #wave-8 {
        animation: small-wave-bounce 3s ease-in-out infinite;
        transform-box: fill-box;
        transform-origin: center;
    }

    #big-bottle {
        animation: bottle-bounce 2.5s ease-in-out infinite;
        transform-box: fill-box;
        transform-origin: center;
    }

    #small-bottle {
        animation: small-bottle-bounce 3s ease-in-out infinite;
        transform-box: fill-box;
        transform-origin: center;
    }
    
    @keyframes waves {
        0% {
            transform: translateX(0);
        }
        50% {
            transform: translateX(0.3rem);
        }
        100% {
            transform: translateX(0);
        }
    }
    @keyframes waves-alt {
        0% {
            transform: translateX(0);
        }
        50% {
            transform: translateX(-0.4rem);
        }
        100% {
            transform: translateX(0);
        }
    }
    @keyframes wave-bounce {
        0% {
            transform: scale(1) translateY(0);
        }
        50% {
            transform: scale(1.025, 1) translateY(0.125rem);
        }
        100% {
            transform:  scale(1) translateY(0);
        }
    }
    @keyframes small-wave-bounce {
        0% {
            transform: scale(1) translateY(0);
        }
        50% {
            transform: scale(1.03, 1) translateY(0.15rem);
        }
        100% {
            transform:  scale(1) translateY(0);
        }
    }
    @keyframes bottle-bounce {
        0% {
            transform: scale(1) translateY(0);
        }
        50% {
            transform: scale(1.01, 1) translateY(0.1rem);
        }
        100% {
            transform:  scale(1) translateY(0);
        }
    }
    @keyframes small-bottle-bounce {
        0% {
            transform: scale(1) translateY(0);
        }
        50% {
            transform: scale(1.06, 1) translateY(0.2rem);
        }
        100% {
            transform:  scale(1) translateY(0);
        }
    }

    /*Small devices*/
    @media (min-width: 425px) {

        .wait-content svg {
            transform: scale(1);
            margin: 1rem auto 1rem -40px;
        }

        .report-count {
            margin-top: 1rem;
            text-align: center;
        }

        .report-warning {
            margin-top: 1rem;
        }
    }

    /*Medium devices (tablets, 768px and up)*/
    @media (min-width: 768px) {

        .wait-content svg {
            transform: scale(1);
            display: block;
            margin: auto auto 1rem -20px;
        }

        .wait-content h1 {
            margin-top: 0.5rem;
        }

        .report-count {
            width: 85%;
            text-align: center;
            margin: auto;
        }

        .report-warning {
            width: 85%;
            margin: 1.5rem auto;
        }

    }

    /*Large devices (desktops, 992px and up)*/
    @media (min-width: 992px) {

        .wait-content svg {
            display: block;
            margin: 5rem auto auto 30px;
            transform: scale(1.4);
        }

        .report-count {
            width: 75%;
            margin: 5rem auto auto auto;
            text-align: center;
        }

        .report-warning {
            width: 75%;
        }

    }

    /*Extra large devices (large desktops, 1200px and up)*/
    @media (min-width: 1200px) {

        .wait-content svg {
            display: block;
            margin: 6rem auto auto auto;
            transform: scale(1.75);
            /*padding-left: 4rem;*/
        }

        .report-count {
            width: 60%;
            margin: 6rem auto auto auto;
            text-align: center;
        }

        .report-warning {
            width: 60%;
            margin: 2rem auto;
        }

    }

</style>
