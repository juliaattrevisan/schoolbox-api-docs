{# #
 # Assessment options on Admin Report Export page.
 #
 # Parameters:
 # * assessmentOptions: available options for assessments
 # * page:              name of the page to display the options for
 # * workTypeOption:    name of work type option
#}
<legend>{{ locale.assessment.plural | capitalize }}</legend>
<div class="small-12 columns">
    <label for="report-work-types-{{ page }}">Work types</label>
    <select data-actions name="{{ workTypeOption }}[]" id="report-work-types-{{ page }}" multiple></select>
</div>
<script type="text/javascript">
    {% autoescape 'js' %}

    $('#report-work-types-{{ page }}').selectizeSelector({
        multiple: true,
        selectize: {
            create: false,
            placeholder: 'Search work types',
            preload: true,
            persist: true,
            hideSelected: true,
            load: function (query, callback) {
                $.ajax({
                    url: '{{ routeLookup('adminReportExport.getWorkTypes') }}',
                    type: 'GET',
                    dataType: 'json',
                    data: {query: query}
                }).done(function (result) {
                    callback(result)
                }).fail(function () {
                    callback()
                })
            }
        },
    });
    {% endautoescape %}
</script>
{% for optionId, assessmentOption in assessmentOptions %}
    <div class="small-12 medium-6 large-6 columns">
        <label for="{{ optionId }}">{{ assessmentOption }}</label>
        <div class="switch">
            <input name="{{ optionId }}" id="{{ optionId }}" type="checkbox"
                   value="1"/>
            <label for="{{ optionId }}">
                <span>ON</span>
                <span>OFF</span>
            </label>
        </div>
    </div>
{% endfor %}
