<script type="application/javascript">
    $(function() {
        /* Re Generation of data usage
         */
        $('[data-perform-update]').click(function (e) {
            e.preventDefault();

            $(this).confirmDialog({
                header: 'Warning! Re Calculation of Storage.',
                format: 'html',
                text: '<div class="alert-box warning">You have selected to a regeneration of the system storage. This may take a while. </div>',
                confirmEvent: function () {
                    var toaster = $('#toast');
                    toaster.toastActivate({ text: 'Calculating Data' });
                    $.post('{{ routeLookup('adminUsage.postRegenerateUsage') }}', {
                    }).done(function () {

                        toaster.toastTimeout({ text: 'Calculation Success', css: 'success' });
                        window.location.reload();

                    }).fail(function () {
                        toaster.toastTimeout({ text: 'Failed to re Calculate Storage, Try Again..', css: 'alert' });
                    });
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container usage-charts row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">

        <div class="actions-small-1">
                <nav>
                    <a class="icon-more" title="Actions" data-dropdown="usage-options"></a>
                </nav>
                <ul id="usage-options" class="f-dropdown" data-dropdown-content>
                    <li><a data-perform-update href='#' class="icon-export" title="Perform re Calculation">Perform re Calculation</a></li>
                </ul>
        </div>
        <div id="usage-global-container">
            <usage-global
                :endpoint-total-payload="'{{ routeLookupIfAuthorized('adminUsage.getTotalPayload') }}'"
                :endpoint-system-payload="'{{ routeLookupIfAuthorized('adminUsage.getSystemPayload') }}'"
                :endpoint-file-type-payload="'{{ routeLookupIfAuthorized('adminUsage.getFileTypePayload') }}'"
                :endpoint-role-payload="'{{ routeLookupIfAuthorized('adminUsage.getRolePayload') }}'"
                :endpoint-user-payload="'{{ routeLookupIfAuthorized('adminUsage.getUserPayload') }}'"
                :is-s3-adapter="{{ isS3Adapter ? 'true' : 'false' }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/usageGlobal.js?v={{ config.site_version }}"></script>

    </div>

</div>
<div id="toast" class="toast"></div>
