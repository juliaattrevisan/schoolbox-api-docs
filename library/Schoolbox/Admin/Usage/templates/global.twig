<script type="application/javascript">
    $(function() {
        /* Re Generation of data usage
         */
        $('[data-perform-update]').on('click', function (e) {
            e.preventDefault();

            var toaster = $('#toast');
            toaster.toastActivate({ text: 'Reload Usage Data...' });
            $.post('{{ routeLookup('adminUsage.postRegenerateUsage') }}', {
            }).done(function () {
                toaster.toastTimeout({ text: 'Reload Usage Successful', css: 'success' });
                window.location.reload();
            }).fail(function () {
                toaster.toastTimeout({ text: 'Failed to Reload Usage Data, Try Again..', css: 'alert' });
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="admin-container row">

    {# Shared navigation menu #}
    {{ renderAdminNavigation(pageCurrent) }}

    <div class="admin-content">

        <div id='option-container'>
            <div class="small-12 columns">
                <div class="actions-small-1">
                    <h2 class="subheader">&nbsp;</h2>
                    <nav>
                        <sbx-pop-out content-id="suds-options"></sbx-pop-out>
                    </nav>
                    <ul id="suds-options" class="f-dropdown" data-dropdown-content>
                        <li>
                            <a data-perform-update href='#' class="sbx-button--has-icon" title="Reload Usage Data">
                                <sbx-icon name="refresh"></sbx-icon>
                                Reload Usage Data
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="usage-charts">
            <div id="usage-global-container">
                <usage-global
                    endpoint-total-payload="{{ routeLookupIfAuthorized('adminUsage.getTotalPayload') }}"
                    endpoint-system-payload="{{ routeLookupIfAuthorized('adminUsage.getSystemPayload') }}"
                    endpoint-file-type-payload="{{ routeLookupIfAuthorized('adminUsage.getFileTypePayload') }}"
                    endpoint-role-payload="{{ routeLookupIfAuthorized('adminUsage.getRolePayload') }}"
                    endpoint-user-payload="{{ routeLookupIfAuthorized('adminUsage.getUserPayload') }}"
                    :is-s3-adapter="{{ isS3Adapter ? 'true' : 'false' }}"
                />
            </div>
            <script src="{{ CDN_PREFIX }}/js/bundle/usageGlobal.js?v={{ config.site_version }}"></script>
        </div>
    </div>
</div>
<div id="toast" class="toast"></div>
