{##
 # User
 #
 # A table of users and the amount of storage they occupy
 # This should be converted to Michael's mega vue table
 #}
<script>
    $(function() {
        let route = '{{ routeLookupIfAuthorized('adminUsage.getUserPayload') }}';

        $.get(route, function(responseText) {

            {# Convert to human-readable format
             # https://stackoverflow.com/questions/10420352/converting-file-size-in-bytes-to-human-readable-string/10420404
             #}
            function humanFileSize(size) {
                const i = size === 0 ? 0 : Math.floor(Math.log(size) / Math.log(1000));
                return (size / Math.pow(1000, i)).toFixed(2) * 1 + ' ' + ['B', 'kB', 'MB', 'GB', 'TB'][i];
            }

            $.each(responseText, function(index, element) {
                $('[data-user-usage]').append(
                    '<tr>' +
                    '<td><a href="/adminv2/usage2/specific/'+element.userId+'">' + element.firstname + '</a></td>' +
                    '<td><a href="/adminv2/usage2/specific/'+element.userId+'">' + element.lastname + '</a></td>' +
                    '<td>' + element.role + '</td>' +
                    '<td>' + humanFileSize(parseInt(element.size)) + '</td>' +
                    '</tr>'
                );
            });
        });
    });
</script>
<table>
    <thead>
        <tr>
            <th>Firstname</th>
            <th>Lastname</th>
            <th>Role</th>
            <th>Usage</th>
        </tr>
    </thead>
    <tbody data-user-usage>
    </tbody>
</table>