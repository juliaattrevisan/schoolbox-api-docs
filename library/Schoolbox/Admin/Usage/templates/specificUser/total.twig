{##
 # Total Usage for a Specific User
 #
 # @param User user
 #}
<script>
    $(function() {
        let route = '{{ routeLookupIfAuthorized('adminUsage.getSpecificUserTotalPayload', {userId: user.id}) }}';

        $.get(route, function(responseText) {
            $('#totalUsage').html(humanFileSize(responseText.size, 1024));
        });
    });
</script>
<section class="content">
    <h2>Total</h2>
    <p id="totalUsage"></p>
</section>