{##
 # User
 #
 # A table of users and the amount of storage they occupy
 # This should be converted to Michael's mega vue table
 #}
<script>
    $(function() {
        let route = '{{ routeLookupIfAuthorized('adminUsage.getSpecificUserFilePayload', {userId: user.id}) }}';

        $.get(route, function(responseText) {
            $.each(responseText, function(index, element) {
                $('[data-file-usage]').append(
                    '<tr>' +
                    '<td><a href="' + element._links.send + ' ">' + element.name + '</a></td>' +
                    '<td>' + humanFileSize(parseInt(element.size), 1024) + '</td>' +
                    '<td>' + element.location + '</td>' +
                    '<td><a href="/homepage/' + element.folderId + '">' + element.folder + '</td>' +
                    '<td>' + element.mimeType + '</td>' +
                    '<td><a class="icon-delete no-text" href="' + element._links.delete + '" data-action="delete"></a></td>' +
                    '</tr>'
                );
            });
        });
    });
</script>
<table>
    <thead>
        <tr>
            <th>Filename</th>
            <th>Size</th>
            <th>Location</th>
            <th>Folder</th>
            <th>Type</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody data-file-usage>
    </tbody>
</table>