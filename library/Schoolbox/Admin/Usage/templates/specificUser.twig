<script>
    $(function() {
        $('[data-file-usage]').on('click', '[data-action=delete]', function(event) {
            event.preventDefault();

            let element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you wish to delete this file?',
                confirmEvent: function() {
                    $.get(element.attr('href')).done(function() {
                        window.location.reload();
                    });
                }
            });
        });
    });
</script>

