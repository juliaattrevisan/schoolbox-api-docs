<script type="text/javascript" src="/javascript/components/highcharts-release/highcharts.js"></script>
<script>

    {# Convert to human-readable format
     # https://stackoverflow.com/questions/10420352/converting-file-size-in-bytes-to-human-readable-string/10420404
    #}
    function humanFileSize(size, base) {
        const i = size === 0 ? 0 : Math.floor(Math.log(size) / Math.log(base));
        return (size / Math.pow(base, i)).toFixed(2) * 1 + ' ' + ['B', 'kB', 'MB', 'GB', 'TB'][i];
    }

    $(function() {
    $('[data-file-usage]').on('click', '[data-action=delete]', function(event) {
            event.preventDefault();

            let element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you wish to delete this file?',
                confirmEvent: function() {
                    $.get(element.attr('href')).done(function() {
                        window.location.reload();
                    });
                }
            });
        });
    });
</script>
<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">Usage for <a href="/search/user{{ user.id }}">{{ user.fullname }}</a></h2>
    </div>

    <div class="small-12 island">
        {% include '@adminUsage/specificUser/total.twig' with {user: user} %}
    </div>

    <div class="small-12 medium-6 island">
        {% include '@adminUsage/specificUser/system.twig' with {user: user} %}
    </div>

    <div class="small-12 medium-6 island">
        {% include '@adminUsage/specificUser/filetype.twig' with {user: user} %}
    </div>

    <div class="small-12 island">
        <h2 class="subheader">Users</h2>
        {% include '@adminUsage/specificUser/file.twig' with {user: user} %}
    </div>
</div>

