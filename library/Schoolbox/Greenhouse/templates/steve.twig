<style>
    table {
        border-collapse: collapse;
    }

    th, td {
        border: 1px solid #ccc !important;
    }

    /* Dots go in these
     */
    .outcome-cell {
        font-size: 48px;
        max-width: 50px;
        min-width: 50px;
        text-align: center;
        vertical-align: middle;
    }

    /* Each Level comes in a pair of cells for each half of an academic period, I guess
     * These should not have a dividing line in between
     */
    .outcome-cell.hide-left-border {
        border-left: 0 !important;
    }

    .outcome-cell.hide-right-border {
        border-right: 0 !important;
    }
</style>

<table>
    <thead>
        <tr class="header">
            <th colspan="2"></th>
            <th>Rating</th>
            {% for i in payload.levels %}
                <th colspan="2" class="text-center">
                    Level {{ i }}
                </th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for parentNodeId, parentNodeData in payload.data %}
            {% set nSubrows = parentNodeData.subnodes|length %}

            {% if nSubrows %}
                {# Render at least one subnode with various spanning for presentation #}
                <tr>
                    <td rowspan="{{ nSubrows + 1 }}">
                        {{ parentNodeData.name }}
                    </td>
                </tr>
                {% for nodeId, nodeData in parentNodeData.subnodes %}
                    <tr>
                        <td>{{ nodeData.name }}</td>
                        {{ _self.renderOutcomes(nodeData, payload.possibleOutcomes) }}
                    </tr>
                {% endfor %}
            {% else %}
                {# No subnodes: occupy available space #}
                <tr>
                    <td colspan="2">{{ parentNodeData.name }}</td>
                    {{ _self.renderOutcomes(parentNodeData, payload.possibleOutcomes) }}
                </tr>
            {% endif %}
        {% endfor %}
    </tbody>
</table>

{##
 # Render the possible outcomes for a curriculum node
 # and, if applicable, a Progression Point
 #
 # @param array $nodeData
 # @param array $possibleOutcomes
 #}
{% macro renderOutcomes(nodeData, possibleOutcomes) %}
    <td>
        {# TODO How is "rating" decided...? It goes in this cell. #}
    </td>
    {% for i in possibleOutcomes %}
        {# If i > floor(i), we're in a halfway point hide the left border
         # Otherwise, hide the right border
         #}
        {% set borderStyle = 'hide-left-border' %}

        {% if i == i|round(0, 'floor') %}
            {% set borderStyle = 'hide-right-border' %}
        {% endif %}

        <td class="outcome-cell {{ borderStyle }}">
            {# Progression Point from something in the past #}
            {% if i == nodeData.previous %}
                ◦
            {% endif %}

            {# Progression Point from current academic period #}
            {% if i == nodeData.current %}
                •
            {% endif %}
        </td>
    {% endfor %}
{% endmacro %}



















