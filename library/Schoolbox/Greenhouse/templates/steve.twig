<style>
    th, td {
        border: 1px solid #f00 !important;
    }
</style>

{% set levels = [6, 7, 8, 9, 10] %}
{% set possibleOutcomes = [6, 6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10, 10.5] %}

<table>
    <thead>
        <tr>
            <th colspan="2">Nodes</th>
            <th>Rating</th>
            {% for i in levels %}
                <th colspan="2" class="text-center">
                    Level {{ i }}
                </th>
            {% endfor %}
        </tr>
        <tr>
            <th></th>
            <th></th>
            <th></th>
            {% for i in possibleOutcomes %}
                <th class="text-center" style="width:40px" data-value="{{ i }}">
                    o
                </th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for parentNodeId, parentNodeData in payload.data %}
            {% set nSubrows = parentNodeData.subnodes|length %}

            {% if nSubrows %}
                <tr>
                    <td rowspan="{{ nSubrows + 1 }}">
                        {{ parentNodeData.name }}
                    </td>
                </tr>
                {% for nodeId, nodeData in parentNodeData.subnodes %}
                    <tr>
                        {{ _self.renderOutcomes(nodeData, possibleOutcomes) }}
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td>
                        {{ parentNodeData.name }}
                    </td>
                    {% for nodeId, nodeData in parentNodeData.subnodes %}
                        {{ _self.renderOutcomes(nodeData, possibleOutcomes) }}
                    {% endfor %}
                </tr>
            {% endif %}
        {% endfor %}
    </tbody>
</table>

{##
 # Render the possible outcomes for a curriculum node
 # and, if applicable, a Progression Point
 #
 # @param array $nodeData
 # @param array $possibleOutcomes
 #}
{% macro renderOutcomes(nodeData, possibleOutcomes) %}
    <td>{{ nodeData.name }}</td>
    <td data-col-name="rating"></td>
    {% for i in possibleOutcomes %}
        <td class="text-center" style="vertical-align:middle;font-size:48px;">
            {# Progression Point from something in the past #}
            {% if i == nodeData.previous %}
                ◦
            {% endif %}

            {# Progression Point from current academic period #}
            {% if i == nodeData.current %}
                •
            {% endif %}
        </td>
    {% endfor %}
{% endmacro %}



















