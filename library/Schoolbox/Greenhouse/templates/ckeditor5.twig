<div class="row">
    <div class="small-12 columns">
        <h1>CKEditor5</h1>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <section>
           <fieldset class="content">
                <div class="small-12 columns">
                    <label for="editor-1">Text Editor 1</label>
                    <textarea id="editor-1"></textarea>
                    <label for="editor-2">Text Editor 2</label>
                    <textarea id="editor-2"></textarea>
                </div>
            </fieldset>
        </section>
    </div>
</div>
<div class="row">
    <div class="small-12 island">
        <button id="save-button" class="full-width">Save</button>
    </div>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/defaultEditor.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/helloCKEditor.js?v={{ config.site_version }}"></script>
<script>
document.dispatchEvent(new CustomEvent("EDITOR__CREATE", {
    detail: {
        targetElements: ["#editor"],
    }
}));
</script>
