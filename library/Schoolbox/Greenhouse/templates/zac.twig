<script>
$(document).ready(function() {
    $("[data-task-list]").sortable({
        placeholder: "sortable-placeholder",
        forcePlaceholderSize: true,
        handle: ".grip",
        axis: "y",
        helper: 'clone',
        start: function(event, ui) {
            console.log("start", ui.item.data("unit-assessment"), ui.item);
            document.querySelectorAll("[data-sortable-hidden]").forEach(function(el) {
                el.dataset.sortableHidden = false;
            });
            ui.item.show();
            ui.item.attr("data-sortable-active", true);
            $('[data-sortable-hidden]').slideDown({
                complete: function() {
                    $("[data-task-list]").sortable("refreshPositions")
                }
            })
        },
        stop: function(event, ui) {
            console.log("stop", ui.item.data("unit-assessment"), ui.item);
            document.querySelectorAll("[data-sortable-hidden]").forEach(function(el) {
                el.dataset.sortableHidden = true;
            });
            ui.item.removeAttr("data-sortable-active");
            $('[data-sortable-hidden]').slideUp();
        },
    });
});
</script>

