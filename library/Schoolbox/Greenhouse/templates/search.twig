{#
Expected data items:
 - filters
 - filtersTerminology
 #}

<div id="search-page-container">
    <search-page
        endpoint="/api/search"
        :filter-types="[]"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/searchPage.js?v={{ config.site_version }}"></script>

<ul>
{% for key, value in filters %}
    <li>
    {% if value is iterable %}
        {{ key }}
        <ul>
        {% for key2, value2 in value %}
            <li>{{ key2 }}</li>
        {% endfor %}
        </ul>
    {% else %}
       {{ key }}
    {% endif %}
    </li>
{% endfor %}
</ul>

<ul>
    {% for term, details in filtersTerminology %}
        <li>
            {{ term }}
            <ul>
                {% for key, value in details %}
                    <li>{{ key }}: {{ value }}</li>
                {% endfor %}
            </ul>
        </li>
    {% endfor %}
</ul>

<style>
/* temporarily add extra padding to the container to allow the new styles */
#container {
    padding: 2rem;
}
</style>
