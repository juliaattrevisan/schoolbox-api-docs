{% set reportCount = 25 %}
{% set warnings = ["X warning","Y warning"] %}
<style>
    .island {
        margin-top: 4em;
        width: 80%;
    }

    .wait-content {
        width: 50%;
        margin: auto;
    }

    .wait-content svg{
        display: block;
        margin: auto;
        transform: scale(1.25);
        margin-top: 5em;
        padding-bottom: 2em;
    }

    .report-count {
        width: 50%;
        margin: auto;
        margin-top: 3em;
    }
    .report-warning {
        width: 50%;
        margin: auto;
        margin-top: 2em;
        margin-bottom: 2em;
    }

    #wave-1 {
        animation: waves 5s ease-in-out infinite;
    }

    #wave-2 {
        animation: waves-alt 4s ease-in-out infinite;
    }

    #big-bottle {
        animation: bottle-bounce 5s ease-in-out infinite;
        transform-box: fill-box;
        transform-origin: center;
    }

    @keyframes waves {
        0% {
            transform: translateX(0em);
        }
        50% {
            transform: translateX(0.3em);
        }
        100% {
            transform: translateX(0em);
        }
    }
    @keyframes waves-alt {
        0% {
            transform: translateX(0em);
        }
        50% {
            transform: translateX(-0.3em);
        }
        100% {
            transform: translateX(0em);
        }
    }
    @keyframes bottle-bounce {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05, 0.95);
        }
        100% {
            transform: scale(1);
        }
    }


</style>
