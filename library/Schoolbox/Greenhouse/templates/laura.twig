{% set reportCount = 25 %}
{% set warnings = ["X warning","Y warning"] %}
<style>
    .island {
        margin-top: 4em;
        width: 80%;
    }

    .wait-content {
        border: 1px solid darkgrey;
        height: 25rem;
        width: 50%;
        margin: auto;
        margin-top: 2em;
    }

    .report-count {
        width: 50%;
        margin: auto;
        margin-top: 3em;
    }
    .report-warning {
        width: 50%;
        margin: auto;
        margin-top: 2em;
        margin-bottom: 2em;
    }

</style>
<div class="admin-container row">
    <div class="admin-content">
<div class="row">
    <div class="small-12 island">
        <section class="content">
            <div class="wait-content">

            </div>
            <div class="report-count">
                <h2>Compiling reports</h2>
                <p>We are currently working on collating your student reports for {{reportCount}} students into a zip file…..
                    We expect this to take approximately {{ ((reportCount * 5) /60) |round (0, 'ceil') }} minutes
                    Feel free to continue working, we will send you a notification when the file is ready to download
                </p>
            </div>
            <div class="alert-box alert report-warning">
                {% if warnings %}
                    <p>Please note that we encountered the following issues while processing your request:</p>
                    {% for warning in warnings %}
                        {{ warning }} <br>
                    {% endfor %}
                {% endif %}
            </div>
    </div>
        </section>
    </div>
</div>
</div>
