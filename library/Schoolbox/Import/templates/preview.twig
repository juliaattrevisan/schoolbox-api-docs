{# Shared navigation menu #}

{{ renderAdminNavigation(pageCurrent) }}

{% include '@upsRuleset/breadcrumbs.twig' with { allNodes: allBreadcrumbs } %}

<div class="row">
    <div class="small-12 columns">
        <h1>
            {% block title %}
            {% endblock %}
        </h1>

        {% include '@upsRuleset/navigation.twig' with { allNodes: allNavigation } %}
    </div>

    <div class="small-12 island">
        <section class="content">
            <ul class="information-list ups" data-log>
                {% include '@upsRuleset/log/lines.twig' %}
            </ul>

            {% block form %}
            <form action="{{ routeLookup(basename ~ '.import') }}" method="post">

                {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}

                <input type="submit" value="Run Import" />
            </form>
            {% endblock form %}
        </section>
    </div>
</div>
<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
<script type="text/javascript">
    $(function () {
        // allow records to expand/collapse
        $('[data-log]').on('click', '[data-collapser]', function (e) {
            e.preventDefault();

            var target    = $(this).data('collapser'),
                component = $('[data-collapsable=' + target + ']');

            if (component.attr('data-collapse-state') == 'collapsed') {
                component.stop().removeClass('hide').slideUp(1).slideDown();
                component.attr('data-collapse-state', 'uncollapsed');
            }
            else {
                component.attr('data-collapse-state', 'collapsed');
                component.stop().slideUp();
            }
        });
    });
</script>
