{{ renderAdminNavigation(pageCurrent) }}

<div class="row">
    <div class="small-12 columns">
        <h2 class="subheader">
            {% block title %}
            {% endblock %}
        </h2>

        {% if uploadMissing %}
            <div class="alert-box alert">
                <h2>You must upload a file!</h2>
                <p>Download the template below, enter your data, and upload it when done.</p>
            </div>
        {% endif %}

        {% include '@upsRuleset/navigation.twig' with { allNodes: allNavigation } %}
    </div>
    <div class="small-12 island">
        <form action="{{ routeLookup(basename ~ '.preview') }}" method="post">
                {% block helpText %}
                {% endblock helpText %}

                {% block form %}
                    <input type="submit" value="Preview Import" />
                {% endblock form %}
        </form>
    </div>
</div>
