{% extends '@adminImport/upload.twig' %}

{% block title %}
    Import Timetable Structure
{% endblock %}

{% block helpText %}
    {% if hasExternalDb %}
    <div class="empty-state">
        <i class="icon-timetable"></i>
        <p>Your timetable structure data is stored in your external database - you do not need to upload it here.</p>
    </div>
    {% else %}
    <section>
        <div class="content">
        <p>
            Provide a file containing your timetable structure (term start and end dates, timetable days and periods)
            in the CSV format in the template below.
        </p>
        <ul>
            <li>You must upload your entire timetable structure in one CSV - any existing structure will be deleted.</li>
            <li>You must ensure that you specify all periods for all days prior to import.</li>
            <li>Periods will be imported in the order specified, regardless of their start/finish times.</li>
            <li>Any empty fields will be filled with the previous non-empty value in that column.</li>
            <li>
                <strong>Term Start</strong> and <strong>Term Finish</strong> must only be in Y-M-D format <em>(<time>{{ now.getUsingFormat('Y-m-d') }}</time>)</em>
            </li>
            <li>
                <strong>Period Start</strong> and <strong>Period Finish</strong> must be in:
                <ul>
                    <li>12 hour format, with am/pm <em>(<time>{{ now.getUsingFormat('g:ia') }}</time>)</em></li>
                    <li>24 hour format <em>(<time>{{ now.getUsingFormat('G:i') }}</time>)</em></li>
                </ul>
            </li>
        </ul>
        </div>
        <div class="component-action">
            <section>
                <a href="/adminv2/import/timetableStructureTemplate.csv" class="button">Download Template</a>
            </section>
        </div>
    </section>
        {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}
    {% endif %}
{% endblock helpText %}

{% block form %}
    {% if not hasExternalDb %}
        {{ parent() }}
    {% endif %}
{% endblock form %}
