{# This is a clone of sync/navigation.twig to use admin-specific subnav style #}
{% if allNodes|length %}
    <dl class="sub-nav">
        {% for currentNode in allNodes %}
            <dd {% if currentNode.isActive() %}class="active"{% endif %}>
                <a href="{{ currentNode.getUrl() }}">{{ currentNode.getName() }}</a>
            </dd>
        {% endfor %}
    </dl>
{% endif %}
