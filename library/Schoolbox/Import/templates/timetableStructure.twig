{% include '@upsRuleset/breadcrumbs.twig' with { allNodes: allBreadcrumbs } %}

<div class="row">
    <div class="small-12 columns">
        <h1>Timetable Structure</h1>

        {% include '@upsRuleset/navigation.twig' with { allNodes: allNavigation } %}
    </div>

    <div class="small-12 island">
        <section class="content">
            <p>Import timetable structure (terms, periods and day definitions) here</p>

            <a href="/adminv2/import/timetableStructureTemplate.csv" class="button icon-download">Download Template</a>

            <form action="{{ routeLookup('adminImport.timetableStructureImport') }}" method="post">

                {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}

                <input type="submit" value="Import" />
            </form>
        </section>
    </div>
</div>
<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
