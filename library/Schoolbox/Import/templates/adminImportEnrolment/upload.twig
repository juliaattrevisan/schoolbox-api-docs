{% extends '@adminImport/upload.twig' %}

{% block title %}
    Enrolment
{% endblock %}

{% block helpText %}
    {% if hasExternalDb %}
        <p>Your enrolment data is stored in your external database - you do not need to upload it here.</p>
    {% else %}
        <p>
            Provide a file containing your class enrolments in the CSV format in the template below.
        </p>
        <ul>
            <li>You must upload your entire enrolment in one CSV - any existing enrolments will be deleted.</li>
            <li>You must have first uploaded your timetable structure and timetable.</li>
        </ul>
        <a href="/adminv2/import/enrolmentTemplate.csv" class="button icon-download">Download Template</a>
    {% endif %}
{% endblock helpText %}

{% if hasExternalDb %}
    {% block form %}
    {% endblock form %}
{% endif %}
