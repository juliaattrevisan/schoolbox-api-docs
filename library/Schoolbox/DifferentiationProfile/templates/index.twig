{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    [ locale.differentiationProfile.plural ]
) }}

<div class="f-container">
    <div class="l-flex-col l-gap-m">
        <div class="f-no-margins">
            <h1>Manage {{ locale.differentiationProfile.plural }}</h1>
        </div>
        <div>
            {% include '@filters/panel.twig' with {
                contentId: 'filterPanel',
                panel:     filterPanel,
                quickload: false,
            } only %}
        </div>
        <div id="manage-differentiation-profiles-container">
            <manage-differentiation-profiles
                :header='{{ header|json_encode|raw }}'
                :adjustment-categories='{{ adjustmentCategories|json_encode|raw }}'
                :adjustment-levels='{{ adjustmentLevels|json_encode|raw }}'
                :profiles='{{ profiles|json_encode|raw }}'
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/manageDifferentiationProfiles.js?v={{ config.site_version }}"></script>
    </div>
</div>

