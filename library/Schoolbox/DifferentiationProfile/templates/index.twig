{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    [ locale.differentiationProfile.properPlural ]
) }}

{% set reportContentId = 'manage-differentiation-profiles-container' %}

{% autoescape 'js' %}
    <script type="text/javascript">
        $(function () {
            // Filtered content has been [re]loaded
            $('#{{ reportContentId }}').on('filterContentLoaded', function (event, selectedFilters) {
                document.dispatchEvent(new CustomEvent('lazy-grid__onFilterChange', {
                    detail: {
                        selectedFilters
                    }
                }));
            });
        });
    </script>
{% endautoescape %}

<div class="f-container">
    <div class="l-flex-col l-gap-m">
        <div class="l-flex-row l-flex--justify-space f-no-margins">
            <h1>Manage {{ locale.differentiationProfile.properPlural }}</h1>
            {% set viewRecordsRoute = routeLookupIfAuthorized('customisationRecord.viewRecords') %}
            {% if viewRecordsRoute %}
                <a href="{{ viewRecordsRoute }}" class="button l-flex l-gap-s" title="View Customisation Records">
                    <sbx-icon name="group"></sbx-icon>
                    View Customisation Records
                </a>
            {% endif %}
        </div>
        <div>
            {% include '@filters/panel.twig' with {
                contentId: reportContentId,
                panel:     filterPanel,
                quickload: false,
            } only %}
        </div>
        <div id="{{ reportContentId }}" class="f-no-margins" data-test="manage-differentiation-profiles-container">
            <manage-differentiation-profiles
                :header="{{ header|json_encode }}"
                :adjustment-categories="{{ adjustmentCategories|json_encode }}"
                :adjustment-levels="{{ adjustmentLevels|json_encode }}"
                :routes="{{ routes|json_encode }}"
                :pastoral-config="{{ {
                    pastoralPointEnabled: config.pastoral_point_enabled,
                    pastoralActionEnable: config.pastoral_action_enable,
                    pastoralSeverity: config.pastoral_severity,
                }|json_encode }}"
                :pastoral-routes="{{ {
                    getStudentRecord: routeLookup('pastoral.getStudentRecord'),
                    getReportTags: routeLookup('pastoralReportBuilder.getReportTags'),
                }|json_encode }}"
            />
        </div>
        <script src="{{ CDN_PREFIX }}/js/bundle/manageDifferentiationProfiles.js?v={{ config.site_version }}"></script>
    </div>
</div>
