{# Iterate all child nodes #}
{% spaceless %}
{% for childNode in node.children %}
    {% if loop.first %}
        {# This is the first child, open the <ul> tag #}
        <ul class="left-submenu">
            <li class="back"><a href="#">Back</a></li>
        {% if node.url %}
            <a href="{{ node.url }}" {%  if node.target is not empty %}target="{{ node.target }}"{% endif %}>
                <span>{{ node.title }}</span>
            </a>
        {% endif %}
    {% endif %}
            <li {% if childNode.children | length %}class="has-submenu"{% endif %}>
                <a href="{{ childNode.url }}" {%  if childNode.target is not empty %}target="{{ childNode.target }}"{% endif %}>
                    <span>{{ childNode.title }}</span>
                </a>
                {% if childNode.children | length %}
                    {% include "@menuSide/includes/treeLevel.twig" with {'node': childNode } %}
                {% endif %}
            </li>
{% endfor %}
        </ul>
{% endspaceless %}