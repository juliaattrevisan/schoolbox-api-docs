{# This is a flag used to indicate if we should open the <ul> tag #}

{% set submenu = false %}
{% set first = true %}

{# Iterate all child nodes #}
{% spaceless %}
{% for node in nodes if node.parentId == parent.id %}

    {% if first == true %}
        {% set first = false %}

        {# This is the first child, open the <ul> tag #}

        <ul class="left-submenu">
            <li class="back"><a href="#">Back</a></li>
    {% endif %}

    <li
        {% for subnode in nodes if subnode.parentId == node.id %}
            {% if submenu == false %}
                {% set submenu = true %}
                class="has-submenu"
            {% endif %}
        {% endfor %}
    >
        <a href="{{ node.url }}">
            <span>{{ node.title }}</span>
        </a>
        {% include "@menuSide/includes/treeLevel.twig" with {'parent': node} %}
    </li>

{% endfor %}

{# If we opened a <ul> tag in our loop we need to close it here #}

{% if first == false %}
    </ul>
{% endif %}
{% endspaceless %}