{%  if user.pronoun is null %}
    {% set tokens = {
        '[id]':         user.id,
        '[externalId]': user.externalId,
        '[username]':   user.username,
        '[firstName]':  user.firstName,
        '[lastName]':   user.lastName,
        '[email]':      user.email,
        '[subjectivepronoun]': 'they',
        '[subjectivepronounproper]': 'They',
        '[objectivepronoun]': 'them',
        '[objectivepronounproper]': 'Them',
        '[possessivepronoun]': 'theirs',
        '[possessivepronounproper]': 'Theirs'
    } %}
{% else %}
    {% set tokens = {
        '[id]':         user.id,
        '[externalId]': user.externalId,
        '[username]':   user.username,
        '[firstName]':  user.firstName,
        '[lastName]':   user.lastName,
        '[email]':      user.email,
        '[subjectivepronoun]': user.pronoun.subjective,
        '[subjectivepronounproper]': user.pronoun.subjective | capitalize,
        '[objectivepronoun]': user.pronoun.objective,
        '[objectivepronounproper]': user.pronoun.objective |capitalize,
        '[possessivepronoun]': user.pronoun.possessive,
        '[possessivepronounproper]': user.pronoun.possessive |capitalize
    } %}
{% endif %}

{% for tab in tabs %}
    <li data-id="{{ tab.id }}"> {# data-id is used by JS to map between the top menu and side menu (overflow) version of these menu items #}
        <a class="icon-{{ tab.icon }} {% if tabCurrent | lower == tab.token | lower and tab.token is not empty %}navthis{% endif %}"
           {# Should href tokens be url-encoded? #}
           href="{{ tab.url | ireplace(tokens) }}"
           title="{{ tab.title }}"
           {% if tab.target is not empty %}target="{{ tab.target }}"{% endif %}
        >
            <span>{{ tab.text }}</span>
        </a>
    </li>
{% endfor %}
