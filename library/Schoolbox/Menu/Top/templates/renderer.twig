{% set tokens = {
    '[id]':         user.id,
    '[externalId]': user.externalId,
    '[username]':   user.username,
    '[firstName]':  user.firstName,
    '[lastName]':   user.lastName,
    '[email]':      user.email,
} %}

{% for tab in tabs %}
    <li data-id="{{ tab.id }}"> {# data-id is used by JS to map between the top menu and side menu (overflow) version of these menu items #}
        <a class="icon-{{ tab.icon }} {% if tabCurrent | lower == tab.token | lower and tab.token is not empty %}navthis{% endif %}"
           {# Should href tokens be url-encoded? #}
           href="{{ tab.url | ireplace(tokens) }}"
           title="{{ tab.title }}"
           {% if tab.target is not empty %}target="{{ tab.target }}"{% endif %}
        >
            <span>{{ tab.text }}</span>
        </a>
    </li>
{% endfor %}
