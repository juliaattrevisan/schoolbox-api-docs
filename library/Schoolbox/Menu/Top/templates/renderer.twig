{% set tokens = {
    '[id]':         user.id,
    '[externalId]': user.externalId,
    '[username]':   user.username,
    '[firstName]':  user.firstName,
    '[lastName]':   user.lastName,
    '[email]':      user.email,
} %}

{% for tab in tabs %}
    <li data-id="{{ tab.id }}"> {# data-id is used by JS to map between the top menu and side menu (overflow) version of these menu items #}
        <a{% if tabCurrent | lower == tab.token | lower and tab.token is not empty %} class="navthis sbx-button--has-icon"{% else %} class="sbx-button--has-icon"{% endif %}
           href="{{ tab.url | ireplace(tokens) }}"
           title="{{ tab.title }}"
           {% if tab.target is not empty %}target="{{ tab.target }}"{% endif %}
        >
            <sbx-icon name="{{ tab.icon }}" color="var(--sbx-config-color-menu-secondary, var(--navigation-foreground))" size="1.30rem"></sbx-icon>
            <span>{{ tab.text }}</span>
        </a>
    </li>
{% endfor %}
