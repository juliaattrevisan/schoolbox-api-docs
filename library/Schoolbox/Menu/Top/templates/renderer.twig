        {% for tab in tabs %}
            <li><a class="icon-{{ tab.icon }} {% if tabCurrent | lower == tab.token | lower and tab.token is not empty %}navthis{% endif %}" {% if tab.url starts with 'onclick:' %}onclick="{{ tab.url|replace({'onclick:':''}) }}"{% else %}href="{{ tab.url }}"{% endif %} title="{{ tab.title }}" {% if tab.target is not empty %}target="{{ tab.target }}"{% endif %}><span>{{ tab.text }}</span></a></li>
        {% endfor %}
