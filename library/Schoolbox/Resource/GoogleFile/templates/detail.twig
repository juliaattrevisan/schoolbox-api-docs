{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ folder.name, '/homepage/' ~ folder.id ],
    [ googleFile.name ]
) }}
<p style="margin-top: -1rem;"><a href="{{ googleFile.url }}" class="right external" target="_blank">Open in Google</a>
</p>
<iframe id="google-file-content" class="hide"></iframe>
<div id="google-error" class="small-12 column hide">
    <div class="empty-state">
        <i class="icon-google-drive"></i>
        <p>Sorry, we could not find the document at this time.</p>
    </div>
</div>
<div class="small-12 island">
    <div id="google-authenticate" class="button hide">Authorize Google account to view document</div>
</div>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/google/apiloader.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/google/picker.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function () {
        $.fn.setupGapi({
            clientId: '{{ config.googleapps_client_id }}',
            modules: ['client:auth2'],
            callback: function () {
                $('#google-file-content').googlePicker({
                    listener: false,
                    authBtn: '#google-authenticate',
                    onAuth: function () {
                        gapi.client.load('drive', 'v3', function () {
                            let getViewLink = gapi.client.drive.files.get({
                                'fields': 'webViewLink',
                                'supportsAllDrives': 'true',
                                'fileId': '{{ googleFile.googleId }}',
                            });
                            getViewLink.execute(function (resp) {
                                if (resp.error || resp.webViewLink.length === 0) {
                                    $('#google-error').removeClass('hide');
                                    return;
                                }
                                $('#google-file-content').attr('src', resp.webViewLink);
                                $('#google-file-content').removeClass('hide').addClass('fullscreen');
                            });
                        });
                    },
                });
            }
        });
    });
</script>
