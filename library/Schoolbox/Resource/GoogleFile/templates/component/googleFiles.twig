<script type="text/javascript" src="{{ CDN_PREFIX }}/javascript/shared/google/apiloader.js"></script>
<style type="text/css">
    div.picker-dialog {
        z-index: 2000;
    }
</style>
<div class="empty-state">
    <i class="icon-google-drive"></i>
    <p><a id="find-files">Find a Google file</a> to share with users and allow them to view, edit or suggest changes.
    </p>
</div>
<div id="gfile" class="modal-backdrop" data-reveal aria-labelledby="Google Files" aria-hidden="true"
     role="dialog">
</div>
<script type="text/javascript" src="{CDN_PREFIX}/javascript/shared/google/picker.js"></script>
<script type="text/javascript">
    $(function() {
        $('#find-files').googlePicker({
            clientId: '{{ config.googleapps_client_id }}',
            postGoogleFileUrl: '{{ routeLookupIfAuthorized('googleFile.postGoogleFile', {folderId: component.context.id, folder: component.context}) }}'
        });
    });
</script>
