{% set portrait = '/portrait.php?size=square48&userId=' %}
{% set mime     = '/images/mime/128x128/' %}

{#
Each delete request is an ajax request for compatibility
These are its args, which is given for you
#}

{% set deleteArgs = '{ajax: 1, delete: ' ~ file.id ~ '}' %}

{% if namespace == 'resourceBrowser' %}
    {% set send   = '/send.php?id=' %}
    {% set image  = '/cms/image.php?id=' %}
    {% set modify = '/cms/file/' %}
    {% set delete = '/cms/fileForm.php?delete=' %}

{% elseif namespace == 'myFilesBrowser' %}
    {% set send   = '/cms/sendMyFile.php?id=' %}
    {% set image  = '/cms/myImage.php?id=' %}
    {% set modify = '/cms/myFile/' %}
    {% set delete = '/cms/myFileForm.php' %}

{% else %}
    {% set send   = '/cms/sendNetworkFile.php?id=' %}
    {% set image  = '/cms/networkImage.php?id=' %}
    {% set modify = '/cms/networkFile/' %}
    {% set delete = '/cms/networkFileForm.php' %}

{% endif %}


{% if access > 0 %}

<ul class="breadcrumb" id="breadcrumbs">
    {% for node in tree %}
        <li><a data-selectnode="{{ node.categoryId }}" href="/resources/{{ node.categoryId }}">{{ node.name }}</a></li>
    {% endfor %}
</ul>

<div class="row">
    <div class="small-4 column text-center">
        {% if file.mimetype.isImage %}
            <img class="icon" src="{{ image ~ file.id }}&width=128&height=128" alt="{{ file.title }}" />
        {% else %}
            <img class="icon" src="{{ mime ~ file.mimetype.iconFile }}" alt="{{ file.title }}" />
        {% endif %}
    </div>
    <div class="small-8 column">
        <div class="actions-small-1">
            <div class="list-item">
                <h3>{{ file.title }}</h3>
            </div>
            <nav>
                <a href="#" class="icon-eye" data-reveal-id="modal-file-{{ file.id }}"></a>
            </nav>
        </div>
        {% if namespace == 'resourceBrowser' and file.description %}
            <p>{{ file.description }}</p>
        {% else %}
            <p>{{ file.mimetype.description }}</p>
        {% endif %}

        {# Add delete confirmation if it is available #}
        {% if access >= 2 %}
        <script type="text/javascript">
            $('[data-action="delete"]').click(function(event) {
                event.preventDefault();

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this file?',
                    confirmEvent: function() {
                        $.get('{{ delete }}', {{ deleteArgs }}, function() {
                            window.location = window.location;
                        });
                    }
                });
            });
        </script>
        {% endif %}

        {% set fileActionList %}
            <li><a class="icon-document" data-action="open"     href="{{ send ~ file.id }}" target="_blank">Open</a></li>
            <li><a class="icon-download" data-action="download" href="{{ send ~ file.id }}&save=1">Download</a></li>
            {% if access >= 2 %}
                <li><a class="icon-modify"   data-action="modify"   href="{{ modify ~ file.id }}">Modify</a></li>
                <li><a class="icon-delete"   data-action="delete"   href="#">Delete</a></li>
            {% endif %}

        {% endset %}

        {% include '@resourceBrowser/actionBar.twig' with { id: 'file-actions', list: fileActionList, sizing: { small: 1, medium: 2, large: 2, xlarge: 4, xxlarge: 2 } } %}

        <div class="reveal-modal" data-reveal id="modal-file-{{ file.id }}">

            <h2>{{ file.title }}</h2>

            {% include '@resourceBrowser/fileInfo/file.twig' %}

            <a class="close-reveal-modal" aria-label="Close">&#215;</a>

        </div>

    </div>
</div>
{% else %}
<li>
    <img class="icon" src="/images/core/icons/error-icon.png" alt="No access"/>
    <h3>No access</h3>
</li>
{% endif %}
