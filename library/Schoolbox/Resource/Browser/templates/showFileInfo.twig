{% set portrait = '/portrait.php?size=square48&userId=' %}
{% set mime     = '/images/mime/' %}

{#
Each delete request is an ajax request for compatibility
These are its args, which is given for you
#}

{% if namespace == 'resourceBrowser' %}
    {% set send   = '/send.php?id=' %}
    {% set image  = '/cms/image.php?id=' %}
    {% set modify = '/cms/file/' %}
    {% set delete = '/cms/fileForm.php?ajax=1&delete=' %}
    {% set type   = 'sbfs' %}

{% elseif namespace == 'myFilesBrowser' %}
    {% set send   = '/cms/sendMyFile.php?id=' %}
    {% set image  = '/cms/myImage.php?id=' %}
    {% set modify = '/cms/myFile/' %}
    {% set delete = '/cms/myFileForm.php?ajax=1&delete=' %}
    {% set type   = 'myfile' %}

{% else %}
    {% set send   = '/cms/sendNetworkFile.php?id=' %}
    {% set image  = '/cms/networkImage.php?id=' %}
    {% set modify = '/cms/networkFile/' %}
    {% set delete = '/cms/networkFileForm.php?ajax=1&delete=' %}
    {% set type   = 'storage' %}

{% endif %}

{% if access > 0 %}


<ul class="breadcrumb" id="breadcrumbs">
    {% for node in tree %}
        <li>
            {%- if node.disabled -%}
                <a class="disabled" data-selectnode="{{ node.categoryId }}">{{ node.name }}</a>
            {%- else -%}
                <a data-selectnode="{{ node.categoryId }}" href="/resources/{{ node.categoryId }}">{{ node.name }}</a>
            {%- endif -%}
        </li>
    {% endfor %}
</ul>

<div class="row">
    <div class="small-6 medium-4 column text-center meta-preview">
        {% if file.mimetype.isImage %}
            <a data-plugin="preview" href="{{ send ~ file.id }}&width=1024&height=1024">
                <img class="icon" src="{{ image ~ file.id }}&width=256&height=256" alt="{{ file.title }}" />
            </a>
        {% elseif file.mimetype.isAudio %}
            <audio id="schoolbox_video_preview"
                   controls
                   preload="none"
                   width="100%">
                <source src="/cms/sendVideo.php?type={{ type }}&id={{ file.id }}" type='audio/mp3'>
            </audio>
        {% elseif file.mimetype.isVideo %}
            <video id="schoolbox_video_preview"
                   data-videocomponent
                   controls
                   preload="none"
                   poster="/cms/videoThumb.php?type={{ type }}&id={{ file.id }}&size=poster"
                   height="200"
                   width="100%">
                <source src="/cms/sendVideo.php?type={{ type }}&id={{ file.id }}" type='video/mp4'>
            </video>
        {% else %}
            <a href="{{ send ~ file.id }}" target="_blank">
                <img class="icon" src="{{ mime ~ file.mimetype.iconFile }}" alt="{{ file.title }}" height="128" width="128"/>
            </a>
        {% endif %}
    </div>
    <div class="small-6 medium-8 column">
        <h3><a href="{{ send ~ file.id }}" target="_blank">{{ file.title }}</a><span class="hint has-tip" data-reveal-id="modal-file-{{ file.id }}" title="View file information">?</span></h3>
        {% if namespace == 'resourceBrowser' and file.description %}
            <p>{{ file.description }}</p>
        {% else %}
            <p>{{ file.mimetype.description }}</p>
        {% endif %}

        {% set fileActionList %}
            <li><a class="icon-document" data-action="open" {% if type == 'sbfs' %} data-plugin="preview" {%  endif %} href="{{ send ~ file.id }}" target="_blank">Open</a></li>
            <li><a class="icon-download" data-action="download" href="{{ send ~ file.id }}&save=1">Download</a></li>
            {% if access >= 2 %}
                <li><a class="icon-modify"   data-action="modify"   href="{{ modify ~ file.id }}{{RETURN_URL}}">Modify</a></li>
                <li><a class="icon-delete"   data-action="delete"   href="{{ delete ~ file.id }}">Delete</a></li>
            {% endif %}

        {% endset %}

        {% include '@resourceBrowser/actionBar.twig' with { id: 'file-actions', list: fileActionList, sizing: { small: 1, medium: 2, large: 2, xlarge: 4, xxlarge: 4 } } %}

        <div class="reveal-modal" data-reveal id="modal-file-{{ file.id }}">

            <h2>{{ file.title }}</h2>

            {% include '@resourceBrowser/fileInfo/file.twig' %}

            <a class="close-reveal-modal" aria-label="Close">&#215;</a>

        </div>

    </div>
</div>
<script type="text/javascript">
    $(function() {
        $('[data-plugin="preview"]','#content').preview();
        $('[data-videocomponent]').mediaelementplayer();
    });
</script>
{% endif %}
