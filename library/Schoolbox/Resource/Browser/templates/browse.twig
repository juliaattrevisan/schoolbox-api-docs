{# TODO PUT THIS IN THE HEAD SOMEHOW #}
<link rel="stylesheet" type="text/css" media="screen" href="/css/foundation/chrome.css?v={SITE_VERSION}" />
<link rel="stylesheet" type="text/css" media="screen" href="/css/tree.css" />
<link rel="stylesheet" href="/javascript/components/jstree/dist/themes/default/style.css" />
<style type="text/css">
    /* STYLES I NEED */
    #file-list li {
        line-height: 24px;
        background-position: 0 0;
        background-repeat: no-repeat;
    }
    #file-list li a {
        margin-left: 24px;
    }
</style>
<script type="text/javascript" src="/javascript/components/jstree/dist/jstree.js"></script>
<script type="text/javascript" src="/javascript/jquery.resourceTree.js"></script>
<script type="text/javascript" src="/javascript/jquery.three-panel.js"></script>
<script type="text/javascript" src="/javascript/jquery.fileDrop.js"></script>
<script type="text/javascript">
    $(function () {
        $('#container').addClass('foundation').foundation();

        var tree = $('#tree');

        tree.resourceTree();


    });
</script>
{# /HEAD #}

<div class="row" style="max-width:100%;">
    <div class="large-5 columns">
        <h2>Folders</h2>
        <div class="scroller">
            <div id="tree"></div>
        </div>
    </div>
    <div class="large-4 columns">
        <h2>Files</h2>
        <div class="scroller">
            <ul id="file-list">
                {% include '@resourceBrowser/listResources.twig' with { files: files } %}
            </ul>
        </div>
    </div>
    <div class="large-3 columns">
        <h2>Details</h2>
        {% include '@resourceBrowser/showFolderInfo.twig' %}
    </div>
</div>

