{# TODO PUT THIS IN THE HEAD SOMEHOW #}
<link rel="stylesheet" href="/javascript/components/jstree/dist/themes/default/style.css" />
<script type="text/javascript" src="/javascript/components/jstree/dist/jstree.js"></script>
<script type="text/javascript" src="/javascript/jquery.resourceTree.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.scroll-to.js"></script>
<script type="text/javascript" src="/javascript/jquery.fileDrop.js"></script>

{% if namespace == 'myFilesBrowser' %}
    {% set fileController   = 'myFile' %}
    {% set folderController = 'myFolder' %}
{% elseif namespace == 'webDavBrowser' %}
    {% set fileController   = 'networkFile' %}
    {% set folderController = 'networkFolder' %}
{% else %}
    {% set fileController   = 'file' %}
    {% set folderController = 'category' %}
{% endif %}

<script type="text/javascript">
    $(function () {

        var openNode = {{ folder.id }};

        {# TODO put this in a new module #}
        var tree = $('#tree'),
            metaData         = $('#meta'),
            listItem         = 'li',
            folderInfoUri    = '/:id/info',
            fileInfoUri      = '/file/:id/info',
            linkInfoUri      = '/link/:id/info';

        tree.resourceTree({
            data: {
                cache: {{ treedata | raw }},
                ajaxParams: {
                    url: '{{ routeLookup(namespace ~ '.listNodes') }}',
                    token: '{folderId}'
                }
            }
        });

        // expose the jstree in all its splendour
        var jstree = tree.jstree(true);

        tree.on('select_node.jstree', function(event, jstree) {
            jstree.instance.open_node(jstree.node.id);
            var nodeId = jstree.node.li_attr['data-id'];
            if (jstree.node.type == 'file') {
                loadPanel(metaData, fileInfoUri, nodeId);
            } else if (jstree.node.type == 'link') {
                loadPanel(metaData, linkInfoUri, nodeId);
            } else {
                // changed folder? update the node
                openNode = nodeId;
                loadPanel(metaData, folderInfoUri, nodeId);
            }
        });

        $(document).on('dnd_stop.vakata', function (event, data) {

            var $dragged       = $(data.element).closest(listItem),
                draggedType    = $dragged.data('type'),
                draggedTypeGen = draggedType == 'file' ? '{{ fileController }}' : '{{ folderController }}',
                draggedId      = $dragged.data('id'),

                $dropTarget    = $(data.event.srcElement).closest(listItem),
                dropTargetId   = $dropTarget.data('id'),
                dropTargetType = $dropTarget.data('type'),
                dropTargetPerm = $dropTarget.data('permission');

            if (dropTargetType == 'file' || (!(dropTargetPerm == 'write' || dropTargetPerm == 'full'))) {
                return;
            }

            /*
            console.log([
                'Move', draggedType, draggedId, 'to', dropTargetType, dropTargetId
            ].join(' '));
            */

            $.post(
                '/cms/' + draggedTypeGen + 'Form.php',
                {
                    move: draggedId,
                    categoryID: dropTargetId,
                    ajax: 1
                }
            );

        });

        var $window    = $(window),
            $hybrid    = $('#hybrid-bar'),
            $footer    = $('#footer'),
            $resources = $('#resources');


        // On the initial open of the tree and all its open by default parts:
        // scroll to it
        tree.on('after_open.jstree.initial', function(event, jstree) {
            var nodeId = jstree.node.id;

            // If this node is the parent of the selected: scroll to the selected now
            var initialNode = jstree.instance.get_children_dom(nodeId).filter('#'+{{ folder.id }});
            if (initialNode.length) {
                $resources.scrollTo(initialNode);
                tree.off('.jstree.initial');
            }
        });

        function rs()
        {
            var calcd = $window.height() - $hybrid.height() - $footer.height() - metaData.height() - 120;

            $resources.height(Math.max(200, calcd));
        }

        function loadPanel(panel, path, nodeId)
        {
            var uri = '{{ routeLookup(namespace ~ '.browse') }}'+path.replace(':id', nodeId);

            panel
                .addClass('loading')
                .data('nodeId', nodeId)

                {# TODO cache this #}
                .load(uri, function () {
                    $(this).removeClass('loading');
                    $('#container').foundation('tooltip', 'reflow');
                    rs();
                });

        }

        rs();

        $(window).on('resize', rs);

        metaData.on('click', '[data-selectnode]', function (e) {
            e.preventDefault();

            var $anchor = $(this);
            openNode    = $anchor.data('selectnode');
            var target  = tree.find('a[id=' + openNode + '_anchor]');

            target.trigger('click');
        });

        var loadingClass = 'icon-loading',
            fileClass    = 'icon-document',
            failClass    = 'icon-alert';

        $('#async').fileDrop({
            dictDefaultMessage:'You can drag files into this space.',
            previewsContainer: '#preview-container',

            addedfile: function (file) {

                var name = file.name.substr(0, file.name.lastIndexOf('.')),
                    data = {
                        category: openNode,
                        description: name,
                        comment: '',
                        hidden: 0
                    };

                var parent = [ openNode ],
                    newNode = {
                        text: name,
                        icon: loadingClass,
                        type: 'file',
                        li_attr: {
                            'data-permission': 'write'
                        }
                    };

                var el = $(file.previewElement);

                $.each(data, function (k, v) {

                    // set data for ajax form submission on both preview elements
                    el.data(k, v);
                    newNode.li_attr['data-' + k] = v;

                });

                jstree.create_node(parent, newNode, 'last', function (freshNode) {
                    $(file.previewElement).data('node', freshNode);
                    console.log('node creation done:' + freshNode.id);
                });

                // console.log(openNode, name, $(file.previewElement).data());
            },

            sending: function (file, xhr, formData) {

                console.log('sending commenced');

                var data = $(file.previewElement).data();

                console.log(data);

                if (data) {
                    // jam file data into form data
                    $.each(data, function (k, v) {
                        formData.append(k, v);
                    });
                }
            },

            success: function (file, response) {

                var newFileId = response.id,
                    el        = $(file.previewElement),
                    node      = el.data('node');

                node.li_attr['data-id'] = newFileId;
                node.icon = fileClass;

                // update the "original" too
                node.original.li_attr['data-id'] = newFileId;
                node.original.icon = fileClass;

                // get the li in the tree
                var $li = $(jstree.get_node(node.id, true));

                // manipulate the visual output
                $li.data('id', newFileId)
                   .find('.' + loadingClass)
                   .removeClass(loadingClass)
                   .addClass(fileClass);

            },

            error: function (file, response) {

                var el   = $(file.previewElement),
                    node = el.data('node');

                node.icon = failClass;
                node.original.icon = failClass;

                var $li = $(jstree.get_node(node.id, true));

                $li.find('.' + loadingClass).removeClass(loadingClass).addClass(failClass).attr('title', response.error);
                $li.find('a.jstree-anchor').append('<span class="meta"> - ' + response.error + '</span>');
            }
        });

    });
</script>
{# /HEAD #}

<div class="resource-browser row">
    <div class="small-12 island">
        <section>
            <div class="scroller" id="resources">
                <div id="tree" class="resource-tree"></div>
            </div>
        </section>
    </div>
    <div class="small-12 island">
        <section class="dropzone-wrap">
            <form id="async" class="dropzone overlay" action="/cms/fileForm.php?ajax=1" method="post"></form>
            <div class="hide" id="preview-container"></div>
            <div data-ajax id="meta" class="meta-panel">
                {% include '@resourceBrowser/showFolderInfo.twig' %}
            </div>
        </section>
    </div>
</div>
