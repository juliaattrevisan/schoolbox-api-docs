{% import '@resourceBrowser/macro/nodeIcon.twig' as nodeIcon %}

{# TODO PUT THIS IN THE HEAD SOMEHOW #}
<link rel="stylesheet" href="/javascript/components/jstree/dist/themes/default/style.css" />
<script type="text/javascript" src="/javascript/components/jstree/dist/jstree.js"></script>
<script type="text/javascript" src="/javascript/jquery.resourceTree.js"></script>
<script type="text/javascript" src="/javascript/components/jquery.scrollTo/jquery.scrollTo.min.js"></script>

{% if namespace == 'myFilesBrowser' %}
    {% set fileController   = 'myFile' %}
    {% set folderController = 'myFolder' %}
    {% set folderVar = 'parent' %}
{% elseif namespace == 'webDavBrowser' %}
    {% set fileController   = 'networkFile' %}
    {% set folderController = 'networkFolder' %}
    {% set folderVar = 'parent' %}
{% else %}
    {% set fileController   = 'file' %}
    {% set folderController = 'category' %}
    {% set linkController   = 'link' %}
    {% set folderVar = 'category' %}
{% endif %}

<script type="text/javascript">
    $(function () {
        var openNode = {{ folder.id }};

        {# TODO put this in a new module #}
        var tree = $('#tree'),
            metaData         = $('#meta'),
            listItem         = 'li',
            folderInfoUri    = '/:id/info',
            fileInfoUri      = '/file/:id/info',
            linkInfoUri      = '/link/:id/info';

        tree.resourceTree({{ nodeIcon.jsIconMap() }}, {
            data: {
                {# raw HTML reluctantly sanctioned - this should be passed to template as raw, then json_encode|raw #}
                cache: {{ treedata | raw }},
                ajaxParams: {
                    url: '{{ routeLookup(namespace ~ '.listNodes') }}',
                    token: '{folderId}'
                }
            }
        });

        // expose the jstree in all its splendour
        var jstree = tree.jstree(true);

        tree.on('select_node.jstree', function(event, jstree) {
            jstree.instance.open_node(jstree.node.id);
            var nodeId = jstree.node.li_attr['data-id'];
            if (jstree.node.type == 'file') {
                loadPanel(metaData, fileInfoUri, nodeId);
            } else if (jstree.node.type == 'link') {
                loadPanel(metaData, linkInfoUri, nodeId);
            } else {
                // changed folder? update the node
                openNode = nodeId;
                loadPanel(metaData, folderInfoUri, nodeId);
            }
        });

        $(document).on('dnd_stop.vakata', function (event, data) {

            // draggedTypeGen could also be a link
            var $dragged       = $(data.element).closest(listItem),
                draggedType    = $dragged.data('type'),
                draggedTypeGen = '',
                draggedId      = $dragged.data('id'),
                draggedPerm    = $dragged.data('permission'),
                dragParentPerm = $dragged.closest(listItem).data('permission'),
                $dropTarget    = $(data.event.target).closest(listItem),
                dropTargetId   = $dropTarget.data('id'),
                dropTargetType = $dropTarget.data('type'),
                dropTargetPerm = $dropTarget.data('permission');

            switch (draggedType) {
                case 'file':
                    draggedTypeGen = '{{ fileController }}';
                    break;
                case 'link':
                    draggedTypeGen = '{{ linkController }}' || '{{ folderController }}';
                    break;
                case 'folder':
                default:
                    draggedTypeGen = '{{ folderController }}';
                    break;
            }

            // Can I actually drag this item or its parent?
            if (!(draggedPerm == 'write' || draggedPerm == 'full')
                || !(dragParentPerm == 'write' || dragParentPerm == 'full')
            ) {
                return;
            }

            switch (dropTargetType) {
                case 'file':
                case 'link':
                    // If somehow this node was dragged onto a node which can't have children,
                    // target the folder this node is in instead.
                    $dropTarget    = $dropTarget.parent().closest(listItem);
                    dropTargetId   = $dropTarget.data('id');
                    dropTargetType = $dropTarget.data('type');
                    dropTargetPerm = $dropTarget.data('permission');
                    break;

                case 'folder':
                default:
                    break;
            }

            if (!(dropTargetPerm == 'write' || dropTargetPerm == 'full')) {
                return;
            }

            if (draggedTypeGen == 'category') {
                // /cms/categoryForm.php no longer exists, use controller instead.
                $.ajax({
                    url: '/resource/folder/{id}/move/{parentId}'
                        .replace('{id}', draggedId)
                        .replace('{parentId}', dropTargetId),
                    type: 'PUT'
                });
            } else {
                $.post(
                    '/cms/' + draggedTypeGen + 'Form.php',
                    {
                        move: draggedId,
                        categoryID: dropTargetId,
                        ajax: 1
                    }
                );
            }
        });

        var $window    = $(window),
            $hybrid    = $('#hybrid-bar'),
            $footer    = $('#footer'),
            $resources = $('#resources');


        // On the initial open of the tree and all its open by default parts:
        // scroll to it
        tree.on('after_open.jstree.initial', function(event, jstree) {
            var nodeId = jstree.node.id;

            // If this node is the parent of the selected: scroll to the selected now
            var initialNode = jstree.instance.get_children_dom(nodeId).filter('#'+{{ folder.id }});
            if (initialNode.length) {
                $resources.scrollTo(initialNode);
                tree.off('.jstree.initial');
            }
        });

        function rs()
        {
            var calcd = 0;

            if ($(window).width() > 1440) {
                calcd = $window.height() - $hybrid.height() - $footer.height() - 120;
            } else {
                calcd = $window.height() - $hybrid.height() - $footer.height() - metaData.height() - 120;
            }

            $resources.height(Math.max(200, calcd));
        }

        function loadPanel(panel, path, nodeId)
        {
            var uri = '{{ routeLookup(namespace ~ '.browse') }}'+path.replace(':id', nodeId);

            panel
                .addClass('loading')
                .data('nodeId', nodeId)

                {# TODO cache this #}
                .load(uri, function () {
                    $(this).removeClass('loading');
                    $(document).foundation('tooltip', 'reflow').foundation('dropdown', 'reflow');
                    rs();
                });

        }

        rs();

        $(window).on('resize', rs);

        metaData.on('click', '[data-selectnode]', function (e) {
            e.preventDefault();

            var $anchor = $(this);
            openNode    = $anchor.data('selectnode');
            var target  = tree.find('a[id=' + openNode + '_anchor]');

            target.trigger('click');
        });

        {# Add delete confirmation if it is available by intercepting delete requests #}
        metaData.on('click', '[data-action="delete"]', function (event) {
            event.preventDefault();

            var deleteNode   = jstree.get_selected(true);
            var selectParent = deleteNode[0].parent;

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this?',
                confirmEvent: function (anchor) {
                    $
                        .ajax({
                            url: anchor.attr('href'),
                            type: 'DELETE',
                        })
                        .done(function () {
                            jstree.delete_node(deleteNode);
                            jstree.select_node(selectParent);
                        });
                }
            });
        });

    });
</script>
{# /HEAD #}
<div class="row">
    <div class="small-12 columns"><h1>Resources</h1></div>
</div>
<div class="resource-browser row">
    <div class="small-12 xlarge-7 island">
        <section>
            <div class="scroller" id="resources">
                <div id="tree" class="resource-tree"></div>
            </div>
        </section>
    </div>
    <div class="small-12 xlarge-5 island">
        <section class="dropzone-wrap">
            <div class="hide" id="preview-container"></div>
            <div data-ajax id="meta" class="meta-panel">
                {% include '@resourceBrowser/showFolderInfo.twig' %}
            </div>
        </section>
    </div>
</div>
