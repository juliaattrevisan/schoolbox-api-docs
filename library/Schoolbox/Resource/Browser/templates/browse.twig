{# TODO PUT THIS IN THE HEAD SOMEHOW #}
<link rel="stylesheet" type="text/css" media="screen" href="/css/foundation/chrome.css?v={SITE_VERSION}" />
<link rel="stylesheet" type="text/css" media="screen" href="/css/tree.css" />
<link rel="stylesheet" href="/javascript/components/jstree/dist/themes/default/style.css" />
<style type="text/css">
    /* STYLES I NEED */
    #file-list li {
        line-height: 32px;
        background-position: 0 4px;
        background-repeat: no-repeat;
    }
    .jstree-default .jstree-node {
        min-height: 32px;
        line-height: 32px;
    }
    #file-list li a {
        margin-left: 24px;
    }
    .row > div.columns:not(:last-of-type) {
        border-right: solid 1px #eee;
    }
    .row > div.columns {
        overflow-x: hidden;
    }
    #container.foundation ul.jstree-container-ul {
        margin-left: 0;
    }
    #tree > ul > li > i {
        visibility: hidden;
    }
    #tree > ul > li > a {
        margin-left: -7px;
    }
    [data-ajax] {
        position: relative;
    }
    [data-ajax]:before {
        display: none;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255,255,255,0.8);
        text-align: center;
        box-sizing: border-box;
        padding-top: 45%;
    }
    [data-ajax].loading:before {
        display: block;
        position: absolute;
        content: "Loading...";
        z-index: 1;
    }
    .p128 {
        display: block;
        min-height: 128px;
    }
    #file-list a {
        overflow-x: hidden;
        display: block;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    .jstree-node {
        overflow-x: hidden;
    }
    #three-panel > .columns {
        height: 100%;
    }
    .meta-title {
        font-weight: bold !important;
        clear: both;
        white-space: nowrap;
        overflow-x: hidden;
        text-overflow: ellipsis;
    }

    #meta .information-list > li.center img.icon { {# I should not need to be this specific :/ #}
        float: none;
        margin: 0 0 1.125em 0;
    }
</style>
<script type="text/javascript" src="/javascript/components/jstree/dist/jstree.js"></script>
<script type="text/javascript" src="/javascript/jquery.resourceTree.js"></script>
<script type="text/javascript" src="/javascript/jquery.three-panel.js"></script>
<script type="text/javascript" src="/javascript/jquery.fileDrop.js"></script>
<script type="text/javascript">
    $(function () {
        $('#container').addClass('foundation').foundation();

        var tree = $('#tree');

        tree.resourceTree({
            data: {
                cache: {{ treedata | raw }}
            }
        });

        tree.on('select_node.jstree', function(event, jstree) {
            $('#file-list')
                .addClass('loading')
                .load('/resourceses/'+jstree.node.id+'/children', function () {
                    $(this).removeClass('loading');
                });

            $('#meta')
                .addClass('loading')
                .load('/resourceses/'+jstree.node.id+'/info', function () {
                    $(this).removeClass('loading');
                        $('#container').foundation('tooltip', 'reflow');
                });
        });

        $('#file-list').on('click', 'a', function (e) {
            e.preventDefault();
            $('#meta')
                .addClass('loading')
                .load('/resourceses/file/'+$(this).data('id')+'/info', function () {
                    $(this).removeClass('loading');
                    $('#container').foundation('tooltip', 'reflow');
                });
        });

        function rs()
        {
            $('#three-panel').height(
                $(window).height() - $('#header').height() - $('#footer').height() - 8
            );
        }

        rs();

        $(window).on('resize', rs);
    });
</script>
{# /HEAD #}

<div id="three-panel" class="row" style="max-width:100%;">
    <div class="large-4 columns">
        <h2>Folders</h2>
        <div class="scroller">
            <div id="tree"></div>
        </div>
    </div>
    <div class="large-4 columns">
        <h2>Files</h2>
        <div class="scroller">
            <ul data-ajax id="file-list">
                {% include '@resourceBrowser/listResources.twig' with { files: files } %}
            </ul>
        </div>
    </div>
    <div class="large-4 columns">
        <h2>Properties</h2>
        <div data-ajax id="meta">
            {% include '@resourceBrowser/showFolderInfo.twig' %}
        </div>
    </div>
</div>

