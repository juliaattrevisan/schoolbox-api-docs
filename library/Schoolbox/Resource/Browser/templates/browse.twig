{# TODO PUT THIS IN THE HEAD SOMEHOW #}
<link rel="stylesheet" type="text/css" media="screen" href="/css/foundation/chrome.css?v={SITE_VERSION}" />
<link rel="stylesheet" href="/javascript/components/jstree/dist/themes/default/style.css" />
<style type="text/css">
    /* STYLES I NEED */

    #tree > ul > li > i {
        visibility: hidden;
    }
    #tree > ul > li > a {
        margin-left: -7px;
    }
    [data-ajax] {
        position: relative;
    }
    [data-ajax]:before {
        display: none;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255,255,255,0.8);
        text-align: center;
        box-sizing: border-box;
        padding-top: 10%;
    }
    [data-ajax].loading:before {
        display: block;
        position: absolute;
        content: "Loading...";
        z-index: 1;
    }

    #file-list {
        margin: 0;
    }
    #file-list li {
        line-height: 2rem;
        background-position: 0.375rem 0.75rem;
        background-repeat: no-repeat;
        border-radius: 0;
        box-shadow: none;
     }
    #file-list li a {
        margin-left: 2rem;
        padding: 0.5rem;
        overflow-x: hidden;
        display: block;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    .meta-title {
        font-weight: bold !important;
        clear: both;
        white-space: nowrap;
        overflow-x: hidden;
        text-overflow: ellipsis;
    }

    #three-panel form.dropzone {
        position: absolute !important;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }
    #tree {
        /*overflow-x: hidden;*/
    }
    .scroller {
        overflow: auto;
        height: 20rem;
    }
    @media only screen and (min-width:64.0625em) and (max-width:120em) {
        .folder-panel, .file-panel {
            height: 100%;
        }
        .folder-panel section, .file-panel section {
            height: 100%;
            overflow: auto;
        }
        .property-panel {
            margin-top: 1rem;
            /*height: 200px;*/
        }
        #meta {
            /*height: 200px;*/
            overflow: hidden;
        }
    }


</style>
<script type="text/javascript" src="/javascript/components/jstree/dist/jstree.js"></script>
<script type="text/javascript" src="/javascript/jquery.resourceTree.js"></script>

{% if namespace == 'myFilesBrowser' %}
    {% set treeController = 'MyFiles' %}
{% elseif namespace == 'webDavBrowser' %}
    {% set treeController = 'Webdav' %}
{% endif %}

<script type="text/javascript">
    $(function () {

        {# TODO put this in a new module #}
        var tree = $('#tree'),
            metaData         = $('#meta'),
            listItem         = 'li',
            selected         = 'selected',
            hovered          = 'jstree-hovered',
            folderInfoUri    = '/:id/info',
            fileInfoUri      = '/file/:id/info';

        tree.resourceTree({
            data: {
                cache: {{ treedata | raw }},
                ajaxParams: {
                    url: '{{ routeLookup(namespace ~ '.listNodes') }}',
                    token: '{folderId}'
                }
            }
        });

        {# TODO this will only work if put inside a promise at the end of jstree loading #}
        {% if folder.id == 0 %}
        tree.data('jstree').open_node(0);
        {% endif %}

        tree.on('select_node.jstree', function(event, jstree) {

            if (jstree.node.type == 'file') {
                loadPanel(metaData, fileInfoUri, jstree.node.id);
            } else {
                loadPanel(metaData, folderInfoUri, jstree.node.id);
            }
        });

        $(document).on('dnd_stop.vakata', function (event, data) {

            var $dragged       = $(data.element).closest(listItem),
                draggedType    = $dragged.data('type'),
                draggedTypeGen = draggedType == 'file' ? 'file' : 'category',
                draggedId      = data.data.nodes[0],

                $dropTarget    = $(data.event.srcElement).closest(listItem),
                dropTargetId   = $dropTarget.attr('id'),
                dropTargetType = $dropTarget.data('type'),
                dropTargetPerm = $dropTarget.data('permission');

            if (dropTargetType == 'file' || (!(dropTargetPerm == 'write' || dropTargetPerm == 'full'))) {
                return;
            }

            /*
            console.log([
                'Move', draggedType, draggedId, 'to', dropTargetType, dropTargetId
            ].join(' '));
            */

            $.post(
                '/cms/' + draggedTypeGen + 'Form.php',
                {
                    move: draggedId,
                    categoryID: dropTargetId,
                    ajax: 1
                }
            );

        });

        var $window    = $(window),
            $hybrid    = $('#hybrid-bar'),
            $footer    = $('#footer'),
            $resources = $('#resources');


        function rs()
        {
            var calcd = $window.height() - $hybrid.height() - $footer.height() - metaData.height() - 120;

            $resources.height(Math.max(200, calcd));
        }

        function loadPanel(panel, path, nodeId)
        {
            var uri = '{{ routeLookup(namespace ~ '.browse') }}'+path.replace(':id', nodeId);

            panel
                .addClass('loading')
                .data('nodeId', nodeId)

                {# TODO cache this #}
                .load(uri, function () {
                    $(this).removeClass('loading');
                    $('#container').foundation('tooltip', 'reflow');
                    rs();
                });

        }

        rs();

        $(window).on('resize', rs);

        metaData.on('click', '[data-selectnode]', function (e) {
            e.preventDefault();

            var $anchor = $(this),
                node    = $anchor.data('selectnode'),
                target  = tree.find('a[id=' + node + '_anchor]');

            target.trigger('click');
        });

    });
</script>
{# /HEAD #}

<div id="three-panel" class="three-panels row" style="max-width:100%;">
    <div class="small-12 island folder-panel">
        <section>
            <div class="scroller" id="resources">
                <div id="tree"></div>
            </div>
        </section>
    </div>
    <div class="small-12 island property-panel">
        <section>
            <div data-ajax id="meta" class="content">
                {% include '@resourceBrowser/showFolderInfo.twig' %}
            </div>
        </section>
    </div>
</div>
