<dl class="inline-dl">
    {% if namespace == 'resourceBrowser' %}
        <dt class="small-12 medium-4">Uploaded by</dt>
        <dd class="small-12 medium-8">
            <div class="tiny card small-12">
                <a href="/search/user/{{ file.owner.id }}">
                    <img src="{{ portrait ~ file.owner.externalId }}" alt="{{ file.owner.formatName }}" />
                    <p>{{ file.owner.formatName }}</p>
                </a>
            </div>
        </dd>
    {% endif %}

    <dt class="small-12 medium-4">Filesize</dt>
    <dd class="small-12 medium-8">{{ file.size | bytes }}</dd>

    {% set fileHasCreatedAt = file.createdAt is defined and file.createdAt is not null %}
    {% if fileHasCreatedAt %}
    <dt class="small-12 medium-4">Created</dt>
    <dd class="small-12 medium-8">{{ file.createdAt.short }}</dd>
    {% endif %}


    {# Modified files remember who modified them
     #
     # ModifiedAt actually exists in the absence of ModifiedBy if you upload this file somewhere,
     # which isn't something I expected to find
     #}
    {% set fileHasModifiedAt = file.modifiedAt is defined and file.modifiedAt is not null %}
    {% if fileHasModifiedAt
        and (not fileHasCreatedAt or file.createdAt.unixTimestamp != file.modifiedAt.unixTimestamp)
    %}
        <dt class="small-12 medium-4">Last modified</dt>
        <dd class="small-12 medium-8">{{ file.modifiedAt.short }}
            {% if file.modifiedBy %}
            by <a href="/search/user/{{ file.modifiedBy.id }}" title="{{ file.modifiedBy.formatName }}">{{ file.modifiedBy.formatName }}</a>
            {% endif %}
        </dd>
    {% endif %}

    <dt class="small-12 medium-4">Original File</dt>
    <dd class="small-12 medium-8">{{ file.filename }} ({{ file.mime }})</dd>

    {% if namespace == 'resourceBrowser' %}
        <dt class="small-12 medium-4">Hidden</dt>
        <dd class="small-12 medium-8">
            <span data-tooltip aria-haspopup="true" class="has-tip" title="Visible to users with {{ file.hidden ? 'write' : 'read' }} access to the folder">{{ file.hidden ? 'Yes' : 'No' }}</span>
        </dd>
    {% endif %}

    <dt class="small-12 medium-4">Direct Link</dt>
    <dd class="small-12 medium-8">
        <a href="{{ send ~ file.id }}">{{ host ~ send ~ file.id }}</a>
    </dd>
</dl>
