<dl class="inline-dl">
    {% if namespace == 'resourceBrowser' %}
        <dt class="small-12 medium-4">Uploaded by</dt>
        <dd class="small-12 medium-8">
            <div class="avatar card tiny">
                <a href="/search/user/{{ file.owner.id }}">
                    <img src="{{ portrait ~ file.owner.externalId }}" alt="{{ file.owner.formatName }}" />
                    <p>{{ file.owner.formatName }}</p>
                </a>
            </div>
        </dd>
    {% endif %}

    <dt class="small-12 medium-4">URL</dt>
    <a href="{{ file.getHref() }}">{{ file.getUrl() }}</a>

    {% if namespace == 'resourceBrowser' %}
        {% if file.createdAt.unixTimestamp != file.modifiedAt.unixTimestamp %}
            <dt class="small-12 medium-4">Last modified</dt>
            <dd class="small-12 medium-8">{{ file.modifiedAt.dateOnly }}</dd>
        {% endif %}

        <dt class="small-12 medium-4">Hidden</dt>
        <dd class="small-12 medium-8">
            <span data-tooltip aria-haspopup="true" class="has-tip" title="Visible to users with {{ file.hidden ? 'write' : 'read' }} access to the folder">{{ file.hidden ? 'Yes' : 'No' }}</span>
        </dd>
    {% endif %}
</dl>
