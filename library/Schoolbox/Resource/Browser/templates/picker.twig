{% import '@resourceBrowser/macro/nodeIcon.twig' as nodeIcon %}

{# Load in required CSS as we are not inside the chrome #}
{% include 'include/skin.twig' with { config: config } only %}

<link rel="stylesheet" href="{{ CDN_PREFIX }}/js/vendors/jstree/dist/themes/default/style.css?v={{ config.site_version }}" />

{% if namespace == 'myFilesBrowser' %}
    {% set fileController   = 'myFile' %}
    {% set folderController = 'myFolder' %}
    {% set folderVar = 'parent' %}
{% elseif namespace == 'webDavBrowser' %}
    {% set fileController   = 'networkFile' %}
    {% set folderController = 'networkFolder' %}
    {% set folderVar = 'parent' %}
{% else %}
    {% set fileController   = 'file' %}
    {% set folderController = 'category' %}
    {% set linkController   = 'link' %}
    {% set folderVar = 'category' %}
{% endif %}

<script src='{{ CDN_PREFIX }}/js/bundle/vendors.js?v={{ config.site_version }}'></script>
<script src='{{ CDN_PREFIX }}/js/bundle/main.js?v={{ config.site_version }}'></script>

<script>
    // This is required because chrome.twig might not be included, due to this file being used as a full web page.
    window.cdnPrefix = "{{ CDN_PREFIX }}";

    // Although this file is clearly not a full web page (no <html> tag for example), it is used as a full web
    // page when set as the contents of an iframe by Javascript in attach-browser.html.
    // Because this file is used as a full web page, the document may not be ready at the time this script runs.
    if (document.readyState !== 'loading') {
        main();
    } else {
        document.addEventListener('DOMContentLoaded', main);
    }

    function main() {
        sbProps.injectScriptsIfNotLoaded(
            {
                srcList: [
                    '{{ CDN_PREFIX }}/js/bundle/vendors.js?v={{ config.site_version }}',
                    '{{ CDN_PREFIX }}/js/bundle/main.js?v={{ config.site_version }}',
                    '{{ CDN_PREFIX }}/js/vendors/jstree/dist/jstree.min.js?v={{ config.site_version }}',
                    '{{ CDN_PREFIX }}/js/resource/jquery.resourceTree.js?v={{ config.site_version }}',
                    '{{ CDN_PREFIX }}/js/vendors/scrollTo/jquery.scrollTo.min.js?v={{ config.site_version }}',
                    '{{ CDN_PREFIX }}/js/resource/jquery.fileDrop.js?v={{ config.site_version }}'
                ],
                onComplete: initResourceTree
            }
        );
    }

    function initResourceTree () {

        var openNode = {{ folder.id ?? 0 }};

        {# TODO put this in a new module #}
        var tree = $('#tree'),
                metaData         = $('#meta'),
                listItem         = 'li',
                folderInfoUri    = '/:id/info',
                fileInfoUri      = '/file/:id/info',
                linkInfoUri      = '/link/:id/info';

        tree.resourceTree({{ nodeIcon.jsIconMap() }}, {
            data: {
                {# raw HTML reluctantly sanctioned - this should be passed to template as raw, then json_encode|raw #}
                cache: {{ treedata | raw }},
                ajaxParams: {
                    url: '{{ routeLookup(namespace ~ '.listNodes') }}?mime={{ mime }}',
                    token: '{folderId}'
                }
            }
        });

        // expose the jstree in all its splendour
        var jstree = tree.jstree(true);

        tree.on('select_node.jstree', function(event, jstree) {
            jstree.instance.open_node(jstree.node.id);
            var nodeId = jstree.node.li_attr['data-id'];
            if (jstree.node.type == 'file') {
                $.get('/drives/file/' + nodeId + '/ajax', function(e) {
                    data = [{
                        title:    e.title,
                        mimeType: e.mimeType,
                        filesize: e.filesize,
                        hash:     '{{ source_slug }}:' + nodeId
                    }];

                    window.top.postMessage(JSON.stringify({ data: data }), location.origin);
                });
            } else if (jstree.node.type == 'folder') {
                openNode = nodeId;
            }
        });

        var $window    = $(window),
                $hybrid    = $('#hybrid-bar'),
                $footer    = $('#footer'),
                $resources = $('#resources');


        // On the initial open of the tree and all its open by default parts:
        // scroll to it
        tree.on('after_open.jstree.initial', function(event, jstree) {
            var nodeId = jstree.node.id;

            // If this node is the parent of the selected: scroll to the selected now
            var initialNode = jstree.instance.get_children_dom(nodeId).filter('#'+{{ folder.id ?? 0 }});
            if (initialNode.length) {
                $resources.scrollTo(initialNode);
                tree.off('.jstree.initial');
            }
        });

        function rs()
        {
            var calcd = $window.height() - $hybrid.height() - $footer.height() - metaData.height() - 120;
            $resources.height(Math.max(320, calcd));
        }

        rs();

        $(window).on('resize', rs);

        metaData.on('click', '[data-selectnode]', function (e) {
            e.preventDefault();

            var $anchor = $(this);
            openNode    = $anchor.data('selectnode');
            var target  = tree.find('a[id=' + openNode + '_anchor]');

            target.trigger('click');
        });

        var loadingClass = 'icon-loading',
                fileClass    = 'icon-document',
                failClass    = 'icon-alert';

        $('#async').fileDrop({
            dictDefaultMessage:'You can drag files into this space.',
            previewsContainer: '#preview-container',

            addedfile: function (file) {

                var name = file.name.substr(0, file.name.lastIndexOf('.')),
                        data = {
                            '{{ folderVar }}': openNode,
                            description: name,
                            comment: '',
                            visible: 1
                        };

                var parent = [ openNode ],
                        newNode = {
                            text: name,
                            icon: loadingClass,
                            type: 'file',
                            li_attr: {
                                'data-permission': 'write'
                            }
                        };

                var el = $(file.previewElement);

                $.each(data, function (k, v) {

                    // set data for ajax form submission on both preview elements
                    el.data(k, v);
                    newNode.li_attr['data-' + k] = v;

                });

                jstree.create_node(parent, newNode, 'last', function (freshNode) {
                    $(file.previewElement).data('node', freshNode);
                });
            },

            sending: function (file, xhr, formData) {

                var data = $(file.previewElement).data();

                if (data) {
                    // jam file data into form data
                    $.each(data, function (k, v) {
                        formData.append(k, v);
                    });
                }
            },

            success: function (file, response) {

                var newFileId = response.id,
                        el        = $(file.previewElement),
                        node      = el.data('node');

                node.li_attr['data-id'] = newFileId;
                node.icon = fileClass;

                // update the "original" too
                node.original.li_attr['data-id'] = newFileId;
                node.original.icon = fileClass;

                // get the li in the tree
                var $li = $(jstree.get_node(node.id, true));

                // manipulate the visual output
                $li.data('id', newFileId)
                        .find('.' + loadingClass)
                        .removeClass(loadingClass)
                        .addClass(fileClass);

            },

            error: function (file, response) {

                var el   = $(file.previewElement),
                        node = el.data('node');

                node.icon = failClass;
                node.original.icon = failClass;

                var $li = $(jstree.get_node(node.id, true));

                $li.find('.' + loadingClass).removeClass(loadingClass).addClass(failClass).attr('title', response.error);
                $li.find('a.jstree-anchor').append('<span class="meta"> - ' + response.error + '</span>');
            }
        });

        {# Add delete confirmation if it is available by intercepting delete requests #}
        metaData.on('click', '[data-action="delete"]', function (event) {
            event.preventDefault();

            var deleteNode   = jstree.get_selected(true);
            var selectParent = deleteNode[0].parent;

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this?',
                confirmLabel: 'Delete',
                confirmEvent: function (anchor) {
                    $.post(anchor.attr('href'), {id: $(event.target).attr('data-folder-id') }).done(function () {
                        jstree.delete_node(deleteNode);
                        jstree.select_node(selectParent);
                    });
                }
            });
        });

    }

</script>
{# /HEAD #}

<div class="resource-browser row">
    <div class="small-12 island no-pad">
        <section>
            <div class="scroller" id="resources">
                <div id="tree" class="resource-tree"></div>
            </div>
        </section>
    </div>
</div>
