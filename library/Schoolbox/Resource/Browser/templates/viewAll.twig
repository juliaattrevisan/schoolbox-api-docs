<ul class="breadcrumb">
    <li><a href="/homepage/{{ homepage.identifier }}">{{ homepage.name }}</a></li>
    <li class="active"><a>{{ title }}</a></li>
</ul>
{{ title }}
<br>
componentFolderId:
{{ componentFolderId }}
<br>
<div>Source Folder: {{ componentInstanceConfig.src.value }}</div>

<div>Filters: {{ dump(filter) }}</div>
<table>
    <tr>
        <th>File Name</th>
        <th>Date Modified</th>
    </tr>
    {% for file in files %}
        <tr>
            <td>
                <a data-plugin="preview" href="/send.php?id={{ file.file_id }}" rel="external">
                    <img class="mime" src="/images/mime/{{ file.mime.iconFile }}" height="64" width="64" title="{{ file.mime }}"/>{{ file.name }}
                </a>
            </td>
            <td>{{ file.dateModified.formatted }}</td>
        </tr>
    {% endfor %}
</table>
