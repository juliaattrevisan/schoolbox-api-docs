<script type="text/javascript" src="{{ CDN_PREFIX }}/js/resource/jquery.fileDrop.js"></script>

<ul class="breadcrumb">
    <li><a href="/homepage/{{ homepage.id }}">{{ homepage.getNameWithCodes() }}</a></li>
    <li class="active"><span>{{ title }}</span></li>
</ul>

<div class="row">
    <div class="small-12">
        <h1>{{ title }}</h1>
    </div>
</div>

<div id="view-all-files-container">
    <view-all-files
        :component-instance-config="{{ componentInstanceConfig|json_encode }}"
        :files="{{ files|json_encode }}"
        :selected-filters="{{ filter|json_encode }}"
        :can-edit="{{ canEdit ? 'true' : 'false' }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/viewAllFiles.js"></script>