<ul class="breadcrumb">
    <li><a href="/homepage/{{ homepage.id }}">{{ homepage.getNameWithCodes() }}</a></li>
    <li class="active"><span>{{ breadcrumb }}</span></li>
</ul>

<div class="row">
    <div class="small-12">
        <h1 class="t-restrict-length">{{ title }}</h1>
    </div>
</div>

<div id="view-all-files-container">
    <view-all-files
        :can-edit="{{ canEdit ? 'true' : 'false' }}"
        sort-dir="{{ sortDir }}"
        sort-by="{{ sortBy }}"
        :files="{{ files|json_encode }}"
        :preset-filters="{{ filter|json_encode }}"
        referrer="{{ referrer }}"
        :source-folder-id="{{ sourceFolderID }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/resource/jquery.fileDrop.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/viewAllFiles.js?v={{ config.site_version }}"></script>
