<ul class="breadcrumb">
    <li><a href="/homepage/{{ homepage.identifier }}">{{ homepage.name }}</a></li>
    <li class="active"><span>{{ title }}</span></li>
</ul>

<div class="row">
    <div class="small-12">
        <h1>{{ title }}</h1>
    </div>
</div>

<div id="view-all-files-container">
    <view-all-files
        :files="{{ files|json_encode }}"
        :selected-filters="{{ filter|json_encode }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/viewAllFiles.js"></script>