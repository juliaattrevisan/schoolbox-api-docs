{% set routeModify    = routeLookupIfAuthorized('folder.getFolderModify', {id: folder.id, folder: folder}) %}
{% set routePostFile  = folder.id != 0 and access >= 2 ? '/cms/file/new/' ~ folder.id : false %}
{% set routeCreate    = routeLookupIfAuthorized('folder.getFolderCreate', {parentId: folder.id, parent: folder.parent}) %}
{% set routeAddLink   = folder.id != 0 and access >= 2 ? '/cms/link/new/' ~ folder.id : false %}
{% set routeDownload  = folder.id != 0 and access >= 2 ? '/cms/fetchFolder.php?folder=' ~ folder.id : false %}
{% set routeUploadZip = folder.id != 0 and (user.isSuperuser or (access >= 2 and conf.enable_teacher_zip_upload)) ? '/cms/zipFile/' ~ folder.id : false %}
{% set routeDelete    = routeLookupIfAuthorized('folder.deleteFolder', {id: folder.id, folder: folder}) %}
{% set routeViewFiles = folder.id == 0 ? false : routeLookupIfAuthorized('resourceBrowser.showFolderFiles', {folderId: folder.id, folder: folder}) %}
{% set viewFilesName  = (folder.id != 0 and (user.isSuperuser or access >= 2)) ? 'Manage Files' : 'View Files' %}
{% set routeManageGroup = routeLookupIfAuthorized('group.getModify', {folderId: folder.id, folder: folder}) %}

{% if folder.hasHomepage %}<li><a data-action="folder" data-test="resource-action-homepage" href="/homepage/{{ folder.id }}" class="sbx-button--has-icon"><sbx-icon name="home"></sbx-icon>Homepage</a></li>{% endif %}
{% if routeModify        %}<li><a data-action="modify" href="{{ routeModify }}" class="sbx-button--has-icon"><sbx-icon name="modify"></sbx-icon>Modify</a></li>{% endif %}
{% if routePostFile      %}<li><a data-action="file" href="{{ routePostFile }}" class="sbx-button--has-icon"><sbx-icon name="drop-box"></sbx-icon>Post File</a></li>{% endif %}
{% if routeViewFiles     %}<li><a data-action="file" href="{{ routeViewFiles }}" class="sbx-button--has-icon"><sbx-icon name="files"></sbx-icon>{{ viewFilesName }}</a></li>{% endif %}
{% if routeCreate        %}<li><a data-action="folder" href="{{ routeCreate }}" class="sbx-button--has-icon"><sbx-icon name="folder"></sbx-icon>Add Folder</a></li>{% endif %}
{% if routeAddLink       %}<li><a data-action="link" href="{{ routeAddLink }}" class="sbx-button--has-icon"><sbx-icon name="link"></sbx-icon>Add Link</a></li>{% endif %}
{% if routeDownload      %}<li><a data-action="download" href="{{ routeDownload }}" title="{{ folder.name }}" class="sbx-button--has-icon"><sbx-icon name="download"></sbx-icon>Download</a></li>{% endif %}
{% if routeUploadZip     %}<li><a data-action="zip" href="{{ routeUploadZip }}" class="sbx-button--has-icon"><sbx-icon name="upload"></sbx-icon>Upload ZIP</a></li>{% endif %}
{% if routeDelete        %}<li><a class="sbx-button--has-icon"
                                   data-action="delete"
                                   href="{{ routeDelete }}"
                                   data-delete
                                   title="Delete folder"
                                   aria-label="Delete folder">
    <sbx-icon name="delete"></sbx-icon>
    Delete
</a></li>{% endif %}

{% if folder.group and routeManageGroup %}
    <li>
        <a data-action="manage" href="{{ routeManageGroup }}" class="sbx-button--has-icon"><sbx-icon name="group-managers"></sbx-icon>Manage Group</a>
    </li>
{% endif %}
