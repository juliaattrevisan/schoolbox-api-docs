{% set routeModify    = routeLookupIfAuthorized('folder.getFolderModify', {id: folder.id, folder: folder}) %}
{% set routePostFile  = folder.id != 0 and access >= 2 ? '/cms/file/new/' ~ folder.id : false %}
{% set routeCreate    = routeLookupIfAuthorized('folder.getFolderCreate', {parentId: folder.id, parent: folder.parent}) %}
{% set routeAddLink   = folder.id != 0 and access >= 2 ? '/cms/link/new/' ~ folder.id : false %}
{% set routeDownload  = folder.id != 0 and access >= 2 ? '/cms/fetchFolder.php?folder=' ~ folder.id : false %}
{% set routeUploadZip = folder.id != 0 and (user.isSuperuser or (access >= 2 and conf.enable_teacher_zip_upload)) ? '/cms/zipFile/' ~ folder.id : false %}
{% set routeDelete    = routeLookupIfAuthorized('folder.deleteFolder', {id: folder.id, folder: folder}) %}

{% if folder.hasHomepage %}<li><a class="icon-home"     data-action="folder"   href="/homepage/{{ folder.id }}">Homepage</a></li>{% endif %}
{% if routeModify        %}<li><a class="icon-modify"   data-action="modify"   href="{{ routeModify }}">Modify</a></li>{% endif %}
{% if routePostFile      %}<li><a class="icon-drop-box" data-action="file"     href="{{ routePostFile }}">Post File</a></li>{% endif %}
{% if routeCreate        %}<li><a class="icon-folder"   data-action="folder"   href="{{ routeCreate }}">Add Folder</a></li>{% endif %}
{% if routeAddLink       %}<li><a class="icon-link"     data-action="link"     href="{{ routeAddLink }}">Add Link</a></li>{% endif %}
{% if routeDownload      %}<li><a class="icon-download" data-action="download" href="{{ routeDownload }}" title="{{ folder.name }}">Download</a></li>{% endif %}
{% if routeUploadZip     %}<li><a class="icon-upload"   data-action="zip"      href="{{ routeUploadZip }}">Upload ZIP</a></li>{% endif %}
{% if routeDelete        %}<li><a class="icon-delete"   data-action="delete"   href="{{ routeDelete }}">Delete</a></li>{% endif %}

{% if folder.group.category %}
    <li>

        {#<h5 class="subheader">Access Type</h5>#}
        {% if (access >= 3 or user.isSuperuser) and not folder.inherit %}
            <a class="icon-group-managers" data-action="manage" href="/group/modify/{{ folder.id }}">Manage Group</a>
        {% endif %}

        {% if access > 0 and access < 3 %}
            <a class="icon-logout" data-action="leave" href="/group/joinForm.php?leave={{ folder.id }}">Leave Group</a>
        {% elseif access is null %}
            <a class="icon-group"  data-action="join" href="/group/joinForm.php?join={{ folder.id }}">Join Group</a>
        {% elseif access == 0 and folder.group.moderated %}
            <span>Membership request pending</span>
        {% endif %}
        {# notably, if you are the admin, you can't leave the group #}

    </li>
{% endif %}
