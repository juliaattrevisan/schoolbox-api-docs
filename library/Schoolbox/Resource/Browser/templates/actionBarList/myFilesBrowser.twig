{% if folder.id == 0 %}
    <li><a class="icon-folder"   data-action="folder"   href="/cms/myFolder/new/{{ folder.id }}">Add Folder</a></li>
{% else %}
    {% if access >= 2 or user.isSuperuser %}
        <li><a data-action="modify" href="/cms/myFolder/{{ folder.id }}"><sbx-icon name="modify"></sbx-icon>Modify</a></li>
        <li><a class="icon-drop-box" data-action="file"     href="/cms/myFile/new/{{ user.getId() }}/{{ folder.id }}">Post File</a></li>
        <li><a class="icon-folder"   data-action="folder"   href="/cms/myFolder/new/{{ folder.id }}">Add Folder</a></li>
    {% endif %}
    {% if access >= 2 or user.isSuperuser %}
        <li><a class="sbx-icon-only-button no-text"
               data-action="delete"
               href="/cms/myFolderForm.php?ajax=1&delete={{ folder.id }}"
               title="Delete folder"
               aria-label="Delete folder">
            <sbx-icon name="delete"></sbx-icon>
            Delete
        </a></li>
    {% endif %}
{% endif %}
