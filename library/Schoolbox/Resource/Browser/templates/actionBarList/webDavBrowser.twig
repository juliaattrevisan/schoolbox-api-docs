{% if folder.id == 0 %}
    <li><a class="icon-folder"   data-action="folder"   href="/cms/category/new/{{ folder.id }}">Add Folder</a></li>
{% else %}
    {% if access >= 2 or user.isSuperuser %}
        <li><a class="icon-modify"   data-action="modify"   href="/cms/category/{{ folder.id }}">Modify</a></li>
        <li><a class="icon-drop-box" data-action="file"     href="/cms/file/new/{{ folder.id }}">Post File</a></li>
        <li><a class="icon-folder"   data-action="folder"   href="/cms/category/new/{{ folder.id }}">Add Folder</a></li>
        <li><a class="icon-link"     data-action="link"     href="/cms/link/new/{{ folder.id }}">Add Link</a></li>
        <li><a class="icon-download" data-action="download" href="#">Download</a></li>
    {% endif %}
    {% if access >= 3 or user.isSuperuser %}
        <li><a class="icon-upload"   data-action="multi"    href="/cms/file/multi/{{ folder.id }}">Upload Multiple Files</a></li>
    {% endif %}
    {% if user.isSuperuser or (access >= 2 and conf.enable_teacher_zip_upload) %}
        <li><a class="icon-upload"   data-action="zip"      href="/cms/zipFile/{{ folder.id }}">Upload ZIP</a></li>
    {% endif %}
    {% if access >= 2 or user.isSuperuser %}
        <li><a class="icon-delete"   data-action="delete"   href="#">Delete</a></li>
    {% endif %}
{% endif %}
{% if folder.group.category %}
    <li>

        {#<h5 class="subheader">Access Type</h5>#}
        {% if access >= 3 or user.isSuperuser %}
            <a class="icon-group-managers" data-action="manage" href="/group/modify/{{ folder.id }}">Manage Group</a>
        {% endif %}

        {% if access > 0 and access < 3 %}
            <a class="icon-logout" data-action="leave" href="/group/joinForm.php?leave={{ folder.id }}">Leave Group</a>
        {% elseif access is null %}
            <a class="icon-group"  data-action="join" href="/group/joinForm.php?join={{ folder.id }}">Join Group</a>
        {% elseif access == 0 and folder.group.moderated %}
            <span>Membership request pending</span>
        {% endif %}
        {# notably, if you are the admin, you can't leave the group #}

    </li>
{% endif %}
