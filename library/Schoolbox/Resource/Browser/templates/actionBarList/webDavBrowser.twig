{% if folder.id == 0 %}
    <li><a class="icon-folder"   data-action="folder"   href="/cms/networkFolder/new/{{ folder.id }}">Add Folder</a></li>
{% else %}
    {% if access >= 2 or user.isSuperuser %}
        <li><a class="icon-modify"   data-action="modify"   href="/cms/networkFolder/{{ folder.id }}">Modify</a></li>
        <li><a class="icon-drop-box" data-action="file"     href="/cms/networkFile/new/{{ folder.id }}">Post File</a></li>
        <li><a class="icon-folder"   data-action="folder"   href="/cms/networkFolder/new/{{ folder.id }}">Add Folder</a></li>
        <li><a class="icon-download" data-action="download" href="#">Download</a></li>
    {% endif %}
    {% if access >= 2 or user.isSuperuser %}
        <li><a class="sbx-icon-only-button no-text"
               data-action="delete"
               href="/cms/networkFolderForm.php?ajax=1&delete={{ folder.id }}"
               title="Delete folder"
               aria-label="Delete folder">
            <sbx-icon name="delete"></sbx-icon>
            Delete
        </a></li>
    {% endif %}
{% endif %}
