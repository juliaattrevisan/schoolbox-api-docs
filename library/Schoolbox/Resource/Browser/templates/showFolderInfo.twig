{% import '@resourceBrowser/macro/nodeIcon.twig' as nodeIcon %}

{% if access > 0 or user.isSuperuser %}

    {% set colouring -%}
        style="border-bottom: solid 0.25rem {{ folder.colour }};"
    {%- endset %}

{% if tree|length %}
<ul class="breadcrumb">
    {% for node in tree %}
        <li>
        {%- if node.disabled ?? false -%}
            <a class="disabled" data-selectnode="{{ node.categoryId }}">{{ node.name }}</a>
        {%- else -%}
            <a data-selectnode="{{ node.categoryId }}" href="/resources/{{ node.categoryId }}">{{ node.name }}</a>
        {%- endif -%}
        </li>
    {% endfor %}
</ul>
{% endif %}
{% set hasHomepage = folder.hasHomepage ?? false %}
<div class="row">
    <div class="card small-12 column meta-preview">
        {% if hasHomepage %}
            <a title="View Homepage - {{ folder.name }}" href="/homepage/{{ folder.id }}">
        {% endif %}
        {% if folder.hasCoverImage ?? false %}
            <img class="folder-cover" src="/storage/image.php?hash={{ folder.coverImage.hash }}&size=square64" alt="{{ folder.name }}" {{ colouring }} />
        {% else %}
            <div class="{{ nodeIcon.icon(nodeType) }} size-32" alt="{{ folder.name }}"></div>
        {% endif %}
        {% if hasHomepage %}
            </a>
        {% endif %}
        <h3 title="{{ folder.name }}">
            {% if hasHomepage %}<a title="View Homepage - {{ folder.name }}" href="/homepage/{{ folder.id }}">{% endif %}
                {{ folder.name }}
                {% if hasHomepage %}</a>{% endif %}
            <span class="hint has-tip" data-reveal-id="modal-folder-{{ folder.id }}" title="View folder permissions">?</span>
        </h3>
        {% if folder.group ?? false %}

            {% if folder.codeString and folder.teachers|length > 0 %}
                {% set type = 'class' %}
            {% else %}
                {% set type = 'group' %}
            {% endif %}

            <li class="meta">
                {% if folder.group.private   %}Private {{ type | capitalize }} <span data-tooltip aria-haspopup="true" class="hint has-tip" title="Users cannot see or join this {{ type }} unless added by an admin">?</span>{% endif %}
                {% if folder.group.moderated %}Moderated {{ type | capitalize }} <span data-tooltip aria-haspopup="true" class="hint has-tip" title="Users can join, but only once access is approved by an admin">?</span>{% endif %}
                {% if folder.group.free      %}Open {{ type | capitalize }} <span data-tooltip aria-haspopup="true" class="hint has-tip" title="Can be joined or left by anyone at any time">?</span>{% endif %}
            </li>

        {% elseif folder.codeString is defined and folder.teachers|length > 0 %}
            <p class="meta">Class</p>
        {% else %}
            <p class="meta">Folder</p>
        {% endif %}
    </div>

    <div class="small-12 column">
        {% if access > 1 and folder.id %}
            <script type="text/javascript">
                $(function () {

                    const $attachzone = $('#cms-zone');
                    const $toast = $('#resource-browser-toast');
                    const uploadForm = document.getElementById('uploadForm');
                    let successFileCount = 0;
                    let fileList = [];

                    //can be called either on upload from modal window (as a group of files) or straight drag and drop (as per file)
                    $attachzone.on('success.attachzone', function (event, fileData) {
                        if (fileData.data && fileData.data.length > 0) { //coming from modal window upload
                            const successfullyUploadedFiles = fileData.data.filter((file) => file.status !== 'error'); //don't add in files that have failed...
                            if (successfullyUploadedFiles.length > 0) { //only if there's files to add
                                addFilesFromModalWindowUpload(successfullyUploadedFiles);
                                updateFileTree();
                            }
                        } else if (fileData.meta) { //just straight drag and drop
                            addFileFromDragAndDrop(fileData);
                            successFileCount++;
                            checkSuccessFileCount();
                        }
                    });

                    //ensure when a file fails the check to update the file tree also takes splace
                    $attachzone.on('error.attachzone', function (event, fileData) {
                        checkSuccessFileCount();
                    });

                    //files have been uploaded from the modal window
                    function addFilesFromModalWindowUpload (files) {
                        files.forEach(function (file) {
                            addFile(file.hash, file.title);
                        });
                    }

                    //files been uploaded from straight drag and drop
                    function addFileFromDragAndDrop (file) {
                        addFile(file.hash, file.meta.name);
                    }

                    //when the count matches those in the dropzone, update the file tree
                    function checkSuccessFileCount () {
                        if (successFileCount === $attachzone.data('plugin_resourceAttach').dropzone.files.length) {
                            updateFileTree();
                        }
                    }

                    //for displaying in the file tree
                    function addFile (hash, name) {
                        fileList.push({
                            name: 'attachment[]',
                            value: hash + ':' + name
                        });
                    }

                    //when a file(s) been uploaded through the Drop Zone, update the file tree to reflect the change
                    function updateFileTree () {
                        $toast.toastActivate( { text: 'Updating resources...' } );
                        $.ajax(getAjaxParams())
                            .done(function (data) {
                                let nFilesAdded = addNewFilesToTree(data);
                                clearDropZone();
                                $toast.toastTimeout( { text: nFilesAdded + ' file(s) added to resources', css: 'success', duration: 5000 } );
                            })
                            .fail(function () {
                                $toast.toastTimeout( { text: 'Unable to update resources', css: 'error' } );
                            });
                    }

                    //to update the file tree
                    function getAjaxParams () {
                       return {
                            url: uploadForm.action,
                            method: uploadForm.method,
                            data: fileList,
                            dataType: 'json'
                        };
                    }

                    // The response contains all items in the folder.
                    // Add any new ones.
                    function addNewFilesToTree (data) {
                        let jstree = $('#tree').jstree(true);
                        let nFilesAdded = 0;
                        data.forEach(function (item) {
                            var existingNode = jstree.get_node(item.id);
                            if (!existingNode) {
                                jstree.create_node(item.parent, item);
                                ++nFilesAdded;
                            }
                        });

                        return nFilesAdded;
                    }

                    // Then remove all the files just uploaded
                    function clearDropZone (data) {
                        $attachzone.data('plugin_resourceAttach').dropzone.removeAllFiles();
                        var azList = uploadForm.querySelector('.az-list');
                        while(azList.firstChild) {
                            azList.removeChild(azList.firstChild);
                        }
                        successFileCount = 0;
                        fileList = [];
                    }

                });
            </script>
            <form id="uploadForm" action="{{ routeLookup(namespace ~ '.postFiles', {folderId: folder.id}) }}" method="post">
                {% include 'sub/attachzone.twig' with { attachzone: attachzone } %}
            </form>
        {% endif %}
        {% set actionBarList %}
            {# Actions differ by namespace #}
            {% if namespace == 'myFilesBrowser' %}
                {% include '@resourceBrowser/actionBarList/myFilesBrowser.twig' %}
            {% elseif namespace == 'webDavBrowser' %}
                {% include '@resourceBrowser/actionBarList/webDavBrowser.twig' %}
            {% else %}
                {% include '@resourceBrowser/actionBarList/resourceBrowser.twig' %}
            {% endif %}
        {% endset %}

        {% include '@resourceBrowser/actionBar.twig' with { id: 'folder-actions', list: actionBarList, sizing: { small: 1, medium: 2, large: 2, xlarge: 4, xxlarge: 4 } } %}

    <div class="reveal-modal" id="modal-folder-{{ folder.id }}" data-reveal>
        <h1>{{ folder.name }}</h1>
        {% set showGroupAdmin = folder.group is defined and admin is defined %}
        {% set showTeachers = folder.codeString is defined and folder.teachers|length > 0 %}
        {% if showGroupAdmin or showTeachers %}
            <dl class="inline-dl">
            {% if showGroupAdmin %}
                <dt class="small-12 medium-4">Group Administrator</dt>
                <dd class="small-12 medium-8">
                    <div class="card tiny">
                        <a href="/search/user/{{ admin.id }}">
                            {% include 'include/portrait.twig' with {user: admin, description: admin.formatName} only %}
                            <p>{{ admin.formatName }}</p>
                        </a>
                    </div>
                </dd>
            {% endif %}
            {% if showTeachers %}
                <dt class="small-12 medium-4">Teacher{{ folder.teachers.count == 1 ? '' : 's' }}</dt>
                {% for i, teacher in folder.teachers %}
                <dd class="small-12 medium-8{% if i > 0 %} medium-offset-4{% endif %}">
                    <div class="card tiny">
                        <a href="/search/user/{{ teacher.id }}">
                            {% include 'include/portrait.twig' with {user: teacher, description: teacher.formatName} only %}
                            <p>{{ teacher.formatName }}</p>
                        </a>
                    </div>
                </dd>
                {% endfor %}
            {% endif %}
            </dl>
        {% endif %}

        {% if namespace == 'resourceBrowser' %}
            <h3>Permissions</h3>
            {% if folder.getInherit %}
                <dl class="inline-dl">
                    <dd>This folder inherits its permission from the '<a href='/homepage/{{ parent.getId }}'>{{ parent.getName }}</a>' folder.</dd>
                </dl>
            {% else %}
                <dl class="inline-dl">
                    {% if user.role.type == 'staff' %}
                        {% for access in roles %}
                            <dt class="small-8">{{ access.role.name }}</dt>
                            <dd class="small-4">
                                {%- if access.type == 0 %}None{% endif -%}
                                {%- if access.type == 1 %}Read{% endif -%}
                                {%- if access.type == 2 %}Write{% endif -%}
                            </dd>
                        {% endfor %}
                    {% endif %}
                </dl>
            {% endif %}
        {% endif %}
        <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </div>
    </div>
</div>
{% endif %}
