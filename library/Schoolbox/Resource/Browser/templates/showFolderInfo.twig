<ul class="information-list">
{% if access > 0 or user.isSuperuser %}
<li class="center">
    <img class="icon" src="/images/icons/128x128/{{ folder.folderType }}.png" alt="{{ folder.name }}"/>
    <h3 class="meta-title">
        {{ folder.name }}
        {% if folder.codeString %}
            ({{ folder.codeString }})
        {% endif %}
    </h3>
</li>

<li>
    <h4>Actions</h4>
    {% if folder.hasHomepage %}
    <a class="button secondary icon-homepage" data-action="homepage" href="/homepage/{{ folder.id }}">View Homepage</a>
    {% endif %}
    {% if access >= 2 or user.isSuperuser %}
    <a class="button secondary icon-modify"   data-action="modify"   href="/cms/category/{{ folder.id }}">Modify</a>
    <a class="button secondary icon-delete"   data-action="delete"   href="#">Delete</a>
    <a class="button secondary icon-download" data-action="download" href="#">Download</a>
    <a class="button secondary icon-folder"   data-action="folder"   href="/cms/category/new/{{ folder.id }}">Add Folder</a>
    <a class="button secondary icon-drop-box" data-action="file"     href="/cms/file/new/{{ folder.id }}">Post File</a>
    <a class="button secondary icon-link"     data-action="link"     href="/cms/link/new/{{ folder.id }}">Add Link</a>
    {% endif %}
    {% if access >= 3 or user.isSuperuser %}
    <a class="button secondary icon-upload"   data-action="multi"    href="/cms/file/multi/{{ folder.id }}">Upload Multiple Files</a>
    {% endif %}
    {% if user.isSuperuser or (access >= 2 and conf.enable_teacher_zip_upload) %}
    <a class="button secondary icon-upload"   data-action="zip"      href="/cms/zipFile/{{ folder.id }}">Upload ZIP</a>
    {% endif %}
</li>

{% if folder.group.category %}
<li>
    <h4>Group</h4>
    <ul>
        <li>
            <h5 class="subheader">Administrator</h5>
            <img src="/portrait.php?size=square48&userId={{ admin.externalId }}" alt="{{ admin.formatName }}" />
            <h3 class="subheader">
                <a href="/search/user/{{ admin.id }}">{{ admin.formatName }}</a>
            </h3>
            <p class="meta">{{ admin.role.name }}</p>
        </li>
        <li>
            <h5 class="subheader">Access Type</h5>
            <p>
                {% if folder.group.private   %}<span data-tooltip aria-haspopup="true" class="has-tip" title="Users cannot see or join this group unless added by an admin">Private</span>{% endif %}
                {% if folder.group.moderated %}<span data-tooltip aria-haspopup="true" class="has-tip" title="Users can join, but only once access is approved by an admin">Moderated</span>{% endif %}
                {% if folder.group.free      %}<span data-tooltip aria-haspopup="true" class="has-tip" title="Can be joined or left by anyone at any time">Open</span>{% endif %}
            </p>
        {% if access >= 3 or user.isSuperuser %}
            <a class="button secondary icon-group-managers" data-action="manage" href="/group/modify/{{ folder.id }}">Manage Group</a>
        {% endif %}

        {% if access > 0 and access < 3 %}
            <a class="button secondary icon-logout" data-action="leave" href="/group/joinForm.php?leave={{ folder.id }}">Leave Group</a>
        {% elseif access is null %}
            <a class="button secondary icon-group"  data-action="join" href="/group/joinForm.php?join={{ folder.id }}">Join Group</a>
        {% elseif access == 0 and folder.group.moderated %}
            <span>Membership request pending</span>
        {% endif %}
        {# notably, if you are the admin, you can't leave the group #}
        </li>
    </ul>
</li>
{% endif %}
{% if folder.codeString and folder.teachers|length > 0 %}
<li>
    <h4>Class</h4>
    <h5 class="subheader">{{ folder.teachers|length == 1 ? 'Teacher' : 'Teachers' }}</h5>
    <ul>
        {% for teacher in folder.teachers %}
        <li>
            <img src="/portrait.php?size=square48&userId={{ teacher.externalId }}" alt="{{ teacher.formatName }}" />
            <h3 class="subheader">
                <a href="/search/user/{{ teacher.id }}">{{ teacher.formatName }}</a>
            </h3>
            <p class="meta">{{ teacher.role.name }}</p>
        </li>
        {% endfor %}
    </ul>
</li>
{% endif %}

<li>
    <h4>Permissions</h4>
    <ul>
    {% for access in roles %}
    <li>
        <h5 class="subheader">{{ access.role.name }}</h5>
        <p>
            {% if access.type == 0 %}None{% endif %}
            {% if access.type == 1 %}Read{% endif %}
            {% if access.type == 2 %}Write{% endif %}
        </p>
    </li>
    {% endfor %}
    </ul>
</li>
{% else %}
<li>
    <img class="icon" src="/images/core/icons/error-icon.png" alt="No access"/>
    <h3>No access</h3>
</li>
{% endif %}
</ul>
{#{{ dump(admin) | raw }}#}