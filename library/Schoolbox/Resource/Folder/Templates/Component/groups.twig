<script type="text/javascript">
    $(function() {
        {# Leave Group confirmation #}
        $('[data-confirm-leave]').on('click', function (e) {
            e.preventDefault();
            $link = $(this);
            $(this).confirmDialog({
                text: 'Are you sure you wish to leave this group?',
                confirmEvent: function () {
                    window.location.href = $link.attr('href');
                }
            });
        });
    });
</script>
<div class="v-card-list">
{% for group in groupList %}
    <div class="v-card small-12">
        <a href="/homepage/{{ group.id }}">
            <div class="card-class-image" style="background-color:{{ group.colour }}; border-bottom: 10px solid {{ group.colour }};{%  if group.coverImage %} background-image: url('/storage/image.php?hash={{ group.coverImage.hash }}&size=cardImageLarge'); background-size: cover; background-repeat: no-repeat; background-position: center; {% endif %}"></div>
        </a>
        <div class="card-content classes groups actions-small-1">
            <div class="list-item">
                <h3><a href="/homepage/{{ group.id }}" title="{{ group.name }}">{{ group.name }}</a></h3>
            </div>
            {% set isAccessAdmin = userAccess[group.id].admin ?? false %}
            {% set isAccessWrite = userAccess[group.id].write ?? false %}
            {% set isAccessRead = userAccess[group.id].read ?? false %}
            {% if (not (group.group and group.group.private) or isAccessWrite or isAccessAdmin) %}
                <nav>
                    <a href="#" class="icon-more" data-dropdown="class-options{{ group.id }}" aria-expanded="false" title="Actions"></a>
                </nav>
                <ul data-dropdown-content class="f-dropdown" id="class-options{{ group.id }}">
                    {% if isAccessWrite or isAccessAdmin %}
                        <li><a href="{{ routeLookup('folder.getFolderModify', {id: group.id}) }}" class="icon-modify">Modify Folder</a></li>
                        <li><a href="/statistics/homepage/{{ group.id }} " class="icon-report">View Statistics</a></li>
                    {% endif %}
                    {% if isAccessAdmin %}
                        <li><a href="{{ routeLookup('group.getModify'), {folderId: group.id, folder: group} }}" class="icon-group">Manage Group</a></li>
                    {% endif %}
                    {% if (not (group.group and group.group.private) and (isAccessWrite or isAccessRead)) %}
                        <li><a href="/group/joinForm.php?leave={{ group.id }}&return=true" data-confirm-leave class="icon-logout">Leave Group</a></li>
                    {% endif %}
                </ul>
            {% endif %}
        </div>
    </div>
{% endfor %}
</div>
