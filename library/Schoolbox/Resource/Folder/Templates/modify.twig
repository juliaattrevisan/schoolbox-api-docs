{#
    user                          User                - Current session user
    breadcrumbs                   array
    formAction                    string
    folder                        Folder\Model
    parent                        Folder\Model
    templates                     HomepageTemplate[]  - all homepage templates available for selection
    templateId                    int                 - (0 => keep existing, -1 => none)
    roles                         Role[]              - all roles in system
    rolePermissions               int[]               - indexed by role id
    database                      string              - external database type
    curriculumTagging             bool                - Whether the system is configured to enable folder curriculum codes
    userAccess                    int                 - current users permission level to the folder
    deny                          int                 - permission level DENY
    read                          int                 - permission level READ
    write                         int                 - permission level WRITE
    moderate                      int                 - permission level FULL
    coverImageZone                array               - context data for cover image render
    editYearLevelUsage            bool                - should YearLevel usages be editable or read-only
    yearLevelOptions              array[]             - Options suitable for default selectize wrapper
    yearLevelOptions[idx]['id']   int                 - Selectize option identifier
    yearLevelOptions[idx]['name'] string              - Selectize option label
    yearLevelValues               array[]             - Values suitable for default selectize wrapper
    yearLevelValues[idx]['id']    int                 - Selectize value identifier
    yearLevelValues[idx]['name']  string              - Selectize value label
#}
{% if folder.getId is null %}
    {% set action = 'Create' %}
{% else %}
    {% set action = 'Modify' %}
{% endif %}

<link rel="stylesheet" type="text/css" href="/javascript/components/spectrum/spectrum.css" />
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/curriculum/javascript/jquery.curriculumSelector.js"></script>
<script type="text/javascript" src="/javascript/components/schoolbox-masonry.min.js?v={{ config.site_version }}"></script>


<script type="text/javascript">
    $(function() {

        $("[data-colour-picker]").spectrum({
            allowEmpty: true,
            showAlpha: false,
            showInput: true,
            preferredFormat: 'rgb',
            clickoutFiresChange: true,
            showInitial: true,
            change: function(color) {
                $(this).val(color.toRgbString());
            }
        });

        var writePermission = {{ write }};

        $('[data-checkbox-inherit]').change(function(event) {
            if ($(event.target).prop('checked')) {
                $('#permissions').addClass('hide');
                $('#synergetic-codes').addClass('hide');
                $("input[name^='groupNone'], input[name^='groupRead'], input[name^='groupWrite']").removeClass('required');
            } else {
                $('#permissions').removeClass('hide');
                $('#synergetic-codes').removeClass('hide');
                $("input[name^='groupNone'], input[name^='groupRead'], input[name^='groupWrite']").addClass('required');
            }
        });

        var form = $('#folderForm');

        form.alaressValidate({
            rules: {
                'code': {
                    checkCodes: true
                },
            },
            submitHandler: function(form) {
                $(form).find("input[type='submit']").prop('disabled', true);

                var hasDefaultPerms = $("input[name='group[{{ user.getRole().getId() }}]']:checked").val();
                var individualPerms = $('input[name=groupcheck]').is(':checked');
                if ((hasDefaultPerms < writePermission) && !individualPerms && !$('[data-checkbox-inherit]').prop('checked')) {
                    $(form).confirmDialog({
                        text: 'You do not currently have write access to this folder. Do you wish to continue?',
                        confirmEvent: function() {
                            form.submit();
                        },
                        cancelEvent: function() {
                            // Allow user to resubmit the form if they cancel out of the dialog
                            $(form).find("input[type='submit']").prop('disabled', false);
                        }
                    });
                } else {
                    form.submit();
                }
            }
        });

        {% if folder.id %}

            $('[data-interaction="delete"]').click(function(event) {
                event.preventDefault();
                $(this).confirmDialog({
                    text: 'Are you sure you wish to delete this folder?',
                    confirmEvent: function() {
                        // Toast
                        var $toast = $('[data-toast]');
                        $toast.toastActivate({text: 'Deleting folder...'});

                        // Redirect to dashboard after request completes
                        $.ajax({
                                url: '/resource/folder/{{ folder.id }}',
                                type: 'DELETE',
                            })
                            .done(function() {
                                window.setTimeout(function() {
                                    $toast.toastTimeout({text: 'Folder deleted', duration: 3000, css: 'success'});
                                }, 1000);
                                window.location = '/';
                            })
                            .fail(function() {
                                $toast.toastTimeout({text: 'Folder cannot be deleted', css: 'alert'});
                            });
                    }
                });
            });

            $('[data-reset-homepage-content]').click(function(event) {
                event.preventDefault();

                var element = $(this);
                $(this).confirmDialog({
                    format: 'html',
                    text: "Are you sure you wish to delete all content from this homepage? This includes:" +
                        "<ul>" +
                        "<li>Blogs</li>" +
                        "<li>Calendar Events</li>" +
                        "<li>News</li>" +
                        "<li>Chats</li>" +
                        "<li>Dropbox</li>" +
                        "<li>Files</li>" +
                        "<li>Forums</li>" +
                        "<li>Polls</li>" +
                        "<li>{{ locale.dueWork.proper }}</li>" +
                        "<li>Surveys</li>" +
                        "<li>Quizzes</li>" +
                        "<li>TextBoxes</li>" +
                        "<li>Wikis</li>" +
                        "<li>Social Stream Posts</li>" +
                        "</ul>",
                    confirmEvent: function() {
                        $.post('{{routeLookup('folder.postFolderReset', {id: folder.id}) }}').done(function() {
                            window.location.href = '/homepage/{{ folder.getId }}';
                        });
                    }
                });
            });

        {% endif %}

        {% if folder.id %}
            $('[data-template]').change(function(event) {
                if ($('[data-template]').val() != 0) {
                    $('[data-template-warning]').removeClass('hide');
                } else {
                    $('[data-template-warning]').addClass('hide');
                }
            });
        {% endif %}

        // If the folder is inheriting permissions need to remove the required attribute from group fields
        if ($('[data-checkbox-inherit]').prop('checked')) {
            $("input[name^='group']").removeClass('required');
        }


        $.validator.addMethod('checkCodes', function(value, element) {
            var allCodes = $(element).val();
            var explodeCodes = allCodes.split(',');
            var shortEnough = true;

            explodeCodes.forEach(function(code){
                if($.trim(code).length > 20) {
                    shortEnough = false;
                }
            });

            return shortEnough;

        }, 'Class codes may not exceed 20 characters.');

        {#
            Warn user that permission recursion will delete role/group/class permissions.
            Only superusers can recurse permission changes, and its only relevant on modification
        #}
        {% if user.isSuperuser and action == 'Modify' %}
        $("#recursive-permissions, #inherit").change(function() {
            if ($("#recursive-permissions").prop("checked") && $("#inherit").prop("checked")) {
                $("[data-alert-permissions]").removeClass("hide");
            } else {
                $("[data-alert-permissions]").addClass("hide");
            }
        });
        {% endif %}

        {# YearLevel selectize. Populated syncronously with all YearLevels known #}
        {% if editYearLevelUsage %}
        $('#yearLevels').selectizeSelector({
            multiple: true,
            value: {{ yearLevelValues|json_encode|raw }},
            selectize: {
                load: null,
                options: {{ yearLevelOptions|json_encode|raw }},
                hideSelected: true
            }
        });
        {% endif %}

    });
</script>

{# Breadcrumbs #}

<ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
        <li {% if loop.last %}class="active"{% endif %}><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
</ul>

<div class="row actions-small-1">
    <div class="list-item small-12 columns">
        <h1>{{ action }} Folder</h1>
    </div>

    {# The jelly-tot is only really relevant if we are modfying a folder #}
    {% if action == 'Modify' %}
        <nav>
            <a href="#" class="icon-more" data-dropdown="folder-options" title="Actions"></a>
        </nav>

        <ul class="f-dropdown" data-dropdown-content id="folder-options">

            {# Only show 'Modify Group' in the jelly-tot if we are actually editing a group #}
            {% if folder.isGroup and userAccess == moderate %}
                <li><a class="icon-group" href="/group/modify/{{ folder.getId }}" title="Manage individual user access to this folder">Modify Group</a></li>
            {% endif %}

            <li><a class="icon-delete" data-interaction="delete">Delete Folder</a></li>
            <li><a class="icon-refresh" data-reset-homepage-content>Reset Content</a>
        </ul>
    {% endif %}

</div>

<div class="row">
    <div class="list-item small-12 island">
        <form action="{{ formAction }}" method="post" id="folderForm" class="top">
            <input type="hidden" id="parent" name="parent" value="{{ parent.getId }}" />

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="name" class="required">Folder Name</label>
                        <input type="text" id="name" name="name" maxlength="100" size="40" value="{{ folder.getName }}" required />
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>
                            Homepage Template
                            <span data-tooltip class="hint has-tip tip-top" data-width="200" title="If you would like a homepage associated with this folder select a basic layout to get started with">?</span>
                            <select data-template name="template">

                                {# Display homepage templates with special case for 'No Homepage' #}

                                {% for template in templates %}
                                    <option value="{{ template.getId }}" {% if template.getId == templateId %}selected{% endif %}>{{ template.getName }}</option>
                                {% endfor %}

                            </select>
                        </label>
                        <div class="alert-box warning hide" data-template-warning>
                            Warning! Changing the folders template will remove all existing components and content.
                        </div>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>
                            Colour
                            <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Select a colour that will be used for this folder">?</span>
                            <div class="row collapse">
                                <div class="small-12 columns">
                                    <input type="text" value="{{ folder.colour.asRgb }}" id="colour" name="colour" data-colour-picker />
                                </div>
                            </div>
                        </label>
                    </div>
                    <div class="small-12 columns">
                    <label>
                            Cover Image
                            <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Select a cover image for this folder">?</span>
                        </label>
                        {% include 'sub/attachzone.twig' with { attachzone: coverImageZone } %}


                    </div>
                </fieldset>

                <fieldset class="content">
                    {% if not user.isSuperuser and folder.getCodeString %}
                        {% set inheritTitle = 'Only superusers may alter permission inheritance for folders with Class Codes' %}
                    {% else %}
                        {% set inheritTitle = 'Select user roles which have access to this folder' %}
                    {% endif %}

                    <div class="small-12 columns">
                        <label>Access Permissions
                            <span data-tooltip class="hint has-tip tip-top" data-width="200" title="{{ inheritTitle }}">?</span>
                        </label>
                    </div>

                    {# Hide inheritance controls if looking at a root folder #}
                    {% if parent.getId != 0 %}
                        {% set disabled = (not user.isSuperuser and folder.getCodeString) ? ' disabled' : '' %}
                        <div class="small-12 columns">
                            <input data-checkbox-inherit type="checkbox" id="inherit" name="inherit" value="1" {% if folder.getInherit %}checked{% endif %}{{ disabled }}/>
                            <label for="inherit" class="checkbox-label">Inherit permissions from '<a href="/homepage/{{ parent.getId }}">{{ parent.getName }}</a>' folder</label>
                        </div>
                    {% endif %}

                    {# Only superusers can recurse permission changes, and its only relevant on modification #}
                    {% if user.isSuperuser and action == 'Modify' %}
                        <div class="small-12 large-10 columns">
                            <input type="checkbox" id="recursive-permissions" name="recursive-permissions" value="1" />
                            <label for="recursive-permissions" class="checkbox-label">Apply these permissions to all subfolders</label>
                        </div>

                        <div class="small-12 columns">
                            <div data-alert-permissions="" class="alert-box warning hide">
                                Warning! This will remove all role permissions, group memberships, and class codes from all subfolders.
                            </div>
                        </div>
                    {% endif %}

                </fieldset>

                {# Permissions block is only visible if not inheriting permissions under normal circumstance
                   However, allow perms to be set if this folder is in the root, so they can actually set perms #}
                <fieldset id="permissions" class="content {% if folder.getInherit and parent.getId != 0 %}hide{% endif %}">
                    <table class="scrollable">
                        <thead>
                        <tr>
                            <th>Role</th>
                            <th>None</th>
                            <th>Read</th>
                            <th>Write</th>
                        </tr>
                        </thead>
                        <tbody>
                            {% for role in roles %}
                                <tr>
                                    <td>{{ role.getName }}</td>
                                    <td>
                                        <input type="radio" class="no_permission required" id="groupNone{{ role.getId }}" name="group[{{ role.getId }}]" value="0" {% if rolePermissions[role.getId] == deny %}checked{% endif %} />
                                        <label class="radio-label" for="groupNone{{ role.getId }}"></label>
                                    </td>
                                    <td>
                                        <input type="radio" name="group[{{ role.getId }}]" id="groupRead{{ role.getId }}" value="1" {% if rolePermissions[role.getId] == read %}checked{% endif %} />
                                        <label class="radio-label" for="groupRead{{ role.getId }}"></label>
                                    </td>
                                    <td>
                                        <input type="radio" name="group[{{ role.getId }}]" id="groupWrite{{ role.getId }}" value="2" {% if rolePermissions[role.getId] == write %}checked{% endif %} />
                                        <label class="radio-label" for="groupWrite{{ role.getId }}"></label>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>

                    {% if not folder.isGroup %}
                        <div class="small-12 columns">
                            <label for="groupcheck">
                                Create Group
                                <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Manage individual user access to this folder. You will automatically be assigned administration rights">?</span>
                            </label>
                            <div class="switch">
                                <input type="checkbox" id="groupcheck" name="groupcheck" value="1" />
                                <label for="groupcheck">
                                    <span>Yes</span>
                                    <span>No</span>
                                </label>
                            </div>
                        </div>
                    {% endif %}
                </fieldset>

                <fieldset id="synergetic-codes" class="content {{ folder.getInherit() ? 'hide' : '' }}">
                    <div class="small-12 columns">

                        {# Only superusers can change subject codes#}
                        {% if user.isSuperuser %}
                            {% set codeTitle = 'If you want this folder to be a ' ~ locale.subject ~ ' enter its code here. You may enter multiple codes by separating them with a comma' %}
                        {% else %}
                            {% set codeTitle = 'Only superusers may administer ' ~ locale.subject.proper  ~ ' Codes' %}
                        {% endif %}

                        <label>
                            {{ database }} {{ locale.subject.proper }} Codes
                            <span data-tooltip class="hint has-tip tip-top" data-width="200" title="{{ codeTitle }}">?</span>
                            <input type="text" name="code" size="40" value="{{ folder.getCodeString }}"{% if not user.isSuperuser %} disabled{% endif %}/>
                        </label>
                    </div>
                </fieldset>

                {# If curriculum tagging enabled, render yearLevel + curriculumCodes half-width, else full-width #}
                {% set columnWidth = curriculumTagging ? 6 : 12 %}
                <fieldset class="content">
                    <div class="small-12 large-{{ columnWidth }} columns">
                        <div>
                            {% if editYearLevelUsage %}
                                {% set toolTipTitle = 'Select the year levels to associate with this folder' %}
                            {% else %}
                                {% set toolTipTitle = "Only superusers may manage a folder's year level association" %}
                            {% endif %}
                            <label>
                                Year Levels
                                <span data-tooltip class="hint has-tip tip-top" data-width="200" title="{{ toolTipTitle }}">?</span>
                            </label>

                            {% if editYearLevelUsage %}
                                <input title="Year Levels" id="yearLevels" name="yearLevelIds" placeholder="Select year Levels" tabindex="-1" class="selectized" type="text">
                            {% else %}
                                {% set yearLevels = [] %}
                                {% for yearLevel in folder.yearLevels %}
                                    {% set yearLevels = yearLevels|merge([yearLevel.name]) %}
                                {% endfor %}
                                <input title="Year Level usages" value="{{ yearLevels|join(', ') }}" readonly="readonly">
                            {% endif %}
                        </div>

                        {% if editYearLevelUsage and action == 'Modify' %}
                            <div>
                                <input type="checkbox" id="recursive-year-levels" name="recursive-year-levels" value="1" />
                                <label for="recursive-year-levels" class="checkbox-label">Copy these year level associations to all subfolders</label>
                            </div>
                        {% endif %}

                    </div>

                    {% if curriculumTagging %}
                        {# This ID is required so curriculum empty state link navigates to this element  #}
                        <div id="curriculum-codes" class="small-12 large-6 columns">
                            <label>
                                Curriculum Codes
                                <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Link this folder with a corresponding curriculum area, you can link multiple curriculum areas to this folder">?</span>
                            </label>
                            <div class="input-group">
                                {%
                                    include 'sub/curriculumCodeSelector.twig' with
                                    {
                                        'codeList' : folder.getCurriculumNodes,
                                        'renderButton' : true
                                    }
                                %}
                            </div>
                        </div>
                    {% endif %}

                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 column">
                    <input type="submit" value="{{ action }} Folder" />
                </div>
            </div>
        </form>
    </div>
</div>
<div id='toaster' class="toast" data-toast></div>
