{##
 # Index of folder usages
 #
 # @param array $usages  A list of textboxes in this homepage and their usage information
 #}
<script type="text/javascript">
    $(function() {
        $('[data-collapser]').collapsable();

        $('#container').on('click', 'a[data-delete]', function(event) {
            event.preventDefault();

            let element = $(this);

            element.confirmDialog({
                text: 'Are you sure you want to delete this item?',
                confirmLabel: 'Delete',
                confirmEvent: function() {
                    $.ajax({
                        url: element.attr('data-delete'),
                        type: 'DELETE',
                        success: function(response) {
                            location.reload();
                        }
                    });
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>Manage Text Boxes on {{ folder.title }}</h1>

        <div id="textbox-list">
            <textbox-list textbox-usage-endpoint="{{ routeLookupIfAuthorized('textbox.getUsageForFolder', {folderId: folder.id, folder: folder}) }}"
                          post-changes-endpoint="{{ routeLookupIfAuthorized('textbox.postRename', {folderId: folder.id, folder: folder}) }}"
                          :folder-id="Number('{{ folder.id }}')"
            >
            </textbox-list>
        </div>

        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/textboxList.js?v={{ config.site_version }}"></script>
    </div>
</div>
