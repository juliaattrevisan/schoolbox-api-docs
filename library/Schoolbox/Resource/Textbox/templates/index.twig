{##
 # Index of folder usages
 #
 # @param array $usages  A list of textboxes in this homepage and their usage information
 #}
<script type="text/javascript">
    $(function() {
        $('[data-collapser]').collapsable();

        $('#container').on('click', 'a[data-delete]', function(event) {
            event.preventDefault();

            let element = $(this);

            element.confirmDialog({
                text: 'Are you sure you want to delete this item?',
                confirmEvent: function() {
                    $.ajax({
                        url: element.attr('data-delete'),
                        type: 'DELETE',
                        success: function(response) {
                            location.reload();
                        }
                    });
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="small-12 island">
        <h1>Manage Textboxes</h1>

        {% if usages|length %}
        <script type="text/javascript">
            $(function() {
                $('#textboxForm').alaressValidate();

                $('#textboxForm input[type=text]').each(function(index, element) {
                    $(element).rules('add', {
                        requiredNotBlank: true
                    });
                });
            })
        </script>

        <form id='textboxForm' method="post" action="{{ routeLookupIfAuthorized('textbox.postRename', {folderId: folder.id, folder: folder}) }}">
            <section>
                <ul class="information-list unsortable expandable-card">
                    {% for usage in usages %}
                        <li>
                            <div class="actions-small-2">
                                <div class="expander" data-collapser="collapser-{{ usage.textbox.id }}"></div>
                                <div class="list-item">
                                    <div class="small-12 column">
                                        <label>
                                            <span class="hide-for-medium-up">Textbox</span>
                                            <input type="text" name="textbox[{{ usage.textbox.id }}]" value="{{ usage.textbox.heading }}" placeholder="Previously: {{ usage.textbox.heading }}">
                                        </label>

                                        {% if usage.folders|length %}

                                            {# If this folder is the only usage of it, don't display the meta
                                             # You'd be stating the obvious
                                             #}
                                            {% if not (usage.folders|length == 1 and usage.folders[folder.id] is not null) %}
                                            <p class="meta">
                                                Folder usages:
                                                {% for folderUsage in usage.folders %}
                                                    <a href="/homepage/{{ folderUsage.folder.id }}">{{ folderUsage.folder.name }} ({{ folderUsage.numUsages }})</a>{% if not loop.last %}, {% endif %}
                                                {% endfor %}
                                            </p>
                                            {% endif %}
                                        {% endif %}

                                        {% if usage.dashboards|length %}
                                        <p class="meta">
                                            Dashboard usages:
                                            {% for dashboardUsage in usage.dashboards %}
                                                {{ dashboardUsage.name }} ({{ dashboardUsage.numUsages }}){% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        </p>
                                        {% endif %}
                                    </div>
                                </div>
                                <nav>
                                    <a class="icon-delete" data-delete="{{ routeLookupIfAuthorized('textbox.deleteTextbox', {id: usage.textbox.id, textbox: usage.textbox, folder: usage.textbox.category}) }}"></a>
                                </nav>
                            </div>

                            <div class="hide" data-collapse-state="collapsed" data-collapsable="collapser-{{ usage.textbox.id }}">
                                <article class="content">
                                    {{ usage.textbox.body|purify }}
                                </article>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>

            <input type="submit" value="Save" />
        </form>
        {% else %}
            <div class="empty-state">
                <i class="icon-textbox"></i>
                <p>There aren't any textboxes associated with this folder.</p>
            </div>

        {% endif %}
    </div>
</div>
