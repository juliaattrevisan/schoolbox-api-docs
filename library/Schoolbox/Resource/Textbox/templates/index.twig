{##
 # Index of folder usages
 #
 # @param array $usages  A list of textboxes in this homepage and their usage information
 #}
<script type="text/javascript">
    $(function() {
        $('[data-collapser]').collapsable();

        $('#container').on('click', 'a[data-delete]', function(event) {
            event.preventDefault();

            let element = $(this);

            element.confirmDialog({
                text: 'Are you sure you want to delete this item?',
                confirmEvent: function() {
                    $.ajax({
                        url: element.attr('data-delete'),
                        type: 'DELETE',
                        success: function(response) {
                            location.reload();
                        }
                    });
                }
            });
        });
    });
</script>
<div class="row">
    <div class="small-12 island">
        <h1>Textbox Usages for {{ folder.name }}</h1>
        <div class="alert-box">You can mass-rename your textboxes here.</div>

        <form>
            <section>
                <ul class="information-list expandable-card">
                    {% for usage in usages %}
                        <li>
                            <div class="actions-small-2">
                                <div class="expander" data-collapser="collapser-{{ usage.textbox.id }}"></div>
                                <div class="list-item">
                                    <div class="small-12 column">
                                        <label>
                                            <span class="hide-for-medium-up">Textbox</span>
                                            <input type="text" name="textbox[{{ usage.textbox.id }}]" value="{{ usage.textbox.heading }}" placeholder="Previously: {{ usage.textbox.heading }}">
                                        </label>

                                        <p class="meta">
                                            Folder usages:
                                            {% for folderUsage in usage.folders %}
                                                <a href="/homepage/{{ folderUsage.folder.id }}">{{ folderUsage.folder.name }} ({{ folderUsage.numUsages }})</a>{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        </p>
                                    </div>
                                </div>
                                <nav>
                                    <a class="icon-delete" data-delete="{{ routeLookupIfAuthorized('textbox.deleteTextbox', {id: usage.textbox.id, textbox: usage.textbox, folder: usage.textbox.category}) }}"></a>
                                </nav>
                            </div>

                            <div class="hide" data-collapse-state="collapsed" data-collapsable="collapser-{{ usage.textbox.id }}">
                                <article class="content">
                                    {{ usage.textbox.body|purify }}
                                </article>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </form>
    </div>
</div>




