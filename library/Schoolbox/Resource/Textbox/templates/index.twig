{##
 # Index of folder usages
 #
 # @param \Schoolbox\Resource\Folder\Model $folder         The folder whose textboxes are shown
 # @param array                            $allBreadcrumbs Breadcrumbs to show on this page
 #}
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbsArray(allBreadcrumbs) }}

<div class="row">
    <div class="button-action small-12 columns">
        <h1>Manage Text Boxes on {{ folder.title }}</h1>
        <a href="#" class="icon-add button" title="Create Text Box" data-action="addTextbox">Create Text Box</a>
    </div>

    <div class="small-12 island">
        <div id="textbox-list">
            <textbox-list textbox-usage-endpoint="{{ routeLookupIfAuthorized('textbox.getUsageForFolder', {folderId: folder.id, folder: folder}) }}"
                          create-textbox-endpoint="{{ routeLookupIfAuthorized('textbox.createTextboxInFolder', {folderId: folder.id, folder: folder}) }}"
                          post-changes-endpoint="{{ routeLookupIfAuthorized('textbox.postRename', {folderId: folder.id, folder: folder}) }}"
                          return-url="{{ RETURN_URL.previous.decoded ?? ('/homepage/' ~ folder.id) }}"
                          :folder-id="Number('{{ folder.id }}')"
            >
            </textbox-list>
        </div>

        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/textboxList.js?v={{ config.site_version }}"></script>
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
        <script type="text/javascript">
            $(function () {
                $('a[data-action="addTextbox"]').click(function (event) {
                    event.preventDefault();
                    window.dispatchEvent(new CustomEvent('textbox-list-add'));
                })
            });
        </script>
    </div>
</div>
