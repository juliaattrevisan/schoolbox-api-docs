{##
 # component: \Schoolbox\Resource\Textbox\Component\Homepage\Controller this component
 # textbox:   \Schoolbox\Resource\Textbox\Model|null                    this component's textbox, if any
 # context:   \Schoolbox\Resource\Folder\Model|null                     this component's context, if any
 # returnUrl: string                                                    encoded return url
 # writable:  bool                                                      Is this component's content writable?
 # editorTemplates: \Schoolbox\Editor\Templates\Model[]                 List of editor templates available for this component
 #}

{% if writable %}
    {% include '@textbox/component/homepage/writable.twig' with {
        component: component,
        textbox:   textbox,
        context:   context,
        returnUrl: returnUrl,
        editorTemplates: editorTemplates
    } only %}
{% else %}
    {% include '@textbox/component/homepage/readonly.twig' with {
        component: component,
        textbox:   textbox,
        context:   context,
    } only %}
{% endif %}
