{##
 # component: \Schoolbox\Resource\Textbox\Component\Homepage\Controller this component
 # textbox:   \Schoolbox\Resource\Textbox\Model|null                    this component's textbox, if any
 # context:   \Schoolbox\Resource\Folder\Model|null                     this component's context, if any
 #}

{% set textboxExists = textbox is not null and textbox.id is not null %}

{% if textboxExists %}
    <div class="content">
        <article id="textBoxBody{{ textbox.id }}" contenteditable="true">{{ textbox.body | purify }}</article>
    </div>

    <div class="component-action">
        <section>
            <button data-action="modify" data-processing-text="Modifying">Modify</button>
            <button data-action="save"
                    data-form-method="put"
                    data-form-action="{{ routeLookupIfAuthorized('textbox.updateTextbox', {id: textbox.id, textbox: textbox, folder: context}) }}"
                    data-processing-text="Saving..."
                    class="hide">Save</button>
            <button data-action="cancel" class="hide">Cancel</button>
            <button data-action="delete"
                    data-form-method="delete"
                    data-form-action="{{ routeLookupIfAuthorized('textbox.deleteTextbox', {id: textbox.id, textbox: textbox, folder: context}) }}">Delete</button>
        </section>
    </div>
{% else %}
    <div class="empty-state">
        <i class="icon-textbox"></i>

        {% if component.config.emptyStateMessage ?? '' %}
            <p>{{ component.config.emptyStateMessage }}</p>
            <p><a href="#" data-reveal-id="addTextboxModal-{{ component.instance.id }}">Add content to this text box</a>.</p>
        {% else %}
            <p>
                <a href="#" data-reveal-id="addTextboxModal-{{ component.instance.id }}">Add text and multimedia, or embed content</a>
                to display in this component.
            </p>
        {% endif %}
    </div>

    <div id="addTextboxModal-{{ component.instance.id }}" class="reveal-modal" data-reveal aria-labelledby="addTextboxModal-{{ component.instance.id }}-title" aria-hidden="true" role="dialog">
        <form method="post" action="{{ routeLookup('textbox.createTextboxInFolder', {folder: context, folderId: context.id}) }}" id="addTextboxModal-{{ component.instance.id }}-form">
            <section>
                <h3 id="addTextboxModal-{{ component.instance.id }}-title">Add Textbox</h3>
                <label class="required" for="addTextboxModal-{{ component.instance.id }}-form-heading">Title</label>
                <input id="addTextboxModal-{{ component.instance.id }}-form-heading" type="text" name="heading" value="" required maxlength="100" />
                <input type="hidden" name="body" value="" />
                <input type="submit" value="Create Textbox">
            </section>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </form>
    </div>
{% endif %}

{% autoescape 'js' %}
    <script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
    <script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>
    <script type="text/javascript">
        $(function() {
            var component       = $('#component{{ component.instance.id }}'),
                modifyButton    = component.find('[data-action="modify"]'),
                deleteButton    = component.find('[data-action="delete"]'),
                saveButton      = component.find('[data-action="save"]'),
                cancelButton    = component.find('[data-action="cancel"]'),
                configForm      = component.find('[data-component-panel="settings"] form'),
                addTextboxModal = $('#addTextboxModal-{{ component.instance.id }}'),
                addTextboxForm  = $('#addTextboxModal-{{ component.instance.id }}-form'),
                editor          = null,
                editorImage     = null;


            // Switch off auto-setup of inline editors
            CKEDITOR.disableAutoInline = true;


            // States:
            // * Empty -> Clean
            // * Clean -> Dirty, Saving, Deleting
            // * Dirty -> Clean, Saving, Deleting
            // * Saving -> Clean (success), Dirty (failure)
            // * Deleting -> Empty (success), Clean/Dirty (failure)


            // Dialog for modifying a textbox
            modifyButton.click(function (event) {
                event.preventDefault();
                if (CKEDITOR.instances['textBoxBody{{ textbox.id }}']) {
                    CKEDITOR.instances['textBoxBody{{ textbox.id }}'].focus();
                } else {
                    editor = CKEDITOR.inline(
                        'textBoxBody{{ textbox.id }}',
                        $.alaressEditorConfig({
                            file_browser_category_id: Number("{{ context.id }}")
                        })
                    );
                    editor.on('instanceReady', function (evt) {
                        // Store the current state
                        editorImage = new CKEDITOR.plugins.undo.Image(evt.editor);
                        evt.editor.focus();
                    });
                    editor.on('focus', function () {
                        // Switch state of modify button
                        modifyButton
                            .data('text', modifyButton.text())
                            .text(modifyButton.attr('data-processing-text'))
                            .prop('disabled', true)
                            .addClass('disabled');
                        // And cancel button
                        cancelButton
                            .removeClass('hide');
                        // And save button
                        saveButton
                            .removeClass('hide');
                        // And delete button
                        deleteButton
                            .addClass('hide');
                    });
                    editor.on('blur', function () {
                        // Revert state of modify button
                        modifyButton
                            .text(modifyButton.data('text'))
                            .prop('disabled', false)
                            .removeClass('disabled');
                        // And cancel button
                        cancelButton
                            .addClass('hide');
                        // And save button
                        saveButton
                            .addClass('hide');
                        // And delete button
                        deleteButton
                            .removeClass('hide');
                    });
                }
            });


            // Action for save button
            saveButton.click(function (event) {
                // Toast
                event.preventDefault();
                $.ajax(
                    saveButton.attr('data-form-action'),
                    {
                        method: saveButton.attr('data-form-method'),
                        data:   JSON.stringify({
                            // TODO pass this via form input as well?
                            heading: "{{ textbox.heading }}",
                            body:    editor.getData(),
                        }),
                        dataType: 'json',
                        contentType: 'application/json',
                    }
                );
            });


            // Action for cancel button
            cancelButton.click(function (event) {
                event.preventDefault();
                // editor.undoManager.restoreImage(editorImage);
            });


            // Dialog for deleting a textbox
            deleteButton.click(function (event) {
                event.preventDefault();
                deleteButton.confirmDialog({
                    text: 'Are you sure you want to delete this content permanently?',
                    confirmEvent: function () {
                        $.ajax(
                            deleteButton.attr('data-form-action'),
                            { method: deleteButton.attr('data-form-method'), }
                        ).done(function () {
                            // Once done: reload component
                            configForm
                                .find('select[name="textbox"]')
                                .val(0);
                            configForm.submit();
                        });
                    }
                });
            });


            // Dialog for creation of a textbox
            addTextboxForm.alaressValidate({
                submitHandler: function (form) {
                    // Disable submit actions
                    // TODO split alaressValidate's submit handler into beforeSubmit (disable inputs) and submit actions
                    var $submit    = $(form).find('input[type=submit]'),
                        submitText = $submit.val(),
                        formData   = new FormData(form);

                    $submit.prop("disabled", true).text('Working...');

                    // And submit form via AJAX
                    $.ajax(
                        form.action,
                        {
                            method: form.method,
                            data:   JSON.stringify({
                                heading: formData.get('heading'),
                                body:    formData.get('body'),
                            }),
                            dataType: 'json',
                            contentType: 'application/json',
                        }
                    ).done(function (response) {
                        // Reload the component, close the dialog
                        addTextboxModal.foundation('reveal', 'close');

                        // Set the component's configuration.
                        // (Cheat by setting the component's textbox to the just created one, and submit its form)
                        configForm
                            .find('select[name="textbox"]')
                            .append($('<option>')
                                .attr('value', response.id)
                                .text(response.heading)
                            )
                            .val(response.id);
                        configForm.submit();
                    }).always(function () {
                        $submit.prop("disabled", false).text(submitText);
                    });
                }
            });
        });
    </script>
{% endautoescape %}
