{##
 # Writable version of homepage textbox component.
 #
 # component: \Schoolbox\Resource\Textbox\Component\Homepage\Controller this component
 # textbox:   \Schoolbox\Resource\Textbox\Model|null                    this component's textbox, if any
 # context:   \Schoolbox\Resource\Folder\Model|null                     this component's context, if any
 #}

{% set textboxExists = textbox is not null and textbox.id is not null %}

{% if textboxExists %}
    <script type="text/javascript">
        $(function () {
            $('#component{{ component.instance.id }} .component-titlebar').attr('id', 'textbox{{ textbox.id }}');
        });
    </script>
    {% if routeLookupIfAuthorized('immersiveReader.getTokenAndSubdomain') %}
        <script src="{{ CDN_PREFIX }}/js/immersive-reader/jquery.immersive-reader.js?v={{ config.site_version }}" type="text/javascript"></script>
        <script type="text/javascript">
            $(function () {
                $('#component{{ component.instance.id }} [data-immersive-reader]').immersiveReader({title: '{{ textbox.heading | escape('js') }}'});
            });
        </script>
        <div class='immersive-reader-button' data-immersive-reader="button"></div>
    {% endif %}
    <div class="content" data-textbox-exists>
        <article data-content
                 data-textbox-heading="{{ textbox.heading }}"
                 id="textBoxBody{{ textbox.id }}">{{ textbox.body | purify }}</article>
    </div>

    <div class="component-action">
        <section>

            {# This has a button-like styling, but isn't actually a button #}
            <button data-role="dirty-indicator" class="hide" disabled>Changes not saved</button>

            {% set manageAllRoute = routeLookupIfAuthorized('textbox.getIndexForFolder', {folderId: textbox.category.id, folder: textbox.category}) %}
            {% if manageAllRoute %}
            <a class='button' href="{{ manageAllRoute }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}">Manage All</a>
            {% endif %}

            <button data-action="save"
                    data-form-method="put"
                    data-form-action="{{ routeLookupIfAuthorized('textbox.updateTextbox', {id: textbox.id, textbox: textbox, folder: textbox.category}) }}"
                    data-processing-text="Saving..."
                    class="hide">Save</button>
            <button data-action="modify" data-processing-text="Modifying">Modify</button>
        </section>
    </div>
{% else %}
    <div class="empty-state">
        <i class="icon-textbox"></i>
        {% if component.config.emptyStateMessage ?? '' %}
            {% set emptyStateLines = component.config.emptyStateMessage|split('\n') %}
            {% for emptyStateLine in emptyStateLines %}
                <p>{{ emptyStateLine }}</p>
            {% endfor %}
            <p><a href="#" data-reveal-id="addTextboxModal-{{ component.instance.id }}">Add content to this text box</a>.</p>
        {% else %}
            <p>
                <a href="#" data-reveal-id="addTextboxModal-{{ component.instance.id }}">Add text and multimedia, or embed content</a>
                to display in this component.
            </p>
        {% endif %}
    </div>

    <div id="addTextboxModal-{{ component.instance.id }}" class="reveal-modal" data-reveal aria-labelledby="addTextboxModal-{{ component.instance.id }}-title" aria-hidden="true" role="dialog">
        {# Create component in alt-source folder context, if there is one #}
        <form method="post" action="{{ routeLookup('textbox.createTextboxInFolder', {folder: textbox.category, folderId: textbox.category.id}) }}" id="addTextboxModal-{{ component.instance.id }}-form">
            <section>
                <h3 id="addTextboxModal-{{ component.instance.id }}-title">Create Text Box</h3>
                <label class="required" for="addTextboxModal-{{ component.instance.id }}-form-heading">Title</label>
                <input id="addTextboxModal-{{ component.instance.id }}-form-heading" type="text" name="heading" value="" required maxlength="100" />
                <input type="hidden" name="body" value="" />
                <input type="submit" value="Create Text Box">
            </section>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </form>
    </div>
{% endif %}

<div id="toast-{{ component.instance.id }}" class="toast"></div>

<script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/textbox/jquery.inlineTextboxEditor.js?v={{ config.site_version }}"></script>
{% autoescape 'js' %}
    <script type="text/javascript">
        $(function() {

            var component             = $('#component{{ component.instance.id }}'),
                content               = component.find('.content'),
                configForm            = component.find('[data-component-panel="settings"] form'),
                dirtyIndicator        = component.find('[data-role="dirty-indicator"]'),
                beforeUnloadListener  = null,
                addTextboxModal       = $('#addTextboxModal-{{ component.instance.id }}'),
                addTextboxForm        = $('#addTextboxModal-{{ component.instance.id }}-form'),
                toast                 = $('#toast-{{ component.instance.id }}'),
                editorInline          = false,
                editorInstanceOptions = $.alaressEditorConfig({
                    // Always start file browser from current folder, instead of the alt source
                    file_browser_category_id: Number("{{ context.id }}"),
                    title:                    '',
                },
            );

            // If using the inline version of the editor:
            // Remove wordcount as it looks awkward
            if (editorInline) {
                if (!editorInstanceOptions.removePlugins) {
                    editorInstanceOptions.removePlugins = 'wordcount';
                } else {
                    editorInstanceOptions.removePlugins += ',wordcount';
                }

                // Restore source dialog plugin
                if (editorInstanceOptions.removeButtons) {
                    editorInstanceOptions.removeButtons = editorInstanceOptions.removeButtons.replace(/sourcedialog/i, '');
                }
            }

            const inlineTextboxEditor = component.inlineTextboxEditor({
                modifyButton:          '[data-action="modify"]',
                deleteButton:          '[data-action="delete"]',
                saveButton:            '[data-action="save"]',
                editorInstance:        '[data-content]',
                editorInstanceOptions: editorInstanceOptions,
                editorInline:          editorInline,
            });


            //to start the Text Box editor automatically after creating a Text Box,
            //previously users had to first select the #modifyButton to start editing
            if ((document.body.hasAttribute('data-new-text-box-id')) && (document.body.getAttribute('data-new-text-box-id') === '{{ component.instance.id }}')) { //check if a new Text Box has been created, and if so enable immediate focus within the relevant component
                inlineTextboxEditor.data('inlineTextboxEditor').onClickModify(); //implement the existing method within #jquery.inlineTextboxEditor.js used by #modifyButton to fire up the editor straight after creation
                document.body.removeAttribute('data-new-text-box-id'); //clear the reference to ensure immediate focus only occurs after initial creation
            }

            // Before creating an editor: restore any placeholders, so that
            // the editor doesn't let you edit the mediaelement player
            component.on('inlineTextboxEditor.preEditorCreate', function () {
                $.fn.schoolboxResource_RestoreAllPlaceholders(component);
            })
            // On create/destroy of editor:
            // add/remove no-pad class to its container, to offset padding
            // Also: put the media players back when the editor is destroyed
            .on('inlineTextboxEditor.editorCreate', function (event, inlineTextboxEditor) {
                content.addClass('no-pad');
                // Add beforeUnload, which will trigger if this is dirty
                beforeUnloadListener = function (event) {
                    if (inlineTextboxEditor.isDirty()) {
                        event.preventDefault();
                        event.stopPropagation();
                        event.returnValue = '';
                        return event.returnValue;
                    }
                };
                window.addEventListener('beforeunload', beforeUnloadListener);
            })
            .on('inlineTextboxEditor.editorDestroy', function () {
                content.removeClass('no-pad');
                window.removeEventListener('beforeunload', beforeUnloadListener);
                $.fn.schoolboxResource_ProxyReplacement(component);
            })
            // Pre/post save/delete: apply toast
            .on('inlineTextboxEditor.preSave', function () {
                toast.toastActivate({text: 'Saving...'});
            })
            .on('inlineTextboxEditor.preDelete', function () {
                toast.toastActivate({text: 'Deleting...'})
            })
            .on('inlineTextboxEditor.save', function () {
                toast.toastTimeout({text: 'Saved', css: 'success'});
            })
            .on('inlineTextboxEditor.delete', function () {
                toast.toastTimeout({text: 'Deleted', css: 'success'});
            })
            .on('inlineTextboxEditor.saveFail', function () {
                toast.toastTimeout({text: 'Could not save textbox', css: 'alert'});
            })
            .on('inlineTextboxEditor.deleteFail', function () {
                toast.toastTimeout({text: 'Could not delete textbox', css: 'alert'});
            })
            // Post-delete: set the textbox to empty and submit config
            .on('inlineTextboxEditor.delete', function () {
                configForm
                    .find('select[name="textbox"]')
                    .val(0);
                configForm.submit();
            })
            .on('inlineTextboxEditor.change inlineTextboxEditor.save', function (event, inlineTextboxEditor) {
                dirtyIndicator.toggleClass('hide', !inlineTextboxEditor.isDirty());
            });

            //when the 'Create Text Box' modal is opened, ensure the Title input field is given immediate focus to allow easier/faster Text Box creation
            $(document).on('opened.fndtn.reveal', '[data-reveal]', function () { //referenced from Event Bindings at https://get.foundation/sites/docs-v5/components/reveal.html
                const openedModalDOMElement = $(this)[0];
                const openedModalDOMElementID = openedModalDOMElement.id;
                if (openedModalDOMElementID.includes('{{ component.instance.id }}')) {  //ensure the id matches the currently active component which contains the 'Create Text Box' modal just opened
                    const titleInputDOMElement = openedModalDOMElement.querySelector('#addTextboxModal-{{ component.instance.id }}-form-heading');
                    titleInputDOMElement.focus();
                }
            });

            // Dialog for creation of a textbox
            addTextboxForm.alaressValidate({
                submitHandler: function (form) {
                    // Disable submit actions
                    // TODO split alaressValidate's submit handler into beforeSubmit (disable inputs) and submit actions
                    var $submit    = $(form).find('input[type=submit]'),
                        submitText = $submit.val(),
                        formData   = new FormData(form);

                    $submit.prop("disabled", true).text('Working...');

                    // And submit form via AJAX
                    toast.toastActivate({text: 'Creating textbox...'});
                    $.ajax(
                        form.action,
                        {
                            method: form.method,
                            data:   JSON.stringify({
                                heading: formData.get('heading'),
                                body:    formData.get('body'),
                            }),
                            dataType: 'json',
                            contentType: 'application/json',
                        }
                    ).done(function (response) {

                        //to pass through that a new Text Box has been created, to allow the editor to start automatically
                        document.body.setAttribute('data-new-text-box-id', '{{ component.instance.id }}');

                        // Reload the component, close the dialog
                        addTextboxModal.foundation('reveal', 'close');
                        toast.toastTimeout({text: 'Created', css: 'success'});

                        // Set the component's configuration:
                        // * Textbox: the ID of the newly created textbox
                        // * Heading: the newly created textbox's heading
                        configForm
                            .find('select[name="textbox"]')
                            .append($('<option>')
                                .attr('value', response.id)
                                .text(response.heading)
                            )
                            .val(response.id);
                        configForm
                            .find('input[name="componentname"]')
                            .val(response.heading);
                        configForm[0].dispatchEvent(new Event('submit')); //is dispatched to updateComponentSettings.js
                    }).fail(function () {
                        toast.toastTimeout({text: 'Could not create text box', css: 'alert'});
                    }).always(function () {
                        $submit.prop("disabled", false).text(submitText);
                    });
                }
            });
        });
    </script>
{% endautoescape %}
