<li class="actions-small-2">
    <div class="list-item">
        <div class="card small-12">
            <a href="{{ item.author._links.profile }}" title="View Profile">
                <img src="{{ item.author._links.avatar }}" alt="{{ item.author.title }} {{ item.author.firstname }} {{ item.author.lastname }}">
            </a>
            <p><a href="{{ item.author._links.profile }}" title="View Profile">{{ item.author.title }} {{ item.author.firstname }} {{ item.author.lastname }}</a></p>
            <p class="meta" title="{{ item.createdAt.json|date(LOCALE.date.longFormat) }}">
                {{ item.createdAt.json|relativeDate }}
            </p>
        </div>
    </div>
    <nav>
        <a href="#" class="icon-delete no-text" title="Delete post"></a>
        <a href="#" class="icon-reply no-text" title="Add Reply"></a>
    </nav>
    <article>
        {{ item.content|purify }}
    </article>

    {# Replies: not yet implemented #}
    {#
    {% include '@discussionPosts/list.twig' with {
        list:  item.children,
        class: 'reply'
    } only %}
    #}
</li>
