{% if list.data is not empty %}
    <ul class="information-list {{ class ?? 'social-stream' }}">
        {% for item in list.data %}
            {% include '@discussionPosts/item.twig' with {item: item} only %}
        {% endfor %}
    </ul>
{% endif %}

{# Output metadata #}
{% if list.metadata.cursor.next %}
    <button rel="next" data-cursor="{{ list.metadata.cursor.next }}">Load more...</button>
{% endif %}
