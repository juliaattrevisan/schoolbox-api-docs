{% set class = class ?? 'social-stream' %}

<ul class="information-list {{ class }}">
    {% foreach item in list.data %}
        {% include '@discussionPosts/item.twig' with {list: list} only %}
    {% endforeach %}
</ul>

{# Output metadata #}
{% if list.metadata.cursor %}
<button rel="next" data-cursor="{{ list.metadata.cursor }}">Load more...</button>
{% endif %}
