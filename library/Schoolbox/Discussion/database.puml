@startuml

hide empty fields
hide empty methods

object discussion_thread {
    <<PK>> id: int
    open: bool
    created: datetime
    updated: datetime
    deleted: datetime
}

object discussion_post {
    <<PK>> id: int
    discussion_thread_id: int
    author_id: int
    content: text
    created: datetime
    updated: datetime
    deleted: datetime
}

object discussion_thread_link {
    <<PK>> id: int
    discussion_thread_id: int
    link_type: enum(news)
    link_id: int
}

note right
link_type is slated to include
these existing discussion types:
• blog
• forum
• socialstream
• grades

and possibly new discussion types:
• assessment
end note

object user {
    id: int, PK
    username: varchar
    ...
}

discussion_thread -r-{ discussion_post : discussion_thread_id >

discussion_post }-r- user : author_id <

discussion_thread -d-{ discussion_thread_link : discussion_thread_id >

@enduml
