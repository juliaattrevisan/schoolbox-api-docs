{% autoescape 'js' %}
    <script type="text/javascript">
        /* Viewports smaller than this width will be presumed to be a small viewport
         * such as a phone, vertical tablet, or similar device
         */
        const SMALL_VIEWPORT_THRESHOLD = 769;

        window.fullCalendarConfig = {
            schedulerLicenseKey: '{{ config.fullcalendar_scheduler_license_key }}',
            userId:             Number('{{ user.id }}'),
            dateDisplayFormats: dateDisplayFormats,
            /* Decide which display format to use, based on viewport dimensions'
             * so phone users can view this data meaningfully
             */
            defaultView:        window.innerWidth < SMALL_VIEWPORT_THRESHOLD ? 'timeGridDay' : 'timeGridWeek',
            defaultDate:        '{{ selectedDate|date('Y-m-d') }}',
            weekends:           {{ weekends }}
        };
    </script>
{% endautoescape %}

{% if children|length > 0 %}
    <div class="row ">
        <div class="small-12 columns">
            <dl class="sub-nav">
                {% for child in children %}
                    {% set childFormattedName = child.formatName %}
                    {% set campus = child.campusCollection.first %}

                    <dd{% if child.id == user.id %} class="active"{% endif %}>
                        <a title="Timetable for {{ childFormattedName }} in {{ campus.name }}"
                           data-child-student-button
                           data-userId="{{ child.id }}"
                           data-childFormattedName="{{ childFormattedName }}"
                           {# Format of data-childYearLevel must match format used below in <span data-heading-user-year>. #}
                           data-childYearLevel="{% if user.year and (user.year.longName(locale.year.proper)|length) %}, {{ user.year.longName(locale.year.proper) }}{% endif %}">
                            {{ childFormattedName }} ({{ campus.name }})
                        </a>
                    </dd>
                {% endfor %}
            </dl>
        </div>
    </div>
{% endif %}

<div class="row">
    <div class="small-12 columns">
        <h1>
            Timetable for
            {% apply spaceless %} {# Spaceless required because of comma inside data-heading-user-year span below. #}
            <span data-heading-user-fullname>{{ user.fullname }}</span>
            <span data-heading-user-year>{% if user.year and (user.year.longName(locale.year.proper)|length) %}, {{ user.year.longName(locale.year.proper) }}{% endif %}</span>
            {% endapply %}
        </h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            <div id="timetable-calendar">
                <timetable-calendar ref="timetable-calendar"></timetable-calendar>
            </div>
            <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/timetableCalendar.js?v={{ config.site_version }}"></script>
        </section>
    </div>
</div>
