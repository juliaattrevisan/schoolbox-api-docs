<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript">
    $(function() {
        $('#divisionForm').alaressValidate({
            rules: {
                name: {
                    required: true,
                    minlength: 2
                },
                seasonId: {
                    required: true,
                    minlength: 1
                }
            },
            messages: {
                'name': 'Please enter a Division name.',
                'seasonId': 'Please select a Season.'
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        });

        $('#season').selectizeSelector({
            {% if division.season.id %}
            value: {"id":{{ division.season.id }}, "name": "{{ division.season.name }}"},
            {% endif %}
            multiple: false,
            selectize: {
                preload: true,
                hideSelected: false,
                load: function(query, callback) {
                    // Load: get values from AJAX, and callback with result
                    var ajaxSettings = {
                        url: '{{ routeLookup('sportsfixturesSeason.getList') }}',
                        type: 'GET',
                        dataType: 'json',
                        data: { query: query }
                    };
                    $.ajax(ajaxSettings)
                            .done(function(result) {
                                callback(result)
                            })
                            .fail(function() {
                                callback()
                            })
                },
                score: function(search) {
                    return function(item) {
                        // Simply filter list, don't reorder
                        return -1 === item.name.toLowerCase().indexOf(search.toLowerCase()) ? 0 : 1;
                    };
                }
            }
        });

        /**
         * Modal for URL homepage selection
         */
        $('[data-role="openResourceBrowser"]').click(function(e) {
            e.preventDefault();
            $('[data-role="resourceBrowser"]').socialstreamBrowser({
                title: 'Choose a folder',
                categoryId: 0,
                mimeFilter: false,
                submitCallback: function(url, filename) {
                    $('input[name="url"]').val(url);
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures',    routeLookup('sportsfixtures.getLanding') ],
    [ 'Sports',      routeLookup('sportsfixturesSport.getList') ],
    [ sport.name,    routeLookup('sportsfixturesSport.getEntity', { entityId: sport.id }) ],
    [ division.name | default(action ~ ' Division') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ sport.name }}</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if division %}
            {% set formUrl = routeLookup('sportsfixturesDivision.updateEntity', {entityId: division.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesDivision.createEntity') %}
        {% endif %}

        <form id="divisionForm" action="{{ formUrl }}" method="post">
            <input type="hidden" name="returnUrl" value="{{ referer }}" />
            <h2 class="subheader">{{ action }} Division in {{ sport.name }}</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="hidden" name="sportId" value="{{ sport.id }}"/>
                        <input type="hidden" name="divisionId" value="{{ division.id }}"/>

                        <label>
                            Name
                            <input type="text" name="name" value="{{ division.name }}"/>
                        </label>

                        <label>
                            Current Season
                            <input id="season" name="seasonId" type="text" value="{{ division.season.name }}" placeholder="Search Seasons" />
                        </label>

                        <label>
                            Homepage URL
                            <div class="column no-pad">
                                <div class="medium-8 large-9 columns no-pad">
                                    <input type="text" name="url" value="{{ division.url }}" placeholder="http://" />
                                </div>
                                <div class="medium-4 large-3 columns">
                                    <a href="#" class="button" data-role="openResourceBrowser">Browse {{ locale.translate('resource',true,true) }}</a>
                                    <div data-role="resourceBrowser" class="hide"></div>
                                </div>
                            </div>
                        </label>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Division" />
        </form>
    </div>
</div>
