
    <section data-division>
        <ul class="information-list sortable"
            data-add-players-action="{{ routeLookup('sportsfixturesDivision.postAddPlayers', {entityId: division.id}) }}"
            data-remove-players-action="{{ routeLookup('sportsfixturesDivision.postRemovePlayers', {entityId: division.id}) }}"
            data-reorder-players-action="{{ routeLookup('sportsfixturesDivision.postReorderPlayers', {entityId: division.id}) }}"
            data-division-player-list="{{ division.id }}">

            {% for playerData in players %}
                <li class="actions-small-1" data-player="{{ playerData.player.id }}" data-assigned="{% if playerData.player.id in assigned %}1{% else %}0{% endif %}">
                    <div class="list-item">
                        <div class="grip compact"></div>
                        <div class="small-11 compact card wrap-down">
                            <a href="/search/user/{{ playerData.player.id }}">
                                <img src="/portrait.php?userId={{ playerData.player.externalId }}&amp;size=square64" />
                                <h3>{{ playerData.player.formatName() }}</h3>
                            </a>
                            {% for currentTeam in playerData.teams %}
                                {% if loop.first %}
                                    <span class="meta">
                                {% endif %}
                                {{ currentTeam.name }}{% if not loop.last %}, {% endif %}
                                {% if loop.last %}
                                    </span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    <nav>
                        <a href="#" class="icon-more" data-dropdown="sportsfixtures-player-{{ playerData.player.id }}-actions"></a>
                    </nav>
                    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-player-{{ playerData.player.id }}-actions">
                        {% for currentTeam in teams %}
                            {% if loop.first %}
                                <li class="separator">Team Membership</li>
                            {% endif %}
                            <li>
                                {% if currentTeam.team in playerData.teams %}
                                    <a href="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: currentTeam.team.id}) }}"
                                       class="icon-close"
                                       data-remove-team-player="{{ playerData.player.id }}"
                                       data-affected-team="{{ currentTeam.team.id }}">Remove Player from {{ currentTeam.team.name }}</a>
                                {% else %}
                                    <a href="{{ routeLookup('sportsfixturesTeam.postAddPlayers', {entityId: currentTeam.team.id}) }}"
                                       class="icon-add"
                                       data-add-team-player="{{ playerData.player.id }}"
                                       data-affected-team="{{ currentTeam.team.id }}">Add Player to {{ currentTeam.team.name }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                        <li class="separator">Division Membership</li>
                        <li><a href="{{ routeLookup('sportsfixturesDivision.postRemovePlayers', {entityId: division.id}) }}"
                               class="icon-delete"
                               data-remove-player="{{ playerData.player.id }}">Remove Player From Division</a></li>
                    </ul>
                </li>
            {% endfor %}
        </ul>
        <span class="label full-width hide" data-division-indicator></span>
    </section>
