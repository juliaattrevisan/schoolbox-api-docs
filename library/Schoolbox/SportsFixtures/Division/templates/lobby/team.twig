<section data-team="{{ team.id }}">
    <ul class="information-list sortable-card expandable-card"
        data-add-players-action="{{ routeLookup('sportsfixturesTeam.postAddPlayers', {entityId: team.id}) }}"
        data-remove-players-action="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: team.id}) }}"
        data-reorder-players-action="{{ routeLookup('sportsfixturesTeam.postReorderPlayers', {entityId: team.id}) }}"
        data-team-player-list-proxy>

        <li class="actions-small-1">
            <div class="icon-up-arrow expander" title="Expand/Collapse Team" data-collapser="team-{{ team.id }}"></div>
            <div class="list-item">
                <div class="small-12 card wrap-down">
                    <h3>{{ team.name }}</h3>
                    <p class="meta">
                        <span data-player-count>{{ players|length }}</span> player(s) in team
                    </p>
                </div>
            </div>
            <nav>
                <a href="{{ routeLookup('sportsfixturesTeam.getModifyForm', {entityId: team.id}) }}" class="icon-modify" title="Modify Team"></a>
            </nav>
            <div class="toast" data-alert data-team-indicator></div>
        </li>
        <li>
            <ul class="information-list sortable-card"
                data-add-players-action="{{ routeLookup('sportsfixturesTeam.postAddPlayers', {entityId: team.id}) }}"
                data-remove-players-action="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: team.id}) }}"
                data-reorder-players-action="{{ routeLookup('sportsfixturesTeam.postReorderPlayers', {entityId: team.id}) }}"
                data-team-player-list
                data-collapsable="team-{{ team.id }}"
                data-collapse-state="uncollapsed">

                {% include '@sportsfixturesDivision/lobby/teamPlayerList.twig' %}
            </ul>
        </li>
    </ul>
</section>
