<section data-test-team="{{ team.id }}">
    <ul class="information-list sortable"
        data-add-players-action="{{ routeLookup('sportsfixturesTeam.postAddPlayers', {entityId: team.id}) }}"
        data-remove-players-action="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: team.id}) }}"
        data-test-team-player-list-proxy>

        <li class="actions-small-2">
            <div class="list-item">
                <div class="small-12 card wrap-down">
                    <h3>{{ team.name }}</h3>
                    <p class="meta icon-group">
                        {{ players|length }}
                        {{ players|length == 1 ? 'player in team' : 'players in team'}}
                    </p>
                </div>
            </div>
            <nav>
                <a href="#" class="icon-up-arrow" title="Expand/Collapse Content" data-collapser="team-{{ team.id }}"></a>
                <a href="{{ routeLookup('sportsfixturesTeam.getModifyForm', {entityId: team.id}) }}" class="icon-modify" title="Modify Team"></a>
            </nav>
            <span class="label full-width hide" data-test-team-indicator></span>
        </li>
        <li>
            <ul class="information-list sortable"
                data-add-players-action="{{ routeLookup('sportsfixturesTeam.postAddPlayers', {entityId: team.id}) }}"
                data-remove-players-action="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: team.id}) }}"
                data-test-team-player-list
                data-collapsable="team-{{ team.id }}">

                {% include '@sportsfixturesDivision/lobby/teamPlayerList.twig' %}
            </ul>
        </li>
    </ul>
</section>
