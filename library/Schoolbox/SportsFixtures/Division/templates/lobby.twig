<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: division.sport.id}) }}">Divisions in {{ division.sport.name }}</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesDivision.getLobby', {entityId: division.id}) }}">{{ division.name }} Lobby</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<script type="text/javascript">
    $(function() {
        $('[data-test-division-player-list], [data-test-team-player-list], [data-test-team-player-list-proxy]').divisionLobby();
    });
</script>

<div class="row">
    <div class="small-12 columns">
        <select id="player-filter">
            <option value="0">Show All Players</option>
            <option value="1">Show Unassigned Players</option>
            <option value="2">Show Assigned Players</option>
        </select>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-6 island">
        <div class="actions-small-2 row">
            <div class="list-item">
                <div class="small-12 column">
                    <h2 class="subheader">Players</h2>
                </div>
            </div>
            <nav>
                <a href="#" class="icon-add" title="Add Players" data-reveal-id="addPlayersModal"></a>
                <a href="#" class="icon-upload" title="Upload Player List" data-reveal-id="uploadPlayersModal"></a>
            </nav>
        </div>

        {% if players is not empty %}
            {% include '@sportsfixturesDivision/lobby/division.twig' with {
                division: division,
                players: players,
                teams: teams
            } only %}
        {% else %}
            <div class="empty-state">
                <i class="icon-group"></i>
                <p>There are no Players in {{ division.name }}.</p>
                <p>
                    You may <a href="#" title="Add Players" data-reveal-id="addPlayersModal">add players by name</a>,
                    or <a href="#" title="Upload Player List" data-reveal-id="uploadPlayersModal">upload a list</a>.
                </p>
            </div>
        {% endif %}
    </div>
    <div class="small-12 medium-6 columns">
        <div class="row">
            <div class="small-12 island">
                <div class="actions-small-1 row">
                    <div class="list-item">
                        <div class="small-12 column">
                            <h2 class="subheader">Teams</h2>
                        </div>
                    </div>
                    <nav>
                        <a href="{{ routeLookup('sportsfixturesTeam.getCreateForm', {contextId: division.id}) }}" class="icon-add" title="Add Team"></a>
                    </nav>
                </div>

                {% if teams is not empty %}
                    {% for teamData in teams %}
                        {% include '@sportsfixturesDivision/lobby/team.twig' with {
                            team: teamData.team,
                            players: teamData.players,
                            positions: teamData.positions
                        } only %}
                    {% endfor %}
                {% else %}
                    <div class="empty-state">
                        <i class="icon-sport"></i>
                        <p>There are no Teams in {{ division.name }}.</p>
                        <p><a href="{{ routeLookup('sportsfixturesTeam.getCreateForm', {contextId: division.id}) }}" title="Add a Team">Add a Team</a></p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
