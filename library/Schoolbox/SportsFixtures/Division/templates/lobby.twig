<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.label-timeout.js"></script>
<script type="text/javascript">
    $(function() {
        // Selectize box for selecting one or more users
        $('[data-role="userSelector"]')
            .selectizeSelector({
                multiple: true,
                ajax: {
                    url:      '/ajax/user.php',
                    type:     'GET',
                    data:     {groupID: 0},
                    dataType: 'json'
                }
            });

        // Add player to team action
        $('[data-add-team-player]').on('click', function(e) {
            e.preventDefault();
            var el       = $(this);
            var feedback = el.closest('[data-division]').find('[data-relation="save-label"]');
            feedback.labelActivate({text: 'Adding to team...'});
            $.post(el.attr('href'), [{name: 'userId[]', value: el.data('addTeamPlayer')}])
                .done(function() {
                    window.location.reload();
                })
                .done(function() {
                    feedback.labelTimeout({text: 'Added!', css: 'success'});
                })
                .fail(function() {
                    feedback.labelTimeout({text: 'Add failed!', css: 'alert'});
                });
        });

        // Remove player from team action
        $('[data-remove-team-player]').on('click', function(e) {
            e.preventDefault();
            $(this).confirmDialog({
                confirmEvent: function(el) {
                    var feedback = el.closest('[data-team], [data-division]').find('[data-relation="save-label"]');
                    feedback.labelActivate({text: 'Removing from team...'});
                    $.post(el.attr('href'), [{name: 'userId[]', value: el.data('removeTeamPlayer')}])
                        .done(function() {
                            // If this event came from division list: reload that player
                            // If this event came from team list: fade out
                            window.location.reload();
                        })
                        .done(function() {
                            feedback.labelTimeout({text: 'Removed!', css: 'success'});
                        })
                        .fail(function() {
                            feedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                        });
                }
            });
        });

        // Remove player from division action
        $('[data-remove-player]').on('click', function(e) {
            e.preventDefault();
            $(this).confirmDialog({
                confirmEvent: function(el) {
                    var feedback = el.closest('[data-team], [data-division]').find('[data-relation="save-label"]');
                    feedback.labelActivate({text: 'Removing from division...'});
                    $.post(el.attr('href'), [{name: 'userId[]', value: el.data('removePlayer')}])
                        .done(function() {
                            el.closest('[data-player]').fadeOut();
                        })
                        .done(function() {
                            feedback.labelTimeout({text: 'Removed!', css: 'success'});
                        })
                        .fail(function() {
                            feedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                        });
                }
            });
        });

        /**
         * Save ordering of a sortable.
         *
         * @param sortable The sortable list to save order for
         * @returns {*} A jqXHR object
         */
        var saveOrdering = function(sortable) {
            var data = sortable.find('[data-player]').map(function() {
                return {name: 'userId[]', value: $(this).data('player')};
            });
            return $.post(sortable.data('reorderPlayersAction'), data)
        };

        /**
         * Adds player to a sortable list.
         *
         * @param dragged  The player that was dragged
         * @param sortable The sortable list to save into
         * @returns {*} A jqXHR object
         */
        var addPlayer = function(dragged, sortable) {
            return $.post(sortable.data('addPlayersAction'), [{name: 'userId[]', value: dragged.data('player')}])
        };

        /**
         * Removes player from a sortable list.
         *
         * @param dragged  The player to remove
         * @param sortable The sortable list to remove from
         * @returns {*} A jqXHR object
         */
        var removePlayer = function(dragged, sortable) {
            return $.post(sortable.data('removePlayersAction'), [{name: 'userId[]', value: dragged.data('player')}])
        };

        // Reorder players in division or team
        // This action handles:
        // * reordering within a division
        // * reordering within a team
        // * dragging from division to team (add to team + reorder team)
        // * dragging from team to division (remove from team + reorder division)
        // * dragging from team to team (remove from team + add to team + reorder team)
        var sortables = $('[data-division-player-list], [data-team-player-list]');
        sortables.sortable({
            handle: '.grip',
            connectWith: sortables,
            stop: function(event, ui) {
                var dragged      = ui.item,
                    from         = $(event.target),
                    fromFeedback = from.closest('[data-team], [data-division]').find('[data-relation="save-label"]'),
                    to           = dragged.closest(sortables),
                    toFeedback   = to.closest('[data-team], [data-division]').find('[data-relation="save-label"]');
                if (from.is(to)) {
                    // Reordering either within team or division:
                    // action is the same
                    fromFeedback.labelActivate({text: 'Saving order...'});
                    saveOrdering(from)
                        .done(function() {
                            fromFeedback.labelTimeout({text: 'Saved!', css: 'success'});
                        })
                        .fail(function() {
                            fromFeedback.labelTimeout({text: 'Save failed!', css: 'alert'});
                        });

                } else if (from.is('[data-team-player-list]') && to.is('[data-team-player-list]')) {
                    // Move between teams (remove from team + add to team, reorder team)
                    fromFeedback.labelActivate({text: 'Removing from team...'});
                    toFeedback.labelActivate({text: 'Adding to team...'});
                    $.when(removePlayer(dragged, from), addPlayer(dragged, to), saveOrdering(to))
                        // TODO replace reload with AJAX redraw of player list
                        .done(function() {
                            window.location.reload();
                        })
                        .done(function() {
                            fromFeedback.labelTimeout({text: 'Removed!', css: 'success'});
                            toFeedback.labelTimeout({text: 'Added!', css: 'success'});
                        })
                        .fail(function() {
                            fromFeedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                            toFeedback.labelTimeout({text: 'Added failed!', css: 'alert'});
                        });

                } else if (from.is('[data-division-player-list]') && to.is('[data-team-player-list]')) {
                    // Move from division to team (add to team, reorder team)
                    toFeedback.labelActivate({text: 'Adding to team...'});
                    $.when(addPlayer(dragged, to), saveOrdering(to))
                        .done(function() {
                            window.location.reload();
                        })
                        .done(function() {
                            toFeedback.labelTimeout({text: 'Added!', css: 'success'});
                        })
                        .fail(function() {
                            toFeedback.labelTimeout({text: 'Added failed!', css: 'alert'});
                        });

                } else if (from.is('[data-team-player-list]') && to.is('[data-division-player-list]')) {
                    // Move from team to division (remove from team + reorder division)
                    fromFeedback.labelActivate({text: 'Removing from team...'});
                    toFeedback.labelActivate({text: 'Saving order...'});
                    $.when(removePlayer(dragged, from), saveOrdering(to))
                        .done(function() {
                            window.location.reload();
                        })
                        .done(function() {
                            fromFeedback.labelTimeout({text: 'Removed!', css: 'success'});
                            toFeedback.labelTimeout({text: 'Saved!', css: 'success'});
                        })
                        .fail(function() {
                            fromFeedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                            toFeedback.labelTimeout({text: 'Save failed!', css: 'alert'});
                        });
                }
            }
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: division.getSport().getId()}) }}">Divisions in {{ division.getSport().getName() }}</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesDivision.getLobby', {entityId: division.id}) }}">{{ division.name }} Lobby</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-6 island">
        <div class="actions-small-2 row">
            <div class="list-item">
                <div class="small-12 column">
                    <h2 class="subheader">Players</h2>
                </div>
            </div>
            <nav>
                <a href="#" class="icon-add" title="Add Players" data-reveal-id="addPlayersModal"></a>
                <a href="#" class="icon-upload" title="Upload Player List" data-reveal-id="uploadPlayersModal"></a>
            </nav>
        </div>
        {% if division.getPlayers() is not empty %}
            <section data-division="{{ division.getId() }}">
                <span class="label full-width hide" data-relation="save-label"></span>
                <ul class="information-list sortable"
                    data-division-player-list="{{ division.getId() }}"
                    data-add-players-action="{{ routeLookup('sportsfixturesDivision.postAddPlayers', {entityId: division.getId()}) }}"
                    data-remove-players-action="{{ routeLookup('sportsfixturesDivision.postRemovePlayers', {entityId: division.getId()}) }}"
                    data-reorder-players-action="{{ routeLookup('sportsfixturesDivision.postReorderPlayers', {entityId: division.getId()}) }}">
                    {% for divisionPlayer in division.getPlayers() %}
                        <li class="actions-small-1" data-player="{{ divisionPlayer.getId() }}">
                            <div class="list-item">
                                <div class="grip"></div>
                                <div class="small-11 avatar card">
                                    <a href="/search/user/{{ divisionPlayer.getId() }}">
                                        <img src="/portrait.php?userId={{ divisionPlayer.getExternalId() }}&amp;size=square64" />
                                        <h3>{{ divisionPlayer.formatName() }}</h3>
                                    </a>
                                    <p class="meta">{{ divisionPlayer.formatMetadata() }}</p>
                                    {% for currentTeam in division.getTeamsForPlayer(divisionPlayer) %}
                                        {% if loop.first %}
                                            <p class="meta icon-sport">
                                        {% endif %}
                                        {{ currentTeam.getName() }}{% if not loop.last %}, {% endif %}
                                        {% if loop.last %}
                                            </p>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                            <nav>
                                <a href="#" class="icon-more" data-dropdown="sportsfixtures-player-{{ divisionPlayer.getId() }}-actions"></a>
                            </nav>
                            <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-player-{{ divisionPlayer.getId() }}-actions">
                                {% for currentTeam in division.getTeams() %}
                                    <li>
                                        {% if currentTeam.isPlayerInTeam(divisionPlayer) %}
                                            <a href="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: currentTeam.getId()}) }}"
                                               class="icon-previous"
                                               data-remove-team-player="{{ divisionPlayer.getId() }}">Remove Player from {{ currentTeam.getName() }}</a>
                                        {% else %}
                                            <a href="{{ routeLookup('sportsfixturesTeam.postAddPlayers', {entityId: currentTeam.getId()}) }}"
                                               class="icon-next"
                                               data-add-team-player="{{ divisionPlayer.getId() }}">Add Player to {{ currentTeam.getName() }}</a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                                <li><a href="{{ routeLookup('sportsfixturesDivision.postRemovePlayers', {entityId: division.getId()}) }}"
                                       class="icon-delete"
                                       data-remove-player="{{ divisionPlayer.getId() }}">Remove Player From Division</a></li>
                            </ul>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-player"></i>
                <p>There are no Players in {{ division.getName() }}.</p>
                <p>
                    You may <a href="#" title="Add Players" data-reveal-id="addPlayersModal">add players by name</a>,
                    or <a href="#" title="Upload Player List" data-reveal-id="uploadPlayersModal">upload a list</a>.
                </p>
            </div>
        {% endif %}
    </div>

    <div class="hide-for-small medium-6 island">
        <h2 class="subheader">Teams</h2>
        {% if division.getTeams() is not empty %}
            {% for currentTeam in division.getTeams() %}
                <section data-team="{{ currentTeam.getId() }}">
                    <span class="label full-width hide" data-relation="save-label"></span>
                    <ul class="information-list sortable"
                        data-team-player-list="{{ currentTeam.getId() }}"
                        data-add-players-action="{{ routeLookup('sportsfixturesTeam.postAddPlayers', {entityId: currentTeam.getId()}) }}"
                        data-remove-players-action="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: currentTeam.getId()}) }}"
                        data-reorder-players-action="{{ routeLookup('sportsfixturesTeam.postReorderPlayers', {entityId: currentTeam.getId()}) }}">
                        <li>
                            <div class="list-item">
                                <div class="small-12 avatar card">
                                    <h3>{{ currentTeam.getName() }}</h3>
                                    <p class="meta icon-group">
                                        {{ currentTeam.getPlayers()|length }}
                                        {{ currentTeam.getPlayers()|length == 1 ? 'player in team' : 'players in team'}}
                                    </p>
                                </div>
                            </div>
                        </li>
                        {% for teamPlayer in currentTeam.getPlayers() %}
                            <li class="actions-small-1" data-player="{{ teamPlayer.getId() }}">
                                <div class="list-item">
                                    <div class="grip"></div>
                                    <div class="small-11 avatar card">
                                        <a href="/search/user/{{ teamPlayer.getId() }}">
                                            <img src="/portrait.php?userId={{ teamPlayer.getExternalId() }}&amp;size=square64" />
                                            <h3>{{ teamPlayer.formatName() }}</h3>
                                        </a>
                                        <p class="meta">{{ teamPlayer.formatMetadata() }}</p>
                                    </div>
                                </div>
                                <nav>
                                    <a href="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: currentTeam.getId()}) }}"
                                       class="icon-previous"
                                       title="Remove Player from {{ currentTeam.getName() }}"
                                       data-remove-team-player="{{ teamPlayer.getId() }}"></a>
                                </nav>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <i class="icon-team"></i>
                <p>There are no Teams in {{ division.getName() }}.</p>
                <p><a href="{{ routeLookup('sportsfixturesTeam.getCreateForm', {contextId: division.id}) }}" title="Add a Team">Add a Team</a></p>
            </div>
        {% endif %}
    </div>
</div>

<div id="addPlayersModal" class="reveal-modal" data-reveal aria-labelledby="addPlayersModalTitle" aria-hidden="true" role="dialog">
    <h2 id="addPlayersModalTitle">Add Players</h2>
    <form action="{{ routeLookup('sportsfixturesDivision.postAddPlayers', {entityId: division.getId()}) }}" method="post">
        <select data-role="userSelector" name="userId[]" multiple placeholder="Search Users"></select>
        <input type="submit" class="full-width" value="Add" />
    </form>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div id="uploadPlayersModal" class="reveal-modal" data-reveal aria-labelledby="uploadPlayersModalTitle" aria-hidden="true" role="dialog">
    <h2 id="uploadPlayersModalTitle">Upload Player List</h2>
    <form action="{{ routeLookup('sportsfixturesDivision.postUploadPlayers', {entityId: division.getId()}) }}" method="post">
        <p>
            You may upload a list of Schoolbox User IDs, usernames or external IDs into this division.
            Make sure that it conforms to the <a href="/sportsfixtures/import/userTemplate.csv">template</a> provided.
        </p>

        {% if user.isSuperuser() %}
            {# Show only superusers the role report link, as only they can see it #}
            <p>
                You may also download a report from the
                <a href="/adminv2/home" target="_blank">Role Statistics section in Administration</a>,
                and use it as the list of users to upload.
            </p>
        {% endif %}

        {% include 'sub/attachzone.twig' with { attachzone: uploadZone.getTwigContext() } %}
        <ul class="flex-list buttons">
            <li><a href="/sportsfixtures/import/userTemplate.csv" class="button">Download Template</a></li>
            <li><input type="submit" class="full-width" value="Upload" /></li>
        </ul>
    </form>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>
