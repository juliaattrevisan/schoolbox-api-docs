{##
 # Template variables:
 #
 # user:                   the logged-in user
 # uploadZone.twigContext: values for rendering the attach zone
 # division:               the division
 # players:                the players in the division
 # players[].player:       the player data for each division player
 # players[].teams[]:      the teams that the division player is in
 # teams:                  the teams in the division
 # teams[].team:           the team data for each division team
 # teams[].players[]:      the player data for each division team
 #}
<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.label-timeout.js"></script>
<script type="text/javascript">
    $(function() {

        connectPlayerPositionButtons = function() {

            // When the player clicks the edit positions button

            $('[data-player-positions-user]').click(function (e) {

                // Set the form data with the team/user IDs
                $('#playerPositionName').html($(this).attr('data-player-positions-team-name') + ' - ' + $(this).attr('data-player-positions-name'));
                $('#playerPositionUserId').val($(this).attr('data-player-positions-user'));
                $('#playerPositionTeamId').val($(this).attr('data-player-positions-team'));

                // Get the players current positions and split into array
                var positions = $(this).attr('data-player-positions').split(',');
                ;

                $('[data-position]').each(function () {
                    // Deselect position
                    $(this).prop('checked', false);

                    // Iterate all position checkboxes and find out if we should check it
                    for (var i = 0; i < positions.length; i++) {
                        if ($(this).val() == positions[i]) {
                            // Player was in this position, check it
                            $(this).prop('checked', true);
                            break;
                        }
                    }

                });
            });
        };

        // Selectize box for selecting one or more users
        $('[data-role="userSelector"]')
            .selectizeSelector({
                multiple: true,
                ajax: {
                    url:      '/ajax/user.php',
                    type:     'GET',
                    data:     {groupID: 0},
                    dataType: 'json'
                }
            });

        var sortables = $('[data-division-player-list], [data-team-player-list]');

        /**
         * Save ordering of a sortable.
         *
         * @param sortable The sortable list to save order for
         * @returns {*} A jqXHR object
         */
        var saveOrdering = function(sortable) {
            var data = sortable.find('[data-player]').map(function() {
                return {name: 'userId[]', value: $(this).data('player')};
            });
            return $.post(sortable.data('reorderPlayersAction'), data)
        };

        /**
         * Performs a post action on a player to a sortable list.
         *
         * @param playerId The player to add
         * @param action   The sortable list to remove from
         * @returns {*} A jqXHR object
         */
        var postPlayer = function(playerId, action) {
            return $.post(action, [{name: 'userId[]', value: playerId}])
        };

        /**
         * Refreshes player lists given a HTML segment.
         *
         * @param segment The HTML segment
         */
        var refreshPlayerList = function(segment) {
            var newSegments = $(segment).find('[data-division-player-list], [data-team-player-list]');
            sortables.each(function() {
                var oldList = $(this);
                // Find matching in newSegments
                var newList = newSegments.filter(function() {
                    var $this = $(this);
                    return (oldList.data('divisionPlayerList') == $this.data('divisionPlayerList')
                        && oldList.data('teamPlayerList') == $this.data('teamPlayerList')
                    );
                });
                oldList.empty().append(newList.children());
            });
            connectPlayerPositionButtons();
        };

        // Add player to team action
        sortables.on('click', '[data-add-team-player]', function(e) {
            e.preventDefault();
            var el       = $(this);
            var feedback = el.closest('[data-division]').find('[data-relation="save-label"]');
            feedback.labelActivate({text: 'Adding to team...'});
            postPlayer(el.data('addTeamPlayer'), el.attr('href'))
                .done(function(response) {
                    refreshPlayerList(response);
                })
                .done(function() {
                    feedback.labelTimeout({text: 'Added!', css: 'success'});
                })
                .fail(function() {
                    feedback.labelTimeout({text: 'Add failed!', css: 'alert'});
                });
        });

        // Remove player from team action
        sortables.on('click', '[data-remove-team-player]', function(e) {
            e.preventDefault();
            $(this).confirmDialog({
                text: 'Are you sure you wish to remove this player from this team?',
                confirmEvent: function(el) {
                    var feedback = el.closest('[data-team], [data-division]').find('[data-relation="save-label"]');
                    feedback.labelActivate({text: 'Removing from team...'});
                    postPlayer(el.data('removeTeamPlayer'), el.attr('href'))
                        .done(function(response) {
                            refreshPlayerList(response);
                        })
                        .done(function() {
                            feedback.labelTimeout({text: 'Removed!', css: 'success'});
                        })
                        .fail(function() {
                            feedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                        });
                }
            });
        });

        // Remove player from division action
        sortables.on('click', '[data-remove-player]', function(e) {
            e.preventDefault();
            $(this).confirmDialog({
                text: 'Are you sure you wish to remove this player from this division, and all teams within this division?',
                confirmEvent: function(el) {
                    var feedback = el.closest('[data-team], [data-division]').find('[data-relation="save-label"]');
                    feedback.labelActivate({text: 'Removing from division...'});
                    postPlayer(el.data('removePlayer'), el.attr('href'))
                        .done(function(response) {
                            refreshPlayerList(response);
                        })
                        .done(function() {
                            feedback.labelTimeout({text: 'Removed!', css: 'success'});
                        })
                        .fail(function() {
                            feedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                        });
                }
            });
        });

        // Reorder players in division or team
        // This action handles:
        // * reordering within a division
        // * reordering within a team
        // * dragging from division to team (add to team + reorder team)
        // * dragging from team to division (remove from team + reorder division)
        // * dragging from team to team (remove from team + add to team + reorder team)
        sortables.sortable({
            handle: '.grip',
            connectWith: sortables,
            stop: function(event, ui) {
                var dragged      = ui.item,
                    from         = $(event.target),
                    fromFeedback = from.closest('[data-team], [data-division]').find('[data-relation="save-label"]'),
                    to           = dragged.closest(sortables),
                    toFeedback   = to.closest('[data-team], [data-division]').find('[data-relation="save-label"]');
                if (from.is(to)) {
                    // Reordering either within team or division:
                    // action is the same
                    fromFeedback.labelActivate({text: 'Saving order...'});
                    saveOrdering(from)
                        .done(function() {
                            fromFeedback.labelTimeout({text: 'Saved!', css: 'success'});
                        })
                        .fail(function() {
                            fromFeedback.labelTimeout({text: 'Save failed!', css: 'alert'});
                        });

                } else if (from.is('[data-team-player-list]') && to.is('[data-team-player-list]')) {
                    // Move between teams (remove from team + add to team, reorder team)
                    // Remove+add first as player must be in team before reordering
                    fromFeedback.labelActivate({text: 'Removing from team...'});
                    toFeedback.labelActivate({text: 'Adding to team...'});
                    $.when(
                        postPlayer(dragged.data('player'), from.data('removePlayersAction')),
                        postPlayer(dragged.data('player'), to.data('addPlayersAction'))
                    )
                        .then(function() {
                            return saveOrdering(to);
                        })
                        .done(function(response) {
                            refreshPlayerList(response);
                        })
                        .done(function() {
                            fromFeedback.labelTimeout({text: 'Removed!', css: 'success'});
                            toFeedback.labelTimeout({text: 'Added!', css: 'success'});
                        })
                        .fail(function() {
                            fromFeedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                            toFeedback.labelTimeout({text: 'Add failed!', css: 'alert'});
                        });

                } else if (from.is('[data-division-player-list]') && to.is('[data-team-player-list]')) {
                    // Move from division to team (add to team, reorder team)
                    // Add first as player must be in team before reordering
                    toFeedback.labelActivate({text: 'Adding to team...'});
                    postPlayer(dragged.data('player'), to.data('addPlayersAction'))
                        .then(function() {
                            return saveOrdering(to);
                        })
                        .done(function(response) {
                            refreshPlayerList(response);
                        })
                        .done(function() {
                            toFeedback.labelTimeout({text: 'Added!', css: 'success'});
                        })
                        .fail(function() {
                            toFeedback.labelTimeout({text: 'Add failed!', css: 'alert'});
                        });

                } else if (from.is('[data-team-player-list]') && to.is('[data-division-player-list]')) {
                    // Move from team to division (remove from team + reorder division)
                    fromFeedback.labelActivate({text: 'Removing from team...'});
                    toFeedback.labelActivate({text: 'Saving order...'});
                    $.when(postPlayer(dragged.data('player'), from.data('removePlayersAction')))
                        .then(function() {
                            return saveOrdering(to);
                        })
                        .done(function(response) {
                            refreshPlayerList(response);
                        })
                        .done(function() {
                            fromFeedback.labelTimeout({text: 'Removed!', css: 'success'});
                            toFeedback.labelTimeout({text: 'Saved!', css: 'success'});
                        })
                        .fail(function() {
                            fromFeedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                            toFeedback.labelTimeout({text: 'Save failed!', css: 'alert'});
                        });
                }
            }
        });

        connectPlayerPositionButtons();
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: division.sport.id}) }}">Divisions in {{ division.sport.name }}</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesDivision.getLobby', {entityId: division.id}) }}">{{ division.name }} Lobby</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-6 island">
        <div class="actions-small-2 row">
            <div class="list-item">
                <div class="small-12 column">
                    <h2 class="subheader">Players</h2>
                </div>
            </div>
            <nav>
                <a href="#" class="icon-add" title="Add Players" data-reveal-id="addPlayersModal"></a>
                <a href="#" class="icon-upload" title="Upload Player List" data-reveal-id="uploadPlayersModal"></a>
            </nav>
        </div>
        {% if players is not empty %}
            <section data-division="{{ division.id }}">
                <ul class="information-list sortable"
                    data-division-player-list="{{ division.id }}"
                    data-add-players-action="{{ routeLookup('sportsfixturesDivision.postAddPlayers', {entityId: division.id}) }}"
                    data-remove-players-action="{{ routeLookup('sportsfixturesDivision.postRemovePlayers', {entityId: division.id}) }}"
                    data-reorder-players-action="{{ routeLookup('sportsfixturesDivision.postReorderPlayers', {entityId: division.id}) }}">
                    {% for playerData in players %}
                        <li class="actions-small-1" data-player="{{ playerData.player.id }}">
                            <div class="list-item">
                                <div class="grip"></div>
                                <div class="small-11 avatar card">
                                    <a href="/search/user/{{ playerData.player.id }}">
                                        <img src="/portrait.php?userId={{ playerData.player.externalId }}&amp;size=square64" />
                                        <h3>{{ playerData.player.formatName() }}</h3>
                                    </a>
                                    <p class="meta">{{ playerData.player.formatMetadata() }}</p>
                                    {% for currentTeam in playerData.teams %}
                                        {% if loop.first %}
                                            <p class="meta icon-sport">
                                        {% endif %}
                                        {{ currentTeam.name }}{% if not loop.last %}, {% endif %}
                                        {% if loop.last %}
                                            </p>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                            <nav>
                                <a href="#" class="icon-more" data-dropdown="sportsfixtures-player-{{ playerData.player.id }}-actions"></a>
                            </nav>
                            <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-player-{{ playerData.player.id }}-actions">
                                {% for currentTeam in teams %}
                                    {% if loop.first %}
                                        <li class="separator">Team Membership</li>
                                    {% endif %}
                                    <li>
                                        {% if currentTeam.team in playerData.teams %}
                                            <a href="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: currentTeam.team.id}) }}"
                                               class="icon-close"
                                               data-remove-team-player="{{ playerData.player.id }}">Remove Player from {{ currentTeam.team.name }}</a>
                                        {% else %}
                                            <a href="{{ routeLookup('sportsfixturesTeam.postAddPlayers', {entityId: currentTeam.team.id}) }}"
                                               class="icon-add"
                                               data-add-team-player="{{ playerData.player.id }}">Add Player to {{ currentTeam.team.name }}</a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                                <li class="separator">Division Membership</li>
                                <li><a href="{{ routeLookup('sportsfixturesDivision.postRemovePlayers', {entityId: division.id}) }}"
                                       class="icon-delete"
                                       data-remove-player="{{ playerData.team.id }}">Remove Player From Division</a></li>
                            </ul>
                        </li>
                    {% endfor %}
                </ul>
                <span class="label full-width hide" data-relation="save-label"></span>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-group"></i>
                <p>There are no Players in {{ division.name }}.</p>
                <p>
                    You may <a href="#" title="Add Players" data-reveal-id="addPlayersModal">add players by name</a>,
                    or <a href="#" title="Upload Player List" data-reveal-id="uploadPlayersModal">upload a list</a>.
                </p>
            </div>
        {% endif %}
    </div>

    <div class="hide-for-small medium-6 island">
        <h2 class="subheader">Teams</h2>
        {% if teams is not empty %}
            {% for teamData in teams %}
                <section data-team="{{ teamData.team.id }}">
                    <ul class="information-list sortable"
                        data-team-player-list="{{ teamData.team.id }}"
                        data-add-players-action="{{ routeLookup('sportsfixturesTeam.postAddPlayers', {entityId: teamData.team.id}) }}"
                        data-remove-players-action="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: teamData.team.id}) }}"
                        data-reorder-players-action="{{ routeLookup('sportsfixturesTeam.postReorderPlayers', {entityId: teamData.team.id}) }}">
                        <li>
                            <div class="list-item">
                                <div class="small-12 avatar card">
                                    <h3>{{ teamData.team.name }}</h3>
                                    <p class="meta icon-group">
                                        {{ teamData.players|length }}
                                        {{ teamData.players|length == 1 ? 'player in team' : 'players in team'}}
                                    </p>
                                </div>
                            </div>
                        </li>
                        {% for teamPlayer in teamData.players %}
                            <li class="actions-small-2" data-player="{{ teamPlayer.id }}">
                                <div class="list-item">
                                    <div class="grip"></div>
                                    <div class="small-10 avatar card">
                                        <a href="/search/user/{{ teamPlayer.id }}">
                                            <img src="/portrait.php?userId={{ teamPlayer.externalId }}&amp;size=square64" />
                                            <h3>{{ teamPlayer.formatName() }}</h3>
                                        </a>
                                        <p class="meta">{{ teamPlayer.formatMetadata() }}</p>
                                        <p>
                                            {% for teamPosition in teamData.positions if teamPosition.user.id == teamPlayer.id %}
                                                {{ teamPosition.position.name }}<br>
                                            {% endfor %}
                                        </p>
                                    </div>

                                </div>
                                <nav>
                                    <a href="#"
                                       data-reveal-id="editPlayerPositions"
                                       class="icon-sport"
                                       title="Change Player Positions"
                                       data-player-positions-name="{{ teamPlayer.formatName() }}"
                                       data-player-positions-team-name="{{ teamData.team.name }}"
                                       data-player-positions-user="{{ teamPlayer.id }}"
                                       data-player-positions-team="{{ teamData.team.id }}"
                                       data-player-positions="{% for teamPosition in teamData.positions if teamPosition.user.id == teamPlayer.id %}{% if not loop.first %},{% endif %}{{ teamPosition.position.id }}{% endfor %}"
                                    ></a>
                                    <a href="{{ routeLookup('sportsfixturesTeam.postRemovePlayers', {entityId: teamData.team.id}) }}"
                                       class="icon-close"
                                       title="Remove Player from {{ teamData.team.name }}"
                                       data-remove-team-player="{{ teamPlayer.id }}"></a>
                                </nav>
                            </li>
                        {% endfor %}
                    </ul>
                    <span class="label full-width hide" data-relation="save-label"></span>
                </section>
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <i class="icon-sport"></i>
                <p>There are no Teams in {{ division.name }}.</p>
                <p><a href="{{ routeLookup('sportsfixturesTeam.getCreateForm', {contextId: division.id}) }}" title="Add a Team">Add a Team</a></p>
            </div>
        {% endif %}
    </div>
</div>

<div id="addPlayersModal" class="reveal-modal" data-reveal aria-labelledby="addPlayersModalTitle" aria-hidden="true" role="dialog">
    <h2 id="addPlayersModalTitle">Add Players</h2>
    <form action="{{ routeLookup('sportsfixturesDivision.postAddPlayers', {entityId: division.id}) }}" method="post">
        <select data-role="userSelector" name="userId[]" multiple placeholder="Search Users"></select>
        <input type="submit" class="full-width" value="Add" />
    </form>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

{# Change player positions modal #}

<div id="editPlayerPositions" class="reveal-modal" data-reveal aria-labelledby="editPlayerPositionsModalTitle" aria-hidden="true" role="dialog">
    <h2 id="editPlayerPositionsModalTitle">Change Player Positions</h2>
    <form action="{{ routeLookup('sportsfixturesDivision.postPlayerPositions', {entityId: division.id}) }}" method="post">
        <input type="hidden" name="team_id" id="playerPositionTeamId">
        <input type="hidden" name="user_id" id="playerPositionUserId">
        <fieldset class="checklist" data-equalizer-watch="">
            <legend id="playerPositionName"></legend>
            {% for position in positions %}
                <input data-position id="position-{{ position.id }}" name="positions[]" value="{{ position.id }}" type="checkbox"><label for="position-{{ position.id }}">{{ position.name }}</label>
            {% endfor %}
        </fieldset>
        <input type="submit" class="full-width" value="Save Changes" />
    </form>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div id="uploadPlayersModal" class="reveal-modal" data-reveal aria-labelledby="uploadPlayersModalTitle" aria-hidden="true" role="dialog">
    <h2 id="uploadPlayersModalTitle">Upload Player List</h2>
    <form action="{{ routeLookup('sportsfixturesDivision.postUploadPlayers', {entityId: division.id}) }}" method="post">
        <p>
            You may upload a list of Schoolbox User IDs, usernames or external IDs into this division.
            Make sure that it conforms to the <a href="/sportsfixtures/import/userTemplate.csv">template</a> provided.
        </p>

        {% if user.isSuperuser %}
            {# Show only superusers the role report link, as only they can see it #}
            <p>
                You may also download a report from the
                <a href="/adminv2/home" target="_blank">Role Statistics section in Administration</a>,
                and use it as the list of users to upload.
            </p>
        {% endif %}

        {% include 'sub/attachzone.twig' with { attachzone: uploadZone.twigContext } %}
        <ul class="flex-list buttons">
            <li><a href="/sportsfixtures/import/userTemplate.csv" class="button">Download Template</a></li>
            <li><input type="submit" class="full-width" value="Upload" /></li>
        </ul>
    </form>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>
