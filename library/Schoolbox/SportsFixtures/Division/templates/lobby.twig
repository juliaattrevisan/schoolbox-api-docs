{##
 # Template variables:
 #
 # user:                   the logged-in user
 # uploadZone.twigContext: values for rendering the attach zone
 # division:               the division
 # players:                the players in the division
 # players[].player:       the player data for each division player
 # players[].teams[]:      the teams that the division player is in
 # teams:                  the teams in the division
 # teams[].team:           the team data for each division team
 # teams[].players[]:      the player data for each division team
 #}
<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/shared/sportsfixtures/jquery.division-lobby.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.collapsable.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.label-timeout.js"></script>
<script type="text/javascript">
    $(function() {

        var connectPlayerPositionButtons = function() {

            // When the player clicks the edit positions button

            $('[data-player-positions-user]').click(function() {

                // Set the form data with the team/user IDs
                $('#playerPositionName').html($(this).attr('data-player-positions-team-name') + ' - ' + $(this).attr('data-player-positions-name'));
                $('#playerPositionUserId').val($(this).attr('data-player-positions-user'));
                $('#playerPositionTeamId').val($(this).attr('data-player-positions-team'));

                // Get the players current positions and split into array
                var positions = $(this).attr('data-player-positions').split(',');

                $('[data-position]').each(function () {
                    // Deselect position
                    $(this).prop('checked', false);

                    // Iterate all position checkboxes and find out if we should check it
                    for (var i = 0; i < positions.length; i++) {
                        if ($(this).val() == positions[i]) {
                            // Player was in this position, check it
                            $(this).prop('checked', true);
                            break;
                        }
                    }

                });
            });
        };

        // Selectize box for selecting one or more users
        $('[data-role="userSelector"]')
            .selectizeSelector({
                multiple: true,
                ajax: {
                    url:      '/ajax/user.php',
                    type:     'GET',
                    data:     {groupID: 0},
                    dataType: 'json'
                }
            });

        var sortables = $('[data-division-player-list], [data-team-player-list]');

        /**
         * Save ordering of a sortable.
         *
         * @param sortable The sortable list to save order for
         * @returns {*} A jqXHR object
         */
        var saveOrdering = function(sortable) {
            var data = sortable.find('[data-player]').map(function() {
                return {name: 'userId[]', value: $(this).data('player')};
            });
            return $.post(sortable.data('reorderPlayersAction'), data)
        };

        /**
         * Performs a post action on a player to a sortable list.
         *
         * @param playerId The player to add
         * @param action   The sortable list to remove from
         * @returns {*} A jqXHR object
         */
        var postPlayer = function(playerId, action) {
            return $.post(action, [{name: 'userId[]', value: playerId}])
        };

        /**
         * Refreshes player lists given a HTML segment.
         *
         * @param segment The HTML segment
         */
        var refreshPlayerList = function(segment) {
            var newSegments = $(segment).find('[data-division-player-list], [data-team-player-list]');
            sortables.each(function() {
                var oldList = $(this);
                // Find matching in newSegments
                var newList = newSegments.filter(function() {
                    var $this = $(this);
                    return (oldList.data('divisionPlayerList') == $this.data('divisionPlayerList')
                        && oldList.data('teamPlayerList') == $this.data('teamPlayerList')
                    );
                });
                oldList.empty().append(newList.children());
            });

            connectPlayerPositionButtons();
        };

        // Add player to team action
        sortables.on('click', '[data-add-team-player]', function(e) {
            e.preventDefault();
            var el       = $(this);
            var feedback = el.closest('[data-division]').find('[data-relation="save-label"]');
            feedback.labelActivate({text: 'Adding to team...'});
            postPlayer(el.data('addTeamPlayer'), el.attr('href'))
                .done(function(response) {
                    refreshPlayerList(response);
                })
                .done(function() {
                    feedback.labelTimeout({text: 'Added!', css: 'success'});
                })
                .fail(function() {
                    feedback.labelTimeout({text: 'Add failed!', css: 'alert'});
                });
        });

        // Remove player from team action
        sortables.on('click', '[data-remove-team-player]', function(e) {
            e.preventDefault();
            $(this).confirmDialog({
                text: 'Are you sure you wish to remove this player from this team?',
                confirmEvent: function(el) {
                    var feedback = el.closest('[data-team], [data-division]').find('[data-relation="save-label"]');
                    feedback.labelActivate({text: 'Removing from team...'});
                    postPlayer(el.data('removeTeamPlayer'), el.attr('href'))
                        .done(function(response) {
                            refreshPlayerList(response);
                        })
                        .done(function() {
                            feedback.labelTimeout({text: 'Removed!', css: 'success'});
                        })
                        .fail(function() {
                            feedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                        });
                }
            });
        });

        // Remove player from division action
        sortables.on('click', '[data-remove-player]', function(e) {
            e.preventDefault();
            $(this).confirmDialog({
                text: 'Are you sure you wish to remove this player from this division, and all teams within this division?',
                confirmEvent: function(el) {
                    var feedback = el.closest('[data-team], [data-division]').find('[data-relation="save-label"]');
                    feedback.labelActivate({text: 'Removing from division...'});
                    postPlayer(el.data('removePlayer'), el.attr('href'))
                        .done(function(response) {
                            refreshPlayerList(response);
                        })
                        .done(function() {
                            feedback.labelTimeout({text: 'Removed!', css: 'success'});
                        })
                        .fail(function() {
                            feedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                        });
                }
            });
        });

        // Reorder players in division or team
        // This action handles:
        // * reordering within a division
        // * reordering within a team
        // * dragging from division to team (add to team + reorder team)
        // * dragging from team to division (remove from team + reorder division)
        // * dragging from team to team (remove from team + add to team + reorder team)
        sortables.sortable({
            handle: '.grip',
            connectWith: sortables,
            stop: function(event, ui) {
                var dragged      = ui.item,
                    from         = $(event.target),
                    fromFeedback = from.closest('[data-team], [data-division]').find('[data-relation="save-label"]'),
                    to           = dragged.closest(sortables),
                    toFeedback   = to.closest('[data-team], [data-division]').find('[data-relation="save-label"]');
                if (from.is(to)) {
                    // Reordering either within team or division:
                    // action is the same
                    fromFeedback.labelActivate({text: 'Saving order...'});
                    saveOrdering(from)
                        .done(function() {
                            fromFeedback.labelTimeout({text: 'Saved!', css: 'success'});
                        })
                        .fail(function() {
                            fromFeedback.labelTimeout({text: 'Save failed!', css: 'alert'});
                        });

                } else if (from.is('[data-team-player-list]') && to.is('[data-team-player-list]')) {
                    // Move between teams (remove from team + add to team, reorder team)
                    // Remove+add first as player must be in team before reordering
                    fromFeedback.labelActivate({text: 'Removing from team...'});
                    toFeedback.labelActivate({text: 'Adding to team...'});
                    $.when(
                        postPlayer(dragged.data('player'), from.data('removePlayersAction')),
                        postPlayer(dragged.data('player'), to.data('addPlayersAction'))
                    )
                        .then(function() {
                            return saveOrdering(to);
                        })
                        .done(function(response) {
                            refreshPlayerList(response);

                            /* ha
                             */
                            uniqueCollapserInitialState($('#allTeams').find('[data-team]'));
                            uniqueCollapser();
                        })
                        .done(function() {
                            fromFeedback.labelTimeout({text: 'Removed!', css: 'success'});
                            toFeedback.labelTimeout({text: 'Added!', css: 'success'});
                        })
                        .fail(function() {
                            fromFeedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                            toFeedback.labelTimeout({text: 'Add failed!', css: 'alert'});
                        });

                }
                else if (from.is('[data-division-player-list]') && to.is('[data-team-player-list]')) {
                    // Move from division to team (add to team, reorder team)
                    // Add first as player must be in team before reordering
                    toFeedback.labelActivate({text: 'Adding to team...'});

                    postPlayer(dragged.data('player'), to.data('addPlayersAction'))
                        .then(function() {
                            return saveOrdering(to);
                        })
                        .done(function(response) {
                            refreshPlayerList(response);

                            /* ha
                             */
                            uniqueCollapserInitialState($('#allTeams').find('[data-team]'));
                            uniqueCollapser();
                        })
                        .done(function() {
                            toFeedback.labelTimeout({text: 'Added!', css: 'success'});
                        })
                        .fail(function() {
                            toFeedback.labelTimeout({text: 'Add failed!', css: 'alert'});
                        });

                } else if (from.is('[data-team-player-list]') && to.is('[data-division-player-list]')) {
                    // Move from team to division (remove from team + reorder division)
                    fromFeedback.labelActivate({text: 'Removing from team...'});
                    toFeedback.labelActivate({text: 'Saving order...'});
                    $.when(postPlayer(dragged.data('player'), from.data('removePlayersAction')))
                        .then(function() {
                            return saveOrdering(to);
                        })
                        .done(function(response) {
                            refreshPlayerList(response);

                            /* ha
                             */
                            uniqueCollapserInitialState($('#allTeams').find('[data-team]'));
                            uniqueCollapser();
                        })
                        .done(function() {
                            fromFeedback.labelTimeout({text: 'Removed!', css: 'success'});
                            toFeedback.labelTimeout({text: 'Saved!', css: 'success'});
                        })
                        .fail(function() {
                            fromFeedback.labelTimeout({text: 'Remove failed!', css: 'alert'});
                            toFeedback.labelTimeout({text: 'Save failed!', css: 'alert'});
                        });
                }
            }
        });

        connectPlayerPositionButtons();
        uniqueCollapser();

        /**
         *  Make a unique collapser
         *
         * For every data-collapser that exists, hide all the data-player
         * elements inside if its current state is uncollapsed; if its
         * current state is collapsed, show all the data-player elements
         */
        function uniqueCollapser(allTeams) {
            $('#allTeams').find('[data-collapser]').each(function (index, element) {
                $(element).on('click', function () {
                    var teamId = $(element).attr('data-collapser');
                    var teamContainer = $('[data-team=' + teamId + ']');

                    var isCollapsed = teamContainer.data('data-collapse-state') == 'collapsed';

                    if (isCollapsed) {
                        teamContainer.attr('id', teamId);
                        teamContainer.find('[data-player]').show();
                        teamContainer.data('data-collapse-state', 'uncollapsed');
                        $(element).removeClass().addClass('icon-down-arrow');
                    }
                    else {
                        teamContainer.attr('id', teamId);
                        teamContainer.find('[data-player]').hide();
                        teamContainer.data('data-collapse-state', 'collapsed');
                        $(element).removeClass().addClass('icon-up-arrow');
                    }
                });
            });
        }

        /**
         * Collapser for a particular team
         * Sets initial state and *maintains it*
         */
        function uniqueCollapserInitialState(allTeams) {
            allTeams.each(function(index, element) {
                var teamContainer = $(element);

                var isCollapsed = teamContainer.data('data-collapse-state') == 'collapsed';

                if (isCollapsed) {
                    teamContainer.find('[data-player]').hide();
                    teamContainer.data('data-collapse-state', 'collapsed');
                    $(element).removeClass().addClass('icon-up-arrow');
                }
                else {
                    teamContainer.find('[data-player]').show();
                    teamContainer.data('data-collapse-state', 'uncollapsed');
                    $(element).removeClass().addClass('icon-down-arrow');
                }
            });
        }
    });
</script>
