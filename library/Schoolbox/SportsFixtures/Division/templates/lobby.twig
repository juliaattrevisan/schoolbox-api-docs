{##
 # Template variables:
 #
 # user:                   the logged-in user
 # uploadZone.twigContext: values for rendering the attach zone
 # division:               the division
 # players:                the players in the division
 # players[].player:       the player data for each division player
 # players[].teams[]:      the teams that the division player is in
 # teams:                  the teams in the division
 # teams[].team:           the team data for each division team
 # teams[].players[]:      the player data for each division team
 #}
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/shared/sportsfixtures/jquery.division-lobby.js"></script>
<script type="text/javascript">
    $(function() {
        $('[data-division-player-list], [data-team-player-list], [data-team-player-list-proxy]').divisionLobby();
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures',          routeLookup('sportsfixtures.getLanding') ],
    [ 'Sports',            routeLookup('sportsfixturesSport.getList') ],
    [ division.sport.name, routeLookup('sportsfixturesSport.getEntity', { entityId: division.sport.id }) ],
    [ division.name ]
) }}

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>{{ division.name }} {{ division.sport.name }} Lobby</h1>
        </div>
    </div>
    {% if division.teams | length %}
    <nav>
        <a href="{{ routeLookup('sportsfixturesMatch.getList', { contextId: division.id }) }}" class="icon-match" title="View Fixture"></a>
    </nav>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 medium-6 island">
        <div class="actions-small-2 row">
            <div class="list-item">
                <div class="small-12 column">
                    <h2 class="subheader">Players</h2>
                </div>
            </div>
            <nav>
                <a href="#" class="icon-add" title="Add Players" data-reveal-id="addPlayersModal"></a>
                <a href="#" class="icon-upload" title="Upload Player List" data-reveal-id="uploadPlayersModal"></a>
            </nav>
        </div>
        <div class="row">
            <div class="small-12 column">
                <div class="content">
                    <select id="player-filter">
                        <option value="0">Show All Players</option>
                        <option value="1" selected>Show Unassigned Players</option>
                        <option value="2">Show Assigned Players</option>
                    </select>
                </div>
            </div>
        </div>

        {% if players is not empty %}
            {% include '@sportsfixturesDivision/lobby/division.twig' with {
                division: division,
                players: players,
                teams: teams,
                assigned: assigned
            } only %}
        {% else %}
            <div class="empty-state">
                <i class="icon-group"></i>
                <p>There are no Players in {{ division.name }}.</p>
                <p>
                    You may <a href="#" title="Add Players" data-reveal-id="addPlayersModal">add players by name</a>,
                    or <a href="#" title="Upload Player List" data-reveal-id="uploadPlayersModal">upload a list</a>.
                </p>
            </div>
        {% endif %}
    </div>
    <div class="small-12 medium-6 island">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 column">
                    <h2 class="subheader">Teams</h2>
                </div>
            </div>
            <nav>
                <a href="{{ routeLookup('sportsfixturesTeam.getCreateForm', {contextId: division.id}) }}" class="icon-add" title="Add Team"></a>
            </nav>
        </div>

        {% if teams is not empty %}
            {% for teamData in teams %}
                {% include '@sportsfixturesDivision/lobby/team.twig' with {
                    team: teamData.team,
                    players: teamData.players,
                    positions: teamData.positions
                } only %}
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <i class="icon-sport"></i>
                <p>There are no Teams in {{ division.name }}.</p>
                <p><a href="{{ routeLookup('sportsfixturesTeam.getCreateForm', {contextId: division.id}) }}" title="Add a Team">Add a Team</a></p>
            </div>
        {% endif %}
    </div>
</div>

<div id="addPlayersModal" class="reveal-modal" data-reveal aria-labelledby="addPlayersModalTitle" aria-hidden="true" role="dialog">
    <h2 id="addPlayersModalTitle">Add Players</h2>
    <form action="{{ routeLookup('sportsfixturesDivision.postAddPlayers', {entityId: division.id}) }}" method="post">
        <select data-role="userSelector" name="userId[]" multiple placeholder="Search Users"></select>
        <input type="submit" class="full-width" value="Add" />
    </form>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

{# Change player positions modal #}

<div id="editPlayerPositions" class="reveal-modal" data-reveal aria-labelledby="editPlayerPositionsModalTitle" aria-hidden="true" role="dialog">
    <h2 id="editPlayerPositionsModalTitle">Change Player Positions</h2>
    <form action="{{ routeLookup('sportsfixturesDivision.postPlayerPositions', {entityId: division.id}) }}" method="post">
        <input type="hidden" name="team_id" id="playerPositionTeamId">
        <input type="hidden" name="user_id" id="playerPositionUserId">
        <fieldset class="checklist" data-equalizer-watch="">
            <legend id="playerPositionName"></legend>
            {% for position in positions %}
                <input data-position id="position-{{ position.id }}" name="positions[]" value="{{ position.id }}" type="checkbox"><label for="position-{{ position.id }}">{{ position.name }}</label>
            {% endfor %}
        </fieldset>
        <input type="submit" class="full-width" value="Save Changes" />
    </form>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<div id="uploadPlayersModal" class="reveal-modal" data-reveal aria-labelledby="uploadPlayersModalTitle" aria-hidden="true" role="dialog">
    <h2 id="uploadPlayersModalTitle">Upload Player List</h2>
    <form action="{{ routeLookup('sportsfixturesDivision.postUploadPlayers', {entityId: division.id}) }}" method="post">
        <p>
            You may upload a list of Schoolbox User IDs, usernames or external IDs into this division.
            Make sure that it conforms to the <a href="/sportsfixtures/import/userTemplate.csv">template</a> provided.
        </p>

        {% if user.isSuperuser %}
            {# Show only superusers the role report link, as only they can see it #}
            <p>
                You may also download a report from the
                <a href="/adminv2/home" target="_blank">Role Statistics section in Administration</a>,
                and use it as the list of users to upload.
            </p>
        {% endif %}

        {% include 'sub/attachzone.twig' with { attachzone: uploadZone.twigContext } %}
        <ul class="flex-list buttons">
            <li><a href="/sportsfixtures/import/userTemplate.csv" class="button">Download Template</a></li>
            <li><input type="submit" class="full-width" value="Upload" /></li>
        </ul>
    </form>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>
