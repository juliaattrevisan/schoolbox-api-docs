<script type="text/javascript">
    $(function() {
        $('#allSports').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Division?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {divisionId: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="#">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {sportId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getUpdate', {divisionId: division.id}) }}">{{ division.name }}</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesDivision.getLobby', {divisionId: division.id}) }}">Division Lobby</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-6 island">
        <h2 class="subheader">Players</h2>
        {% if players is not empty %}
            <ul class="information-list">
                <section>
                    {% for currentPlayer in players %}
                        <li>
                            <div class="list-item">
                                <div class="small-12 avatar card">
                                    <a href="/search/user/{{ currentPlayer.user.getId() }}">
                                        <img src="/portrait.php?userId={{ currentPlayer.user.getExternalId() }}&amp;size=square64" />
                                        <h3>{{ currentPlayer.user.formatName() }}</h3>
                                    </a>
                                    <p class="meta">{{ currentPlayer.user.formatMetadata() }}</p>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </section>
            </ul>
        {% else %}
            <div class="empty-state">
                <i class="icon-group"></i>
                <p>There are no Players in {{ division.getName() }}.</p>
                <p><a href="#" title="Add Players">Add Players</a></p>
            </div>
        {% endif %}
    </div>

    <div class="hide-for-small medium-6 island">
        <h2 class="subheader">Teams</h2>
        {% if teams is not empty %}
            <section>
                <ul class="information-list">
                    {% for currentTeam in teams %}
                        <li>
                            <div class="list-item">
                                <div class="small-12 avatar card">
                                    <h3>{{ currentTeam.getName() }}</h3>
                                    <p><a href="{{ currentTeam.getUrl() }}">{{ currentTeam.getUrl() }}</a>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-sport"></i>
                <p>There are no Teams in {{ division.getName() }}.</p>
                <p><a href="{{ routeLookup('sportsfixturesTeam.getCreate', {divisionId: division.id}) }}" title="Add a Team">Add a Team</a></p>
            </div>
        {% endif %}
    </div>
</div>
