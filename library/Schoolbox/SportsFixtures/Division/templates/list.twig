<script type="text/javascript">
    $(function() {
        $('#allSports').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Division?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allSports">

        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">{{ sport.name }}</h2>
                </div>
            </div>
            <nav>
                <a href='{{ routeLookup('sportsfixturesDivision.getCreateForm', {contextId: sport.id}) }}' class="icon-add" title="Add Division to {{ sport.name }}"></a>
            </nav>
        </div>

        {% if allDivisions|length %}
        <section>
            <ul class="action-list">
                {% for currentDivision in allDivisions %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <p>{{ currentDivision.name }}</p>
                            <p><a href="{{ currentDivision.url }}">{{ currentDivision.url }}</a>
                        </div>
                    </div>
                    <nav>
                        <a href="#" class="icon-more" data-dropdown="sportsfixtures-division-{{ currentDivision.getId() }}-actions"></a>
                    </nav>
                    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-division-{{ currentDivision.getId() }}-actions">
                        <li><a href="{{ routeLookup('sportsfixturesDivision.getLobby', {entityId: currentDivision.id}) }}" class="icon-group" title="Manage Players in {{ currentDivision.name }}">Manage Players</a></li>
                        <li><a href="{{ routeLookup('sportsfixturesTeam.getList', {contextId: currentDivision.id}) }}" class="icon-list" title="Manage Teams in {{ currentDivision.name }}">Manage Teams</a></li>
                        <li><a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: currentDivision.id}) }}" class="icon-list" title="Manage Matches in {{ currentDivision.name }}">Manage Matches</a></li>
                        <li><a href="{{ routeLookup('sportsfixturesDivision.getModifyForm', {entityId: currentDivision.id}) }}" class="icon-modify" title="Modify">Modify</a></li>
                        <li><a href="{{ routeLookup('sportsfixturesDivision.deleteEntity', {entityId: currentDivision.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentDivision.id }}">Delete</a></li>
                    </ul>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-sport"></i>
            <p>There are no Divisions in {{ sport.name }}.</p>
            <p><a href="{{ routeLookup('sportsfixturesDivision.getCreateForm', {contextId: sport.id}) }}" title="Add a Division">Add a Division</a></p>
        </div>
        {% endif %}
    </div>
</div>
