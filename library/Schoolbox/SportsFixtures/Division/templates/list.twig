<script type="text/javascript">
    $(function() {
        $('#allSports').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this item?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {id: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="#">Sports Fixtures</a></li>
    <li><a href="#">Division</a></li>
    <li class="active"><a href="#">List</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allSports">

        {% for id, sportData in allSports %}
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">{{ sportData.sport.name }}</h2>
                </div>
            </div>
            <nav>
                <a href='/sportsfixtures/division/create/{{ sportData.sport.id }}' class="icon-add" title="Add Division to {{ sportData.sport.name }}"></a>
            </nav>
        </div>

        <section>
            <ul class="information-list">
                <li>
                    <ul class="action-list">
                        {% for currentDivision in sportData.allDivisions %}
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="small-12 avatar card">
                                    <p>{{ currentDivision.name }}</p>
                                </div>
                            </div>
                            <nav>
                                <a href="/sportsfixtures/division/delete" class="icon-delete" title="Delete" data-delete="{{ currentDivision.id }}"></a>
                                <a href="/sportsfixtures/division/update/{{ currentDivision.id }}" class="icon-modify" title="Modify"></a>
                            </nav>
                        </li>
                        {% endfor %}
                    </ul>
                </li>
            </ul>
        </section>
        {% endfor %}
    </div>
</div>