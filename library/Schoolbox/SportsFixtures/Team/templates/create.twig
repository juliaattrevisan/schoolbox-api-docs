<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript">
    $(function() {
        $('#teamForm').alaressValidate({
            rules: {
                name: {
                    required: true,
                    minlength: 2
                },
                divisionId: {
                    min: 1
                }
            },
            messages: {
                'divisionId': 'Please choose a Division.',
                'name': 'Please enter a Team name.'
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        });

        // Selectize box for selecting one or more users
        // This box allows freetext entry, because of the requirement that
        // coaches won't always be Schoolbox users.
        var selector = $('[data-role="userSelector"]');
        selector
            .selectizeSelector({
                multiple: true,
                ajax: {
                    url:      '/ajax/tags/sport_coach',
                    type:     'GET',
                    dataType: 'json'
                },
                selectize: {
                    create: function(input) {
                        var freeEntry = {};
                        freeEntry[this.settings.valueField]  = 'newFromInput:'+input;
                        freeEntry[this.settings.searchField] = input;
                        return freeEntry;
                    }
                },
                value: $.selectizeSelector.getValueFromSelect(selector)
            });
    });
</script>

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesTeam.getList', {contextId: division.id}) }}">Teams in {{ division.name }}</a></li>

    {% if team.id %}
    <li class="active"><a href="{{ routeLookup('sportsfixturesTeam.getModifyForm', {entityId: team.id}) }}">{{ team.name }}</a></li>
    {% else %}
    <li class="active"><a href="#">{{ action }}</a></li>
    {% endif %}
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if team %}
            {% set formUrl = routeLookup('sportsfixturesTeam.updateEntity', {entityId: team.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesTeam.createEntity', {contextId: division.id}) %}
        {% endif %}

        <form id='teamForm' action="{{ formUrl }}" method="post">
            <h2 class="subheader">{{ action }} Team in {{ division.name }}</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="hidden" name="divisionId" value="{{ division.id }}"/>
                        <input type="hidden" name="teamId" value="{{ team.id }}"/>

                        <label>
                            Name
                            <input type="text" name="name" value="{{ team.name }}"/>
                        </label>

                        <label>
                            Url
                            <input type="text" name="url" value="{{ team.url }}" />
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Coaches
                            <select type="text" data-role="userSelector" name="coach[]" multiple placeholder="Search Users">
                            {% for coach in team.coaches %}
                                <option selected value="{{ coach.formatId }}">{{ coach.formatName }}</option>
                            {% endfor %}
                            </select>
                        </label>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Team" />
        </form>
    </div>
</div>
