<script type="text/javascript">
    $(function() {
        $('#allTeams').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Team?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {teamId: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="#">Sports Fixtures</a></li>
    <li><a href="/sportsfixtures/sport/list">All Sports</a></li>
    <li><a href="/sportsfixtures/division/list/{{ sport.id }}">Divisions in {{ sport.name }}</a></li>
    <li><a href="/sportsfixtures/division/update/{{ division.id }}">{{ division.name }}</a></li>
    <li class="active"><a href="/sportsfixtures/team/list/{{ division.id }}">Teams in {{ division.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allTeams">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">{{ division.name }}</h2>
                </div>
            </div>
            <nav>
                <a href='/sportsfixtures/team/create/{{ division.id }}' class="icon-add" title="Add Team to {{ division.name }}"></a>
            </nav>
        </div>

        {% if allTeams|length %}
        <section>
            <ul class="action-list">
                {% for currentTeam in allTeams %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <p>{{ currentTeam.name }}</p>
                        </div>
                    </div>
                    <nav>
                        <a href="/sportsfixtures/team/delete" class="icon-delete" title="Delete" data-delete="{{ currentTeam.id }}"></a>
                        <a href="/sportsfixtures/team/update/{{ currentTeam.id }}" class="icon-modify" title="Modify"></a>
                    </nav>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-sport"></i>
            <p>There are no Teams in {{ division.name }}.</p>
            <p><a href="/sportsfixtures/team/create/{{ division.id }}" title="Add a Team">Add a Team</a></p>
        </div>
        {% endif %}
    </div>
</div>