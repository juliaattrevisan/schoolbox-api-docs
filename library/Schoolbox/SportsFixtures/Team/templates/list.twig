<script type="text/javascript">
    $(function() {
        $('#allTeams').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);
            var $team   = element.closest('[data-team]');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Team?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {teamId: element.attr('data-delete')}, function() {

                        // Is this the last team in the division ?
                        if( 1 == $('[data-team]').length){
                            window.location.href = window.location.href;
                        } else {
                            $team.fadeOut({ done: $team.remove() });
                        }
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesTeam.getList', {contextId: division.id}) }}">Teams in {{ division.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allTeams">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">{{ division.name }}</h2>
                </div>
            </div>
            {% if not division.season.isArchived %}
            <nav>
                <a href='{{ routeLookup('sportsfixturesTeam.getCreateForm', {contextId: division.id}) }}' class="icon-add" title="Add Team to {{ division.name }}"></a>
            </nav>
            {% endif %}
        </div>

        {% if allTeams|length %}
        <section>
            <ul class="action-list">
                {% for currentTeam in allTeams %}
                <li class="actions-small-1" data-team>
                    <div class="list-item">
                        <div class="small-12 card">
                            <h3>{{ currentTeam.name }}</h3>
                            <p class="meta"><a href="{{ currentTeam.url }}">{{ currentTeam.url }}</a>
                        </div>
                    </div>
                    <nav>
                        {% if not division.season.isArchived %}
                            <a href="{{ routeLookup('sportsfixturesTeam.getModifyForm', {entityId: currentTeam.id}) }}" class="icon-modify" title="Modify"></a>
                        {% endif %}

                        <a href="#" class="icon-more" data-dropdown="sportsfixtures-team-{{ currentTeam.getId() }}-actions"></a>
                    </nav>
                    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-team-{{ currentTeam.getId() }}-actions">
                        <li><a href="{{ routeLookup('sportsfixturesTeam.deleteEntity', {entityId: currentTeam.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentTeam.id }}">Delete</a></li>
                    </ul>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-team"></i>
            <p>There are no Teams in {{ division.name }}.</p>
            <p><a href="{{ routeLookup('sportsfixturesTeam.getCreateForm', {contextId: division.id}) }}" title="Add a Team">Add a Team</a></p>
        </div>
        {% endif %}
    </div>
</div>
