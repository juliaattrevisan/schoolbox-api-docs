<script type="text/javascript">
    $(function() {
        $('#allTeams').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Team?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {teamId: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="#">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {sportId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getUpdate', {divisionId: division.id}) }}">{{ division.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesTeam.getList', {divisionId: division.id}) }}">Teams in {{ division.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allTeams">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">{{ division.name }}</h2>
                </div>
            </div>
            <nav>
                <a href='{{ routeLookup('sportsfixturesTeam.getCreate', {divisionId: division.id}) }}' class="icon-add" title="Add Team to {{ division.name }}"></a>
            </nav>
        </div>

        {% if allTeams|length %}
        <section>
            <ul class="action-list">
                {% for currentTeam in allTeams %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <p>{{ currentTeam.name }}</p>
                            <p><a href="{{ currentTeam.url }}">{{ currentTeam.url }}</a>
                        </div>
                    </div>
                    <nav>
                        <a href="{{ routeLookup('sportsfixturesTeam.postDelete', {}) }}" class="icon-delete" title="Delete" data-delete="{{ currentTeam.id }}"></a>
                        <a href="{{ routeLookup('sportsfixturesTeam.getUpdate', {teamId: currentTeam.id}) }}" class="icon-modify" title="Modify"></a>
                    </nav>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-sport"></i>
            <p>There are no Teams in {{ division.name }}.</p>
            <p><a href="{{ routeLookup('sportsfixturesTeam.getCreate', {divisionId: division.id}) }}" title="Add a Team">Add a Team</a></p>
        </div>
        {% endif %}
    </div>
</div>