<script type="text/javascript">
    $(function() {
        $('#allSports').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Position?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {positionId: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="#">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesPosition.getList', {sportId: sport.id}) }}">Positions in {{ sport.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allSports">

        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">{{ sport.name }}</h2>
                </div>
            </div>
            <nav>
                <a href='{{ routeLookup('sportsfixturesPosition.getCreate', {sportId: sport.id}) }}' class="icon-add" title="Add Position to {{ sport.name }}"></a>
            </nav>
        </div>

        {% if allPositions|length %}
            <section>
                <ul class="action-list">
                    {% for currentPosition in allPositions %}
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="small-12 avatar card">
                                    <p>{{ currentPosition.name }}</p>
                                    <p><a href="{{ currentPosition.url }}">{{ currentPosition.url }}</a>
                                </div>
                            </div>
                            <nav>
                                <a href="{{ routeLookup('sportsfixturesPosition.postDelete', {}) }}" class="icon-delete" title="Delete" data-delete="{{ currentPosition.id }}"></a>
                                <a href="{{ routeLookup('sportsfixturesPosition.getUpdate', {positionId: currentPosition.id}) }}" class="icon-modify" title="Modify"></a>
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-sport"></i>
                <p>There are no Positions in {{ sport.name }}.</p>
                <p><a href="{{ routeLookup('sportsfixturesPosition.getCreate', {sportId: sport.id}) }}" title="Add a Position">Add a Position</a></p>
            </div>
        {% endif %}
    </div>
</div>