<script type="text/javascript" src="/javascript/shared/jquery.toast-timeout.js"></script>
<script type="text/javascript" src="/javascript/shared/sportsfixtures/jquery.mightyList.js"></script>
<script type="text/javascript">
    $(function() {
        $('#allSchools').mightyList({
            deleteKey: 'id',
            templateSelector: '[data-clone]'
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'External Schools' ]
) }}


<div class="row">
    <div class="small-12 columns">
        <h1>External Schools</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allSchools">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">External Schools</h2>
                </div>
            </div>
            <nav>
                <a href="#" data-item-add class="icon-add" title="Add School"></a>
            </nav>
        </div>
        <section>
            <ul class="information-list hide" data-item-list>
                {% for school in schools %}
                    <li class="actions-small-1" data-item="{{ school.id }}">
                        {% include '@sportsfixturesSchool/listItem.twig' %}
                    </li>
                {% endfor %}
            </ul>
        </section>
        <div id="schoolEmpty" class="empty-state hide">
            <i class="icon-match"></i>
            <p>There are currently no external schools.</p>
            <p><a href="#" data-item-add>Add a school</a></p>
        </div>
        <ul class="information-list hide">
            <li data-clone class="actions-small-1" data-item>
                {% include '@sportsfixturesSchool/listItem.twig' %}
            </li>
        </ul>
    </div>
</div>
