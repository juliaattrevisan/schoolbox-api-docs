{% if matches | length %}

    <div class="small-12 columns no-pad">
        <ul class="action-list">

            {% for match in matches %}

                {% set cardHeader %}
                    <h3>
                        {% if match.match.name|length %}
                            {{ match.match.name }} ({{ match.match.homeTeam.name }} vs {{ match.match.awayTeam.name }})
                        {% else %}
                            {{ match.match.homeTeam.name }} vs {{ match.match.awayTeam.name }}
                        {% endif %}
                    </h3>
                {% endset %}
                {% set showJellytot = match.home and match.away and match.match.homeTeam.id != match.match.awayTeam.id %}

                {# both home and away - show link to results in jellytot #}
                <li {% if showJellytot %}class="actions-small-1"{% endif %}>
                    <div class="list-item">
                        <div class="card small-12">
                            {% if showJellytot %}
                                {{ cardHeader|raw }}
                            {% elseif match.home %}
                                <a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.match.id, teamId: match.match.homeTeam.id}) }}">
                                    {{ cardHeader|raw }}
                                </a>
                            {% elseif match.away %}
                                <a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.match.id, teamId: match.match.awayTeam.id}) }}">
                                    {{ cardHeader|raw }}
                                </a>
                            {% else %}
                                {{ cardHeader|raw }}
                            {% endif %}
                            <p class="meta">
                                <span data-tooltip title="{{ match.match.startAt.getLong }}">{{ match.match.startAt.getRelativeTime }}</span>
                            </p>
                            {% if role == 'parent' %}
                                {% for team in match.teams %}
                                    {% if team.children is not empty %}
                                        <p class="meta icon-group">
                                            {% for child in team.children %}
                                                {% if not loop.first and not loop.last %},{% endif %}
                                                {% if loop.last and not loop.first %}and{% endif %}
                                                <a href="/search/user/{{ child.getId }}">{{ child.formatName }}</a>

                                                {% if loop.last and not loop.first %}are{% endif %}
                                                {% if loop.last and loop.first %}is{% endif %}
                                            {% endfor %} playing for {{ team.team.name }}
                                        </p>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                    {% if showJellytot %}
                    <nav>
                        <a href="#" class="icon-more" data-dropdown="sportsfixtures-match-{{ match.match.id }}-actions"></a>
                    </nav>
                    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-match-{{ match.match.id }}-actions">
                        <li>
                            <a class="icon-match" href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.match.id, teamId: match.match.homeTeam.id}) }}">
                                {{ match.match.homeTeam.name }} Match Page
                            </a>
                        </li>
                        <li>
                            <a class="icon-match" href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.match.id, teamId: match.match.awayTeam.id}) }}">
                                {{ match.match.awayTeam.name }} Match Page
                            </a>
                        </li>
                    </ul>
                    {% endif%}
                </li>

            {% endfor %}

        </ul>
    </div>

{% else %}
    <div class="content">
        <p>
            {% if role == 'parent' %}
                Your children do not have any upcoming matches scheduled.
            {% elseif role == 'student' %}
                You have no upcoming matches scheduled.
            {% endif %}
        </p>
    </div>

{% endif %}
