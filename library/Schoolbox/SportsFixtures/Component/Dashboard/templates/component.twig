{% if role == 'parent' %}

    {% for match in matches %}

        <div class="small-12 columns no-pad">
            <ul class="action-list">
                <li>
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="{{ routeLookup('sportsfixturesMatch.getEntity', {entityId: match.match.id}) }}">
                                <h3>
                                    {{ match.match.name }} ({{ match.match.homeTeam.name }} vs {{ match.match.awayTeam.name }})
                                </h3>
                            </a>
                            <p class="meta">
                                <span data-tooltip title="{{ match.match.startAt.getLong }}">{{ match.match.startAt.getRelativeTime }}</span> |
                                {{ match.match.division.sport.name }} |
                                {{ match.match.division.name }} |
                                {{ match.match.venue.name }}
                            </p>
                            {% for team in match.teams %}
                                <p class="meta icon-group">
                                    {% for child in team.children %}
                                        {% if not loop.first and not loop.last %},{% endif %}
                                        {% if loop.last and not loop.first %}and{% endif %}
                                        <a href="/search/user/{{ child.getId }}">{{ child.firstname }} {{  child.lastname }}</a>

                                        {% if loop.last and not loop.first %}are{% endif %}
                                        {% if loop.last and loop.first %}is{% endif %}
                                    {% endfor %} playing for {{ team.team.name }}
                                </p>
                            {% endfor %}
                        </div>
                    </div>
                </li>
            </ul>
        </div>

    {% endfor %}

    {% if matches | length == 0 %}

        <div class="content">
            Your children do not have any upcoming matches scheduled.
        </div>

    {% endif %}

{% elseif role == 'student' %}

    {% if matches | length %}

        <div class="small-12 columns no-pad">
            <ul class="action-list">

                {% for match in matches %}

                    <li>
                        <div class="list-item">
                            <div class="card small-12">
                                <a href="{{ routeLookup('sportsfixturesMatch.getEntity', {entityId: match.id}) }}">
                                    <h3>
                                        {{ match.name }} ({{ match.homeTeam.name }} vs {{ match.awayTeam.name }})
                                    </h3>
                                </a>
                                <p class="meta">
                                    <span data-tooltip title="{{ match.startAt.getLong }}">{{ match.startAt.getRelativeTime }}</span> | {{ match.division.sport.name }} | {{ match.division.name }}
                                </p>
                            </div>
                        </div>
                    </li>

                {% endfor %}

            </ul>
        </div>

    {% else %}

        <div class="content">
            You have no upcoming matches scheduled.
        </div>

    {% endif %}

{% endif %}
