{% if matches | length %}

    <div class="small-12 columns no-pad">
        <ul class="action-list">

            {% for match in matches %}

                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: match.division.id}) }}">
                                <h3>{{ match.name }} ({{ teams[match.homeTeam.id] }} vs {% if match.awayTeam.id == null %}Unspecified Team{% else %}{{ teams[match.awayTeam.id] }}{% endif %})</h3>
                            </a>
                            <p class="meta">
                                <span data-tooltip title="{{ match.startAt.getLong }}">{{ match.startAt.getRelativeTime }}</span> | {{ sports[match.division.sport.id] }} | {{ match.division.name }}
                            </p>
                        </div>
                    </div>
                    <nav>
                        <a class="icon-view no-text" href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: match.division.id}) }}" title="View Match Details"></a>
                    </nav>
                </li>

            {% endfor %}

        </ul>
    </div>

{% else %}

    <div class="content">
        You have no upcoming matches scheduled.
    </div>

{% endif %}
