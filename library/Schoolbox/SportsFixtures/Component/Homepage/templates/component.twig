{% import '@sportsfixturesMatch/macro/heading.twig' as matchHeading %}

{% if matches | length %}
    <div class="small-12 columns no-pad">
        <ul class="action-list">

            {% for match in matches %}
                <li>
                    <div class="list-item">
                        <div class="card small-12">

                            <div class="row">
                                <div class="small-8 columns no-pad"><h3>{{ match.name }}</h3></div>
                                <div class="small-4 columns text-right"><span class="meta" data-tooltip title="{{ match.startAt.getLong }}">{{ match.startAt.getRelativeTime }}</span></div>
                            </div>

                            <div class="row">
                                <div class="small-5 columns no-pad">
                                    {{ match.homeTeam.name }}{{ match.results.first }}

                                </div>
                                <div class="small-2 columns text-center">vs</div>
                                <div class="small-5 columns text-right">
                                    {{ match.awayTeam.name }}

                                </div>
                            </div>


                            {% if match.homeTeam.id %}
                                <a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: match.homeTeam.id}) }}">{{ match.homeTeam.name }}</a>
                            {% endif %}



                            {% if match.name|length %}
                                <h3>{{ match.name }}: {{ matchHeading.generateWithResultLink(match) }}</h3>
                            {% else %}
                                <h3>{{ matchHeading.generateWithResultLink(match) }}</h3>
                            {% endif %}



                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
{% else %}
    <div class="content">
        <p>
            You have no upcoming matches scheduled.
        </p>
    </div>
{% endif %}
