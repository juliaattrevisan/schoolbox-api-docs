{# Use to generate the text for a breadcrumb node, for a Match
 #
 # Since the Match Name can be the actual name, or the amalgamation
 # of its constituent team names (either by local or faceless teams)
 # heaps of extra logic is required
 #
 # The breadcrumb node href is determined elsewhere
 #}
{% macro generate(match) %}
    {% if match.name %}
        {{ match.name }}
    {% else %}
        {{ match.homeTeam.name }} vs {{ match.awayTeam.name }}
    {% endif %}
{% endmacro %}