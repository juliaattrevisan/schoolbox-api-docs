{# Use to generate the text for a Match Page heading
 #
 # Since the Match Name can be the actual name, or the amalgamation
 # of its constituent team names (either by local or faceless teams)
 # heaps of extra logic is required
 #}
{% macro generate(match, schoolMapper) %}
    {% if match.name %}
        {{ match.name }}
    {% else %}

        {# Detect whether it's a faceless team or not
         # and thus display their name and link properly
         #}

        {# Home Team #}
        {% if match.homeSchoolId == null %}
            {% if match.homeTeam.url %}
                {% set homeTeamData = "<a href='" ~ match.homeTeam.url ~ "'>" ~ match.homeTeam.name ~ "</a>" %}
            {% else %}
                {% set homeTeamData = match.homeTeam.name %}
            {% endif %}
        {% else %}
            {%  set homeTeamData = schoolMapper.getTagName(match.homeSchoolId) %}
        {% endif %}

        {# Away Team #}
        {% if match.awaySchoolId == null %}
            {% if match.awayTeam.url %}
                {% set awayTeamData = "<a href='" ~ match.awayTeam.url ~ "'>" ~ match.awayTeam.name ~ "</a>" %}
            {% else %}
                {% set awayTeamData = match.awayTeam.name %}
            {% endif %}
        {% else %}
            {% set awayTeamData = schoolMapper.getTagName(match.awaySchoolId) %}
        {% endif %}

        {{ homeTeamData|raw }} vs {{ awayTeamData|raw }}
    {% endif %}
{% endmacro %}