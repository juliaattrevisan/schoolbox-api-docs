{# Use to generate the text for a Match Page heading
 # If the Team has a url, hyperlink it
 #
 # @var bool $decorated If true, includes html rendering for team urls
 #}
{% macro generate(match, schoolMapper, decorated) %}

    {# Home Team #}
    {% if match.homeTeam.url and decorated %}
        {% set homeTeamData = "<a href='" ~ match.homeTeam.url ~ "'>" ~ match.homeTeam.name ~ "</a>" %}
    {% else %}
        {% set homeTeamData = match.homeTeam.name %}
    {% endif %}

    {# Away Team #}
    {% if match.awayTeam.url and decorated %}
        {% set awayTeamData = "<a href='" ~ match.awayTeam.url ~ "'>" ~ match.awayTeam.name ~ "</a>" %}
    {% else %}
        {% set awayTeamData = match.awayTeam.name %}
    {% endif %}

    {{ homeTeamData|raw }} vs {{ awayTeamData|raw }}
{% endmacro %}