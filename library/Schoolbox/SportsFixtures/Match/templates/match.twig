{% import '@sportsfixturesMatch/macro/matchHeading.twig' as matchHeading %}

{% block breadcrumbs %}
{% endblock %}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ matchHeading.generate(match, schoolMapper) }}</h1>

        <ul class="meta">
            <li class="icon-calendar">{{ match.startAt.local }}</li>
            <li class="icon-location">{{ match.venue.name }}{% if match.venue.address %}<br />{{ match.venue.address }}{% endif %}</li>
        </ul>
    </div>
</div>

{% set mapUrl = 'https://maps.googleapis.com/maps/api/staticmap?center=' ~ match.venue.latitude ~ ',' ~ match.venue.longitude ~ '&maptype=roadmap&zoom=14&size=600x300&scale=2' %}

<div class="row">
    <div class="small-12 columns">
        <img src="{{ mapUrl }}" width="100%" />
    </div>
</div>
<div class="row">
    <div class="small-6 island">
        {% if teamMetadata.players.offset(team.id)|length %}

        <h2 class="subheader">{{ team.name }} Players</h2>
        <section>
            <ul class="information-list">
                {% for currentPlayer in teamMetadata.players.offset(team.id) %}
                <li>
                    <div class="card small-12">
                        <a href="/search/user/{{ currentPlayer.id }}" title="View Profile">
                            <img src="/portrait.php?userId={{ currentPlayer.externalId }}&size=square64" alt="View Profile" />
                            <p>{{ currentPlayer.fullname }}</p>
                        </a>
                        <p class="meta">{{ teamMetadata.positions.offset(team.id).offset(currentPlayer.id).position.name }}</p>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}
    </div>
    <div class="small-6 island">
        {% if match.itinerary|length %}
        <h2 class="subheader">Itinerary</h2>
        <section>
            <ul class="information-list">
                {% for currentItineraryItem in match.itinerary %}
                <li>
                    <div class="list-item">
                        <div class="card small-12 medium-6 large-4 wrap-down compact">
                            <span>{{ currentItineraryItem.startAt.local }}</span>
                        </div>
                        <div class="card small-12 medium-6 large-8 wrap-down compact">
                            <span class="meta">{{ currentItineraryItem.description }}</span>
                        </div>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% block results %}
        {% endblock %}
    </div>
</div>

