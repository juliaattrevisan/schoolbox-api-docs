{% import '@sportsfixturesMatch/macro/matchHeading.twig' as matchHeading %}
{% import '@sportsfixturesMatch/macro/matchMap.twig' as matchMap %}

{% if match.result.offset(team.id) %}
    {% set hasResult = true %}
{% else %}
    {% set hasResult = false %}
{% endif %}

{% block breadcrumbs %}
{% endblock %}

<div class="row">
    <div class="small-12 columns">
        <h1>
            {% if match.name %}
                {{ match.name }}
            {% else %}
                {{ matchHeading.generate(match, schoolMapper) }}
            {% endif %}
        </h1>

        <ul class="meta">
            {% if match.name %}
            <li class="icon-team" title="{{ matchHeading.generate(match, schoolMapper) }}">{{ matchHeading.generate(match, schoolMapper) }}</li>
            {% endif %}
            <li class="icon-calendar" title="{{ match.startAt.local }}">{{ match.startAt.local }} ({{ match.startAt.relativeTime }})</li>
            <li class="icon-location">
                <a href="{{ matchMap.generate(match.venue, googleApiKey) }}" title="Get Directions">{{ match.venue.name }}</a>

                {#{% if match.venue.address %}<br />#}
                    {#{{ match.venue.address }}#}
                {#{% endif %}#}
            </li>

            {# Needs to have icons for weather #}
            {% if forecast.hasResults %}
            <li>
                <img src="{{ forecast.icon }}" title="{{ forecast.condition }}" width="16" height="16" /> {{ forecast.condition }}
            </li>
            {% endif %}
        </ul>
    </div>
</div>

{% if hasResult %}
<div class="row">
    <div class="small-12 island">
        {% include '@sportsfixturesMatch/fragment/hasResult.twig' %}
    </div>
</div>
{% endif %}

{% if not hasResult %}
    <div class="row">
        <div class="small-12 columns">
            {% include '@sportsfixturesMatch/fragment/map.twig' %}
        </div>
    </div>
{% endif %}

<div class="row">
    {% if hasResult %}
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/players.twig' %}
        </div>
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/itinerary.twig' %}
        </div>
    {% else %}
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/itinerary.twig' %}
        </div>
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/players.twig' %}
        </div>
    {% endif %}
</div>

{% if not hasResult %}
<div class="row">
    <div class="small-12 columns">
        {% include '@sportsfixturesMatch/fragment/noResult.twig' %}
    </div>
</div>
{% endif %}


