{% import '@sportsfixturesMatch/macro/matchHeading.twig' as matchHeading %}

{% if match.result.offset(team.id) %}
    {% set hasResult = true %}
{% else %}
    {% set hasResult = false %}
{% endif %}

{% block breadcrumbs %}
{% endblock %}

<div class="row">
    <div class="small-12 columns">
        <h1>
            {% if match.name %}
                {{ match.name }}
            {% else %}
                {{ matchHeading.generate(match, schoolMapper) }}
            {% endif %}
        </h1>

        <ul class="meta">
            {% if match.name %}
            <li class="icon-team" title="{{ matchHeading.generate(match, schoolMapper) }}">{{ matchHeading.generate(match, schoolMapper) }}</li>
            {% endif %}
            <li class="icon-calendar" title="{{ match.startAt.local }}">{{ match.startAt.local }} ({{ match.startAt.relativeTime }})</li>
            <li class="icon-location">{{ match.venue.name }}{% if match.venue.address %}<br />{{ match.venue.address }}{% endif %}</li>
        </ul>
    </div>
</div>

{% if hasResult %}
<div class="row">
    <div class="small-12 island">
        {% include '@sportsfixturesMatch/fragment/hasResult.twig' %}
    </div>
</div>
{% endif %}

{% if not hasResult %}
    <div class="row">
        <div class="small-12 columns">
            {% include '@sportsfixturesMatch/fragment/map.twig' %}
        </div>
    </div>
{% endif %}

<div class="row">
    {% if hasResult %}
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/players.twig' %}
        </div>
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/itinerary.twig' %}
        </div>
    {% else %}
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/itinerary.twig' %}
        </div>
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/players.twig' %}
        </div>
    {% endif %}
</div>

{% if not hasResult %}
<div class="row">
    <div class="small-12 columns">
        {% include '@sportsfixturesMatch/fragment/noResult.twig' %}
    </div>
</div>
{% endif %}


