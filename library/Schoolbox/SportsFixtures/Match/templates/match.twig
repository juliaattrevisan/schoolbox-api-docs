{% import '@sportsfixturesMatch/macro/matchHeading.twig' as matchHeading %}

{% if match.result.offset(team.id) %}
    {% set hasResult = true %}
{% else %}
    {% set hasResult = false %}
{% endif %}

{% block breadcrumbs %}
{% endblock %}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ matchHeading.generate(match, schoolMapper) }}</h1>

        <ul class="meta">
            <li class="icon-calendar" title="{{ match.startAt.local }}"> <span class='has-tip tip-top' title="{{ match.startAt.local }}" data-tooltip="">{{ match.startAt.relativeTime }}</span></li>
            <li class="icon-location">{{ match.venue.name }}{% if match.venue.address %}<br />{{ match.venue.address }}{% endif %}</li>
        </ul>
    </div>
</div>

{% if hasResult %}
<div class="row">
    <div class="small-12 island">
        {% include '@sportsfixturesMatch/fragment/hasResult.twig' %}
    </div>
</div>
{% endif %}

{% if not hasResult %}
    <div class="row">
        <div class="small-12 columns">
            {% include '@sportsfixturesMatch/fragment/map.twig' %}
        </div>
    </div>
{% endif %}

<div class="row">
    {% if hasResult %}
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/players.twig' %}

        </div>
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/itinerary.twig' %}
        </div>
    {% else %}
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/itinerary.twig' %}
        </div>
        <div class="small-12 medium-6 island">
            {% include '@sportsfixturesMatch/fragment/players.twig' %}
        </div>
    {% endif %}
</div>

{% if not hasResult %}
<div class="row">
    <div class="small-12 columns">
        {% include '@sportsfixturesMatch/fragment/noResult.twig' %}
    </div>
</div>
{% endif %}


