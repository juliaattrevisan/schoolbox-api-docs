{% import '@sportsfixturesMatch/matchHeading.twig' as matchHeading %}

{% block breadcrumbs %}
{% endblock %}

<div class="row">
    <div class="small-12 columns">
        <h1>{{ matchHeading.generate(match, schoolMapper) }}</h1>

        <ul class="meta">
            <li class="icon-calendar">{{ match.startAt.local }}</li>
            <li class="icon-location">{{ match.venue.name }}</li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ match.name }}</h2>

        <section class="content">
            <div class="small-12 columns">
                <dl>
                    <dt>ID</dt>
                    <dd>{{ match.id }}</dd>

                    <dt>Name</dt>
                    <dd>{{ match.name }}</dd>

                    <dt>Venue</dt>
                    <dd>{{ match.venue.name }}</dd>

                    <dt>Starts</dt>
                    <dd>{{ match.startAt.database }}</dd>

                    {% if match.homeTeam.id and match.awayTeam.id %}
                        <dt>Teams</dt>
                        <dd>
                            {{ match.homeTeam.name }} vs {{ match.awayTeam.name }}
                        </dd>
                    {% endif %}

                    {% if match.itinerary|length %}
                        <dt>Itinerary</dt>
                        <dd>
                            <ul class="information-list">
                                {% for currentItineraryItem in match.itinerary %}
                                    <li>
                                        {{ currentItineraryItem.startAt.local }}:
                                        {{ currentItineraryItem.description }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </dd>
                    {% endif %}

                    <dt>Created</dt>
                    <dd>{{ match.createdAt.database }}</dd>

                    {% if not match.createdAt.eq(match.updatedAt) %}
                        <dt>Last Updated</dt>
                        <dd>{{ match.updatedAt.database }}</dd>
                    {% endif %}
                </dl>
            </div>
        </section>

        {% block results %}
        {% endblock %}
    </div>
</div>

