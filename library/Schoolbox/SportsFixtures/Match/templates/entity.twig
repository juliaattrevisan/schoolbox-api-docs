{% extends '@sportsfixturesMatch/match.twig' %}

{% block breadcrumbs %}
    <ul class="breadcrumb">
        <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
        <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
        <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
        <li><a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: division.id}) }}">Matches in {{ division.name }}</a></li>

        {% if match.id %}
            <li class="active"><a href="{{ routeLookup('sportsfixturesMatch.getEntity', {entityId: match.id}) }}">{{ match.name }}</a></li>
        {% else %}
            <li class="active"><a href="#">{{ action }}</a></li>
        {% endif %}
    </ul>
{% endblock %}

{% block results %}
    {% if match.result|length %}
    <h3 class="subheader">Results</h3>
    <section class="content">
        <div class="row">

            <div class="small-12 large-6 columns">
                {% if match.result.offset(match.homeTeam.id) %}
                <div class="actions-small-1 row">
                    <div class="list-item">
                        <div class="small-12 columns">
                            <h4>{{ match.homeTeam.name }}</h4>
                            {{ match.result.offset(match.homeTeam.id).description|raw }}
                        </div>
                    </div>
                    <nav>
                        <a href="{{ routeLookup('sportsfixturesResult.getModifyForm', {entityId: match.result[match.homeTeam.id].id}) }}" class="icon-modify" title="Modify"></a>
                    </nav>
                </div>
                {% elseif match.homeTeam.id %}
                <div class="empty-state">
                    <i class="icon-result"></i>
                    <p>There are no Results for the Home Team.</p>

                    <p><a href="{{ routeLookup('sportsfixturesResult.getCreateFormForTeam', {contextId: match.id, teamId: match.homeTeam.id}) }}" title="Add Results">Add Results for the Home Team.</a></p>
                </div>
                {% endif %}
            </div>

            <div class="small-12 large-6 columns">
                {% if match.result.offset(match.awayTeam.id) %}
                <div class="actions-small-1 row">
                    <div class="list-item">
                        <div class="small-12 columns">
                            <h4>{{ match.awayTeam.name }}</h4>
                            {{ match.result.offset(match.awayTeam.id).description|raw }}
                        </div>
                    </div>
                    <nav>
                        <a href="{{ routeLookup('sportsfixturesResult.getModifyForm', {entityId: match.result[match.awayTeam.id].id}) }}" class="icon-modify" title="Modify"></a>
                    </nav>
                </div>
                {% elseif match.awayTeam.id %}
                <div class="empty-state">
                    <i class="icon-result"></i>
                    <p>There are no Results for the Away Team.</p>

                    <p><a href="{{ routeLookup('sportsfixturesResult.getCreateFormForTeam', {contextId: match.id, teamId: match.awayTeam.id}) }}" title="Add Results">Add Results for the Away Team.</a></p>
                </div>
                {% endif %}
            </div>
        </div>
    </section>
    {% else %}
    <div class="empty-state">
        <i class="icon-result"></i>
        <p>There are no Results for this Match.</p>

        {% if match.homeTeam.id %}
            <p><a href="{{ routeLookup('sportsfixturesResult.getCreateFormForTeam', {contextId: match.id, teamId: match.homeTeam.id}) }}" title="Add Results">Add Results for the Home Team.</a></p>
        {% endif %}

        {% if match.awayTeam.id %}
            <p><a href="{{ routeLookup('sportsfixturesResult.getCreateFormForTeam', {contextId: match.id, teamId: match.awayTeam.id}) }}" title="Add Results">Add Results for the Away Team.</a></p>
        {% endif %}
    </div>
    {% endif %}
{% endblock %}
