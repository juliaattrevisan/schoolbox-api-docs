<li class="actions-small-2" data-match>
    <div class="list-item">
        <div class="small-12 avatar card">

            {% if not currentMatch.season.isArchived %}
                {% if currentMatch.name %}
                    <p>{{ currentMatch.name }}</p>
                    <p class="meta">{{ matchHeading.generateWithResultLink(currentMatch) }}</p>
                {% else %}
                    <p>{{ matchHeading.generateWithResultLink(currentMatch) }}</p>
                {% endif %}
            {% else %}
                {% if currentMatch.name %}
                    <p><del class="icon icon-archive" title="This match's season is archived.">{{ currentMatch.name }}</del></p>
                    <p class="meta">{{ matchHeading.generateWithResultLink(currentMatch) }}</p>
                {% else %}
                    <p>{{ matchHeading.generateWithResultLink(currentMatch) }}</p>
                {% endif %}
            {% endif %}

            <p class="meta">{{ currentMatch.startAt.getLocal }}</p>
        </div>
    </div>
    <nav>
        {% if not currentMatch.season.isArchived %}
            <a href="{{ routeLookup('sportsfixturesMatch.getModifyForm', {entityId: currentMatch.id}) }}" class="icon-modify" title="Modify"></a>
        {% endif %}
        <a href="#" class="icon-more" data-dropdown="sportsfixtures-match-{{ currentMatch.getId() }}-actions"></a>
    </nav>
    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-match-{{ currentMatch.getId() }}-actions">
        <li><a href="{{ routeLookup('sportsfixturesMatch.deleteEntity', {entityId: currentMatch.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentMatch.id }}">Delete</a></li>
    </ul>
</li>