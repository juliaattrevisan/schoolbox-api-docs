<script type="text/javascript" charset="utf-8" src="/javascript/components/jquery-timepicker-jt/jquery.timepicker.min.js"></script>
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript" src="/javascript/ckeditor/ckeditor.js"></script>
<script type="text/javascript" src="/javascript/shared/editor/jquery.editor.js"></script>

<script type="text/javascript">
    $(function() {
        $('#matchForm').alaressValidate({
            rules: {
                divisionId: {
                    required: true,
                    min: 1
                },
                venueId: {
                    required: true,
                    min: 1
                },
                seasonId: {
                    required: true,
                    minlength: 1
                },
                startAtDate: {
                    required: true,
                    minlength: 1
                },
                startAtTime: {
                    required: true,
                    minlength: 1
                },
                homeTeamId: {
                    required: true,
                    minlength: 1
                },
                awayTeamId: {
                    required: true,
                    minlength: 1
                }
            },
            messages: {
                'divisionId': 'Please choose a Division.',
                'venueId': 'Please choose a Venue.',
                'name': 'Please enter a Match name.',
                'seasonId': 'Please choose a Season',
                'startAtDate': 'Please choose a date.',
                'startAtTime': 'Please choose a time.'
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        });

        $('#matchForm').find('[data-itinerary-delete]').click(function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this item?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });

        $('#season').selectizeSelector({
            ajax: {
                url: '/sportsfixtures/seasons',
                type: 'GET',
                dataType: 'json'
            },
            {% if match.id %}
            value: {"id":{{ match.season.id }}, "name": "{{ match.season.name }} - {{ match.season.start.getLocalShort }} to {{ match.season.end.getLocalShort }}"},
            {% else %}
            value: {"id":{{ division.season.id }}, "name": "{{ division.season.name }} - {{ division.season.start.getLocalShort }} to {{ division.season.end.getLocalShort }}"},
            {% endif %}
            multiple: false,
            selectize: {
                score: function(search) {
                    return function(item) {
                        // Simply filter list, don't reorder
                        return -1 === item.name.indexOf(search) ? 0 : 1;
                    };
                },
            }
        });

        // Ensure match is scheduled within the season
        $('[data-datepicker]').datepicker( );

        $('#matchForm').find('[data-timepicker]').timepicker({
            appendTo: function ($input) {
                return $input.closest('.timepick');
            }
        });

        $('#homeTeam').selectizeSelector({
            ajax: {
                url:      '/sportsfixtures/divisions/{{ division.id }}/teams?schools=1',
                type:     'GET',
                dataType: 'json'
            },
            {% if match.homeTeam.id %}
            value: {"id":{{ match.homeTeam.id }},"name":"{{ match.homeTeam.name }}"},
            {% endif %}
            {% if match.homeSchoolId %}
            value: {"id":'{{ schoolToken }}{{ match.homeSchoolId }}',"name":"{{ schoolMapper.getTagName(match.homeSchoolId) }}"},
            {% endif %}
            multiple: false
        });

        $('#awayTeam').selectizeSelector({
            ajax: {
                url:      '/sportsfixtures/divisions/{{ division.id }}/teams?schools=1',
                type:     'GET',
                dataType: 'json'
            },
            {% if match.awayTeam.id %}
            value: {"id":{{ match.awayTeam.id }},"name":"{{ match.awayTeam.name }}"},
            {% endif %}
            {% if match.awaySchoolId %}
            value: {"id":'{{ schoolToken }}{{ match.awaySchoolId }}',"name":"{{ schoolMapper.getTagName(match.awaySchoolId) }}"},
            {% endif %}
            multiple: false
        });

        $('#venue').selectizeSelector({
            ajax: {
                url: '/sportsfixtures/venues',
                type: 'GET',
                dataType: 'json'
            },
            {% if match.venue.id %}
            value: {"id":{{ match.venue.id }}, "name": "{{ match.venue.name }}"},
            {% endif %}
            multiple: false
        });

        $('textarea').alaressEditor();
    });
</script>

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: division.id}) }}">Matches in {{ division.name }}</a></li>

    {% if match.id %}
        <li class="active"><a href="{{ routeLookup('sportsfixturesMatch.getModifyForm', {entityId: match.id}) }}">{{ match.name }}</a></li>
    {% else %}
        <li class="active"><a href="#">{{ action }}</a></li>
    {% endif %}
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if match %}
            {% set formUrl = routeLookup('sportsfixturesMatch.updateEntity', {entityId: match.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesMatch.createEntity') %}
        {% endif %}

        <form id='matchForm' action="{{ formUrl }}" method="post">
            <h2 class="subheader">{{ action }} Match in {{ division.name }}</h2>

            <section>
                <fieldset class="content">
                    <input type="hidden" name="divisionId" value="{{ division.id }}"/>
                    <input type="hidden" name="matchId" value="{{ match.id }}"/>

                    <div class="small-12 columns">
                        <label>
                            Name
                            <input type="text" name="name" value="{{ match.name }}"/>
                        </label>
                    </div>

                    <div class="column small-12 medium-4">
                        <label>
                            Season
                            <input id='season' name="seasonId" type='text' value='' placeholder="Search Seasons" />
                        </label>
                    </div>

                    <div class="column small-12 medium-4">
                        <label>
                            Date
                            <input type="text" name="startAtDate" placeholder="Date" data-datepicker value="{{ match.startAt.getLocalShort }}">
                        </label>
                    </div>

                    <div class="column small-12 medium-4">
                        <div class="timepick">
                            <label>
                                Time
                                <input type="text" name="startAtTime" autocomplete="off" placeholder="Start Time" class="ui-timepicker-input" data-timepicker value="{{ match.startAt.getTimeOnly }}">
                            </label>
                        </div>
                    </div>

                    <div class="small-12 columns">
                        <label>
                            Venue
                            <input id='venue' name="venueId" type='text' value='' placeholder="Search Venues" />
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Participating Teams</legend>
                    <div class="small-12 medium-6 columns">
                        <label>
                            Home
                            <input id='homeTeam' name="homeTeamId" type='text' value='' placeholder="Search Teams" />
                        </label>
                    </div>
                    <div class="small-12 medium-6 columns">
                        <label>
                            Away
                            <input id='awayTeam' name="awayTeamId" type='text' value='' placeholder="Search Teams" />
                        </label>
                    </div>
                </fieldset>

                {% if match.id %}
                <fieldset class="content">
                    <legend>Itinerary</legend>

                    <div class="small-12 columns">
                        {% if allItineraryItems|length %}
                            <ul class="action-list">
                                {% for currentItineraryItem in allItineraryItems %}
                                    <li class="actions-small-2">
                                        <div class="list-item">
                                            <div class="small-12 card">
                                                <p>{{ currentItineraryItem.startAt.local }}</p>
                                                <p class="meta">{{ currentItineraryItem.description }}</p>
                                            </div>
                                        </div>
                                        <nav>
                                            <a href="{{ routeLookup('sportsfixturesItineraryItem.deleteEntity', {entityId: currentItineraryItem.id}) }}" class="icon-delete" title="Delete" data-itinerary-delete="{{ currentItineraryItem.id }}"></a>
                                            <a href="{{ routeLookup('sportsfixturesItineraryItem.getModifyForm', {entityId: currentItineraryItem.id}) }}" class="icon-modify" title="Modify"></a>
                                        </nav>
                                    </li>
                                {% endfor %}
                            </ul>

                            <a href="{{ routeLookup('sportsfixturesItineraryItem.getCreateForm', {contextId: match.id}) }}" class="full-width button icon-add">Add Itinerary Item</a>
                        {% else %}
                            <div class="empty-state">
                                <i class="icon-itineraryitem"></i>
                                <p>There are no items in this Match's Itinerary.</p>
                                <p><a href="{{ routeLookup('sportsfixturesItineraryItem.getCreateForm', {contextId: match.id}) }}" title="Add an Itinerary Item">Add an Itinerary Item.</a></p>
                            </div>
                        {% endif %}
                    </div>
                </fieldset>
                {% endif %}

                <fieldset class="content">
                    <legend>Notes</legend>
                    <div class="small-12 columns">
                        <textarea name="notes">{{ match.notes }}</textarea>
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Match" />
        </form>
    </div>
</div>
