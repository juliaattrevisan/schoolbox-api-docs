<script type="text/javascript">
    $(function() {
        $('#allSports').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Match?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {positionId: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="#">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: division.id}) }}">Matches in {{ division.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allSports">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">Matches in {{ division.name }}</h2>
                </div>
            </div>
            <nav>
                <a href='{{ routeLookup('sportsfixturesMatch.getCreateForm', {contextId: division.id}) }}' class="icon-add" title="Add Match to {{ division.name }}"></a>
            </nav>
        </div>

        {% if allMatches|length %}
            <section>
                <ul class="action-list">
                    {% for currentMatch in allMatches %}
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="small-12 avatar card">
                                    <p>{{ currentMatch.name }}</p>
                                    <p class="meta">{{ currentMatch.startAt.getLocal }}</p>
                                </div>
                            </div>
                            <nav>
                                <a href="{{ routeLookup('sportsfixturesMatch.deleteEntity', {entityId: currentMatch.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentMatch.id }}"></a>
                                <a href="{{ routeLookup('sportsfixturesMatch.getModifyForm', {entityId: currentMatch.id}) }}" class="icon-modify" title="Modify"></a>
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-sport"></i>
                <p>There are no Matches in {{ division.name }}.</p>
                <p><a href="{{ routeLookup('sportsfixturesMatch.getCreateForm', {contextId: division.id}) }}" title="Add a Match">Add a Match</a></p>
            </div>
        {% endif %}
    </div>
</div>