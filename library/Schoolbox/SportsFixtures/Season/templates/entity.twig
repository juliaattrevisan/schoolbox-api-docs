<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSeason.getList', {}) }}">All Seasons</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesSeason.getEntity', {entityId: season.id}) }}">{{ season.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ season.name }}</h2>

        <section class="content">
            <div class="small-12 columns">
                <dl>
                    <dt>ID</dt>
                    <dd>{{ season.id }}</dd>

                    <dt>Name</dt>
                    <dd>{{ season.name }}</dd>

                    <dt>Start Date</dt>
                    <dd>{{ season.start.getDatabaseDate }}</dd>

                    <dt>End Date</dt>
                    <dd>{{ season.end.getDatabaseDate }}</dd>

                    {% if season.isArchived %}
                        <dt>Archived</dt>
                        <dd>{{ season.archivedAt.database }}</dd>
                    {% endif %}

                    <dt>Created</dt>
                    <dd>{{ season.createdAt.database }}</dd>

                    {% if not season.createdAt.eq(season.updatedAt) %}
                        <dt>Last Updated</dt>
                        <dd>{{ season.updatedAt.database }}</dd>
                    {% endif %}
                </dl>
            </div>
        </section>
    </div>
</div>
