{# Generic error modal #}
<div id="errorModal" class="reveal-modal" data-reveal aria-labelledby="errorModalTitle" aria-hidden="true" role="dialog">
    <h2>Error</h2>
    <p class="alert alert-box icon-alert">Something went wrong - maybe try reloading your page and trying again?</p>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>


{# Season deletion if divisions/matches still linked #}
<div id="deleteModal" class="reveal-modal" data-reveal aria-labelledby="deleteModalTitle" aria-hidden="true" role="dialog">
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
    <h2>Delete Season</h2>
    <input type="hidden" data-season value="">

    <p>There are <span data="division-count"></span> divisions and <span data="match-count"></span> matches currently linked to
        <strong><span data="season-name"></span></strong>.<br>What would you like to do with them?</p>

    <fieldset class="radiolist" data-equalizer-watch>
        <input type="radio" name="linkedEntities" value="move" id="linkedEntitiesMove" checked><label for="linkedEntitiesMove">Move divisions and matches to
            <select data="seasons">
                <option value="0" disabled selected>Select a season</option>
                {# Dynammically populated via JS to avoid moving to current season #}
            </select>
        </label>

        <input type="radio" name="linkedEntities" value="delete" id="linkedEntitiesDelete"><label for="linkedEntitiesDelete">Delete divisions and matches</label>
    </fieldset>

    <p class="alert-box warning icon-warning hide" data="alert-delete">Are you sure you really want to delete all divisions and matches linked to <strong><span data="season-name"></span></strong>? This cannot be undone</p>

    <ul class="flex-list buttons">
        <li><a href="#" class="button submit" data-action="confirm-delete" data-post-action="">Delete Season</a></li>
        <li><a href="#" class="button" data-action="cancel">Cancel</a></li>
    </ul>
</div>

<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript">
    $(function() {

        var $allSeasons = $('#allSeasons');

        // Delete season with linked divisions and/or matches
        var $deleteModal  = $('#deleteModal');
        var $alertDelete  = $deleteModal.find('[data=alert-delete]');
        var $radioMove    = $deleteModal.find('#linkedEntitiesMove');
        var $radioDelete  = $deleteModal.find('#linkedEntitiesDelete');
        var $selectMove   = $deleteModal.find('[data=seasons]');
        var $buttonDelete = $deleteModal.find('[data-action=confirm-delete]');
        $radioMove.add($radioDelete).on('change', function(){
            if($radioMove.prop('checked')){
                $alertDelete.addClass('hide');
                $selectMove.prop('disabled',false);
                $buttonDelete.attr('disabled', $selectMove[0].selectedIndex < 1 );
            } else {
                $alertDelete.removeClass('hide');
                $selectMove.prop('disabled',true);
                $buttonDelete.attr('disabled', false);
            }
        });

        // Did user select a season from the dropdown to move divisions/matches to ?
        $selectMove.on('change', function(){
            $buttonDelete.attr('disabled', $selectMove[0].selectedIndex < 1);
        });

        // Did user click an action button on the delete modal ?
        $deleteModal.on('click', 'a[data-action]', function(event) {
            event.preventDefault();
            var $button = $(this),
                action  = $button.data('action'),
                $season = $('[data-season='+$deleteModal.find('[data-season]').val()+']'),
                data    = {};

            $deleteModal.foundation('reveal', 'close');

            switch(action){
                case 'cancel':
                    return;
                case 'confirm-delete':
                    if($radioMove.prop('checked')){
                        data['cascade'] = 'move';
                        data['move'] = $selectMove.val();
                    } else {
                        data['cascade'] = 'delete';
                    }
                    break;
            }

            $.post($button.attr('data-post-action'), data)
                    .done(function() {
                        switch (action) {
                            case 'confirm-delete':
                                // If move, transfer division/match counts to other season
                                if('move' == data['cascade']){
                                    var $otherSeason = $('[data-season='+data['move']+']');
                                    $otherSeason.attr('data-division-count', parseInt($otherSeason.attr('data-division-count')) + parseInt($season.attr('data-division-count')));
                                    $otherSeason.attr('data-match-count', parseInt($otherSeason.attr('data-match-count')) + parseInt($season.attr('data-match-count')));
                                }
                                $season.fadeOut({ done: $season.remove() });

                                // Was this the last season ?
                                checkEmptyState();
                                break;
                        }
                    })
                    .fail(function() {
                        $('#errorModal').foundation('reveal', 'open');
                    });

        });






        // Archive / Restore / Delete AJAX actions
        $allSeasons.on('click', 'a[data-action]', function(event) {
            event.preventDefault();
            var     $button       = $(this),
                    action        = $button.data('action'),
                    $season       = $button.closest('[data-season]'),
                    divisionCount = $season.attr('data-division-count'),
                    divisionClass = 0 == divisionCount ? 'gradient-10' : 'gradient-1',
                    matchCount    = $season.attr('data-match-count'),
                    matchClass    = 0 == matchCount ? 'gradient-10' : 'gradient-1',
                    tenseClause   = action == 'restore' ? 'that were' : 'currently';

            var textQuestion = 'Are you sure you want to <strong>'+action+'</strong> this season?<br>';

            // Generate modal text
            if('delete' == action && 0 == divisionCount && 0 == matchCount){
                var textResults = 'There are no divisions or matches currently linked to this season.';
            } else {
                var textResults = 'This will <strong>'+action+'</strong> <span class="'+divisionClass+'">'+divisionCount+'</span> divisions and <span class="'+matchClass+'">'
                        +matchCount+'</span> matches '+tenseClause+' linked to this season, along with all their subsidiary entities';
            }
            var modalText = textQuestion + textResults;

            // Special case for deleting a season with divisions and/or matches currently linked to it
            if('delete' == action && (divisionCount > 0 || matchCount > 0)){
                resetDeleteModal($season);
                return;
            }


            $button.confirmDialog({
                text: modalText,
                format: 'html',
                confirmEvent: function(el) {
                    // AJAX, then update DOM
                    // Archive/restore: refresh list item
                    // Delete: remove completely

                    $.post(el.data('postAction'))
                            .done(function(data) {
                                switch (action) {
                                    case 'delete':
                                        $season.fadeOut({ done: $season.remove() });

                                        // Was this the last season ?
                                        checkEmptyState();
                                        break;
                                    case 'archive':
                                    case 'restore':
                                    default:
                                        var $newDom  = $(data);
                                        // Replace whole list item
                                        $season.replaceWith($newDom);

                                        // Force dropdown reset
                                        $deleteModal.find('[data-season]').val('')
                                        break;
                                }
                            })
                            .fail(function() {
                                $('#errorModal').foundation('reveal', 'open');
                            });
                }
            })
        });

        /**
         * Resets the season delete modal with data relevant to selected season
         *
         * @param $season jQuery object for season selected for deletion
         */
        function resetDeleteModal($season){
            $deleteModal.foundation('reveal', 'open');

            // Does modal need to be reset?  TODO
            if($deleteModal.find('[data-season]').val() != $season.data('season') ){

                // Populate fields and labels
                $deleteModal.find('[data-season]').val($season.data('season'));
                $deleteModal.find('[data=season-name]').html($season.data('name'));
                $buttonDelete.attr('data-post-action', $season.find('[data-action=delete]').data('post-action'));


                var divisionCount = $season.data('division-count');
                var divisionText = '<span class="gradient-'+(divisionCount > 0 ? '1' : '10') +'">'+divisionCount+'</span>';
                $deleteModal.find('[data=division-count]').html(divisionText);

                var matchCount = $season.data('match-count');
                var matchText = '<span class="gradient-'+(matchCount > 0 ? '1' : '10') +'">'+matchCount+'</span>';
                $deleteModal.find('[data=match-count]').html(matchText);

                // Populate dropdown
                $selectMove.find('option:not(:first-child)').remove();
                $.each($allSeasons.find('[data-season]'), function(idx, elem){
                    var $elem = $(elem);
                    // Filter out this season, and archived seasons
                    if($season.data('season') == $elem.data('season') || $elem.data('archived')){
                        // skip season
                    } else {
                        $selectMove.append($('<option>', {
                            value: $elem.data('season'),
                            text : $elem.data('name')
                        }));
                    }
                });
                $selectMove[0].selectedIndex = 0;
                $radioMove.trigger('click').trigger('change');
            }
        }

        /**
         * Checks how many seasons are in list, if 0, display the empty-state message
         */
        function checkEmptyState(){
            var $emptyState = $('[data-empty-state]');
            if($allSeasons.find('[data-season]').length){
                $emptyState.addClass('hide');
            } else {
                $emptyState.removeClass('hide');
            }
        }
    });
</script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'Seasons' ]
) }}

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Sports Fixtures</h1>
        </div>
    </div>
    <nav>
        <a href='{{ routeLookup('sportsfixturesSeason.getCreateForm', {}) }}' class="icon-add" title="Add Season"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island" id="allSeasons">
        {% if allSeasons|length %}
            <section>
                <ul class="information-list">
                    {% for currentSeason in allSeasons %}
                        {% include '@sportsfixturesSeason/listItem.twig' %}
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <div class="empty-state {% if allSeasons|length %}hide{% endif %}" data-empty-state>
            <i class="icon-season"></i>
            <p>There are no Seasons.</p>
            <p><a href="{{ routeLookup('sportsfixturesSeason.getCreateForm', {context: match.id}) }}" title="Add a Season">Add a Season</a></p>
        </div>
    </div>
</div>


