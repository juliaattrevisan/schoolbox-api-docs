<script type="text/javascript">
    $(function() {
        $('#allSeasons').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Season?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {seasonId: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesSeason.getList', {}) }}">All Seasons</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Sports Fixtures</h1>
        </div>
    </div>
    <nav>
        <a href='{{ routeLookup('sportsfixturesSeason.getCreateForm', {}) }}' class="icon-add" title="Add Season"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island" id="allSeasons">
        {% if allSeasons|length %}
            <section>
                <ul class="information-list">
                    {% for currentSeason in allSeasons %}
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="small-12 avatar card">
                                    <p>{{ currentSeason.name }}</p>
                                    <p class="meta">{{ currentSeason.address }}</p>
                                </div>
                            </div>
                            <nav>
                                <a href="{{ routeLookup('sportsfixturesSeason.deleteEntity', {entityId: currentSeason.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentSeason.id }}"></a>
                                <a href="{{ routeLookup('sportsfixturesSeason.getModifyForm', {entityId: currentSeason.id}) }}" class="icon-modify" title="Modify"></a>
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-season"></i>
                <p>There are no Seasons.</p>
                <p><a href="{{ routeLookup('sportsfixturesSeason.getCreateForm', {context: match.id}) }}" title="Add a Season">Add a Season</a></p>
            </div>
        {% endif %}
    </div>
</div>
