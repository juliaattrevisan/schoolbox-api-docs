{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ 'Fixtures',    routeLookup('sportsfixtures.getLanding') ],
[ 'CSV Import',  routeLookup('sportsfixturesImport.getUpload') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>CSV Import In Progress</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">

        <section class="content">
            <article>
                <p>
                    The import of your sports fixtures file has started.
                </p>
                <p>
                    A notification will be sent when it has completed or you can view the current import status by clicking the link below.
                </p>
                <p>
                    <a href="{{ routeLookup('sportsfixturesImport.getImportProgress', {id: id}) }}">Click here to view import progress</a>
                </p>
            </article>
        </section>

    </div>
</div>