{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ 'Fixtures',    routeLookup('sportsfixtures.getLanding') ],
[ 'CSV Import',  routeLookup('sportsfixturesImport.getUpload') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>CSV Import Progress</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">

        <section class="content">
            <article>
                <h2>Import {{ import.status | capitalize }}</h2>
                <p>
                    {{ import.result | nl2br }}
                </p>
            </article>
        </section>

    </div>
</div>