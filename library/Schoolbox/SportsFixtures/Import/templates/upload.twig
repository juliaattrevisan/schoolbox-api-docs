<script type="text/javascript" src="/javascript/resource/jquery.resourceAttach.js"></script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
[ 'Fixtures',    routeLookup('sportsfixtures.getLanding') ],
[ 'CSV Import',  routeLookup('sportsfixturesImport.getUpload') ]
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>CSV Import</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">

        <section class="content">
            <article>
                <h2>Example Template</h2>
                <p>
                    <a href="/sports.csv">Click here to download example template</a>
                </p>
            </article>
        </section>

        <form method="post" enctype="multipart/form-data" action="{{ routeLookup('sportsfixturesImport.postUpload') }}">
            <h2 class="subheader">Attach Files</h2>
            {% include 'sub/attachzone.twig' with {attachzone: attachzone} %}

            <ul class="flex-list buttons">
                <li><input type="submit" data-submit value="Save"></li>
                <li><input type="button" data-cancel class="button expand icon-cancel" value="Cancel Changes"></li>
            </ul>
        </form>

    </div>
</div>