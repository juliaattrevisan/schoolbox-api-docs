<script type="text/javascript">
    $(function() {
        $('#venueForm').alaressValidate({
            rules: {
                name: {
                    required: true,
                    minlength: 2
                }
            },
            messages: {
                name: 'Please enter a Venue name.',
                latitude: {
                    min: 'Latitude must lie between -90.000000 and 90.0000000',
                    max: 'Latitude must lie between -90.000000 and 90.0000000'
                },
                longitude: {
                    min: 'Longitude must lie between -180.000000 and 180.0000000',
                    max: 'Longitude must lie between -180.000000 and 180.0000000'
                }
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        })
    });
</script>

<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesVenue.getList', {}) }}">All Venues</a></li>
    <li class="active"><a href="#">{{ action }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if venue %}
            {% set formUrl = routeLookup('sportsfixturesVenue.updateEntity', {entityId: venue.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesVenue.createEntity') %}
        {% endif %}

        <form id='venueForm' action="{{ formUrl }}" method="post">
            <h2 class="subheader">{{ action }} Venue</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="hidden" name="id" value="{{ venue.id }}"/>

                        <label>
                            Name
                            <span data-tooltip class="hint has-tip tip-top" title="Internally, what this venue is known as.">?</span>
                            <input type="text" name="name" value="{{ venue.name }}"/>
                        </label>

                        <label>
                            Location
                            <span data-tooltip class="hint has-tip tip-top" title="Select the venue by clicking its location on the map, scrolling and zooming as required.">?</span>
                        </label>
                        <div id="map" style="height:50vh;"></div>
                        <script>
                            var marker;

                            function initMap() {
                                {% set gLat  = venue.latitude ?: location.lat %}
                                {% set gLon  = venue.longitude ?: location.lon %}
                                {% set gZoom = zoom ?: (venue.latitude ? 16 : 13) %}

                                var map = new google.maps.Map(document.getElementById('map'), {
                                    zoom: {{ gZoom }},
                                    center: { lat: {{ gLat }}, lng: {{ gLon }} },
                                    streetViewControl: false
                                });
                                var geocoder = new google.maps.Geocoder;

                                {% if venue.latitude %}
                                marker = new google.maps.Marker({
                                    position: { lat: {{ venue.latitude }}, lng: {{ venue.longitude }} },
                                    map: map
                                });
                                {% endif %}

                                map.addListener('click', function(e) {
                                    placeMarkerAndPanTo(e.latLng, map);
                                    geocodeLatLng(geocoder, map);
                                });
                            }

                            function placeMarkerAndPanTo(latLng, map) {
                                // remove any previous marker
                                if (marker) {
                                    marker.setMap(null);
                                }

                                marker = new google.maps.Marker({
                                    position: latLng,
                                    map: map
                                });

                                map.panTo(latLng);

                                $('[name=latitude]').val(latLng.lat());
                                $('[name=longitude]').val(latLng.lng());
                            }

                            function geocodeLatLng(geocoder, map) {
                                var latlng = {lat: parseFloat($('[name=latitude]').val()), lng: parseFloat($('[name=longitude]').val())};
                                geocoder.geocode({'location': latlng}, function(results, status) {
                                    if (status === google.maps.GeocoderStatus.OK) {
                                        if (results[0]) {
                                            $('[name=address]').val(results[0].formatted_address);
                                        } else {
                                            window.alert('No results found');
                                        }
                                    } else {
                                        window.alert('Geocoder failed due to: ' + status);
                                    }
                                });
                            }

                        </script>
                        <script async defer
                                src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDaiH38otDLfJKqbN9oNZ25ceNwRJVW_fI&callback=initMap">
                        </script>

                        <input type="hidden" name="latitude" value="{{ venue.latitude }}" />
                        <input type="hidden" name="longitude" value="{{ venue.longitude }}" />

                        <label>
                            Closest Street Address
                            <span data-tooltip class="hint has-tip tip-top" title="This will automatically update when you click a point on the map, but you can override it if you need to.">?</span>
                            <input type="text" name="address" value="{{ venue.address }}" maxlength="255"/>
                        </label>

                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Venue" />
        </form>
    </div>
</div>
