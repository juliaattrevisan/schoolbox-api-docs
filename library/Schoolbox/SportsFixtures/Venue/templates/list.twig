<script type="text/javascript">
    $(function() {
        $('#allVenues').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Venue?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {venueId: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesVenue.getList', {}) }}">All Venues</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Sports Fixtures</h1>
        </div>
    </div>
    <nav>
        <a href='{{ routeLookup('sportsfixturesVenue.getCreateForm', {}) }}' class="icon-add" title="Add Venue"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island" id="allVenues">
        {% if allVenues|length %}
            <section>
                <ul class="information-list">
                    {% for currentVenue in allVenues %}
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="small-12 avatar card">
                                    <p>{{ currentVenue.name }}</p>
                                    <p class="meta">{{ currentVenue.address }}</p>
                                </div>
                            </div>
                            <nav>
                                <a href="{{ routeLookup('sportsfixturesVenue.deleteEntity', {entityId: currentVenue.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentVenue.id }}"></a>
                                <a href="{{ routeLookup('sportsfixturesVenue.getModifyForm', {entityId: currentVenue.id}) }}" class="icon-modify" title="Modify"></a>
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-sport"></i>
                <p>There are no Venues.</p>
                <p><a href="{{ routeLookup('sportsfixturesVenue.getCreateForm', {}) }}" title="Add a Venue">Add a Venue</a></p>
            </div>
        {% endif %}
    </div>
</div>
