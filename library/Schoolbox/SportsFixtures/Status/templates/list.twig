<script type="text/javascript">
    $(function() {

        /**
         * Show empty state/hide list when no items
         * Otherwise hide empty state/show list when items exist
         */
        function refreshEmptyStates() {
            var numItems = $('#allStatus').find('[data-status-list]').find('[data-status-item]').length;

            if (numItems) {
                $('.empty-state').addClass('hide');
                $('#allStatus').find('[data-status-list]').removeClass('hide');
            }
            else {
                $('.empty-state').removeClass('hide');
                $('#allStatus').find('[data-status-list]').addClass('hide');
            }
        }

        /* Spawn clone when trying to add new status
         */
        $('#allStatus').on('click', '[data-status-add]', function(event) {
            var clone = $('#status-clone').clone();
            clone.attr('id', '');

            /* Append it to the list
             */
            $('#allStatus').find('[data-status-list]').append(clone);

            refreshEmptyStates();
        });

        /* Submit asynchronously on change
         */
        $('#allStatus').on('change', '[data-status]', function(event) {
            var element = $(this);
            var statusId = element.attr('data-status');

            var form = $('#allStatus').find('[data-status-form='+statusId+']');
            var url = form.attr('action');

            /* Status data
             */
            var data = {
                name: element.val()
            };

            $.post(url, data, function(responseText) {

                /* If responseText has a length, assume it's the
                 * id of the item just saved, otherwise assume error
                 */
                console.log('submit the stuff: ' + responseText);
            });
        });

        /* Remove asynchronously upon confirm
         */
        $('#allStatus').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);
            var elementContainer = element.parents('[data-status-item]');

            /* Just remove unsaved elements
             */
            if (element.attr('data-delete') == '') {
                elementContainer.remove();

                refreshEmptyStates();
            }
            /* Otherwise confirm deletion
             */
            else {
                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this Status?',
                    confirmEvent: function () {
                        $.post(element.attr('href'), {statusId: element.attr('data-delete')}, function (responseText) {

                            /* If responseText has a length, assume error
                             * Otherwise just remove the element upon completion
                             */
                            elementContainer.remove();

                            refreshEmptyStates();
                        });
                    }
                });
            }
        });

        /* Initial state
         */
        refreshEmptyStates();
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesStatus.getList', {}) }}">Status</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allStatus">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">All Statuses</h2>
                </div>
            </div>
            <nav>
                <a class="icon-add" title="Add Status" data-status-add></a>
            </nav>
        </div>

        <section>
            <ul class="action-list hide" data-status-list>
                {% for currentStatus in allStatus %}
                    <li class="actions-small-1" data-status-item>
                        <div class="list-item">
                            <form action="{{ routeLookup('sportsfixturesStatus.updateEntity', {entityId: currentStatus.id}) }}" method="post" data-status-form="{{ currentStatus.id }}">
                                <section>
                                    <fieldset class="content">
                                        <div class="small-12 columns">
                                            <input type="hidden" name="status" value="{{ currentStatus.id }}" />

                                            <label>
                                                <input type="text" name="name" value="{{ currentStatus.name }}" data-status="{{ currentStatus.id }}" />
                                            </label>
                                        </div>
                                    </fieldset>
                                </section>
                            </form>
                        </div>
                        <nav>
                            <a href="{{ routeLookup('sportsfixturesStatus.deleteEntity', {entityId: currentStatus.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentStatus.id }}"></a>
                        </nav>
                    </li>
                {% endfor %}
            </ul>
        </section>
        <div class="empty-state hide">
            <i class="icon-position"></i>
            <p>There are no Statuses.</p>
            <p><a title="Add a Status" data-status-add>Add a Status</a></p>
        </div>
    </div>
</div>

<ul class="action-list hide">
    <li id='status-clone' class="actions-small-1" data-status-item>
        <div class="list-item">
            <form action="{{ routeLookup('sportsfixturesStatus.createEntity') }}" method="post" data-status-form="">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <input type="hidden" name="status" value="" />

                            <label>
                                <input type="text" name="name" value="" data-status="" />
                            </label>
                        </div>
                    </fieldset>
                </section>
            </form>
        </div>
        <nav>
            <a href="" class="icon-delete" title="Delete" data-delete=""></a>
        </nav>
    </li>
</ul>