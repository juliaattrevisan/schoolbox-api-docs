<script type="text/javascript" src="/javascript/shared/jquery.label-timeout.js"></script>
<script type="text/javascript" src="/javascript/shared/sportsfixtures/jquery.mightyList.js"></script>
<script type="text/javascript">
    $(function() {
        $('#allItems').mightyList({
            entityName: 'Status',
            deleteKey: 'statusId'
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesStatus.getList', {}) }}">Status</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allItems">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">All Statuses</h2>
                </div>
            </div>
            <nav>
                <a class="icon-add" title="Add Status" data-item-add></a>
            </nav>
        </div>

        <section>
            <ul class="information-list hide" data-item-list>
                {% for currentStatus in allStatus %}
                    <li class="actions-small-1" data-item>
                        <div class="list-item">
                            <div data-action="{{ routeLookup('sportsfixturesStatus.updateEntity', {entityId: currentStatus.id}) }}" data-item-form="{{ currentStatus.id }}">
                                <section>
                                    <fieldset class="content">
                                        <div class="small-12 columns">
                                            <label>
                                                <input type="text" name="name" value="{{ currentStatus.name }}" data-item-element="{{ currentStatus.id }}" />
                                            </label>

                                            <span class="label full-width hide" data-save-item></span>
                                        </div>
                                    </fieldset>
                                </section>
                            </div>
                        </div>
                        <nav>
                            <a href="{{ routeLookup('sportsfixturesStatus.deleteEntity', {entityId: currentStatus.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentStatus.id }}"></a>
                        </nav>
                    </li>
                {% endfor %}
            </ul>
        </section>
        <div class="empty-state hide">
            <i class="icon-position"></i>
            <p>There are no Statuses.</p>
            <p><a title="Add a Status" data-item-add>Add a Status</a></p>
        </div>
    </div>
</div>

<ul class="action-list hide">
    <li id='item-clone' class="actions-small-1" data-item>
        <div class="list-item">
            <div data-action="{{ routeLookup('sportsfixturesStatus.createEntity') }}" data-item-form="">
                <section>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>
                                <input type="text" name="name" value="" data-item-element="" />
                            </label>

                            <span class="label full-width hide" data-save-item></span>
                        </div>
                    </fieldset>
                </section>
            </div>
        </div>
        <nav>
            <a href="" class="icon-delete" title="Delete" data-delete=""></a>
        </nav>
    </li>
</ul>