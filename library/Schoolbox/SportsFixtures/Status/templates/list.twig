<script type="text/javascript">
    $(function() {
        $('#allStatus').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Status?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {positionId: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });

        $('#allStatus').on('change', '[data-status]', function(event) {
            var element = $(this);
            var statusId = element.attr('data-status');

            var form = $('#allStatus').find('[data-status-form='+statusId+']');
            var url = form.attr('action');

            $.post(url, {}, function(responseText) {
                console.log('submit the stuff: ' + responseText);
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesStatus.getList', {}) }}">Status</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allStatus">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">All Statuses</h2>
                </div>
            </div>
            <nav>
                <a href='{{ routeLookup('sportsfixturesPosition.getCreateForm', {contextId: sport.id}) }}' class="icon-add" title="Add Position to {{ sport.name }}"></a>
            </nav>
        </div>

        {% if allStatus|length %}
            <section>
                <ul class="action-list">
                    {% for currentStatus in allStatus %}
                        <li class="actions-small-1">
                            <div class="list-item">

                                {% if currentStatus.id %}
                                    {% set formUrl = routeLookup('sportsfixturesStatus.updateEntity', {entityId: currentStatus.id}) %}
                                {% else %}
                                    {% set formUrl =  routeLookup('sportsfixturesStatus.createEntity') %}
                                {% endif %}

                                <form action="{{ formUrl }}" method="post" data-status-form="{{ currentStatus.id }}">
                                    <section>
                                        <fieldset class="content">
                                            <div class="small-12 columns">
                                                <input type="hidden" name="status" value="{{ currentStatus.id }}" />

                                                <label>
                                                    <input type="text" name="name" value="{{ currentStatus.name }}" data-status="{{ currentStatus.id }}" />
                                                </label>
                                            </div>
                                        </fieldset>
                                    </section>
                                </form>
                            </div>
                            <nav>
                                <a href="{{ routeLookup('sportsfixturesPosition.deleteEntity', {entityId: currentPosition.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentPosition.id }}"></a>
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-position"></i>
                <p>There are no Statuses.</p>
                <p><a href="{{ routeLookup('sportsfixturesStatus.getCreateForm', {}) }}" title="Add a Status">Add a Status</a></p>
            </div>
        {% endif %}
    </div>
</div>


