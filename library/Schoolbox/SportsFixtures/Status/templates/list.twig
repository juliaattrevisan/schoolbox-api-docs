<script type="text/javascript" src="/javascript/shared/jquery.toast-timeout.js"></script>
<script type="text/javascript" src="/javascript/shared/sportsfixtures/jquery.mightyList.js"></script>
<script type="text/javascript">
    $(function() {
        $('#allItems').mightyList({
            deleteKey: 'statusId'
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'Statuses' ],
) }}

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allItems">
        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">All Statuses</h2>
                </div>
            </div>
            <nav>
                <a class="icon-add" title="Add Status" data-item-add></a>
            </nav>
        </div>

        <section>
            <ul class="information-list hide" data-item-list>
                {% for currentStatus in allStatus %}
                    <li class="actions-small-2" data-item="{{ currentStatus.id }}">
                        {% include '@sportsfixturesStatus/listItem.twig' %}
                    </li>
                {% endfor %}
            </ul>
        </section>
        <div class="empty-state hide">
            <i class="icon-position"></i>
            <p>There are currently no statuses.</p>
            <p><a title="Add a Status" data-item-add>Add a Status</a></p>
        </div>
    </div>
</div>

<ul class="information-list hide">
    <li id="item-clone" class="actions-small-2" data-item="">
        {% include '@sportsfixturesStatus/listItem.twig' %}
    </li>
</ul>
