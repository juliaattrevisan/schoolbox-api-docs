<ul class="breadcrumb">
    <li class="active"><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures Landing Page</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            <a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">Sports</a><br>
            {% for sport in sports %}
                <a href="{{ routeLookup('sportsfixturesPosition.getList', {contextId: sport.id}) }}">Positions - {{ sport.name }}</a><br>
            {% endfor %}
            <a href="{{ routeLookup('sportsfixturesVenue.getList', {}) }}">Venues</a><br>
        </section>
    </div>
</div>
