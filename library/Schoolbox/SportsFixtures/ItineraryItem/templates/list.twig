<script type="text/javascript">
    $(function() {
        $('#allItineraryItems').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Itinerary Item?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {positionId: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="#">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: division.id}) }}">Matches in {{ division.name }}</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesMatch.getModifyForm', {entityId: match.id}) }}">{{ match.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island" id="allItineraryItems">

        <div class="actions-small-1 row">
            <div class="list-item">
                <div class="small-12 columns">
                    <h2 class="subheader">{{ match.name }}</h2>
                </div>
            </div>
            <nav>
                <a href='{{ routeLookup('sportsfixturesItineraryItem.getCreateForm', {contextId: match.id}) }}' class="icon-add" title="Add Itinerary Item to {{ match.name }}"></a>
            </nav>
        </div>

        {% if allItineraryItems|length %}
            <section>
                <ul class="action-list">
                    {% for currentItineraryItem in allItineraryItems %}
                        <li class="actions-small-1">
                            <div class="list-item">
                                <div class="small-12 avatar card">
                                    <p>{{ currentItineraryItem.description }}</p>
                                </div>
                            </div>
                            <nav>
                                <a href="{{ routeLookup('sportsfixturesItineraryItem.deleteEntity', {entityId: currentItineraryItem.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentItineraryItem.id }}"></a>
                                <a href="{{ routeLookup('sportsfixturesItineraryItem.getModifyForm', {entityId: currentItineraryItem.id}) }}" class="icon-modify" title="Modify"></a>
                            </nav>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty-state">
                <i class="icon-sport"></i>
                <p>There are no Itinerary Items in {{ match.name }}.</p>
                <p><a href="{{ routeLookup('sportsfixturesItineraryItem.getCreateForm', {contextId: match.id}) }}" title="Add an Itinerary Item">Add an Itinerary Item</a></p>
            </div>
        {% endif %}
    </div>
</div>