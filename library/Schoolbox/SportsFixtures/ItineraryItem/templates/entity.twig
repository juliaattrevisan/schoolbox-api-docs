<ul class="breadcrumb">
    <li><a href="#">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: division.id}) }}">Matches in {{ division.name }}</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesMatch.getModifyForm', {entityId: match.id}) }}">{{ match.name }}</a></li>
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">{{ position.name }}</h2>

        <section class="content">
            <div class="small-12 columns">
                <dl>
                    <dt>ID</dt>
                    <dd>{{ itineraryItem.id }}</dd>

                    <dt>Match</dt>
                    <dd>{{ match.name }}</dd>

                    <dt>Name</dt>
                    <dd>{{ itineraryItem.description }}</dd>

                    <dt>Starts At</dt>
                    <dd>{{ itineraryItem.startAt.database }}</dd>

                    <dt>Created</dt>
                    <dd>{{ itineraryItem.createdAt.database }}</dd>

                    {% if not itineraryItem.createdAt.eq(itineraryItem.updatedAt) %}
                        <dt>Last Updated</dt>
                        <dd>{{ itineraryItem.updatedAt.database }}</dd>
                    {% endif %}
                </dl>
            </div>
        </section>
    </div>
</div>
