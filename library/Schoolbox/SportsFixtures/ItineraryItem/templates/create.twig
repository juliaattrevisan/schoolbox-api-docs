<script type="text/javascript" charset="utf-8" src="/javascript/components/jquery-timepicker-jt/jquery.timepicker.min.js"></script>
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>

<script type="text/javascript">
    $(function() {
        $('#itineraryItemForm').alaressValidate({
            rules: {
                matchId: {
                    required: true,
                    min: 1
                },
                venueId: {
                    required: true,
                    min: 1
                },
                startAt: {
                    required: true,
                    min: 1
                },
                description: {
                    required: true,
                    minlength: 2
                }
            },
            messages: {
                'matchId': 'Please choose a Match.',
                'venueId': 'Please choose a Venue.',
                'startAt': 'Please choose a Time',
                'description': 'Please enter a name.'
            },
            errorPlacement: function(error, element) {
                $.alaressValidate.defaultErrorPlacement(error, element);
            }
        });

        $('#itineraryItemForm').find('[data-datepicker]').datepicker();

        $('#itineraryItemForm').find('[data-timepicker]').timepicker({
            appendTo: function ($input) {
                return $input.closest('.timepick');
            }
        });

        $('#venue').selectizeSelector({
            ajax: {
                url: '/sportsfixtures/venues/list',
                type: 'GET',
                dataType: 'json'
            },
            {% if itineraryItem.venue.id %}
            value: {"id":{{ itineraryItem.venue.id }}, "name": "{{ itineraryItem.venue.name }}"},
            {% endif %}
            multiple: false
        });
    });
</script>

<ul class="breadcrumb">
    <li><a href="#">Sports Fixtures</a></li>
    <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
    <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: division.id}) }}">Matches in {{ division.name }}</a></li>
    <li><a href="{{ routeLookup('sportsfixturesMatch.getModifyForm', {entityId: match.id}) }}">{{ match.name }}</a></li>

    {% if itineraryItem.id %}
        <li class="active"><a href="{{ routeLookup('sportsfixturesItineraryItem.getModifyForm', {entityId: itineraryItem.id}) }}">{{ itineraryItem.name }}</a></li>
    {% else %}
        <li class="active"><a href="#">{{ action }}</a></li>
    {% endif %}
</ul>

<div class="row">
    <div class="small-12 columns">
        <h1>Sports Fixtures</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% if itineraryItem %}
            {% set formUrl = routeLookup('sportsfixturesItineraryItem.updateEntity', {entityId: itineraryItem.id}) %}
        {% else %}
            {% set formUrl = routeLookup('sportsfixturesItineraryItem.createEntity') %}
        {% endif %}

        <form id='itineraryItemForm' action="{{ formUrl }}" method="post">
            <h2 class="subheader">{{ action }} Itinerary Item in {{ match.name }}</h2>

            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <input type="hidden" name="matchId" value="{{ match.id }}"/>
                        <input type="hidden" name="itineraryItemId" value="{{ itineraryItem.id }}"/>

                        <label>
                            Description
                            <input type="text" name="description" value="{{ itineraryItem.description }}"/>
                        </label>
                    </div>

                    <div class="column small-12 medium-6">
                        <label>
                            Date
                            <input type="text" name="startAtDate" placeholder="Date" data-datepicker value="{{ itineraryItem.startAt.getLocalShort }}">
                        </label>
                    </div>

                    <div class="column small-12 medium-6">
                        <div class="timepick">
                            <label>
                                Time
                                <input type="text" name="startAtTime" autocomplete="off" placeholder="Start Time" class="ui-timepicker-input" data-timepicker value="{{ itineraryItem.startAt.getTimeOnly }}">
                            </label>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Venue
                        </label>
                        <input id='venue' name="venueId" type='text' value='' placeholder="Search Venues" />
                    </div>
                </fieldset>
            </section>

            <input type="submit" value="{{ action }} Itinerary Item" />
        </form>
    </div>
</div>
