{% extends '@sportsfixturesMatch/match.twig' %}

{% block breadcrumbs %}
    <ul class="breadcrumb">
        <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
        <li><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
        <li><a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: sport.id}) }}">Divisions in {{ sport.name }}</a></li>
        <li><a href="{{ routeLookup('sportsfixturesMatch.getList', {contextId: division.id}) }}">Matches in {{ division.name }}</a></li>
        <li><a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: team.id}) }}">{{ match.name }}</a></li>

        {% if match.id %}
            <li class="active"><a href="{{ routeLookup('sportsfixturesResult.getResultForTeam', {contextId: match.id, teamId: team.id}) }}">Results for {{ team.name }}</a></li>
        {% else %}
            <li class="active"><a href="#">{{ action }}</a></li>
        {% endif %}
    </ul>
{% endblock %}

{% block results %}
    {% if match.result.offset(team.id) %}
    <script type="text/javascript">
        $(function() {
            $('[data-delete]').click(function(event) {
                event.preventDefault();

                var element = $(this);

                $(this).confirmDialog({
                    text: 'Are you sure you want to delete this Result?',
                    confirmEvent: function() {
                        $.post(element.attr('href'), {}, function() {
                            window.location.href = window.location.href;
                        });
                    }
                });
            });
        });
    </script>

    <h3 class="subheader">Results</h3>
    <section class="content">
        <div class="row">
            <div class="small-12 columns">
                <div class="actions-small-1 row">
                    <div class="list-item">
                        <div class="small-12 columns">
                            <h4>{{ team.name }}</h4>
                            {{ match.result.offset(team.id).description|raw }}
                        </div>
                    </div>
                    <nav>
                        <a href="{{ routeLookup('sportsfixturesResult.deleteEntity', {entityId: match.result[team.id].id}) }}" class="icon-delete" title="Delete" data-delete="{{ match.result[team.id].id }}"></a>
                        <a href="{{ routeLookup('sportsfixturesResult.getModifyForm', {entityId: match.result[team.id].id}) }}" class="icon-modify" title="Modify"></a>
                    </nav>
                </div>
            </div>
        </div>
    </section>
    {% else %}
    <div class="empty-state">
        <i class="icon-result"></i>
        <p>There are no Results for this Team.</p>

        <p><a href="{{ routeLookup('sportsfixturesResult.getCreateFormForTeam', {contextId: match.id, teamId: team.id}) }}" title="Add Results">Add Results for this Team.</a></p>
    </div>
    {% endif %}
{% endblock %}

