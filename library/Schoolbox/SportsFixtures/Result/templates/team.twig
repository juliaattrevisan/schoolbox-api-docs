{% extends '@sportsfixturesMatch/match.twig' %}

{% block results %}
    {% if match.result.offset(team.id) %}
    <h3 class="subheader">Results</h3>
    <section class="content">
        <div class="row">
            <div class="small-12 columns">
                <div class="actions-small-1 row">
                    <div class="list-item">
                        <div class="small-12 columns">
                            <h4>{{ match.homeTeam.name }}</h4>
                            {{ match.result.offset(match.homeTeam.id).description|raw }}
                        </div>
                    </div>
                    <nav>
                        <a href="{{ routeLookup('sportsfixturesResult.getModifyForm', {entityId: match.result[match.homeTeam.id].id}) }}" class="icon-modify" title="Modify"></a>
                    </nav>
                </div>
            </div>
        </div>
    </section>
    {% else %}
    <div class="empty-state">
        <i class="icon-result"></i>
        <p>There are no Results for this Team.</p>

        <p><a href="{{ routeLookup('sportsfixturesResult.getCreateFormForTeam', {contextId: match.id, teamId: match.homeTeam.id}) }}" title="Add Results">Add Results for this Team.</a></p>
    </div>
    {% endif %}
{% endblock %}

