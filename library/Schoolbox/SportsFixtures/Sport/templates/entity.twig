<script type="text/javascript">
    $(function () {
        $('[data-collapser]').collapsable();

        $('#allDivisions').on('click', '[data-division-action="delete"]', function(event) {
            event.preventDefault();

            var element = $(this);
            var $division = element.closest('[data-division]');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Division?',
                confirmEvent: function() {
                    $.post(element.attr('data-post-action'), {}, function() {

                        // Is this the last division in this sport ?
                        if( 1 == $('[data-division]').length){
                            window.location.href = window.location.href;
                        } else {
                            $division.fadeOut({ done: $division.remove() });
                        }
                    });
                }
            });
        });
    });
</script>

{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures',    routeLookup('sportsfixtures.getLanding') ],
    [ 'Sports',      routeLookup('sportsfixturesSport.getList') ],
    [ sport.name ]
) }}

<div class="row actions-small-1">
    <div class="small-12 columns list-item">
        <h1>{{ sport.name }}</h1>
        {%  if sport.url %}
        <ul class="meta">
            <li class="icon-home"><a href="{{ sport.url }}">{{ sport.url }}</a></li>
        </ul>
        {% endif %}
    </div>
    <nav>
        <a href="#" class="icon-overflow" data-dropdown="fdrop-sport"></a>
    </nav>
    <ul id="fdrop-sport" class="f-dropdown" data-dropdown-content>
        <li><a class="icon-add"    href="{{ routeLookup('sportsfixturesDivision.getCreateForm', { contextId: sport.id }) }}">Add new division</a></li>
        <li><a class="icon-modify" href="{{ routeLookup('sportsfixturesSport.getModifyForm', { entityId: sport.id }) }}">Modify {{ sport.name }}</a></li>
        <li><a class="icon-delete" data-post-action="{{ routeLookup('sportsfixturesSport.deleteEntity', {entityId: sport.id}) }}" >Delete {{ sport.name }}</a></li>
    </ul>
</div>

<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Divisions</h2>
            {% if not divisions | length %}
                <div class="empty-state">
                    <i class="icon-division"></i>
                    <p>There are no divisions in {{ sport.name }}.</p>
                    <p><a href="{{ routeLookup('sportsfixturesDivision.getCreateForm', {contextId: sport.id}) }}">Add a division</a></p>
                </div>
            {% else %}
        <section>
            <ul class="information-list expandable-card" id="allDivisions">
                {% for division in divisions %}
                {% set teamCount = division.teams | length %}
                <li class="actions-small-2" data-division>
                    {% if teamCount %}
                    <div class="expander icon-down-arrow" data-collapser="division-{{ division.id }}"></div>
                    {% endif %}
                    <div class="list-item">
                        <div class="card small-12">
                            <a href="{{ routeLookup('sportsfixturesDivision.getLobby', { entityId: division.id }) }}" title="Go to {{ division.name }} lobby">
                                <div class="icon-division icon-16"></div>
                                <h3>{{ division.name }}</h3>
                            </a>
                            <p class="meta">
                                {%- if teamCount == 1 -%}
                                    One team
                                {%- elseif teamCount -%}
                                    {{ teamCount }} teams
                                {%- else -%}
                                    No teams
                                {%- endif -%}
                            </p>
                        </div>
                        <div class="small-12 column hide" data-collapse-state="collapsed" data-collapsable="division-{{ division.id }}">
                            <ul class="unit-list">
                                {% for team in division.teams %}
                                    <li>
                                        <span class="icon-16 icon-team"></span>
                                        <span>{{ team.name }}</span>
                                        {% if team.coaches | length %}
                                            <span class="meta">({{ team.coaches | column('name') | join(', ') }})</span>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                    <nav>
                        <a href="#" class="icon-overflow" data-dropdown="division-{{ division.id }}-dropdown" aria-expanded="false" title="Actions"></a>{#-dessicant-#}
                    </nav>
                    <ul class="f-dropdown" data-division-dropdown data-dropdown-content id="division-{{ division.id }}-dropdown">
                        <li><a href="{{ routeLookup('sportsfixturesMatch.getList', { contextId: division.id }) }}" class="icon-search">View Fixture</a></li>
                        <li><a href="{{ routeLookup('sportsfixturesTeam.getCreateForm', { contextId: division.id }) }}" class="icon-add">Add New Team</a></li>
                        <li><a href="{{ routeLookup('sportsfixturesDivision.getModifyForm', { entityId: division.id }) }}" class="icon-modify">Modify</a></li>
                        <li><a href="#" data-division-action="delete" data-post-action="{{ routeLookup('sportsfixturesDivision.deleteEntity', {entityId: division.id}) }}" class="icon-delete">Delete</a></li>
                    </ul>
                </li>
                {% endfor %}
            </ul>
        </section>
            {% endif %}
    </div>
</div>
