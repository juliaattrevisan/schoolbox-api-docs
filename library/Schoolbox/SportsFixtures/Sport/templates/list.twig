<script type="text/javascript">
    $(function() {
        $('#allSports').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);
            var $sport = element.closest('[data-sport]');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Sport?',
                confirmEvent: function() {
                    $.post(element.data('post-action'), {}, function() {

                        // Is this the last sport ?
                        if( 1 == $('[data-sport]').length){
                            window.location.href = window.location.href;
                        } else {
                            $sport.fadeOut({ done: $sport.remove() });
                        }

                    });
                }
            });
        });
    });
</script>
{% import 'sub/breadcrumbs.twig' as bread %}
{{ bread.crumbs(
    [ 'Fixtures', routeLookup('sportsfixtures.getLanding') ],
    [ 'Sports' ]
) }}
<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Fixtures</h1>
        </div>
    </div>
    <nav>
        <a href='{{ routeLookup('sportsfixturesSport.getCreateForm', {}) }}' class="icon-add" title="Add Sport"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island" id="allSports">
        <h2 class="subheader">All Sports</h2>
        {% if allSports|length %}
        <section>
            <ul class="information-list">
                {% for sport in allSports %}
                    {% include '@sportsfixturesSport/listItem.twig' %}
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-sport"></i>
            <p>There are no Sports.</p>
            <p><a href="{{ routeLookup('sportsfixturesSport.getCreateForm', {}) }}" title="Add a Sport">Add a Sport</a></p>
        </div>
        {% endif %}
    </div>
</div>
