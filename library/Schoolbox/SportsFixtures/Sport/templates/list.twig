<script type="text/javascript">
    $(function() {
        $('#allSports').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);
            var $sport = element.closest('[data-sport]');

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Sport?',
                confirmEvent: function() {
                    $.post(element.data('post-action'), {sportId: element.data('delete')}, function() {
                        $sport.fadeOut({ done: $sport.remove });
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="{{ routeLookup('sportsfixtures.getLanding', {}) }}">Sports Fixtures</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Sports Fixtures</h1>
        </div>
    </div>
    <nav>
        <a href='{{ routeLookup('sportsfixturesSport.getCreateForm', {}) }}' class="icon-add" title="Add Sport"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island" id="allSports">
        {% if allSports|length %}
        <section>
            <ul class="information-list">
                {% for currentSport in allSports %}
                <li class="actions-small-1" data-sport>
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <p>{{ currentSport.name }}</p>
                            <p><a href="{{ currentSport.url }}">{{ currentSport.url }}</a>
                        </div>
                    </div>
                    <nav>
                        <a href="{{ routeLookup('sportsfixturesSport.getModifyForm', {entityId: currentSport.id}) }}" class="icon-modify" title="Modify"></a>
                        <a href="{{ routeLookup('sportsfixturesDivision.getList', {contextId: currentSport.id}) }}" class="icon-division" title="Manage Divisions in {{ currentSport.name }}"></a>
                        <a href="{{ routeLookup('sportsfixturesPosition.getList', {contextId: currentSport.id}) }}" class="icon-position" title="Manage Positions in {{ currentSport.name }}"></a>
                        <a href="#" class="icon-more" data-dropdown="sportsfixtures-sport-{{ currentSport.getId() }}-actions"></a>
                    </nav>
                    <ul class="f-dropdown" data-dropdown-content="" id="sportsfixtures-sport-{{ currentSport.getId() }}-actions">
                        <li><a href="#" data-action="delete" data-post-action="{{ routeLookup('sportsfixturesSport.deleteEntity', {entityId: currentSport.id}) }}" class="icon-delete" title="Delete" data-delete="{{ currentSport.id }}">Delete</a></li>
                    </ul>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-sport"></i>
            <p>There are no Sports.</p>
            <p><a href="{{ routeLookup('sportsfixturesSport.getCreateForm', {}) }}" title="Add a Sport">Add a Sport</a></p>
        </div>
        {% endif %}
    </div>
</div>
