<script type="text/javascript">
    $(function() {
        $('#allSports').on('click', '[data-delete]', function(event) {
            event.preventDefault();

            var element = $(this);

            $(this).confirmDialog({
                text: 'Are you sure you want to delete this Sport?',
                confirmEvent: function() {
                    $.post(element.attr('href'), {sportId: element.attr('data-delete')}, function() {
                        window.location.href = window.location.href;
                    });
                }
            });
        });
    });
</script>
<ul class="breadcrumb">
    <li><a href="#">Sports Fixtures</a></li>
    <li class="active"><a href="{{ routeLookup('sportsfixturesSport.getList', {}) }}">All Sports</a></li>
</ul>

<div class="actions-small-1 row">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Sports Fixtures</h1>
        </div>
    </div>
    <nav>
        <a href='{{ routeLookup('sportsfixturesSport.getCreate', {}) }}' class="icon-add" title="Add Sport"></a>
    </nav>
</div>

<div class="row">
    <div class="small-12 island" id="allSports">
        {% if allSports|length %}
        <section>
            <ul class="information-list">
                {% for currentSport in allSports %}
                <li class="actions-small-1">
                    <div class="list-item">
                        <div class="small-12 avatar card">
                            <p>{{ currentSport.name }}</p>
                            <p><a href="{{ currentSport.url }}">{{ currentSport.url }}</a>
                        </div>
                    </div>
                    <nav>
                        <a href="{{ routeLookup('sportsfixturesSport.postDelete', {}) }}" class="icon-delete" title="Delete" data-delete="{{ currentSport.id }}"></a>
                        <a href="{{ routeLookup('sportsfixturesSport.getUpdate', {sportId: currentSport.id}) }}" class="icon-modify" title="Modify"></a>
                        <a href="{{ routeLookup('sportsfixturesDivision.getList', {sportId: currentSport.id}) }}" class="icon-list" title="Manage Divisions in {{ currentSport.name }}"></a>
                    </nav>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% else %}
        <div class="empty-state">
            <i class="icon-sport"></i>
            <p>There are no Sports.</p>
            <p><a href="{{ routeLookup('sportsfixturesSport.getCreate', {}) }}" title="Add a Sport">Add a Sport</a></p>
        </div>
        {% endif %}
    </div>
</div>