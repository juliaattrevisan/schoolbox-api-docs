<!-- BEGIN custom_head -->
<script type="text/javascript" src="/javascript/shared/jquery.pantry.js"></script>

<script type="text/javascript">
    $(function() {
        /* Collapse content on components
         */
        $('[data-component]').find('[data-collapser=true]').collapsable();
    });
</script>
<!-- END custom_head -->

<div class="row">
    <div class="small-12 columns">
        <h1>Schoolbox Help Courses</h1>

        <ul class="sub-nav">
            <li class="active">
                <a href="{{ routeLookup('shaps.getUsersInCourses') }}">Courses</a>
            </li>
            <li>
                <a href="{{ routeLookup('shaps.getUserEnrolmentSearch') }}">User Search</a>
            </li>
        </ul>
    </div>
</div>



<div class="row">
    <div class="small-12 island">
        <h3 class="subheader">Available courses</h3>

        <section>
            <ul class="information-list expandable-card">
                {% for course in courses %}
                    <li>
                        <div class="actions-small-1">
                            <div class="expander icon-down-arrow" data-collapser="collap-{{loop.index}}"></div>
                            <div class="small-12 card compact list-item">
                                <div class="icon-course"></div>
                                <h3>{{ course.folderName }}</h3>
                            </div>
                        </div>
                        <div class="small-12 column hide" data-collapse-state="collapsed" data-collapsable="collap-{{loop.index}}">

                            <div class="row">
                                <div class="small-12 island">
                                    <dl class="tabs" data-tab>
                                        <dd class="active"><a href="#members">Current Enrolments</a></dd>
                                        <dd><a href="#addMembers">Enrol users</a></dd>
                                    </dl>

                                    <section>
                                        <div class="tabs-content content no-margin">
                                            <div class="content active" id="members">
                                                <input type="hidden" name="categoryID" value="{CATEGORY_ID}" />

                                                <ul class="information-list card-selectable">

                                                    <li data-relation="member">
                                                        <div class="actions-small-4">
                                                            <div class="selector">
                                                                <input data-toggle-all name="delete-all-{{ loop.index }}" id="delete-all-{{ loop.index }}" type="checkbox">
                                                                <label for="delete-all-{{ loop.index }}" class="checkbox-label"></label>
                                                            </div>
                                                            <div class="list-item">
                                                                <div class="card small-12">
                                                                    <p>Select All</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </li>

                                                    {% for user in course.participants %}
                                                        {% if user.id is null %}
                                                        {% else %}
                                                        <li data-relation="member">
                                                            <div class="actions-small-4">
                                                                <div class="selector">
                                                                    <input id="delete-{{ user.id}}" name="delete[]" type="checkbox">
                                                                    <label for="delete-{{ user.id }}" class="checkbox-label"></label>
                                                                </div>
                                                                <div class="list-item">
                                                                    <div class="card small-12">
                                                                        <a href="/search/user/{{ user.id }}">
                                                                            {{ user.firstname }} {{ user.lastname }}
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                                <nav>
                                                                    <!-- TODO change this form action -->
                                                                    <form action="/group/modifyForm.php" method="post" class="no-margin">
                                                                        <input id="accessLevel-{{ user.id }}-0" type="radio" name="accessLevel[{{ user.id }}]" value="0" />
                                                                        <label for="accessLevel-{{ user.id }}-0" class="input-toggle" title="Remove user from this course">
                                                                            <i class="icon-close alert"></i>
                                                                        </label>
                                                                    </form>
                                                                </nav>
                                                            </div>
                                                        </li>
                                                        {% endif %}
                                                    {% endfor %}
                                                </ul>

                                                <hr>
                                                <button disabled data-delete-members class="expand">Remove Selected Users From Course</button>
                                            </div>

                                            <div class="content" id="addMembers">
                                                <dl class="tabs" data-tab>
                                                    <dd class="active"><a href="#userName">From Name</a></dd>
                                                    <dd><a href="#userGroups">From Group</a></dd>
                                                    <dd><a href="#userRoles">From Role</a></dd>
                                                    <dd><a href="#userList">From List</a></dd>
                                                </dl>
                                                <section>
                                                    <div class="tabs-content no-margin">
                                                        <div class="content active" id="userName">
                                                            <!-- TODO change this form action -->
                                                            <form action="/group/modifyForm.php" method="post" class="no-margin">
                                                                <input type="hidden" name="categoryID" value="{CATEGORY_ID}" />
                                                                <label for="addUser">
                                                                    Enrol users
                                                                    <span data-tooltip class="has-tip tip-top hint" title="You may add users individually by typing their name and selecting from the list.">?</span>
                                                                </label>
                                                                <select id="addUser" name="userID[]" multiple placeholder="Search Users"></select>
                                                                <input type="submit" value="Add Users" />
                                                            </form>
                                                        </div>

                                                        <div class="content" id="userGroups">
                                                            <form action="/group/addUserByGroup.php?type=individual&destinationID={CATEGORY_ID}" method="post" class="no-margin">
                                                                <input type="hidden" name="individualGroupID" id="individualGroupID" />
                                                                <label for="addUsersByIndividualGroup">
                                                                    Group
                                                                    <span data-tooltip class="has-tip tip-top hint" title="Add all users that belong to another group.">?</span>
                                                                </label>
                                                                <input id="addUsersByIndividualGroup" type="text" size="30" placeholder="Search User Groups" />
                                                                <input type="submit" value="Add Users" />
                                                            </form>
                                                        </div>

                                                        <div class="content" id="userRoles">
                                                            <form action="/group/addUserByGroup.php?type=system&destinationID={CATEGORY_ID}" method="post" class="no-margin">
                                                                <input type="hidden" name="systemGroupID" id="systemGroupID" />
                                                                <label for="addUsersBySystemGroup">
                                                                    Role
                                                                    <span data-tooltip class="has-tip tip-top hint" title="Add all users of a particular role in the system.">?</span>
                                                                </label>
                                                                <input id="addUsersBySystemGroup" type="text" size="30" placeholder="Search User Roles" />
                                                                <input type="submit" value="Add Users" />
                                                            </form>
                                                        </div>

                                                        <div class="content" id="userList">
                                                            <form action="/group/modifyForm.php" method="post" class="no-margin">
                                                                <label for="addUsersByList">
                                                                    User List
                                                                    <span data-tooltip class="has-tip tip-top hint" title="Add a list of users (either external user IDs or Schoolbox usernames).">?</span>
                                                                </label>
                                                                <input type="hidden" name="categoryID" value="{CATEGORY_ID}" />
                                                                <textarea name="bulkAdd" id="addUsersByList" cols="30" rows="20"></textarea>
                                                                <input type="submit" value="Add Users" />
                                                            </form>
                                                        </div>
                                                    </div>
                                                </section>
                                            </div>

                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>

            <script type="text/javascript">
                $(function () {
                    $('[data-collapser]').collapsable();
                });
            </script>
        </section>

        <div class="empty-state{% if courses | length > 0 %} hide{% endif %}" data-empty-state>
            <i class="icon-course"></i>
            <p>{% block emptyStateText %}No courses found for your school.{% endblock %}</p>
        </div>
    </div>
</div>