<div class="row">
    <div class="small-12 island">

        <h1>Schoolbox Help Staff Provisioning</h1>

        {%
            set pages = {
                '/' : 'All',
                '/provisioned' : 'Provisioned',
                '/unprovisioned' : 'Not Provisioned',
                '/search' : 'Search'
            }
        %}
        <ul class="sub-nav">
            {% for pageUrl, pageTitle in pages %}
                <li {% if currentPageUrl == pageUrl %}class="active"{% endif %}><a href="/shaps/provisioning{{ pageUrl }}">{{ pageTitle }}</a></li>
            {% endfor %}
        </ul>

        {% block page_specific_content %}
        {% endblock %}

        <div id="statusForm" {% if allUsers | length == 0 %}class="hide"{% endif %}>
            <form>
                <section class="content" id="statusTable">
                    <table>
                        <tr>
                            <th>Status</th>
                            <th>User</th>
                            {% block provisioned_column_heading %}
                            <th>
                                <div class="checklist">
                                    <input id="select-all" type="checkbox">
                                    <label for="select-all" title="Select All">Provision?</label>
                                </div>
                            </th>
                            {% endblock %}
                        </tr>

                        {% for user in allUsers %}
                            {% if user.id not in provisionedUserIDs %}
                                <tr class="highlight-warning">
                            {% else %}
                                <tr>
                            {% endif %}
                            <td>
                                {% if user.id in provisionedUserIDs %}
                                    <i class="icon-course-outline" title="Provisioned"></i>
                                {% else %}
                                    <p>Not Provisioned</p>
                                {% endif %}
                            </td>
                            <td>
                                {{ user.fullname }}
                            </td>

                            {% block provisioned_column %}
                                <td>
                                    {% if user.id not in provisionedUserIDs %}
                                        <div class="checklist">
                                            <input id="provision-{{ user.id }}" type="checkbox" data-checkbox>
                                            <label for="provision-{{ user.id }}"></label>
                                        </div>
                                    {% else %}
                                        <div class="checklist">
                                            <input id="provision-{{ user.id }}" type="checkbox" disabled>
                                            <label for="provision-{{ user.id }}" title="Already provisioned"></label>
                                        </div>
                                    {% endif %}
                                </td>
                            {% endblock %}
                            </tr>
                        {% endfor %}
                    </table>
                </section>

                <input type="submit" value="Save changes">
            </form>
        </div>

        <div class="empty-state{% if allUsers | length > 0 %} hide{% endif %}">
            <i class="icon-staff-students"></i>
            <p>No matching users found.</p>
        </div>

    </div>
</div>

<script type="text/javascript" src="/javascript/shared/select-all/jquery.select-all.js"></script>
<script>
    $("#statusForm").selectAll({
        selector: "#select-all",
        checkboxes: "[data-checkbox]",
        observerParent: "tbody"
    });
</script>