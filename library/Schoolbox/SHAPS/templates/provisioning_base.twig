<div class="row">
    <div class="small-12 island">

        <h1>Schoolbox Help Staff Provisioning</h1>

        {%
            set pages = {
                '/' : 'All',
                '/provisioned' : 'Provisioned',
                '/unprovisioned' : 'Not Provisioned',
                '/search' : 'Search'
            }
        %}
        <ul class="sub-nav">
            {% for pageUrl, pageTitle in pages %}
                <li {% if currentPageUrl == pageUrl %}class="active"{% endif %}><a href="/shaps/provisioning{{ pageUrl }}">{{ pageTitle }}</a></li>
            {% endfor %}
        </ul>

        {% block page_specific_content %}
        {% endblock %}

        <div id="statusForm">
            <form>
                <section class="content" id="statusTable">
                    <table>
                        <tr>
                            <th>Status</th>
                            <th>User</th>
                            <th>
                                <div class="checklist">
                                    <input id="select-all" type="checkbox">
                                    <label for="select-all" title="Select All">Provision?</label>
                                </div>
                            </th>
                        </tr>

                        {% for user in allUsers %}
                            {% if user.externalID not in provisionedUserIDs %}
                                <tr class="highlight-warning">
                            {% else %}
                                <tr>
                            {% endif %}
                            <td>
                                {% if user.externalID in provisionedUserIDs %}
                                    <i class="icon-course-outline" title="Provisioned"></i>
                                {% else %}
                                    <i class="icon-close" title="Not Provisioned"></i>
                                {% endif %}
                            </td>
                            <td>
                                {{ user.fullname }}
                            </td>
                            <td>
                                {% if user.externalID not in provisionedUserIDs %}
                                    <div class="checklist">
                                        <input id="provision-{{ user.externalID }}" type="checkbox">
                                        <label for="provision-{{ user.externalID }}"></label>
                                    </div>
                                {% else %}
                                    <div class="checklist">
                                        <input id="provision-{{ user.externalID }}" type="checkbox" disabled>
                                        <label for="provision-{{ user.externalID }}" title="Already provisioned"></label>
                                    </div>
                                {% endif %}
                            </td>
                            </tr>
                        {% endfor %}
                    </table>
                </section>

                <input type="submit" value="Save changes">
            </form>
        </div>

    </div>
</div>