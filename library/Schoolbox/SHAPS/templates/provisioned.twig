<div class="row">
    <div class="small-12 island">

        <h1>Schoolbox Help Staff Provisioning</h1>

        <ul class="sub-nav">
            <li><a href="/shaps/provisioning/">All</a></li>
            <li class="active"><a href="/shaps/provisioning/provisioned">Provisioned</a></li>
            <li><a href="/shaps/provisioning/unprovisioned">Not Provisioned</a></li>
            <li><a href="/shaps/provisioning/search">Search</a></li>
        </ul>

        <form>
            <section class="content" id="statusTable">
                <table>
                    <tr>
                        <th>Status</th>
                        <th>User</th>
                        <th>Provision?</th>
                    </tr>

                    {% for user in provisionedUsers %}
                        <tr>
                            <td>
                                <i class="icon-course-outline" title="Provisioned"></i>
                            </td>
                            <td>
                                {{ user.fullname }}
                            </td>
                            <td>
                                <div class="checklist">
                                    <input id="provision-{{ user.externalID }}" type="checkbox" disabled>
                                    <label for="provision-{{ user.externalID }}" title="Already provisioned"></label>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}

                </table>
            </section>

            <input type="submit" value="Save changes">
        </form>

    </div>
</div>