<div class="row">
    <div class="small-12 island">

        <h1>Schoolbox Help Staff Provisioning</h1>

        <ul class="sub-nav">
            <li><a href="/shaps/provisioning/">All</a></li>
            <li><a href="/shaps/provisioning/provisioned">Provisioned</a></li>
            <li><a href="/shaps/provisioning/unprovisioned">Not Provisioned</a></li>
            <li class="active"><a href="/shaps/provisioning/search">Search</a></li>
        </ul>


        <section id="staffSearch" class="content">
            <input id="users" name="userId" value="" placeholder="Search Staff" data-selectizeuser="" required="" tabindex="-1" style="display: none;" class="selectized" type="text">
            <script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
            <script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
            <script type="text/javascript">
                $(function() {

                    var $selectize = $('#users').selectizeSelector({
                        ajax: {
                            url:      '/ajax/user.php',
                            type:     'GET',
                            data:     {showCampus: true},
                            dataType: 'json'
                        },
                        multiple: true
                    });

                    $selectize = $selectize[0].selectize;
                    $selectize.on("item_add", function(value, $item) {
                        var $itemText = $item.text();
                        var userID = $itemText.match(/\((\d*)\)/)[1];

                        $.get("/shaps/provisioning/"+userID, function(data) {
                            var tableSelector = "#statusTable table";

                            if ($.isEmptyObject(data)) {
                                $(".empty-state").show();
                                $("#statusForm").addClass("hide");
                            } else {
                                $(".empty-state").hide();
                                $("#statusForm").removeClass("hide");
                            }

                            $(data).each(function(index, user) {
                                var statusMarkup = '';
                                var checkboxMarkup = '';
                                var trMarkup = '';

                                if (user.provisioned) {
                                    statusMarkup = '<i class="icon-course-outline" title="Provisioned"></i>\n';
                                    checkboxMarkup = '<div class="checklist"><input id="provision-' + user.externalID + '" type="checkbox" disabled><label for="provision-' + user.externalID + '" title="Already provisioned"></label></div>';
                                    trMarkup = '<tr>';
                                } else {
                                    statusMarkup = '<i class="icon-close" title="Not Provisioned"></i>\n';
                                    checkboxMarkup = '<div class="checklist"><input id="provision-' + user.externalID + '" type="checkbox"><label for="provision-' + user.externalID + '"></label></div>';
                                    trMarkup = '<tr class="highlight-warning">';
                                }

                                var markup = trMarkup + "<td>" + statusMarkup + "</td>"
                                    + "<td>" + user.name + "</td>"
                                    + "<td>" + checkboxMarkup + "</td></tr>";

                                $(tableSelector).append(markup);
                            });

                        }, "json")
                            .fail(function(xhr, status, error) {
                                console.log(xhr);
                                console.log(status + ": " + error);
                            })
                    });

                    $selectize.on("item_remove", function(index, value) {
                        // TODO extract the id from the value innerText
                        // and use it to find the table row for that user and delete it from the DOM
                        var selectizeEmpty = ($selectize.items.length < 1);
                        if (selectizeEmpty) {
                            $(".empty-state").show();
                            $("#statusForm").addClass("hide");
                        }
                    });

                });
            </script>
        </section>

        <div class="empty-state">
            <i class="icon-staff-students"></i>
            <p>Users you search for will appear here.</p>
        </div>

        <div id="statusForm" class="hide">
            <form>
                <section class="content" id="statusTable">
                    <table>
                        <tr>
                            <th>Status</th>
                            <th>User</th>
                            <th>Provision?</th>
                        </tr>

                        {% for user in allUsers %}
                            {% if user.externalID not in provisionedUserIDs %}
                                <tr class="highlight-warning">
                            {% else %}
                                <tr>
                            {% endif %}
                            <td>
                                {% if user.externalID in provisionedUserIDs %}
                                    <i class="icon-course-outline" title="Provisioned"></i>
                                {% else %}
                                    <i class="icon-close" title="Not Provisioned"></i>
                                {% endif %}
                            </td>
                            <td>
                                {{ user.fullname }}
                            </td>
                            <td>
                                {% if user.externalID not in provisionedUserIDs %}
                                    <div class="checklist">
                                        <input id="provision-{{ user.externalID }}" type="checkbox">
                                        <label for="provision-{{ user.externalID }}"></label>
                                    </div>
                                {% else %}
                                    <div class="checklist">
                                        <input id="provision-{{ user.externalID }}" type="checkbox" disabled>
                                        <label for="provision-{{ user.externalID }}" title="Already provisioned"></label>
                                    </div>
                                {% endif %}
                            </td>
                            </tr>
                        {% endfor %}
                    </table>
                </section>

                <input type="submit" value="Save changes">
            </form>
        </div>

    </div>
</div>