{% set pdUpdateRoute = routeLookupIfAuthorized('professionaldevelopment.postUpdate', {userId: userId}) %}

{% if pdUpdateRoute %}
    <script type="text/javascript">
        $(function() {
            $("#pdForm").alaressValidate({
                rules: {
                    'pdNumber':  {
                        alphanumeric: true,
                        requiredNotBlank:true
                    },
                    'pdState':  {
                        alphanumeric: true,
                        requiredNotBlank:true
                    }
                }
            });
        });
    </script>
    <form action="{{ pdUpdateRoute }}" method="post" id="pdForm">
        <section class="content">
            <div class="small-12 medium-8 columns">
                <label>Professional Development Number</label>
                <input type="text" name="pdNumber" value="{{ pd.number }}" />
            </div>
            <div class="small-12 medium-4 columns">
                <label>Registration State</label>
                <select name="pdState">
                    <option value="" disabled="disabled">Please Select</option>

                    {% for state in pdStates %}
                        {% if state == pd.registrationState %}
                            {% set selected = ' selected="selected"' %}
                        {% else %}
                            {% set selected = '' %}
                        {% endif %}

                        <option value="{{ state }}"{{ selected }}>{{ state }}</option>
                    {% endfor %}
                </select>
            </div>
        </section>
        <input type="submit" value="Update Professional Development details" />
    </form>
{% endif %}
