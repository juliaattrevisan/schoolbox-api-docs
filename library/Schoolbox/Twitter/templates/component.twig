{% block markup %}
{% endblock markup %}

{% block js %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            // Include Twitter's JS API
            window.twttr = (function (d, s, id) {
                let js,
                    fjs = d.getElementsByTagName(s)[0],
                    t = window.twttr || {};
                if (d.getElementById(id)) return t;
                js = d.createElement(s);
                js.id = id;
                js.src = "https://platform.twitter.com/widgets.js";
                fjs.parentNode.insertBefore(js, fjs);

                t._e = [];
                t.ready = function (f) {
                    t._e.push(f);
                };

                return t;
            }(document, "script", "twitter-wjs"));
        </script>
    {% endautoescape %}
{% endblock js %}

{% block install %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            ($(function () {
                // Wait for Twitter API to become available, then load widgets
                twttr.widgets.load(document.getElementById("twitter-view-{{ id }}"));
            }));
        </script>
    {% endautoescape %}
{% endblock install %}
