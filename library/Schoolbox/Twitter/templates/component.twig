{% block emptyState %}
<div class="empty-state">
    <span class="icon-twitter"></span>
    <p>
        <a href="#" class="edit empty-edit" data-target="settings" data-state="closed">Enter an author</a>
        to show a feed of tweets.
    </p>
</div>
{% endblock emptyState %}

{% block js %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            // Include Twitter's JS API
            window.twttr = (function (d, s, id) {
                let js,
                    fjs = d.getElementsByTagName(s)[0],
                    t = window.twttr || {};
                if (d.getElementById(id)) return t;
                js = d.createElement(s);
                js.id = id;
                js.src = "https://platform.twitter.com/widgets.js";
                fjs.parentNode.insertBefore(js, fjs);

                t._e = [];
                t.ready = function (f) {
                    t._e.push(f);
                };

                return t;
            }(document, "script", "twitter-wjs"));
        </script>
    {% endautoescape %}
{% endblock js %}

{% block install %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            ($(function () {
                twttr.widgets.createTimeline(
                    {
                        sourceType: "profile",
                        screenName: "{{ username }}"
                    },
                    document.getElementById("twitter-view-{{ id }}")
                );
            }));
        </script>
    {% endautoescape %}
{% endblock install %}

{% block markup %}
    <a id="twitter-view-{{ id }}"
       class="twitter-timeline"
       href="https://twitter.com/{{ username }}"
    >Tweets by @{{ username }}</a>
{% endblock markup %}

