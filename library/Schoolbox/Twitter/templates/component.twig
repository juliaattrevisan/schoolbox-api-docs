{% if href is null %}
    <div class="empty-state">
        <span class="icon-twitter"></span>
        <p>
            <a href="#" class="edit empty-edit" data-target="settings" data-state="closed">Enter an author</a>
            to show a feed of tweets.
        </p>
    </div>
{% else %}
    {# The empty state exists here only whilst loading the item. We have a mutation observer set up to remove it. #}
    <div class="empty-state" id="twitter-view-{{ id }}-container">
        <span class="icon-twitter" id="twitter-view-{{ id }}-icon"></span>
        <p>
            <a id="twitter-view-{{ id }}"
               class="twitter-timeline"
               href="{{ href }}"
               target="_blank"
               data-dnt="true"
               {% if limit %}data-tweet-limit="{{ limit }}"{% endif %}
               data-chrome="noheader nofooter noborders transparent noscrollbar"
            >Loading tweets...</a>
        </p>
    </div>

    {% autoescape 'js' %}
        <script type="text/javascript">
            // Include Twitter's JS API
            window.twttr = (function (d, s, id) {
                let js,
                    fjs = d.getElementsByTagName(s)[0],
                    t = window.twttr || { };
                if (d.getElementById(id)) return t;
                js = d.createElement(s);
                js.id = id;
                js.src = "//platform.twitter.com/widgets.js";
                fjs.parentNode.insertBefore(js, fjs);

                t._e = [];
                t.ready = function (f) {
                    t._e.push(f);
                };

                return t;
            }(document, "script", "twitter-wjs"));

            // Wait for Twitter API to become available, then load the widget.
            // (This is only required when reloading the component's content)
            twttr.ready(
                function (t) {
                    let elementId = "twitter-view-{{ id }}",
                        container = document.getElementById("twitter-view-{{ id }}-container"),
                        icon      = document.getElementById("twitter-view-{{ id }}-icon"),
                        observer  = new MutationObserver(function (mutationsList, observer) {
                            // If the observer doesn't find the element, the
                            // Twitter feed has been loaded.
                            // Remove the empty state.
                            if (!document.getElementById(elementId)) {
                                container.classList.remove('empty-state');
                                icon.remove();
                                observer.disconnect();
                            }
                        }),
                        timeout1  = function () {
                            let element = document.getElementById(elementId);
                            if (element) {
                                element.innerText = 'Still loading...';
                            }
                        },
                        timeout2  = function () {
                            let element = document.getElementById(elementId);
                            if (element) {
                                element.innerText = 'Cannot load tweets for @{{ username }}.';
                            }
                        };
                    observer.observe(container, { attributes: true, childList: true, subtree: true });
                    t.widgets.load(document.getElementById(elementId))
                        .finally(
                            function () {
                                // The widget got loaded, apparently.
                                // Wait and see if this item still exists?
                                // If we detect the item doesn't exist: remove
                                // the empty state
                                setTimeout(timeout1, 5000);
                                setTimeout(timeout2, 15000);
                            }
                        );
                }
            );
        </script>
    {% endautoescape %}
{% endif %}
