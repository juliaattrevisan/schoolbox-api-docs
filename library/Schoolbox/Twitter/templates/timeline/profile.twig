{% extends '@twitter/component.twig' %}

{% block markup %}
    <a id="twitter-view-{{ id }}"
       class="twitter-timeline"
       href="https://twitter.com/{{ username }}"
    >Tweets by @{{ username }}</a>
{% endblock markup %}

{% block install %}
    {% autoescape 'js' %}
        <script type="text/javascript">
            ($(function () {
                twttr.widgets.createTimeline(
                    {
                        sourceType: "profile",
                        screenName: "{{ username }}"
                    },
                    document.getElementById("twitter-view-{{ id }}")
                );
            }));
        </script>
    {% endautoescape %}
{% endblock install %}
