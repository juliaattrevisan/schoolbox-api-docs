{% extends '@twitter/component.twig' %}

{% block markup %}
    <a id="twitter-view-{{ id }}"
       class="twitter-timeline"
       href="https://twitter.com/{{ username }}/timelines/{{ collectionId }}"
       data-dnt="true"
       {% if limit %}data-tweet-limit="{{ limit }}"{% endif %}
       data-chrome="noheader nofooter noborders transparent noscrollbar"
    >Tweet Collection by @{{ username }}</a>
{% endblock markup %}
