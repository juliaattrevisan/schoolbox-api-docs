{% extends '@twitter/component.twig' %}

{% block markup %}
    <a id="twitter-view-{{ id }}"
       class="twitter-timeline"
       href="https://twitter.com/{{ username }}/lists/{{ listSlug }}"
       data-dnt="true"
       data-height="600"
       data-chrome="noheader nofooter noborders transparent noscrollbar"
    >Tweets from https://twitter.com/{{ username }}/lists/{{ listSlug }}</a>
{% endblock markup %}
