<script type="text/javascript" src="{{ CDN_PREFIX }}/js/form/jquery.alaressValidate.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        $('#accountForm').alaressValidate({
            rules: {
                confirm_password: {
                    equalsOtherField: $('#new_password')
                }
            },
            messages: {
                confirm_password: {
                    equalsOtherField: 'New Password and Confirm New Password must match.'
                }
            }
        });
    });
</script>

{% if isRequestMade %}
    <div class="row">
        <div class="small-12 columns">
            {% if isPasswordReset %}
                <div class="alert-box success">
                    Your password has been changed successfully.
                </div>
            {% else %}
                <div class="alert-box alert">
                    There was a problem changing your password; please try again.
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}

<div class="row">
    <div class="small-12 columns">
        <h1>Change Your Password</h1>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        {% set formAction = routeLookupIfAuthorized('passwordChange.postChangePassword') %}
        {% if formAction %}
            <form id="accountForm" method="post" action="{{ formAction }}">
                <section>
                    <fieldset class="content">
                        <div class="small-12 column">
                            <label class="required" for="current_password">Current Password</label>
                            <input type="password"
                                   name="current_password"
                                   id="current_password"
                                   required/>

                            <label class="required" for="new_password">New Password</label>
                            <input type="password"
                                   name="new_password"
                                   id="new_password"
                                   data-rule-minlength="8"
                                   required/>

                            <label class="required" for="confirm_password">Confirm New
                                <span data-tooltip class="hint has-tip tip-top" title="Password must be at least 8 characters in length">?</span>
                            </label>
                            <input type="password"
                                   name="confirm_password"
                                   id="confirm_password"
                                   data-rule-minlength="8"
                                   required/>

                        </div>
                    </fieldset>
                </section>
                <div class="row">
                    <div class="small-12 column">
                        <input type="submit" name="btnSubmit" value="Update Password"/>
                    </div>
                </div>
            </form>
        {% endif %}
    </div>
</div>
