<head>
    <title>{{ config.site_title }}</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="Content-Language" content="en-au" />
    <meta name="author" content="Alaress Pty Ltd"/>
    <meta name="application-name" content="{SITE_NAME}" />
    <meta name="msapplication-TileColor" content="#0066b0" />
    <meta name="msapplication-square70x70logo" content="/images/logo.php?logo=skin_logo_square&size=tile70" />
    <meta name="msapplication-square150x150logo" content="/images/logo.php?logo=skin_logo_square&size=tile150" />
    <meta name="msapplication-wide310x150logo" content="/images/logo.php?logo=skin_logo_login&size=tile310" />
    <meta name="msapplication-square310x310logo" content="/images/logo.php?logo=skin_logo_large&size=tile310" />
    <meta name="viewport" content="initial-scale=1, maximum-scale=1">
    <link rel="apple-touch-icon" sizes="57x57" href="/images/logo.php?logo=skin_logo_square&size=apple57">
    <link rel="apple-touch-icon" sizes="60x60" href="/images/logo.php?logo=skin_logo_square&size=apple60">
    <link rel="apple-touch-icon" sizes="72x72" href="/images/logo.php?logo=skin_logo_square&size=apple72">
    <link rel="apple-touch-icon" sizes="76x76" href="/images/logo.php?logo=skin_logo_square&size=apple76">
    <link rel="apple-touch-icon" sizes="114x114" href="/images/logo.php?logo=skin_logo_square&size=apple114">
    <link rel="apple-touch-icon" sizes="120x120" href="/images/logo.php?logo=skin_logo_square&size=apple120">
    <link rel="apple-touch-icon" sizes="144x144" href="/images/logo.php?logo=skin_logo_square&size=apple144">
    <link rel="apple-touch-icon" sizes="152x152" href="/images/logo.php?logo=skin_logo_square&size=apple152">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo.php?logo=skin_logo_square&size=apple180">
    <link rel="Shortcut Icon" href="/images/logo.php?logo=skin_logo_square&size=favicon" type="image/x-icon" />

    <link rel="stylesheet" type="text/css" href="/css/{{ config.site_location }}/chrome-foundation.css?v={{ config.site_version }}" />
</head>
<body>
<!-- The Schoolbox Hybrid Bar -->
<div class="standard-bar">
    <a href="/" class="logo small-2 columns no-pad">
        <img src="/images/logo.php?logo=skin_logo_square&size=normal" srcset="/images/logo.php?logo=skin_logo_square&size=normal 1x,/images/logo.php?logo=skin_logo_square&size=hidpi 2x" alt="{SITE_NAME}"/>
    </a>
</div>
<div id="container">
    <div id="content">
        <script type="text/javascript">
            $(function() {
                $('#forgottenPassword').alaressValidate({
                    rules: {
                        'email': {
                            required: true,
                            minlength: 1
                        }
                    },
                    messages: {
                        'email': "Please enter an email address or username"
                    }
                });
            });
        </script>
        <script type="text/javascript" src="/javascript/shared/jquery.validate.extensions.js"></script>
        <script type="text/javascript" src="/javascript/jquery.alaressValidate.js"></script>
        <script type="text/javascript">
            $(document).ready(function () {
                $('#resetPassword').alaressValidate({
                    rules: {
                        confirm_password: {
                            equalsOtherField: $('#new_password')
                        }
                    },
                    messages: {
                        confirm_password: {
                            equalsOtherField: 'New Password and Confirm New Password must match.'
                        }
                    }
                });
            });
        </script>

        <div class="row">
            <div class="small-12 island">
                <h1>Reset Your Password</h1>

                {% if not isPasswordValid %}
                    <div class="alert-box alert">
                        The password you provided is not valid. Please follow the rules specified below.
                    </div>
                {% endif %}

                <form id="resetPassword" action="{{ routeLookup('userPasswordReset.reset', {token: reset.getToken()}) }}" method="post" class="top">
                    <section>
                        <div class="small-12 card">
                            {# As you are not logged in, you don't have permission to view this user's profile image. #}
                            <img src="/portrait.php?userId={{ reset.getUser().getExternalId() }}&amp;size=square64" alt="{{ reset.getUser().formatName() }}">
                            <h3>{{ reset.getUser().formatName() }}</h3>
                        </div>
                    </section>
                    <section>
                        <fieldset class="content">
                            <div class="small-12 columns">
                                <label>
                                    Username
                                    <input type="text"
                                           readonly
                                           value="{{ reset.getUser().getUsername() }}" />
                                </label>
                                <label>
                                    New Password
                                    <input type="password"
                                           name="new_password"
                                           id="new_password"
                                           data-rule-minlength="8"
                                           required />
                                </label>
                                <label>
                                    Confirm New Password
                                    <input type="password"
                                           name="confirm_password"
                                           id="confirm_password"
                                           data-rule-minlength="8"
                                           required />
                                </label>
                            </div>
                        </fieldset>
                    </section>
                    <input type="submit" name="submit" value="Reset Password" />
                </form>
            </div>
        </div>
    </div>
    <div id="footer">
        <ul>
            <li>{{ config.year }} &copy; Copyright <a href="{{ config.school_address }}">{{ config.school_name }}</a></li>
            <li><a href="/policy.php">Terms of Use and Privacy Policy</a></li>
            <li>Powered by <a href="http://www.schoolbox.com.au" title="Virtual Learning Environment, Learning Management System, LMS">Schoolbox</a></li>
        </ul>
    </div>
</div>
</body>
</html>
