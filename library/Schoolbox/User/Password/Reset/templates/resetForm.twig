<script type="text/javascript" src="{{ CDN_PREFIX }}/js/form/jquery.alaressValidate.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('#resetPassword').alaressValidate({
            rules: {
                confirm_password: {
                    equalsOtherField: $('#new_password')
                }
            },
            messages: {
                confirm_password: {
                    equalsOtherField: 'New Password and Confirm New Password must match.'
                }
            }
        });
    });
</script>

<div class="row">
    <div class="small-12 island">
        <h1>Reset Your Password</h1>

        {% if not isPasswordValid %}
            <div class="alert-box alert">
                The password you provided is not valid. Please follow the rules specified below.
            </div>
        {% endif %}

        <form id="resetPassword" action="{{ routeLookup('userPasswordReset.reset', {token: reset.getToken()}) }}" method="post" class="top">
            <section>
                <div class="small-12 card">
                    {# As you are not logged in, you don't have permission to view this user's profile image. #}
                    {% include 'include/portrait.twig' with {user: reset.getUser(), description: reset.getUser().fullName()} only %}
                    <h3>{{ reset.getUser().formatName() }}</h3>
                </div>
            </section>
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label>
                            Username
                            <input type="text"
                                   readonly
                                   value="{{ reset.getUser().getUsername() }}" />
                        </label>
                        <label>
                            New Password
                            <input type="password"
                                   name="new_password"
                                   id="new_password"
                                   data-rule-minlength="8"
                                   required />
                        </label>
                        <label>
                            Confirm New Password
                            <input type="password"
                                   name="confirm_password"
                                   id="confirm_password"
                                   data-rule-minlength="8"
                                   required />
                        </label>
                    </div>
                </fieldset>
            </section>
            <input type="submit" name="btnSubmit" value="Reset Password" />
        </form>
    </div>
</div>
