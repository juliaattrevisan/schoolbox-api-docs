<div class="row">
    <div class="small-12 island">
        <h1>{{ config.forgotten_password_title }}</h1>

        {% if isResetExpired %}
            <div class="alert-box alert">
                Your reset link has expired - please create a new request here.
            </div>
        {% endif %}

        {% if isEmailSubmitted %}
            {% if isEmailValid %}
                <div class="alert-box success">
                    Thank you. If <strong>{{ email }}</strong> is associated with a {{ config.title }} account,
                    you will receive an email which contains a link for you to reset your password.
                </div>
            {% else %}
                <div class="alert-box alert">
                    The email address or username you provided is not valid - please check your email address or username.
                </div>
            {% endif %}

        {% elseif config.forgotten_password_desc|trim is not empty %}
            <div class="alert-box">
                {{ config.forgotten_password_desc|purify }}
            </div>
        {% endif %}

        <form novalidate id="forgottenPassword" action="{{ routeLookup('userPasswordReset.createRequest') }}" method="post" class="top">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="email">Email / Username</label>
                        <input class="input_text" type="email" name="email" id="email" value="{{ email|e('html_attr') }}" />
                    </div>
                </fieldset>
            </section>
            <input type="submit" value="Send" />
        </form>
    </div>
</div>
