<script type="text/javascript" src="/javascript/components/jquery-validation/additional-methods.js"></script>
<script type="text/javascript" src="/javascript/shared/jquery.validate.extensions.js"></script>
<script type="text/javascript" src="/javascript/jquery.alaressValidate.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('#resetPassword').alaressValidate({
            rules: {
                new_password: {
                    // Regex: must contain [a-z], \d and ^[a-z\d] (case-insensitive)
                    pattern: /^(?=.*[a-z])(?=.*\d)(?=.*[^a-z\d])/i
                },
                confirm_password: {
                    equalsOtherField: $('#new_password')
                }
            },
            messages: {
                new_password: {
                    pattern: 'Your new password must be at least 6 characters in length and contain at least one letter, one number and one symbol or punctuation character.'
                },
                confirm_password: {
                    equalsOtherField: 'New Password and Confirm New Password must match.'
                }
            }
        });
    });
</script>

<div class="row">
    <div class="small-12 island">
        <h1>Reset Your Password</h1>

        {% if isPasswordSubmitted %}
            {% if isPasswordValid %}
                <div class="alert-box success">
                    Thank you. Your password has been reset, and you may now log in with your new password.
                </div>
            {% else %}
                <div class="alert-box alert">
                    The password you provided is not valid. Please follow the rules specified below.
                </div>
            {% endif %}
        {% endif %}

        {% if not (isPasswordSubmitted and isPasswordValid) %}
            <div class="alert-box">
                <p>Your new password must be at least 6 characters in length and contain at least one letter,
                    one number and one symbol or punctuation character.<br />
                    (examples of symbol characters: $, #, _, &amp;)</p>
            </div>

            <form id="resetPassword" action="{{ routeLookup('userPasswordReset.reset') }}" method="post" class="top">
                <section>
                    <div class="small-12 avatar card">
                        <img src="/portrait.php?userId={{ reset.getUser().getExternalId() }}&amp;size=square64" alt="{{ reset.getUser().formatName() }}">
                        <p>{{ reset.getUser().formatName() }}</p>
                    </div>
                    <fieldset class="content">
                        <div class="small-12 columns">
                            <label>
                                New Password
                                <input type="password"
                                       name="new_password"
                                       id="new_password"
                                       size="35"
                                       data-rule-minlength="6"
                                       maxlength="50"
                                       required />
                            </label>
                            <label>
                                Confirm New Password
                                <input type="password"
                                       name="confirm_password"
                                       id="confirm_password"
                                       size="35"
                                       data-rule-minlength="6"
                                       maxlength="50"
                                       required />
                            </label>
                        </div>
                    </fieldset>
                </section>
                <input type="submit" name="submit" value="Reset Password" />
            </form>
        {% endif %}
    </div>
</div>
