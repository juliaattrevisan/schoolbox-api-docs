<script type="text/javascript">
    $(document).ready(function () {
        $('#accountForm').submit(function (event) {

            event.stopPropagation();

            var current = $('#current_password').val(),
                    password = $('#new_password').val(),
                    confirmp = $('#confirm_password').val(),
                    msgs = {
                        current_password: [],
                        new_password:     [],
                        confirm_password: []
                    },
                    letter_re = /[a-z]/i,
                    number_re = /\d/,
                    nonalpha_re = /[^a-z\d]/i
                    ;

            if (current == '') {
                msgs.current_password.push('You must enter your current password.');
            }
            if (password.length < 6) {
                msgs.new_password.push('Your new password must be at least 6 characters long.');
            }
            else {
                if (!letter_re.test(password)) {
                    msgs.new_password.push('Your new password must have at least one letter.');
                }
                if (!number_re.test(password)) {
                    msgs.new_password.push('Your new password must have at least one number.');
                }
                if (!nonalpha_re.test(password)) {
                    msgs.new_password.push('Your new password must have at least one punctuation or symbol character.');
                }
            }
            if (password != confirmp) {
                msgs.confirm_password.push('The new and confirmation passwords you entered do not match.');
            }

            var slots = $('#current_password_messages, #new_password_messages, #confirm_password_messages');
            slots.hide().empty();
            if (msgs.current_password.length === 0
                    && msgs.new_password.length === 0
                    && msgs.confirm_password.length === 0
            ) {
                return true;
            }
            else {
                $.each(msgs, function(key) {
                    var slot = $('#'+key+'_messages');
                    $.each(this, function(k,text) {
                        slot.append($('<li></li>').text(text).addClass("error-notification"));
                    });
                });
                slots.fadeIn('fast');
                return false;
            }
        });
    });
</script>

<div class="row">
    <div class="small-12 island">
        <h1>Reset Your Password</h1>

        {% if isPasswordSubmitted %}
            {% if isPasswordValid %}
                <div class="alert-box success">
                    Thank you. Your password has been reset, and you may now log in with your new password.
                </div>
            {% else %}
                <div class="alert-box alert">
                    The password you provided is not valid. Please follow the rules specified below.
                </div>
            {% endif %}
        {% endif %}

        <div class="alert-box">
            <p>Your new password must be at least 6 characters in length and contain at least one letter,
                one number and one symbol or punctuation character.<br />
                (examples of symbol characters: $, #, _, &amp;)</p>
        </div>

        <form id="forgottenPassword" action="{{ routeLookup('userPasswordReset.createRequest') }}" method="post" class="top">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        User
                        <label>
                            New Password
                            <input type="password" name="new_password" id="new_password" size="35" maxlength="50" />
                        </label>
                        <label>
                            Confirm New Password
                            <input type="password" name="confirm_password" id="confirm_password" size="35" maxlength="50" />
                        </label>
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <input type="submit" name="submit" value="Update Password" />
                </div>
            </div>
        </form>
    </div>
</div>
