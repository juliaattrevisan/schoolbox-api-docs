{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
    [ student.formatName, "/search/user/" ~ student.id ],
    [ 'Academic Reports' ]
) }}

<div class="row">
    <div class="small-12 island">
        <h1>Academic Reports</h1>
    </div>

    {% if reports|length %}
        {% set previousFileYear = -1 %}
        {% for report in reports %}
            {% if previousFileYear != report.FileYear %}
                {% if previousFileYear != -1 %}
                            </ul>
                        </section>
                    </div>
                {% endif %}
                {% set previousFileYear = report.FileYear %}
                <div class="small-12 island">
                    <h2 class="subheader">{{ report.FileYear }}</h2>
                        <section>
                        <ul class="information-list">
            {% endif %}
            <li class="actions-small-1">
                <div class="list-item">
                    <div class="compact card small-12">
                        <a href="{{ routeLookupIfAuthorized('profileDocumentManagement.getDownload', {studentId: student.id, documentId: report.ID, source: report.Source}) }}">
                            <img src="/images/mime/application-pdf.svg" class="mime">
                            <h3>{{ report.Description }}</h3>
                            <p class="meta" title="{{ report.CreatedDate.relativeTime }}">
                                Uploaded {{ report.CreatedDate.long }}
                            </p>
                        </a>
                    </div>
                </div>
            </li>
        {% endfor %}
                </ul>
            </section>
        </div>

    {% else %}
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-document"></i>
                <p>No academic reports found for this student</p>
            </div>
        </div>
    {% endif %}
</div>
