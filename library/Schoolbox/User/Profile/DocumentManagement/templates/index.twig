{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
[ student.formatName, "/search/user/" ~ student.id ],
[ 'Academic Reports' ]
) }}

<div class="row">
    <div class="small-12 island">
        <h1>Academic Reports</h1>
    </div>

    {% if reports|length %}
        {% for year, yearReports in reports %}
            <div class="small-12 island">
                <h2 class="subheader">{{ year }}</h2>

                {% for reportId in yearReports %}
                    <section>
                        <ul class="action-list">
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <div class="compact card small-12">
                                        <a href="{{ routeLookupIfAuthorized('profileDocumentManagement.getDownload', {studentId: student.id, documentId: reportId, source: reportId.source}) }}">
                                            <img src="/images/mime/application-pdf.svg" class="mime">
                                            <h3>{{ reportId.description }}</h3>
                                        </a>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </section>
                {% endfor %}

            </div>
        {% endfor %}
    {% else %}
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-document"></i>
                <p>No academic reports found for this student</p>
            </div>
        </div>
    {% endif %}
</div>
