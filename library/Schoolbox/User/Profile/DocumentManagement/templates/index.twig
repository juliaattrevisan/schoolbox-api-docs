{% import 'sub/breadcrumbs.twig' as bread %}

{{ bread.crumbs(
[ student.formatName, "/search/user/" ~ student.id ],
[ 'Academic Reports' ]
) }}

<div class="row">
    <div class="small-12 island">
        <h1>Academic Reports</h1>
    </div>

    {% if reports|length %}
        {% for year, semesters in reports %}
            {% for semester, reports in semesters %}
                <div class="small-12 island">
                <h2 class="subheader">{{ year }} {% if semester is not empty %}Semester {{ semester }}{% endif %}</h2>
                <section>
                <ul class="action-list">
                {% for reportId, report in reports %}
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="compact card small-12">
                                <a href="{{ routeLookupIfAuthorized('profileDocumentManagement.getDownload', {studentId: student.id, documentId: reportId, source: report.source}) }}">
                                    <img src="/images/mime/application-pdf.svg" class="mime">
                                    <h3>{{ report.description }}</h3>
                                </a>
                            </div>
                        </div>
                    </li>
                {% endfor %}
                </ul>
                </section>
                </div>
            {% endfor %}
        {% endfor %}
    {% else %}
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-document"></i>
                <p>No academic reports found for this student</p>
            </div>
        </div>
    {% endif %}
</div>
