{% import 'sub/breadcrumbs.twig' as bread %}

<div class="row">
    {{ bread.crumbs(
        [ student.formatName, "/search/user/" ~ student.id ],
        [ locale.reports.properPlural ]
    ) }}
    <div class="small-12 island">
        <h1>{{ locale.reports.properPlural }}</h1>
    </div>

    {% if wysiwyg_content | length > 0 %}
    <div class="small-12 island">
        <section class="content">
            <article>
                {{- wysiwyg_content | purify -}}
            </article>
        </section>
    </div>
    {% endif %}

    {% if reports|length %}
        {% set previousFileYear = -1 %}
        {% for report in reports %}
            {% if previousFileYear != report.FileYear %}
                {% if previousFileYear != -1 %}
                            </ul>
                        </section>
                    </div>
                {% endif %}
                {% set previousFileYear = report.FileYear %}
                <div class="small-12 island">
                    <h2 class="subheader">{{ report.FileYear }}</h2>
                        <section>
                        <ul class="information-list">
            {% endif %}
            <li class="actions-small-1">
                <div class="list-item">
                    <div class="card small-12">
                        <a href="{{ routeLookupIfAuthorized('profileDocumentManagement.getDownload', {studentId: student.id, documentId: report.ID, source: report.Source}) }}" download>
                            <img src="{{ CDN_PREFIX }}/images/mime/{{ icons[report.ID] }}" class="mime">
                            <h3>{{ report.Description }}</h3>
                            <p class="meta" title="{{ report.CreatedDate.long }}">
                                Uploaded {{ report.CreatedDate.relativeTime }}
                            </p>
                        </a>
                    </div>
                </div>
            </li>
        {% endfor %}
                </ul>
            </section>
        </div>

    {% else %}
        <div class="small-12 island">
            <div class="empty-state">
                <i class="icon-document"></i>
                <p>No {{ locale.reports.plural }} found for this student</p>
            </div>
        </div>
    {% endif %}
</div>
