<div class="row">
    <div class="small-12 island">
        <h1>Have You Forgotten Your Password?</h1>

        <div class="alert-box">
            Please enter your email address below - we will send a link for you to reset your password. This feature works for parents only.
        </div>

        <form id="forgottenPassword" action="{{ routeLookup('user.requestPasswordReset') }}" method="post" class="top">
            <section>
                <fieldset class="content">
                    <div class="small-12 columns">
                        <label for="email">Email</label>
                        <input class="input_text" type="text" name="email" id="email" value="" />
                    </div>
                </fieldset>
            </section>
            <div class="row">
                <div class="small-12 columns">
                    <input type="submit" value="Send" />
                </div>
            </div>
        </form>
    </div>
</div>
