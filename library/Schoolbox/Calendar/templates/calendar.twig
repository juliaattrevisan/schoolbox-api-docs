{% autoescape 'js' %}
<script type="text/javascript">
    // Which view gets shown?
    var anchorView = '',
        parts      = location.href.split('#');

    if (parts.length > 1) {
        anchorView = parts[1];
        switch (anchorView) {
            case 'month':
                anchorView = 'dayGridMonth';
                break;
            case 'week':
            case 'agendaWeek':
            case 'basicWeek':
                anchorView = 'timeGridWeek';
                break;
            case 'day':
            case 'agendaDay':
            case 'basicDay':
                anchorView = 'timeGridDay';
                break;
            case 'list':
                anchorView = 'listWeek';
                break;
            default:
                anchorView = '';
                break;
        }
    }

    window.fullCalendarConfig = {
        userId:             Number('{{ user.id }}'),
        token:              '{{ user.key }}',
        taskTypeId:         Number('{{ taskTypeId }}'),
        sources:            {{ sources | json_encode | raw }},
        eventTypes:         {{ eventTypes | json_encode | raw }},
        groups:             {{ groups | json_encode | raw }},
        campuses:           {{ campuses | json_encode | raw }},
        selectedFilters:    {{ filters | json_encode | raw }},
        defaultDate:        '{{ selectedDate|date('Y-m-d') }}',
        eventLimit:         Boolean('{{ config.calendar_collapse_events }}'),
        firstDay:           Number('{{ config.calendar_start_day }}'),
        defaultView:        anchorView || '{{ calendarView }}',
        dateDisplayFormats: dateDisplayFormats,
        translations:       {
            eotc: {
                proper: '{{ locale.eotc.proper }}'
            },
            dueWork: {
                proper: '{{ locale.dueWork.proper }}'
            }
        }
    };
</script>
{% endautoescape %}

<div class="row actions-small-1">
    <div class="small-12 columns">
        <h1>{{ locale.calendar.proper ~ " for " ~ user.fullName}}</h1>
    </div>
    {% set assessmentCalendar = routeLookupIfAuthorized('learningAssessmentCalendar.getReport')  %}
    {% if assessmentCalendar %}
    <nav>
        <a href="#" class="icon-more" data-dropdown="header-options" title="Actions" aria-expanded="false"></a>
    </nav>
    <ul class="f-dropdown fadeInDown" data-dropdown-content="" id="header-options">
        <li><a class="icon-calendar" href="{{assessmentCalendar}}">Assessment Calendar</a></li>
    </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        <section>
            <div id="calendar"></div>
            <script type="text/javascript" src="/javascript/components/fullCalendar.bundle.js?v={{ config.site_version }}"></script>
        </section>
    </div>
</div>
