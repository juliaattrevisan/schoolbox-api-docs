{% autoescape 'js' %}
    <script type="text/javascript">
        window.fullCalendarConfig = {
            schedulerLicenseKey: '{{ config.fullcalendar_scheduler_license_key }}',
            userId: Number('{{ user.id }}') || null,
            folderId: Number('{{ folder.id }}') || null,
            componentId: Number('{{ component.instance.id }}') || null,
            // Days: 0 = max, must be at least 1.
            // Maximum is defined as the number of remaining days from current date to the
            // end of the following school year period.
            days: Math.min(Math.max(1, Number('{{ component.config.days }}') || {{ maxCalendarDays }}), {{ maxCalendarDays }}),
            dateDisplayFormats: dateDisplayFormats,
            limit: Number('{{ component.config.size }}') || null,
            createEventUrl: "{{ routeLookup('calendarEvent.getCreate') }}?{{ RETURN_URL.name }}={{ returnUrl }}&level=2&homepageId={{ folder.id }}",
            exportUrl: $.fn.getExportCalendarLink(
                "{{ user.key }}",
                {
                    'export': 'group',
                    'group': Number('{{ folder.id }}') || null,
                }
            ),
            importEventsUrl: "/calendar/import/{{ folder.id }}",
            canCreateEvent: Boolean("{{ canCreateEvent }}"),
            dayjsDateLong:  '{{ config.date_long | dayjsFormat }}',
            isDashboard: false
        };
    </script>
{% endautoescape %}
<div id="calendar-{{ component.instance.id }}" >
    <calendar-component />
</div>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/calendarComponent.js?v={{ config.site_version }}" data-is-vue></script>
