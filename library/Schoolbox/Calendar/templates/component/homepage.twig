{% autoescape 'js' %}
    <script type="text/javascript">
        window.fullCalendarConfig = {
            schedulerLicenseKey: '{{ config.fullcalendar_scheduler_license_key }}',
            userId: Number('{{ user.id }}') || null,
            folderId: Number('{{ folder.id }}') || null,
            componentId: Number('{{ component.instance.id }}') || null,
            // Days: 0 = max, must be at least 1.
            // Allegedly may be up to 1 year (or "all": wtf?),
            // but surely don't show all events for all time?
            days: Math.min(Math.max(1, Number('{{ component.config.days }}') || 365), 365),
            dateDisplayFormats: dateDisplayFormats,
            limit: Number('{{ component.config.size }}') || null,
            createEventUrl: "{{ routeLookup('calendarEvent.getCreate') }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}&level=2&homepageId={{ folder.id }}",
            exportUrl: $.fn.getExportCalendarLink(
                "{{ user.key }}",
                {
                    'export': 'group',
                    'group': Number('{{ folder.id }}') || null,
                }
            ),
            importEventsUrl: "/calendar/import/{{ folder.id }}",
            canCreateEvent: Boolean("{{ canCreateEvent }}"),
        };
    </script>
{% endautoescape %}
<div id="calendar" >
    <calendar-component />
</div>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/calendarComponent.js?v={{ config.site_version }}"></script>
