{% autoescape 'js' %}
    <script type="text/javascript">
        window.fullCalendarConfig = {
            userId: Number('{{ user.id }}') || null,
            folderId: Number('{{ folder.id }}') || null,
            // Days: 0 = max, must be at least 1.
            // Allegedly may be up to 1 year (or "all": wtf?),
            // but surely don't show all events for all time?
            days: Math.min(Math.max(1, Number('{{ component.config.days }}') || 365), 365),
        };
    </script>
{% endautoescape %}

<div class="row">
    <div class="small-12 island">
        <section>
            <div id="calendar">
                Loading events...
            </div>
            <script type="text/javascript" src="/javascript/components/calendarComponent.bundle.js?v={{ config.site_version }}"></script>
        </section>

        {# Add events part #}
        <div class="component-action">
            <section>
                {% if canCreateEvent %}
                    <a href="{{ routeLookup('calendarEvent.getCreate') }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}&amp;level=2&amp;homepageId={{ folder.id }}" class="button">Add Event</a>
                {% endif %}

                <a id="calendar-export" href="#" data-reveal-id="calendar-export-dialog" class="button">Export Events</a>

                {% if canCreateEvent %}
                    <a href="/calendar/import/{{ folder.id }}" class="button">Import Events</a>
                {% endif %}
            </section>
        </div>
    </div>
</div>
