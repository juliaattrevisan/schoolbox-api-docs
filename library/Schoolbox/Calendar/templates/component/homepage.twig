{% autoescape 'js' %}
    <script type="text/javascript" src="/javascript/components/zeroclipboard/dist/ZeroClipboard.min.js"></script>
    <script type="text/javascript" src="/javascript/shared/jquery.clipboard-selector.js"></script>
    <script type="text/javascript">
        window.fullCalendarConfig = {
            userId: Number('{{ user.id }}') || null,
            folderId: Number('{{ folder.id }}') || null,
            // Days: 0 = max, must be at least 1.
            // Allegedly may be up to 1 year (or "all": wtf?),
            // but surely don't show all events for all time?
            days: Math.min(Math.max(1, Number('{{ component.config.days }}') || 365), 365),
            dateDisplayFormats: dateDisplayFormats,
            limit: Number('{{ component.config.size }}') || null,
            createEventUrl: "{{ routeLookup('calendarEvent.getCreate') }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}&level=2&homepageId={{ folder.id }}",
            importEventsUrl: "/calendar/import/{{ folder.id }}",
        };

        $(function() {
            // Attach rsvp/unattend functionality to rsvp butttons
            $('form[data-rsvp-form]').calendarAttendance();

            $('#component{{ component.id }}').clipboardSelector({
                userToken: '{{ user.key }}',
                groupId: Number('{{ folder.id }}'),
            });
        });
    </script>
{% endautoescape %}

<div class="row">
    <div class="small-12 island">
        <section>
            <div id="calendar">
                Loading events...
            </div>
            <script type="text/javascript" src="/javascript/components/calendarComponent.bundle.js?v={{ config.site_version }}"></script>
        </section>

        {# Add events part #}
        <div class="component-action">
            <section>
                {% if canCreateEvent %}
                    <a href="{{ routeLookup('calendarEvent.getCreate') }}?{{ RETURN_URL.name }}={{ RETURN_URL.current }}&amp;level=2&amp;homepageId={{ folder.id }}" class="button">Add Event</a>
                {% endif %}

                <a id="calendar-export" href="#" data-reveal-id="calendar-export-dialog" class="button">Export Events</a>

                {% if canCreateEvent %}
                    <a href="/calendar/import/{{ folder.id }}" class="button">Import Events</a>
                {% endif %}
            </section>
        </div>
    </div>
</div>

<div id="calendar-export-dialog" class="reveal-modal" data-reveal>
    <div id="calendar-export-dialog-text">
        Use the following address to subscribe your favourite calendar application to a live feed.
    </div>

    <textarea readonly id="calendar-export-dialog-url" rows="6"></textarea>

    <a class="button icon-copy" id="copy-button" data-clipboard-target="calendar-export-dialog-url" title="Click to copy me.">Copy to Clipboard</a>
    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>
