<ul class="action-list">
    {% for guest in guests %}
    <li class="actions-small-1">
        <div class="compact card small-11">
            <a href="/search/user/{{ guest.id }}" title="View Profile">
                <img src="/portrait.php?userId={{ guest.id }}&size=square64" />

                <p>{{ guest.name }}</p>
            </a>
        </div>
        <nav>
            <a data-guest-delete="{{ guest.id }}" data-guest-name="{{ guest.name }}" class="icon-close no-text" href="{{ routeLookupIfAuthorized('calendarEventAttendance.postDelete', {id: event.id}) }}" title="Remove guest"></a>
        </nav>
    </li>
    {% endfor %}
</ul>
