{##
 # Event Create/Update screen
 #
 # @param Event      $event                        An Event instance
 # @param User       $user                         A User instance (this person receives the event on their calendar)
 # @param Collection $eventTypes                   A list of Event Types
 # @param array      $recurrence                   A list of recurring instances
 # @param array      $efficacy                     An array of key-value pairs corresponding to 'self' and 'series' efficacies consts
 # @param array      $levels                       An array of Event Levels (personal/group/school)
 # @param array      $roles                        A list of available and selected Roles
 # @param array      $folders                      A list of available and selected Folders
 # @param array      $campuses                     A list of available and selected Campuses
 # @param string     $returnUrl                    A Redirect-encoded string (you go here after saving the form)
 # @param array      $attendanceLevels             A set of consts and their meaning, key-value pairs
 # @param int        $attendanceLevelNoAttendance  An int corresponding to No Attendance
 # @param Event      $event         An Event instance
 # @param User       $user          A User instance (this person receives the event on their calendar)
 # @param Collection $eventTypes    A list of Event Types
 # @param array      $recurrence    A list of recurring instances
 # @param array      $efficacy      An array of key-value pairs corresponding to 'self' and 'series' efficacies consts
 # @param array      $levels        An array of Event Levels (personal/group/school)
 # @param array      $roles         A list of available and selected Roles
 # @param array      $folders       A list of available and selected Folders
 # @param array      $campuses      A list of available and selected Campuses
 # @param string     $returnUrl     A Redirect-encoded string (you go here after saving the form)
 #}
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/ckeditor/ckeditor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/editor/jquery.editor.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/calendar/jquery.eventModify.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/attacher/attacher.hide-watch.js?v={{ config.site_version }}"></script>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/select-all/attacher.select-all.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function() {
        $.fn.alaressEditor();

        $('#eventForm').eventModify({
            functionLabel: "{{ action ?? '' }}",
            deleteButton: $('[data-action="delete"]')
        });

        // Collapsables
        $('[data-collapser=true]').collapsable({
            container: '[data-collapsable-container]'
        });
    });
</script>

{# Decide context for creating/modifying an event
 # This is purely cosmetic now
 #}
{% set action = 'Add' %}

{% if event.id %}
    {% set action = 'Update' %}
{% endif %}

<ul class="breadcrumb">
    <li><a href="/calendar">{{ locale.calendar.proper }}</a></li>
    <li class="active"><span>{{ action }} Event</span></li>
</ul>

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ action }} Event</h1>
        </div>
    </div>
    {% if event.id %}
        <nav><a href="#" class="icon-overflow" data-dropdown="overflow"></a></nav>
        <ul class="f-dropdown" data-dropdown-content id="overflow">
            <li><a data-action="delete" href="{{ routeLookupIfAuthorized('calendarEvent.postDelete', {eventId: event.id}) }}?{{ returnUrl }}" class="icon-delete">Delete Event</a></li>
        </ul>
    {% endif %}
</div>

<div class="row">
    <div class="small-12 island">
        {% if event.id %}
            {% set formRoute = routeLookupIfAuthorized('calendarEvent.postModify', {eventId: event.id}) %}
        {% else %}
            {% set formRoute = routeLookupIfAuthorized('calendarEvent.postCreate') %}
        {% endif %}

        {# Append returnUrl encoding if supplied
         # It's used generally from the event modal
         #}
        {% if returnUrl|length %}
            {% set formRoute = formRoute ~ '?' ~ returnUrl %}
        {% endif %}
        <form id="eventForm" method="post" action="{{ formRoute }}" class="top">
            <input name="id" type="hidden" value="{{ event.id }}" />
            <input name="userId" type="hidden" value="{{ user.id }}" />
            <input name="authorId" type="hidden" value="{{ event.author.id }}" />
            <input id="allDay" name="allDay" type="hidden" value="{{ event.allDay }}">
            <input id="efficacy" name="efficacy" type="hidden" value="{{ efficacy.self }}" />

            <section>
                <fieldset class="content">
                    <legend>Overview</legend>
                    <div class="small-12 column">
                        <label class="required" for="title">Title</label>
                        <input name="title" id="title" type="text" maxlength="250" value="{{ event.title }}" required />
                    </div>
                    <div class="small-6 columns">
                        <label class="required" for="startDate">
                            From
                        </label>
                        <input name="startDate" id="startDate" data-datepicker data-datepicker-time data-datepicker-alldayswitch data-datepicker-alldayinput="allDay" data-datepicker-call="event" data-datesync-enddate="#endDate" type="text" size="15" maxlength="30" value="{{ event.allDay ? event.startDateTime.localShort : event.startDateTime.local }}"/>
                    </div>
                    <div class="small-6 columns">
                        <label class="required" for="endDate">
                            Until
                        </label>
                        <input name="endDate" id="endDate" data-datepicker data-datepicker-time data-datepicker-alldayswitch data-datepicker-alldayinput="allDay" data-datepicker-call="event" data-datepicker-endofperiod data-datesync-startdate="#startDate" type="text" size="15" maxlength="30" value="{{ event.allDay ? event.endDateTime.localShort : event.endDateTime.local }}"/>
                    </div>
                </fieldset>

                <fieldset class="content" data-collapsable-container>
                    <legend>
                        <span data-collapser="true" href="#" class="icon-down-arrow">
                            <a href="#" title="Collapse Content">Recurrence</a>
                        </span>

                    </legend>
                    <div class="small-12 columns {{ recurrence|length ? '' : 'hide' }}" data-collapsable="true" data-collapse-state="{{ recurrence|length ? 'uncollapsed' : 'collapsed' }}">
                        <div class="row">
                            {% if recurrence|length %}
                                <div id="repeat-reminder" class="small-12 columns">
                                    <div class="alert-box">
                                        <h5>This event is part of a recurring series</h5>
                                        <p>{{ recurrence.freq|capitalize }}, beginning <strong>{{ recurrence.start.longDateOnly }}</strong> and ending <strong>{{ recurrence.end.longDateOnly }}</strong></p>
                                    </div>
                                </div>
                            {% else %}
                                <div class="small-6 columns">
                                    <label>Repeat
                                        <span data-tooltip class="hint has-tip tip-top" data-width="200" title="The frequency with which this event recurs, if at all">?</span>
                                        <select name="repeat">
                                            <option value="">Single Event</option>
                                            <option value="daily">Daily</option>
                                            <option value="weekly">Weekly</option>
                                            <option value="fortnightly">Fortnightly</option>
                                            <option value="monthly">Monthly</option>
                                        </select>
                                    </label>
                                </div>
                                <div id="repeatUntil" class="small-6 columns" data-repeat-until>
                                    <label>
                                        Repeat Until
                                        <span data-tooltip class="hint has-tip tip-top" data-width="200" title="The date at which recurrence should cease">?</span>
                                        <input name="repeat_until" id="repeat-until" data-datepicker type="text" size="15" maxlength="30" value="{{ event.startDateTime.localShort }}" />
                                    </label>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Event Details</legend>
                    <div class="small-12 column">
                        <label>
                            Type
                            <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Select the type of event. This will be represented via different colours">?</span>
                            {% if eventTypes|length %}
                                <select name="type">
                                    {% for eventType in eventTypes %}
                                        <option value="{{ eventType.id }}" {{ eventType.id == event.type.id ? 'selected="selected"' : '' }}>{{ eventType.type }}</option>
                                    {% endfor %}
                                </select>
                            {% else %}
                                <input type="hidden" name="type" value="{{ event.type.id }}" />
                            {% endif %}
                        </label>
                    </div>
                    <div class="small-12 column">
                        <label>
                            Location
                            <input name="location" type="text" value="{{ event.location }}" maxlength="250"/>
                        </label>
                    </div>
                    <div class="small-12 column">
                        <label>
                            Details
                            <textarea class='event-detail' name="detail">{{ event.detail }}</textarea>
                        </label>
                    </div>
                </fieldset>

                <fieldset class="content">
                    <legend>Availability</legend>
                    <div class="small-12 columns">
                        <label>
                            Publish Date
                            <span data-tooltip class="hint has-tip tip-top" data-width="200" title="This event will only be visible to the public on or after this date">?</span>
                            <input id="publishDate" name="publishDate" data-datepicker data-datepicker-alldayswitch data-datepicker-time data-datepicker-format="datetime" type="text" size="15" maxlength="30" value="{{ event.publishDateTime.local }}"/>
                        </label>
                    </div>
                    <div class="small-12 columns">
                        <label>
                            Level
                            <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Select who you would like to be able to see this event">?</span>
                            <select name="level" id="level" data-interaction="select-level">
                                {% for level in levels.all %}
                                    <option value="{{ level.id }}" {{ level.id == levels.selected ? 'selected="selected"' : '' }}>{{ level.name }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                    <div class="small-12 column" data-hide-watch="[data-interaction='select-level']" data-hide-watch-value="2">
                        <fieldset class="checklist">
                            <legend>
                                Groups
                                <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Select the group which will be able to view this event">?</span>
                            </legend>
                            <ul class="option-list">
                                {% for folder in folders.all %}
                                    <li>
                                        <input type="checkbox" name="folder[]" value="{{ folder.id }}" id="folder{{ folder.id }}" {{ folder.id in folders.selected ? 'checked="checked"' : '' }} />
                                        <label for="folder{{ folder.id }}" class="checkbox">{{ folder.name }}</label>
                                    </li>
                                {% endfor %}
                            </ul>
                        </fieldset>
                    </div>
                    <div class="small-12 large-6 column" data-hide-watch="[data-interaction='select-level']" data-hide-watch-value="3">
                        <fieldset class="checklist">
                            <legend>
                                Roles
                                <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Select the roles which will be able to view this event">?</span>
                            </legend>
                            <ul class="option-list">
                                <li>
                                    <input type="checkbox" data-select-all id="roleSelectAll"/>
                                    <label for="roleSelectAll">Select all</label>
                                </li>
                                {% for role in roles.all %}
                                    <li>
                                        <input type="checkbox" name="roles[]" id="role{{ role.id }}" value="{{ role.id }}" {{ role.id in roles.selected ? 'checked="checked"' : '' }} />
                                        <label for="role{{ role.id }}">{{ role.name }}</label>
                                    </li>
                                {% endfor %}
                            </ul>
                        </fieldset>
                    </div>
                    <div class="small-12 large-6 column" data-hide-watch="[data-interaction='select-level']" data-hide-watch-value="3">
                        <fieldset class="checklist">
                            <legend>
                                Campus
                                <span data-tooltip class="hint has-tip tip-top" data-width="200" title="Select the campus' which will be able to view this event">?</span>
                            </legend>
                            <ul class="option-list">
                                <li>
                                    <input type="checkbox" data-select-all id="campusSelectAll" />
                                    <label for="campusSelectAll">Select all</label>
                                </li>
                                {% for campus in campuses.all %}
                                    <li>
                                        <input type="checkbox" class="campusCheck" name="campus[]" id="campus{{ campus.id }}" value="{{ campus.id }}" {{ campus.id in campuses.selected ? 'checked="checked"' : '' }} />
                                        <label for="campus{{ campus.id }}">{{ campus.name }}</label>
                                    </li>
                                {% endfor %}
                            </ul>
                        </fieldset>
                    </div>
                </fieldset>

                {% if canInvite %}
                <fieldset id="attendance" class="content">
                    <legend>Attendance</legend>

                    <div class="small-12 column">
                        <label>
                            Enable attendance?
                            <span data-tooltip class="hint has-tip tip-top" data-width="200" title="You may use attendance to invite specific guests, or publish an open event that people may choose to  join. Open personal events will be visible on your calendar.">?</span>

                            <select name="attendance" id="attendanceLevelSelector">
                                {% for value, label in attendanceLevels %}
                                    <option value="{{ value }}" {% if value == event.attendance %}selected="selected"{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </label>

                        {# Hide the attendance inputs if No Attendance is selected
                         # Otherwise, show the attendance inputs
                         #}
                        <script>
                            $(function() {
                                /* Init the attendance options based on dropdown's current value
                                 */
                                if ('{{ attendanceLevelNoAttendance }}' == $('#attendanceLevelSelector').val()) {
                                    $('#attendance-guests').hide();
                                }

                                $('#attendanceLevelSelector').on('change', function(event) {
                                    if ($(this).val() == '{{ attendanceLevelNoAttendance }}') {
                                        $('#attendance-guests').hide();
                                    } else {
                                        $('#attendance-guests').show();
                                    }
                                });
                            });
                        </script>
                    </div>

                    <div id="attendance-guests" class="small-12 columns" {% if event.attendance == '{{ attendanceLevelNoAttendance }}' %}style="display:none"{% endif %}>
                        <div class="row">
                            <div class="small-12 columns">
                                <label>Invite Guests</label>
                                <input id='add-guests' name="guests" type='text' value='' placeholder="Search for people to invite" />
                                <script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/selectize.min.js?v={{ config.site_version }}"></script>
                                <script type="text/javascript" src="{{ CDN_PREFIX }}/js/vendors/selectize/jquery.selectize-selector.js?v={{ config.site_version }}"></script>
                                <script type="text/javascript">
                                    $(function() {
                                        $('#add-guests').selectizeSelector({
                                            ajax: {
                                                url:      '/ajax/user.php',
                                                type:     'GET',
                                                data:     {groupID: 0, showCampus: true},
                                                dataType: 'json'
                                            },
                                            value: [
                                                {% for guest in guests %}
                                                {'id': '{{ guest.id }}', 'name': '{{ guest.name | escape('js') }}'},
                                                {% endfor %}
                                            ],
                                            multiple: true
                                        });
                                    });
                                </script>
                            </div>
                            <div class="small-12 medium-6 columns">
                                <label>Maximum Attendees <span class="hint has-tip tip-top" title="The maximum amount of people who can attend your event" data-tooltip>?</span></label>
                                <input name="maxAttendees" maxlength="5" type="number" value="{{ event.maxAttendees }}" />
                            </div>
                            <div class="small-12 medium-6 columns">
                                <label>
                                    Show Guest List <span class="hint has-tip tip-top" title="Control the visibility of the guest list to other guests, you will always see the guest list." data-tooltip>?</span>
                                    <div class="switch">
                                        <input id="showAttendees" name="showAttendees" type="checkbox" value="1" {{ event.showAttendees ? 'checked="checked"' : '' }}>
                                        <label for="showAttendees">
                                            <span>On</span>
                                            <span>Off</span>
                                        </label>
                                    </div>
                                </label>
                            </div>

                        </div>

                        {# Show the Guests input if attendance is enabled
                         # Hide the Guests input if attendance is disabled
                         #}
                        <script>
                            $(function() {
                                $('#attendanceCheckbox').on('change', function(event) {
                                    if ($(this).is(':checked')) {
                                        $('#attendance-guests').show();
                                    } else {
                                        $('#attendance-guests').hide();
                                    }
                                });
                            });
                        </script>
                    </div>
                </fieldset>
                {% endif %}
            </section>
            <input id="calendar-modify-submit" type="submit" value="{{ action }} Event" />
        </form>
    </div>
</div>

<div class="reveal-modal" data-reveal data-dialog="bulk-modify">
    <h2>This event is part of a series</h2>
    <p class="icon-alert">
        Would you like to update only this event, or all in the series? If any events in the series have been modified, the changes will be overridden.
    </p>
    <ul class="flex-list buttons">
        <li><a href="#" class="button" data-action="self">Only this event</a></li>
        <li><a href="#" class="button" data-action="series">All events in the series</a></li>
        <li><a href="#" class="button" data-action="cancel">Cancel</a></li>
    </ul>
</div>
<div class="reveal-modal" data-reveal data-dialog="bulk-delete">
    <h2>This event is part of a series</h2>
    <p class="icon-alert">
        Would you like to delete only this event, or all in the series?
    </p>
    <ul class="flex-list buttons">
        <li><a href="#" class="button" data-action="self">Only this event</a></li>
        <li><a href="#" class="button" data-action="series">All events in the series</a></li>
        <li><a href="#" class="button" data-action="cancel">Cancel</a></li>
    </ul>
</div>

