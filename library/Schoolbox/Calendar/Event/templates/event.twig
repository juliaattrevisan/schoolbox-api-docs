<div class="row" id="event-details">
    {% set eventData = {
        "id"      : event.id,
        "title"   : event.title,
        "location": event.location,
        "author"  : {
            id      : event.author.id,
            fullName: event.author.fullName,
        },
        "detail"  : event.detail,
        "options" : {
            "allDay": event.allDay,
            "type"  : {
                "name": event.type.type,
                "color": event.type.color,
            },
            "isAttendable": event.attendance,
        },
        "dates"   : {
            "start": event.startDateTime.getDatabase,
            "end"  : event.endDateTime.getDatabase,
        },
        "audiences" : {
            "campus"    : campusCollection,
            "roles"     : roleCollection,
            "folders"   : folderCollection
        },
        'guests'     : guests,
        "attendance" : attendance,
        "canModify"  : canModify,
        "level"      : level,
    } %}

    <event-details :event="{{ eventData | json_encode }}"></event-details>
</div>

<script src="/javascript/components/eventDetails.bundle.js"></script>
<script type="text/javascript" src="/javascript/components/selectize/dist/js/standalone/selectize.min.js"></script>
<script type="text/javascript" src="/javascript/shared/selectize/jquery.selectize-selector.js"></script>
<script type="text/javascript">
    $(function() {
        $('#add-guests').selectizeSelector({
            ajax: {
                url:      '/ajax/user.php',
                type:     'GET',
                data:     {groupID: 0, showCampus: true},
                dataType: 'json'
            },
            multiple: true
        });

        $('#attendance-guests').on('change', '#add-guests', function(event) {
            event.preventDefault();

            /* User's name
             */
            let user = $('#attendance-guests [data-value]:last')
            let name = user.html().split(' - ')[0];
            let id = user.attr('data-value');

            /* Existing users
             */
            let existingGuests = $('input[name="existingGuests[]"]').map(function(index, element) {
                return $(element).val();
            }).get();

            let element = $(this);

            /* A toast - to your valour, my sword, and our victory together
             */
            let $toast = $('[data-toast]');

            $toast.toastActivate({
                text: 'Adding ' + name + '...'
            });

            $.ajax({
                url: element.parents('form').attr('action'),
                method: 'POST',
                data: {
                    guests: id,
                    existingGuests: existingGuests
                },
                success: function(responseText) {
                    $toast.toastTimeout({
                        text: name + ' has been added',
                        css: 'success'
                    });
                },
                error: function(responseText) {
                    $toast.toastTimeout({text: 'Could not add ' + name, css: 'alert'});
                }
            });
        });

        $('#attendance-guests').on('click', '[data-guest-delete]', function(event) {
            event.preventDefault();

            let element = $(this);

            element.confirmDialog({
                text: 'Are you sure you want to remove attendance for ' + element.attr('data-guest-name') + '?',
                confirmEvent: function() {

                    /* User's name
                     */
                    let name = element.attr('data-guest-name');

                    /* A toast - to your valour, my sword, and our victory together
                     */
                    let $toast = $('[data-toast]');

                    $toast.toastActivate({
                        text: 'Removing ' + name + '...'
                    });

                    $.ajax({
                        url: element.attr('href'),
                        method: 'POST',
                        data: {guest: element.attr('data-guest-delete')},
                        success: function(responseText) {
                            $toast.toastTimeout({
                                text: name + ' has been removed',
                                css: 'success'
                            });
                        },
                        error: function(responseText) {
                            $toast.toastTimeout({text: 'Could not remove ' + name, css: 'alert'});
                        }
                    });
                }
            });
        });
    });
</script>
