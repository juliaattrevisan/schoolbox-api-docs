<div id="event-details">
    {% set eventData = {
        "id"      : event.id,
        "seriesId": event.seriesId,
        "title"   : event.title,
        "location": event.location | purify,
        "author"  : {
            id      : event.author.id,
            fullName: event.author.fullName,
        },
        "detail"  : event.detail | purify,
        "options" : {
            "allDay": event.allDay,
            "type"  : {
                "name": event.type.type,
                "color": event.type.color,
            }
        },
        "dates"   : {
            "start": event.startDateTime.getDatabase,
            "end"  : event.endDateTime.getDatabase,
        },
        "audiences" : {
            "campus"    : campusCollection,
            "roles"     : roleCollection,
            "folders"   : folderCollection
        },
        "attendance" : attendance,
        "showAttendees" : event.showAttendees,
        "canModify"  : canModify,
        "level"      : level,
        "canBookResources" : canBookResources,
    } %}

    {# Resource booking data will only be available if the resource booking module is enabled. #}
    {% if resourceBookingCollection is defined %}
        {% set eventData = eventData | merge({"resourceBookings": resourceBookingCollection}) %}
    {% endif %}

    <calendar-event-details :event="{{ eventData | json_encode }}"></calendar-event-details>
</div>

<script src="{{ CDN_PREFIX }}/js/bundle/calendarEventDetails.js?v={{ config.site_version }}"></script>
