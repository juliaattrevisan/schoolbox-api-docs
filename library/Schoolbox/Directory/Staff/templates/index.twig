{# To allow schools to alter whats displayed in the columns #}
{% set columnsConfig = [
    { heading: "Image", data: "portrait_url", class: "portrait-td", isSortable: false },
    { heading: "First name", data: "StaffPreferredName", class: ""  },
    { heading: "Surname", data: "StaffSurname", class: "" },
    { heading: "Department", data: "StaffDepartment", class: "hide-for-medium-down" },
    { heading: "Role", data: "JobPositionDescription", class: "hide-for-small" },
    { heading: "Campus", data: "StaffCampusDescription", class: "hide-for-medium-down" },
    { heading: "Phone", data: "StaffOccupPhone", class: "" },
    { heading: "Ext", data: "StaffExtension", class: "" },
    { heading: "Email", data: "StaffOccupEmail", class: "" },
] %}

{# Add any config specific to the staff directory table #}
{% set tableConfig = {
    orderBy: {
        ascending: true,
        column: "StaffSurname",
    },
    texts: {
        count: "{from}-{to} of {count} members|{count} members|1 member",
        filterPlaceholder: "Search staff members...",
        noResults: "No matching staff members",
    },
 } %}

 {% set templates = [
    {
        name: "portrait_url",
        component: "image",
        componentData: {
            src: "portrait_url",
            href: "profile_url",
            title: "View profile",
            alt: "Portrait photo of user",
        }
    },
    {
        name: "StaffPreferredName",
        component: "link",
        componentData: {
            text: "StaffPreferredName",
            href: "profile_url",
            title: "View profile",
        }
    },
    {
        name: "StaffSurname",
        component: "link",
        componentData: {
            text: "StaffSurname",
            href: "profile_url",
            title: "View profile",
        }
    },
    {
        name: "StaffOccupPhone",
        component: "link",
        componentData: {
            text: "StaffOccupPhone",
            href: "StaffOccupPhone",
            prependHref: "tel:",
            title: "View profile",
        }
    },
    {
        name: "StaffOccupEmail",
        component: "link",
        componentData: {
            text: "StaffOccupEmail",
            href: "StaffOccupEmail",
            prependHref: "mailto:",
            title: "View profile",
        }
    }
 ] %}

<style>
.VueTables__table .portrait-td {
    max-width: 3rem; /* prevent the image column from being too wide */
}
</style>

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Staff Directory</h1>
        </div>
    </div>
</div>

<div id="data-table-container">
    <data-table
        endpoint="{{ routeLookupIfAuthorized('staffDirectory.getPayload') }}"
        :columns-config="{{ columnsConfig|json_encode() }}"
        :table-options="{{ tableConfig|json_encode() }}"
        :templates="{{ templates|json_encode() }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/dataTable.js?v={{ config.site_version }}"></script>
