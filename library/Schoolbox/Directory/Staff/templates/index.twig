{# To allow schools to alter whats displayed in the columns #}
{% set columnsConfig = [
    { heading: "Image", data: "portrait_url", class: "image-td" },
    { heading: "First name", data: "StaffPreferredName", class: ""  },
    { heading: "Surname", data: "StaffSurname", class: "" },
    { heading: "Department", data: "StaffDepartment", class: "hide-for-medium-down" },
    { heading: "Role", data: "JobPositionDescription", class: "hide-for-small" },
    { heading: "Campus", data: "StaffCampusDescription", class: "hide-for-medium-down" },
    { heading: "Phone", data: "StaffOccupPhone", class: "" },
    { heading: "Ext", data: "StaffExtension", class: "" },
    { heading: "Email", data: "StaffOccupEmail", class: "" },
] %}

{% set tableConfig = {
    orderBy: {
        ascending: true,
        column: "StaffSurname",
    },
    sortable: ["StaffPreferredName", "StaffSurname", "StaffDepartment", "JobPositionDescription", "StaffCampusDescription", "StaffOccupPhone", "StaffExtension", "StaffOccupEmail"],
    texts: {
        count: "{from}-{to} of {count} members|{count} members|1 member",
        filterPlaceholder: "Search staff members...",
        noResults: "No matching staff members",
    },
 } %}

<div class="row actions-small-1">
    <div class="list-item">
        <div class="small-12 columns">
            <h1>Staff Directory</h1>
        </div>
    </div>
</div>

<div id="staff-directory-container">
    <staff-directory
        endpoint="{{ routeLookupIfAuthorized('staffDirectory.getPayload') }}"
        :columns-config="{{ columnsConfig|json_encode() }}"
        :table-options="{{ tableConfig|json_encode() }}"
    />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/staffDirectory.js?v={{ config.site_version }}"></script>
