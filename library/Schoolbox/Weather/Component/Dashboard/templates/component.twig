{#
 # Weather dashboard component version 2
 # @param int componentInstanceId
 # @param bool weatherAvailable
 # @param array today
 # @param array forecastDays
#}

<div id="weather-container-{{ componentInstanceId }}">
    <div class="row {CONFIG_COLLAPSED_CLASS}" data-collapsable='true' data-collapse-state="{CONFIG_COLLAPSED_STATE}">
        <div class="small-12 island">

            {% if weatherAvailable %}

                <section>
                    <ul class="weather-list">
                        <li data-equalizer>
                            <div class="list-item">
                                <div class="row">
                                    <div class="small-12 medium-3 columns">
                                        <p class="text-center current-value">Now</p>
                                    </div>
                                    <div class="small-12 medium-3 columns">
                                        <p class="text-center">
                                            <img src="{{ today.weatherIcon }}" title="{{ today.weatherSummary }}" alt="{{ today.weatherSummary }}" />
                                        </p>
                                    </div>
                                    <div class="small-12 medium-3 columns">
                                        <p class="text-center current-value">{{ today.currentTemp }}&deg;C</p>
                                    </div>
                                    <div class="small-12 medium-3 columns">
                                        <p class="text-center current-value">UV Index {{ today.uvIndex}}</p>
                                    </div>
                                </div>
                            </div>
                        </li>

                        {% for forecastDay in forecastDays %}
                        <li class="future-day">
                            <div class="list-item">
                                <div class="row">
                                    <div class="small-12 medium-3 columns">
                                        <p class="text-center current-value">{{ forecastDay.day }}</p>
                                    </div>
                                    <div class="small-12 medium-3 columns">
                                        <p class="text-center">
                                            <img src="{{ forecastDay.weatherIcon }}" title="{{ forecastDay.weatherSummary }}" alt="{{ forecastDay.weatherSummary }}"/>
                                        </p>
                                    </div>
                                    <div class="small-12 medium-3 columns">
                                        <p class="text-center hot">{{ forecastDay.highTemp }}&deg;C</p>

                                    </div>
                                    <div class="small-12 medium-3 columns">
                                        <p class="text-center cold">{{ forecastDay.lowTemp }}&deg;C</p>
                                    </div>
                                </div>
                            </div>
                        </li>
                        {% endfor %}
                    </ul>

                    <div class="component-action">
                        <section>
                            <a href="{{ routeLookup('weather.getWeatherDetails') }}?location={{ weeklyForecastLocation }}" title="View Weekly Forecast" class="button">View Weekly Forecast</a>
                        </section>
                    </div>
                </section>

            {% else %}

                <div class="content">
                    <div data-alert="" class="alert-box alert">
                        Weather forecast is temporarily unavailable.
                    </div>
                </div>

            {% endif %}

        </div>
    </div>
</div>
