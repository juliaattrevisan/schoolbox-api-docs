{#
 # Weather dashboard component version 2
 #}

<div id="weather-container-{{ componentInstanceId }}">
    <div class="row {CONFIG_COLLAPSED_CLASS}" data-collapsable='true' data-collapse-state="{CONFIG_COLLAPSED_STATE}">
        <div class="small-12 island">

            {% if weatherUnavailable %}

                <div class="content">
                    <p class="meta">Weather forecast is temporarily unavailable.</p>
                    <p>{{ error }}</p>
                </div>

            {% else %}

                <section>
                    <ul class="weather-list-summary">
                        <li data-equalizer>
                            <div class="list-item weather-forecast current">
                                <p class="day-heading">{{ today.day }}</p>

                                <img src="{{ today.weatherIcon }}" title="{{ today.weatherSummary }}" alt="{{ today.weatherSummary }}"/>

                                <p>{{ today.currentTemp }}&deg;C</p>
                            </div>
                        </li>
                        {% for forecastDay in forecastDays %}
                            <li data-equalizer>
                                <div class="list-item weather-forecast">
                                    <p class="day-heading">{{ forecastDay.day }}</p>

                                    <img src="{{ forecastDay.weatherIcon }}" title="{{ forecastDay.weatherSummary }}" alt="{{ forecastDay.weatherSummary }}"/>

                                    <p class="hot">{{ forecastDay.highTemp }}&deg;C</p>
                                    <p class="cold">{{ forecastDay.lowTemp }}&deg;C</p>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="component-action">
                        <section>
                            <a href="/weather/" title="View Weekly Forecast" class="button">View Weekly Forecast</a>
                        </section>
                    </div>
                </section>

            {% endif %}

        </div>
    </div>
</div>

