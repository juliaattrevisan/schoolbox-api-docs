{
    "compilerOptions": {
        "allowJs": true, // Allow JavaScript files to be imported inside your project,
        "baseUrl": "./", // base directory of where import is referenced from
        "esModuleInterop": true, // resolves potential transpile issues: https://www.typescriptlang.org/tsconfig#esModuleInterop
        "forceConsistentCasingInFileNames": true, // When this option is set, TypeScript will issue an error if a program tries to include a file by a casing different from the casing on disk.
        "jsx": "preserve", // to link methods/properies in Vue <template> to <script> in Single File Components
        "moduleResolution": "node",
        "paths": {
            "@schoolboxLearningMomentEvidence/*": ["library/Schoolbox/Learning/Moment/Evidence/vue/*"],
            "@schoolboxCurriculum/*": ["library/Schoolbox/Curriculum/templates/*"],
            "@schoolboxBadge/*": ["library/Schoolbox/Learning/Badge/*"],
            "@schoolboxAssessment/*": ["library/Schoolbox/Assessment/*"],
            "@schoolboxLearnosity/*": ["library/Schoolbox/Learning/Learnosity/templates/*"],
            "@schoolboxVue/*": ["vue/*"],
            "@schoolboxTest/*": ["test/*"],
            "@js/*": ["www/static/js/*"],
        },
        "skipLibCheck": true, // Skip type checking of declaration file:  https://www.typescriptlang.org/tsconfig#skipLibCheck
        "strict": true, // The strict flag enables a wide range of type checking behavior that results in stronger guarantees of program correctness.
        "target": "ES6" // Modern browsers support all ES6 features, so ES6 is a good choice.
    },
    "exclude": [ // Specifies an array of filenames or patterns that should be skipped when resolving include.
        ".git",
        ".vagrant",
        "conf",
        "debian",
        "docs",
        "node_modules",
        "packages",
        "sql",
        "tools",
        "updates",
        "vagrantcache",
        "vendor",
        "www/static/js/bundle",
    ],
    "include": [ // Specifies an array of filenames or patterns where ts files could exist
        "library/Schoolbox/**/*",
        "stories/**/*",
        "templates/core/**/*",
        "types/**/*",
        "vue/**/*",
        "www/static/js/**/*",
        "test/playwright/**/*",
        "playwright.config.ts",
    ]
}
