@startuml

participant "Worker\n<size:10>//\Schoolbox\Realtime\Routing\Worker//</size>" as Worker
participant "RouterTransmitterReceiver\n<size:10>//\Schoolbox\Realtime\Routing\RouteTXRX//</size>" as RouterTransmitterReceiver
participant "QueueSorter\n<size:10>//\Schoolbox\Realtime\Routing\QueueSorter//</size>" as QueueSorter
participant "PermissionMapper\n<size:10>//\Schoolbox\Realtime\Message\RoutePermissionMapper//</size>" as PermissionMapper
participant "DeliveryQueue\n<size:10>//\Alaress\Async\Queue\QueueInterface//</size>" as DeliveryQueue

group Worker Process
RouterTransmitterReceiver <- Worker : receive()
RouterTransmitterReceiver -> QueueSorter : process()
note left
    The worker knows to whom messages are sent:
    its job is to determine the delivery mechanism
    through which they're sent.
end note
QueueSorter <-> PermissionMapper : getReroutedLevel()
QueueSorter -> DeliveryQueue : push()
note left
    getReroutedLevel is used to determine exactly
    which DeliveryQueue instance is pushed to,
    and therefore the delivery mechanism for the
    message.
end note
end group

@enduml
