parameters:
    bootstrapFiles:
        - %rootDir%/../../../conf/core/require.php
    level: 4
    parallel:
        processTimeout: 300.0
    paths:
        - conf
        - dav
        - library
        - tools
    inferPrivatePropertyTypeFromConstructor: true
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#@var above a method has no effect#'

includes:
    - phpstan-baseline.neon
