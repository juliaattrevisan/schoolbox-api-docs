parameters:
    autoload_directories:
        - %rootDir%/../../../conf
        - %rootDir%/../../../test/codeception
        - %rootDir%/../../../test/behavior/bootstrap
        - %rootDir%/../../../test/notif/tests
    bootstrap: %rootDir%/../../../conf/core/require.php
    level: 2
    paths:
        - conf
        - dav
        - library
        - tools
    inferPrivatePropertyTypeFromConstructor: true
includes:
	- phpstan-baseline.neon
