parameters:
    bootstrapFiles:
        - %rootDir%/../../../conf/core/require.php
    level: 4
    parallel:
        processTimeout: 300.0
    paths:
        - conf
        - dav
        - library
        - tools
        - test/codeception
    excludePaths:
        - test/*/_generated/*
    inferPrivatePropertyTypeFromConstructor: true
    treatPhpDocTypesAsCertain: false

rules:
    - Alaress\PhpStan\Rule\PhpUnitTestName
    - Alaress\PhpStan\Rule\BacktickForbidden
services:
    -
        class: Alaress\PhpStan\Rule\PhpUnitTestName
        arguments:
            suffix: Test.php
        tags:
            - phpstan.rules.rule

includes:
    - phpstan-baseline.neon
