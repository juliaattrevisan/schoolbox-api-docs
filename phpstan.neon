parameters:
    bootstrapFiles:
        - %rootDir%/../../../conf/core/require.php
    level: 4
    parallel:
        processTimeout: 300.0
    paths:
        - conf
        - dav
        - library
        - tools
    inferPrivatePropertyTypeFromConstructor: true
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#@var above a method has no effect#'
        - '#is unused#'
        - '#is never read#'
        - '#Dead catch#'
        - '#in isset\(\) is not nullable#'
        - '#in isset\(\) always exists and is not nullable#'
        - '#in empty\(\) is not falsy#'
        - '#on left side of \?\? is not nullable#'

includes:
    - phpstan-baseline.neon
