parameters:
    autoload_directories:
        - %rootDir%/../../../conf
    bootstrap: %rootDir%/../../../conf/core/require.php
    level: 0
    paths:
        - conf
        - dav
        - library
        - test
        - tools
        - updates
        - www
    ignoreErrors:
        -
            message: '#Using \$this outside a class.#'
            path: %currentWorkingDirectory%/www/*
        -
            message: '#Undefined variable: \$this#'
            path: %currentWorkingDirectory%/www/*