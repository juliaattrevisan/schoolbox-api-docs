parameters:
    bootstrapFiles:
        - %rootDir%/../../../conf/core/require.php
    level: 4
    parallel:
        processTimeout: 300.0
    paths:
        - conf
        - dav
        - library
        - tools
        - test/codeception
    excludePaths:
        - test/*/_generated/*
    inferPrivatePropertyTypeFromConstructor: true

rules:
    - Alaress\PhpStan\Rule\PhpUnitTestName

includes:
    - phpstan-baseline.neon
