parameters:
    bootstrapFiles:
        - %rootDir%/../../../conf/core/require.php
    level: 4
    parallel:
        processTimeout: 300.0
    paths:
        - conf
        - dav
        - library
        - tools
    inferPrivatePropertyTypeFromConstructor: true
    excludes_analyse:
        - library/Schoolbox/Sync/Iterator/StackableTrait.php
        - library/Schoolbox/Sync/Iterator/Guardian.php
        - library/Schoolbox/Sync/Iterator/Staff.php
        - library/Schoolbox/Sync/Iterator/Student.php

includes:
	- phpstan-baseline.neon
