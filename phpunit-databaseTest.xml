<?xml version="1.0" encoding="UTF-8"?>

<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false"
         bootstrap="test/bootstrap/unit.php"
         defaultTestSuite="databaseTest"
>
  <testsuites>
    <testsuite name="databaseTest">
      <directory suffix=".php">library/Alaress/Database/Test</directory>
      <directory suffix=".php">library/Schoolbox/Database/Test</directory>
    </testsuite>
  </testsuites>
    <php>
        <!--
        Database tests require the Vagrant box's standard instance ID, in order
        to be granted access to the database.
        -->
        <env name="INSTANCE_ID" value="vagrantx" force="true" />
    </php>
</phpunit>
