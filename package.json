  "scripts": {
    "build": "NODE_ENV=development rspack --config rspack.dev.js",
    "watch": "NODE_ENV=development rspack --config rspack.dev.js --watch",
    "watch-poll": "NODE_ENV=development rspack --config rspack.dev.js --watch --watch-poll=1000",
