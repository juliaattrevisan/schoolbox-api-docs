  "scripts": {
    "build": "./node_modules/.bin/webpack-cli --config webpack.dev.js",
    "watch": "./node_modules/.bin/webpack-cli --config webpack.dev.js --watch",
    "watch-poll": "./node_modules/.bin/webpack-cli --config webpack.dev.js --watch --watch-poll=1000",
    "publish": "./node_modules/.bin/webpack-cli --config webpack.prod.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "test": "jest",
    "watch-test": "jest --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "npx eslint --max-warnings=0 --ext .ts,.vue .",
    "prettier:check": "npx prettier --check \"**/*.{js,ts,vue,mdx,css,scss}\"",
    "prettier:write": "npx prettier --write \"**/*.{js,ts,vue,mdx,css,scss}\""
