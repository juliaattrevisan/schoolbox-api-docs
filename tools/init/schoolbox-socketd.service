[Unit]
Description=Schoolbox Websocket Server
After=mysql.service redis-server.service rabbitmq-server.service
Requires=mysql.service redis-server.service rabbitmq-server.service

[Service]
Environment=SBVERBOSITY='--porcelain'
Environment=SBPORT=9081
ExecStartPre=/usr/share/schoolbox/tools/notif/syscheck.php -vvv
ExecStart=/usr/share/schoolbox/tools/socket/socketd.php -p${SBPORT} $SBVERBOSITY
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=2s
LimitNOFILE=40960:40960
Nice=5

[Install]
WantedBy=multi-user.target
