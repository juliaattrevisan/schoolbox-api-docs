Vagrant::Config.run do |config|

  config.vm.box = "ubuntu-12.04"
  config.vm.box_url = "http://vagrant.alaress-dev.com.au/ubuntu-12.04.box"
  
  config.vm.network :bridged
  config.vm.host_name = "ubuntubuild-schoolbox"

  config.vm.provision :puppet do |puppet|
     puppet.manifests_path = "manifests"
     puppet.manifest_file  = "ubuntubuild.pp"
  end

end
