/var/log/schoolbox-sync*.log {
	daily
	missingok
	rotate 30
	compress
	delaycompress
}

/var/log/schoolbox/binder*.log /var/log/schoolbox/ups*.log {
	daily
	missingok
	rotate 7
	compress
}

/var/log/schoolbox/quiz*.log /var/log/schoolbox/plagscan*.log /var/log/schoolbox/docman*.log /var/log/schoolbox/etherpad-sync*.log /var/log/schoolbox/remove-old-triggers.log {
	monthly
	missingok
	rotate 2
	compress
}

/var/log/schoolbox/upgrade.log {
	monthly
	missingok
	rotate 6
	compress
}

/var/log/schoolbox/*/upgrade.log {
	monthly
	missingok
	rotate 6
	compress
}

/var/lib/schoolbox/cache/logs/*.log {
	monthly
	missingok
	rotate 6
	compress
}

/var/log/schoolbox/cache-cleanup*.log  /var/log/schoolbox/set-config-data-dirs-perms*.log {
	weekly
	missingok
	rotate 5
	compress
}

/var/log/schoolbox/digestd*.log /var/log/schoolbox/scheduled*.log /var/log/schoolbox/socketd*.log /var/log/schoolbox/routed*.log /var/log/schoolbox/belld*.log {
	size 100M
	copytruncate
	missingok
	rotate 14
	compress
}
