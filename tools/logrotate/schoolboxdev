/var/log/schoolboxdev-sync*.log {
	daily
	missingok
	rotate 30
	compress
	delaycompress
}

/var/log/schoolboxdev/binder*.log /var/log/schoolboxdev/ups*.log {
	daily
	missingok
	rotate 7
	compress
}

/var/log/schoolboxdev/quiz*.log /var/log/schoolboxdev/plagscan*.log /var/log/schoolboxdev/docman*.log /var/log/schoolboxdev/etherpad-sync*.log /var/log/schoolboxdev/remove-old-triggers.log  {
	monthly
	missingok
	rotate 2
	compress
}

/var/log/schoolboxdev/upgrade.log {
	monthly
	missingok
	rotate 6
	compress
}

/var/log/schoolboxdev/*/upgrade.log {
	monthly
	missingok
	rotate 6
	compress
}

/var/lib/schoolboxdev/cache/logs/*.log {
	monthly
	missingok
	rotate 6
	compress
}

/var/log/schoolboxdev/cache-cleanup*.log  /var/log/schoolboxdev/set-config-data-dirs-perms*.log {
	weekly
	missingok
	rotate 5
	compress
}

/var/log/schoolboxdev/digestd*.log /var/log/schoolboxdev/scheduled*.log /var/log/schoolboxdev/socketd*.log /var/log/schoolboxdev/routed*.log /var/log/schoolboxdev/belld*.log {
	size 100M
	copytruncate
	missingok
	rotate 14
	compress
}
