<IfModule mod_ssl.c>
NameVirtualHost *:443
<VirtualHost *:443>
        ServerName schoolbox.schoolname.edu
        DocumentRoot /usr/share/schoolbox/www

        <Directory /usr/share/schoolbox>
                Options FollowSymLinks
                AllowOverride None
                Order allow,deny
                Allow from all
                Satisfy all
                <LimitExcept GET POST HEAD>
                        Order Allow,Deny
                        Deny from all
                        Satisfy all
                </LimitExcept>
        </Directory>

        SSLEngine on
        SSLCertificateFile    /etc/apache2/certs/schoolbox.crt
        SSLCertificateKeyFile /etc/apache2/certs/schoolbox-private.key
        SSLCertificateChainFile /etc/apache2/certs/schoolbox-intermediate.crt
        #SSLCACertificateFile /etc/apache2/certs/root.crt
        SSLProtocol all -SSLv2 -SSLv3
        # Enabling the below cipher order will stop IE8 on WinXP being able to connect at all on SSL/TLS
        # but will provide much better security for everyone else
        # https://community.qualys.com/blogs/securitylabs/2013/08/05/configuring-apache-nginx-and-openssl-for-forward-secrecy
        #SSLHonorCipherOrder on
        #SSLCipherSuite "EECDH+ECDSA+AESGCM EECDH+aRSA+AESGCM EECDH+ECDSA+SHA384 EECDH+ECDSA+SHA256 EECDH+aRSA+SHA384 EECDH+aRSA+SHA256 EECDH+aRSA+RC4 EECDH EDH+aRSA RC4 !aNULL !eNULL !LOW !3DES !MD5 !EXP !PSK !SRP !DSS !RC4"

        <FilesMatch "\.(cgi|shtml|phtml|php)$">
                SSLOptions +StdEnvVars
        </FilesMatch>
        <Directory /usr/lib/cgi-bin>
                SSLOptions +StdEnvVars
        </Directory>

        BrowserMatch "MSIE [2-6]" \
                nokeepalive ssl-unclean-shutdown \
                downgrade-1.0 force-response-1.0
        BrowserMatch "MSIE [17-9]" ssl-unclean-shutdown

        ErrorLog /var/log/apache2/schoolbox_error.log
        LogLevel warn
        CustomLog /var/log/apache2/schoolbox_access.log combined

        #Setup xhprof for debugging, only works if module is installed on server
        Alias /xhprof /usr/share/php5-xhprof/xhprof_html
        Alias /debugbar /usr/share/schoolbox/vendor/maximebf/debugbar/src/DebugBar/Resources/
        #Alias /xhprof /usr/share/schoolbox/vendor/facebook/xhprof/xhprof_html/

        # LISS Exceptions
        <Directory /vagrant/www/liss>
                php_value memory_limit 512M
                php_value max_execution_time 300
        </Directory>

        # MGS Sport Module Exceptions
        <Directory /usr/share/schoolbox/www/modules/sport>
                php_flag apc.enabled off
        </Directory>

        # Force IE to not use compatibility mode
        <IfModule mod_headers.c>
                  Header set X-UA-Compatible "IE=Edge,chrome=1"
                  # mod_headers can't match by content-type, but we don't want to send this header on *everything*...
                  <FilesMatch "\.(appcache|crx|css|eot|gif|htc|ico|jpe?g|js|m4a|m4v|manifest|mp4|oex|oga|ogg|ogv|otf|pdf|png|safariextz|svg|svgz|ttf|vcf|webm|webp|woff|xml|xpi)$">
                            Header unset X-UA-Compatible
                  </FilesMatch>
        </IfModule>


        ErrorDocument 404 /index.php?page=common/404

        Options +FollowSymLinks
        Options -Multiviews

        RewriteEngine on

        # PHP Error handling
        php_flag display_startup_errors off
        php_flag display_errors off
        php_flag html_errors off
        php_flag log_errors on
        php_value error_reporting 30711
        php_flag auto_detect_line_endings On
        php_value docref_root 0
        php_value docref_ext 0
        php_value upload_max_filesize 1024M
        php_value post_max_size 1024M
        php_flag session.use_trans_sid on
        php_value session.gc_maxlifetime 86400
        php_flag session.cookie_httponly On
        php_value session.save_handler redis
        php_value session.save_path "tcp://127.0.0.1:6379"
        php_value newrelic.appname "Schoolbox 15.0"

        # Assess uses JSON arrays to transfer data in multi-choice/matching pairs
        # JSON arrays don't like being escaped!!
        php_flag magic_quotes_gpc off

        RewriteCond  %{REQUEST_URI} login.php$
        RewriteRule ^(.*)$ http://%{HTTP_HOST}/ [R,L]

        RewriteCond %{REQUEST_URI} ^/favicon.ico$
        RewriteRule ^(.*)$ /favicon.ico.php [L,R=301]

        # Force SSL
        #RewriteCond %{SERVER_PORT} !^443$
        #RewriteCond %{REQUEST_URI} ^/login [OR]
        #RewriteCond %{REQUEST_URI} ^/login/.* [OR]
        #RewriteCond %{REQUEST_URI} ^/adminv2/.* [OR]
        #RewriteCond %{REQUEST_URI} ^/login/.* [OR]
        #RewriteCond %{REQUEST_URI} ^/saml [OR]
        #RewriteCond %{REQUEST_URI} ^/saml/.* [OR]
        #RewriteCond %{REQUEST_URI} ^/cms/network [OR]
        #RewriteCond %{REQUEST_URI} ^/cms/network/.* [OR]
        #RewriteCond %{REQUEST_URI} ^/account/modify [OR]
        #RewriteCond %{REQUEST_URI} ^/account/modify/.*
        #RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R,NE,L]

        # Force non-secure
        #RewriteCond %{SERVER_PORT} ^443$
        #RewriteCond %{REQUEST_URI} !^/login
        #RewriteCond %{REQUEST_URI} !^/login/.*
        #RewriteCond %{REQUEST_URI} !^/adminv2/.*
        #RewriteCond %{REQUEST_URI} !^/saml
        #RewriteCond %{REQUEST_URI} !^/saml/.*
        #RewriteCond %{REQUEST_URI} !^/cms/network
        #RewriteCond %{REQUEST_URI} !^/cms/network/.*
        #RewriteCond %{REQUEST_URI} !^/account/modify
        #RewriteCond %{REQUEST_URI} !^/account/modify/.*
        #RewriteCond %{REQUEST_URI} !^/ajax/.*
        #RewriteCond %{REQUEST_URI} !^/resources/.*
        #RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
        #RewriteRule ^(.*)$ http://%{HTTP_HOST}%{REQUEST_URI} [R,NE,L]

        RewriteCond %{SCRIPT_FILENAME}/ -d
        RewriteRule [^/]$ %{REQUEST_URI}/ [R=301,L]

        # Required to bypass central authentication for RSS feeds
        RewriteCond %{REQUEST_URI} /homepage/rss/[0-9]*
        RewriteRule ^(.*)$ /homepage/rss.php?page=$1 [L]

        RewriteCond %{REQUEST_URI} !/dav/.*
        RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
        RewriteRule ^(.*)$ /index.php?page=$1 [L,QSA]

</VirtualHost>
</IfModule>
