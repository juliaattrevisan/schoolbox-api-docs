#!/bin/bash

for service in socketd digestd routed scheduled; do
  if systemctl | grep -q "schoolbox-$service.service"; then
    systemctl stop "schoolbox-$service.service";
  fi
done

service schoolbox-cloud-scheduled@vagrantx stop;
service schoolbox-cloud-routed@vagrantx    stop;
service schoolbox-cloud-socketd@vagrantx   stop;
service schoolbox-cloud-digestd@vagrantx   stop;
