#!/bin/bash
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games;

file_path=$(readlink -f "$0");
dir_path=${file_path%/*}
site_root=$(readlink -f "$dir_path"/../../);
conf_file="$site_root"/www/conf/conf.php

# Stop all schoolbox notif daemons
"$dir_path"/allstop

# All environments are now Multi-instance arch.
instance_list=$(schoolbox-conf --conf="$conf_file" --option=instancelist | jq -r '.[]' | sort);
for daemon in socketd digestd routed scheduled; do
    for instance_id in $instance_list; do
        echo "starting schoolbox-cloud-$daemon@$instance_id"
        service "schoolbox-cloud-$daemon@$instance_id" start;
    done
done

# Start schoolbox-belld only if already enabled
for instance_id in $instance_list; do
    if [ "$(systemctl is-enabled schoolbox-cloud-belld@"$instance_id" 2>/dev/null)" = "enabled" ]; then
        echo "starting schoolbox-cloud-belld@$instance_id"
        service schoolbox-cloud-belld@"$instance_id" start;
    fi
done
