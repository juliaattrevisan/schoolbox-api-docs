# Schoolboxdev Cron Jobs
# Description:
#	Lists all automatically install cron jobs for schoolboxdev
#	Deployed for running by cron into /etc/cron.d/
# Usage:
#	Automatically run by cron from /etc/cron.d/
#
# @author      Sam Bailey <sam.bailey@alaress.com.au>
# @copyright   2013 Alaress Pty Ltd
# @link        http://www.alaress.com.au
#
# m h dom mon dow user command
MAILTO="support@schoolbox.com.au"

# Video Processing
* */4 * * *	www-data	php /usr/share/schoolboxdev/tools/video/video-scanner.php >/dev/null 2>&1
*/2 * * * *	www-data	php /usr/share/schoolboxdev/tools/video/processor.php >/dev/null 2>&1

# Cleanup cache  files (minify,zip,stream) (once a week on a Sunday)
0 1 * * 0	root	php /usr/share/schoolboxdev/tools/clean-cache-dir.sh >/dev/null 2>&1

# Plagscan callback - every hour
0 * * * *	root	php /usr/share/schoolboxdev/tools/plagscan/scan.php >> /var/log/schoolboxdev/plagscan.log 2>&1

# Upload student submissions to crocodoc - every hour
30 * * * *	root	php /usr/share/schoolboxdev/tools/crocodoc/upload.php >> /var/log/schoolboxdev/crocodoc.log 2>&1

# Etherpad - sync back to MySQL - every hour
0 * * * *	root	php /usr/share/schoolboxdev/tools/etherpad-sync.php >> /dev/null 2>&1

# Skin Builder - Every 5 minutes
*/5 * * * *	root	php /usr/share/schoolboxdev/tools/skin/builder.php >> /dev/null 2>&1
