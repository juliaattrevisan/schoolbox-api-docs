# Schoolboxdev Cron Jobs
# Description:
#	Lists all automatically install cron jobs for schoolboxdev
#	Deployed for running by cron into /etc/cron.d/
# Usage:
#	Automatically run by cron from /etc/cron.d/
#
# @author      Sam Bailey <sam.bailey@alaress.com.au>
# @copyright   Copyright 2019, Schoolbox Pty Ltd
# @link        https://schoolbox.com.au/
#
# m h dom mon dow user command
MAILTO="support@schoolbox.com.au"

# Video Processing
*/2 * * * *	www-data	php /usr/share/schoolboxdev/tools/video/processor.php >> /var/lib/schoolboxdev/cache/logs/transcode.log 2>&1

# Cleanup cache  files (minify,zip,stream) (once a week on a Sunday)
0 1 * * 0	root	/usr/share/schoolboxdev/tools/clean-cache-dir.sh >> /var/log/schoolboxdev/cache-cleanup.log 2>&1

# Cleanup UPS log files (once a week on a Sunday)
20 3 * * 0	root	/usr/share/schoolboxdev/tools/ups/cleanup.php -p -vv >> /var/log/schoolboxdev/cache-cleanup.log 2>&1

# Plagscan callback - every hour
0 * * * *	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolboxdev/tools/plagscan/scan.php >> /var/lib/schoolboxdev/cache/logs/plagscan.log 2>&1

# Plagscan file upload - twice a week
0 4 * * 0,3,5	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolboxdev/tools/plagscan/submit.php >> /var/lib/schoolboxdev/cache/logs/plagscan.log 2>&1

# Etherpad - sync back to MySQL - every hour
0 * * * *	root	php /usr/share/schoolboxdev/tools/etherpad-sync.php >> /var/log/schoolboxdev/etherpad-sync.log 2>&1

# Skin Builder - Every 2 minutes
*/2 * * * *	root	php /usr/share/schoolboxdev/tools/skin/builder.php >> /var/log/schoolboxdev/skin-builder.log 2>&1

# Complete quizzes that have expired
*/20 * * * *	root	php /usr/share/schoolboxdev/tools/quiz/autoFinish.php >> /var/log/schoolboxdev/quiz.log 2>&1

# Pastoral DocMan upload - Every 5 minutes
*/5 * * * *     root    php /usr/share/schoolboxdev/tools/docman/pastoralUpload.php >> /var/log/schoolboxdev/docman.log 2>&1

# Kami - Upload 'pending' documents every 1 minute
* * * * *   www-data    php /usr/share/schoolboxdev/tools/kami/upload.php --perform -v >> /var/lib/schoolboxdev/cache/logs/kami.log 2>&1

# Kami - Retry any 'failed' every day at 2:17am (offset by 2min from uploader)
17 2 * * *    www-data    php /usr/share/schoolboxdev/tools/kami/upload.php --perform --retry-failed -v >> /var/lib/schoolboxdev/cache/logs/kami-retry-failed.log 2>&1

# SIS Data Importer - every hour
0 * * * *	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolboxdev/tools/synchronise/scheduler.php >> /var/lib/schoolboxdev/cache/logs/sis-scheduler.log 2>&1

# End of file - do not delete
