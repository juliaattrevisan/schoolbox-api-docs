# m h dom mon dow user command
MAILTO="support@schoolbox.com.au"

# Video Processing
*/5 * * * *     www-data    php /usr/share/schoolboxdev/tools/video/video-scanner.php >> /var/log/schoolboxdev-video-scanner.log 2>/dev/null
*/10 * * * *    www-data    php /usr/share/schoolboxdev/tools/video/processor.php >> /var/log/schoolboxdev-video-processor.log 2>/dev/null

# Due Work Notifications
# -- Not to be run for dev other can spam emails to users during testing
#*/15 * * * *    root    php /usr/share/schoolboxdev/tools/submission/notify_students.php --send --upcoming --overdue >> /var/log/schoolboxdev-duework.log 2>/dev/null

# Cleanup cache  files (minify,zip,stream) (once a month)
0 1 1 * *       root    php /usr/share/schoolboxdev/tools/clean-cache-dir.sh >/dev/null 2>&1
