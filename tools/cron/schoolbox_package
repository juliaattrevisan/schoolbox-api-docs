# Schoolbox Package Cron Jobs.
# Description:
#   Lists all cron jobs for a schoolbox package.
#   Deployed for running by puppet into /etc/cron.d/schoolbox_package
#   Unlike the Instance cron job template, this file is deployed as-is by puppet.
#   Jobs in this file are expected to be instance-agnostic. Ie they will run per-package, not per-instance.
# Usage:
#   Automatically run by cron from /etc/cron.d/schoolbox_package
#
# @copyright   Copyright 2022, Schoolbox Pty Ltd
# @link        https://schoolbox.com.au/
#
# m h dom mon dow user command
MAILTO="ist+cron@schoolbox.com.au"

# Cleanup etherpad session storage (once a week on a Sunday)
10 2 * * 0 www-data php /usr/share/schoolbox/tools/redis/removeEtherpadSession.php -p >> /var/log/schoolbox/purge-old-sessions.log 2>&1

# Restart socketd nightly to avoid memory leak issue
51 15 * * * root systemctl restart schoolbox-cloud-socketd.service > /dev/null
