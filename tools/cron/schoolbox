# Schoolbox Cron Jobs
# Description:
#	Lists all automatically install cron jobs for schoolbox
#	Deployed for running by cron into /etc/cron.d/
# Usage:
#	Automatically run by cron from /etc/cron.d/
#
# @author      Sam Bailey <sam.bailey@alaress.com.au>
# @copyright   Copyright 2019, Schoolbox Pty Ltd
# @link        https://schoolbox.com.au/
#
# m h dom mon dow user command
MAILTO="support@schoolbox.com.au"

# Image Processing - Every 5 minutes. Standard transforms + timed-out web request transforms
*/5 * * * *	www-data    /usr/share/schoolbox/tools/image/processor.php >> /var/lib/schoolbox/cache/logs/image-processor.log 2>&1

# Image Processing - Nightly at 1am. Failed transforms are retried.
* 1 * * *	www-data    RETRY_FAILED=1 /usr/share/schoolbox/tools/image/processor.php >> /var/lib/schoolbox/cache/logs/image-processor-failed.log 2>&1

# Video Processing
*/2 * * * *	www-data	php /usr/share/schoolbox/tools/video/processor.php >> /var/lib/schoolbox/cache/logs/transcode.log 2>&1

# Cleanup cache  files (minify,zip,stream) (once a week on a Sunday)
0 1 * * 0	root	/usr/share/schoolbox/tools/clean-cache-dir.sh >> /var/log/schoolbox/cache-cleanup.log 2>&1

# Cleanup UPS log files (once a week on a Sunday)
20 3 * * 0	root	/usr/share/schoolbox/tools/ups/cleanup.php -p -vv >> /var/log/schoolbox/cache-cleanup.log 2>&1

# Plagscan callback - every hour
0 * * * *	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolbox/tools/plagscan/scan.php >> /var/lib/schoolbox/cache/logs/plagscan.log 2>&1

# Plagscan file upload - every 3 hours
14 */3 * * *	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolbox/tools/plagscan/submit.php >> /var/lib/schoolbox/cache/logs/plagscan.log 2>&1

# Etherpad - sync back to MySQL - every hour
0 * * * *	root	php /usr/share/schoolbox/tools/etherpad-sync.php >> /var/log/schoolbox/etherpad-sync.log 2>&1

# Complete quizzes that have expired
*/20 * * * *	root	php /usr/share/schoolbox/tools/quiz/autoFinish.php >> /var/log/schoolbox/quiz.log 2>&1

# Pastoral DocMan upload - Every 5 minutes
*/5 * * * *     root    php /usr/share/schoolbox/tools/docman/pastoralUpload.php >> /var/log/schoolbox/docman.log 2>&1

# Kami - Upload 'pending' documents every 3 minute
*/3 * * * *   www-data    php /usr/share/schoolbox/tools/kami/upload.php --perform -v >> /var/lib/schoolbox/cache/logs/kami.log 2>&1

# Kami - Retry any 'failed' every day at 2:17am (offset by 2min from uploader)
17 2 * * *    www-data    php /usr/share/schoolbox/tools/kami/upload.php --perform --retry-failed -v >> /var/lib/schoolbox/cache/logs/kami-retry-failed.log 2>&1

# SIS Data Importer - every hour
0 * * * *	www-data	php /usr/share/schoolbox/tools/synchronise/scheduler.php >> /var/lib/schoolbox/cache/logs/sis-scheduler.log 2>&1

# Calendar: pre-parse any vCal files every 2 hours
35 */2 * * *    www-data    /usr/share/schoolbox/tools/calendar/preparseVcalSubscription.php -v >> /var/lib/schoolbox/cache/logs/preparseVcalSubscription.log 2>&1

# Data dir ownership - every 10 min - skip storage dir (just a hack until we fix this properly)
*/10 * * * * root /usr/share/schoolbox/tools/set-config-data-dirs-perms.sh --skip storage_dir --owner www-data --group www-data >> /var/log/schoolbox/set-config-data-dirs-perms.log 2>&1

# Submit system metrics to telegraf server every day at 3:15am
15 3 * * * www-data php /usr/share/schoolbox/tools/stats.php | curl -s -X POST -d @- 'http://localhost:8128/telegraf' 2>&1


