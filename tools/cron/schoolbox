# Schoolbox Cron Jobs
# Description:
#	Lists all automatically install cron jobs for schoolbox
#	Deployed for running by cron into /etc/cron.d/
# Usage:
#	Automatically run by cron from /etc/cron.d/
#
# @author      Sam Bailey <sam.bailey@alaress.com.au>
# @copyright   2013 Alaress Pty Ltd
# @link        http://www.alaress.com.au
#
# m h dom mon dow user command
MAILTO="support@schoolbox.com.au"

# Video Processing
*/5 * * * *     www-data    php /usr/share/schoolbox/tools/video/video-scanner.php >/dev/null 2>&1
*/10 * * * *    www-data    php /usr/share/schoolbox/tools/video/processor.php >/dev/null 2>&1

# Due Work Notifications
*/15 * * * *    root    php /usr/share/schoolbox/tools/submission/notify_students.php --send --upcoming --overdue >> /var/log/schoolbox-duework.log 2>/dev/null

# Cleanup cache  files (minify,zip,stream) (once a month)
0 1 1 * *       root    php /usr/share/schoolbox/tools/clean-cache-dir.sh >/dev/null 2>&1

# Digest notifications
00 06 * * 1-4 root    php /usr/share/schoolbox/tools/digest/daily.php  >> /var/log/schoolbox-digest-daily.log 2>/dev/null
00 11 * * 5   root    php /usr/share/schoolbox/tools/digest/weekly.php >> /var/log/schoolbox-digest-weekly.log 2>/dev/null
