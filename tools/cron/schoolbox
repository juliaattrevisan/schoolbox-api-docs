# Schoolbox Cron Jobs
# Description:
#	Lists all automatically install cron jobs for schoolbox
#	Deployed for running by cron into /etc/cron.d/
# Usage:
#	Automatically run by cron from /etc/cron.d/
#
# @author      Sam Bailey <sam.bailey@alaress.com.au>
# @copyright   2013 Alaress Pty Ltd
# @link        http://www.alaress.com.au
#
# m h dom mon dow user command
MAILTO="support@schoolbox.com.au"

# Video Processing
*/30 * * * *     www-data    php /usr/share/schoolbox/tools/video/video-scanner.php >/dev/null 2>&1
*/5 * * * *    www-data    php /usr/share/schoolbox/tools/video/processor.php >/dev/null 2>&1

# Cleanup cache  files (minify,zip,stream) (once a month)
0 1 1 * *       root    php /usr/share/schoolbox/tools/clean-cache-dir.sh >/dev/null 2>&1

# Plagscan callback - every hour
0 * * * *    root    php /usr/share/schoolbox/tools/plagscan/scan.php >> /var/log/schoolbox-plagscan.log 2>&1
