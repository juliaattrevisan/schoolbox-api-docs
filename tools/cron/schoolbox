# Schoolbox Cron Jobs
# Description:
#	Lists all automatically install cron jobs for schoolbox
#	Deployed for running by cron into /etc/cron.d/
# Usage:
#	Automatically run by cron from /etc/cron.d/
#
# @author      Sam Bailey <sam.bailey@alaress.com.au>
# @copyright   2013 Alaress Pty Ltd
# @link        http://www.alaress.com.au
#
# m h dom mon dow user command
MAILTO="support@schoolbox.com.au"

# Video Processing
*/2 * * * *	www-data	php /usr/share/schoolbox/tools/video/processor.php >> /var/lib/schoolbox/cache/logs/transcode.log 2>&1

# Cleanup cache  files (minify,zip,stream) (once a week on a Sunday)
0 1 * * 0	root	/usr/share/schoolbox/tools/clean-cache-dir.sh >> /var/log/schoolbox/cache-cleanup.log 2>&1

# Plagscan callback - every hour
0 * * * *	www-data	php /usr/share/schoolbox/tools/plagscan/scan.php >> /var/lib/schoolbox/cache/logs/plagscan.log 2>&1

# Plagscan file upload - every day
0 4 * * 0,3	www-data	php /usr/share/schoolbox/tools/plagscan/submit.php >> /var/lib/schoolbox/cache/logs/plagscan.log 2>&1

# Etherpad - sync back to MySQL - every hour
0 * * * *	root	php /usr/share/schoolbox/tools/etherpad-sync.php >> /var/log/schoolbox/etherpad-sync.log 2>&1

# Skin Builder - Every 2 minutes
*/2 * * * *	root	php /usr/share/schoolbox/tools/skin/builder.php >> /var/log/schoolbox/skin-builder.log 2>&1

# UPS - Nightly at 10pm
0 22 * * *	www-data	php /usr/share/schoolbox/tools/synchronise/userProvision.php -v --perform-update >> /var/lib/schoolbox/cache/logs/ups.log 2>&1

# Complete quizzes that have expired
*/20 * * * *	root	php /usr/share/schoolbox/tools/quiz/autoFinish.php >> /var/log/schoolbox/quiz.log 2>&1

# Pastoral DocMan upload - Every 5 minutes
*/5 * * * *     root    php /usr/share/schoolbox/tools/docman/pastoralUpload.php >> /var/log/schoolbox/docman.log 2>&1

# Kami - Upload 'pending' documents every 1 minute
* * * * *   www-data    php /usr/share/schoolbox/tools/kami/upload.php --perform -v >> /var/lib/schoolbox/cache/logs/kami.log 2>&1

# Kami - Retry any 'failed' every day at 2:17am (offset by 2min from uploader)
17 2 * * *    www-data    php /usr/share/schoolbox/tools/kami/upload.php --perform --retry-failed -v >> /var/lib/schoolbox/cache/logs/kami-retry-failed.log 2>&1

# End of file - do not delete
