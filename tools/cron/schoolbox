# Schoolbox Instance Cron Job template.
# Description:
#   Lists all cron jobs for a schoolbox instance.
#   Deployed for running by puppet into /etc/cron.d/sbc_schoolbox_${INSTANCE_ID}
#   Puppet will modify each line to:
#   * insert the INSTANCE_ID as an env var when invoking the cron job
#   * remap schedule to align to instance's timezone
#   * insert jitter if none explicitly defined in this template
#   * log stdout/stderr to /var/log/schoolbox/${INSTANCE_ID}/
# Usage:
#   Automatically run by cron from /etc/cron.d/sbc_schoolbox_${INSTANCE_ID}
#
# @copyright   Copyright 2022, Schoolbox Pty Ltd
# @link        https://schoolbox.com.au/
#
# m h dom mon dow user command
MAILTO="support@schoolbox.com.au"

# Image Processing - Every 5 minutes. Standard transforms + timed-out web request transforms
*/5 * * * *	www-data    /usr/share/schoolbox/tools/image/processor.php -vvv >> /var/log/schoolbox/image-processor.log 2>&1

# Image Processing - Nightly at 1:12am. Failed transforms are retried.
12 1 * * *	www-data    /usr/share/schoolbox/tools/image/processor.php --retry-failed -vvv >> /var/log/schoolbox/image-processor.log 2>&1

# Video Processing
*/2 * * * *	www-data	php /usr/share/schoolbox/tools/video/processor.php >> /var/log/schoolbox/transcode.log 2>&1

# Cleanup cache  files (minify,zip,stream) (once a week on a Sunday)
28 1 * * 0	root	/usr/share/schoolbox/tools/clean-cache-dir.sh >> /var/log/schoolbox/cache-cleanup.log 2>&1

# Cleanup UPS log files (once a week on a Sunday)
20 3 * * 0	www-data	/usr/share/schoolbox/tools/ups/cleanup.php -p -vv >> /var/log/schoolbox/ups-cleanup.log 2>&1

# Plagscan callback - every hour
44 * * * *	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolbox/tools/plagscan/scan.php >> /var/log/schoolbox/plagscan.log 2>&1

# Plagscan file upload - every 3 hours
14 */3 * * *	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolbox/tools/plagscan/submit.php >> /var/log/schoolbox/plagscan.log 2>&1

# Turnitin group attachments - every 15 min
*/15 * * * *	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolbox/tools/turnitin/group.php --force >> /var/log/schoolbox/turnitin.log 2>&1

# Turnitin transmitter - every 1 hour
13 * * * *	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolbox/tools/turnitin/transmit.php --force >> /var/log/schoolbox/turnitin.log 2>&1

# Turnitin reporter - every 10min
*/10 * * * *	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolbox/tools/turnitin/report.php >> /var/log/schoolbox/turnitin.log 2>&1

# Geosnapshot Redactions - daily at 8:08pm I guess
8 20 * * *	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolbox/tools/geosnapshot/redaction.php --perform >> /var/log/schoolbox/geosnapshot.log 2>&1

# Clipboard Importer - every 4 hours
22 */4 * * *  www-data   /usr/local/bin/jitter 1800 php /usr/share/schoolbox/tools/clipboard/importer.php --membership --sessions --perform >> /var/log/schoolbox/clipboard-importer.log 2>&1

# Expired Storage Removal Tool - every Sunday at 5am
15 5 * * 0	www-data	/usr/local/bin/jitter 1200 php /usr/share/schoolbox/tools/storage/expired-storage-removal.php --perform >> /var/log/schoolbox/expired-storage-removal.log 2>&1

# Etherpad - sync back to MySQL - every hour
38 * * * *	www-data	php /usr/share/schoolbox/tools/etherpad-sync.php >> /var/log/schoolbox/etherpad-sync.log 2>&1

# Complete quizzes that have expired
6,26,46 * * * *	www-data	php /usr/share/schoolbox/tools/quiz/autoFinish.php >> /var/log/schoolbox/quiz.log 2>&1

# Pastoral DocMan upload - Every 5 minutes
*/5 * * * *     www-data    php /usr/share/schoolbox/tools/docman/pastoralUpload.php >> /var/log/schoolbox/docman.log 2>&1

# Kami - Upload 'pending' documents every 3 minute
*/3 * * * *   www-data    php /usr/share/schoolbox/tools/kami/upload.php --perform -v >> /var/log/schoolbox/kami.log 2>&1

# Kami - Retry any 'failed' every day at 2:17am (offset by 2min from uploader)
17 2 * * *    www-data    php /usr/share/schoolbox/tools/kami/upload.php --perform --retry-failed -v >> /var/log/schoolbox/kami.log 2>&1

# SIS Data Importer - every hour
1 * * * *	www-data	php /usr/share/schoolbox/tools/synchronise/scheduler.php >> /var/log/schoolbox/sis-scheduler.log 2>&1

# Calendar: pre-parse any vCal files every 2 hours
35 */2 * * *    www-data    /usr/share/schoolbox/tools/calendar/preparseVcalSubscription.php -v >> /var/log/schoolbox/preparseVcalSubscription.log 2>&1

# Data dir ownership - every 10 min - skip storage dir (just a hack until we fix this properly)
*/10 * * * * root /usr/share/schoolbox/tools/set-config-data-dirs-perms.sh --skip storage_dir --owner www-data --group www-data >> /var/log/schoolbox/set-config-data-dirs-perms.log 2>&1

# Submit system metrics to telegraf server every day at 3:15am
# Pipe OUTPUT from php as INPUT to curl. Pipe ERROR from php + STDOUT/STDERR from curl to log file
15 3 * * *	www-data	bash -c "{ php /usr/share/schoolbox/tools/stats.php | curl --silent --show-error -d @- 'http://localhost:8128/telegraf'; }" >> /var/log/schoolbox/stats.log 2>&1

# Rebuild notification routes for users by polling group and class memberships
30 2 * * * www-data php /usr/share/schoolbox/tools/notif/route/refresh-binding-cache.php -vv >>/var/log/schoolbox/binder.log 2>&1

# Reload notification daemons nightly at 1am
52 1 * * * root /usr/local/bin/jitter 3600 /usr/share/schoolbox/tools/notif/allrestart >>/var/log/schoolbox/notif-restart.log 2>&1

# Cleanup redis notification data (once a week on a Sunday)
20 1 * * 0 www-data php /usr/share/schoolbox/tools/mq/remove-old-triggers.php -p >> /var/log/schoolbox/remove-old-triggers.log 2>&1

# Cleanup etherpad session storage (once a week on a Sunday)
#10 2 * * 0 www-data php /usr/share/schoolbox/tools/redis/removeEtherpadSession.php -p >> /var/log/schoolbox/purge-old-sessions.log 2>&1

# mysql optimize. Each night between 3:45 - 4:45 AM
45 03 * * * root /usr/local/bin/jitter 3600 /usr/share/schoolbox/tools/schema/optimize.sh >> /var/log/schoolbox/mysql-optimize.log 2>&1

# Clean orphaned transforms at 2:18 AM everyday
18 2 * * * root /usr/share/schoolbox/tools/storage/transform-cleanup.php -p >> /var/log/schoolbox/transform-cleanup.log 2>&1

# Intellischool Sync - every 30min
4,34 * * * *	www-data	/usr/local/bin/jitter 600 php /usr/share/schoolbox/tools/intellischool/dataSync.php --force >> /var/log/schoolbox/intellischool.log 2>&1

# Login Log Prune - 1st day of month, 2am
3 2 1 * * www-data php /usr/share/schoolbox/tools/schema/loginlog.php --perform

# End of file - do not delete
