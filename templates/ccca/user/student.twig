{% extends '@core/user/student.twig' %}

{# Intercept default handling of a tuple. Custom Works' tuples must get dealt with specially here,
 # before falling back to just putting selectedField.value on screen
 #}
{% block profileFieldTuple %}
    {% if selectedField.field == 'StudentMobilePhone' %}
        <dt class="small-4 medium-3 columns">Student Mobile:</dt>
        <dd class="small-8 medium-9 columns"><a href="tel:{{ selectedField.value }}">{{ selectedField.value }}</a></dd>
    {% else %}
        {# Default rendering: inherit from core template #}
        {{ parent() }}
    {% endif %}
{% endblock %}
