{% extends '@core/user/student.twig' %}

{% block extraDetails %}
    <dt class="no-margin small-6 medium-3">Full Days Absent</dt>
    <dd class="no-margin small-6 medium-9">{{ externalUser.AbsenceFullDaysForYear }}</dd>
    <dt class="no-margin small-6 medium-3">Late Arrivals</dt>
    <dd class="no-margin small-6 medium-9">{{ externalUser.LateStartDaysForYear }}</dd>
    <dt class="no-margin small-6 medium-3">Early Departures</dt>
    <dd class="no-margin small-6 medium-9">{{ externalUser.EarlyLeaveDaysForYear }}</dd>
{% endblock extraDetails %}
