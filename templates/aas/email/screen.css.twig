/* This file is subject to Twig, beware the {{ vars }} */
/* use classes, don't use id's */

/* will be truncated by mail clients, but we use it for styling */
body {
    margin: 0;
}

table {
    border-spacing: 0;
    border-width: 0;
    border-collapse: collapse;
}
td {
    padding: 0;
    font-family: Georgia, sans-serif;
    font-size: 13px;
}

a {
    text-decoration: none;
}
a[href] {
    text-decoration: underline;
}

img {
    display: block;
}

.wrap {
    width: 100%;
}

.inner-wrap {
    background-color: {{ colours.skin_colour_body_bg }};
    width: 100%;
}

.header, .footer {
    width: 100%;
}

.header {
    background-color: {{ colours.skin_colour_navigation_background }};
}

.header img {
    color: {{ colours.skin_colour_offcanvas_background }}
}

.content {
    background-color: {{ 'white'  }};
}

.content a {
    color: {{ colours.skin_colour_content_ui_foreground }};
}
.content p {
    line-height: 20px;
    font-size: 13px;
    margin: 0;
}

.content .heading {
    line-height: 36px;
    font-weight: bold;
    font-size: 18px;
    color: {{ colours.skin_colour_navigation_background  }};
{#background: {{ colours.module_background }};#}
}

.content a.cta {
    background-color: {{  colours.skin_colour_navigation_background }};
    padding: 4px 8px 6px;
    text-decoration: none;
    color: {{ colours.skin_colour_offcanvas_background }};
}

.content .title {
    line-height: 24px;
    font-weight: bold;
    font-size: 16px;
    text-decoration: none;
}

.footer p {
    color: {{ 'black'  }};
    font-family: Georgia, sans-serif;
    font-size: 11px;
    line-height: 18px;
    text-align: right;
    margin: 0; {# ignored by 50% of mail clients #}
}

.footer a {
    color: {{ colours.skin_colour_content_ui_foreground }};
    text-decoration: underline;
}

tr.underline td, td.underline {
    border-bottom: solid 1px {{ colours.skin_colour_navigation_background }};
}


{# module specifics #}
.work-month, .work-day {
    text-align: center;
    border: solid 2px {{ colours.skin_colour_navigation_background }};
}
.work-month {
    text-transform: uppercase;
    font-size: 12px;
    background-color: {{ colours.skin_colour_navigation_background }};
    color: {{ colours.skin_colour_navigation_foreground }};
    border-bottom: solid 1px #fff;
}

.work-day {
    font-size: 22px;
    line-height: 35px;
    color: {{ colours.skin_colour_navigation_background }};
    background-color: {{ colours.skin_colour_offcanvas_background }};
}

.admin-nav a {
    display: block;
    height: auto;
    line-height: 22px;
    text-decoration: none;
    padding: 1px 6px;
    border: 4px solid {{ colours.skin_colour_navigation_background }};

    color: {{ colours.skin_colour_navigation_background }};
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: -1px;
    margin: 12px 6px 0 0;
}

.admin-nav .all{
    color: #004559; border-color: #004559;
}
.admin-nav .notices{
    color: #006a56; border-color: #006a56;
}
.admin-nav .comm{
    color: #004559; border-color: #004559;
    margin: 12px 0 0 0;
}
.admin-nav .events{
    color: #c43c96; border-color: #c43c96;
}
.admin-nav .sport{
    color: #ef4056; border-color: #ef4056;
}
.admin-nav .general{
    color: #00ae66; border-color: #00ae66;
}
.admin-nav .music{
    color: #fec357; border-color: #fec357;
}
