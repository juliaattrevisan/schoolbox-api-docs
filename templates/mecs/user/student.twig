{% extends '@core/user/student.twig' %}

{% block details_studentId %}
    <dt class="small-12 medium-3">Admission ID:</dt>
    <dd class="small-12 medium-9">{{ externalUser.AdmissionNo }}</dd>
    <dt class="small-12 medium-3">Engage ID:</dt>
    <dd class="small-12 medium-9">{{ user.getExternalId() }}</dd>
{% endblock details_studentId %}

{% block contacts %}
    <h2 class="subheader">Contact Information</h2>
    {% if showContactsAlert %}
        {% if externalUser.CustodyAlert == 1 %}
            <div class="alert-box alert icon-alert no-margin">
                Custodian: {{ externalUser.CustodyResponsiblePerson }}
            </div>
            <div class="alert-box alert icon-alert no-margin">
                {{ externalUser.CustodyNotes }}
            </div>
        {% endif %}
    {% endif %}
    {% for message in externalUser.AlertMessages %}
        {% block contacts_alert %}
            {# Only staff may view contact alerts #}
            {% if showContactsAlert %}
                <div class="alert-box alert icon-alert no-margin">
                    {{ message | nl2br }}
                </div>
            {% endif %}
        {% endblock contacts_alert %}
    {% endfor %}

    <section>
        <div class="content no-pad">
            <ul class="information-list">
                {% for contact in contacts %}
                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="card small-12">
                                {% if contact.main %}
                                    <a href="/search/user/{{ contact.main.getId() }}">
                                        <img src="/portrait.php?userId={{ contact.StudentContactID }}&amp;size=square64"/>
                                        <h3>{{ contact.StudentContactTitle }} {{ contact.StudentContactPreferred }} {{ contact.StudentContactSurname }}</h3>
                                    </a>
                                {% else %}
                                    <img src="/portrait.php?userId={{ contact.StudentContactID }}&amp;size=square64"/>
                                    <h3>{{ contact.StudentContactTitle }} {{ contact.StudentContactPreferred }} {{ contact.StudentContactSurname }}</h3>
                                {% endif %}
                                <p class="meta">{{ contact.StudentContactRelation }}</p>
                            </div>
                        </div>
                        {% if (contact.StudentContactDefaultEmail)
                        or (contact.StudentContactSpouseDefaultEmail)
                        or (contact.StudentContactMobilePhone)
                        or (contact.StudentContactOccupPhone)
                        or (contact.StudentContactSpouseMobilePhone) or (contact.StudentContactSpouseOccupPhone) %}
                            <nav>
                                <a href="#" class="icon-more"
                                   data-dropdown="row-options-contact-{{ contact.StudentContactID }}"
                                   title="Actions"></a>
                            </nav>

                            <ul class="f-dropdown" data-dropdown-content
                                id="row-options-contact-{{ contact.StudentContactID }}">
                                {% if contact.StudentContactDefaultEmail %}
                                    <li><a class="icon-email"
                                           href="{{ session.mailhandle }}{{ contact.StudentContactDefaultEmail }}">{{ contact.StudentContactDefaultEmail }}</a>
                                    </li>
                                {% endif %}
                                {% if contact.StudentContactSpouseDefaultEmail %}
                                    <li><a class="icon-email"
                                           href="{{ session.mailhandle }}{{ contact.StudentContactSpouseDefaultEmail }}">{{ contact.StudentContactSpouseDefaultEmail }}</a>
                                    </li>
                                {% endif %}
                                {% if contact.StudentContactMobilePhone %}
                                    <li><a class="icon-mobile"
                                           href="tel:{{ contact.StudentContactMobilePhone }}">{{ contact.StudentContactMobilePhone }}</a>
                                    </li>
                                {% endif %}
                                {% if contact.StudentContactOccupPhone %}
                                    <li><a class="icon-mobile"
                                           href="tel:{{ contact.StudentContactOccupPhone }}">{{ contact.StudentContactOccupPhone }}</a>
                                    </li>
                                {% endif %}
                                {% if contact.StudentContactSpouseMobilePhone %}
                                    <li><a class="icon-mobile"
                                           href="tel:{{ contact.StudentContactSpouseMobilePhone }}">{{ contact.StudentContactSpouseMobilePhone }}</a>
                                    </li>
                                {% endif %}
                                {% if contact.StudentContactSpouseOccupPhone %}
                                    <li><a class="icon-mobile"
                                           href="tel:{{ contact.StudentContactSpouseOccupPhone }}">{{ contact.StudentContactSpouseOccupPhone }}</a>
                                    </li>
                                {% endif %}

                            </ul>
                        {% endif %}
                    </li>

                    <li class="actions-small-1">
                        <div class="list-item">
                            <div class="card small-12">
                                <span class="icon-home size-32"></span>
                                {% if contact.StudentContactAddress1 or contact.StudentContactAddress2 or contact.StudentContactAddress3 %}
                                    <p>{{ contact.StudentContactAddress1 }}</p>
                                    <p>{{ contact.StudentContactAddress2 }}</p>
                                    <p>{{ contact.StudentContactAddress3 }}</p>
                                    <p>{{ contact.StudentContactSuburb }},</p>
                                    <p>{{ contact.StudentContactState }} {{ contact.StudentContactPostCode }}</p>
                                {% endif %}
                            </div>
                        </div>
                        <nav>
                            {% if contact.StudentContactPhoneActual %}
                                <a class="icon-mobile" href="tel:{{ contact.StudentContactPhoneActual }}"
                                   title="Call {{ contact.StudentContactPhoneActual }}"></a>
                            {% endif %}
                        </nav>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endblock contacts %}
