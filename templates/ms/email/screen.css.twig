/* This file is subject to Twig, beware the {{ vars }} */
/* use classes, don't use id's */

/* will be truncated by mail clients, but we use it for styling */
body {
    margin: 0;
}

table {
    border-spacing: 0;
    border-width: 0;
    border-collapse: collapse;
}

table.fullwidth {
    border-collapse: separate;
    border-radius: {{ skinConfig.skin_container_corner_radius }};
    overflow: hidden;
}

td {
    padding: 0;
    font-family: Arial, sans-serif;
    font-size: 13px;
}

a {
    text-decoration: none;
}
a[href] {
    text-decoration: underline;
}

img {
    display: block;
}

a img {
    border-radius: {{ skinConfig.skin_field_corner_radius }};
    height: auto;
    width: 100%;
}

.wrap {
    width: 100%;
}

.inner-wrap {
    background-color: {{ skinConfig.skin_colour_body_bg }};
    width: 100%;
}

.header, .footer {
    width: 100%;
}

.header {
    background-color: {{ skinConfig.skin_colour_navigation_background }};
}

.header img {
    color: {{ skinConfig.skin_colour_offcanvas_background }}
}

.content {
    background-color: {{ 'white' }};
}

.content a {
    color: {{ skinConfig.skin_colour_accent_foreground }};
}
.content p {
    line-height: 20px;
    font-size: 13px;
    margin: 0;
}

.content .heading {
    line-height: 36px;
    font-weight: bold;
    font-size: 18px;
    color: {{ skinConfig.skin_colour_navigation_background }};
    {#background: {{ colours.module_background }};#}
}

.content a.cta {
    background-color: {{ skinConfig.skin_colour_navigation_background }};
    padding: 4px 8px 6px;
    text-decoration: none;
    color: {{ skinConfig.skin_colour_offcanvas_background }};
}

.content .title {
    line-height: 24px;
    font-weight: bold;
    font-size: 16px;
    text-decoration: none;
}

.footer p {
    color: {{ 'black' }};
    font-family: Arial, sans-serif;
    font-size: 11px;
    line-height: 18px;
    text-align: right;
    margin: 0; {# ignored by 50% of mail clients #}
}

.footer a {
    color: {{ skinConfig.skin_colour_accent_foreground }};
    text-decoration: underline;
}

tr.underline td, td.underline {
    border-bottom: solid 1px {{ skinConfig.skin_colour_navigation_background }};
}


{# module specifics #}
.work-month, .work-day {
    text-align: center;
    border: solid 2px {{ skinConfig.skin_colour_navigation_background }};
}
.work-month {
    text-transform: uppercase;
    font-size: 12px;
    background-color: {{ skinConfig.skin_colour_navigation_background }};
    color: {{ skinConfig.skin_colour_navigation_foreground }};
    border-bottom: solid 1px #fff;
}

.work-day {
    font-size: 22px;
    line-height: 35px;
    color: {{ skinConfig.skin_colour_navigation_background }};
    background-color: {{ skinConfig.skin_colour_offcanvas_background }};
}
