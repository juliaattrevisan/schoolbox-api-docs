{% extends '@core/user/student.twig' %}

{% block individualEducationPlan %}
    {% if isStaff and externalUser.countIndividualEducationPlans > 0 %}
        <div class="alert-box warning icon-bell">
            Individual Plan
        </div>
    {% endif %}
{% endblock individualEducationPlan %}

{% block details_gender %}
    {% if externalUser.StudentGender %}
        <dt class="small-4 medium-3 columns">Gender:</dt>
        <dd class="small-8 medium-9 columns">{{ externalUser.StudentGender }}</dd>
    {% endif %}
{% endblock details_gender %}
