{% extends '@core/user/student.twig' %}

{% import '@searchUser/field/macro.twig' as macro %}

{# Sometimes humans get their profile field names changed to something really
 # particular to their school, or to a set of circumstances, that aren't easily
 # implemented by Profile Editor. This block allows you to custom-render humans,
 # defaulting to the core template's original behaviur.
#}
{% block profileFieldPeople %}
    {% if selectedField.field in ['hohTeacher'] %}
        {# Head of House only applies to certain year levels #}
        {% set showHeadOfHouse = externalUser.StudentYearLevel in [9,10,11,12] %}

        {% if showHeadOfHouse %}
            <dt class="small-4 medium-3 columns">{{ macro.fieldName(selectedField) }}</dt>
            <dd class="small-8 medium-9 columns">
                {# These fields are Schoolbox\User instances and need special treatment #}
                {{ macro.email(session, selectedField.value.email, selectedField.value.formatName) }}
            </dd>
        {% endif %}
    {% elseif selectedField.field in ['coordTeacher'] %}
        {# Coord Teacher only applies to certain year levels #}
        {% set showCoordTeacher = externalUser.StudentYearLevel in [6,7,8] %}

        {% if showCoordTeacher %}
            {# In their prod terminology, this is still Year Level Coordinator
             # so I'm...not sure if that was supposed to be renamed, or if this
             # is a unique contextual usage here. I'll keep it close to the original
             # implementation for now.
             #}
            <dt class="small-4 medium-3 columns">Head of Year {{ externalUser.StudentYearLevel }}</dt>
            <dd class="small-8 medium-9 columns">
                {# These fields are Schoolbox\User instances and need special treatment #}
                {{ macro.email(session, selectedField.value.email, selectedField.value.formatName) }}
            </dd>
        {% endif %}
    {% elseif selectedField.field in ['tutorTeacher'] %}
        {# turn off specific sections for year 6-12 students#}
        {% set isUpperYears = externalUser.StudentYearLevel in [6,7,8,9,10,11,12] %}

        {% if not isUpperYears  %}
            <dt class="small-4 medium-3 columns">Horizontal Tutor</dt>
            <dd class="small-8 medium-9 columns">
                {# These fields are Schoolbox\User instances and need special treatment #}
                {{ macro.email(session, selectedField.value.email, selectedField.value.formatName) }}
            </dd>
        {% endif %}
    {% elseif selectedField.field in ['formTeacher'] %}
        {# turn off specific sections for year 6-12 students#}
        {% set isUpperYears = externalUser.StudentYearLevel in [6,7,8,9,10,11,12] %}

        {% if isUpperYears %}
            <dt class="small-4 medium-3 columns">Mentor</dt>
            <dd class="small-8 medium-9 columns">
                {# These fields are Schoolbox\User instances and need special treatment #}
                {{ macro.email(session, selectedField.value.email, selectedField.value.formatName) }}
            </dd>
        {% else %}
            <dt class="small-4 medium-3 columns">Class Teacher</dt>
            <dd class="small-8 medium-9 columns">
                {# These fields are Schoolbox\User instances and need special treatment #}
                {{ macro.email(session, selectedField.value.email, selectedField.value.formatName) }}
            </dd>
        {% endif %}
    {% else %}
        {# Default behaviour specified in core template #}
        {{ parent() }}
    {% endif %}
{% endblock %}


{# Intercept default handling of a tuple. Custom Works' tuples must get dealt with specially here,
 # before falling back to just putting selectedField.value on screen
 #}
{% block profileFieldTuple %}
    {% if selectedField.field in ['StudentTutorDescription'] %}
        {# turn off specific sections for year 6-12 students#}
        {% set isUpperYears = externalUser.StudentYearLevel in [6,7,8,9,10,11,12] %}

        {% if not isUpperYears %}
            <dt class="small-4 medium-3 columns">Horizontal Tutor Group</dt>
            <dd class="small-8 medium-9 columns">
                {{ selectedField.value }}
            </dd>
        {% endif %}
    {% else %}
        {# Default behaviour specified in core template #}
        {{ parent() }}
    {% endif %}
{% endblock %}








