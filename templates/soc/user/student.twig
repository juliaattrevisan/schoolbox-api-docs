{% extends '@core/user/student.twig' %}

{# turn off specific sections for year 6-12 students#}
{% set isUpperYears = externalUser.StudentYearLevel in [6,7,8,9,10,11,12] %}
{% set showHeadOfHouse = externalUser.StudentYearLevel in [9,10,11,12] %}
{% set showCoordTeacher = externalUser.StudentYearLevel in [6,7,8] %}


{% block details_hohTeacher %}
    {% if showClasses %}
        {% if showHeadOfHouse and hohTeacher %}
            <dt class="small-4 medium-3 columns">Head of House:</dt>
            <dd class="small-8 medium-9 columns">
                {% if hohTeacher.id %}
                    <a href="{{ session.mailhandle }}{{ hohTeacher.email }}">{{ hohTeacher.formatName }}</a>
                {% else %}
                    {{ hohTeacher.formatName }}
                {% endif %}
            </dd>
        {% endif %}
        {% if showCoordTeacher and coordTeacher %}
            <dt class="no-margin small-6 medium-3">Head of Year {{ externalUser.StudentYearLevel }}:</dt>
            <dd class="no-margin small-6 medium-9">
                {% if coordTeacher.id %}
                    <a href="{{ session.mailhandle }}{{ coordTeacher.email }}">{{ coordTeacher.formatName }}</a>
                {% else %}
                    {{ coordTeacher.formatName }}
                {% endif %}
            </dd>
        {% endif %}
    {% endif %}
{% endblock details_hohTeacher %}

{% block details_formTeacher %}
    {% if showClasses %}
        {# Horizontal Tutor #}
        {% if tutorTeacher and not isUpperYears %}
            <dt class="small-4 medium-3 columns">Horizontal Tutor:</dt>
            <dd class="small-8 medium-9 columns">
                {% if tutorTeacher.id %}
                    <a href="{{ session.mailhandle }}{{ tutorTeacher.email }}">{{ tutorTeacher.formatName }}</a>
                {% else %}
                    {{ tutorTeacher.formatName }}
                {% endif %}
            </dd>
        {% endif %}

        {% if externalUser.StudentTutorDescription ?? false and not isUpperYears %}
            <dt class="small-4 medium-3 columns">Horizontal Tutor Group:</dt>
            <dd class="small-8 medium-9 columns">{{ externalUser.StudentTutorDescription }}</dd>
        {% endif %}

        {# Vertical Tutor #}
        {% if formTeacher %}
            {% if isUpperYears %}
                <dt class="small-12 medium-3">Mentor:</dt>
            {% else %}
                <dt class="small-12 medium-3">Class Teacher:</dt>
            {% endif %}
            <dd class="small-12 medium-9">
                {% if formTeacher.id %}
                    <a href="{{ session.mailhandle }}{{ formTeacher.email }}">{{ formTeacher.formatName }}</a>
                {% else %}
                    {{ formTeacher.formatName }}
                {% endif %}
            </dd>

            {% if externalUser.StudentForm %}
                {% if isUpperYears %}
                    <dt class="small-12 medium-3">Mentor Group:</dt>
                {% else %}
                    <dt class="small-12 medium-3">Class Group:</dt>
                {% endif %}
                <dd class="small-12 medium-9">{{ externalUser.StudentForm }}</dd>
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}


{% block buttons_dueWork %}
    {% if not (config.restrict_parent_duework_access and session.user.isParent()) %}
        <li>
            <a href="/learning/due/{{ user.getId() }}" class="icon-due-work">Tasks/Assessments Due</a>
        </li>
    {% endif %}
{% endblock %}

{% block buttons_grades %}
    {% if not (config.restrict_parent_grades and session.user.isParent()) %}
        <li>
            <a href="/learning/grades/{{ user.getId() }}" class="icon-tick">Assessments</a>
        </li>
    {% endif %}
{% endblock %}
