{% extends '@core/user/student.twig' %}

{% block buttons_documents %}
    {% if config.external_document_report_enabled %}
        {% set routeAcademicReports = routeLookupIfAuthorized('profileDocumentManagement.getIndex', {studentId: user.id}) %}
        {% if routeAcademicReports %}
            <li>
                <a href="{{ routeAcademicReports }}" class="icon-document">Medical Documents</a>
            </li>
        {% endif %}
    {% endif %}
{% endblock buttons_documents %}

{% block buttons %}
    {{ parent() }}
    {% if isStaff %}
        <li><a class="icon-progress" href="https://datadashboard.penola.vic.edu.au/login/stafflogin/{{ user.id }}">Data Dashboard</a></li>
    {% endif %}
{% endblock buttons %}