{% extends '@core/user/student.twig' %}

{% block medicalAlert %}
{% endblock medicalAlert %}

{% block details_tutorTeacher %}
    {% if showClasses %}
        {% if tutorTeacher %}
            <dt class="no-margin small-6 medium-3">Pastoral Care Teacher</dt>
            <dd class="no-margin small-6 medium-9">
                {% if tutorTeacher.getId() %}
                    <a href="{{ session.mailhandle }}{{ tutorTeacher.getEmail() }}">{{ tutorTeacher.formatName() }}</a>
                {% else %}
                    {{ tutorTeacher.formatName() }}
                {% endif %}
            </dd>
        {% endif %}
    {% endif %}
{% endblock details_tutorTeacher %}

{% block details_coordTeacher %}
    {% if coordTeacher %}
        <dt class="no-margin small-6 medium-3">Year Coordinator:</dt>
        <dd class="no-margin small-6 medium-9">
            {% if coordTeacher.getId() %}
                <a href="{{ session.mailhandle }}{{ coordTeacher.getEmail() }}">{{ coordTeacher.formatName() }}</a>
            {% else %}
                {{ coordTeacher.formatName() }}
            {% endif %}
        </dd>
    {% endif %}
{% endblock details_coordTeacher %}

{% block details_hohTeacher %}
{% endblock details_hohTeacher %}

{# Buttons - add intranet at start of list #}
{% block buttons %}
    <li class="no-pad">
        <a href="https://intranet.wenona.nsw.edu.au/contentpages/studentprofile/default.aspx?studentID={{ user.getExternalId() }}"
           class="no-margin fat button icon-fat size-32 icon-synergetic"
           data-equalizer-watch>Intranet</a>
    </li>
    {{ parent() }}
    {# Change of information request can go here #}
    <li class="no-pad">
        <a href="{{ session.mailhandler }}changeofinformation@wenona.nsw.edu.au"
           class="no-margin fat button icon-fat size-32 icon-email"
           title="Email Wenona about updates to your information"
           data-equalizer-watch>Email Updates</a>
    </li>
{% endblock buttons %}

{% block buttons_dueWork %}
{% endblock buttons_dueWork %}

{% block buttons_grades %}
    {% if (not session.user.getRole().isParent()) or (not config.restrict_parent_grades) %}
        <li class="no-pad">
            <a href="https://intranet.wenona.nsw.edu.au/contentpages/studentprofile/default.aspx?studentID={{ user.getExternalId() }}"
               class="no-margin fat button icon-fat size-32 icon-tick"
            >My Progress</a>
        </li>
    {% endif %}
{% endblock buttons_grades %}

{% block contacts_alert %}
{% endblock contacts_alert %}
