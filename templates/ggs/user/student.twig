{% extends '@core/user/student.twig' %}

{% block medicalAlert %}
    {% for message in externalUser.AlertMessages ?? [] %}
        {# Only staff may view contact alerts #}
        {% if showContactsAlert %}
            <div class="alert-box alert icon-alert">
                {{ message | nl2br }}
            </div>
        {% endif %}
    {% endfor %}
    {% if externalUser.StudentMedicalAlert ?? false and showMedicalAlert %}
        <div class="alert-box highlight">{{ externalUser.StudentMedicalAlert | nl2br }}</div>
    {% endif %}
{% endblock medicalAlert %}


{% block contacts_alert %}
{% endblock contacts_alert %}

