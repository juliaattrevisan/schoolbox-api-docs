{% extends '@core/user/student.twig' %}
{% block specialAlert %}
    {% if isStaffWhoCanView and (externalUser.IndigenousFlag ?? false or externalUser.StudentTSIFlag ?? false) %}
        <div class="alert-box highlight">
            {% if isStaffWhoCanView and externalUser.IndigenousFlag ?? false %}
                <img src="{{ CDN_PREFIX }}/images/tcgi/aboriginal.jpeg" alt="Aboriginal decent">
            {% endif %}
            {% if isStaffWhoCanView and externalUser.StudentTSIFlag ?? false %}
                <img src="{{ CDN_PREFIX }}/images/tcgi/tsiflag.bmp" alt="orres Strait Islander decent">
            {% endif %}
        </div>
    {% endif %}
    {{ parent() }}
{% endblock specialAlert %}
