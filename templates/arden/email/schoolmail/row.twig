{% import 'macro/spacer.twig' as fn %}

<tr class="{{ loop.index is even ? 'dark' : '' }}">{{ fn.spacer(config.fqdn, 12, 0, 4) }}</tr>
<tr class="{{ loop.index is even ? 'dark' : '' }}">
    <td width="64" height="56" valign="top">
        <table>
            <tr>
                {{ fn.spacer(config.fqdn, 0, 8) }}
                <td>
                    {% block image %}
                    {# leave an empty space of appropriate size #}
                    {{ fn.spacer(config.fqdn, 56, 56) }}
                    {% endblock %}
                </td>
            </tr>
        </table>
    </td>
    {{ fn.spacer(config.fqdn, 0, 12) }}
    <td valign="top">
        <table width="100%">
            <tr>
                <td>
                    {% block pretty %}
                    <!-- NO HEADING -->
                    {% endblock %}
                </td>
            </tr>
            {% block meta %}
                <tr class="underline">{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
                <tr>{{ fn.spacer(config.fqdn, 4, 0) }}</tr>
            {% endblock %}
        </table>
    </td>
    {{ fn.spacer(config.fqdn, 0, 8) }}
</tr>
<tr style="border-bottom:1px solid #dbe9ec" class="{{ loop.index is even ? 'dark' : '' }}">{{ fn.spacer(config.fqdn, 12, 0, 4) }}</tr>

