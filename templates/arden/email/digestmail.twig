{% extends 'schoolmail.twig' %}
{# parent DOM: you are directly inside a <td/> right now #}
{% block content %}
    <table>
    {% for ns, group in groups %}
        <tr>{{ fn.spacer(config.fqdn, 16, 0, 3) }}</tr>
        <tr class="heading">
            {{ fn.spacer(config.fqdn, 0, 8) }}
            <td class="heading" valign="middle" height="32">{{ group.heading }}</td>
        </tr>
        <tr>
            {{ fn.spacer(config.fqdn, 0, 8) }}
            <td valign="middle" height="32">
            <ul class="admin-nav">
                <li class="all"><a href="http://schoolbox.arden.nsw.edu.au/news/" title="News All">News All</a></li>
                <li class="comm"><a href="http://schoolbox.arden.nsw.edu.au/news/community" title="Community">Community</a></li>
                <li class="events"><a href="http://schoolbox.arden.nsw.edu.au/news/events" title="Events">Events</a></li>
                <li class="general"><a href="http://schoolbox.arden.nsw.edu.au/news/general-news" title="General">General</a></li>
                <li class="music"><a href="http://schoolbox.arden.nsw.edu.au/news/music" title="Music">Music</a></li>
                <li class="notices"><a href="http://schoolbox.arden.nsw.edu.au/news/notices" title="Notices">Notices</a></li>
                <li class="sport"><a href="http://schoolbox.arden.nsw.edu.au/news/sport" title="Sport">Sport</a></li>
            </ul>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <table width="624">
                    <tr>
                        <td>
                            <table width="624">
                            {% for row in group.rows %}
                                {% include "digestmail/grouping/#{ns}.twig" %}
                            {% endfor %}
                            </table>
                        </td>
                    </tr>
                    <tr>{{ fn.spacer(config.fqdn, 4, 0) }}</tr>
                </table>
            </td>
        </tr>
    {% endfor %}
        <tr>{{ fn.spacer(config.fqdn, 8, 0, 2) }}</tr>
    </table>
{% endblock %}

