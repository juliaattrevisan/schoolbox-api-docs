{% extends 'schoolmail.twig' %}
{# parent DOM: you are directly inside a <td/> right now #}
{% block content %}
    <table>
    {% for ns, group in groups %}
        <tr>{{ fn.spacer(config.fqdn, 16, 0, 3) }}</tr>
        <tr class="heading">
            {{ fn.spacer(config.fqdn, 0, 8) }}
            <td class="heading" valign="middle" height="32">{{ group.heading }}</td>
        </tr>
        {% if ns == 'news' %}
        <tr class="admin-nav">
            <td colspan="2">
                <table width="624">
                    <tr>      
                        <td valign="middle" height="32">
                            <a class="all" href="http://schoolbox.arden.nsw.edu.au/news/" title="News All">News All</a>
                        </td>
                        <td valign="middle" height="32">
                            <a class="notices" href="http://schoolbox.arden.nsw.edu.au/news/notices" title="Notices">Notices</a>
                        </td>
                        <td valign="middle" height="32">
                            <a class="general" href="http://schoolbox.arden.nsw.edu.au/news/general-news" title="General">General</a>
                        </td>
                        <td valign="middle" height="32">
                            <a class="events" href="http://schoolbox.arden.nsw.edu.au/news/events" title="Events">Events</a>
                        </td>
                        <td valign="middle" height="32">
                            <a class="sport" href="http://schoolbox.arden.nsw.edu.au/news/sport" title="Sport">Sport</a>
                        </td>
                        <td valign="middle" height="32">
                            <a class="music" href="http://schoolbox.arden.nsw.edu.au/news/music" title="Music">Music</a>
                        </td>
                        <td valign="middle" height="32">
                            <a class="comm" href="http://schoolbox.arden.nsw.edu.au/news/community" title="Community">Community</a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        {% endif %}
        <tr>
            <td colspan="2">
                <table width="624">
                    <tr>
                        <td>
                            <table width="624">
                            {% for row in group.rows %}
                                {% include "digestmail/grouping/#{ns}.twig" %}
                            {% endfor %}
                            </table>
                        </td>
                    </tr>
                    <tr>{{ fn.spacer(config.fqdn, 4, 0) }}</tr>
                </table>
            </td>
        </tr>
    {% endfor %}
        <tr>{{ fn.spacer(config.fqdn, 8, 0, 2) }}</tr>
    </table>
{% endblock %}

