{% extends '@core/user/student.twig' %}

{% if showDetails %}
    {% block details_studentId %}
    {% endblock details_studentId %}

    {% block details_dob %}
        {% if  externalUser.StudentBirthDate|date  %}
        {% endif %}
    {% endblock details_dob %}

    {% block details_tutorTeacher %}
        {% if showClasses %}
            {% if tutorTeacher %}
            {% endif %}
        {% endif %}
    {% endblock details_tutorTeacher %}

    {% block details_hohTeacher %}
        {% if showClasses %}
            {% if hohTeacher %}
            {% endif %}
        {% endif %}
    {% endblock details_hohTeacher %}

    {% block details_studentType %}
        {% if boarderType %}
        {% endif %}
    {% endblock details_studentType %}
{% endif %}

{% block buttons_miscellaneous %}
    <li>
        <a href="{{ routeLookup('customStkOleReport.reportList', {studentId: user.id}) }}" class="icon-document">Reports</a>
    </li>

    {# Obey access rules for non-ib students #}
    {% set nceaRoute = routeLookupIfAuthorized('nceaReport.getReport', {id: user.id, year: 'now'|date('Y')}) %}

    {% if nceaRoute and not externalUser.StudentIBFlag %}
    <li>
        <a href="{{ nceaRoute }}" class="icon-progress">NCEA Report</a>
    </li>
    {% endif %}
{% endblock buttons_miscellaneous %}
