{% extends '@core/user/student.twig' %}




{% block details_hohTeacher %}
    {% if showClasses %}
        {% if hohTeacher %}
            <dt class="small-4 medium-3 columns">Cohort Leader:</dt>
            <dd class="small-8 medium-9 columns">
            {% if hohTeacher.id %}
                <a href="{{ session.mailhandle }}{{ hohTeacher.email }}">{{ hohTeacher.formatName }}</a>
            {% else %}
                {{ hohTeacher.formatName }}
            {% endif %}
            </dd>
        {% endif %}
    {% endif %}
{% endblock details_hohTeacher %}


{# Display the student's Travel Log in the afterButtons area #}
{% block afterButtons %}
    <table>
        <thead>
            <tr>
                <th>TYPE</th>
                <th>ACTION & LOCATION</th>
                <th>TIME</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>aaaaaaaa</td>
                <td>bbbbbbbbbbbbbbbb</td>
                <td>ccccccccc</td>
            </tr>
            <tr>
                <td>dddd</td>
                <td>eeeeeeee</td>
                <td>fff</td>
            </tr>
            <tr>
                <td>gggggggggggggggg</td>
                <td>hh</td>
                <td>iiiiiiiii</td>
            </tr>
        </tbody>
    </table>
    {% if showDetails %}
        {{ travelLogs | raw }}
    {% endif %}
{% endblock afterButtons %}
