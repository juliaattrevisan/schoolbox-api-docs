{% extends "schoolmail/row.twig" %}

{% block image %}
    {% set msg = row.messages | first %}
    {% if 'icon=news' in msg.icon %}
        <img src="https://{{ config.fqdn }}/images/logo.php?logo=skin_logo_square&size=normal" width="56" height="56" />
    {% else %}
        <img src="{{ msg.icon }}" width="64" height="64" />
    {% endif %}
{% endblock %}

{% block pretty %}
    {% set msg = row.messages | first %}
    {% if msg.meta.title %}
        {# use the meta title if possible, it looks nicer #}
        {# Blurb only? show no link #}
        {% if msg.meta.body|length %}
            <a href="{{ msg.href }}" class="title">{{ msg.meta.title }}</a>
        {% else %}
            <span class="title">{{ msg.meta.title }}</span>
        {% endif %}
    {% else %}
        {# raw HTML unable to be sanctioned or rejected - I don't know whether this could be HTML or not. #}
        {{ msg.title | raw }}
    {% endif %}
{% endblock %}

{% block meta %}
    {% set msg = row.messages | first %}
    {% if msg.meta %}
        {{ parent() }}
        <tr>
            <td>
                <p>
                    <em>
                        {{ msg.meta.byline }}
                    </em>
                </p>
            </td>
        </tr>
        <tr>
            <td>
                {% if msg.meta.blurb | length %}
                    {# blurb already has a <p> tag #}
                    {{ msg.meta.blurb | purifyAbsoluteUri('https://'~config.fqdn) }}
                {% else %}
                    <p>{{ msg.meta.body | cutSentence(300, true) }}</p>
                {% endif %}
            </td>
        </tr>
    {% endif %}
{% endblock %}
