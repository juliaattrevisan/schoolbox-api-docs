{% extends '@core/user/student.twig' %}

{% if showDetails %}
    {% block details_studentType %}
        {% if boarderType and USER.role.isStaff %}
            <dt class="small-12 medium-3">Student Type:</dt>
            <dd class="small-12 medium-9">{{ boarderType }}</dd>
        {% endif %}
    {% endblock details_studentType %}
{% endif %}