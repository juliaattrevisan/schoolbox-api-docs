{% extends 'schoolmail.twig' %}
{% block content %}
    {# dig into the context #}
    {% set ns = groups|first %}
    {% set row = ns.rows|first %}
    {% set msg = row.messages|first %}

    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
    <tr>{{ fn.spacer(config.fqdn, 16, 0) }}</tr>
    <tr>
        <td width="640">
            <p>Hi {{ recipient }},</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    <tr>
        <td width="640">
            <p>You have requested your account login information for the {{ config.title }}.</p>
            <p>The details are listed below.</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    {% if forgotten_password == '0' %}
    <tr>
        <td width="640">
            <p>Username: {{ username }}</p>
        </td>
    </tr>
    {% endif %}
    <tr>
        <td width="640">
            <p>Password: {{ password }}</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    <tr>
        <td width="640">
            <p>Regards,</p>
            <p>Bialik College Technology Services Department</p>
            <p>support@bialik.vic.edu.au</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 16, 0, 2) }}</tr>
</table>
{% endblock %}
