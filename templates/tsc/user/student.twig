{% extends '@core/user/student.twig' %}

{% block buttons %}
    {{ parent() }}
    {% if isParentOfStudent or isStaff %}
        <li><a class="icon-result" href="https://dashboard.tsc.nsw.edu.au/login/index/{{user.id}}">Results</a></li>
    {% endif %}
{% endblock buttons %}

{# This adds Learning Enrichment Case Manager field where a Coordinator
 # would otherwise be found. The base template doesn't use this
 # so I presume I can just hijack its spot. If there's no name,
 # hide this definition entirely (render nothing)
 #}
{% block details_coordTeacher %}
    {{ parent() }}
    {% if externalUser.LECaseManagerName ?? false %}
        <dt class="no-margin small-6 medium-3">Learning Enrichment Case Manager:</dt>
        <dd class="no-margin small-6 medium-9">
            {% if externalUser.LECaseManagerUserId %}
                <a href="/search/user/{{ externalUser.LECaseManagerUserId }}">{{ externalUser.LECaseManagerName }}</a>
            {% else %}
                {{ externalUser.LECaseManagerName }}
            {% endif %}
        </dd>
    {% endif %}
{% endblock details_coordTeacher %}
