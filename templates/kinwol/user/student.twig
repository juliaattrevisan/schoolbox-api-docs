{% extends '@core/user/student.twig' %}
{% block specialAlert %}
    {% if externalUser.StudentSpecialNeedsFlag and showSpecialAlert %}
        <a class="alert-box-icon highlight icon-bell" title="{{ locale.translate('specialNeeds', false, true) }}" data-alert-button></a>
    {% endif %}
{% endblock specialAlert %}

{% block englishSecond %}
    {% if externalUser.EnglishSecondFlag and showSpecialAlert  %}
        <a class="alert-box-icon highlight icon-eng-second-lang" title="English as an Additional Language" data-alert-button></a>
    {% endif %}
{% endblock englishSecond %}

{% block medicalAlert %}
    {% if externalUser.StudentMedicalAlert and showMedicalAlert %}
        <a class="alert-box-icon alert icon-alert" title="Medical Note: {{ externalUser.StudentMedicalAlert }}" data-alert-button></a>
    {% endif %}
{% endblock medicalAlert %}

{% block individualEducationPlan %}
    {% if isStaff and externalUser.countIndividualEducationPlans > 0 %}
        <a class="alert-box-icon highlight icon-curriculum" title="Individual Education Plan" data-alert-button></a>
    {% endif %}
{% endblock individualEducationPlan %}

{% block synergeticComments %}
    {% if externalUser.Comment is not empty and showComments %}
        <a class="alert-box-icon highlight icon-info" title="{{ externalUser.Comment | nl2br }}" data-alert-button></a>
    {% endif %}
{% endblock synergeticComments %}

{% block contacts_alert %}
    {# Only staff may view contact alerts #}
    {% if showContactsAlert %}
        <a class="alert-box-icon alert icon-alert" title="{{ message | nl2br }}" data-alert-button></a>
    {% endif %}
{% endblock contacts_alert %}

{% block pd %}
<script>
    /**
     * Kinross Wolaroi would like their alerts less prominent and to minimise the risk of visibility to others while on screen
     * As a result the alerts have been changed to buttons with just the relevant icon initially visible
     * Once the alert is selected the title attribute will be referenced to add the text to the button
     * The title attribute is still shown on hover when available, and the click ensures visibility across all devices 
     */
    const alertButtons = document.querySelectorAll('[data-alert-button]');
    alertButtons.forEach((alertButton) => {
        alertButton.addEventListener('click', (event) => {
            if (alertButton.textContent === '') {
                alertButton.textContent = alertButton.getAttribute('title');
                alertButton.style.width = '100%';
            } else {
                alertButton.textContent = '';
                alertButton.style.width = '2rem';
            }
        });
    });
</script>
<style>
    @media only print, screen and (max-width: 40em) {
        .profile .alert-box, .profile .eotc-status, .profile .alert-box-icon, .profile .pastoral-flags {
            padding: 0.25rem 0.5rem
        }
    }

    .alert-box-icon {
        display: block;
        width: 2rem;
    }
    .alert-box:empty,
    .alert-box-icon:empty {
        /* was display:none, so need to ensure our empty buttons are initially visible */ 
        display: block;
    }
</style>
{% endblock pd %}