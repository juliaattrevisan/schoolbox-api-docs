{% extends '@core/user/student.twig' %}


{% block details_studentType %}
    {% if boarderType %}
        <dt class="small-4 medium-3 columns">Student Type:</dt>
        <dd class="small-8 medium-9 columns">
            {{ boarderType }}

            {% if externalUser.StudentNonResidentFlag %}
                <br />International Student
            {% endif %}
        </dd>
    {% endif %}
{% endblock details_studentType %}

{% block buttons_miscellaneous %}
    <li>
        <a href="{{ routeLookup('customStkOleReport.reportList', {studentId: user.id}) }}" class="icon-document">Reports</a>
    </li>

    {# Obey access rules for non-ib students #}
    {% set nceaRoute = routeLookupIfAuthorized('nceaReport.getReport', {userId: user.id, year: 'now'|date('Y'), user: user}) %}

    {% if nceaRoute %}
    <li>
        <a href="{{ nceaRoute }}" class="icon-progress">NCEA Progress</a>
    </li>
    {% endif %}
{% endblock buttons_miscellaneous %}
