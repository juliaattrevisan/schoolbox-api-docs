{% extends '@core/user/student.twig' %}

{% block buttons_grades %}
    {% if not (config.restrict_parent_grades and session.user.getRole().isParent()) %}
        <li class="no-pad">
            <a href="/learning/grades/{{ user.getId() }}" class="no-margin fat button icon-fat size-32 icon-tick">Grades</a>
        </li>
    {% endif %}
    <li class="no-pad"><a href="/synRedir.php?page=Docs&menu=&id={{ user.getExternalId() }}" target="_blank" class="no-margin fat button icon-fat size-32 icon-files">Reports</a></li>
    <li class="no-pad"><a href="/synRedir.php?page=pti&menu=&id={{ user.getExternalId() }}" target="_blank" class="no-margin fat button icon-fat size-32 icon-group">PT Interviews</a></li>
    <li class="no-pad"><a href="/synRedir.php?page=StudentParentContacts&menu=&id={{ user.getExternalId() }}" target="_blank" class="no-margin fat button icon-fat size-32 icon-group">Parent Contacts</a></li>
    <li class="no-pad"><a href="/synRedir.php?page=MyDetails&menu=&id={{ user.getExternalId() }}" target="_blank" class="no-margin fat button icon-fat size-32 icon-forms">My Details</a></li>
    <li class="no-pad"><a href="https://community.moriah.nsw.edu.au/ExcursionDetails.aspx" target="_blank" class="no-margin fat button icon-fat size-32 icon-location">Excursions</a></li>
{% endblock buttons_grades %}
