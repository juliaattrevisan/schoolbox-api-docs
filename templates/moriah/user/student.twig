{% extends '@core/user/student.twig' %}

{% set inSeniorCampus = false %}

{% for campus in user.campusCollection %}
    {% if campus.extTimetableCode == 'HS' %}
        {% set inSeniorCampus = true %}
    {% endif %}
{% endfor %}

{% block details_formTeacher %}
    {% if showClasses %}
        {% if formTeacher %}
            <dt class="small-4 medium-3 columns">Head of Year:</dt>
            <dd class="small-8 medium-9 columns">
                {% if formTeacher.id %}
                    <a href="{{ session.mailhandle }}{{ formTeacher.email }}">{{ formTeacher.formatName }}</a>
                {% else %}
                    {{ formTeacher.formatName }}
                {% endif %}
            </dd>
        {% endif %}
    {% endif %}
{% endblock details_formTeacher %}

{% block details_tutorTeacher %}
    {% if showClasses %}
        {% if tutorTeacher %}
            <dt class="small-4 medium-3 columns">
                {% if inSeniorCampus %}
                    Mentor:
                {% else %}
                    Class Teacher:
                {% endif %}
            </dt>
            <dd class="small-8 medium-9 columns">
                {% if tutorTeacher.id %}
                    <a href="{{ session.mailhandle }}{{ tutorTeacher.email }}">{{ tutorTeacher.formatName }}</a>
                {% else %}
                    {{ tutorTeacher.formatName }}
                {% endif %}
            </dd>
        {% endif %}
    {% endif %}
{% endblock details_tutorTeacher %}

{% block details_tutorGroup %}
    {% if showClasses %}
        {% if externalUser.StudentTutorDescription %}

            {# Remove usage of "Class" which only occurs with people outsiide
             # the Senior Campus. Presumably "Mentor Group" is still in usage
             #}
            {% if inSeniorCampus %}
            <dt class="small-4 medium-3 columns">
                Mentor Group:
            </dt>
            <dd class="small-8 medium-9 columns">{{ externalUser.StudentTutorDescription }}</dd>
            {% endif %}

        {% endif %}
    {% endif %}
{% endblock details_tutorGroup %}

{# Disable this block #}
{% block details_studentType %}
{% endblock %}

{# Disable this block #}
{% block details_studentForm %}
{% endblock %}

{# Cuastomisation SA-12128 #}
{% block extraDetails %}

    {# Community Service hours are only available to student and their parents #}
    {% if externalUser.studentChesedHours and (isSelf or isParentOfStudent) %}
        <dt class="small-4 medium-3 columns">
            Chesed Hours:
        </dt>
        <dd class="small-8 medium-9 columns">{{ externalUser.studentChesedHours }}</dd>
    {% endif %}
{% endblock %}