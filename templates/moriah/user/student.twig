{% extends '@core/user/student.twig' %}

{% block buttons_grades %}
    {% if not (config.restrict_parent_grades and session.user.getRole().isParent()) %}
        <li class="no-pad">
            <a href="/submission/allWork/{{ user.getId() }}"
               class="no-margin fat button icon-fat icon-32 icon-tick"
            >Grades</a>
        </li>
    {% endif %}
    {% if session.user.getRole().isStaff() or (session.user.getRole().isParent() and not config.restrict_parent_grades) %}
        <li class="no-pad">
            <a href="/modules/custom/moriah/cohort/student/{{ user.getId() }}"
               class="no-margin fat button icon-fat icon-32 icon-report"
            >Cohort Report</a>
        </li>
    {% endif %}
    <li class="no-pad"><a href="/synergetic/Docs/?id={{ user.getExternalId() }}" class="no-margin fat button icon-fat icon-32 icon-files">Reports</a></li>
    <li class="no-pad"><a href="/synergetic/pti/?id={{ user.getExternalId() }}" class="no-margin fat button icon-fat icon-32 icon-group">PT Interviews</a></li>
    <li class="no-pad"><a href="/synergetic/StudentParentContacts/?id={{ user.getExternalId() }}" class="no-margin fat button icon-fat icon-32 icon-group">Parent Contacts</a></li>
    <li class="no-pad"><a href="http://ely.moriah.nsw.edu.au/synRedir.php?page=MyDetails&menu=&id={{ user.getExternalId() }}" target="_blank" class="no-margin fat button icon-fat icon-32 icon-group">My Details</a></li>
{% endblock buttons_grades %}
