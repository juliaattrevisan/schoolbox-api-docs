{% import 'macro/spacer.twig' as fn %}

<tr>{{ fn.spacer(config.fqdn_cdn_prefix, 16, 4, 3) }}</tr>
<tr>
    {{ fn.spacer(config.fqdn_cdn_prefix, 0, 8) }}
    <td width="608" valign="top">

        {% if hideUnsubscribe is defined and hideUnsubscribe %}
            {# noop #}
        {% else %}
            <p>If you do not wish to receive these emails from {{ config.school_name }}, please
                <a href="https://reset.collegiate.tas.edu.au:4430/unsubscribe/">unsubscribe</a>.
            </p>
        {% endif %}

        <p>
            &copy; {{ config.year }}
            <a href="{{ config.school_address }}">{{ config.school_name }}</a> |
            <a href="http://{{ config.fqdn }}/policy">Guidelines of Use and Privacy Policy</a>

            {% if config.feedback_url|trim is not empty and config.feedback_text|trim is not empty %}
                {% if config.feedback_url_object.isRelativeUrl %}
                    {% set feedback_url = 'http://' ~ config.fqdn ~ config.feedback_url|trim %}
                {% else %}
                    {% set feedback_url = config.feedback_url|trim %}
                {% endif %}

                | <a href="{{ feedback_url }}">{{ config.feedback_text|trim|purify }}</a>
            {% endif %}
        </p>
    </td>
    {{ fn.spacer(config.fqdn_cdn_prefix, 0, 8) }}
</tr>
<tr>{{ fn.spacer(config.fqdn_cdn_prefix, 16, 4, 3) }}</tr>
