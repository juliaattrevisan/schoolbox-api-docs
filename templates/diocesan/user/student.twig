{% extends '@core/user/student.twig' %}

{% if showButtons %}
    {% block details_studiesCode %}
        {% if externalUser.StudentStudiesCode %}
        <dt class="no-margin small-6 medium-3">NSN</dt>
        <dd class="no-margin small-6 medium-9">{{ externalUser.StudentStudiesCode }}</dd>
        {% endif %}
    {% endblock details_studiesCode %}

    {% block buttons_miscellaneous %}
        <!-- Start on School Grades page initially -->
        <li class="no-pad"><a href="/modules/custom/diocesan/achievementreport/{{ user.getExternalId() }}" class="no-margin fat icon-fat button size-32 icon-progress" data-equalizer-watch>Achievement</a></li>
        <li class="no-pad"><a href="/synergetic/stures" class="no-margin fat icon-fat button size-32 icon-progress" data-equalizer-watch>Progress</a></li>
        <li class="no-pad"><a href="/synergetic/contacts" class="no-margin fat icon-fat button size-32 icon-progress" data-equalizer-watch>Contacts</a></li>
        <li class="no-pad"><a href="/synergetic/attendances2" class="no-margin fat icon-fat button size-32 icon-progress" data-equalizer-watch>Attendance</a></li>
        <li class="no-pad"><a href="/synergetic/docs" class="no-margin fat icon-fat size-32 button icon-progress" data-equalizer-watch>Documents</a></li>
    {% endblock buttons_miscellaneous %}
{% endif %}
