{% extends '@core/user/student.twig' %}

{% block details_hohTeacher %}
    {% if showClasses %}
        {% if hohTeacher %}
            <dt class="small-12 medium-3">Staff House Leader:</dt>
            <dd class="small-12 medium-9">
                {% if hohTeacher.getId() %}
                    <a href="{{ session.mailhandle }}{{ hohTeacher.getEmail() }}">{{ hohTeacher.formatName() }}</a>
                {% else %}
                    {{ hohTeacher.formatName() }}
                {% endif %}
            </dd>
        {% endif %}
    {% endif %}
{% endblock details_hohTeacher %}

{% if showButtons %}
    {% block details_studiesCode %}
        {% if externalUser.StudentStudiesCode %}
        <dt class="no-margin small-6 medium-3">NSN</dt>
        <dd class="no-margin small-6 medium-9">{{ externalUser.StudentStudiesCode }}</dd>
        {% endif %}
    {% endblock details_studiesCode %}

    {% block buttons_miscellaneous %}
        <!-- Start on School Grades page initially -->
        <li><a href="/modules/custom/diocesan/achievementreport/{{ user.getExternalId() }}" class="icon-progress">Achievement</a></li>
        <li><a href="/synergetic/stures" class="icon-progress">Progress</a></li>
        <li><a href="/synergetic/contacts" class="icon-progress">Contacts</a></li>
        <li><a href="/synergetic/attendances2" class="icon-progress">Attendance</a></li>
        <li><a href="/synergetic/docs" class="icon-progress">Documents</a></li>
    {% endblock buttons_miscellaneous %}
{% endif %}
