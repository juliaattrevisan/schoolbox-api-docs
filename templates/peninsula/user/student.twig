{% extends '@core/user/student.twig' %}

{% block medicalAlert %}
    {% if externalUser.StudentMedicalAlert and showMedicalAlert %}
        <a class="alert-box alert icon-alert no-margin" data-reveal-id="medicalModal">
            Medical Information
        </a>
        <!-- Medical Modal -->
        <div id="medicalModal" class="reveal-modal" data-reveal aria-labelledby="medicalModalTitle" aria-hidden="true" role="dialog">
            <h2 id="medicalModalTitle">Medical Note:</h2>
            <p class="alert-box alert">{{ externalUser.StudentMedicalAlert }}</p>
            <a class="close-reveal-modal" aria-label="Close">&#215;</a>
        </div>
    {% endif %}
{% endblock medicalAlert %}