{% extends '@core/user/student.twig' %}

{% block details_studiesCode %}
    {% if externalUser.StudentStudiesCode ?? false %}
        <dt class="no-margin small-4 medium-3">{{ locale.studies_code.proper }}:</dt>
        <dd class="no-margin small-8 medium-9">{{ externalUser.StudentStudiesCode }}</dd>
    {% endif %}
    {% if externalUser.StudentGovernmentStudentNumber ?? false %}
        <dt class="no-margin small-4 medium-3">LUI Number:</dt>
        <dd class="no-margin small-8 medium-9">{{ externalUser.StudentGovernmentStudentNumber }}</dd>
    {% endif %}
{% endblock details_studiesCode %}
