{% if travelLogs.data is not empty %}
    <table>
        <thead>
        <tr>
            <th>TYPE</th>
            <th>ACTION & LOCATION</th>
            <th>TIME</th>
        </tr>
        </thead>
        <tbody>
        {% for log in travelLogs.data %}
            {% set direction = log.direction|lower == 'in' ? 'Enter' : 'Exit' %}
            {% set type = log.event_type|capitalize %}
            <tr>
                <td>{{ type }}</td>
                <td>
                    <img src="/images/VIST/{{ log.icon }}"
                         title="{{ type }}, {{ direction }}"
                         alt="{{ type }}, {{ direction }}"
                         style="width: 16px; margin-right: 10px;" />
                    {{ log.location_tag }}
                </td>
                <td>{{ log.timestamp|date('h:i a') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
