{% if travelLogs.data is not empty %}
    <table>
        <thead>
        <tr>
            <th>TYPE</th>
            <th>ACTION & LOCATION</th>
            <th>TIME</th>
        </tr>
        </thead>
        <tbody>
        {% for log in travelLogs.data %}
            <tr>
                <td>{{ log.event_type|capitalize }}</td>
                <td>
                    <img src="/images/VIST/{{ log.direction|lower == 'in' ? 'enter' : 'exit' }}.svg"
                         title="{{ log.direction|lower == 'in' ? 'enter' : 'exit' }}"
                         alt="{{ log.direction|lower == 'in' ? 'enter' : 'exit' }}"
                         style="width: 16px; margin-right: 10px;" />
                    {{ log.location_tag }}
                </td>
                <td>{{ log.timestamp|date('h:i a') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
