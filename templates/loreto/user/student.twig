{% extends '@core/user/student.twig' %}

{% block details_tutorTeacher %}
{% if showClasses %}
    {% if tutorTeacher %}
    <dt class="small-12 medium-3">Academic Care Coordinator:</dt>
    <dd class="small-12 medium-9">
        {% if tutorTeacher.getId() %}
            <a href="{{ session.mailhandle }}{{ tutorTeacher.getEmail() }}">{{ tutorTeacher.formatName() }}</a>
        {% else %}
            {{ tutorTeacher.formatName() }}
        {% endif %}
    </dd>
    {% endif %}
{% endif %}
{% endblock details_tutorTeacher %}

{% block details_coordTeacher %}
{% if coordTeacher %}
<dt class="small-12 medium-3">Year Wellbeing Coordinator:</dt>
<dd class="small-12 medium-9">
    {% if coordTeacher.getId() %}
        <a href="{{ session.mailhandle }}{{ coordTeacher.getEmail() }}">{{ coordTeacher.formatName() }}</a>
    {% else %}
        {{ coordTeacher.formatName() }}
    {% endif %}
</dd>
{% endif %}
{% endblock details_coordTeacher %}

{% block details_houseCoord %}
{% if houseCoord %}
    <dt class="small-12 medium-3">House Academic Care Coordinator:</dt>
    <dd class="small-12 medium-9">
        {% if houseCoord.getId() %}
            <a href="{{ session.mailhandle }}{{ houseCoord.getEmail() }}">{{ houseCoord.formatName() }}</a>
        {% else %}
            {{ houseCoord.formatName() }}
        {% endif %}
    </dd>
{% endif %}
{% endblock details_houseCoord %}

{% block details_coach %}
    {% if studentCoach %}
        <dt class="small-12 medium-3">Coach:</dt>
        <dd class="small-12 medium-9">
            {% if studentCoach.getId() %}
                <a href="{{ session.mailhandle }}{{ studentCoach.getEmail() }}">{{ studentCoach.formatName() }}</a>
            {% else %}
                {{ studentCoach.formatName() }}
            {% endif %}
        </dd>
    {% endif %}
{% endblock details_coach %}

{% block details_tutorGroup %}
{% if showClasses %}
    {% if externalUser.StudentTutorDescription %}
    <dt class="small-12 medium-3">Circle Class:</dt>
    <dd class="small-12 medium-9">{{ externalUser.StudentTutorDescription }}</dd>
    {% endif %}

    {% if externalUser.StudentFormStaffName %}
    <dt class="small-12 medium-3">Circle Teacher:</dt>
    <dd class="small-12 medium-9">{{ externalUser.StudentFormStaffName }}</dd>
    {% endif %}
{% endif %}
{% endblock details_tutorGroup %}