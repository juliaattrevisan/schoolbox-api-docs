{% extends '@core/user/student.twig' %}


{% block details_yearLevel %}
    {# SA-12418 / SA-12495#}
    {% if user.year.name is defined %}
        <dt class="small-4 medium-3 columns">School:</dt>
        <dd class="small-8 medium-9 columns">{{  user.year.name }}</dd>
    {% endif %}
{% endblock details_yearLevel %}

{% block details_house %}
    {# SA-12418 / SA-12495#}
    {% if user.schoolhouse.house is defined %}
        <dt class="small-4 medium-3 columns">Hub:</dt>
        <dd class="small-8 medium-9 columns">{{ user.schoolhouse.house }}</dd>
    {% endif %}
{% endblock details_house %}
