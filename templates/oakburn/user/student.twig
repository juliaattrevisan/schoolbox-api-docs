{% extends '@core/user/student.twig' %}

{% block details_studiesCode %}
    {% if externalUser.StudentStudiesCode %}
    <dt class="no-margin small-6 medium-3">Studies Code:</dt>
    <dd class="no-margin small-6 medium-9">{{ externalUser.StudentStudiesCode }}</dd>
    {% endif %}
{% endblock details_studiesCode %}

{% block buttons_dueWork %}
    {% if not (config.restrict_parent_duework_access and session.user.isParent()) %}
        <li class="no-pad">
            <a href="/submission/dueWork/0/{{ user.getId() }}"
               class="no-margin fat button icon-fat icon-32 icon-due-work"
            >Tasks/Assessments Due</a>
        </li>
    {% endif %}
{% endblock buttons_dueWork %}

{% block buttons_grades %}
    {% if not (config.restrict_parent_grades and session.user.isParent()) %}
        <li class="no-pad">
            <a href="/submission/allWork/{{ user.getId() }}"
               class="no-margin fat button icon-fat icon-32 icon-tick"
            >Assessments</a>
        </li>
    {% endif %}
{% endblock buttons_grades %}