{% extends '@core/user/student.twig' %}

{% block details_studentForm %}
    {% if showClasses %}
        {% if externalUser.StudentForm %}
            <dt class="small-12 medium-3">Tutor Group</dt>
            <dd class="small-12 medium-9">{{ externalUser.StudentForm }}</dd>
        {% endif %}
    {% endif %}
{% endblock details_studentForm %}

{% block details_studiesCode %}
    {% if externalUser.StudentStudiesCode %}
    <dt class="small-12 medium-3">TASC Code:</dt>
    <dd class="small-12 medium-9">{{ externalUser.StudentStudiesCode }}</dd>
    {% endif %}
{% endblock details_studiesCode %}

{% block buttons_dueWork %}
    {% if not (config.restrict_parent_duework_access and session.user.isParent()) %}
        <li>
            <a href="/learning/due/{{ user.getId() }}" class="icon-due-work">Tasks/Assessments Due</a>
        </li>
    {% endif %}
{% endblock buttons_dueWork %}

{% block buttons_grades %}
    {% if not (config.restrict_parent_grades and session.user.isParent()) %}
        <li>
            <a href="/learning/grades/{{ user.getId() }}" class="icon-tick">Assessments</a>
        </li>
    {% endif %}
{% endblock buttons_grades %}