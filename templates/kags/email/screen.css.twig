/* This file is subject to Twig, beware the {{ vars }} */
/* use classes, don't use id's */

/* will be truncated by mail clients, but we use it for styling */
body {
    margin: 0;
}

table {
    border-spacing: 0;
    border-width: 0;
    border-collapse: collapse;
}
td {
    padding: 0;
    font-family: Arial, sans-serif;
    font-size: 13px;
}
a {
    text-decoration: none;
    color: {{ colours.link }};
}
a[href] {
    text-decoration: underline;
}

img {
    display: block;
}

.wrap {
    width: 100%;
}

.inner-wrap {
    background-color: {{ colours.body_background }};
    width: 100%;
}

.header, .footer {
    width: 100%;
}

.header {
    background-color: {{ colours.body_background }};
}

.header img {
    color: {{ colours.banner_color }}
}

.content {
    background-color: {{ colours.content_background }};
}

.content a {
    color: {{ colours.link }};
}
.content p {
    line-height: 20px;
    font-size: 13px;
    margin: 0;
}

tr.dark {
    background-color: {{ colours.dark }};
}

.content .heading {
    line-height: 36px;
    font-weight: bold;
    font-size: 18px;
    color: {{ colours.black }};
    {#background: {{ colours.module_background }};#}
}

.content a.cta {
    background-color: {{ colours.submit_btn }};
    padding: 4px 8px 6px;
    text-decoration: none;
    color: {{ colours.white }};
}

.content a.title {
    line-height: 24px;
    font-weight: bold;
    font-size: 16px;
    text-decoration: none;
}

.content em {
    color: {{ colours.dgrey }}
}

.footer p {
    color: {{ colours.white }};
    font-family: Arial, sans-serif;
    font-size: 11px;
    line-height: 18px;
    text-align: right;
    margin: 0; {# ignored by 50% of mail clients #}
}

.footer a {
    color: {{ colours.white }};
    text-decoration: underline;
}

tr.underline td, td.underline {
    border-bottom: solid 1px {{ colours.border_color }};
}


{# module specifics #}
.work-month, .work-day {
    text-align: center;
    border: solid 2px {{ colours.black }};
}
.work-month {
    text-transform: uppercase;
    font-size: 12px;
    background-color: {{ colours.black }};
    color: {{ colours.white }};
    border-bottom: solid 1px #fff;
}

.work-day {
    font-size: 22px;
    line-height: 35px;
    color: {{ colours.link }};
    background-color: {{ colours.content_background }};
}

