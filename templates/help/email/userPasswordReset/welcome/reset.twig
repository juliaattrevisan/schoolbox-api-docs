{% import 'macro/spacer.twig' as fn %}

{% extends 'schoolmail.twig' %}
{% block content %}
    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
        <tr>{{ fn.spacer(config.fqdn, 16, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Dear {{ user.firstName }},</p>
                <p>Your school has added you to <a href="https://help.schoolbox.com.au/login/" title="Schoolbox Help">Schoolbox Help</a></p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Schoolbox Help is designed to support your learning journey in Schoolbox. There are step-by-step guides,
                    information about the latest features and a 'Teacher Course' where you develop your skills and have
                    feedback provided by the Schoolbox teachers!</p>
                <p>On Schoolbox Help, you also have the ability to engage in the community. You can post ideas and feature
                    suggestions, ask or answer questions and collaborate with other staff, sharing best practice ideas!</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Your username is <strong>{{ user.username }}</strong> and you can <a href="http://{{ config.fqdn }}/passwordReset/{{ reset.token }}" title="Create Password">
                        click here
                    </a> to create a password
                </p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>We look forward to you engaging with Schoolbox Help and our fabulous Schoolbox community!</p>
                <p>The Schoolbox Team</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 16, 0, 2) }}</tr>
    </table>
{% endblock %}
