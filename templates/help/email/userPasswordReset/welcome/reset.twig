{% import 'macro/spacer.twig' as fn %}

{% extends 'schoolmail.twig' %}
{% block content %}
    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 16, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Dear {{ user.givenName }},</p>
                <p>Your school has added you to Schoolbox Help.</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Schoolbox Help is designed to support your learning journey in Schoolbox. There are step-by-step guides and information about the latest features.
                On Schoolbox Help, you also have the ability to engage in the community. You can post feature suggestions, ask or answer questions and collaborate with other staff.</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>If your school has subscribed to the Online Learning Course (OLC), you will be able to develop your skills and receive targeted feedback from the Schoolbox Team.
                Navigate to the 'My Groups' icon in your Top Menu within Schoolbox Help to view any OLC units for which you have been enrolled.</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Your username is <strong>{{ user.username }}</strong> and you can <a href="http://{{ config.fqdn }}/passwordReset/{{ reset.token }}" title="Create Password">
                        click here
                    </a> to create a password
                </p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>We look forward to you engaging with Schoolbox Help and our Schoolbox community!</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>The Schoolbox Team</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 16, 0, 2) }}</tr>
    </table>
{% endblock %}
