{% import 'macro/spacer.twig' as fn %}

{% extends 'schoolmail.twig' %}
{% block content %}
    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
        <tr>{{ fn.spacer(config.fqdn, 16, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Dear {{ user.firstName }},</p>
                <p>Your school has signed you up to Schoolbox Help, a one-stop-shop to help you make the most of Schoolbox.</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>In Schoolbox Help you can:</p>
                <ul>
                    <li>
                        Learn more about how to maximise your Schoolbox experience with the Teacher Course. The Teacher
                        Course is mapped against the Australian and New Zealand Professional Standards for Teachers and
                        can therefore be logged as PD hours!
                    </li>
                    <li>
                        Suggest features in our ideas forum and have your say in shaping Schoolbox
                    </li>
                    <li>
                        Be inspired in community forums and share best practice ideas with other schools
                    </li>
                    <li>
                        Collaborate &amp; communicate with people in your state, or make connections with schools in other
                        areas to visit, through state-based user groups
                    </li>
                    <li>
                        Ask or find the answers to your questions in our forums
                    </li>
                    <li>
                        Access step-by-step guides and information about how to do different things in our docs section
                    </li>
                </ul>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Your username to access Schoolbox Help is <strong>{{ user.username }}</strong></p>
                <p>
                    <a href="http://{{ config.fqdn|e('html_attr') }}/passwordReset/{{ reset.token|e('html_attr') }}">
                        Click here to set your password and access Schoolbox Help now!
                    </a>
                </p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>
                    (The link above will expire on {{ reset.expiry.long }}. After that time, you can still set your
                    password by clicking the forgotten password link on the login page.)
                </p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 16, 0, 2) }}</tr>
    </table>
{% endblock %}
