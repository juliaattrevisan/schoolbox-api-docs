{% import 'macro/spacer.twig' as fn %}

{% extends 'schoolmail.twig' %}
{% block content %}
    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 16, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Dear {{ user.givenName }},</p>
                <p>Your school has signed you up to Schoolbox Help, a one-stop-shop to help you make the most of Schoolbox.</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Schoolbox Help is designed to support your learning journey in Schoolbox. There are step-by-step guides and information about the latest features.
                On Schoolbox Help, you also have the ability to engage in the community. You can post feature suggestions, ask or answer questions and collaborate with other staff.</p>
                <p>And if your school has subscribed to the Teacher Course, you will be able to develop your skills and receive targeted feedback from the Schoolbox Team.</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Your username to access Schoolbox Help is <strong>{{ user.username }}</strong></p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 16, 0, 2) }}</tr>
    </table>
{% endblock %}
