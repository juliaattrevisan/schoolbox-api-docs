<?xml version="1.0" ?>
<quiz>
    <version>16.5</version>
    <title>{ASSESS_TITLE}</title>
    <description><![CDATA[
        {ASSESS_DESCRIPTION}
        ]]></description>
    <completionmessage><![CDATA[
        {ASSESS_COMPLETION_MESSAGE}
        ]]></completionmessage>
    <start>{ASSESS_START}</start>
    <finish>{ASSESS_FINISH}</finish>
    <maxattempts>{ASSESS_MAX_ATTEMPTS}</maxattempts>
    <availability>{ASSESS_AVAILABILITY}</availability>
    <anonymousresult>{ASSESS_ANONYMOUS_RESULT}</anonymousresult>
    <notifyauthor>{ASSESS_NOTIFY_AUTHOR}</notifyauthor>
    <!-- BEGIN section -->
    <section>
        <title>{SECTION_TITLE}</title>
        <description><![CDATA[
            {SECTION_DESCRIPTION}
        ]]>
        </description>
        <!-- BEGIN question -->
        <question type="{QUESTION_TYPE_MOODLE}">
            <typeid>{QUESTION_TYPE_ID}</typeid>
            <marks>{QUESTION_MARKS}</marks>
            <name>
                <text>{QUESTION_MARKS} marks</text>
            </name>
            <configs>
                <!-- BEGIN answer_configuration -->
                <config>
                    <name>{ANSWER_CONFIGURATION_NAME}</name>
                    <value>{ANSWER_CONFIGURATION_VALUE}</value>
                </config>
                <!-- END answer_configuration -->
            </configs>
            <questiontext format="html">
                <text><![CDATA[
                    {QUESTION_QUESTION}
                    ]]>
                </text>
            </questiontext>
            <penalty>1</penalty>
            <answers>
                <!-- BEGIN answerInputs -->
                <!-- END answerInputs -->
            </answers>
        </question>
        <!-- END question -->
    </section>
    <!-- END section -->
</quiz>
