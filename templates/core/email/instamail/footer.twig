<tr bgcolor="{{ colours.body_background }}">
  <td colspan="3" valign="top" height="16"><img src="{{ spacer }}" height="{{ config.padding * 2}}" width="1" border="0" /></td>
</tr>
<tr bgcolor="{{ colours.body_background }}">
  <td width="{{ config.padding * 2}}" valign="top"><img src="{{ spacer }}" height="1" width="{{ config.padding * 2}}" border="0" /></td>
  <td width="608" valign="top">
    <p style="font-family:sans-serif;font-size:13px;line-height:16px;color:{{ colours.footer_links }};margin:0">
      &copy; {{ config.year }}
      <a href="http://{{ config.site_domain }}" style="color:{{ colours.footer_links }};text-decoration:underline;">{{ config.title }}</a> |
      <a href="http://{{ config.site_domain }}/policy.php" style="color:{{ colours.footer_links }};text-decoration:underline;">Guidelines of use and Privacy Policy</a> |
      <a href="http://{{ config.site_domain }}/feedback.php" style="color:{{ colours.footer_links }};text-decoration:underline;">Support and Feeback</a>
    </p>
  </td>
  <td width="{{ config.padding * 2}}" valign="top"><img src="{{ spacer }}" height="1" width="{{ config.padding * 2}}" border="0" /></td>
</tr>
<tr bgcolor="{{ colours.body_background }}">
  <td colspan="3" valign="top" height="{{ config.padding }}"><img src="{{ spacer }}" height="{{ config.padding }}" width="1" border="0" /></td>
</tr>
