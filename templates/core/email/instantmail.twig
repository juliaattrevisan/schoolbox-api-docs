{% import 'macro/spacer.twig' as fn %}

{% extends 'schoolmail.twig' %}

{% block content %}
    {# dig into the context #}
    {% set ns = groups|first %}
    {% set row = ns.rows|first %}
    {% set msg = row.messages|first %}

    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
    <tr>{{ fn.spacer(config.fqdn, 16, 0) }}</tr>
    <tr>
        <td width="640" colspan="2">
            <p>Hi {{ recipient }},</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    <tr>
        {% if msg.icon %}
        <td width="48" height="48" valign="top">
            <table>
                <tr>
                    <td><img src="{{ msg.icon }}" width="32" height="32" /></td>
                    {{ fn.spacer(config.fqdn, 0, 16) }}
                </tr>
            </table>
        </td>
        {% else %}
        {{ fn.spacer(config.fqdn, 36, 0, 2) }}
        {% endif %}
        <td valign="middle">
            <table>
                <tr>
                    {# raw HTML NOT sanctioned - this should never be HTML, so it shouldn't be necessary #}
                    <td>{{ msg.title | raw }}</td>
                </tr>
                {% if msg.meta %}
                <tr class="underline">{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
                <tr>{{ fn.spacer(config.fqdn, 4, 0) }}</tr>
                <tr>
                    <td>
                        <p>
                            {# raw HTML NOT sanctioned - this should never be HTML, so it shouldn't be necessary #}
                            <em>{{ msg.meta.byline | raw }}</em>
                        </p>
                    </td>
                </tr>
                    <td>
                        {% if msg.meta.blurb %}
                            {{ msg.meta.blurb | purifyAbsoluteUri('https://'~config.fqdn) }}
                        {% else %}
                            <p>{{ msg.meta.body | cutSentence(300, true) }}</p>
                        {% endif %}
                    </td>
                {% endif %}
            </table>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 24, 0, 2) }}</tr>
    <tr>
        <td width="640" colspan="2">
          <a class="cta" href="{{ msg.href }}">View in {{ config.title }}</a>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 16, 0, 2) }}</tr>
</table>
{% endblock %}
