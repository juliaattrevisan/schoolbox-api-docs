{# This file is subject to Twig, beware the {{ vars }} #}
{# use classes, don't use id's #}

{# will be truncated by mail clients, but we use it for styling #}
body {
    margin: 0;
}

table {
    border-spacing: 0;
    border-width: 0;
    border-collapse: collapse;
}

td {
    padding: 0;
    font-family: Arial, sans-serif;
    font-size: 13px;
}

a {
    text-decoration: none;
}

em {
    color: #9a9a9a;
}

img {
    display: block;
}

.wrap {
    width: 100%;
}

.inner-wrap {
    background-color: #EDEDED;
    width: 100%;
}

.header, .footer {
    width: 100%;
}

.header {
    background-color: {{ colours.skin_colour_navigation_background }};
}

.header img {
    color: {{ colours.skin_colour_offcanvas_background }}
}

.island {
    background-color: #fff;
    width: 100%;
}

.island > td:first-child {
    padding: 16px 0 16px 16px;
}

.island > td {
    padding: 16px;
}

.content a {
    color: {{ colours.skin_colour_content_ui_foreground }};
}

.content p {
    line-height: 20px;
    font-size: 13px;
    margin-bottom: 8px;
    margin-top: 0;
}

.content .heading {
    line-height: 36px;
    font-size: 18px;
    color: #9a9a9a;
    text-transform: uppercase;
}

.content a.cta {
    background-color: {{ colours.skin_colour_content_ui_submit_background }};
    padding: 4px 8px 6px;
    text-decoration: none;
    color: {{ colours.skin_colour_content_ui_submit_foreground }};
}

.content .title {
    line-height: 24px;
    font-size: 16px;
    text-decoration: none;
    margin-bottom: 8px;
}

.footer td {
    padding: 16px 0;
}

.footer p {
    color: #9a9a9a;
    font-family: Arial, sans-serif;
    font-size: 11px;
    line-height: 18px;
    margin: 0; {# ignored by 50% of mail clients #}
}

.footer a {
    color: #9a9a9a;
    text-decoration: underline;
}

tr.underline td, td.underline {
    border-bottom: solid 1px {{ colours.skin_colour_navigation_background }};
}

{# module specifics #}
.work-month, .work-day {
    text-align: center;
    border: solid 2px {{ colours.skin_colour_navigation_background }};
}

.work-month {
    text-transform: uppercase;
    font-size: 12px;
    background-color: {{ colours.skin_colour_navigation_background }};
    color: {{ colours.skin_colour_navigation_foreground }};
    border-bottom: solid 1px #fff;
}

.work-day {
    font-size: 22px;
    line-height: 35px;
    color: {{ colours.skin_colour_navigation_background }};
    background-color: #fff;
}
