{# This file is subject to Twig, beware the {{ vars }} #}
{# use classes, don't use id's #}

{# will be truncated by mail clients, but we use it for styling #}
body {
    background-color: #EDEDED;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Droid Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

table {
    border-spacing: 0;
    border-width: 0;
}

table.fullwidth {
    border-collapse: separate;
    border-radius: {{ skinConfig.skin_container_corner_radius }};
    overflow: hidden;
}

td {
    padding: 0;
    font-size: 14px;
}

h1 {
    font-size: 28px;
    font-weight: normal;
}

a {
    text-decoration: none;
}

em {
    color: #525252;
}

img {
    display: block;
}

a img {
    border-radius: {{ skinConfig.skin_field_corner_radius }};
    height: auto;
    width: 100%;
}

.wrap {
    width: 100%;
}

.inner-wrap {
    background-color: #EDEDED;
    width: 100%;
}

.header, .footer {
    width: 100%;
}

.header {
    background-color: {{ skinConfig.skin_colour_menu_background }};
}

.header img {
    color: {{ skinConfig.skin_colour_menu_foreground }};
    height: auto;
    max-height: 100px;
    max-width: 670px;
}

.island {
    background-color: #fff;
    border-bottom: 1px solid #dcdcdc;
}

.island > td:first-child {
    padding: 16px 0 16px 16px;
}

.island > td,
.island.padding > td {
    padding: 16px;
}

.content a {
    color: {{ skinConfig.skin_colour_accent }};
}

.content p {
    line-height: 20px;
    font-size: 14px;
    margin-bottom: 8px;
    margin-top: 4px;
}

.content .heading {
    line-height: 36px;
    font-size: 20px;
    color: #000;
}

.content a.cta {
    background-color: {{ skinConfig.skin_colour_accent }};
    color: {{ skinConfig.skin_colour_accent_text }};
    padding: 8px 16px;
    font-size: 16px;
    font-weight: normal;
    display: block;
    text-align: center;
    text-decoration: none;
}

.content .title {
    line-height: 24px;
    font-size: 16px;
    text-decoration: none;
    margin-bottom: 8px;
}

.more {
    text-transform: uppercase;
}

.footer td {
    padding: 16px 0;
}

.footer p {
    color: #525252;
    font-family: Arial, sans-serif;
    font-size: 13px;
    line-height: 18px;
    margin: 0; {# ignored by 50% of mail clients #}
}

.footer a {
    color: #525252;
    text-decoration: underline;
}

tr.underline td, td.underline {
    border-bottom: solid 1px #dcdcdc;
}

{# module specifics #}
.work-month, .work-day {
    text-align: center;
    border: solid 2px #dcdcdc;
}

.work-month {
    text-transform: uppercase;
    font-size: 12px;
    background-color: #f4f2f2;
    color: #525252;
    border-bottom: solid 1px #fff;
}

.work-day {
    font-size: 22px;
    line-height: 35px;
    color: #000;
    background-color: #fff;
}

@media screen and (max-width: 730px) {
    .fullwidth {
        width: 100% !important;
    }
    h1, .heading, .footer p {
        padding-left: 16px !important;
    }
    .header img {
        margin-left: 16px;
    }
}
