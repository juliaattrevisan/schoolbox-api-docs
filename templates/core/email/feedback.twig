{% extends 'schoolmail.twig' %}
{% block content %}
    {# dig into the context #}
    {% set ns = groups|first %}
    {% set row = ns.rows|first %}
    {% set msg = row.messages|first %}

    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
    <tr>{{ fn.spacer(config.fqdn, 16, 0) }}</tr>
    <tr>
        <td width="640">
            <p style='font-weight:bold'>{{ config.title }} Feedback</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    <tr>
        <td width="640">
            <p>The following was submitted using the {{ config.title }} feedback form.</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    <tr>
        <td width="640">
            <p>Name: {{ NAME }}</p>
	    <p>Email: {{ EMAIL }}</p>
	    <p>Subject: {{ SUBJECT }}</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    <tr>
        <td width="640">
	    <p>Message:<br>{{ MESSAGE }}</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 16, 0, 2) }}</tr>
</table>
{% endblock %}
