{% import 'macro/spacer.twig' as fn %}

{% extends 'schoolmail.twig' %}
{% block content %}
<table cellpadding="0" cellspacing="0" border="0" align="center" width="100%" class="fullwidth">
    <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 16, 0, 2) }}</tr>
    <tr class="heading">
        <td class="heading" valign="middle" height="32">{{ config.title }} Feedback</td>
    </tr>
    <tr class="island padding">
        <td width="670">
            <p>The following was submitted using the {{ config.title }} feedback form.</p>
            <p><b>Name:</b> {{ NAME }}</p>
            <p><b>Email:</b> {{ EMAIL }}</p>
            <p><b>Subject:</b> {{ SUBJECT }}</p>
        </td>
    </tr>
    <tr class="island padding">
        <td width="670">
            <p><b>Message:</b><br>{{ MESSAGE | nl2br }}</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 16, 0, 2) }}</tr>
</table>
{% endblock %}
