<tr class="island">
    <td width="50" height="50" valign="top" class="column-container">
        <table>
            <tr>
                <td>
                    {% block image %}
                    {# leave an empty space of appropriate size #}
                    {% endblock %}
                </td>
            </tr>
        </table>
    </td>
    <td valign="middle" class="column-container">
        <table width="100%">
            <tr>
                <td>
                    {% block pretty %}
                    <!-- NO HEADING -->
                    {% endblock %}
                </td>
            </tr>
            {% block meta %}

            {% endblock %}
        </table>
    </td>
</tr>