<tr class="{{ loop.index is even ? 'dark' : '' }}">{{ fn.spacer(12, 0, 4) }}</tr>
<tr class="{{ loop.index is even ? 'dark' : '' }}">
    <td width="64" height="56" valign="top">
        <table>
            <tr>
                {{ fn.spacer(0, 8) }}
                <td>
                    {% block image %}
                    {# leave an empty space of appropriate size #}
                    {{ fn.spacer(56, 56) }}
                    {% endblock %}
                </td>
            </tr>
        </table>
    </td>
    {{ fn.spacer(0, 8) }}
    <td valign="middle">
        <table width="100%">
            <tr>
                <td>
                    {% block pretty %}
                    <!-- NO HEADING -->
                    {% endblock %}
                </td>
            </tr>
            {% block meta %}
                <tr class="underline">{{ fn.spacer(8, 0) }}</tr>
                <tr>{{ fn.spacer(4, 0) }}</tr>
            {% endblock %}
        </table>
    </td>
    {{ fn.spacer(0, 8) }}
</tr>
<tr class="{{ loop.index is even ? 'dark' : '' }}">{{ fn.spacer(12, 0, 4) }}</tr>

