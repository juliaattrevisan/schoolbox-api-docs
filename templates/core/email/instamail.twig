<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
{% set spacer = "http://#{config.site_domain}/images/emails/spacer.gif" %}
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{ config.subject }}</title>
</head>
<body style="margin:0;">
  <table cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
      <td>
        <table cellpadding="0" cellspacing="0" border="0" align="center" width="640">
          {% include 'instamail/header.twig' %}
          <tr>
            <td width="16" valign="top" bgcolor="{{ colours.content_background }}"></td>
            <td width="608" valign="top" bgcolor="{{ colours.content_background }}">
              {# content here #}
              <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
              {% for msg in messages %}
                  <tr><td valign="top" height="{{ config.padding }}"><img src="{{ spacer }}" height="{{ config.padding }}" width="1" border="0" /></td></tr>
                <tr>
                  <td width="640">
                    {{ msg.text | raw }}
                  </td>
                </tr>
                  <tr><td valign="top" height="24"><img src="{{ spacer }}" height="24" width="1" border="0" /></td></tr>
                  <tr>
                    <td>
                      <a bgcolor="{{ colours.submit_btn }}" style="background:{{ colours.submit_btn }};padding:4px 8px 6px;text-decoration:none;color:{{ colours.white }};" href="{{ msg.href }}">View in {{ config.title }}</a>
                    </td>
                  </tr>
                  <tr><td valign="top" height="{{ config.padding }}"><img src="{{ spacer }}" height="{{ config.padding }}" width="1" border="0" /></td></tr>
              {% endfor %}
              </table>
              {# end content here #}
            </td>
            <td width="16" valign="top" bgcolor="{{ colours.content_background }}"></td>
          </tr>
          {% include 'instamail/footer.twig' %}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>