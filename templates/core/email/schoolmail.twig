<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{{ config.subject }}</title>
    <style type="text/css">
        {% include 'screen.css.twig' %}
    </style>
</head>
<body>

{# "full-width" wrapper #}
<table class="wrap">
    <tr>
        <td>
            <table class="inner-wrap">
                <tr{# header #} height="100">
                    <td class="header">
                        <table align="center" width="670">
                            {% include 'schoolmail/header.twig' %}
                        </table>
                    </td>
                </tr>
                <tr{# content #}>
                    <td class="content">
                        <table align="center" width="670">
                            <tr>
                                <td>
                                {% block content %}
                                    <!-- NO CONTENT -->
                                {% endblock %}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr{# footer #}>
                    <td class="footer" width="670">
                        <table align="center" width="670">
                            {% include 'schoolmail/footer.twig' %}
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

</body>
</html>
