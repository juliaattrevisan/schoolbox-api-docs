{% import 'macro/spacer.twig' as fn %}

{% extends 'schoolmail.twig' %}
{% block content %}
    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
        <tr>{{ fn.spacer(config.fqdn, 16, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Hi {{ user.firstName }},</p>
                <h1>Welcome to {{ config.title }}!</h1>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>
                    You have requested a password reset for your
                    account on <a href="http://{{ config.fqdn|e('html_attr') }}/">{{ config.title }}</a>,
                    but users in the {{ user.role.name }} role may not reset their password.
                    Please contact your <a href="http://{{ config.fqdn|e('html_attr') }}/">{{ config.title }}</a>
                    systems administrator.
                </p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>
                    If you did not request a password reset, please ignore this email.
                </p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn, 16, 0, 2) }}</tr>
    </table>
{% endblock %}
