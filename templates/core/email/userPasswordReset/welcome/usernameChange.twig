{% import 'macro/spacer.twig' as fn %}

{% extends 'schoolmail.twig' %}
{% block content %}
    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 16, 0) }}</tr>
        <tr>
            <td width="640">
                <p>Hi {{ user.givenName }},</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 8, 0) }}</tr>
        <tr>
            <td width="640">
                <p>
                    This is a courtesy email to advise that your username for your account on
                    <a href="http://{{ config.fqdn|e('html_attr') }}/">{{ config.title }}</a> has changed.
                </p>
                <ul>
                    <li><strong>Previous username:</strong> {{ oldUsername }}</li>
                    <li><strong>New username:</strong> {{ user.username }}</li>
                </ul>
                <p>The next time you log in to {{ config.title }} you will need to use your new username.</p>
                <p>Your password has not been changed.</p>
            </td>
        </tr>
        <tr>{{ fn.spacer(config.fqdn_cdn_prefix, 16, 0, 2) }}</tr>
    </table>
{% endblock %}
