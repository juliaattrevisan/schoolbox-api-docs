{% extends "schoolmail/row.twig" %}

{% block image %}
    {% set msg = row.messages | first %}
    <img src="{{ msg.icon }}" width="56" height="56" />
{% endblock %}

{% block pretty %}
    {% set msg = row.messages | first %}
    <strong>{{ msg.pretty | raw }}</strong>
{% endblock %}

{% block meta %}
    {% set msg = row.messages | first %}
    {% if msg.meta %}
    {{ parent() }}
    <tr>
        <td>
            <p>
                <em>
                {% if msg.meta.topic %}
                    {{ msg.meta.topic }} |
                {% endif %}
                    {{ msg.timestamp|date('jS M Y') }} by {{ msg.meta.author }}
                </em>
            </p>
        </td>
    </tr>
    <tr>
        <td><p>{{ msg.meta.abstract | raw }}</p></td>
    </tr>
    {% endif %}
{% endblock %}