{% extends "schoolmail/row.twig" %}

{% block image %}
    {% set msg = row.messages | first %}
    {% if msg.meta.thumb %}
    <a href="{{ msg.href }}">
        <img src="{{ msg.meta.thumb }}" alt="{{ msg.meta.title }}" />
    </a>
    {% endif %}
{% endblock %}

{% block pretty %}
    {% set msg = row.messages | first %}
    {% if msg.meta.title %}
        {% if config.read_more | length %}
            <span class="title">{{ msg.meta.title }}</span>
        {% else %}
            <a href="{{ msg.href }}" class="title">{{ msg.meta.title }}</a>
        {% endif %}
    {% else %}
        {# raw HTML unable to be sanctioned or rejected - I don't know whether this could be HTML or not. #}
        {{ msg.title | raw }}
    {% endif %}
{% endblock %}

{% block meta %}
    {% set msg = row.messages | first %}
    {% if msg.meta %}
    {{ parent() }}
    <tr>
        <td>
            <p>
                <em>
                    {{ msg.meta.byline }}
                </em>
            </p>
        </td>
    </tr>
    <tr>
        <td>
            {% if msg.meta.blurb | length %}
            {# blurb already has a <p> tag #}
            {{ msg.meta.blurb | purifyAbsoluteUri('https://'~config.fqdn) }}
            {% else %}
            <p>{{ msg.meta.body | cutSentence(200, true) }}</p>
            {% endif %}
            {% if config.read_more | length %}
            <a href="{{ msg.href }}" class="more">{{ config.read_more }}</a>
            {% endif %}
        </td>
    </tr>
    {% endif %}
{% endblock %}
