<tr class="island">
    <td width="32" height="32" valign="top">
        <table>
            <tr>
                <td>
                    {% set msg = row.messages | first %}
                    <img src="{{ msg.icon }}" width="32" height="32" />
                </td>

            </tr>
        </table>
    </td>
    <td valign="middle">
        <table width="100%">
            <tr>
                <td>
                    {% set msg = row.messages | first %}
                    {# raw HTML unable to be sanctioned or rejected - I don't know whether this could be HTML or not. #}
                    <p>{{ msg.title | raw }}</p>
                </td>
            </tr>
        </table>
    </td>
</tr>
