{% import 'macro/spacer.twig' as fn %}

<tr class="{{ loop.index is even ? 'dark' : '' }}">{{ fn.spacer(config.fqdn, 8, 0, 4) }}</tr>
<tr class="{{ loop.index is even ? 'dark' : '' }}">
    <td width="64" height="32" valign="top">
        <table>
            <tr>
                {{ fn.spacer(config.fqdn, 0, 32) }}
                <td>
                    {% set msg = row.messages | first %}
                    <img src="{{ msg.icon }}" width="32" height="32" />
                </td>
            </tr>
        </table>
    </td>
    {{ fn.spacer(config.fqdn, 0, 8) }}
    <td valign="middle">
        <table width="100%">
            <tr>
                <td>
                    {% set msg = row.messages | first %}
                    {# raw HTML unable to be sanctioned or rejected - I don't know whether this could be HTML or not. #}
                    <p>{{ msg.title | raw }}</p>
                </td>
            </tr>
        </table>
    </td>
    {{ fn.spacer(config.fqdn, 0, 8) }}
</tr>
<tr class="{{ loop.index is even ? 'dark' : '' }}">{{ fn.spacer(config.fqdn, 8, 0, 4) }}</tr>
