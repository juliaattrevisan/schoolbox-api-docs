{% import 'macro/spacer.twig' as fn %}

{% extends "schoolmail/row.twig" %}

{% block image %}
    {% set msg = row.messages | first %}
    <table width="72" align="center">
        <tr>{{ fn.spacer(config.fqdn, 8, 0, 3) }}</tr>
        <tr>
            {{ fn.spacer(config.fqdn, 0, 8) }}
            <td class="work-month">{{ msg.time|date('M') }}</td>
            {{ fn.spacer(config.fqdn, 0, 8) }}
        </tr>
        <tr>
            {{ fn.spacer(config.fqdn, 0, 8) }}
            <td class="work-day">{{ msg.time|date('j') }}</td>
            {{ fn.spacer(config.fqdn, 0, 8) }}
        </tr>
        {#<tr>{{ fn.spacer(config.fqdn, 8, 0, 3) }}</tr>#}
    </table>
{% endblock %}

{% block pretty %}
    <table>
        <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
        {% for msg in row.messages %}
            <tr>
                {# raw HTML unable to be sanctioned or rejected - I don't know whether this could be HTML or not. #}
                <td><p>{{ msg.title | raw }}</p></td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}

{% block meta %}
    {# no meta #}
{% endblock %}

