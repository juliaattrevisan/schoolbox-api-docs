<h1></h1>
<div class="empty-state">
    <i class="icon-info"></i>
    <h2>Sorry, we are unable to complete this request </h2>

    <p>{{ summary.message|raw }}</p>

    {% if info|length %}
    <p>{{ info }}</p>
    {% endif %}



    {% if url|length %}
    <p class="meta">{{ url }}</p>
    {% endif %}

    {% if outputStackTrace %}
    <p class="meta">
        Error Code {{ code }} "{{ meta.message }}" in file {{ meta.file }} on line {{ meta.line }}
    </p>

    <pre class="content stacktrace">
        {%- spaceless -%}
        {{ stackTrace }}
        {%- endspaceless -%}
    </pre>
    {% endif %}
    <p><br />Issued occured at {{ date.long }}, further information may have been logged</p>
</div>

<div class="row">
    <div class="small-12 island">
        {% include 'common/error/fragment/options.twig' %}
    </div>
</div>


