<h1>Sorry, we are unable to complete this request</h1>

<div class="alert-box alert">{{ summary.getMessage|raw }}</div>

<div class="row">
    <div class="small-12 island">
        <section class="content">
            {% if info|length %}
            <p>{{ info }}</p>
            {% endif %}

            <p class="meta">{{ date.getLocal }}</p>

            {% if url|length %}
            <p class="meta">{{ url }}</p>
            {% endif %}

            <p class="meta">
                {% if outputStackTrace %}
                    Error Code {{ code }} "{{ meta.message }}" in file {{ meta.file }} on line {{ meta.line }}
                {% else %}
                    {{ summary.getMessage|raw }}
                {% endif %}
            </p>
        </section>

        {% include 'common/error/fragment/options.twig' %}
    </div>
</div>


