<div class="row">
    <div class="error-state small-12 columns">
        <section>
            <div class="row">
                <div>
                    {# raw HTML reluctantly sanctioned - this should not be HTML, but maybe some error codes are? #}

                    {% if message is defined %}
                    <h1>
                        {{ message|striptags }}
                    </h1>
                    {% endif %}

                    <h2>Sorry, we are unable to complete this request </h2>

                    {% if url is defined %}
                        <p>{{ url }}</p>
                    {% endif %}

                    {% if info is defined %}
                        <p>{{ info }}</p>
                    {% endif %}

                    <p>Issue occurred at {{ date.long }}, further information may have been logged.</p>

                    <p><a href="javascript:history.back()">&#8592; Go Back</a></p>
                </div>
                <img src="{{ CDN_PREFIX }}/images/core/error-whale.png" alt="error" width="300" />
            </div>
        </div>
    </div>
</div>

{% if outputStackTrace ?? false %}
<div class="row">
    <div class="small-12 island">
        <h2 class="subheader">Stack trace</h2>
        <section class="scrollable">
            <ul class="action-list error-stack-trace">
                <li>
                    <div class="column small-1"><pre>#0 </pre></div>
                    <div class="column small-11">
                        <pre>{{ exceptionClass }}{% if stackTrace.message %}: "{{ stackTrace.message }}"{% endif %}</pre>
                        <pre class="meta">thrown on {{ stackTrace.file }}:{{ stackTrace.line }}</pre>
                    </div>
                </li>
                {% for frame in stackTrace.trace %}
                    <li>
                        <div class="column small-1"><pre>#{{ loop.index }} </pre></div>
                        <div class="column small-11">
                            <pre>{{ frame.class ?? '' }}{{ frame.type ?? '' }}{{ frame.function }}{% if frame.args is defined %}({% for arg in frame.args %}<span>{{ arg|json_encode }}</span>{% if not loop.last %}, {% endif %}{% endfor %});{% endif %}</pre>
                            <pre class="meta">called from {{ frame.file ?? '' }}:{{ frame.line ?? '' }}</pre>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    </div>
</div>
{% endif %}

<div class="row">
    <div class="small-12 island">
        {% include 'common/error/fragment/options.twig' %}
    </div>
</div>
