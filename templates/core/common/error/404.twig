<div class="row">
    <div class="small-12 island">
        <div class="empty-state">
            <img src="{{ CDN_PREFIX }}/images/core/404.png" width="200" alt="Page not found" />
            <h2>Page Not Found</h2>
            <p class="meta">Unfortunately, the page you were trying to retrieve does not exist in this system.</p>
        </div>

        <div class="row">
            <div class="small-12 medium-6 island">
                <h2 class="subheader">Possible Reasons</h2>
                <section class="content">
                    <ul>
                        <li>The link you followed may be out of date and it needs to be updated</li>
                        <li>The system is broken and needs to be fixed</li>
                        <li>You may have typed the url incorrectly</li>
                    </ul>
                </section>
            </div>
            <div class="small-12 medium-6 island">
                {% include 'common/error/fragment/options.twig' %}
            </div>
        </div>
    </div>
</div>
