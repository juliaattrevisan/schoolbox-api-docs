{%- set checkName    = formField ~ '[' ~ rubric.id ~ '][criterion][' ~ crit.id ~ '][on]' -%}
{%- set checkChecked = crit.descriptors|length > 0 -%}
{%- set cellClass    = checkChecked ? '' : 'hide-v' -%}

<th>
    <input type="hidden" name="{{ formField }}[{{ rubric.id }}][criterion][{{ crit.id }}][groupId]" value="{{ group.id }}" />
    <input  id="{{ checkName }}" data-criterion-name="{{ crit.name }}" name="{{ checkName }}" type="checkbox" value="1" {% if checkChecked %}checked="checked"{% endif %} />
    <label for="{{ checkName }}" class="checkbox-label rb-criterion">
        {%- if crit.used -%}
        {{ crit.name | raw }}
        {%- else -%}
            <input type="text" value="{{ crit.name }}" name="{{ formField }}[{{ rubric.id }}][criterion][{{ crit.id }}][name]" />
        {%- endif -%}
    </label>

</th>

{% for levelIndex, level in rubric.levels -%}
    {%- set descriptor = rubric.descriptors[crit.id][level.id] -%}

    <td class="{{ cellClass }}">
        <textarea{% if not checkChecked %} disabled="disabled"{% endif %} placeholder="Descriptor" rows="2" name="{{ formField }}[{{ rubric.id }}][descriptor][{{ crit.id }}][{{ level.id }}][text]">{{ descriptor.text }}</textarea>
        <input{% if not checkChecked %} disabled="disabled"{% endif %} class="rb-value" type="text" placeholder="Points" value="{{ descriptor.value }}" name="{{ formField }}[{{ rubric.id }}][descriptor][{{ crit.id }}][{{ level.id }}][points]" />
    </td>

{%- endfor %}
{% if rubric.levels|length < levelLimit %}
<td class="{{ cellClass }}">&nbsp;</td>
{% endif %}
