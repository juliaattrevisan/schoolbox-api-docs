{%- set checkName    = 'crit[' ~ crit.id ~ '][on]' -%}
{%- set checkChecked = crit.descriptors|length > 0 -%}
{%- set cellClass    = checkChecked ? '' : 'hide-v' -%}

<th>
    <input  id="{{ checkName }}" data-criterion-name="{{ crit.name }}" name="{{ checkName }}" type="checkbox" value="{{ crit.id }}" {% if checkChecked %}checked="checked"{% endif %} />
    <label for="{{ checkName }}" class="checkbox-label rb-criterion">
        {%- if crit.used -%}
        {{ crit.name | raw }}
        {%- else -%}
            <input type="text" value="{{ crit.name }}" />
        {%- endif -%}
    </label>

</th>

{% for levelIndex, level in rubric.levels -%}
    {%- set descriptor = rubric.descriptors[crit.id][level.id] -%}

    <td class="{{ cellClass }}">
        <textarea{% if not checkChecked %} disabled="disabled"{% endif %} placeholder="Descriptor" rows="2">{{ descriptor.text }}</textarea>
        <input{% if not checkChecked %} disabled="disabled"{% endif %} class="rb-value" type="text" placeholder="Points" value="{{ descriptor.value }}" />
    </td>

{%- endfor %}

<td class="{{ cellClass }}">&nbsp;</td>
