{##
 # Curriculum code selector
 #}
<script type="text/javascript">
    // Set up the curriculum code selection
    $(function(){
        $('#curriculum-codes').curriculumSelector({
            value: {{ codeList|json_encode|raw }}
        });
    });
</script>

{# Empty code so that when no code is selected something is actually sent to form.
 # This distinguishes between all codes being cleared and this input not existing at all.
 #}
<input type="hidden" name="curriculumCodes[]" value="" />
<select id="curriculum-codes" name="curriculumCodes[]" multiple></select>

