{##
 # Curriculum code selector
 #
 # @param bool courseManagedReadonly
 #}

<div id="curriculum-selector-container">
    <curriculum-selector
            :is-read-only="{{ courseManagedReadonly ? 'true' : 'false' }}"
            :selected-codes="{{ codeList }}"
            data-endpoint="{{ routeLookup('curriculumApi.getTree') }}"

    />

</div>
<script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/curriculumSelector.js?v={{ config.site_version }}"></script>
