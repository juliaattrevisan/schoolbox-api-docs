{##
 # Curriculum code selector
 #
 # @param bool $courseManagedReadonly   A bool that decides whether settings are managed elsewhere
 # @param ?bool $vueSlot                Whether this is being rendered as a vue slot,
 #                                      if so, the relevant createApp() must have CurriculumSelector included as an available component
 #                                      Otherwise, this will render it as an independent vue app
 # @param bool $hasTabs                 Whether the curriculum code selector should have tabs
 # @param int|null $parentFolderId      The folder ID to use for the current curriculum selector tab
 # @param string|null $formValueName    If provided, becomes the element's name= attribute
 # @param bool|null $includeWithoutCode If provided, passes through to curriculum-selector prop to allow codeless nodes to be selectable
 #}
{% if courseManagedReadonly is not defined %}
    {% set courseManagedReadonly = false %}
{% endif %}

{% if hasTabs is not defined %}
    {% set hasTabs = false %}
{% endif %}

{% set vueSlot = vueSlot ?? null %}
{% if not vueSlot %}
    <div data-cs-container>
{% endif %}
    <curriculum-selector
        {# these props are passed to either the curriculum-selector component, or the slot - which expects the same props #}
        :is-read-only="{{ courseManagedReadonly ? 'true' : 'false' }}"
        :selected-nodes="{{ codeList|json_encode }}"
        data-endpoint="{{ routeLookup('curriculumApi.searchNode') }}"
        :include-children="true"
        :has-tabs="{{ hasTabs ? 'true' : 'false' }}"
        {% if formValueName is defined and formValueName is not null %}form-value-name="{{ formValueName }}"{% endif %}
        {% if parentFolderId is defined and parentFolderId is not null %}:parent-folder-id="{{ parentFolderId }}"{% endif %}
    />
{% if not vueSlot %}
    </div>
    <script src="{{ CDN_PREFIX }}/js/bundle/curriculumSelector.js?v={{ config.site_version }}"></script>
{% endif %}
