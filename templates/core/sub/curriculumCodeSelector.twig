{##
 # Curriculum code selector
 #
 # @param bool courseManagedReadonly
 #}
<script type="text/javascript">
    // Set up the curriculum code selection
    $(function(){
        $('#curriculum-code-select').curriculumSelector({
            value: {{ codeList|json_encode|raw }}
        });
    });
</script>

<select id="curriculum-code-select" name="curriculumCodes[]" multiple {% if courseManagedReadonly %}disabled{% endif %}></select>

{# Synchronous: Empty code so that when no code is selected something is actually sent to form.
 # This distinguishes between all codes being cleared and this input not existing at all.
 # Async: This field MUST be placed after non-empty value.
 #}
<input type="hidden" name="curriculumCodes[]" value="" />

