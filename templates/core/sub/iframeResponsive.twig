{#
    Display a responsive iframe.

    Data:
        'id'       string       The HTML id attribute of the iframe
        'src'      string       The source URL to load into the iframe
#}
<script src="{{ CDN_PREFIX }}/js/iframe/jquery.responsive-iframe.js?v={{ config.site_version }}"></script>
<script type="text/javascript">
    $(function () {

        /**
         * Resize iframe dynamically ("responsively")
         */
        $.fn.responsiveIframe({
            onLoad: resizeViewport,
            onResize: resizeViewport
        });

        /**
         * Resize the iFrame viewport
         */
        function resizeViewport() {
            $('#{{ id }}').height($(window).height() * 0.90);
        }
    });
</script>
<iframe class=""
        id="{{ id }}"
        src="{{ src }}"
        frameborder="0"
        {% if allow | length %}allow="{{ allow }}"{% endif %}
        {% for key, value in dataAttributes %}
            data-{{ key }}="{{ value }}"
        {% endfor %}
></iframe>
