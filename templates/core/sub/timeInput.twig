<input type="text"
       name="{{ name }}[hour]"
       class="date-time"
       value="{{ value is empty ? "" : value|date("h") }}" /> :
<input type="text"
       name="{{ name }}[minute]"
       class="date-time"
       value="{{ value is empty ? "" : value|date("i") }}" />
<select name="{{ name }}[meridien]">
    <option>--</option>
    <option value="am" {% if value is not empty and value|date('A') == 'AM' %}selected{% endif %}>AM</option>
    <option value="pm" {% if value is not empty and value|date('A') == 'PM' %}selected{% endif %}>PM</option>
</select>
