{# Generates the local URL to review an Assessment Response #}
{% macro localUrl(response) -%}

    {%- if response.assessable is quiz -%}
        {% set argList = {assessmentId: response.assessable.id, firstSectionId: response.firstSectionId, responseId: response.id} -%}
        {{ routeLookup('learningQuiz.getQuizResponseFirstSection', argList) }}
    {%- elseif response.assessable is dueWork -%}
        {{ routeLookup('learningResponse.getParticularResponse', {assessmentId: response.assessable.id, studentId: response.submittedOnBehalfOf.id, responseId: response.id, response: response}) }}
    {%- elseif response.assessable is task -%}
        {# no link. Caller should not render a link if assessable is a task #}
    {%- endif -%}
{% endmacro %}

{# Generates the hover title text shown over the link to Review a Student Response #}
{% macro reviewResponseTitle(response) -%}
    {%- if response.assessable is quiz -%}
        Review Quiz Attempt
    {%- elseif response.assessable is dueWork -%}
        Review Student Submission
    {%- elseif response.assessable is task -%}
        Review Task Completion
    {%- endif -%}
{% endmacro %}
