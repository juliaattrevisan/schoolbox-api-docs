{# select.twig
 #
 # Dynamically construct a <select> element with options, whose value and name can be chosen dynamically
 # Assigns preselected value, data vars if applicable
 # Accepts array of arrays, or a set of objects
 # Supplies a readonly and nonselectable "Please Select" option inherently
 #
 # name: the name of the select element
 # preselected: the value that should be initially selected (preselected)
 # options: a collection of objects or an array
 # value: the object method that returns the value e.g. "id", or the array key containing the equivalent
 # label: the object method that returns the name e.g. "name", or the array key containing the equivalent
 # selectData: a set of key-value pairs corresponding to data vars or element attributes
 # showPrompt: a boolean to determine whether to show the "Please Select" option
 #}
<select {{ disabled }} name="{{ name }}"
    {% for dataVar, dataValue in selectData %}
        {{ dataVar }}="{{ dataValue }}"
    {% endfor %}
>
    {% if showPrompt %}
    <option disabled selected="selected" value="">Please Select</option>
    {% endif %}

{% for index, option in options %}

    {% if (value == null or label == null)  %}

        {# If (value, label) was not specified, assume backwards-compatible defaults
         #}
        <option value="{{ index }}" {% if index == preselected %}selected="selected"{% endif %}>
            {{ option }}
        </option>

    {% elseif attribute(option, value) is defined %}

        {# Object method exists; assume a set of objects
         # access their contents using the attribute() method
         #}
        <option value="{{ attribute(option, value) }}" {% if attribute(option, value) == preselected %}selected="selected"{% endif %}>
            {{ attribute(option, label) }}
        </option>

    {% else %}

        {# The (value, label) tuple was specified; access arrays accordingly
         # using the chosen settings
         #}
        <option value="{{ option[value] }}" {% if option[value] == preselected %}selected="selected"{% endif %}>
            {{ option[label] }}
        </option>
    {% endif %}
{% endfor %}
</select>

