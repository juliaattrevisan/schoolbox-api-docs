{# Component content displayed when component uses alt-data-source, and that alt-data-source's folder is soft-deleted #}
<div class="empty-state" data-deleted-source>
    <sbx-icon name="info" size="2.5rem"></sbx-icon>
    {# Note: We show 'denied' before 'deleted' if both are true. Fallback to default if no reason set #}
    {% if isAltSourceDenied %}
        <p>You do not have permission to view this component's data source.</p>
    {% elseif isAltSourceDeleted %}
        <p>The alternative data source this component was using has been deleted.</p>
    {% else %}
        <p>Unable to display component data.</p>
    {% endif %}
    <p>You may either
        <a href="#" title="Remove this Component" data-target="delete">remove this component</a>, or
        <a href="#" title="Select Source" class="edit empty-edit" data-target="settings" data-state="closed">select a new source</a>
    </p>
</div>
