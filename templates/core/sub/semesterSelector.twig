{#
Generic Term (aka Semester) selector.

Usage: include 'sub/semesterSelector.twig
    currentTerm: Term                    - (optional) the current selected Term
    terms:       Collection|Term[]       - all Terms to render in dropdown
    route:       string                  - Aura route
    routeArgs:   JSON object             - Aura route args to be merged with {Term.code} inside loop
#}

<script type="text/javascript">
    $(function() {

        var $semesterSelector = $('#context-selector-semester');
        var $options = $semesterSelector.find('option');

        {# Wire up context selector #}

        $semesterSelector.change(function() {
            window.location.href = $semesterSelector.find(':selected').data('href');
        });

        {# Wire up next/previous term buttons #}

        $("[data-semester-switch]").click(function(e) {
            e.preventDefault();

            var index = $semesterSelector.prop('selectedIndex');
            var newIndex = 'next' == $(this).data('semester-switch') ? index - 1 : index + 1;

            if(newIndex >= 1 && newIndex < $options.length){
                var term = $options.eq(newIndex);
                window.location.href = term.data('href');
            }
        });
    });
</script>

<nav>
    <a data-semester-switch="previous" href="#" {% if currentTerm.code == terms[0].code %}disabled{% endif %}></a>
</nav>
<div class="semester">
    <select id="context-selector-semester" title="Select a Term">
        <option disabled {% if currentTerm is empty %}selected{% endif %} label="Select a term">Select a term</option>
        {% for term in terms %}
            <option data-href="{{ routeLookup(route, routeArgs|merge({termCode: term.code}) ) }}" value="{{ term.code }}" {% if currentTerm.code == term.code %}selected{% endif %}>
                {#- dessicate -#}{{ term.title }} ({{ term.start.dateOnly }} - {{ term.displayFinish.dateOnly }}){#- dessicate -#}
            </option>
        {% endfor %}
    </select>
</div>
<nav>
    <a data-semester-switch="next" href="#" {% if currentTerm.code == terms[terms | length - 1].code %}disabled{% endif %}></a>
</nav>
