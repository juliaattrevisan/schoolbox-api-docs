{#
Generic Term (aka Semester) selector.
Usage: include 'sub/semesterSelector.twig
    currentTerm:        Term                    - (optional) the current selected Term
    terms:              Collection|Term[]       - all Terms to render in dropdown
    termsWithResults:   Collection|Term[]       - (optional) Terms that have results. If provided, used to disable terms in dropdown.
    route:              string                  - Aura route
    routeArgs:          JSON object             - Aura route args to be merged with {Term.code} inside loop
#}

<script type="text/javascript">
    $(function() {
        var $semesterSelector = $('#context-selector-semester');
        var $options = $semesterSelector.find('option');
        {# Wire up context selector #}
        $semesterSelector.change(function () {
            window.location.href = $semesterSelector.find(':selected').data('href');
        });
        {# Wire up next/previous term buttons #}
        $("[data-semester-switch]").click(function (e) {
            e.preventDefault();
            var index = $semesterSelector.prop('selectedIndex');
            var newIndex = 'next' === $(this).data('semester-switch') ? index - 1 : index + 1;
            if (newIndex >= 1 && newIndex < $options.length){
                var term = $options.eq(newIndex);
                window.location.href = term.data('href');
            }
        });
    });
</script>

<nav>
    <a data-semester-switch="previous" href="#" {% if terms is empty or currentTerm.code == (terms|last).code %}disabled{% endif %}></a>
</nav>
<div class="semester">
    <select id="context-selector-semester" title="Select {{ locale.term.indefiniteArticle ~ ' ' ~ locale.term }}">
        <option disabled {% if currentTerm is empty %}selected{% endif %} label="Select {{ locale.term.indefiniteArticle ~ ' ' ~ locale.term }}">Select {{ locale.term.indefiniteArticle ~ ' ' ~ locale.term }} </option>
        {% for term in terms %}
            <option data-href="{{ routeLookup(route, routeArgs|merge({termCode: term.code}) ) }}" value="{{ term.code }}" {% if currentTerm.code == term.code %}selected{% endif %}
                    {% if termsWithResults is defined and term not in termsWithResults %} disabled {% endif %}>
                {#- dessicate -#}
                    {{ term.title }} ({{ term.start.dateOnly }} - {{ term.displayFinish.dateOnly }})
                    {% if termsWithResults is defined and term not in termsWithResults %}
                        (No results)
                    {% endif %}
                {#- dessicate -#}
            </option>
        {% endfor %}
    </select>
</div>
<nav>
    <a data-semester-switch="next" href="#" {% if terms is empty or currentTerm.code == (terms|first).code %}disabled{% endif %}></a>
</nav>
