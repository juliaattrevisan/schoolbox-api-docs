{# usage:
    {% import '@sub/breadcrumbs.twig' as bread  %}
    {{ bread.crumbs([ label, href ], ...) }} # note the variadic nature of this function
#}
{% macro crumbs() %}
    {# preprocess varargs to strip blanks, in lieu of an array_filter |filter #}
    {% set crumbs = [] %}

    {% for i in varargs if i[0] %}
        {% set crumbs = crumbs|merge([ i ]) %}
    {% endfor %}

    <ul class="breadcrumb">
        {% for crumb in crumbs %}
            <li{% if loop.last %} class="active"{% endif %}>
                <a{% if crumb[1] %} href="{{ crumb[1] }}"{% endif %}>{{ crumb[0] }}</a>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{# Basic version of breadcrumbs #}
{% macro basic() %}
    {# preprocess varargs to strip blanks, in lieu of an array_filter |filter #}
    {% set crumbs = [] %}

    {% for i in varargs if i[0] %}
        {% set crumbs = crumbs|merge([ i ]) %}
    {% endfor %}

    <ul class="breadcrumb-basic meta">
        {% for crumb in crumbs %}
            <li{% if loop.last %} class="active"{% endif %}>
                {% if crumb[1] %}
                    <a href="{{ crumb[1] }}">{{ crumb[0] }} {% if not loop.last %}&rsaquo; {% endif %}</a>
                {% else %}
                    {{ crumb[0] }} {% if not loop.last %}&rsaquo; {% endif %}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}
