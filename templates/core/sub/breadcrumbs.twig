{# usage:
    {% import '@sub/breadcrumbs.twig' as bread  %}
    {{ bread.crumbs([ label, href ], ...) }} # note the variadic nature of this function
    {{ bread.crumbsArray([[ label, href ], ...]) }} # note the non-variadic nature of this function
#}

{% macro crumbs() %}
    {% import _self as self %}
    {{ self.crumbsArray(varargs) }}
{% endmacro %}

{% macro crumbsArray(crumbsArray) %}
    {# preprocess crumbsArray to strip blanks, in lieu of an array_filter |filter #}
    {% set crumbs = [] %}

    {% for i in crumbsArray if i[0] %}
        {% set crumbs = crumbs|merge([ i ]) %}
    {% endfor %}

    <ul class="breadcrumb">
        {% for crumb in crumbs %}
            <li{% if loop.last %} class="active"{% endif %}>
                <a{% if crumb[1] ?? false %} href="{{ crumb[1] }}"{% endif %}>{{ crumb[0] }}</a>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{# Basic version of breadcrumbs #}
{% macro basic() %}
    {% import _self as self %}
    {{ self.basicArray(varargs) }}
{% endmacro %}

{% macro basicArray(crumbsArray) %}
    {# preprocess crumbsArray to strip blanks, in lieu of an array_filter |filter #}
    {% set crumbs = [] %}

    {% for i in crumbsArray if i[0] %}
        {% set crumbs = crumbs|merge([ i ]) %}
    {% endfor %}

    <ul class="breadcrumb-basic meta">
        {% for crumb in crumbs %}
            <li{% if loop.last %} class="active"{% endif %}>
                <a{% if crumb[1] ?? false %} href="{{ crumb[1] }}"{% endif %}>{{ crumb[0] }}</a>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}
