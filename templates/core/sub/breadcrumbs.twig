{# usage:
    {% import '@sub/breadcrumbs.twig' as bread  %}
    {{ bread.crumbs([ label, href ], ...) }} # note the variadic nature of this function
    {{ bread.crumbsArray([[ label, href ], ...]) }} # note the non-variadic nature of this function
#}

{% macro crumbs() %}
    {% import _self as self %}
    {{ self.crumbsArray(varargs) }}
{% endmacro %}

{% macro crumbsArray(crumbsArray) %}
    <ul class="breadcrumb">
        {#
         # Must map here, as filter doesn't guarantee an array (which defines loop.last)
         # Alternately, use CSS to apply a style to the last crumb
         #}
        {% for crumb in crumbsArray | filter(i=>i[0]) | map(i=>i) %}
            <li{% if loop.last %} class="active"{% endif %}>
                <a{% if loop.last == false %} href="{{ crumb[1] }}"{% endif %}>{{ crumb[0] }}</a>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{# Basic version of breadcrumbs #}
{% macro basic() %}
    {% import _self as self %}
    {{ self.basicArray(varargs) }}
{% endmacro %}

{% macro basicArray(crumbsArray) %}
    <ul class="breadcrumb-basic meta no-margin">
        {% for crumb in crumbsArray | filter(i=>i[0]) | map(i=>i) %}
            <li{% if loop.last %} class="active"{% endif %}>
                <a{% if crumb[1] ?? false %} href="{{ crumb[1] }}"{% endif %}>{{ crumb[0] }}</a>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}
