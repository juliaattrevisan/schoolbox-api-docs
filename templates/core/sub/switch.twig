<label for="{{ identifier }}">{{ name }}</label>

{% if subtext|length %}
<p>{{ subtext }}.</p>
{% endif %}

<div class="switch">
    <input id="{{ identifier }}" name="{{ identifier }}" type="checkbox" {% if isChecked %}checked{% endif %} value="{{ checkedValue }}">
    <label for="{{ identifier }}">
        <span>On</span>
        <span>Off</span>
    </label>
</div>