{# usage: {% include 'attachzoneTemplate.twig' with {attachzone: $data}  %} where

$data = {
    title: (string),
    id: (string),
    camelId: (string),
    label: (string),
    prompt: (string),
    mime: (string),
    readonly: (bool),
    multi: (bool),
    size: (int),
    mode: (string),
    useModal: (bool),
    capture: (bool),
    iconClass: (?string),
    attachments: [{
        name: (string),
        hash: (string),
        prev: (url)
    }, ...],
    fs: (?string),
    expiryDate: (?string)
}

#}
<div class="attachzone s{{ attachzone.size }}" id="{{ attachzone.id }}-zone">
    <label>{{ attachzone.label }}</label>
    <ul data-dz-previews class="az-list">
        {% for attachment in attachzone.attachments ?? [] %}
        <li class="dz-success {% if not attachzone.readonly %}actions-small-1{% endif %}">
            <div class="list-item">
                <div class="card small-12">
                    <img {% if not attachment.isImage %}class="mime"{% endif %} alt="{{ attachment.name }}" src="{{ attachment.preview }}" />
                    <p class="filename" data-dz-name>
                        <a href="/storage/fetch.php?save=1&hash={{ attachment.hash|split(':')[1] }}" data-plugin="preview">{{ attachment.name }}</a>
                    </p>
                </div>
            </div>
            {% if not attachzone.readonly %}
            <nav>
                <a href="/storage/fetch.php?hash={{ attachment.hash|split(':')[1] }}&save=1" class="icon-download" title="Download"></a>
                <a href="#" data-dz-remove title="Remove" class="icon-delete"></a>
                <input type="hidden" name="{{ attachzone.fileVar }}" value="{{ attachment.hash }}" data-az-attachment />
            </nav>
            {% endif %}
        </li>
        {% endfor %}
    </ul>
    <script type="text/javascript">
        $(function () {
            $('[data-plugin="preview"]').preview();
        });
    </script>
    {% if not attachzone.readonly %}
    <div class="dzone {% if attachzone.mode == 'button' %}button" title="{{ attachzone.prompt | capitalize }}{% endif %}" id="{{ attachzone.camelId }}Zone">
        <ul data-template class="hide">
            <li class="actions-small-1">
                <div class="list-item">
                    <div class="card small-12">
                        <img data-dz-thumbnail src="{{ CDN_PREFIX }}/images/emails/spacer.gif" class="mime" />
                        <p class="filename" data-dz-name></p>
                    </div>
                </div>
                <nav>
                    <a href="#" data-dz-remove title="Remove" class="icon-delete"></a>
                    <input type="hidden" data-az-attachment name="{{ attachzone.fileVar }}" value="" />
                </nav>
                <div class="progress"><span class="meter" style="width:0;" data-dz-uploadprogress></span></div>
            </li>
        </ul>
    </div>
    <ul class="az-error-list"></ul>
        {% autoescape 'js' %}
        <script type="text/javascript">
            $(function () {
                $('#{{ attachzone.id }}-zone').resourceAttach({
                    url: '/storage/asyncUpload.php{% if attachzone.expiryDate is defined %}?expiryDate={{ attachzone.expiryDate | e('url') | e('js') }}{% endif %}',
                    paramName: 'upload',
                    trigger: 'div.dzone',
                    detachSelector: '[data-dz-remove]',
                    dropzoneSelector: 'div.dzone',
                    dictDefaultMessage: {{ (attachzone.mode == 'button' ? 'null' : (attachzone.prompt|json_encode|raw)) }},
                    {# raw HTML reluctantly sanctioned - this should be passed to template as raw, then json_encode|raw #}
                    allowedFiles: {{ attachzone.mime|raw ?: 'null' }},
                    multi: {{ attachzone.multi ? 'true' : 'false' }},
                    title: '{{ attachzone.title }}',
                    thumbnailSize: '{{ attachzone.size }}',
                    fallbackButtonSelector: 'a[data-attach-fallback]',
                    previewsContainerSelector: '[data-dz-previews]',
                    {% if onDetach is defined %}
                    onDetach: {{ onDetach|raw }},
                    {% endif %}
                    useFolder: false,
                    useModal: {{ attachzone.useModal ? 'true' : 'false' }},
                    capture: {{ attachzone.capture ? 'true' : 'false' }},
                    {% if attachzone.iconClass is defined and attachzone.iconClass is not null %}iconClass: '{{ attachzone.iconClass }}',{% endif %}
                    {% if attachzone.fs is defined and attachzone.fs %}fs: '{{ attachzone.fs }}',{% endif %}
                });
            });
        </script>
        {% endautoescape %}
    {% endif %}
</div>
