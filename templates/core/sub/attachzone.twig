{# usage: {% include 'attachzoneTemplate.twig' with {attachzone: $data}  %} where

$data = {
    title: (string),
    id: (string),
    camelId: (string),
    label: (string),
    prompt: (string),
    mime: (string),
    readonly: (bool),
    multi: (bool),
    size: (int),
    attachments: [{
        name: (string),
        hash: (string),
        prev: (url)
    }, ...]
}

#}
<div class="attachzone s{{ attachzone.size }}" id="{{ attachzone.id }}-zone">
    <span class="az-label">{{ attachzone.label }}</span>
    <ul class="az-list">
        {% for attachment in attachzone.attachments %}
        <li class="dz-success">
            {% if not attachzone.readonly %}
            <p class="actions">
                <a href="#" data-dz-remove title="Detach" class="button no-text icon-delete"></a>
            </p>
            <input type="hidden" name="attachment[]" value="{{ attachment.hash }}" data-az-attachment />
            {% endif %}
            <img alt="{{ attachment.name }}" src="{{ attachment.preview }}" />
            <p class="filename" data-dz-name>{{ attachment.name }}</p>
        </li>
        {% endfor %}
    </ul>
    {% if not attachzone.readonly %}
    <ul class="az-error-list"></ul>
    <div class="dzone" id="{{ attachzone.camelId }}Zone">
        <ul data-template>
            <li>
                <div class="dz-progress"><span class="dz-upload" data-dz-uploadprogress></span></div>
                <p class="actions">
                    <a title="Detach" data-dz-remove class="button no-text icon-delete"></a>
                </p>
                <img data-dz-thumbnail src="/images/emails/spacer.gif" />
                <p class="filename" data-dz-name></p>
                <input type="hidden" data-az-attachment name="attachment[]" value="" />
            </li>
        </ul>
    </div>
    <script type="text/javascript">
        $(function () {
            $('#{{ attachzone.id }}-zone').resourceAttach({
                url: '/storage/asyncUpload',
                paramName: 'upload',
                trigger: 'div.dzone',
                dropzoneSelector: 'div.dzone',
                dictDefaultMessage: '{{ attachzone.prompt }}',
                allowedFiles: {{ attachzone.mime|raw ?: 'null' }},
                multi: {{ attachzone.multi ? 'true' : 'false' }},
                title: '{{ attachzone.title }}',
                thumbnailSize: '{{ attachzone.size }}',
                fallbackButtonSelector: 'a[data-attach-fallback]'
            });
        });
    </script>
    {% endif %}
</div>
