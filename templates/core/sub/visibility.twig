{% macro dropdown(selected, availableVisibilities) %}
{% set allOptions = {
    0: 'Staff Only',
    1: 'Staff and Students',
    2: 'Staff, Students and their Parents'
}
%}

{% apply spaceless %}
<div class="c-form-element">
    <label class="c-label">Mark Visibility</label>
    <div class="c-hint">This controls who will be able to view the marks for this assessment (including feedback).</div>
    <select name="visibility">
        {% for currentOption, label in allOptions %}
            <option value="{{ currentOption }}"
                    {% if currentOption == selected %}selected="selected"{% endif %}
                    {% if currentOption not in availableVisibilities %}disabled="disabled"{% endif %}
            >{{ label }}</option>
        {% endfor %}
    </select>
</div>

{% endapply %}
{% endmacro %}
