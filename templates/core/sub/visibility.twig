{% macro dropdown(selected, availableVisibilities) %}
{% set allOptions = {
    0: 'Staff Only',
    1: 'Staff and Students',
    2: 'Staff, Students and their Parents'
}
%}

{% apply spaceless %}
<label>
    Feedback Visibility
    <span data-tooltip class="hint has-tip tip-top"
     title="This controls who can view feedback for this {{ locale.translate('activity', false, false)}}. Feedback can only be shown to roles included in the Activity Audience.">
     ?
    </span>
    <select name="visibility" data-test="assessment-form-select-visibility">
        {% for currentOption, label in allOptions %}
            <option value="{{ currentOption }}"
                    {% if currentOption == selected %}selected="selected"{% endif %}
                    {% if currentOption not in availableVisibilities %}disabled="disabled"{% endif %}
            >{{ label }}</option>
        {% endfor %}
    </select>
</label>

{% endapply %}
{% endmacro %}
