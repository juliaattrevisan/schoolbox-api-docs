{##
 # Paginator
 #
 # Builds a paginator that displays when there are meaningful options
 #
 # @param UrlPaginator paginator
 # @param string class
 # @param int page
 #}

{# Set default page number #}
{% if not page %}
    {% set page = 1 %}
{% endif %}

{% if paginator.pageCount > 1 %}
    <ul class="pagination {{ class is defined ? class : '' }}">
        {# back/forward page links #}
        <li class="arrow {% if page == 1 %}unavailable{% endif %}">
            <a href="{{ paginator.urlForPage(1) }}"
               title="First Page"
               {% if page == 1 %}disabled{% endif %} >«</a></li>
        <li class="arrow {% if page == 1 %}unavailable{% endif %}">
            <a href="{{ paginator.urlForPage(max(page-1, 1)) }}"
               title="Previous Page"
               {% if page == 1 %}disabled{% endif %}>‹</a></li>
        {% for currentPage, url in paginator.pageUrls %}
            <li{% if currentPage == page %} class="active"{% endif %}>
                <a href="{{ url }}" title="Page {{ currentPage }}">{{ currentPage }}</a>
            </li>
        {% endfor %}
        <li class="arrow {% if page == paginator.pageCount %}unavailable{% endif %}">
            <a href="{{ paginator.urlForPage(min(page+1, paginator.pageCount)) }}"
               title="Next Page"
               {% if page == paginator.pageCount %}disabled{% endif %}>›</a></li>
        <li class="arrow {% if page == paginator.pageCount %}unavailable{% endif %}">
            <a href="{{ paginator.urlForPage(paginator.pageCount) }}"
               title="Last Page"
               {% if page == paginator.pageCount %}disabled{% endif %}>»</a></li>
    </ul>
{% endif %}
