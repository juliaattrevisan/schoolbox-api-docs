<div class="timetable-picker" data-interaction="timetableSelector">
<dl class="clearfix" >
    <dt>Campus</dt>
    <dd>
        <select id="timetableCampus" name="timetable[campus]" data-role="campusSelector">
            <option disabled>-- select campus --</option>
            {% for campus in campusList %}
                <option value="{{ campus.id }}"
                        label="{{ campus.name }}"
                        >{{ campus.name }}</option>
            {% endfor %}
        </select>
    </dd>
    <dt>Day</dt>
    <dd>
        <select id="timetableDay" name="timetable[day]" disabled data-role="daySelector">
            <option disabled>-- select day --</option>
        </select>
    </dd>
    <dt>Period</dt>
    <dd>
        <select id="timetablePeriod" name="timetable[period]" disabled data-role="periodSelector">
            <option disabled>-- select period --</option>
        </select>
    </dd>
</dl>
<dl class="clearfix">
    <dt>Date</dt>
    <dd>
        <time data-role="selectedDate" class="clearfix">Please select a campus and day.</time>
        <a data-interaction="previousDate" class="btn go-back no-text float-left" title="Previous" href="#"><span></span></a>
        <a data-interaction="nextDate" class="btn go-to no-text float-left" title="Next" href="#"><span></span></a>
    </dd>
    <dt>Start Time</dt>
    <dd>
        <label>
            {% if select == 'radio' %}
            <input type="radio" name="pickTime" value="start" />
            {% endif %}
            <time data-role="selectedTimeStart">Please select a period.</time>
            {% if select == 'button' %}
            <a href="#"
               class="submit-btn-plain inline-block"
               data-interaction="pickStartTime">Use</a>
            {% endif %}
        </label>
    </dd>
    <dt>End Time</dt>
    <dd>
        <label>
            {% if select == 'radio' %}
            <input type="radio" name="pickTime" value="end" />
            {% endif %}
            <time data-role="selectedTimeEnd">Please select a period.</time>
            {% if select == 'button' %}
            <a href="#"
               class="submit-btn-plain inline-block"
               data-interaction="pickEndTime">Use</a>
            {% endif %}
        </label>
    </dd>
</dl>
</div>