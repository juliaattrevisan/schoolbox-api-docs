{##
 # Display metadata about a list of users.
 #
 # Parameters:
 # users:   users to include in the metadata
 # message: the stump of the message to show in the metadata.
 #          Will be in sentences:
 #          "{{ message }} and {{ users[0] }}"
 #          "{{ message }}, {{ users[0] }} and {{ users[1] }}"
 #          "{{ message }}, {{ users[0] }}, {{ users[1] }} and {{ users|length-2 }} others"
 #          "{{ message }} {{ users|length }} users" in the modal
 #}

{{ message }}

{##
 # Presentation depends on how many others are being shared with.
 # 1-3: just show their names
 # 4+:  show the names of the first 3, and then "and x others"
#}
{% set usersLength = users|length %}
{% if usersLength <= 3 %}
    {% for user in users -%}
        {% if not loop.first %}{{ loop.last ? ' and' : ',' }} {% endif %}<a href="/search/user/{{ user.id }}">{{ user.fullName }}</a>
    {%- endfor %}
{% else %}
    {%- for user in users[0:2] -%}
        {% if not loop.first %}, {% endif %}<a href="/search/user/{{ user.id }}">{{ user.fullName }}</a>
    {%- endfor %}
    and <a href="#" data-reveal-id="all-users">{{ usersLength - 2 }} others</a>

    <div data-reveal id="all-users" class="reveal-modal">
        <h2>{{ message }} {{ users|length }} users</h2>
        <ul class="information-list">
            {% for user in users %}
                <li>
                    <div class="compact card">
                        <a href="/search/user/{{ user.id }}">
                            <img src="/portrait.php?id={{ user.id }}&amp;size=square64">
                            <p>{{ user.fullName }}</p>
                        </a>
                    </div>
                </li>
            {% endfor %}
        </ul>
        <a class="close-reveal-modal" aria-label="Close">×</a>
    </div>
{% endif %}
