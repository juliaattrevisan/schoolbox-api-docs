{#
Generic Subject selector.

Usage: include 'sub/subjectSelector.twig
    currentSubject: Folder               - (optional) the current selected Subject Folder
    subjects:       Collection|Folder[]  - the subjects to render in dropdown
    route:          string               - Aura route
    routeArgs:      JSON object          - Aura route args to be merged with subjectId inside loop
#}

<script type="text/javascript">
    $(function() {

        var $subjectSelector = $('#context-selector-subject');

        {# Wire up context selector #}
        $subjectSelector.change(function() {
            window.location.href = $subjectSelector.find(':selected').data('href');
        });
    });
</script>

{% if year is empty %}
<div class="subject">
    <select id="context-selector-subject" title="Select a {{ locale.class }}">
        <option disabled="" selected="" label="Select a {{ locale.class }}">Select a {{ locale.class }}</option>
        {% for folder in subjects %}
            <option data-href="{{ routeLookup('learningGrades.getGradesForSubject', routeArgs|merge({subjectId: folder.id, subject: folder})) }}" {% if currentSubject is defined and folder.id == currentSubject.id %}selected{% endif %} value="{{ folder.id }}">
                {#- dessicate -#}{{ folder.nameWithCodes }}{#- dessicate -#}
            </option>
        {% endfor %}
    </select>
</div>
{% endif %}
