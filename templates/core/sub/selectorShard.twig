{# Selector Shard
 #
 # Originally:
 # This lets you spawn a Course Selector modal, whose
 # onCourseSelect() callback deals with selection
 #
 # Usage:
    {% include 'sub/selectorShard.twig' with {
            'formLabel':      string,
            'formInputName':  string,
            'formInputValue': mixed,
            'formInputLabel': string,
            'activator':      string,
            'title':          string
        } only
    %}
 #}

{# Manufacture form label
 # Form label, for presentation purposes
 #}
{% if not formLabel|length %}
    {% set formLabel = "{{ locale.faculty.proper }} / {{ locale.class.proper }}" %}
{% endif %}

{# Manufacture input id attribute
 # Modal's selection gets put into this element
 #}
{% if not formInputName|length %}
    {% set formInputName = 'parent' %}
{% endif %}

{# Manufacture modal activator
 # jquery identifier (usually a data var) which spawns modal
 #}
{% if not activator|length %}
    {% set activator = '[data-course-selector]' %}
{% endif %}

{# Manufacture modal activator title attribute
 # Anchor title
 #}
{% if not title|length %}
    {% set title = 'Click to change the {{ locale.faculty }} / {{ locale.class }} this course belongs to' %}
{% endif %}

<label>
    {{ formLabel }}
    <input type="hidden" name="{{ formInputName }}" id="{{ formInputName }}" value="{{ formInputValue }}" />
    <a {{ activator }}
       data-source="{{ formInputName }}"
       href="#"
       class="source-select {{ formInputValue ? 'icon-folder' : '' }}"
       title="{{ title }}">{{ formInputValue ? formInputLabel : '(Click to select)' }}
    </a>
</label>
