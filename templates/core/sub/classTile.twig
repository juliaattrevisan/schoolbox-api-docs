{# Usage:
    {% include 'sub/classTile.twig' with {
        'term':       Term
        'class':      Folder
        'classType':  string
        'courses':    string[] CourseSpec titles indexed by courseSpec.id
    } only %}
#}

{% set tileContent %}
    <div class="card-class-image"
         style="background-color:{{ class.colour }}; border-bottom: 10px solid {{ class.colour }};{% if class.coverImage %} background-image: url('/storage/image.php?hash={{ class.coverImage.hash }}&size=cardImageLarge'); background-size: cover; background-repeat: no-repeat; background-position: center; {% endif %}"></div>
{% endset %}

<div class="v-card small-12">
    {% if homepageUrl %}
        <a href="{{ homepageUrl }}">{{ tileContent }}</a>
    {% else %}
        {{ tileContent }}
    {% endif %}
    <div class="card-content classes actions-small-1">
        <div class="list-item">
            {% if homepageUrl %}
                <h3><a href="{{ homepageUrl }}" title="{{ class.title }}">{{ class.name }}</a></h3>
            {% else %}
                <h3>{{ class.name }}</h3>
            {% endif %}
            <p class="meta">{{ class.codeString }}<br>{{ classType }}</p>
        </div>
        {% if USER.getRole.isStaff == true %}
            <nav>
                <a href="#" class="icon-more" data-dropdown="class-options{{ class.id }}" aria-expanded="false" title="Actions"></a>
            </nav>
            <ul data-dropdown-content class="f-dropdown" id="class-options{{ class.id }}">
                <li><a href="{{ routeLookup('learning.getClassListPage', {folderId: class.id, folder: class}) }}" class="icon-class-list">Class List</a></li>
                {% set classMarkbookRoute = routeLookupIfAuthorized(
                    'learningMarkbook.getMarkbookForClassAndTerm',
                    {folder: class, folderId: class.id, term: term, termCode: term.code})
                %}
                {% if classMarkbookRoute %}<li><a href="{{ classMarkbookRoute }}" class="icon-curriculum">Class Markbook</a></li>{% endif %}
                {% set rubricMarkbookRoute = routeLookupIfAuthorized('rubricMarkbook.getMarkbook', {folder: class, folderId: class.id}) %}
                {% if rubricMarkbookRoute %}<li><a href="{{ rubricMarkbookRoute }}" class="icon-curriculum">Rubric Markbook</a></li>{% endif %}
                {% set badgeAwardRoute = routeLookupIfAuthorized('learningBadgeAward.getListPage', {folder: class, folderId: class.id}) %}
                {% if badgeAwardRoute %}<li><a href="{{ badgeAwardRoute }}" class="icon-achievement">Badge Report</a></li>{% endif %}
                {% set classPastoralRoute = routeLookupIfAuthorized('pastoralClassReportModule.getReport', {folder: class, folderId: class.id}) %}
                {% if classPastoralRoute %}<li><a href="{{ classPastoralRoute }}" class="icon-pastoral">{{ locale.pastoralCare.proper }} Report</a></li>{% endif %}
                <li><a href="{{ routeLookup('folder.getFolderModify', {id: class.id}) }}" class="icon-modify">Modify</a></li>
                {% set routes = {} %}
                {% set intellischoolRoute = routeLookupIfAuthorized('intellischool.getClassAnalytics', {folderId: class.id}) %}
                {% if courses | length %}
                    {% for courseSpecId, courseSpecTitle in courses %}
                        {# get the route for analytics #}
                        {% set url = routeLookup('learningAnalytics.folderWithTerm', {courseSpecId: courseSpecId, folderId: class.id, termCode: term.code}) %}
                        {# check if url is filled (the url is possibly not available, due to the schoolbox plan) #}
                        {% if url %}
                            {% set routes = routes|merge({(loop.index0) : {'title' : courseSpecTitle, 'url' : url}}) %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
                {% if routes or intellischoolRoute %}
                    <li class="separator">Analytics</li>
                    {% for route in routes %}
                        <li><a href="{{ route.url }}" class="icon-poll">{{ route.title }}</a></li>
                    {% endfor %}
                    {% if intellischoolRoute %}
                        <li><a href="{{ intellischoolRoute }}" class="icon-intellischool">Albitros Analytics</a></li>
                    {% endif %}
                {% endif %}



            </ul>
        {% endif %}

        {% block studentGradesLink %}
        {% set gradesRoute = routeLookupIfAuthorized('learningGrades.getGradesForSubject', { viewee: USER, userId: USER.id, term: term, termCode: term.code, subject: class, subjectId: class.id }) %}
        {% if USER.getRole.isStudent == true and gradesRoute %}
            <nav>
                <a href="#" class="icon-more" data-dropdown="class-options{{ class.id }}" aria-expanded="false" title="Actions"></a>
            </nav>
            <ul data-dropdown-content class="f-dropdown" id="class-options{{ class.id }}">
                <li><a href="{{ gradesRoute }}" class="icon-approve">{{ locale.grades.properPlural }}</a></li>
            </ul>
        {% endif %}
        {% endblock %}
    </div>
</div>

