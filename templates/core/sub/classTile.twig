{# Usage:
    {% include 'sub/classTile.twig' with {
        'term':       Term
        'class':      Folder
        'classType':  string
        'courses':    CourseSpecification[]
    } only %}
#}


<div class="card-new small-12">
    <a href="/homepage/{{ class.id }}">
        <div class="card-feature-image" style="background-color:{{ class.colour }}; border-bottom: 10px solid {{ class.colour }};{%  if class.coverImage.hash %} background-image: url('/storage/image.php?hash={{ class.coverImage.hash }}&size=cardImageLarge'); background-size: cover; background-repeat: no-repeat; background-position: center; {% endif %}"></div>
    </a>
    <div class="card-content actions-small-1">
        <div class="list-item">
            <h3><a href="/homepage/{{ class.id }}">{{ class.title }}</a></h3>
            <p class="meta">{{ classType }}</p>
        </div>
        {% if USER.getRole.isStaff == true %}
            <nav>
                <a href="#" class="icon-more" data-dropdown="class-options{{ class.id }}" aria-expanded="false" title="Actions"></a>
            </nav>
            <ul data-dropdown-content class="f-dropdown" id="class-options{{ class.id }}">
                <li><a href="/subject/classList/{{ class.getCodeString() }}" class="icon-class-list">Class List</a></li>
                <li><a href="{{ routeLookup('learningMarkbook.getMarkbookForClassAndTerm', {folderId: class.id, termId: term.id}) }}" class="icon-curriculum">Markbook</a></li>
                <li><a href="/resource/folder/modify/{{ class.id }} " class="icon-modify">Modify</a></li>
                {% if courses | length %}
                    <li class="separator">Analytics</li>
                    {% for courseSpec in courses %}
                        {% set url = routeLookup('learningAnalytics.folderWithTerm', {courseSpecId: courseSpec.id, folderId: class.id, termCode: term.code}) %}
                        <li><a href="{{ url }}" class="icon-poll">{{ courseSpec.title }}</a></li>
                    {% endfor %}
                {% endif %}

            </ul>
        {% endif %}

        {% set gradesRoute = routeLookupIfAuthorized('learning.getGradesForSubject', { viewee: USER, userId: USER.id, term: term, termCode: term.code, subject: class, subjectId: class.id }) %}
        {% if USER.getRole.isStudent == true and gradesRoute %}
            <nav>
                <a href="#" class="icon-more" data-dropdown="class-options{{ class.id }}" aria-expanded="false" title="Actions"></a>
            </nav>
            <ul data-dropdown-content class="f-dropdown" id="class-options{{ class.id }}">
                <li><a href="{{ gradesRoute }}" class="icon-approve">Grades</a></li>
            </ul>
        {% endif %}
    </div>
</div>

