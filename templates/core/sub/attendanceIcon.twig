{# Renders a CSS class name appropriate for the externalType and attendance status #}
{% macro icon(externalType, isMarked) -%}
{% apply spaceless %}
    {% if 'tass' == externalType %}
        icon-class-list
    {% elseif 'synergetic' == externalType %}
        {% if isMarked %}
            icon-approve
        {% else %}
            icon-class-list
        {% endif %}
    {% endif %}
{% endapply %}
{%- endmacro %}
