{##
 # Student Profile
 #
 # showEmails   bool    Spec pattern to decide whether email address is visible
 # showDetails  bool    Spec patternt to decide whether details are visible
#}

{# Permissions #}
{% set isSuperuser = session.user.superUser %}
{% set isStaffWhoCanView = isSuperuser or (USER.role.staff and USER.role.viewStudentProfile) %}
{# Leaving isStaff for extended custom templates #}
{% set isStaff = isSuperuser or USER.role.staff %}
{% set isSelf = session.user.id == user.id %}

{# medical: if allowed in config, and user is staff or parent of this child #}
{% set showMedicalAlert = not config.protect_medicalspecial_profile and isStaffWhoCanView %}
{% set showSpecialAlert = not config.protect_medicalspecial_profile and isStaffWhoCanView %}
{% set showComments = config.synergetic_student_comment and isStaffWhoCanView %}

{% set showButtons = showDetails %}
{# contacts: su, staff or parent #}
{# Should a student see their own contact details? I think so #}
{% set showContacts = (isStaffWhoCanView or isParentOfStudent) and not hideContacts and contacts|length > 0 %}
{% set showContactsAlert = config.synergetic_community_alerts and showContacts and isStaffWhoCanView and externalUser is defined %}

{# Emergency Contact Information, due to non-normalisation, must be manually inspected
 # for contents in three possible places; name, phone, phone alt. Information can exist
 # in any one, or more, of those fields per emergency contact
 #
 # Using a defined() check isn't enough. It needs to contain useful information.
 # Therefore check for string length in each of name, phone, phone alt to decide
 #
 # tbh I think that you need both a name and at least one phone number for this section
 # to be even remotely useful, but anyway I'll go with what was previously here...
#}
{% set hasEmergencyContacts = false %}
{% for i in 1..3 %}
    {% set index = (i == 1 ? '' : i) %}

    {% if (externalUser["StudentEmergency#{index}Name"] is defined and externalUser["StudentEmergency#{index}Name"]|length) %}
        {% set hasEmergencyContacts = true %}
    {% endif %}
{% endfor %}

{% set showEmergencyContacts =
    (isPrimaryCarer or isStaffWhoCanView)
    and not hideContacts
    and hasEmergencyContacts
%}
{% set showContactsTab =
    showContacts
    or showContactsAlert
    or showEmergencyContacts
%}
{% set showSubjects = showDetails and subjects is not empty %}
{% set showGroups = showDetails and groups is not empty %}
{% set showTitle = user.hasPositionTitle() %}

{% set showActivityFeed =
    ((config.learning_moments_enabled and user.learningMomentsEnabled) or config.badges_enabled or config.grades_enabled)
    and (isStaffWhoCanView or isSelf or isParentOfStudent) %}
{% set showAchievementsTab = config.badges_enabled and (isStaffWhoCanView or isSelf or isParentOfStudent) %}
{% set shareLearningMomentUrl = routeLookupIfAuthorized(
    'learningMomentEvidence.getCreateForm',
    {
        users:   [user],
        userIds: user.id
    }
) %}
{% set pastoralUrl = showPastoral ? routeLookupIfAuthorized('pastoral.getStudent',{studentId: user.id}) : null %}
{##
 # Is the current user viewing their own profile?
 # This affects some links and metadata displayed.
#}
{% set isCurrentUser = user.id == USER.id %}

<script type="text/javascript">
    $(function () {
        $('#email-all-staff').click(function () {
            $('#email-all-form').submit();
        })
    });

    $(function () {
        $('#email-all-parents').click(function () {
            $('#email-contacts-form').submit();
        })
    });

    // Enable Expandables
    $(function () {
        $('[data-collapser]').collapsable();
    });
</script>

<div class="actions-small-{{ isSuperuser ? 1 : 0 }} row">
    <div class="list-item">
        <div class="small-12 column">
            {% block profileHeading %}
                <h1 data-test="user-profile-name">{{ user.formatName }}</h1>
            {% endblock %}
        </div>
    </div>
    <nav>
        {% if routeLookupIfAuthorized('adminUser.getModify') %}
            <a href="{{ routeLookup('adminUser.getModify', {'userId': user.id}) }}" class="icon-modify" title="Modify User" data-test="user-profile-modify"></a>
        {% endif %}
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="no-pad">
            <div class="profile content">
                <div class="row no-margin">
                    <div class="small-12 medium-2 columns no-pad">
                        {% include 'include/portrait.twig' with {user: user, render: 'profile', class: 'full-width', description: ''} only %}
                    </div>

                    <div class="small-12 medium-10 columns no-pad">
                        {% block details %}
                            {# TODO @zacmcw I don't know where you put styles anymore
                             #  Migrate this inline stylesheet into the appropriate place
                             #}
                            <style>
                                .profile.content .alert-box {
                                    margin-left: 0;
                                }

                                .profile .pastoral-flags {
                                    margin-left: 1rem;
                                }

                                /* What is with these paddings?!?
                                 */
                                .alert-box.obscured {
                                    width: 2rem;
                                    cursor: pointer;
                                    padding-right: 2rem;
                                }
                            </style>

                            {# TODO @zacmcw you might be able to implement this gooder than me #}
                            <script>
                                $(function() {
                                    $('[data-click-to-reveal]').on('click', function(event) {
                                        event.preventDefault();
                                        let elem = $(this).find('span');
                                        if (elem.is(':visible')) {
                                            elem.hide();
                                            $(this).css({
                                                'width': '2rem'
                                            });
                                        } else {
                                            elem.show();
                                            $(this).css({
                                                'width': 'auto',
                                            });
                                        }
                                    });
                                });
                            </script>

                            {# Build a hash lookup of additional clauses and cross-reference them
                             # This list is your last opportunity to show/hide a field
                             #
                             # Additional visibility constraints for the **viewer's** roletype
                             # and the corresponding bool set by old twig implementation
                             #}
                            {% set additionalConstraints = {
                                'staff': {
                                    'AlertLegal': showContactsAlert,
                                    'AlertMessage': showContactsAlert,
                                    'Comment': showComments,
                                    'countIndividualEducationPlans': isStaffWhoCanView,
                                    'email': showEmail,
                                    'EnglishSecondFlag': showSpecialAlert,
                                    'externalId': showDetails,
                                    'formTeacher': showDetails and showClasses,
                                    'hohTeacher': showClasses,
                                    'pastoralCounts': showPastoral,
                                    'StudentForm': showClasses,
                                    'StudentMedicalAlert': showMedicalAlert,
                                    'StudentSpecialNeedsFlag': showSpecialAlert,
                                    'StudentTutorDescription': showDetails and showClasses,
                                    'tutorTeacher': showDetails and showClasses
                                }
                            } %}

                            <dl>
                                {# Portrait is always element 0 at the moment: we can skip iterating
                                 # that array element here, because it's rendered elsewhere.
                                 #}
                                {% for selectedField in externalUser.data.roleTypes.fields.selected[1:] %}
                                    {# Decide if the viewer can actually see this field, due to additional
                                     # permissions, privacy and configuration settings that go well beyond
                                     # the viewer's role type; if you can see it, show it. Otherwise skip it.
                                     #}
                                    {% if (additionalConstraints[USER.role.type][selectedField.field] ?? true) %}
                                        {# Use localisation variant from Terminology, if it exists;
                                         # otherwise use default Display As that I provided by default
                                         #}
                                        {% set fieldName = selectedField.displayAs %}

                                        {% if selectedField.terminology %}
                                            {% set fieldName = locale.translate(selectedField.terminology, false, true) %}
                                        {% endif %}

                                        {# Now render each of the flags/tuples in some manner #}

                                        {# Presence of icon and css means it renders as a flag/alert #}
                                        {% if selectedField.icon and selectedField.css %}
                                            <dt class="full-width">
                                                {% if selectedField.field in ['AlertMessages', 'AlertLegal'] %}
                                                    {# A set of Alert Messages that display in one big flag
                                                     # This is often a set of strings that need to be output sequentially
                                                     #}
                                                    {% if selectedField.value|length %}
                                                        <div class="alert-box {{ selectedField.css ?? '' }} {{ selectedField.icon ?? '' }} {% if selectedField.clickToReveal %}obscured{% endif %}" {% if selectedField.clickToReveal %}data-click-to-reveal{% endif %}>
                                                            <span {% if selectedField.clickToReveal %}style="display:none"{% endif %}>
                                                                {% for message in selectedField.value %}
                                                                    {{ message|nl2br }}
                                                                {% endfor %}
                                                            </span>
                                                        </div>
                                                    {% endif %}
                                                {% elseif selectedField.value %}
                                                    {# A string that displays in a flag in some manner, typically #}
                                                    <div class="alert-box {{ selectedField.css ?? '' }} {{ selectedField.icon ?? '' }} {% if selectedField.clickToReveal %}obscured{% endif %}" {% if selectedField.clickToReveal %}data-click-to-reveal{% endif %}>
                                                        <span {% if selectedField.clickToReveal %}style="display:none"{% endif %}>
                                                            {% if selectedField.field in ['StudentMedicalAlert'] %}
                                                                {# A string with a special prefix that displays in a flag #}
                                                                Medical Note: {{ selectedField.value }}
                                                            {% elseif selectedField.field in ['Comment'] %}
                                                                {# A string that displays on its own in a flag#}
                                                                {{ selectedField.value }}
                                                            {% elseif selectedField.field in ['ParentsSeparatedFlag'] %}
                                                                {# A special flag that has a hardcoded text string #}
                                                                Parents separated; please be mindful when making contact.
                                                            {% else %}
                                                                {# A generic flag which shows Display As/Terminology equivalent
                                                                 #
                                                                 # Flags always display fullwidth and I can cheat by rendering
                                                                 # a full-width definition title without a definition data lol
                                                                 #}
                                                                {{ fieldName }}
                                                            {% endif %}
                                                        </span>
                                                    </div>
                                                {% endif %}
                                            </dt>
                                        {% else %}
                                            {% if selectedField.field in ['pastoralCounts'] and selectedField.value is not null %}
                                                {# This is handled separately and specially in the controller
                                                 # it's not really consolidated in this payload
                                                 #}
                                                {% if selectedField.value|length %}
                                                    <div class="pastoral-flags">
                                                        {% for pastoralCount in selectedField.value %}
                                                            <a href="{{ pastoralCount.destinationUrl }}">
                                                            <span class="label neutral icon-{{ pastoralCount.icon }} pastoral-flag-in-profile"
                                                                  data-tooltip title="{{ pastoralCount.title }}"
                                                                  style="color: {{ pastoralCount.fgColor }}; background-color: {{ pastoralCount.bgColor }}"
                                                            >{{ pastoralCount.count }}</span></a>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                            {% elseif selectedField.value %}
                                                {# Only render a tuple if it has a meaningful value
                                                 # Note that some fields require special handling (different data structures)
                                                 #}
                                                {% if selectedField.field in ['campusCollection'] %}
                                                    {# A list of campuses #}
                                                    {% if selectedField.value|length %}
                                                        <dt class="small-4 medium-3 columns">{{ fieldName }}</dt>
                                                        <dd class="small-8 medium-9 columns">
                                                            {% for campus in selectedField.value %}
                                                                {{ campus.name }}{% if not loop.last %}, {% endif %}
                                                            {% endfor %}
                                                        </dd>
                                                    {% endif %}
                                                {% else %}
                                                    {# The field name will always show at this point, though their values
                                                     # will need special treatment somehow
                                                     #}
                                                    <dt class="small-4 medium-3 columns">{{ fieldName }}</dt>
                                                    <dd class="small-8 medium-9 columns">
                                                        {% if selectedField.field in ['formTeacher', 'tutorTeacher', 'hohTeacher', 'coordTeacher', 'studentCoach'] %}
                                                            {# These fields are Schoolbox\User instances and need special treatment #}
                                                            <a href="{{ session.mailhandle }}{{ selectedField.value.email }}">{{ selectedField.value.formatName }}</a>
                                                        {% elseif selectedField.field in ['email'] %}
                                                            {# Renders a mailto: hyperlink #}
                                                            <a href="{{ session.mailhandle }}{{ selectedField.value }}">{{ selectedField.value }}</a>
                                                        {% elseif selectedField.field in ['StudentBirthDate'] %}
                                                            {# Renders with date formatting #}
                                                            {{ selectedField.value|date(dateFormats.shortDateOnlyFormat) }}
                                                        {% else %}
                                                            {# A generic tuple (key, value) pair #}
                                                            {{ selectedField.value }}
                                                        {% endif %}
                                                    </dd>
                                                {% endif %}
                                            {% endif %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            </dl>
                        {% endblock details %}
                    </div>
                </div>
            </div>

            {% block buttons_island %}
                <ul class='flex-list flex-wrap buttons'>
                    {% block buttons %}

                        {% if eportfolioAuth %}
                            {% block buttons_eportfolio %}
                                <li>
                                    <a href="/eportfolio/{{ user.id }}/profile"
                                       class="icon-eportfolio">ePortfolio</a>
                                </li>
                            {% endblock buttons_eportfolio %}
                        {% endif %}

                        {% if showButtons %}
                            {% block buttons_dueWork %}
                                {% set route = routeLookupIfAuthorized('learningUpcoming.getUpcomingForStudent', {student: user, studentId: user.id}) %}
                                {% if route %}
                                    <li>
                                        <a href="{{ route }}" class="icon-due-work">{{ locale.dueWork.proper }}</a>
                                    </li>
                                {% endif %}
                            {% endblock buttons_dueWork %}

                            {% block buttons_grades %}
                                {% set route = routeLookupIfAuthorized('learningGrades.getGrades', {viewee: user, userId: user.id}) %}
                                {% if route %}
                                    <li>
                                        <a href="{{ route }}" class="icon-tick">{{ locale.grades.properPlural }}</a>
                                    </li>
                                {% endif %}
                            {% endblock buttons_grades %}



                            {% if showPastoral and pastoralUrl %}
                                <li>
                                    <a href="{{ pastoralUrl }}"
                                       class="icon-pastoral">{{ locale.pastoralCare.proper }}</a>
                                </li>
                            {% endif %}

                            {% set calendarUrl = routeLookupIfAuthorized('calendar.getCalendar', {selectedDate: now.urlDate, userId: user.id, user: user})  %}
                            {% if calendarUrl %}
                                {% block buttons_calendar %}
                                    <li>
                                        <a href='{{ calendarUrl }}'
                                           class="icon-calendar">{{ locale.calendar.proper }}</a>
                                    </li>
                                {% endblock buttons_calendar %}
                            {% endif %}

                            {% if showClasses %}
                                {% block buttons_timetable %}
                                    <li>
                                        <a href="/timetable/{{ user.id }}"
                                           class="icon-timetable">Timetable</a>
                                    </li>
                                {% endblock buttons_timetable %}
                            {% endif %}

                            {% block buttons_pastoralCare %}
                                {% if isStaffWhoCanView and config.external_type == 'synergetic' and config.external_staff_portal %}
                                    <li>
                                        <a href="{{ config.external_staff_portal }}/stud.aspx?id={{ user.externalId }}"
                                           class="icon-synergetic"
                                           target="_blank">Synweb</a>
                                    </li>
                                {% endif %}
                            {% endblock buttons_pastoralCare %}

                            {% block buttons_documents %}
                                {% if config.external_document_report_enabled and config.external_document_button_enable %}
                                    {% set routeAcademicReports = routeLookupIfAuthorized('profileDocumentManagement.getIndex', {studentId: user.id}) %}
                                    {% if routeAcademicReports %}
                                        <li>
                                            <a href="{{ routeAcademicReports }}" class="icon-document">{{ locale.reports.properPlural }}</a>
                                        </li>
                                    {% endif %}
                                {% endif %}
                            {% endblock buttons_documents %}

                            {% block buttons_email_all_staff %}
                                {% if config.mail_enable and isStaffWhoCanView and config.email_all_staff and session.user.email %}
                                    <li>
                                        <a class="icon-email" id="email-all-staff" title="Includes all teachers, year coordinator, head of house, tutor and coach.">Email All Teachers</a>
                                        <form id="email-all-form" action="{{ routeLookupIfAuthorized('mail.postCreateMail') }}" class="hide" method="post">
                                            <input name="userIds" value="{{ allTeacherIds }}" type="hidden">
                                            <input name="target" value="cc" type="hidden">
                                            <input name="title" value="Email All Teachers" type="hidden">
                                            <input name="studentId" value="{{ user.id }}" type="hidden">
                                        </form>
                                    </li>
                                {% endif %}
                            {% endblock  buttons_email_all_staff  %}

                            {% block buttons_email_parents %}
                                {% if config.mail_enable and isStaffWhoCanView and config.email_all_parents and session.user.email and not hideContacts %}
                                    <li>
                                        <a class="icon-email" id="email-all-parents" title="Emails the parents that have email addresses and can be contacted">Email Parents</a>
                                        <form action="{{ routeLookupIfAuthorized('mail.postCreateMail') }}" method="post" class="no-margin" id="email-contacts-form">
                                            <input type="hidden" name="studentExternalIds" value="{{ user.externalId }}"/>
                                            <input type="hidden" name="selectedGroups" value="parents_of"/>
                                            <input name="studentId" value="{{ user.id }}" type="hidden">
                                            <input name="title" value="Email Parents" type="hidden">
                                        </form>
                                    </li>
                                {% endif %}
                            {% endblock buttons_email_parents %}

                            {% block buttons_geosnapshots %}
                                {% if isGeosnapshotAvailable %}
                                    {% set route = routeLookupIfAuthorized('geosnapshotApi.getStudentPhotos', {id: user.id})  %}

                                    {% if route %}
                                        <li>
                                            <a class="icon-geosnapshot" href="/geosnapshot/user/{{ user.id }}">View Photos</a>
                                        </li>
                                    {% endif %}
                                {% endif %}
                            {% endblock %}

                            {% block buttons_miscellaneous %}
                            {% endblock buttons_miscellaneous %}

                            {% for button in customButtons %}
                                <li>
                                    <a href="{{ button.url }}" title="{{ button.title }}" class="icon-{{ button.icon }} {{ button.css }}" target="{{ button.target }}">{{ button.text }}</a>
                                </li>
                            {% endfor %}
                        {% endif %}
                    {% endblock buttons %}
                </ul>
            {% endblock buttons_island %}

            {% block travel_logs %}
            {% endblock travel_logs %}
        </section>
    </div>
</div>


{# Tabs #}
<div class="row">
    <div class="small-12 island">
        {# Programmatically detect the anchor value and select that tab via foundation
         # This allows you to link /search/user/...#classes to open the Classes tab initially
         # upon visiting that url
        #}
        <script>
            $(function() {
                switch (window.location.hash) {
                    case '#activity':
                    case '#achievements':
                    case '#goals':
                    case '#classes':
                    case '#groups':
                    case '#contacts':
                        $.fn.scrollToTop({
                            scrollOnInit: true,
                            scrollTo: '[data-tab]',
                            velocity: 250
                        });

                        $('[data-tab] a[href="#tab-'+window.location.hash.substring(1)+'"]').trigger('click');
                        break;

                        {# If you visit this url directly without a hash, just do default behaviour
                     # Don't try to preselect any tabs, because you might not be here for the tabs
                        #}
                    default:
                        $('[data-tab] a').first().trigger('click');
                        break;
                #}
            });
        </script>

        {# These are all the possible tab buttons that could exist
         # and the booleans which determine if they're currently available
         #
         # The first button in the list is always selected by default
         # activeTab setting will override it later if appropriate to do so
         # based on the anchor in the url via javascript
        #}
        {% set possibleTabs = [
            {
                label: 'Activity Feed',
                anchor: 'tab-activity',
                visible: showActivityFeed
            },
            {
                label: 'Goals',
                anchor: 'tab-goals',
                visible: showAchievementsTab
            },
            {
                label: achievementsTabLabel | default('Achievements'),
                anchor: 'tab-achievements',
                visible: showAchievementsTab
            },
            {
                label: 'Classes',
                anchor: 'tab-classes',
                visible: showClasses and showSubjects
            },
            {
                label: 'Groups',
                anchor: 'tab-groups',
                visible: showGroups
            },
            {
                label: 'Contacts',
                anchor: 'tab-contacts',
                visible: showContactsTab
            }
        ] %}

        {# Out of all the tabs that could possibly exist here, figure out
         # which one is currently active by default and remember it
        #}
        {% set activeTab = null %}

        {% for data in possibleTabs %}
            {% if data.visible and not activeTab %}
                {% set activeTab = data.anchor %}
            {% endif %}
        {%  endfor %}

        {# If activeTab was set, then at least one of the tabs was available
         # and we can show the whole island. We can also preselect a default
         # tab so it appears active, which will happen when you visit a profile
         # screen via /search/user/...
         #
         # Visiting that url with a hash /search/user/...#classes for example,
         # will cause a javascript to run and switch the foundation tabs to the
         # one represented by the hash (in this case, #classes)
        #}
        {% if activeTab %}
            <dl class="tabs" data-tab>

                {# First visible tab is active by default #}
                {% set defaultCss = 'active' %}

                {% for tab in possibleTabs %}
                    {% if tab.visible %}
                        <dd class="{{ defaultCss }}"><a href="#{{ tab.anchor }}">{{ tab.label }}</a></dd>

                        {# All subsequent tabs are not active by default #}
                        {% set defaultCss = '' %}
                    {% endif %}
                {% endfor %}
            </dl>
        {% endif %}

        <div class="profile-tabs tabs-content">
            {% if showActivityFeed %}
                <div class="content no-pad {% if activeTab == 'activity' %}active{% endif %}" id="tab-activity">
                    <div id="activity-feed">
                        <activity-feed
                                cdn-prefix="{{ CDN_PREFIX }}"
                                site-version="{{ config.site_version }}"
                                :config-grade-gradient-enabled={{ config.grade_gradient_enable == 1 ? 'true' : 'false' }}
                                :show-learning-moments="{{ config.learning_moments_enabled ? 'true' : 'false' }}"
                                :show-goals="{{ config.badges_enabled ? 'true' : 'false' }}"
                                :show-achievements="{{ config.badges_enabled ? 'true' : 'false' }}"
                                :show-feedback="{{ config.activity_feed_feedback_enabled ? 'true' : 'false' }}"
                        />
                    </div>
                </div>
            {% endif %}

            {% if showAchievementsTab %}
                <div class="content no-pad {% if activeTab == 'goals' %}active{% endif %}" id="tab-goals">
                    <div id="goal-feed" class="goals-achievements">
                        <goal-feed
                                cdn-prefix="{{ CDN_PREFIX }}"
                                site-version="{{ config.site_version }}"
                        />
                    </div>
                </div>

                <div class="content no-pad {% if activeTab == 'achievements' %}active{% endif %}" id="tab-achievements">
                    <div id="achievement-feed" class="goals-achievements">
                        <achievement-feed
                                cdn-prefix="{{ CDN_PREFIX }}"
                                site-version="{{ config.site_version }}"
                        />
                    </div>
                </div>
            {% endif %}

            {% autoescape 'js' %}
                {# Configuration for various Vue components #}
                <script type="text/javascript">
                    let baseConfig = {
                        currentUser: {{ USER | json_encode | raw }},
                        student: {{ user | json_encode | raw }},
                        routes: {
                            getCreateEvidenceForm: '{{ routeLookupIfAuthorized(
                                'learningMomentEvidence.getCreateForm',
                                {users: [user], userIds: user.id}
                            ) }}',
                            getSetAsGoalForm: '{{ routeLookupIfAuthorized(
                                'learningBadgeAward.getSetAsGoalForm',
                                {users: [user], userIds: user.id}
                            ) }}',
                            getSetAsGoalForSelfForm: '{{ routeLookupIfAuthorized(
                                'learningBadgeAward.getSetAsGoalForSelfForm'
                            ) }}',
                            getAwardAsAchievementForm: '{{ routeLookupIfAuthorized(
                                'learningBadgeAward.getAwardAsAchievementForm',
                                {users: [user], userIds: user.id}
                            ) }}',
                        },
                        returnUrl: {
                            name: '{{ RETURN_URL.name }}',
                            current: '{{ RETURN_URL.current }}',
                        },
                    };
                    window.learningEvidenceFeedConfig = $.extend(true, {}, baseConfig);
                    window.learningEvidenceFeedConfig.routes.getFeed = '{{ routeLookupIfAuthorized(
                        'learningMomentFeed.getFeedForUser',
                        {user: user, userId: user.id}
                    ) }}';
                    window.learningEvidenceFeedConfig.canComment = Boolean('{{ learningMomentCanComment }}');

                    window.learningBadgeGoalFeedConfig = $.extend(true, {}, baseConfig);
                    window.learningBadgeGoalFeedConfig.routes.getAwardFeed = '{{ routeLookupIfAuthorized(
                        'learningBadgeAward.getAwardedBadges',
                        {user: user, userId: user.id, awardStatus: 'goal'}
                    ) }}';

                    window.learningBadgeAchievementFeedConfig = $.extend(true, {}, baseConfig);
                    window.learningBadgeAchievementFeedConfig.routes.getAwardFeed = '{{ routeLookupIfAuthorized(
                        'learningBadgeAward.getAwardedBadges',
                        {user: user, userId: user.id, awardStatus: 'achievement'}
                    ) }}';
                </script>
            {% endautoescape %}
            <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/userProfileFeeds.js?v={{ config.site_version }}"></script>

            {% if showClasses and showSubjects %}
                <div class="content no-pad {% if activeTab == 'classes' %}active{% endif %}" id="tab-classes">
                    <section>

                        {% for group, subjectGroup in subjects %}

                            {# Suffix all iterated identifiers
                         # Tot menus and so on start exhiting interrelated behaviour when they share the same id
                         # We can ensure uniqueness in iterations by suffixing with an index but we can do it by
                         # taking advantage of a twig construct
                            #}
                            {% set groupIdentifier = loop.index %}

                            {# Keep a running total of all teachers emails in this group #}
                            {% set teacherIdsToEmail = [] %}
                            <div class="actions-small-1 content">
                                <div class="list-item">
                                    <div>
                                        <h2 class="subheader">{{ group }}</h2>
                                    </div>
                                </div>
                                {% if isStaffWhoCanView and config.email_all_staff and config.mail_enable %}
                                    {% for subject in subjectGroup %}
                                        {% for teacher in subject.teachers %}
                                            {% if not teacher.email is empty and teacher.id not in teacherIdsToEmail %}
                                                {% set teacherIdsToEmail = teacherIdsToEmail|merge([teacher.id]) %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endfor %}
                                    {% if teacherIdsToEmail|length > 0 %}
                                        <nav>
                                            <sbx-pop-out content-id="email-teachers-{{ groupIdentifier }}"></sbx-pop-out>
                                        </nav>
                                        <ul class="f-dropdown" data-dropdown-content id="email-teachers-{{ groupIdentifier }}">
                                            <li>
                                                <a id="email-all-{{ groupIdentifier }}" class="icon-email" href="#" title="Email all {{ group }} teachers">Email all {{ group }} teachers</a>
                                            </li>
                                        </ul>
                                        <form id="email-all-form-{{ groupIdentifier }}" action="{{ routeLookupIfAuthorized('mail.postCreateMail') }}" method="post">
                                            <input type="hidden" name="userIds" value="{{ teacherIdsToEmail|join(',') }}"/>
                                            <input name="target" value="cc" type="hidden">
                                            <input name="title" value="Email all {{ group }} teachers" type="hidden">
                                            <input name="studentId" value="{{ user.id }}" type="hidden">
                                        </form>
                                        {% autoescape 'js' %}
                                        <script type="text/javascript">
                                            $('#email-all-{{ groupIdentifier }}').on('click',function(){
                                                $('#email-all-form-{{ groupIdentifier }}').submit();
                                            });
                                        </script>
                                        {% endautoescape %}
                                    {% endif %}
                                {% endif %}
                            </div>
                            <section class="v-card-list classes-groups content">
                                {% for subjectKey, subject in subjectGroup %}

                                    {# Suffix all iterated identifiers
                                 # Tot menus and so on start exhibiting interrelated behaviour when they share the same id
                                 # We can ensure uniqueness in iterations by suffixing with an index but we can do it by
                                 # taking advantage of a twig construct
                                 #
                                 # You have multiple subjects per subject group so you need further uniquification
                                    #}
                                    {% set subjectIdentifier = loop.index %}

                                    <div class="v-card">

                                        {% if subject.linkedToFolder %}
                                        <a href="/homepage/code/{{ subject.folder.matchedCode|e('url')|e('url') }}">
                                            {% endif %}
                                            <div class="card-class-image"
                                                 style="border-bottom-width: 10px;
                                                         border-bottom-style: solid;
                                                 {% if subject.folder is defined and subject.folder.colour %}
                                                         background-color:{{ subject.folder.colour }};
                                                         border-bottom-color: {{ subject.folder.colour }};
                                                 {% endif %}
                                                    {% if subject.folder is defined and subject.folder.coverImage %}
                                                         background-image: url('/storage/image.php?hash={{ subject.folder.coverImage.hash }}&size=cardImageLarge');
                                                         background-size: cover;
                                                         background-repeat: no-repeat;
                                                         background-position: center;
                                                 {% endif %}"
                                            >
                                                <div class="related">
                                                    {# A card can't fit more than 5 subject teachers comfortably, so four are displayed,
                                                    with the remaining counted, and displayed in tool tip #}
                                                    {% set maxTeachersToShowCount = 4 %}
                                                    {% set teachersHead = subject.teachers[:maxTeachersToShowCount] %}
                                                    {% for teacher in teachersHead %}
                                                        {% include 'include/portrait.twig' with {user: teacher, description: teacher.fullName} only %}
                                                    {% endfor %}
                                                    {% set teachersTail = subject.teachers[maxTeachersToShowCount:] %}
                                                    {% if teachersTail|length %}
                                                        {% set subjectTeacherNames = '' %}
                                                        {% for teacher in teachersTail %}
                                                            {% if loop.index == teachersTail|length %}
                                                                {% set subjectTeacherNames = subjectTeacherNames ~ teacher.formatName %}
                                                            {% else %}
                                                                {% set subjectTeacherNames = subjectTeacherNames ~ teacher.formatName ~ '<br/>' %}
                                                            {% endif %}
                                                        {% endfor %}
                                                        {% set remainingSubjectTeachersCount = subject.teachers|length - maxTeachersToShowCount  %}
                                                        <div class="plus-more" data-tooltip class="hint has-tip tip-top" title="{{ subjectTeacherNames }}">+{{ remainingSubjectTeachersCount }}</div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            {% if subject.linkedToFolder %}
                                        </a>
                                        {% endif %}

                                        {% set hasTeachersWithEmail = false %}
                                        {% if canEmailStaff  %}
                                            {% for teacher in subject.teachers %}
                                                {% if not teacher.email is empty %}
                                                    {% set hasTeachersWithEmail = true %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                        <div class="card-content classes actions-small-{{ hasTeachersWithEmail ? '1' : '0'}} {% block folderListItemClasses %}{% endblock %}">
                                            <div class="list-item">
                                                {% set subjectCode = subject.campusCode|default('') is same as('') ? subject.code : subject.campusCode ~ '/' ~ subject.code %}

                                                {% if subject.linkedToFolder %}
                                                    <a href="/homepage/code/{{ subject.folder.matchedCode|e('url')|e('url') }}">
                                                        <h3>{{ subject.name }}</h3>
                                                        {% if subjectCode|length %}<p class="meta">{{ subjectCode }}</p>{% endif %}
                                                    </a>
                                                {% else %}
                                                    <h3>{{ subject.name }}</h3>
                                                    {% if subjectCode|length %}<p class="meta">{{ subjectCode }}</p>{% endif %}
                                                {% endif %}
                                            </div>
                                            {% block folderListItemActions %}
                                                {% if hasTeachersWithEmail and canEmailStaff %}
                                                    <nav>
                                                        <sbx-pop-out content-id="class-options-{{ groupIdentifier }}-{{ subjectIdentifier }}"></sbx-pop-out>
                                                    </nav>
                                                    <ul id="class-options-{{ groupIdentifier }}-{{ subjectIdentifier }}" class="f-dropdown" data-dropdown-content>
                                                        {% for teacher in subject.teachers %}
                                                            {% if not teacher.email is empty %}
                                                                <li>
                                                                    {% set replyTo = teacher.getFormattedEmailDisplay %}
                                                                    <a class="icon-email" href="{{ session.mailhandle }}{{ replyTo }}" title="Email {{ replyTo }}">Email {{ teacher.formatName }}</a>
                                                                </li>
                                                            {% endif %}
                                                        {% endfor %}
                                                    </ul>
                                                {% endif %}
                                            {% endblock %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </section>
                        {% endfor %}
                    </section>
                </div>
            {% endif %}

            {% if showGroups %}
                <div class="content no-pad {% if activeTab == 'groups' %}active{% endif %}" id="tab-groups">
                    <section>
                        <h2 class="subheader content">Groups</h2>
                        <section class="v-card-list classes-groups content">
                            {% for groupKey, group in groups %}
                                <div class="v-card">
                                    {% if group.linkedToFolder %}
                                    <a href="/homepage/{{ group.id }}">
                                        {% endif %}
                                        <div class="card-class-image"
                                             style="border-bottom-width: 10px;
                                                     border-bottom-style: solid;
                                             {% if group.folder is defined and group.folder.colour %}
                                                     background-color:{{ group.folder.colour }};
                                                     border-bottom-color: {{ group.folder.colour }};
                                             {% endif %}
                                                {% if group.folder is defined and group.folder.coverImage %}
                                                     background-image: url('/storage/image.php?hash={{ group.folder.coverImage.hash }}&size=cardImageLarge');
                                                     background-size: cover;
                                                     background-repeat: no-repeat;
                                                     background-position: center;
                                             {% endif %}"
                                        >
                                            {% if group.owners is defined %}
                                                <div class="related groups">
                                                    {# A card can't fit more than 5 group owners comfortably, so four are displayed,
                                                with the remaining counted, and displayed in tool tip #}
                                                    {% set maxOwnersToShowCount = 4 %}
                                                    {% set ownersHead = group.owners[:maxOwnersToShowCount] %}
                                                    {% for owner in ownersHead %}
                                                        {% include 'include/portrait.twig' with {user: owner, description: owner.fullName} only %}
                                                    {% endfor %}
                                                    {% set ownersTail = group.owners[maxOwnersToShowCount:] %}
                                                    {% if ownersTail|length %}
                                                        {% set groupOwnersNames = '' %}
                                                        {% for owner in ownersTail %}
                                                            {% if loop.index == ownersTail|length %}
                                                                {% set groupOwnersNames = groupOwnersNames ~ owner.formatName %}
                                                            {% else %}
                                                                {% set groupOwnersNames = groupOwnersNames ~ owner.formatName ~ '<br/>' %}
                                                            {% endif %}
                                                        {% endfor %}
                                                        {% set remainingGroupOwnersCount = group.owners|length - maxOwnersToShowCount  %}
                                                        <div class="plus-more" data-tooltip class="hint has-tip tip-top" title="{{ groupOwnersNames }}">+{{ remainingGroupOwnersCount }}</div>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        </div>
                                        {% if group.linkedToFolder %}
                                    </a>
                                    {% endif %}

                                    {% set hasOwnersWithEmail = false %}
                                    {% if group.owners is defined and canEmailStaff %}
                                        {% for owner in group.owners %}
                                            {% if not owner.email is empty %}
                                                {% set hasOwnersWithEmail = true %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                    <div class="card-content classes groups actions-small-{{ hasOwnersWithEmail ? '1' : '0' }}">
                                        <div class="list-item">
                                            {% if group.linkedToFolder %}
                                                <a href="/homepage/{{ group.id }}">
                                                    <h3>{{ group.name }}</h3>
                                                </a>
                                            {% else %}
                                                <h3>{{ group.name }}</h3>
                                            {% endif %}
                                        </div>
                                        {% if hasOwnersWithEmail and canEmailStaff %}
                                            <nav>
                                                <sbx-pop-out content-id="group-options-{{ groupKey }}"></sbx-pop-out>
                                            </nav>
                                            <ul id="group-options-{{ groupKey }}" class="f-dropdown" data-dropdown-content>
                                                {% for owner in group.owners %}
                                                    {% if not owner.email is empty %}
                                                        <li>
                                                            {% set replyTo = owner.getFormattedEmailDisplay %}
                                                            <a class="icon-email" href="{{ session.mailhandle }}{{ replyTo }}" title="Email {{ replyTo }}">Email {{ owner.formatName }}</a>
                                                        </li>
                                                    {% endif %}
                                                {% endfor %}
                                            </ul>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </section>
                    </section>
                </div>
            {% endif %}

            {% if showContactsTab %}
                <div class="content no-pad {% if activeTab == 'contacts' %}active{% endif %}" id="tab-contacts">

                    <section class="content">
                        {% block contacts_island %}
                            {% block contacts %}
                                <h2 class="subheader">Contact Information</h2>
                                {% if showContactsAlert %}
                                    {% if externalUser.ParentsSeparatedFlag ?? false %}
                                        {% block parents_separated %}
                                            <div class="alert-box highlight icon-info">Parents Separated</div>
                                        {% endblock parents_separated %}
                                    {% endif %}
                                {% endif %}

                                {% if showContacts %}
                                    <section>
                                        <ul class="information-list expandable-card">
                                            {% for contact in contacts %}
                                                {% if contact.StudentContactTitle or contact.StudentContactPreferred %}
                                                    <li class="small-12">

                                                        <!-- Expander -->
                                                        <div class="list-item">
                                                            <div class="expander" data-collapser="collap-contact-{{ loop.index }}"></div>
                                                            <div class="compact card small-12">
                                                                {% if contact.main %}
                                                                    <a href="/search/user/{{ contact.main.id }}">
                                                                        {% include 'include/portrait.twig' with {user: contact.main} only %}
                                                                        <p>
                                                                            {{ contact.StudentContactTitle }} {{ contact.StudentContactPreferred }} {{ contact.StudentContactSurname }}
                                                                            <span class="pipe meta">{{ contact.StudentContactRelation }}</span>
                                                                        </p>
                                                                    </a>
                                                                {% else %}
                                                                    {% include 'include/portrait.twig' with {externalId: contact.StudentContactID} only %}
                                                                    <p>
                                                                        {{ contact.StudentContactTitle }} {{ contact.StudentContactPreferred }} {{ contact.StudentContactSurname }}
                                                                        <span class="pipe meta">{{ contact.StudentContactRelation }}</span>
                                                                    </p>
                                                                {% endif %}
                                                            </div>
                                                        </div>

                                                        <!-- Collapsable content -->
                                                        {% if (contact.StudentContactPhoneActual and not contact.StudentContactSilentPhoneFlag) or contact.StudentContactMobilePhone or contact.StudentContactOccupPhone or contact.StudentContactDefaultEmail %}
                                                            <div class="small-12 column content hide" data-collapse-state="collapsed" data-collapsable="collap-contact-{{ loop.index }}">
                                                                <div class="list-item">
                                                                    <div class="small-12">

                                                                        {% if contact.StudentContactPhoneActual and not contact.StudentContactSilentPhoneFlag %}
                                                                            <div class="row">
                                                                                <div class="column small-12 medium-5"><strong>Home Phone: </strong></div>
                                                                                <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactPhoneActual }}" title="Call {{ contact.StudentContactPhoneActual }}">{{ contact.StudentContactPhoneActual }}</a></div>
                                                                            </div>
                                                                        {% endif %}

                                                                        {% if contact.StudentContactMobilePhone %}
                                                                            <div class="row">
                                                                                <div class="column small-12 medium-5"><strong>Mobile Phone: </strong></div>
                                                                                <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactMobilePhone }}" title="Call {{ contact.StudentContactMobilePhone }}">{{ contact.StudentContactMobilePhone }}</a></div>
                                                                            </div>
                                                                        {% endif %}

                                                                        {% if contact.StudentContactOccupPhone %}
                                                                            <div class="row">
                                                                                <div class="column small-12 medium-5"><strong>Work Phone: </strong></div>
                                                                                <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactOccupPhone }}" title="Call {{ contact.StudentContactOccupPhone }}">{{ contact.StudentContactOccupPhone }}</a></div>
                                                                            </div>
                                                                        {% endif %}

                                                                        {% if contact.StudentContactDefaultEmail %}
                                                                            <div class="row">
                                                                                <div class="column small-12 medium-5"><strong>Email: </strong></div>
                                                                                <div class="column small-12 medium-7"><a href="{{ session.mailhandle }}{{ contact.StudentContactDefaultEmail }}">{{ contact.StudentContactDefaultEmail }}</a></div>
                                                                            </div>
                                                                        {% endif %}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        {% else %}
                                                            <div class="hide" data-collapse-state="collapsed" data-collapsable="collap-contact-{{ loop.index }}">
                                                                <div class="empty-state small-12">
                                                                    <p>No contact details found.</p>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                    </li>

                                                    {% if contact.StudentContactSpouseTitle or contact.StudentContactSpousePreferred %}
                                                        <li class="small-12">

                                                            <!-- Expander -->
                                                            <div class="list-item">
                                                                <div class="expander" data-collapser="collap-spouse-{{ loop.index }}"></div>
                                                                <div class="compact card small-12">
                                                                    {# need to know user's schoolbox info here #}
                                                                    {% if contact.spouse %}
                                                                        <a href="/search/user/{{ contact.spouse.id }}">
                                                                            {% include 'include/portrait.twig' with {user: contact.spouse} only %}
                                                                            <p>
                                                                                {{ contact.StudentContactSpouseTitle }} {{ contact.StudentContactSpousePreferred }} {{ contact.StudentContactSpouseSurname }}
                                                                                <span class="pipe meta">{{ contact.StudentContactSpouseRelation }}</span>
                                                                            </p>
                                                                        </a>
                                                                    {% else %}
                                                                        {% include 'include/portrait.twig' with {externalId: contact.StudentContactSpouseID} only %}
                                                                        <p>
                                                                            {{ contact.StudentContactSpouseTitle }} {{ contact.StudentContactSpousePreferred }} {{ contact.StudentContactSpouseSurname }}
                                                                            <span class="pipe meta">{{ contact.StudentContactSpouseRelation }}</span>
                                                                        </p>
                                                                    {% endif %}
                                                                </div>
                                                            </div>

                                                            {% if (contact.StudentContactPhoneActual and not contact.StudentContactSilentPhoneFlag) or contact.StudentContactSpouseMobilePhone or contact.StudentContactSpouseOccupPhone or contact.StudentContactSpouseDefaultEmail %}
                                                                <!-- Collapsable content -->
                                                                <div class="small-12 column content hide" data-collapse-state="collapsed" data-collapsable="collap-spouse-{{ loop.index }}">
                                                                    <div class="list-item">
                                                                        <div class="small-12">

                                                                            {% if contact.StudentContactPhoneActual and not contact.StudentContactSilentPhoneFlag %}
                                                                                <div class="row">
                                                                                    <div class="column small-12 medium-5"><strong>Home Phone: </strong></div>
                                                                                    <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactPhoneActual }}" title="Call {{ contact.StudentContactPhoneActual }}">{{ contact.StudentContactPhoneActual }}</a></div>
                                                                                </div>
                                                                            {% endif %}

                                                                            {% if contact.StudentContactSpouseMobilePhone %}
                                                                                <div class="row">
                                                                                    <div class="column small-12 medium-5"><strong>Mobile Phone: </strong></div>
                                                                                    <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactSpouseMobilePhone }}" title="Call {{ contact.StudentContactSpouseMobilePhone }}">{{ contact.StudentContactSpouseMobilePhone }}</a></div>
                                                                                </div>
                                                                            {% endif %}

                                                                            {% if contact.StudentContactSpouseOccupPhone %}
                                                                                <div class="row">
                                                                                    <div class="column small-12 medium-5"><strong>Work Phone: </strong></div>
                                                                                    <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactSpouseOccupPhone }}" title="Call {{ contact.StudentContactSpouseOccupPhone }}">{{ contact.StudentContactSpouseOccupPhone }}</a></div>
                                                                                </div>
                                                                            {% endif %}

                                                                            {% if contact.StudentContactSpouseDefaultEmail %}
                                                                                <div class="row">
                                                                                    <div class="column small-12 medium-5"><strong>Email: </strong></div>
                                                                                    <div class="column small-12 medium-7"><a href="{{ session.mailhandle }}{{ contact.StudentContactSpouseDefaultEmail }}">{{ contact.StudentContactSpouseDefaultEmail }}</a></div>
                                                                                </div>
                                                                            {% endif %}
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            {% else %}
                                                                <div class="hide" data-collapse-state="collapsed" data-collapsable="collap-spouse-{{ loop.index }}">
                                                                    <div class="empty-state small-12">
                                                                        <p>No contact details found.</p>
                                                                    </div>
                                                                </div>
                                                            {% endif %}
                                                        </li>
                                                    {% endif %}
                                                {% endif %}
                                            {% endfor %}
                                        </ul>
                                    </section>
                                {% endif %}
                            {% endblock contacts %}
                        {% endblock contacts_island %}

                        {% block emergencyContacts_island %}
                            {% block emergencyContacts %}
                                {# up to 3 emergency contact blocks
                         # show no header if no emergencies
                                #}
                                {% if showEmergencyContacts %}
                                    <h2 class="subheader">Emergency Contact Information</h2>
                                    <section>
                                        <ul class="information-list expandable-card">
                                            {% for i in 1..3 %}
                                                {% set index = (i == 1 ? '' : i) %}
                                                {% if externalUser["StudentEmergency#{index}Name"] %}
                                                    <li>
                                                        <!-- Expander -->
                                                        <div>
                                                            <div class="expander" data-collapser="collap-emergency-{{ i }}"></div>
                                                            <div class="content small-12">
                                                                {{ externalUser["StudentEmergency#{index}Name"] }}
                                                            </div>
                                                        </div>

                                                        <!-- Collapseable content -->
                                                        <div class="small-12 column content hide" data-collapse-state="collapsed" data-collapsable="collap-emergency-{{ i }}">
                                                            <div class="row">
                                                                <div class="column small-12 medium-5"><strong>Primary Phone: </strong></div>
                                                                <div class="column small-12 medium-7">
                                                                    <a href="tel:{{ externalUser["StudentEmergency#{index}Phone"] }}">
                                                                        {{ externalUser["StudentEmergency#{index}Phone"] }}
                                                                    </a>
                                                                </div>
                                                            </div>

                                                            <div class="row">
                                                                <div class="column small-12 medium-5"><strong>Alternate Phone: </strong></div>
                                                                <div class="column small-12 medium-7">
                                                                    <a href="tel:{{ externalUser["StudentEmergency#{index}PhoneAlt"] }}">
                                                                        {{ externalUser["StudentEmergency#{index}PhoneAlt"] }}
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </li>
                                                {% endif %}
                                            {% endfor %}
                                        </ul>
                                    </section>
                                {% endif %}
                            {% endblock emergencyContacts %}
                        {% endblock emergencyContacts_island %}
                    </section>
                </div>
            {% endif %}
        </div>
    </div>
</div>


