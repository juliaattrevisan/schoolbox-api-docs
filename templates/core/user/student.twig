<div class="row">
    <div class="small-12 column">
        <h1>{{ user.formatName() }}</h1>
        <span class='header-actions'>
            {% if session.user.isSuperuser() %}
            <a href="/adminv2/modify-user/{{ user.getId() }}" class="button icon-modify" title="Modify User"></a>
            {% endif %}
        </span>
    </div>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="no-pad no-margin">
            <div class="content no-pad">
                <div class="row no-margin">
                    <div class="small-12 medium-6 large-4 columns no-pad">
                        <!-- BEGIN portrait -->
                        <img src="/portrait.php?userId={{ user.getExternalId() }}&amp;size=profile" class="full-width"/>
                        <!-- END portrait -->
                    </div>

                    <div class="small-12 medium-6 large-8 columns no-pad">
                        {% if externalUser.StudentMedicalAlert %}
                        <div class="alert-box alert icon-alert no-margin">
                            Medical Note: {{ externalUser.StudentMedicalAlert }}
                        </div>
                        {% endif %}
                        <dl class="inline-dl no-margin">
                            <dt class="no-margin small-6 medium-3">Email:</dt>
                            <dd class="no-margin small-6 medium-9">
                                <a href="{{ session.mailhandle }}{{ user.getEmail() }}">{{ user.getEmail() }}</a>
                            </dd>

                            <dt class="no-margin small-6 medium-3">Student ID:</dt>
                            <dd class="no-margin small-6 medium-9">{{ user.getExternalId() }}</dd>

                            <dt class="no-margin small-6 medium-3">Date of Birth:</dt>
                            <dd class="no-margin small-6 medium-9">{{ externalUser.StudentBirthDate }}</dd>

                            {# This can be a separate external user #}
                            <dt class="no-margin small-6 medium-3">Class Teacher:</dt>
                            <dd class="no-margin small-6 medium-9">{FORM_STAFF}</dd>

                            <dt class="no-margin small-6 medium-3">Year Level:</dt>
                            <dd class="no-margin small-6 medium-9">{{ externalUser.StudentYearLevel }}</dd>

                            {% if externalUser.StudentForm|trim %}
                            <dt class="no-margin small-6 medium-3">Tutor:</dt>
                            <dd class="no-margin small-6 medium-9">{TUTOR}</dd>
                            {% endif %}

                            <dt class="no-margin small-6 medium-3">House:</dt>
                            <dd class="no-margin small-6 medium-9">{{ externalUser.StudentHouseDescription }}</dd>

                            {% if externalUser.StudentForm|trim %}
                            <dt class="no-margin small-6 medium-3">Tutor Group:</dt>
                            <dd class="no-margin small-6 medium-9">{{ externalUser.StudentTutorDescription }}</dd>

                            <dt class="no-margin small-6 medium-3">Head of House:</dt>
                            <dd class="no-margin small-6 medium-9">{HOH}</dd>

                            {% else %}
                            <dt class="no-margin small-6 medium-3">Class:</dt>
                            <dd class="no-margin small-6 medium-9">{{ externalUser.StudentForm }}</dd>
                            {% endif %}

                            <dt class="no-margin small-6 medium-3">Student Type:</dt>
                            <dd class="no-margin small-6 medium-9">{STUDENT_TYPE}</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </section>
        <ul class="no-margin small-block-grid-2 medium-block-grid-4 large-block-grid-6 xlarge-block-grid-8" data-equalizer>
            <!-- BEGIN due_work -->
            <li class="no-pad"><a href="/submission/dueWork/0/{ID}" class="no-margin fat button icon-fat icon-32 icon-due-work" data-equalizer-watch>Due Work</a></li>
            <!-- END due_work -->

            <!-- BEGIN grades_button -->
            <li class="no-pad"><a href="/submission/allWork/{ID}" class="no-margin fat button icon-fat icon-32 icon-tick" data-equalizer-watch>Grades</a></li>
            <!-- END grades_button -->

            <!-- BEGIN eportfolio -->
            <li class="no-pad"><a href="/eportfolio/{ID}/profile" class="no-margin fat button icon-fat icon-32 icon-eportfolio" data-equalizer-watch>ePortfolio</a></li>
            <!-- END eportfolio -->

            <!-- BEGIN user_calendar -->
            <li class="no-pad"><a href='/calendar/full/{USER_CALENDAR_CURRENTDATE}/{ID}' class="no-margin fat button icon-fat icon-32 icon-calendar" data-equalizer-watch>Calendar</a></li>
            <!-- END user_calendar -->

            <!-- BEGIN timetable_link -->
            <li class="no-pad"><a href="/timetable/{ID}" class="no-margin fat button icon-fat icon-32 icon-timetable" data-equalizer-watch>Timetable</a></li>
            <!-- END timetable_link -->

            <!-- BEGIN boarder_leave -->
            <li class="no-pad"><a href="/modules/leave/student/{ID}" class="no-margin fat button icon-fat icon-32 icon-boarder-leave" data-equalizer-watch>Boarder Leave</a></li>
            <!-- END boarder_leave -->

            <!-- BEGIN pastoral_care -->
            <li class="no-pad"><a href="{SYNWEB_URL}/stud.aspx?id={SYNERGY_ID}" class="no-margin fat button icon-fat icon-32 icon-modify" target="_blank" data-equalizer-watch>Pastoral Care</a></li>
            <!-- END pastoral_care -->
        </ul>
    </div>
</div>

<div class="row">
    <div class="small-12 xlarge-6 xlarge-push-6 columns">
        <!-- BEGIN contact_synergy -->
        <div class="row">
            <div class="small-12 medium-6 xlarge-12 island">
                <h2 class="subheader">Contact Information</h2>
                <!-- BEGIN contact_alert -->
                <div class="alert-box alert icon-alert no-margin">
                    {CONTACT_ALERT_MESSAGE}
                </div>
                <!-- END contact_alert -->
                <section>
                    <div class="content no-pad">
                        <ul class="information-list">
                            <!-- BEGIN contact_details -->
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <div class="avatar-card">
                                        <a href="{CONTACT_LINK}">
                                            <img src="/portrait.php?userId={CONTACT_EXTERNAL_ID}&size=square64" />
                                            {CONTACT_NAME}
                                        </a>
                                        <p class="meta">{CONTACT_ROLE}</p>
                                    </div>
                                </div>
                                <nav>
                                    <a href="#" class="icon-more" data-dropdown="row-options-contact-{CONTACT_ID}"></a>
                                </nav>
                                <ul class="f-dropdown" data-dropdown-content id="row-options-contact-{CONTACT_ID}">
                                    <!-- BEGIN contact_email -->
                                    <li><a class="icon-email" href="{CONTACT_EMAIL_HREF}">{CONTACT_EMAIL}</a></li>
                                    <!-- END contact_email -->
                                    <!-- BEGIN contact_mobile -->
                                    <li><a class="icon-mobile" href="tel:{CONTACT_MOBILE_PHONE}">{CONTACT_MOBILE_PHONE}</a></li>
                                    <!-- END contact_mobile -->
                                    <!-- BEGIN contact_phone -->
                                    <li><a class="icon-mobile" href="tel:{CONTACT_OCCUP_PHONE}">{CONTACT_OCCUP_PHONE}</a></li>
                                    <!-- END contact_phone -->
                                </ul>
                            </li>

                            <!-- BEGIN spouse_details -->
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <div class="avatar-card">
                                        <a href="{SPOUSE_LINK}">
                                            <img src="/portrait.php?userId={SPOUSE_EXTERNAL_ID}&size=square64" />
                                            {SPOUSE_NAME}
                                        </a>
                                        <p class="meta">{SPOUSE_ROLE}</p>
                                    </div>
                                </div>
                                <nav>
                                    <a href="#" class="icon-more" data-dropdown="row-options-spouse-{SPOUSE_ID}"></a>
                                </nav>
                                <ul class="f-dropdown" data-dropdown-content id="row-options-spouse-{SPOUSE_ID}">
                                    <!-- BEGIN spouse_email -->
                                    <li><a class="icon-email" href="{SPOUSE_EMAIL_HREF}">{SPOUSE_EMAIL}</a></li>
                                    <!-- END spouse_email -->
                                    <!-- BEGIN spouse_mobile -->
                                    <li><a class="icon-mobile" href="tel:{SPOUSE_MOBILE_PHONE}">{SPOUSE_MOBILE_PHONE}</a></li>
                                    <!-- END spouse_mobile -->
                                    <!-- BEGIN spouse_phone -->
                                    <li><a class="icon-mobile" href="tel:{SPOUSE_OCCUP_PHONE}">{SPOUSE_OCCUP_PHONE}</a></li>
                                    <!-- END spouse_phone -->
                                </ul>
                            </li>
                            <!-- END spouse_details -->

                            <li class="actions-small-1">
                                <div class="list-item">
                                    <div class="avatar-card">
                                        <span class="icon-home icon-32"></span>
                                        {CONTACT_ADDRESS}
                                    </div>
                                </div>
                                <nav>
                                    <a class="icon-mobile" href="tel:{CONTACT_HOME_PHONE}" title="Call {CONTACT_HOME_PHONE}"></a>
                                </nav>
                            </li>
                            <!-- END contact_details -->
                        </ul>
                    </div>
                </section>
            </div>

            <div class="small-12 medium-6 xlarge-12 island">
                <!-- BEGIN emergency -->
                <h2 class="subheader">Emergency Contact Information</h2>
                <section>
                    <div class="content no-pad">
                        <!-- BEGIN edit_emergency -->
                        <!-- END edit_emergency -->

                        <ul class="information-list">
                            <!-- BEGIN emergency_contact -->
                            <li class="actions-small-1 actions-medium-2">
                                <div class="list-item">
                                    <div class="avatar-card">
                                        <span class="icon-alert icon-32"></span>
                                        {EMERGENCY_NAME}
                                    </div>
                                </div>
                                <nav>
                                    <a href="#" class="icon-more" data-dropdown="row-options-emergency-{EMERGENCY_COUNT}"></a>
                                </nav>
                                <ul class="f-dropdown" data-dropdown-content id="row-options-emergency-{EMERGENCY_COUNT}">
                                    <li class="full-width">
                                        <a class="icon-mobile" href="tel:{EMERGENCY_PHONE}">{EMERGENCY_PHONE}</a>
                                    </li>
                                    <li class="full-width">
                                        <a class="icon-mobile" href="tel:{EMERGENCY_ALT_PHONE}">{EMERGENCY_ALT_PHONE}</a>
                                    </li>
                                </ul>
                            </li>
                            <!-- END emergency_contact -->
                        </ul>
                    </div>
                    <!-- END emergency -->
                </section>
            </div>
        </div>
        <!-- END contact_synergy -->
    </div>

    <div class="small-12 xlarge-6 xlarge-pull-6 columns">
        <!-- BEGIN subject -->
        <div class="row">
            <div class="small-12 island">
                <h2 class="subheader">{SUBJECT_CLASSTYPE}</h2>
                <!-- BEGIN subject_row -->
                <!-- BEGIN subject_item -->
                <section>
                    <div class="content no-pad">
                        <ul class="subject-list">
                            <li>
                                <div class="list-item">
                                    <div class="small-12 avatar card">
                                        <a href="{SUBJECT_URL}">
                                            <span class="icon-folder icon-32"></span>
                                            {SUBJECT_NAME}
                                        </a>
                                        <p class="meta">{SUBJECT_CODE}</p>
                                    </div>
                                </div>
                            </li>
                            <!-- BEGIN subject_teacher -->
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <div class="avatar-card">
                                        <a href="/search/user/{SUBJECT_TEACHER_ID}">
                                            <img src="/portrait.php?userId={SUBJECT_TEACHER_EXTERNAL_ID}&size=square64" />
                                            {SUBJECT_TEACHER_NAME}
                                        </a>
                                        <p class="meta">Teacher</p>
                                    </div>
                                </div>
                                <nav>
                                    <a class="icon-email" href="{SUBJECT_TEACHER_EMAIL}" title="Email {SUBJECT_TEACHER_NAME}"></a>
                                </nav>
                            </li>
                            <!-- END subject_teacher -->
                        </ul>
                    </div>
                </section>
                <!-- END subject_item -->
                <!-- END subject_row -->

                <!-- BEGIN subject_mail -->
                <form action="/mail/createMail.php" method="post">
                    <div class="row">
                        <div class="small-12 columns">
                            <input type="hidden" name="replyto" value="{REPLYTO}"/>
                            <input type="hidden" name="bcc" value="{EMAILALL}"/>
                            <input type="submit" value="Email All {SUBJECT_CLASSTYPE} Teachers" />
                        </div>
                    </div>
                </form>
                <!-- END subject_mail -->
            </div>
        </div>
        <!-- END subject -->

        <!-- BEGIN group -->
        <div class="row">
            <div class="small-12 island">
                <h2 class="subheader">Groups</h2>
                <!-- BEGIN group_row -->
                <!-- BEGIN group_item -->
                <section>
                    <div class="content no-pad">
                        <ul class="subject-list">
                            <li>
                                <div class="list-item">
                                    <div class="small-12 avatar card">
                                        <a href="{GROUP_URL}">
                                            <span class="icon-folder icon-32"></span>
                                            {GROUP_NAME}
                                        </a>
                                    </div>
                                </div>
                            </li>
                            <!-- BEGIN group_teacher -->
                            <li class="actions-small-1">
                                <div class="list-item">
                                    <div class="avatar-card">
                                        <a href="/search/user/{SUBJECT_TEACHER_ID}">
                                            <img src="/portrait.php?userId={SUBJECT_TEACHER_EXTERNAL_ID}&size=square64" />
                                            {SUBJECT_TEACHER_NAME}
                                        </a>
                                        <p class="meta">Teacher</p>
                                    </div>
                                </div>
                                <nav>
                                    <a class="icon-email" href="{SUBJECT_TEACHER_EMAIL}" title="Email {SUBJECT_TEACHER_NAME}"></a>
                                </nav>
                            </li>
                            <!-- END group_teacher -->
                        </ul>
                    </div>
                </section>
                <!-- END group_item -->
                <!-- END group_row -->
            </div>
        </div>
        <!-- END group -->
    </div>
</div>
