{##
 # Parent Profile
 #
 # showEmails   bool    Spec pattern to decide whether email address is visible
 # showDetails  bool    Spec pattern to decide whether details are visible
 #}

{# Permissions #}
{% set isSuperuser = session.user.isSuperUser() %}
{% set isStaff = isSuperuser or session.user.getRole().isStaff() %}
{% set isSelf = session.user.getId() == user.getId() %}
{% set isParent = session.user.getRole().isParent() %}

{% set showButtons = isStaff or isSelf %}
{% set showTitle = user.hasPositionTitle() %}

<div class="actions-small-{{ isSuperuser ? 1 : 0 }} row">
    <div class="list-item">
        <div class="small-12 column">
            <h1 data-test="user-profile-name">{{ user.formatName() }}</h1>
        </div>
    </div>
    <nav>
        {% if routeLookupIfAuthorized('adminUser.getModify') %}
            <a href="{{ routeLookup('adminUser.getModify', {'userId': user.id}) }}" class="icon-modify" title="Modify User" data-test="user-profile-modify"></a>
        {% endif %}
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="no-pad">
            <div class="profile content">
                <div class="row no-margin">
                    {# Build a hash lookup of additional clauses and cross-reference them
                     # This list is your last opportunity to show/hide a field based on your
                     # own boolean rather than the showDetails one I used
                     #
                     # Additional visibility constraints for the **viewer's** roletype
                     # and the corresponding bool set by old twig implementation
                     #}
                    {% set additionalConstraints = {
                        'student': {
                            '_default': null,
                        },
                        'parent': {
                            '_default': null,
                        },
                        'staff': {
                            '_default': USER.role.viewParentProfile,
                        }
                    } %}

                    <div class="small-12 medium-2 columns no-pad">
                        {# If the portrait was made available and visible to you, it would normally appear
                         # as element 0 in this selected list, but you have to check anyway to be sure
                         #}
                        {% set foundPortrait = false %}

                        {% for selectedField in externalUser.data.roleTypes.fields.selected|filter(selectedField => selectedField.field == 'portrait') %}
                            {# If this field doesn't have a special boolean associated with it that might make it visible,
                             # use the prescribed default bool
                             #}
                            {% if (additionalConstraints[USER.role.type][selectedField.field] ?? additionalConstraints[USER.role.type]['_default']) %}
                                {% set foundPortrait = true %}

                                {# Portrait was available and visible to you,
                                 # and you pass the additionalConstraints listed above
                                 # Ask php to give you an image (it might not...)
                                 #}
                                {% include 'include/portrait.twig' with {
                                    user: user,
                                    render: 'profile',
                                    class: 'full-width',
                                    description: ''
                                } only %}
                            {% endif %}
                        {% endfor %}

                        {# No image? Grey man
                         # We can kind of force this with a null user...wow
                         #}
                        {% if not foundPortrait %}
                            {% include 'include/portrait.twig' with {
                                user: null,
                                render: 'profile',
                                class: 'full-width',
                                description: ''
                            } only %}
                        {% endif %}
                    </div>

                    <div class="small-12 medium-10 columns no-pad">
                        <dl class="profile">
                            {# Portrait is always element 0 at the moment: we can skip iterating
                             # that array element here, because it's rendered elsewhere.
                             #}
                            {% for selectedField in externalUser.data.roleTypes.fields.selected|filter(selectedField => selectedField.field != 'portrait') %}
                                {# Decide if the viewer can actually see this field, due to additional
                                 # permissions, privacy and configuration settings that go well beyond
                                 # the viewer's role type; if you can see it, show it. Otherwise skip it.
                                 #}
                                {% if (additionalConstraints[USER.role.type][selectedField.field] ?? additionalConstraints[USER.role.type]['_default'] ?? true) %}
                                    {# Use localisation variant from Terminology, if it exists;
                                     # otherwise use default Display As that I provided by default
                                     #}
                                    {% set fieldName = selectedField.displayAs %}

                                    {% if selectedField.terminology %}
                                        {% set fieldName = locale.translate(selectedField.terminology, false, true) %}
                                    {% endif %}

                                    {# Now render each of the flags/tuples in some manner #}

                                    {% if selectedField.value %}
                                        {# Only render a tuple if it has a meaningful value
                                         # Note that some fields require special handling (different data structures)
                                         #
                                         # The field name will always show at this point, though their values
                                         # will need special treatment somehow
                                         #}
                                        <dt class="small-4 medium-3 columns">{{ fieldName }}</dt>
                                        <dd class="small-8 medium-9 columns">
                                            {% if selectedField.field in ['spouseName'] %}
                                                <a href="/search/user/{{ spouse.id }}">{{ externalUser.SpouseTitle }} {{ externalUser.SpousePreferred }} {{ externalUser.SpouseSurname }}</a>
                                            {% elseif selectedField.field in ['email', 'SpouseEmail'] %}
                                                {# Renders a mailto: hyperlink #}
                                                <a href="{{ session.mailhandle }}{{ selectedField.value }}">{{ selectedField.value }}</a>
                                            {% else %}
                                                {# A generic tuple (key, value) pair #}
                                                {{ selectedField.value }}
                                            {% endif %}
                                        </dd>
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        </dl>
                    </div>
                </div>
            </div>
            <ul class="flex-list flex-wrap buttons">
                {% if eportfolioAuth %}
                    {% block buttons_eportfolio %}
                        <li>
                            <a href="/eportfolio/{{ user.getId() }}/profile"
                               class="icon-eportfolio"
                            >ePortfolio</a>
                        </li>
                    {% endblock buttons_eportfolio %}
                {% endif %}

                {% if showButtons %}
                    {% block buttons_calendar %}
                        <li>
                            <a href='/calendar/{{ now.getURLDate() }}/{{ user.getId() }}'
                               class="icon-calendar"
                            >{{ locale.calendar.proper }}</a>
                        </li>
                    {% endblock buttons_calendar %}
                    {% for button in customButtons %}
                        <li>
                            <a href="{{ button.url }}" title="{{ button.title }}" class="icon-{{ button.icon }} {{ button.css }}" target="{{ button.target }}">{{ button.text }}</a>
                        </li>
                    {% endfor %}
                {% endif %}
            </ul>
        </section>
    </div>
</div>
{% if isStaff and showDetails and not user.getHideContacts and students|length > 0 %}
    <div class="row">
        <div class="column small-12 medium-6 island">
            <h2 class="subheader">Students</h2>
            <section>
                <ul class="information-list">
                    {% for student in students %}
                        <li>
                            <div class="card small-12">
                                {% include 'include/portrait.twig' with {user: student} only %}
                                <a href="/search/user/{{ student.id }}"><p>{{ student.formatName }}</p></a>
                                <span class="meta">Year {{ student.year ? student.year.name : '' }}</span>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endif %}
