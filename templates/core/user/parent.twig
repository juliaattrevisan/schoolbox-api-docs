{##
 # Parent Profile
 #
 # showEmails   bool    Spec pattern to decide whether email address is visible
 # showDetails  bool    Spec pattern to decide whether details are visible
 #}

{# Permissions #}
{% set isSuperuser = session.user.isSuperUser() %}
{% set isStaff = isSuperuser or session.user.getRole().isStaff() %}
{% set isSelf = session.user.getId() == user.getId() %}
{% set isParent = session.user.getRole().isParent() %}

{% set showButtons = isStaff or isSelf %}
{% set showTitle = user.hasPositionTitle() %}

<div class="actions-small-{{ isSuperuser ? 1 : 0 }} row">
    <div class="list-item">
        <div class="small-12 column">
            <h1 data-test="user-profile-name">{{ user.formatName() }}</h1>
        </div>
    </div>
    <nav>
        {% if routeLookupIfAuthorized('adminUser.getModify') %}
            <a href="{{ routeLookup('adminUser.getModify', {'userId': user.id}) }}" class="icon-modify" title="Modify User" data-test="user-profile-modify"></a>
        {% endif %}
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="no-pad">
            <div class="profile content">
                <div class="row no-margin">
                    <div class="small-12 medium-2 columns no-pad">
                        {% include 'include/portrait.twig' with {user: user, render: 'profile', class: 'full-width', description: ''} only %}
                    </div>

                    <div class="small-12 medium-10 columns">
                        <dl class="profile">
                            {% if showTitle %}
                                <dt class="small-12 medium-3">Position Title:</dt>
                                <dd class="small-12 medium-9">
                                    {{ user.getPositionTitle() }}
                                </dd>
                            {% endif %}

                            {% if showDetails %}
                                {% block details_email %}
                                    {% if user.getEmail() %}
                                        <dt class="small-12 medium-3">Email:</dt>
                                        <dd class="small-12 medium-9">
                                            <a href="{{ session.mailhandle }}{{ user.getEmail() }}">{{ user.getEmail() }}</a>
                                        </dd>
                                    {% endif %}
                                {% endblock details_email %}
                            {% endif %}

                            {% if showDetails and not (externalUser.SilentPhoneFlag ?? false) %}
                                {% if externalUser and externalUser.HomePhone %}
                                    <dt class="small-12 medium-3">Home Phone:</dt>
                                    <dd class="small-12 medium-9">
                                        <a href="tel:{{ externalUser.HomePhone }}">{{ externalUser.HomePhone }}</a>
                                    </dd>
                                {% endif %}
                            {% endif %}

                            {% if showDetails and not (externalUser.SilentMobilePhoneFlag ?? false) %}
                                {% if externalUser and externalUser.MobilePhone %}
                                    <dt class="small-12 medium-3">Mobile Phone:</dt>
                                    <dd class="small-12 medium-9">
                                        <a href="tel:{{ externalUser.MobilePhone }}">{{ externalUser.MobilePhone }}</a>
                                    </dd>
                                {% endif %}
                            {% endif %}

                            {% if showDetails and not (externalUser.SilentPhoneFlag ?? false) %}
                                {% if externalUser and externalUser.WorkPhone %}
                                    <dt class="small-12 medium-3">Work Phone:</dt>
                                    <dd class="small-12 medium-9">
                                        <a href="tel:{{ externalUser.WorkPhone }}">{{ externalUser.WorkPhone }}</a>
                                    </dd>
                                {% endif %}
                            {% endif %}

                            {% if showDetails %}
                                {% block home_address %}
                                {% endblock home_address %}
                                <dt class="small-12 medium-3">Role:</dt>
                                <dd class="small-12 medium-9">{{ user.role.name }}</dd>
                                {% if externalUser and externalUser.SpouseDirectoryIncludeFlag and externalUser.SpouseSurname and (spouse is null or not spouse.getHideContacts) %}
                                    <dt class="small-12">Partner:</dt>
                                    <dd class="small-12">
                                        <div class="card small-12">
                                            {% if spouse %}
                                                <a href="/search/user/{{ spouse.id }}">
                                                    {% include 'include/portrait.twig' with {user: spouse} only %}
                                                    <p>{{ externalUser.SpouseTitle }} {{ externalUser.SpousePreferred }} {{ externalUser.SpouseSurname }}</p>
                                                </a>
                                            {% else %}
                                                {% include 'include/portrait.twig' with {externalId: externalUser.SpouseID} only %}
                                                <p>{{ externalUser.SpouseTitle }} {{ externalUser.SpousePreferred }} {{ externalUser.SpouseSurname }}</p>
                                            {% endif %}

                                            {% if externalUser.SpouseEmail %}
                                                <p class="meta">
                                                    <a href="{{ session.mailhandle }}{{ externalUser.SpouseEmail }}">{{ externalUser.SpouseEmail }}</a>
                                                </p>
                                            {% endif %}

                                            {% if externalUser.SpouseMobilePhone %}
                                            <p class="meta">
                                                <a href="tel:{{ externalUser.SpouseMobilePhone }}">{{ externalUser.SpouseMobilePhone }}</a>
                                            </p>
                                            {% endif %}
                                        </div>
                                    </dd>
                                {% endif %}
                            {% endif %}
                        </dl>
                    </div>
                </div>
            </div>
            <ul class="flex-list flex-wrap buttons">
                {% if eportfolioAuth %}
                    {% block buttons_eportfolio %}
                        <li>
                            <a href="/eportfolio/{{ user.getId() }}/profile"
                               class="icon-eportfolio"
                            >ePortfolio</a>
                        </li>
                    {% endblock buttons_eportfolio %}
                {% endif %}

                {% if showButtons %}
                    {% block buttons_calendar %}
                        <li>
                            <a href='/calendar/{{ now.getURLDate() }}/{{ user.getId() }}'
                               class="icon-calendar"
                            >{{ locale.calendar.proper }}</a>
                        </li>
                    {% endblock buttons_calendar %}
                    {% for button in customButtons %}
                        <li>
                            <a href="{{ button.url }}" title="{{ button.title }}" class="icon-{{ button.icon }} {{ button.css }}" target="{{ button.target }}">{{ button.text }}</a>
                        </li>
                    {% endfor %}
                {% endif %}
            </ul>
        </section>
    </div>
</div>
{% if isStaff and showDetails and not user.getHideContacts and students|length > 0 %}
    <div class="row">
        <div class="column small-12 medium-6 island">
            <h2 class="subheader">Students</h2>
            <section>
                <ul class="information-list">
                    {% for student in students %}
                        <li>
                            <div class="card small-12">
                                {% include 'include/portrait.twig' with {user: student} only %}
                                <a href="/search/user/{{ student.id }}"><p>{{ student.formatName }}</p></a>
                                <span class="meta">Year {{ student.year ? student.year.name : '' }}</span>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endif %}
