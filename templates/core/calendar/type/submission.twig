{% extends 'calendar/type/_base.twig' %}

{% block eventBubbleButtons %}
<div>
    {% if event.getIsAssessment() %}
        <a class="button icon-quiz" href="/assess/intro/{{ event.submissionBoxId }}">Start Quiz</a>
    {% else %}
        {% if renderer.isEditable() %}
            <a class="button icon-due-work" href="/submission/viewSubmission/{{ event.eventID }}">View Submissions</a>
            <a class="button icon-modify" href="/submission/createSubmission/modify/{{ event.eventID }}">Modify</a>
        {% else %}
            <a class="button icon-due-work" href="/submission/submissionHistory/{{ event.eventID }}/{{ renderer.viewer.id }}">View Details</a>
        {% endif %}
    {% endif %}
</div>
{% endblock eventBubbleButtons %}
