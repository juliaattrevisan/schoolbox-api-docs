{% extends 'calendar/type/_base.twig' %}

{% block eventBubbleButtons %}
<div>
    {% if event.getIsAssessment() %}
        <a class="btn up-arrow float-left" href="/assess/intro/{{ event.submissionBoxId }}"><span></span>Start Quiz</a>
    {% else %}
        {%  if renderer.isEditable()  %}
            <a class="btn eyeball float-left" href="/submission/viewSubmission/{{ event.eventID }}"><span></span>View Submissions</a>
            <a class="btn modify float-left" href="/submission/createSubmission/modify/{{ event.eventID }}"><span></span>Modify</a>
        {% else %}
            <a class="btn eyeball float-left" href="/submission/submissionHistory/{{ event.eventID }}/{{ renderer.viewer.id }}"><span></span>View Details</a>
        {% endif %}
    {% endif %}
</div>
{% endblock eventBubbleButtons %}
