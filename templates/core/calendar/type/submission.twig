{% extends 'calendar/type/_base.twig' %}

{% block eventBubbleButtons %}
<div>
    {% if renderer.user.role.type == 'staff' %}
        {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getStatus', {assessmentId: event.assessment.id }) %}
    {% else %}
        {% set viewRoute = routeLookupIfAuthorized('learningAssessment.getSummary', {assessmentId: event.assessment.id, assessment: event.assessment, studentId: renderer.user.id, student: renderer.user }) %}
    {% endif %}
    {% if viewRoute %}
        <a class="button icon-due-work" href="{{ viewRoute }}">View More Details</a>
    {% endif %}
    {% set modifyRoute = routeLookupIfAuthorized('learningAssessment.getUpdateAssessmentForm', {assessmentId: event.assessment.id, assessment: event.assessment}) %}
    {% if modifyRoute %}
        <a class="button icon-modify" href="{{ modifyRoute }}">Modify</a>
    {% endif %}
</div>
{% endblock eventBubbleButtons %}
