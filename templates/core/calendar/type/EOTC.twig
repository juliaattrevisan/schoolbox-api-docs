{% extends 'calendar/type/_base.twig' %}

{% block eventSpan %}
<div class="small-4 column">
    {% if not event.AllDay %}
        {{ event.startTime.timeOnly }} : {{ event.endTime.timeOnly }}
    {% endif %}
        &nbsp;
</div>
{% endblock eventSpan %}

{% block modifyLink %}
    <a class="button icon-modify" href="/modules/eotc/manage/modify?eventID={{ event.eventId }}{{ returnStr }}">Modify</a>
{% endblock %}

{% block deleteButton %}
    {# Currently it's not possible to delete EOTC events so this is blank. #}
{% endblock %}