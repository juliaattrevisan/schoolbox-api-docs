{% set augmentedId = random(10000000000) %}

<li data-reveal-id="modal{{ event.getEventId() }}{{ augmentedId }}" class="row {{ event.getEventClasses() }} {% if renderer.isTranslucent() %}translucent{% endif %}" style="background-color:{{ event.colour }}">
    {% block eventSpan %}
    <div class="small-4 column" >
        {# raw HTML reluctantly sanctioned - getEventSpan() should be updated to not output htmlentities #}
        {{ event.getEventSpan()|raw }}&nbsp;
    </div>
    {% endblock eventSpan %}

    {% block eventTitle %}

    <div class="small-8 column">
        {{ event.title }}
        <span class="right" style="background-color:{{ event.colour }}">
            {% if event.attendance %}
                A
            {% endif %}
        </span>
    </div>
    {% endblock eventTitle %}

    <div id="modal{{ event.getEventId() }}{{ augmentedId }}" class="reveal-modal" data-reveal>
        {% block eventBubble %}
            {% block eventBubbleSummary %}
            <h2>
                <a href="{{ routeLookup('calendarEvent.getEvent', {eventId: event.eventId}) }}" title="Go to event page">{{ event.title }}</a>
            </h2>

            <ul class="meta">
                <li class="icon-calendar" title="Date"><time>{{ event.getFullDate() | raw }}</time></li>

                {% if event.eventType %}
                <li class="icon-list" title="Type">{{ event.eventType }}</li>
                {% endif %}

                {% if event.location %}
                <li class="icon-location" title="Location">{{ event.location }}</li>
                {% endif %}

                {% block eventBubbleMeta %}
                {% if event.authorName %}
                <li class="icon-staff-students" title="Author">Posted by
                    <a href="/search/user/{{ event.authorId }}">{{ event.authorName }}</a>
                </li>
                {% endif %}

                {% if event.categoryId and event.categoryName %}
                <li class="icon-home" title="Homepage"><a href='/homepage/{{ event.categoryId }}'>{{ event.categoryName }}</a></li>
                {% endif %}

                {% if event.attendance %}
                <li class="icon-list" title="Attendance">Attendance {{ renderer.attendanceStatus() }}</li>
                {% endif %}
                {% endblock eventBubbleMeta %}
            </ul>

            <article>{{ event.detail|purify}}</article>
            {% endblock eventBubbleSummary %}

            {% block eventBubbleButtons %}
            <div class="component-action">
                <section>
                {% if event.attendance %}
                    <form method="post" data-rsvp-form>
                        <input name="eventId" type="hidden" value="{{ event.eventId }}">
                        {% if renderer.attendanceStatus() %}
                        <a class="button" data-attendance-request href="#">Unattend</a>
                        {% else %}
                        <a class="button" data-attendance-request href="#">RSVP</a>
                        {% endif %}
                    </form>

                    {%if event.isEditable %}
                    <a class="button" href="/calendar/attendance/list/{{ event.eventId }}">View Attendees</a>
                    {% endif %}
                {% endif %}
                {% if event.isEditable %}
                    {% block modifyLink %}
                    <a class="button" href="/calendar/modify.php?eventID={{ event.eventId }}{{ returnStr }}">Modify</a>
                    {% endblock %}
                    {% block deleteButton %}
                    <a class="button" {{ event.seriesId() ? 'data-delete-series' : 'data-delete-single' }} id="delete-event-{{ event.eventId }}"
                        data-event-id="{{ event.eventId }}" data-event-type="event">Delete</a>
                    {% endblock %}
                {% endif %}
                </section>
            </div>
            {% endblock eventBubbleButtons %}
        {% endblock eventBubble %}

        <a class="close-reveal-modal">&#215;</a>
    </div>
    {% block deleteUrls %}
        <input type="hidden" id="delete-single-{{ event.eventId }}" value="/calendar/modifyForm.php?action=Delete&id={{ event.eventId }}{{ returnStr }}">
        {% if event.seriesId() %}
            <input type="hidden" id="delete-series-self-{{ event.eventId }}" value="/calendar/modifyForm.php?action=Delete&id={{ event.eventId }}{{ returnStr }}&efficacy=self">
            <input type="hidden" id="delete-series-all-{{ event.eventId }}" value="/calendar/modifyForm.php?action=Delete&id={{ event.eventId }}{{ returnStr }}&efficacy=series">
        {% endif %}
    {% endblock deleteUrls %}
</li>
