{% set augmentedId = random(10000000000) %}

<li class="row {{ event.getEventClasses() }} {% if renderer.isTranslucent() %}translucent{% endif %}">
    {% block eventSpan %}
    <div class="three-column">
        {{ event.getEventSpan()|raw }}
    </div>
    {% endblock eventSpan %}

    {% block eventTitle %}
    <div class="nine-column" data-dropdown="contentDrop{{ event.getEventId() }}{{ augmentedId }}" style="background-color:{{ event.colour }}">
        {{ event.title }}

        <span class="right" style="background-color:{{ event.colour }}">
            {% if event.attendance %}
                A
            {% endif %}
        </span>
    </div>
    {% endblock eventTitle %}


    <div class="f-dropdown content content-drop medium" data-dropdown-content="" id="contentDrop{{ event.getEventId() }}{{ augmentedId }}">
        {% block eventBubble %}

            {% block eventBubbleSummary %}
            <h3>{{ event.title }}</h3>

            <ul class="meta">
                <li class="icon-calendar"><time>{{ event.getFullDate()|raw }}</time></li>

                {% if event.eventType %}
                <li class="icon-event-type">{{ event.eventType }}:</li>
                {% endif %}

                {% if event.location %}
                <li class="icon-location">{{ event.location }}</li>
                {% endif %}
            </ul>

            <article>{{ event.detail|purify}}</article>
            {% endblock eventBubbleSummary %}

            {% block eventBubbleMeta %}
            <div class="created meta">
                {% if event.authorName %}
                Posted by <a href="/search/user/{{ event.authorId }}">{{ event.authorName }}</a>
                {% endif %}

                {% if event.category %}
                in <a href='/homepage/{{ event.categoryId }}'>{{ event.categoryName }}</a>
                {% endif %}
            </div>

            {% if event.attendance %}
            <p class="meta">Attendance {{ renderer.attendanceStatus() }}</p>
            {% endif %}
            {% endblock eventBubbleMeta %}











            {% block eventBubbleButtons %}
            <div>
                {% if event.attendance %}
                    <form method="post">
                        <input name="event[id]" type="hidden" value="{{ event.eventId }}">
                        {% if renderer.attendanceStatus() %}
                        <a class="button icon-close" data-attendance-request href="#">Unattend</a>
                    {% else %}
                        <a class="button icon-approve" data-attendance-request href="#">RSVP</a>
                        {% endif %}
                    </form>

                    {%if event.isEditable %}
                    <a class="button icon-group" href="/calendar/attendance/list/{{ event.eventId }}">Attendees</a>
                    {% endif %}
                {% endif %}
                {% if event.isEditable %}
                <a class="button icon-modify" href="/calendar/modify.php?eventID={{ event.eventId }}&returnTo=calendar">Modify</a>
                <a class="button icon-delete" href="/calendar/modifyForm.php?action=Delete&id={{ event.eventId }}&returnTo=calendar" onclick="return(confirm('Are you sure you wish to delete this event?'))">Delete</a>
                {% endif %}
            </div>
            {% endblock eventBubbleButtons %}
        {% endblock eventBubble %}
    </div>
</li>
