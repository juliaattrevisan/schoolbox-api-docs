{% extends 'calendar/type/_base.twig' %}

{% block eventBubbleSummary %}
<h3>{{ event.title }}</h3>
<ul class="meta">
    {# raw HTML NOT sanctioned - this should never be HTML, so it shouldn't be necessary #}
    <li class="icon-calendar" title="Booking time"><time>{{ event.getFullDate()|raw }}</time></li>
    <li class="icon-location" title="Resource">{{ event.location }}</li>
    <li class="icon-staff-students" title="Requester">Requested by <a href="/search/user/{{ event.authorId }}">{{ event.authorName }}</a></li>
    <li class="icon-resource-booking" title="Resource"><a href="{{ routeLookup('resourceItem.read', {id: event.booking.resource.id}) }}?date={{ event.getStartTime().getURLDate() }}">{{ event.booking.resource.name }}</a></li>
    {% if event.categoryId %}
    <li class="icon-folder" title="Category"><a href='/resource-booking/item?category={{ event.booking.resource.category.id }}'>{{ event.category }}</a></li>
    {% endif %}
</ul>
<article>{{ event.detail|purify}}</article>
{% if event.booking.relatedBookingList is iterable %}
    <h3>Related Bookings</h3>
    <ul>
        {% for relatedBooking in event.booking.relatedBookingList %}
            <li>
                ({{ relatedBooking.status.name }}) <a href="{{ routeLookup('resourceItem.read', {id: relatedBooking.resource.id}) }}?date={{ event.getStartTime().getURLDate() }}">{{ relatedBooking.resource.name }}</a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
{% endblock eventBubbleSummary %}

{% block eventBubbleButtons %}
<div>
    {% if renderer.getEditURL() != '' %}
    <a class="button icon-modify" href="{{ renderer.getEditURL() }}">Modify</a>
    {% endif %}
    {% if renderer.getCancelURL() != '' %}
        <a class="button icon-delete" {{ event.booking.event.seriesId() ? 'data-delete-series' : 'data-delete-single' }} id="delete-event-{{ event.eventId }}"
           data-event-id="{{ event.eventId }}" data-event-type="booking">Delete</a>
    {% endif %}
    {% if renderer.getApproveURL() != '' %}
    <a class="button icon-approve" href="{{ renderer.getApproveURL() }}">Approve</a>
    {% endif %}
    {% if renderer.getRejectURL() != '' %}
    <a class="button icon-close" href="{{ renderer.getRejectURL() }}">Reject</a>
    {% endif %}
</div>
{% endblock eventBubbleButtons %}
    {% block deleteUrls %}
        <input type="hidden" id="delete-single-{{ event.eventId }}" value="{{ renderer.getCancelURL() }}">
        {% if event.booking.event.seriesId() %}
            <input type="hidden" id="delete-series-self-{{ event.eventId }}" value="{{ renderer.getCancelURL() }}">
            <input type="hidden" id="delete-series-all-{{ event.eventId }}" value="{{ renderer.getCancelURL() }}?efficacy=series&seriesId={{ event.booking.event.seriesId() }}#">
        {% endif %}
    {% endblock deleteUrls %}
