<li class="row {{ event.getEventClasses() }}">
    <div class="eventListing">
        <div class="small-6 columns">
            <strong>{{ event.getEventSpan()|raw }}</strong>
        </div>
        <div class="small-6 columns">
        <span style="background-color:{{ event.colour }}">
            {{ event.title }}
            {% if event.attendance %}
                <span class="float-right">A</span>
            {% endif %}
        </span>
        </div>
    </div>

    <div class="hidden-fields clearfix">
        <h3>{{ event.getTitle() }}</h3>
        <h4>{{ event.getFullDate()|raw }}</h4>
        <em>{{ event.getCategory() }}</em>

        <p class="wysiwyg">{{ event.detail|purify}}</p>

        <div class="created meta">
            {% if event.authorName %}
                Requested by <a href="/search/user/{{ event.authorId }}">{{ event.authorName }}</a>
            {% endif %}
        </div>
        {% if event.booking.relatedBookingList is iterable %}
            <br />
            <h3>Related Bookings</h3>
            <ul class="relatedBookings">
                {% for relatedBooking in event.booking.relatedBookingList %}
                    <li>
                        ({{ relatedBooking.status.name }}) <a href="{{ routeLookup('resourceItem.read', {id: relatedBooking.resource.id}) }}?date={{ event.getStartTime().getURLDate() }}">{{ relatedBooking.resource.name }}</a>
                    </li>
                {% endfor %}
            </ul>
        {%  endif %}
        <div>

            {% if renderer.getEditURL() != '' %}
            <a class="btn float-left modify booking-modify" href="{{ renderer.getEditURL() }}"><span></span>Modify</a>
            {% endif %}
            {% if renderer.getCancelURL() != '' %}
            <a class="btn float-left delete booking-cancel" href="{{ renderer.getCancelURL() }}"><span></span>Delete</a>
            {% endif %}
            {% if renderer.getApproveURL() != '' %}
            <a class="btn float-left tick booking-approve" href="{{ renderer.getApproveURL() }}"><span></span>Approve</a>
            {% endif %}
            {% if renderer.getRejectURL() != '' %}
            <a class="btn float-left tick booking-reject" href="{{ renderer.getRejectURL() }}"><span></span>Reject</a>
            {% endif %}

        </div>

    </div>
</li>