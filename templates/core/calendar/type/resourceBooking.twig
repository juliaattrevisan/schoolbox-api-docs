<li class="{{ event.getEventClasses() }}">
    <span class="eventListing">
        <strong>{{ event.getEventSpan()|raw }}</strong>
        <span style="background-color:{{ event.colour }}">{{ event.title }}
            {% if event.attendance %}
                <span class="float-right">A</span>
            {% endif %}
        </span>
    </span>

    <div class="hidden-fields clearfix">
        <h3>{{ event.getTitle() }}</h3>
        <h4>{{ event.getFullDate()|raw }}</h4>
        <em>{{ event.getCategory() }}</em>

        <p class="wysiwyg meta">{{ event.detail|purify}}</p>
        <div class="created">
            {% if event.authorName %}
                Requested by <a href="/search/user/{{ event.authorId }}">{{ event.authorName }}</a>
            {% endif %}
        </div>
        <ul class="relatedBookings">
            {% for relatedBooking in event.booking.relatedBookingList %}
            <li>
                ({{ relatedBooking.status.name }}) {{ relatedBooking.resource.name }}
                <a href="{{ routeLookup('resourceItem.read', {id: relatedBooking.item.id}) }}?date={{ event.getURLDate() }}">Review</a>
            </li>
            {% endfor %}
        </ul>
        <div>
            {% if renderer.getEditURL() != '' %}
            <a class="btn float-right modify booking-modify" href="{{ renderer.getEditURL() }}"><span></span>Modify</a>
            {% endif %}
            {% if renderer.getCancelURL() != '' %}
            <a class="btn float-right delete booking-cancel" href="{{ renderer.getCancelURL() }}"><span></span>Delete</a>
            {% endif %}
            {% if renderer.getApproveURL() != '' %}
            <a class="btn float-right tick booking-approve" href="{{ renderer.getApproveURL() }}"><span></span>Approve</a>
            {% endif %}
            {% if renderer.getRejectURL() != '' %}
            <a class="btn float-right tick booking-reject" href="{{ renderer.getRejectURL() }}"><span></span>Reject</a>
            {% endif %}

        </div>

    </div>
</li>