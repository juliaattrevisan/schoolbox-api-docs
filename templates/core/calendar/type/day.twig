<li class="{{ event.eventClasses() }}">
    <span class="eventListing">
         {% if not event.startTime.isAtStartOfDay() %}
        <strong>{{ event.getEventSpan()|raw }}</strong>
        {% endif %}
        <span style="background-color:{{ event.colour }}">{{ event.title }}
            {% if event.attendance %}
            <span class="float-right">A</span>
            {% endif %}
        </span>
    </span>

    <div class="hidden-fields clearfix">
        <h3>{{ event.title }}</h3>
        <h4>
            {% if event.eventType %}
            {{ event.eventType }}:
            {% endif %}
            {{ event.getFullDate()|raw }}</h4>
        <em>{{ event.location }}</em>

        <p class="wysiwyg meta">
            {{ event.detail|purify}}

        <div class="created">
            {% if event.author %}
            Posted by <a href="/search/user/{{ event.authorId }}">{{ event.author }}</a>
            {% endif %}

            {% if event.category %}
            in <a href='/homepage/{{ event.categoryId }}'>{{ event.categoryName }}</a>
            {% endif %}
        </div>
        </p>
        {% if event.attendance %}
        <p class="meta">Attendance Status: {{ renderer.attendanceStatus() }}</p>
        {% endif %}
        <div>
            {% if event.attendance %}
                <form method="post">
                    <input name="event[id]" type="hidden" value="{{ event.eventId }}">
                    {% if event.renderer.attendanceStatus() %}
                    <a class="btn modify float-left attendance-request" href="#"><span></span>Not Going</a>
                    {% else %}
                    <a class="btn modify float-left attendance-request" href="#"><span></span>RSVP</a>
                    {% endif %}
                </form>

                {%if event.isEditable %}
                <a class="btn groups float-left"
                   href="/calendar/attendance/list/{{ event.eventId }}"><span></span>Attendees</a>
                {% endif %}
            {% endif %}
            {% if event.isEditable %}
            <a class="btn modify float-left" href="/calendar/modify.php?eventID={{ event.eventId }}&returnTo=calendar"><span></span>Modify</a>
            <a class="btn delete float-left" href="/calendar/modifyForm.php?action=Delete&id={{ event.eventId }}&returnTo=calendar" onclick="return(confirm('Are you sure you wish to delete this event?'))"><span></span>Delete</a>
            {% endif %}
        </div>

    </div>
</li>