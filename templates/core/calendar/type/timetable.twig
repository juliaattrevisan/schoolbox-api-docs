{% extends 'calendar/type/_base.twig' %}


{% block eventBubbleSummary %}
    <h3>{{ event.title }}</h3>
    <ul class="meta">
        {# raw HTML reluctantly sanctioned - getEventSpan() should be updated to not output htmlentities #}
        <li class="icon-calendar" title="Date">{% if event.allDay %} {{ event.date | raw }} {% else %} {% if  event.periodName | length %} {{ event.periodName }}: {% endif %}<time>{{ event.eventSpan|raw }}</time> {% endif %}</li>

        {% if event.location %}
            <li class="icon-location" title="Location">{{ event.location }}</li>
        {% endif %}
    </ul>
{% endblock eventBubbleSummary %}


{% block eventBubbleButtons %}
<div>

    {% if event.categoryId > 0 %}
        <a class="button icon-home" href="/homepage/{{ event.categoryId }}" title="Go to homepage">Go to homepage</a>
    {% endif %}

    {% if renderer.showAttendanceLink() %}
        {% set encodedClass = event.code|url_encode|url_encode|url_encode %}
        {% if event.campus is not empty %}
            {% set classLink = event.campus ~ '/' ~ encodedClass %}
        {% else %}
            {% set classLink = '0/' ~ encodedClass %}
        {% endif %}

        <a class="button icon-class-list" href="/modules/attendance/modify/{{ classLink }}/{{ event.getStartTime.getDatabaseDate() }}/{{ event.attendancePeriods | join(',') }}/{{ event.timetableCode }}/{{ event.fileType }}" title="Mark Attendance">Mark Attendance</a>
    {% endif %}

</div>
{% endblock eventBubbleButtons %}
