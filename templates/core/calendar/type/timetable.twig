<li class="{{ event.getEventClasses() }} {% if renderer.isTranslucent() %}translucent{% endif %}">
    <span class="eventListing">
        <strong>{{ event.getEventSpan()|raw }}</strong>
        <span style="background-color:{{ event.colour }}">{{ event.title }}
            {% if event.attendance %}
            <span class="float-right">A</span>
            {% endif %}
        </span>
    </span>

    <div class="hidden-fields clearfix">
        <h3>{{ event.title }}</h3>
        <h4>
            {% if event.eventType %}
            {{ event.eventType }}:
            {% endif %}
            {{ event.getFullDate()|raw }}</h4>
        <p class="location">{{ event.location }}</p>
        <div>
            {% if event.categoryId > 0 %}
            <a class="btn house float-left" href="/homepage/{{ event.categoryId }}"><span></span>Go To Homepage</a>
            {% endif %}
        </div>
    </div>

</li>