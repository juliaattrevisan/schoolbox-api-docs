<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/core/core.css?v={{ config.site_version }}" />
{% if config.advanced_ui_enabled %}
<link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/core/sbx-core.css?v={{ config.site_version }}" />
<style>
@font-face {
    font-family: "schoolbox";
    src:
        url("{{ CDN_PREFIX }}/fonts/sbx-icons.ttf?ttda0c") format("truetype"),
        url("{{ CDN_PREFIX }}/fonts/sbx-icons.woff?ttda0c") format("woff"),
        url("{{ CDN_PREFIX }}/fonts/sbx-icons.svg?ttda0c#sbx-icons") format("svg");
    font-weight: normal;
    font-style: normal;
    font-display: block;
}
</style>
{% else %}
<style>
@font-face {
    font-family: "schoolbox";
    src:
        url("{{ CDN_PREFIX }}/fonts/schoolbox.ttf?ttda0c") format("truetype"),
        url("{{ CDN_PREFIX }}/fonts/schoolbox.woff?ttda0c") format("woff"),
        url("{{ CDN_PREFIX }}/fonts/schoolbox.svg?ttda0c#schoolbox") format("svg");
    font-weight: normal;
    font-style: normal;
    font-display: block;
}
</style>
{% endif %}
<link rel="stylesheet" type="text/css" href="/css/core/skin.css.php?v={{ config.site_version }}&t={{ config.skin_config_last_modified }}" />
