<link rel="stylesheet" type="text/css" href="/css/core/defaults.css?v={{ config.site_version }}" />
{% autoescape 'css' %}
<style type="text/css">
    :root {
        /* Translate config colors to HSL values */
        {# TODO consider moving this to a PHP-generated CSS file #}
        {# can use \ImagickPixel for HSL conversion, as that is guaranteed to exist with Imagine existing #}
        {#--navigation-foreground:        {{ config.skin_colour_navigation_foreground }};#}
        --navigation-foreground-h: 205;
        --navigation-foreground-s: 53%;
        --navigation-foreground-l: 67.5%;
        --navigation-foreground-a: 100%;
        --navigation-foreground:   hsla(
                var(--navigation-foreground-h),
                var(--navigation-foreground-s),
                var(--navigation-foreground-l),
                var(--navigation-foreground-a)
        );

        {#--navigation-background:        {{ config.skin_colour_navigation_background }};#}
        --navigation-background-h: 205;
        --navigation-background-s: 100.0%;
        --navigation-background-l: 34.5%;
        --navigation-background-a: 100%;
        --navigation-background:   hsla(
                var(--navigation-background-h),
                var(--navigation-background-s),
                var(--navigation-background-l),
                var(--navigation-background-a)
        );

        {#--navigation-hover:             {{ config.skin_colour_navigation_hover }};#}
        --navigation-hover-h: 205;
        --navigation-hover-s: 70%;
        --navigation-hover-l: 43%;
        --navigation-hover-a: 100%;
        --navigation-hover:   hsla(
                var(--navigation-hover-h),
                var(--navigation-hover-s),
                var(--navigation-hover-l),
                var(--navigation-hover-a)
        );

        --off-canvas-foreground:        {{ config.skin_colour_offcanvas_foreground }};
        --off-canvas-background:        {{ config.skin_colour_offcanvas_background }};
        --off-canvas-hover:             {{ config.skin_colour_offcanvas_hover }};
        --accounts-menu-bg-colour:      {{ config.accounts_menu_bg_colour }};
        --accounts-menu-text-colour:    {{ config.accounts_menu_text_colour }};
        --accounts-menu-hover-colour:   {{ config.accounts_menu_hover_colour }};
        --content-ui-foreground:        {{ config.skin_colour_content_ui_foreground }};
        --content-ui-background:        {{ config.skin_colour_content_ui_background }};
        --content-ui-hover:             {{ config.skin_colour_content_ui_hover }};
        --content-ui-selected:          {{ config.skin_colour_content_ui_selected }};
        --content-ui-submit-foreground: {{ config.skin_colour_content_ui_submit_foreground }};
        --content-ui-submit-background: {{ config.skin_colour_content_ui_submit_background }};
        --accent-foreground:            {{ config.skin_colour_accent_foreground }};
        --accent-background:            {{ config.skin_colour_accent_background }};
        --accent-hover:                 {{ config.skin_colour_accent_hover }};
        --logo-background:              {{ config.skin_colour_logo_background }};
        --body-bg:                      {{ config.skin_colour_body_bg }};
        --button-input-scale:           {{ config.skin_button_input_scale }};
        --login-form-background-color:  {{ config.skin_colour_login_background }};
        --form-border-color:            {{ config.skin_colour_form_input_border_color }};
        --form-bg-hover-color:          {{ config.skin_colour_form_background_hover_color }};
    }
    {{ skin_custom_css | raw }}
</style>
{% endautoescape %}
<link rel="stylesheet" type="text/css" href="/css/{{ config.site_location }}/chrome-foundation.css?v={{ config.site_version }}" />
