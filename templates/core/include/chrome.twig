<!DOCTYPE html>
<html xmlns:m="http://www.w3.org/1998/Math/MathML" lang="en">
<!--  Copyright {{ NOW.year }} Schoolbox Pty Ltd -->
<!--  Visit us at https://schoolbox.com.au/ -->
<head>
    <title>{{ config.title }}{{ chrome.title ? (' - ' ~ chrome.title) : '' }}</title>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="Content-Language" content="en-au" />
    <meta name="author" content="Schoolbox Pty Ltd"/>
    {% if not config.web_crawlers_enabled %}<meta name="robots" content="noindex">{% endif %}
    {% if config.pwa_enable %}
        <link rel="manifest" href="/manifest">
    {% endif %}
    <meta itemprop="user.externalId" content="{{ user.current.externalId }}" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="{{ config.title }}">
    <meta name="theme-color" content="{{ config.skin_colour_navigation_background }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-title" content="{{ config.title }}">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="icon" href="/images/logo.php?logo=skin_favicon&size=favicon"/>
    <link rel="apple-touch-icon" sizes="57x57" href="/images/logo.php?logo=skin_favicon&size=apple57">
    <link rel="apple-touch-icon" sizes="60x60" href="/images/logo.php?logo=skin_favicon&size=apple60">
    <link rel="apple-touch-icon" sizes="72x72" href="/images/logo.php?logo=skin_favicon&size=apple72">
    <link rel="apple-touch-icon" sizes="76x76" href="/images/logo.php?logo=skin_favicon&size=apple76">
    <link rel="apple-touch-icon" sizes="114x114" href="/images/logo.php?logo=skin_favicon&size=apple114">
    <link rel="apple-touch-icon" sizes="120x120" href="/images/logo.php?logo=skin_favicon&size=apple120">
    <link rel="apple-touch-icon" sizes="144x144" href="/images/logo.php?logo=skin_favicon&size=apple144">
    <link rel="apple-touch-icon" sizes="152x152" href="/images/logo.php?logo=skin_favicon&size=apple152">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo.php?logo=skin_favicon&size=apple180">

    {% include 'include/skin.twig' with { config: config } only %}
    <link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/vendors/fullcalendar/datepicker.css?v={{ config.site_version }}" />

    {% if tour.data is defined and not user.impersonated %}
    {% autoescape 'js' %}
    <script>
        window.tourData = {{ tour.data|json_encode|raw }};
    </script>
    {% endautoescape %}
    {% endif %}

    {# Include iframely everywhere as it is needed to render oembeds and media wherever content from a ckeditor can be shown #}
    <script src="https://cdn.iframe.ly/embed.js?cancel=0&key={{ config.iframely_license_key_public ?? null }}"></script>

    {% autoescape 'js' %}
    <script>
        {# Global properties for SchoolBox. Load these before main.js to ensure they are available and can be used throughout parts of those scripts.
         # Types for these should be maintained in /types/index.d.ts where possible.
         # More properties are added by @js/global/sbProps.ts while main.js is loaded.
         #}

        // Date formats (global variable)
        window.siteLocation = "{{ config.site_school_code }}";

        window.dateDisplayFormats = {
            dayjs:          "{{ config.date_local | dayjsFormat }}",
            dayjsDatetime:  "{{ (config.date_local ~ ' ' ~ config.date_time) | dayjsFormat }}",
            dayjsDateLong:  "{{ config.date_long | dayjsFormat }}",
            dayjsTime:      "{{ config.date_time | dayjsFormat}}",
            localDate:         "{{ config.date_local }}",
            localDateTime:     "{{ config.date_local ~ ' ' ~ config.date_time }}",
            calendarStartTime: "{{ config.calendar_start_time }}",
            localTime:         "{{ config.date_time }}",
        };

        // This schoolboxUser is here for custom scripts.
        window.schoolboxUser            = {{ user.current | json_encode | raw }};
        schoolboxUser.name           = "{{ user.current.formatName }}";
        schoolboxUser.email          = "{{ user.current.email }}";
        schoolboxUser.year           = "{{ user.current.year.name ?? '' }}";
        schoolboxUser.role           = {{ user.current.role | json_encode | raw }};
        schoolboxUser.impersonated   = Boolean('{{ user.impersonated }}');
        schoolboxUser.communityLogin = Boolean('{{ user.communityLogin }}');

        // Reluctantly add the CDN prefix and site version as global JS variables
        window.cdnPrefix = "{{ CDN_PREFIX }}";
        window.siteVersion = "{{ config.site_version }}";

        // Ensure window.sbProps exists before we try to add to it
        window.sbProps = window.sbProps || {};

        window.sbProps.imageLightboxLicenseKey = "{{ config.image_lightbox_license_key }}";
        window.sbProps.ckeditor5LicenseKey = "{{ config.ckeditor5_license_key }}";
        window.sbProps.iframelyLicenseKey = "{{ config.iframely_license_key_public ?? null }}";

        window.sbProps.colourDefaults = {
            "skin" : [
                "{{ config.skin_colour_navigation_background }}",
                "{{ config.skin_colour_content_ui_foreground }}",
                "{{ config.skin_colour_content_ui_background }}",
                "{{ config.skin_colour_content_ui_selected }}",
                "{{ config.skin_colour_logo_background }}",
                "{{ config.skin_colour_navigation_foreground }}",
                "{{ config.skin_colour_content_ui_submit_background }}",
            ],
            "constant": [
                "rgb(50, 114, 226)",
                "rgb(101, 168, 101)",
                "rgb(244, 213, 86)",
                "rgb(248, 150, 30)",
                "rgb(171, 148, 242)",
                "rgb(211, 36, 132)",
                "rgb(123, 0, 143)",
                "rgb(0, 0, 0)",
                "rgb(255, 255, 255)",
            ]
        }

        // When showing colour swatches, we only want the first 3 unique colours from skin config as well as the constant colours,
        // if there are less than 3 unique colours, we'll use the first 3 colours but bias towards the unique colours
        const uniqueSkinColours = [...new Set(window.sbProps.colourDefaults["skin"])];
        const chosenSkinColours =
            uniqueSkinColours.length > 3
                ? uniqueSkinColours.slice(0, 3)
                : [...uniqueSkinColours, ...window.sbProps.colourDefaults["skin"]].slice(0, 3);

        window.sbProps.colourDefaults["skinUnique"] = uniqueSkinColours;
        window.sbProps.colourDefaults["swatches"] = [...chosenSkinColours, ...window.sbProps.colourDefaults["constant"]];

        {% if user.current.role.staff and config.openai_key  %}
        // to display the AI features within the editor
        window.sbProps.hasEditorAI = true;
        window.sbProps.openAIModel = "{{ config.openai_model }}";
        {% endif %}

        window.sbProps.firebaseApps = [];
        {% for app in firebase.apps %}
        {# Firebase public configuration will generally be provided as JS, so must be output raw #}
        window.sbProps.firebaseApps.push({
            appIdentifier: '{{ app.appIdentifier ?? '' }}',
            publicConfiguration: {{ (app.publicConfiguration ?? 'null') | raw }},
            webPushPublicKey: '{{ app.webPushPublicKey ?? '' }}',
        });
        {% endfor %}
    </script>
    {% endautoescape %}

    <script src="{{ CDN_PREFIX }}/js/bundle/vendors.js?v={{ config.site_version }}"></script>
    <script src="{{ CDN_PREFIX }}/js/bundle/main.js?v={{ config.site_version }}"></script>
    <script src="{{ CDN_PREFIX }}/js/fullcalendar/schoolbox-fullcalendar.min.js?v={{ config.site_version }}"></script>
    <script src="/service-worker.js?v={{ config.site_version }}"></script>
    <script src="{{ CDN_PREFIX }}/js/browser/browser-redirect.js?v={{ config.site_version }}"></script>

    {% if config.site_usage_tracking %}
    {% autoescape 'js' %}
    <!-- Google Tag Manager -->
    <script>
        window.dataLayer = window.dataLayer || [];
        dataLayer.push({
            'event': 'page_view',
            'site_school_code': '{{ config. site_school_code }}',
            'site_type': '{{ config.site_type }}',
            'site_version': '{{ config.site_version }}',
            {% if user.current.id %}
            'role_name': '{{ user.current.role.name }}',
            'role_type': '{{ user.current.role.type }}',
            {% if user.current.role.isStudent %}
            'user_year': '{{ user.current.year.name ?? '' }}',
            {% endif %}
            'impersonated': {{ user.impersonated ? 1 : 0 }},
            {% endif %}
        });
    </script>
    <script>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-N8R6VLV');
    </script>
    <!-- End Google Tag Manager -->
    {% endautoescape %}
    {% endif %}
    {{ scripts.header | raw }}
</head>
<body class="{{ ws.enabled ? '' : 'disableNotifications' }}">
<div id="toast-container">
    <sbx-toast />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/sbxToast.js?v={{ config.site_version }}"></script>
<div class="off-canvas-wrap" id="off-canvas-wrap" data-offcanvas data-transition="overlap">
    <div class="inner-wrap {{ user.current.getHideSidenav ? '' : 'left-open' }} {{ user.current.getHideNotificationsTray ? '' : 'right-open' }}" id="inner-wrap" data-inner-offcanvas>
        {% set dockTitle = 'Pin side menu' %}
        {% set undockTitle = 'Unpin side menu' %}
        <aside id="left-menu" class="left-off-canvas-menu hide-for-print" data-side-nav>
            <a
                href="#"
                title="{{ user.current.getHideSidenav ? dockTitle : undockTitle }}"
                class="left-menu-dock"
                id="left-menu-dock"
                data-dock-state="{{ not user.current.getHideSidenav }}"
                data-title-dock="{{ dockTitle }}"
                data-title-undock="{{ undockTitle }}"
            ></a>
            <div class="logo-wrapper">
                <a href="/" class="logo">
                    <img src="/images/logo.php?logo=skin_logo_large&size=normal" srcset="/images/logo.php?logo=skin_logo_large&size=normal 1x,/images/logo.php?logo=skin_logo_large&size=hidpi 2x" alt="{{ config.school_name }}"/>
                </a>
            </div>

            {% block accountMenuMobile %}
                {% if user.current.id %}
                    <div class="row">
                        <ul class="account-menu-mobile accordion" id="account-menu-mobile" data-accordion>
                            <li class="accordion-navigation">
                                <a href="#account-content-mobile" class="profile-drop" id="profile-accordion">
                                    {% include 'include/portrait.twig' with {user: user.current, render: 'menuMobile'} only %}
                                    <span>{{ user.current.formatName }}</span>
                                </a>
                                <div id="account-content-mobile" class="content">
                                    {% include 'include/accountMenu.twig' with {user: user, mobile: true} only %}
                                </div>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            {% endblock accountMenuMobile %}

            {% block menuTopOffCanvas %}
                {% if user.current.id %}
                    <nav class="row">
                        <ul class="off-canvas-list second-nav" id="overflow-nav">
                            <li data-sidenav-separator>
                                <h3>Navigation</h3>
                            </li>
                            {% include '@menuTop/renderer.twig' with topMenu only %}
                        </ul>
                    </nav>
                {% endif %}
            {% endblock menuTopOffCanvas %}

            {% block menuSideOffCanvas %}
                {% if user.current.id %}
                    {% include '@menuSide/renderer.twig' with sideMenu only %}
                {% endif %}
            {% endblock menuSideOffCanvas %}
        </aside>

        <!-- CONTAINER -->
        <section class="main">
            <div id="header">
                {# Never used AFAICT #}
                {#{MAIN_BANNER_REGION}#}
            </div>
            <div class="hybrid-bar hide-for-print" id="hybrid-bar" {% if user.no_header %}style="display:none"{% endif %}>
                <nav class="tab-bar">
                    <section class="left-small" id="menu-toggle">
                        <a class="left-off-canvas-toggle menu-icon" id="left-off-canvas-toggle">
                            <svg width="18" height="14" viewBox="0 0 80 60">
                                <rect width="100" height="10"></rect>
                                <rect width="100" y="25" height="10"></rect>
                                <rect width="100" y="50" height="10"></rect>
                            </svg>
                        </a>
                    </section>

                    <section class="tab-bar-section">
                        <a href="/" class="logo">
                            <img src="/images/logo.php?logo=skin_logo_square&size=normal" srcset="/images/logo.php?logo=skin_logo_square&size=normal 1x,/images/logo.php?logo=skin_logo_square&size=hidpi 2x" alt="{{ config.school_name }}"/>
                        </a>

                        {% block menuTop %}
                            {% if user.current.id %}
                                <ul id="top-menu" class="top-menu">
                                    {% include '@menuTop/renderer.twig' with topMenu only %}
                                </ul>
                            {% endif %}
                        {% endblock menuTop %}

                        {% block search %}
                            {% if user.current.id %}
                                <header-search></header-search>
                            {% endif %}
                        {% endblock search %}

                        {% block accountMenu %}
                            {% if user.current.id %}
                                <a href="#" id="profile-drop" data-test="profile-drop" title="{{ user.current.fullName }}" class="account-menu">
                                    {% include 'include/portrait.twig' with {user: user.current, render: 'menuMobile'} only %}
                                </a>
                                <div id="account-content" class="account-drop" data-test="account-content">
                                    {% include 'include/accountMenu.twig' with {user: user, mobile: false} only %}
                                </div>
                            {% endif %}
                        {% endblock accountMenu %}
                    </section>

                    {% block messaging %}
                        {% if ws.enabled and user.current.id %}
                            <section class="right-small" id="notifications">
                                <a class="right-off-canvas-toggle icon-notifications" id="notification-toggle" data-unread="{{ ws.unread }}">
                                    <span data-unread-count>{{ ws.unread ?? '' }}</span>
                                </a>
                            </section>
                        {% endif %}
                    {% endblock messaging %}

                </nav>
            </div>

            <div id="container">
                <div id="content">
                    {% include template with data only %}
                </div>
            </div>

            {% block footer %}
                <div id="footer" class="clearfix">
                    <ul>
                        <li>{{ NOW.year }} &copy; Copyright <a href="{{ config.school_address }}">{{ config.school_name }}</a></li>
                        <li><a href="{{ routeLookup('policy.getPolicy') }}">Guidelines of Use and Privacy Policy</a></li>
                        <li><a href="https://schoolbox.education" title="Schoolbox, Virtual Learning Environment, Learning Management System, LMS">Schoolbox</a>
                            {{ config.site_version }}</li>
                        {% if config.feedback_url and config.feedback_text %}
                            <li><a href="{{ config.feedback_url }}">{{ config.feedback_text }}</a></li>
                        {% endif %}
                    </ul>
                </div>

                {# Yandex translation service
                 # Only available to parents depending on config setting
                 #}
                {% include 'sub/yandex.twig' %}

                <script type="text/javascript">
                    Foundation.global.namespace = '';
                    $(document).foundation();
                </script>
                {% set user_role = user.current.role.name | escape('js') %}
                {{ config.site_analytics | replace({'{USER_ROLE}':user_role}) | raw }}
            {% endblock %}

            {% if debugBar is defined %}
                {{ debugBar.head | raw }}
                {{ debugBar.body | raw }}
            {% endif %}
        </section>
        <!-- END CONTAINER -->

        {% block instant %}
            {% if ws.enabled and user.current.id %}
                {% set dockNotifsTitle = 'Pin notifications' %}
                {% set undockNotifsTitle = 'Unpin notifications' %}
                <aside class="right-off-canvas-menu island no-pad hide-for-print" id="msgs" data-unread="{{ ws.unread }}">
                    <ul class="off-canvas-list" id="message-list">
                        <li>
                            <a
                                href="#"
                                title="{{ user.current.getHideNotificationsTray ? dockNotifsTitle : undockNotifsTitle }}"
                                class="right-menu-dock show-for-xlarge-up"
                                id="right-menu-dock"
                                data-dock-state="{{ not user.current.getHideNotificationsTray }}"
                                data-title-dock="{{ dockNotifsTitle }}"
                                data-title-undock="{{ undockNotifsTitle }}"
                            ></a>
                            <label id="notification-toggle-full">Notifications</label>
                            <a class="icon-settings settings-button" href="{{ routeLookup("notifications.configure") }}" aria-label="Modify notification settings" title="Modify notification settings"></a>
                        </li>
                        {% set installGoogle = config.digistorm_google_play_store_link ?? '' %}
                        {% set installApple = config.digistorm_apple_app_store_link ?? '' %}
                        {% if config.pwa_enable or config.web_push_notifications_enabled or installGoogle is not empty or installApple is not empty %}
                        <li id="pwaPrompt" data-pwa="sidebarPrompt" class="content hide">
                            {% include '@notifications/pwa.twig' with { notifButton : 'notifOn', pwaPage: 'chrome' } %}
                            <a id="installDelayPrompt" data-pwa="sidebarPromptDelay" class="button load-more expand" href="#">Later</a>
                        </li>
                        {% endif %}
                        <li>
                            <a id="msg-mar" class="mark-all-read button icon-approve" href="#">Mark all read</a>
                        </li>
                        <li>
                            <section>
                                <ul id="msg-content" class="action-list">
                                    <li data-msgitem class="actions-small-1">
                                        <div class="list-item">
                                            <div class="compact card wrap-down small-12">
                                                <a data-msgitem-href class="no-pad">
                                                    <img data-msgitem-thumb />
                                                    <p data-msgitem-title></p>
                                                    <p class="meta spaced" data-msgitem-time></p>
                                                </a>
                                            </div>
                                        </div>
                                        <nav>
                                            <a data-msgitem-ack class="icon-approve no-pad" title="Mark as read"></a>
                                        </nav>
                                    </li>
                                </ul>
                            </section>
                        </li>
                        <li>
                            <a href="/notifications" class="button" data-msgfooter-action>
                                <span class="connecting"></span>&nbsp;Connecting&hellip;
                            </a>
                        </li>
                    </ul>
                </aside>
                <div id="alert-dialog" class="reveal-modal" data-reveal aria-labelledby="modalTitle" aria-hidden="true" role="dialog">
                    <h2 data-modal-title></h2>
                    <ul id="alert-content" class="information-list no-pad">
                        <li data-msgitem>
                            <div class="card wrap-down small-12">
                                <a data-msgitem-href>
                                    <img data-msgitem-thumb />
                                    <p data-msgitem-title></p>
                                </a>
                            </div>
                        </li>
                    </ul>
                    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
                </div>

                {% autoescape 'js' %}
                <script type="text/javascript">
                    $(function () {
                        // launch the notifier
                        $('#msgs').notifier({
                            unread:   Number('{{ ws.unread }}'),
                            maxstack: Number('{{ ws.stackLimit }}'),
                            itemTimeFormat: dateDisplayFormats.dayjsDatetime,
                            debug: Boolean({{ config.debug_mode }})
                        });

                        $('#alert-dialog').on('click', 'a.action', function (e) {
                            e.preventDefault();
                        });

                        $('#profile-drop').on('click', function(e) {
                            $(".c-header-search").removeClass( "focus" );
                            e.preventDefault(); // Prevent '#' from being appended to the URL.  This can mess up interactions with the browser history API.
                        });

                        if ('serviceWorker' in navigator) {
                            window.addEventListener('load', () => {
                                navigator.serviceWorker.register('/service-worker.js')
                                        .then((reg) => {
                                            console.log('Service worker registered.', reg);
                                        });
                            });
                        }
                    });

                    {# js for installing pwa / enabling notifications #}

                    {# To determine if the user is on an iOS device #}
                    function iOS() {
                        return [
                                'iPad Simulator',
                                'iPhone Simulator',
                                'iPod Simulator',
                                'iPad',
                                'iPhone',
                                'iPod'
                            ].includes(navigator.platform)
                            // iPad on iOS 13 detection
                            || (navigator.userAgent.includes("Mac") && "ontouchend" in document)
                    }

                    /** define device ID */
                    let deviceId = 'Browser';
                    if (iOS()) {
                        deviceId = 'iOS';
                    } else if (/android/i.test(navigator.userAgent)) {
                        deviceId = 'Android';
                    }

                    {# Check if any of the PWA installer buttons are visible in a given section
                     # @param {HTMLElement} sectionWrapper - The parent element of the PWA installer buttons (e.g. sidebar prompt or element with data-pwa-page)
                     # @returns {boolean} - Whether or not the PWA installer buttons are visible in the given section
                     #}
                    function isPWAInstallPromptVisible(sectionWrapper) {
                        // Check install section
                        if (Array.from(sectionWrapper.querySelectorAll('[data-pwa="install"]')).some((installSectionElement) => {
                            if (installSectionElement.classList.contains('hide')) {
                                return false; // The install section is hidden
                            }

                            // If any install button is visible, return true
                            return Array.from(installSectionElement.querySelectorAll('[data-pwa-action]')).some((installActionElement) => {
                                return !installActionElement.classList.contains('hide');
                            });
                        })) {
                            return true; // An install button is visible
                        };

                        return false; // No install button is visible
                    }

                    {# Check if any of the notification buttons/messages are visible in a given section
                     # @param {HTMLElement} sectionWrapper - The parent element of the notification messages (e.g. sidebar prompt or element with data-pwa-page)
                     # @returns {boolean} - Whether or not the notification messages are visible in the given section
                     #}
                    function isPWANotifPromptVisible(sectionWrapper) {
                        return Array.from(sectionWrapper.querySelectorAll('[data-pwa-notif]')).some((notifSectionElement) => {
                            return !notifSectionElement.classList.contains('hide'); // If any of them don't have a "hide" class, return true
                        });
                    }

                    {# Determine whether or not the sidebar/settings prompt is empty (has no install button or notification message)
                     # This is useful when hiding parts of the sidebar prompt contents so that we don't end up with
                     # weird padding or the "Later" button floating in the middle of nowhere...
                     # @param {"sidebarPrompt"|"settingsPrompt"} promptId - The location to check for emptiness
                     #}
                    function isPromptSectionEmpty(promptId) {
                        return Array.from(document.querySelectorAll(`[data-pwa="${promptId}"]`)).some((sidebarElement) => {
                            // Check install section
                            if (isPWAInstallPromptVisible(sidebarElement)) {
                                return false; // An install button is visible, so the sidebar prompt is not empty
                            };

                            // Check notification section
                            if (isPWANotifPromptVisible(sidebarElement)) {
                                return false; // A notification button/message is visible, so the sidebar prompt is not empty
                            };

                            return true;
                        });
                    }

                    {# Hide the sidebar/settings prompt if it's empty, or show it if it's not #}
                    function hideShowPromptsIfEmpty() {
                        ['sidebarPrompt', 'settingsPrompt'].forEach((promptId) => {
                            document.querySelectorAll(`[data-pwa="${promptId}"]`).forEach((element) => {
                                if (isPromptSectionEmpty(promptId)) {
                                    element.classList.add('hide');
                                } else {
                                    element.classList.remove('hide');
                                }
                            });
                        });
                    }

                    {# Allow the user to dismiss our request for them to install the app/enable notifications
                     # in the notifications panel. If they've previously dismissed it, don't show it again.
                     #}
                    function removeSidebarPrompt() {
                        document.querySelectorAll('[data-pwa="sidebarPrompt"]').forEach((element) => {
                            // We remove the element entirely so that later on it won't be unhidden unintentionally
                            element.remove();
                        });
                    }

                    if (window.sbProps.pwaConfig.user.hasClickedInstallLater) {
                        removeSidebarPrompt();
                    } else {
                        document.querySelectorAll('[data-pwa="sidebarPromptDelay"]').forEach((element) => {
                            element.addEventListener('click', () => {
                                window.sbProps.pwaConfig.user.hasClickedInstallLater = true;
                                removeSidebarPrompt();
                            });
                        });
                    }

                    {# Are we currently installed and inside a PWA? #}
                    const isPWA = window.matchMedia('(display-mode: standalone)').matches;

                    {# If on iOS and digistorm app exists, show digistorm and not PWA #}
                    if (
                        iOS() &&
                        Boolean({{ (config.digistorm_apple_app_store_link ?? '' != '') ? true : false}}) &&
                        Boolean({{ ((USER.role.type | capitalize) in config.digistorm_role_install_prompt) ? true : false }})
                    ) {
                        {% if config.debug_mode %}
                        console.log('iOS Digistorm');
                        {% endif %}

                        document.querySelectorAll('[data-pwa="sidebarPrompt"], [data-pwa="install"], [data-pwa-action="installApple"]').forEach((element) => {
                            element.classList.remove('hide');
                        });
                        hideShowPromptsIfEmpty();
                    }
                    {# If on Android and digistorm app exists, show digistorm and not PWA #}
                    else if (
                        /android/i.test(navigator.userAgent) &&
                        Boolean({{ (config.digistorm_google_play_store_link ?? '' != '') ? true : false }}) &&
                        Boolean({{ ((USER.role.type | capitalize) in config.digistorm_role_install_prompt) ? true : false }})
                    ) {
                        {% if config.debug_mode %}
                        console.log('Android Digistorm');
                        {% endif %}

                        document.querySelectorAll('[data-pwa="sidebarPrompt"], [data-pwa="install"], [data-pwa-action="installGoogle"]').forEach((element) => {
                            element.classList.remove('hide');
                        });
                        hideShowPromptsIfEmpty();
                    }
                    {# Otherwise, show PWA installer if we aren't already in the PWA #}
                    else if (!isPWA) {
                        {% if config.debug_mode %}
                        console.log('Normal PWA');
                        {% endif %}

                        if (iOS()) {
                            {# We can't use beforeinstallprompt on iOS, so we'll show our own prompt and
                             # guide the user with instructions on how to add to home screen instead...
                             #}

                            {# Show the iOS install button, which has a reveal modal connected to it for "add to homescreen" instructions #}
                            document.querySelectorAll('[data-pwa="sidebarPrompt"], [data-pwa="install"], [data-pwa-action="installPWAiOS"]').forEach((element) => {
                                element.classList.remove('hide');
                            });
                            hideShowPromptsIfEmpty();
                        } else {
                            {# Otherwise, rely on beforeinstallprompt to detect browser compatibility before showing the install button
                             # This event is not widely supported, so we either need to provide a manual guide (e.g. iOS) or wait for
                             # the event to tell us that the browser is capable of installing the PWA.
                             #
                             # If we don't do this, the install button will end up showing on browsers that don't support it, and do nothing upon click...
                             #
                             # Dupe from https://web.dev/articles/codelab-make-installable and changes to use inside schoolbox
                             #}

                            window.addEventListener('beforeinstallprompt', (event) => {
                                {% if config.debug_mode %}
                                    console.log('👍', 'beforeinstallprompt', event);
                                {% endif %}

                                {# Prevent the mini-infobar from appearing on mobile. #}
                                event.preventDefault();

                                {# Stash the event so it can be used later #}
                                window.deferredPrompt = event;

                                {# The browser is capable of directly installing the PWA, so show the install button #}
                                document.querySelectorAll('[data-pwa="sidebarPrompt"], [data-pwa="install"], [data-pwa-action="installPWA"]').forEach((element) => {
                                    element.classList.remove('hide');
                                });
                                hideShowPromptsIfEmpty();

                                {# When the user clicks the install button, use the deferredPrompt we just made #}
                                document.querySelectorAll('[data-pwa-action="installPWA"]').forEach((element) => {
                                    element.addEventListener('click', async () => {
                                        {% if config.debug_mode %}
                                        console.log('👍', 'butInstall-clicked');
                                        {% endif %}
                                        const promptEvent = window.deferredPrompt;
                                        if (!promptEvent) return; // The deferred prompt isn't available.

                                        // Show the install prompt.
                                        promptEvent.prompt();

                                        // Reset the deferred prompt variable, since
                                        // prompt() can only be called once.
                                        window.deferredPrompt = null;

                                        // Hide the install button
                                        document.querySelectorAll('[data-pwa="install"]').forEach((element) => {
                                            element.classList.add('hide');
                                        });

                                        // Hide the sidebar/settings prompt if it's now empty
                                        hideShowPromptsIfEmpty();

                                        const result = await promptEvent.userChoice;

                                        {% if config.debug_mode %}
                                        // Log the result
                                        console.log('👍', 'userChoice', result);
                                        {% endif %}
                                    });
                                });
                            });

                            window.addEventListener('appinstalled', (event) => {
                                {% if config.debug_mode %}
                                console.log('👍', 'appinstalled', event);
                                {% endif %}

                                {# Clear the deferredPrompt so it can be garbage collected #}
                                window.deferredPrompt = null;
                            });
                        }
                    }

                    if (window.schoolboxUser.impersonated) {
                        {# If the user is impersonating another user, notification functionality is disabled #}
                        {# Only show the message on the settings page #}

                        document.querySelectorAll('[data-pwa-page="settings"] [data-pwa-notif="notifDisabledImpersonate"]').forEach((element) => {
                            element.classList.remove('hide');
                        });
                    } else if ("Notification" in window) {
                        {# When the same device is re-registered, Firebase will invalidate all old devices automatically.
                         # Check if any users that aren't the current logged in user have (according to pwaConfig) previously been registered
                         # and if so, invalidate their registration locally so we can re-register them when they next log in.
                         #
                         # NOTE: We should NOT send PWA_NOTIFICATION_DENY in this case, as it will de-register the current user too!
                         #
                         # We keep the old notificationToken in the config so if the user logs in again, we can clean up the old token in
                         # the schoolbox mobile app registration database. See firebase-init for more details about this scenario.
                         #}
                        for (const [userId, pwaUserConfig] of Object.entries(window.sbProps.pwaConfig.config.users)) {
                            if (userId.toString() !== window.schoolboxUser.id.toString()) {
                                pwaUserConfig.notificationState = null;
                            }
                        };

                        {# As Notification.permission cannot be trusted on iOS, we can use the PWA config to determine
                         # if we should avoid showing "Enable Notifications" again when the user has already enabled them
                         # If the browser is saying notifications are blocked, respect that, even though it may be wrong
                         # as we handle this separately by providing a button to re-request permission instead.
                         #}
                        let currentPermission = Notification.permission;

                        if (
                            iOS() &&
                            currentPermission === "default" &&
                            ![null, "removing"].includes(window.sbProps.pwaConfig.user.notificationState)
                        ) {
                            currentPermission = "granted"; // Treat "default" as "granted" on iOS if the user has allowed notifications in the past
                        }

                        if (currentPermission === "granted") {
                            {# Only show the notification enabled message outside the sidebar when granted on initial page load #}
                            document.querySelectorAll('[data-pwa-page="settings"] [data-pwa-notif="notifEnabledMessage"]').forEach((element) => {
                                element.classList.remove('hide');
                            });

                            {# If this device is now allowing notifications but we haven't registered it yet,
                             # then attempt to register the device now...
                             #}
                            if (window.sbProps.pwaConfig.user.notificationState !== "registered") {
                                window.sbProps.pwaConfig.user.notificationState = "registering";
                            }
                        } else if (currentPermission === "denied") {
                            {# Show the blocked message #}
                            document.querySelectorAll('[data-pwa="sidebarPrompt"], [data-pwa-notif="notifBlocked"]').forEach( (element)=>{
                                element.classList.remove('hide');
                            });

                            {# As the user has now blocked notifications, set the notification state to removing so firebase can clean up on page load
                             #}
                            if (window.sbProps.pwaConfig.user.notificationState !== null) {
                                window.sbProps.pwaConfig.user.notificationState = "removing";
                            }
                        } else {
                            {# The user hasn't been prompted yet, show them the button to enable notifs
                             #}
                            document.querySelectorAll('[data-pwa="sidebarPrompt"], [data-pwa-notif="enableNotifPrompt"]').forEach( (element)=>{
                                element.classList.remove('hide');
                            });

                            {# If on iOS and outside of the PWA, disable the button.
                             # iOS requires the user to be in the PWA to before enabling notifications.
                             #}
                            if (iOS() && !isPWA) {
                                document.querySelectorAll('[data-pwa-notif="iOSHomePrompt"]').forEach((element) => {
                                    element.classList.remove('hide');
                                });

                                document.querySelectorAll('[data-pwa-action="enableNotif"]').forEach((element) => {
                                    element.toggleAttribute('disabled', true);
                                });
                            }
                        }

                        {# on iOS, Notification.permission is completely unreliable until we have used
                         # Notification.requestPermission at least once. If a user initially denies notifications,
                         # but then turns them on in settings, iOS will still return 'denied' for Notification.permission
                         # even if you navigate between pages or refresh the whole app sometimes...
                         # We can't just auto re-request permission because Notification.requestPermission() requires a user gesture
                         #
                         # To work around this, we provide a button on the blocked message that the user can click to
                         # trigger Notification.requestPermission() again and then reload the page to get the reflected UI changes
                         #}
                        document.querySelectorAll('[data-pwa-action="retryNotifPrompt"]').forEach( (element) => {
                            element?.addEventListener('click', async () => {
                                await Notification.requestPermission();
                                window.location.reload();
                            });
                        });

                        let prompted = false;
                        document.querySelectorAll('[data-pwa-action="enableNotif"]').forEach( (enableNotifElement)=> {
                            enableNotifElement.addEventListener('click', async () => {
                                if (prompted) {
                                    return; {# only prompt once #}
                                }
                                prompted = true;

                                {# Use await instead of .then to avoid iOS treating as a non-interaction and failing #}
                                const permission = await Notification.requestPermission();

                                {# Hide the enable button, as we'll either show the granted or blocked message next
                                 #}
                                document.querySelectorAll('[data-pwa-notif="enableNotifPrompt"]').forEach( (element)=>{
                                    element.classList.add('hide');
                                });

                                if (permission === 'granted') {
                                    window.sbProps.pwaConfig.user.notificationState = "registering";
                                    {% if config.debug_mode %}
                                    console.info('Notification permission granted');
                                    {% endif %}

                                    {# Show the granted message.
                                     # Notable difference to page load behaviour here, we do want to show the message on the sidebar
                                     # as the user has just enabled notifications, so find all elements instead of excluding some this time.
                                     #}
                                    document.querySelectorAll('[data-pwa-notif="notifEnabledMessage"]').forEach( (element)=>{
                                        element.classList.remove('hide');
                                    });

                                    {# If the PWA install button does not exist, such that the notifiation granted message is the only
                                     # element left, hide the "Later" button in the sidebar prmopt, as it's now unnecessary.
                                     #}
                                    document.querySelectorAll('[data-pwa="sidebarPrompt"]').forEach((sidebarPromptElement) => {
                                        if (!isPWAInstallPromptVisible(sidebarPromptElement)) {
                                            sidebarPromptElement.querySelectorAll('[data-pwa="sidebarPromptDelay"]').forEach((element) => {
                                                element.classList.add('hide');
                                            });
                                        };
                                    });

                                    {# Attempt to register the device for notifications #}
                                    document.dispatchEvent(
                                        new CustomEvent("PWA_NOTIFICATION_ALLOW", {
                                            detail: {
                                                debug: Boolean({{ config.debug_mode }}),
                                                deviceId: deviceId,
                                            },
                                        }),
                                    );

                                    {# Show a sample notification, if we have the ability to do so
                                     # iOS requires notifications to be dispatched from inside a service worker, so send it there
                                     #}
                                    if ("serviceWorker" in navigator && navigator.serviceWorker.controller) {
                                        navigator.serviceWorker.controller.postMessage({
                                            type: 'SHOW_NOTIFICATION',
                                            title: `{{ config.title }}`,
                                            options: {
                                                body: 'Welcome! Your notifications are powered by the {{ config.title }} web app',
                                                icon: "/images/logo.php?logo=skin_logo_square&size=apple72",
                                                image: "/images/logo.php?logo=skin_logo_square&size=apple72",
                                                badge: "/images/logo.php?logo=skin_logo_square&size=apple72",
                                                renotify: false,
                                                data: {
                                                    href: "/settings/notifications"
                                                }
                                            }
                                        })
                                    }
                                } else {
                                    // may be "denied" or "default", in the case of "default" - we should treat as "denied" as per
                                    // https://developer.mozilla.org/en-US/docs/Web/API/Notification/requestPermission_static#return_value

                                    {% if config.debug_mode %}
                                    console.warn('Notification permission denied');
                                    {% endif %}

                                    {# Show the blocked message #}
                                    document.querySelectorAll('[data-pwa-notif="notifBlocked"]').forEach( (element)=> {
                                        element.classList.remove('hide');
                                    });

                                    {# turn notifications off... #}
                                    document.dispatchEvent(
                                        new CustomEvent("PWA_NOTIFICATION_DENY", {
                                            detail: {
                                                debug: Boolean({{ config.debug_mode }}),
                                            },
                                        }),
                                    );
                                }
                                hideShowPromptsIfEmpty();
                            });
                        });

                        {# sometimes the service worker is not running when we prompt attempt to register notifications, try again if we failed... #}
                        reAuthNotif = function () {
                            {# If we were registering but the page was reloaded partially through, try again #}
                            if (window.sbProps.pwaConfig.user.notificationState === "registering") {
                                document.dispatchEvent(
                                    new CustomEvent("PWA_NOTIFICATION_ALLOW", {
                                        detail: {
                                            debug: Boolean({{ config.debug_mode }}),
                                            deviceId: deviceId,
                                        },
                                    }),
                                );
                            }

                            {# If we were unregistering but the page was reloaded partially through, try again #}
                            if (window.sbProps.pwaConfig.user.notificationState === "removing") {
                                document.dispatchEvent(
                                    new CustomEvent("PWA_NOTIFICATION_DENY", {
                                        detail: {
                                            debug: Boolean({{ config.debug_mode }}),
                                        },
                                    }),
                                );
                            }
                        }

                        {# frontend people, I was trying to get this to load on page load, or when the page has finished loading,
                         # so we can hit the event listener in the firebase file at the bottom of the file.
                         # This is calling the above function which calls the firebase event, but is not passing through the data,
                         # and there is probably a better way of doing this anyhow...
                         #}
                        if (document.readyState !== 'loading') {
                            reAuthNotif();
                        } else {
                            document.addEventListener('DOMContentLoaded', reAuthNotif);
                        }
                    } else {
                        {# If the browser doesn't support notifications
                         # and we are on iOS outside of the PWA, show the iOS home prompt.
                         # iOS requires the user to be in the PWA to before enabling notifications.
                         #}
                        if (iOS() && !isPWA) {
                            document.querySelectorAll('[data-pwa-notif="iOSHomePrompt"]').forEach((element) => {
                                element.classList.remove('hide');
                            });

                            document.querySelectorAll('[data-pwa-action="enableNotif"]').forEach((element) => {
                                element.toggleAttribute('disabled', true);
                            });
                        }
                    }

                    hideShowPromptsIfEmpty();
                </script>
                {% endautoescape %}
            {% endif %}
        {% endblock %}
        <a href="#" class="exit-off-canvas"></a>
    </div>
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/headerSearch.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/firebaseInit.js?v={{ config.site_version }}"></script>
</body>
</html>
