<!DOCTYPE html>
<html xmlns:m="http://www.w3.org/1998/Math/MathML" lang="en">
<!--  Copyright {{ NOW.year }} Schoolbox Pty Ltd -->
<!--  Visit us at https://schoolbox.com.au/ -->
<head>
    <title>{{ config.title }}{{ chrome.title ? (' - ' ~ chrome.title) : '' }}</title>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="Content-Language" content="en-au" />
    <meta name="author" content="Schoolbox Pty Ltd"/>
    {% if not config.web_crawlers_enabled %}<meta name="robots" content="noindex">{% endif %}
    <link rel="manifest" href="/manifest">
    <meta itemprop="user.externalId" content="{{ user.current.externalId }}" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="{{ config.title }}">
    <meta name="theme-color" content="{{ config.skin_colour_navigation_background }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-title" content="{{ config.title }}">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="icon" href="/images/logo.php?logo=skin_favicon&size=favicon"/>
    <link rel="apple-touch-icon" sizes="57x57" href="/images/logo.php?logo=skin_favicon&size=apple57">
    <link rel="apple-touch-icon" sizes="60x60" href="/images/logo.php?logo=skin_favicon&size=apple60">
    <link rel="apple-touch-icon" sizes="72x72" href="/images/logo.php?logo=skin_favicon&size=apple72">
    <link rel="apple-touch-icon" sizes="76x76" href="/images/logo.php?logo=skin_favicon&size=apple76">
    <link rel="apple-touch-icon" sizes="114x114" href="/images/logo.php?logo=skin_favicon&size=apple114">
    <link rel="apple-touch-icon" sizes="120x120" href="/images/logo.php?logo=skin_favicon&size=apple120">
    <link rel="apple-touch-icon" sizes="144x144" href="/images/logo.php?logo=skin_favicon&size=apple144">
    <link rel="apple-touch-icon" sizes="152x152" href="/images/logo.php?logo=skin_favicon&size=apple152">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo.php?logo=skin_favicon&size=apple180">

    {% include 'include/skin.twig' with { config: config } only %}
    <link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/vendors/fullcalendar/datepicker.css?v={{ config.site_version }}" />

    {% if tour.data is defined and not user.impersonated %}
    {% autoescape 'js' %}
    <script>
        window.tourData = {{ tour.data|json_encode|raw }};
    </script>
    {% endautoescape %}
    {% endif %}
    <script src="{{ CDN_PREFIX }}/js/bundle/vendors.js?v={{ config.site_version }}"></script>
    <script src="{{ CDN_PREFIX }}/js/bundle/main.js?v={{ config.site_version }}"></script>
    <script src="{{ CDN_PREFIX }}/js/fullcalendar/schoolbox-fullcalendar.min.js?v={{ config.site_version }}"></script>
    <script src="/service-worker.js?v={{ config.site_version }}"></script>
    <script src="{{ CDN_PREFIX }}/js/browser/browser-redirect.js?v={{ config.site_version }}"></script>
    {% autoescape 'js' %}
    <script>

        // Date formats (global variable)
        window.siteLocation = "{{ config.site_school_code }}";

        window.dateDisplayFormats = {
            dayjs:          "{{ config.date_local | dayjsFormat }}",
            dayjsDatetime:  "{{ (config.date_local ~ ' ' ~ config.date_time) | dayjsFormat }}",
            dayjsDateLong:  "{{ config.date_long | dayjsFormat }}",
            dayjsTime:      "{{ config.date_time | dayjsFormat}}",
            localDate:         "{{ config.date_local }}",
            localDateTime:     "{{ config.date_local ~ ' ' ~ config.date_time }}",
            calendarStartTime: "{{ config.calendar_start_time }}",
            localTime:         "{{ config.date_time }}",
        };

        // This schoolboxUser is here for custom scripts.
        window.schoolboxUser            = {{ user.current | json_encode | raw }};
        schoolboxUser.name           = "{{ user.current.formatName }}";
        schoolboxUser.email          = "{{ user.current.email }}";
        schoolboxUser.year           = "{{ user.current.year.name ?? '' }}";
        schoolboxUser.role           = {{ user.current.role | json_encode | raw }};
        schoolboxUser.impersonated   = Boolean('{{ user.impersonated }}');
        schoolboxUser.communityLogin = Boolean('{{ user.communityLogin }}');

        // Reluctantly add the CDN prefix and site version as global JS variables
        window.cdnPrefix = "{{ CDN_PREFIX }}";
        window.siteVersion = "{{ config.site_version }}";

        window.sbProps.imageLightboxLicenseKey = "{{ config.image_lightbox_license_key }}";
        window.sbProps.ckeditor5LicenseKey = "{{ config.ckeditor5_license_key }}";
        window.sbProps.iframelyLicenseKey = "{{ config.iframely_license_key_public ?? null }}";

        window.sbProps.colourDefaults = {
            "skin" : [
                "{{ config.skin_colour_navigation_background }}",
                "{{ config.skin_colour_content_ui_foreground }}",
                "{{ config.skin_colour_content_ui_background }}",
                "{{ config.skin_colour_content_ui_selected }}",
                "{{ config.skin_colour_logo_background }}",
                "{{ config.skin_colour_navigation_foreground }}",
                "{{ config.skin_colour_content_ui_submit_background }}",
            ],
            "constant": [
                "rgb(50, 114, 226)",
                "rgb(101, 168, 101)",
                "rgb(244, 213, 86)",
                "rgb(248, 150, 30)",
                "rgb(171, 148, 242)",
                "rgb(211, 36, 132)",
                "rgb(123, 0, 143)",
                "rgb(0, 0, 0)",
                "rgb(255, 255, 255)",
            ]
        }

        // When showing colour swatches, we only want the first 3 unique colours from skin config as well as the constant colours,
        // if there are less than 3 unique colours, we'll use the first 3 colours but bias towards the unique colours
        const uniqueSkinColours = [...new Set(window.sbProps.colourDefaults["skin"])];
        const chosenSkinColours =
            uniqueSkinColours.length > 3
                ? uniqueSkinColours.slice(0, 3)
                : [...uniqueSkinColours, ...window.sbProps.colourDefaults["skin"]].slice(0, 3);

        window.sbProps.colourDefaults["skinUnique"] = uniqueSkinColours;
        window.sbProps.colourDefaults["swatches"] = [...chosenSkinColours, ...window.sbProps.colourDefaults["constant"]];

        {% if user.current.role.staff and config.openai_key  %}
        // to display the AI features within the editor
        window.sbProps.hasEditorAI = true;
        {% endif %}

        window.sbProps.firebaseApps = [];
        {% for app in firebase.apps %}
        {# Firebase public configuration will generally be provided as JS, so must be output raw #}
        window.sbProps.firebaseApps.push({
            appIdentifier: '{{ app.appIdentifier ?? '' }}',
            publicConfiguration: {{ (app.publicConfiguration ?? 'null') | raw }},
            webPushPublicKey: '{{ app.webPushPublicKey ?? '' }}',
        });
        {% endfor %}
    </script>
    {% endautoescape %}

    {% if config.site_usage_tracking %}
    {% autoescape 'js' %}
    <!-- Google Tag Manager -->
    <script>
        window.dataLayer = window.dataLayer || [];
        dataLayer.push({
            'event': 'page_view',
            'site_school_code': '{{ config. site_school_code }}',
            'site_type': '{{ config.site_type }}',
            'site_version': '{{ config.site_version }}',
            {% if user.current.id %}
            'role_name': '{{ user.current.role.name }}',
            'role_type': '{{ user.current.role.type }}',
            {% if user.current.role.isStudent %}
            'user_year': '{{ user.current.year.name ?? '' }}',
            {% endif %}
            'impersonated': {{ user.impersonated ? 1 : 0 }},
            {% endif %}
        });
    </script>
    <script>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-N8R6VLV');
    </script>
    <!-- End Google Tag Manager -->
    {% endautoescape %}
    {% endif %}
    {{ scripts.header | raw }}
</head>
<body class="{{ ws.enabled ? '' : 'disableNotifications' }}">
<div class="off-canvas-wrap" id="off-canvas-wrap" data-offcanvas data-transition="overlap">
    <div class="inner-wrap {{ user.current.getHideSidenav ? '' : 'left-open' }} {{ user.current.getHideNotificationsTray ? '' : 'right-open' }}" id="inner-wrap" data-inner-offcanvas>

        {% set dockTitle = 'Pin side menu' %}
        {% set undockTitle = 'Unpin side menu' %}
        <aside id="left-menu" class="left-off-canvas-menu hide-for-print" data-side-nav>
            <a
                href="#"
                title="{{ user.current.getHideSidenav ? dockTitle : undockTitle }}"
                class="left-menu-dock"
                id="left-menu-dock"
                data-dock-state="{{ not user.current.getHideSidenav }}"
                data-title-dock="{{ dockTitle }}"
                data-title-undock="{{ undockTitle }}"
            ></a>
            <div class="logo-wrapper">
                <a href="/" class="logo">
                    <img src="/images/logo.php?logo=skin_logo_large&size=normal" srcset="/images/logo.php?logo=skin_logo_large&size=normal 1x,/images/logo.php?logo=skin_logo_large&size=hidpi 2x" alt="{{ config.school_name }}"/>
                </a>
            </div>

            {% block accountMenuMobile %}
                {% if user.current.id %}
                    <div class="row">
                        <ul class="account-menu-mobile accordion" id="account-menu-mobile" data-accordion>
                            <li class="accordion-navigation">
                                <a href="#account-content-mobile" class="profile-drop" id="profile-accordion">
                                    {% include 'include/portrait.twig' with {user: user.current, render: 'menuMobile'} only %}
                                    <span>{{ user.current.formatName }}</span>
                                </a>
                                <div id="account-content-mobile" class="content">
                                    {% include 'include/accountMenu.twig' with {user: user, mobile: true} only %}
                                </div>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            {% endblock accountMenuMobile %}

            {% block menuTopOffCanvas %}
                {% if user.current.id %}
                    <nav class="row">
                        <ul class="off-canvas-list second-nav" id="overflow-nav">
                            <li data-sidenav-separator>
                                <h3>Navigation</h3>
                            </li>
                            {% include '@menuTop/renderer.twig' with topMenu only %}
                        </ul>
                    </nav>
                {% endif %}
            {% endblock menuTopOffCanvas %}

            {% block menuSideOffCanvas %}
                {% if user.current.id %}
                    {% include '@menuSide/renderer.twig' with sideMenu only %}
                {% endif %}
            {% endblock menuSideOffCanvas %}
        </aside>

        <!-- CONTAINER -->
        <section class="main">
            <div id="header">
                {# Never used AFAICT #}
                {#{MAIN_BANNER_REGION}#}
            </div>
            <div class="hybrid-bar hide-for-print" id="hybrid-bar" {% if user.no_header %}style="display:none"{% endif %}>
                <nav class="tab-bar">
                    <section class="left-small" id="menu-toggle">
                        <a class="left-off-canvas-toggle menu-icon" id="left-off-canvas-toggle">
                            <svg width="18" height="14" viewBox="0 0 80 60">
                                <rect width="100" height="10"></rect>
                                <rect width="100" y="25" height="10"></rect>
                                <rect width="100" y="50" height="10"></rect>
                            </svg>
                        </a>
                    </section>

                    <section class="tab-bar-section">
                        <a href="/" class="logo">
                            <img src="/images/logo.php?logo=skin_logo_square&size=normal" srcset="/images/logo.php?logo=skin_logo_square&size=normal 1x,/images/logo.php?logo=skin_logo_square&size=hidpi 2x" alt="{{ config.school_name }}"/>
                        </a>

                        {% block menuTop %}
                            {% if user.current.id %}
                                <ul id="top-menu" class="top-menu">
                                    {% include '@menuTop/renderer.twig' with topMenu only %}
                                </ul>
                            {% endif %}
                        {% endblock menuTop %}

                        {% block search %}
                            {% if user.current.id %}
                                <header-search></header-search>
                            {% endif %}
                        {% endblock search %}

                        {% block accountMenu %}
                            {% if user.current.id %}
                                <a href="#" id="profile-drop" title="{{ user.current.fullName }}" class="account-menu">
                                    {% include 'include/portrait.twig' with {user: user.current, render: 'menuMobile'} only %}
                                </a>
                                <div id="account-content" class="account-drop">
                                    {% include 'include/accountMenu.twig' with {user: user, mobile: false} only %}
                                </div>
                            {% endif %}
                        {% endblock accountMenu %}
                    </section>

                    {% block messaging %}
                        {% if ws.enabled and user.current.id %}
                            <section class="right-small" id="notifications">
                                <a class="right-off-canvas-toggle icon-notifications" id="notification-toggle" data-unread="{{ ws.unread }}">
                                    <span data-unread-count>{{ ws.unread ?? '' }}</span>
                                </a>
                            </section>
                        {% endif %}
                    {% endblock messaging %}

                </nav>
            </div>

            <div id="container">
                <div id="content">
                    {% include template with data only %}
                </div>
            </div>

            {% block footer %}
                <div id="footer" class="clearfix">
                    <ul>
                        <li>{{ NOW.year }} &copy; Copyright <a href="{{ config.school_address }}">{{ config.school_name }}</a></li>
                        <li><a href="{{ routeLookup('policy.getPolicy') }}">Guidelines of Use and Privacy Policy</a></li>
                        <li><a href="https://schoolbox.education" title="Schoolbox, Virtual Learning Environment, Learning Management System, LMS">Schoolbox</a>
                            {{ config.site_version }}</li>
                        {% if config.feedback_url and config.feedback_text %}
                            <li><a href="{{ config.feedback_url }}">{{ config.feedback_text }}</a></li>
                        {% endif %}
                    </ul>
                </div>

                {# Yandex translation service
                 # Only available to parents depending on config setting
                 #}
                {% include 'sub/yandex.twig' %}

                <script type="text/javascript">
                    Foundation.global.namespace = '';
                    $(document).foundation();
                </script>
                {% set user_role = user.current.role.name | escape('js') %}
                {{ config.site_analytics | replace({'{USER_ROLE}':user_role}) | raw }}
            {% endblock %}

            {% if debugBar is defined %}
                {{ debugBar.head | raw }}
                {{ debugBar.body | raw }}
            {% endif %}
        </section>
        <!-- END CONTAINER -->

        {% block instant %}
            {% if ws.enabled and user.current.id %}
                {% set dockNotifsTitle = 'Pin notifications' %}
                {% set undockNotifsTitle = 'Unpin notifications' %}
                <aside class="right-off-canvas-menu island no-pad hide-for-print" id="msgs" data-unread="{{ ws.unread }}">
                    <ul class="off-canvas-list" id="message-list">
                        <li>
                            <a
                                href="#"
                                title="{{ user.current.getHideNotificationsTray ? dockNotifsTitle : undockNotifsTitle }}"
                                class="right-menu-dock show-for-xlarge-up"
                                id="right-menu-dock"
                                data-dock-state="{{ not user.current.getHideNotificationsTray }}"
                                data-title-dock="{{ dockNotifsTitle }}"
                                data-title-undock="{{ undockNotifsTitle }}"
                            ></a>
                            <label id="notification-toggle-full">Notifications</label>
                            <a class="icon-settings" href="{{ routeLookup("messages.configure") }}"></a>
                        </li>
                        <li id="pwaPrompt" class="content">
                            {% include '@messages/pwa.twig' with { notifButton : 'notifOn', pwaPage: 'chrome' } %}
                            <a id="installDelayPrompt" href="#">Later</a>
                        </li>
                        <li>
                            <a id="msg-mar" class="mark-all-read button icon-approve" href="#">Mark all read</a>
                        </li>
                        <li>
                            <section>
                                <ul id="msg-content" class="action-list">
                                    <li data-msgitem class="actions-small-1">
                                        <div class="list-item">
                                            <div class="compact card wrap-down small-12">
                                                <a data-msgitem-href class="no-pad">
                                                    <img data-msgitem-thumb />
                                                    <p data-msgitem-title></p>
                                                    <p class="meta spaced" data-msgitem-time></p>
                                                </a>
                                            </div>
                                        </div>
                                        <nav>
                                            <a data-msgitem-ack class="icon-approve no-pad" title="Mark as read"></a>
                                        </nav>
                                    </li>
                                </ul>
                            </section>
                        </li>
                        <li>
                            <a href="/messages" class="button" data-msgfooter-action>
                                <span class="connecting"></span>&nbsp;Connecting&hellip;
                            </a>
                        </li>
                    </ul>
                </aside>
                <div id="alert-dialog" class="reveal-modal" data-reveal aria-labelledby="modalTitle" aria-hidden="true" role="dialog">
                    <h2 data-modal-title></h2>
                    <ul id="alert-content" class="information-list no-pad">
                        <li data-msgitem>
                            <div class="card wrap-down small-12">
                                <a data-msgitem-href>
                                    <img data-msgitem-thumb />
                                    <p data-msgitem-title></p>
                                </a>
                            </div>
                        </li>
                    </ul>
                    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
                </div>

                {% autoescape 'js' %}
                <script type="text/javascript">
                    $(function () {
                        // launch the notifier
                        $('#msgs').notifier({
                            unread:   Number('{{ ws.unread }}'),
                            maxstack: Number('{{ ws.stackLimit }}'),
                            itemTimeFormat: dateDisplayFormats.dayjsDatetime
                        });

                        $('#alert-dialog').on('click', 'a.action', function (e) {
                            e.preventDefault();
                        });

                        $('#profile-drop').on('click', function(e) {
                            $(".c-header-search").removeClass( "focus" );
                            e.preventDefault(); // Prevent '#' from being appended to the URL.  This can mess up interactions with the browser history API.
                        });

                        if ('serviceWorker' in navigator) {
                            window.addEventListener('load', () => {
                                navigator.serviceWorker.register('/service-worker.js')
                                        .then((reg) => {
                                            console.log('Service worker registered.', reg);
                                        });
                            });
                        }
                    });

                    {# js for installing pwa / enabling notifications #}
                    // if install later cookie exists, don't show the div
                    const installDelayCookie = window.localStorage.getItem("installDelayCookie");
                    let deviceId = 'Browser';
                    if (installDelayCookie) {
                        document.querySelector('#installDelayPrompt')?.remove();
                        document.querySelector('#pwaPrompt').remove();
                    }
                    {# if PWA was installed and you are accessing it via the PWA #}
                    if (window.matchMedia('(display-mode: standalone)').matches) {
                        // If visible, hide the install promotion
                        document.querySelectorAll('[data-pwa-action="installPWA"]').forEach((element) => {
                            element.remove();
                        });
                    }

                    {# dupe from https://web.dev/articles/codelab-make-installable and changes to use inside schoolbox #}
                    // Initialize deferredPrompt for use later to show browser install prompt.
                    window.addEventListener('beforeinstallprompt', (event) => {
                        // Prevent the mini-infobar from appearing on mobile.
                        event.preventDefault();
                        {% if config.debug_mode %}
                        console.log('👍', 'beforeinstallprompt', event);
                        {% endif %}
                        // Stash the event so it can be triggered later.
                        window.deferredPrompt = event;
                        // Remove the 'hidden' class from the install button container.
                        document.querySelectorAll('[data-pwa-action="installPWA"]').forEach((element) => {
                            element.classList.toggle('display', 'none');
                        });
                    });

                    document.querySelectorAll('[data-pwa-action="installPWA"]').forEach((element) => {
                        element.addEventListener('click', async () => {
                            {% if config.debug_mode %}
                            console.log('👍', 'butInstall-clicked');
                            {% endif %}
                            const promptEvent = window.deferredPrompt;
                            if (!promptEvent) {
                                // The deferred prompt isn't available.
                                return;
                            }
                            // Show the install prompt.
                            promptEvent.prompt();
                            // Log the result
                            const result = await promptEvent.userChoice;
                            {% if config.debug_mode %}
                            console.log('👍', 'userChoice', result);
                            {% endif %}
                            // Reset the deferred prompt variable, since
                            // prompt() can only be called once.
                            window.deferredPrompt = null;
                            // Hide the install button.
                            document.querySelectorAll('[data-pwa-action="installPWA"]').forEach((element) => {
                                element.classList.toggle('display', 'block');
                            });
                        });
                    });

                    window.addEventListener('appinstalled', (event) => {
                        {% if config.debug_mode %}
                        console.log('👍', 'appinstalled', event);
                        {% endif %}
                        // Clear the deferredPrompt so it can be garbage collected
                        window.deferredPrompt = null;
                    });


                    document.querySelector('#installDelayPrompt')?.addEventListener('click', () => {
                        window.localStorage.setItem("installDelayCookie", "installLater");
                        document.querySelector('#pwaPrompt').remove();
                        document.querySelector('#installDelayPrompt')?.remove();
                    });

                    {# if iOS and the iOS link exists, show it and hide the rest #}
                    function iOS() {
                        return [
                                'iPad Simulator',
                                'iPhone Simulator',
                                'iPod Simulator',
                                'iPad',
                                'iPhone',
                                'iPod'
                            ].includes(navigator.platform)
                            // iPad on iOS 13 detection
                            || (navigator.userAgent.includes("Mac") && "ontouchend" in document)
                    }

                    /** define device ID
                     * if different to a desktop browser
                     */
                    if (iOS()) {
                        deviceId = 'iOS';
                    } else if (/android/i.test(navigator.userAgent)) {
                        deviceId = 'Android';
                    }

                    if (iOS() && {{ (config.digistorm_apple_app_store_link ?? '' != '') ? true : false}}) {
                        {% if config.debug_mode %}
                        console.log('iOS');
                        {% endif %}
                        {# disable Notifications, Need to have the app installed and on the homepage to even think about allowing notifs #}
                        document.querySelectorAll('[data-pwa-action="enableNotif"]').forEach((element) => {
                            element.toggleAttribute('disabled', true);
                        });
                        document.querySelectorAll('[data-pwa-action="installGoogle"]').forEach((element) => {
                            element.remove();
                        });
                        document.querySelectorAll('[data-pwa-action="installPWA"]').forEach((element) => {
                            element.remove();
                        });
                    }
                            {# if android and the android link exists, show it and hide the rest #}
                    else if (/android/i.test(navigator.userAgent && {{ (config.digistorm_google_play_store_link ?? '' != '') ? true : false }})) {
                        {% if config.debug_mode %}
                        console.log('Android');
                        {% endif %}
                        document.querySelectorAll('[data-pwa-action="installApple"]').forEach((element) => {
                            element.remove();
                        });
                        document.querySelectorAll('[data-pwa-iOS="iOSHomePrompt"]').forEach((element) => {
                            element.remove();
                        });
                        document.querySelectorAll('[data-pwa-action="installPWA"]').forEach((element) => {
                            element.remove();
                        });
                    } else {
                        {% if config.debug_mode %}
                        console.log('Normal PWA');
                        {% endif %}
                        document.querySelectorAll('[data-pwa-action="installApple"]').forEach((element) => {
                            element.remove();
                        });
                        document.querySelectorAll('[data-pwa-iOS="iOSHomePrompt"]').forEach((element) => {
                            element.remove();
                        });
                        document.querySelectorAll('[data-pwa-action="installGoogle"]').forEach((element) => {
                            element.remove();
                        });
                    }

                    {# if notifications have been disabled show prompt, and disable allow notif switch #}
                    if (("Notification" in window)) {
                        if (Notification.permission === "granted") {
                            document.querySelectorAll('[data-pwa-action="enableNotif"]').forEach( (element)=>{
                                element.setAttribute('checked', true);
                            });
                            document.querySelectorAll('[data-pwa="notifBlocked"]').forEach( (element)=> {
                                element.remove();
                            });
                        } else if (Notification.permission !== "denied") {
                            document.querySelectorAll('[data-pwa="notifBlocked"]').forEach( (element)=> {
                                element.classList.toggle('display', 'block');
                            });
                            {# wait for toggle change #}

                            document.querySelectorAll('[data-pwa-action="enableNotifPrompt"]').forEach( (element)=> {
                                element?.addEventListener('click', () => {
                                    if ('on' === element.querySelector('[data-pwa-action="enableNotif"]').value) {
                                        window.Notification.requestPermission().then((permission) => {
                                            if (permission === 'granted') {
                                                {% if config.debug_mode %}
                                                console.info('Notification permission granted');
                                                {% endif %}

                                                document.dispatchEvent(
                                                    new CustomEvent("PWA_NOTIFICATION_ALLOW", {
                                                        detail: {
                                                            debug: {{ config.debug_mode }},
                                                            deviceId: deviceId,
                                                        },
                                                    }),
                                                );
                                            } else if (permission === 'denied') {
                                                document.querySelectorAll('[data-pwa="notifBlocked"]').forEach( (element)=> {
                                                    element.classList.toggle('display', 'none');
                                                });
                                                {% if config.debug_mode %}
                                                console.warn('Notification permission denied');
                                                {% endif %}
                                            }
                                        });
                                    } else {
                                        {# turn notifications off... #}
                                        document.dispatchEvent(
                                            new CustomEvent("PWA_NOTIFICATION_DENY", {
                                                detail: {
                                                    debug: {{ config.debug_mode }},
                                                },
                                            }),
                                        );
                                    }
                                });
                            });

                        } else {
                            document.querySelectorAll('[data-pwa-action="enableNotif"]').forEach( (element)=>{
                                element.classList.toggle('display', 'none');
                            });
                            document.querySelectorAll('[data-pwa="notifBlocked"]').forEach( (element)=> {
                                element.classList.toggle('display', 'none');
                            });
                        }
                    }

                </script>
                {% endautoescape %}
            {% endif %}
        {% endblock %}
        <a href="#" class="exit-off-canvas"></a>
    </div>
</div>
<div id="toast-container">
    <sbx-toast />
</div>
<script src="{{ CDN_PREFIX }}/js/bundle/headerSearch.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/sbxToast.js?v={{ config.site_version }}"></script>
<script src="{{ CDN_PREFIX }}/js/bundle/firebaseInit.js?v={{ config.site_version }}"></script>
</body>
</html>
