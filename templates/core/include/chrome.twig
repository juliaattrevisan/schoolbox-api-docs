<head>
    {# TODO consider if there's a better way to set title? #}
    <title>{{ config.title }}{{ chrome.title ? (' - ' ~ chrome.title) : '' }}</title>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="Content-Language" content="en-au" />
    <meta name="author" content="Alaress Pty Ltd"/>
    <meta name="application-name" content="{{ config.school_name }}" />
    <meta name="msapplication-TileColor" content="#0066b0" />
    <meta name="msapplication-square70x70logo" content="/images/logo.php?logo=skin_logo_square&size=tile70" />
    <meta name="msapplication-square150x150logo" content="/images/logo.php?logo=skin_logo_square&size=tile150" />
    <meta name="msapplication-wide310x150logo" content="/images/logo.php?logo=skin_logo_login&size=tile310" />
    <meta name="msapplication-square310x310logo" content="/images/logo.php?logo=skin_logo_large&size=tile310" />
    <meta name="viewport" content="initial-scale=1, maximum-scale=1">
    <link rel="apple-touch-icon" sizes="57x57" href="/images/logo.php?logo=skin_logo_square&size=apple57">
    <link rel="apple-touch-icon" sizes="60x60" href="/images/logo.php?logo=skin_logo_square&size=apple60">
    <link rel="apple-touch-icon" sizes="72x72" href="/images/logo.php?logo=skin_logo_square&size=apple72">
    <link rel="apple-touch-icon" sizes="76x76" href="/images/logo.php?logo=skin_logo_square&size=apple76">
    <link rel="apple-touch-icon" sizes="114x114" href="/images/logo.php?logo=skin_logo_square&size=apple114">
    <link rel="apple-touch-icon" sizes="120x120" href="/images/logo.php?logo=skin_logo_square&size=apple120">
    <link rel="apple-touch-icon" sizes="144x144" href="/images/logo.php?logo=skin_logo_square&size=apple144">
    <link rel="apple-touch-icon" sizes="152x152" href="/images/logo.php?logo=skin_logo_square&size=apple152">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo.php?logo=skin_logo_square&size=apple180">

    {% block mainHeader %}
        <link rel="stylesheet" type="text/css" href="/css/{{ config.site_location }}/chrome-foundation.css?v={{ config.site_version }}" />
        <link rel="Shortcut Icon" href="/images/logo.php?logo=skin_logo_square&size=favicon" type="image/x-icon" />

        {# header custom CSS: never used AFAICT #}
        {#<link rel="stylesheet" type="text/css" media="{HEADER_CSS_TYPE}" href="{HEADER_CSS_LOCATION}" />#}

        <link rel="stylesheet" type="text/css" href="/javascript/components/fullcalendar/dist/fullcalendar.min.css" />
        <link rel="stylesheet" type="text/css" href="/javascript/components/fullcalendar/dist/fullcalendar.print.css" media="print" />
        <link rel="stylesheet" type="text/css" href="/javascript/components/fullcalendar-scheduler/dist/scheduler.min.css" />
        <link rel="stylesheet" type="text/css" href="/css/core/fullcalendar/fullcalendar.overrides.css" />

        {% if tour.url and not user.impersonated %}
            {% autoescape 'js' %}
            <script type="text/javascript">
                window.tourUrl = '{{ tour.url }}';
            </script>
            {% endautoescape %}
        {% endif %}

        <script type="text/javascript" src="/javascript/components/schoolbox.min.js?v={{ config.site_version }}"></script>
        <script type="text/javascript" src="/javascript/components/schoolbox-fullcalendar.min.js?v={{ config.site_version }}"></script>
        <script src="/javascript/shared/browser-redirect.js"></script>
        <script type="text/javascript" src="/javascript/math/jscurry-0.3.0.js"></script>
        <script type="text/javascript" src="/javascript/math/jqmath-0.4.0.js"></script>
        <script async charset="utf-8" src="//cdn.iframe.ly/embed.js?api_key=94aa8fc28ac1089a2dfb28"></script>

        {% autoescape 'js' %}
        <script type="text/javascript">

            // Disable $ formula encoding
            M.$mathQ = false;

            $(function() {
                $('#infoPanel').find('a[data-menu]').flyout();
                $('#nav').touchMenu()
                    .scrollToTop({
                            cancel: function () {
                                return !$(this).parent().hasClass('has-submenu');
                            }
                        }
                    );

                var s = $('#search');
                s.on('click', '[data-jsubmit]', function () {
                    if (s.find('input').val()) {
                        s.submit();
                    }
                });

                /* Replace all editor video/audio placeholders
                 */
                $.fn.schoolboxResource_ProxyReplacment();

                $('.right-small, .right-off-canvas-menu').hover(function(){
                        $('.right-off-canvas-menu').addClass('overlap');
                    },
                    function(){
                        $('.right-off-canvas-menu').removeClass('overlap');
                    });

                $('.right-small a, .right-off-canvas-menu label').click(function() {
                    $('.inner-wrap').toggleClass('docking');
                    $(this).toggleClass('raquo');

                    if ($('.inner-wrap').hasClass('docking')){
                        $.post('/ajax/notificationsTray', {state: 'show'}, function(responseText) {
                        });
                    }
                    else {
                        $.post('/ajax/notificationsTray', {state: 'hide'}, function(responseText) {
                        });
                    }
                });

                /* Ensure modals always appear in a visible location
                 *
                 * The callback open.fndtn.reveal doesn't fire when the
                 * modal is built dynamically with js -_-
                 *
                 * Also, arbitrary 6.25rem padding at top (in the design)
                 */
                var modalTop = 6.25*16;

                $(document).on('open.fndtn.reveal', '[data-reveal]', function () {
                    $(this).css({'top': $(window).scrollTop() + modalTop + 'px'});
                });

                $(document).on('opened.fndtn.reveal', '[data-reveal]', function () {
                    $(this).css({'top': $(window).scrollTop() + modalTop + 'px'});
                });

                var splash, d, x, y, splashTimeout;
                $(document).on('click', ".button, button, .sub-nav a, .pagination a, .flex-list a, [data-component-palette]", function(e) {

                    splash = $(this).find(".splash");
                    splash.removeClass('animate');
                    clearTimeout(splashTimeout);

                    if (splash.length === 0) {
                        $(this).prepend("<span class='splash'></span>");
                    }

                    if (!splash.height() && !splash.width()) {
                        d = Math.max($(this).outerWidth(), $(this).outerHeight());
                        splash.css({height: d, width: d});
                    }

                    x = e.pageX - $(this).offset().left - splash.width()/2;
                    y = e.pageY - $(this).offset().top - splash.height()/2;

                    splash.css({top: y+'px', left: x+'px'}).addClass("animate");

                    // Remove the animation after a bit of time, otherwise this animation will happen every time the element hides and becomes visible again
                    splashTimeout = setTimeout(function() {
                        splash.removeClass('animate');
                    }, 300);
                });
            });

            // Date formats (global variable)
            var siteLocation = "{{ config.site_location }}";

            var dateDisplayFormats = {
                momentJs:          "{{ config.date_local | momentJsFormat }}",
                momentJsDatetime:  "{{ (config.date_local ~ ' ' ~ config.date_time) | momentJsFormat }}",
                momentJsDateLong:  "{{ config.date_long | momentJsFormat }}",
                localDate:         "{{ config.date_local }}",
                localDateTime:     "{{ config.date_local ~ ' ' ~ config.date_time }}",
                calendarStartTime: "{{ config.calendar_start_time }}"
            };

            // TODO consider expanding Schoolbox json-serialized user so these fields get output
            var schoolboxUser   = {{ user.current | json_encode | raw }};
            schoolboxUser.name  = "{{ user.current.formatName }}";
            schoolboxUser.email = "{{ user.current.email }}";
            schoolboxUser.year  = "{{ user.current.year }}";
            schoolboxUser.role  = {{ user.current.role | json_encode | raw }};

            // TODO set if they're impersonated
            schoolboxUser.impersonated = Boolean('{{ user.impersonated}}');

            $.datepicker.setDefaults({
                dateFormat: dateDisplayFormats.datepicker
            });
        </script>
        {% endautoescape %}

        {# Header JS: AFAICT used nowhere #}
        {#<script type="text/javascript" src="{HEADER_SCRIPT_LOCATION}"></script>#}

        {% if config.site_usage_tracking %}
        <!-- Global Site Tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-97642429-1"></script>

        {% autoescape 'js' %}
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments)}
            gtag('js', new Date());

            // Set tracking ID and map custom dimensions
            gtag('config', 'UA-97642429-1', {
                'custom_map': {
                    'dimension1': 'site_school_code',
                    'dimension2': 'site_type',
                    'dimension3': 'role_name',
                    'dimension4': 'role_type',
                    'dimension5': 'user_year',
                    'dimension6': 'site_version',
                    'dimension7': 'impersonated'
                }
            });

            // Send custom dimension events
            gtag('event', 'site_school_code_dimension', {'site_school_code': '{{ config. site_school_code }}'});
            gtag('event', 'site_type_dimension', {'site_type': '{{ config.site_type }}'});
            gtag('event', 'site_version_dimension', {'site_version': '{{ config.site_version }}'});

            if (schoolboxUser.id) {
                gtag('event', 'role_name_dimension', {'role_name': schoolboxUser.role.name });
                gtag('event', 'role_type_dimension', {'role_type': schoolboxUser.role.type });

                if (schoolboxUser.role.student) {
                    gtag('event', 'user_year_dimension', {'user_year': schoolboxUser.year});
                }

                if (schoolboxUser.impersonated) {
                    gtag('event', 'impersonated_dimension', {'impersonated': 1});
                }
            }
        </script>
        {% endautoescape %}

        {% endif %}

        {# TODO hide if on admin page #}
        {{ config.site_header_scripts | raw }}

    {% endblock mainHeader %}

    {##
     # Twig doesn't/can't use custom headers, AFAICT.
     # Only way I can see this happening is if I could override a block in
     # a base template included by another one?
     #}
    {#{CUSTOM_HEADER_REGION}#}

</head>
<body class="{{ ws.enabled ? '' : 'disableNotifications' }}">
<div class="off-canvas-wrap docs-wrap" data-offcanvas>
    <div class="inner-wrap {{ user.current.hideNotificationsTray ? '' : 'docking' }}">

        {% block instant %}
            <aside class="right-off-canvas-menu island no-pad hide-for-print" id="msgs" data-unread="{{ ws.unread }}">
                <ul class="off-canvas-list" id="message-list">
                    <li>
                        <label title="Click to hide or show Notifications">Notifications</label>
                    </li>
                    <li>
                        <a id="msg-mar" class="mark-all-read button icon-approve" href="#">Mark all read</a>
                    </li>
                    <li>
                        <section>
                            <ul id="msg-content" class="action-list">
                                <li data-msgitem class="actions-small-1">
                                    <div class="list-item">
                                        <div class="compact card wrap-down small-12">
                                            <a data-msgitem-href class="no-pad">
                                                <img data-msgitem-thumb />
                                                <p data-msgitem-title></p>
                                                <p class="meta spaced" data-msgitem-time></p>
                                            </a>
                                        </div>
                                    </div>
                                    <nav>
                                        <a data-msgitem-ack class="icon-approve no-pad" title="Mark as read"></a>
                                    </nav>
                                </li>
                            </ul>
                        </section>
                    </li>
                    <li>
                        <a href="/messages" class="button" data-msgfooter-action>
                            <span class="connecting"></span>&nbsp;Connecting&hellip;
                        </a>
                    </li>
                </ul>
            </aside>
            <div id="alert-dialog" class="reveal-modal" data-reveal aria-labelledby="modalTitle" aria-hidden="true" role="dialog">
                <h2 data-modal-title></h2>
                <ul id="alert-content" class="information-list no-pad">
                    <li data-msgitem>
                        <div class="card wrap-down small-12">
                            <a data-msgitem-href>
                                <img data-msgitem-thumb />
                                <p data-msgitem-title></p>
                            </a>
                        </div>
                    </li>
                </ul>
                <a class="close-reveal-modal" aria-label="Close">&#215;</a>
            </div>

            {% autoescape 'js' %}
            <script type="text/javascript">
                $(function () {
                    // launch the notifier
                    $('#msgs').notifier({
                        host:     '{{ ws.host }}',
                        port:     Number('{{ ws.port }}'),
                        path:     '{{ ws.path }}',
                        secure:   Boolean('{{ ws.secure }}'),
                        unread:   Number('{{ ws.unread }}'),
                        maxstack: Number('{{ ws.stackLimit }}')
                    });

                    $('#alert-dialog').on('click', 'a.action', function (e) {
                        e.preventDefault();
                    })
                });
            </script>
            {% endautoescape %}
        {% endblock %}


        <aside class="left-off-canvas-menu hide-for-print" data-side-nav>
            <div class="logo-wrapper">
                <a href="/" class="logo">
                    <img src="/images/logo.php?logo=skin_logo_large&size=normal" srcset="/images/logo.php?logo=skin_logo_large&size=normal 1x,/images/logo.php?logo=skin_logo_large&size=hidpi 2x" alt="{{ config.school_name }}"/>
                </a>
            </div>

            {% if user.current %}
            <div class="row">
                <ul class="account-menu accordion" id="account-menu" data-accordion>
                    <li class="accordion-navigation">
                        <a href="#accountContent" class="profile-drop" id="profile-accordion">
                            <img height="72" width="72" alt="View Profile" src="/portrait.php?userId={{ user.current.externalId }}&size=square80"/>
                            <span>{{ user.current.formatName }}</span>
                        </a>
                        <div id="accountContent" class="content">
                            <ul id="profile-options">
                                <li><a class="icon-staff-students" href="/search/user/{{ user.current.id }}">Profile</a></li>
                                <li><a class="icon-settings" href="/settings/messages">Settings</a></li>
                                {% if user.current.superuser %}
                                <li><a class="icon-locked" href="/adminv2/home">Administration</a></li>
                                {% endif %}
                                <li><a class="icon-logout" href="/logout.php">Logout</a></li>
                            </ul>
                            <ul id="avatar2">

                                {% if user.current.linkedUser is not empty %}
                                <li>
                                    <ul id="switch-user">
                                        <li class="separator">Switch User</li>
                                        {% for linkedUser in user.current.linkedUser %}
                                        <li class="switch-user">
                                            <div class="card small-12">
                                                <a class="no-pad" href="/user/switch/{{ linkedUser.id }}" title="Switch to {{ linkedUser.formatName }}">
                                                    <img src="/portrait.php?userId={{ linkedUser.externalId }}&amp;size=square64" />
                                                    <p>{{ linkedUser.formatName }}</p>
                                                    <p class="meta">{{ linkedUser.role.name }}</p>
                                                </a>
                                            </div>
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </li>
                                {% endif %}

                                {% if user.previous %}
                                <li class="switch-user">
                                    <div class="card small-12">
                                        <a class="no-pad" href="/user/recoverSession" title="Return to {{ user.previous.formatName }}">
                                            <img src="/portrait.php?userId={{ user.previous.externalId }}&amp;size=square64" />
                                            <p>{{ user.previous.formatName }}</p>
                                            <p class="meta">{{ user.previous.role.name }}</p>
                                        </a>
                                    </div>
                                </li>
                                {% endif %}
                            </ul>
                        </div>
                    </li>
                </ul>
            </div>
            {% endif %}

            <nav class="row">
                <ul class="off-canvas-list second-nav">
                    {% block menuTopOffCanvas %}
                        {% include '@menuTop/renderer.twig' with topMenu only %}
                    {% endblock menuTopOffCanvas %}
                </ul>
            </nav>

            {% block menuSideOffCanvas %}
                {% include '@menuSide/renderer.twig' with sideMenu only %}
            {% endblock menuSideOffCanvas %}
        </aside>

        <!-- START CONTAINER -->
        <section class="main-section">
            <div id="header">
                {# Never used AFAICT #}
                {#{MAIN_BANNER_REGION}#}
            </div>

            <!-- The Schoolbox Hybrid Bar -->
            <div class="hybrid-bar hide-for-print" id="hybrid-bar">
                <nav class="tab-bar">
                    <section class="left-small">
                        <a class="left-off-canvas-toggle menu-icon hide-for-large-up" id="left-off-canvas-toggle" href="#"><span></span></a>
                    </section>

                    <section class="tab-bar-section">
                        <a href="/" class="logo">
                            <img src="/images/logo.php?logo=skin_logo_square&size=normal" srcset="/images/logo.php?logo=skin_logo_square&size=normal 1x,/images/logo.php?logo=skin_logo_square&size=hidpi 2x" alt="{{ config.school_name }}"/>
                        </a>

                        <ul id="top-menu">
                            {% block menuTop %}
                                {% include '@menuTop/renderer.twig' with topMenu only %}
                            {% endblock menuTop %}
                        </ul>

                        <form id="search" action="/search" method="get">
                            <input id="search-field" type="text" name="keyword" placeholder="Search"/>
                            <label data-jsubmit for="search-field" class="icon-search no-text"></label>
                        </form>
                    </section>

                    {% block messaging %}
                    {% if ws.enabled %}
                    <section class="right-small" id="notification-toggle">
                        <a class="right-off-canvas-toggle icon-notifications hidden-for-xlarge-up" data-unread="{{ ws.unread }}">
                            <span data-unread-count>{{ ws.unread ?? ''}}</span>
                        </a>
                        <a class="icon-notifications show-for-xlarge-up" data-unread="{{ ws.unread }}">
                            <span data-unread-count>{{ ws.unread ?? '' }}</span>
                        </a>
                    </section>
                    {% endif %}
                    {% endblock messaging %}

                </nav>
            </div>

            <div id="container">
                <div id="content">
                    {% include template with data only %}
                </div>
            </div>

            {% block footer %}
                <div id="footer" class="clearfix">
                    <ul>
                        <li>{{ NOW.year }} &copy; Copyright <a href="{{ config.school_address }}">{{ config.school_name }}</a></li>
                        <li><a href="/policy.php">Guidelines of Use and Privacy Policy</a></li>
                        <li><a href="http://www.schoolbox.com.au" title="Schoolbox, Virtual Learning Environment, Learning Management System, LMS">Schoolbox</a>
                            {{ config.site_version }} by <a href="http://www.alaress.com.au">Alaress</a></li>
                        {% if config.feedback_url and config.feedback_text %}
                        <li><a href="{{ config.feedback_url }}">{{ config.feedback_text }}</a></li>
                        {% endif %}
                    </ul>
                </div>
                <script type="text/javascript">
                    Foundation.global.namespace = '';
                    $(document).foundation();

                    $(function () {
                        var s = $('#search');

                        s.on('focus blur', 'input', function (e) {
                            if (e.type === 'focusin') {
                                s.addClass('focus');
                            } else {
                                s.removeClass('focus');
                            }
                        });
                    });
                </script>
                {{ config.site_analytics | raw }}
            {% endblock %}

            {{ debugBar.head | raw }}
            {{ debugBar.body | raw }}
        </section>
        <!-- END CONTAINER -->
        <a href="#" class="exit-off-canvas"></a>
    </div>
</div>
</body>
</html>
