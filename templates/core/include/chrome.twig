<!DOCTYPE html>
<html xmlns:m="http://www.w3.org/1998/Math/MathML">
<!--  Copyright {{ NOW.year }} Schoolbox Pty Ltd -->
<!--  Visit us at https://schoolbox.com.au/ -->
<head>
    <title>{{ config.title }}{{ chrome.title ? (' - ' ~ chrome.title) : '' }}</title>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="Content-Language" content="en-au" />
    <meta name="author" content="Schoolbox Pty Ltd"/>
    <meta name="application-name" content="{{ config.school_name }}" />
    <meta name="msapplication-TileColor" content="#0066b0" />
    <meta name="msapplication-square70x70logo" content="{{ CDN_PREFIX }}/images/logo.php?logo=skin_logo_square&size=tile70" />
    <meta name="msapplication-square150x150logo" content="{{ CDN_PREFIX }}/images/logo.php?logo=skin_logo_square&size=tile150" />
    <meta name="msapplication-wide310x150logo" content="{{ CDN_PREFIX }}/images/logo.php?logo=skin_logo_login&size=tile310" />
    <meta name="msapplication-square310x310logo" content="{{ CDN_PREFIX }}/images/logo.php?logo=skin_logo_large&size=tile310" />
    <meta name="viewport" content="initial-scale=1, maximum-scale=1">
    <link rel="apple-touch-icon" sizes="57x57" href="/images/logo.php?logo=skin_logo_square&size=apple57">
    <link rel="apple-touch-icon" sizes="60x60" href="/images/logo.php?logo=skin_logo_square&size=apple60">
    <link rel="apple-touch-icon" sizes="72x72" href="/images/logo.php?logo=skin_logo_square&size=apple72">
    <link rel="apple-touch-icon" sizes="76x76" href="/images/logo.php?logo=skin_logo_square&size=apple76">
    <link rel="apple-touch-icon" sizes="114x114" href="/images/logo.php?logo=skin_logo_square&size=apple114">
    <link rel="apple-touch-icon" sizes="120x120" href="/images/logo.php?logo=skin_logo_square&size=apple120">
    <link rel="apple-touch-icon" sizes="144x144" href="/images/logo.php?logo=skin_logo_square&size=apple144">
    <link rel="apple-touch-icon" sizes="152x152" href="/images/logo.php?logo=skin_logo_square&size=apple152">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo.php?logo=skin_logo_square&size=apple180">

    {% block mainHeader %}
        {% include 'include/skin.twig' with { config: config } only %}
        <link rel="stylesheet" type="text/css" href="{{ CDN_PREFIX }}/css/vendors/fullcalendar/datepicker.css?v={{ config.site_version }}" />
        <link rel="Shortcut Icon" href="/images/logo.php?logo=skin_logo_square&size=favicon" type="image/x-icon" />
        {% if tour.data is defined and not user.impersonated %}
        {% autoescape 'js' %}
        <script type="text/javascript">
            window.tourData = {{ tour.data|json_encode|raw }};
        </script>
        {% endautoescape %}
        {% endif %}
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/bundle/main.js?v={{ config.site_version }}"></script>
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/fullcalendar/schoolbox-fullcalendar.min.js?v={{ config.site_version }}"></script>

        <script src="{{ CDN_PREFIX }}/js/browser/browser-redirect.js?v={{ config.site_version }}"></script>
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/math/jscurry-0.3.0.js?v={{ config.site_version }}"></script>
        <script type="text/javascript" src="{{ CDN_PREFIX }}/js/math/jqmath-0.4.0.js?v={{ config.site_version }}"></script>
        <script async charset="utf-8" src="//cdn.iframe.ly/embed.js?api_key=94aa8fc28ac1089a2dfb28" crossorigin></script>

        {% autoescape 'js' %}
        <script type="text/javascript">
            // Disable $ formula encoding
            M.$mathQ = false;

            // Date formats (global variable)
            var siteLocation = "{{ config.site_school_code }}";

            var dateDisplayFormats = {
                dayjs:          "{{ config.date_local | dayjsFormat }}",
                dayjsDatetime:  "{{ (config.date_local ~ ' ' ~ config.date_time) | dayjsFormat }}",
                dayjsDateLong:  "{{ config.date_long | dayjsFormat }}",
                dayjsTime:      "{{ config.date_time | dayjsFormat}}",
                localDate:         "{{ config.date_local }}",
                localDateTime:     "{{ config.date_local ~ ' ' ~ config.date_time }}",
                calendarStartTime: "{{ config.calendar_start_time }}",
                localTime:         "{{ config.date_time }}",
            };

            // This schoolboxUser is here for custom scripts.
            var schoolboxUser            = {{ user.current | json_encode | raw }};
            schoolboxUser.name           = "{{ user.current.formatName }}";
            schoolboxUser.email          = "{{ user.current.email }}";
            schoolboxUser.year           = "{{ user.current.year.name ?? '' }}";
            schoolboxUser.role           = {{ user.current.role | json_encode | raw }};
            schoolboxUser.impersonated   = Boolean('{{ user.impersonated }}');
            schoolboxUser.communityLogin = Boolean('{{ user.communityLogin }}');

            // Reluctantly add the CDN prefix as a global JS variable
            window.cdnPrefix = "{{ CDN_PREFIX }}";
        </script>
        {% endautoescape %}

        {% if config.site_usage_tracking %}
        <!-- Global Site Tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-97642429-1"></script>

        {% autoescape 'js' %}
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments)}
            gtag('js', new Date());

            // Set tracking ID and map custom dimensions
            gtag('config', 'UA-97642429-1', {
                'custom_map': {
                    'dimension1': 'site_school_code',
                    'dimension2': 'site_type',
                    'dimension3': 'role_name',
                    'dimension4': 'role_type',
                    'dimension5': 'user_year',
                    'dimension6': 'site_version',
                    'dimension7': 'impersonated'
                }
            });

            // Send custom dimension events
            gtag('event', 'site_school_code_dimension', {'site_school_code': '{{ config. site_school_code }}'});
            gtag('event', 'site_type_dimension', {'site_type': '{{ config.site_type }}'});
            gtag('event', 'site_version_dimension', {'site_version': '{{ config.site_version }}'});
            {% if user.current.id %}
            gtag('event', 'role_name_dimension', {'role_name': '{{ user.current.role.name }}'});
            gtag('event', 'role_type_dimension', {'role_type': '{{ user.current.role.type }}' });
            {% if user.current.role.isStudent %}
            gtag('event', 'user_year_dimension', {'user_year': '{{ user.current.year.name ?? '' }}' });
            {% endif %}
            gtag('event', 'impersonated_dimension', {'impersonated': {{ user.impersonated ? 1 : 0 }}});
            {% endif %}
        </script>
        {% endautoescape %}

        {% endif %}
        {{ scripts.header | raw }}
    {% endblock mainHeader %}
</head>
<body class="{{ ws.enabled ? '' : 'disableNotifications' }}">
<div class="off-canvas-wrap" id="off-canvas-wrap" data-offcanvas data-transition="overlap">
    <div class="inner-wrap {{ user.current.getHideSidenav ? '' : 'left-open' }} {{ user.current.getHideNotificationsTray ? '' : 'right-open' }}" id="inner-wrap" data-inner-offcanvas>

        {% set dockTitle = 'Pin side menu' %}
        {% set undockTitle = 'Unpin side menu' %}
        <aside id="left-menu" class="left-off-canvas-menu hide-for-print" data-side-nav>
            <a
                href="#"
                title="{{ user.current.getHideSidenav ? dockTitle : undockTitle }}"
                class="left-menu-dock"
                id="left-menu-dock"
                data-dock-state="{{ not user.current.getHideSidenav }}"
                data-title-dock="{{ dockTitle }}"
                data-title-undock="{{ undockTitle }}"
            ></a>
            <div class="logo-wrapper">
                <a href="/" class="logo">
                    <img src="/images/logo.php?logo=skin_logo_large&size=normal" srcset="/images/logo.php?logo=skin_logo_large&size=normal 1x,/images/logo.php?logo=skin_logo_large&size=hidpi 2x" alt="{{ config.school_name }}"/>
                </a>
            </div>

            {% block accountMenuMobile %}
                {% if user.current.id %}
                    <div class="row">
                        <ul class="account-menu-mobile accordion" id="account-menu-mobile" data-accordion>
                            <li class="accordion-navigation">
                                <a href="#account-content-mobile" class="profile-drop" id="profile-accordion">
                                    {% include 'include/portrait.twig' with {user: user.current, render: 'menuMobile'} only %}
                                    <span>{{ user.current.formatName }}</span>
                                </a>
                                <div id="account-content-mobile" class="content">
                                    {% include 'include/accountMenu.twig' with {user: user, mobile: true} only %}
                                </div>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            {% endblock accountMenuMobile %}

            {% block menuTopOffCanvas %}
                {% if user.current.id %}
                    <nav class="row">
                        <ul class="off-canvas-list second-nav" id="overflow-nav">
                            {% include '@menuTop/renderer.twig' with topMenu only %}
                        </ul>
                    </nav>
                {% endif %}
            {% endblock menuTopOffCanvas %}

            {% block menuSideOffCanvas %}
                {% if user.current.id %}
                    {% include '@menuSide/renderer.twig' with sideMenu only %}
                {% endif %}
            {% endblock menuSideOffCanvas %}
        </aside>

        <!-- CONTAINER -->
        <section class="main">
            <div id="header">
                {# Never used AFAICT #}
                {#{MAIN_BANNER_REGION}#}
            </div>
            <div class="hybrid-bar hide-for-print" id="hybrid-bar" {% if user.no_header %}style="display:none"{% endif %}>
                <nav class="tab-bar">
                    <section class="left-small" id="menu-toggle">
                        <a class="left-off-canvas-toggle menu-icon" id="left-off-canvas-toggle">
                            <svg width="18" height="14" viewBox="0 0 80 60">
                                <rect width="100" height="10"></rect>
                                <rect width="100" y="25" height="10"></rect>
                                <rect width="100" y="50" height="10"></rect>
                            </svg>
                        </a>
                    </section>

                    <section class="tab-bar-section">
                        <a href="/" class="logo">
                            <img src="/images/logo.php?logo=skin_logo_square&size=normal" srcset="/images/logo.php?logo=skin_logo_square&size=normal 1x,/images/logo.php?logo=skin_logo_square&size=hidpi 2x" alt="{{ config.school_name }}"/>
                        </a>

                        {% block menuTop %}
                            {% if user.current.id %}
                                <ul id="top-menu" class="top-menu">
                                    {% include '@menuTop/renderer.twig' with topMenu only %}
                                </ul>
                            {% endif %}
                        {% endblock menuTop %}

                        {% block search %}
                            {% if user.current.id %}
                                <search-bar></search-bar>
                            {% endif %}
                        {% endblock search %}

                        {% block accountMenu %}
                            {% if user.current.id %}
                                <a href="#" id="profile-drop" title="{{ user.current.fullName }}" class="account-menu">
                                    {% include 'include/portrait.twig' with {user: user.current, render: 'menuMobile'} only %}
                                </a>
                                <div id="account-content" class="account-drop">
                                    {% include 'include/accountMenu.twig' with {user: user, mobile: false} only %}
                                </div>
                            {% endif %}
                        {% endblock accountMenu %}
                    </section>

                    {% block messaging %}
                        {% if ws.enabled and user.current.id %}
                            <section class="right-small" id="notifications">
                                <a class="right-off-canvas-toggle icon-notifications" id="notification-toggle" data-unread="{{ ws.unread }}">
                                    <span data-unread-count>{{ ws.unread ?? '' }}</span>
                                </a>
                            </section>
                        {% endif %}
                    {% endblock messaging %}

                </nav>
            </div>

            <div id="container">
                <div id="content">
                    {% include template with data only %}
                </div>
            </div>

            {% block footer %}
                <div id="footer" class="clearfix">
                    <ul>
                        <li>{{ NOW.year }} &copy; Copyright <a href="{{ config.school_address }}">{{ config.school_name }}</a></li>
                        <li><a href="{{ routeLookup('policy.getPolicy') }}">Guidelines of Use and Privacy Policy</a></li>
                        <li><a href="https://schoolbox.com.au" title="Schoolbox, Virtual Learning Environment, Learning Management System, LMS">Schoolbox</a>
                            {{ config.site_version }}</li>
                        {% if config.feedback_url and config.feedback_text %}
                            <li><a href="{{ config.feedback_url }}">{{ config.feedback_text }}</a></li>
                        {% endif %}
                    </ul>
                </div>

                {# Yandex translation service
                 # Only available to parents depending on config setting
                 #}
                {% include 'sub/yandex.twig' %}

                <script type="text/javascript">
                    Foundation.global.namespace = '';
                    $(document).foundation();
                </script>
                {% set user_role = user.current.role.name | escape('js') %}
                {{ config.site_analytics | replace({'{USER_ROLE}':user_role}) | raw }}
            {% endblock %}

            {% if debugBar is defined %}
                {{ debugBar.head | raw }}
                {{ debugBar.body | raw }}
            {% endif %}
        </section>
        <!-- END CONTAINER -->

        {% block instant %}
            {% if ws.enabled and user.current.id %}
                {% set dockNotifsTitle = 'Pin notifications' %}
                {% set undockNotifsTitle = 'Unpin notifications' %}
                <aside class="right-off-canvas-menu island no-pad hide-for-print" id="msgs" data-unread="{{ ws.unread }}">
                    <ul class="off-canvas-list" id="message-list">
                        <li>
                            <a
                                href="#"
                                title="{{ user.current.getHideNotificationsTray ? dockNotifsTitle : undockNotifsTitle }}"
                                class="right-menu-dock show-for-xlarge-up"
                                id="right-menu-dock"
                                data-dock-state="{{ not user.current.getHideNotificationsTray }}"
                                data-title-dock="{{ dockNotifsTitle }}"
                                data-title-undock="{{ undockNotifsTitle }}"
                            ></a>
                            <label id="notification-toggle-full">Notifications</label>
                        </li>
                        <li>
                            <a id="msg-mar" class="mark-all-read button icon-approve" href="#">Mark all read</a>
                        </li>
                        <li>
                            <section>
                                <ul id="msg-content" class="action-list">
                                    <li data-msgitem class="actions-small-1">
                                        <div class="list-item">
                                            <div class="compact card wrap-down small-12">
                                                <a data-msgitem-href class="no-pad">
                                                    <img data-msgitem-thumb />
                                                    <p data-msgitem-title></p>
                                                    <p class="meta spaced" data-msgitem-time></p>
                                                </a>
                                            </div>
                                        </div>
                                        <nav>
                                            <a data-msgitem-ack class="icon-approve no-pad" title="Mark as read"></a>
                                        </nav>
                                    </li>
                                </ul>
                            </section>
                        </li>
                        <li>
                            <a href="/messages" class="button" data-msgfooter-action>
                                <span class="connecting"></span>&nbsp;Connecting&hellip;
                            </a>
                        </li>
                    </ul>
                </aside>
                <div id="alert-dialog" class="reveal-modal" data-reveal aria-labelledby="modalTitle" aria-hidden="true" role="dialog">
                    <h2 data-modal-title></h2>
                    <ul id="alert-content" class="information-list no-pad">
                        <li data-msgitem>
                            <div class="card wrap-down small-12">
                                <a data-msgitem-href>
                                    <img data-msgitem-thumb />
                                    <p data-msgitem-title></p>
                                </a>
                            </div>
                        </li>
                    </ul>
                    <a class="close-reveal-modal" aria-label="Close">&#215;</a>
                </div>

                {% autoescape 'js' %}
                <script type="text/javascript">
                    $(function () {
                        // launch the notifier
                        $('#msgs').notifier({
                            unread:   Number('{{ ws.unread }}'),
                            maxstack: Number('{{ ws.stackLimit }}')
                        });

                        $('#alert-dialog').on('click', 'a.action', function (e) {
                            e.preventDefault();
                        });

                        $('#profile-drop').on('click', function(e) {
                            $(".global-search").removeClass( "focus" );
                        });
                    });
                </script>
                {% endautoescape %}
            {% endif %}
        {% endblock %}
        <a href="#" class="exit-off-canvas"></a>
    </div>
</div>

<script src="{{ CDN_PREFIX }}/js/bundle/searchBar.js?v={{ config.site_version }}"></script>
</body>
</html>
