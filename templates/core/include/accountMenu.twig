{#
 # Account dropdown of options for the user (profile, settings, logout, etc) & including switch users
 # This was split into a twig fragment so that it could be used on the mobile and non-mobile versions of the account menu
 #
 # @param User user
 # @param boolean mobile
 #}
{% if mobile %}
    {% set mobileSuffix = '-mobile' %}
{% else %}
    {% set mobileSuffix = '' %}
{% endif %}

<ul id="profile-options{{ mobileSuffix }}">
    {% if not mobile %}
        <li class="separator">{{ user.current.fullName }}</li>
    {% endif %}

    <li><a class="icon-staff-students" href="/search/user/{{ user.current.id }}">Profile</a></li>
    <li><a class="icon-settings" href="/settings/messages">Settings</a></li>
    {% if user.current.superuser %}
        <li><a class="icon-locked" href="/adminv2/home">Administration</a></li>
    {% endif %}

    {# Not Help? Show a link to Help #}
    {% if user.current.role.staff and config.show_schoolbox_help_link %}
        <li><a class="icon-help" href="{{ routeLookup('helpSso.sendTokenToHelp') }}" target="_blank">Online Help</a></li>
    {% endif %}

    <li><a class="icon-logout" href="/logout.php">Logout</a></li>
</ul>
{% if user.current.linkedUser is not empty or user.previous  %}
    <ul id="switch-user{{ mobileSuffix }}">
        <li class="separator">Switch User</li>

        {% set previousUser = user.previous | default(null) %}
        {% if user.current.linkedUser is not empty %}
            {% for linkedUser in user.current.linkedUser %}
                {% if not previousUser or previousUser.id != linkedUser.id %}
                <li class="user">
                    <a class="no-pad" href="/user/switch/{{ linkedUser.id }}" title="Switch to {{ linkedUser.formatName }}">
                        <div class="card small-12">
                            {% include 'include/portrait.twig' with {user: linkedUser} %}
                            <p>{{ linkedUser.formatName }}</p>
                            <p class="meta">{{ linkedUser.role.name }}</p>
                        </div>
                    </a>
                </li>
                {% endif %}
            {% endfor %}
        {% endif %}

        {% if previousUser %}
            <li class="user">
                <a class="no-pad" href="/user/recoverSession" title="Return to {{ user.previous.formatName }}">
                    <div class="card small-12">
                        {% include 'include/portrait.twig' with {user: user.previous} %}
                        <p>{{ user.previous.formatName }}</p>
                        <p class="meta">{{ user.previous.role.name }}</p>
                    </div>
                </a>
            </li>
        {% endif %}
    </ul>
{% endif %}
