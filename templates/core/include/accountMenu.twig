{#
 # Account dropdown of options for the user (profile, settings, logout, etc) & including switch users
 # This was split into a twig fragment so that it could be used on the mobile and non-mobile versions of the account menu
 #
 # @param User user
 # @param boolean mobile
 #}
{% if mobile %}
    {% set mobileSuffix = '-mobile' %}
{% else %}
    {% set mobileSuffix = '' %}
{% endif %}

<ul id="profile-options{{ mobileSuffix }}" class="profile-options{{ mobileSuffix }}">
    {% if not mobile %}
        <li class="separator">{{ user.current.fullName }}</li>
    {% else %}
        <li class="separator">Profile Options</li>
    {% endif %}

    <li><a class="icon-staff-students" href="/search/user/{{ user.current.id }}">Profile</a></li>
    <li><a class="icon-settings" href="/settings/notifications">Notification Settings</a></li>
    {% set adminHomeUrl = routeLookupIfAuthorized('adminHome.getIndex') %}
    {% if adminHomeUrl %}
        <li><a class="icon-locked" href="{{ adminHomeUrl }}">Administration</a></li>
    {% endif %}

    {# Not Help? Show a link to Help #}
    {% if user.current.role.staff and config.show_schoolbox_help_link %}
        <li><a class="icon-help" href="{{ routeLookup('helpSso.sendTokenToHelp') }}" target="_blank">Online Help</a></li>
    {% endif %}

    <li><a class="icon-logout" href="/logout.php">Logout</a></li>
</ul>
{% if user.current.linkedUsers is not empty or user.previous or user.initial %}
    <ul id="switch-user{{ mobileSuffix }}" class="switch-user{{ mobileSuffix }}">
        {# Users to switch back to #}
        {% if user.initial or user.previous %}
            <li class="separator">Return To User</li>
            {% if user.previous and user.previous.id != (user.initial.id ?? null) %}
                <li class="user">
                    <a class="no-pad" href="{{ routeLookup('user.recoverSessionPrevious') }}" title="Return to {{ user.previous.formatName }}">
                        <div class="card small-12">
                            {% include 'include/portrait.twig' with {user: user.previous} only %}
                            <p>{{ user.previous.formatName }}</p>
                            <p class="meta">{{ user.previous.role.name }}</p>
                        </div>
                    </a>
                </li>
            {% endif %}
            {% if user.initial %}
                <li class="user">
                    <a class="no-pad" href="{{ routeLookup('user.recoverSessionInitial') }}" title="Return to {{ user.initial.formatName }}">
                        <div class="card small-12">
                            {% include 'include/portrait.twig' with {user: user.initial} only %}
                            <p>{{ user.initial.formatName }}</p>
                            <p class="meta">{{ user.initial.role.name }}</p>
                        </div>
                    </a>
                </li>
            {% endif %}
        {% endif %}

        {# Impersonable users: show all in the list, except for the previous user #}
        {% if user.current.linkedUsers is not empty %}
        <li class="separator">Switch User</li>
            {% for linkedUser in user.current.linkedUsers %}
                <li class="user">
                    <a class="no-pad" href="{{ routeLookup('user.impersonate', {userId: linkedUser.id}) }}" title="Switch to {{ linkedUser.formatName }}">
                        <div class="card small-12">
                            {% include 'include/portrait.twig' with {user: linkedUser} only %}
                            <p>{{ linkedUser.formatName }}</p>
                            <p class="meta">{{ linkedUser.role.name }}</p>
                        </div>
                    </a>
                </li>
            {% endfor %}
        {% endif %}
    </ul>
{% endif %}
