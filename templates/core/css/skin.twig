{% autoescape 'css' %}
{% set customCss = customCss ?? config.skin_custom_css ?? '' %}
{{ customCss | raw }}

:root {
    {% for configKey, colorOptions in colors %}
        {{ colorOptions.cssVar | raw }}-r: {{ colorOptions.r }};
        {{ colorOptions.cssVar | raw }}-g: {{ colorOptions.g }};
        {{ colorOptions.cssVar | raw }}-b: {{ colorOptions.b }};
        {{ colorOptions.cssVar | raw }}-h: {{ colorOptions.h | round(2) }};
        {{ colorOptions.cssVar | raw }}-s: {{ colorOptions.s | round(2) }}%;
        {{ colorOptions.cssVar | raw }}-l: {{ colorOptions.l | round(2) }}%;
        {{ colorOptions.cssVar | raw }}-a: {{ colorOptions.a | round(2) }};
        {{ colorOptions.cssVar | raw }}:   hsla(
            var({{ colorOptions.cssVar | raw }}-h),
            var({{ colorOptions.cssVar | raw }}-s),
            var({{ colorOptions.cssVar | raw }}-l),
            var({{ colorOptions.cssVar | raw }}-a)
        );
    {% endfor %}
}
{% endautoescape %}
