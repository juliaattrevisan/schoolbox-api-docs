{% autoescape 'css' %}
:root {
    {# Nav bar colors #}
    {% if colors.skin_colour_navigation_foreground is defined %}
        --navigation-foreground-h: {{ colors.skin_colour_navigation_foreground.h | round(2) }};
        --navigation-foreground-s: {{ colors.skin_colour_navigation_foreground.s | round(2) }}%;
        --navigation-foreground-l: {{ colors.skin_colour_navigation_foreground.l | round(2) }}%;
        --navigation-foreground-a: {{ colors.skin_colour_navigation_foreground.a | round(2) }}%;
        --navigation-foreground:   hsla(
            var(--navigation-foreground-h),
            var(--navigation-foreground-s),
            var(--navigation-foreground-l),
            var(--navigation-foreground-a)
        );
        {#
            Derived styles:
            $off-canvas-bg-hover
            $off-canvas-bg-active
        #}
    {% endif %}

    {% if colors.skin_colour_navigation_background is defined %}
        --navigation-background-h: {{ colors.skin_colour_navigation_background.h | round(2) }};
        --navigation-background-s: {{ colors.skin_colour_navigation_background.s | round(2) }}%;
        --navigation-background-l: {{ colors.skin_colour_navigation_background.l | round(2) }}%;
        --navigation-background-a: {{ colors.skin_colour_navigation_background.a | round(2) }}%;
        --navigation-background:   hsla(
            var(--navigation-background-h),
            var(--navigation-background-s),
            var(--navigation-background-l),
            var(--navigation-background-a)
        );
        {#
            Derived styles:
            $icon-nav-highlight-color
            .top-menu style buried deep within www/css/foundation/ui/navigation/_navigation.scss
            .right-off-canvas-menu style buried deep within www/css/foundation/ui/navigation/_navigation.scss
        #}
    {% endif %}

    {% if colors.skin_colour_navigation_hover is defined %}
        --navigation-hover-h: {{ colors.skin_colour_navigation_hover.h | round(2) }};
        --navigation-hover-s: {{ colors.skin_colour_navigation_hover.s | round(2) }}%;
        --navigation-hover-l: {{ colors.skin_colour_navigation_hover.l | round(2) }}%;
        --navigation-hover-a: {{ colors.skin_colour_navigation_hover.a | round(2) }}%;
        --navigation-hover:   hsla(
            var(--navigation-hover-h),
            var(--navigation-hover-s),
            var(--navigation-hover-l),
            var(--navigation-hover-a)
        );
        {#
            Derived styles:
            None known
        #}
    {% endif %}


    {# Off-canvas colors #}
    {% if colors.skin_colour_offcanvas_foreground is defined %}
        --off-canvas-foreground-h: {{ colors.skin_colour_offcanvas_foreground.h | round(2) }};
        --off-canvas-foreground-s: {{ colors.skin_colour_offcanvas_foreground.s | round(2) }}%;
        --off-canvas-foreground-l: {{ colors.skin_colour_offcanvas_foreground.l | round(2) }}%;
        --off-canvas-foreground-a: {{ colors.skin_colour_offcanvas_foreground.a | round(2) }}%;
        --off-canvas-foreground:   hsla(
            var(--off-canvas-foreground-h),
            var(--off-canvas-foreground-s),
            var(--off-canvas-foreground-l),
            var(--off-canvas-foreground-a)
        );
        {#
            Derived styles:
            ul.off-canvas-list in www/css/foundation/ui/navigation/_navigation.scss:
            used to generate a constrasting color to off-canvas
        #}
    {% endif %}

    {% if colors.skin_colour_offcanvas_background is defined %}
        --off-canvas-background-h: {{ colors.skin_colour_offcanvas_background.h | round(2) }};
        --off-canvas-background-s: {{ colors.skin_colour_offcanvas_background.s | round(2) }}%;
        --off-canvas-background-l: {{ colors.skin_colour_offcanvas_background.l | round(2) }}%;
        --off-canvas-background-a: {{ colors.skin_colour_offcanvas_background.a | round(2) }}%;
        --off-canvas-background:   hsla(
            var(--off-canvas-background-h),
            var(--off-canvas-background-s),
            var(--off-canvas-background-l),
            var(--off-canvas-background-a)
        );
        {#
            Derived styles:
            $off-canvas-bg
        #}
    {% endif %}

    {% if colors.skin_colour_offcanvas_hover is defined %}
        --off-canvas-hover-h: {{ colors.skin_colour_offcanvas_hover.h | round(2) }};
        --off-canvas-hover-s: {{ colors.skin_colour_offcanvas_hover.s | round(2) }}%;
        --off-canvas-hover-l: {{ colors.skin_colour_offcanvas_hover.l | round(2) }}%;
        --off-canvas-hover-a: {{ colors.skin_colour_offcanvas_hover.a | round(2) }}%;
        --off-canvas-hover:   hsla(
            var(--off-canvas-hover-h),
            var(--off-canvas-hover-s),
            var(--off-canvas-hover-l),
            var(--off-canvas-hover-a)
        );
        {#
            Derived styles:
            None known
        #}
    {% endif %}


    {# Content UI colors #}
    {% if colors.skin_colour_content_ui_foreground is defined %}
        --content-ui-foreground-h: {{ colors.skin_colour_content_ui_foreground.h | round(2) }};
        --content-ui-foreground-s: {{ colors.skin_colour_content_ui_foreground.s | round(2) }}%;
        --content-ui-foreground-l: {{ colors.skin_colour_content_ui_foreground.l | round(2) }}%;
        --content-ui-foreground-a: {{ colors.skin_colour_content_ui_foreground.a | round(2) }}%;
        --content-ui-foreground:   hsla(
            var(--content-ui-foreground-h),
            var(--content-ui-foreground-s),
            var(--content-ui-foreground-l),
            var(--content-ui-foreground-a)
        );
        {#
            Derived styles:
            Too many!
        #}
    {% endif %}

    {% if colors.skin_colour_content_ui_background is defined %}
        --content-ui-background-h: {{ colors.skin_colour_content_ui_background.h | round(2) }};
        --content-ui-background-s: {{ colors.skin_colour_content_ui_background.s | round(2) }}%;
        --content-ui-background-l: {{ colors.skin_colour_content_ui_background.l | round(2) }}%;
        --content-ui-background-a: {{ colors.skin_colour_content_ui_background.a | round(2) }}%;
        --content-ui-background:   hsla(
            var(--content-ui-background-h),
            var(--content-ui-background-s),
            var(--content-ui-background-l),
            var(--content-ui-background-a)
        );
        {#
            Derived styles:
            Too many!
        #}
    {% endif %}

    {% if colors.skin_colour_content_ui_hover is defined %}
        --content-ui-hover-h: {{ colors.skin_colour_content_ui_hover.h | round(2) }};
        --content-ui-hover-s: {{ colors.skin_colour_content_ui_hover.s | round(2) }}%;
        --content-ui-hover-l: {{ colors.skin_colour_content_ui_hover.l | round(2) }}%;
        --content-ui-hover-a: {{ colors.skin_colour_content_ui_hover.a | round(2) }}%;
        --content-ui-hover:   hsla(
            var(--content-ui-hover-h),
            var(--content-ui-hover-s),
            var(--content-ui-hover-l),
            var(--content-ui-hover-a)
        );
        {#
            Derived styles:
            Too many!
        #}
    {% endif %}

    {% if colors.skin_colour_content_ui_hover is defined %}
        --content-ui-selected-h: {{ colors.skin_colour_content_ui_selected.h | round(2) }};
        --content-ui-selected-s: {{ colors.skin_colour_content_ui_selected.s | round(2) }}%;
        --content-ui-selected-l: {{ colors.skin_colour_content_ui_selected.l | round(2) }}%;
        --content-ui-selected-a: {{ colors.skin_colour_content_ui_selected.a | round(2) }}%;
        --content-ui-selected:   hsla(
            var(--content-ui-selected-h),
            var(--content-ui-selected-s),
            var(--content-ui-selected-l),
            var(--content-ui-selected-a)
        );
        {#
            Derived styles:
            Too many!
        #}
    {% endif %}


    {# Content UI submit colors #}
    {% if colors.skin_colour_content_ui_foreground is defined %}
        --content-ui-submit-foreground-h: {{ colors.skin_colour_content_ui_submit_foreground.h | round(2) }};
        --content-ui-submit-foreground-s: {{ colors.skin_colour_content_ui_submit_foreground.s | round(2) }}%;
        --content-ui-submit-foreground-l: {{ colors.skin_colour_content_ui_submit_foreground.l | round(2) }}%;
        --content-ui-submit-foreground-a: {{ colors.skin_colour_content_ui_submit_foreground.a | round(2) }}%;
        --content-ui-submit-foreground:   hsla(
            var(--content-ui-submit-foreground-h),
            var(--content-ui-submit-foreground-s),
            var(--content-ui-submit-foreground-l),
            var(--content-ui-submit-foreground-a)
        );
        {#
            Derived styles:
            www/css/foundation/components/_buttons.scss
            www/css/foundation/ui/selectize.customisation.scss
        #}
    {% endif %}

    {% if colors.skin_colour_content_ui_background is defined %}
        --content-ui-submit-background-h: {{ colors.skin_colour_content_ui_submit_background.h | round(2) }};
        --content-ui-submit-background-s: {{ colors.skin_colour_content_ui_submit_background.s | round(2) }}%;
        --content-ui-submit-background-l: {{ colors.skin_colour_content_ui_submit_background.l | round(2) }}%;
        --content-ui-submit-background-a: {{ colors.skin_colour_content_ui_submit_background.a | round(2) }}%;
        --content-ui-submit-background:   hsla(
            var(--content-ui-submit-background-h),
            var(--content-ui-submit-background-s),
            var(--content-ui-submit-background-l),
            var(--content-ui-submit-background-a)
        );
        {#
            Derived styles:
            www/css/foundation/components/_buttons.scss
            www/css/foundation/ui/selectize.customisation.scss
        #}
    {% endif %}


    {# Form colors #}
    {% if colors.skin_colour_form_input_border_color is defined %}
        --form-border-color-h: {{ colors.skin_colour_form_input_border_color.h | round(2) }};
        --form-border-color-s: {{ colors.skin_colour_form_input_border_color.s | round(2) }}%;
        --form-border-color-l: {{ colors.skin_colour_form_input_border_color.l | round(2) }}%;
        --form-border-color-a: {{ colors.skin_colour_form_input_border_color.a | round(2) }}%;
        --form-border-color:   hsla(
            var(--form-border-color-h),
            var(--form-border-color-s),
            var(--form-border-color-l),
            var(--form-border-color-a)
        );
        {#
            Derived styles:
            www/css/foundation/ui/forms/_forms.scss
            www/css/foundation/components/submissions/rubric.scss
        #}
    {% endif %}

    {% if colors.skin_colour_form_background_hover_color is defined %}
        --form-bg-hover-color-h: {{ colors.skin_colour_form_background_hover_color.h | round(2) }};
        --form-bg-hover-color-s: {{ colors.skin_colour_form_background_hover_color.s | round(2) }}%;
        --form-bg-hover-color-l: {{ colors.skin_colour_form_background_hover_color.l | round(2) }}%;
        --form-bg-hover-color-a: {{ colors.skin_colour_form_background_hover_color.a | round(2) }}%;
        --form-bg-hover-color:   hsla(
            var(--form-bg-hover-color-h),
            var(--form-bg-hover-color-s),
            var(--form-bg-hover-color-l),
            var(--form-bg-hover-color-a)
        );
        {#
            Derived styles:
            www/css/foundation/ui/forms/_forms.scss
            www/css/foundation/components/submissions/rubric.scss
        #}
    {% endif %}


    {##
     # Accent colors
     #
     # Derived styles:
     # www/css/foundation/ui/_content.scss, including a select color mixin I don't know what to do with
     # www/css/foundation/components/alaress-datetime-picker/alaress-datetime-picker.scss
     #}
    {% if colors.skin_colour_accent_foreground is defined %}
        --accent-foreground-h: {{ colors.skin_colour_accent_foreground.h | round(2) }};
        --accent-foreground-s: {{ colors.skin_colour_accent_foreground.s | round(2) }}%;
        --accent-foreground-l: {{ colors.skin_colour_accent_foreground.l | round(2) }}%;
        --accent-foreground-a: {{ colors.skin_colour_accent_foreground.a | round(2) }}%;
        --accent-foreground:   hsla(
            var(--accent-foreground-h),
            var(--accent-foreground-s),
            var(--accent-foreground-l),
            var(--accent-foreground-a)
        );
    {% endif %}

    {% if colors.skin_colour_accent_background is defined %}
        --accent-background-h: {{ colors.skin_colour_accent_background.h | round(2) }};
        --accent-background-s: {{ colors.skin_colour_accent_background.s | round(2) }}%;
        --accent-background-l: {{ colors.skin_colour_accent_background.l | round(2) }}%;
        --accent-background-a: {{ colors.skin_colour_accent_background.a | round(2) }}%;
        --accent-background:   hsla(
            var(--accent-background-h),
            var(--accent-background-s),
            var(--accent-background-l),
            var(--accent-background-a)
        );
    {% endif %}

    {% if colors.skin_colour_accent_hover is defined %}
        --accent-hover-h: {{ colors.skin_colour_accent_hover.h | round(2) }};
        --accent-hover-s: {{ colors.skin_colour_accent_hover.s | round(2) }}%;
        --accent-hover-l: {{ colors.skin_colour_accent_hover.l | round(2) }}%;
        --accent-hover-a: {{ colors.skin_colour_accent_hover.a | round(2) }}%;
        --accent-hover:   hsla(
            var(--accent-hover-h),
            var(--accent-hover-s),
            var(--accent-hover-l),
            var(--accent-hover-a)
        );
    {% endif %}


    {##
     # Logo background
     #
     # Derived styles:
     # None known
     #}
    {% if colors.skin_colour_logo_background is defined %}
        --logo-background-h: {{ colors.skin_colour_logo_background.h | round(2) }};
        --logo-background-s: {{ colors.skin_colour_logo_background.s | round(2) }}%;
        --logo-background-l: {{ colors.skin_colour_logo_background.l | round(2) }}%;
        --logo-background-a: {{ colors.skin_colour_logo_background.a | round(2) }}%;
        --logo-background:   hsla(
            var(--logo-background-h),
            var(--logo-background-s),
            var(--logo-background-l),
            var(--logo-background-a)
        );
    {% endif %}


    {##
     # Body background
     #
     # Derived styles:
     # the contrast-bg rubric
     #}
    {% if colors.skin_colour_body_bg is defined %}
        --body-background-h: {{ colors.skin_colour_body_bg.h | round(2) }};
        --body-background-s: {{ colors.skin_colour_body_bg.s | round(2) }}%;
        --body-background-l: {{ colors.skin_colour_body_bg.l | round(2) }}%;
        --body-background-a: {{ colors.skin_colour_body_bg.a | round(2) }}%;
        --body-background:   hsla(
            var(--body-background-h),
            var(--body-background-s),
            var(--body-background-l),
            var(--body-background-a)
        );
    {% endif %}

{#--accounts-menu-bg-colour:      {{ config.accounts_menu_bg_colour }};#}
{#--accounts-menu-text-colour:    {{ config.accounts_menu_text_colour }};#}
{#--accounts-menu-hover-colour:   {{ config.accounts_menu_hover_colour }};#}
