<style type='text/css'>
    .success {
        background-color: #eaffea
    }

    .failure {
        background-color: #ffecec
    }

    code {
        white-space: pre;
    }

    table {
        width: 100%;
        margin-top: 50px;
        border-collapse: collapse;
    }

    td {
        vertical-align: top;
        border:1px solid #000;
        padding: 16px;
    }

    td.api-call {
        width: 200px
    }

    td.api-call span {
        font-size: 12px;
        display: block;
        clear: both;
    }

    td.missing-properties {
        width: 400px;
    }
</style>

<h1>External Connector Test</h1>
<h2>{{ data.fail }} failed, out of {{ data.total }} things tested.</h2>

<table>
    <thead>
        <tr>
            <th>Api Call</th>
            <th>Missing Properties</th>
            <th>Api Output</th>
        </tr>
    </thead>
    <tbody>
        {% for currentResult in data.allResults %}
        {% if currentResult.state %}
        <tr class="success">
        {% else %}
        <tr class="failure">
        {% endif %}
            <td class="api-call">
                {{ currentResult.label }}
                <span>{{ currentResult.method }}</span>
            </td>
            <td class="missing-properties">
                {% if currentResult.missingProperties|length %}
                <ul>
                    {% for currentMissingProperty in currentResult.missingProperties %}
                    <li>{{ currentMissingProperty }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
            </td>
            <td>
                <code>{{ currentResult.output }}</code>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>