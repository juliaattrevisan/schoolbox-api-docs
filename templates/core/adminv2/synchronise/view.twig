<style type="text/css">
    .synchronise-container tr.colspans th {
        border: 1px solid #ddd;
    }

    .synchronise-container {
        overflow: scroll;
    }

    .synchronise-container table.data{
        min-width: 2500px;
    }

    .synchronise-match-container {
        width: 100%;
        clear: both;
    }

    .synchronise-match-container .left-column {
        width: 47%;
        float: left;
    }

    .synchronise-match-container .right-column {
        width: 47%;
        float: left;
    }

    .synchronise-match-container .icon {
        width: 33px;
        height: 33px;
        background-image: url('/images/core/admin/icons.png');
        background-repeat: no-repeat;
        margin: 40px 10px;
        float: left;
    }

    .synchronise-match-container .icon.plus {
        background-position: 0px -132px;
    }

    .synchronise-match-container .icon.equals {
        background-position: 0px -99px;
    }
</style>

<h2>Synchronise</h2>

<div class="settings-nav-holder">
    {% include 'adminv2/synchronise/nav.twig' %}
</div>
<div class="settings">
    {% block body %}
    {% endblock %}
</div>