{% extends 'adminv2/synchronise/view.twig' %}

{% block body %}
<div class="row">
    <div class="small-12 large-12 columns scrollable">
        <table>
            <thead>
                <tr>
                    <th colspan="6">Personal</th>
                    <th colspan="2">Account</th>
                    <th colspan="6">Contact</th>
                    <th colspan="2">Meta</th>
                </tr>
                <tr>
                    <th>External ID</th>
                    <th>Title</th>
                    <th>Preferred</th>
                    <th>Given</th>
                    <th>Lastname</th>
                    <th>Gender</th>
                    <th>Login</th>
                    <th>Active</th>
                    <th>Postal Address</th>
                    <th>Home Address</th>
                    <th>Email</th>
                    <th>Phone (Home)</th>
                    <th>Phone (Work)</th>
                    <th>Phone (Mobile)</th>
                    <th>Campus</th>
                    <th>Year Level</th>
                </tr>
            </thead>
            <tbody>
                {% for i in data.allPeople|slice(0, 13) %}
                <tr>
                    <td>{{ i.getId() }}</td>
                    <td>{{ i.getTitle() }}</td>
                    <td>{{ i.getPreferredName() }}</td>
                    <td>{{ i.getGivenName() }}</td>
                    <td>{{ i.getLastname() }}</td>
                    <td>{{ i.getGender() }}</td>
                    <td>{{ i.getAccount().getLogin() }}</td>
                    <td>{{ i.getAccount().getActive() }}</td>
                    <td>{{ i.getPostalAddress().getAsString() }}</td>
                    <td>{{ i.getHomeAddress().getAsString() }}</td>
                    <td>{{ i.getAllEmails("\n") }}</td>
                    <td>{{ i.getPhoneHome().getNumber() }}</td>
                    <td>{{ i.getPhoneWork().getNumber() }}</td>
                    <td>{{ i.getPhoneMobile().getNumber() }}</td>
                    <td>{{ i.getCampusAsString(", ") }}</td>
                    <td>{{ i.getYearAsString(", ") }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="row">
    <div class="small-12 large-12 columns">
        <h2 class="subheader">Campus Mapping</h2>
    </div>
    <div class="small-12 large-5 island">
        <section class="content">
            {% include 'adminv2/synchronise/sub/campus/external.twig' %}
        </section>
    </div>
    <div class="small-12 large-2 columns text-center">
        =
    </div>
    <div class="small-12 large-5 island">
        <section class="content">
            {% include 'adminv2/synchronise/sub/campus/schoolbox.twig' %}
        </section>
    </div>
</div>

<div class="row">
    <div class="small-12 large-12 columns">
        <h2 class="subheader">Role Mapping</h2>
    </div>
    <div class="small-12 large-5 island">
        <section class="content">
            {% include 'adminv2/synchronise/sub/role/parent/external.twig' %}
        </section>
    </div>
    <div class="small-12 large-2 columns text-center">
        =
    </div>
    <div class="small-12 large-5 island">
        <section class="content">
            {% include 'adminv2/synchronise/sub/role/schoolbox.twig' %}
        </section>
    </div>
</div>
{% endblock %}