{% extends 'adminv2/synchronise/view.twig' %}

{% block title %}
    <h2>Staff</h2>
{% endblock %}

{% block body %}
    <table class="table ruler">
        <thead>
            <tr>
                <th>External ID</th>
                <th>Title</th>
                <th>Preferred</th>
                <th>Given</th>
                <th>Lastname</th>
                <th>Gender</th>
                <th>Login</th>
                <th>Active</th>
                <th>Postal Address</th>
                <th>Home Address</th>
                <th>Email</th>
                <th>Phone (Home)</th>
                <th>Phone (Work)</th>
                <th>Phone (Mobile)</th>
                <th>Campus</th>
            </tr>
        </thead>
        <tbody>
            {% for i in data.allPeople|slice(0,20) %}
            <tr>
                <td>{{ i.getId() }}</td>
                <td>{{ i.getTitle() }}</td>
                <td>{{ i.getPreferredName() }}</td>
                <td>{{ i.getGivenName() }}</td>
                <td>{{ i.getLastname() }}</td>
                <td>{{ i.getGender() }}</td>
                <td>{{ i.getAccount().getLogin() }}</td>
                <td>{{ i.getAccount().getActive() }}</td>
                <td>{{ i.getPostalAddress().getAsString() }}</td>
                <td>{{ i.getHomeAddress().getAsString() }}</td>
                <td>{{ i.getAllEmails("\n") }}</td>
                <td>{{ i.getPhoneHome().getNumber() }}</td>
                <td>{{ i.getPhoneWork().getNumber() }}</td>
                <td>{{ i.getPhoneMobile().getNumber() }}</td>
                <td>{{ i.getAllCampuses("\n") }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}