{% extends 'adminv2/synchronise/view.twig' %}

{% block body %}
<table>
    <thead>
        <tr>
            <th colspan="6">Personal</th>
            <th colspan="2">Account</th>
            <th colspan="6">Contact</th>
            <th colspan="10">Metadata</th>
        </tr>
        <tr>
            <th>External ID</th>
            <th>Title</th>
            <th>Preferred</th>
            <th>Given</th>
            <th>Lastname</th>
            <th>Gender</th>
            <th>Login</th>
            <th>Active</th>
            <th>Postal Address</th>
            <th>Home Address</th>
            <th>Email</th>
            <th>Phone (Home)</th>
            <th>Phone (Work)</th>
            <th>Phone (Mobile)</th>
            <th>Campus</th>
            <th>Staff Type</th>
            <th>Department</th>
            <th>Room</th>
            <th>Building</th>
            <th>Voicemail</th>
            <th>Extension</th>
            <th>Position Description</th>
            <th>Position Start</th>
            <th>Position End</th>
        </tr>
    </thead>
    <tbody>
        {% for i in data.allPeople|slice(0, 13) %}
        <tr>
            <td>{{ i.getId() }}</td>
            <td>{{ i.getTitle() }}</td>
            <td>{{ i.getPreferredName() }}</td>
            <td>{{ i.getGivenName() }}</td>
            <td>{{ i.getLastname() }}</td>
            <td>{{ i.getGender() }}</td>
            <td>{{ i.getAccount().getLogin() }}</td>
            <td>{{ i.getAccount().getActive() }}</td>
            <td>{{ i.getPostalAddress().getAsString() }}</td>
            <td>{{ i.getHomeAddress().getAsString() }}</td>
            <td>{{ i.getAllEmails("\n") }}</td>
            <td>{{ i.getPhoneHome().getNumber() }}</td>
            <td>{{ i.getPhoneWork().getNumber() }}</td>
            <td>{{ i.getPhoneMobile().getNumber() }}</td>
            <td>{{ i.getAllCampuses("\n") }}</td>
            <td>{{ i.getMeta().getCategory().getType() }}</td>
            <td>{{ i.getMeta().getDepartment() }}</td>
            <td>{{ i.getMeta().getRoom() }}</td>
            <td>{{ i.getMeta().getBuilding() }}</td>
            <td>{{ i.getMeta().getVoicemail() }}</td>
            <td>{{ i.getMeta().getExtension() }}</td>
            <td>{{ i.getMeta().getPosition().getDescription() }}</td>
            <td>{{ i.getMeta().getPosition().getStartDate().getDateOnly() }}</td>
            <td>{{ i.getMeta().getPosition().getEndDate().getDateOnly() }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<div class="row">
    <div class="large-12 columns">
        <h3>Campus Mapping</h3>
    </div>
    <div class="large-6 columns">
        {% include 'adminv2/synchronise/sub/campus/external.twig' %}
    </div>
    <div class="large-6 columns">
        {% include 'adminv2/synchronise/sub/campus/schoolbox.twig' %}
    </div>
</div>

<div class="row">
    <div class="large-12 columns">
        <h3>Role Mapping</h3>
    </div>
    <div class="large-6 columns">
        {% include 'adminv2/synchronise/sub/role/staff/external.twig' %}
    </div>
    <div class="large-6 columns">
        {% include 'adminv2/synchronise/sub/role/schoolbox.twig' %}
    </div>
</div>

<div class="row">
    <div class="large-12 columns">
        <h3>Default User Options</h3>
    </div>
    <div class="large-3 columns">
        {% include 'adminv2/synchronise/sub/eportfolio.twig' %}
    </div>
    <div class="large-3 columns">
        {% include 'adminv2/synchronise/sub/webmail.twig' %}
    </div>
    <div class="large-3 columns">
        {% include 'adminv2/synchronise/sub/localEmail.twig' %}
    </div>
    <div class="large-3 columns">
        {% include 'adminv2/synchronise/sub/externalMail.twig' %}
    </div>
</div>
{% endblock %}