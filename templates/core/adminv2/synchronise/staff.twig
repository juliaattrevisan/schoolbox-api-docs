{% extends 'adminv2/synchronise/view.twig' %}

{% block body %}
    <div class="synchronise-container">
        <table class="table ruler data">
            <thead>
                <tr class="colspans">
                    <th colspan="6">Personal</th>
                    <th colspan="2">Account</th>
                    <th colspan="6">Contact</th>
                    <th colspan="10">Metadata</th>
                </tr>
                <tr>
                    <th>External ID</th>
                    <th>Title</th>
                    <th>Preferred</th>
                    <th>Given</th>
                    <th>Lastname</th>
                    <th>Gender</th>
                    <th>Login</th>
                    <th>Active</th>
                    <th>Postal Address</th>
                    <th>Home Address</th>
                    <th>Email</th>
                    <th>Phone (Home)</th>
                    <th>Phone (Work)</th>
                    <th>Phone (Mobile)</th>
                    <th>Campus</th>
                    <th>Staff Type</th>
                    <th>Department</th>
                    <th>Room</th>
                    <th>Building</th>
                    <th>Voicemail</th>
                    <th>Extension</th>
                    <th>Position Description</th>
                    <th>Position Start</th>
                    <th>Position End</th>
                </tr>
            </thead>
            <tbody>
                {% for i in data.allPeople|slice(0, 13) %}
                <tr>
                    <td>{{ i.getId() }}</td>
                    <td>{{ i.getTitle() }}</td>
                    <td>{{ i.getPreferredName() }}</td>
                    <td>{{ i.getGivenName() }}</td>
                    <td>{{ i.getLastname() }}</td>
                    <td>{{ i.getGender() }}</td>
                    <td>{{ i.getAccount().getLogin() }}</td>
                    <td>{{ i.getAccount().getActive() }}</td>
                    <td>{{ i.getPostalAddress().getAsString() }}</td>
                    <td>{{ i.getHomeAddress().getAsString() }}</td>
                    <td>{{ i.getAllEmails("\n") }}</td>
                    <td>{{ i.getPhoneHome().getNumber() }}</td>
                    <td>{{ i.getPhoneWork().getNumber() }}</td>
                    <td>{{ i.getPhoneMobile().getNumber() }}</td>
                    <td>{{ i.getAllCampuses("\n") }}</td>
                    <td>{{ i.getMeta().getType() }}</td>
                    <td>{{ i.getMeta().getDepartment() }}</td>
                    <td>{{ i.getMeta().getRoom() }}</td>
                    <td>{{ i.getMeta().getBuilding() }}</td>
                    <td>{{ i.getMeta().getVoicemail() }}</td>
                    <td>{{ i.getMeta().getExtension() }}</td>
                    <td>{{ i.getMeta().getPosition().getDescription() }}</td>
                    <td>{{ i.getMeta().getPosition().getStartDate().getDateOnly() }}</td>
                    <td>{{ i.getMeta().getPosition().getEndDate().getDateOnly() }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="synchronise-match-container">
        <div class="left-column">
            {% include 'adminv2/synchronise/sub/campus/external.twig' %}
        </div>
        <div class="right-column">
            {% include 'adminv2/synchronise/sub/campus/schoolbox.twig' %}
        </div>
    </div>
{% endblock %}