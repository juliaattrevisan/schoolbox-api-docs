<h4>External Year</h4>
<table>
    <colgroup>
        <col width="75">
        <col />
    </colgroup>
    <thead>
        <tr>
            <th>Level</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
    {% for i in data.year.external %}
        <tr>
            <td>{{ i.getLevel() }}</td>
            <td>{{ i.getDescription() }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>