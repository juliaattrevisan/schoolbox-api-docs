<h3>Schoolbox Year</h3>
<table class="table ruler">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Type</th>
        </tr>
    </thead>
    <tbody>
        {% for i in data.year.schoolbox %}
        <tr>
            <td>{{ i.getId() }}</td>
            <td>{{ i.getName() }}</td>
            <td>{{ i.getType() }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>