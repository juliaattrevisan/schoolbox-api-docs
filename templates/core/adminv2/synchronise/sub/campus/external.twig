<h3>External Campus</h3>
<table class="table ruler">
    <thead>
    <tr>
        <th>ID</th>
        <th>Name</th>
    </tr>
    </thead>
    <tbody>
    {% for i in data.campus.external %}
        <tr>
            <td>{{ i.getId() }}</td>
            <td>{{ i.getName() }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>