<h4>Schoolbox Campus</h4>
<table>
    <colgroup>
        <col width="75">
        <col />
    </colgroup>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
    {% for i in data.campus.schoolbox %}
        <tr>
            <td>{{ i.getId() }}</td>
            <td>{{ i.getName() }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>