<h3>Year</h3>
<table class="table ruler">
    <thead>
    <tr>
        <th>Level</th>
        <th>Description</th>
    </tr>
    </thead>
    <tbody>
    {% for i in data.year.external %}
        <tr>
            <td>{{ i.getLevel() }}</td>
            <td>{{ i.getDescription() }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>