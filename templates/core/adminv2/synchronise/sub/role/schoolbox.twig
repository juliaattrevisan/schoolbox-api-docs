<h3>Schoolbox Role</h3>
<table>
    <colgroup>
        <col width="75">
        <col />
        <col />
    </colgroup>
    <thead>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Type</th>
    </tr>
    </thead>
    <tbody>
    {% for i in data.role.schoolbox %}
        <tr>
            <td>{{ i.getId() }}</td>
            <td>{{ i.getName() }}</td>
            <td>{{ i.getType() }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>