<h3>External Role</h3>
<table>
    <colgroup>
        <col width="75">
        <col />
    </colgroup>
    <thead>
    <tr>
        <th>ID</th>
        <th>Name</th>
    </tr>
    </thead>
    <tbody>
    {% for i in data.role.external %}
        <tr>
            <td>{{ i.getId() }}</td>
            <td>{{ i.getType() }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>