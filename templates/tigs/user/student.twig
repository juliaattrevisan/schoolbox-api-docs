{% extends '@core/user/student.twig' %}

{% block buttons %}
    {{ parent() }}
    {% set routeParticipationReport = routeLookupIfAuthorized('tigsParticipationReport.getReport', { userId: user.id, user: user }) %}
    {% if routeParticipationReport %}
        <li>
            <a href="{{ routeParticipationReport }}" class="icon-report">Awards & Attendance</a>
        </li>
    {% endif %}
{% endblock buttons %}
{% set routeSubjectReport = routeLookupIfAuthorized('tigsSubjectReport.getReport', { userId: user.id, user: user, folderId: subject.folder.id, folder: subject.folder }) %}

{% block folderListItemClasses -%}
    {%- if routeSubjectReport %}actions-small-1{% endif -%}
{%- endblock %}

{% block folderListItemActions %}
    {% if routeSubjectReport or hasTeachersWithEmail  %}
    <nav>
        <sbx-pop-out content-id="class-options-{{ groupIdentifier }}-{{ subjectIdentifier }}"></sbx-pop-out>
    </nav>
    <ul id="class-options-{{ groupIdentifier }}-{{ subjectIdentifier }}" class="f-dropdown" data-dropdown-content>
        {% if routeSubjectReport %}
            <li><a class="icon-report" href="{{ routeSubjectReport }}" title="Subject Report">Subject Report</a></li>
        {% endif %}
        {% if hasTeachersWithEmail %}
        {% for teacher in subject.teachers %}
            {% if not teacher.email is empty %}
                <li>
                    {% set replyTo = teacher.getFormattedEmailDisplay %}
                    <a class="icon-email" href="{{ session.mailhandle }}{{ replyTo }}" title="Email {{ replyTo }}">Email {{ teacher.formatName }}</a>
                </li>
            {% endif %}
        {% endfor %}
        {% endif %}
    </ul>
    {% endif %}
{% endblock %}
