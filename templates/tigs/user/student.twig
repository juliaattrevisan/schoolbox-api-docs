{% extends '@core/user/student.twig' %}

{% block buttons %}
    {{ parent() }}
    <li>
        <a href="/synergetic/absences?id={{user.getExternalId()}}" class="icon-user">Absences</a>
    </li>
    <li>
        <a href="/synergetic/mydetails?id={{user.getExternalId()}}" class="icon-info">My Details</a>
    </li>
    <li>
        <a href="/synergetic/fin?id={{user.getExternalId()}}" class="icon-itineraryitem">Finance</a>
    </li>
    <li>
        <a href="/homepage/2814" class="icon-forms">Permission Notes</a>
    </li>
    {% set routeParticipationReport = routeLookupIfAuthorized('tigsSummativeReport.getParticipationReport', { userId: user.id, user: user }) %}
    {% if routeParticipationReport %}
        <li>
            <a href="{{ routeParticipationReport }}" class="icon-report">Participation Report</a>
        </li>
    {% endif %}
{% endblock buttons %}

{% block folderListItemClasses -%}
    {%- set routeSubjectReport = routeLookupIfAuthorized('tigsSummativeReport.getSubjectReport', { userId: user.id, user: user, folderId: subject.folder.id, folder: subject.folder }) -%}
    {%- if routeSubjectReport %}actions-small-1{% endif -%}
{%- endblock %}

{% block folderListItemActions %}
    {% set routeSubjectReport = routeLookupIfAuthorized('tigsSummativeReport.getSubjectReport', { userId: user.id, user: user, folderId: subject.folder.id, folder: subject.folder }) %}
    {% if routeSubjectReport %}
        <nav>
            <a class="icon-report" href="{{ routeSubjectReport }}" title="{{ subject.name }} Subject Report"></a>
        </nav>
    {% endif %}
{% endblock %}
