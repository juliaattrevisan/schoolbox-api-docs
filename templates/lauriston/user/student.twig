{% extends '@core/user/student.twig' %}

{% block details_studiesCode %}
    {% if externalUser.StudentStudiesCode %}
    <dt class="small-12 medium-3">Studies Code:</dt>
    <dd class="small-12 medium-9">{{ externalUser.StudentStudiesCode }}</dd>
    {% endif %}
{% endblock details_studiesCode %}

{% block buttons_island %}
    {{ parent() }}
    {% if isStaff %}
        <ul class="flex-list flex-wrap buttons">
            <li>
                <a href="https://reports.lauriston.vic.edu.au/ReportServer/Pages/ReportViewer.aspx?/Schoolbox/Students/Assessment%20Data&rs:Command=Render&rc:Stylesheet=notoolbar&rc:Zoom=Page%20Width&ID={{ user.externalId }}"
                   class="icon-due-work" rel="external">Assessment Data</a>
            </li>
            <li>
                <a href="https://reports.lauriston.vic.edu.au/ReportServer/Pages/ReportViewer.aspx?/Schoolbox/Students/Reporting%20Grades&rs:Command=Render&rc:Stylesheet=notoolbar&rc:Zoom=Page%20Width&ID={{ user.externalId }}"
                   class="icon-progress" rel="external">Reporting Grades</a>
            </li>
            <li>
                <a href="https://reports.lauriston.vic.edu.au/ReportServer/Pages/ReportViewer.aspx?/Schoolbox/Students/Learning%20Support&rs:Command=Render&rc:Stylesheet=notoolbar&rc:Zoom=Page%20Width&ID={{ user.externalId }}"
                   class="icon-staff" rel="external">Learning Support</a>
            </li>
            <li>
                <a href="https://reports.lauriston.vic.edu.au/ReportServer/Pages/ReportViewer.aspx?/Schoolbox/Students/Student%20Notes&rs:Command=Render&rc:Stylesheet=notoolbar&rc:Zoom=Page%20Width&ID={{ user.externalId }}"
                   class="icon-forms" rel="external">Student Notes</a>
            </li>
        </ul>
    {% endif %}
{% endblock buttons_island %}