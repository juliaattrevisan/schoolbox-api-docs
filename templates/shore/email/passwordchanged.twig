{% extends 'schoolmail.twig' %}
{% block content %}
    {# dig into the context #}
    {% set ns = groups|first %}
    {% set row = ns.rows|first %}
    {% set msg = row.messages|first %}

    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
    <tr>{{ fn.spacer(config.fqdn, 16, 0) }}</tr>
    <tr>
        <td width="640">
            <p>Dear Shore Parent,</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    <tr>
        <td width="640">
            <p>On {{ date }} at {{ time }} your Lampada password was successfully changed.</p>
	    <p>If you didn’t initiate this password change please contact the School immediately.</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 16, 0, 2) }}</tr>
</table>
{% endblock %}
