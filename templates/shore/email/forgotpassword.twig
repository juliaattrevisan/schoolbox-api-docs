{% extends 'schoolmail.twig' %}
{% block content %}
    {# dig into the context #}
    {% set ns = groups|first %}
    {% set row = ns.rows|first %}
    {% set msg = row.messages|first %}

    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
    <tr>{{ fn.spacer(config.fqdn, 16, 0) }}</tr>
    <tr>
        <td width="640">
            <p>Dear Shore Parent, this email has been automatically generated in response to the Retrieve Password feature being used within Shore Parent Services.</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    {% if forgotten_password == '0' %}
    <tr>
        <td width="640">
            <p>Your Username is: {{ username }}</p>
        </td>
    </tr>
    {% endif %}
    <tr>
        <td width="640">
            <p>Your Password is: {{ password }}</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    <tr>
        <td width="640">
            <p>Please take care to enter the password exactly as it appears above as it is case sensitive.</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    <tr>
        <td width="640">
            <p>If you are still having difficulties logging in please send an email to bursar@shore.nsw.edu.au and include a description of the problem.  We will endeavour to respond within 1 working day.</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 8, 0) }}</tr>
    <tr>
        <td width="640">
            <p>Kind Regards</p>
	    <p>Shore School</p>
        </td>
    </tr>
    <tr>{{ fn.spacer(config.fqdn, 16, 0, 2) }}</tr>
</table>
{% endblock %}
