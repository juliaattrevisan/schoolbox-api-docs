{% extends '@core/user/staff.twig' %}

{# Hide email address unless you're Staff
 # or a Parent with the config option on
 #}
{% block details_email %}
    {% set isParent = session.user.getRole().isParent() %}
    {% set canViewStaffDetails = isStaff or (isParent and config.report_staff_access) %}

    {% if canViewStaffDetails %}
        {% if user.getEmail() %}
            <dt class="no-margin small-6 medium-3">Email</dt>
            <dd class="no-margin small-6 medium-9">
                <a href="{{ session.mailhandle }}{{ user.getEmail() }}">{{ user.getEmail() }}</a>
            </dd>
        {% endif %}
    {% endif %}
{% endblock %}

{# Rearrange contents
 #}
{% block details %}
    {% set isParent = session.user.getRole().isParent() %}
    {% set canViewStaffDetails = isStaff or (isParent and config.report_staff_access) %}

    {% if canViewStaffDetails %}
        {% if externalUser.StaffDefaultMobilePhone %}
            <dt class="no-margin small-6 medium-3">Mobile Phone</dt>
            <dd class="no-margin small-6 medium-9">{{ externalUser.StaffDefaultMobilePhone }}</dd>
        {% endif %}
        {% if externalUser.StaffDepartment %}
            <dt class="no-margin small-6 medium-3">Department</dt>
            <dd class="no-margin small-6 medium-9">{{ externalUser.StaffDepartment }}</dd>
        {% endif %}
        {% if externalUser.StaffExtension %}
            <dt class="no-margin small-6 medium-3">Telephone Extension</dt>
            <dd class="no-margin small-6 medium-9">{{ externalUser.StaffExtension }}</dd>
        {% endif %}
        {% if externalUser.StaffCampusDescription %}
            <dt class="no-margin small-6 medium-3">Campus</dt>
            <dd class="no-margin small-6 medium-9">{{ externalUser.StaffCampusDescription }}</dd>
        {% endif %}
    {% endif %}
{% endblock %}