{##
 # Student Profile
 #
 # showEmails   bool    Spec pattern to decide whether email address is visible
 # showDetails  bool    Spec patternt to decide whether details are visible
 #}

{# Permissions #}
{% set isSuperuser = session.user.superUser %}
{% set isStaff = isSuperuser or session.user.role.staff %}
{% set isSelf = session.user.id == user.id %}

{# medical: if allowed in config, and user is staff or parent of this child #}
{% set showMedicalAlert = not config.protect_medicalspecial_profile and isStaff %}
{% set showSpecialAlert = not config.protect_medicalspecial_profile and isStaff %}
{% set showComments = config.synergetic_student_comment and isStaff %}

{% set showButtons = showDetails %}
{# contacts: su, staff or parent #}
{# Should a student see their own contact details? I think so #}
{% set showContacts = (isStaff or isParentOfStudent) and not hideContacts %}
{% set showContactsAlert = config.synergetic_community_alerts and showContacts and isStaff %}
{% set showSubjects = showDetails %}
{% set showGroups = showDetails %}
{% set showClasses = showClasses and showDetails %}
{% set showTitle = user.hasPositionTitle() %}

<script type="text/javascript">
    $(function () {
        $('#email-all-staff').click(function () {
            $('#email-all-form').submit();
        })
    });

    // Enable Expandables
    $(function () {
        $('[data-collapser]').collapsable();
    });
</script>

<div class="actions-small-{{ isSuperuser ? 1 : 0 }} row">
    <div class="list-item">
        <div class="small-12 column">
            <h1>{{ user.formatName }}</h1>
        </div>
    </div>
    <nav>
        {% if routeLookupIfAuthorized('adminUser.getModify') %}
            <a href="{{ routeLookup('adminUser.getModify', {'userId': user.id}) }}" class="icon-modify" title="Modify User"></a>
        {% endif %}
    </nav>
</div>

<div class="row">
    <div class="small-12 island">
        <section class="no-pad">
            <div class="profile content">
                <div class="row no-margin">
                    <div class="small-12 medium-2 columns no-pad">
                        <img class="full-width" src="/portrait.php?id={{ user.id }}&amp;size=constrain200"/>
                    </div>

                    <div class="small-12 medium-10 columns no-pad">
                        {% block specialAlert %}
                            {% if externalUser.StudentSpecialNeedsFlag and showSpecialAlert %}
                                <div class="alert-box highlight icon-bell">
                                    {{ locale.translate('specialNeeds', false, true) }}
                                </div>
                            {% endif %}
                        {% endblock specialAlert %}

                        {% block englishSecond %}
                            {% if externalUser.EnglishSecondFlag and showSpecialAlert  %}
                                <div class="alert-box highlight icon-eng-second-lang">
                                    English as an Additional Language
                                </div>
                            {% endif %}
                        {% endblock englishSecond %}

                        {% block medicalAlert %}
                            {% if externalUser.StudentMedicalAlert and showMedicalAlert %}
                                <div class="alert-box alert icon-alert">
                                    Medical Note: {{ externalUser.StudentMedicalAlert }}
                                </div>
                            {% endif %}
                        {% endblock medicalAlert %}

                        {% block individualEducationPlan %}
                            {% if isStaff and externalUser.countIndividualEducationPlans > 0 %}
                                <div class="alert-box highlight icon-curriculum">
                                    Individual Education Plan
                                </div>
                            {% endif %}
                        {% endblock individualEducationPlan %}

                        {% block synergeticComments %}
                            {% if externalUser.Comment is not empty and showComments %}
                                <div class="alert-box highlight icon-info no-margin">
                                    {{ externalUser.Comment | nl2br }}
                                </div>
                            {% endif %}
                        {% endblock synergeticComments %}

                        {% block details %}
                            <dl>
                                {% if showTitle %}
                                    <dt class="small-4 medium-3 columns">Position Title:</dt>
                                    <dd class="small-8 medium-9 columns">
                                        {{ user.positionTitle }}
                                    </dd>
                                {% endif %}

                                {% if showEmail %}
                                    {% block details_email %}
                                        {% if user.email %}
                                            <dt class="small-4 medium-3 columns">Email:</dt>
                                            <dd class="small-8 medium-9 columns">
                                                <a href="{{ session.mailhandle }}{{ user.email }}">{{ user.email }}</a>
                                            </dd>
                                        {% endif %}
                                    {% endblock details_email %}
                                {% endif %}

                                {% if showDetails %}
                                    {% block details_studentId %}
                                        <dt class="small-4 medium-3 columns">Student ID:</dt>
                                        <dd class="small-8 medium-9 columns">{{ user.externalId }}</dd>
                                    {% endblock details_studentId %}

                                    {% block details_dob %}
                                        {% if  externalUser.StudentBirthDate is not empty  %}
                                            <dt class="small-4 medium-3 columns">Date of Birth:</dt>
                                            <dd class="small-8 medium-9 columns">{{ externalUser.StudentBirthDate|date(dateFormats.shortDateOnlyFormat) }}</dd>
                                        {% endif %}
                                    {% endblock details_dob %}

                                    {% block details_formTeacher %}
                                        {% if showClasses %}
                                            {% if formTeacher %}
                                                <dt class="small-4 medium-3 columns">Class Teacher:</dt>
                                                <dd class="small-8 medium-9 columns">
                                                    {% if formTeacher.id %}
                                                        <a href="{{ session.mailhandle }}{{ formTeacher.email }}">{{ formTeacher.formatName }}</a>
                                                    {% else %}
                                                        {{ formTeacher.formatName }}
                                                    {% endif %}
                                                </dd>
                                            {% endif %}
                                        {% endif %}
                                    {% endblock details_formTeacher %}

                                    {% block details_yearLevel %}
                                        {% if externalUser.StudentYearLevel %}
                                            <dt class="small-4 medium-3 columns">Year Level:</dt>
                                            <dd class="small-8 medium-9 columns">{{ externalUser.StudentYearLevel }}</dd>
                                        {% endif %}
                                    {% endblock details_yearLevel %}

                                    {% block details_tutorTeacher %}
{#                                        {% if showClasses %}#}
{#                                            {% if tutorTeacher %}#}
{#                                                <dt class="small-4 medium-3 columns">Tutor:</dt>#}
{#                                                <dd class="small-8 medium-9 columns">#}
{#                                                    {% if tutorTeacher.id %}#}
{#                                                        <a href="{{ session.mailhandle }}{{ tutorTeacher.email }}">{{ tutorTeacher.formatName }}</a>#}
{#                                                    {% else %}#}
{#                                                        {{ tutorTeacher.formatName }}#}
{#                                                    {% endif %}#}
{#                                                </dd>#}
{#                                            {% endif %}#}
{#                                        {% endif %}#}
                                    {% endblock details_tutorTeacher %}

                                    {% block details_coordTeacher %}
                                        {#{% if coordTeacher %}#}
                                        {#<dt class="no-margin small-6 medium-3">Year Coordinator:</dt>#}
                                        {#<dd class="no-margin small-6 medium-9">#}
                                        {#{% if coordTeacher.id %}#}
                                        {#<a href="{{ session.mailhandle }}{{ coordTeacher.email }}">{{ coordTeacher.formatName }}</a>#}
                                        {#{% else %}#}
                                        {#{{ coordTeacher.formatName }}#}
                                        {#{% endif %}#}
                                        {#</dd>#}
                                        {#{% endif %}#}
                                    {% endblock details_coordTeacher %}

                                    {% block details_house %}
                                        {% if externalUser.StudentHouseDescription %}
                                            <dt class="small-4 medium-3 columns">House:</dt>
                                            <dd class="small-8 medium-9 columns">{{ externalUser.StudentHouseDescription }}</dd>
                                        {% endif %}
                                    {% endblock details_house %}

                                    {% block details_tutorGroup %}
                                        {% if showClasses %}
                                            {% if externalUser.StudentTutorDescription %}
                                                <dt class="small-4 medium-3 columns">Tutor Group:</dt>
                                                <dd class="small-8 medium-9 columns">{{ externalUser.StudentTutorDescription }}</dd>
                                            {% endif %}
                                        {% endif %}
                                    {% endblock details_tutorGroup %}

                                    {% block details_hohTeacher %}
                                        {% if showClasses %}
                                            {% if hohTeacher %}
                                                <dt class="small-4 medium-3 columns">Head of House:</dt>
                                                <dd class="small-8 medium-9 columns">
                                                    {% if hohTeacher.id %}
                                                        <a href="{{ session.mailhandle }}{{ hohTeacher.email }}">{{ hohTeacher.formatName }}</a>
                                                    {% else %}
                                                        {{ hohTeacher.formatName }}
                                                    {% endif %}
                                                </dd>
                                            {% endif %}
                                        {% endif %}
                                    {% endblock details_hohTeacher %}

                                    {% block details_studentForm %}
                                        {% if showClasses %}
                                            {% if externalUser.StudentForm %}
                                                <dt class="small-4 medium-3 columns">Class:</dt>
                                                <dd class="small-8 medium-9 columns">{{ externalUser.StudentForm }}</dd>
                                            {% endif %}
                                        {% endif %}
                                    {% endblock details_studentForm %}

                                    {% block details_studentType %}
                                        {% if boarderType %}
                                            <dt class="small-4 medium-3 columns">Student Type:</dt>
                                            <dd class="small-8 medium-9 columns">{{ boarderType }}</dd>
                                        {% endif %}
                                    {% endblock details_studentType %}

                                    {% block details_studentDates %}
                                    {% endblock %}

                                    {% block details_studiesCode %}
                                        {#{% if externalUser.StudentStudiesCode %}#}
                                        {#<dt class="no-margin small-6 medium-3">Studies Code:</dt>#}
                                        {#<dd class="no-margin small-6 medium-9">{{ externalUser.StudentStudiesCode }}</dd>#}
                                        {#{% endif %}#}
                                    {% endblock details_studiesCode %}

                                    {% block details_gender %}
                                        {#<dt class="small-4 medium-3 columns">Gender:</dt>
                                        <dd class="small-8 medium-9 columns">{{ externalUser.StudentGender }}</dd>#}
                                    {% endblock details_gender %}

                                    {% block details_coach %}
                                    {% endblock details_coach %}
                                {% endif %}

                                {% block extraDetails %}
                                    {# Schools can insert extra details here #}
                                {% endblock extraDetails %}
                            </dl>
                        {% endblock details %}
                    </div>
                </div>
            </div>

            {% block buttons_island %}
                <ul class='flex-list flex-wrap buttons'>
                    {% block buttons %}
                        {% if eportfolioAuth %}
                            {% block buttons_eportfolio %}
                                <li>
                                    <a href="/eportfolio/{{ user.id }}/profile"
                                       class="icon-eportfolio">ePortfolio</a>
                                </li>
                            {% endblock buttons_eportfolio %}
                        {% endif %}

                        {% if showButtons %}
                            {% block buttons_dueWork %}
                                {% if (not session.user.role.parent) or (not config.restrict_parent_duework_access) %}
                                    <li>
                                        <a href="/learning/due/{{ user.id }}"
                                           class="icon-due-work">{{ locale.dueWork.proper }}</a>
                                    </li>
                                {% endif %}
                            {% endblock buttons_dueWork %}

                            {% block buttons_grades %}
                                {% if (not session.user.role.parent) or (not config.restrict_parent_grades) %}
                                    <li>
                                        <a href="/learning/grades/{{ user.id }}"
                                           class="icon-tick">{{ locale.grades.properPlural }}</a>
                                    </li>
                                {% endif %}
                            {% endblock buttons_grades %}



                            {% if showPastoral %}
                                {% if isStaff or isParentOfStudent %}
                                    <li>
                                        <a href="{{ routeLookup('pastoral.getStudent', {studentId: user.id}) }}"
                                           class="icon-pastoral">{{ locale.pastoralCare.proper }}</a>
                                    </li>
                                {% endif %}
                            {% endif %}

                            {% block buttons_calendar %}
                                <li>
                                    <a href='/calendar/{{ now.urlDate }}/{{ user.id }}'
                                       class="icon-calendar">{TPL_LOCAL_CALENDAR_PC}</a>
                                </li>
                            {% endblock buttons_calendar %}

                            {% if showClasses %}
                                {% block buttons_timetable %}
                                    <li>
                                        <a href="/timetable/{{ user.id }}"
                                           class="icon-timetable">Timetable</a>
                                    </li>
                                {% endblock buttons_timetable %}
                            {% endif %}

                            {% block buttons_boarderLeave %}
                                {% if config.boarder_leave_enabled and user.residentialHouse %}
                                    <li>
                                        <a href="/modules/leave/student/{{ user.id }}"
                                           class="icon-boarder-leave">Boarder Leave</a>
                                    </li>
                                {% endif %}
                            {% endblock buttons_boarderLeave %}

                            {% block buttons_pastoralCare %}
                                {% if isStaff and config.external_type == 'synergetic' and config.external_staff_portal %}
                                    <li>
                                        <a href="{{ config.external_staff_portal }}/stud.aspx?id={{ user.externalId }}"
                                           class="icon-synergetic"
                                           target="_blank">Synweb</a>
                                    </li>
                                {% endif %}
                            {% endblock buttons_pastoralCare %}

                            {% block buttons_documents %}
                                {% if config.external_document_report_enabled and config.external_document_button_enable %}
                                    {% set routeAcademicReports = routeLookupIfAuthorized('profileDocumentManagement.getIndex', {studentId: user.id}) %}
                                    {% if routeAcademicReports %}
                                        <li>
                                            <a href="{{ routeAcademicReports }}" class="icon-document">{{ locale.reports.properPlural }}</a>
                                        </li>
                                    {% endif %}
                                {% endif %}
                            {% endblock buttons_documents %}

                            {% block buttons_email_all_staff %}
                                {% if isStaff and config.email_all_staff %}
                                    {% set replyTo = session.user.getFormattedEmailDisplay %}
                                    <li>
                                        <a class="icon-email" id="email-all-staff" title="Includes all teachers, year coordinator, head of house, tutor and coach.">Email All Teachers</a>
                                        <form id="email-all-form" action="/mail/createMail.php" class="hide">
                                            <input name="cc" value="{{ allTeacherEmails }}" type="hidden">
                                            <input name="replyto" value="{{ replyTo }}" type="hidden">
                                        </form>
                                    </li>
                                {% endif %}
                            {% endblock  buttons_email_all_staff  %}

                            {% block buttons_miscellaneous %}
                            {% endblock buttons_miscellaneous %}

                            {% for button in customButtons %}
                                <li>
                                    <a href="{{ button.url }}" title="{{ button.title }}" class="icon-{{ button.icon }} {{ button.css }}" target="{{ button.target }}">{{ button.text }}</a>
                                </li>
                            {% endfor %}
                        {% endif %}
                    {% endblock buttons %}
                </ul>
            {% endblock buttons_island %}
        </section>
    </div>
</div>

{% block pd %}
{% endblock pd %}

{# TODO: Where to pus this?
 # https://stackoverflow.com/questions/23569705/zurb-foundation-prevent-empty-column-collapsing-to-zero-width
 # https://foundation.zurb.com/forum/posts/22995-empty-column
 #}
<style type="text/css">
    .columns, .column {
        min-height: 1px;
    }
</style>

<div class="row">
    <div class="small-12 {% if showClasses %}medium-6 medium-push-6{% else %}large-reset-order{% endif %} columns">
        {% if showContacts and contacts|length > 0 %}
            <div class="row">
                {% block contacts_island %}
                    <div class="small-12 island">
                        {% block contacts %}
                            <h2 class="subheader">Contact Information</h2>

                            {% for message in externalUser.AlertMessages %}
                                {% block contacts_alert %}
                                    {# Only staff may view contact alerts #}
                                    {% if showContactsAlert %}
                                        <div class="alert-box alert icon-alert">
                                            {{ message }}
                                        </div>
                                    {% endif %}
                                {% endblock contacts_alert %}
                            {% endfor %}

                            <section>
                                <ul class="information-list expandable-card">
                                    {% for contact in contacts %}
                                        {% if contact.StudentContactTitle or contact.StudentContactPreferred %}
                                            <li class="small-12">

                                                <!-- Expander -->
                                                <div class="list-item">
                                                    <div class="expander" data-collapser="collap-contact-{{ loop.index }}"></div>
                                                    <div class="compact card small-12">
                                                        {% if contact.main %}
                                                            <a href="/search/user/{{ contact.main.id }}">
                                                                <img src="/portrait.php?userId={{ contact.StudentContactID }}&amp;size=square64" />
                                                                <p>
                                                                    {{ contact.StudentContactTitle }} {{ contact.StudentContactPreferred }} {{ contact.StudentContactSurname }}
                                                                    <span class="pipe meta">{{ contact.StudentContactRelation }}</span>
                                                                </p>
                                                            </a>
                                                        {% else %}
                                                            <img src="/portrait.php?userId={{ contact.StudentContactID }}&amp;size=square64" />
                                                            <p>
                                                                {{ contact.StudentContactTitle }} {{ contact.StudentContactPreferred }} {{ contact.StudentContactSurname }}
                                                                <span class="pipe meta">{{ contact.StudentContactRelation }}</span>
                                                            </p>
                                                        {% endif %}
                                                    </div>
                                                </div>

                                                <!-- Collapsable content -->
                                                {% if (contact.StudentContactPhoneActual and not contact.StudentContactSilentPhoneFlag) or contact.StudentContactMobilePhone or contact.StudentContactOccupPhone or contact.StudentContactDefaultEmail %}
                                                    <div class="small-12 column content hide" data-collapse-state="collapsed" data-collapsable="collap-contact-{{ loop.index }}">
                                                        <div class="list-item">
                                                            <div class="small-12">

                                                                {% if contact.StudentContactPhoneActual and not contact.StudentContactSilentPhoneFlag %}
                                                                    <div class="row">
                                                                        <div class="column small-12 medium-5"><strong>Home Phone: </strong></div>
                                                                        <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactPhoneActual }}" title="Call {{ contact.StudentContactPhoneActual }}">{{ contact.StudentContactPhoneActual }}</a></div>
                                                                    </div>
                                                                {% endif %}

                                                                {% if contact.StudentContactMobilePhone %}
                                                                    <div class="row">
                                                                        <div class="column small-12 medium-5"><strong>Mobile Phone: </strong></div>
                                                                        <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactMobilePhone }}" title="Call {{ contact.StudentContactMobilePhone }}">{{ contact.StudentContactMobilePhone }}</a></div>
                                                                    </div>
                                                                {% endif %}

                                                                {% if contact.StudentContactOccupPhone %}
                                                                    <div class="row">
                                                                        <div class="column small-12 medium-5"><strong>Work Phone: </strong></div>
                                                                        <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactOccupPhone }}" title="Call {{ contact.StudentContactOccupPhone }}">{{ contact.StudentContactOccupPhone }}</a></div>
                                                                    </div>
                                                                {% endif %}

                                                                {% if contact.StudentContactDefaultEmail %}
                                                                    <div class="row">
                                                                        <div class="column small-12 medium-5"><strong>Email: </strong></div>
                                                                        <div class="column small-12 medium-7"><a href="{{ session.mailhandle }}{{ contact.StudentContactDefaultEmail }}">{{ contact.StudentContactDefaultEmail }}</a></div>
                                                                    </div>
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% else %}
                                                    <div class="hide" data-collapse-state="collapsed" data-collapsable="collap-contact-{{ loop.index }}">
                                                        <div class="empty-state small-12">
                                                            <p>No contact details found.</p>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            </li>

                                            {% if contact.StudentContactSpouseTitle or contact.StudentContactSpousePreferred %}
                                            <li class="small-12">

                                                <!-- Expander -->
                                                <div class="list-item">
                                                    <div class="expander" data-collapser="collap-spouse-{{ loop.index }}"></div>
                                                    <div class="compact card small-12">
                                                        {# need to know user's schoolbox info here #}
                                                        {% if contact.spouse %}
                                                            <a href="/search/user/{{ contact.spouse.id }}">
                                                                <img src="/portrait.php?userId={{ contact.StudentContactSpouseID }}&amp;size=square64" />
                                                                <p>
                                                                    {{ contact.StudentContactSpouseTitle }} {{ contact.StudentContactSpousePreferred }} {{ contact.StudentContactSpouseSurname }}
                                                                    <span class="pipe meta">{{ contact.StudentContactSpouseRelation }}</span>
                                                                </p>
                                                            </a>
                                                        {% else %}
                                                            <img src="/portrait.php?userId={{ contact.StudentContactSpouseID }}&amp;size=square64" />
                                                            <p>
                                                                {{ contact.StudentContactSpouseTitle }} {{ contact.StudentContactSpousePreferred }} {{ contact.StudentContactSpouseSurname }}
                                                                <span class="pipe meta">{{ contact.StudentContactSpouseRelation }}</span>
                                                            </p>
                                                        {% endif %}
                                                    </div>
                                                </div>

                                                {% if (contact.StudentContactPhoneActual and not contact.StudentContactSilentPhoneFlag) or contact.StudentContactSpouseMobilePhone or contact.StudentContactSpouseOccupPhone or contact.StudentContactSpouseDefaultEmail %}
                                                    <!-- Collapsable content -->
                                                    <div class="small-12 column content hide" data-collapse-state="collapsed" data-collapsable="collap-spouse-{{ loop.index }}">
                                                        <div class="list-item">
                                                            <div class="small-12">

                                                                {% if contact.StudentContactPhoneActual and not contact.StudentContactSilentPhoneFlag %}
                                                                    <div class="row">
                                                                        <div class="column small-12 medium-5"><strong>Home Phone: </strong></div>
                                                                        <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactPhoneActual }}" title="Call {{ contact.StudentContactPhoneActual }}">{{ contact.StudentContactPhoneActual }}</a></div>
                                                                    </div>
                                                                {% endif %}

                                                                {% if contact.StudentContactSpouseMobilePhone %}
                                                                    <div class="row">
                                                                        <div class="column small-12 medium-5"><strong>Mobile Phone: </strong></div>
                                                                        <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactSpouseMobilePhone }}" title="Call {{ contact.StudentContactSpouseMobilePhone }}">{{ contact.StudentContactSpouseMobilePhone }}</a></div>
                                                                    </div>
                                                                {% endif %}

                                                                {% if contact.StudentContactSpouseOccupPhone %}
                                                                    <div class="row">
                                                                        <div class="column small-12 medium-5"><strong>Work Phone: </strong></div>
                                                                        <div class="column small-12 medium-7"><a href="tel:{{ contact.StudentContactSpouseOccupPhone }}" title="Call {{ contact.StudentContactSpouseOccupPhone }}">{{ contact.StudentContactSpouseOccupPhone }}</a></div>
                                                                    </div>
                                                                {% endif %}

                                                                {% if contact.StudentContactSpouseDefaultEmail %}
                                                                    <div class="row">
                                                                        <div class="column small-12 medium-5"><strong>Email: </strong></div>
                                                                            <div class="column small-12 medium-7"><a href="{{ session.mailhandle }}{{ contact.StudentContactSpouseDefaultEmail }}">{{ contact.StudentContactSpouseDefaultEmail }}</a></div>
                                                                    </div>
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% else %}
                                                <div class="hide" data-collapse-state="collapsed" data-collapsable="collap-spouse-{{ loop.index }}">
                                                    <div class="empty-state small-12">
                                                        <p>No contact details found.</p>
                                                    </div>
                                                </div>
                                                {% endif %}
                                            </li>
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </section>
                        {% endblock contacts %}
                    </div>
                {% endblock contacts_island %}
            </div>
        {% endif %}
        {% block emergencyContacts_island %}
        <div class="row">
            <div class="small-12 island">
                {% block emergencyContacts %}
                    {# up to 3 emergency contact blocks
                     # show no header if no emergencies
                     #}
                    {%  if isPrimaryCarer or isStaff %}
                        {% if not hideContacts  and (externalUser.StudentEmergencyName
                        or externalUser.StudentEmergency2Name
                        or externalUser.StudentEmergency3Name)
                        %}
                            <h2 class="subheader">Emergency Contact Information</h2>
                            <section>
                                <ul class="information-list expandable-card">
                                    {% for i in 1..3 %}
                                        {% set index = (i == 1 ? '' : i) %}
                                        {% if externalUser["StudentEmergency#{index}Name"] %}
                                            <li>
                                                <!-- Expander -->
                                                <div>
                                                    <div class="expander" data-collapser="collap-emergency-{{ i }}"></div>
                                                    <div class="content small-12">
                                                        {{ externalUser["StudentEmergency#{index}Name"] }}
                                                    </div>
                                                </div>

                                                <!-- Collapseable content -->
                                                <div class="small-12 column content hide" data-collapse-state="collapsed" data-collapsable="collap-emergency-{{ i }}">
                                                    <div class="row">
                                                        <div class="column small-12 medium-5"><strong>Primary Phone: </strong></div>
                                                        <div class="column small-12 medium-7">
                                                            <a href="tel:{{ externalUser["StudentEmergency#{index}Phone"] }}">
                                                                {{ externalUser["StudentEmergency#{index}Phone"] }}
                                                            </a>
                                                        </div>
                                                    </div>

                                                    <div class="row">
                                                        <div class="column small-12 medium-5"><strong>Alternate Phone: </strong></div>
                                                        <div class="column small-12 medium-7">
                                                            <a href="tel:{{ externalUser["StudentEmergency#{index}PhoneAlt"] }}">
                                                                {{ externalUser["StudentEmergency#{index}PhoneAlt"] }}
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </section>
                        {% endif %}
                    {% endif %}
                {% endblock emergencyContacts %}
            </div>
        </div>
        {% endblock emergencyContacts_island %}
    </div>

    <div class="small-12 {% if showContacts %}medium-6 medium-pull-6{% else %}large-reset-order{% endif %} columns">
        {% if showClasses %}
            {% if showSubjects %}
                {% for group, subjectGroup in subjects %}
                    {# Keep a running total of all teachers emails in this group #}
                    {% set teacherEmails = [] %}
                    <div class="row">
                        <div class="small-12 island">
                            <h2 class="subheader">{{ group }}</h2>
                            <section>
                                {% for subject in subjectGroup %}
                                <ul class="subject-list group">
                                    <li class="subject-group {% block folderListItemClasses %}{% endblock %}">
                                        <div class="content small-12">
                                            {% set subjectCode = subject.campusCode|default('') is same as('') ? subject.code : subject.campusCode ~ '/' ~ subject.code %}
                                            {% if subject.folder.id and subject.perms >= constant('\\Schoolbox\\Permission\\Access\\UserAccess::ACCESS_READ') %}
                                            <a href="/homepage/code/{{ subject.code|e('url')|e('url')|e('url') }}">
                                                <h3 class="no-margin">{{ subject.name }} <span class="meta">({{ subjectCode }})</span></h3>
                                            </a>
                                            {% else %}
                                            <h3 class="no-margin">{{ subject.name }} <span class="meta">({{ subjectCode }})</span></h3>
                                            {% endif %}
                                        </div>
                                        {% block folderListItemActions %}{% endblock %}
                                    </li>
                                    {% for teacher in subject.teachers %}
                                        {% set email =  '"' ~ teacher.formatName ~ '"' ~ " <" ~ teacher.email ~ ">" %}
                                        {% set teacherEmails = teacherEmails|merge([email]) %}
                                        <li class="actions-small-1">
                                            <div class="list-item">
                                                <div class="compact card small-12">
                                                    <a href="/search/user/{{ teacher.id }}">
                                                        <img src="/portrait.php?userId={{ teacher.externalId|e('url') }}&amp;size=square64" />
                                                        <p>
                                                            {{ teacher.formatName }}
                                                            <span class="pipe meta">
                                                                {% if teacher.positionTitle is empty %}
                                                                    {{ teacher.role.name }}
                                                                {% else %}
                                                                    {{ teacher.positionTitle }}
                                                                {% endif %}
                                                            </span>
                                                        </p>
                                                    </a>
                                                </div>
                                            </div>
                                            <nav>

                                                {% if not teacher.email is empty %}
                                                    {% set replyTo = teacher.getFormattedEmailDisplay %}
                                                    <a class="icon-email" href="{{ session.mailhandle }}{{ replyTo }}" title="Email {{ replyTo }}"></a>
                                                {% endif %}
                                            </nav>
                                        </li>
                                    {% endfor %}
                                </ul>
                                {% endfor %}
                                {% if session.user.role.staff and config.email_all_staff and config.mail_enable %}
                                    {% set teacherEmails = teacherEmails|join(emailSeparator)  %}
                                    {% set replyTo = session.user.getFormattedEmailDisplay %}
                                    <div class="component-action">
                                        <section>
                                            <form action="/mail/createMail.php" method="post">
                                                <div class="row">
                                                    <div class="small-12 columns">
                                                        <input type="hidden" name="replyto" value="{{ replyTo }}"/>
                                                        <input type="hidden" name="bcc" value="{{ teacherEmails }}"/>
                                                        <button type="submit" class="button">Email All {{ group }} Teachers</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </section>
                                    </div>
                                {% endif %}
                            </section>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}

            {% if showGroups and groups is not empty %}
                <div class="row">
                    <div class="small-12 island">
                        <h2 class="subheader">Groups</h2>
                        <section>
                            {% for group in groups %}
                            <ul class="subject-list group">
                                <li class="subject-group">
                                    <div class="list-item">
                                        <div class="content small-12 ">
                                            {% if group.perms > 0 %}
                                                <a href="/homepage/{{ group.id }}">
                                                    <h3 class="no-margin">{{ group.name }}</h3>
                                                </a>
                                            {% else %}
                                                <h3 class="no-margin">{{ group.name }}</h3>
                                            {% endif %}
                                        </div>
                                    </div>
                                </li>
                                {% if group.owners is defined %}
                                    {% for owner in group.owners %}
                                        <li class="actions-small-1">
                                            <div class="list-item">
                                                <div class="compact card small-12">
                                                    <a href="/search/user/{{ owner.id }}">
                                                        <img src="/portrait.php?userId={{ owner.externalId }}&amp;size=square64" />
                                                        <p>
                                                            {{ owner.formatName }}
                                                            <span class="pipe meta">
                                                                {% if owner.positionTitle is empty %}
                                                                    {{ owner.role.name }}
                                                                {% else %}
                                                                    {{ owner.positionTitle }}
                                                                {% endif %}
                                                            </span>
                                                        </p>
                                                    </a>
                                                </div>
                                            </div>
                                            <nav>
                                                {% if not owner.email is empty %}
                                                    {% set replyTo = owner.getFormattedEmailDisplay %}
                                                    <a class="icon-email" href="{{ session.mailhandle }}{{ replyTo }}" title="Email {{ replyTo }}"></a>
                                                {% endif %}
                                            </nav>
                                        </li>
                                    {% endfor %}
                                {% endif %}
                            </ul>
                            {% endfor %}
                        </section>
                    </div>
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
