{% extends '@core/user/student.twig' %}
{% block details_formTeacher %}
{% if showClasses %}
    {% if formTeacher %}
    <dt class="small-12 medium-3">Pastoral Teacher:</dt>
    <dd class="small-12 medium-9">
        {% if formTeacher.getId() %}
        <a href="{{ session.mailhandle }}{{ formTeacher.getEmail() }}">{{ formTeacher.formatName() }}</a>
        {% else %}
        {{ formTeacher.formatName() }}
        {% endif %}
    </dd>
    {% endif %}
{% endif %}
{% endblock details_formTeacher %}

{% block details_studentForm %}
{% if showClasses %}
    {% if externalUser.StudentForm %}
    <dt class="small-12 medium-3">Form:</dt>
    <dd class="small-12 medium-9">{{ externalUser.StudentForm }}</dd>
    {% endif %}
{% endif %}
{% endblock details_studentForm %}

{% block buttons %}
{{ parent() }}
<li>
    <a href="/synergetic/Docs/?id={{user.getExternalId()}}" class="icon-document">Academic Reports</a>
</li>
<li>
    <a href="/synergetic/fin/?id={{user.getExternalId()}}" class="icon-itineraryitem">Fees</a>
</li>

<li>
    <a href="/synergetic/mydetails?id={{user.getExternalId()}}" class="icon-info">My Details</a>
</li>
{% endblock buttons %}


