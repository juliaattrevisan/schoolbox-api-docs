{% extends '@core/user/student.twig' %}
{% block details_formTeacher %}
{% if showClasses %}
    {% if formTeacher %}
    <dt class="no-margin small-6 medium-3">Form Teacher</dt>
    <dd class="no-margin small-6 medium-9">
        {% if formTeacher.getId() %}
        <a href="{{ session.mailhandle }}{{ formTeacher.getEmail() }}">{{ formTeacher.formatName() }}</a>
        {% else %}
        {{ formTeacher.formatName() }}
        {% endif %}
    </dd>
    {% endif %}
{% endif %}
{% endblock details_formTeacher %}

{% block details_studentForm %}
{% if showClasses %}
    {% if externalUser.StudentForm %}
    <dt class="no-margin small-6 medium-3">Form</dt>
    <dd class="no-margin small-6 medium-9">{{ externalUser.StudentForm }}</dd>
    {% endif %}
{% endif %}
{% endblock details_studentForm %}

{% block buttons_island %}
    {{ parent() }}
    <ul id='fat-buttons' class="no-margin small-block-grid-2 medium-block-grid-3 large-block-grid-5" data-equalizer>
        <li class="no-pad">
            <a href="/synergetic/Docs/?id={{user.getExternalId()}}" class="no-margin fat button icon-fat size-32 icon-document" data-equalizer-watch>Academic Reports</a>
        </li>
        <li class="no-pad">
            <a href="/synergetic/fin/?id={{user.getExternalId()}}" class="no-margin fat button icon-fat size-32 icon-itineraryitem" data-equalizer-watch>Fees</a>
        </li>

        <li class="no-pad">
            <a href="/synergetic/mydetails?id={{user.getExternalId()}}" class="no-margin fat button icon-fat size-32 icon-info" data-equalizer-watch>My Details</a>
        </li>
    </ul>
{% endblock buttons_island %}
