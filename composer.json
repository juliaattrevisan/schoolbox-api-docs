        "aura/web": "~2.0.0",
        "aura/session": "~2.0.0",
        "aura/sqlquery": "~2.0.0",
        "0x46616c6b/etherpad-lite-client": "dev-schoolbox-14.0-dep as dev-master",
        "easyrdf/easyrdf": "~0.8.0",
