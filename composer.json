    "license": "proprietary",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "djfm/cssin",
                "version": "0.1.0",
                "source": {
                    "url": "https://github.com/djfm/cssin",
                    "type": "git",
                    "reference": "1234181cea"
                },
                "autoload": {
                    "psr-4": {
                        "FM\\": "src/"
                    }
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "gggeek/phpxmlrpc",
                "version": "0.1.0",
                "source": {
                    "url": "https://github.com/gggeek/phpxmlrpc",
                    "type": "git",
                    "reference": "f9dbab373a5ed33f7246daf2865ea2e2231a362e"
                },
                "autoload": {
                    "classmap": ["lib/"]
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "devristo/phpws",
                "version": "0.1.0",
                "source": {
                    "url": "https://github.com/Devristo/phpws",
                    "type": "git",
                    "reference": "911de5a6b54c5ee9c40fc9231e7301fdfdfa5b30"
                },
                "autoload": {
                    "psr-0": {
                        "Devristo\\Phpws\\": "src/"
                    }
                }
            }
        },
        {
            "type": "vcs",
            "url":  "https://github.com/alaress/etherpad-lite-client"
        },
        {
            "type": "vcs",
            "url":  "https://github.com/armatronic/Imagine"
        }
