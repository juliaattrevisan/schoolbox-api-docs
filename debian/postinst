#!/bin/sh
# postinst script for schoolbox
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)
        # start logging
        date >> /var/log/schoolbox/upgrade.log;
        echo "Schoolbox Upgrade" >> /var/log/schoolbox/upgrade.log;
        # Test whether a2enmod is available (and thus also apache2ctl).
        if [ -x /usr/sbin/a2enmod ]; then
            # Enable the Apache2 rewrite module if not already enabled
            a2enmod rewrite > /dev/null || true
            a2enmod ssl > /dev/null || true
            a2enmod headers > /dev/null || true
        fi
        chown -R alaress:alaress /usr/share/schoolbox 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
        /usr/share/schoolbox/tools/create-data-dirs.sh /var/lib/schoolbox 2>&1 | tee -a /var/log/schoolbox/upgrade.log;

        # Clear cache directories
        if [ -f /etc/schoolbox/conf.php ]; then
            /usr/share/schoolbox/tools/clean-cache-dir.sh 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
        fi

        # Fix ownership and permissions of existing configuration.
        if [ -f /etc/schoolbox/conf.php ]; then
            chown root:www-data /etc/schoolbox/conf.php;
            chmod 0644 /etc/schoolbox/conf.php;
            /usr/share/schoolbox/tools/update-sql.sh 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
        fi
        # Manage services (upstart|systemd)
        if [ "$(readlink /proc/1/exe)" = "/lib/systemd/systemd" ]; then
            cp -f /usr/share/schoolbox/tools/init/schoolbox-*.service /lib/systemd/system;
            systemctl daemon-reload;
            # Enable services
            # schoolbox-belld is not enabled by default
            systemctl enable schoolbox-scheduled.service;
            systemctl enable schoolbox-routed.service;
            systemctl enable schoolbox-socketd.service;
            systemctl enable schoolbox-digestd.service;
            # Restart all daemons post upgrade
            systemctl restart schoolbox-scheduled.service | tee -a /var/log/schoolbox/upgrade.log;
            systemctl restart schoolbox-routed.service | tee -a /var/log/schoolbox/upgrade.log;
            systemctl restart schoolbox-socketd.service | tee -a /var/log/schoolbox/upgrade.log;
            systemctl restart schoolbox-digestd.service | tee -a /var/log/schoolbox/upgrade.log;
            # Restart schoolbox-belld only if already enabled
            if [ "$(systemctl is-enabled schoolbox-belld.service 2>/dev/null)" = "enabled" ]; then
                systemctl restart schoolbox-belld.service | tee -a /var/log/schoolbox/upgrade.log;
            fi
        else
            cp -f /usr/share/schoolbox/tools/init/schoolbox-*.conf /etc/init/;
            cp -f /usr/share/schoolbox/tools/init/schoolbox-*.override /etc/init/;
            # Restart all daemons post upgrade
            service schoolbox-scheduled restart 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
            service schoolbox-socketd restart 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
            service schoolbox-digestd restart 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
            service schoolbox-routed restart 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
            if [ -f /etc/init/schoolbox-belld.conf ]; then
                service schoolbox-belld restart 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
            fi
        fi

        # Bring site back up
        /usr/share/schoolbox/tools/maintenance/site_up.sh 2>&1 | tee -a /var/log/schoolbox/upgrade.log;

        # Attempt to execute repair on schoolbox database using database root user credentials
        optionsFile="/root/.my.cnf";
        if [ ! -f ${optionsFile} ]; then
            echo "DB root credentials file '$optionsFile' not found, skipping repair";
        else
            echo "DB root credentials file '$optionsFile' found, initiating repair";
            mysqlcheck --defaults-file=${optionsFile} --repair schoolbox 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
        fi
        # Fix ownership and permissions of existing configuration.
        if [ -f /etc/schoolbox/conf.php ]; then
          /usr/bin/php /usr/share/schoolbox/tools/skin/builder.php --force 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
          /usr/share/schoolbox/tools/set-data-dir-perms.sh /var/lib/schoolbox/cache 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
