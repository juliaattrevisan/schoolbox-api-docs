#!/bin/sh
# postinst script for schoolbox
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)
        # start logging
        date >> /var/log/schoolbox/upgrade.log;
        echo "Schoolbox Upgrade" >> /var/log/schoolbox/upgrade.log;

        # Modify newly-deployed package files to be owned by 'alaress' user.
        # In theory, package files should be root-owned, but this assists Support/Devs using FTP to manipulate files.
        # https://www.debian.org/doc/debian-policy/ch-files.html#permissions-and-owners
        chown -R alaress:alaress /usr/share/schoolbox 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
        /usr/share/schoolbox/tools/create-data-dirs.sh /var/lib/schoolbox 2>&1 | tee -a /var/log/schoolbox/upgrade.log;

        # Clear cache directories
#        if [ -f /etc/schoolbox/conf.php ]; then
            /usr/share/schoolbox/tools/clean-cache-dir.sh 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
#        fi

#        # Fix ownership and permissions of existing configuration.
#        if [ -f /etc/schoolbox/conf.php ]; then
#            chown root:www-data /etc/schoolbox/conf.php;
#            chmod 0644 /etc/schoolbox/conf.php;
            /usr/share/schoolbox/tools/update-sql.sh 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
#        fi

        # Run scripts that apply instance-specific values.
        # (These should only be run on install, not on upgrade. For that reason, these scripts must be idempotent.)
        php /usr/share/schoolbox/tools/token/generateKeyPair.php --quiet 2>&1 | tee -a /var/log/schoolbox/upgrade.log;

        /usr/local/bin/schoolbox-rebuild-daemons --fetch

        # Bring site back up
        /usr/share/schoolbox/tools/maintenance/site_up.sh 2>&1 | tee -a /var/log/schoolbox/upgrade.log;

        # Fix ownership and permissions of existing configuration.
#        if [ -f /etc/schoolbox/conf.php ]; then
          /usr/share/schoolbox/tools/set-data-dir-perms.sh /var/lib/schoolbox/cache 2>&1 | tee -a /var/log/schoolbox/upgrade.log;
#        fi

        echo "$(date +%Y-%m-%d\ %X) - Upgrade completed successfully" >> /var/log/schoolbox/upgrade.log;
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
