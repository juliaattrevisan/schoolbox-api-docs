#!/bin/sh
# prerm script for schoolbox-mobile
#
# see: dh_installdeb(1)

set -e

case "$1" in
    upgrade)
        # Make no changes
    ;;

    remove)
        /usr/share/schoolbox/tools/module.sh disable mobile
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
