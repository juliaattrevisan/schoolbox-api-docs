#!/bin/sh
# preinst script for schoolbox
#
# see: dh_installdeb(1)

set -e

# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    install)
    ;;
    upgrade)
        # backup instances
        if [ -f /etc/schoolbox/primary_node ]; then
            instance_list=$(/usr/local/bin/schoolbox-read-instances --ini /etc/schoolbox/instances.ini --option instance-list)
            for instance_id in $instance_list
            do
                INSTANCE_ID=$instance_id /usr/local/bin/schoolbox-database-backup --package schoolbox | \
                tee -a /var/log/schoolbox/"$instance_id"/upgrade.log &
                pids="${pids} $!"
            done

            for pid in $pids
            do
                if ! wait "$pid"; then
                    echo "failed to backup an instance" | tee -a tee -a /var/log/schoolbox/upgrade.log
                    exit 1;
                fi
            done
        fi
        # Temporary fix for moving symlinked conf file as part of 20.2 upgrade
        if [ -L /usr/share/schoolbox/www/conf ]; then
            echo "Converting conf link to dir..." | tee -a /var/log/schoolbox/upgrade.log;
            temp_file=$(mktemp)
            mv /usr/share/schoolbox/www/conf/conf.php "$temp_file"
            rm /usr/share/schoolbox/www/conf
            mkdir /usr/share/schoolbox/www/conf
            mv "$temp_file" /usr/share/schoolbox/www/conf/conf.php
        fi

        # Is nginx local? TODO Add cloud support.
        if service nginx status >/dev/null 2>&1; then
            # We cannot reference a file in the package from a prinst script, so need to inline it here
            echo 'Taking Schoolbox offline...' | tee -a /var/log/schoolbox/upgrade.log;
            maintenanceFileName="/usr/share/schoolbox/.maintenance";
            # Does maintenance file already exist
            echo "Checking for maintenance file '$maintenanceFileName'..." | tee -a /var/log/schoolbox/upgrade.log;
            if [ ! -d /usr/share/schoolbox ]; then
                echo "Schoolbox folder does not yet exist, maintenance file cannot be created." | tee -a /var/log/schoolbox/upgrade.log;
            elif [ -f ${maintenanceFileName} ]; then
                echo "Maintenance file already present." | tee -a /var/log/schoolbox/upgrade.log;
            else
                echo "Maintenance file not present, creating..." | tee -a /var/log/schoolbox/upgrade.log;
                if ! touch ${maintenanceFileName}; then
                    echo "Unable to create maintenance file, exiting" | tee -a /var/log/schoolbox/upgrade.log;
                    exit 1;
                fi;
                echo "Maintenance file created at '$maintenanceFileName'" | tee -a /var/log/schoolbox/upgrade.log;
            fi;
            # Production servers use 'open_file_cache', need to reload to detect file change
            nginx -s reload | tee -a /var/log/schoolbox/upgrade.log;
        fi

        # Stop all schoolbox daemons (supports both old+new single/multi instance style)
        for daemon in socketd digestd routed scheduled belld; do
            for service in $(systemctl --plain --no-legend | grep -E "schoolbox*.*$daemon.*service" | awk '{print $1}'); do
                echo "stopping $service" | tee -a /var/log/schoolbox/upgrade.log
                systemctl stop "$service"
            done
        done

        echo "Removing cronjobs" | tee -a /var/log/schoolbox/upgrade.log
        find /etc/cron.d -iname 'sbc_schoolbox_*' -delete 2>&1 | tee -a /var/log/schoolbox/upgrade.log
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
