#!/bin/sh
# preinst script for schoolbox
#
# see: dh_installdeb(1)

set -e

# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    install|upgrade)
        # If a schoolbox DB backup script has been previously shipped, use it
        if [ -f /usr/share/schoolbox/tools/tools/backup-database.sh ]; then
            /usr/share/schoolbox/tools/tools/backup-database.sh;
        fi
        # Ensure the alaress user exists
        useradd -m alaress 2> /dev/null || true;
        # Stop all daemons for consistency
        service schoolbox-scheduled stop 2>&1 >> /var/log/schoolbox/upgrade.log || true;
        service schoolbox-socketd stop 2>&1 >> /var/log/schoolbox/upgrade.log || true;
        service schoolbox-digestd stop 2>&1 >> /var/log/schoolbox/upgrade.log || true;
        service schoolbox-routed stop 2>&1 >> /var/log/schoolbox/upgrade.log || true;
        # Stop old pre-v17.0 rerouted daemon
        service schoolbox-rerouted stop 2>&1 >> /var/log/schoolbox/upgrade.log || true;
        if [ -f /etc/init/schoolbox-belld.conf ]; then
            service schoolbox-belld stop 2>&1 >> /var/log/schoolbox/upgrade.log || true;
        fi
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
