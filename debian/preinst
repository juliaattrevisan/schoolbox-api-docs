#!/bin/sh
# preinst script for schoolbox
#
# see: dh_installdeb(1)

set -e

# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# Circuit breaker configuration
readonly CIRCUIT_BREAKER_DIR="/var/lock/schoolbox-upgrade"
readonly CIRCUIT_BREAKER_TIMEOUT=86400  # 24 hours in seconds

# Circuit breaker helpers
# Check if circuit breaker is active for a specific instance
check_instance_circuit_breaker() {
  local instance_id=$1
  local breaker_file="${CIRCUIT_BREAKER_DIR}/${instance_id}.lock"

  if [ -f "$breaker_file" ]; then
    local last_failure=$(cat "$breaker_file")
    local current_time=$(date +%s)
    local time_diff=$((current_time - last_failure))

    if [ $time_diff -lt $CIRCUIT_BREAKER_TIMEOUT ]; then
      local hours_remaining=$(( (CIRCUIT_BREAKER_TIMEOUT - time_diff) / 3600 ))
      echo "Circuit breaker active for instance '$instance_id'. Last failure was ${time_diff}s ago. Skipping backup (retry in ${hours_remaining}h)." | tee -a /var/log/schoolbox/upgrade.log
      return 1  # Circuit breaker is active
    else
      echo "Circuit breaker timeout expired for instance '$instance_id'. Removing lock and proceeding..." | tee -a /var/log/schoolbox/upgrade.log
      clear_instance_circuit_breaker "$instance_id"
      return 0  # Circuit breaker expired, can proceed
    fi
  fi
  return 0  # No circuit breaker, can proceed
}

# Trigger circuit breaker for a specific instance
trigger_instance_circuit_breaker() {
  local instance_id=$1
  mkdir -p "$CIRCUIT_BREAKER_DIR"
  date +%s > "${CIRCUIT_BREAKER_DIR}/${instance_id}.lock"
  echo "Circuit breaker triggered for instance '$instance_id'. Backup/upgrade will not run again for 24 hours." | tee -a /var/log/schoolbox/upgrade.log
  send_slack_alert "$instance_id"
}

# Send Slack alert via email
send_slack_alert() {
  local instance_id=$1
  local log_file="/var/log/schoolbox/${instance_id}/upgrade.log"
  local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
  local email="operations-aaaaaxwus43lmb5z5amyxounpy@alaress.slack.com" # address for #operations in Slack

  local subject="[ALERT] Schoolbox database backup failed for ${instance_id}"
  local body="Schoolbox database backup failed during package upgrade and circuit breaker activated.

Instance: ${instance_id}
Timestamp: ${timestamp}
Log file: ${log_file}

The backup/upgrade will not run again for this instance for 24 hours.
Manual intervention required.

To manually reset the circuit breaker:
  rm /var/lock/schoolbox-upgrade/${instance_id}.lock
"

  echo "$body" | mail -aFrom:ist@schoolbox.com.au -s "$subject" "$email"
}

# Clear circuit breaker for a specific instance
clear_instance_circuit_breaker() {
  local instance_id=$1
  rm -f "${CIRCUIT_BREAKER_DIR}/${instance_id}.lock"
}

case "$1" in
    install)
    ;;
    upgrade)
        # Backup databases for all instances for package. Exit if any backups fail.
        if [ ! -f /usr/local/bin/schoolbox-database-backup ]; then
            echo "Non-primary node. Skipping databases backup" | tee -a /var/log/schoolbox/upgrade.log
        else
            echo "Primary node. Backing up databases" | tee -a /var/log/schoolbox/upgrade.log

            instance_list=$(/usr/local/bin/schoolbox-read-instances --ini /etc/schoolbox/instances.ini --option instance-list)
            for instance_id in $instance_list; do
                # Check circuit breaker FIRST for this instance
                if ! check_instance_circuit_breaker "$instance_id"; then
                    # Circuit breaker is active, skip this instance
                    continue
                fi

                instance_log_file=/var/log/schoolbox/"$instance_id"/upgrade.log
                echo "Backing up instance ${instance_id}. Logging to $instance_log_file" | tee -a /var/log/schoolbox/upgrade.log
                mkdir -p /var/log/schoolbox/"$instance_id" 2>&1 | tee -a /var/log/schoolbox/upgrade.log
                INSTANCE_ID=$instance_id /usr/local/bin/schoolbox-database-backup >> "$instance_log_file" 2>&1 &
                pids="${pids} $!-$instance_id"
            done

            any_failures=0
            for group in $pids; do
                pid=$(echo "$group" | cut -d '-' -f1)
                instance_id=$(echo "$group" | cut -d '-' -f2)
                if ! wait "$pid"; then
                    echo "Error: Failed to backup instance $instance_id" | tee -a /var/log/schoolbox/upgrade.log
                    trigger_instance_circuit_breaker "$instance_id"
                    any_failures=1
                else
                    echo "Backup complete for $instance_id" | tee -a /var/log/schoolbox/upgrade.log
                    clear_instance_circuit_breaker "$instance_id"
                fi
            done

            if [ $any_failures != '0' ]; then
                echo "Error: Backup failures detected. Exiting." | tee -a /var/log/schoolbox/upgrade.log
                exit 1;
            fi
            echo "Finished backing up instances" | tee -a /var/log/schoolbox/upgrade.log
        fi

        # Stop all schoolbox daemons (supports both old+new single/multi instance style)
        for daemon in socketd digestd routed scheduled mobiled belld; do
            for service in $(systemctl --plain --no-legend | grep -E "schoolbox*.*$daemon.*service" | awk '{print $1}'); do
                echo "stopping $service" | tee -a /var/log/schoolbox/upgrade.log
                systemctl stop "$service"
            done
        done

        echo "Removing cronjobs" | tee -a /var/log/schoolbox/upgrade.log
        find /etc/cron.d -iname 'sbc_schoolbox_*' -delete 2>&1 | tee -a /var/log/schoolbox/upgrade.log
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
