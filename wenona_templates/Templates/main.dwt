<div id="outerWrap"> 
	<div id="header"></div> 
	<div id="searchBox"> 
		<form class="standardForm" id="searchForm" action="/search.php" method="get"> 
			<p style="margin:0;"> 
				<input class="short" type="text" name="keyword" /> 
				<select class="short" name="where"> 
					<option value="0" selected="selected">portal</option> 
					<option value="1">google</option> 
					<option value="2">yahoo</option> 
				</select> 
				<input class="img" type="image" src="/images/wenona/searchbutton.gif" alt="Search" name="Submit" /> 
			</p> 
		</form> 
	</div> 
	<div id="left"> 
		<h3>&#187;&nbsp;Go To</h3> 
		{MCSSMENU}
		<!-- BEGIN msubject --> 
		<h3>&#187;&nbsp;My Subjects</h3> 
		<ul> 
			<!-- BEGIN msubject_block --> 
			<li><a href="/homepage/{MSUBCODE}">{MSUBJECT}</a></li> 
			<!-- END msubject_block --> 
		</ul> 
		<!-- END msubject -->
        <!-- BEGIN mstudent --> 
		<h3>&#187;&nbsp;My Daughters</h3> 
