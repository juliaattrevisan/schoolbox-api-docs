<head>
<title>{TITLE}</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta http-equiv="Content-Language" content="en-au" />
<meta name="author" content="James Leckie, Lektec Consulting"/> 
<link rel="stylesheet" type="text/css" media="screen" href="/css/demo/droppy.css" />
<link rel="stylesheet" type="text/css" media="screen" href="/css/demo/core-demo.css" /> 
<link rel="stylesheet" type="text/css" media="screen" href="/css/jpc/screen.css" /> 

<!-- BEGIN header_css --><!-- END header_css -->

<link rel="Shortcut Icon" href="/images/jpc/favicon.ico" type="image/x-icon" />

<script type="text/javascript" src="/javascript/jquery.js"></script>
<script type="text/javascript" src="/javascript/jquery.droppy.js"></script>
<script type='text/javascript'>
  var $j = jQuery.noConflict(); 
	
	$j(function() {
    $j('#nav ul').droppy({speed: 0});
	
		$j('#nav li.parent > a span').each(function() {
			$j(this).append('<strong>&rsaquo;</strong>');
		});
		
		$j('.standardForm tr:last td').css("border", "0"); 
	
  });
</script>
<!-- BEGIN header_javascript -->
<script type="text/javascript" src="{HEADER_SCRIPT_LOCATION}"></script>
<!-- END header_javascript -->
</head>
<body>
<!-- TemplateBeginEditable name="head" --><!-- TemplateEndEditable -->
  <div id="header">
    	<a href="/" class="logo"><img height="221" width="224" alt="JPCNet" src="/images/jpc/jpc-logo.png"></a>
<ul id="infoPanel">
	<li class="first">{SITE_GREETING} <a href="/search/user/{USER_ID}" alt="View Profile" title="View Profile">{SITE_LOGINNAME}</a>|</li>
    <li><a href="/logout.php" alt="Logout" title="Logout">Logout</a></li>
</ul>
    <form id="search" action="/search.php" method="get">
      <fieldset>
        <input id="search-field" type="text" name="keyword" />
        <input id="search-button" type="submit" value="Search" />
      </fieldset>
    </form>  
<ul id="tabs">
	<li class="{TAB_MAIN_ON}"><a href="/home/" title="Greeting page">Home</a></li>
	<li class="{TAB_NEWS_ON}"><a href="/news/" title="Current school news">News</a></li>
	<!-- BEGIN webmail_tab -->
	<li class="{TAB_WEBMAIL_ON}"><a {WEBMAIL_LOCATION} title="Access your messages here">Webmail</span></a></li> 
	<!-- END webmail_tab -->
	<li class="{TAB_CALENDAR_ON}"><a href="/calendar/week/" title="School calendar events">Calendar</a></li>
	<!-- BEGIN timetable_tab -->
	<li class="{TAB_TIMETABLE_ON}"><a href="/timetable/" title="View your school timetable">Timetable</a></li>
	<!-- END timetable_tab -->
	<li class="{TAB_RESOURCES_ON}"><a href="/resources/" title="Browse resources and homepages">Folders</a></li>
	<!-- BEGIN submission_tab -->
	<li class="{TAB_SUBMISSION_ON}"><a href="/submission/listSubmission" title="Access your submission boxes">Submissions</a></li>
	<!-- END submission_tab --> 
	<!-- BEGIN eportfolio_tab -->
	<li class="{TAB_EPORTFOLIO_ON}"><a href="/eportfolio/{EPORTFOLIO_USER_ID}" title="Access your eportfolio area">My ePortfolio</a></li>
	<!-- END eportfolio_tab -->
</ul>

<!-- BEGIN myfiles_tab --> 
<!-- END myfiles_tab -->


  </div>
<div id="container">


  <div id="nav">
    <h3>My JPCNet</h3>
    {MCSSMENU}
    <!-- BEGIN msubject -->
    <h3>My Subjects</h3>
    <ul>
      <!-- BEGIN msubject_block --> 
      <li><a href="/homepage/{MSUBCODE}/">{MSUBJECT}</a></li> 
      <!-- END msubject_block -->
    </ul>
    <!-- END msubject -->
    <!-- BEGIN mstudent -->
    <h3>My Students</h3>
    <ul>
      <!-- BEGIN mstudent_block --> 
      <li><a href="/search/user/{MSTUDENT_ID}">{MSTUDENT_NAME} ({MSTUDENT_YEAR})</a></li> 
      <!-- END mstudent_block -->
    </ul>
    <!-- END mstudent -->
    <!-- BEGIN mgroup --> 
    <h3>My Groups</h3>
    <ul>
      <!-- BEGIN mgroup_block --> 
      <li><a href="/homepage/{MGID}/">{MGNAME}</a></li>
      <!-- END mgroup_block -->
    </ul>	
    <!-- END mgroup --> 
    <h3>My Links</h3>
    <ul>
      <!-- BEGIN mlink_block -->
      <li>{MLINK}</li>
      <!-- END mlink_block --> 
      <li><a href="/cms/myLinks">Add Link</a></li>
    </ul>	
  </div>

  <div id="content">
	<!-- TemplateBeginEditable name="content" -->content<!-- TemplateEndEditable -->
    <div class="float-fix"></div>

  </div>


</div>
	<div id="footer">
<ul>
  <li>{TEMPLATE_YEAR} &copy; Copyright <a href="{SITE_ADDRESS}">{SITE_NAME}</a></li>
