<?xml version="1.0" encoding="UTF-8"?>

<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false"
         bootstrap="test/bootstrap/unit.php"
         defaultTestSuite="default"
>
  <testsuites>
    <testsuite name="default">
      <directory suffix=".php">library/Proxy/</directory>
      <directory suffix=".php">library/Alaress/</directory>
      <directory suffix=".php">library/Schoolbox/</directory>
      <exclude>library/Alaress/Database/Test</exclude>
      <exclude>library/Schoolbox/Database/Test</exclude>
      <exclude>library/Schoolbox/Profile/Test/Generator.php</exclude>
    </testsuite>
  </testsuites>
    <listeners>
        <!-- TODO - This is a temporary hack to compensate for a bug in paratest/phpunit when using code-coverage -->
        <!--        The correct solution is to upgrade paratest/phpunit -->
        <!--        See https://github.com/paratestphp/paratest/issues/282 -->
        <listener class="Alaress\Test\MakeWarningErrorAgainTestListener"></listener>
    </listeners>
    <php>
        <!--
            The standard test suite uses a fake instance ID, to ensure that
            there is no database connection.
            The Vagrant environment by default has a connection, even in tests:
            the CI environment does not, which can cause Vagrant and CI to
            report different errors.
        -->
        <env name="INSTANCE_ID" value="null" force="true" />
    </php>
</phpunit>
